/// Export a branch as a portable bundle file (registry + frontier ops) -- move it to another machine.
let executeExport (state: AppState) (branchRef: String) (path: String) : AppState =
  match resolveRef branchRef with
  | None -> Cli.exitWith state false
  | Some branchId ->
    match Stdlib.Cli.File.writeText path (SCM.PackageOps.exportBranch branchId) with
    | Ok _ ->
      Cli.printOk $"exported branch \"{branchRef}\" to {path}."
      state
    | Error _ ->
      Cli.printErr $"couldn't write {path}."
      Cli.exitWith state false

/// Import a branch bundle file (from another machine): recreates the branch here (isolated from main).
let executeImport (state: AppState) (path: String) : AppState =
  match Stdlib.Cli.File.readText path with
  | Ok json ->
    match SCM.PackageOps.importBranch json with
    | Ok msg ->
      Cli.printOk msg
      state
    | Error e ->
      Cli.printErr $"couldn't import: {e}"
      Cli.exitWith state false
  | Error _ ->
    Cli.printErr $"couldn't read {path}."
    Cli.exitWith state false



