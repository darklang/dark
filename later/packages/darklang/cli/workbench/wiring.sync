// --- packages/darklang/cli/workbench/nav.dark ---
/// `u`/`d` in the SCM view: push to the relay, pull from it, output in the reader.
///
/// Sync is an ACTION here, not just a readout: seeing that you are ahead and having to leave for a shell
/// is how people stop pushing. It runs the same registered command the CLI does, so there is one
/// implementation.
///
/// With no relay configured this says so instead of running: `push` would fail against an empty url, and
/// the fix is a question-asking command that cannot run inside a frame the workbench owns.
let syncInFrame (state: State) (verb: String) : Step =
  if SCM.PackageOps.relay () == "" then
    Step.Continue
      { state with messageKind = MessageKind.Refused; message = "no relay yet - run `dark sync setup` from a shell to point this instance at one" }
  else
    runCommandInFrame state verb []




// --- packages/darklang/cli/workbench/chrome.dark ---
  else if state.activeView == vDevices then
    renderDevices state region


// --- packages/darklang/cli/workbench/chrome.dark ---
  else if idx == vDevices then ("this instance's config, and the peers it syncs with", "part sketch")


// --- packages/darklang/cli/workbench/chrome.dark ---
    else if view == vDevices then
      [ ("c", "config"), ("s", "sync now"), ("a", "setup") ]


// --- packages/darklang/cli/workbench/chrome.dark ---
            [ ("c", "commit"), ("x", "discard"), ("u/d", "push/pull") ]

// --- packages/darklang/cli/workbench/chrome.dark ---
    ("Changes", "⏎ source   c commit   x discard   u/d push/pull   o/t/a resolve the conflict under the cursor")

// --- packages/darklang/cli/workbench/chrome.dark ---
    ("Sync", "s sync now   u push   d pull   o other instances")


