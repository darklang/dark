// --- the Crons view's loaders ---
/// The Crons view - scheduled jobs on this instance (mock until a Darklang.Cron value type + engine exist;
/// see notes/cli-ux/22-things.md and classic Dark's cron model). Columns: status · name · schedule · last · next.
let loadCronItems () : List<BodyItem> =
  [ BodyItem { name = "●  nightly-backup    daily 02:00    14h ago ok    in 9h"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "⏸  digest-email      weekly Mon     3d ago  ok    paused"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "⚠  sync-metrics      every 1h       52m ago fail  in 8m"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "○  cleanup-temp      every 12h      never         in 12h"; kind = "cron"; isModule = false; desc = "" } ]

let cronDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    (Stdlib.Cli.UI.Colors.boldText item.name)
    + "\n\n"
    + "schedule : daily at 02:00  (EveryDay)\n"
    + "handler  : Stachu.Backups.nightly  @9fa3…\n"
    + "last run : 2026-07-24 02:00  ok  1.2s\n"
    + "next run : 2026-07-25 02:00  (in 9h)\n"
    + "state    : enabled · runs 41 · fails 0 · ● this instance\n\n"
    + (Stdlib.Cli.UI.Colors.dimText "(mock data)")
    + "\n\n"
    + "r run-now   p pause/resume   t traces   e edit"
  | None -> Stdlib.Cli.UI.Colors.dimText "no crons yet - declare a Darklang.Cron value"
