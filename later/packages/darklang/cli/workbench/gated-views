// --- packages/darklang/cli/workbench/types.dark ---
    /// "" = always visible; anything else is a config key that must be on (see `gateEnabled`)
    gateKey: String


// --- packages/darklang/cli/workbench/types.dark ---
/// Is this gate key switched on in the config?
///
/// Per key, so `config set crons.enabled on` turns one view on and nothing else. It used to ask
/// whether the ACCOUNT was one of the two people building the thing, which stopped being a
/// question anybody could answer when accounts left: no account meant no gated view, ever.
let gateEnabled (key: String) : Bool =
  match Darklang.Cli.Config.get key with
  | Some v ->
    let v = Stdlib.String.toLowercase (Stdlib.String.trim v)
    (v == "on") || (v == "true") || (v == "1") || (v == "yes")
  | None -> false



// --- packages/darklang/cli/workbench/types.dark ---
/// Built-in view indices and their optional gate keys. Extension views are
/// appended by `viewSpecs`.
// Indices 2 and 5 remain reserved for the former Inspect and Devices views,
// keeping later indices stable without exposing either in the navbar.
val baseViewSpecs =
  [ (vHome, "")
    (vMatter, "")
    (vScratch, "")
    (vSCM, "")
    (vTraces, "")
    (vDocs, "") ]

// --- packages/darklang/cli/workbench/types.dark ---
val viewSpecs =
  let base =
    baseViewSpecs
    |> Stdlib.List.map (fun pair ->
      let (i, g) = pair
      (i, Frame.viewName i, g))
  let exts =
    extensionViews ()
    |> Stdlib.List.indexedMap (fun i vd -> (baseViewCount + i, vd.name, vd.gateKey))
  Stdlib.List.append base exts

// --- packages/darklang/cli/workbench/types.dark ---
/// Which gated views (Crons, Calendar, Builtins) the config has switched on.
///
/// Computed at launch rather than per frame: each key is a config read.
let gatedViews () : List<Int> =
  viewSpecs
  |> Stdlib.List.filter (fun spec ->
    let (_i, _n, g) = spec
    (g != "") && (gateEnabled g))
  |> Stdlib.List.map (fun spec ->
    let (i, _n, _g) = spec
    i)


/// Re-read the gates for a running workbench.
let recomputeGatedViews (state: State) : List<Int> =
  gatedViews ()


/// The view indices the navbar may show, in `viewSpecs` order. A view shows
/// if it isn't gated, or it's gated and enabled for this account (see
/// `enabledGatedViews`, recomputed on launch and after a config change).
let visibleViews (state: State) : List<Int> =
  viewSpecs
  |> Stdlib.List.filter (fun spec ->
    let (i, _n, g) = spec
    (g == "") || (Stdlib.List.member state.enabledGatedViews i))
  |> Stdlib.List.map (fun spec ->
    let (i, _n, _g) = spec
    i)

