// --- packages/darklang/cli/workbench/nav.dark ---
let navBottom (state: State) : Step =
  if isDocument state then
    Step.Continue { state with detailScroll = Stdlib.max 0 ((previewRowCount state) - 1) }
  else
  let maxIdx

// --- packages/darklang/cli/workbench/nav.dark ---
/// Page through a document using the same wrapped-row bounds as its renderer.
let documentPage (state: State) (direction: Int) : Step =
  if Stdlib.Bool.not (isDocument state) then Step.Continue state
  else
    let (_w, h) = Terminal.getSize ()
    let page = Stdlib.max 1 (h - 5)
    let last = Stdlib.max 0 ((previewRowCount state) - 1)
    let scroll = Stdlib.max 0 (Stdlib.min last (state.detailScroll + direction * page))
    Step.Continue { state with detailScroll = scroll }



