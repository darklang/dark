//       which takes over the screen.
// ALSO: the `dark docs cli` line `outliner          the interactive tree outliner`, under
//       "The full-screen experience", after `workbench`.
// WHEN: the molt-mvp pass, 2026-11-02

  let acceptsOutliner(): Accepts.Accepts = (Accepts.subcommands([ ("ls", Accepts.nothing()), ("show", Accepts.between(1, 1, [])), ("add", Accepts.text(2)) ], Accepts.nothing()))

      ("outliner", "Interactive tree outliner", [ "tree-exp" ], acceptsOutliner, Outliner.App.execute, Outliner.App.help, Outliner.App.complete)
