      | Error e -> Stdlib.Result.Result.Error e
    | _ ->
      ... the Unix branch, which stays ...

// `installFromCurrentBinary`, the config file:

    let setupResult =
      match host.os with
      | Windows ->
        match Stdlib.Cli.PowerShell.createFile configPath with
        | Ok _ ->
          match Config.updateVersion configPath "local-binary" with
          | Ok _ -> Stdlib.Result.Result.Ok()
          | Error e -> Stdlib.Result.Result.Error e
        | Error e -> Stdlib.Result.Result.Error e
      | _ ->
        ... the Unix branch, which stays ...


// --- packages/darklang/cli/installation/uninstall.dark ----------------------------------

// `removeDarklangDirectory`:

  match host.os with
  | Windows ->
    Stdlib.Cli.PowerShell.removeFile darklangDir
  | Linux | MacOS ->
    Stdlib.Cli.Unix.removeDirectory darklangDir

// `runUninstall`:

  match host.os with
  | Windows ->
    let result =
      (Stdlib.Cli.PowerShell.deleteAlias "dark")
      |> Stdlib.Result.andThen (fun _ -> removeDarklangDirectory host)

    match result with
    | Ok _ -> Stdlib.Result.Result.Ok()
    | Error err ->
      Stdlib.Result.Result.Error $"Error uninstalling dark: {err}"

  | Linux | MacOS ->
    ... the Unix branch, which stays ...


