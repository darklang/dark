/// Functions to interact with the `gunzip` CLI application
module Darklang.Stdlib.Cli.Gunzip


/// Unzip a file to a specified destination path
let unzipToFile
  (inputFilePath: String)
  (outputFilePath: String)
  : Stdlib.Result.Result<Unit, String> =
  Stdlib.Cli.executeWithUnitOrStdErr
    $"gunzip -c {inputFilePath} > {outputFilePath}"
// MOVED: nothing called it, and the one place that gunzips (cli/installation/download.dark)
// inlines `gunzip -c '{from}' > '{to}' && chmod +x '{to}'` instead. The inline version is the
// better code of the two: it QUOTES its paths, and this wrapper does not, so routing the update
// path through it would have introduced a bug for any path with a space in it. If it comes back,
// quote the interpolations first.
