module Darklang.LanguageTools.LspServer.CursorPosition


type ThingAtPosition =
  | Keyword(keywordName: String)
  | ModuleName(String, description: Stdlib.Option.Option<String>)
  | SubModuleName(
    fqName: String,
    description: Stdlib.Option.Option<String>)
  | FnName(String, description: Stdlib.Option.Option<String>)
  | TraitName(String, description: Stdlib.Option.Option<String>)
  | PackageValue(
    fqName: List<String>,
    value: ProgramTypes.PackageValue.PackageValue,
    description: Stdlib.Option.Option<String>)
  | BuiltinFn(
    signature: String,
    description: Stdlib.Option.Option<String>)
  | PackageFn(
    fqName: List<String>,
    fn: ProgramTypes.PackageFn.PackageFn,
    description: Stdlib.Option.Option<String>)
  | BuiltinType(
    signature: String,
    description: Stdlib.Option.Option<String>)
  | PackageType(
    fqName: List<String>,
    typ: ProgramTypes.PackageType.PackageType,
    description: Stdlib.Option.Option<String>)
  | Variable(String, description: Stdlib.Option.Option<String>)
  | Operator(description: String)
  | EnumCase(String, description: Stdlib.Option.Option<String>)
  | FieldName(String, description: Stdlib.Option.Option<String>)
  | Parameter(
    name: String,
    typ: String,
    description: Stdlib.Option.Option<String>)
  | TypeParameter(description: Stdlib.Option.Option<String>)
  | EnumLabel(description: Stdlib.Option.Option<String>)


let wordUnderCursor
  (text: String)
  (cursorPosition: LanguageServerProtocol.Position.Position)
  : String =
  // `fromUInt64` is total now that `Int` is arbitrary-precision, so there's
  // no `Option` to unwrap.
  let line = cursorPosition.line |> Stdlib.Int.fromUInt64
  let character = cursorPosition.character |> Stdlib.Int.fromUInt64

  let currentLine =
    text
    |> Stdlib.String.split "\n"
    |> Stdlib.List.getAt line
    |> Stdlib.Option.withDefault ""

  let lineToCursor =
    currentLine |> Stdlib.String.slice 0 character

  lineToCursor
  |> Stdlib.String.split " "
  |> Stdlib.List.last
  |> Stdlib.Option.withDefault ""


/// Check if the position falls within the node's range
let checkIfPositionWithinRange
  (position: LanguageServerProtocol.Position.Position)
  (range: WrittenTypes.Range)
  : Stdlib.Option.Option<WrittenTypes.Range> =
  let line = position.line |> Stdlib.Int.fromUInt64
  let character = position.character |> Stdlib.Int.fromUInt64

  let rangeStartLine = range.start.row
  let rangeEndLine = range.end_.row
  let rangeStartCharacter = range.start.column
  let rangeEndCharacter = range.end_.column

  if
    line == rangeStartLine
    && character >= rangeStartCharacter
    && character <= rangeEndCharacter
  then
    Stdlib.Option.Option.Some(range)
  else
    Stdlib.Option.Option.None


let isLineNumberInRange
  (position: LanguageServerProtocol.Position.Position)
  (range: WrittenTypes.Range)
  : Bool =
  let line = position.line |> Stdlib.Int.fromUInt64
  let rangeStartLine = range.start.row
  let rangeEndLine = range.end_.row
  line >= rangeStartLine && line <= rangeEndLine