/// Callers that read integer fields from provider JSON refuse a non-integer.
test integerCallers =
  Stdlib.Test.all
    [ Darklang.WIP.AI.OpenAI.Chat.parseUsage
        [ ("completion_tokens_details",
           Json.Object [ ("reasoning_tokens", Json.Float 1.5) ]) ]
      |> Stdlib.Test.equal (Error "Invalid JSON integer field: reasoning_tokens")
      Darklang.WIP.AI.Anthropic.Chat.parseResponse
        (Json.Object
          [ ("usage",
             Json.Object [ ("cache_creation_input_tokens", Json.Float 1.5) ]) ])
      |> Stdlib.Test.equal (
        Error "Invalid JSON integer field: cache_creation_input_tokens"
      )
      largeRequestMaxTokens () |> Stdlib.Test.equal (Ok 9007199254740992) ]
