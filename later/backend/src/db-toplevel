// ---- packages/darklang/prettyPrinter/programTypes.dark ----
// sat just after customType
let db
  (ctx: Context)
  (db: LanguageTools.ProgramTypes.DB)
  : String =
  let versionPart =
    if db.version == 0l then
      ""
    else
      $"_v{Stdlib.toString db.version}"

  let doc =
    Stdlib.Pretty.hang
      2
      (Stdlib.Pretty.text $"type {db.name}{versionPart} =")
      [ typeReferenceDoc ctx db.typ ]
  Stdlib.Pretty.render ctx.width doc

