<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Publishing configuration -->
    <IsPublishable>false</IsPublishable>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Prelude/Prelude.fsproj" />
    <ProjectReference Include="../LibExecution/LibExecution.fsproj" />
    <ProjectReference Include="../LibSerialization/LibSerialization.fsproj" />
    <ProjectReference Include="../LibConfig/LibConfig.fsproj" />
    <ProjectReference Include="../LibDB/LibDB.fsproj" />
  </ItemGroup>
  <!-- The molt inverted this list, and an earlier version of it would have failed at MSBuild on a
       missing file and then compiled nothing. The two files it used to name, Config.fs and File.fs,
       did NOT come here: they stayed in the live tree, rehomed as backend/src/LibConfig/Dirs.fs and
       backend/src/LibConfig/File.fs. The three below are the ones actually sitting beside this
       file, in the compile order they had. If Config.fs and File.fs are ever wanted back under this
       project, take them from LibConfig and put them first, which is where they were. -->
  <ItemGroup>
    <Compile Include="Account.fs" />
    <Compile Include="Serialize.fs" />
    <Compile Include="Toplevels.fs" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>