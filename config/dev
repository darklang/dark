# Root directories
DARK_CONFIG_ROOT_DIR=/home/dark/app
DARK_CONFIG_RUNDIR=/home/dark/app/rundir

# DB
DARK_CONFIG_DB_NAME=data.db

# Http
DARK_CONFIG_TEST_HTTPCLIENT_SERVER_PORT=10030
DARK_CONFIG_HTTPCLIENT_TIMEOUT_IN_MS=10000

# Serialization
DARK_CONFIG_SERIALIZATION_GENERATE_TEST_DATA=y

# Logging
DARK_CONFIG_ENV_DISPLAY_NAME=dev
DARK_CONFIG_DEFAULT_LOGGER=console

# Feature flag defaults
# Recording is OFF in a shipped binary until somebody asks for it, and ON here: a clone is
# where you want `dark traces` to have your own morning in it. Bounded by retention
# (`trace.keep`, `trace.maxMb`). `dark --no-trace <command>` opts one command out, and a stored
# `trace.record` in your own store beats this line.
DARK_CONFIG_TRACE_DETAIL=on

# Package source: "disk" (reload from .dark files) or "seed" (fetch from R2)
# Default: disk (set to "seed" to use the seed-based flow)
DARK_CONFIG_PACKAGES_SOURCE=disk

