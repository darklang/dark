module Darklang.Internal.Test

type WTTest =
  { name: String
    lineNumber: Int64
    actual: LanguageTools.WrittenTypes.Expr
    expected: LanguageTools.WrittenTypes.Expr }


type PTTest =
  { name: String
    lineNumber: Int64
    actual: LanguageTools.ProgramTypes.Expr
    expected: LanguageTools.ProgramTypes.Expr }


let parseTest(pf: LanguageTools.WrittenTypes.ParsedFile): Result<WTTest, String> =
  let exprsToEval =
    match pf with
    | SourceFile(s) -> s.exprsToEval
    | _ -> []

  match exprsToEval with
  | [] -> Result.Error("no exprs to eval")
  | [_, _, ...] -> Result.Error("expected exactly one expr to eval")
  | [e] ->
    match e with
    | EInfix(r, _, actual, expected) ->
      WTTest { name = "test", lineNumber = r.start.row, actual = actual, expected = expected }
      |> Result.Ok
    | _ -> Result.Error("expected x = y format")


let parseSingleTestFromFile(filename: String, testSource: String): Result<PTTest, String> =
  match testSource |> LanguageTools.Parser.Parse.initialParse with
  | Error(e) -> Result.Error(LanguageTools.Parser.Parse.ParseError.toString(e))
  | Ok(parsedFile) ->
    match parseTest(parsedFile) with
    | Error(e) -> Result.Error(e)
    | Ok(wtTest) ->
      let lineNumber = wtTest.lineNumber
      let pm = LanguageTools.PackageManager.pm()
      let ctx =
        LanguageTools.NameResolver.NRContext
          { onMissing = LanguageTools.NameResolver.OnMissing.ThrowError
            pm = pm
            branchId = SCM.Branch.mainBranchId
            owner = ""
            currentModule = [] }

      let context =
        LanguageTools.WrittenTypesToProgramTypes.Context
          { currentFnName = Option.None, argMap = Stdlib.Dict.empty, localBindings = [] }

      let (actual, _unres) =
        LanguageTools.WrittenTypesToProgramTypes.Expr.toPT(ctx, context, wtTest.actual)

      let (expected, _unres) =
        LanguageTools.WrittenTypesToProgramTypes.Expr.toPT(ctx, context, wtTest.expected)

      PTTest { name = "test", lineNumber = lineNumber, actual = actual, expected = expected }
      |> Result.Ok
