/// LLM Model Registry
/// Pre-defined models with typed access for autocomplete and compile-time safety.
///
/// Usage:
///   Models.Anthropic.sonnet45  // Claude Sonnet 4.5
///   Models.OpenAI.gpt4o        // GPT-4o
///   Models.Local.llama3        // Local Ollama model
module Darklang.LLM.Models


// MODEL DEFINITION

/// A model configuration with provider information
type Model =
  { /// Model identifier to send to the API (e.g., "claude-sonnet-4-5-20250929")
    id: String

    /// Human-readable name (e.g., "Claude Sonnet 4.5")
    name: String

    /// Provider identifier (e.g., "anthropic", "openai", "ollama")
    providerId: String

    /// Maximum context window in tokens
    contextTokens: Int

    /// Maximum output tokens
    outputTokens: Int }


// ANTHROPIC MODELS
// Current Claude models from https://platform.claude.com/docs/en/about-claude/models

let anthropicModel (id: String) (name: String) (outputTokens: Int) : Model =
  Model
    { id = id
      name = name
      providerId = "anthropic"
      contextTokens = 200000
      outputTokens = outputTokens }

module Anthropic =
  // Claude 4.6 (newest, most capable - February 2026)
  val opus46 = anthropicModel "claude-opus-4-6" "Claude Opus 4.6" 128000
  val sonnet46 = anthropicModel "claude-sonnet-4-6" "Claude Sonnet 4.6" 64000

  // Claude 4.5 family
  val opus45 = anthropicModel "claude-opus-4-5-20251101" "Claude Opus 4.5" 64000
  val sonnet45 = anthropicModel "claude-sonnet-4-5-20250929" "Claude Sonnet 4.5" 64000
  val haiku45 = anthropicModel "claude-haiku-4-5-20251001" "Claude Haiku 4.5" 64000

  // Claude 4 family
  val sonnet4 = anthropicModel "claude-sonnet-4-20250514" "Claude Sonnet 4" 64000
  val opus4 = anthropicModel "claude-opus-4-20250514" "Claude Opus 4" 32000

  // Claude 3.7
  val sonnet37 = anthropicModel "claude-3-7-sonnet-20250219" "Claude Sonnet 3.7" 64000

  // Claude 3 (legacy)
  val haiku3 = anthropicModel "claude-3-haiku-20240307" "Claude Haiku 3" 4096

  /// Balanced: good balance of speed/quality (Sonnet 4.6 - latest)
  val balanced = sonnet46

  /// Fast: optimized for speed and cost
  val fast = haiku45

  /// Smart: most capable for complex reasoning
  val smart = opus46


// OPENAI MODELS
// Current OpenAI models from https://platform.openai.com/docs/models

let openaiModel (id: String) (name: String) (contextTokens: Int) (outputTokens: Int) : Model =
  Model
    { id = id
      name = name
      providerId = "openai"
      contextTokens = contextTokens
      outputTokens = outputTokens }

module OpenAI =
  // GPT-4o family
  val gpt4o = openaiModel "gpt-4o" "GPT-4o" 128000 16384
  val gpt4oMini = openaiModel "gpt-4o-mini" "GPT-4o Mini" 128000 16384

  // O-series (reasoning models)
  val o1 = openaiModel "o1" "O1" 200000 100000
  val o1Mini = openaiModel "o1-mini" "O1 Mini" 128000 65536
  val o3Mini = openaiModel "o3-mini" "O3 Mini" 200000 100000

  // GPT-4 Turbo
  val gpt4Turbo = openaiModel "gpt-4-turbo" "GPT-4 Turbo" 128000 4096

  /// Balanced: good balance of speed/quality
  val balanced = gpt4o

  /// Fast: optimized for speed and cost
  val fast = gpt4oMini

  /// Smart: most capable for complex reasoning
  val smart = o1


// LOCAL MODELS (Ollama)
// Common models available through Ollama

let ollamaModel (id: String) (name: String) (contextTokens: Int) (outputTokens: Int) : Model =
  Model
    { id = id
      name = name
      providerId = "ollama"
      contextTokens = contextTokens
      outputTokens = outputTokens }

module Local =
  val llama3 = ollamaModel "llama3" "Llama 3 8B" 8192 4096
  val llama3_70b = ollamaModel "llama3:70b" "Llama 3 70B" 8192 4096
  val llama31 = ollamaModel "llama3.1" "Llama 3.1 8B" 128000 4096
  val llama32 = ollamaModel "llama3.2" "Llama 3.2 3B" 128000 4096
  val codellama = ollamaModel "codellama" "Code Llama" 16384 4096
  val mistral = ollamaModel "mistral" "Mistral 7B" 32768 4096
  val mixtral = ollamaModel "mixtral" "Mixtral 8x7B" 32768 4096
  val qwen25 = ollamaModel "qwen2.5" "Qwen 2.5" 128000 8192
  val deepseekCoder = ollamaModel "deepseek-coder" "DeepSeek Coder" 16384 4096

  /// Balanced local model
  val balanced = llama3


// CUSTOM MODEL FACTORY

/// Create a custom model for any OpenAI-compatible endpoint
let custom
  (providerId: String)
  (modelId: String)
  (contextTokens: Int)
  : Model =
  Model
    { id = modelId
      name = "Custom: " ++ modelId
      providerId = providerId
      contextTokens = contextTokens
      outputTokens = contextTokens / 4 }


// ENVIRONMENT-BASED MODEL SELECTION
//
// These must remain functions: provider selection belongs to the caller's
// environment, not the machine that built the package seed.

/// The balanced model for the configured provider.
/// Set DARKLANG_LLM_PROVIDER to "openai", "ollama", or "anthropic" (default).
let balanced () : Model =
  match Stdlib.Env.get "DARKLANG_LLM_PROVIDER" with
  | Some "openai" -> OpenAI.balanced
  | Some "ollama" -> Local.balanced
  | Some "local" -> Local.balanced
  | _ -> Anthropic.balanced


/// The fast model for the configured provider.
let fast () : Model =
  match Stdlib.Env.get "DARKLANG_LLM_PROVIDER" with
  | Some "openai" -> OpenAI.fast
  | Some "ollama" -> Local.balanced
  | Some "local" -> Local.balanced
  | _ -> Anthropic.fast


/// The most capable model for the configured provider.
let smart () : Model =
  match Stdlib.Env.get "DARKLANG_LLM_PROVIDER" with
  | Some "openai" -> OpenAI.smart
  | Some "ollama" -> Local.llama3_70b
  | Some "local" -> Local.llama3_70b
  | _ -> Anthropic.smart
