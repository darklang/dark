/// `dark compile <fn>`: write a native executable of a package fn with the Darklang compiler
/// (darklang/compiler) that runs as `dark run <fn>` does. `dark compile --run <expression>`:
/// compile an expression, run it and print what it prints, as `dark eval` does. Package items
/// are read from this instance's main branch through `Darklang.Compiler.PackageServer`,
/// served on a free loopback port for as long as the compile takes.
module Darklang.Cli.Compile

let div(a: Int64, b: Int64): Int64 =
  Stdlib.Int64.checkedDivide(a, b) |> Stdlib.Result.withDefault(0)


/// "0.4 s", "2.4 s", "81 s".
let seconds(ms: Int64): String =
  if ms >= 10000 then
    $"{Stdlib.display(div(ms, 1000))} s"
  else
    let tenths = div(ms, 100)
    $"{Stdlib.display(div(tenths, 10))}.{Stdlib.display(tenths - div(tenths, 10) * 10)} s"


val preparing = "Preparing the compiler's stdlib"


/// Before darkc builds its stdlib cache, ask; with nobody to ask, go ahead and say so.
let confirmStdlib(verbosity: Int64): Bool =
  if Stdlib.Cli.UI.Prompt.canAsk() then
    Stdlib.printError(
      "The first compile prepares the compiler's stdlib: about a minute and 150 MB. Continue? [Y/n] ")

    match Stdlib.Cli.Stdin.checkedReadLine() with
    | Ok(Some(typed)) ->
      let answer = Stdlib.String.toLowercase(Stdlib.String.trim(typed))
      answer == "" || answer == "y" || answer == "yes"
    | _ -> false
  else
    if verbosity >= 0 then
      Stdlib.printErrorLine($"{preparing} (once per compiler: about a minute and 150 MB).")
    else
      ()

    true


/// Wait for <param run>, counting seconds on stderr until the stdlib cache appears.
let waitShowingProgress(
  run: Stdlib.Exec.Handle<Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error>>,
  started: Int64)
  : Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
  match Stdlib.Exec.awaitWithin(1000, run) with
  | Some(result) ->
    Stdlib.printError("\r\x1b[K")
    result
  | None ->
    if Compiler.Darkc.stdlibPrepared() then
      Stdlib.printError("\r\x1b[K")
      Stdlib.Exec.await(run)
    else
      Stdlib.printError(
        $"\r{preparing}... {Stdlib.display(div(Telemetry.elapsedMs(started), 1000))} s")

      waitShowingProgress(run, started)


let runCompiler(
  args: List<String>,
  verbosity: Int64,
  preparingStdlib: Bool)
  : Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
  let compiler = Compiler.Darkc.path()
  if preparingStdlib && verbosity >= 0 && Stdlib.Cli.Sys.isTerminal(2) then
    let run = Stdlib.Exec.spawn(fun () -> Stdlib.Cli.Process.run(compiler, args))
    waitShowingProgress(run, Telemetry.now())
  else
    Stdlib.Cli.Process.run(compiler, args)


/// Serve this instance's packages on a random high port, retrying a few ports when one is
/// taken. `serve` only returns if it could not bind, so a server still running after a
/// second is listening. (`HttpClient` refuses loopback addresses, so it cannot be asked.)
let startServer(
  token: String,
  attempts: Int64)
  : Result<(Stdlib.Exec.Handle<Result<Unit, String>> * Int64), String> =
  let port = Stdlib.Int64.random(49152, 65535)
  match Stdlib.Net.Port.fromInt64(port) with
  | Error(e) -> Result.Error(Stdlib.display(e))
  | Ok(p) ->
    let defaults = Stdlib.HttpServer.Config.defaults(p)
    let config = { defaults with middleware = [ Stdlib.HttpServer.Middleware.standardHeaders() ] }
    let server =
      Stdlib.Exec.spawn(fun () ->
        Stdlib.HttpServer.serve(
          config,
          (fun req -> Compiler.PackageServer.guardedRouter(token, req)),
          fun () -> ()))

    match Stdlib.Exec.awaitWithin(1000, server) with
    | None -> Result.Ok((server, port))
    | Some(Error(e)) ->
      if attempts > 1 then
        startServer(token, attempts - 1)
      else
        Result.Error($"The package server could not start: {e}")
    | Some(Ok(_)) -> Result.Error("The package server stopped before the compile.")


/// Why compiling can't start here, before anything is served or run.
let unavailable(): Option<String> =
  match Compiler.Darkc.unsupportedHost() with
  | Some(host) ->
    Option.Some(
      $"dark compile isn't available on {host}. The compiler runs on Linux x86-64 and arm64, and macOS arm64.")
  | None ->
    let compiler = Compiler.Darkc.path()
    if Stdlib.Cli.File.exists(compiler) then
      Option.None
    else
      Option.Some($"No compiler at {compiler}. Build the pinned one with scripts/compiler/build.")


/// Run darkc on <param job> while this instance's packages are served to it.
let withServer(
  job: Compiler.Darkc.Job,
  verbosity: Int64)
  : Result<Stdlib.Cli.Process.Output, String> =
  match unavailable() with
  | Some(message) -> Result.Error(message)
  | None ->
    let preparingStdlib = Stdlib.Bool.not(Compiler.Darkc.stdlibPrepared())
    if preparingStdlib && Stdlib.Bool.not(confirmStdlib(verbosity)) then
      Result.Error("Not compiling.")
    else
      // darkc sends the URL's user and password as basic auth on every request
      let token = Stdlib.String.replaceAll(Stdlib.display(Stdlib.Uuid.generate()), "-", "")
      match startServer(token, 5) with
      | Error(e) -> Result.Error(e)
      | Ok((server, port)) ->
        if verbosity > 0 then
          Stdlib.printErrorLine($"serving packages on 127.0.0.1:{Stdlib.display(port)}")
          Stdlib.printErrorLine($"running {Compiler.Darkc.path()}")
        else
          ()

        let invocation =
          Compiler.Darkc.Invocation
            { job = job
              verbosity = verbosity
              packageServer = $"http://dark:{token}@127.0.0.1:{Stdlib.display(port)}" }

        let result =
          runCompiler(Compiler.Darkc.arguments(invocation), verbosity, preparingStdlib)
          |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))

        let _ = Stdlib.Exec.stop(server, Stdlib.Exec.Stop.Kill)
        // darkc names the URL when a fetch fails
        result
        |> Stdlib.Result.map(fun output ->
          { output with stderr = Stdlib.String.replaceAll(output.stderr, $"dark:{token}@", "") })


/// The package fn <param name> as an executable's entry, or why it can't be one. Takes and
/// returns what `dark run <fn>` takes and returns.
let entry(name: String): Result<Run.Entry, String> =
  let branchId = Compiler.PackageServer.branchId
  match Run.entry(branchId, name) with
  | Error(NoFn) -> Result.Error($"No package fn named {name}.")
  | Error(OtherParameters(shown)) ->
    Result.Error(
      $"{name} takes ({shown}); an executable's fn takes List<String> or nothing, as for `dark run`.")
  | Ok(found) ->
    match found.returnType with
    | Some(typ) when Stdlib.Bool.not(Run.givesExitCode(typ)) ->
      let ctx = Packages.Signatures.rootContext(branchId, [])
      let shown = PrettyPrinter.ProgramTypes.typeReference(ctx, typ)
      Result.Error(
        $"{name} returns {shown}; an executable's fn returns Int64, the exit code, or Unit, as for `dark run`.")
    | _ -> Result.Ok(found)


/// Where an executable of <param name> goes with no `-o`: its last segment, here.
let defaultOutput(name: String): String =
  let leaf =
    Stdlib.String.split(name, ".")
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(name)

  $"./{leaf}"


/// Compile the package fn <param name> to an executable at <param output>.
let executable(
  name: String,
  output: String,
  verbosity: Int64)
  : Result<Stdlib.Cli.Process.Output, String> =
  let started = Telemetry.now()
  if Stdlib.Cli.FileSystem.isDirectory(output) then
    Result.Error($"{output} is a directory. Give -o a file to write.")
  else
    entry(name)
    |> Stdlib.Result.andThen(fun found ->
      withServer(Compiler.Darkc.Job.Executable(found.hash, output), verbosity))
    |> Stdlib.Result.map(fun result ->
      if result.exitCode == 0 && verbosity >= 0 then
        let size =
          Stdlib.Cli.File.size(output)
          |> Stdlib.Result.map(fun n -> $" ({Text.bytes(n)})")
          |> Stdlib.Result.withDefault("")

        { result with
            stderr =
              result.stderr + $"wrote {output}{size} in {seconds(Telemetry.elapsedMs(started))}\n" }
      else
        result)


let checkLine(report: Compiler.Darkc.CheckReport): String =
  if report.status == "compiles" then
    $"{report.name}: compiles"
  else
    $"{report.name}: can't compile: {report.error}"


/// Whether each package fn or value in <param names> compiles, and why not.
let check(names: List<String>, _json: Bool): Result<Stdlib.Cli.Process.Output, String> =
  withServer(Compiler.Darkc.Job.Check(names), -1)
  |> Stdlib.Result.map(fun output ->
    let reports = Compiler.Darkc.parseCheckReports(output.stdout)
    let lines = reports |> Stdlib.List.map(checkLine)
    { output with
        exitCode =
          if Stdlib.List.all(reports, fun r -> r.status == "compiles") then
            output.exitCode
          else
            1
        stdout = Stdlib.String.join(lines, "\n") + "\n" })


/// What the command line asks for, once the verbosity flags are taken out.
type Request =
  | Executable(name: String, output: String)
  | Run(expr: String)
  | Check(names: List<String>, json: Bool)


val usage = "Usage: compile <fn> [-o <file>] | compile --run <expression> | compile --check <fn>..."


let parse(args: List<String>): Result<Request, String> =
  match args with
  | ["--run", expr] -> Result.Ok(Request.Run(expr))
  | ["--check"] -> Result.Error("Usage: compile --check <fn>...")
  | ["--check", ...names] -> Result.Ok(Request.Check(names, false))
  | [name] when Stdlib.Bool.not(Stdlib.String.startsWith(name, "-")) ->
    Result.Ok(Request.Executable(name, defaultOutput(name)))
  | [name, "-o", output] -> Result.Ok(Request.Executable(name, output))
  | ["-o", output, name] -> Result.Ok(Request.Executable(name, output))
  | _ -> Result.Error(usage)


let verbosityFlag(arg: String): Option<Int64> =
  match arg with
  | "-q" -> Option.Some(-1)
  | "-v" -> Option.Some(1)
  | "-vv" -> Option.Some(2)
  | "-vvv" -> Option.Some(3)
  | _ -> Option.None


let withoutVerbosity(args: List<String>): List<String> =
  args |> Stdlib.List.filter(fun a -> Stdlib.Option.isNone(verbosityFlag(a)))


/// <param args> without the verbosity flags, and the level they ask for. `--run`'s
/// expression is left alone, whatever it looks like.
let verbosityOf(args: List<String>): (List<String> * Int64) =
  let (flags, rest) =
    match args with
    | ["--run", expr, ...after] ->
      (after, Stdlib.List.concat([ "--run", expr ], withoutVerbosity(after)))
    | _ -> (args, withoutVerbosity(args))

  let level =
    flags
    |> Stdlib.List.filterMap(fun a -> verbosityFlag(a))
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(0)

  (rest, level)


let execute(state: AppState, args: List<String>): AppState =
  let (rest, verbosity) = verbosityOf(args)
  let result =
    parse(rest)
    |> Stdlib.Result.andThen(fun request ->
      match request with
      | Executable(name, output) -> executable(name, output, verbosity)
      | Run(expr) -> withServer(Compiler.Darkc.Job.Run(expr), verbosity)
      | Check(names, json) -> check(names, json))

  match result with
  | Ok(output) ->
    Stdlib.print(output.stdout)
    if Stdlib.String.isEmpty(output.stderr) then
      ()
    else
      Stdlib.printError(output.stderr)

    { state with exitCode = output.exitCode }
  | Error(message) ->
    printErr(message)
    { state with exitCode = 1 }


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Compile a package fn to a native executable with the Darklang compiler. Experimental."
    ""
    "Usage: compile <fn>                    write an executable named after the fn: ./wc"
    "       compile <fn> -o <file>          write it to <file>"
    "       compile --run <expression>      compile an expression, run it, print what it prints"
    "       compile --check <fn>...         does each fn compile, and if not, why not"
    ""
    "The fn is what `dark run <fn>` runs: it takes List<String>, the command-line"
    "arguments, or nothing, and returns Int64, the exit code, or Unit. `./wc a b` does"
    "what `dark run Me.Tools.wc a b` does. `--run` prints what `dark eval` prints."
    "Package fns come from this instance's main branch."
    ""
    "An executable runs with the access of whoever runs it: it checks no permission"
    "policy, and has no store, traces or DB."
    ""
    "Options:"
    "  -q              nothing on stderr"
    "  -v, -vv, -vvv   also what the compiler did, each pass's time, each intermediate form"
    ""
    "See docs/compile.md."
    ""
    "Example:"
    "  compile Me.Tools.wc"
    "  compile Me.Tools.wc -o bin/wc"
    "  compile --run 'Stdlib.English.toOrdinal(22)'"
    "  compile --check Stdlib.English.toOrdinal Stdlib.Decimal.scale" ]
  |> Stdlib.String.join("\n")
