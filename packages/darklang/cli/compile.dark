/// `dark compile <fn>`: write a native executable of a package fn with the Darklang compiler
/// (darklang/compiler) that runs as `dark run <fn>` does. `dark compile --run <expression>`:
/// compile an expression, run it and print what it prints, as `dark eval` does. Package items
/// are read from this instance's main branch through `Darklang.Compiler.PackageServer`,
/// served on a free loopback port for as long as the compile takes.
module Darklang.Cli.Compile

let div(a: Int64, b: Int64): Int64 =
  Stdlib.Int64.checkedDivide(a, b) |> Stdlib.Result.withDefault(0)


/// "0.4 s", "2.4 s", "81 s".
let seconds(ms: Int64): String =
  if ms >= 10000 then
    $"{Stdlib.display(div(ms, 1000))} s"
  else
    let tenths = div(ms, 100)
    $"{Stdlib.display(div(tenths, 10))}.{Stdlib.display(tenths - div(tenths, 10) * 10)} s"


val preparing = "Preparing the compiler's stdlib"


/// " It needs about 6 GB of memory, and 2.1 GB is free." when that's so.
let memoryNote(): String =
  match Compiler.Prepare.availableMemory() with
  | Some(bytes) when bytes < Compiler.Prepare.memoryNeeded ->
    let tenths = div(bytes, 100000000)
    $" It needs about 6 GB of memory, and {Stdlib.display(div(tenths, 10))}.{Stdlib.display(tenths - div(tenths, 10) * 10)} GB is free."
  | _ -> ""


/// Before darkc builds its stdlib cache, ask; with nobody to ask, go ahead and say so.
let confirmStdlib(verbosity: Int64): Bool =
  if Stdlib.Cli.UI.Prompt.canAsk() then
    Stdlib.printError(
      $"The first compile prepares the compiler's stdlib: about a minute and 150 MB.{memoryNote()} Continue? [Y/n] ")

    match Stdlib.Cli.Stdin.checkedReadLine() with
    | Ok(Some(typed)) ->
      let answer = Stdlib.String.toLowercase(Stdlib.String.trim(typed))
      answer == "" || answer == "y" || answer == "yes"
    | _ -> false
  else
    if verbosity >= 0 then
      Stdlib.printErrorLine(
        $"{preparing} (once per compiler: about a minute and 150 MB).{memoryNote()}")
    else
      ()

    true


/// Wait for <param run>, counting seconds after <param label> on stderr until the stdlib
/// cache appears.
let waitShowingProgress(
  run: Stdlib.Exec.Handle<Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error>>,
  label: String,
  started: Int64)
  : Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
  match Stdlib.Exec.awaitWithin(1000, run) with
  | Some(result) ->
    Stdlib.printError("\r\x1b[K")
    result
  | None ->
    if Compiler.Darkc.stdlibPrepared() then
      Stdlib.printError("\r\x1b[K")
      Stdlib.Exec.await(run)
    else
      Stdlib.printError($"\r{label}... {Stdlib.display(div(Telemetry.elapsedMs(started), 1000))} s")
      waitShowingProgress(run, label, started)


let runCompiler(
  args: List<String>,
  verbosity: Int64,
  preparingStdlib: Bool)
  : Result<Stdlib.Cli.Process.Output, Stdlib.Cli.Posix.Error> =
  // under the lock a background preparation takes, so the two never both prepare
  let (program, programArgs) =
    if preparingStdlib && Compiler.Prepare.isLinux() then
      let _ = Stdlib.Cli.Dir.createRecursive(Compiler.Darkc.cacheDir())
      ("flock", Stdlib.List.concat([ Compiler.Prepare.lockPath(), Compiler.Darkc.path() ], args))
    else
      (Compiler.Darkc.path(), args)

  if preparingStdlib && verbosity >= 0 && Stdlib.Cli.Sys.isTerminal(2) then
    let run = Stdlib.Exec.spawn(fun () -> Stdlib.Cli.Process.run(program, programArgs))
    waitShowingProgress(run, preparing, Telemetry.now())
  else
    Stdlib.Cli.Process.run(program, programArgs)


/// When the stdlib is being prepared in the background, wait for it.
let waitForBackground(verbosity: Int64): Unit =
  if Compiler.Prepare.running() then
    let wait = fun () -> Stdlib.Cli.Process.run("flock", [ Compiler.Prepare.lockPath(), "true" ])
    if verbosity >= 0 && Stdlib.Cli.Sys.isTerminal(2) then
      let _ =
        waitShowingProgress(
          Stdlib.Exec.spawn(wait),
          "Waiting for the compiler's stdlib, preparing in the background",
          Telemetry.now())

      ()
    else
      let _ = wait()
      ()
  else
    ()


/// Serve this instance's packages on a random high port, retrying a few ports when one is
/// taken. `serve` only returns if it could not bind, so a server still running after a
/// second is listening. (`HttpClient` refuses loopback addresses, so it cannot be asked.)
let startServer(
  token: String,
  attempts: Int64)
  : Result<(Stdlib.Exec.Handle<Result<Unit, String>> * Int64), String> =
  let port = Stdlib.Int64.random(49152, 65535)
  match Stdlib.Net.Port.fromInt64(port) with
  | Error(e) -> Result.Error(Stdlib.display(e))
  | Ok(p) ->
    let defaults = Stdlib.HttpServer.Config.defaults(p)
    let config = { defaults with middleware = [ Stdlib.HttpServer.Middleware.standardHeaders() ] }
    let server =
      Stdlib.Exec.spawn(fun () ->
        Stdlib.HttpServer.serve(
          config,
          (fun req -> Compiler.PackageServer.guardedRouter(token, req)),
          fun () -> ()))

    match Stdlib.Exec.awaitWithin(1000, server) with
    | None -> Result.Ok((server, port))
    | Some(Error(e)) ->
      if attempts > 1 then
        startServer(token, attempts - 1)
      else
        Result.Error($"The package server could not start: {e}")
    | Some(Ok(_)) -> Result.Error("The package server stopped before the compile.")


/// Why compiling can't start here, before anything is served or run.
let unavailable(): Option<String> =
  match Compiler.Darkc.unsupportedHost() with
  | Some(host) ->
    Option.Some(
      $"dark compile isn't available on {host}. The compiler runs on Linux x86-64 and arm64, and macOS arm64.")
  | None ->
    let compiler = Compiler.Darkc.path()
    if Stdlib.Cli.File.exists(compiler) then
      Option.None
    else
      Option.Some($"No compiler at {compiler}. Build the pinned one with scripts/compiler/build.")


/// Why the stdlib can't be prepared on this disk, when it can't.
let lowDiskMessage(): Option<String> =
  match Compiler.Prepare.availableDisk() with
  | Some(bytes) when bytes < Compiler.Prepare.diskNeeded ->
    Option.Some(
      $"The first compile prepares the compiler's stdlib, which needs about 1 GB free in {Compiler.Darkc.directory()}, and {Text.bytes(bytes)} is free.")
  | _ -> Option.None


/// Run darkc on <param job> while this instance's packages are served to it.
let withServer(
  job: Compiler.Darkc.Job,
  verbosity: Int64)
  : Result<Stdlib.Cli.Process.Output, String> =
  match unavailable() with
  | Some(message) -> Result.Error(message)
  | None ->
    waitForBackground(verbosity)
    let preparingStdlib = Stdlib.Bool.not(Compiler.Darkc.stdlibPrepared())
    let lowDisk = if preparingStdlib then lowDiskMessage() else Option.None
    if Stdlib.Option.isSome(lowDisk) then
      Result.Error(Stdlib.Option.withDefault(lowDisk, ""))
    else if preparingStdlib && Stdlib.Bool.not(confirmStdlib(verbosity)) then
      Result.Error("Not compiling.")
    else
      // darkc sends the URL's user and password as basic auth on every request
      let token = Stdlib.String.replaceAll(Stdlib.display(Stdlib.Uuid.generate()), "-", "")
      match startServer(token, 5) with
      | Error(e) -> Result.Error(e)
      | Ok((server, port)) ->
        if verbosity > 0 then
          Stdlib.printErrorLine($"serving packages on 127.0.0.1:{Stdlib.display(port)}")
          Stdlib.printErrorLine($"running {Compiler.Darkc.path()}")
        else
          ()

        let invocation =
          Compiler.Darkc.Invocation
            { job = job
              verbosity = verbosity
              packageServer = $"http://dark:{token}@127.0.0.1:{Stdlib.display(port)}" }

        let result =
          runCompiler(Compiler.Darkc.arguments(invocation), verbosity, preparingStdlib)
          |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))

        let _ = Stdlib.Exec.stop(server, Stdlib.Exec.Stop.Kill)
        // darkc names the URL when a fetch fails
        result
        |> Stdlib.Result.map(fun output ->
          { output with stderr = Stdlib.String.replaceAll(output.stderr, $"dark:{token}@", "") })


/// The package fn <param name> as an executable's entry, or why it can't be one. Takes and
/// returns what `dark run <fn>` takes and returns, and does nothing only an instance can do.
let entry(name: String): Result<Run.Entry, String> =
  let branchId = Compiler.PackageServer.branchId
  match Run.entry(branchId, name) with
  | Error(NoFn) -> Result.Error($"No package fn named {name}.")
  | Error(OtherParameters(shown)) ->
    Result.Error(
      $"{name} takes ({shown}); an executable's fn takes List<String> or nothing, as for `dark run`.")
  | Ok(found) ->
    match found.returnType with
    | Some(typ) when Stdlib.Bool.not(Run.givesExitCode(typ)) ->
      let ctx = Packages.Signatures.rootContext(branchId, [])
      let shown = PrettyPrinter.ProgramTypes.typeReference(ctx, typ)
      Result.Error(
        $"{name} returns {shown}; an executable's fn returns Int64, the exit code, or Unit, as for `dark run`.")
    | _ ->
      match Compiler.Access.refusal(name, Compiler.Access.reasons(name, found.hash)) with
      | Some(message) -> Result.Error(message)
      | None -> Result.Ok(found)


/// The access approved for the executable of <param found>, written where darkc reads it, or
/// None when it needs nothing past what every executable has.
let approvedPolicy(
  accountID: Option<Uuid>,
  name: String,
  found: Run.Entry,
  output: String)
  : Result<Option<String>, String> =
  let hash =
    match found.hash with
    | Hash(h) -> h

  match Approval.decide(
          accountID,
          found.name,
          hash,
          output,
          Compiler.Access.reasons(name, found.hash)) with
  | Refused(message) -> Result.Error(message)
  | Approved(policy) when Stdlib.List.isEmpty(policy.allow) -> Result.Ok(Option.None)
  | Approved(policy) ->
    let path = Compiler.Darkc.policyPath(hash)
    let _ = Stdlib.Cli.Dir.createRecursive(Stdlib.Cli.Path.parent(path))
    Stdlib.Cli.File.writeText(path, Stdlib.Json.serialize<LanguageTools.Permissions.Policy>(policy))
    |> Stdlib.Result.map(fun _ -> Option.Some(path))
    |> Stdlib.Result.mapError(fun e -> $"Could not write {path}: {Stdlib.display(e)}")


/// What darkc's <param reason> means, as the end of a sentence.
let describeReason(diagnostic: Compiler.Darkc.Diagnostic): String =
  match diagnostic.reason with
  | MissingBuiltin(name) -> $"compiled code doesn't have {name}"
  | MissingFunction(name) -> $"the compiler can't find {name}"
  | MissingType(name) -> $"the compiler can't find the type {name}"
  | UnsupportedFeature(feature) -> $"compiled code doesn't support {feature} yet"
  | NeedsTypeArguments(_) -> "it needs type arguments to compile"
  | NotAnEntry -> "it isn't a program's fn"
  | EntryNotFound -> "the compiler couldn't read it"
  | Other(_) -> diagnostic.message


/// darkc's `--json` diagnostics on <param stderr> as text, or <param stderr> as it is.
let renderFailure(name: String, stderr: String): String =
  match Compiler.Darkc.parseDiagnostics(stderr) with
  | [] -> stderr
  | diagnostics ->
    let lines =
      diagnostics
      |> Stdlib.List.map(fun d ->
        let first = $"{name} can't be compiled yet: {describeReason(d)}."
        match d.path with
        | [] -> first
        | path -> $"{first}\n  {Stdlib.String.join(path, " -> ")}")

    Stdlib.String.join(lines, "\n") + "\n"


/// Where an executable of <param name> goes with no `-o`: its last segment, here.
let defaultOutput(name: String): String =
  let leaf =
    Stdlib.String.split(name, ".")
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(name)

  $"./{leaf}"


/// Compile the package fn <param name> to an executable at <param output>.
let executable(
  accountID: Option<Uuid>,
  name: String,
  output: String,
  verbosity: Int64)
  : Result<Stdlib.Cli.Process.Output, String> =
  let started = Telemetry.now()
  if Stdlib.Cli.FileSystem.isDirectory(output) then
    Result.Error($"{output} is a directory. Give -o a file to write.")
  else
    entry(name)
    |> Stdlib.Result.andThen(fun found ->
      approvedPolicy(accountID, name, found, output)
      |> Stdlib.Result.andThen(fun policy ->
        withServer(Compiler.Darkc.Job.Executable(found.hash, output, policy), verbosity)))
    |> Stdlib.Result.map(fun result ->
      if result.exitCode == 0 && verbosity >= 0 then
        let size =
          Stdlib.Cli.File.size(output)
          |> Stdlib.Result.map(fun n -> $" ({Text.bytes(n)})")
          |> Stdlib.Result.withDefault("")

        { result with
            stderr =
              result.stderr + $"wrote {output}{size} in {seconds(Telemetry.elapsedMs(started))}\n" }
      else if result.exitCode == 0 then
        result
      else
        { result with stderr = renderFailure(name, result.stderr) })


/// What `--check` says about one name.
type Verdict =
  | Compiles
  /// It reaches something only an instance has, or access compiled code can't limit yet.
  | Refused(blocker: Compiler.Access.Blocker, reasons: List<Compiler.Access.Reason>)
  | Fails(diagnostic: Option<Compiler.Darkc.Diagnostic>)
  | NotFound


type CheckRow =
  { name: String
    verdict: Verdict
    /// what the fn may do that an executable allows: may raise, reads the clock
    effects: List<Compiler.Access.Reason> }


/// <param name>'s row as far as the effect analysis answers it. A row left at `Compiles` goes
/// to darkc.
let precheck(name: String): CheckRow =
  let branchId = Compiler.PackageServer.branchId
  let location =
    LanguageTools.ProgramTypes.parsePackageLocation(TraceVerbs.canonicalFnName(branchId, name))

  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | None ->
    match LanguageTools.PackageManager.Value.find(branchId, location) with
    | Some(_) -> CheckRow { name = name, verdict = Verdict.Compiles, effects = [] }
    | None -> CheckRow { name = name, verdict = Verdict.NotFound, effects = [] }
  | Some(hash) ->
    let reasons = Compiler.Access.reasons(name, hash)
    let instance = Compiler.Access.blocking(reasons, Compiler.Access.Blocker.NeedsInstance)
    let unenforced = Compiler.Access.blocking(reasons, Compiler.Access.Blocker.NotEnforced)
    let allowed =
      reasons
      |> Stdlib.List.filter(fun r -> Stdlib.Option.isNone(Compiler.Access.blocker(r.effect)))

    if Stdlib.Bool.not(Stdlib.List.isEmpty(instance)) then
      CheckRow
        { name = name
          verdict = Verdict.Refused(Compiler.Access.Blocker.NeedsInstance, instance)
          effects = allowed }
    else if Stdlib.Bool.not(Stdlib.List.isEmpty(unenforced)) then
      CheckRow
        { name = name
          verdict = Verdict.Refused(Compiler.Access.Blocker.NotEnforced, unenforced)
          effects = allowed }
    else
      CheckRow { name = name, verdict = Verdict.Compiles, effects = allowed }


/// <param row> with darkc's answer for it.
let withReport(row: CheckRow, reports: List<Compiler.Darkc.CheckReport>): CheckRow =
  match row.verdict with
  | Compiles ->
    match reports |> Stdlib.List.findFirst(fun r -> r.name == row.name) with
    | Some(report) when report.status == "compiles" -> row
    | Some(report) -> { row with verdict = Verdict.Fails(report.diagnostic) }
    | None -> { row with verdict = Verdict.Fails(Option.None) }
  | _ -> row


let via(reason: Compiler.Access.Reason): String =
  // the path starts at the fn itself, which the row already names
  match reason.path with
  | [_, ...rest] when Stdlib.Bool.not(Stdlib.List.isEmpty(rest)) ->
    $"{Compiler.Access.describe(reason.effect)}, via {Stdlib.String.join(rest, " -> ")}"
  | _ -> Compiler.Access.describe(reason.effect)


let rowColumns(row: CheckRow): (String * String) =
  let effects =
    match row.effects with
    | [] -> "no effects"
    | reasons ->
      reasons
      |> Stdlib.List.map(via)
      |> Stdlib.String.join("; ")

  match row.verdict with
  | Compiles -> ("compiles", effects)
  | Refused(NeedsInstance, reasons) ->
    (
      "needs dark",
      reasons
      |> Stdlib.List.map(via)
      |> Stdlib.String.join("; "))
  | Refused(NotEnforced, reasons) ->
    (
      "not yet",
      reasons
      |> Stdlib.List.map(via)
      |> Stdlib.String.join("; "))
  | Fails(Some(diagnostic)) ->
    match diagnostic.path with
    | [_, ...rest] when Stdlib.Bool.not(Stdlib.List.isEmpty(rest)) ->
      ("not yet", $"{describeReason(diagnostic)}, via {Stdlib.String.join(rest, " -> ")}")
    | _ -> ("not yet", describeReason(diagnostic))
  | Fails(None) -> ("not yet", "the compiler said nothing about it")
  | NotFound -> ("not found", "no package fn or value by that name")


let pad(text: String, width: Int64): String =
  Stdlib.String.padEnd(text, ' ', width)


let checkLines(rows: List<CheckRow>): List<String> =
  let width =
    rows
    |> Stdlib.List.map(fun r -> Stdlib.String.length(r.name))
    |> Stdlib.List.fold(0, fun(acc, n) -> if n > acc then n else acc)

  rows
  |> Stdlib.List.map(fun row ->
    let (status, detail) = rowColumns(row)
    $"{pad(status, 12)}  {pad(row.name, width)}  {detail}")


/// One JSON object per name: `{name, status, detail}`.
type CheckJson =
  { name: String
    status: String
    detail: String }


let checkJsonLines(rows: List<CheckRow>): List<String> =
  rows
  |> Stdlib.List.map(fun row ->
    let (status, detail) = rowColumns(row)
    Stdlib.Json.serialize<CheckJson>(
      CheckJson { name = row.name, status = status, detail = detail }))


let checkOk(row: CheckRow): Bool =
  match row.verdict with
  | Compiles -> true
  | _ -> false


/// Whether each package fn or value in <param names> compiles, and why not. Fns that need an
/// instance are answered without starting darkc.
let check(names: List<String>, json: Bool): Result<Stdlib.Cli.Process.Output, String> =
  let rows = names |> Stdlib.List.map(precheck)

  let toCompiler =
    rows
    |> Stdlib.List.filter(checkOk)
    |> Stdlib.List.map(fun r -> r.name)

  let answered =
    match toCompiler with
    | [] -> Result.Ok(rows)
    | _ ->
      withServer(Compiler.Darkc.Job.Check(toCompiler), -1)
      |> Stdlib.Result.map(fun output ->
        let reports = Compiler.Darkc.parseCheckReports(output.stdout)
        rows |> Stdlib.List.map(fun row -> withReport(row, reports)))

  answered
  |> Stdlib.Result.map(fun rows ->
    let lines = if json then checkJsonLines(rows) else checkLines(rows)
    Stdlib.Cli.Process.Output
      { exitCode = if Stdlib.List.all(rows, checkOk) then 0 else 1
        stdout = Stdlib.String.join(lines, "\n") + "\n"
        stderr = "" })


/// What the command line asks for, once the verbosity flags are taken out.
type Request =
  | Executable(name: String, output: String)
  | Run(expr: String)
  | Check(names: List<String>, json: Bool)


val usage =
  "Usage: compile <fn> [-o <file>] | compile --run <expression> | compile --check [--json] <fn>..."


let parse(args: List<String>): Result<Request, String> =
  match args with
  | ["--run", expr] -> Result.Ok(Request.Run(expr))
  | ["--check"] | ["--check", "--json"] -> Result.Error("Usage: compile --check [--json] <fn>...")
  | ["--check", "--json", ...names] -> Result.Ok(Request.Check(names, true))
  | ["--check", ...names] -> Result.Ok(Request.Check(names, false))
  | [name] when Stdlib.Bool.not(Stdlib.String.startsWith(name, "-")) ->
    Result.Ok(Request.Executable(name, defaultOutput(name)))
  | [name, "-o", output] -> Result.Ok(Request.Executable(name, output))
  | ["-o", output, name] -> Result.Ok(Request.Executable(name, output))
  | _ -> Result.Error(usage)


let verbosityFlag(arg: String): Option<Int64> =
  match arg with
  | "-q" -> Option.Some(-1)
  | "-v" -> Option.Some(1)
  | "-vv" -> Option.Some(2)
  | "-vvv" -> Option.Some(3)
  | _ -> Option.None


let withoutVerbosity(args: List<String>): List<String> =
  args |> Stdlib.List.filter(fun a -> Stdlib.Option.isNone(verbosityFlag(a)))


/// <param args> without the verbosity flags, and the level they ask for. `--run`'s
/// expression is left alone, whatever it looks like.
let verbosityOf(args: List<String>): (List<String> * Int64) =
  let (flags, rest) =
    match args with
    | ["--run", expr, ...after] ->
      (after, Stdlib.List.concat([ "--run", expr ], withoutVerbosity(after)))
    | _ -> (args, withoutVerbosity(args))

  let level =
    flags
    |> Stdlib.List.filterMap(fun a -> verbosityFlag(a))
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(0)

  (rest, level)


let execute(state: AppState, args: List<String>): AppState =
  let (rest, verbosity) = verbosityOf(args)
  let result =
    parse(rest)
    |> Stdlib.Result.andThen(fun request ->
      match request with
      | Executable(name, output) -> executable(state.accountID, name, output, verbosity)
      | Run(expr) -> withServer(Compiler.Darkc.Job.Run(expr), verbosity)
      | Check(names, json) -> check(names, json))

  match result with
  | Ok(output) ->
    Stdlib.print(output.stdout)
    if Stdlib.String.isEmpty(output.stderr) then
      ()
    else
      Stdlib.printError(output.stderr)

    { state with exitCode = output.exitCode }
  | Error(message) ->
    printErr(message)
    { state with exitCode = 1 }


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let partial =
    match args with
    | [] -> Option.Some("")
    | [one] when Stdlib.Bool.not(Stdlib.String.startsWith(one, "-")) -> Option.Some(one)
    | ["--check", ...names] -> Stdlib.List.last(names)
    | _ -> Option.None

  match partial with
  | Some(text) ->
    Packages.Traversal.completePartialPath(
      state.currentBranchId,
      state.packageData.currentLocation,
      text)
  | None -> []


let help(_state: AppState): String =
  [ "Compile a package fn to a native executable with the Darklang compiler. Experimental."
    ""
    "Usage: compile <fn>                       write an executable named after the fn: ./wc"
    "       compile <fn> -o <file>             write it to <file>"
    "       compile --run <expression>         compile an expression, run it, print what it prints"
    "       compile --check [--json] <fn>...   does each fn compile, and if not, why not"
    ""
    "The fn is what `dark run <fn>` runs: it takes List<String>, the command-line"
    "arguments, or nothing, and returns Int64, the exit code, or Unit. `./wc a b` does"
    "what `dark run Me.Tools.wc a b` does. `--run` prints what `dark eval` prints."
    "Package fns come from this instance's main branch."
    ""
    "An executable has no store, traces or DB. It gets stdin, stdout, the clock and"
    "randomness; a fn that needs other access isn't compiled yet."
    ""
    "Options:"
    "  -q              nothing on stderr"
    "  -v, -vv, -vvv   also what the compiler did, each pass's time, each intermediate form"
    ""
    "See `dark docs compile`."
    ""
    "Example:"
    "  compile Me.Tools.wc"
    "  compile Me.Tools.wc -o bin/wc"
    "  compile --run 'Stdlib.English.toOrdinal(22)'"
    "  compile --check Stdlib.English.toOrdinal Stdlib.Decimal.scale" ]
  |> Stdlib.String.join("\n")
