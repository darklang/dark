module Darklang.Cli.Outliner.App

/// The outliner as a `Cli.Component`: a view, a key handler, and a save. The terminal lifecycle (start,
/// present, stop, resume) belongs to `Cli.Component`, not here.

let view(state: Main.State, size: Darklang.Stdlib.Cli.Tui.Size): Darklang.Stdlib.Cli.Tui.View =
  Main.viewAtSize(state, size)

let onKey(
  state: Main.State,
  key: Stdlib.Cli.Stdin.Key.Key,
  modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers,
  keyChar: Stdlib.Option.Option<String>)
  : Darklang.Cli.Component.Step<Main.State> =
  match Main.handleKey(state, key, modifiers, keyChar) with
  | Continue next -> Darklang.Cli.Component.Step.Stay next
  | Save next -> Darklang.Cli.Component.Step.Save next
  // Leaving the picker doesn't change persisted documents: every mutation already saved itself.
  | Exit next -> Darklang.Cli.Component.Step.Exit next

let save(state: Main.State): Main.State =
  Main.save(state)

/// A FUNCTION, not a `val`: a component holds lambdas, and a lambda cannot be stored. Its
/// instructions live in the execution that created it, so a stored one is a dangling reference that
/// dies when applied in a later process. Rebuilt per call instead.
let component(): Cli.Component.Component<Cli.Outliner.Main.State> =
  Darklang.Cli.Component.simple(view, onKey, save)


/// Flag values, with a default when the flag isn't there.
let flag(args: List<String>, name: String, fallback: String): String =
  let rec_ = args |> Stdlib.List.findFirstIndex(fun a -> a == $"--{name}")

  match rec_ with
  | None -> fallback
  | Some i ->
    match Stdlib.List.getAt(args, i + 1) with
    | Some v -> v
    | None -> fallback

/// The words that aren't flags or flag values.
let positional(args: List<String>): List<String> =
  args
  |> Stdlib.List.indexedMap(fun i a -> (i, a))
  |> Stdlib.List.filter(fun pair ->
    let (i, a) = pair
    let previous = Stdlib.List.getAt(args, i - 1) |> Stdlib.Option.withDefault("")

    (Stdlib.Bool.not(Stdlib.String.startsWith(a, "--")))
    && (Stdlib.Bool.not(Stdlib.String.startsWith(previous, "--"))))
  |> Stdlib.List.map(fun pair ->
    let (_i, a) = pair
    a)

/// CLI command: the subcommands, or the full-screen app.
let execute(cliState: Darklang.Cli.AppState, args: List<String>): Darklang.Cli.AppState =
  let words = positional(args)

  match words with
  | [] ->
    // Without a terminal there's nothing to drive, so say what's there rather than refusing. (The check is
    // the terminal's own, not `cliState.nonInteractive`, which only means "typed as `dark outliner`" and is
    // true even when there's a perfectly good terminal.)
    match Stdlib.Cli.Tui.TerminalSupport.current() with
    | Available -> Darklang.Cli.Component.launch(cliState, component(), Main.load())
    | Unavailable _reason -> Cli.exitWith(cliState, Commands.ls())
  | "ls" :: _ -> Cli.exitWith(cliState, Commands.ls())
  | [ "show" ] ->
    Cli.printErr("Usage: outliner show <document>")
    Cli.exitWith(cliState, false)
  | "show" :: name :: _ -> Cli.exitWith(cliState, Commands.show(name))
  | [ "add" ] ->
    Cli.printErr("Usage: outliner add <document> <text>")
    Cli.exitWith(cliState, false)
  | "add" :: name :: rest ->
    if Stdlib.List.isEmpty(rest) then
      Cli.printErr("Usage: outliner add <document> <text>")
      Cli.exitWith(cliState, false)
    else
      Cli.exitWith(cliState, Commands.add(name, Stdlib.String.join(rest, " ")))
  | other ->
    let word = Stdlib.List.head(other) |> Stdlib.Option.withDefault("")
    Cli.printErr($"outliner: unknown subcommand \"{word}\"")
    Stdlib.printErrorLine("Try: ls, show, add - or no arguments for the app.")
    Cli.exitWith(cliState, false)


/// CLI help text.
let help(_state: Darklang.Cli.AppState): String =
  [ "Usage: outliner"
    "Interactive tree outliner with multi-document support."
    ""
    "Navigate mode:"
    "  Up/Down      Move between lines"
    "  Left/Right   Fold, or step out to the parent / in to the first child"
    "  Home/End     First and last line"
    "  Enter        Edit the selected line"
    "  Tab          Indent (make child of previous sibling)"
    "  Shift+Tab    Outdent (move to parent's level)"
    "  o            New line below, O a new line underneath this one"
    "  x            Plain line -> task -> done -> plain"
    "  Space        Fold or unfold"
    "  Ctrl+Up      Move a line up among its siblings"
    "  Ctrl+Down    Move a line down among its siblings"
    "  Backspace    Delete a line (asks first, unless it's empty)"
    "  u / r        Undo, redo"
    "  /            Search this document; Esc clears the filter"
    "  e            Export this document"
    "  g            Back to the document list"
    "  Escape       Back to the document list"
    ""
    "Document picker:"
    "  Up/Down      Select document"
    "  Enter        Open selected document"
    "  n            Create new document"
    "  d            Delete selected document"
    "  r            Rename selected document"
    "  e            Export selected document"
    "  Escape       Exit to main CLI"
    ""
    "Edit mode:"
    "  Type         Insert characters"
    "  Left/Right   Move cursor, Home/End for the ends"
    "  Tab          Indent this line without leaving it"
    "  Up/Down      Keep editing, one line further"
    "  Enter        Finish this line and start the next"
    "  Esc          Finish editing (the text is kept; u undoes)"
    ""
    "Without a terminal:"
    "  outliner ls                              List documents"
    "  outliner show <doc>                      Print one as a tree"
    "  outliner add <doc> <text>                Append a line"
  ] |> Stdlib.String.join("\n")


/// Complete subcommands, then document names for the ones that take one.
let complete(
  _state: Darklang.Cli.AppState,
  args: List<String>)
  : List<Darklang.Cli.Completion.CompletionItem> =
  let item(value: String): Darklang.Cli.Completion.CompletionItem =
    Darklang.Cli.Completion.CompletionItem { value = value, display = value }

  match args with
  | [] -> [ "ls", "show", "add" ] |> Stdlib.List.map(item)
  | [ word ] ->
    [ "ls", "show", "add" ]
    |> Stdlib.List.filter(fun c -> Stdlib.String.startsWith(c, word))
    |> Stdlib.List.map(item)
  | verb :: _ ->
    if verb == "show" || verb == "add" then
      match Store.load() with
      | Loaded data -> data.documents |> Stdlib.List.map(fun d -> item(d.title))
      | Unreadable(_path, _reason) -> []
    else
      []
