/// Markdown in and out.
///
/// The shape we write is the shape every outliner writes: a `#` title, then a bullet per line, two spaces
/// of indent per level, and `- [ ]` / `- [x]` for the lines that are tasks. What we read is looser than
/// what we write, because the point of importing is to accept a file someone else made.
module Darklang.Cli.Outliner.Markdown

let bulletFor (mark: Mark) : String =
  match mark with
  | Plain -> "- "
  | Todo -> "- [ ] "
  | Done -> "- [x] "

let exportInto (outline: Outline) (ids: List<Int>) (depth: Int) (acc: List<String>) : List<String> =
  ids
  |> Stdlib.List.fold acc (fun soFar id ->
    let content = getContent outline id
    let indent = Stdlib.String.repeat "  " depth
    let line = $"{indent}{bulletFor content.mark}{content.text}"
    let withLine = Stdlib.List.push soFar line
    exportInto outline (getStructure outline id).children (depth + 1) withLine)

let export (doc: Document) : String =
  let lines = Stdlib.List.reverse (exportInto doc.outline doc.outline.rootChildren 0 [])
  Stdlib.String.join (Stdlib.List.flatten [ [ $"# {doc.title}"; "" ]; lines ]) "\n"


// --- Import ---

/// One parsed line: how deep it sits, what it says, and whether it's a task.
type Line =
  { depth: Int
    text: String
    mark: Mark }

/// Leading whitespace, counting a tab as one indent level (the two spaces we'd have written).
let indentWidth (line: String) : Int =
  // Widen tabs first, so a file indented with them lands at the same depths as one indented with spaces.
  let widened = Stdlib.String.replaceAll line "\t" "  "
  (Stdlib.String.length widened) - (Stdlib.String.length (Stdlib.String.trimStart widened))

/// Strip a bullet (`-`, `*`, `+`) and a checkbox, and say what was there.
let readMark (text: String) : (String * Mark) =
  let withoutBullet =
    if Stdlib.String.startsWith text "- " then Stdlib.String.dropFirst text 2
    else if Stdlib.String.startsWith text "* " then Stdlib.String.dropFirst text 2
    else if Stdlib.String.startsWith text "+ " then Stdlib.String.dropFirst text 2
    else text

  let lowered = Stdlib.String.toLowercase withoutBullet

  if Stdlib.String.startsWith lowered "[ ] " then
    (Stdlib.String.dropFirst withoutBullet 4, Mark.Todo)
  else if Stdlib.String.startsWith lowered "[x] " then
    (Stdlib.String.dropFirst withoutBullet 4, Mark.Done)
  else
    (withoutBullet, Mark.Plain)

let parseLine (raw: String) : Line =
  let (text, mark) = readMark (Stdlib.String.trim raw)
  Line { depth = Stdlib.Int.divide (indentWidth raw) 2; text = text; mark = mark }

/// Add one line to the outline being built, hanging it off the nearest shallower line.
///
/// `stack` is the trail of (depth, id) we're inside. Depths in a hand-written file skip around, so the
/// parent is "the last line shallower than this one", not "the line at depth - 1".
let importLine
  (outline: Outline)
  (stack: List<(Int * Int)>)
  (line: Line)
  : (Outline * List<(Int * Int)>) =
  let id = outline.nextId
  let withNode = setMark (addNode outline id line.text) id line.mark
  let trail = stack |> Stdlib.List.filter (fun pair ->
    let (d, _id) = pair
    d < line.depth)

  let parentId =
    Stdlib.List.last trail
    |> Stdlib.Option.map (fun pair ->
      let (_d, pid) = pair
      pid)

  let siblings = getChildren withNode parentId
  let placed = setChildren withNode parentId (Stdlib.List.append siblings [ id ])

  ({ placed with nextId = id + 1 }, Stdlib.List.append trail [ (line.depth, id) ])

let import (markdown: String) : Document =
  let lines = Stdlib.String.split markdown "\n"

  let title =
    match Stdlib.List.head lines with
    | Some first ->
      if Stdlib.String.startsWith first "# " then
        Stdlib.String.trim (Stdlib.String.dropFirst first 2)
      else
        "Imported"
    | None -> "Imported"

  let body =
    match Stdlib.List.head lines with
    | Some first -> if Stdlib.String.startsWith first "# " then Stdlib.List.drop lines 1 else lines
    | None -> []

  let parsed =
    body
    |> Stdlib.List.filter (fun line -> (Stdlib.String.trim line) != "")
    |> Stdlib.List.map parseLine

  let (outline, _stack) =
    parsed
    |> Stdlib.List.fold ((emptyOutline ()), []) (fun acc line ->
      let (soFar, stack) = acc
      importLine soFar stack line)

  Document { id = 0; title = title; outline = outline }
