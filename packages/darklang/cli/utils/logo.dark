 ▄▄▄        ▄▄▄▄▄▄
 """


let combineLogoAndText(logoStr: String, textLines: List<String>, color: String): String =
  let logoLines =
    (Stdlib.String.split(logoStr, "\n"))

  let maxLogoWidth =
    logoLines
    |> Stdlib.List.map(Stdlib.String.displayWidth)
    |> Stdlib.List.fold(0, fun(acc, len) -> if len > acc then len else acc)

  let paddedLogoLines =
    logoLines
    |> Stdlib.List.map(fun line ->
      let paddedLine = Stdlib.Text.padEndToWidth(line, maxLogoWidth)
      if Stdlib.String.isEmpty(Stdlib.String.trim(line)) then
        paddedLine
      else
        color + paddedLine + Stdlib.Cli.UI.Colors.reset)

  let logoHeight = Stdlib.List.length(paddedLogoLines)
  let textHeight = Stdlib.List.length(textLines)

  let targetHeight = if logoHeight > textHeight then logoHeight else textHeight

  let finalLogoLines =
    if logoHeight < targetHeight then
      let totalPadding = targetHeight - logoHeight
      let paddingTop = (totalPadding / 2)
      let paddingBottom = totalPadding - paddingTop
      let emptyLogoLine = Stdlib.String.repeat(" ", maxLogoWidth)
      let topEmpty = Stdlib.List.repeat(paddingTop, emptyLogoLine)
      let bottomEmpty = Stdlib.List.repeat(paddingBottom, emptyLogoLine)
      Stdlib.List.flatten([topEmpty, paddedLogoLines, bottomEmpty])
    else
      paddedLogoLines

  let finalTextLines =
    if textHeight < targetHeight then
      let totalPadding = targetHeight - textHeight
      let paddingTop = totalPadding / 2
      let paddingBottom = totalPadding - paddingTop
      let topEmpty = Stdlib.List.repeat(paddingTop, "")
      let bottomEmpty = Stdlib.List.repeat(paddingBottom, "")
      Stdlib.List.flatten([topEmpty, textLines, bottomEmpty])
    else
      textLines

  let spacing = "    "

  match Stdlib.List.zip(finalLogoLines, finalTextLines) with
  | Ok(zipped) ->
    zipped
    |> Stdlib.List.map(fun((logoLine, textLine)) -> logoLine + spacing + textLine)
    |> Stdlib.String.join("\n")
  | Error(_) ->
    // This should never happen since we ensured both lists are the same length
    ""