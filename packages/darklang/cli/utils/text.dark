module Darklang.Cli.Text

// Small text helpers shared across CLI commands, so counters and summaries read the same everywhere.

/// Add colors to a permission error and make its section headings bold.
/// The console handles NO_COLOR, pipes and TERM=dumb.
let stylePermissionError(message: String): String =
  message
  |> Stdlib.String.splitOnNewline
  |> Stdlib.List.indexedMap(fun(index, line) ->
    if index == 0 then
      Stdlib.Cli.UI.Colors.error(line)
    else if Stdlib.String.startsWith(line, "  dark ") then
      Stdlib.Cli.UI.Colors.cyanText(line)
    else if
      Stdlib.String.endsWith(line, ":")
      && Stdlib.Bool.not(Stdlib.String.startsWith(line, "  "))
    then
      Stdlib.Cli.UI.Colors.boldText(line)
    else
      line)
  |> Stdlib.String.join("\n")

/// <param text> as lines no wider than <param width>, broken at spaces, every line after the first
/// carrying <param indent>. What every line a person reads at a save goes through: an 80-column
/// terminal is the floor, and a wrapped line keeps its shape.
let wrap(width: Int64, indent: String, text: String): List<String> =
  let room = Stdlib.max(20, width - (Stdlib.String.length(indent)))

  match Stdlib.Cli.Tui.Text.wrapAtWords(text, room) with
  | [] -> [ indent + text ]
  | [first, ...rest] ->
    Stdlib.List.prepend(rest |> Stdlib.List.map(fun l -> indent + l), indent + first)

/// Print <param text> wrapped at 80 columns, indented by <param indent>, in <param colour>.
let printWrapped(colour: String -> String, indent: String, text: String): Unit =
  wrap(80, indent, text) |> Stdlib.List.iter(fun l -> Stdlib.printLine(colour(l)))

/// <fn printWrapped> to stderr, for a line that is not the answer: a refusal, a warning.
let printWrappedErr(colour: String -> String, indent: String, text: String): Unit =
  wrap(80, indent, text) |> Stdlib.List.iter(fun l -> Stdlib.printErrorLine(colour(l)))

/// The first eight characters of an id: how every table and message names a process, a run or
/// a commit. Eight is enough to be unique in practice and short enough to read in a column.
let shortIdText(id: String): String = Stdlib.String.slice(id, 0, 8)

/// <fn shortIdText> for an id that is already a `Uuid`.
let shortId(id: Uuid): String = shortIdText(Stdlib.display(id))

/// <param text> on one line, at most <param width> characters: for a table cell that must not
/// break the row. `Table.print` pads to the widest cell and never wraps, so a cell that is
/// allowed to be long costs every row below it.
let oneLineAt(width: Int64, text: String): String =
  let flat = Stdlib.String.join(Stdlib.String.splitOnNewline(text), " ")
  if Stdlib.String.length(flat) > width then
    (Stdlib.String.slice(flat, 0, width - 3)) + "..."
  else
    flat

/// <fn oneLineAt> at 40 characters.
let oneLine(text: String): String = oneLineAt(40, text)

/// "9,999", "48k", "3.2M": a count at a glance, for a column where the exact number is not the
/// point and the magnitude is.
let count(n: Int64): String =
  if n < 10000 then Stdlib.display(n)
  else if n < 1000000 then $"{Stdlib.display(Stdlib.Int64.checkedDivide(n, 1000) |> Stdlib.Result.withDefault(0))}k"
  else
    let tenths = Stdlib.Int64.checkedDivide(n, 100000) |> Stdlib.Result.withDefault(0)
    $"{Stdlib.display(Stdlib.Int64.checkedDivide(tenths, 10) |> Stdlib.Result.withDefault(0))}.{Stdlib.display(Stdlib.Int64.checkedMod(tenths, 10) |> Stdlib.Result.withDefault(0))}M"

/// "812 B", "34 KB", "2.1 MB": bytes at a glance.
let bytes(n: Int64): String =
  if n < 1024 then $"{Stdlib.display(n)} B"
  else if n < 1048576 then $"{Stdlib.display(Stdlib.Int64.checkedDivide(n, 1024) |> Stdlib.Result.withDefault(0))} KB"
  else
    let tenths = Stdlib.Int64.checkedDivide(n, 104858) |> Stdlib.Result.withDefault(0)
    $"{Stdlib.display(Stdlib.Int64.checkedDivide(tenths, 10) |> Stdlib.Result.withDefault(0))}.{Stdlib.display(Stdlib.Int64.checkedMod(tenths, 10) |> Stdlib.Result.withDefault(0))} MB"

// "1 value" / "2 values": a count with its noun pluralized by the English rule in
// `Stdlib.English.pluralize`, so no CLI message reads "1 value(s)". The linguistic rule lives in
// stdlib; this just pairs it with a count.
let plural(n: Int64, noun: String): String =
  if n == 1 then
    $"{Stdlib.display(n)} {noun}"
  else
    $"{Stdlib.display(n)} {Stdlib.English.pluralize(noun)}"
