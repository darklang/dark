/// One rule for what a long listing does when it is too long to read.
///
/// `search` already capped its results and said how many it dropped; `deps` printed all 431 dependents
/// and `show` all 11,578 ops. A listing that scrolls a thousand lines past you has told you less than
/// one that shows twenty and says how many there were, and silently truncating is worse than either --
/// a cap you can't see reads as "that's all of them".
module Darklang.Cli.Listing

/// How many rows a long listing shows before it stops and says how many are left.
val defaultLimit = 20

/// The flag every capped listing accepts to print everything. Kept here so the commands and the
/// footers that name it can't drift apart.
val allFlag = "--all"


/// Whether to cap at all: only for a person at a terminal, never under `--all`, never when stdout is
/// a pipe or file -- there the reader is `grep` or `wc`, and a silent cut is data loss. Commands call
/// this once and pass the answer down, so the helpers below stay pure.
let shouldCap (all: Bool) : Bool =
  (Stdlib.Bool.not all)
  && (Stdlib.Cli.Tui.TerminalSupport.currentFacts ()).outputIsTerminal


/// The footer under a capped listing: how many were left out, and how to see them.
/// <param seeAlso> is what the reader should do, since not every surface that caps a
/// listing has an `--all` flag of its own to point at.
let footerSeeAlso (left: Int) (what: String) (seeAlso: String) : String =
  Stdlib.Cli.UI.Colors.hint $"  ... and {Stdlib.toString left} more {what} ({seeAlso})"


/// The footer under a capped listing on a command that takes `--all` itself.
let footer (left: Int) (what: String) : String =
  Listing.footerSeeAlso left what $"pass {Listing.allFlag} to see them"


/// Where every capped listing decides what to drop: the items to show, and how many things were
/// left out. `cost` is rows an item occupies (spent against `limit`); `count` is things it holds
/// (what the footer reports). Both are 1 for a flat list. Always keeps at least one item; with `cap`
/// false, keeps everything.
let cut
  (items: List<'a>)
  (limit: Int)
  (cap: Bool)
  (cost: 'a -> Int)
  (count: 'a -> Int)
  : (List<'a> * Int) =
  if Stdlib.Bool.not cap then
    (items, 0)
  else
    let (shown, _) =
      Stdlib.List.fold items ([], 0) (fun acc item ->
        let (taken, spent) = acc
        let next = spent + (cost item)

        if taken == [] || next <= limit then
          (Stdlib.List.append taken [ item ], next)
        else
          (taken, spent))

    let total = Stdlib.sum 0 (items |> Stdlib.List.map count)
    let kept = Stdlib.sum 0 (shown |> Stdlib.List.map count)

    (shown, total - kept)


/// Render what `cut` kept and add the footer if anything was left out.
let withFooterSeeAlso
  (rows: List<String>)
  (left: Int)
  (what: String)
  (seeAlso: String)
  : List<String> =
  if left <= 0 then
    rows
  else
    Stdlib.List.append rows [ Listing.footerSeeAlso left what seeAlso ]


/// Render what `cut` kept and add the footer if anything was left out.
let withFooter (rows: List<String>) (left: Int) (what: String) : List<String> =
  Listing.withFooterSeeAlso rows left what $"pass {Listing.allFlag} to see them"


/// A flat listing: the first `limit` rows, then a footer counting the rest as `what`.
let capped (rows: List<String>) (limit: Int) (cap: Bool) (what: String) : List<String> =
  let (shown, left) = Listing.cut rows limit cap (fun _ -> 1) (fun _ -> 1)
  Listing.withFooter shown left what


/// Split a fully-qualified name into its module path and its leaf.
let splitLeaf (name: String) : (String * String) =
  let parts = Stdlib.String.split name "."

  match Stdlib.List.last parts with
  | None -> ("", name)
  | Some leaf ->
    let modulePath =
      parts
      |> Stdlib.List.take ((Stdlib.List.length parts) - 1)
      |> Stdlib.String.join "."

    (modulePath, leaf)


/// Group qualified names under their module, so a long list reads as a few modules rather than as
/// hundreds of near-identical paths whose only difference is the last segment.
///
/// Each group is the module path and its leaves. The modules are sorted; the leaves keep the
/// order they came in.
let groupedByModule (names: List<String>) : List<(String * List<String>)> =
  // One pass, splitting each name once. A Dict lists its keys sorted, which is the module
  // order this has always had.
  names
  |> Stdlib.List.fold (Dict { }) (fun groups name ->
    let (m, leaf) = Listing.splitLeaf name

    match Stdlib.Dict.get groups m with
    | Some leaves -> Stdlib.Dict.setOverridingDuplicates groups m (Stdlib.List.push leaves leaf)
    | None -> Stdlib.Dict.set groups m [ leaf ])
  |> Stdlib.Dict.toList
  |> Stdlib.List.map (fun (m, leaves) -> (m, Stdlib.List.reverse leaves))


/// One group as its two rows: a dimmed header with the count, and the leaves on one line.
let groupRows (group: (String * List<String>)) : List<String> =
  let (m, leaves) = group
  let count = Stdlib.toString (Stdlib.List.length leaves)

  [ Stdlib.Cli.UI.Colors.dimText $"  {m}  ({count})", $"    {Stdlib.String.join leaves ", "}" ]


/// Grouped names, capped by whole modules: as many groups as fit in `limit` rows, then a footer
/// counting the items left out -- not rows, so it adds up with a header that counted items.
let cappedGroupsSeeAlso
  (groups: List<(String * List<String>)>)
  (limit: Int)
  (cap: Bool)
  (what: String)
  (seeAlso: String)
  : List<String> =
  let (shown, left) =
    Listing.cut
      groups
      limit
      cap
      (fun g -> Stdlib.List.length (Listing.groupRows g))
      (fun (_, leaves) -> Stdlib.List.length leaves)

  Listing.withFooterSeeAlso
    (shown |> Stdlib.List.map Listing.groupRows |> Stdlib.List.flatten)
    left
    what
    seeAlso


/// Grouped names, capped by whole modules, on a command that takes `--all` itself.
let cappedGroups
  (groups: List<(String * List<String>)>)
  (limit: Int)
  (cap: Bool)
  (what: String)
  : List<String> =
  Listing.cappedGroupsSeeAlso
    groups
    limit
    cap
    what
    $"pass {Listing.allFlag} to see them"
