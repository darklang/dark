      // SCM commands
      ("status", "What's in your draft, in one line", [ "wip", "changes" ], Cli.Status.execute, Cli.Status.help, Cli.Status.complete)
      // `commits`, not `log`: every noun in this CLI says what it lists (`ops`, `branches`, `conflicts`), and
