module Darklang.Cli.Packages.Type


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [] ->
    Stdlib.printLine (help state)
    state

  // type SomeModule.myType = definition
  | location :: definitionParts ->
    // Strip leading "=" if present (since users naturally type "type Foo = ...")
    let cleanedParts =
      match definitionParts with
      | "=" :: rest -> rest
      | parts -> parts

    // Join all remaining args as the inline definition.
    // Special case: a single "-" arg means "read body from stdin" so callers
    // can pipe multi-line definitions via heredoc without shell-quoting.
    let inlineDefinition =
      match cleanedParts with
      | [ "-" ] -> Builtin.stdinReadAll ()
      | parts ->
        // Strip a leading "=" from the JOINED string too, not just when it arrived as its own argument.
        // `type Foo = <def>` unquoted splits into a separate "=" token and was already handled; `type Foo
        // "= <def>"` quotes it into the definition, where it used to reach the parser and fail. The help
        // example is written in the unquoted form, so anyone quoting -- which is what you do from a script,
        // or when the definition contains shell metacharacters like `|` -- hit a parse error on the
        // documented syntax.
        let joined = Stdlib.String.join parts " " |> Stdlib.String.trim

        if Stdlib.String.startsWith joined "=" then
          Stdlib.String.dropFirst joined 1 |> Stdlib.String.trim
        else
          joined

    if Stdlib.String.isEmpty inlineDefinition then
      // No inline definition provided - show error
      [
        (Stdlib.Cli.UI.Colors.error "Error: Inline type definition required")
        ""
        "Usage: type <location> <definition>"
        "       type <location> -    (read definition from stdin, for multi-line input)"
        ""
        "Examples:"
        "  type Status = | Active | Inactive"
        "  type User = { name: String; age: Int }"
        "  type Result = | Ok of String | Error of String"
        ""
        "  # Multi-line definition via stdin (run from shell, not the REPL):"
        "  ./scripts/run-cli type User - <<'EOF'"
        "  {"
        "    name: String"
        "    age: Int"
        "    email: String"
        "  }"
        "  EOF"
        ""
      ] |> Stdlib.printLines

      state
    else
      // Parse and create type immediately
      createTypeInline
        state.packageData.currentLocation
        location
        inlineDefinition
        state


let createTypeInline
  (currentLocation: Packages.PackageLocation)
  (locationStr: String)
  (definition: String)
  (state: Cli.AppState)
  : Cli.AppState =
  // Parse location relative to current position
  match Location.parseRelativeTo currentLocation locationStr with
  | Ok location ->
    // Build full source code for parsing
    let fullSource = $"type {location.name} = {definition}"

    // Parse the type definition
    match Builtin.parserParseToWrittenTypes fullSource with
    | Some(SourceFile sourceFile) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors (Builtin.parserParseDiagnostics fullSource)
      let found =
        if hasParseError then
          Stdlib.Option.Option.None
        else
          sourceFile.declarations
          |> Stdlib.List.findFirst (fun d ->
            match d with
            | Type _ -> true
            | _ -> false)

      match found with
      | Some(Type writtenType) ->
        // Convert to ProgramTypes.PackageType
        let pm = LanguageTools.PackageManager.pm ()

        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = pm
              branchId = state.currentBranchId
              owner = location.owner
              currentModule = location.modules }

        let (packageType, unresolvedNames) =
          LanguageTools.WrittenTypesToProgramTypes.TypeDeclaration.toPackageTypePT
            ctx
            writtenType

        // Check for unresolved names
        if Errors.reportUnresolvedNames state.currentBranchId unresolvedNames then
          state
        // no unresolved names - keep going
        else
          // Check if this is an update (has previous versions)
          let previousHashes = Propagate.getAllPreviousHashes state.currentBranchId location LanguageTools.ProgramTypes.ItemKind.Type
          let isUpdate = (Stdlib.List.isEmpty previousHashes) |> Stdlib.Bool.not

          // Create ops: AddType and SetName
          let ops =
            [ LanguageTools.ProgramTypes.PackageOp.AddType packageType
              LanguageTools.ProgramTypes.PackageOp.SetName (location, LanguageTools.ProgramTypes.Reference.PackageType packageType.hash, Stdlib.Option.Option.None) ]

          match SCM.PackageOps.addAuthored state.currentBranchId ops with
          | Ok report ->
            AtRestCheck.printSaveReport state.currentBranchId report

            // Show success message
            let fullPath = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation location
            let action = if isUpdate then "Updated" else "Created"

            Stdlib.printLine ""
            Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ {action} type: {fullPath}")

            // Repoint dependents NOW, into the draft, so you can run them against this change before
            // deciding whether to commit. Nothing is committed; `dark commit` is still the blessing.
            if isUpdate then
              Propagate.repointNow state.currentBranchId location previousHashes packageType.hash LanguageTools.ProgramTypes.ItemKind.Type

            Stdlib.printLine ""
            state

          | Error msg ->
            [ ""
              (Stdlib.Cli.UI.Colors.error $"✗ Failed to add type: {msg}")
              "" ]
            |> Stdlib.printLines

            state

      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          state
        else
          [
            (Stdlib.Cli.UI.Colors.error "Failed to parse type definition")
            ""
            "Make sure your syntax is correct. Examples:"
            "  type Status = | Active | Inactive"
            "  type User = { name: String; age: Int }"
            ""
          ] |> Stdlib.printLines
          state
    | None ->
      [
        (Stdlib.Cli.UI.Colors.error "Failed to parse type definition")
        ""
        "Make sure your syntax is correct. Examples:"
        "  type Status = | Active | Inactive"
        "  type User = { name: String; age: Int }"
        ""
      ] |> Stdlib.printLines
      state
  | Error msg ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Invalid location: {msg}")
    state


let help (_state: Cli.AppState) : String =
  [
    "Create or update a type"
    ""
    "Usage: type <location> <definition>"
    ""
    "When updating an existing type, dependents are automatically updated"
    "to use the new version."
    ""
    "Examples:"
    "  # Simple enum:"
    "  type Status = | Active | Inactive"
    ""
    "  # Enum with fields:"
    "  type Result = | Ok of String | Error of String"
    ""
    "  # Record type:"
    "  type User = { name: String; age: Int }"
    ""
    "  # Type alias:"
    "  type UserId = Uuid"
    ""
    "  # Multi-line definition via stdin (run from shell, not the REPL -- '-' reads stdin):"
    "  ./scripts/run-cli type User - <<'EOF'"
    "  {"
    "    name: String"
    "    age: Int"
    "    email: String"
    "  }"
    "  EOF"
    ""
    "Location can be relative or absolute:"
    "  type Foo = ...              # Right here in this module"
    "  type ../Adjacent.Foo = ...  # Relative to current location"
    "  type /Darklang.Foo = ...    # Absolute path"
    ""
  ] |> Stdlib.String.join "\n"


/// CLEANUP could offer useful completions:
/// - when on the LHS of the =,
///   - help in the same way that nav-like commands do
/// - when on the RHS of the =,
///   - probably nothing,
///   - but _could_ offer some suggested impls via AI...
let complete (_state: Cli.AppState) (_args: List<String>) : List<Cli.Completion.CompletionItem> =
  []
