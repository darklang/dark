module Darklang.Cli.Packages.Type


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [] ->
    Stdlib.printLine (help state)
    state

  // type SomeModule.myType = definition
  | location :: definitionParts ->
    let inlineDefinition = Packages.definitionFromArgs definitionParts

    if Stdlib.String.isEmpty inlineDefinition then
      [
        (Stdlib.Cli.UI.Colors.error "Error: Inline type definition required")
        ""
        "Usage: type <location> <definition>"
        "       type <location> -    (read definition from stdin, for multi-line input)"
        ""
        "Examples:"
        "  type Status = | Active | Inactive"
        "  type User = { name: String; age: Int }"
        "  type Result = | Ok of String | Error of String"
        ""
        "  # Multi-line definition via stdin (run from shell, not the REPL):"
        "  ./scripts/run-cli type User - <<'EOF'"
        "  {"
        "    name: String"
        "    age: Int"
        "    email: String"
        "  }"
        "  EOF"
        ""
      ] |> Stdlib.printLines

      state
    else
      createTypeInline
        state.packageData.currentLocation
        location
        inlineDefinition
        state


let createTypeInline
  (currentLocation: Packages.PackageLocation)
  (locationStr: String)
  (definition: String)
  (state: Cli.AppState)
  : Cli.AppState =
  match Location.parseRelativeTo currentLocation locationStr with
  | Ok location ->
    let fullSource = $"type {location.name} = {definition}"

    match LanguageTools.Parser.Parse.toWrittenTypes fullSource with
    | Some(SourceFile sourceFile) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors (LanguageTools.Parser.Parse.diagnostics fullSource)
      let found =
        if hasParseError then
          Stdlib.Option.Option.None
        else
          sourceFile.declarations
          |> Stdlib.List.findFirst (fun d ->
            match d with
            | Type _ -> true
            | _ -> false)

      match found with
      | Some(Type writtenType) ->
        Packages.saveAuthored
          state
          location
          LanguageTools.ProgramTypes.ItemKind.Type
          "type"
          state
          (fun ctx ->
            let (packageType, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.TypeDeclaration.toPackageTypePT
                ctx
                writtenType

            let ops =
              [ LanguageTools.ProgramTypes.PackageOp.AddType packageType
                LanguageTools.ProgramTypes.PackageOp.SetName (location, LanguageTools.ProgramTypes.Reference.PackageType packageType.hash, Stdlib.Option.Option.None) ]

            (ops, packageType.hash, unresolvedNames))

      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          state
        else
          [
            (Stdlib.Cli.UI.Colors.error "Failed to parse type definition")
            ""
            "Make sure your syntax is correct. Examples:"
            "  type Status = | Active | Inactive"
            "  type User = { name: String; age: Int }"
            ""
          ] |> Stdlib.printLines
          state
    | None ->
      [
        (Stdlib.Cli.UI.Colors.error "Failed to parse type definition")
        ""
        "Make sure your syntax is correct. Examples:"
        "  type Status = | Active | Inactive"
        "  type User = { name: String; age: Int }"
        ""
      ] |> Stdlib.printLines
      state
  | Error msg ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Invalid location: {msg}")
    state


let help (_state: Cli.AppState) : String =
  [
    "Create or update a type"
    ""
    "Usage: type <location> <definition>"
    "       type <location> <source-file>"
    ""
    "When updating an existing type, dependents are automatically updated"
    "to use the new version."
    ""
    "Examples:"
    "  # Simple enum:"
    "  type Status = | Active | Inactive"
    ""
    "  # Enum with fields:"
    "  type Result = | Ok of String | Error of String"
    ""
    "  # Record type:"
    "  type User = { name: String; age: Int }"
    ""
    "  # Type alias:"
    "  type UserId = Uuid"
    ""
    "  # Multi-line definition via stdin (run from shell, not the REPL -- '-' reads stdin):"
    "  ./scripts/run-cli type User - <<'EOF'"
    "  {"
    "    name: String"
    "    age: Int"
    "    email: String"
    "  }"
    "  EOF"
    ""
    "Location can be relative or absolute:"
    "  type Foo = ...              # Right here in this module"
    "  type ../Adjacent.Foo = ...  # Relative to current location"
    "  type /Darklang.Foo = ...    # Absolute path"
    ""
  ] |> Stdlib.String.join "\n"


/// CLEANUP could offer useful completions: nav-style help on the LHS of the `=`;
/// probably nothing on the RHS.
let complete (_state: Cli.AppState) (_args: List<String>) : List<Cli.Completion.CompletionItem> =
  []
