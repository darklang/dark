module Darklang.Cli.Packages.Type

let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    Stdlib.printLine(help(state))
    state
  // type SomeModule.myType = definition
  | [location, ...definitionParts] ->
    match definitionFromArgs(definitionParts) with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(inlineDefinition) ->
      if Stdlib.String.isEmpty(inlineDefinition) then
        // No body: with a terminal, open the structural editor on a blank one.
        match Stdlib.Cli.Tui.TerminalSupport.current(), Location.parseRelativeTo(
                state.packageData.currentLocation,
                location) with
        | Available, Ok(loc) -> Fluid.App.createType(state, loc)
        | _ ->
          [ Stdlib.Cli.UI.Colors.error("Error: Inline type definition required")
            ""
            "Usage: type <location> <definition>"
            "       type <location> -    (read definition from stdin, for multi-line input)"
            ""
            "Examples:"
            "  dark type Me.Demo.Status '| Active | Inactive'"
            "  dark type Me.Demo.User '{ name: String, age: Int64 }'"
            "" ]
          |> Stderr.lines

          failed(state)
      else
        createTypeInline(state.packageData.currentLocation, location, inlineDefinition, state)


let createTypeInline(
  currentLocation: PackageLocation,
  locationStr: String,
  definition: String,
  state: AppState)
  : AppState =
  match Location.parseRelativeTo(currentLocation, locationStr) with
  | Ok(location) ->
    let fullSource = $"type {location.name} = {definition}"
    let (tree, diagnostics) =
      LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, fullSource)

    match tree with
    | Some(SourceFile(sourceFile)) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors(diagnostics) || Errors.reportTrailing(sourceFile)
      let found =
        if hasParseError then
          Option.None
        else
          sourceFile.declarations
          |> Stdlib.List.findFirst(fun d ->
            match d with
            | Type(_) -> true
            | _ -> false)

      match found with
      | Some(Type(writtenType)) ->
        saveAuthored(
          state,
          location,
          LanguageTools.ProgramTypes.ItemKind.Type,
          "type",
          { state with exitCode = 1 },
          0,
          fun ctx ->
            let (packageType, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.TypeDeclaration.toPackageTypePT(
                ctx,
                writtenType)

            let ops =
              [ LanguageTools.ProgramTypes.PackageOp.AddType(packageType)
                LanguageTools.ProgramTypes.PackageOp.SetName(
                  location,
                  LanguageTools.ProgramTypes.Reference.PackageType(packageType.hash),
                  Option.None) ]

            Option.Some((ops, packageType.hash, unresolvedNames)))
      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          failed(state)
        else
          [ Stdlib.Cli.UI.Colors.error("Failed to parse type definition")
            ""
            "Make sure your syntax is correct. Examples:"
            "  dark type Me.Demo.Status '| Active | Inactive'"
            "  dark type Me.Demo.User '{ name: String, age: Int64 }'"
            "" ]
          |> Stderr.lines

          failed(state)
    | None ->
      [ Stdlib.Cli.UI.Colors.error("Failed to parse type definition")
        ""
        "Make sure your syntax is correct. Examples:"
        "  dark type Me.Demo.Status '| Active | Inactive'"
        "  dark type Me.Demo.User '{ name: String, age: Int64 }'"
        "" ]
      |> Stderr.lines

      failed(state)
  | Error(msg) ->
    printErr($"Invalid location: {msg}")
    failed(state)


let help(_state: AppState): String =
  [ "Create or update a type"
    ""
    "Usage: type <location> <definition>"
    "       type <location> <source-file>"
    ""
    "When updating an existing type, dependents are automatically updated"
    "to use the new version."
    ""
    "A name is Owner.Name, or Owner.Module.Name to put it in a module. `Me` is a"
    "fine owner to start with; `Darklang` is reserved for the standard library."
    ""
    "Examples:"
    "  dark type Me.Demo.Status '| Active | Inactive'"
    "  dark type Me.Demo.Size '| Small | Large(Int64)'"
    "  dark type Me.Demo.User '{ name: String, age: Int64 }'"
    "  dark type Me.Demo.UserId 'Uuid'"
    "  dark eval 'Me.Demo.User { name = \"Ada\", age = 36 }'"
    ""
    "  # Several lines, from stdin:"
    "  dark type Me.Demo.Account - <<'EOF'"
    "  {"
    "    owner: String"
    "    balance: Int64"
    "  }"
    "  EOF"
    ""
    "A leading `/` makes a name absolute (`/Me.Demo.User`); without one it is"
    "relative to the module `nav` put you in."
    "" ]
  |> Stdlib.String.join("\n")


/// CLEANUP could offer useful completions: nav-style help on the LHS of the `=`;
/// probably nothing on the RHS.
let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
