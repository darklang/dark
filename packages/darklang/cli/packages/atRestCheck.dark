/// At-rest checker reporting for package commands.
module Darklang.Cli.Packages.AtRestCheck

let checkBranch (branchId: Uuid) : LanguageTools.AtRestTypeChecker.Report =
  Builtin.atRestCheckBranch branchId

let customTypeName
  (branchId: Uuid)
  (hash: LanguageTools.ProgramTypes.Hash)
  : Stdlib.Option.Option<String> =
  LanguageTools.PackageManager.pickLocation
    LanguageTools.PackageManager.PickContext.empty
    (LanguageTools.PackageManager.Type.locations branchId hash)
  |> Stdlib.Option.map
       PrettyPrinter.ProgramTypes.PackageLocation.packageLocation

let staticType
  (branchId: Uuid)
  (typ: LanguageTools.AtRestTypeChecker.StaticType)
  : String =
  LanguageTools.AtRestTypeChecker.staticTypeToStringWith
    (customTypeName branchId)
    typ

let issueLine
  (branchId: Uuid)
  (issue: LanguageTools.AtRestTypeChecker.Issue)
  : String =
  let code = LanguageTools.AtRestTypeChecker.issueCodeToString issue.code
  let message =
    LanguageTools.AtRestTypeChecker.issueToStringWith
      (customTypeName branchId)
      issue
  "  - [" ++ code ++ "] " ++ message

let sameOrMirrored
  (first: LanguageTools.AtRestTypeChecker.Issue)
  (second: LanguageTools.AtRestTypeChecker.Issue)
  : Bool =
  let sameSite =
    first.code == second.code
    && first.nodeId == second.nodeId
    && first.context == second.context
  let same =
    sameSite
    && first.expected == second.expected
    && first.actual == second.actual
  let mirrored =
    sameSite
    && first.code == LanguageTools.AtRestTypeChecker.IssueCode.TypeMismatch
    && first.expected == second.actual
    && first.actual == second.expected
  same || mirrored

let deduplicate
  (issues: List<LanguageTools.AtRestTypeChecker.Issue>)
  : List<LanguageTools.AtRestTypeChecker.Issue> =
  match issues with
  | [] -> []
  | issue :: rest ->
    let remaining =
      rest
      |> Stdlib.List.filter (fun other ->
        Stdlib.Bool.not(sameOrMirrored issue other))
    Stdlib.List.push (deduplicate remaining) issue

let issueLines
  (branchId: Uuid)
  (issues: List<LanguageTools.AtRestTypeChecker.Issue>)
  : List<String> =
  issues
  |> deduplicate
  |> Stdlib.List.map (issueLine branchId)
  |> Stdlib.List.groupByWithKey (fun line -> line)
  |> Stdlib.List.map (fun (line, occurrences) ->
    let count = Stdlib.List.length occurrences
    if count == 1 then line
    else line ++ " (" ++ Stdlib.Int.toString count ++ " occurrences)")

let summary
  (report: LanguageTools.AtRestTypeChecker.Report)
  : Stdlib.Option.Option<String> =
  match report.verdict with
  | Checked -> Stdlib.Option.Option.None
  | Failed -> Stdlib.Option.Option.Some "static type errors detected"
  | Incomplete -> Stdlib.Option.Option.Some "static check incomplete"

/// Print the checker's findings for a batch that was just saved as WIP. Nothing
/// here stops the save: `Failed` means `commit` will refuse the batch until it is
/// fixed (or the commit allows type errors), and says so.
let printSaveReport
  (branchId: Uuid)
  (report: LanguageTools.AtRestTypeChecker.Report)
  : Unit =
  match report.verdict with
  | Checked -> ()
  | Failed ->
    let details =
      Stdlib.List.append
        (issueLines branchId report.diagnostics)
        (issueLines branchId report.blockers)
    Stdlib.List.append
      [ ""
        (Stdlib.Cli.UI.Colors.error
          ("At-rest type check failed "
           ++ "(saved as WIP; `commit` will refuse it until fixed):")) ]
      details
    |> Stdlib.printLines
  | Incomplete ->
    let details =
      Stdlib.List.append
        (issueLines branchId report.diagnostics)
        (issueLines branchId report.blockers)
    Stdlib.List.append
      [ ""
        (Stdlib.Cli.UI.Colors.warning
          "At-rest type check was incomplete (save continued):") ]
      details
    |> Stdlib.printLines
