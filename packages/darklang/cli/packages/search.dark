module Darklang.Cli.Packages.Search

// Max results rendered per entity type.
val displayCap = 20

// Batch mode caps each entity section at three results.
val batchDisplayCap = 3


// An operator symbol is not a name, so searching for one literally finds nothing. Each one is
// answered with the TRAIT it is, so `dark search %` lands on `Modulo` and every type that
// implements it rather than on whatever happens to contain the letters. `NumericTraits.ofInfix`
// is the authoritative symbol-to-trait table and this is its reader-facing half, so a trait
// renamed there has to be renamed here.
//
// Four are not traits and say so by answering with a name instead: `==` and `!=` are structural
// for every value, and `!`, `&&` and `||` are ordinary Bool functions. `++` is no operator any
// more; it lands on `Add`, since `+` is what joins strings now.
let operatorAlias(query: String): Stdlib.Option.Option<String> =
  match Stdlib.String.trim(query) with
  | "+" -> Stdlib.Option.Option.Some("Add")
  | "++" -> Stdlib.Option.Option.Some("Add")
  | "-" -> Stdlib.Option.Option.Some("Subtract")
  | "*" -> Stdlib.Option.Option.Some("Multiply")
  | "/" -> Stdlib.Option.Option.Some("Divide")
  | "%" -> Stdlib.Option.Option.Some("Modulo")
  | "**" -> Stdlib.Option.Option.Some("Power")
  | "&" -> Stdlib.Option.Option.Some("BitwiseAnd")
  | "|" -> Stdlib.Option.Option.Some("BitwiseOr")
  | "^" -> Stdlib.Option.Option.Some("BitwiseXor")
  | "~" -> Stdlib.Option.Option.Some("BitwiseNot")
  | "<<" -> Stdlib.Option.Option.Some("ShiftLeft")
  | ">>" -> Stdlib.Option.Option.Some("ShiftRight")
  | "<" -> Stdlib.Option.Option.Some("Compare")
  | "<=" -> Stdlib.Option.Option.Some("Compare")
  | ">" -> Stdlib.Option.Option.Some("Compare")
  | ">=" -> Stdlib.Option.Option.Some("Compare")
  | "==" -> Stdlib.Option.Option.Some("equals")
  | "!=" -> Stdlib.Option.Option.Some("notEquals")
  | "!" -> Stdlib.Option.Option.Some("not")
  | "&&" -> Stdlib.Option.Option.Some("and")
  | "||" -> Stdlib.Option.Option.Some("or")
  | _ -> Stdlib.Option.Option.None


/// For a query that names an operator as a function, `Int64.mod`, the operator it is: there is no
/// such function to find, and what the results hold instead is the trait's own method.
let operatorHint(branchId: Uuid, query: String): Unit =
  match Packages.Errors.operatorSuggestion(branchId, Stdlib.String.split(Stdlib.String.trim(query), ".")) with
  | Some(written) ->
    Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint($"  ({query} is the operator: {written})"))
  | None -> ()


// Ranks a name by how directly it answers the query (lower = better).
// Beyond exact and prefix matches, we reward a name the query *elaborates* —
// `parse` for the query `parseInt`, `get` for `getEnvVar` — since that name is
// the canonical operation the camelCase concept is built on. A hit matched only
// via its doc comment (the query token isn't in the name at all) ranks last, so
// the name-relevant results aren't pushed under the display cap. <fn matchRank> is
// case-insensitive; this takes both already lowercased.
let matchLowered(q: String, n: String): Int64 =
  if n == q then 0
  else if Stdlib.String.startsWith(q, n) then 1 // query elaborates name: parseInt ⊃ parse
  else if Stdlib.String.startsWith(n, q) then 2 // name elaborates query: parseIntLiteral ⊃ parseInt
  else if Stdlib.String.contains(n, q) then 3
  else 4


let matchRank(query: String, name: String): Int64 =
  matchLowered(Stdlib.String.toLowercase(query), Stdlib.String.toLowercase(name))


let isStdlib(owner: String, modules: List<String>): Bool =
  match modules with
  | [ "Stdlib", ... ] -> owner == "Darklang"
  | _ -> false


// For a qualified or multi-token query, the final token normally describes the
// item while the preceding tokens describe its module path. Rank by that item
// token; the database has already required every token to match the location or
// documentation.
let itemQuery(query: String): String =
  query
    |> Stdlib.String.toLowercase
    |> Stdlib.String.replaceAll(".", " ")
    |> Stdlib.String.split(" ")
    |> Stdlib.List.filter(fun token ->
      Stdlib.Bool.not(Stdlib.String.isEmpty(token)))
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(query)


// The query's words run together, which is how a person spells a camelCase name
// out loud: `read file` is asking for `readFile`. For a one-word query this is
// the word itself, so it changes nothing there.
let joinedQuery(query: String): String =
  query
    |> Stdlib.String.toLowercase
    |> Stdlib.String.replaceAll(".", " ")
    |> Stdlib.String.split(" ")
    |> Stdlib.List.filter(fun token ->
      Stdlib.Bool.not(Stdlib.String.isEmpty(token)))
    |> Stdlib.String.join("")


// The query's words, lowercased, the way the store matched them: split on spaces
// and dots, and short filler like `of` and `to` dropped unless every word is short.
let queryWords(query: String): List<String> =
  let words =
    query
    |> Stdlib.String.toLowercase
    |> Stdlib.String.replaceAll(".", " ")
    |> Stdlib.String.split(" ")
    |> Stdlib.List.filter(fun token ->
      Stdlib.Bool.not(Stdlib.String.isEmpty(token)))
  let kept = words |> Stdlib.List.filter(fun w -> Stdlib.String.length(w) > 2)
  if Stdlib.List.isEmpty(kept) then words else kept


// ---- Synonyms ----
//
// Words for an operation that Stdlib names another way: `size` is `length`, `replace`
// is `replaceAll`. Each answer is searched as well as what was typed, so a query that
// already finds the name loses nothing.

// What a word may also mean: the name Stdlib gives it.
let wordSynonyms(word: String): List<String> =
  match Stdlib.String.toLowercase(word) with
  | "size" -> [ "length" ]
  | "count" -> [ "length" ]
  | "len" -> [ "length" ]
  | "concat" -> [ "join", "append" ]
  | "concatenate" -> [ "join", "append" ]
  | "replace" -> [ "replaceAll" ]
  | "tostring" -> [ "display" ]
  | "torepr" -> [ "inspect" ]
  | "repr" -> [ "inspect" ]
  | _ -> []


// What a whole query may also mean, for words that mean something only together.
let phraseSynonyms(words: List<String>): List<String> =
  match words with
  | [ "current", "time" ] -> [ "DateTime.now" ]
  | [ "current", "date" ] -> [ "DateTime.now" ]
  | [ "time", "now" ] -> [ "DateTime.now" ]
  | [ "random", "number" ] -> [ "Int64.random" ]
  | [ "random", "int" ] -> [ "Int64.random" ]
  | [ "random", "integer" ] -> [ "Int64.random" ]
  | _ -> []


// The other queries <param query> is searched as, and the names they stand for:
// `size of string` is also `length string`, for `length`. None for a dotted query,
// which names what it wants.
let synonymQueries(query: String): List<(String * String)> =
  if Stdlib.String.contains(query, ".") then
    []
  else
    let words = queryWords(query)
    match phraseSynonyms(words) with
    | [] ->
      words
      |> Stdlib.List.map(fun word ->
        wordSynonyms(word)
        |> Stdlib.List.map(fun target ->
          let swapped =
            words |> Stdlib.List.map(fun w -> if w == word then target else w)
          (Stdlib.String.join(swapped, " "), target)))
      |> Stdlib.List.flatten
    | targets -> targets |> Stdlib.List.map(fun target -> (target, target))


// A query read once for ranking, since a search ranks every result against it.
type Ranker =
  { item: String
    joined: String
    // Each word ranks too, unless the query is dotted: `List.map` names its item last.
    words: List<String>
    // The names and modules its synonyms stand for, lowercased: `length` for `size`,
    // and `datetime` with `now` for `current time`.
    synonymNames: List<String>
    synonymModules: List<String>
    // The words, then the synonym names: what a name is ranked by beside the item token.
    names: List<String>
    // How many items call each result, by its full path.
    uses: Dict<String, Int64> }


let rankerWith(
  query: String,
  synonyms: List<String>,
  uses: Dict<String, Int64>)
  : Ranker =
  let parts =
    synonyms
    |> Stdlib.List.map(fun s -> Stdlib.String.split(Stdlib.String.toLowercase(s), "."))
  let words = if Stdlib.String.contains(query, ".") then [] else queryWords(query)
  let synonymNames = parts |> Stdlib.List.filterMap(fun p -> Stdlib.List.last(p))
  Ranker
    { item = itemQuery(query)
      joined = joinedQuery(query)
      words = words
      synonymNames = synonymNames
      synonymModules =
        parts |> Stdlib.List.map(fun p -> Stdlib.List.dropLast(p)) |> Stdlib.List.flatten
      names = Stdlib.List.flatten([ words, synonymNames ])
      uses = uses }


let rankerFor(query: String): Ranker = rankerWith(query, [], Stdlib.Dict.empty)


// A name's rank against the item token or the joined words, whichever is better.
// The item token alone gives `read file` nothing but "file" to rank by, so
// `overwriteFile` ties with `readFile`, and a type called `ReadFileParams` beats
// both. Taking the better of the two never lowers a name's rank, so an exact or
// prefix match on the item token keeps the rank it had.
//
// Plain words also rank by each word: in `parse int` and `length of list` the name
// is the first word, not the last. So does each name a synonym stands for. Takes the
// name lowercased; <fn rankName> lowercases it.
let rankLowered(ranker: Ranker, name: String): Int64 =
  let byItem = matchLowered(ranker.item, name)
  let byWords = matchLowered(ranker.joined, name)
  let best = if byWords < byItem then byWords else byItem
  ranker.names
  |> Stdlib.List.fold(best, fun(acc, word) ->
    let r = matchLowered(word, name)
    if r < acc then r else acc)


let rankName(ranker: Ranker, name: String): Int64 =
  rankLowered(ranker, Stdlib.String.toLowercase(name))


let nameRank(query: String, name: String): Int64 = rankName(rankerFor(query), name)


// 0 when a word of the query that is not in the name is in the item's module name:
// `parse int` is asking for `Int64.parse` before `Url.parse`, and `http get` for
// `HttpClient.get`. A word the name already has says nothing about the module, or
// `search parse` would put `FlagParser.parse` first. A module a synonym names is a hit
// too: `current time` is asking for `DateTime.now`. Takes the name lowercased.
let moduleHit(ranker: Ranker, modules: List<String>, lowerName: String): Int64 =
  let moduleName =
    modules
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault("")
    |> Stdlib.String.toLowercase
  let hit =
    (ranker.words
     |> Stdlib.List.any(fun w ->
       Stdlib.String.contains(moduleName, w)
       && Stdlib.Bool.not(Stdlib.String.contains(lowerName, w))))
    || Stdlib.List.contains(ranker.synonymModules, moduleName)
  if hit then 0 else 1


// Who an item is likely for, as a sort key: Stdlib first, then other owners'
// packages, then the rest of Darklang (the CLI, the tools), which a program rarely
// calls.
let tier(owner: String, modules: List<String>): String =
  if isStdlib(owner, modules) then "0"
  else if owner == "Darklang" then "2"
  else "1"


// How many items call <param path>, as a fixed-width sort key: the most called first.
// `String.split` has a hundred callers and `Regex.split` none, so `split` is
// `String.split`.
let usageKey(uses: Dict<String, Int64>, path: String): String =
  let n = Stdlib.Option.withDefault(Stdlib.Dict.get(uses, path), 0)
  let capped = if n > 999999 then 999999 else n
  Stdlib.String.padStart(Stdlib.display(999999 - capped), '0', 6)


// Sort key: match quality first, then whether the module is named by the query,
// then the tier, then how many items call it, and finally the full path for
// deterministic ordering. Each part is fixed-width, so plain string ordering under
// `sortBy` gives the intended result.
let rankKey(
  ranker: Ranker,
  owner: String,
  modules: List<String>,
  name: String)
  : String =
  let lowerName = Stdlib.String.toLowercase(name)
  let mr = Stdlib.display(rankLowered(ranker, lowerName))
  let mh = Stdlib.display(moduleHit(ranker, modules, lowerName))
  let path =
    [ [owner], modules, [name] ]
    |> Stdlib.List.flatten
    |> Stdlib.String.join(".")
  $"{mr}{mh}{tier(owner, modules)}{usageKey(ranker.uses, path)}:{path}"


// The length of a rank key's head (match, module hit, tier, usage): what orders the
// result sections.
val rankKeyHead = 9


let sortKey(
  query: String,
  owner: String,
  modules: List<String>,
  name: String)
  : String =
  rankKey(rankerFor(query), owner, modules, name)


// Test helpers: anything inside a `Tests` module. `AltJson.Tests.parse` is a
// fixture, but it used to be the first answer to `search parse`.
let inTestModule(modules: List<String>): Bool = Stdlib.List.contains(modules, "Tests")


// A search hides test helpers the way it hides tests, unless the query or the
// current module is itself about tests.
let showsTestHelpers(query: String, currentModule: List<String>): Bool =
  inTestModule(currentModule)
  || Stdlib.List.contains(queryWords(query), "tests")


// How many types, values, fns, traits and impls the results hold.
let itemCount(results: LanguageTools.ProgramTypes.Search.SearchResults): Int64 =
  (Stdlib.List.length(results.types))
  + (Stdlib.List.length(results.values))
  + (Stdlib.List.length(results.fns))
  + (Stdlib.List.length(results.traits))
  + (Stdlib.List.length(results.impls))


// The results without test helpers, and how many were left out.
let withoutTestHelpers(
  results: LanguageTools.ProgramTypes.Search.SearchResults)
  : (LanguageTools.ProgramTypes.Search.SearchResults * Int64) =
  let kept =
    LanguageTools.ProgramTypes.Search.SearchResults
      { submodules =
          results.submodules
          |> Stdlib.List.filter(fun m -> Stdlib.Bool.not(inTestModule(m)))
        types = results.types |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(inTestModule(i.location.modules)))
        values = results.values |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(inTestModule(i.location.modules)))
        fns = results.fns |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(inTestModule(i.location.modules)))
        traits = results.traits |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(inTestModule(i.location.modules)))
        impls = results.impls |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(inTestModule(i.location.modules)))
        tests = results.tests }
  (kept, itemCount(results) - itemCount(kept))


// <param items> best first, each ranked once.
let ranked(
  ranker: Ranker,
  items: List<LanguageTools.ProgramTypes.LocatedItem<'a>>)
  : List<LanguageTools.ProgramTypes.LocatedItem<'a>> =
  items
  |> Stdlib.List.sortBy(fun i ->
    rankKey(ranker, i.location.owner, i.location.modules, i.location.name))


// Used to order result sections: the head of the best item's rank key (match,
// module hit, tier, usage), so a section led by a much-called Stdlib function prints
// before one led by a CLI internal that matches as well. Takes the items <fn ranked>.
// Empty sections sort last.
let bestItemKey(
  ranker: Ranker,
  items: List<LanguageTools.ProgramTypes.LocatedItem<'a>>)
  : String =
  match items with
  | [] -> (Stdlib.String.checkedRepeat("9", rankKeyHead) |> Stdlib.Result.withDefault(""))
  | [ item, ... ] ->
    Stdlib.String.first(
      rankKey(ranker, item.location.owner, item.location.modules, item.location.name),
      rankKeyHead)


let bestModuleRank(query: String, modules: List<List<String>>): Int64 =
  modules
  |> Stdlib.List.fold(9, fun(acc, modulePath) ->
    let modName = Stdlib.Option.withDefault(Stdlib.List.last(modulePath), "")
    let r = matchRank(query, modName)
    if r < acc then r else acc)


// ---- Searching by type ----
//
// `bytes to string`, `string -> int` and `String -> Int64` ask for a function by
// what it takes and returns, which no name or doc comment spells. The answer is
// the Stdlib functions whose first parameter has the one type and whose result has
// the other: `Utf8.decode` for the first, `Int64.parse` for the second.

// The type a word names, in one spelling per type: the everyday words for the
// common ones and the type's own name for every builtin type.
let typeWord(word: String): Stdlib.Option.Option<String> =
  match Stdlib.String.toLowercase(word) with
  | "string" -> Stdlib.Option.Option.Some("string")
  | "str" -> Stdlib.Option.Option.Some("string")
  | "text" -> Stdlib.Option.Option.Some("string")
  | "int" -> Stdlib.Option.Option.Some("int64")
  | "integer" -> Stdlib.Option.Option.Some("int64")
  | "number" -> Stdlib.Option.Option.Some("int64")
  | "int64" -> Stdlib.Option.Option.Some("int64")
  | "float" -> Stdlib.Option.Option.Some("float")
  | "double" -> Stdlib.Option.Option.Some("float")
  | "bool" -> Stdlib.Option.Option.Some("bool")
  | "boolean" -> Stdlib.Option.Option.Some("bool")
  | "char" -> Stdlib.Option.Option.Some("char")
  | "character" -> Stdlib.Option.Option.Some("char")
  | "bytes" -> Stdlib.Option.Option.Some("bytes")
  | "binary" -> Stdlib.Option.Option.Some("bytes")
  | "list" -> Stdlib.Option.Option.Some("list")
  | "array" -> Stdlib.Option.Option.Some("list")
  | "dict" -> Stdlib.Option.Option.Some("dict")
  | "dictionary" -> Stdlib.Option.Option.Some("dict")
  | "datetime" -> Stdlib.Option.Option.Some("datetime")
  | "date" -> Stdlib.Option.Option.Some("datetime")
  | "uuid" -> Stdlib.Option.Option.Some("uuid")
  | "unit" -> Stdlib.Option.Option.Some("unit")
  | "decimal" -> Stdlib.Option.Option.Some("decimal")
  | "bigint" -> Stdlib.Option.Option.Some("bigint")
  | "float32" -> Stdlib.Option.Option.Some("float32")
  | "int8" -> Stdlib.Option.Option.Some("int8")
  | "uint8" -> Stdlib.Option.Option.Some("uint8")
  | "int16" -> Stdlib.Option.Option.Some("int16")
  | "uint16" -> Stdlib.Option.Option.Some("uint16")
  | "int32" -> Stdlib.Option.Option.Some("int32")
  | "uint32" -> Stdlib.Option.Option.Some("uint32")
  | "uint64" -> Stdlib.Option.Option.Some("uint64")
  | "int128" -> Stdlib.Option.Option.Some("int128")
  | "uint128" -> Stdlib.Option.Option.Some("uint128")
  | _ -> Stdlib.Option.Option.None


// The <fn typeWord> spelling of a type, for the types a word can name.
let typeWordOf(
  t: LanguageTools.ProgramTypes.TypeReference)
  : Stdlib.Option.Option<String> =
  match t with
  | TString -> Stdlib.Option.Option.Some("string")
  | TInt64 -> Stdlib.Option.Option.Some("int64")
  | TFloat -> Stdlib.Option.Option.Some("float")
  | TBool -> Stdlib.Option.Option.Some("bool")
  | TChar -> Stdlib.Option.Option.Some("char")
  | TBytes -> Stdlib.Option.Option.Some("bytes")
  | TList(_) -> Stdlib.Option.Option.Some("list")
  | TDict(_, _) -> Stdlib.Option.Option.Some("dict")
  | TDateTime -> Stdlib.Option.Option.Some("datetime")
  | TUuid -> Stdlib.Option.Option.Some("uuid")
  | TUnit -> Stdlib.Option.Option.Some("unit")
  | TDecimal -> Stdlib.Option.Option.Some("decimal")
  | TBigInt -> Stdlib.Option.Option.Some("bigint")
  | TFloat32 -> Stdlib.Option.Option.Some("float32")
  | TInt8 -> Stdlib.Option.Option.Some("int8")
  | TUInt8 -> Stdlib.Option.Option.Some("uint8")
  | TInt16 -> Stdlib.Option.Option.Some("int16")
  | TUInt16 -> Stdlib.Option.Option.Some("uint16")
  | TInt32 -> Stdlib.Option.Option.Some("int32")
  | TUInt32 -> Stdlib.Option.Option.Some("uint32")
  | TUInt64 -> Stdlib.Option.Option.Some("uint64")
  | TInt128 -> Stdlib.Option.Option.Some("int128")
  | TUInt128 -> Stdlib.Option.Option.Some("uint128")
  | _ -> Stdlib.Option.Option.None


// How a <fn typeWord> spelling is written in Dark, for the section header.
let typeLabel(word: String): String =
  match word with
  | "int64" -> "Int64"
  | "datetime" -> "DateTime"
  | "bigint" -> "BigInt"
  | "uuid" -> "Uuid"
  | "float32" -> "Float32"
  | "int8" -> "Int8"
  | "uint8" -> "UInt8"
  | "int16" -> "Int16"
  | "uint16" -> "UInt16"
  | "int32" -> "Int32"
  | "uint32" -> "UInt32"
  | "uint64" -> "UInt64"
  | "int128" -> "Int128"
  | "uint128" -> "UInt128"
  | w ->
    Stdlib.String.toUppercase(Stdlib.String.first(w, 1))
    + Stdlib.String.dropFirst(w, 1)


// The two types of a by-type query, as <fn typeWord> spells them: `bytes to string`,
// `string -> int`, `String->Int64`. None for anything else, which is most queries.
let typeQuery(query: String): Stdlib.Option.Option<(String * String)> =
  let words =
    query
    |> Stdlib.String.replaceAll("->", " -> ")
    |> Stdlib.String.split(" ")
    |> Stdlib.List.filter(fun w -> Stdlib.Bool.not(Stdlib.String.isEmpty(w)))
  let pair = fun(a, b) ->
    match (typeWord(a), typeWord(b)) with
    | (Some(source), Some(target)) -> Stdlib.Option.Option.Some((source, target))
    | _ -> Stdlib.Option.Option.None
  match words with
  | [ a, "to", b ] -> pair(a, b)
  | [ a, "->", b ] -> pair(a, b)
  | _ -> Stdlib.Option.Option.None


// Whether a function's result is <param target>, bare or as the first type
// argument of what it returns: `Result<Int64, _>` or `Option<Int64>`.
let returnsType(
  target: String,
  t: LanguageTools.ProgramTypes.TypeReference)
  : Bool =
  if typeWordOf(t) == Stdlib.Option.Option.Some(target) then
    true
  else
    match t with
    | TCustomType(_, [ arg, ... ]) -> typeWordOf(arg) == Stdlib.Option.Option.Some(target)
    | _ -> false


// Whether a function's name says it converts: `parse`, `toString`, `fromList`,
// `decode`. `String.length` also takes a String and returns an Int64, but nobody
// asking for `string to int` wants it first.
let convertsByName(name: String): Bool =
  let n = Stdlib.String.toLowercase(name)
  [ "parse", "to", "from", "of", "as", "decode", "encode", "convert" ]
  |> Stdlib.List.any(fun prefix -> Stdlib.String.startsWith(n, prefix))


// Whether a function takes <param source> first and returns <param target>, bare
// or in a Result or Option.
let takesAndReturns(
  source: String,
  target: String,
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageFn.PackageFn>)
  : Bool =
  match item.entity.parameters with
  | [] -> false
  | [ first, ... ] ->
    (typeWordOf(first.typ) == Stdlib.Option.Option.Some(source))
    && returnsType(target, item.entity.returnType)


// The sort key of a function for a by-type query. One named for converting comes
// first, then one taking nothing else, then the most called.
let typeMatchKey(
  uses: Dict<String, Int64>,
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageFn.PackageFn>)
  : String =
  let named = if convertsByName(item.location.name) then "0" else "1"
  let arity = if Stdlib.List.length(item.entity.parameters) == 1 then "0" else "1"
  let path = Stdlib.String.join(Stdlib.List.flatten([ [ item.location.owner ], item.location.modules, [ item.location.name ] ]), ".")
  $"{named}{arity}{tier(item.location.owner, item.location.modules)}{usageKey(uses, path)}:{path}"


// The Stdlib functions a by-type query asks for, in no order: they are ranked once
// their callers are counted.
let byType(
  branchId: Uuid,
  source: String,
  target: String)
  : List<LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageFn.PackageFn>> =
  let query =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = [ "Darklang", "Stdlib" ]
        text = ""
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Fn ]
        exactMatch = false }
  let found = Query.withoutInternal(LanguageTools.PackageManager.Search.search(branchId, query))
  found.fns
  |> Stdlib.List.filter(fun item ->
    Stdlib.Bool.not(inTestModule(item.location.modules))
    && takesAndReturns(source, target, item))


// ---- When nothing matched ----

// Names within a couple of typos of <param word>, closest first: `lenght` is
// `length`. One edit for a short word, two for a longer one, so a short word does
// not suggest every other short word. Only names starting with the same letter are
// measured: a typo rarely starts a word, and measuring every name is slow.
let nearNames(word: String, names: List<String>): List<String> =
  let w = Stdlib.String.toLowercase(word)
  let len = Stdlib.String.length(w)
  let limit = if len <= 4 then 1 else 2
  let initial = Stdlib.String.first(w, 1)
  names
  |> Stdlib.List.filter(fun n ->
    let diff = Stdlib.String.length(n) - len
    (diff <= limit)
    && (diff >= 0 - limit)
    && (Stdlib.String.toLowercase(Stdlib.String.first(n, 1)) == initial))
  |> Stdlib.List.unique
  |> Stdlib.List.filterMap(fun n ->
    let d = Darklang.Cli.Config.editDistance(w, Stdlib.String.toLowercase(n))
    if (d <= limit) && (d > 0) then
      Stdlib.Option.Option.Some((d, n))
    else
      Stdlib.Option.Option.None)
  |> Stdlib.List.sortBy(fun((d, n)) -> $"{Stdlib.display(d)}{n}")
  |> Stdlib.List.map(fun((_, n)) -> n)
  |> Stdlib.List.take(3)


// The names of everything a search from <param currentModule> could find.
let namesUnder(
  branchId: Uuid,
  currentModule: List<String>)
  : List<String> =
  let query =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = currentModule
        text = ""
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes =
          [ LanguageTools.ProgramTypes.Search.EntityType.Fn
            LanguageTools.ProgramTypes.Search.EntityType.Type
            LanguageTools.ProgramTypes.Search.EntityType.Value ]
        exactMatch = false }
  let (_, types, values, fns, _, _, _) =
    LanguageTools.PackageManager.Search.searchNames(branchId, query)
  Query.withoutInternalNames(Stdlib.List.flatten([ fns, types, values ]))


// What to try when a query found nothing.
type NothingFound =
  { // Each word of a several-word query, and how many items it finds alone. Empty
    // for a one-word query.
    wordCounts: List<(String * Int64)>
    // Each word that finds nothing, and the names it may be a typo of.
    didYouMean: List<(String * List<String>)> }


val nothingToTry =
  NothingFound
    { wordCounts = []
      didYouMean = [] }


// What to try when <param query> found nothing. Each word of a several-word query
// on its own, since every word has to match and one may be what ruled everything
// out; and for a word that finds nothing alone, the names it is a typo of.
let nothingFound(
  branchId: Uuid,
  query: LanguageTools.ProgramTypes.Search.SearchQuery)
  : NothingFound =
  let words = queryWords(query.text)
  let countFor = fun word ->
    let found =
      LanguageTools.PackageManager.Search.search(branchId, { query with text = word })
      |> Query.withoutInternal
    let (kept, _) = withoutTestHelpers(found)
    itemCount(kept)
  let several = Stdlib.List.length(words) > 1
  let counts =
    if several then
      words |> Stdlib.List.map(fun w -> (w, countFor(w)))
    else
      [ (query.text, 0) ]

  let didYouMean =
    match Stdlib.List.filter(counts, fun((_, n)) -> n == 0) with
    | [] -> []
    | missing ->
      let names = namesUnder(branchId, query.currentModule)
      missing
      |> Stdlib.List.filterMap(fun((w, _)) ->
        match nearNames(w, names) with
        | [] -> Stdlib.Option.Option.None
        | near -> Stdlib.Option.Option.Some((w, near)))

  NothingFound
    { wordCounts = if several then counts else []
      didYouMean = didYouMean }


// <type NothingFound> as hint lines.
let nothingFoundLines(found: NothingFound): List<String> =
  let alone =
    match found.wordCounts with
    | [] -> []
    | counts ->
      let each =
        counts
        |> Stdlib.List.map(fun((w, n)) -> $"`search {w}` finds {Stdlib.display(n)}")
        |> Stdlib.String.join(", ")
      [ $"  No item matches every word. One word at a time: {each}" ]

  let several = Stdlib.Bool.not(Stdlib.List.isEmpty(found.wordCounts))
  let typos =
    found.didYouMean
    |> Stdlib.List.map(fun((w, near)) ->
      let shown =
        near
        |> Stdlib.List.map(fun n -> $"`{n}`")
        |> Stdlib.String.join(", ")
      let forWord = if several then $" (for `{w}`)" else ""
      $"  Did you mean {shown}?{forWord}")

  Stdlib.List.flatten([ alone, typos ])


let docBlock(desc: String, indent: String): String =
  if Stdlib.String.isEmpty(desc) then
    ""
  else
    let lines = Stdlib.String.splitOnNewline(desc)
    lines
    |> Stdlib.List.map(fun line -> Stdlib.Cli.UI.Colors.dimText(indent + line))
    |> Stdlib.String.join("\n")


let withDoc(headline: String, desc: String): String =
  let doc = docBlock(desc, "  ")
  if Stdlib.String.isEmpty(doc) then headline else headline + "\n" + doc


// A rendered result line, with its doc comment appended only under --with-docs.
// The trailing blank line separates multi-line doc entries.
let withOptionalDoc(withDocs: Bool, headline: String, desc: String): String =
  if withDocs then (withDoc(headline, desc)) + "\n" else headline


let overflowNote(total: Int64, shown: Int64): Unit =
  let extra = total - shown
  if extra > 0 then
    Stdlib.printErrorLine((
      Stdlib.Cli.UI.Colors.hint(
        $"  ... and {Stdlib.display(extra)} more (narrow with --exact or `nav` into a module)")))
  else
    ()


let fullPathOf(item: LanguageTools.ProgramTypes.LocatedItem<'a>): String =
  [ [ item.location.owner ], item.location.modules, [ item.location.name ] ]
  |> Stdlib.List.flatten
  |> Stdlib.String.join(".")


// Pretty-printer context for rendering an item's signature. Type references are
// abbreviated relative to the item's own module, so `Stdlib.Option.Option` shows
// as `Option.Option` for a Stdlib hit, and a package hit's types collapse to its
// own root rather than being forced through the Stdlib namespace.
let contextFor(
  branchId: Uuid,
  item: LanguageTools.ProgramTypes.LocatedItem<'a>)
  : PrettyPrinter.ProgramTypes.Context =
  let modulePath = Stdlib.List.prepend(item.location.modules, item.location.owner)
  Signatures.rootContext(branchId, modulePath)


// Renders one result section (types/values/fns): header, the ranked hits capped
// (one line each via `renderItem`), and an overflow footer. Nothing is printed
// for an empty section. `renderItem` does the per-entity formatting at the call
// site, so this stays generic over the entity type.
let renderSection(
  header: String,
  cap: Int64,
  items: List<LanguageTools.ProgramTypes.LocatedItem<'a>>,
  renderItem: LanguageTools.ProgramTypes.LocatedItem<'a> -> String)
  : Unit =
  if Stdlib.List.isEmpty(items) then
    ()
  else
    Stdlib.printLine(Display.getSectionHeader(header))
    let shown = Stdlib.List.take(items, cap)
    shown |> Stdlib.List.iter(fun item -> Stdlib.printLine(renderItem(item)))
    overflowNote(Stdlib.List.length(items), Stdlib.List.length(shown))
    Stdlib.printLine("")


type ParsedArgs =
  { queryParts: List<String>
    entityTypes: List<LanguageTools.ProgramTypes.Search.EntityType>
    batch: Bool
    exactMatch: Bool
    withDocs: Bool
    shallow: Bool
    deprecated: Query.Deprecated
    internal: Query.Internal
    includeTests: Bool
    asJson: Bool
    parseErrors: List<FlagParser.ParseError> }


val argSpec =
  FlagParser.Spec
    { flags =
        [ ("--type", [])
          ("--fn", [ "--function" ])
          ("--val", [ "--value" ])
          ("--trait", [])
          ("--impl", [])
          ("--test", [])
          ("--batch", [])
          ("--exact", [])
          ("--shallow", [])
          ("--with-docs", [])
          ("--include-deprecated", [])
          ("--include-internal", [])
          ("--include-tests", [])
          ("--json", []) ]
      valueFlags = [] }


let parseArgs(args: List<String>): ParsedArgs =
  let p = FlagParser.parse(argSpec, args)
  // Entity types are preserved in the order their flags appeared.
  let entityTypes =
    p.flags
    |> Stdlib.List.fold([], fun(acc, f) ->
      match f with
      | "--type" ->
        Stdlib.List.append(
          acc,
          LanguageTools.ProgramTypes.Search.EntityType.Type)
      | "--fn" ->
        Stdlib.List.append(acc, LanguageTools.ProgramTypes.Search.EntityType.Fn)
      | "--val" ->
        Stdlib.List.append(
          acc,
          LanguageTools.ProgramTypes.Search.EntityType.Value)
      | "--trait" ->
        Stdlib.List.append(
          acc,
          LanguageTools.ProgramTypes.Search.EntityType.Trait)
      | "--impl" ->
        Stdlib.List.append(
          acc,
          LanguageTools.ProgramTypes.Search.EntityType.TraitImpl)
      | "--test" ->
        Stdlib.List.append(acc, LanguageTools.ProgramTypes.Search.EntityType.Test)
      | _ -> acc)

  ParsedArgs
    { queryParts = p.positionals
      entityTypes = entityTypes
      batch = FlagParser.hasFlag(p, "--batch")
      exactMatch = FlagParser.hasFlag(p, "--exact")
      withDocs = FlagParser.hasFlag(p, "--with-docs")
      shallow = FlagParser.hasFlag(p, "--shallow")
      deprecated = Query.Deprecated.showIf(FlagParser.hasFlag(p, "--include-deprecated"))
      internal = Query.Internal.showIf(FlagParser.hasFlag(p, "--include-internal"))
      includeTests = FlagParser.hasFlag(p, "--include-tests")
      asJson = FlagParser.hasFlag(p, "--json")
      parseErrors = p.errors }


val usage =
  "Usage: search <query> [--batch] [--type] [--fn] [--val] [--trait] [--impl] [--test] [--exact] [--shallow] [--with-docs] [--include-deprecated] [--include-internal] [--include-tests]"


// The --json rendering. Typed results for the command an agent runs most; the signatures are the
// same rendering the human view shows, minus color. `alsoSearched` is the synonym queries that ran
// too; `wordCounts` and `didYouMean` are what the human view hints when nothing matched, and are
// empty otherwise.
let jsonOutput(
  branchId: Uuid,
  queryText: String,
  alsoSearched: List<String>,
  found: NothingFound,
  results: LanguageTools.ProgramTypes.Search.SearchResults)
  : String =
  let fnRows =
    results.fns
    |> Stdlib.List.map(fun item ->
      let ctx = contextFor(branchId, item)
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("fn"))
          ("signature", Stdlib.AltJson.Json.String(Signatures.formatFn(ctx, item.entity))) ]))

  let typeRows =
    results.types
    |> Stdlib.List.map(fun item ->
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("type"))
          ("signature", Stdlib.AltJson.Json.String("")) ]))

  let valueRows =
    results.values
    |> Stdlib.List.map(fun item ->
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("value"))
          ("signature", Stdlib.AltJson.Json.String("")) ]))

  let traitRows =
    results.traits
    |> Stdlib.List.map(fun item ->
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("trait"))
          ("signature", Stdlib.AltJson.Json.String("")) ]))

  let implRows =
    results.impls
    |> Stdlib.List.map(fun item ->
      let ctx = contextFor(branchId, item)
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("impl"))
          ("signature",
           Stdlib.AltJson.Json.String(
             $"impl {PrettyPrinter.ProgramTypes.NameResolution.traitName(ctx, item.entity.trait_)} for {PrettyPrinter.ProgramTypes.typeReference(ctx, item.entity.self)}")) ]))

  let testRows =
    results.tests
    |> Stdlib.List.map(fun item ->
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(fullPathOf(item)))
          ("kind", Stdlib.AltJson.Json.String("test"))
          ("signature", Stdlib.AltJson.Json.String("")) ]))

  let moduleRows =
    results.submodules
    |> Stdlib.List.map(fun modulePath ->
      Stdlib.AltJson.Json.Object(
        [ ("name", Stdlib.AltJson.Json.String(Stdlib.String.join(modulePath, ".")))
          ("kind", Stdlib.AltJson.Json.String("module"))
          ("signature", Stdlib.AltJson.Json.String("")) ]))

  let wordCountRows =
    found.wordCounts
    |> Stdlib.List.map(fun((word, n)) ->
      Stdlib.AltJson.Json.Object(
        [ ("word", Stdlib.AltJson.Json.String(word))
          ("count", Stdlib.AltJson.Json.Integer(n)) ]))

  let didYouMeanRows =
    found.didYouMean
    |> Stdlib.List.map(fun((word, names)) ->
      Stdlib.AltJson.Json.Object(
        [ ("word", Stdlib.AltJson.Json.String(word))
          ("names",
           Stdlib.AltJson.Json.Array(
             names |> Stdlib.List.map(fun n -> Stdlib.AltJson.Json.String(n)))) ]))

  Stdlib.AltJson.format((
    Stdlib.AltJson.Json.Object(
      [ ("query", Stdlib.AltJson.Json.String(queryText))
        ("results",
         Stdlib.AltJson.Json.Array(
           Stdlib.List.flatten([ fnRows, typeRows, valueRows, traitRows, implRows, testRows, moduleRows ])
         ))
        ("alsoSearched",
         Stdlib.AltJson.Json.Array(
           alsoSearched |> Stdlib.List.map(fun q -> Stdlib.AltJson.Json.String(q))))
        ("wordCounts", Stdlib.AltJson.Json.Array(wordCountRows))
        ("didYouMean", Stdlib.AltJson.Json.Array(didYouMeanRows)) ])
  ))


// Execute one query. `execute` below fans batch arguments out through this
// function so ranking, filtering, and rendering stay identical in both modes.
/// Says how many tests matched but were left out, so a search that hides them
/// never looks like there were none. Prints nothing when none were.
let hiddenTestsHint(count: Int64): Unit =
  if count > 0 then
    let noun = if count == 1 then "test" else "tests"
    Stdlib.printErrorLine(
      (Stdlib.Cli.UI.Colors.hint(
        $"  ({Stdlib.display(count)} {noun} matched; --include-tests shows them)")))
  else
    ()


/// The same, for test helpers: what lives in a `Tests` module and isn't a test.
let hiddenHelpersHint(count: Int64): Unit =
  if count > 0 then
    let noun = if count == 1 then "test helper" else "test helpers"
    Stdlib.printErrorLine(
      (Stdlib.Cli.UI.Colors.hint(
        $"  ({Stdlib.display(count)} {noun} matched; --include-tests shows them)")))
  else
    ()


/// Where `--shallow` searches, and for what. A qualified query names its own module:
/// `search Darklang.Stdlib.List --shallow` lists what is directly in
/// `Darklang.Stdlib.List`, and `search Stdlib.List.ma --shallow` (from `Darklang`) what
/// in `Darklang.Stdlib.List` matches `ma`. The module is resolved from <param location>,
/// the way `nav` resolves it. Any other query searches <param location> itself.
let shallowScope(
  branchId: Uuid,
  location: PackageLocation,
  query: String)
  : (List<String> * String) =
  let here = Traversal.getCurrentModulePath(location)
  let parts = Stdlib.String.split(query, ".")
  // Names only: `..` and `/` mean something to `nav`, and a space makes it words.
  let isPath =
    (Stdlib.List.length(parts) > 1)
    && Stdlib.List.all(parts, fun p ->
      Stdlib.Bool.not(
        Stdlib.String.isEmpty(p)
        || Stdlib.String.contains(p, " ")
        || Stdlib.String.contains(p, "/")))

  let moduleAt = fun path ->
    match Traversal.traverse(branchId, location, Stdlib.String.join(path, ".")) with
    | Ok(Module(m)) -> Stdlib.Option.Option.Some(m)
    | _ -> Stdlib.Option.Option.None

  if Stdlib.Bool.not(isPath) then
    (here, query)
  else
    match moduleAt(parts) with
    | Some(m) -> (m, "")
    | None ->
      match moduleAt(Stdlib.List.dropLast(parts)) with
      | Some(m) -> (m, Stdlib.Option.withDefault(Stdlib.List.last(parts), query))
      | None -> (here, query)


// <param extra> after <param have>, leaving out what <param have> holds already.
let addItems(
  have: List<LanguageTools.ProgramTypes.LocatedItem<'a>>,
  extra: List<LanguageTools.ProgramTypes.LocatedItem<'a>>)
  : List<LanguageTools.ProgramTypes.LocatedItem<'a>> =
  let paths =
    have |> Stdlib.List.map(fun i -> (fullPathOf(i), true)) |> Stdlib.Dict.fromList
  Stdlib.List.flatten(
    [ have
      extra |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(Stdlib.Dict.containsKey(paths, fullPathOf(i)))) ])


// <param more> added to <param results>, leaving out what is there already.
let mergeResults(
  results: LanguageTools.ProgramTypes.Search.SearchResults,
  more: LanguageTools.ProgramTypes.Search.SearchResults)
  : LanguageTools.ProgramTypes.Search.SearchResults =
  LanguageTools.ProgramTypes.Search.SearchResults
    { submodules =
        Stdlib.List.flatten(
          [ results.submodules
            more.submodules
            |> Stdlib.List.filter(fun m -> Stdlib.Bool.not(Stdlib.List.contains(results.submodules, m))) ])
      types = addItems(results.types, more.types)
      values = addItems(results.values, more.values)
      fns = addItems(results.fns, more.fns)
      traits = addItems(results.traits, more.traits)
      impls = addItems(results.impls, more.impls)
      tests = addItems(results.tests, more.tests) }


// The full path of <param item> and how many items call it, when something does.
let calledPath(
  byHash: Dict<String, Int64>,
  hash: LanguageTools.ProgramTypes.Hash,
  item: LanguageTools.ProgramTypes.LocatedItem<'a>)
  : Stdlib.Option.Option<(String * Int64)> =
  Stdlib.Dict.get(byHash, LanguageTools.ProgramTypes.hashToString(hash))
  |> Stdlib.Option.map(fun n -> (fullPathOf(item), n))


// How many items call each of <param results> and <param typed>, by full path, from the
// store's dependency rows. One read for the whole search, and a path only for an item
// something calls.
let callerUses(
  results: LanguageTools.ProgramTypes.Search.SearchResults,
  typed: List<LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageFn.PackageFn>>)
  : Dict<String, Int64> =
  let fns = Stdlib.List.flatten([ typed, results.fns ])
  let hashes =
    Stdlib.List.flatten(
      [ results.types |> Stdlib.List.map(fun i -> i.entity.hash)
        results.values |> Stdlib.List.map(fun i -> i.entity.hash)
        fns |> Stdlib.List.map(fun i -> i.entity.hash)
        results.traits |> Stdlib.List.map(fun i -> i.entity.hash)
        results.impls |> Stdlib.List.map(fun i -> i.entity.hash)
        results.tests |> Stdlib.List.map(fun i -> i.entity.hash) ])
  match Builtin.pmCallerCounts(hashes) with
  | [] -> Stdlib.Dict.empty
  | counts ->
    let byHash =
      counts
      |> Stdlib.List.map(fun((hash, n)) -> (LanguageTools.ProgramTypes.hashToString(hash), n))
      |> Stdlib.Dict.fromList
    Stdlib.Dict.fromList(
      Stdlib.List.flatten(
        [ results.types |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i))
          results.values |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i))
          fns |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i))
          results.traits |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i))
          results.impls |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i))
          results.tests |> Stdlib.List.filterMap(fun i -> calledPath(byHash, i.entity.hash, i)) ]))


let executeQuery(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | [] ->
    // Enter interactive search mode (nav with search enabled)
    let navState = NavInteractive.buildState(state.currentBranchId, state.packageData.currentLocation)
    let searchNavState = { navState with mode = NavInteractive.Mode.Search }
    match NavInteractive.start(searchNavState) with
    | Ok(session) ->
      { state with
          currentPage = Page.InteractiveNav(session)
          prompt = Prompt.Editing.clear(state.prompt) }
    | Error(message) ->
      Cli.printErr(message)
      Cli.failed(state)

  | _ ->
    let parsed = parseArgs(args)

    if Stdlib.Bool.not(Stdlib.List.isEmpty(parsed.parseErrors)) then
      Cli.printErr(FlagParser.parseErrorsMessage(parsed.parseErrors))
      Stdlib.printErrorLine("")
      Stdlib.printErrorLine(usage)
      Cli.failed(state)
    else
      let rawQueryText = Stdlib.String.join(parsed.queryParts, " ")

      let aliasKeyword = operatorAlias(rawQueryText)
      let queryText = Stdlib.Option.withDefault(aliasKeyword, rawQueryText)

      if Stdlib.String.isEmpty(queryText) then
        Cli.printErr("Error: Search query cannot be empty")
        // "everything of this kind" is a listing, not a search, and `--trait` with no query is
        // the natural way to reach for it.
        Stdlib.printErrorLine(
          (Stdlib.Cli.UI.Colors.hint(
            "  for everything in one place, `dark ls <module>` sections by kind; `dark tree` goes deeper")))

        Stdlib.printErrorLine("")
        Stdlib.printErrorLine(usage)
        Cli.failed(state)
      else
        let searchDepth =
          if parsed.shallow then
            LanguageTools.ProgramTypes.Search.SearchDepth.OnlyDirectDescendants
          else
            LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants

        // What is searched for, and where. Also what results are ranked by, so a
        // scoped search ranks by the item part of the query, not the module part.
        let (currentModule, searchText) =
          if parsed.shallow then
            shallowScope(
              state.currentBranchId,
              state.packageData.currentLocation,
              queryText)
          else
            (Traversal.getCurrentModulePath(state.packageData.currentLocation),
             queryText)

        let query =
          LanguageTools.ProgramTypes.Search.SearchQuery
            { currentModule = currentModule
              text = searchText
              searchDepth = searchDepth
              entityTypes = parsed.entityTypes
              exactMatch = parsed.exactMatch }

        // `size of string` is searched as `length string` too. An exact search means
        // what it says.
        let synonyms = if parsed.exactMatch then [] else synonymQueries(searchText)
        let alsoSearched = synonyms |> Stdlib.List.map(fun((q, _)) -> q)
        let rawResults =
          alsoSearched
          |> Stdlib.List.fold(
            LanguageTools.PackageManager.Search.search(state.currentBranchId, query),
            fun(acc, q) ->
              mergeResults(
                acc,
                LanguageTools.PackageManager.Search.search(state.currentBranchId, { query with text = q })))
        let depSets = Query.loadDeprecationSets(state.currentBranchId)
        let results = Query.filterHidden(rawResults, depSets, parsed.deprecated, parsed.internal)

        // An implementation is one result. Its method fns live under it and its path reads as a
        // module, so without this each one was listed three times. A method matches on its own
        // name even when its impl does not (`search Int64.display` matched
        // `Json.ParseError.Display.display`), so every impl below the search is looked at.
        let implPaths =
          Builtin.pmImplPathsBelow(state.currentBranchId, currentModule)
          |> Stdlib.List.map(fun path -> (path, true))
          |> Stdlib.Dict.fromList
        let isImpl = fun path -> Stdlib.Dict.containsKey(implPaths, Stdlib.String.join(path, "."))
        let results =
          { results with
              fns =
                results.fns
                |> Stdlib.List.filter(fun f ->
                  Stdlib.Bool.not(isImpl(Stdlib.List.prepend(f.location.modules, f.location.owner))))
              submodules =
                results.submodules
                |> Stdlib.List.filter(fun m -> Stdlib.Bool.not(isImpl(m))) }
        // Tests are left out unless asked for. A test is usually named after what
        // it tests, so every search for a function would also list its tests;
        // `dark test run <filter>` and `view --include-tests` are where to find them.
        // Searched for anyway, so the hint below can say how many were left out.
        let showTests =
          parsed.includeTests
          || Stdlib.List.contains(
            parsed.entityTypes,
            LanguageTools.ProgramTypes.Search.EntityType.Test)
        let hiddenTests = if showTests then 0 else Stdlib.List.length(results.tests)
        let results = if showTests then results else { results with tests = [] }
        // Test helpers go with the tests, unless the search is about tests.
        let (results, hiddenHelpers) =
          if showTests || showsTestHelpers(searchText, currentModule) then
            (results, 0)
          else
            withoutTestHelpers(results)

        // `bytes to string`: the Stdlib functions by what they take and return. They
        // print in a section of their own, so they leave the name matches.
        let wantsFns =
          Stdlib.List.isEmpty(parsed.entityTypes)
          || Stdlib.List.contains(
            parsed.entityTypes,
            LanguageTools.ProgramTypes.Search.EntityType.Fn)
        let typed =
          match typeQuery(searchText) with
          | Some((source, target)) when wantsFns ->
            byType(state.currentBranchId, source, target)
            |> Stdlib.List.filter(fun f -> Stdlib.Bool.not(Query.isHidden(depSets, f.entity.hash)))
          | _ -> []
        let typedPaths = typed |> Stdlib.List.map(fun f -> fullPathOf(f))
        let results =
          { results with
              fns =
                results.fns
                |> Stdlib.List.filter(fun f -> Stdlib.Bool.not(Stdlib.List.contains(typedPaths, fullPathOf(f)))) }

        // Only count submodules when no entity type filter is specified
        let submodulesCount =
          if Stdlib.List.isEmpty(parsed.entityTypes) then
            Stdlib.List.length(results.submodules)
          else
            0

        let totalResults =
          (Stdlib.List.length(results.types))
          + (Stdlib.List.length(results.values))
          + (Stdlib.List.length(results.fns))
          + (Stdlib.List.length(results.traits))
          + (Stdlib.List.length(results.impls))
          + (Stdlib.List.length(results.tests))
          + (Stdlib.List.length(typed))
          + submodulesCount

        // Ranked by how many items call each result, read once for all of them.
        let uses =
          if totalResults == 0 then
            Stdlib.Dict.empty
          else
            callerUses(results, typed)
        let typed = typed |> Stdlib.List.sortBy(fun f -> typeMatchKey(uses, f))
        let ranker =
          rankerWith(searchText, synonyms |> Stdlib.List.map(fun((_, target)) -> target), uses)

        if parsed.asJson then
          let found =
            if totalResults == 0 then nothingFound(state.currentBranchId, query) else nothingToTry
          Stdlib.printLine(
            jsonOutput(
              state.currentBranchId,
              queryText,
              alsoSearched,
              found,
              { results with fns = Stdlib.List.flatten([ typed, results.fns ]) }))
        else if totalResults == 0 then
          Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.dimText($"No results found for: {queryText}"))
          operatorHint(state.currentBranchId, rawQueryText)
          hiddenTestsHint(hiddenTests)
          hiddenHelpersHint(hiddenHelpers)
          nothingFoundLines(nothingFound(state.currentBranchId, query))
          |> Stdlib.List.iter(fun line -> Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint(line)))
          Stdlib.printErrorLine("")
        else
          Stdlib.printLine(Stdlib.Cli.UI.Colors.boldText($"Search results for: {queryText}"))
          match aliasKeyword with
          | Some(kw) ->
            Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint($"  ({rawQueryText} is {kw})"))
          | None -> ()
          operatorHint(state.currentBranchId, rawQueryText)
          match alsoSearched with
          | [] -> ()
          | qs ->
            let shown = qs |> Stdlib.List.map(fun q -> $"`{q}`") |> Stdlib.String.join(", ")
            Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint($"  (also searched {shown})"))
          Stdlib.printLine("")

          // Key format: match rank followed by the fixed section order.
          let resultCap = if parsed.batch then batchDisplayCap else displayCap

          match typeQuery(searchText) with
          | Some((source, target)) when Stdlib.Bool.not(Stdlib.List.isEmpty(typed)) ->
            Stdlib.printLine(
              $"{Darklang.Cli.Glyphs.forKind("fn")} Functions from {typeLabel(source)} to {typeLabel(target)}:")
            let shownTyped = Stdlib.List.take(typed, resultCap)
            shownTyped
            |> Stdlib.List.iter(fun item ->
              let ctx = contextFor(state.currentBranchId, item)
              let sigBody = Signatures.formatFn(ctx, item.entity)
              let line = $"{fullPathOf(item)} {Stdlib.Cli.UI.Colors.dimText(sigBody)}"
              Stdlib.printLine(withOptionalDoc(parsed.withDocs, line, item.entity.description)))
            overflowNote(Stdlib.List.length(typed), Stdlib.List.length(shownTyped))
            Stdlib.printLine("")
          | _ -> ()

          let moduleRank =
            if Stdlib.List.isEmpty(parsed.entityTypes) then
              bestModuleRank(searchText, results.submodules)
            else
              9

          let results =
            { results with
                types = ranked(ranker, results.types)
                values = ranked(ranker, results.values)
                fns = ranked(ranker, results.fns)
                traits = ranked(ranker, results.traits)
                impls = ranked(ranker, results.impls)
                tests = ranked(ranker, results.tests) }

          // Suffix orders sections on a rank tie. Modules are navigation, not the
          // usual discovery target, so they sort last - a wall of namespace
          // matches shouldn't precede an equally-ranked fn/type/value hit.
          let moduleKey =
            Stdlib.String.padEnd($"{Stdlib.display(moduleRank)}1", '9', rankKeyHead)
          let sectionKeys =
            [ ($"{moduleKey}4", "module")
              ($"{bestItemKey(ranker, results.types)}1", "type")
              ($"{bestItemKey(ranker, results.values)}2", "value")
              ($"{bestItemKey(ranker, results.fns)}3", "function")
              ($"{bestItemKey(ranker, results.traits)}0", "trait")
              ($"{bestItemKey(ranker, results.impls)}5", "impl")
              ($"{bestItemKey(ranker, results.tests)}6", "test") ]

          let order =
            sectionKeys
            |> Stdlib.List.sortBy(fun((key, _)) -> key)
            |> Stdlib.List.map(fun((_, tag)) -> tag)

          order
          |> Stdlib.List.iter(fun tag ->
            match tag with
            | "function" ->
              renderSection("function", resultCap, results.fns, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                let ctx = contextFor(state.currentBranchId, item)
                let sigBody = Signatures.formatFn(ctx, item.entity)
                let badge =
                  Stdlib.Cli.UI.Colors.dimText(
                    Permissions.Command.requirementBadge(item.entity.hash))
                let line =
                  $"{fullPathOf(item)} {Stdlib.Cli.UI.Colors.dimText(sigBody)}{mark} {badge}"
                withOptionalDoc(parsed.withDocs, line, item.entity.description))
            | "value" ->
              renderSection("value", resultCap, results.values, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                withOptionalDoc(parsed.withDocs, $"{fullPathOf(item)}{mark}", item.entity.description))
            | "type" ->
              renderSection("type", resultCap, results.types, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                let ctx = contextFor(state.currentBranchId, item)
                let defn = Signatures.formatType(ctx, fullPathOf(item), item.entity)
                withOptionalDoc(parsed.withDocs, $"{defn}{mark}", item.entity.description))
            | "trait" ->
              renderSection("trait", resultCap, results.traits, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                withOptionalDoc(parsed.withDocs, $"{fullPathOf(item)}{mark}", item.entity.description))
            | "impl" ->
              renderSection("impl", resultCap, results.impls, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                let ctx = contextFor(state.currentBranchId, item)
                // The call first, as it is written (`a % b`, `Stdlib.display(v)`): the impl's own
                // path is never where a call goes, so it comes after.
                let header =
                  $"impl {PrettyPrinter.ProgramTypes.NameResolution.traitName(ctx, item.entity.trait_)} for {PrettyPrinter.ProgramTypes.typeReference(ctx, item.entity.self)}, at {fullPathOf(item)}"
                let line =
                  match Packages.Impls.callExamples(state.currentBranchId, ctx, item.entity) with
                  | [] -> $"{fullPathOf(item)} {Stdlib.Cli.UI.Colors.dimText(header)}{mark}"
                  | calls -> $"{Stdlib.String.join(calls, ", ")}  {Stdlib.Cli.UI.Colors.dimText(header)}{mark}"
                withOptionalDoc(parsed.withDocs, line, item.entity.description))
            | "test" ->
              renderSection("test", resultCap, results.tests, fun item ->
                let mark = Query.deprecationMarker(depSets, item.entity.hash)
                withOptionalDoc(parsed.withDocs, $"{fullPathOf(item)}{mark}", item.entity.description))
            | "module" ->
              if (Stdlib.List.isEmpty(parsed.entityTypes)) && (Stdlib.Bool.not(Stdlib.List.isEmpty(results.submodules))) then
                Stdlib.printLine(Display.getSectionHeader("module"))
                let sortedMods =
                  results.submodules
                  |> Stdlib.List.sortBy(fun modulePath ->
                    let modName = Stdlib.Option.withDefault(Stdlib.List.last(modulePath), "")
                    let owner = Stdlib.Option.withDefault(Stdlib.List.head(modulePath), "")
                    let mods = Stdlib.Option.withDefault(Stdlib.List.tail(modulePath), [])
                    rankKey(ranker, owner, mods, modName))
                let shownMods = Stdlib.List.take(sortedMods, resultCap)
                shownMods
                |> Stdlib.List.iter(fun modulePath ->
                  let moduleStr = Stdlib.String.join(modulePath, ".")
                  Stdlib.printLine(moduleStr))
                overflowNote(Stdlib.List.length(sortedMods), Stdlib.List.length(shownMods))
                Stdlib.printLine("")
              else
                ()
            | _ -> ())

          hiddenTestsHint(hiddenTests)
          hiddenHelpersHint(hiddenHelpers)
          if (Stdlib.Bool.not(parsed.withDocs)) && (Stdlib.Bool.not(parsed.batch)) then
            Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint("  (add --with-docs to show doc comments)"))
          else
            ()

        state



let execute(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | [] -> executeQuery(state, args)
  | _ ->
    let parsed = parseArgs(args)
    // A name has no spaces, so several words under --exact are several names, not one
    // phrase that nothing could match exactly.
    let several =
      parsed.batch
      || (parsed.exactMatch && (Stdlib.List.length(parsed.queryParts) > 1))

    if
      (Stdlib.Bool.not(several))
      || (Stdlib.Bool.not(Stdlib.List.isEmpty(parsed.parseErrors)))
    then
      executeQuery(state, args)
    else if Stdlib.List.isEmpty(parsed.queryParts) then
      Cli.printErr("Error: Batch search requires at least one query")
      Stdlib.printErrorLine("")
      Stdlib.printErrorLine(usage)
      Cli.failed(state)
    else
      // FlagParser has no value-taking flags in this command, so retaining the
      // original flag arguments is sufficient to give every query the same
      // filters. Each positional remains one query even when it contains spaces. Each query
      // gets `--batch` even when several --exact names put it here without one, so it caps
      // its results and leaves the --with-docs hint to the end.
      let flags =
        args
        |> Stdlib.List.filter(fun arg -> Stdlib.String.startsWith(arg, "--") && arg != "--batch")
        |> Stdlib.List.prepend("--batch")

      parsed.queryParts
      |> Stdlib.List.iter(fun query ->
        let queryArgs = Stdlib.List.prepend(flags, query)
        let _ = executeQuery(state, queryArgs)
        ())

      if Stdlib.Bool.not(parsed.withDocs) then
        Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint("  (add --with-docs to show doc comments)"))
      else
        ()

      state


let help(state: Cli.AppState): String =
  [
    "Search modules, types, functions, values, traits, implementations and tests"
    ""
    "Usage: search [query] [options]"
    ""
    "Without query: Launch interactive search mode"
    "With query: Execute search and display results"
    ""
    "Options:"
    "  --batch                Treat each quoted query as an independent search (3 results each)"
    "  --type                 Search only types"
    "  --fn                   Search only functions"
    "  --val                  Search only values"
    "  --trait                Search only traits"
    "  --impl                 Search only implementations of traits"
    "  --test                 Search only tests"
    "  --include-tests        Also list tests and test helpers (left out by default)"
    "  --exact                Require exact match (default: fuzzy); several names"
    "                         are looked up one by one"
    "  --shallow              Search only direct children (default: all descendants);"
    "                         a qualified query searches inside the module it names"
    "  --with-docs            Also show doc comments"
    "  --include-deprecated   Include items deprecated with no live callers"
    "  --include-internal     Include internal helpers (names starting with __)"
    "  --json                 The results, typed, for an agent"
    ""
    "Examples:"
    "  search                      # Launch interactive search mode"
    "  search List                 # Find all items matching 'List' (recursively)"
    "  search List --shallow       # Find all items matching 'List' (direct descendants only)"
    "  search Darklang.Stdlib.List --shallow"
    "                              # Everything directly in Darklang.Stdlib.List"
    "  search map --fn             # Find functions matching 'map' (with param names)"
    "  search map --fn --with-docs # ...and doc comments too"
    "  search --batch \"List.map\" \"Json.serialize\" \"String.slice\" --fn"
    "                              # Run several searches in one command"
    "  search String --type        # Find types matching 'String'"
    "  search parseJson --exact    # Find exact match for 'parseJson'"
    "  search Http --fn --val      # Find functions and values matching 'Http'"
    "  search doubles --test       # Find tests matching 'doubles'"
    "  search ceiling --include-tests  # Everything matching, tests too"
    "  search bytes to string      # Stdlib functions taking Bytes and returning a String"
    "  search String->Int64        # The same, by type name"
    "  search size of string       # Also searches `length string`, the name Stdlib uses"
    ""
    "By default, search looks in the current module and ALL nested descendants recursively."
    "Use --shallow to search only direct children of the current module, or of the"
    "module a qualified query names."
    "Use 'nav' to change your current location first if needed."
    ""
  ] |> Stdlib.String.join("\n")


let complete(_state: Cli.AppState, args: List<String>): List<Cli.Completion.CompletionItem> =
  // Offer flag completions when typing --
  match Stdlib.List.last(args) with
  | Some(lastArg) ->
    if Stdlib.String.startsWith(lastArg, "--") then
      ["--batch", "--type", "--fn", "--val", "--trait", "--impl", "--test", "--exact", "--shallow", "--with-docs", "--include-deprecated", "--include-internal", "--include-tests"]
      |> Stdlib.List.filter(fun flag -> Stdlib.String.startsWith(flag, lastArg))
      |> Stdlib.List.map(Cli.Completion.simple)
    else
      []
  | None -> []
