module Darklang.Cli.Packages.Errors

/// Whether an invalid name uses the internal `PACKAGE.` notation, allowing the
/// CLI to show its source spelling.
let isInternalPackageName(originalName: List<String>): Bool =
  match originalName with
  | ["PACKAGE", ...] -> true
  | _ -> false


let sourceNameWithoutInternalPrefix(originalName: List<String>): String =
  let sourceParts =
    match originalName with
    | ["PACKAGE", "Darklang", "Stdlib", ...rest] -> Stdlib.List.prepend(rest, "Stdlib")
    | ["PACKAGE", ...rest] -> rest
    | _ -> originalName

  Stdlib.String.join(sourceParts, ".")


let splitLast(parts: List<String>): Option<(List<String> * String)> =
  match Stdlib.List.reverse(parts) with
  | [] -> Option.None
  | [name, ...reversedModules] -> Option.Some((Stdlib.List.reverse(reversedModules), name))


/// One place a name could live in the standard library: how the user would write it, and where it is.
/// <param writtenPrefix> is how they spelled the root, `Stdlib` or `Darklang.Stdlib`, and
/// <param modules> are the modules below it.
let stdlibCandidate(
  writtenPrefix: List<String>,
  modules: List<String>,
  name: String)
  : (String * LanguageTools.ProgramTypes.PackageLocation) =
  let written = Stdlib.List.flatten([ writtenPrefix, modules, [ name ] ]) |> Stdlib.String.join(".")
  let location =
    LanguageTools.ProgramTypes.PackageLocation
      { owner = "Darklang", modules = Stdlib.List.prepend(modules, "Stdlib"), name = name }

  (written, location)


/// The modules enclosing <param modules>, nearest first, down to the empty root:
/// `[Int64, Bits]` gives `[Int64]` then `[]`.
let enclosingModules(modules: List<String>): List<List<String>> =
  match modules with
  | [] -> []
  | _ ->
    let parent = Stdlib.List.dropLast(modules)
    Stdlib.List.prepend(enclosingModules(parent), parent)


/// The Stdlib name for a job another language spells differently: `toString` is `display`,
/// and `Int64.absoluteValue` is the generic `abs`.
let otherLanguageName(name: String): Option<String> =
  match name with
  | "toString" -> Option.Some("display")
  | "toRepr" -> Option.Some("inspect")
  | "absoluteValue" | "absolute" -> Option.Some("abs")
  | _ -> Option.None


/// The conversion written from the other side: `UInt8.toInt64` is `Int64.fromUInt8`, and
/// `Int64.fromUInt8` is `UInt8.toInt64`. Each as (the module it is in, its name).
let conversionName(modules: List<String>, name: String): Option<(List<String> * String)> =
  match splitLast(modules) with
  | None -> Option.None
  | Some((outer, from)) ->
    let other = fun prefix ->
      let rest = Stdlib.String.dropFirst(name, Stdlib.String.length(prefix))
      match Stdlib.String.toList(rest) with
      | [c, ...] when Stdlib.String.startsWith(name, prefix) && Stdlib.Char.isUppercase(c) ->
        Option.Some(rest)
      | _ -> Option.None

    match other("to"), other("from") with
    | Some(target), _ -> Option.Some((Stdlib.List.append(outer, target), "from" + from))
    | _, Some(source) -> Option.Some((Stdlib.List.append(outer, source), "to" + from))
    | _ -> Option.None


/// Where an unresolved name might really be, in the order <fn stdlibSuggestion> tries them.
///
/// A name without a `Stdlib.` prefix gets one: `Bool.not` -> `Stdlib.Bool.not`. A name already under
/// `Stdlib.` tries its final name in each enclosing module, nearest first, down to the `Stdlib` root:
/// `Stdlib.Int64.max` -> `Stdlib.max`. An unprefixed name walks up only from one module, so
/// `Int64.max` also tries `Stdlib.max`: a deeper one may be the user's own module that does not
/// exist yet. Last, a name from <fn otherLanguageName> tries its Stdlib one: `Int64.toString` ->
/// `Stdlib.display`.
let stdlibSuggestionCandidates(
  originalName: List<String>)
  : List<(String * LanguageTools.ProgramTypes.PackageLocation)> =
  match splitLast(originalName) with
  | None -> []
  | Some((modules, name)) ->
    let walkUp = fun(writtenPrefix, inner) ->
      enclosingModules(inner) |> Stdlib.List.map(fun m -> stdlibCandidate(writtenPrefix, m, name))

    let renamed = fun(writtenPrefix, inner) ->
      let converted =
        match conversionName(inner, name) with
        | Some((m, n)) -> [ stdlibCandidate(writtenPrefix, m, n) ]
        | None -> []

      match otherLanguageName(name) with
      | Some(other) -> Stdlib.List.append(converted, stdlibCandidate(writtenPrefix, [], other))
      | None -> converted

    match modules with
    | [] -> []
    | ["Stdlib", ...inner] ->
      Stdlib.List.concat(walkUp([ "Stdlib" ], inner), renamed([ "Stdlib" ], inner))
    | ["Darklang", "Stdlib", ...inner] ->
      Stdlib.List.concat(
        walkUp([ "Darklang", "Stdlib" ], inner),
        renamed([ "Darklang", "Stdlib" ], inner))
    | ["Darklang", ...] -> []
    | ["PACKAGE", ...] -> []
    | [_] ->
      Stdlib.List.flatten(
        [ [ stdlibCandidate([ "Stdlib" ], modules, name) ]
          walkUp([ "Stdlib" ], modules)
          renamed([ "Stdlib" ], modules) ])
    | _ ->
      Stdlib.List.prepend(
        renamed([ "Stdlib" ], modules),
        stdlibCandidate([ "Stdlib" ], modules, name))


/// Names other languages give a job Stdlib does under another name, or with two calls: each
/// (module, the names lowercased, what to write instead).
let otherLanguageNames(): List<(String * List<String> * String)> =
  [ ("String", [ "frombytes", "fromutf8" ], "Stdlib.Utf8.decode")
    ("Bytes", [ "tostring" ], "Stdlib.Utf8.decode")
    ("String", [ "tobytes", "toutf8" ], "Stdlib.Utf8.encode")
    ("Bytes", [ "fromstring" ], "Stdlib.Utf8.encode")
    ("Char", [ "tostring" ], "Stdlib.String.fromChar")
    (
      "List",
      [ "flatmap", "concatmap", "collect", "bind", "selectmany", "chain" ],
      "Stdlib.List.flatten(Stdlib.List.map(xs, f))")

    ("List", [ "choose", "mapmaybe", "compactmap" ], "Stdlib.List.filterMap")
    (
      "List",
      [ "iteri"
        "mapi"
        "enumerate"
        "withindex"
        "eachwithindex"
        "mapindexed"
        "foreachindexed" ],
      "Stdlib.List.indexedMap")

    (
      "Float64",
      [ "format", "tostringfixed", "toprecision", "formatfixed", "tofixed", "roundto" ],
      "Stdlib.Decimal.round")

    ("List", [ "nth", "item", "at", "elementat", "get" ], "Stdlib.List.getAt")
    ("List", [ "reduce", "foldl", "foldleft", "inject", "aggregate" ], "Stdlib.List.fold")
    ("String", [ "toint", "parseint" ], "Stdlib.Int64.parse")
    ("String", [ "tofloat", "parsefloat" ], "Stdlib.Float64.parse")
    ("String", [ "substring", "substr" ], "Stdlib.String.slice") ]


/// What to write for a name <fn otherLanguageNames> lists: `List.flatMap` is
/// `Stdlib.List.flatten(Stdlib.List.map(xs, f))`, and `Bytes.toString` is `Stdlib.Utf8.decode`.
let guessedName(originalName: List<String>): Option<String> =
  let lastTwo =
    originalName
    |> Stdlib.List.reverse
    |> Stdlib.List.take(2)
    |> Stdlib.List.map(Stdlib.String.toLowercase)

  match lastTwo with
  | [name, moduleName] ->
    otherLanguageNames()
    |> Stdlib.List.findFirst(fun((m, names, _)) ->
      Stdlib.String.toLowercase(m) == moduleName && Stdlib.List.contains(names, name))
    |> Stdlib.Option.map(fun((_, _, instead)) -> instead)
  | _ -> Option.None


/// Suggest the standard-library name an unresolved name probably meant, when an item exists there:
/// a <fn guessedName>, or else the first of <fn stdlibSuggestionCandidates> that is on the branch.
let stdlibSuggestion(branchId: Uuid, originalName: List<String>): Option<String> =
  match guessedName(originalName) with
  | Some(name) -> Option.Some(name)
  | None ->
    stdlibSuggestionCandidates(originalName)
    |> Stdlib.List.findFirst(fun((_, location)) ->
      Stdlib.Option.isSome(LanguageTools.PackageManager.findAny(branchId, location)))
    |> Stdlib.Option.map(fun((written, _)) -> written)


/// The modules an unresolved name's module may be, each as (how the user would write it, where
/// it is): `Stdlib.String` is `Darklang.Stdlib.String`, and a module with no `Stdlib.` in front is
/// tried as written and under `Stdlib`.
let closestNameModules(modules: List<String>): List<(List<String> * List<String>)> =
  match modules with
  | [] -> []
  | ["PACKAGE", ...] -> []
  | ["Stdlib", ...inner] -> [ (modules, Stdlib.List.flatten([ [ "Darklang", "Stdlib" ], inner ])) ]
  | ["Darklang", ...] -> [ (modules, modules) ]
  | _ ->
    [ (modules, modules)
      (
        Stdlib.List.prepend(modules, "Stdlib"),
        Stdlib.List.flatten([ [ "Darklang", "Stdlib" ], modules ])) ]


/// Up to three existing names in the module <param originalName> names that are spelled close to
/// it or are Stdlib's word for it (<fn Search.wordSynonyms>): `Stdlib.List.lenght` and
/// `Stdlib.List.size` give `Stdlib.List.length`.
let closestNames(branchId: Uuid, originalName: List<String>): List<String> =
  match splitLast(originalName) with
  | None -> []
  | Some((modules, name)) ->
    closestNameModules(modules)
    |> Stdlib.List.map(fun((written, location)) ->
      let (_, types, values, fns, _, _, _) = Query.allDirectDescendantNames(branchId, location)
      LanguageTools.Suggest.near(
        name,
        Stdlib.List.flatten([ fns, values, types ]),
        Search.wordSynonyms(name))
      |> Stdlib.List.map(fun candidate -> Stdlib.String.join(Stdlib.List.append(written, candidate), ".")))
    |> Stdlib.List.flatten
    |> Stdlib.List.unique
    |> Stdlib.List.take(3)


/// The operator a function name stands for, as (its trait, the trait's method, how it is
/// written), when the name is that method or a usual word for it: `mod` and `modulo` are `%`.
let operatorOfName(name: String): Option<(String * String * String)> =
  match Stdlib.String.toLowercase(name) with
  | "add" | "plus" -> Option.Some(("Add", "add", "a + b"))
  | "sub" | "subtract" | "minus" -> Option.Some(("Subtract", "subtract", "a - b"))
  | "mul" | "multiply" | "times" -> Option.Some(("Multiply", "multiply", "a * b"))
  | "div" | "divide" -> Option.Some(("Divide", "divide", "a / b"))
  | "mod" | "modulo" -> Option.Some(("Modulo", "modulo", "a % b"))
  | "pow" | "power" -> Option.Some(("Power", "power", "a ** b"))
  | "neg" | "negate" -> Option.Some(("Negate", "negate", "-a"))
  | "shiftleft" -> Option.Some(("ShiftLeft", "shiftLeft", "a << b"))
  | "shiftright" -> Option.Some(("ShiftRight", "shiftRight", "a >> b"))
  | "bitwiseand" -> Option.Some(("BitwiseAnd", "bitwiseAnd", "a & b"))
  | "bitwiseor" -> Option.Some(("BitwiseOr", "bitwiseOr", "a | b"))
  | "bitwisexor" | "xor" -> Option.Some(("BitwiseXor", "bitwiseXor", "a ^ b"))
  | "bitwisenot" -> Option.Some(("BitwiseNot", "bitwiseNot", "~a"))
  | "lessthan" -> Option.Some(("Compare", "lessThan", "a < b"))
  | "greaterthan" -> Option.Some(("Compare", "greaterThan", "a > b"))
  | _ -> Option.None


/// The operator an unresolved name was reaching for, written out (`a % b`), when its module is a
/// type with that operator: `Stdlib.Int64.mod` is `%`, since `Int64` implements `Modulo`. A type
/// without it gets nothing, so `Stdlib.String.mod` is not sent to `%`.
let operatorSuggestion(branchId: Uuid, originalName: List<String>): Option<String> =
  match splitLast(originalName) with
  | None -> Option.None
  | Some((modules, name)) ->
    match operatorOfName(name) with
    | None -> Option.None
    | Some((traitName, methodName, written)) ->
      let implemented =
        closestNameModules(modules)
        |> Stdlib.List.any(fun((_, location)) ->
          match location with
          | [] -> false
          | [owner, ...inner] ->
            let method =
              LanguageTools.ProgramTypes.PackageLocation
                { owner = owner, modules = Stdlib.List.append(inner, traitName), name = methodName }

            Stdlib.Option.isSome(LanguageTools.PackageManager.findAny(branchId, method)))

      if implemented then Option.Some(written) else Option.None


/// The overflow-checked function next to an operator's name, when its module has one:
/// `Stdlib.Int64.add` is `+`, which wraps, or `Stdlib.Int64.checkedAdd`, which says so.
let checkedSibling(branchId: Uuid, originalName: List<String>): List<String> =
  match splitLast(originalName) with
  | None -> []
  | Some((modules, name)) ->
    match operatorOfName(name) with
    | None -> []
    | Some((_, methodName, _)) ->
      let checked = "checked" + Stdlib.String.capitalize(methodName)
      closestNameModules(modules)
      |> Stdlib.List.filterMap(fun((written, location)) ->
        let (_, _, _, fns, _, _, _) = Query.allDirectDescendantNames(branchId, location)
        if Stdlib.List.contains(fns, checked) then
          Option.Some(Stdlib.String.join(Stdlib.List.append(written, checked), "."))
        else
          Option.None)
      |> Stdlib.List.take(1)


/// The same name one module further down: `Stdlib.Http.header` is `Stdlib.Http.Request.header`.
let namesOneModuleDown(branchId: Uuid, originalName: List<String>): List<String> =
  match splitLast(originalName) with
  | None -> []
  | Some((modules, name)) ->
    closestNameModules(modules)
    |> Stdlib.List.map(fun((written, location)) ->
      let (subs, _, _, _, _, _, _) = Query.allDirectDescendantNames(branchId, location)
      subs
      |> Stdlib.List.filter(fun sub ->
        let (_, types, values, fns, _, _, _) =
          Query.allDirectDescendantNames(branchId, Stdlib.List.append(location, sub))

        Stdlib.List.contains(Stdlib.List.flatten([ fns, values, types ]), name))
      |> Stdlib.List.map(fun sub ->
        Stdlib.String.join(Stdlib.List.flatten([ written, [ sub, name ] ]), ".")))
    |> Stdlib.List.flatten
    |> Stdlib.List.take(3)


/// What an unresolved name probably meant: the standard-library name it moved to
/// (<fn stdlibSuggestion>), the operator it is (<fn operatorSuggestion>), the same name one module
/// down (<fn namesOneModuleDown>), or else the names in its module spelled closest to it.
let didYouMean(branchId: Uuid, originalName: List<String>): List<String> =
  match stdlibSuggestion(branchId, originalName) with
  | Some(name) -> [ name ]
  | None ->
    match operatorSuggestion(branchId, originalName) with
    | Some(written) -> Stdlib.List.concat([ written ], checkedSibling(branchId, originalName))
    | None ->
      match namesOneModuleDown(branchId, originalName) with
      | [] -> closestNames(branchId, originalName)
      | names -> names


/// Prints every parse diagnostic, so one save shows all there is to fix. Returns true when
/// parsing failed.
let reportParseErrors(diagnostics: List<(LanguageTools.Parser.Range * String)>): Bool =
  diagnostics
  |> Stdlib.List.iter(fun((range, message)) ->
    let lineNum = range.start.row + 1 |> Stdlib.display
    // 1-based column, matching renderDiagnostic and the line number above
    let colNum = range.start.column + 1 |> Stdlib.display
    printErr($"Parse error at line {lineNum}, column {colNum}: {message}"))

  Stdlib.Bool.not(Stdlib.List.isEmpty(diagnostics))


/// Whether one authoring command was handed more than one thing, and says so.
///
/// The arguments are joined into one source, so a stray extra one parses as a second
/// declaration or a bare expression. Taking the first declaration and ignoring the rest
/// saved `dark val Me.A.x 42 zzznope` as `42` and reported success.
let reportTrailing(sourceFile: LanguageTools.WrittenTypes.SourceFile.SourceFile): Bool =
  let decls = Stdlib.List.length(sourceFile.declarations)
  let extra = decls + Stdlib.List.length(sourceFile.exprsToEval) - 1
  if extra > 0 then
    printErr("There is something after the definition; nothing was saved.")
    printHint("  Quote the whole definition as one argument, or pass `-` and pipe it in.")
    true
  else
    false


/// The unresolved names in one line, `Nope.missing (line 1), Other.thing (line 3)`, for a surface with no
/// room for <fn reportUnresolvedNames>'s list: the workbench's footer.
let unresolvedNamesText(
  unresolvedNames:
    List<
      (LanguageTools.Parser.Range * List<String> * LanguageTools.ProgramTypes.NameResolutionError)>)
  : String =
  unresolvedNames
  |> Stdlib.List.map(fun((range, originalName, _err)) ->
    let lineNum = range.start.row + 1 |> Stdlib.display
    $"{Stdlib.String.join(originalName, ".")} (line {lineNum})")
  |> Stdlib.String.join(", ")


/// Checks for invalid names (hard errors) and unresolved names (warnings).
/// Returns true if there are invalid names (which block creation).
/// Unresolved names are allowed in WIP — they'll be resolved by WipRefresh when
/// the missing items are added, and rejected at commit time if still unresolved.
/// Where a name that did not resolve from <param home> (owner first, then modules) is defined
/// in a module next to it or inside it: `TokKind` saved into `Me.Tiny.Lexer` gives
/// `Me.Tiny.Types.TokKind`. Up to three, as written in full.
let nearbyNames(branchId: Uuid, home: List<String>, originalName: List<String>): List<String> =
  match splitLast(originalName), home with
  | Some((modules, name)), [owner, ...homeModules] ->
    let submodulesOf = fun path ->
      let (subs, _, _, _, _, _, _) = Query.allDirectDescendantNames(branchId, path)
      subs |> Stdlib.List.map(fun sub -> Stdlib.List.append(path, sub))

    let places =
      match homeModules with
      | [] -> submodulesOf(home)
      | _ -> Stdlib.List.concat(submodulesOf(home), submodulesOf(Stdlib.List.dropLast(home)))

    places
    |> Stdlib.List.filter(fun place -> place != home)
    |> Stdlib.List.filterMap(fun place ->
      let location =
        LanguageTools.ProgramTypes.PackageLocation
          { owner = owner
            modules = Stdlib.List.concat(Stdlib.List.drop(place, 1), modules)
            name = name }

      if Stdlib.Option.isSome(LanguageTools.PackageManager.findAny(branchId, location)) then
        Option.Some(Stdlib.String.join(Stdlib.List.flatten([ place, modules, [ name ] ]), "."))
      else
        Option.None)
    |> Stdlib.List.take(3)
  | _ -> []


let reportUnresolvedNames(
  branchId: Uuid,
  home: List<String>,
  unresolvedNames:
    List<
      (LanguageTools.Parser.Range * List<String> * LanguageTools.ProgramTypes.NameResolutionError)>)
  : Bool =
  let invalidNames =
    unresolvedNames
    |> Stdlib.List.filter(fun((_, _, err)) ->
      match err with
      | InvalidName -> true
      | NotFound -> false)

  // A missing name under `Stdlib` or `Darklang` cannot arrive later: those owners are reserved,
  // so nothing a save makes can define it. It is a typo, and the save is refused.
  let isReserved = fun((_, name, _)) ->
    match name with
    | ["Stdlib", ...] | ["Darklang", ...] -> true
    | _ -> false

  let notFound =
    unresolvedNames
    |> Stdlib.List.filter(fun((_, _, err)) ->
      match err with
      | NotFound -> true
      | InvalidName -> false)

  let (reservedNames, notFoundNames) = Stdlib.List.partition(notFound, isReserved)

  // Warnings for unresolved names (will be fixed by WipRefresh). On stderr: the save's answer is the
  // "Created" line, and a warning is never part of it.
  if Stdlib.List.isEmpty(notFoundNames) |> Stdlib.Bool.not then
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.warning(
        "Warning: Unresolved references (will resolve when dependencies are added)"))

    notFoundNames
    |> Stdlib.List.iter(fun((range, originalName, _err)) ->
      let lineNum = range.start.row + 1 |> Stdlib.display
      let colNum = range.start.column |> Stdlib.display
      let nameStr = Stdlib.String.join(originalName, ".")
      let suggestion =
        let names =
          match didYouMean(branchId, originalName) with
          | [] -> nearbyNames(branchId, home, originalName)
          | names -> names

        match LanguageTools.Suggest.sentence(names) with
        | "" -> ""
        | text -> " " + text

      let message = $"  - Not found: {nameStr} (line {lineNum}, column {colNum}).{suggestion}"
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.warning(message)))

    Stdlib.printErrorLine("")

  if Stdlib.List.isEmpty(reservedNames) |> Stdlib.Bool.not then
    printErr("Error: Not in the standard library, so nothing was saved")
    reservedNames
    |> Stdlib.List.iter(fun((range, originalName, _err)) ->
      let lineNum = range.start.row + 1 |> Stdlib.display
      let colNum = range.start.column |> Stdlib.display
      let nameStr = Stdlib.String.join(originalName, ".")
      let suggestion =
        match LanguageTools.Suggest.sentence(didYouMean(branchId, originalName)) with
        | "" -> ""
        | text -> " " + text

      printErr($"  - Not found: {nameStr} (line {lineNum}, column {colNum}).{suggestion}"))

    Stdlib.printErrorLine("")

  // Print errors for invalid names (these block creation)
  if Stdlib.List.isEmpty(invalidNames) |> Stdlib.Bool.not then
    printErr("Error: Invalid names")
    invalidNames
    |> Stdlib.List.iter(fun((range, originalName, _err)) ->
      let lineNum = range.start.row + 1 |> Stdlib.display
      let colNum = range.start.column |> Stdlib.display
      let nameStr = Stdlib.String.join(originalName, ".")
      if isInternalPackageName(originalName) then
        let suggested = sourceNameWithoutInternalPrefix(originalName)
        let message =
          $"  - Invalid name: {nameStr} (line {lineNum}, column {colNum}). "
          + $"`PACKAGE.` is internal notation; write `{suggested}`."

        printErr(message)
      else
        let message = $"  - Invalid name: {nameStr} (line {lineNum}, column {colNum})"
        printErr(message))

    Stdlib.printErrorLine("")
    true
  else
    Stdlib.Bool.not(Stdlib.List.isEmpty(reservedNames))
