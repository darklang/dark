module Darklang.Cli.Packages.Delete

// Deleting a committed item deprecates it after checking for live dependents: history keeps it.
// An item that was never committed has nothing to keep, so it is discarded instead.
// Deleting a module does the same for each of its declarations, in one batch.

type ParsedArgs =
  { itemType: Option<String>
    target: Option<String>
    reason: String
    autoConfirm: Bool
    ignoreDependents: Bool
    dryRun: Bool
    json: Bool
    parseErrors: List<FlagParser.ParseError> }


val argSpec =
  FlagParser.Spec
    { flags =
        [ ("--yes", [ "-y" ])
          ("--ignore-dependents", [])
          ("--force", [])
          ("--dry-run", [])
          ("--json", []) ]
      valueFlags = [ ("--reason", [ "-m" ]) ] }


/// Positional args fill itemType, then target. `--force` is shorthand for
/// `--ignore-dependents --yes`: ignore live dependents and skip the prompt.
let parseArgs(args: List<String>): ParsedArgs =
  let p = FlagParser.parse(argSpec, args)
  let forced = FlagParser.hasFlag(p, "--force")
  ParsedArgs
    { itemType = Stdlib.List.getAt(p.positionals, 0)
      target = Stdlib.List.getAt(p.positionals, 1)
      reason = FlagParser.getOptionOr(p, "--reason", "")
      autoConfirm = FlagParser.hasFlag(p, "--yes") || forced
      ignoreDependents = FlagParser.hasFlag(p, "--ignore-dependents") || forced
      dryRun = FlagParser.hasFlag(p, "--dry-run")
      json = FlagParser.hasFlag(p, "--json")
      parseErrors = p.errors }


/// Count live dependents at this name. A shared hash at another name
/// does not make it a dependent of this binding.
let countLiveDependents(
  targetLoc: LanguageTools.ProgramTypes.PackageLocation,
  targetKind: LanguageTools.ProgramTypes.ItemKind,
  depSets: Query.DeprecationSets)
  : Int64 =
  let deps = SCM.Deps.dependentsFor(SCM.PackageOps.currentBranch(), [ (targetLoc, targetKind) ])
  deps
  |> Stdlib.List.filter(fun entry ->
    let (depHash, _depLoc, _depKind) = entry
    Stdlib.Bool.not(Query.isDeprecated(depSets, depHash)))
  |> Stdlib.List.length


/// The flags that get past live dependents. Without a terminal `--ignore-dependents` alone
/// would only stop again at the prompt.
let dependentsOverride(parsed: ParsedArgs): String =
  if parsed.autoConfirm || Stdlib.Cli.UI.Prompt.canAsk() then
    "`--ignore-dependents` / `--force`"
  else
    "`--force`"


/// A committed item renamed in the draft was committed.
let neverCommitted(branchId: Uuid, location: LanguageTools.ProgramTypes.PackageLocation): Bool =
  let renamedHere =
    SCM.PackageOps.draftEntriesFor(branchId)
    |> Stdlib.List.any(fun e ->
      match e.op with
      | Rename(_, l, _, _, _) -> l == location
      | _ -> false)

  Stdlib.Bool.not(renamedHere)
  && SCM.PackageOps.committedBindingsOn(
       branchId,
       [ (location.owner, Stdlib.String.join(location.modules, "."), location.name) ])
     == []


/// Forward the shared options to `deprecate`.
let toDeprecateArgs(parsed: ParsedArgs, itemTypeStr: String, target: String): List<String> =
  let baseArgs = [ itemTypeStr, target ]
  let reasonArgs = if parsed.reason != "" then [ "--reason", parsed.reason ] else []
  let confirmArgs = if parsed.autoConfirm then [ "--yes" ] else []
  let dryRunArgs = if parsed.dryRun then [ "--dry-run" ] else []
  let jsonArgs = if parsed.json then [ "--json" ] else []
  Stdlib.List.flatten([ baseArgs, reasonArgs, confirmArgs, dryRunArgs, jsonArgs ])


let execute(state: AppState, args: List<String>): AppState =
  let parsed = parseArgs(args)
  let branchId = state.currentBranchId
  match parsed.itemType, parsed.target with
  | _ when Stdlib.Bool.not(Stdlib.List.isEmpty(parsed.parseErrors)) ->
    printErr(FlagParser.parseErrorsMessage(parsed.parseErrors))
    Stdlib.printErrorLine(help(state))
    failed(state)
  | None, _ ->
    Stdlib.printLine(help(state))
    failed(state)
  | Some(first), target ->
    match LanguageTools.ProgramTypes.ItemKind.fromString(first), target with
    | Some(kind), Some(name) -> deleteItem(state, first, kind, name, parsed)
    | Some(_), None ->
      printErr($"Missing target after '{first}'.")
      failed(state)
    | None, Some(_) ->
      printErr($"'{first}' is not a valid item kind. See `dark help delete`.")
      failed(state)
    | None, None ->
      let inferred =
        Deprecate.allItemKinds
        |> Stdlib.List.filter(fun((kind, _)) ->
          Deprecate.resolveTarget(branchId, state.packageData.currentLocation, kind, first)
          != Option.None)

      match inferred with
      | [] -> deleteModule(state, first, parsed)
      | [(kind, word)] -> deleteItem(state, word, kind, first, parsed)
      | several ->
        let kinds =
          several
          |> Stdlib.List.map(Stdlib.Tuple2.second)
          |> Stdlib.String.join("|")

        printErr($"More than one item is named {first}. Use `dark delete <{kinds}> {first}`.")
        failed(state)


/// Check callers before applying a single-item deprecation.
let deleteItem(
  state: AppState,
  itemTypeStr: String,
  itemKind: LanguageTools.ProgramTypes.ItemKind,
  target: String,
  parsed: ParsedArgs)
  : AppState =
  let branchId = state.currentBranchId
  let currentLoc = state.packageData.currentLocation
  match Location.parseRelativeTo(currentLoc, target) with
  | Error(errMsg) ->
    printErr($"Could not resolve {itemTypeStr} {target}: {errMsg}")
    failed(state)
  | Ok(_) ->
    match Deprecate.resolveLocated(branchId, currentLoc, itemKind, target) with
    | None ->
      printErr($"Could not resolve {itemTypeStr} {target}")
      failed(state)
    | Some((targetLoc, reference)) ->
      let sets = Query.loadDeprecationSets(branchId)
      let hash = LanguageTools.ProgramTypes.Reference.hash(reference)
      let fresh = neverCommitted(branchId, targetLoc)
      if Stdlib.Bool.not(fresh) && Query.isDeprecatedAtLocation(sets, targetLoc, hash) then
        let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(targetLoc)
        printErr($"{name} is already deprecated.")
        failed(state)
      else
        let depCount = countLiveDependents(targetLoc, itemKind, sets)
        if depCount > 0 && Stdlib.Bool.not(parsed.ignoreDependents) then
          printErr(
            $"""{Text.plural(depCount, "live dependent")} still {if depCount == 1 then "references" else "reference"} this item.""")

          Stdlib.printErrorLine(
            $"Use `deprecate` to give them time to migrate, or pass {dependentsOverride(parsed)}.")

          failed(state)
        else if fresh then
          discardItem(state, itemTypeStr, targetLoc, target, parsed)
        else
          Deprecate.executeWithVerb(state, toDeprecateArgs(parsed, itemTypeStr, target), "delete")


/// Delete a never-committed item by discarding it.
let discardItem(
  state: AppState,
  itemTypeStr: String,
  location: LanguageTools.ProgramTypes.PackageLocation,
  target: String,
  parsed: ParsedArgs)
  : AppState =
  let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(location)
  let dryRun = parsed.dryRun || Stdlib.Bool.not(parsed.autoConfirm)
  if parsed.json then
    let written =
      if dryRun then
        Result.Ok(0)
      else
        SCM.PackageOps.discardDraftName(location.owner, location.modules, location.name)

    match written with
    | Ok(_) ->
      Deprecate.printReport(
        state,
        Deprecate.DeprecateJson
          { deprecated = name
            itemType = itemTypeStr
            kind = "discarded"
            replacement = ""
            message = parsed.reason
            names = [ name ]
            dryRun = dryRun })
    | Error(e) ->
      printErr($"Delete failed: {e}")
      failed(state)
  else if parsed.dryRun then
    Stdlib.printLine($"  Would discard {itemTypeStr} {name}: it was never committed.")
    Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint("(dry-run, no op emitted)"))
    state
  else
    Discard.execute(state, if parsed.autoConfirm then [ target, "-y" ] else [ target ])


/// Collect the bound declarations in a module and its descendants.
let moduleItems(
  branchId: Uuid,
  owner: String,
  modules: List<String>)
  : List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.Reference)> =
  let path = Stdlib.List.prepend(modules, owner)
  let (subs, types, values, fns, traits, impls, tests) =
    Query.allDirectDescendantNamesAndHashes(branchId, path)

  let here =
    [ (LanguageTools.ProgramTypes.ItemKind.Type, types)
      (LanguageTools.ProgramTypes.ItemKind.Value, values)
      (LanguageTools.ProgramTypes.ItemKind.Fn, fns)
      (LanguageTools.ProgramTypes.ItemKind.Trait, traits)
      (LanguageTools.ProgramTypes.ItemKind.TraitImpl, impls)
      (LanguageTools.ProgramTypes.ItemKind.Test, tests) ]
    |> Stdlib.List.map(fun((kind, items)) ->
      items
      |> Stdlib.List.filterMap(fun((name, _)) ->
        let location =
          LanguageTools.ProgramTypes.PackageLocation
            { owner = owner, modules = modules, name = name }

        // Search also matches paths with the owner omitted. Verify the binding at this exact path.
        Deprecate.findAt(branchId, kind, location)
        |> Stdlib.Option.map(fun reference -> (location, reference))))
    |> Stdlib.List.flatten

  let below =
    subs
    |> Stdlib.List.map(fun sub -> moduleItems(branchId, owner, Stdlib.List.append(modules, sub)))
    |> Stdlib.List.flatten

  Stdlib.List.concat(here, below)


/// <param name> as a module path, owner first.
let modulePath(state: AppState, name: String): Option<List<String>> =
  match Location.parseRelativeTo(state.packageData.currentLocation, name + ".__module__") with
  | Ok(location) -> Option.Some(Stdlib.List.prepend(location.modules, location.owner))
  | Error(_) -> Option.None


/// Look for declarations or submodules regardless of deprecation status.
let moduleExists(branchId: Uuid, path: List<String>): Bool =
  let (subs, types, values, fns, traits, impls, tests) =
    Query.allDirectDescendantNames(branchId, path)

  Stdlib.List.any([ subs, types, values, fns, traits, impls, tests ], fun names -> names != [])


/// Deprecate the module's items in one batch. Live callers outside the module
/// require an explicit override.
let deleteModule(state: AppState, name: String, parsed: ParsedArgs): AppState =
  let branchId = state.currentBranchId
  let notFound = fun () ->
    printErr($"No item or module named {name} was found.")
    failed(state)

  match modulePath(state, name) with
  | Some([owner, first, ...rest]) ->
    let shown = Stdlib.String.join([ owner, first, ...rest ], ".")
    let (owner, modules) =
      if owner == "Stdlib" then
        ("Darklang", [ "Stdlib", first, ...rest ])
      else
        (owner, [ first, ...rest ])

    match moduleItems(branchId, owner, modules) with
    | [] -> notFound()
    | items ->
      let sets = Query.loadDeprecationSets(branchId)
      let pending =
        items
        |> Stdlib.List.filter(fun((location, reference)) ->
          let hash = LanguageTools.ProgramTypes.Reference.hash(reference)
          Stdlib.Bool.not(Query.isDeprecatedAtLocation(sets, location, hash))
          || neverCommitted(branchId, location))

      match pending with
      | [] ->
        printErr($"All items in {shown} are already deprecated.")
        failed(state)
      | _ ->
        deleteModuleItems(state, shown, Stdlib.List.prepend(modules, owner), pending, sets, parsed)
  | Some([owner]) when moduleExists(branchId, [ owner ]) ->
    printErr($"Won't delete all of {owner} at once; delete one module: delete {owner}.<module>")
    failed(state)
  | _ -> notFound()


let deleteModuleItems(
  state: AppState,
  shown: String,
  path: List<String>,
  items: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.Reference)>,
  sets: Query.DeprecationSets,
  parsed: ParsedArgs)
  : AppState =
  let branchId = state.currentBranchId
  let depth = Stdlib.List.length(path)
  let outside =
    SCM.Deps.dependentsFor(
      SCM.PackageOps.currentBranch(),
      items
      |> Stdlib.List.map(fun((location, reference)) ->
        (location, LanguageTools.ProgramTypes.Reference.kind(reference))))
    |> Stdlib.List.filter(fun((hash, location, _)) ->
      let home = Stdlib.List.prepend(location.modules, location.owner)
      Stdlib.List.take(home, depth) != path && Stdlib.Bool.not(Query.isDeprecated(sets, hash)))
    |> Stdlib.List.map(fun((_, location, _)) ->
      PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(location))
    |> Stdlib.List.unique

  let (fresh, committed) =
    items |> Stdlib.List.partition(fun((location, _)) -> neverCommitted(branchId, location))

  let total = Stdlib.List.length(items)
  let count = Text.plural(total, "item")
  if Stdlib.Bool.not(Stdlib.List.isEmpty(outside)) && Stdlib.Bool.not(parsed.ignoreDependents) then
    printErr($"Used from outside {shown}: " + Stdlib.String.join(outside, ", "))
    Stdlib.printErrorLine($"Pass {dependentsOverride(parsed)} to delete it anyway.")
    failed(state)
  else
    let names =
      items
      |> Stdlib.List.map(fun((location, _)) ->
        PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(location))
      |> Stdlib.List.sortBy(fun name -> name)

    let dryRun = parsed.dryRun || parsed.json && Stdlib.Bool.not(parsed.autoConfirm)
    let reportJson(): AppState =
      Deprecate.printReport(
        state,
        Deprecate.DeprecateJson
          { deprecated = shown
            itemType = "module"
            kind = "deprecated"
            replacement = ""
            message = parsed.reason
            names = names
            dryRun = dryRun })

    let printItems(printLine: String -> Unit, action: String): Unit =
      printLine($"{action} {count} in {shown}:")
      names |> Stdlib.List.iter(fun name -> printLine($"  {name}"))
      if fresh == [] then
        printLine("They can still be used by name.")
      else
        printLine("Those never committed are discarded; the rest can still be used by name.")

    if Stdlib.Bool.not(parsed.json) then
      if dryRun then
        printItems(Stdlib.printLine, "Would delete")
      else if Stdlib.Bool.not(parsed.autoConfirm) then
        printItems(Stdlib.printErrorLine, "Will delete")

    if dryRun then
      if parsed.json then
        reportJson()
      else
        Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint("(dry-run, no op emitted)"))
        state
    else if
      Prompt.confirmExplicit(
        Confirm.assumeIf(parsed.autoConfirm),
        Stdlib.Cli.UI.Colors.warning("Proceed? (y/n): "))
    then
      let ops =
        committed
        |> Stdlib.List.map(fun((location, reference)) ->
          LanguageTools.ProgramTypes.PackageOp.Deprecate(
            location,
            reference,
            LanguageTools.ProgramTypes.DeprecationKind.Deprecated,
            parsed.reason,
            Option.None))

      let written =
        fresh
        |> Stdlib.List.fold(Result.Ok(0), fun(acc, item) ->
          let (l, _) = item
          Stdlib.Result.andThen(acc, fun _ ->
            SCM.PackageOps.discardDraftName(l.owner, l.modules, l.name)))
        |> Stdlib.Result.andThen(fun _ ->
          if ops == [] then Result.Ok(0) else SCM.PackageOps.add(branchId, ops))

      match written with
      | Ok(_) when parsed.json -> reportJson()
      | Ok(_) ->
        match parsed.autoConfirm, names, committed with
        | true, [name], [(_, reference)] ->
          let kind = LanguageTools.ProgramTypes.Reference.kind(reference)
          printOk(Deprecate.deletedItemMessage(name, kind))
        | true, _, _ -> printItems(Stdlib.printLine, "Deleted")
        | false, _, _ -> printOk($"Deleted {count} in {shown}")

        state
      | Error(e) ->
        printErr($"Delete failed: {e}")
        failed(state)
    else
      if Stdlib.Cli.UI.Prompt.canAsk() then
        Stderr.line("Delete cancelled.")
      else
        printErr(Prompt.refuseWithoutTerminal("Delete", $"dark delete {shown}"))

      failed(state)


let help(_state: AppState): String =
  [ "Deprecate items. They remain usable by name."
    "An item that was never committed is discarded instead, like `discard <name>`."
    ""
    "Usage: delete <fn|type|value|trait|impl|test> <name-or-hash> [options]"
    "       delete <module> [options]    - everything in it and the modules under it"
    ""
    "Refuses without --ignore-dependents when the target has live dependents."
    ""
    "Options:"
    "  --reason <text>, -m            Reason for deprecating the item"
    "  --ignore-dependents           Proceed even if live dependents exist"
    "  --yes, -y                     Skip confirmation prompt"
    "  --force                       Ignore dependents and skip confirmation"
    "  --dry-run                     Print what would happen; emit no ops"
    "  --json                        Print the result as JSON, the same shape as `deprecate --json`;"
    "                                without --yes or --force it is a dry run"
    ""
    "Examples:"
    "  delete fn Darklang.Legacy.oldThing --reason 'no longer maintained' --yes"
    "  delete fn Darklang.Debug.trace --force"
    ""
    "Use `deprecate --replacement <name>` to point to a replacement."
    "Use `deprecate --block-execution` to block calls to a function." ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  Deprecate.completeItemTypes(args)
