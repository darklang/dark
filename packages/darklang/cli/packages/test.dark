/// `dark test run`: run package tests, or author one with `test add`. Dark handles
/// discovery, caching, judging, and printing. F# executes test bodies and
/// checks cache safety using the shared call-graph analyzer.
module Darklang.Cli.Packages.Test

/// How one run of a test went, as the runner sees it: what the test returned
/// (`Stdlib.Test.Result`), or `RuntimeFailed` when it could not be judged at
/// all. Passing ordinary tests can be reused; test failures are stored
/// for display, while runtime failures are never stored.
type Outcome =
  | Passed
  | Failed(messages: List<String>)
  | RuntimeFailed(message: String)
  /// A `Stdlib.Test.table`: each row is its own test, in a group named after the test.
  | Rows(rows: List<(String * Outcome)>)


/// The tests <param outcome> reports, each as its name and how it went: one per
/// table row, as `name › (args)`, or the test itself.
let reported(name: String, outcome: Outcome): List<(String * Outcome)> =
  match outcome with
  | Rows(rows) -> Stdlib.List.map(rows, fun((args, row)) -> ($"{name} › {args}", row))
  | _ -> [ (name, outcome) ]


/// <param outcome> as one result for the whole declaration, for views that show one
/// line per test: a table passes when every row did, else lists its failing rows.
let summary(outcome: Outcome): Outcome =
  match outcome with
  | Rows(rows) ->
    let failing =
      rows
      |> Stdlib.List.filter(fun((_, row)) -> Stdlib.Bool.not(isPassed(row)))
      |> Stdlib.List.map(fun((args, row)) ->
        match row with
        | Failed(messages) -> args + ": " + Stdlib.String.join(messages, " ")
        | RuntimeFailed(message) -> args + ": " + message
        | _ -> args)

    if Stdlib.List.isEmpty(failing) then Outcome.Passed else Outcome.Failed(failing)
  | _ -> outcome


/// How long one test took to run, and where.
type Timing =
  { name: String
    ms: Int64
    inProcess: Bool }


type Counts =
  { passed: Int64
    failed: Int64
    cached: Int64
    ran: Int64
    /// Of those that ran, how many needed their own process and store copy.
    isolated: Int64
    timings: List<Timing>
    /// Each test reported so far, latest first, for `--json`.
    results: List<TestJson> }


/// One test as `test run --json` reports it. <param status> is `passed`, `failed`, or
/// `error` when the test could not be judged; <param messages> say why.
type TestJson =
  { name: String
    status: String
    messages: List<String>
    cached: Bool }


/// What `test run --json` prints: every test, in the order they finished, and the totals.
type RunJson =
  { tests: List<TestJson>
    passed: Int64
    failed: Int64
    ran: Int64
    cached: Int64
    seed: Int64 }


let testJson(name: String, outcome: Outcome, cached: Bool): TestJson =
  let (status, messages) =
    match outcome with
    | Passed -> ("passed", [])
    | Failed(messages) -> ("failed", messages)
    | RuntimeFailed(message) -> ("error", [ message ])
    | Rows(_) -> if isPassed(outcome) then ("passed", []) else ("failed", [])

  TestJson { name = name, status = status, messages = messages, cached = cached }


val usage =
  "Usage: test run [--force] [--brief | --verbose] [--json] [--jobs <count>] [--seed <n>] [name-or-module ... | <script>.dark]\n       test count [--for <item>] [module]\n       test add <location> <body> | <source-file> | - [--description <text>]"


let fullPath(
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)
  : String =
  [ [ item.location.owner ], item.location.modules, [ item.location.name ] ]
  |> Stdlib.List.flatten
  |> Stdlib.String.join(".")


/// The test's name with its group, for a filter to match: `Module.group.name`.
let groupedPath(
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)
  : String =
  match LanguageTools.PackageManager.Test.testGroup(item.entity.body) with
  | Some(group) ->
    [ [ item.location.owner ], item.location.modules, [ group, item.location.name ] ]
    |> Stdlib.List.flatten
    |> Stdlib.String.join(".")
  | None -> fullPath(item)


/// How `test run` names the test: `Module.name`, or `Module › group › name` when
/// it is in a group.
let shownName(
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)
  : String =
  match LanguageTools.PackageManager.Test.testGroup(item.entity.body) with
  | Some(group) ->
    let moduleName =
      Stdlib.String.join(Stdlib.List.prepend(item.location.modules, item.location.owner), ".")

    $"{moduleName} › {group} › {item.location.name}"
  | None -> fullPath(item)


/// Whether <param want> appears in <param have> as a contiguous run.
let segmentsIn(have: List<String>, want: List<String>): Bool =
  if Stdlib.List.take(have, Stdlib.List.length(want)) == want then
    true
  else
    match have with
    | [] -> false
    | [_, ...rest] -> segmentsIn(rest, want)


/// Whether <param filter> selects the test named <param path>: the filter's
/// segments, split at `.` or `›`, appear whole and in order in the test's full name,
/// its group included. `Stdlib.Float64` selects `Darklang.Stdlib.Float64.Tests.add`,
/// `doubles` selects a test named `doubles`, `Tests.parsing` the tests in the group
/// `parsing`, and `Float64.T` selects nothing.
let selects(filter: String, path: String): Bool =
  segmentsIn(filterSegments(path), filterSegments(testPart(filter)))


/// <param filter> split at `.` or `›`, as `test run` prints a test in a group.
let filterSegments(filter: String): List<String> =
  filter
  |> Stdlib.String.replaceAll("›", ".")
  |> Stdlib.String.split(".")
  |> Stdlib.List.map(Stdlib.String.trim)
  |> Stdlib.List.filter(fun seg -> seg != "")


/// <param filter> up to a table row's arguments: `lengths › ` of `lengths › ("a", 1)`.
let testPart(filter: String): String =
  match Stdlib.String.indexOf(filter, "(") with
  | Some(at) -> Stdlib.String.first(filter, at)
  | None -> filter


/// Whether <param filters> keep the test <param name> reports for the test at
/// <param path>: any filter that selects the test, unless it names a table row,
/// as in `lengths › ("a", 1)` or `lengths("a", 1)`, and <param name> is another one.
let rowSelected(filters: List<String>, path: String, name: String): Bool =
  Stdlib.List.isEmpty(filters)
  || Stdlib.List.any(filters, fun f ->
    let test = testPart(f)
    selects(test, path)
    && (test == f || name == $"{path} › {Stdlib.String.dropFirst(f, Stdlib.String.length(test))}"))


/// The actual judging function, including its followed dependencies, and the
/// runtime compilation. Reflect the function we call, not a possibly pinned
/// branch binding. An unexpected callable, or a runtime that cannot be hashed,
/// gets a fresh key so it cannot reuse a persisted result.
let cacheRuntime(): String =
  let judge =
    match LanguageTools.RuntimeTypes.reflect(LanguageTools.PackageManager.Test.execute) with
    | DApplicable(AppNamedFn(named)) ->
      match named.name with
      | Package(hash) -> LanguageTools.RuntimeTypes.hashToString(hash)
      | _ -> Stdlib.display(Stdlib.Uuid.generate())
    | _ -> Stdlib.display(Stdlib.Uuid.generate())

  let runtime =
    match Installation.Helpers.runtimeHash() with
    | Ok(hash) -> hash
    | Error(_) -> Stdlib.display(Stdlib.Uuid.generate())

  runtime + ":" + judge


/// Read cache metadata once; test workers cannot change the parent store.
///
/// Only successful ordinary tests are reusable. Branch identity and the
/// branch's current `Stdlib.Test.Result` binding are part of the key: neither
/// is covered by the test's content hash. The runtime key covers the build
/// and the judging code.
type CacheContext =
  { runtime: String
    branch: String
    resultType: String }


let cacheContext(branchId: Uuid): Option<CacheContext> =
  LanguageTools.PackageManager.Test.resultTypeHash(branchId)
  |> Stdlib.Option.map(fun resultType ->
    CacheContext
      { runtime = cacheRuntime()
        branch = Stdlib.display(branchId)
        resultType = LanguageTools.ProgramTypes.hashToString(resultType) })


let resultKey(
  cache: CacheContext,
  testHash: LanguageTools.ProgramTypes.Hash)
  : LanguageTools.PackageManager.Test.ResultKey =
  LanguageTools.PackageManager.Test.ResultKey
    { test = LanguageTools.ProgramTypes.hashToString(testHash)
      runtime = cache.runtime
      branch = cache.branch
      resultType = cache.resultType }


let storedOutcome(cache: CacheContext, testHash: LanguageTools.ProgramTypes.Hash): Option<Outcome> =
  match LanguageTools.PackageManager.Test.storedResult(resultKey(cache, testHash)) with
  | Some(json) -> Stdlib.Json.parse<Outcome>(json) |> Stdlib.Result.toOption
  | None -> Option.None


let storeOutcome(
  cache: CacheContext,
  testHash: LanguageTools.ProgramTypes.Hash,
  outcome: Outcome)
  : Unit =
  match Stdlib.Json.checkedSerialize<Outcome>(outcome) with
  | Ok(json) -> LanguageTools.PackageManager.Test.storeResult(resultKey(cache, testHash), json)
  // Not cached: the next run runs the test again.
  | Error(_) -> ()


/// The last result for this test on this branch, read without writing anything.
/// A failed result is shown in views but is never reused by `dark test run`.
let lastOutcome(branchId: Uuid, testHash: LanguageTools.ProgramTypes.Hash): Option<Outcome> =
  match cacheContext(branchId) with
  | Some(cache) -> storedOutcome(cache, testHash) |> Stdlib.Option.map(summary)
  | None -> Option.None


/// <fn lastOutcome> for each of <param testHashes>, in order, for a listing: the cache key is
/// worked out once (it looks up a type and hashes the runtime) and the results read in one go.
let lastOutcomes(
  branchId: Uuid,
  testHashes: List<LanguageTools.ProgramTypes.Hash>)
  : List<Option<Outcome>> =
  match testHashes with
  | [] -> []
  | _ ->
    match cacheContext(branchId) with
    | Some(cache) ->
      LanguageTools.PackageManager.Test.storedResults(
        testHashes |> Stdlib.List.map(fun h -> resultKey(cache, h)))
      |> Stdlib.List.map(fun stored ->
        stored
        |> Stdlib.Option.andThen(fun json ->
          Stdlib.Json.parse<Outcome>(json) |> Stdlib.Result.toOption)
        |> Stdlib.Option.map(summary))
    | None -> testHashes |> Stdlib.List.map(fun _ -> Option.None)


/// Run <param test> now, ignoring the cache, and say how it went.
let runFresh(
  run: LanguageTools.PackageManager.Test.Run,
  branchId: Uuid,
  item: LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)
  : Outcome =
  let test = item.entity
  let ctx(_u: Unit): PrettyPrinter.ProgramTypes.Context =
    PrettyPrinter.ProgramTypes.Context.forModule(
      branchId,
      Stdlib.List.prepend(item.location.modules, item.location.owner))

  match LanguageTools.PackageManager.Test.executeInRun(run, branchId, test.hash) with
  | Ok(Pass) -> Outcome.Passed
  | Ok(Rows(rows)) ->
    rows
    |> Stdlib.List.map(fun((args, result)) ->
      if Stdlib.Test.passed(result) then
        (args, Outcome.Passed)
      else
        (
          args,
          Outcome.Failed(
            LanguageTools.PackageManager.Test.rowFailureLines(ctx(), test.body, result))))
    |> Outcome.Rows
  | Ok(result) ->
    Outcome.Failed(LanguageTools.PackageManager.Test.failureLines(ctx(), test.body, result))
  | Error(error) ->
    Outcome.RuntimeFailed(PrettyPrinter.RuntimeTypes.RuntimeError.toString(branchId, error))


/// Expected-error tests always rerun.
let mayCache(test: LanguageTools.ProgramTypes.PackageTest.PackageTest): Bool =
  match test.expectedError with
  | Some(_) -> false
  | None -> true


/// <param cacheSafe>: the current cache-safety rule's answer for this test, checked
/// before reusing or storing a result.
let isCacheable(test: LanguageTools.ProgramTypes.PackageTest.PackageTest, cacheSafe: Bool): Bool =
  mayCache(test) && cacheSafe


let printOutcome(name: String, outcome: Outcome): Unit =
  match outcome with
  | Passed -> Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"PASS {name}"))
  | Failed(messages) ->
    Stdlib.printLine(Stdlib.Cli.UI.Colors.error($"FAIL {name}"))
    messages
    |> Stdlib.List.iter(fun message ->
      Stdlib.printLine(Stdlib.Cli.UI.Colors.dimText($"  {message}")))
  | RuntimeFailed(message) ->
    Stdlib.printLine(Stdlib.Cli.UI.Colors.error($"ERROR {name}"))
    Stdlib.printLine(Stdlib.Cli.UI.Colors.dimText($"  {message}"))
  | Rows(_) -> reported(name, outcome) |> Stdlib.List.iter(fun((n, o)) -> printOutcome(n, o))


let isPassed(outcome: Outcome): Bool =
  match outcome with
  | Passed -> true
  | Failed(_) | RuntimeFailed(_) -> false
  | Rows(rows) -> Stdlib.List.all(rows, fun((_, row)) -> isPassed(row))


val addUsage = "Usage: test add <location> <body> | <source-file> | - [--description <text>]"


/// Print why `test add` saved nothing, with its usage, and fail the command.
let addFailed(state: AppState, message: String): AppState =
  printErr(message)
  Stdlib.printErrorLine(addUsage)
  { state with exitCode = 1 }


/// `test add`: author one test at <param locationStr>. <param definition> is
/// the body alone (`Foo.double 4 |> Stdlib.Test.equal 8`) or a whole
/// declaration, `test name = ...` with an optional doc comment, which is what
/// a file or stdin usually holds.
let addTest(
  state: AppState,
  locationStr: String,
  definition: String,
  description: Option<String>)
  : AppState =
  match Location.parseFrom(
          state.currentBranchId,
          state.packageData.currentLocation,
          locationStr) with
  | Error(msg) -> addFailed(state, $"Invalid location: {msg}")
  | Ok(location) ->
    let trimmed = Stdlib.String.trim(definition)
    let isFullDeclaration = Stdlib.String.startsWith(codeAfterComments(definition), "test ")
    let fullSource =
      if isFullDeclaration then definition else $"test {location.name} = {definition}"

    let (tree, diagnostics) =
      LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, fullSource)

    match tree with
    | None -> addFailed(state, "Failed to parse the test")
    | Some(SourceFile(sourceFile)) ->
      // The parser may recover a tree after errors; do not save it.
      if Errors.reportParseErrors(diagnostics) then
        { state with exitCode = 1 }
      else
        match sourceFile.declarations with
        | [Test(written)] ->
          let written =
            { written with
                description = Stdlib.Option.withDefault(description, written.description) }

          if written.name.name != location.name then
            addFailed(
              state,
              $"Test name `{written.name.name}` does not match target `{location.name}`")
          else
            saveAuthored(
              state,
              location,
              LanguageTools.ProgramTypes.ItemKind.Test,
              "test",
              0,
              fun ctx ->
                let (packageTest, unresolvedNames) =
                  LanguageTools.WrittenTypesToProgramTypes.TestDeclaration.toTestPT(ctx, written)

                // Tests use the test instance policy, with no extra restriction of
                // their own.
                let ops =
                  [ LanguageTools.ProgramTypes.PackageOp.AddTest(packageTest)
                    LanguageTools.ProgramTypes.PackageOp.SetName(
                      location,
                      LanguageTools.ProgramTypes.Reference.PackageTest(packageTest.hash),
                      Option.None) ]

                Option.Some((ops, packageTest.hash, unresolvedNames)))
        | _ -> addFailed(state, "Expected exactly one test declaration")


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | ["add"] -> addFailed(state, "test add needs a location and a body")
  | ["add", location, ...definitionParts] ->
    match definitionAndDescription(definitionParts) with
    | Error(message) -> addFailed(state, message)
    | Ok((definition, description)) ->
      if Stdlib.String.isEmpty(Stdlib.String.trim(definition)) then
        addFailed(state, "test add needs a body after the location")
      else
        addTest(state, location, definition, description)
  | ["run", ...runArgs] -> runTests(state, runArgs)
  | ["count", ...countArgs] -> countTests(state, countArgs)
  | [] ->
    Stdlib.printLine(help(state))
    state
  | _ ->
    Stdlib.printLine(usage)
    { state with exitCode = 1 }


/// `dark test run [--force] [--jobs <count>] [--seed <n>] [filters]`: run the matching tests,
/// from the cache where it allows, print each one, and fail the command if any failed or
/// nothing matched.
let runTests(state: AppState, args: List<String>): AppState =
  // One test per core, at most 16: every slot owns a process and a store copy.
  // A test process holds about 90 MB (one outlier reaches ~750 MB), so 16 stay
  // near 2 GB. `exec.workers` lowers the core count; --jobs overrides both.
  let cores = LanguageTools.Exec.workers()
  let defaults =
    RunOptions
      { force = false
        json = false
        brief = Stdlib.Bool.not(Stdlib.Cli.Sys.isTerminal(1))
        jobs = if cores < 16 then cores else 16
        seed = Option.None
        filters = [] }

  match parseRunOptions(defaults, args) with
  | Error(message) ->
    printErr(message)
    Stdlib.printErrorLine(usage)
    { state with exitCode = 1 }
  | Ok(options) when Stdlib.List.any(options.filters, isScript) ->
    match options.filters with
    | [path] -> runScriptTests(state, options, path)
    | _ ->
      printErr("test run takes one script, or test names and modules, not both")
      Stdlib.printErrorLine(usage)
      { state with exitCode = 1 }
  | Ok(options) ->
    let seed = Stdlib.Option.withDefault(options.seed, freshSeed())
    LanguageTools.PackageManager.Test.withStoreSnapshot(state.currentBranchId, seed, fun run ->
      runTestsInRun(run, state, options, selectedTests(state.currentBranchId, options.filters)))


/// Whether <param arg> names a script rather than a test: test names never end in `.dark`.
let isScript(arg: String): Bool =
  Stdlib.String.endsWith(arg, ".dark")


/// The module a script's tests are saved under while they run.
val scriptModule = "Script"


/// `dark test run todo.dark`: run the tests in a script with only its declarations in scope. No
/// top-level statement runs. The declarations go into the current branch's draft under `Script`
/// for the run, which runs them like stored tests (in this process when pure, else in a worker on
/// the virtual clock) and never from the cache, and those ops are dropped after.
let runScriptTests(state: AppState, options: RunOptions, path: String): AppState =
  match Stdlib.Cli.File.readText(path) with
  | Error(_) ->
    printErr($"Can't read {path}")
    { state with exitCode = 1 }
  | Ok(source) ->
    match LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Script, source) with
    | Some(SourceFile(sourceFile)), [] ->
      match LanguageTools.ScriptTests.belowLet(sourceFile) with
      | [] -> runScriptTestsIn(state, options, sourceFile)
      | belowLet ->
        Stdlib.List.iter(belowLet, fun b -> Stdlib.printErrorLine(belowLetText(b)))
        { state with exitCode = 1 }
    | _, diagnostics ->
      let _ = Errors.reportParseErrors(diagnostics)
      { state with exitCode = 1 }


/// A script test that uses a top-level `let` or calls a function below the first one, as a
/// diagnostic with a hint.
let belowLetText(b: LanguageTools.ScriptTests.BelowLet): String =
  let at = $"{Stdlib.display(b.range.start.row + 1)}:{Stdlib.display(b.range.start.column + 1)}"
  let letLine = Stdlib.display(b.letLine)
  if b.usesLet then
    let calls =
      b.calls
      |> Stdlib.List.map(fun c -> $"calls `{c}`, which ")
      |> Stdlib.String.join("")

    let passTo =
      match Stdlib.List.last(b.calls) with
      | Some(fn) -> $", or pass it to `{fn}` as an argument"
      | None -> ""

    $"error[SCRIPT-TEST-USES-LET] at {at}: `{b.test}` {calls}uses the top-level `let {b.letName}` on line {letLine}.\n  hint: make it a `val` if it's a constant{passTo}"
  else
    let fn = Stdlib.String.join(b.calls, "")
    $"error[SCRIPT-TEST-BELOW-LET] at {at}: `{b.test}` calls `{fn}`, which is defined below the top-level `let {b.letName}` on line {letLine}.\n  hint: move `{fn}` above line {letLine}"


let runScriptTestsIn(
  state: AppState,
  options: RunOptions,
  sourceFile: LanguageTools.WrittenTypes.SourceFile.SourceFile)
  : AppState =
  let branchId = state.currentBranchId
  let rootModule =
    LanguageTools.WrittenTypes.ModuleDeclaration.ModuleDeclaration
      { range = sourceFile.range
        name = (sourceFile.range, scriptModule)
        declarations =
          sourceFile.declarations |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)
        keywordModule = sourceFile.range }

  let ctx =
    LanguageTools.NameResolver.NRContext
      { onMissing = LanguageTools.NameResolver.OnMissing.Allow
        pm = LanguageTools.PackageManager.pm()
        branchId = branchId
        owner = scriptModule
        currentModule = [] }

  let (ops, unresolvedNames) = LanguageTools.Parser.Parse.moduleToPackageOps(ctx, rootModule)
  let locations =
    ops
    |> Stdlib.List.filterMap(fun op ->
      match op with
      | SetName(location, _, _) -> Option.Some(location)
      | _ -> Option.None)

  let taken =
    locations
    |> Stdlib.List.filter(fun location ->
      Stdlib.Option.isSome(Rename.referenceAt(branchId, location)))

  if Stdlib.Bool.not(Stdlib.List.isEmpty(taken)) then
    printErr($"`{scriptModule}` already holds names on this branch; a script's tests run under it")
    { state with exitCode = 1 }
  else if Errors.reportUnresolvedNames(branchId, [ scriptModule ], unresolvedNames) then
    { state with exitCode = 1 }
  else
    let draftBefore = SCM.PackageOps.draftEntriesFor(branchId) |> Stdlib.List.map(fun e -> e.id)
    let result =
      match SCM.PackageOps.addAuthored(branchId, ops) with
      | Error(message) ->
        printErr($"Couldn't save the script's declarations to run its tests: {message}")
        { state with exitCode = 1 }
      | Ok(_) ->
        let options = { options with force = true, filters = [ scriptModule ] }
        LanguageTools.PackageManager.Test.withStoreSnapshot(
          branchId,
          Stdlib.Option.withDefault(options.seed, freshSeed()),
          fun run ->
            // Look up only tests declared in this file. The general "Script" filter
            // would load every visible test before narrowing the list.
            let selected =
              liveTests(branchId, [ scriptModule ], "")
              |> Stdlib.List.filter(fun item -> Stdlib.List.contains(locations, item.location))
              |> Stdlib.List.sortBy(groupedPath)

            runTestsInRun(run, state, options, selected))

    let added =
      SCM.PackageOps.draftEntriesFor(branchId)
      |> Stdlib.List.map(fun e -> e.id)
      |> Stdlib.List.filter(fun id -> Stdlib.Bool.not(Stdlib.List.contains(draftBefore, id)))

    let _ = SCM.PackageOps.dropBranchOps(branchId, added)
    result


/// A seed for a run that was not given one.
let freshSeed(): Int64 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromInt64(1), Stdlib.BigInt.fromInt64(9999999))
  |> Stdlib.BigInt.toInt64
  |> Stdlib.Option.withDefault(1)


type RunOptions =
  { force: Bool
    /// Print one JSON answer instead of a line per test.
    json: Bool
    /// Show failures and the final counts without progress or passing rows. On by default when
    /// stdout is not a terminal.
    brief: Bool
    jobs: Int64
    seed: Option<Int64>
    filters: List<String> }


let parseRunOptions(options: RunOptions, args: List<String>): Result<RunOptions, String> =
  match args with
  | [] -> Result.Ok(options)
  | ["--force", ...rest] -> parseRunOptions({ options with force = true }, rest)
  | ["--json", ...rest] -> parseRunOptions({ options with json = true }, rest)
  | ["--brief", ...rest] -> parseRunOptions({ options with brief = true }, rest)
  | ["--verbose", ...rest] -> parseRunOptions({ options with brief = false }, rest)
  | ["--jobs", value, ...rest] ->
    match Stdlib.Int64.parse(value) with
    | Ok(jobs) when jobs > 0 -> parseRunOptions({ options with jobs = jobs }, rest)
    | _ -> Result.Error("--jobs needs a positive whole number")
  | ["--jobs"] -> Result.Error("--jobs needs a positive whole number")
  | [arg, ...rest] when Stdlib.String.startsWith(arg, "--jobs=") ->
    let value = Stdlib.String.dropFirst(arg, 7)
    parseRunOptions(options, Stdlib.List.concat([ "--jobs", value ], rest))
  | ["--seed", value, ...rest] ->
    match Stdlib.Int64.parse(value) with
    | Ok(seed) -> parseRunOptions({ options with seed = Option.Some(seed) }, rest)
    | Error(_) -> Result.Error("--seed needs a whole number")
  | ["--seed"] -> Result.Error("--seed needs a whole number")
  | [arg, ...rest] when Stdlib.String.startsWith(arg, "--seed=") ->
    let value = Stdlib.String.dropFirst(arg, 7)
    parseRunOptions(options, Stdlib.List.concat([ "--seed", value ], rest))
  | [arg, ...rest] ->
    if Stdlib.String.startsWith(arg, "-") then
      Result.Error($"Unknown option: {arg}")
    else
      parseRunOptions({ options with filters = Stdlib.List.prepend(options.filters, arg) }, rest)


/// Only the coordinator checks cache safety, writes the cache and prints results.
/// Spawned processes run tests and return their outcomes.
type FinishedTest =
  { name: String
    test: LanguageTools.ProgramTypes.PackageTest.PackageTest
    cacheSafe: Bool
    outcome: Outcome
    wasCached: Bool
    inProcess: Bool
    ms: Int64 }


/// <param filters> pick rows too: one with an argument list, as in
/// `lengths › ("a", 1)`, keeps only the row of that name.
let finishTest(
  cache: Option<CacheContext>,
  options: RunOptions,
  counts: Counts,
  finished: FinishedTest)
  : Counts =
  if Stdlib.Bool.not(finished.wasCached) then
    match cache, finished.outcome with
    | _, RuntimeFailed(_) -> ()
    | Some(context), _ when isCacheable(finished.test, finished.cacheSafe) ->
      storeOutcome(context, finished.test.hash, finished.outcome)
    | _ -> ()

  let tests =
    reported(finished.name, finished.outcome)
    |> Stdlib.List.filter(fun((name, _)) -> rowSelected(options.filters, finished.name, name))

  if Stdlib.Bool.not(options.json) then
    tests
    |> Stdlib.List.iter(fun((name, outcome)) ->
      if options.brief && isPassed(outcome) then () else printOutcome(name, outcome))

  let results =
    if options.json then
      Stdlib.List.fold(tests, counts.results, fun(acc, (name, outcome)) ->
        Stdlib.List.prepend(acc, testJson(name, outcome, finished.wasCached)))
    else
      counts.results

  let n = Stdlib.List.length(tests)
  let passed =
    tests
    |> Stdlib.List.filter(fun((_, o)) -> isPassed(o))
    |> Stdlib.List.length

  Counts
    { passed = counts.passed + passed
      failed = counts.failed + n - passed
      cached = counts.cached + (if finished.wasCached then n else 0)
      ran = counts.ran + (if finished.wasCached then 0 else n)
      isolated = counts.isolated + (if finished.wasCached || finished.inProcess then 0 else n)
      timings =
        if finished.wasCached then
          counts.timings
        else
          Stdlib.List.prepend(
            counts.timings,
            Timing { name = finished.name, ms = finished.ms, inProcess = finished.inProcess })
      results = results }


/// Run up to `jobs` tests at once. Start the next whenever one finishes.
/// Wait for all tests before closing the shared snapshot. A test the analysis
/// proves pure runs inside this process; the rest get a worker and a store copy.
/// Each test comes with whether a cached pass of it may be reused.
let runSelected(
  run: LanguageTools.PackageManager.Test.Run,
  branchId: Uuid,
  options: RunOptions,
  cache: Option<CacheContext>,
  remaining:
    List<
      (LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest> *
       Bool)>,
  running: List<Stdlib.Exec.Handle<FinishedTest>>,
  counts: Counts)
  : Counts =
  match remaining with
  | [(item, cacheSafe), ...rest] when Stdlib.List.length(running) < options.jobs ->
    let cachedResult =
      if options.force then
        Option.None
      else
        match cache with
        | Some(context) when mayCache(item.entity) ->
          match storedOutcome(context, item.entity.hash) with
          | Some(outcome) when isPassed(outcome) && isCacheable(item.entity, cacheSafe) ->
            Option.Some(outcome)
          | _ -> Option.None
        | _ -> Option.None

    match cachedResult with
    | Some(outcome) ->
      let finished =
        FinishedTest
          { name = shownName(item)
            test = item.entity
            cacheSafe = cacheSafe
            outcome = outcome
            wasCached = true
            inProcess = false
            ms = 0 }

      runSelected(
        run,
        branchId,
        options,
        cache,
        rest,
        running,
        finishTest(cache, options, counts, finished))
    | None ->
      // Progress, not a result: stderr, so the answer on stdout is the PASS/FAIL lines and the verdict.
      if Stdlib.Bool.not(options.brief) then
        Stdlib.printErrorLine($"Running: {shownName(item)}")

      let handle = Stdlib.Exec.spawn(fun () ->
        let started = Stdlib.DateTime.__monotonicMilliseconds()
        let outcome = runFresh(run, branchId, item)
        // Asked after the run: a test stopped at an `Impure` call ran again in a worker.
        let inProcess = LanguageTools.PackageManager.Test.runsInProcess(item.entity.hash)
        FinishedTest
          { name = shownName(item)
            test = item.entity
            cacheSafe = cacheSafe
            outcome = outcome
            wasCached = false
            inProcess = inProcess
            ms = Stdlib.DateTime.__monotonicMilliseconds() - started })

      runSelected(run, branchId, options, cache, rest, Stdlib.List.prepend(running, handle), counts)
  | _ ->
    if Stdlib.List.isEmpty(running) then
      counts
    else
      let (done, finished) = Stdlib.Exec.select(running)
      let running = Stdlib.List.filter(running, fun handle -> handle.id != done.id)
      runSelected(
        run,
        branchId,
        options,
        cache,
        remaining,
        running,
        finishTest(cache, options, counts, finished))


/// The ten slowest tests that ran, slowest first, so a log says where the time
/// went. Only for runs of a dozen tests or more; a short run shows it already.
let printSlowest(timings: List<Timing>): Unit =
  if Stdlib.List.length(timings) >= 12 then
    Stdlib.printLine("")
    Stdlib.printLine("Slowest:")
    timings
    |> Stdlib.List.sortBy(fun t -> 0 - t.ms)
    |> Stdlib.List.take(10)
    |> Stdlib.List.iter(fun t ->
      let place = if t.inProcess then "in-process" else "isolated"
      Stdlib.printLine($"  {Stdlib.display(t.ms)} ms  {t.name} ({place})"))
  else
    ()


/// The tests on <param branchId> under <param currentModule> whose names or docs
/// hold <param text>, leaving out deprecated ones: `delete` deprecates rather than
/// unbinding, so a deleted test would otherwise keep running. Not
/// `Query.filterHidden`: that keeps items with live callers and, on a branch,
/// anything the branch deprecated.
let liveTests(
  branchId: Uuid,
  currentModule: List<String>,
  text: String)
  : List<
  LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>> =
  let rawResults =
    LanguageTools.PackageManager.Search.search(
      branchId,
      LanguageTools.ProgramTypes.Search.SearchQuery
        { currentModule = currentModule
          text = text
          searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
          entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Test ]
          exactMatch = false })

  let depSets = Query.loadDeprecationSets(branchId)
  rawResults.tests
  |> Stdlib.List.filter(fun item ->
    Stdlib.Bool.not(Query.isDeprecatedAtLocation(depSets, item.location, item.entity.hash)))


/// The tests <param filters> select, by name, or every test when there are none.
/// `selects` decides. The search's text match is looser (segments in any order,
/// docs too, so `WbTests.R` alone matches every test in every `Tests` module), so
/// searching for a filter of two or more segments finds every test it selects
/// without reading the rest. A single segment could be a module, which the search
/// would only look for in names.
let selectedTests(
  branchId: Uuid,
  filters: List<String>)
  : List<
  LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>> =
  let narrowable =
    Stdlib.Bool.not(Stdlib.List.isEmpty(filters))
    && Stdlib.List.all(filters, fun f -> Stdlib.List.length(filterSegments(testPart(f))) > 1)

  let found =
    if narrowable then
      filters
      |> Stdlib.List.map(fun f ->
        liveTests(branchId, [], Stdlib.String.join(filterSegments(testPart(f)), ".")))
      |> Stdlib.List.prepend(groupedTests(branchId))
      |> Stdlib.List.flatten
      |> Stdlib.List.uniqueBy(fullPath)
    else
      liveTests(branchId, [], "")

  found
  |> Stdlib.List.filter(fun item ->
    Stdlib.List.isEmpty(filters)
    || Stdlib.List.any(filters, fun f -> selects(f, groupedPath(item))))
  |> Stdlib.List.sortBy(groupedPath)


/// The tests in the modules of every test that calls `Stdlib.Test.group`: the search
/// knows names, not groups, so a filter that names a group finds its tests here.
let groupedTests(
  branchId: Uuid)
  : List<
  LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>> =
  let group =
    LanguageTools.ProgramTypes.PackageLocation
      { owner = "Darklang", modules = [ "Stdlib", "Test" ], name = "group" }

  SCM.Deps.dependentsFor(branchId, [ (group, LanguageTools.ProgramTypes.ItemKind.Fn) ])
  |> Stdlib.List.filterMap(fun((_, loc, kind)) ->
    if kind == LanguageTools.ProgramTypes.ItemKind.Test then
      Option.Some(Stdlib.List.prepend(loc.modules, loc.owner))
    else
      Option.None)
  |> Stdlib.List.unique
  |> Stdlib.List.map(fun modules -> liveTests(branchId, modules, ""))
  |> Stdlib.List.flatten


/// The full names, as segments, of the tests under the module path <param prefix>.
/// The search looks in the module above <param prefix>, whose last segment may name
/// a test rather than a module.
let testsUnder(branchId: Uuid, prefix: List<String>): List<List<String>> =
  testItemsUnder(branchId, prefix) |> Stdlib.List.map(fun((path, _)) -> path)


/// <fn testsUnder>, each with its test.
let testItemsUnder(
  branchId: Uuid,
  prefix: List<String>)
  : List<
  (List<String> *
   LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)> =
  let found =
    match prefix with
    | [] -> liveTests(branchId, [], "")
    | [owner] -> liveTests(branchId, [ owner ], "")
    | _ -> liveTests(branchId, Stdlib.List.dropLast(prefix), Stdlib.String.join(prefix, "."))

  let depth = Stdlib.List.length(prefix)
  found
  |> Stdlib.List.filterMap(fun item ->
    let path = Stdlib.String.split(groupedPath(item), ".")
    if Stdlib.List.take(path, depth) == prefix then
      Option.Some((path, item))
    else
      Option.None)


let runTestsInRun(
  run: LanguageTools.PackageManager.Test.Run,
  state: AppState,
  options: RunOptions,
  selected:
    List<
      LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>>)
  : AppState =
  // One analysis for the whole run: the tests share most of what they call.
  let cacheSafe =
    LanguageTools.PackageManager.Test.areCacheSafe(
      Stdlib.List.map(selected, fun item -> item.entity.hash))

  let initial =
    Counts { passed = 0, failed = 0, cached = 0, ran = 0, isolated = 0, timings = [], results = [] }

  let counts =
    runSelected(
      run,
      state.currentBranchId,
      options,
      cacheContext(state.currentBranchId),
      Stdlib.List.zipShortest(selected, cacheSafe),
      [],
      initial)

  let total = counts.passed + counts.failed
  let printed =
    if options.json then
      RunJson
        { tests = Stdlib.List.reverse(counts.results)
          passed = counts.passed
          failed = counts.failed
          ran = counts.ran
          cached = counts.cached
          seed = run.seed }
      |> Stdlib.Json.checkedSerialize<RunJson>
      |> printJson
    else if total == 0 then
      printErr("No package tests matched.")
      true
    else
      if Stdlib.Bool.not(options.brief) then
        printSlowest(counts.timings)
        Stdlib.printLine("")

      Stdlib.printLine(
        $"{countLine(total)}: {Stdlib.display(counts.passed)} passed, {Stdlib.display(counts.failed)} failed; {Stdlib.display(counts.ran)} ran, {Stdlib.display(counts.cached)} cached; {Stdlib.display(counts.isolated)} isolated")

      if counts.failed > 0 then
        let seed = Stdlib.display(run.seed)
        Stdlib.printLine($"Seed {seed}: rerun with --seed {seed} for the same random values")
      else
        ()

      true

  if Stdlib.Bool.not(printed) || counts.failed > 0 || total == 0 then
    { state with exitCode = 1 }
  else
    state


/// One row of `test count`: a submodule with everything beneath it, or one test.
type CountRow =
  { name: String
    tests: Int64 }


/// <param tests> (full name segments, and how many tests each holds) rolled up one
/// level below <param prefix>: a row per submodule, plus a row per test directly in
/// <param prefix> when it has no submodules, or one row for them all when it has.
let countRows(prefix: List<String>, tests: List<(List<String> * Int64)>): List<CountRow> =
  let depth = Stdlib.List.length(prefix)
  let (direct, nested) =
    Stdlib.List.partition(tests, fun((path, _)) -> Stdlib.List.length(path) == depth + 1)

  let row(name: String, group: List<(List<String> * Int64)>): CountRow =
    CountRow { name = name, tests = total(group) }

  let modules =
    nested
    |> Stdlib.List.groupBy(fun((path, _)) ->
      Stdlib.Option.withDefault(Stdlib.List.getAt(path, depth), ""))
    |> Stdlib.List.map(fun((name, group)) -> row(name, group))
    |> Stdlib.List.sortBy(fun r -> r.name)

  let here =
    if Stdlib.List.isEmpty(direct) then
      []
    else if Stdlib.List.isEmpty(modules) then
      direct
      |> Stdlib.List.map(fun((path, n)) ->
        row(Stdlib.Option.withDefault(Stdlib.List.last(path), ""), [ (path, n) ]))
      |> Stdlib.List.sortBy(fun r -> r.name)
    else
      [ row("(tests in this module)", direct) ]

  Stdlib.List.concat(modules, here)


let total(tests: List<(List<String> * Int64)>): Int64 =
  Stdlib.List.fold(tests, 0, fun(sum, (_, n)) -> sum + n)


let countLine(tests: Int64): String =
  let t = if tests == 1 then "test" else "tests"
  $"{Stdlib.display(tests)} {t}"


/// <param prefix>, extended while every test in <param tests> sits under the
/// same submodule, so a module holding only `Tests` shows what is inside it.
let deepestShared(prefix: List<String>, tests: List<(List<String> * Int64)>): List<String> =
  let depth = Stdlib.List.length(prefix)
  let next =
    tests
    |> Stdlib.List.map(fun((path, _)) ->
      if Stdlib.List.length(path) > depth + 1 then
        Stdlib.List.getAt(path, depth)
      else
        Option.None)
    |> Stdlib.List.unique

  match next with
  | [Some(segment)] -> deepestShared(Stdlib.List.append(prefix, segment), tests)
  | _ -> prefix


/// Print the total for <param heading>, then a row per entry of `countRows`
/// below the deepest module all of <param tests> share. A row for one of
/// <param groups>, a `Stdlib.Test.group` or a table, is marked `› name`.
let printCounts(
  heading: String,
  prefix: List<String>,
  tests: List<(List<String> * Int64)>,
  groups: List<List<String>>)
  : Unit =
  let shared = deepestShared(prefix, tests)
  let rows =
    countRows(shared, tests)
    |> Stdlib.List.map(fun r ->
      if Stdlib.List.contains(groups, Stdlib.List.append(shared, r.name)) then
        { r with name = $"› {r.name}" }
      else
        r)

  let below = if shared == prefix then "" else $" (all in {Stdlib.String.join(shared, ".")})"
  Stdlib.printLine($"{heading}: {countLine(total(tests))}{below}")
  let width = Stdlib.List.fold(rows, 0, fun(w, r) ->
    let n = Stdlib.String.length(r.name)
    if n > w then n else w)

  rows
  |> Stdlib.List.iter(fun r ->
    Stdlib.printLine($"  {Stdlib.String.padEnd(r.name, ' ', width)}  {countLine(r.tests)}"))


/// The full names of the groups among <param items>: each `Stdlib.Test.group`, and
/// each table, whose rows `test run` shows as a group.
let countGroups(
  items:
    List<
      (List<String> *
       LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>)>)
  : List<List<String>> =
  items
  |> Stdlib.List.map(fun((path, item)) ->
    let body = item.entity.body
    let group =
      match LanguageTools.PackageManager.Test.testGroup(body) with
      | Some(_) -> [ Stdlib.List.dropLast(path) ]
      | None -> []

    let table = if LanguageTools.PackageManager.Test.isTable(body) then [ path ] else []
    Stdlib.List.concat(group, table))
  |> Stdlib.List.flatten
  |> Stdlib.List.unique


/// `test count [--for <item>] [module]`: how many tests are in
/// <param module> (by full dotted name; everything when omitted), rolled up one
/// level down. With `--for`, only the tests that use <item>, directly or
/// through anything else they call. Reads definitions only; nothing runs.
let countTests(state: AppState, args: List<String>): AppState =
  let branchId = state.currentBranchId
  let (forItem, rest) =
    match args with
    | ["--for", item, ...rest] -> (Option.Some(item), rest)
    | [moduleArg, "--for", item] -> (Option.Some(item), [ moduleArg ])
    | _ -> (Option.None, args)

  let badArgs(message: String): AppState =
    printErr(message)
    Stdlib.printErrorLine(usage)
    { state with exitCode = 1 }

  match rest with
  | [_, _, ...] -> badArgs("test count takes at most one module")
  | [arg, ...] when Stdlib.String.startsWith(arg, "-") -> badArgs($"Unknown option: {arg}")
  | _ ->
    let prefix =
      match rest with
      | [moduleArg] ->
        Stdlib.String.split(moduleArg, ".") |> Stdlib.List.filter(fun seg -> seg != "")
      | _ -> []

    let depth = Stdlib.List.length(prefix)
    let items = testItemsUnder(branchId, prefix)
    let under =
      items
      |> Stdlib.List.map(fun((path, item)) ->
        (path, LanguageTools.PackageManager.Test.testCount(item.entity.body)))

    let groups = countGroups(items)
    let place = if depth == 0 then "All tests" else Stdlib.String.join(prefix, ".")
    match forItem with
    | None ->
      if Stdlib.List.isEmpty(under) then
        printErr($"No package tests under {place}.")
        { state with exitCode = 1 }
      else
        printCounts(place, prefix, under, groups)
        state
    | Some(item) ->
      match Deps.resolvePath(branchId, state.packageData.currentLocation, item) with
      | Error(message) ->
        printErr(message)
        { state with exitCode = 1 }
      | Ok((_, loc, name, kind)) ->
        match Deps.getTransitiveDependentsFor(branchId, [ (loc, kind) ]) with
        | Error(e) ->
          printErr($"Couldn't read what uses {name}: {e}")
          { state with exitCode = 1 }
        | Ok(dependents) ->
          let users =
            dependents
            |> Stdlib.List.filterMap(fun((depLoc, depKind)) ->
              if depKind == LanguageTools.ProgramTypes.ItemKind.Test then
                Option.Some((Deps.fqnOf(depLoc), true))
              else
                Option.None)
            |> Stdlib.Dict.fromList

          let using =
            Stdlib.List.filter(under, fun((path, _)) ->
              Stdlib.Dict.containsKey(users, Stdlib.String.join(path, ".")))

          let heading =
            if depth == 0 then
              $"Tests that use {name}"
            else
              $"Tests in {place} that use {name}"

          printCounts(heading, prefix, using, groups)
          state


let help(_state: AppState): String =
  [ "Run package tests on the current branch, or add one."
    ""
    usage
    ""
    "A test is rerun only when it, anything it uses, or the build changes: a"
    "change to something it uses gives the test itself a new version. Use"
    "--force to ignore cached results."
    ""
    "Tests follow updates to the functions they use. Full dependency changes"
    "invalidate cached results."
    "Rebuilding the runtime or changing the judging code invalidates results."
    "Tests using branch-dependent formatting, including `equal` and `notEqual`,"
    "rerun conservatively; `expect` with a fixed message can be cached."
    ""
    "A filter selects tests whose full name contains its segments, whole and"
    "in order: a module (`Stdlib.Float64`), a test name, or both. Several filters"
    "select the union."
    "Deprecated (deleted) tests are skipped."
    "Tests run in parallel, one per core, up to 16 at once. A test that analysis"
    "shows is pure (no effect, only pure builtins) runs inside this process;"
    "any other gets a fresh process and its own store copy."
    "When stdout is not a terminal, only failures and the final counts are printed,"
    "as with --brief; --verbose prints every test, as at a terminal."
    "Use --jobs <count> to change the limit, or --jobs 1 to run serially."
    "Tests start in name order; results are printed as they finish. --json prints"
    "one answer at the end instead: each test's name, status (passed, failed or"
    "error), messages and whether it was cached, then the totals and the seed."
    ""
    "In a test, Stdlib.Uuid.generate and the Random functions draw from a seed"
    "picked fresh for each run. A failed run prints its seed; --seed <n> reruns"
    "with the same values."
    ""
    "A failing item of a `Stdlib.Test.all([ ... ])` list is shown by its"
    "position and source. `test emptyInput = Stdlib.Test.group(\"parsing\", ...)`"
    "puts a test in a group: it shows as `Module › parsing › emptyInput`, and"
    "a filter can name the group, as in `Tests.parsing`. Each row of a"
    "`Stdlib.Test.table(rows, check)` is its own test, in a group named after the"
    "test, as in `lengths › (\"a\", 1)`; a filter written that way runs the table"
    "and keeps only that row."
    "`test count` shows how many tests a module and each"
    "module under it hold, without running anything; a group or table shows as"
    "`› name`. `--for <item>` keeps only the"
    "tests that use that item, directly or through other code."
    ""
    "A path ending in `.dark` runs that script's tests: `test name = ...`"
    "declarations in the file, which see its functions, types and `val`s but"
    "none of its top-level statements. `dark run` skips them."
    ""
    "Examples:"
    "  test run"
    "  test run todo.dark"
    "  test run MyApp.Math"
    "  test run --force MyApp.Math.doubles"
    "  test count Darklang.Stdlib"
    "  test count --for Stdlib.List.map"
    ""
    "Adding a test:"
    "  test add MyApp.Math.Tests.doubles 'MyApp.Math.double(4) |> Stdlib.Test.equal(8)'"
    "  test add MyApp.Math.Tests.doubles doubles.dark"
    "  test add MyApp.Math.Tests.doubles - <<'EOF'"
    "  /// Doubling four gives eight."
    "  test doubles = MyApp.Math.double(4) |> Stdlib.Test.equal(8)"
    "  test keyLength = Stdlib.Uuid.generate() |> Stdlib.display |> Stdlib.String.length |> Stdlib.Test.equal(36)"
    "  EOF"
    "The body may be given alone or as a whole `test name = ...` declaration;"
    "it lands in your draft like `fn` and `val`. --description <text> documents it:"
    "  test add MyApp.Math.Tests.doubles 'MyApp.Math.double(4) |> Stdlib.Test.equal(8)' --description \"Doubling four gives eight.\"" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] -> [ "run", "count", "add" ] |> Stdlib.List.map(Completion.simple)
  | ["run", ...runArgs] ->
    let partial = Stdlib.Option.withDefault(Stdlib.List.last(runArgs), "")
    [ "--force", "--brief", "--verbose", "--json", "--jobs" ]
    |> Stdlib.List.filter(fun flag -> Stdlib.String.startsWith(flag, partial))
    |> Stdlib.List.map(Completion.simple)
  | ["add", ...] -> []
  | ["count", ...countArgs] ->
    let partial = Stdlib.Option.withDefault(Stdlib.List.last(countArgs), "")
    if Stdlib.String.startsWith("--for", partial) && partial != "" then
      [ Completion.simple("--for") ]
    else
      []
  | [partial] ->
    [ "run", "count", "add" ]
    |> Stdlib.List.filter(fun command -> Stdlib.String.startsWith(command, partial))
    |> Stdlib.List.map(Completion.simple)
  | _ -> []
