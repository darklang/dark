module Darklang.Cli.Packages.Propagate

// Propagation helpers.
//
// Propagation itself runs at `dark commit`, not on edit. What lives here is the one call into it
// (`repointDependents`) plus the structural comparison helpers `dark commit` uses to say whether an
// update changed a SIGNATURE -- which matters because propagation does a blind hash swap with no
// type-checking, so a signature change is the one thing callers can't absorb silently.

/// Convert an ItemKind to its display string
let itemKindToString (kind: LanguageTools.ProgramTypes.ItemKind) : String =
  match kind with
  | Fn -> "fn"
  | Type -> "type"
  | Value -> "value"

/// Parse a string to an ItemKind
let itemKindFromString (s: String) : Stdlib.Option.Option<LanguageTools.ProgramTypes.ItemKind> =
  match s with
  | "fn" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Fn
  | "type" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Type
  | "value" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Value
  | _ -> Stdlib.Option.Option.None

/// Get ALL hashes that have ever been at a location (across the branch chain).
/// Returns empty list if no entries exist (i.e., this is a brand new item).
/// Callers should filter out the current hash to get only previous versions.
let getAllPreviousHashes
  (branchId: String)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  : List<LanguageTools.ProgramTypes.Hash> =
  Builtin.pmGetAllPreviousHashes location itemKind


/// Resolve a type hash to its location name for comparison purposes.
/// Two hashes that point to the same named location are considered equal.
let resolveTypeName
  (branchId: String)
  (hash: LanguageTools.ProgramTypes.FQTypeName.Package)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageLocation> =
  Darklang.LanguageTools.PackageManager.pickLocation
    Darklang.LanguageTools.PackageManager.PickContext.empty
    (Builtin.pmGetLocationsByType branchId hash)


/// Compare two lists element-wise; returns false if lengths differ.
let listsEqual (xs: List<'a>) (ys: List<'a>) (eq: 'a -> 'a -> Bool) : Bool =
  let checks = Stdlib.List.map2 xs ys (fun a b -> eq a b)
  let results = Stdlib.Option.withDefault checks []
  (Stdlib.List.length xs == Stdlib.List.length ys)
  && (Stdlib.List.all results (fun x -> x))


/// Structurally compare two TypeReferences, resolving hashes to names.
/// Returns true if they are semantically equal (same structure, same named types).
let typeReferenceEqual
  (branchId: String)
  (a: LanguageTools.ProgramTypes.TypeReference)
  (b: LanguageTools.ProgramTypes.TypeReference)
  : Bool =
  match (a, b) with
  | (TVariable nameA, TVariable nameB) -> nameA == nameB
  | (TUnit, TUnit) -> true
  | (TBool, TBool) -> true
  | (TInt8, TInt8) -> true
  | (TUInt8, TUInt8) -> true
  | (TInt16, TInt16) -> true
  | (TUInt16, TUInt16) -> true
  | (TInt32, TInt32) -> true
  | (TUInt32, TUInt32) -> true
  | (TInt64, TInt64) -> true
  | (TUInt64, TUInt64) -> true
  | (TInt128, TInt128) -> true
  | (TUInt128, TUInt128) -> true
  | (TInt, TInt) -> true
  | (TFloat, TFloat) -> true
  | (TChar, TChar) -> true
  | (TString, TString) -> true
  | (TDateTime, TDateTime) -> true
  | (TUuid, TUuid) -> true
  | (TBlob, TBlob) -> true

  | (TStream innerA, TStream innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TList innerA, TList innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TDict innerA, TDict innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TDB innerA, TDB innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TTuple (firstA, secondA, restA), TTuple (firstB, secondB, restB)) ->
    (typeReferenceEqual branchId firstA firstB)
    && (typeReferenceEqual branchId secondA secondB)
    && (listsEqual restA restB (fun a b -> typeReferenceEqual branchId a b))

  | (TCustomType (typA, argsA), TCustomType (typB, argsB)) ->
    let namesEqual =
      match (typA, typB) with
      | (Ok (Package idA), Ok (Package idB)) ->
        let locA = resolveTypeName branchId idA
        let locB = resolveTypeName branchId idB
        match (locA, locB) with
        | (Some lA, Some lB) -> lA == lB
        | _ -> idA == idB
      | (Error eA, Error eB) -> eA == eB
      | _ -> false

    namesEqual
    && (listsEqual argsA argsB (fun a b -> typeReferenceEqual branchId a b))

  | (TFn (argsA, retA), TFn (argsB, retB)) ->
    (listsEqual argsA argsB (fun a b -> typeReferenceEqual branchId a b))
    && (typeReferenceEqual branchId retA retB)

  | _ -> false


/// Compare two function signatures structurally (type params, parameter names/types, return type).
let fnSignatureEqual
  (branchId: String)
  (oldF: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  (newF: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : Bool =
  let typeParamsEqual = oldF.typeParams == newF.typeParams

  let paramsEqual =
    listsEqual oldF.parameters newF.parameters (fun oldP newP ->
      oldP.name == newP.name && typeReferenceEqual branchId oldP.typ newP.typ)

  let returnEqual = typeReferenceEqual branchId oldF.returnType newF.returnType

  typeParamsEqual && paramsEqual && returnEqual


/// Repoint this item's dependents NOW, into the draft, and say so in one line.
///
/// Propagation happens on EDIT again, not only at commit. The reason is the whole point of doing it at all:
/// you change `base` in order to find out what it does to the things above it, and you cannot find that out
/// if `dep` is still pinned to the old version until you commit. Seeing the impact is how you decide whether
/// to commit, so it has to happen first.
///
/// Nothing is committed by this. The repoints land in the DRAFT like any other edit, `dark status` counts them,
/// and `dark commit` is still the moment you bless the whole thing. The checkpoint model is intact; what
/// moved is when the repoint becomes visible, not when it becomes permanent.
///
/// Quiet by design: one line, or nothing when nothing moved. The wall of per-edit consequences is the churn
/// this design exists to remove.
let repointNow
  (branchId: String)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (previousHashes: List<LanguageTools.ProgramTypes.Hash>)
  (currentHash: LanguageTools.ProgramTypes.Hash)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  : Unit =
  match previousHashes with
  | [] -> () // brand new: nothing can be pointing at an older version of it
  | _ ->
    match repointDependents branchId location itemKind previousHashes currentHash with
    | Ok [] -> ()
    | Ok repoints ->
      let n = Stdlib.Int.toString (Stdlib.List.length repoints)
      Stdlib.printLine (Colors.hint $"  {n} dependent(s) repointed")
    | Error e -> Stdlib.printLine (Colors.error $"  propagation failed: {e}")


/// THE call into propagation. Repoint everything that still references an older version of
/// <param location> at <param currentHash>, transitively, and hand back the repoints so the caller can
/// report them however it likes. One wrapper so the eager path and `dark commit` can't drift apart on what
/// "propagate" means.
let repointDependents
  (branchId: String)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  (previousHashes: List<LanguageTools.ProgramTypes.Hash>)
  (currentHash: LanguageTools.ProgramTypes.Hash)
  : Stdlib.Result.Result<List<LanguageTools.ProgramTypes.PropagateRepoint>, String> =
  Builtin.pmPropagate branchId location itemKind previousHashes currentHash
