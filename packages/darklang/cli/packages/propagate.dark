module Darklang.Cli.Packages.Propagate

// Propagation helpers.
//
// Propagation itself runs on EDIT (`repointNow`), not at commit. What lives here is the one call into it
// (`repointDependents`) plus the structural comparison helpers `dark commit` uses to say whether an
// update changed a SIGNATURE -- which matters because propagation does a blind hash swap with no
// type-checking, so a signature change is the one thing callers can't absorb silently.

/// Convert an ItemKind to its display string
let itemKindToString (kind: LanguageTools.ProgramTypes.ItemKind) : String =
  match kind with
  | Fn -> "fn"
  | Type -> "type"
  | Value -> "value"

/// Parse a string to an ItemKind
let itemKindFromString (s: String) : Stdlib.Option.Option<LanguageTools.ProgramTypes.ItemKind> =
  match s with
  | "fn" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Fn
  | "type" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Type
  | "value" -> Stdlib.Option.Option.Some LanguageTools.ProgramTypes.ItemKind.Value
  | _ -> Stdlib.Option.Option.None

/// Every hash that has ever been at a location, NEWEST FIRST. Empty means the name is new here.
/// Callers filter out the current hash to get only previous versions.
///
/// Two sources, and both are needed. `locations` has no `branch_id`, so on a branch its rows are the
/// history you FORKED FROM; the branch's own edits live in its op log and are prepended here. Answering
/// from `locations` alone is the plausible-but-wrong shape: re-authoring a branch-only item reads as
/// "Created" rather than "Updated", and propagation finds no earlier version to repoint dependents off.
let getAllPreviousHashes
  (branchId: Uuid)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  : List<LanguageTools.ProgramTypes.Hash> =
  let fromMain = SCM.Propagation.everBoundHashes location itemKind

  if SCM.Branch.isMain branchId then
    fromMain
  else
    // `branchHashHistoryFor` is oldest-first and this is newest-first, so it is reversed and goes in
    // FRONT: a branch's edits happened after the history it forked from.
    let fromBranch =
      SCM.PackageOps.branchHashHistoryFor
        branchId
        location.owner
        (Stdlib.String.join location.modules ".")
        location.name
      |> Stdlib.List.reverse
      |> Stdlib.List.map (fun h -> LanguageTools.ProgramTypes.Hash.Hash h)
      |> Stdlib.List.filter (fun h ->
        Stdlib.Bool.not (Stdlib.List.``member`` fromMain h))

    Stdlib.List.append fromBranch fromMain


/// Resolve a type hash to its location name for comparison purposes.
/// Two hashes that point to the same named location are considered equal.
let resolveTypeName
  (branchId: Uuid)
  (hash: LanguageTools.ProgramTypes.FQTypeName.Package)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageLocation> =
  Darklang.LanguageTools.PackageManager.pickLocation
    Darklang.LanguageTools.PackageManager.PickContext.empty
    (LanguageTools.PackageManager.Type.locations branchId hash)


/// Compare two lists element-wise; returns false if lengths differ.
let listsEqual (xs: List<'a>) (ys: List<'a>) (eq: 'a -> 'a -> Bool) : Bool =
  let checks = Stdlib.List.map2 xs ys (fun a b -> eq a b)
  let results = Stdlib.Option.withDefault checks []
  (Stdlib.List.length xs == Stdlib.List.length ys)
  && (Stdlib.List.all results (fun x -> x))


/// Structurally compare two TypeReferences, resolving hashes to names.
/// Returns true if they are semantically equal (same structure, same named types).
let typeReferenceEqual
  (branchId: Uuid)
  (a: LanguageTools.ProgramTypes.TypeReference)
  (b: LanguageTools.ProgramTypes.TypeReference)
  : Bool =
  match (a, b) with
  | (TVariable nameA, TVariable nameB) -> nameA == nameB
  | (TUnit, TUnit) -> true
  | (TBool, TBool) -> true
  | (TInt8, TInt8) -> true
  | (TUInt8, TUInt8) -> true
  | (TInt16, TInt16) -> true
  | (TUInt16, TUInt16) -> true
  | (TInt32, TInt32) -> true
  | (TUInt32, TUInt32) -> true
  | (TInt64, TInt64) -> true
  | (TUInt64, TUInt64) -> true
  | (TInt128, TInt128) -> true
  | (TUInt128, TUInt128) -> true
  | (TInt, TInt) -> true
  | (TFloat, TFloat) -> true
  | (TChar, TChar) -> true
  | (TString, TString) -> true
  | (TDateTime, TDateTime) -> true
  | (TUuid, TUuid) -> true
  | (TBlob, TBlob) -> true

  | (TStream innerA, TStream innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TList innerA, TList innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TDict innerA, TDict innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TDB innerA, TDB innerB) ->
    typeReferenceEqual branchId innerA innerB

  | (TTuple (firstA, secondA, restA), TTuple (firstB, secondB, restB)) ->
    (typeReferenceEqual branchId firstA firstB)
    && (typeReferenceEqual branchId secondA secondB)
    && (listsEqual restA restB (fun a b -> typeReferenceEqual branchId a b))

  | (TCustomType (typA, argsA), TCustomType (typB, argsB)) ->
    let namesEqual =
      match (typA.resolved, typB.resolved) with
      | (Ok resolvedA, Ok resolvedB) ->
        match (resolvedA.name, resolvedB.name) with
        | (Package idA, Package idB) ->
          let locA = resolveTypeName branchId idA
          let locB = resolveTypeName branchId idB
          match (locA, locB) with
          | (Some lA, Some lB) -> lA == lB
          | _ -> idA == idB
      | (Error eA, Error eB) -> eA == eB
      | _ -> false

    namesEqual
    && (listsEqual argsA argsB (fun a b -> typeReferenceEqual branchId a b))

  | (TFn (argsA, retA), TFn (argsB, retB)) ->
    (listsEqual argsA argsB (fun a b -> typeReferenceEqual branchId a b))
    && (typeReferenceEqual branchId retA retB)

  | _ -> false


/// Compare two function signatures structurally (type params, parameter names/types, return type).
let fnSignatureEqual
  (branchId: Uuid)
  (oldF: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  (newF: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : Bool =
  let typeParamsEqual = oldF.typeParams == newF.typeParams

  let paramsEqual =
    listsEqual oldF.parameters newF.parameters (fun oldP newP ->
      oldP.name == newP.name && typeReferenceEqual branchId oldP.typ newP.typ)

  let returnEqual = typeReferenceEqual branchId oldF.returnType newF.returnType

  typeParamsEqual && paramsEqual && returnEqual


/// Repoint this item's dependents NOW, into the draft, and say so in one line.
///
/// On EDIT rather than at commit, which is the whole point of propagating at all: you change `base` in
/// order to find out what it does to the things above it, and you cannot find that out while `dep` is
/// still pinned to the old version. Seeing the impact is how you decide whether to commit, so it has to
/// happen first.
///
/// Nothing is committed here. The repoints land in the DRAFT like any other edit, `dark status` counts
/// them, and `dark commit` is still the moment the whole thing is blessed.
///
/// Quiet by design: one line, or nothing when nothing moved. A wall of per-edit consequences is the churn
/// this design exists to remove.
/// What a save's propagation did, for the save to say in its own words.
type Followed =
  { /// The dependents now on the new version, by name, in the order they were repointed.
    names: List<String>
    /// The ones that no longer type-check, with the first issue each, as `Live.issueText` puts it.
    broken: List<(String * String)>
    /// Propagation itself failed; the names above are empty.
    failure: Stdlib.Option.Option<String> }

let nothingFollowed () : Followed =
  Followed { names = []; broken = []; failure = Stdlib.Option.Option.None }

/// Repoint the dependents of <param location> at <param currentHash>, now, into the draft, and say
/// what followed. The caller prints; a save is at most two lines and decides its own glyph from this.
let repointNow
  (branchId: Uuid)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (previousHashes: List<LanguageTools.ProgramTypes.Hash>)
  (currentHash: LanguageTools.ProgramTypes.Hash)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  : Followed =
  match previousHashes with
  | [] -> nothingFollowed () // brand new: nothing can be pointing at an older version of it
  | _ ->
    match repointDependents branchId location itemKind previousHashes currentHash with
    | Ok [] -> nothingFollowed ()
    | Ok repoints ->
      let nameOf (r: LanguageTools.ProgramTypes.PropagateRepoint) : String =
        let l = r.location
        let mods = Stdlib.String.join l.modules "."
        if mods == "" then $"{l.owner}.{l.name}" else $"{l.owner}.{mods}.{l.name}"

      let names = repoints |> Stdlib.List.map nameOf |> Stdlib.List.unique

      // The one thing worth saying at the SAVE that nothing else says in the same breath: some of
      // what just followed you is now broken. The draft check already covers the items; this only
      // takes the repointed ones among its failures -- branch-correct, unlike the old report.
      let byHash =
        repoints |> Stdlib.List.map (fun r -> (SCM.Draft.referenceHash r.toRef, nameOf r))

      let broken =
        (SCM.PackageOps.typeCheckDraft branchId).items
        |> Stdlib.List.filterMap (fun ir ->
          let h = SCM.Draft.referenceHash ir.item

          match ir.verdict with
          | Failed ->
            byHash
            |> Stdlib.List.findFirst (fun pair -> (Stdlib.Tuple2.first pair) == h)
            |> Stdlib.Option.map (fun pair ->
              let issues = Stdlib.List.append ir.blockers ir.diagnostics

              let text =
                match issues with
                | issue :: _ -> Stdlib.Live.issueText issue
                | [] -> "it failed the type check"

              (Stdlib.Tuple2.second pair, text))
          | _ -> Stdlib.Option.Option.None)

      Followed { names = names; broken = broken; failure = Stdlib.Option.Option.None }
    | Error e -> Followed { names = []; broken = []; failure = Stdlib.Option.Option.Some e }

/// The save's second line, if it has one: who follows, or who broke. Wrapped at 80, indented.
let printFollowed (followed: Followed) : Unit =
  match followed.failure with
  | Some e -> Cli.Text.printWrapped Stdlib.Cli.UI.Colors.error "  " $"propagation failed: {e}"
  | None ->
    match followed.broken with
    | [] ->
      match followed.names with
      | [] -> ()
      | [ one ] -> Stdlib.printLine (Stdlib.Cli.UI.Colors.hint $"  {one} follows")
      | names ->
        let count = Stdlib.List.length names
        let shown = names |> Stdlib.List.take 3 |> Stdlib.String.join ", "
        let rest = if count > 3 then $" and {Stdlib.Int.toString (count - 3)} more" else ""
        Cli.Text.printWrapped Stdlib.Cli.UI.Colors.hint "  " $"{Stdlib.Int.toString count} dependents follow: {shown}{rest}"
    | broken ->
      broken
      |> Stdlib.List.iter (fun pair ->
        let (name, why) = pair
        let line = $"{name} no longer type-checks: {why}"
        let withHint = line ++ "; `dark typecheck --failed` lists them"
        // The way to the full list only when it fits; the diagnostic is the part that matters.
        let text = if (Stdlib.String.length withHint) + 2 <= 80 then withHint else line
        Cli.Text.printWrapped Stdlib.Cli.UI.Colors.error "  " text)


/// THE call into propagation. Repoint everything that still references an older version of
/// <param location> at <param currentHash>, transitively, and hand back the repoints so the caller can
/// report them however it likes. One wrapper so the eager path and `dark commit` can't drift apart on what
/// "propagate" means.
let repointDependents
  (branchId: Uuid)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  (previousHashes: List<LanguageTools.ProgramTypes.Hash>)
  (currentHash: LanguageTools.ProgramTypes.Hash)
  : Stdlib.Result.Result<List<LanguageTools.ProgramTypes.PropagateRepoint>, String> =
  SCM.Propagation.repointDependents branchId location itemKind previousHashes currentHash


/// Repoint everything that referenced an EARLIER version of <param location> at <param currentHash>.
///
/// The eager path used by the authoring commands: they know the location and the new hash, and the
/// previous versions are whatever the store already holds under that name. `dark module` is the caller
/// that needs it most, since one command can redefine many declarations at once.
let autoPropagateAfterUpdate
  (branchId: Uuid)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (currentHash: LanguageTools.ProgramTypes.Hash)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  : Unit =
  let previousHashes =
    getAllPreviousHashes branchId location itemKind
    |> Stdlib.List.filter (fun h -> h != currentHash)

  printFollowed (repointNow branchId location previousHashes currentHash itemKind)
