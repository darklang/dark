module Darklang.Cli.Packages.Propagate

// Propagation helpers.
//
// Saves invoke SCM.Propagation through `repointNow`. The structural comparison helpers here let
// `dark commit` say whether an
// update changed a SIGNATURE -- which matters because propagation does a blind hash swap with no
// type-checking, so a signature change is the one thing callers can't absorb silently.

/// Every hash that has ever been at a location, NEWEST FIRST. Empty means the name is new here.
/// Callers filter out the current hash to get only previous versions.
///
/// Two sources: `everBoundHashes` is the history you FORKED FROM, and on a branch its own edits are
/// prepended. Without them, re-authoring a branch-only item reads as "Created" rather than "Updated",
/// and propagation finds no earlier version to repoint dependents off.
let getAllPreviousHashes(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  itemKind: LanguageTools.ProgramTypes.ItemKind)
  : List<LanguageTools.ProgramTypes.Hash> =
  let fromMain = SCM.Propagation.everBoundHashes(location, itemKind)
  if SCM.Branch.isMain(branchId) then
    fromMain
  else
    // `branchHashHistoryFor` is oldest-first and this is newest-first, so it is reversed and goes in
    // FRONT: a branch's edits happened after the history it forked from.
    let fromBranch =
      SCM.PackageOps.branchHashHistoryFor(
        branchId,
        location.owner,
        Stdlib.String.join(location.modules, "."),
        location.name)
      |> Stdlib.List.reverse
      |> Stdlib.List.map(fun h -> LanguageTools.ProgramTypes.Hash.Hash(h))
      |> Stdlib.List.filter(fun h -> Stdlib.Bool.not(Stdlib.List.contains(fromMain, h)))

    Stdlib.List.concat(fromBranch, fromMain)


/// Resolve a type hash to its location name for comparison purposes.
/// Two hashes that point to the same named location are considered equal.
let resolveTypeName(
  branchId: Uuid,
  hash: LanguageTools.ProgramTypes.FQTypeName.Package)
  : Option<LanguageTools.ProgramTypes.PackageLocation> =
  LanguageTools.PackageManager.pickLocation(
    LanguageTools.PackageManager.PickContext.empty,
    LanguageTools.PackageManager.Type.locations(branchId, hash))


/// Compare two lists element-wise; returns false if lengths differ.
let listsEqual(xs: List<'a>, ys: List<'a>, eq: ('a, 'a) -> Bool): Bool =
  let checks = Stdlib.List.map2(xs, ys, fun(a, b) -> eq(a, b))
  let results = Stdlib.Result.withDefault(checks, [])
  Stdlib.List.length(xs) == Stdlib.List.length(ys) && Stdlib.List.all(results, fun x -> x)


/// Structurally compare two TypeReferences, resolving hashes to names.
/// Returns true if they are semantically equal (same structure, same named types).
let typeReferenceEqual(
  branchId: Uuid,
  a: LanguageTools.ProgramTypes.TypeReference,
  b: LanguageTools.ProgramTypes.TypeReference)
  : Bool =
  match a, b with
  | TVariable(nameA), TVariable(nameB) -> nameA == nameB
  | TUnit, TUnit -> true
  | TBool, TBool -> true
  | TInt8, TInt8 -> true
  | TUInt8, TUInt8 -> true
  | TInt16, TInt16 -> true
  | TUInt16, TUInt16 -> true
  | TInt32, TInt32 -> true
  | TUInt32, TUInt32 -> true
  | TInt64, TInt64 -> true
  | TUInt64, TUInt64 -> true
  | TInt128, TInt128 -> true
  | TUInt128, TUInt128 -> true
  | TBigInt, TBigInt -> true
  | TFloat64, TFloat64 -> true
  | TFloat32, TFloat32 -> true
  | TDecimal, TDecimal -> true
  | TChar, TChar -> true
  | TString, TString -> true
  | TDateTime, TDateTime -> true
  | TUuid, TUuid -> true
  | TBytes, TBytes -> true
  | TStream(innerA), TStream(innerB) -> typeReferenceEqual(branchId, innerA, innerB)
  | TList(innerA), TList(innerB) -> typeReferenceEqual(branchId, innerA, innerB)
  | TDict(keyA, valueA), TDict(keyB, valueB) ->
    typeReferenceEqual(branchId, keyA, keyB) && typeReferenceEqual(branchId, valueA, valueB)
  | TTuple(firstA, secondA, restA), TTuple(firstB, secondB, restB) ->
    typeReferenceEqual(branchId, firstA, firstB)
    && typeReferenceEqual(branchId, secondA, secondB)
    && listsEqual(restA, restB, fun(a, b) -> typeReferenceEqual(branchId, a, b))
  | TCustomType(typA, argsA), TCustomType(typB, argsB) ->
    let namesEqual =
      match typA.resolved, typB.resolved with
      | Ok(resolvedA), Ok(resolvedB) ->
        match resolvedA.name, resolvedB.name with
        | Package(idA), Package(idB) ->
          let locA = resolveTypeName(branchId, idA)
          let locB = resolveTypeName(branchId, idB)
          match locA, locB with
          | Some(lA), Some(lB) -> lA == lB
          | _ -> idA == idB
      | Error(eA), Error(eB) -> eA == eB
      | _ -> false

    namesEqual && listsEqual(argsA, argsB, fun(a, b) -> typeReferenceEqual(branchId, a, b))
  | TFn(argsA, retA), TFn(argsB, retB) ->
    listsEqual(argsA, argsB, fun(a, b) -> typeReferenceEqual(branchId, a, b))
    && typeReferenceEqual(branchId, retA, retB)
  | _ -> false


/// Compare two function signatures structurally (type params, parameter names/types, return type).
let fnSignatureEqual(
  branchId: Uuid,
  oldF: LanguageTools.ProgramTypes.PackageFn.PackageFn,
  newF: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : Bool =
  let typeParamsEqual = oldF.typeParams == newF.typeParams
  let paramsEqual =
    listsEqual(oldF.parameters, newF.parameters, fun(oldP, newP) ->
      oldP.name == newP.name && typeReferenceEqual(branchId, oldP.typ, newP.typ))

  let returnEqual = typeReferenceEqual(branchId, oldF.returnType, newF.returnType)
  typeParamsEqual && paramsEqual && returnEqual


/// What a save's propagation did, for the save to say in its own words.
type Followed =
  { /// The dependents now on the new version, by name, in the order they were repointed.
    names: List<String>
    /// The ones that no longer type-check, with the first issue each, as `Live.issueText` puts it.
    broken: List<(String * String)>
    /// Propagation itself failed; the names above are empty.
    failure: Option<String> }


let nothingFollowed(): Followed =
  Followed { names = [], broken = [], failure = Option.None }


/// Whether a save type-checks the dependents that followed it. `Skip` leaves `broken` empty.
type FollowerCheck =
  | Check
  | Skip


/// Repoint the dependents of <param location> at <param currentHash>, now, into the draft, and say
/// what followed.
///
/// On EDIT rather than at commit, which is the whole point of propagating at all: you change `base` in
/// order to find out what it does to the things above it, and you cannot find that out while `dep` is
/// still using the old version. Seeing the impact is how you decide whether to commit, so it has to
/// happen first.
///
/// Nothing is committed here. The repoints land in the DRAFT like any other edit, `dark status` counts
/// them, and `dark commit` is still the moment the whole thing is blessed.
///
/// Quiet by design: the caller prints, a save is at most two lines and decides its own glyph from
/// this. A wall of per-edit consequences is the churn this design exists to remove.
let repointNow(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  previousHashes: List<LanguageTools.ProgramTypes.Hash>,
  currentHash: LanguageTools.ProgramTypes.Hash,
  itemKind: LanguageTools.ProgramTypes.ItemKind,
  followerCheck: FollowerCheck)
  : Followed =
  match previousHashes with
  | [] -> nothingFollowed()  // brand new: nothing can be pointing at an older version of it
  | _ ->
    match SCM.Propagation.repointDependents(
            branchId,
            location,
            itemKind,
            previousHashes,
            currentHash) with
    | Ok([]) -> nothingFollowed()
    | Ok(repoints) ->
      // A repointed saved generator is a generator whose input moved: re-run it, so its
      // outputs follow the edit the way a caller follows a callee. Staging its outputs
      // comes back through here for THEIR dependents, which is the cascade.
      Generate.regenerateRepointed(branchId, repoints)
      let nameOf(r: LanguageTools.ProgramTypes.PropagateRepoint): String =
        let l = r.location
        let mods = Stdlib.String.join(l.modules, ".")
        if mods == "" then $"{l.owner}.{l.name}" else $"{l.owner}.{mods}.{l.name}"

      let names =
        repoints
        |> Stdlib.List.map(nameOf)
        |> Stdlib.List.unique

      // Check updated callers on this branch, including ones that reuse a stored version.
      let broken =
        match followerCheck with
        | Skip -> []
        | Check ->
          let report =
            LanguageTools.AtRestTypeChecker.Run.checkReferences(
              branchId,
              LanguageTools.AtRestTypeChecker.Run.loadCandidate,
              Stdlib.List.map(repoints, fun r -> r.toRef))

          let issuesByRef =
            report.items
            |> Stdlib.List.fold(Dict {}, fun(found, ir) ->
              match ir.verdict with
              | Failed ->
                let why =
                  match Stdlib.List.concat(ir.diagnostics, ir.warnings) with
                  | [issue, ...] -> LanguageTools.Live.issueText(issue)
                  | [] -> "it failed the type check"

                Stdlib.Dict.set(found, ir.item, why)
              | _ -> found)

          repoints
          |> Stdlib.List.filterMap(fun r ->
            Stdlib.Dict.get(issuesByRef, r.toRef) |> Stdlib.Option.map(fun why -> (nameOf(r), why)))
          |> Stdlib.List.unique

      Followed { names = names, broken = broken, failure = Option.None }
    | Error(e) -> Followed { names = [], broken = [], failure = Option.Some(e) }


/// A binding that existed before this save. Method functions count too.
type UpdatedItem =
  { location: LanguageTools.ProgramTypes.PackageLocation
    kind: LanguageTools.ProgramTypes.ItemKind
    previous: List<LanguageTools.ProgramTypes.Hash> }


/// Capture before storage, while the old bindings are still visible.
let updatedItems(
  branchId: Uuid,
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<UpdatedItem> =
  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | SetName(location, reference, _) ->
      let kind = LanguageTools.ProgramTypes.Reference.kind(reference)
      let previous = getAllPreviousHashes(branchId, location, kind)
      if Stdlib.List.isEmpty(previous) then
        Option.None
      else
        Option.Some(UpdatedItem { location = location, kind = kind, previous = previous })
    | _ -> Option.None)
  |> Stdlib.List.uniqueBy(fun item -> item.location)


/// Every updated binding uses its final stored hash, shared by all authoring paths.
let repointSaved(
  branchId: Uuid,
  updates: List<UpdatedItem>,
  followerCheck: FollowerCheck)
  : Followed =
  updates
  |> Stdlib.List.fold(nothingFollowed(), fun(combined, update) ->
    let followed =
      match SCM.Propagation.hashOn(branchId, update.location, update.kind) with
      | Some(current) ->
        repointNow(
          branchId,
          update.location,
          update.previous |> Stdlib.List.filter(fun h -> h != current),
          current,
          update.kind,
          followerCheck)
      | None ->
        Followed
          { names = []
            broken = []
            failure = Option.Some("A saved binding could not be resolved.") }

    let failure =
      match combined.failure with
      | Some(_) -> combined.failure
      | None -> followed.failure

    Followed
      { names = Stdlib.List.unique(Stdlib.List.concat(combined.names, followed.names))
        broken = Stdlib.List.unique(Stdlib.List.concat(combined.broken, followed.broken))
        failure = failure })


/// Report which dependents followed the save or failed their type check.
let printFollowed(followed: Followed): Unit =
  match followed.failure with
  | Some(e) -> Text.printWrappedErr(Stdlib.Cli.UI.Colors.error, "  ", $"propagation failed: {e}")
  | None ->
    match followed.broken with
    | [] ->
      match followed.names with
      | [] -> ()
      | [one] -> Stdlib.printLine(Stdlib.Cli.UI.Colors.hint($"  {one} follows"))
      | names ->
        let count = Stdlib.List.length(names)
        let shown =
          names
          |> Stdlib.List.take(3)
          |> Stdlib.String.join(", ")

        let rest = if count > 3 then $" and {Stdlib.display(count - 3)} more" else ""
        Text.printWrapped(
          Stdlib.Cli.UI.Colors.hint,
          "  ",
          $"{Stdlib.display(count)} dependents follow: {shown}{rest}")
    | [(name, why)] ->
      Text.printWrappedErr(Stdlib.Cli.UI.Colors.error, "  ", $"{name} no longer type-checks")
      Text.printWrappedErr(Stdlib.Cli.UI.Colors.error, "    ", why)
    | broken ->
      let count = Stdlib.display(Stdlib.List.length(broken))
      Text.printWrappedErr(
        Stdlib.Cli.UI.Colors.error,
        "  ",
        $"{count} dependents no longer type-check:")

      broken
      |> Stdlib.List.iter(fun((name, why)) ->
        Text.printWrappedErr(Stdlib.Cli.UI.Colors.error, "  ", $"- {name}")
        Text.printWrappedErr(Stdlib.Cli.UI.Colors.error, "    ", why))


/// Report the propagation result for a single declaration edit.
let printEditPropagation(followed: Followed): Unit =
  let names = Stdlib.List.sortWith(followed.names, fun(a, b) ->
    let order = Stdlib.String.compare(a, b)
    if order < 0 then
      Stdlib.Ordering.Less
    else if order > 0 then
      Stdlib.Ordering.Greater
    else
      Stdlib.Ordering.Equal)

  match followed.failure, followed.broken, names with
  | None, [], [first, ...rest] ->
    let message =
      match rest with
      | [] -> $"{first} now uses the new version"
      | [second] -> $"{first} and {second} now use the new version"
      | [second, third] -> $"{first}, {second}, and {third} now use the new version"
      | [second, third, ...others] ->
        let more = Stdlib.display(Stdlib.List.length(others))
        $"{first}, {second}, {third}, and {more} more now use the new version"

    Text.printWrapped(Stdlib.Cli.UI.Colors.hint, "  ", message)
  | _ -> printFollowed(followed)


/// <fn printFollowed> as one clause for a footer that already says what was saved (the workbench's):
/// "" when nothing followed, else `; ` and the same news, shortest first.
let followedNote(followed: Followed): String =
  match followed.failure with
  | Some(e) -> $"; propagation failed: {e}"
  | None ->
    match followed.broken with
    | [] ->
      match followed.names with
      | [] -> ""
      | [one] -> $"; {one} follows"
      | names -> $"; {Stdlib.display(Stdlib.List.length(names))} dependents follow"
    | [(name, why), ...rest] ->
      let more =
        match rest with
        | [] -> ""
        | _ -> $" (and {Stdlib.display(Stdlib.List.length(rest))} more)"

      $"; {name} no longer type-checks: {why}{more}"
