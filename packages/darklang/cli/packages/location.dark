module Darklang.Cli.Packages.Location


/// Parse a location string relative to current position
/// Handles absolute paths (/Darklang.Foo.bar) and relative paths (bar, Foo.bar)
let parseRelativeTo
  (currentLocation: Packages.PackageLocation)
  (location: String)
  : Stdlib.Result.Result<LanguageTools.ProgramTypes.PackageLocation, String> =
  // Get the current module path
  let currentPath = Traversal.getCurrentModulePath currentLocation

  // Check if it's an absolute path
  let isAbsolute = Stdlib.String.startsWith location "/"

  let parts =
    if isAbsolute then
      // Remove leading slash and split
      let withoutSlash = Stdlib.String.dropFirst location 1
      Stdlib.String.split withoutSlash "."
    else
      // Relative path - combine current path with relative path
      let relativeParts = Stdlib.String.split location "."
      Stdlib.List.append currentPath relativeParts

  match parts with
  | [] -> Stdlib.Result.Result.Error "Empty location"
  | [_] -> Stdlib.Result.Result.Error "Location must have at least owner, module, and name"
  | [_; _] -> Stdlib.Result.Result.Error "Location must have at least owner, module, and name"
  | owner :: rest ->
    let name = (Stdlib.List.last rest) |> Builtin.unwrap
    let modules = Stdlib.List.dropLast rest

    // Module segments MUST be capitalised, and this has to be refused here rather than discovered later.
    //
    // The parser reads a dotted name by taking capitalised segments as modules and the first lowercase one
    // as the NAME, treating anything after it as field access. So `Zz.low.f` parses as the name `Zz.low`
    // with `.f` applied to it. Authoring it anyway used to SUCCEED -- the item stored fine and `dark view`
    // rendered it -- and then every reference to it failed with "Zz.low not found", which reads as a
    // resolution bug and sends you looking a long way from the cause. Creating something the language
    // cannot refer to is the actual defect.
    //
    // The owner segment is exempt: lowercase owners resolve fine (`zz.Mod.k` works).
    let badModule =
      modules
      |> Stdlib.List.findFirst (fun m ->
        match Stdlib.String.toList m with
        | [] -> true
        | first :: _ -> (Stdlib.Char.isUppercase first) |> Stdlib.Bool.not)

    match badModule with
    | Some bad ->
      Stdlib.Result.Result.Error
        $"module names must start with a capital: \"{bad}\" doesn't. A lowercase segment is read as the item NAME, so nothing could refer to what you'd be creating."
    | None ->
      Stdlib.Result.Result.Ok
        (LanguageTools.ProgramTypes.PackageLocation
          { owner = owner; modules = modules; name = name })