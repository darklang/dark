module Darklang.Cli.Packages.Location

/// Parse a location string relative to current position
/// Handles absolute paths (/Darklang.Foo.bar) and relative paths (bar, Foo.bar)
let parseRelativeTo(
  currentLocation: PackageLocation,
  location: String)
  : Result<LanguageTools.ProgramTypes.PackageLocation, String> =
  // Get the current module path
  let currentPath = Traversal.getCurrentModulePath(currentLocation)

  // Check if it's an absolute path
  let isAbsolute = Stdlib.String.startsWith(location, "/")
  let parts =
    if isAbsolute then
      // Remove leading slash and split
      let withoutSlash = Stdlib.String.dropFirst(location, 1)
      Stdlib.String.split(withoutSlash, ".")
    else
      // Relative path - combine current path with relative path
      let relativeParts = Stdlib.String.split(location, ".")
      Stdlib.List.concat(currentPath, relativeParts)

  match parts with
  | [] -> Result.Error("Empty location")
  | [name] ->
    Result.Error($"a name starts with its owner, Owner.name or Owner.Module.name; try `Me.{name}`")
  | [owner, ...rest] ->
    let name = Stdlib.List.last(rest) |> Stdlib.Option.withDefault("")
    let modules = Stdlib.List.dropLast(rest)

    // Module segments must be capitalised. A lowercase one is read as the item's NAME,
    // so `Zz.low.f` authors `Zz.low`, and every later reference fails with "Zz.low not
    // found" -- far from here. Owners are exempt.
    let badModule =
      modules
      |> Stdlib.List.findFirst(fun m ->
        match Stdlib.String.toList(m) with
        | [] -> true
        | [first, ...] -> Stdlib.Bool.not(Stdlib.Char.isUppercase(first)))

    match badModule with
    | Some(bad) ->
      Result.Error(
        $"module names must start with a capital, and \"{bad}\" does not. "
        + "A lowercase segment is read as the item's NAME, so nothing could refer "
        + "to what this would create.")
    | None ->
      Result.Ok(
        LanguageTools.ProgramTypes.PackageLocation
          { owner = owner, modules = modules, name = name })


/// <fn parseRelativeTo> for a name a command creates: one that starts with an owner is a full
/// name wherever you stand, as it is for lookups (`Traversal.applyPathFrom`), unless something
/// here already has that first name.
let parseFrom(
  branchId: Uuid,
  currentLocation: PackageLocation,
  location: String)
  : Result<LanguageTools.ProgramTypes.PackageLocation, String> =
  let here = Traversal.getCurrentModulePath(currentLocation)
  let first =
    Stdlib.String.split(location, ".")
    |> Stdlib.List.head
    |> Stdlib.Option.withDefault("")

  let isHere =
    Traversal.applyPath(
      branchId,
      PackageLocation.Module(here),
      [ Traversal.PathSegment.Into(first) ])
    |> Stdlib.Result.isOk

  if
    Stdlib.List.isEmpty(here)
    || Stdlib.String.startsWith(location, "/")
    || isHere
    || Stdlib.Bool.not(Traversal.isOwner(branchId, first))
  then
    parseRelativeTo(currentLocation, location)
  else if first == "Stdlib" then
    parseRelativeTo(currentLocation, "/Darklang." + location)
  else
    parseRelativeTo(currentLocation, "/" + location)
