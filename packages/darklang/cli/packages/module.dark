module Darklang.Cli.Packages.ModuleCommand

let collectDecls(
  modules: List<String>,
  decls: List<LanguageTools.WrittenTypes.ModuleDeclaration.Declaration>)
  : List<(List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)> =
  decls
  |> Stdlib.List.map(fun decl ->
    match decl with
    | SubModule(modul) ->
      let nestedModules = Stdlib.List.append(modules, Stdlib.Tuple2.second(modul.name))
      collectDecls(nestedModules, modul.declarations)
    | _ -> [ (modules, decl) ])
  |> Stdlib.List.flatten


let declarationName(
  decl: LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)
  : Option<String> =
  match decl with
  | Type(typ) -> Option.Some(typ.name.name)
  | Function(fn) -> Option.Some(fn.name.name)
  | Value(value) -> Option.Some(value.name.name)
  | Trait(t) -> Option.Some(t.name.name)
  // An impl's location is `<Type>.<Trait>` beneath the module it is written in
  | Impl(i) ->
    Option.Some(
      $"{LanguageTools.WrittenTypesToProgramTypes.ImplDeclaration.typeReferenceHeadName(i.forType)}.{i.trait_.typ.name}")
  | Test(test) -> Option.Some(test.name.name)
  | SubModule(modul) -> Option.Some(Stdlib.Tuple2.second(modul.name))
  | Expr(_) -> Option.None


/// Return every declaration path that occurs more than once in the input.
/// `collectDecls` has already flattened submodules, so the relative module path
/// plus declaration name uniquely identifies the eventual package location.
let duplicateDeclarationNames(
  declarations: List<(List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)>)
  : List<String> =
  let (_, duplicates) =
    declarations
    |> Stdlib.List.fold(([], []), fun((seen, duplicates), (modules, decl)) ->
      match declarationName(decl) with
      | None -> (seen, duplicates)
      | Some(name) ->
        let path = Stdlib.List.append(modules, name) |> Stdlib.String.join(".")
        if Stdlib.List.contains(seen, path) then
          (seen, Stdlib.List.prepend(duplicates, path))
        else
          (Stdlib.List.prepend(seen, path), duplicates))

  Stdlib.List.unique(duplicates)


/// Write the doc comments a save changed without moving any version, and say how many items that was.
///
/// Docs are not part of the content hash, so a doc-only edit stores nothing new: every item lands on
/// the hash it already had and the batch folds to nothing. It has to be said with an `UpdateDoc`, as
/// `dark fn` says it (`updateDocsThatChanged`). Per item, because a module is one batch and
/// `updateDocsThatChanged` reads every doc in the ops it is given: an item's words are compared with
/// that item's own declaration, never with another's.
let landDocEdits(branchId: Uuid, ops: List<LanguageTools.ProgramTypes.PackageOp>): Int64 =
  // The Add for the item a SetName binds: they carry the same placeholder hash before the save.
  let addFor(h: LanguageTools.ProgramTypes.Hash): Option<LanguageTools.ProgramTypes.PackageOp> =
    ops
    |> Stdlib.List.findFirst(fun op ->
      match op with
      | AddFn(f) -> f.hash == h
      | AddType(t) -> t.hash == h
      | AddValue(v) -> v.hash == h
      | AddTrait(t) -> t.hash == h
      | AddTraitImpl(i) -> i.hash == h
      | _ -> false)

  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | SetName(location, reference, _) ->
      match addFor(LanguageTools.ProgramTypes.Reference.hash(reference)) with
      | Some(add) ->
        match Rename.referenceAt(branchId, location) with
        | Some(bound) ->
          if
            updateDocsThatChanged(
              branchId,
              location,
              LanguageTools.ProgramTypes.Reference.kind(reference),
              LanguageTools.ProgramTypes.Reference.hash(bound),
              [ add ])
          then
            Option.Some(location.name)
          else
            Option.None
        | None -> Option.None
      | None -> Option.None
    | _ -> Option.None)
  |> Stdlib.List.length


/// Who is saving a module.
type Caller =
  /// `dark module`.
  | Command
  /// `defineBundled`, for the dev build.
  | DevBuild


/// Save the declarations in <param source> under <param modulePath>, saying what happened, as
/// `module` does.
let define(state: AppState, modulePath: String, source: String, caller: Caller): AppState =
  let bundled = caller == Caller.DevBuild
  // Package input is declaration scope at its root. In particular, `val x`
  // declares a package value while `let x` is diagnosed directly instead of
  // being consumed as a script binding and failing later at EOF.
  match LanguageTools.Parser.Parse.packageToWrittenTypes(source) with
  | Error(diagnostics) ->
    let _ = Errors.reportParseErrors(diagnostics)
    // Nothing was saved: an agent's authoring loop branches on the exit.
    { state with exitCode = 1 }
  | Ok(SourceFile(sourceFile)) ->
    let declarations =
      let moduleDecls =
        sourceFile.declarations |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)

      collectDecls([], moduleDecls)

    let duplicateNames = duplicateDeclarationNames(declarations)
    if Stdlib.List.isEmpty(declarations) then
      printErr("Package source contains no declarations")
      { state with exitCode = 1 }
    else if Stdlib.Bool.not(Stdlib.List.isEmpty(duplicateNames)) then
      printErr("Package source contains duplicate declaration names:")
      duplicateNames |> Stdlib.List.iter(fun name -> printErr($"  - {name}"))
      { state with exitCode = 1 }
    else
      // Resolve a synthetic item path below the requested module so the
      // module path follows the same rules as `fn`, `type`, and `val`.
      let locationInput = modulePath + ".__module__"
      match Location.parseRelativeTo(state.packageData.currentLocation, locationInput) with
      | Error(message) ->
        printErr($"Invalid module location: {message}")
        failed(state)
      | Ok(baseLocation) ->
        let basePm = LanguageTools.PackageManager.pm()
        let branchId = state.currentBranchId
        let rootModule =
          LanguageTools.WrittenTypes.ModuleDeclaration.ModuleDeclaration
            { range = sourceFile.range
              name = (sourceFile.range, "__module__")
              declarations =
                sourceFile.declarations
                |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)
              keywordModule = sourceFile.range }

        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = basePm
              branchId = branchId
              owner = baseLocation.owner
              currentModule = baseLocation.modules }

        let (ops, unresolvedNames) = LanguageTools.Parser.Parse.moduleToPackageOps(ctx, rootModule)
        let updates = Propagate.updatedItems(branchId, ops)
        let home = Stdlib.List.prepend(baseLocation.modules, baseLocation.owner)
        let refused = Errors.reportUnresolvedNames(branchId, home, unresolvedNames)
        if bundled && Stdlib.Bool.not(Stdlib.List.isEmpty(unresolvedNames)) then
          failed(state)
        else if refused then
          failed(state)
        else
          // Stabilize and store the module as one mutually recursive batch.
          match SCM.PackageOps.addAuthored(branchId, ops) with
          | Error(message) ->
            printErr($"Failed to define module: {message}")
            { state with exitCode = 1 }
          | Ok(report) ->
            let followed =
              Propagate.repointSaved(
                branchId,
                updates,
                if bundled then Propagate.FollowerCheck.Skip else Propagate.FollowerCheck.Check)

            Propagate.printFollowed(followed)

            // A reload never leaves an edit's dependents behind, so the build fails over to one
            // when they could not follow.
            let state =
              if bundled && Stdlib.Option.isSome(followed.failure) then
                failed(state)
              else
                state

            let docsUpdated = landDocEdits(branchId, ops)

            // Counted from the ops that were recorded, not from the declarations
            // that were parsed, so the number is what happened rather than what
            // was asked for.
            let definedNames =
              ops
              |> Stdlib.List.filterMap(fun op ->
                match op with
                // Three fields, and a two-field pattern silently matches nothing rather than
                // failing to compile.
                | SetName(location, _, _) -> Option.Some(location.name)
                | _ -> Option.None)

            let count = Stdlib.List.length(definedNames)

            // "1 declarations" is the sort of thing you stop reading, and `edit`
            // routes through here for a single item, so the singular is a common
            // case rather than an edge one.
            let what = if count == 1 then "declaration" else "declarations"

            // `!` rather than a tick when the check did not pass, and the report AFTER this
            // line, both matching a single-item save in `core.dark`. A tick printed under the
            // reasons a save is broken is read as success by anybody who reads the last line.
            let glyph =
              match report.verdict with
              | Checked -> Stdlib.Cli.UI.Colors.success("✓")
              | Failed | Incomplete -> Stdlib.Cli.UI.Colors.warning("!")

            // A doc-only edit is otherwise indistinguishable from a save that changed nothing.
            let docNote =
              if docsUpdated == 0 then
                ""
              else if docsUpdated == 1 then
                "; updated 1 doc comment"
              else
                $"; updated {Stdlib.display(docsUpdated)} doc comments"

            Stdlib.printLine(
              $"{glyph} Defined {Stdlib.display(count)} {what} in {modulePath}{docNote}")

            // main's at-rest type check reports on every save; keep it ahead of propagation
            // so a type error is on screen before anything follows the change.
            AtRestCheck.printSaveReport(branchId, report)

            // Save the code so it can be fixed, and signal errors through the exit code.
            let state = if AtRestCheck.saveHasErrors(report) then failed(state) else state

            // Name what did not, so a rejected declaration is something you find out now rather than
            // the next time you call it.
            // `declarationName` returns an Option, so unwrap with filterMap before comparing:
            // `List.contains` against a list of Options silently never matches, which would report
            // every declaration as missing.
            // An impl's declaration name is `<Type>.<Trait>`; its SetName carries the
            // trait as the location's name, so compare on the last segment.
            let missing =
              declarations
              |> Stdlib.List.filterMap(fun d -> declarationName(Stdlib.Tuple2.second(d)))
              |> Stdlib.List.filter(fun n ->
                let leaf =
                  Stdlib.String.split(n, ".")
                  |> Stdlib.List.last
                  |> Stdlib.Option.withDefault(n)

                Stdlib.Bool.not(Stdlib.List.contains(definedNames, leaf)))

            if Stdlib.List.isEmpty(missing) then
              state
            else
              printErr($"""not defined: {Stdlib.String.join(missing, ", ")}""")
              Stdlib.printErrorLine(
                Stdlib.Cli.UI.Colors.hint(
                  "  the rest of the module was defined; fix these and run it again."))

              failed(state)


/// Who is staging: a person (or a command they ran), or a generator re-running because an
/// input it reads was edited. The ops are the same; the bindings are marked differently.
type StagedBy =
  | Author
  | Regeneration


/// Why a source text could not be staged. Parse errors keep their diagnostics so the
/// caller can print them the way every other authoring command does; everything else is
/// one line of prose.
type StageError =
  | ParseErrors(List<(LanguageTools.Parser.Range * String)>)
  | Message(String)


/// What staging did to one name.
type Outcome =
  /// Nothing was bound here before.
  | New
  /// The name was bound to different content.
  | Updated
  /// The name already held exactly this content.
  | Unchanged


/// What staging a source text did.
type Staged =
  { /// Every name the batch bound, as the ops recorded it (not as the source asked).
    definedNames: List<String>
    /// Declarations the source asked for that no op bound.
    missing: List<String>
    /// Per bound name, in source order, what happened to it. A generator re-run reads
    /// this to say `+`, `~` or `=` per output, and to know when there was nothing to do.
    outcomes: List<(String * Outcome)>
    report: LanguageTools.AtRestTypeChecker.Report }


/// What each `SetName` in <param ops> will do, read BEFORE the ops are stored, while the
/// live binding still says what was there. <param ops> must be stabilized.
let outcomesOf(
  branchId: Uuid,
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<(String * Outcome)> =
  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | SetName(location, target, _) ->
      let outcome =
        match LanguageTools.PackageManager.findAny(branchId, location) with
        | None -> Outcome.New
        | Some((hash, _)) ->
          if LanguageTools.ProgramTypes.hashToString(hash) == SCM.Draft.referenceHash(target) then
            Outcome.Unchanged
          else
            Outcome.Updated

      Option.Some((location.name, outcome))
    | _ -> Option.None)


/// <fn define> for a caller that wants what happened rather than printed lines: `generate`
/// stages what a generator emitted through here, so generated code is authored like typed
/// code. Unresolved names count as failure; nothing is stored when they are present.
let stageSource(
  branchId: Uuid,
  currentLocation: PackageLocation,
  modulePath: String,
  source: String,
  by: StagedBy)
  : Result<Staged, StageError> =
  match LanguageTools.Parser.Parse.packageToWrittenTypes(source) with
  | Error(diagnostics) -> Result.Error(StageError.ParseErrors(diagnostics))
  | Ok(SourceFile(sourceFile)) ->
    let moduleDecls =
      sourceFile.declarations |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)

    let declarations = collectDecls([], moduleDecls)
    let duplicateNames = duplicateDeclarationNames(declarations)
    if Stdlib.List.isEmpty(declarations) then
      Result.Error(StageError.Message("Package source contains no declarations"))
    else if Stdlib.Bool.not(Stdlib.List.isEmpty(duplicateNames)) then
      Result.Error(
        StageError.Message(
          "Package source contains duplicate declaration names: "
          + Stdlib.String.join(duplicateNames, ", ")))
    else
      match Location.parseRelativeTo(currentLocation, modulePath + ".__module__") with
      | Error(message) -> Result.Error(StageError.Message($"Invalid module location: {message}"))
      | Ok(baseLocation) ->
        let rootModule =
          LanguageTools.WrittenTypes.ModuleDeclaration.ModuleDeclaration
            { range = sourceFile.range
              name = (sourceFile.range, "__module__")
              declarations = moduleDecls
              keywordModule = sourceFile.range }

        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = LanguageTools.PackageManager.pm()
              branchId = branchId
              owner = baseLocation.owner
              currentModule = baseLocation.modules }

        let (ops, unresolvedNames) = LanguageTools.Parser.Parse.moduleToPackageOps(ctx, rootModule)
        let updates = Propagate.updatedItems(branchId, ops)
        let outcomes =
          outcomesOf(
            branchId,
            ops
            |> LanguageTools.PackageManager.resolveTraitCalls
            |> LanguageTools.PackageManager.stabilizeHashes)

        let home = Stdlib.List.prepend(baseLocation.modules, baseLocation.owner)
        if Errors.reportUnresolvedNames(branchId, home, unresolvedNames) then
          Result.Error(StageError.Message("unresolved names; nothing was defined"))
        else
          let stored =
            match by with
            | Author -> SCM.PackageOps.addAuthored(branchId, ops)
            | Regeneration -> SCM.PackageOps.addRegenerated(branchId, ops)

          match stored with
          | Error(message) ->
            Result.Error(StageError.Message($"Failed to define module: {message}"))
          | Ok(report) ->
            AtRestCheck.printSaveReport(branchId, report)

            // Only what moved propagates. A name re-bound to the content it already held (a
            // generator re-run that came out the same) has no dependents to repoint, and
            // skipping it is what lets a regeneration cascade settle.
            let unchangedNames =
              outcomes
              |> Stdlib.List.filterMap(fun((name, outcome)) ->
                match outcome with
                | Unchanged -> Option.Some(name)
                | _ -> Option.None)

            let moved =
              updates
              |> Stdlib.List.filter(fun update ->
                Stdlib.Bool.not(Stdlib.List.contains(unchangedNames, update.location.name)))

            let followed = Propagate.repointSaved(branchId, moved, Propagate.FollowerCheck.Check)
            Propagate.printFollowed(followed)
            let definedNames =
              ops
              |> Stdlib.List.filterMap(fun op ->
                match op with
                | SetName(location, _, _) -> Option.Some(location.name)
                | _ -> Option.None)

            let missing =
              declarations
              |> Stdlib.List.filterMap(fun d -> declarationName(Stdlib.Tuple2.second(d)))
              |> Stdlib.List.filter(fun n ->
                let leaf =
                  Stdlib.String.split(n, ".")
                  |> Stdlib.List.last
                  |> Stdlib.Option.withDefault(n)

                Stdlib.Bool.not(Stdlib.List.contains(definedNames, leaf)))

            Result.Ok(
              Staged
                { definedNames = definedNames
                  missing = missing
                  outcomes = outcomes
                  report = report })


let execute(state: AppState, args: List<String>): AppState =
  let input =
    match args with
    | [modulePath, "-"] ->
      Stdlib.Cli.Stdin.readAll() |> Stdlib.Result.map(fun source -> (modulePath, source))
    | [modulePath, sourcePath] ->
      match Stdlib.Cli.File.readText(sourcePath) with
      | Ok(source) -> Result.Ok((modulePath, source))
      | Error(err) -> Result.Error($"Could not read '{sourcePath}': {err.message}")
    | _ -> Result.Error("Usage: module <module> <source-file|->")

  match input with
  | Error(message) ->
    printErr(message)
    { state with exitCode = 1 }
  | Ok((modulePath, source)) -> define(state, modulePath, source, Caller.Command)


/// `module` for `LocalExec apply-package-edits`, which lands the dev build's edits to `packages/` on
/// main in place of a reload. An unresolved name fails it, leaving that to the reload. The dependents
/// that follow are not type-checked: for a core function that is most of the time, and a reload
/// doesn't check them either.
let defineBundled(modulePath: String, source: String): Int64 =
  let state =
    { Cli.initState() with nonInteractive = true, currentBranchId = SCM.Branch.mainBranchId }

  (define(state, modulePath, source, Caller.DevBuild)).exitCode


let help(_state: AppState): String =
  [ "Define a module from multiple package declarations atomically"
    ""
    "Usage: module <module> <source-file|->"
    ""
    "The source may contain functions, types, values, tests, and nested modules."
    "All declarations are validated, then saved as WIP in one batch; the at-rest"
    "type check is reported and `commit` refuses definite type errors."
    "Definite type errors and unresolved names exit 1; declarations remain saved"
    "as drafts. Other incomplete checks warn and exit 0."
    ""
    "Example:"
    "  dark module /Me.Example - <<'EOF'"
    "  val greeting = \"hello\""
    "  let double(n: Int64): Int64 = n * 2"
    "  let quadruple(n: Int64): Int64 = double(double(n))"
    "  test doubles = double(4) |> Stdlib.Test.equal(8)"
    "  EOF"
    "  dark eval 'Me.Example.quadruple(5)'" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
