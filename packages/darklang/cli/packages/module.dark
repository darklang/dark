module Darklang.Cli.Packages.ModuleCommand


type UpdatedItem =
  { location: LanguageTools.ProgramTypes.PackageLocation
    hash: LanguageTools.ProgramTypes.Hash
    kind: LanguageTools.ProgramTypes.ItemKind }


let sfDeclToModuleDecl
  (decl: LanguageTools.WrittenTypes.SourceFile.SourceFileDeclaration)
  : LanguageTools.WrittenTypes.ModuleDeclaration.Declaration =
  match decl with
  | Type typ -> LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Type typ
  | Function fn ->
    LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Function fn
  | Value value ->
    LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Value value
  | Module modul ->
    LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.SubModule modul


let collectDecls
  (modules: List<String>)
  (decls: List<LanguageTools.WrittenTypes.ModuleDeclaration.Declaration>)
  : List<List<String>
      * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration> =
  decls
  |> Stdlib.List.map (fun decl ->
    match decl with
    | SubModule modul ->
      let nestedModules =
        Stdlib.List.append modules [ Stdlib.Tuple2.second modul.name ]
      collectDecls nestedModules modul.declarations
    | _ -> [ (modules, decl) ])
  |> Stdlib.List.flatten


let declarationName
  (decl: LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)
  : Stdlib.Option.Option<String> =
  match decl with
  | Type typ -> Stdlib.Option.Option.Some typ.name.name
  | Function fn -> Stdlib.Option.Option.Some fn.name.name
  | Value value -> Stdlib.Option.Option.Some value.name.name
  | SubModule modul ->
    Stdlib.Option.Option.Some (Stdlib.Tuple2.second modul.name)
  | Expr _ -> Stdlib.Option.Option.None


/// Return every declaration path that occurs more than once in the input.
/// `collectDecls` has already flattened submodules, so the relative module path
/// plus declaration name uniquely identifies the eventual package location.
let duplicateDeclarationNames
  (declarations:
    List<List<String>
      * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration>)
  : List<String> =
  let (_, duplicates) =
    declarations
    |> Stdlib.List.fold ([], []) (fun (seen, duplicates) (modules, decl) ->
      match declarationName decl with
      | None -> (seen, duplicates)
      | Some name ->
        let path =
          Stdlib.List.append modules [name]
          |> Stdlib.String.join "."

        if Stdlib.List.member seen path then
          (seen, Stdlib.List.push duplicates path)
        else
          (Stdlib.List.push seen path, duplicates))

  Stdlib.List.unique duplicates


let updatedItem
  (branchId: Uuid)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (hash: LanguageTools.ProgramTypes.Hash)
  (kind: LanguageTools.ProgramTypes.ItemKind)
  : Stdlib.Option.Option<UpdatedItem> =
  let previous = Propagate.getAllPreviousHashes branchId location kind
  if Stdlib.List.isEmpty previous then
    Stdlib.Option.Option.None
  else
    Stdlib.Option.Option.Some
      (UpdatedItem { location = location; hash = hash; kind = kind })


/// Definitions that replace an existing location. Must run before storage, while
/// history still distinguishes creates from updates. Hashes are placeholders.
let updatedItems
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<UpdatedItem> =
  ops
  |> Stdlib.List.filterMap (fun op ->
    match op with
    | SetName(location, PackageType hash, _) ->
      updatedItem branchId location hash LanguageTools.ProgramTypes.ItemKind.Type
    | SetName(location, PackageValue hash, _) ->
      updatedItem branchId location hash LanguageTools.ProgramTypes.ItemKind.Value
    | SetName(location, PackageFn hash, _) ->
      updatedItem branchId location hash LanguageTools.ProgramTypes.ItemKind.Fn
    | _ -> Stdlib.Option.Option.None)


/// Why a source text could not be staged. Parse errors keep their diagnostics so the
/// caller can print them the way every other authoring command does; everything else is
/// one line of prose.
type StageError =
  | ParseErrors of List<(LanguageTools.Parser.Range * String)>
  | Message of String


/// What staging did to one name.
type Outcome =
  /// Nothing was bound here before.
  | New
  /// The name was bound to different content.
  | Updated
  /// The name already held exactly this content; no op was recorded.
  | Unchanged


/// What staging a source text did.
type Staged =
  { /// Every name the batch bound, as the ops recorded it (not as the source asked).
    definedNames: List<String>
    /// Declarations the source asked for that no op bound.
    missing: List<String>
    /// Per bound name, in source order, what happened to it. A generator re-run reads
    /// this to say `+`, `~` or `=` per output, and to know when there was nothing to do.
    outcomes: List<(String * Outcome)>
    report: LanguageTools.AtRestTypeChecker.Report }


/// What each `SetName` in <param ops> will do, read BEFORE the ops are stored, while the
/// live binding still says what was there.
let outcomesOf
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<(String * Outcome)> =
  ops
  |> Stdlib.List.filterMap (fun op ->
    match op with
    | SetName(location, target, _) ->
      let outcome =
        match LanguageTools.PackageManager.findAny branchId location with
        | None -> Outcome.New
        | Some found ->
          let (hash, _) = found
          if (LanguageTools.ProgramTypes.hashToString hash) == (SCM.Draft.referenceHash target) then
            Outcome.Unchanged
          else
            Outcome.Updated
      Stdlib.Option.Option.Some((location.name, outcome))
    | _ -> Stdlib.Option.Option.None)


/// Parse, lower, stabilize and store a module's source under <param modulePath>, as one
/// mutually recursive batch, and propagate. THE staging path for source text: `module` is
/// its front door, and `generate` stages what a generator emitted through the same fn, so
/// generated code is authored exactly like typed code.
///
/// Unresolved names are reported here (it is the one place that has the diagnostics) and
/// count as failure; nothing is stored when they are present.
/// Who is staging: a person (or a command they ran), or a generator re-running because an
/// input it reads was edited. The ops are the same; the bindings are marked differently.
type StagedBy =
  | Author
  | Regeneration


let stageSource
  (branchId: Uuid)
  (currentLocation: Packages.PackageLocation)
  (modulePath: String)
  (source: String)
  : Stdlib.Result.Result<Staged, StageError> =
  stageSourceAs StagedBy.Author branchId currentLocation modulePath source


let stageSourceAs
  (by: StagedBy)
  (branchId: Uuid)
  (currentLocation: Packages.PackageLocation)
  (modulePath: String)
  (source: String)
  : Stdlib.Result.Result<Staged, StageError> =
  // Package input is declaration scope at its root. In particular, `val x`
  // declares a package value while `let x` is diagnosed directly instead of
  // being consumed as a script binding and failing later at EOF.
  match Builtin.parserParsePackageToWrittenTypes source with
  | Error diagnostics -> Stdlib.Result.Result.Error(StageError.ParseErrors diagnostics)
  | Ok(SourceFile sourceFile) ->
    let declarations =
      let moduleDecls =
        sourceFile.declarations
        |> Stdlib.List.map sfDeclToModuleDecl
      collectDecls [] moduleDecls
    let duplicateNames = duplicateDeclarationNames declarations

    if Stdlib.List.isEmpty declarations then
      Stdlib.Result.Result.Error(StageError.Message "Package source contains no declarations")
    else if Stdlib.Bool.not (Stdlib.List.isEmpty duplicateNames) then
      Stdlib.Result.Result.Error(
        StageError.Message(
          "Package source contains duplicate declaration names: "
          ++ (Stdlib.String.join duplicateNames ", ")))
    else
      // Resolve a synthetic item path below the requested module so the
      // module path follows the same rules as `fn`, `type`, and `val`.
      let locationInput = modulePath ++ ".__module__"
      match Location.parseRelativeTo currentLocation locationInput with
      | Error message ->
        Stdlib.Result.Result.Error(StageError.Message $"Invalid module location: {message}")
      | Ok baseLocation ->
        let basePm = LanguageTools.PackageManager.pm ()
        let rootModule =
          LanguageTools.WrittenTypes.ModuleDeclaration.ModuleDeclaration
            { range = sourceFile.range
              name = (sourceFile.range, "__module__")
              declarations =
                sourceFile.declarations
                |> Stdlib.List.map sfDeclToModuleDecl
              keywordModule = sourceFile.range }
        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = basePm
              branchId = branchId
              owner = baseLocation.owner
              currentModule = baseLocation.modules }

        // The provisional ops use unique location hashes, allowing all
        // declarations to resolve each other without touching the DB.
        let (_, provisionalOps, _) =
          LanguageTools.WrittenTypesToProgramTypes.moduleDeclarationWithOpsHelper
            ctx
            rootModule
        let pm =
          LanguageTools.ProgramTypes.PackageManager.withExtraOps
            basePm
            provisionalOps
        let (_, ops, unresolvedNames) =
          LanguageTools.WrittenTypesToProgramTypes.moduleDeclarationWithOpsHelper
            { ctx with pm = pm }
            rootModule

        // Resolve the placeholders as one graph so mutually recursive
        // declarations receive consistent content-addressed hashes.
        let ops = LanguageTools.PackageManager.stabilizeHashes ops
        let updates = updatedItems branchId ops
        let outcomes = outcomesOf branchId ops

        if Errors.reportUnresolvedNames branchId unresolvedNames then
          Stdlib.Result.Result.Error(StageError.Message "unresolved names; nothing was defined")
        else
          // Stabilize and store the module as one mutually recursive batch.
          let stored =
            match by with
            | Author -> SCM.PackageOps.addAuthored branchId ops
            | Regeneration -> SCM.PackageOps.addRegenerated branchId ops
          match stored with
          | Error message ->
            Stdlib.Result.Result.Error(StageError.Message $"Failed to define module: {message}")
          | Ok report ->
            // main's at-rest type check reports on every save; keep it ahead of propagation
            // so a type error is on screen before anything follows the change.
            AtRestCheck.printSaveReport branchId report

            // Only what actually moved propagates. A name re-bound to the content it
            // already held (a generator re-run that came out the same) has no
            // dependents to repoint, and skipping it is what lets a regeneration
            // cascade settle rather than chase its own tail.
            let unchangedNames =
              outcomes
              |> Stdlib.List.filterMap (fun (name, outcome) ->
                match outcome with
                | Unchanged -> Stdlib.Option.Option.Some name
                | _ -> Stdlib.Option.Option.None)

            updates
            |> Stdlib.List.filter (fun update ->
              Stdlib.Bool.not (Stdlib.List.member unchangedNames update.location.name))
            |> Stdlib.List.iter (fun update ->
              Propagate.autoPropagateAfterUpdate
                branchId
                update.location
                update.hash
                update.kind)

            // Counted from the ops that were recorded, not from the declarations
            // that were parsed, so the number is what happened rather than what
            // was asked for.
            let definedNames =
              ops
              |> Stdlib.List.filterMap (fun op ->
                match op with
                // Three fields, and a two-field pattern silently matches nothing rather than
                // failing to compile.
                | SetName(location, _, _) -> Stdlib.Option.Option.Some location.name
                | _ -> Stdlib.Option.Option.None)

            // `declarationName` returns an Option, so unwrap with filterMap before comparing:
            // `List.member` against a list of Options silently never matches, which would report
            // every declaration as missing.
            let missing =
              declarations
              |> Stdlib.List.filterMap (fun d ->
                declarationName (Stdlib.Tuple2.second d))
              |> Stdlib.List.filter (fun n ->
                Stdlib.Bool.not (Stdlib.List.member definedNames n))

            Stdlib.Result.Result.Ok(
              Staged
                { definedNames = definedNames
                  missing = missing
                  outcomes = outcomes
                  report = report })


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  let input =
    match args with
    | [ modulePath, "-" ] ->
      Stdlib.Result.Result.Ok((modulePath, Stdlib.Cli.Stdin.readAll ()))
    | [ modulePath, sourcePath ] ->
      match Stdlib.Cli.File.readText sourcePath with
      | Ok source -> Stdlib.Result.Result.Ok((modulePath, source))
      | Error err ->
        Stdlib.Result.Result.Error
          $"Could not read '{sourcePath}': {err.message}"
    | _ ->
      Stdlib.Result.Result.Error
        "Usage: module <module> <source-file|->"

  match input with
  | Error message ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error message)
    { state with exitCode = 1 }
  | Ok((modulePath, source)) ->
    match
      stageSource
        state.currentBranchId
        state.packageData.currentLocation
        modulePath
        source
    with
    | Error(ParseErrors diagnostics) ->
      let _ = Errors.reportParseErrors diagnostics
      // Nothing was saved: an agent's authoring loop branches on the exit.
      { state with exitCode = 1 }
    | Error(Message message) ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error message)
      { state with exitCode = 1 }
    | Ok staged ->
      let count = Stdlib.List.length staged.definedNames

      // "1 declarations" is the sort of thing you stop reading, and `edit`
      // routes through here for a single item, so the singular is a common
      // case rather than an edge one.
      let what = if count == 1 then "declaration" else "declarations"

      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.success
          $"✓ Defined {Stdlib.Int.toString count} {what} in {modulePath}")

      // Name what did not, so a rejected declaration is something you find out now rather than
      // the next time you call it.
      if Stdlib.List.isEmpty staged.missing then
        ()
      else
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.error
            $"""not defined: {Stdlib.String.join staged.missing ", "}""")

        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.hint
            "  the rest of the module was defined; fix these and run it again.")

      state


let help (_state: Cli.AppState) : String =
  [ "Define a module from multiple package declarations atomically"
    ""
    "Usage: module <module> <source-file|->"
    ""
    "The source may contain functions, types, values, and nested modules."
    "All declarations are validated, then saved as WIP in one batch; the at-rest"
    "type check is reported and `commit` refuses definite type errors."
    ""
    "Example:"
    "  ./scripts/run-cli module /Darklang.Example - <<'EOF'"
    "  val greeting = \"hello\""
    "  let double (n: Int) : Int = n * 2"
    "  let quadruple (n: Int) : Int = double (double n)"
    "  EOF"
  ] |> Stdlib.String.join "\n"


let complete
  (_state: Cli.AppState)
  (_args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  []
