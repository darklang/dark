module Darklang.Cli.Packages.ModuleCommand

let collectDecls(
  modules: List<String>,
  decls: List<LanguageTools.WrittenTypes.ModuleDeclaration.Declaration>)
  : List<(List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)> =
  decls
  |> Stdlib.List.map(fun decl ->
    match decl with
    | SubModule(modul) ->
      let nestedModules = Stdlib.List.append(modules, Stdlib.Tuple2.second(modul.name))
      collectDecls(nestedModules, modul.declarations)
    | _ -> [ (modules, decl) ])
  |> Stdlib.List.flatten


let declarationName(
  decl: LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)
  : Option<String> =
  match decl with
  | Type(typ) -> Some(typ.name.name)
  | Function(fn) -> Some(fn.name.name)
  | Value(value) -> Some(value.name.name)
  | Trait(t) -> Some(t.name.name)
  // An impl's location is `<Type>.<Trait>` beneath the module it is written in
  | Impl(i) ->
    Some(
      $"{LanguageTools.WrittenTypesToProgramTypes.ImplDeclaration.typeReferenceHeadName(i.forType)}.{i.trait_.typ.name}")
  | Test(test) -> Some(test.name.name)
  | SubModule(modul) -> Some(Stdlib.Tuple2.second(modul.name))
  | Expr(_) -> None


/// Return every declaration path that occurs more than once in the input.
/// `collectDecls` has already flattened submodules, so the relative module path
/// plus declaration name uniquely identifies the eventual package location.
let duplicateDeclarationNames(
  declarations: List<(List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)>)
  : List<String> =
  let (_, duplicates) =
    declarations
    |> Stdlib.List.fold(([], []), fun((seen, duplicates), (modules, decl)) ->
      match declarationName(decl) with
      | None -> (seen, duplicates)
      | Some(name) ->
        let path = Stdlib.List.append(modules, name) |> Stdlib.String.join(".")
        if Stdlib.List.contains(seen, path) then
          (seen, Stdlib.List.prepend(duplicates, path))
        else
          (Stdlib.List.prepend(seen, path), duplicates))

  Stdlib.List.unique(duplicates)


/// Write the doc comments a save changed without moving any version, and say how many items that was.
///
/// Docs are not part of the content hash, so a doc-only edit stores nothing new: every item lands on
/// the hash it already had and the batch folds to nothing. It has to be said with an `UpdateDoc`, as
/// `dark fn` says it (`updateDocsThatChanged`). Per item, because a module is one batch and
/// `updateDocsThatChanged` reads every doc in the ops it is given: an item's words are compared with
/// that item's own declaration, never with another's.
let landDocEdits(branchId: Uuid, ops: List<LanguageTools.ProgramTypes.PackageOp>): Int64 =
  // The Add for the item a SetName binds: they carry the same placeholder hash before the save.
  let addFor(h: LanguageTools.ProgramTypes.Hash): Option<LanguageTools.ProgramTypes.PackageOp> =
    ops
    |> Stdlib.List.findFirst(fun op ->
      match op with
      | AddFn(f) -> f.hash == h
      | AddType(t) -> t.hash == h
      | AddValue(v) -> v.hash == h
      | AddTrait(t) -> t.hash == h
      | AddTraitImpl(i) -> i.hash == h
      | _ -> false)

  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | SetName(location, reference, _) ->
      match addFor(LanguageTools.ProgramTypes.Reference.hash(reference)) with
      | Some(add) ->
        match Rename.referenceAt(branchId, location) with
        | Some(bound) ->
          if
            updateDocsThatChanged(
              branchId,
              location,
              LanguageTools.ProgramTypes.Reference.kind(reference),
              LanguageTools.ProgramTypes.Reference.hash(bound),
              [ add ])
          then
            Some(location.name)
          else
            None
        | None -> None
      | None -> None
    | _ -> None)
  |> Stdlib.List.length


/// Save rules for module input.
type SaveMode =
  /// `dark import` can save the declarations that passed parsing, and refuses a script.
  | Import
  /// `dark import --skip-expressions`, which leaves a script's expressions out.
  | ImportSkippingExpressions
  /// `dark edit`, which saves one declaration through its module.
  | Edit
  /// `defineBundled`, for the dev build.
  | DevBuild


/// What is in the module at <param home> (owner first) that this save did not define, as (kind,
/// name): names an earlier save left behind, which still run, get type-checked and can block a
/// commit.
let leftOver(branchId: Uuid, home: List<String>, defined: List<String>): List<(String * String)> =
  let (_, types, values, fns, traits, _, tests) =
    Query.allDirectDescendantNamesAndHashes(branchId, home)

  let sets = Query.loadDeprecationSets(branchId)
  [ ("type", types), ("value", values), ("fn", fns), ("trait", traits), ("test", tests) ]
  |> Stdlib.List.map(fun((kind, items)) ->
    Query.filterHiddenPairs(home, items, sets, Query.Deprecated.Hide, Query.Internal.Show)
    |> Stdlib.List.map(fun((name, _)) -> (kind, name)))
  |> Stdlib.List.flatten
  |> Stdlib.List.filter(fun((_, name)) -> Stdlib.Bool.not(Stdlib.List.contains(defined, name)))
  |> Stdlib.List.unique


/// The declarations in <param source> that a partial save dropped, by name: what a full parse
/// recovers that <param kept> does not have.
let unparsedNames(
  source: String,
  kept: List<(List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration)>)
  : List<String> =
  let path = fun((modules, decl)) ->
    declarationName(decl) |> Stdlib.Option.map(fun name -> Stdlib.List.append(modules, name))

  let keptPaths = Stdlib.List.filterMap(kept, path)
  match LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, source) with
  | Some(SourceFile(sourceFile)), _ ->
    sourceFile.declarations
    |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)
    |> (fun decls -> collectDecls([], decls))
    |> Stdlib.List.filterMap(fun((modules, decl)) ->
      let usable =
        match decl with
        | Type(_) -> true
        | Function(_) -> true
        | Value(_) -> true
        | _ -> false

      match path((modules, decl)) with
      | Some(p) when usable && Stdlib.Bool.not(Stdlib.List.contains(keptPaths, p)) ->
        Stdlib.List.last(p)
      | _ -> None)
  | _ -> []


/// Where the expressions a script runs are, when <param source> is a script.
let scriptExpressions(source: String): List<LanguageTools.Parser.Range> =
  match LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Script, source) with
  | Some(SourceFile(file)), [] ->
    file.exprsToEval |> Stdlib.List.map(LanguageTools.WrittenTypes.Expr.range)
  | _ -> []


/// Name each expression an import left out of <param source>, and how to run `main`.
let printLeftOut(
  source: String,
  leftOut: List<LanguageTools.Parser.Range>,
  home: String,
  definedNames: List<String>)
  : Unit =
  let lines = Stdlib.String.split(source, "\n")
  leftOut
  |> Stdlib.List.iter(fun range ->
    let text =
      Stdlib.List.getAt(lines, range.start.row)
      |> Stdlib.Option.withDefault("")
      |> Stdlib.String.dropFirst(range.start.column)
      |> Stdlib.String.trim

    let line = Stdlib.display(range.start.row + 1)
    printHint(
      $"  left out line {line}, `{Text.oneLineAt(60, text)}`: a module holds declarations, not expressions"))

  if
    Stdlib.Bool.not(Stdlib.List.isEmpty(leftOut)) && Stdlib.List.contains(definedNames, "main")
  then
    printHint($"  run it with `dark run {home}.main`")
  else
    ()


let save(state: AppState, modulePath: String, source: String, mode: SaveMode): AppState =
  let bundled = mode == SaveMode.DevBuild
  let moduleCommand = mode == SaveMode.Import || mode == SaveMode.ImportSkippingExpressions
  let kind =
    if moduleCommand then
      LanguageTools.Parser.FileKind.PackagePartialSave
    else
      LanguageTools.Parser.FileKind.Package

  let (parsed, diagnostics) = LanguageTools.Parser.Parse.parse(kind, source)
  let scriptLines =
    if moduleCommand then
      scriptExpressions(source)
      |> Stdlib.List.filter(fun range -> Stdlib.List.any(diagnostics, fun((r, _)) -> r == range))
    else
      []

  let leftOut = if mode == SaveMode.ImportSkippingExpressions then scriptLines else []
  let diagnostics =
    diagnostics
    |> Stdlib.List.filter(fun((range, _)) -> Stdlib.Bool.not(Stdlib.List.contains(leftOut, range)))

  let parseFailed = Errors.reportParseErrors(diagnostics)
  let refusedScript = mode == SaveMode.Import && Stdlib.Bool.not(Stdlib.List.isEmpty(scriptLines))
  if refusedScript then
    printHint("  `--skip-expressions` saves the declarations and leaves the expressions out")
  else
    ()

  let state = if parseFailed then failed(state) else state
  let saves = Stdlib.Bool.not(refusedScript) && (moduleCommand || Stdlib.Bool.not(parseFailed))
  match parsed with
  | Some(SourceFile(sourceFile)) when saves ->
    let declarations =
      let moduleDecls =
        sourceFile.declarations |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)

      collectDecls([], moduleDecls)

    let duplicateNames = duplicateDeclarationNames(declarations)
    if Stdlib.List.isEmpty(declarations) then
      if parseFailed then
        printErr("Nothing was saved. No declarations could be recovered.")
      else
        printErr("Package source contains no declarations")

      { state with exitCode = 1 }
    else if Stdlib.Bool.not(Stdlib.List.isEmpty(duplicateNames)) then
      printErr("Package source contains duplicate declaration names:")
      duplicateNames |> Stdlib.List.iter(fun name -> printErr($"  - {name}"))
      { state with exitCode = 1 }
    else
      // Resolve a synthetic item path below the requested module so the
      // module path follows the same rules as `fn`, `type`, and `val`.
      let locationInput = modulePath + ".__module__"
      match Location.parseFrom(
              state.currentBranchId,
              state.packageData.currentLocation,
              locationInput) with
      | Error(message) ->
        printErr($"Invalid module location: {message}")
        failed(state)
      | Ok(baseLocation) ->
        let basePm = LanguageTools.PackageManager.pm()
        let branchId = state.currentBranchId
        let rootModule =
          LanguageTools.WrittenTypes.ModuleDeclaration.ModuleDeclaration
            { range = sourceFile.range
              name = (sourceFile.range, "__module__")
              declarations =
                sourceFile.declarations
                |> Stdlib.List.map(LanguageTools.Parser.Parse.toModuleDeclaration)
              keywordModule = sourceFile.range }

        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = basePm
              branchId = branchId
              owner = baseLocation.owner
              currentModule = baseLocation.modules }

        let (ops, unresolvedNames) = LanguageTools.Parser.Parse.moduleToPackageOps(ctx, rootModule)
        let updates = Propagate.updatedItems(branchId, ops)
        let home = Stdlib.List.prepend(baseLocation.modules, baseLocation.owner)
        let refused = Errors.reportUnresolvedNames(branchId, home, unresolvedNames)
        if bundled && Stdlib.Bool.not(Stdlib.List.isEmpty(unresolvedNames)) then
          failed(state)
        else if refused then
          failed(state)
        else
          let previouslyDeprecated =
            if bundled then
              []
            else
              updates
              |> Stdlib.List.filterMap(fun item ->
                deprecatedHashBeforeSave(branchId, item.location, item.kind)
                |> Stdlib.Option.map(fun hash -> (item.location, item.kind, hash)))

          // Stabilize and store the module as one mutually recursive batch.
          match SCM.PackageOps.addAuthored(branchId, ops) with
          | Error(message) ->
            printErr($"Not saved: {message}")
            { state with exitCode = 1 }
          | Ok(authored) ->
            let report = authored.report
            let followed =
              Propagate.repointSaved(
                branchId,
                updates,
                if bundled then Propagate.FollowerCheck.Skip else Propagate.FollowerCheck.Check)

            // A reload never leaves an edit's dependents behind, so the build fails over to one
            // when they could not follow.
            let state =
              if bundled && Stdlib.Option.isSome(followed.failure) then
                failed(state)
              else
                state

            let docsUpdated = landDocEdits(branchId, ops)
            let deprecationNotes =
              previouslyDeprecated
              |> Stdlib.List.filterMap(fun((location, kind, hash)) ->
                deprecationSaveNote(branchId, location, kind, hash))

            let unchangedDeprecated =
              deprecationNotes
              |> Stdlib.List.filter(Stdlib.Tuple2.first)
              |> Stdlib.List.length

            // Keep every submitted binding for the missing-declaration and leftover checks.
            let definedNames =
              ops
              |> Stdlib.List.filterMap(fun op ->
                match op with
                // Three fields, and a two-field pattern silently matches nothing rather than
                // failing to compile.
                | SetName(location, _, _) -> Some(location.name)
                | _ -> None)

            let count = Stdlib.List.length(definedNames) - unchangedDeprecated

            // "1 declarations" is the sort of thing you stop reading, and `edit`
            // routes through here for a single item, so the singular is a common
            // case rather than an edge one.
            let what = if count == 1 then "declaration" else "declarations"

            // `!` rather than a tick when the check did not pass, and the report AFTER this
            // line, both matching a single-item save in `core.dark`. A tick printed under the
            // reasons a save is broken is read as success by anybody who reads the last line.
            let glyph =
              if parseFailed || Stdlib.Bool.not(Stdlib.List.isEmpty(followed.broken)) then
                Stdlib.Cli.UI.Colors.warning("!")
              else
                match report.verdict with
                | Checked -> Stdlib.Cli.UI.Colors.success("✓")
                | Failed | Incomplete -> Stdlib.Cli.UI.Colors.warning("!")

            let docNote =
              if docsUpdated == 0 then
                ""
              else
                let comments = Text.plural(docsUpdated, "doc comment")
                $"Updated {comments}."

            let updatedName =
              match mode, definedNames, updates with
              | Edit, [_], [item] ->
                let loc = item.location
                let parts = Stdlib.List.prepend(loc.modules, loc.owner)
                Some(Stdlib.String.join(Stdlib.List.append(parts, loc.name), "."))
              | _ -> None

            if count > 0 || unchangedDeprecated == 0 then
              let summary =
                match updatedName with
                | Some(name) -> $"{glyph} Updated {name}"
                | None -> $"{glyph} Defined {count} {what} in {modulePath}"

              Stdlib.printLine(if docNote == "" then summary else $"{summary}. {docNote}")
            else if docNote != "" then
              Stdlib.printLine($"{glyph} {docNote}")

            deprecationNotes |> Stdlib.List.iter(fun((_, message)) -> Stdlib.printLine(message))
            let savedFns =
              if bundled then
                []
              else
                ops
                |> Stdlib.List.filterMap(fun op ->
                  match op with
                  | SetName(location, PackageFn(_), _) ->
                    let previous =
                      updates
                      |> Stdlib.List.findFirst(fun u -> u.location == location)
                      |> Stdlib.Option.andThen(fun u -> Stdlib.List.head(u.previous))

                    match LanguageTools.PackageManager.Function.find(branchId, location) with
                    | Some(now) when previous != Some(now) -> Some((location, previous, now))
                    | _ -> None
                  | _ -> None)

            savedFns
            |> Stdlib.List.iter(fun((location, previous, now)) ->
              let summary =
                Effects.saveSummary(
                  previous |> Stdlib.Option.map(LanguageTools.ProgramTypes.hashToString),
                  LanguageTools.ProgramTypes.hashToString(now))

              match updatedName, savedFns with
              | Some(_), [_] -> Stdlib.printLine($"  effects: {summary}")
              | _ ->
                // named below the module just saved, which the line above names
                let below =
                  Stdlib.List.drop(
                    Stdlib.List.prepend(location.modules, location.owner),
                    Stdlib.List.length(home))

                let name = Stdlib.String.join(Stdlib.List.append(below, location.name), ".")
                Stdlib.printLine($"  effects of {name}: {summary}"))

            if parseFailed then
              printHint("  Fix and resend only the declarations that failed to parse.")
              printHint("  Use `import` for one or more declarations or `fn` for a function.")
              printHint("  Use `edit` only if the item already had a saved version.")
            else
              ()

            printLeftOut(source, leftOut, Stdlib.String.join(home, "."), definedNames)
            AtRestCheck.printUnresolvedTraitCalls(authored.unresolvedTraitCalls, 0u64)

            // main's at-rest type check reports on every save; keep it ahead of propagation
            // so a type error is on screen before anything follows the change.
            let unparsed = if parseFailed then unparsedNames(source, declarations) else []
            AtRestCheck.printSaveReport(branchId, report, unparsed)
            match updatedName, report.verdict with
            | Some(_), Checked -> Propagate.printEditPropagation(followed)
            | _ -> Propagate.printFollowed(followed)

            // Save the code so it can be fixed, and signal errors through the exit code.
            let state = if AtRestCheck.saveHasErrors(report) then failed(state) else state

            // Name what did not, so a rejected declaration is something you find out now rather than
            // the next time you call it.
            // `declarationName` returns an Option, so unwrap with filterMap before comparing:
            // `List.contains` against a list of Options silently never matches, which would report
            // every declaration as missing.
            // An impl's declaration name is `<Type>.<Trait>`; its SetName carries the
            // trait as the location's name, so compare on the last segment.
            let missing =
              declarations
              |> Stdlib.List.filterMap(fun d -> declarationName(Stdlib.Tuple2.second(d)))
              |> Stdlib.List.filter(fun n ->
                let leaf =
                  Stdlib.String.split(n, ".")
                  |> Stdlib.List.last
                  |> Stdlib.Option.withDefault(n)

                Stdlib.Bool.not(Stdlib.List.contains(definedNames, leaf)))

            let shown = Stdlib.String.join(home, ".")
            let left =
              if moduleCommand && Stdlib.Bool.not(parseFailed) then
                leftOver(branchId, home, definedNames)
              else
                []

            match left with
            | [] -> ()
            | [(kind, name), ...] ->
              let names =
                left
                |> Stdlib.List.map(fun((_, n)) -> n)
                |> Stdlib.String.join(", ")

              Stdlib.printErrorLine(
                Stdlib.Cli.UI.Colors.hint(
                  $"  still in {shown} from an earlier save: {names}\n"
                  + $"  `delete {kind} {shown}.{name} --yes` takes one out"))

            if Stdlib.List.isEmpty(missing) then
              state
            else
              printErr($"""not defined: {Stdlib.String.join(missing, ", ")}""")
              Stdlib.printErrorLine(
                Stdlib.Cli.UI.Colors.hint(
                  "  the rest of the module was defined; fix these and run it again."))

              failed(state)
  | _ ->
    if moduleCommand then printErr("Nothing was saved.") else ()
    failed(state)


let readAndSave(state: AppState, modulePath: String, sourcePath: String, mode: SaveMode): AppState =
  let input =
    if sourcePath == "-" then
      Stdlib.Cli.Stdin.readAll()
    else
      Stdlib.Cli.File.readText(sourcePath)
      |> Stdlib.Result.mapError(fun err -> $"Could not read '{sourcePath}': {Stdlib.display(err)}")

  match input with
  | Error(message) ->
    printErr(message)
    failed(state)
  | Ok(source) -> save(state, modulePath, source, mode)


/// Save replacement source for an edit.
let saveEdit(state: AppState, modulePath: String, source: String): AppState =
  save(state, modulePath, source, SaveMode.Edit)


/// Read replacement source from a file or stdin and save it as an edit.
let readAndSaveEdit(state: AppState, modulePath: String, sourcePath: String): AppState =
  readAndSave(state, modulePath, sourcePath, SaveMode.Edit)


/// `import` for `LocalExec apply-package-edits`, which lands the dev build's edits to `packages/` on
/// main in place of a reload. An unresolved name fails it, leaving that to the reload. The dependents
/// that follow are not type-checked: for a core function that is most of the time, and a reload
/// doesn't check them either.
let defineBundled(modulePath: String, source: String): Int64 =
  let state =
    { Cli.initState() with nonInteractive = true, currentBranchId = SCM.Branch.mainBranchId }

  (save(state, modulePath, source, SaveMode.DevBuild)).exitCode
