/// Navigate between packages, modules, and entities
module Darklang.Cli.Packages.Nav

let navTo(state: AppState, location: PackageLocation): AppState =
  // if the intended state is the same as the current state (cd .), then short-circuit
  if location == state.packageData.currentLocation then
    state
  else
    let newHistory = Stdlib.List.append(state.packageData.locationHistory, state.packageData.currentLocation)

    { state with
        packageData =
          { state.packageData with
              currentLocation = location
              locationHistory = newHistory }
    }


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [pathArg] ->
    let branchId = state.currentBranchId
    match Traversal.traverse(branchId, state.packageData.currentLocation, pathArg) with
    | Error errorMsg ->
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Navigation to {pathArg} failed: {errorMsg}"))
      Cli.exitWith(state, false)
    | Ok newLocation ->
      let locationStr = Packages.formatLocation(newLocation)
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Changed to: {locationStr}"))

      // Where you are lives for the length of this one command, and nothing after it sees the move.
      // Said out loud, because "Changed to:" on its own reads like it stuck, and the next `dark ls`
      // disagreeing with it is a confusing way to find out.
      if state.nonInteractive then
        Cli.printHint(
          "  (only for this command -- a location doesn't carry between `dark` invocations. `dark ls <path>` reads elsewhere; `dark` with no arguments opens the workbench to browse.)")
      else
        ()

      navTo(state, newLocation)
  | _ ->
    Stdlib.printLine(help(state))
    state


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let branchId = state.currentBranchId
  match args with
  | [] ->
    // No args - complete from current location
    Traversal.completePartialPath(branchId, state.packageData.currentLocation, "")
  | [partialPath] ->
    Traversal.completePartialPath(branchId, state.packageData.currentLocation, partialPath)
  | _ ->
    // Too many arguments
    []


let help(_state: AppState): String =
  [
    "Usage: nav <path>"
    "Navigate package space - modules, types, values, functions, and tests."
    ""
    "Navigates directly to the specified location. To browse, run `dark` with no arguments."
    ""
    "Examples:"
    "  nav /                - Go to root"
    "  nav /Darklang/Stdlib - Go to absolute path from root"
    "  nav ..               - Go to parent"
    "  nav ../..            - Go to grandparent"
    "  nav Submodule        - Go to a submodule of current location"
    "  nav Stdlib/List      - Go to Stdlib.List module"
    "  nav equals           - Go to equals function"
    "  nav Option           - Go to Option type"
  ] |> Stdlib.String.join("\n")
