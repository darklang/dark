module Darklang.Cli.Packages.Rename

// A rename changes bindings and the current branch's reference names atomically.
// Reference names are metadata; content hashes remain unchanged.

/// Prepare one atomic rename, including its current callers' reference names.
let ops(
  branchId: Uuid,
  oldLocation: LanguageTools.ProgramTypes.PackageLocation,
  newLocation: LanguageTools.ProgramTypes.PackageLocation,
  reference: LanguageTools.ProgramTypes.Reference)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  SCM.PackageOps.prepareRename(branchId, oldLocation, newLocation, reference)


/// What lives at <param location> right now, as the reference a rename rebinds. `None` when the
/// name holds nothing here -- a typo, or a name that only exists on another branch.
let referenceAt(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.Reference> =
  let modulePath = Stdlib.List.prepend(location.modules, location.owner)
  let results = Packages.Query.searchExactMatch(branchId, modulePath, location.name)

  match results.fns with
  | [i, ...] ->
    Stdlib.Option.Option.Some(
      LanguageTools.ProgramTypes.Reference.PackageFn(i.entity.hash)
    )
  | [] ->
    match results.types with
    | [i, ...] ->
      Stdlib.Option.Option.Some(
        LanguageTools.ProgramTypes.Reference.PackageType(i.entity.hash)
      )
    | [] ->
      match results.values with
      | [i, ...] ->
        Stdlib.Option.Option.Some(
          LanguageTools.ProgramTypes.Reference.PackageValue(i.entity.hash)
        )
      | [] ->
        match results.traits with
        | [i, ...] ->
          Stdlib.Option.Option.Some(
            LanguageTools.ProgramTypes.Reference.PackageTrait(i.entity.hash)
          )
        | [] ->
          match results.impls with
          | [i, ...] ->
            Stdlib.Option.Option.Some(
              LanguageTools.ProgramTypes.Reference.PackageTraitImpl(i.entity.hash)
            )
          | [] ->
            match results.tests with
            | [i, ...] ->
              Stdlib.Option.Option.Some(
                LanguageTools.ProgramTypes.Reference.PackageTest(i.entity.hash)
              )
            | [] -> Stdlib.Option.Option.None


let execute(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | [ oldName, newName ] ->
    let here = state.packageData.currentLocation

    match
      (Packages.Location.parseRelativeTo(here, oldName),
       Packages.Location.parseRelativeTo(here, newName))
    with
    | (Error(e), _) ->
      Cli.printErr($"the name to rename: {e}")
      { state with exitCode = 1 }
    | (_, Error(e)) ->
      Cli.printErr($"the new name: {e}")
      { state with exitCode = 1 }
    | (Ok(oldLoc), Ok(newLoc)) ->
      let dotted(l: LanguageTools.ProgramTypes.PackageLocation): String =
        PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(l)

      if (dotted(oldLoc)) == (dotted(newLoc)) then
        Cli.printOk($"{dotted(oldLoc)} already has that name -- nothing to do.")
        state
      else
        match referenceAt(state.currentBranchId, oldLoc) with
        | None ->
          Cli.printErr($"nothing here is named {dotted(oldLoc)}.")
          Cli.printHint("  `dark ls` lists what is; `dark search <text>` looks wider.")
          { state with exitCode = 1 }
        | Some(reference) ->
          // Refused rather than silently rebound: one name holds one item, so binding over a live
          // name would take the other item off the shelf as a side effect of renaming this one.
          match referenceAt(state.currentBranchId, newLoc) with
          | Some(_) ->
            Cli.printErr($"{dotted(newLoc)} already names something.")
            Cli.printHint("  pick another name, or retire that one first (`dark delete`).")
            { state with exitCode = 1 }
          | None ->
            let changes = ops(state.currentBranchId, oldLoc, newLoc, reference)
            match SCM.PackageOps.add(state.currentBranchId, changes) with
            | Ok(_) ->
              Cli.printOk($"renamed {dotted(oldLoc)} -> {dotted(newLoc)}.")

              Cli.printHint(
                "  callers now use the new name; content hashes are unchanged. `dark status` shows the change.")

              state
            | Error(e) ->
              Cli.printErr($"couldn't rename: {e}")
              { state with exitCode = 1 }

  | _ ->
    Cli.printErr("usage: dark rename <name> <new-name>")
    Cli.printHint("  both names are relative to where you are (`dark nav` moves).")
    { state with exitCode = 1 }


let help(_state: Cli.AppState): String =
  [ ""
    "  dark rename <name> <new-name>"
    ""
    "  The item and its callers keep their content hashes. References on this"
    "  branch use the new name, and subsequent edits keep reaching those callers."
    ""
    "  The old binding ends, the new binding starts, and reference names update"
    "  together. `dark status` shows the change."
    ""
    "  Refused when the new name already holds something: one name holds one"
    "  item, so that would take the other one off the shelf." ]
  |> Stdlib.String.join("\n")


let complete(
  state: Cli.AppState,
  args: List<String>)
  : List<Completion.CompletionItem> =
  match args with
  | [] -> Packages.Nav.complete(state, args)
  | [ _ ] -> Packages.Nav.complete(state, args)
  | _ -> []
