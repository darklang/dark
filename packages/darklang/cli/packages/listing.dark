// LS command - list contents
// CLEANUP could the impl here just be a `... --depth=1 --plain` call of 'tree'?
module Darklang.Cli.Packages.Listing

/// Every version this name has been bound to, oldest first: main's history, continuing into the
/// branch's own edits. Only interesting when there is more than one, which is why the caller only
/// prints it then.
let versionsOf(
  modulePath: List<String>,
  name: String)
  : List<String> =
  match modulePath with
  | [] -> []
  | [owner, ...modules] ->
    SCM.Propagation.authoringOrder((
      LanguageTools.ProgramTypes.PackageLocation
        { owner = owner, modules = modules, name = name }))


/// Print the `--versions` rows under one name: each version's short hash, oldest first, the
/// live one tagged. Nothing is printed for a single-version name. What `--versions` is for is
/// explained once, in `help`.
let printVersionLines(
  modulePath: List<String>,
  name: String,
  hash: LanguageTools.ProgramTypes.Hash)
  : Unit =
  let live = LanguageTools.ProgramTypes.hashToString(hash)

  match versionsOf(modulePath, name) with
  | [] -> ()
  | [ _single ] -> ()
  | versions ->
    versions
    |> Stdlib.List.iter(fun v ->
      let tag = if v == live then "  (live)" else ""

      Stdlib.printLine(
        (Stdlib.Cli.UI.Colors.dimText(
          $"      {Stdlib.String.slice(v, 0, 8)}{tag}"))))


let listModule(
  branchId: Uuid,
  location: PackageLocation,
  deprecated: Query.Deprecated,
  internal: Query.Internal,
  showVersions: Bool)
  : Unit =
  let modulePath = modulePathOf(location)

  // Names and hashes only: a listing shows a name and a deprecation mark, and materializing each item's
  // full definition to read those was most of the command's cost once startup got cheap.
  let (allSubmodules, rawTypes, rawValues, rawFns, rawTraits, rawImpls, rawTests) =
    Query.allDirectDescendantNamesAndHashes(branchId, modulePath)
  let depSets = Query.loadDeprecationSets(branchId)
  let types = Query.filterHiddenPairs(modulePath, rawTypes, depSets, deprecated, internal)
  let values = Query.filterHiddenPairs(modulePath, rawValues, depSets, deprecated, internal)
  let fns = Query.filterHiddenPairs(modulePath, rawFns, depSets, deprecated, internal)
  let traits = Query.filterHiddenPairs(modulePath, rawTraits, depSets, deprecated, internal)
  let impls = Query.filterHiddenPairs(modulePath, rawImpls, depSets, deprecated, internal)
  let tests = Query.filterHiddenPairs(modulePath, rawTests, depSets, deprecated, internal)

  let locationStr = Packages.formatLocation(location)
  Stdlib.printLine($"Contents of {locationStr}:")
  Stdlib.printLine("")

  // An implementation is named `<module>.<Type>.<Trait>`, so the ones written in THIS module are
  // stored one level down, under the type they are for. A listing of the module shows them anyway:
  // you wrote `impl Show for Pt` in `Acme`, so `ls Acme` is where you look for it. They also show
  // in `ls Acme.Pt`, which is deliberate -- the type's module is a sub-listing of this one and
  // seeing an implementation in both is what a reader expects. Do not "fix" the duplicate.
  //
  // Only a type that is ALSO a submodule here can have implementations under it: one at
  // `M.T.Trait` makes `M.T` a module, and the submodule names are already in hand from the one
  // call above. `Darklang.Stdlib` declares no types at all, so its listing pays nothing. The types
  // that do qualify share ONE search for the implementations below this module, rather than a
  // listing each.
  let implTypes =
    types
    |> Stdlib.List.map(fun((typeName, _hash)) -> typeName)
    |> Stdlib.List.filter(fun typeName -> Stdlib.List.contains(allSubmodules, typeName))

  let implsBelow =
    if Stdlib.List.isEmpty(implTypes) then
      []
    else
      Query.implsBelow(branchId, modulePath)

  let implsUnder(
    typeName: String)
    : List<(String * String * LanguageTools.ProgramTypes.Hash * List<String>)> =
    let childPath = Stdlib.List.append(modulePath, typeName)

    let childImpls =
      implsBelow
      |> Stdlib.List.filter(fun item ->
        Stdlib.List.prepend(item.location.modules, item.location.owner) == childPath)
      |> Stdlib.List.map(fun item -> (item.location.name, item.entity.hash))

    Query.filterHiddenPairs(childPath, childImpls, depSets, deprecated, internal)
    |> Stdlib.List.map(fun((traitName, hash)) -> (traitName, typeName, hash, childPath))

  // The type an implementation stored HERE is for is the module we are standing in: at
  // `Stdlib.Int64` the entries are `Add for Int64`.
  let selfType =
    modulePath |> Stdlib.List.last |> Stdlib.Option.withDefault("")

  // The fourth field is the module the implementation actually lives in, which `--versions` needs:
  // for one stored here that is this module, and for one under a type it is that type's.
  let ownImplEntries =
    impls
    |> Stdlib.List.map(fun((traitName, hash)) -> (traitName, selfType, hash, modulePath))

  let childImplEntries =
    implTypes |> Stdlib.List.map(implsUnder) |> Stdlib.List.flatten

  let implEntries =
    Stdlib.List.concat(ownImplEntries, childImplEntries)
    |> Stdlib.List.sortBy(fun entry ->
      let (traitName, typeName, _hash, _path) = entry
      typeName + "." + traitName)

  let implNames = impls |> Stdlib.List.map(fun((name, _)) -> name)
  let submodules =
    LanguageTools.PackageManager.Search.readerSubmodules(allSubmodules, implNames)

  if Stdlib.Bool.not(Stdlib.List.isEmpty(submodules)) then
    Stdlib.printLine(Display.getSectionHeader("module"))
    submodules
    |> Stdlib.List.iter(fun name -> Stdlib.printLine($"  {name}/"))
    Stdlib.printLine("")

  let printSection(header: String, items: List<(String * LanguageTools.ProgramTypes.Hash)>): Unit =
    if Stdlib.Bool.not(Stdlib.List.isEmpty(items)) then
      Stdlib.printLine(Display.getSectionHeader(header))
      items
      |> Stdlib.List.iter(fun((name, hash)) ->
        let mark = Query.deprecationMarker(depSets, modulePath, name, hash)
        Stdlib.printLine($"  {name}{mark}")

        // A listing names what a name MEANS, which is one version; `--versions` adds what it
        // has meant.
        if showVersions then
          printVersionLines(modulePath, name, hash))

      Stdlib.printLine("")

  // Its own printer: an implementation entry names the trait AND the type, because at the module
  // level the type is no longer implied by where you are standing, and one form everywhere beats
  // a short one here and a long one there.
  let printImplSection(
    entries: List<(String * String * LanguageTools.ProgramTypes.Hash * List<String>)>)
    : Unit =
    if Stdlib.Bool.not(Stdlib.List.isEmpty(entries)) then
      Stdlib.printLine(Display.getSectionHeader("impl"))
      entries
      |> Stdlib.List.iter(fun entry ->
        let (traitName, typeName, hash, versionsPath) = entry
        let mark = Query.deprecationMarker(depSets, versionsPath, traitName, hash)
        Stdlib.printLine(
          $"  implementation of trait \"{traitName}\" for type \"{typeName}\"{mark}")

        if showVersions then
          printVersionLines(versionsPath, traitName, hash))

      Stdlib.printLine("")

  // Driven by the one kind order, so this list cannot drift from `tree` or the workbench.
  Darklang.Cli.Glyphs.kindOrder
  |> Stdlib.List.iter(fun kind ->
    match kind with
    | "module" -> ()
    | "type" -> printSection("type", types)
    | "fn" -> printSection("fn", fns)
    | "val" -> printSection("val", values)
    | "trait" -> printSection("trait", traits)
    | "impl" -> printImplSection(implEntries)
    | "test" -> printSection("test", tests)
    | _ -> ())


let execute(state: AppState, args: List<String>): AppState =
  let branchId = state.currentBranchId
  let deprecated = Query.Deprecated.showIf(Stdlib.List.contains(args, "--include-deprecated"))
  let internal = Query.Internal.showIf(Stdlib.List.contains(args, "--include-internal"))
  let showVersions = Stdlib.List.contains(args, "--versions")

  let positional =
    args
    |> Stdlib.List.filter(fun a ->
      (a != "--include-deprecated") && (a != "--include-internal") && (a != "--versions"))
  match positional with
  | [] ->
    listModule(branchId, state.packageData.currentLocation, deprecated, internal, showVersions)
    state
  | [pathArg] ->
    match Traversal.traverse(branchId, state.packageData.currentLocation, pathArg) with
    | Error(errorMsg) ->
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Cannot list {pathArg}: {errorMsg}"))
      Cli.failed(state)
    | Ok(newLocation) ->
      match newLocation with
      | Module(_) ->
        listModule(branchId, newLocation, deprecated, internal, showVersions)
        state
      // An implementation's methods are fns in a module named for it, so listing one is a real
      // question with a real answer; the other kinds are leaves.
      | Impl(i) ->
        let asModule =
          PackageLocation.Module(Stdlib.List.append(Stdlib.List.prepend(i.modules, i.owner), i.name))

        listModule(branchId, asModule, deprecated, internal, showVersions)
        state
      | Type(_) | Value(_) | Function(_) | Trait(_) | Test(_) ->
        let locationStr = Packages.formatLocation(newLocation)
        Cli.printErr($"'{locationStr}' is not a module.")
        Cli.Stderr.line("`dark view` shows one item; `dark ls` lists a module.")

        // A trait's own question is which types implement it, and `impls` is the only command that
        // answers it. Without this line you find that command in the docs or by accident.
        match newLocation with
        | Trait(t) ->
          let traitName = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(t)

          Cli.Stderr.line($"`dark impls {traitName}` lists the types that implement it.")
        | _ -> ()

        Cli.failed(state)
  | _ ->
    Stdlib.printLine(help(state))
    state




let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let branchId = state.currentBranchId
  match args with
  | [] ->
    Traversal.completePartialPath(branchId, state.packageData.currentLocation, "")
  | [partialPath] ->
    Traversal.completePartialPath(branchId, state.packageData.currentLocation, partialPath)
  | _ -> []


let help(_state: AppState): String =
  [
    "Usage: ls [path] [--include-deprecated] [--include-internal] [--versions]"
    "List contents of the current location or specified path with icons."
    ""
    "Shows modules, types, functions, values, traits, trait implementations and tests, by kind."
    "Deprecated items with no live callers are hidden by default; pass"
    "--include-deprecated to show them. Visible deprecated items are marked ⚠."
    "Internal helpers (names starting with __) are hidden too; --include-internal"
    "shows them. `view` and calls reach them by name either way."
    ""
    "A listing names what a name MEANS, which is one version. --versions is how"
    "you ask what it has meant: every version under that name, oldest first, the"
    "live one marked. On a branch the sequence continues past the fork, so this"
    "is where a branch's own superseded versions are addressable by name."
    ""
    "Examples:"
    "  ls                         - List current location"
    "  ls /                       - List root packages"
    "  ls Darklang                - List Darklang package contents"
    "  ls .. --include-deprecated - Include deprecated items"
    "  ls Darklang.Stdlib.List --versions   - every version of each name"
    ""
    "See also: `tree` for multi-level view, `view` for detailed view"
  ] |> Stdlib.String.join("\n")
