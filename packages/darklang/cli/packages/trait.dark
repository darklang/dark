module Darklang.Cli.Packages.TraitCommand

// `trait <location> <type params and methods>`: author one trait, the way `fn`
// authors one function. The fragment is everything after the name
// (`<'a> = let show (v: 'a) : String`); a complete `trait Name<'a> = ...`
// declaration is accepted too, doc comment included.

let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    Stdlib.printLine(help(state))
    state
  | [location, ...definitionParts] ->
    match definitionFromArgs(definitionParts) with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(inlineDefinition) ->
      if Stdlib.String.isEmpty(inlineDefinition) then
        [ Stdlib.Cli.UI.Colors.error("Error: Trait definition required")
          ""
          "Pass the definition inline, a file that holds it, or `-` to read from stdin:"
          "  trait <location> <type params and methods>"
          "  trait <location> <source-file>"
          "  trait <location> -    (read from stdin)"
          ""
          "Example:"
          "  dark trait Me.Demo.Show \"<'a> = let show(v: 'a): String\""
          "" ]
        |> Stderr.lines

        { state with exitCode = 1 }
      else
        createTraitInline(state.packageData.currentLocation, location, inlineDefinition, state)


let createTraitInline(
  currentLocation: PackageLocation,
  locationStr: String,
  definition: String,
  state: AppState)
  : AppState =
  match Location.parseRelativeTo(currentLocation, locationStr) with
  | Ok(location) ->
    let trimmedDefinition = Stdlib.String.trim(definition)
    let fullSource =
      if
        Stdlib.String.startsWith(trimmedDefinition, "trait ")
        || Stdlib.String.startsWith(trimmedDefinition, "///")
      then
        definition
      else
        $"trait {location.name}{definition}"

    let (tree, diagnostics) =
      LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, fullSource)

    match tree with
    | Some(SourceFile(sourceFile)) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors(diagnostics) || Errors.reportTrailing(sourceFile)
      let parsed =
        if hasParseError then
          Option.None
        else
          match sourceFile.declarations with
          | [Trait(t)] -> Option.Some(t)
          | _ -> Option.None

      match parsed with
      | Some(t) when t.name.name != location.name ->
        let actual = t.name.name
        printErr($"Trait name `{actual}` does not match target `{location.name}`")
        Stdlib.printErrorLine(
          Stdlib.Cli.UI.Colors.hint(
            $"Rename it to `trait {location.name}<...> = ...`, or change the target."))

        { state with exitCode = 1 }
      | Some(t) ->
        let failState = { state with exitCode = 1 }
        saveAuthored(
          state,
          location,
          LanguageTools.ProgramTypes.ItemKind.Trait,
          "trait",
          failState,
          0,
          fun ctx ->
            let (packageTrait, ops, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.traitWithOps(ctx, t)

            Option.Some((ops, packageTrait.hash, unresolvedNames)))
      | _ ->
        if hasParseError then
          { state with exitCode = 1 }
        else
          [ Stdlib.Cli.UI.Colors.error("Expected exactly one trait declaration")
            ""
            "Example:"
            "  dark trait Me.Demo.Show \"<'a> = let show(v: 'a): String\""
            "" ]
          |> Stderr.lines

          { state with exitCode = 1 }
    | None ->
      [ Stdlib.Cli.UI.Colors.error("Failed to parse trait definition")
        ""
        "Example:"
        "  dark trait Me.Demo.Show \"<'a> = let show(v: 'a): String\""
        "" ]
      |> Stderr.lines

      { state with exitCode = 1 }
  | Error(msg) ->
    printErr($"Invalid location: {msg}")
    { state with exitCode = 1 }


let help(_state: AppState): String =
  [ "Create or update a trait"
    ""
    "Usage: trait <location> <type params and methods>"
    "       trait <location> <source-file>"
    "       trait <location> -"
    ""
    "A trait names a set of fns over one open type; the first type parameter is"
    "the type an implementation is for. Implement it with `impl`, list the"
    "implementations with `impls <trait>`, and see `docs traits`."
    ""
    "Examples:"
    "  dark trait Me.Demo.Show \"<'a> = let show(v: 'a): String\""
    ""
    "  # Several methods, from stdin:"
    "  dark trait Me.Demo.Shape - <<'EOF'"
    "  /// What a shape can do"
    "  trait Shape<'a> ="
    "    let area(s: 'a): Float"
    "    let name(s: 'a): String"
    "  EOF"
    "  dark impls Me.Demo.Shape"
    "" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
