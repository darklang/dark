/// Read-only audit of serialized package declarations on the current branch.
module Darklang.Cli.Packages.Typecheck

type Counts =
  { checkedCount: Int
    failedCount: Int
    incompleteCount: Int
    /// Of the failed, how many name something that resolves to nothing.
    unresolvedCount: Int }

type OutputFilter =
  { showChecked: Bool
    showFailed: Bool
    showIncomplete: Bool }

type ParsedArgs =
  { outputFilter: OutputFilter
    parseErrors: List<FlagParser.ParseError>
    positionals: List<String>
    asJson: Bool
    conflictingFilters: Bool }

val usage =
  "Usage: typecheck [<module>] [--failed] [--incomplete] [--all] [--json]"

val argSpec =
  FlagParser.Spec
    { flags = [ ("--failed", []), ("--incomplete", []), ("--all", []), ("--json", []) ]
      valueFlags = [] }

let parseArgs (args: List<String>) : ParsedArgs =
  let parsed = FlagParser.parse argSpec args
  let failedOnly = FlagParser.hasFlag parsed "--failed"
  let incompleteOnly = FlagParser.hasFlag parsed "--incomplete"
  let showAll = FlagParser.hasFlag parsed "--all"
  let hasSpecificFilter = failedOnly || incompleteOnly
  ParsedArgs
    { outputFilter =
        OutputFilter
          { showChecked = showAll
            showFailed = showAll || failedOnly || Stdlib.Bool.not hasSpecificFilter
            showIncomplete =
              showAll || incompleteOnly || Stdlib.Bool.not hasSpecificFilter }
      parseErrors = parsed.errors
      positionals = parsed.positionals
      asJson = FlagParser.hasFlag parsed "--json"
      conflictingFilters = showAll && hasSpecificFilter }

let fullPath (location: LanguageTools.ProgramTypes.PackageLocation) : String =
  [ [ location.owner ], location.modules, [ location.name ] ]
  |> Stdlib.List.flatten
  |> Stdlib.String.join "."

let locationsFor
  (branchId: Uuid)
  (reference: LanguageTools.ProgramTypes.Reference)
  : List<LanguageTools.ProgramTypes.PackageLocation> =
  match reference with
  | PackageType hash -> LanguageTools.PackageManager.Type.locations branchId hash
  | PackageValue hash -> LanguageTools.PackageManager.Value.locations branchId hash
  | PackageFn hash -> LanguageTools.PackageManager.Function.locations branchId hash
  | PackageTrait hash -> LanguageTools.PackageManager.Trait.locations branchId hash
  | PackageTraitImpl hash -> LanguageTools.PackageManager.TraitImpl.locations branchId hash

let fallbackLabel (reference: LanguageTools.ProgramTypes.Reference) : String =
  let kind =
    match reference with
    | PackageType _ -> "type"
    | PackageValue _ -> "value"
    | PackageFn _ -> "function"
    | PackageTrait _ -> "trait"
    | PackageTraitImpl _ -> "impl"
  let hash =
    LanguageTools.ProgramTypes.hashToShort (
      LanguageTools.ProgramTypes.Reference.hash reference)
  $"{kind} {hash}"

let itemLabel
  (branchId: Uuid)
  (reference: LanguageTools.ProgramTypes.Reference)
  : String =
  let paths =
    locationsFor branchId reference
    |> Stdlib.List.map fullPath
    |> Stdlib.List.unique
    |> Stdlib.List.sort
  match paths with
  | [] -> fallbackLabel reference
  | [ path ] -> path
  | _ -> Stdlib.String.join paths ", "

/// Whether the item names something that resolves to nothing. At save that means "not decided
/// yet", since a caller may be written before its callee; in an audit of what is stored it means
/// the item calls something that is not there.
let namesNothing (item: LanguageTools.AtRestTypeChecker.ItemReport) : Bool =
  item.warnings
  |> Stdlib.List.findFirst (fun w ->
    match w.code with
    | UnresolvedFunctionName
    | UnresolvedValueName
    | UnresolvedTypeName
    | UnresolvedTraitName -> true
    | _ -> false)
  |> Stdlib.Option.isSome

/// The checker's verdict, except that an item it could not prove because it names something
/// that does not exist is failed here.
let auditVerdict
  (item: LanguageTools.AtRestTypeChecker.ItemReport)
  : LanguageTools.AtRestTypeChecker.Verdict =
  match item.verdict with
  | Incomplete when namesNothing item -> LanguageTools.AtRestTypeChecker.Verdict.Failed
  | v -> v

let counts
  (items: List<LanguageTools.AtRestTypeChecker.ItemReport>)
  : Counts =
  items
  |> Stdlib.List.fold
       (Counts { checkedCount = 0; failedCount = 0; incompleteCount = 0; unresolvedCount = 0 })
       (fun acc item ->
         match (auditVerdict item, item.verdict) with
         | (Checked, _) -> { acc with checkedCount = acc.checkedCount + 1 }
         | (Failed, Incomplete) ->
           { acc with
               failedCount = acc.failedCount + 1
               unresolvedCount = acc.unresolvedCount + 1 }
         | (Failed, _) -> { acc with failedCount = acc.failedCount + 1 }
         | (Incomplete, _) -> { acc with incompleteCount = acc.incompleteCount + 1 })

let printItem
  (branchId: Uuid)
  (outputFilter: OutputFilter)
  (item: LanguageTools.AtRestTypeChecker.ItemReport)
  : Unit =
  let label = itemLabel branchId item.item
  match auditVerdict item with
  | Checked ->
    if outputFilter.showChecked then
      Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"checked: {label}")
  | Failed ->
    if outputFilter.showFailed then
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"failed: {label}")
      Stdlib.List.append
        (AtRestCheck.issueLines branchId item.diagnostics)
        (AtRestCheck.issueLines branchId item.warnings)
      |> Stdlib.printLines
  | Incomplete ->
    if outputFilter.showIncomplete then
      Stdlib.printLine (Stdlib.Cli.UI.Colors.warning $"incomplete: {label}")
      Stdlib.List.append
        (AtRestCheck.issueLines branchId item.diagnostics)
        (AtRestCheck.issueLines branchId item.warnings)
      |> Stdlib.printLines

// The --json rendering. The same data the human view renders, typed: `docs for-ai` promises every
// question-answering command takes --json, and an agent auditing a branch after a batch of
// edits is this command's main consumer. Items are filtered the same way the human view is.
let jsonReport
  (branchId: Uuid)
  (outputFilter: OutputFilter)
  (report: LanguageTools.AtRestTypeChecker.Report)
  (totals: Counts)
  (total: Int)
  : String =
  let verdictWord (v: LanguageTools.AtRestTypeChecker.Verdict) : String =
    match v with
    | Checked -> "checked"
    | Failed -> "failed"
    | Incomplete -> "incomplete"

  let wanted (item: LanguageTools.AtRestTypeChecker.ItemReport) : Bool =
    match auditVerdict item with
    | Checked -> outputFilter.showChecked
    | Failed -> outputFilter.showFailed
    | Incomplete -> outputFilter.showIncomplete

  let items =
    report.items
    |> Stdlib.List.filter wanted
    |> Stdlib.List.sortBy (fun item -> itemLabel branchId item.item)
    |> Stdlib.List.map (fun item ->
      let issues =
        Stdlib.List.append
          (AtRestCheck.issueLines branchId item.diagnostics)
          (AtRestCheck.issueLines branchId item.warnings)
        |> Stdlib.List.map (fun l -> Stdlib.String.trim l)

      Stdlib.AltJson.Json.Object
        [ ("name", Stdlib.AltJson.Json.String(itemLabel branchId item.item))
          ("verdict", Stdlib.AltJson.Json.String(verdictWord (auditVerdict item)))
          ("issues", Stdlib.AltJson.Json.Array(issues |> Stdlib.List.map (fun l -> Stdlib.AltJson.Json.String l))) ])

  Stdlib.AltJson.format (
    Stdlib.AltJson.Json.Object
      [ ("verdict",
         Stdlib.AltJson.Json.String(
           if totals.failedCount > 0 then "failed" else verdictWord report.verdict))
        ("checked", Stdlib.AltJson.Json.Integer(totals.checkedCount))
        ("failed", Stdlib.AltJson.Json.Integer(totals.failedCount))
        ("incomplete", Stdlib.AltJson.Json.Integer(totals.incompleteCount))
        ("total", Stdlib.AltJson.Json.Integer(total))
        ("items", Stdlib.AltJson.Json.Array items) ]
  )

let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  let parsed = parseArgs args
  if Stdlib.Bool.not (Stdlib.List.isEmpty parsed.parseErrors) then
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        (FlagParser.parseErrorsMessage parsed.parseErrors))
    Stdlib.printLine usage
    Cli.exitWith state false
  else if (Stdlib.List.length parsed.positionals) > 1 then
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Error: typecheck takes at most one module to scope the audit to")
    Stdlib.printLine usage
    Cli.exitWith state false
  else if parsed.conflictingFilters then
    Stdlib.printLine (
      Stdlib.Cli.UI.Colors.error
        "Error: --all cannot be combined with --failed or --incomplete")
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error usage)
    Cli.exitWith state false
  else
    // A module scopes the audit to that subtree. Without one it is the whole branch, which
    // on a full store is thousands of declarations and tens of seconds; a caller that wants
    // an answer about one module should not pay for the rest.
    let report =
      match parsed.positionals with
      | [] -> AtRestCheck.checkBranch state.currentBranchId
      | [ one ] ->
        AtRestCheck.checkModule state.currentBranchId (Stdlib.String.split one ".")
      | _ -> AtRestCheck.checkBranch state.currentBranchId
    let totals = counts report.items
    let total = Stdlib.List.length report.items

    // An audit that found failures says so in its exit code, so a script or a gate can tell.
    let finished = if totals.failedCount > 0 then { state with exitCode = 1 } else state

    if parsed.asJson then
      Stdlib.printLine
        (jsonReport state.currentBranchId parsed.outputFilter report totals total)
      finished
    else

    let checkedCount = Stdlib.toString totals.checkedCount
    let failedCount =
      if totals.unresolvedCount > 0 then
        $"{Stdlib.toString totals.failedCount} ({Stdlib.toString totals.unresolvedCount} name something that does not exist)"
      else
        Stdlib.toString totals.failedCount
    let incompleteCount = Stdlib.toString totals.incompleteCount
    let totalCount = Stdlib.toString total

    Stdlib.printLine (Stdlib.Cli.UI.Colors.boldText "At-rest package type audit")
    Stdlib.printLine (
      $"checked {checkedCount}, failed {failedCount}, incomplete {incompleteCount}, total {totalCount}")

    report.items
    |> Stdlib.List.sortBy (fun item -> itemLabel state.currentBranchId item.item)
    |> Stdlib.List.iter (printItem state.currentBranchId parsed.outputFilter)

    if Stdlib.List.isEmpty report.items then
      match report.verdict with
      | Incomplete ->
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.warning "The audit could not complete:")
        AtRestCheck.issueLines state.currentBranchId report.warnings
        |> Stdlib.printLines
      | Checked
      | Failed -> ()

    finished

let help (_state: Cli.AppState) : String =
  [ "Audit all visible package types, values, and functions on the current branch."
    "The command is read-only and reports definite errors separately from checks"
    "that are incomplete because the checker cannot yet prove them."
    ""
    usage
    ""
    "Options:"
    "  --failed      List only declarations with definite type errors"
    "  --incomplete  List only declarations the checker could not fully prove"
    "  --all         List checked, failed, and incomplete declarations"
    "  --json        The same report, typed, for an agent"
    ""
    "With a <module>, only that module and everything below it is audited."
    ""
    "Without a filter, failed and incomplete declarations are listed."
    "--failed and --incomplete may be combined; --all is mutually exclusive." ]
  |> Stdlib.String.join "\n"

let complete
  (_state: Cli.AppState)
  (_args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  []
