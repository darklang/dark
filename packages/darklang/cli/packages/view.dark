module Darklang.Cli.Packages.View

/// Resolve a replacement Reference to a human-readable location name for the
/// current branch, falling back to a short hash if no location is bound.
let resolveReplacementName(branchId: Uuid, ref: LanguageTools.ProgramTypes.Reference): String =
  let ctx = PrettyPrinter.ProgramTypes.Context.forBranch(branchId)
  let hash = LanguageTools.ProgramTypes.Reference.hash(ref)
  let locs =
    match ref with
    | PackageFn(h) -> LanguageTools.PackageManager.Function.locations(branchId, h)
    | PackageType(h) -> LanguageTools.PackageManager.Type.locations(branchId, h)
    | PackageValue(h) -> LanguageTools.PackageManager.Value.locations(branchId, h)
    | PackageTrait(h) -> LanguageTools.PackageManager.Trait.locations(branchId, h)
    | PackageTraitImpl(h) -> LanguageTools.PackageManager.TraitImpl.locations(branchId, h)
    | PackageTest(h) -> LanguageTools.PackageManager.Test.locations(branchId, h)

  match LanguageTools.PackageManager.pickLocation(
          PrettyPrinter.ProgramTypes.Context.toPickContext(ctx),
          locs) with
  | Some(loc) -> PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)
  | None -> $"<hash:{LanguageTools.ProgramTypes.hashToShort(hash)}>"


/// The declaration alone: no deprecation header, no capabilities line, no colour.
/// Feed it to `dark module` or `dark edit` and it round-trips.
///
/// Reading an item and writing it back should be a pipe. Stripping a trailer and a
/// prefix with `sed` is a screen-scrape: it works until the display changes.
let rawSource(branchId: Uuid, location: PackageLocation): Result<String, String> =
  let sourceOf(loc: LanguageTools.ProgramTypes.PackageLocation): Result<String, String> =
    let modulePath = Stdlib.List.prepend(loc.modules, loc.owner)
    // `preferredLocation`, so a shared body is headed with the name asked for.
    let ctx =
      { PrettyPrinter.ProgramTypes.Context.forModule(branchId, modulePath) with
          width = PrettyPrinter.ProgramTypes.sourceWidth
          preferredLocation = Option.Some(loc) }

    let results = Query.searchExactMatch(branchId, modulePath, loc.name)
    match results.fns, results.types, results.values, results.tests with
    | [item, ...], _, _, _ -> Result.Ok(PrettyPrinter.ProgramTypes.packageFn(ctx, item.entity))
    | _, [item, ...], _, _ -> Result.Ok(PrettyPrinter.ProgramTypes.packageType(ctx, item.entity))
    | _, _, [item, ...], _ -> Result.Ok(PrettyPrinter.ProgramTypes.packageValue(ctx, item.entity))
    | _, _, _, [item, ...] -> Result.Ok(PrettyPrinter.ProgramTypes.packageTest(ctx, item.entity))
    | _ ->
      match results.traits, results.impls with
      | [item, ...], _ -> Result.Ok(PrettyPrinter.ProgramTypes.packageTrait(ctx, item.entity))
      | _, [item, ...] -> Result.Ok(PrettyPrinter.ProgramTypes.packageImpl(ctx, item.entity))
      | _ ->
        let where = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)
        Result.Error($"nothing at {where}")

  match location with
  | Module(_) ->
    Result.Error(
      "--raw prints ONE declaration. Name a fn, type, value, trait, impl or test, not a module.")
  | Type(loc) -> sourceOf(loc)
  | Value(loc) -> sourceOf(loc)
  | Function(loc) -> sourceOf(loc)
  | Trait(loc) -> sourceOf(loc)
  | Impl(loc) -> sourceOf(loc)
  | Test(loc) -> sourceOf(loc)


/// Print `rawSource`, or say why there is none.
let printRaw(branchId: Uuid, location: PackageLocation): Unit =
  match rawSource(branchId, location) with
  | Ok(src) -> Stdlib.printLine(src)
  | Error(e) -> printErr(e)


/// Build a deprecation header for the item at a name, if any.
let deprecationHeaderRowsFor(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  hash: LanguageTools.ProgramTypes.Hash,
  itemKind: LanguageTools.ProgramTypes.ItemKind)
  : List<String> =
  match LanguageTools.PackageManager.currentDeprecation(branchId, location, hash, itemKind) with
  | None -> []
  | Some(tuple) ->
    let (kind, message) = tuple
    let (header, replacementLine) =
      match kind with
      | SupersededBy(ref) ->
        let replName = resolveReplacementName(branchId, ref)
        ("DEPRECATED (superseded)", Option.Some($"   → use {replName} instead"))
      | Harmful -> ("DEPRECATED (HARMFUL -- runtime will halt)", Option.None)
      | Obsolete -> ("DEPRECATED (obsolete)", Option.None)

    let replacementRows =
      match replacementLine with
      | Some(line) -> [ Stdlib.Cli.UI.Colors.hint(line) ]
      | None -> []

    let messageRows =
      if message != "" then [ Stdlib.Cli.UI.Colors.dimText($"   {message}") ] else []

    Stdlib.List.flatten(
      [ [ Stdlib.Cli.UI.Colors.warning($"⚠ {header}") ], replacementRows, messageRows, [ "" ] ])


/// Split rendered source into logical terminal rows.
let sourceRows(source: String): List<String> =
  if source == "" then [ "" ] else Stdlib.String.split(source, "\n")


/// Build the complete textual representation of an entity without printing it.
/// A printer context for `modulePath`, laid out for the terminal's width rather than a fixed 80.
let terminalContext(branchId: Uuid, modulePath: List<String>): PrettyPrinter.ProgramTypes.Context =
  let (width, _rows) = Terminal.getSize()
  { PrettyPrinter.ProgramTypes.Context.forModule(branchId, modulePath) with width = width }


/// The tests that call <param location> directly, each with its last stored
/// result. Read-only: nothing runs here, and a test with no stored result for
/// this build says so. Deprecated (deleted) tests are left out, as `dark test run`
/// leaves them out.
///
/// <param cmdPrefix> is how the reader runs a command where these rows are
/// shown: "dark " in a shell, ":" in the workbench's command bar.
let testRows(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind,
  cmdPrefix: String,
  heading: String)
  : List<String> =
  testRowsFrom(
    branchId,
    SCM.Deps.dependentsFor(SCM.PackageOps.currentBranch(), [ (location, kind) ]),
    cmdPrefix,
    heading)


/// <fn testRows>, from the item's dependents the caller already read.
let testRowsFrom(
  branchId: Uuid,
  dependents:
    List<
      (LanguageTools.ProgramTypes.Hash *
       LanguageTools.ProgramTypes.PackageLocation *
       LanguageTools.ProgramTypes.ItemKind)>,
  cmdPrefix: String,
  heading: String)
  : List<String> =
  let depSets = Query.loadDeprecationSets(branchId)
  let tests =
    dependents
    |> Stdlib.List.filter(fun((hash, loc, depKind)) ->
      depKind == LanguageTools.ProgramTypes.ItemKind.Test
      && Stdlib.Bool.not(Query.isDeprecatedAtLocation(depSets, loc, hash)))
    |> Stdlib.List.sortBy(fun((_, loc, _)) ->
      PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc))

  match tests with
  | [] -> []
  | _ ->
    let passMark = Stdlib.Cli.UI.Colors.success("✓")
    let failMark = Stdlib.Cli.UI.Colors.error("✗")
    let noResult = Stdlib.Cli.UI.Colors.dimText("no result for this build")
    let outcomes = Test.lastOutcomes(branchId, tests |> Stdlib.List.map(fun((hash, _, _)) -> hash))
    let rows =
      Stdlib.List.zipShortest(tests, outcomes)
      |> Stdlib.List.map(fun(((_, loc, _), outcome)) ->
        let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)
        let result =
          match outcome with
          | Some(Passed) -> [ $"  {passMark} {name}" ]
          | Some(Failed(messages)) ->
            let first = Stdlib.Option.withDefault(Stdlib.List.head(messages), "")
            [ $"  {failMark} {name}", Stdlib.Cli.UI.Colors.dimText($"      {first}") ]
          | Some(RuntimeFailed(message)) ->
            [ $"  {failMark} {name}", Stdlib.Cli.UI.Colors.dimText($"      {message}") ]
          | None -> [ $"  · {name}  {noResult}" ]

        result)
      |> Stdlib.List.flatten

    // One module holds them all (the usual case): name it, so the hint runs
    // exactly these.
    let modules =
      tests
      |> Stdlib.List.map(fun((_, loc, _)) ->
        Stdlib.String.join(Stdlib.List.prepend(loc.modules, loc.owner), "."))
      |> Stdlib.List.unique

    let runHint =
      match modules with
      | [only] -> $"`{cmdPrefix}test run {only}` runs them"
      | _ -> $"`{cmdPrefix}test run` runs them"

    Stdlib.List.flatten(
      [ [ "", heading ]
        Listing.capped(rows, Listing.defaultLimit, Listing.shouldCap(false), "tests")
        [ Stdlib.Cli.UI.Colors.dimText($"  {runHint}") ] ])


/// Whether viewing a function also shows its tests. `--include-tests` asks for them.
type Tests =
  | Show
  | Hide


module Tests =
  /// {{Show}} when <param asked>, the way `view` reads `--include-tests`.
  let showIf(asked: Bool): Cli.Packages.View.Tests =
    if asked then Cli.Packages.View.Tests.Show else Cli.Packages.View.Tests.Hide


let entityRows(branchId: Uuid, location: PackageLocation, tests: Tests): List<String> =
  match location with
  | Module(path) ->
    // Names only. This listing prints each item's name and nothing else, so materializing every matched
    // item's full definition to read `.location.name` is work thrown away. Submodules come back already
    // reduced to the direct children of `path`.
    let (directSubmodules, typeNames, valueNames, fnNames, traitNames, implNames, testNames) =
      Query.allDirectDescendantNames(branchId, path)

    let locationStr = formatLocation(location)
    let submodules =
      LanguageTools.PackageManager.Search.readerSubmodules(directSubmodules, implNames)

    // Internal `__` helpers are left out, as in `ls`; `view` of one by name still shows it.
    let sectionRows(header: String, suffix: String, names: List<String>): List<String> =
      match Query.withoutInternalNames(names) with
      | [] -> []
      | shown ->
        Stdlib.List.flatten(
          [ [ Display.getSectionHeader(header) ]
            shown |> Stdlib.List.map(fun name -> $"  {name}{suffix}")
            [ "" ] ])

    // An impl's methods are called through its trait, never at the impl's path, so each row
    // says where: `Display  Stdlib.display`, for someone who came looking for
    // `Stdlib.Int64.toString`.
    let implRows =
      match Query.withoutInternalNames(implNames) with
      | [] -> []
      | shown ->
        let width =
          shown
          |> Stdlib.List.map(fun name -> Stdlib.String.displayWidth(name))
          |> Stdlib.List.fold(0, fun(acc, w) -> if w > acc then w else acc)

        let row = fun name ->
          let calls =
            match (Query.searchExactMatch(branchId, path, name)).impls with
            | [item, ...] -> Impls.methodCalls(branchId, item.entity)
            | [] -> []

          match calls with
          | [] -> $"  {name}"
          | _ ->
            let padded = Stdlib.Text.padEndToWidth(name, width)
            // `Stdlib.Compare.lessThan, lessThanOrEqualTo, ...`: the path once.
            let callText =
              match calls with
              | [first, ...rest] ->
                rest
                |> Stdlib.List.map(fun c ->
                  Stdlib.Option.withDefault(Stdlib.List.last(Stdlib.String.split(c, ".")), c))
                |> Stdlib.List.prepend(first)
                |> Stdlib.String.join(", ")
              | [] -> ""

            $"  {padded}  {Stdlib.Cli.UI.Colors.dimText(callText)}"

        Stdlib.List.flatten(
          [ [ Display.getSectionHeader("impl") ], shown |> Stdlib.List.map(row), [ "" ] ])

    // A module named for a type (`Acme.Point`, holding the impls `Point.Show`
    // and `Point.Add`) is also that type, and an impl's module (`Acme.Point.Show`,
    // holding its method fns) is the impl: show the declaration above the listing.
    let sameNamedTypeRows =
      match path with
      | [] -> []
      | _ ->
        let parent = Stdlib.List.dropLast(path)
        match Stdlib.List.last(path), parent with
        | Some(name), [owner, ...modules] ->
          let results = Query.searchExactMatch(branchId, parent, name)
          let itemName =
            LanguageTools.ProgramTypes.PackageLocation
              { owner = owner, modules = modules, name = name }

          let ctx =
            { terminalContext(branchId, parent) with preferredLocation = Option.Some(itemName) }

          let printed =
            match results.types with
            | [item, ...] -> Option.Some(PrettyPrinter.ProgramTypes.packageType(ctx, item.entity))
            | [] ->
              match results.impls with
              | [item, ...] -> Option.Some(PrettyPrinter.ProgramTypes.packageImpl(ctx, item.entity))
              | [] -> Option.None

          match printed with
          | Some(prettyPrinted) ->
            Stdlib.List.append(sourceRows(SyntaxHighlighting.highlightCode(prettyPrinted)), "")
          | None -> []
        | _, _ -> []

    Stdlib.List.flatten(
      [ [ locationStr
          Stdlib.String.checkedRepeat("=", Stdlib.String.length(locationStr))
          |> Stdlib.Result.withDefault("")

          "" ]

        sameNamedTypeRows
        sectionRows("submodule", "/", submodules)
        sectionRows("type", "", typeNames)
        sectionRows("trait", "", traitNames)
        sectionRows("value", "", valueNames)
        sectionRows("function", "", fnNames)
        implRows
        sectionRows("test", "", testNames) ])
  | Type(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.types with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Type '{locationStr}' not found." ]
    | [item, ...] ->
      // `preferredLocation`, so a shared body is headed with the name asked for.
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageType(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.Type)

          sourceRows(highlighted) ])
  | Function(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.fns with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Function '{locationStr}' not found." ]
    | [item, ...] ->
      // `preferredLocation`, so a shared body is headed with the name asked for.
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageFn(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      let permissionLines =
        Permissions.Command.policyLinesForHash(
          LanguageTools.ProgramTypes.hashToString(item.entity.hash))

      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.Fn)

          sourceRows(highlighted)
          [ "" ]
          permissionLines |> Stdlib.List.map(Stdlib.Cli.UI.Colors.dimText)
          if tests == Tests.Show then
            testRows(
              branchId,
              name,
              LanguageTools.ProgramTypes.ItemKind.Fn,
              "dark ",
              Display.getSectionHeader("test"))
          else
            [] ])
  | Value(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.values with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Value '{locationStr}' not found." ]
    | [item, ...] ->
      // `preferredLocation`, so a shared body is headed with the name asked for.
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageValue(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.Value)

          sourceRows(highlighted) ])
  | Trait(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.traits with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Trait '{locationStr}' not found." ]
    | [item, ...] ->
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageTrait(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.Trait)

          sourceRows(highlighted) ])
  | Impl(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.impls with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Impl '{locationStr}' not found." ]
    | [item, ...] ->
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageImpl(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.TraitImpl)

          sourceRows(highlighted) ])
  | Test(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.tests with
    | [] ->
      let locationStr = formatLocation(location)
      [ $"Test '{locationStr}' not found." ]
    | [item, ...] ->
      let ctx =
        { terminalContext(branchId, Stdlib.List.prepend(name.modules, name.owner)) with
            preferredLocation = Option.Some(name) }

      let prettyPrinted = PrettyPrinter.ProgramTypes.packageTest(ctx, item.entity)
      let highlighted = SyntaxHighlighting.highlightCode(prettyPrinted)
      Stdlib.List.flatten(
        [ deprecationHeaderRowsFor(
            branchId,
            name,
            item.entity.hash,
            LanguageTools.ProgramTypes.ItemKind.Test)

          sourceRows(highlighted) ])


let viewEntity(branchId: Uuid, location: PackageLocation, tests: Tests): Unit =
  entityRows(branchId, location, tests) |> Stdlib.printLines


/// What `view` shows. Source is the default and the only one that works for every kind of item; the
/// other two are compiler views of a function.
type ViewMode =
  | Source
  /// The declaration alone: no highlighting, no deprecation header, no capabilities
  /// line. What you get back is what `dark module` and `dark edit` accept, so
  /// reading an item and writing it back is a pipe rather than a screen-scrape. The
  /// default view is for a person; this is for whatever reads it next.
  | Raw
  /// The ProgramTypes tree the parser built, before compilation.
  | Ast
  /// The register-machine instructions the function actually runs.
  | Instructions


let modeName(mode: ViewMode): String =
  match mode with
  | Source -> "source"
  | Raw -> "--raw"
  | Ast -> "--ast"
  | Instructions -> "--instructions"


// TODO: neither `--raw` nor `--include-tests` has earned its place, and both should be
// settled rather than left.
//
// `--raw` prints one declaration with no chrome, for a pipe. That is a real need, and it
// is not clear it is a MODE: the default view already decides what to print from what you
// named, so the difference is presentation, and presentation is also what the colour and
// the capping are. If the answer is "no decoration when stdout is not a terminal" then
// `--raw` is a flag for overriding a detection, not a view of its own, and it belongs with
// whatever we do about ANSI in piped output generally.
//
// `--include-tests` is one hardcoded filter on what a listing shows, and `view` on a module
// mostly duplicates `ls` anyway (the keep-or-kill sheet calls ls / tree / view / moduleRows
// four spellings of one listing). A filter belongs on that one listing, as something
// general -- kinds, deprecation, tests -- not as a boolean threaded through this file in
// four places. Deciding that is the prerequisite; this flag should not be extended first.

/// Flags are accepted in any position, so `view --ast List.last` and `view List.last --ast` both work.
/// Returns the paths given (none means the current location), the mode, and whether
/// `--include-tests` was passed, or an error naming the bad flag.
let parseArgs(args: List<String>): Result<(List<String> * ViewMode * Bool), String> =
  let isFlag(a: String): Bool = Stdlib.String.startsWith(a, "-")
  let includeTests = Stdlib.List.contains(args, "--include-tests")
  let flags = Stdlib.List.filter(args, fun a -> isFlag(a) && a != "--include-tests")
  let paths = Stdlib.List.filter(args, fun a -> Stdlib.Bool.not(isFlag(a)))
  let modeResult = Stdlib.List.fold(flags, Result.Ok(ViewMode.Source), fun(acc, flag) ->
    match acc with
    | Error(e) -> Result.Error(e)
    | Ok(_) ->
      match flag with
      | "--raw" -> Result.Ok(ViewMode.Raw)
      | "--ast" -> Result.Ok(ViewMode.Ast)
      | "--instructions" -> Result.Ok(ViewMode.Instructions)
      | "--instrs" -> Result.Ok(ViewMode.Instructions)
      | other -> Result.Error($"unknown option `{other}`"))

  match modeResult with
  | Error(e) -> Result.Error(e)
  | Ok(mode) ->
    if includeTests && mode != ViewMode.Source then
      // The other modes print one declaration for a machine or a debugger;
      // a tests list in that output would break the pipe `--raw` exists for.
      Result.Error("`--include-tests` goes with the default view only")
    else
      Result.Ok((paths, mode, includeTests))


/// The function at a location, if the location names one. `--ast` and `--instructions` are function-only
/// views, and saying which kind of thing you actually pointed at beats a bare "not found".
let fnAt(
  branchId: Uuid,
  location: PackageLocation)
  : Result<LanguageTools.ProgramTypes.PackageFn.PackageFn, String> =
  match location with
  | Function(name) ->
    let modulePath = Stdlib.List.prepend(name.modules, name.owner)
    let results = Query.searchExactMatch(branchId, modulePath, name.name)
    match results.fns with
    | [item, ...] -> Result.Ok(item.entity)
    | [] ->
      let loc = formatLocation(location)
      Result.Error($"Function '{loc}' not found.")
  | Module(_) -> Result.Error("that's a module; this view is for functions")
  | Type(_) -> Result.Error("that's a type; this view is for functions")
  | Value(_) -> Result.Error("that's a value; this view is for functions")
  | Trait(_) -> Result.Error("that's a trait; this view is for functions")
  | Impl(_) ->
    Result.Error("that's an implementation; this view is for functions. Name one of its methods.")
  | Test(_) -> Result.Error("that's a test; this view is for functions")


/// The ProgramTypes tree, indented by depth. Node kinds are colored and payloads dimmed, so the shape
/// reads at a glance and the detail is there when you look for it.
let astRows(
  branchId: Uuid,
  name: String,
  fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : List<String> =
  let ctx = PrettyPrinter.ProgramTypes.Context.forBranch(branchId)
  PrettyPrinter.ProgramTypes.Ast.packageFn(ctx, name, fn)
  |> Stdlib.List.map(fun l ->
    // The signature is depth 0 and the body starts at depth 0 too, so the tree reads as a block under
    // the signature rather than being pushed a level in by scaffolding that isn't there any more.
    let indent = Stdlib.String.checkedRepeat("  ", l.depth) |> Stdlib.Result.withDefault("")
    let label = Stdlib.Cli.UI.Colors.keyword(l.label)
    if l.detail == "" then
      $"{indent}{label}"
    else
      $"{indent}{label} {Stdlib.Cli.UI.Colors.dimText(l.detail)}")


/// The disassembly, plus any lambdas defined inside it. Lambdas get their own section rather than being
/// inlined, because `CreateLambda` is otherwise a dead end in the listing.
let instructionRows(branchId: Uuid, instrs: LanguageTools.RuntimeTypes.Instructions): List<String> =
  let renderBody(is: LanguageTools.RuntimeTypes.Instructions): List<String> =
    let opcodeWidth =
      is.instructions
      |> Stdlib.List.map(fun i ->
        Stdlib.String.length(PrettyPrinter.RuntimeTypes.Instructions.opcode(i)))
      |> Stdlib.List.fold(0, fun(acc, n) -> if n > acc then n else acc)

    is.instructions
    |> Stdlib.List.indexedMap(fun(index, i) ->
      let idx = Stdlib.Cli.UI.Colors.dimText(Stdlib.Text.padStartToWidth(Stdlib.display(index), 4))
      // Width of the widest opcode actually in this body, not a fixed 22. Most functions use short
      // opcodes, and a fixed column leaves a corridor of blanks between them and their operands.
      let op =
        Stdlib.Cli.UI.Colors.command(
          Stdlib.Text.padEndToWidth(PrettyPrinter.RuntimeTypes.Instructions.opcode(i), opcodeWidth))

      let ops = PrettyPrinter.RuntimeTypes.Instructions.operands(branchId, index, i)
      $"  {idx}  {op} {ops}")

  let lambdaSections =
    PrettyPrinter.RuntimeTypes.Instructions.lambdas(instrs)
    |> Stdlib.List.map(fun l ->
      let header = PrettyPrinter.RuntimeTypes.Instructions.header(l.instructions)
      Stdlib.List.flatten(
        [ [ ""
            Stdlib.Cli.UI.Colors.hint($"lambda#{Stdlib.display(l.exprId)}")
            Stdlib.Cli.UI.Colors.dimText($"  {header}")
            "" ]

          renderBody(l.instructions) ]))
    |> Stdlib.List.flatten

  Stdlib.List.flatten(
    [ [ Stdlib.Cli.UI.Colors.dimText($"  {PrettyPrinter.RuntimeTypes.Instructions.header(instrs)}")
        "" ]

      renderBody(instrs)
      lambdaSections ])


/// Render one of the compiler views of the function at <param location>.
let viewCompiled(branchId: Uuid, location: PackageLocation, mode: ViewMode): Unit =
  match fnAt(branchId, location) with
  | Error(e) -> printErr($"Cannot {modeName(mode)}: {e}")
  | Ok(fn) ->
    let title = Stdlib.Cli.UI.Colors.boldText(formatLocation(location))
    Stdlib.printLine(title)
    Stdlib.printLine("")
    match mode with
    | Ast ->
      let shortName =
        match location with
        | Function(name) -> name.name
        | _ -> ""

      astRows(branchId, shortName, fn) |> Stdlib.printLines
    | Instructions ->
      match Builtin.pmFnInstructions(fn.hash) with
      | Some(instrs) -> instructionRows(branchId, instrs) |> Stdlib.printLines
      | None -> printErr("No compiled instructions stored for this function.")
    | Source -> viewEntity(branchId, location, Tests.Hide)
    | Raw -> printRaw(branchId, location)


/// Is every character a hex digit? (Cheaper than a parse, and an FQN never looks like this.)
let looksLikeHex(s: String): Bool =
  s
  |> Stdlib.String.toList
  |> Stdlib.List.all(fun c ->
    Stdlib.Char.isDigit(c) || Stdlib.List.contains([ 'a', 'b', 'c', 'd', 'e', 'f' ], c))


/// A 64-hex argument is an item HASH: every --json surface hands them out, and a
/// content-addressed store whose ids were dead ends on the command line taught agents to
/// route back through names that propagation can move underneath them.
let isItemHash(s: String): Bool =
  Stdlib.String.length(s) == 64 && Stdlib.String.toLowercase(s) == s && looksLikeHex(s)


/// Resolve an item hash (see `isItemHash`) to the location main binds it to, wrapped by
/// the KIND the store records for it, so the viewer renders it as itself. Errors when no
/// live name binds the hash.
let resolveHashArg(hash: String): Result<PackageLocation, String> =
  match SCM.Deps.mainLocationOf(hash) with
  | Some(loc) ->
    let kind =
      SCM.Propagation.kindAt(loc)
      |> Stdlib.Option.withDefault(LanguageTools.ProgramTypes.ItemKind.Fn)

    match kind with
    | Fn -> Result.Ok(PackageLocation.Function(loc))
    | Type -> Result.Ok(PackageLocation.Type(loc))
    | Value -> Result.Ok(PackageLocation.Value(loc))
    | Trait -> Result.Ok(PackageLocation.Trait(loc))
    | TraitImpl -> Result.Ok(PackageLocation.Impl(loc))
    | Test -> Result.Ok(PackageLocation.Test(loc))
  | None ->
    Result.Error(
      $"no live name binds hash {Stdlib.String.first(hash, 8)} -- `dark show {Stdlib.String.first(hash, 8)}` reads it as an op.")


// VIEW command - view modules, functions, types, or constants, as source, AST, or instructions
/// "3 traces went through this", under a function you are looking at or have just edited.
///
/// The one bridge from the package viewer to `dark traces`. Silent when there are none, since a
/// line saying nothing has run is noise on every function you ever look at, and silent for a type
/// or a value, which do not run. <param after> ends the line: what `traces show` does for the
/// reader at this moment.
let printTraceHintWith(branchId: Uuid, location: PackageLocation, after: String): Unit =
  match location with
  | Module(_) -> ()
  | Type(_) -> ()
  | Value(_) -> ()
  | Trait(_) -> ()
  | Impl(_) -> ()
  | Test(_) -> ()
  | Function(loc) ->
    let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)
    match Tracing.Store.wentThroughNamed(branchId, name, 25) with
    | [] -> ()
    | traces ->
      let n = Stdlib.List.length(traces)
      let count = if n == 25 then "25 or more traces" else Text.plural(n, "trace")
      Stdlib.printErrorLine("")

      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.dimText($"{count} went through this: dark traces show {name}{after}"))


let printTraceHint(branchId: Uuid, location: PackageLocation): Unit =
  printTraceHintWith(branchId, location, "")


/// View one item: <param pathArg>, or the current location when there is none. <param failure>
/// starts the line that says it is not there.
let viewOne(
  state: AppState,
  pathArg: Option<String>,
  mode: ViewMode,
  includeTests: Bool,
  failure: String)
  : AppState =
  let branchId = state.currentBranchId
  let locationResult =
    match pathArg with
    | None -> Result.Ok(state.packageData.currentLocation)
    | Some(p) ->
      if isItemHash(p) then
        resolveHashArg(p)
      else
        Traversal.traverse(branchId, state.packageData.currentLocation, p)

  match locationResult with
  | Error(errorMsg) ->
    Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"{failure}: {errorMsg}"))
    // Nonzero: `dark view X` in a script is asking a question whose answer here is "there is no
    // such thing", and a zero exit says the opposite to everything downstream of it.
    { state with exitCode = 1 }
  | Ok(location) ->
    match mode with
    | Raw ->
      match rawSource(branchId, location) with
      | Ok(src) ->
        Stdlib.printLine(src)
        state
      | Error(e) ->
        printErr(e)
        { state with exitCode = 1 }
    | Source ->
      viewEntity(branchId, location, Tests.showIf(includeTests))
      // Show the trace hint only for the human-readable source view.
      printTraceHint(branchId, location)
      state
    | _ ->
      viewCompiled(branchId, location, mode)
      state


let execute(state: AppState, args: List<String>): AppState =
  match parseArgs(args) with
  | Error(e) ->
    Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Cannot view: {e}"))
    Stdlib.printErrorLine(help(state))
    { state with exitCode = 1 }
  | Ok(parsed) ->
    let (paths, mode, includeTests) = parsed

    // Several items are each viewed under their name. Under --raw the name is a comment, so the
    // output is still source that `dark module` reads. A failure names the path, because the
    // traversal names only the segment it stopped at.
    let viewNamed(acc: AppState, p: String): AppState =
      match mode with
      | Raw -> Stdlib.printLine($"// {p}")
      | _ -> Stdlib.printLine(Stdlib.Cli.UI.Colors.boldText($"# {p}"))

      viewOne(acc, Option.Some(p), mode, includeTests, $"Cannot view {p}")

    match paths with
    | [] -> viewOne(state, Option.None, mode, includeTests, "Cannot view")
    | [p] -> viewOne(state, Option.Some(p), mode, includeTests, "Cannot view")
    | [first, ...rest] ->
      rest
      |> Stdlib.List.fold(viewNamed(state, first), fun(acc, p) ->
        Stdlib.printLine("")
        viewNamed(acc, p))


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let branchId = state.currentBranchId
  // Complete the path as before, and offer the view flags once something is typed. Flags are filtered
  // out of the path completion so `view List.last --a` completes the flag, not a package path.
  let flagCompletions(partial: String): List<Completion.CompletionItem> =
    [ "--raw", "--ast", "--instructions", "--include-tests" ]
    |> Stdlib.List.filter(fun name -> Stdlib.String.startsWith(name, partial))
    |> Stdlib.List.map(fun name -> Completion.simple(name))

  match Stdlib.List.last(args) with
  | Some(lastArg) ->
    if Stdlib.String.startsWith(lastArg, "-") then
      flagCompletions(lastArg)
    else
      Traversal.completePartialPath(branchId, state.packageData.currentLocation, lastArg)
  | None -> Traversal.completePartialPath(branchId, state.packageData.currentLocation, "")


let help(_state: AppState): String =
  [ "Usage: view [path...] [--include-tests] [--raw | --ast | --instructions]"
    "View a function, type, value, trait, implementation, test or module."
    ""
    "With path: View the specified item with syntax highlighting."
    "With several paths: View each in turn, under its name."
    "Without path: View current location."
    ""
    "Options:"
    "  --raw             The declaration alone, with no header, badge or colour."
    "                    What `dark module` and `dark edit` accept, so reading an"
    "                    item and writing it back is a pipe."
    ""
    "Options (functions only):"
    "  --include-tests   Also list the tests that call the function, each with"
    "                    its last result for this build. Nothing is run;"
    "                    `dark test run` runs them."
    "  --ast             The ProgramTypes tree the parser built, before compilation."
    "  --instructions    The register-machine instructions the function actually runs."
    "                    Aliased as --instrs."
    ""
    "Examples:"
    "  view                            - View current location"
    "  view List.head                  - View the List.head function"
    "  view List.head List.last        - View both, in one call"
    "  view Option                     - View the Option type"
    "  view Stdlib.List                - View contents of Stdlib.List module"
    "  view List.head --raw            - Print just the declaration"
    "  view Float64.add --include-tests  - Float64.add and the tests that call it"
    "  view List.last --ast            - View List.last as a syntax tree"
    "  view List.map --instructions    - Disassemble List.map" ]
  |> Stdlib.String.join("\n")
