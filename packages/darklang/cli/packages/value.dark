module Darklang.Cli.Packages.Value

let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    Stdlib.printLine(help(state))
    state
  // val SomeModule.myValue = expression
  | [location, ...definitionParts] ->
    match definitionFromArgs(definitionParts) with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(inlineDefinition) ->
      if Stdlib.String.isEmpty(inlineDefinition) then
        // No body: with a terminal, open the structural editor on a blank one.
        match Stdlib.Cli.Tui.TerminalSupport.current(), Location.parseRelativeTo(
                state.packageData.currentLocation,
                location) with
        | Available, Ok(loc) -> Fluid.App.createValue(state, loc)
        | _ ->
          [ Stdlib.Cli.UI.Colors.error("Error: Inline value expression required")
            ""
            "Usage: val <location> <expression>"
            "       val <location> -    (read expression from stdin, for multi-line input)"
            ""
            "Examples:"
            "  dark val Me.Demo.answer '42'"
            "  dark val Me.Demo.message '\"hello world\"'"
            "" ]
          |> Stderr.lines

          failed(state)
      else
        createValueInline(state.packageData.currentLocation, location, inlineDefinition, state)


let createValueInline(
  currentLocation: PackageLocation,
  locationStr: String,
  expression: String,
  state: AppState)
  : AppState =
  match Location.parseRelativeTo(currentLocation, locationStr) with
  | Ok(location) ->
    let fullSource = $"val {location.name} = {expression}"

    // Parse the value definition with the unified (ranged) parser
    let (tree, diagnostics) =
      LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, fullSource)

    match tree with
    | Some(SourceFile(sourceFile)) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors(diagnostics) || Errors.reportTrailing(sourceFile)
      let found =
        if hasParseError then
          Option.None
        else
          sourceFile.declarations
          |> Stdlib.List.findFirst(fun d ->
            match d with
            | Value(_) -> true
            | _ -> false)

      match found with
      | Some(Value(writtenValue)) ->
        saveAuthored(
          state,
          location,
          LanguageTools.ProgramTypes.ItemKind.Value,
          "value",
          { state with exitCode = 1 },
          0,
          fun ctx ->
            let (packageValue, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.ValueDeclaration.toPackageValuePT(
                ctx,
                writtenValue)

            let ops =
              [ LanguageTools.ProgramTypes.PackageOp.AddValue(packageValue)
                LanguageTools.ProgramTypes.PackageOp.SetName(
                  location,
                  LanguageTools.ProgramTypes.Reference.PackageValue(packageValue.hash),
                  Option.None) ]

            Option.Some((ops, packageValue.hash, unresolvedNames)))
      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          failed(state)
        else
          [ Stdlib.Cli.UI.Colors.error("Failed to parse value expression")
            ""
            "Make sure your syntax is correct. Examples:"
            "  dark val Me.Demo.answer '42'"
            "  dark val Me.Demo.message '\"hello world\"'"
            "" ]
          |> Stderr.lines

          failed(state)
    | None ->
      [ Stdlib.Cli.UI.Colors.error("Failed to parse value expression")
        ""
        "Make sure your syntax is correct. Examples:"
        "  dark val Me.Demo.answer '42'"
        "  dark val Me.Demo.message '\"hello world\"'"
        "" ]
      |> Stderr.lines

      failed(state)
  | Error(msg) ->
    printErr($"Invalid location: {msg}")
    failed(state)


let help(_state: AppState): String =
  [ "Create or update a value"
    ""
    "Usage: val <location> <expression>"
    ""
    "When updating an existing value, dependents are automatically updated"
    "to use the new version."
    ""
    "A name is Owner.name, or Owner.Module.name to put it in a module. `Me` is a"
    "fine owner to start with; `Darklang` is reserved for the standard library."
    ""
    "Examples:"
    "  dark val Me.Demo.answer '42'"
    "  dark val Me.Demo.message '\"hello world\"'"
    "  dark val Me.Demo.smallPrimes '[2, 3, 5, 7]'"
    "  dark val Me.Demo.capitals 'Dict { \"France\": \"Paris\", \"Peru\": \"Lima\" }'"
    "  dark eval 'Me.Demo.answer + 1'"
    ""
    "  # Several lines, from stdin:"
    "  dark val Me.Demo.morePrimes - <<'EOF'"
    "  [ 11, 13,"
    "    17, 19 ]"
    "  EOF"
    ""
    "A leading `/` makes a name absolute (`/Me.Demo.answer`); without one it is"
    "relative to the module `nav` put you in."
    "" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
