module Darklang.Cli.Packages.Value


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [] ->
    Stdlib.printLine (help state)
    state

  // val SomeModule.myValue = expression
  | location :: definitionParts ->
    // Strip leading "=" if present (since users naturally type "val x = ...")
    let cleanedParts =
      match definitionParts with
      | "=" :: rest -> rest
      | parts -> parts

    // Join all remaining args as the inline definition.
    // Special case: a single "-" arg means "read body from stdin" so callers
    // can pipe multi-line expressions via heredoc without shell-quoting.
    let inlineDefinition =
      match cleanedParts with
      | [ "-" ] -> Builtin.stdinReadAll ()
      | parts ->
        // Strip a leading "=" from the JOINED string too, not just when it arrived as its own argument.
        // `val Foo = <def>` unquoted splits into a separate "=" token and was already handled; `val Foo
        // "= <def>"` quotes it into the definition, where it used to reach the parser and fail. The help
        // example is written in the unquoted form, so anyone quoting -- which is what you do from a script,
        // or when the definition contains shell metacharacters like `|` -- hit a parse error on the
        // documented syntax.
        let joined = Stdlib.String.join parts " " |> Stdlib.String.trim

        if Stdlib.String.startsWith joined "=" then
          Stdlib.String.dropFirst joined 1 |> Stdlib.String.trim
        else
          joined

    if Stdlib.String.isEmpty inlineDefinition then
      // No inline definition provided - show error
      [
        (Colors.error "Error: Inline value expression required")
        ""
        "Usage: val <location> <expression>"
        "       val <location> -    (read expression from stdin, for multi-line input)"
        ""
        "Examples:"
        "  val x = 42"
        "  val myString = \"hello\""
        "  val myList = [1; 2; 3]"
        ""
        "  # Multi-line expression via stdin (run from shell, not the REPL):"
        "  ./scripts/run-cli val primes - <<'EOF'"
        "  ["
        "    2L"
        "    3L"
        "    5L"
        "    7L"
        "  ]"
        "  EOF"
        ""
      ] |> Stdlib.printLines

      state
    else
      // Parse and create value immediately
      createValueInline
        state.packageData.currentLocation
        location
        inlineDefinition
        state


let createValueInline
  (currentLocation: Packages.PackageLocation)
  (locationStr: String)
  (expression: String)
  (state: Cli.AppState)
  : Cli.AppState =
  // Parse location relative to current position
  match Location.parseRelativeTo currentLocation locationStr with
  | Ok location ->
    // Build full source code for parsing
    let fullSource = $"val {location.name} = {expression}"

    // Parse the value definition with the unified (ranged) parser
    match Builtin.parserParseToWrittenTypes fullSource with
    | Some(SourceFile sourceFile) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors (Builtin.parserParseDiagnostics fullSource)
      let found =
        if hasParseError then
          Stdlib.Option.Option.None
        else
          sourceFile.declarations
          |> Stdlib.List.findFirst (fun d ->
            match d with
            | Value _ -> true
            | _ -> false)

      match found with
      | Some(Value writtenValue) ->
        // Convert to ProgramTypes.PackageValue
        let pm = LanguageTools.PackageManager.pm ()

        let ctx =
          LanguageTools.NameResolver.NRContext
            { onMissing = LanguageTools.NameResolver.OnMissing.Allow
              pm = pm
              branchId = state.currentBranchId
              owner = location.owner
              currentModule = location.modules }

        let (packageValue, unresolvedNames) =
          LanguageTools.WrittenTypesToProgramTypes.ValueDeclaration.toPackageValuePT
            ctx
            writtenValue

        // Check for unresolved names
        if Errors.reportUnresolvedNames state.currentBranchId unresolvedNames then
          state
        // no unresolved names - keep going
        else
          // Check if this is an update (has previous versions)
          let previousHashes = Propagate.getAllPreviousHashes state.currentBranchId location LanguageTools.ProgramTypes.ItemKind.Value
          let isUpdate = (Stdlib.List.isEmpty previousHashes) |> Stdlib.Bool.not

          // Create ops: AddValue and SetName
          let ops =
            [ LanguageTools.ProgramTypes.PackageOp.AddValue packageValue
              LanguageTools.ProgramTypes.PackageOp.SetName (location, LanguageTools.ProgramTypes.Reference.PackageValue packageValue.hash, Stdlib.Option.Option.None) ]

          // Add ops as WIP (use 'scm commit' to commit)
          match SCM.PackageOps.add state.currentBranchId ops with
          | Ok _ ->
            // Show success message
            let fullPath = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation location
            let action = if isUpdate then "Updated" else "Created"

            Stdlib.printLine ""
            Stdlib.printLine (Colors.success $"✓ {action} value: {fullPath}")

            // Repoint dependents NOW, into the draft, so you can run them against this change before
            // deciding whether to commit. Nothing is committed; `dark commit` is still the blessing.
            if isUpdate then
              Propagate.repointNow state.currentBranchId location previousHashes packageValue.hash LanguageTools.ProgramTypes.ItemKind.Value

            Stdlib.printLine ""
            state

          | Error msg ->
            [ ""
              (Colors.error $"✗ Failed to add value: {msg}")
              "" ]
            |> Stdlib.printLines

            state

      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          state
        else
          [
            (Colors.error "Failed to parse value expression")
            ""
            "Make sure your syntax is correct. Examples:"
            "  val x = 42"
            "  val myString = \"hello\""
            ""
          ] |> Stdlib.printLines
          state
    | None ->
      [
        (Colors.error "Failed to parse value expression")
        ""
        "Make sure your syntax is correct. Examples:"
        "  val x = 42"
        "  val myString = \"hello\""
        ""
      ] |> Stdlib.printLines
      state
  | Error msg ->
    Stdlib.printLine (Colors.error $"Invalid location: {msg}")
    state


let help (_state: Cli.AppState) : String =
  [
    "Create or update a value"
    ""
    "Usage: val <location> <expression>"
    ""
    "When updating an existing value, dependents are automatically updated"
    "to use the new version."
    ""
    "Examples:"
    "  # Simple values:"
    "  val x = 42"
    "  val message = \"hello world\""
    ""
    "  # Collections:"
    "  val myList = [1; 2; 3]"
    "  val myDict = Dict { key = \"value\" }"
    ""
    "  # Type alias:"
    "  val userId = Uuid.parse \"123e4567-e89b-12d3-a456-426614174000\""
    ""
    "  # Multi-line expression via stdin (run from shell, not the REPL — '-' reads stdin):"
    "  ./scripts/run-cli val primes - <<'EOF'"
    "  ["
    "    2"
    "    3"
    "    5"
    "    7"
    "  ]"
    "  EOF"
    ""
    "Location can be relative or absolute:"
    "  val foo = 42          # Relative to current location"
    "  val /Darklang.Foo.x = 42  # Absolute path"
    ""
  ] |> Stdlib.String.join "\n"


let complete (_state: Cli.AppState) (_args: List<String>) : List<Cli.Completion.CompletionItem> = []
