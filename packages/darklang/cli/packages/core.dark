module Darklang.Cli.Packages

// CLEANUP should largely defer to a Darklang.Packages or Darklang.Matter namespace
// (less of this in CLI world)

type PackageLocation =
  | Module(path: List<String>)
  | Type(location: LanguageTools.ProgramTypes.PackageLocation)
  | Value(location: LanguageTools.ProgramTypes.PackageLocation)
  | Function(location: LanguageTools.ProgramTypes.PackageLocation)
  | Trait(location: LanguageTools.ProgramTypes.PackageLocation)
  | Impl(location: LanguageTools.ProgramTypes.PackageLocation)
  | Test(location: LanguageTools.ProgramTypes.PackageLocation)


/// The module path a location sits in: the module itself, or the module an item lives in.
let modulePathOf(location: PackageLocation): List<String> =
  match location with
  | Module(path) -> path
  | Type(t) -> Stdlib.List.prepend(t.modules, t.owner)
  | Value(v) -> Stdlib.List.prepend(v.modules, v.owner)
  | Function(f) -> Stdlib.List.prepend(f.modules, f.owner)
  | Trait(t) -> Stdlib.List.prepend(t.modules, t.owner)
  | Impl(i) -> Stdlib.List.prepend(i.modules, i.owner)
  | Test(t) -> Stdlib.List.prepend(t.modules, t.owner)


type EntityType =
  | Module
  | Type
  | Function
  | Value
  | Trait
  | Impl
  | Test


type State =
  { currentLocation: PackageLocation
    locationHistory: List<PackageLocation> }


let initState(): State =
  State { currentLocation = PackageLocation.Module([]), locationHistory = [] }


let formatLocation(location: PackageLocation): String =
  match location with
  | Module(path) ->
    if Stdlib.List.isEmpty(path) then
      "/ (root)"
    else
      $"/{Stdlib.String.join(path, ".")} (module)"
  | Type(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (type)"
  | Value(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (value)"
  | Function(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (fn)"
  | Trait(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (trait)"
  | Impl(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (impl)"
  | Test(loc) -> $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(loc)} (test)"


/// The definition a person typed, from the arguments after the item's name.
///
/// The `=` separating name from definition arrives either as its own argument or
/// attached to the front; both come off, leading ones only, since the `=` in
/// `(x: Int64) : Int64 = x` is the body's. A lone `-` reads stdin, so the separate
/// argument has to go first. A lone argument naming a file that exists reads the
/// file, the way `module` does; a definition is never one token, so the two cannot
/// be confused.
let definitionFromArgs(args: List<String>): Result<String, String> =
  let withoutSeparator =
    match args with
    | ["=", ...rest] -> rest
    | parts -> parts

  match withoutSeparator with
  | ["-"] -> Stdlib.Cli.Stdin.readAll()
  // A file, when the one argument could be one: a declaration has spaces, a path here does
  // not, and asking the host about a declaration-shaped "path" that is longer than a file
  // name may fail closed (the link check treats what it cannot inspect as a link).
  | [path] when if Stdlib.String.contains(path, " ") then false else Stdlib.Cli.File.exists(path) ->
    match Stdlib.Cli.File.readText(path) with
    | Ok(source) -> Result.Ok(source)
    | Error(_) -> Result.Ok(path)
  | parts ->
    let joined = Stdlib.String.join(parts, " ") |> Stdlib.String.trim
    if Stdlib.String.startsWith(joined, "=") then
      Result.Ok(Stdlib.String.dropFirst(joined, 1) |> Stdlib.String.trim)
    else
      Result.Ok(joined)


/// Every doc comment a declaration carries, as (part, text): its own, plus one per parameter,
/// record field or enum case.
///
/// Both sides of the comparison are built by this, so "what did the author write" and "what does
/// this name say now" are the same question asked of two declarations.
let docsOfFn(
  fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : List<(LanguageTools.ProgramTypes.DocPart * String)> =
  let params =
    fn.parameters
    |> Stdlib.List.indexedMap(fun(i, p) ->
      [ (LanguageTools.ProgramTypes.DocPart.Parameter(i), p.description)
        (LanguageTools.ProgramTypes.DocPart.ParameterName(i), p.name) ])
    |> Stdlib.List.flatten

  Stdlib.List.prepend(params, (LanguageTools.ProgramTypes.DocPart.WholeItem, fn.description))


let docsOfType(
  t: LanguageTools.ProgramTypes.PackageType.PackageType)
  : List<(LanguageTools.ProgramTypes.DocPart * String)> =
  let nested =
    match t.declaration.definition with
    | Record(fields) ->
      fields
      |> Stdlib.List.map(fun f ->
        (LanguageTools.ProgramTypes.DocPart.RecordField(f.name), f.description))
    | Enum(cases) ->
      cases
      |> Stdlib.List.map(fun c ->
        (LanguageTools.ProgramTypes.DocPart.EnumCase(c.name), c.description))
    | Alias(_) -> []

  Stdlib.List.prepend(nested, (LanguageTools.ProgramTypes.DocPart.WholeItem, t.description))


/// Every doc these authored ops carry, for the item they declare.
let authoredDocs(
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<(LanguageTools.ProgramTypes.DocPart * String)> =
  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | AddFn(fn) -> Option.Some(docsOfFn(fn))
    | AddType(t) -> Option.Some(docsOfType(t))
    | AddValue(v) -> Option.Some([ (LanguageTools.ProgramTypes.DocPart.WholeItem, v.description) ])
    | AddTrait(t) ->
      Option.Some(
        Stdlib.List.prepend(
          t.methods
          |> Stdlib.List.map(fun m ->
            (LanguageTools.ProgramTypes.DocPart.RecordField(m.name), m.description)),
          (LanguageTools.ProgramTypes.DocPart.WholeItem, t.description)))
    | AddTraitImpl(i) ->
      Option.Some([ (LanguageTools.ProgramTypes.DocPart.WholeItem, i.description) ])
    | AddTest(test) ->
      Option.Some([ (LanguageTools.ProgramTypes.DocPart.WholeItem, test.description) ])
    | _ -> Option.None)
  |> Stdlib.List.flatten


/// What <param location> says NOW at each part: its own words where it has said any, and its
/// declaration's where it has not.
let currentDocs(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind,
  hash: LanguageTools.ProgramTypes.Hash)
  : List<(LanguageTools.ProgramTypes.DocPart * String)> =
  let declared =
    match kind with
    | Fn ->
      LanguageTools.PackageManager.Function.get(hash)
      |> Stdlib.Option.map(fun fn -> docsOfFn(fn))
      |> Stdlib.Option.withDefault([])
    | Type ->
      LanguageTools.PackageManager.Type.get(hash)
      |> Stdlib.Option.map(fun t -> docsOfType(t))
      |> Stdlib.Option.withDefault([])
    | Value ->
      LanguageTools.PackageManager.Value.get(hash)
      |> Stdlib.Option.map(fun v ->
        [ (LanguageTools.ProgramTypes.DocPart.WholeItem, v.description) ])
      |> Stdlib.Option.withDefault([])
    | Trait ->
      LanguageTools.PackageManager.Trait.get(hash)
      |> Stdlib.Option.map(fun t ->
        Stdlib.List.prepend(
          t.methods
          |> Stdlib.List.map(fun m ->
            (LanguageTools.ProgramTypes.DocPart.RecordField(m.name), m.description)),
          (LanguageTools.ProgramTypes.DocPart.WholeItem, t.description)))
      |> Stdlib.Option.withDefault([])
    | TraitImpl ->
      LanguageTools.PackageManager.TraitImpl.get(hash)
      |> Stdlib.Option.map(fun i ->
        [ (LanguageTools.ProgramTypes.DocPart.WholeItem, i.description) ])
      |> Stdlib.Option.withDefault([])
    | Test ->
      LanguageTools.PackageManager.Test.get(hash)
      |> Stdlib.Option.map(fun test ->
        [ (LanguageTools.ProgramTypes.DocPart.WholeItem, test.description) ])
      |> Stdlib.Option.withDefault([])

  SCM.Docs.overlay(branchId, location, declared)


/// The text <param part> holds in <param docs>, or None when it names nothing there.
let docAt(
  docs: List<(LanguageTools.ProgramTypes.DocPart * String)>,
  part: LanguageTools.ProgramTypes.DocPart)
  : Option<String> =
  docs
  |> Stdlib.List.findFirst(fun pair ->
    let (p, _) = pair
    p == part)
  |> Stdlib.Option.map(fun pair ->
    let (_, text) = pair
    text)


/// Author an `UpdateDoc` for every doc that changed, and say whether there was one.
///
/// Called once the save has landed on <param hash>. When that hash was already stored, under this
/// name or another, the ops just authored folded to nothing, so the docs and parameter names written
/// here are what this name says rather than what the stored declaration does.
///
/// One op per changed PART, each naming the text it replaces. Naming it is what lets the far side
/// tell an edit made on top of its own words from one made without ever seeing them.
let updateDocsThatChanged(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind,
  hash: LanguageTools.ProgramTypes.Hash,
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Bool =
  let current = currentDocs(branchId, location, kind, hash)
  let written = authoredDocs(ops)
  let updates =
    written
    |> Stdlib.List.filterMap(fun pair ->
      let (part, text) = pair
      match docAt(current, part) with
      // A part the declaration does not have is not an edit to anything.
      | None -> Option.None
      | Some(currentText) ->
        if currentText == text then
          Option.None
        // Silence is not a statement that the existing words are wrong. Clearing a doc is sayable
        // (the op takes an empty text), just not by omitting one.
        else if text == "" then
          Option.None
        else
          let previous =
            if currentText == "" then
              Option.None
            else
              Option.Some(LanguageTools.ProgramTypes.hashOfText(currentText))

          Option.Some(
            LanguageTools.ProgramTypes.PackageOp.UpdateDoc(
              location,
              part,
              text,
              previous,
              Option.None)))

  if Stdlib.List.isEmpty(updates) then
    false
  else
    match SCM.PackageOps.add(branchId, updates) with
    | Ok(_) -> true
    | Error(_) -> false


/// What a save did, decided without printing anything: the CLI's authoring commands print from it
/// (`saveAuthored`), and so does the workbench's editor, so the two cannot drift apart on what a
/// save means. They did once: the workbench kept its own copy of this, and the copy never
/// propagated.
type Committed =
  { isUpdate: Bool
    /// Anything happened at all: a new item, a new version, a doc change, or a revert.
    landed: Bool
    /// The name went back to a version it held before.
    reverted: Bool
    boundHash: LanguageTools.ProgramTypes.Hash
    followed: Propagate.Followed
    /// The save's own type error, named, if it has one.
    ownIssue: Option<String>
    /// The node the issue in <field ownIssue> is about, which may carry where it is.
    ownIssueNode: Option<UInt64>
    /// How many issues there are besides the one in <field ownIssue>.
    otherIssues: Int64
    /// Another name that already held the version this name now holds.
    sameAs: Option<LanguageTools.ProgramTypes.PackageLocation>
    report: LanguageTools.AtRestTypeChecker.Report }


/// Save <param ops>, which bind <param location> (a <param kind>) at the placeholder <param hash>,
/// repoint what depended on the version it replaces, and say what happened. Prints nothing.
let commitAuthored(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind,
  hash: LanguageTools.ProgramTypes.Hash,
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Result<Committed, String> =
  let previousHashes = Propagate.getAllPreviousHashes(branchId, location, kind)
  let updates = Propagate.updatedItems(branchId, ops)
  let isUpdate = Stdlib.List.isEmpty(previousHashes) |> Stdlib.Bool.not
  let referenceNamesBefore =
    match Stdlib.List.head(previousHashes) with
    | None -> []
    | Some(previous) ->
      SCM.PackageOps.referenceSnapshots(
        branchId,
        [ (location, LanguageTools.ProgramTypes.Reference.fromHashAndKind(previous, kind)) ])
      |> Stdlib.List.map(fun snapshot -> snapshot.names)

  match SCM.PackageOps.addAuthored(branchId, ops) with
  | Ok(report) ->
    // Read the hash BACK, rather than trusting the one the parser handed us: hashes are
    // stabilized inside the save, so the value in hand until now is a placeholder. Everything
    // below that names a version -- the permission summary, the doc-only note -- needs the
    // real one.
    let boundHash =
      match Rename.referenceAt(branchId, location) with
      | Some(reference) -> LanguageTools.ProgramTypes.Reference.hash(reference)
      | None -> hash

    // Decided here rather than before the save, because this is where the stabilized hash is
    // finally known: the one in hand until now is the parser's placeholder.
    let movedVersion = Stdlib.Bool.not(Stdlib.List.contains(previousHashes, boundHash))
    let docsChanged = updateDocsThatChanged(branchId, location, kind, boundHash, ops)
    let docOnly = isUpdate && Stdlib.Bool.not(movedVersion) && docsChanged
    let sameAs =
      if isUpdate && Stdlib.Bool.not(movedVersion) then
        Option.None
      else
        LanguageTools.PackageManager.itemLocations(branchId, kind, boundHash)
        |> Stdlib.List.filter(fun other -> other != location)
        |> Stdlib.List.head

    // A body the name held BEFORE, not the one it holds now: the save put the name back on an
    // earlier version (as a decision, since the SetName already exists). A change, and one a live
    // host follows; not "unchanged".
    let reverted =
      isUpdate
      && Stdlib.Bool.not(movedVersion)
      && Stdlib.List.head(previousHashes) != Option.Some(boundHash)

    // What actually happened, rather than "Updated" for everything. An edit that lands on the hash
    // it already had and carries no new text saved NOTHING, and re-running the same authoring
    // command does exactly that. Reporting it as an update is how a dropped edit stays hidden.
    let referenceNamesAfter =
      SCM.PackageOps.referenceSnapshots(
        branchId,
        [ (location, LanguageTools.ProgramTypes.Reference.fromHashAndKind(boundHash, kind)) ])
      |> Stdlib.List.map(fun snapshot -> snapshot.names)

    let namesChanged = referenceNamesBefore != referenceNamesAfter
    let landed = Stdlib.Bool.not(isUpdate) || docOnly || movedVersion || reverted || namesChanged

    // Repoint dependents NOW, into the draft, so you can run them against this change before
    // deciding whether to commit. Nothing is committed; `dark commit` is still the blessing. A
    // revert repoints too: the dependents follow the name to the version it holds now. Done
    // BEFORE anything prints: whether a dependent broke decides the first line's glyph.
    let followed = Propagate.repointSaved(branchId, updates, Propagate.FollowerCheck.Check)

    // The save's own type check: an error in what was just written. Saved anyway (WIP is yours
    // to break); `dark commit` is the gate. Said on the second line, with the issue itself.
    // Named, not hashed. A trait diagnostic carries the CONTENT HASH of the type and of the
    // trait, and turning one into a name needs a branch to look it up on.
    // `LanguageTools.Live.reportText` takes the report and nothing else, so it renders
    // `type #bf494e2a has no implementation of #d4222cbd155f`, which is the least useful
    // thing to say at the moment a save is refused. `AtRestCheck.customTypeName` is the
    // lookup `dark commit` uses, and the branch is already in hand here.
    //
    // Same shape `reportText` produces, the first issue and a count of the rest, so the save
    // stays two lines.
    let ownIssue =
      match report.verdict with
      | Failed ->
        // definite errors first: a warning such as AmbiguousType is often what an error
        // left behind, and only the first issue is shown
        let issues = Stdlib.List.concat(report.diagnostics, report.warnings)
        match issues with
        | [] -> Option.Some("it failed the type check")
        | [issue, ...rest] ->
          // The CODE as well as the message. `dark docs traits` names these codes, they are
          // what somebody searches for, and `dark module` prints them through
          // `AtRestCheck.printSaveReport`, so a `fn` or an `impl` dropping them made the two
          // paths disagree about what a refused save says. It costs one bracketed word on a
          // line that already exists, so the save is still two lines.
          let first =
            "["
            + LanguageTools.AtRestTypeChecker.issueCodeToString(issue.code)
            + "] "
            + AtRestCheck.withDisplayHint(
              branchId,
              issue,
              PrettyPrinter.ProgramTypes.PackageLocation.packageLocation,
              LanguageTools.AtRestTypeChecker.issueToStringWith(
                (fun hash -> AtRestCheck.customTypeName(branchId, hash)),
                issue))

          Option.Some(first)
      | _ -> Option.None

    let ownIssueNode =
      match report.verdict with
      | Failed ->
        Stdlib.List.concat(report.diagnostics, report.warnings)
        |> Stdlib.List.head
        |> Stdlib.Option.andThen(fun issue -> issue.nodeId)
      | _ -> Option.None

    let otherIssues =
      match report.verdict with
      | Failed ->
        let all = Stdlib.List.length(Stdlib.List.concat(report.diagnostics, report.warnings))
        if all > 1 then all - 1 else 0
      | _ -> 0

    Result.Ok(
      Committed
        { isUpdate = isUpdate
          landed = landed
          reverted = reverted
          boundHash = boundHash
          followed = followed
          ownIssue = ownIssue
          ownIssueNode = ownIssueNode
          otherIssues = otherIssues
          sameAs = sameAs
          report = report })
  | Error(msg) -> Result.Error(msg)


/// Shared tail of the fn/type/val authoring flow: build the name-resolution
/// context, convert the written declaration, check unresolved names, take the
/// previous hashes, save, report, and repoint dependents. `kindWord` fills the
/// output lines ("function" | "type" | "value"); `failState` is what a failed
/// save returns (fn sets the exit code, type/val historically don't). `convert` answers None
/// to refuse, having said why; nothing is written.
let saveAuthored(
  state: AppState,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind,
  kindWord: String,
  failState: AppState,
  firstLineShift: Int64,
  convert:
    LanguageTools.NameResolver.NRContext ->
    Option<
      (List<LanguageTools.ProgramTypes.PackageOp> *
       LanguageTools.ProgramTypes.Hash *
       List<
         (LanguageTools.Parser.Range *
          List<String> *
          LanguageTools.ProgramTypes.NameResolutionError)>)>)
  : AppState =
  let pm = LanguageTools.PackageManager.pm()
  let ctx =
    LanguageTools.NameResolver.NRContext
      { onMissing = LanguageTools.NameResolver.OnMissing.Allow
        pm = pm
        branchId = state.currentBranchId
        owner = location.owner
        currentModule = location.modules }

  match convert(ctx) with
  | None -> failState
  | Some(converted) ->
    // Not `Some(a, b, c)`: that pattern never matches an Option holding a 3-tuple.
    let (ops, hash, unresolvedNames) = converted
    let home = Stdlib.List.prepend(location.modules, location.owner)
    if Errors.reportUnresolvedNames(state.currentBranchId, home, unresolvedNames) then
      failState
    else
      match commitAuthored(state.currentBranchId, location, kind, hash, ops) with
      | Ok(committed) ->
        let isUpdate = committed.isUpdate
        let landed = committed.landed
        let reverted = committed.reverted
        let followed = committed.followed
        let ownIssue = committed.ownIssue
        let fullPath = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(location)

        // A save is at most two lines. Line one: what happened, with a check when all is well and a
        // `!` when something no longer type-checks. Line two: who follows, or what broke.
        let broke =
          Stdlib.Option.isSome(ownIssue) || Stdlib.Bool.not(Stdlib.List.isEmpty(followed.broken))

        let glyph =
          if broke then
            Stdlib.Cli.UI.Colors.warning("!")
          else
            Stdlib.Cli.UI.Colors.success("✓")

        if reverted then
          Stdlib.printLine($"{glyph} Put {kindWord} {fullPath} back to an earlier version")
        else if landed then
          let action = if isUpdate then "Updated" else "Created"
          let alsoNamed =
            match committed.sameAs with
            | Some(other) ->
              $" (same code as {PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(other)}, stored once)"
            | None -> ""

          Stdlib.printLine($"{glyph} {action} {kindWord} {fullPath}{alsoNamed}")
        else
          Stdlib.printLine(
            Stdlib.Cli.UI.Colors.hint($"= {kindWord} {fullPath} is unchanged; nothing was saved"))

        match ownIssue with
        | Some(why) ->
          let at =
            match AtRestCheck.positionShifted(
                    committed.ownIssueNode,
                    Stdlib.UInt64.fromInt64(firstLineShift) |> Stdlib.Option.withDefault(0u64)) with
            | Some(p) -> $" ({p})"
            | None -> ""

          Text.printWrappedErr(
            Stdlib.Cli.UI.Colors.error,
            "  ",
            (let more =
               if committed.otherIssues == 0 then
                 ""
               else
                 $" (and {Stdlib.display(committed.otherIssues)} more)"
             $"type error: {why}{at}{more}; saved as a draft, `dark commit` will refuse it"))
        | None -> ()

        Propagate.printFollowed(followed)
        state
      | Error(msg) ->
        let fullPath = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(location)
        Text.printWrappedErr(
          Stdlib.Cli.UI.Colors.error,
          "",
          $"✗ Could not save {kindWord} {fullPath}: {msg}")

        failState
