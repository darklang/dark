module Darklang.Cli.Packages

// CLEANUP should largely defer to a Darklang.Packages or Darklang.Matter namespace
// (less of this in CLI world)

type PackageLocation =
  | Module of path: List<String>
  | Type of location: LanguageTools.ProgramTypes.PackageLocation
  | Value of location: LanguageTools.ProgramTypes.PackageLocation
  | Function of location: LanguageTools.ProgramTypes.PackageLocation

type EntityType =
  | Module
  | Type
  | Function
  | Value

type State =
  { currentLocation: PackageLocation
    locationHistory: List<PackageLocation> }

let initState () : State =
  State
    { currentLocation = PackageLocation.Module []
      locationHistory = [] }


let formatLocation (location: PackageLocation) : String =
  match location with
  | Module path ->
    if Stdlib.List.isEmpty path then
      "/ (root)"
    else
      $"/{Stdlib.String.join path "."} (module)"
  | Type loc ->
    $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation loc} (type)"
  | Value loc ->
    $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation loc} (value)"
  | Function loc ->
    $"/{PrettyPrinter.ProgramTypes.PackageLocation.packageLocation loc} (fn)"


/// The definition a person typed, from the arguments after the item's name.
///
/// The `=` separating name from definition arrives either as its own argument or
/// attached to the front; both come off, leading ones only, since the `=` in
/// `(x: Int64) : Int64 = x` is the body's. A lone `-` reads stdin, so the separate
/// argument has to go first. A lone argument naming a file that exists reads the
/// file, the way `module` does; a definition is never one token, so the two cannot
/// be confused.
let definitionFromArgs (args: List<String>) : String =
  let withoutSeparator =
    match args with
    | "=" :: rest -> rest
    | parts -> parts

  match withoutSeparator with
  | [ "-" ] -> Stdlib.Cli.Stdin.readAll ()
  | [ path ] when Stdlib.Cli.File.exists path ->
    match Stdlib.Cli.File.readText path with
    | Ok source -> source
    | Error _ -> path
  | parts ->
    let joined = Stdlib.String.join parts " " |> Stdlib.String.trim

    if Stdlib.String.startsWith joined "=" then
      Stdlib.String.dropFirst joined 1 |> Stdlib.String.trim
    else
      joined


/// The "changed under you" heads-up, computed BEFORE an edit lands (afterwards the live
/// binding is already the new version): when the version being replaced was authored by a
/// colleague, one line naming them, the commit it arrived in, and how long ago it landed
/// here. None for your own versions and unattributed ones.
let peerHeadsUpLine
  (location: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<String> =
  match SCM.PackageOps.peerAuthoredCurrent location with
  | Some((author, message, mins)) ->
    let who =
      if Stdlib.String.startsWith author "inst-" then
        Stdlib.String.slice author 0 13
      else
        author

    let mins = if mins < 1L then 1L else mins

    let age =
      if mins < 120L then
        (Stdlib.Int64.toString mins) ++ "m"
      else if mins < 2880L then
        (Stdlib.Int64.toString (Stdlib.Int64.divide mins 60L)) ++ "h"
      else
        (Stdlib.Int64.toString (Stdlib.Int64.divide mins 1440L)) ++ "d"

    let subject = if message == "" then "no message" else message

    Stdlib.Option.Option.Some(
      Stdlib.Cli.UI.Colors.hint
        $"  note: {who} changed this {age} ago ({subject}); your edit replaces their version"
    )
  | None -> Stdlib.Option.Option.None


/// The doc comment these authored ops carry.
let authoredDescription
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Option.Option<String> =
  ops
  |> Stdlib.List.findFirst (fun op ->
    match op with
    | AddFn _ -> true
    | AddType _ -> true
    | AddValue _ -> true
    | _ -> false)
  |> Stdlib.Option.andThen (fun op ->
    match op with
    | AddFn fn -> Stdlib.Option.Option.Some fn.description
    | AddType t -> Stdlib.Option.Option.Some t.description
    | AddValue v -> Stdlib.Option.Option.Some v.description
    | _ -> Stdlib.Option.Option.None)


/// What the store currently says about the item at <param hash>.
let storedDescription
  (kind: LanguageTools.ProgramTypes.ItemKind)
  (hash: LanguageTools.ProgramTypes.Hash)
  : Stdlib.Option.Option<String> =
  match kind with
  | Fn ->
    LanguageTools.PackageManager.Function.get hash
    |> Stdlib.Option.map (fun f -> f.description)
  | Type ->
    LanguageTools.PackageManager.Type.get hash
    |> Stdlib.Option.map (fun t -> t.description)
  | Value ->
    LanguageTools.PackageManager.Value.get hash
    |> Stdlib.Option.map (fun v -> v.description)


/// Author the `Describe` a doc-only edit needs, and say whether there was one.
///
/// Called once the save has landed on <param hash>: if that is a hash the location already had,
/// nothing about the VERSION moved, so the ops just authored folded to nothing and a changed doc
/// comment is the only thing left that could have been meant. `Describe` is the op that can carry
/// it -- its own id hashes the text, so two texts are two ops.
let describeIfTheDocChanged
  (branchId: Uuid)
  (kind: LanguageTools.ProgramTypes.ItemKind)
  (hash: LanguageTools.ProgramTypes.Hash)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Bool =
  match (authoredDescription ops, storedDescription kind hash) with
  | (Some written, Some stored) when written != stored ->
    let reference = LanguageTools.ProgramTypes.Reference.fromHashAndKind hash kind

    match
      SCM.PackageOps.add
        branchId
        [ LanguageTools.ProgramTypes.PackageOp.Describe(reference, written) ]
    with
    | Ok _ -> true
    | Error _ -> false
  | _ -> false


/// Shared tail of the fn/type/val authoring flow: build the name-resolution
/// context, convert the written declaration, check unresolved names, take the
/// previous hashes, save, report, and repoint dependents. `kindWord` fills the
/// output lines ("function" | "type" | "value"); `failState` is what a failed
/// save returns (fn sets the exit code, type/val historically don't).
let saveAuthored
  (state: Cli.AppState)
  (location: LanguageTools.ProgramTypes.PackageLocation)
  (kind: LanguageTools.ProgramTypes.ItemKind)
  (kindWord: String)
  (failState: Cli.AppState)
  (convert:
    LanguageTools.NameResolver.NRContext
      -> (List<LanguageTools.ProgramTypes.PackageOp>
          * LanguageTools.ProgramTypes.Hash
          * List<LanguageTools.Parser.Range
              * List<String>
              * LanguageTools.ProgramTypes.NameResolutionError>))
  : Cli.AppState =
  let pm = LanguageTools.PackageManager.pm ()

  let ctx =
    LanguageTools.NameResolver.NRContext
      { onMissing = LanguageTools.NameResolver.OnMissing.Allow
        pm = pm
        branchId = state.currentBranchId
        owner = location.owner
        currentModule = location.modules }

  let (ops, hash, unresolvedNames) = convert ctx

  if Errors.reportUnresolvedNames state.currentBranchId unresolvedNames then
    state
  else
    let previousHashes = Propagate.getAllPreviousHashes state.currentBranchId location kind
    let isUpdate = (Stdlib.List.isEmpty previousHashes) |> Stdlib.Bool.not

    // Read BEFORE the save: after it, the live binding IS the new version.
    let peerHeadsUp =
      if isUpdate then peerHeadsUpLine location
      else Stdlib.Option.Option.None

    match SCM.PackageOps.addAuthored state.currentBranchId ops with
    | Ok report ->
      AtRestCheck.printSaveReport state.currentBranchId report

      // Read the hash BACK, rather than trusting the one the parser handed us: hashes are
      // stabilized inside the save, so the value in hand until now is a placeholder. Everything
      // below that names a version -- the permission summary, the doc-only note -- needs the
      // real one.
      let boundHash =
        match Packages.Rename.referenceAt state.currentBranchId location with
        | Some reference -> LanguageTools.ProgramTypes.Reference.hash reference
        | None -> hash

      let fullPath = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation location

      // Decided here rather than before the save, because this is where the stabilized hash is
      // finally known: the one in hand until now is the parser's placeholder.
      let movedVersion =
        Stdlib.Bool.not (Stdlib.List.member previousHashes boundHash)

      let docOnly =
        (isUpdate && (Stdlib.Bool.not movedVersion))
        && (describeIfTheDocChanged state.currentBranchId kind boundHash ops)

      // What actually happened, rather than "Updated" for everything. An edit that lands on the hash
      // it already had and carries no new text saved NOTHING: re-running the same authoring command
      // does that, and so does editing a doc comment on a FIELD or a parameter, which is the one
      // edit with no op to carry it (see the `Describe` op's TODO). Reporting those as an update is
      // how a dropped edit stays hidden.
      let landed = (Stdlib.Bool.not isUpdate) || docOnly || movedVersion

      Stdlib.printLine ""

      if landed then
        let action = if isUpdate then "Updated" else "Created"
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.success $"✓ {action} {kindWord}: {fullPath}")
      else
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.hint $"= {kindWord} {fullPath} is unchanged: nothing saved.")

        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.dimText
            "  (a doc comment on a FIELD or a parameter is the one edit with no op to carry it yet)")

      let _ =
        if docOnly then
          Stdlib.printLine
            (Stdlib.Cli.UI.Colors.dimText
              "  documentation only -- the version is unchanged, so nothing was repointed.")
        else
          ()

      match peerHeadsUp with
      | Some line -> Stdlib.printLine line
      | None -> ()

      // Repoint dependents NOW, into the draft, so you can run them against this change before
      // deciding whether to commit. Nothing is committed; `dark commit` is still the blessing.
      if isUpdate && (Stdlib.Bool.not docOnly) then
        Propagate.repointNow state.currentBranchId location previousHashes hash kind

      // A fn's transitive permission requirements, named at the save so the author
      // learns what a caller must be allowed BEFORE anyone runs it and gets denied.
      match kind with
      | Fn ->
        Fn.printFunctionPermissionSummary
          (LanguageTools.ProgramTypes.hashToString boundHash)
      | _ -> ()

      Stdlib.printLine ""
      state

    | Error msg ->
      [ ""
        (Stdlib.Cli.UI.Colors.error $"✗ Failed to add {kindWord}: {msg}")
        "" ]
      |> Stdlib.printLines

      failState
