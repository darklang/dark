module Darklang.Cli.Packages.Fn


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [] ->
    Stdlib.printLine (help state)
    state

  // fn SomeModule.myFn (param: Type): ReturnType = body
  | location :: definitionParts ->
    let inlineDefinition = Packages.definitionFromArgs definitionParts

    if Stdlib.String.isEmpty inlineDefinition then
      // No body provided - show error
      [
        (Stdlib.Cli.UI.Colors.error "Error: Function body required")
        ""
        "Pass the body inline, a file that holds it, or `-` to read from stdin:"
        "  fn <location> <parameters and body>"
        "  fn <location> <source-file>"
        "  fn <location> -    (read body from stdin)"
        ""
        "Examples:"
        "  fn double (x: Int): Int = Stdlib.Int.multiply x 2"
        "  fn greet (name: String): String = \"Hello, \" ++ name"
        ""
        "  # Multi-line body via stdin (run from shell, not the REPL):"
        "  ./scripts/run-cli fn fib - <<'EOF'"
        "  let fib (n: Int): Int ="
        "    if n < 2 then n"
        "    else fib (n - 1) + fib (n - 2)"
        "  EOF"
        ""
      ] |> Stdlib.printLines

      state
    else
      // Parse and create function immediately
      createFnInline
        state.packageData.currentLocation
        location
        inlineDefinition
        state


/// After defining a fn: its transitive permission requirements (naming its
/// callbacks when the static walk cannot follow them), and where to inspect
/// them.
let printFunctionPermissionSummary (hash: String) : Unit =
  let requirements = Permissions.Command.requirementDisplay hash
  Stdlib.printLine
    (Stdlib.Cli.UI.Colors.hint $"  permission requirements: {requirements}")
  Stdlib.printLine
    (Stdlib.Cli.UI.Colors.hint $"  inspect: `permissions show {hash}`")


let createFnInline
  (currentLocation: Packages.PackageLocation)
  (locationStr: String)
  (definition: String)
  (state: Cli.AppState)
  : Cli.AppState =
  // Parse location relative to current position
  match Location.parseRelativeTo currentLocation locationStr with
  | Ok location ->
    // Keep accepting the concise historical fragment, while also accepting a
    // complete declaration (with an optional doc comment).
    let trimmedDefinition = Stdlib.String.trim definition
    let fullSource =
      if
        Stdlib.String.startsWith trimmedDefinition "let "
        || Stdlib.String.startsWith trimmedDefinition "///"
      then
        definition
      else
        $"let {location.name} {definition}"

    // Parse the function definition
    match LanguageTools.Parser.Parse.toWrittenTypes fullSource with
    | Some(SourceFile sourceFile) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError =
        Errors.reportParseErrors (LanguageTools.Parser.Parse.diagnostics fullSource)
      let parsedFunction =
        if hasParseError then
          Stdlib.Option.Option.None
        else
          match sourceFile.declarations with
          | [ Function writtenFn ] -> Stdlib.Option.Option.Some writtenFn
          | _ -> Stdlib.Option.Option.None

      match parsedFunction with
      | Some writtenFn when writtenFn.name.name != location.name ->
        let actual = writtenFn.name.name
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.error
            $"Function name `{actual}` does not match target `{location.name}`")
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.hint
            ($"Rename it to `let {location.name} ...`, or change the "
             ++ "fn target."))
        // Nothing was saved: an agent's authoring loop branches on the exit.
        { state with exitCode = 1 }

      | Some writtenFn ->
        let failState = { state with exitCode = 1 }

        Packages.saveAuthored
          state
          location
          LanguageTools.ProgramTypes.ItemKind.Fn
          "function"
          failState
          (fun ctx ->
            let (packageFn, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.FunctionDeclaration.toPackageFnPT
                ctx
                writtenFn

            let ops =
              [ LanguageTools.ProgramTypes.PackageOp.AddFn packageFn
                LanguageTools.ProgramTypes.PackageOp.SetName (location, LanguageTools.ProgramTypes.Reference.PackageFn packageFn.hash, Stdlib.Option.Option.None) ]

            (ops, packageFn.hash, unresolvedNames))

      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          { state with exitCode = 1 }
        else
          [
            (Stdlib.Cli.UI.Colors.error "Expected exactly one function declaration")
            ""
            "Examples:"
            "  fn double (x: Int): Int = Stdlib.Int.multiply x 2"
            "  fn greet (name: String): String = \"Hello, \" ++ name"
            ""
          ] |> Stdlib.printLines
          { state with exitCode = 1 }
    | None ->
      [
        (Stdlib.Cli.UI.Colors.error "Failed to parse function definition")
        ""
        "Make sure your syntax is correct. Examples:"
        "  fn double (x: Int): Int = Stdlib.Int.multiply x 2"
        "  fn greet (name: String): String = \"Hello, \" ++ name"
        ""
      ] |> Stdlib.printLines
      { state with exitCode = 1 }
  | Error msg ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Invalid location: {msg}")
    { state with exitCode = 1 }


let help (_state: Cli.AppState) : String =
  [
    "Create or update a function"
    ""
    "Usage: fn <location> <parameters and body>"
    "       fn <location> <source-file>"
    "       fn <location> -"
    ""
    "When updating an existing function, dependents are automatically updated"
    "to use the new version."
    ""
    "Examples:"
    "  # Simple function:"
    "  fn double (x: Int): Int = Stdlib.Int.multiply x 2"
    ""
    "  # String function:"
    "  fn greet (name: String): String = \"Hello, \" ++ name"
    ""
    "  # Multiple parameters:"
    "  fn add (a: Int) (b: Int): Int = Stdlib.Int.add a b"
    ""
    "  # Boolean function:"
    "  fn isPositive (x: Int): Bool = x > 0"
    ""
    "  # Multi-line body via stdin (run from shell, not the REPL -- '-' reads stdin):"
    "  ./scripts/run-cli fn fib - <<'EOF'"
    "  let fib (n: Int): Int ="
    "    if n < 2 then n"
    "    else fib (n - 1) + fib (n - 2)"
    "  EOF"
    "  # Stdin accepts a complete `let` declaration; the shorter fragment"
    "  # `(n: Int): Int = ...` form remains valid too."
    ""
    "Location can be relative or absolute:"
    "  fn helper (x: Int): Int = ...    # Relative to current location"
    "  fn /Darklang.Foo.bar (x: String): String = ...  # Absolute path"
    ""
  ] |> Stdlib.String.join "\n"


let complete (_state: Cli.AppState) (_args: List<String>) : List<Cli.Completion.CompletionItem> = []
