module Darklang.Cli.Packages.Fn

let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    Stdlib.printLine(help(state))
    state
  // fn SomeModule.myFn (param: Type): ReturnType = body
  | [location, ...definitionParts] ->
    match definitionFromArgs(definitionParts) with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(inlineDefinition) ->
      if Stdlib.String.isEmpty(inlineDefinition) then
        // No body: with a terminal, open the structural editor on a blank one.
        match Stdlib.Cli.Tui.TerminalSupport.current(), Location.parseRelativeTo(
                state.packageData.currentLocation,
                location) with
        | Available, Ok(loc) -> Fluid.App.createFn(state, loc)
        | _ ->
          [ Stdlib.Cli.UI.Colors.error("Error: Function body required")
            ""
            "Pass the body inline, a file that holds it, or `-` to read from stdin:"
            "  fn <location> <parameters and body>"
            "  fn <location> <source-file>"
            "  fn <location> -    (read body from stdin)"
            ""
            "Examples:"
            "  dark fn Me.Demo.double '(x: Int64): Int64 = x * 2'"
            "  dark fn Me.Demo.fib - <<'EOF'"
            "  let fib(n: Int64): Int64 = if n < 2 then n else fib(n - 1) + fib(n - 2)"
            "  EOF"
            "" ]
          |> Stderr.lines

          failed(state)
      else
        // Parse and create function immediately
        createFnInline(state.packageData.currentLocation, location, inlineDefinition, state)


let createFnInline(
  currentLocation: PackageLocation,
  locationStr: String,
  definition: String,
  state: AppState)
  : AppState =
  // Parse location relative to current position
  match Location.parseRelativeTo(currentLocation, locationStr) with
  | Ok(location) ->
    // Keep accepting the concise historical fragment, while also accepting a
    // complete declaration (with an optional doc comment).
    let trimmedDefinition = Stdlib.String.trim(definition)
    let isShortForm =
      Stdlib.Bool.not(
        Stdlib.String.startsWith(trimmedDefinition, "let ")
        || Stdlib.String.startsWith(trimmedDefinition, "///"))

    let fullSource =
      if
        Stdlib.String.startsWith(trimmedDefinition, "let ")
        || Stdlib.String.startsWith(trimmedDefinition, "///")
      then
        definition
      else if Stdlib.String.startsWith(trimmedDefinition, "<") then
        // `dark fn F "<'a: Show> (v: 'a) : String = ..."`: type parameters bind to the name and
        // the parser refuses a space between them, so there is nowhere for the usual one to go.
        $"let {location.name}{trimmedDefinition}"
      else
        $"let {location.name} {definition}"

    // Parse the function definition
    let (tree, diagnostics) =
      LanguageTools.Parser.Parse.parse(LanguageTools.Parser.FileKind.Package, fullSource)

    match tree with
    | Some(SourceFile(sourceFile)) ->
      // The parser may recover a tree after errors; do not save it.
      let hasParseError = Errors.reportParseErrors(diagnostics) || Errors.reportTrailing(sourceFile)
      let parsedFunction =
        if hasParseError then
          Option.None
        else
          match sourceFile.declarations with
          | [Function(writtenFn)] -> Option.Some(writtenFn)
          | _ -> Option.None

      match parsedFunction with
      | Some(writtenFn) when writtenFn.name.name != location.name ->
        let actual = writtenFn.name.name
        printErr($"Function name `{actual}` does not match target `{location.name}`")
        Stdlib.printErrorLine(
          Stdlib.Cli.UI.Colors.hint(
            $"Rename it to `let {location.name} ...`, or change the " + "fn target."))

        // Nothing was saved: an agent's authoring loop branches on the exit.
        { state with exitCode = 1 }
      | Some(writtenFn) ->
        let failState = { state with exitCode = 1 }
        saveAuthored(
          state,
          location,
          LanguageTools.ProgramTypes.ItemKind.Fn,
          "function",
          failState,
          (// the short form is parsed behind `let <name> `, so a column on its first line is off by that
           if isShortForm then
             Stdlib.String.length(fullSource) - Stdlib.String.length(definition)
           else
             0),
          fun ctx ->
            let (packageFn, unresolvedNames) =
              LanguageTools.WrittenTypesToProgramTypes.FunctionDeclaration.toPackageFnPT(
                ctx,
                writtenFn)

            // A bound on a trait that does not exist is not a forward reference worth waiting
            // on, same as `dark impl`: without the trait the bound constrains nothing, and the
            // generic "will resolve when dependencies are added" sends you looking for a missing
            // dependency. The common way to get here is naming a TYPE, which resolves fine as a
            // type and not at all as a trait, so the generic message reads as a lie.
            let unresolvedBoundNames =
              packageFn.bounds
              |> Stdlib.List.filterMap(fun b ->
                match b.trait_.trait_.resolved with
                | Ok(_) -> Option.None
                | Error(_) -> Option.Some(Stdlib.String.join(b.trait_.trait_.originalName, ".")))
              |> Stdlib.List.unique

            unresolvedBoundNames
            |> Stdlib.List.iter(fun name ->
              printErr($"There is no trait called {name}.")
              let alsoAType =
                match LanguageTools.ProgramTypes.parsePackageLocation(name) with
                | location ->
                  match LanguageTools.PackageManager.Type.find(ctx.branchId, location) with
                  | Some(_) -> true
                  | None -> false

              if alsoAType then
                Stdlib.printErrorLine(
                  Stdlib.Cli.UI.Colors.hint(
                    $"  {name} is a type. A bound names a trait: `'a: Display`, not `'a: SomeType`."))
              else
                Stdlib.printErrorLine(
                  Stdlib.Cli.UI.Colors.hint(
                    "  `dark search <name> --trait` finds one; `dark trait` writes one; `docs traits` explains them."))

              Stdlib.printLine(""))

            if Stdlib.Bool.not(Stdlib.List.isEmpty(unresolvedBoundNames)) then
              Option.None
            else
              let ops =
                [ LanguageTools.ProgramTypes.PackageOp.AddFn(packageFn)
                  LanguageTools.ProgramTypes.PackageOp.SetName(
                    location,
                    LanguageTools.ProgramTypes.Reference.PackageFn(packageFn.hash),
                    Option.None) ]

              Option.Some((ops, packageFn.hash, unresolvedNames)))
      | _ ->
        // a precise parse error was already printed above; don't stack the
        // generic hint on top of it
        if hasParseError then
          { state with exitCode = 1 }
        else
          [ Stdlib.Cli.UI.Colors.error("Expected exactly one function declaration")
            ""
            "Examples:"
            "  fn double(x: Int64): Int64 = (x * 2)"
            "  fn greet(name: String): String = \"Hello, \" + name"
            "" ]
          |> Stderr.lines

          { state with exitCode = 1 }
    | None ->
      [ Stdlib.Cli.UI.Colors.error("Failed to parse function definition")
        ""
        "Make sure your syntax is correct. Examples:"
        "  fn double(x: Int64): Int64 = (x * 2)"
        "  fn greet(name: String): String = \"Hello, \" + name"
        "" ]
      |> Stderr.lines

      { state with exitCode = 1 }
  | Error(msg) ->
    printErr($"Invalid location: {msg}")
    { state with exitCode = 1 }


let help(_state: AppState): String =
  [ "Create or update a function"
    ""
    "Usage: fn <location> <parameters and body>"
    "       fn <location> <source-file>"
    "       fn <location> -"
    ""
    "When updating an existing function, dependents are automatically updated"
    "to use the new version."
    ""
    "A name is Owner.name, or Owner.Module.name to put it in a module. `Me` is a"
    "fine owner to start with; `Darklang` is reserved for the standard library."
    ""
    "Examples:"
    "  dark fn Me.Demo.double '(x: Int64): Int64 = x * 2'"
    "  dark fn Me.Demo.greet '(name: String): String = \"Hello, \" + name'"
    "  dark fn Me.Demo.add '(a: Int64, b: Int64): Int64 = a + b'"
    "  dark fn Me.Demo.isPositive '(x: Int64): Bool = x > 0'"
    "  dark eval 'Me.Demo.double(21)'"
    ""
    "  # Several lines, from stdin: a complete `let`, or the `(n: Int64): Int64 = ...` fragment"
    "  dark fn Me.Demo.fib - <<'EOF'"
    "  let fib(n: Int64): Int64 ="
    "    if n < 2 then n"
    "    else fib(n - 1) + fib(n - 2)"
    "  EOF"
    ""
    "A leading `/` makes a name absolute (`/Me.Demo.double`); without one it is"
    "relative to the module `nav` put you in."
    "" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
