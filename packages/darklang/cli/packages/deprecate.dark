module Darklang.Cli.Packages.Deprecate

// `deprecate` marks a fn/type/value/trait/impl/test as deprecated.
//
// TODO (v1.5): interactive kind picker when stdin is a TTY and --kind is
//   missing (reuse CompletionPicker).

type ParsedArgs =
  { itemType: Option<String>
    target: Option<String>
    kind: Option<String>
    replacement: Option<String>
    message: String
    autoConfirm: Bool
    dryRun: Bool
    json: Bool
    parseErrors: List<FlagParser.ParseError> }


val argSpec =
  FlagParser.Spec
    { flags = [ ("--yes", [ "-y" ]), ("--dry-run", []), ("--json", []) ]
      valueFlags = [ ("--kind", []), ("--replacement", []), ("--message", [ "-m" ]) ] }


/// Parse `--key value` / `--flag` style args into a ParsedArgs.
/// Positional args fill itemType, then target.
let parseArgs(args: List<String>): ParsedArgs =
  let p = FlagParser.parse(argSpec, args)
  ParsedArgs
    { itemType = Stdlib.List.getAt(p.positionals, 0)
      target = Stdlib.List.getAt(p.positionals, 1)
      kind = FlagParser.getOption(p, "--kind")
      replacement = FlagParser.getOption(p, "--replacement")
      message = FlagParser.getOptionOr(p, "--message", "")
      autoConfirm = FlagParser.hasFlag(p, "--yes")
      dryRun = FlagParser.hasFlag(p, "--dry-run")
      json = FlagParser.hasFlag(p, "--json")
      parseErrors = p.errors }


/// Build a Reference by resolving a location string (FQN).
/// Returns None if the name can't be resolved on the current branch.
/// TODO: the design doc also promises hash-prefix resolution (e.g.
///       `deprecate fn ab12cd34`); not implemented yet. Add when the first
///       caller needs it.
let resolveTarget(
  branchId: Uuid,
  currentLocation: PackageLocation,
  itemKind: LanguageTools.ProgramTypes.ItemKind,
  target: String)
  : Option<LanguageTools.ProgramTypes.Reference> =
  match Location.parseRelativeTo(currentLocation, target) with
  | Ok(location) ->
    match itemKind with
    | Fn ->
      match LanguageTools.PackageManager.Function.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageFn(h))
      | None -> Option.None
    | Type ->
      match LanguageTools.PackageManager.Type.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageType(h))
      | None -> Option.None
    | Value ->
      match LanguageTools.PackageManager.Value.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageValue(h))
      | None -> Option.None
    | Trait ->
      match LanguageTools.PackageManager.Trait.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageTrait(h))
      | None -> Option.None
    | TraitImpl ->
      match LanguageTools.PackageManager.TraitImpl.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageTraitImpl(h))
      | None -> Option.None
    | Test ->
      match LanguageTools.PackageManager.Test.find(branchId, location) with
      | Some(h) -> Option.Some(LanguageTools.ProgramTypes.Reference.PackageTest(h))
      | None -> Option.None
  | Error(_) -> Option.None


/// What `deprecate` is being pointed at: the kind, its word (for the messages), the name as typed,
/// the name it means, which is what the deprecation is said at, and the item it resolved to there.
type Target =
  { itemKind: LanguageTools.ProgramTypes.ItemKind
    itemTypeStr: String
    target: String
    location: LanguageTools.ProgramTypes.PackageLocation
    targetRef: LanguageTools.ProgramTypes.Reference }


/// `target` as a <type Target> of `itemKind`, or None when nothing of that kind is there.
let resolveAt(
  branchId: Uuid,
  currentLoc: PackageLocation,
  itemKind: LanguageTools.ProgramTypes.ItemKind,
  itemTypeStr: String,
  target: String)
  : Option<Target> =
  match Location.parseRelativeTo(currentLoc, target) with
  | Ok(location) ->
    resolveTarget(branchId, currentLoc, itemKind, target)
    |> Stdlib.Option.map(fun targetRef ->
      Target
        { itemKind = itemKind
          itemTypeStr = itemTypeStr
          target = target
          location = location
          targetRef = targetRef })
  | Error(_) -> Option.None


val allItemKinds =
  [ (LanguageTools.ProgramTypes.ItemKind.Fn, "fn")
    (LanguageTools.ProgramTypes.ItemKind.Type, "type")
    (LanguageTools.ProgramTypes.ItemKind.Value, "value")
    (LanguageTools.ProgramTypes.ItemKind.Trait, "trait")
    (LanguageTools.ProgramTypes.ItemKind.TraitImpl, "impl")
    (LanguageTools.ProgramTypes.ItemKind.Test, "test") ]


/// The kind and the target, whether or not the kind was typed.
///
/// `deprecate fn Acme.Foo` and `deprecate Acme.Foo` both work, as they do for
/// `delete` and `undeprecate`. `locations` does not stop one name holding two
/// kinds, so a name that resolves twice is refused rather than guessed at; the
/// explicit form is how you say which.
let resolveKindAndTarget(
  branchId: Uuid,
  currentLoc: PackageLocation,
  first: String,
  second: Option<String>)
  : Result<Target, String> =
  match LanguageTools.ProgramTypes.ItemKind.fromString(first), second with
  | Some(itemKind), Some(target) ->
    match resolveAt(branchId, currentLoc, itemKind, first, target) with
    | Some(found) -> Result.Ok(found)
    | None -> Result.Error($"Could not resolve {first} {target}")
  // A kind word and nothing after it: say that, rather than looking for an item called `fn`.
  | Some(_), None -> Result.Error($"Missing target (location or hash) after '{first}'")
  | None, Some(extra) ->
    Result.Error(
      $"'{first}' is not a valid item kind, and '{extra}' follows it. "
      + "Expected `deprecate <fn|type|value|trait|impl> <name>`, or just `deprecate <name>`.")
  | None, None ->
    let found =
      allItemKinds
      |> Stdlib.List.filterMap(fun pair ->
        let (k, word) = pair
        resolveAt(branchId, currentLoc, k, word, first))

    match found with
    | [one] -> Result.Ok(one)
    | [] -> Result.Error($"Could not resolve {first}")
    | several ->
      let kinds =
        several
        |> Stdlib.List.map(fun t -> t.itemTypeStr)
        |> Stdlib.String.join(", ")

      Result.Error(
        $"{first} names more than one kind of item ({kinds}). "
        + $"Say which: `dark deprecate <{kinds |> Stdlib.String.replaceAll(", ", "|")}> {first}`")


let parseKind(
  itemKind: LanguageTools.ProgramTypes.ItemKind,
  kindStr: String,
  replacementRef: Option<LanguageTools.ProgramTypes.Reference>)
  : Result<LanguageTools.ProgramTypes.DeprecationKind, String> =
  match kindStr with
  | "superseded-by" ->
    match replacementRef with
    | Some(r) -> Result.Ok(LanguageTools.ProgramTypes.DeprecationKind.SupersededBy(r))
    | None -> Result.Error("--kind superseded-by requires --replacement <location-or-hash>")
  // Harmful is a promise the runtime can only keep for fns: the gate is a call-site check
  // (`ExecutionState.fns.isHarmful`), so there is nowhere for a marked type or value to halt. Accepting it
  // would report success for a safety marking that can never fire, which is worse than refusing.
  | "harmful" ->
    match itemKind with
    | Fn -> Result.Ok(LanguageTools.ProgramTypes.DeprecationKind.Harmful)
    | _ ->
      Result.Error(
        "--kind harmful only applies to fns: the runtime halts at a CALL, so another item kind has no point to halt at. Use --kind obsolete to take it off the shelf.")
  | "obsolete" -> Result.Ok(LanguageTools.ProgramTypes.DeprecationKind.Obsolete)
  | other -> Result.Error($"Unknown kind '{other}'. Expected: superseded-by, harmful, obsolete")


/// The other names holding the content `target` holds at `location`. Deprecated and deleted leave
/// them alone; harmful marks them too, because it is about the code.
let twinsOf(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  target: LanguageTools.ProgramTypes.Reference)
  : List<LanguageTools.ProgramTypes.PackageLocation> =
  let hash =
    LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target))

  let kind =
    LanguageTools.ProgramTypes.ItemKind.toString(LanguageTools.ProgramTypes.Reference.kind(target))

  SCM.Bindings.query(SCM.Bindings.BindingFilter.ByHash(branchId, hash, kind))
  |> Stdlib.List.map(fun b ->
    LanguageTools.ProgramTypes.PackageLocation
      { owner = b.owner
        modules = if b.modules == "" then [] else Stdlib.String.split(b.modules, ".")
        name = b.name })
  |> Stdlib.List.unique
  |> Stdlib.List.filter(fun l -> l != location)


/// The one line that says other names share this code: `what` is what happens to them.
let sayShared(
  twins: List<LanguageTools.ProgramTypes.PackageLocation>,
  what: String,
  listed: Bool)
  : Unit =
  match twins with
  | [] -> ()
  | _ ->
    let n = Stdlib.List.length(twins)
    let share = if n == 1 then "shares" else "share"

    let are = if n == 1 then "is" else "are"

    let names =
      if listed then
        ": "
        + (twins
           |> Stdlib.List.map(PrettyPrinter.ProgramTypes.PackageLocation.packageLocation)
           |> Stdlib.String.join(", "))
      else
        ""

    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.hint(
        $"  {Text.plural(n, "other name")} {share} this code and {are} {what}{names}"))


/// Whether the item at `location` is marked harmful.
let harmfulAt(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  target: LanguageTools.ProgramTypes.Reference)
  : Bool =
  match LanguageTools.PackageManager.currentDeprecation(
          branchId,
          location,
          LanguageTools.ProgramTypes.Reference.hash(target),
          LanguageTools.ProgramTypes.Reference.kind(target)) with
  | Some(standing) ->
    let (kind, _) = standing
    match kind with
    | Harmful -> true
    | _ -> false
  | None -> false


/// What `deprecate --json` and `delete --json` print. `dryRun` is true when nothing was written: `--dry-run`,
/// or `--json` without `--yes`, since there is nobody to ask. `names` is every name the deprecation reaches:
/// the target alone, or for harmful every name holding the same code.
type DeprecateJson =
  { deprecated: String
    itemType: String
    kind: String
    replacement: String
    message: String
    names: List<String>
    dryRun: Bool }


let execute(state: AppState, args: List<String>): AppState =
  let parsed = parseArgs(args)
  let branchId = state.currentBranchId
  match parsed.itemType, parsed.kind with
  | _ when Stdlib.Bool.not(Stdlib.List.isEmpty(parsed.parseErrors)) ->
    printErr(FlagParser.parseErrorsMessage(parsed.parseErrors))
    Stdlib.printErrorLine(help(state))
    failed(state)
  | None, _ ->
    Stdlib.printLine(help(state))
    failed(state)
  | _, None ->
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.error("Error: Missing --kind. Use: superseded-by, harmful, or obsolete"))

    failed(state)
  | Some(first), Some(kindStr) ->
    let currentLoc = state.packageData.currentLocation
    match resolveKindAndTarget(branchId, currentLoc, first, parsed.target) with
    | Error(msg) ->
      printErr(msg)
      failed(state)
    | Ok(found) ->
      let itemKind = found.itemKind
      let itemTypeStr = found.itemTypeStr
      let target = found.target
      let location = found.location
      let targetRef = found.targetRef
      // --replacement has three outcomes we care about:
      //   - absent: None (only valid for non-superseded-by kinds)
      //   - given and resolves: Some ref
      //   - given and doesn't resolve: error out here, don't let parseKind
      //     report "missing" (which would be misleading)
      let replacementResult =
        match parsed.replacement with
        | None -> Result.Ok(Option.None)
        | Some(r) ->
          match resolveTarget(branchId, currentLoc, itemKind, r) with
          | Some(ref) -> Result.Ok(Option.Some(ref))
          | None ->
            // A replacement is resolved AS the kind being deprecated, so a real name of the wrong kind
            // lands here looking exactly like a typo. It is not the same mistake and should not read
            // like one: say which kind it actually is, and why that cannot be a replacement.
            let otherKind =
              allItemKinds
              |> Stdlib.List.filter(fun pair ->
                let (k, _) = pair
                k != itemKind && resolveTarget(branchId, currentLoc, k, r) != Option.None)
              |> Stdlib.List.head

            match otherKind with
            | Some(found) ->
              let (_, foundName) = found
              Result.Error(
                $"{r} is a {foundName}, but you are deprecating a {itemTypeStr}. \"Use this instead\" has to point at something that can stand in its place; use --kind obsolete to retire it with no replacement.")
            | None -> Result.Error($"Could not resolve --replacement {itemTypeStr} {r}")

      match replacementResult with
      | Error(msg) ->
        printErr(msg)
        failed(state)
      | Ok(replacementRef) ->
        match parseKind(itemKind, kindStr, replacementRef) with
        | Error(msg) ->
          printErr(msg)
          failed(state)
        | Ok(deprecationKind) ->
          let fullPathOf = fun name ->
            match Location.parseRelativeTo(currentLoc, name) with
            | Ok(l) -> PrettyPrinter.ProgramTypes.PackageLocation.packageLocation(l)
            | Error(_) -> name

          let fullPath = fullPathOf(target)

          // Harmful is about the code, so it marks every name holding it; the rest are by name.
          let twins = twinsOf(branchId, location, targetRef)
          let harmful =
            match deprecationKind with
            | Harmful -> true
            | _ -> false

          let marked = if harmful then Stdlib.List.prepend(twins, location) else [ location ]
          let report = fun dryRun ->
            printJson(
              Stdlib.Json.checkedSerialize<DeprecateJson>(
                DeprecateJson
                  { deprecated = fullPath
                    itemType = itemTypeStr
                    kind = kindStr
                    replacement =
                      parsed.replacement
                      |> Stdlib.Option.map(fullPathOf)
                      |> Stdlib.Option.withDefault("")
                    message = parsed.message
                    names =
                      marked
                      |> Stdlib.List.map(PrettyPrinter.ProgramTypes.PackageLocation.packageLocation)
                    dryRun = dryRun }))

          // Under --dry-run the preview is the answer, so it goes to stdout. Otherwise it is what the
          // prompt asks about, and goes to stderr with the prompt, so a refusal leaves stdout empty.
          let preview = fun line ->
            if parsed.dryRun then Stdlib.printLine(line) else Stdlib.printErrorLine(line)

          if Stdlib.Bool.not(parsed.json) then
            preview($"  Will deprecate {itemTypeStr} {fullPath}")
            preview($"    kind: {kindStr}")
            if parsed.message != "" then preview($"    message: {parsed.message}")
            match parsed.replacement with
            | Some(r) -> preview($"    replacement: {r}")
            | None -> ()

          if harmful then
            sayShared(twins, "also marked harmful", true)
          else
            sayShared(twins, "unaffected", false)

          if parsed.dryRun || parsed.json && Stdlib.Bool.not(parsed.autoConfirm) then
            if parsed.json then
              exitWith(state, report(true))
            else
              Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint("(dry-run, no op emitted)"))
              state
          else
            let proceed =
              Prompt.confirmExplicit(
                Confirm.assumeIf(parsed.autoConfirm),
                Stdlib.Cli.UI.Colors.warning("Proceed? (y/n): "))

            if proceed then
              let ops =
                marked
                |> Stdlib.List.map(fun l ->
                  LanguageTools.ProgramTypes.PackageOp.Deprecate(
                    l,
                    targetRef,
                    deprecationKind,
                    parsed.message,
                    Option.None))

              match SCM.PackageOps.add(branchId, ops) with
              | Ok(_) ->
                // Report what is in EFFECT, not that the write returned Ok. The two can differ:
                // an op's identity is its content, so a deprecation that was later undone is the
                // op the log already holds. Authoring re-states it with a stamp (`PT.restating`),
                // so this should now always be deprecated -- which is why the other arm says to
                // report it rather than offering advice.
                match LanguageTools.PackageManager.currentDeprecation(
                        branchId,
                        location,
                        LanguageTools.ProgramTypes.Reference.hash(targetRef),
                        itemKind) with
                | Some(_) ->
                  if parsed.json then
                    exitWith(state, report(false))
                  else
                    Stdlib.printLine(
                      Stdlib.Cli.UI.Colors.success($"Deprecated {itemTypeStr} {fullPath}"))

                    state
                | None ->
                  printErr(
                    "Not deprecated, though the op was written. That is a bug in op restatement -- please report it.")

                  failed(state)
              | Error(e) ->
                printErr($"Deprecation failed: {e}")
                failed(state)
            else
              if Stdlib.Cli.UI.Prompt.canAsk() then
                Stderr.line("Deprecation cancelled.")
              else
                let verb = if kindStr == "obsolete" then "delete" else "deprecate"
                printErr($"no terminal to confirm at; add --yes to {verb} {fullPath}")

              failed(state)


/// `dark undeprecate <name>` -- put something back on the shelf.
///
/// The only way to author an `Undeprecate` op, which the fold has always understood. Without it
/// `deprecate` and `delete` are one-way: a `delete` typed at the wrong name can be undone only by
/// re-authoring the item.
///
/// The kind is inferred rather than asked for. You know the name; making you also name its kind to undo
/// something is the sort of question a tool asks because it is easy to implement.
let executeUndeprecate(state: AppState, args: List<String>): AppState =
  let branchId = state.currentBranchId
  // Any dash-led argument, not just `--` ones. `delete <name> -y` is how you get here in the first
  // place, so `restore <name> -y` is what people type to undo it. Nothing to confirm either way:
  // putting something back is not destructive.
  let positional =
    args |> Stdlib.List.filter(fun a -> Stdlib.String.startsWith(a, "-") |> Stdlib.Bool.not)

  match positional with
  // Asking for help is not an error, so `help` is plain and only a bare call (which IS a missing
  // argument) shows the usage in red.
  | ["help"] ->
    Stdlib.printLine("usage: dark undeprecate <name>   (also `dark restore <name>`)")

    Stdlib.printLine(
      Stdlib.Cli.UI.Colors.hint(
        "  puts a deprecated fn, type, value, trait, impl or test back on the shelf. `dark ls --include-deprecated` finds them."))

    state
  | [] ->
    printErr("usage: dark undeprecate <name>   (also `dark restore <name>`)")
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.hint(
        "  puts a deprecated fn, type, value, trait, impl or test back on the shelf. `dark ls --include-deprecated` finds them."))

    failed(state)
  | [target] ->
    let currentLoc = state.packageData.currentLocation

    // Try each kind rather than making the caller say which. `locations` does not stop one name
    // holding two kinds, so more than one can resolve, and then the name alone is not an answer.
    let resolved =
      allItemKinds
      |> Stdlib.List.filterMap(fun pair ->
        let (k, word) = pair
        resolveAt(branchId, currentLoc, k, word, target))

    match resolved with
    | [] ->
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Could not resolve {target}"))

      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.hint(
          "  deprecated items are hidden; `dark ls --include-deprecated` shows them."))

      failed(state)
    | [_, _, ...] ->
      printErr($"{target} names more than one kind of item")
      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.hint(
          "  say which: `dark deprecate <fn|type|value|trait|impl> <name>`"))

      failed(state)
    | [found] ->
      let itemKind = found.itemKind
      let location = found.location
      let targetRef = found.targetRef

      // Two checks, because they ask different questions. Reporting success for
      // undeprecating something that was never deprecated reads as though it undid
      // something. And an op can be written without taking effect, which is what
      // `restating` settles, so the only honest success is one the store agrees to.
      let standing() =
        LanguageTools.PackageManager.currentDeprecation(
          branchId,
          location,
          LanguageTools.ProgramTypes.Reference.hash(targetRef),
          itemKind)

      // Harmful is about the code: undoing it at one name clears it at every name holding the code.
      let harmfulTwins =
        twinsOf(branchId, location, targetRef)
        |> Stdlib.List.filter(fun l -> harmfulAt(branchId, l, targetRef))

      let cleared =
        match standing() with
        | Some(_) -> Stdlib.List.prepend(harmfulTwins, location)
        | None -> harmfulTwins

      match cleared with
      | [] ->
        Stdlib.printErrorLine(
          Stdlib.Cli.UI.Colors.hint($"{target} is not deprecated; nothing to undo."))

        state
      | _ ->
        let ops =
          cleared
          |> Stdlib.List.map(fun l ->
            LanguageTools.ProgramTypes.PackageOp.Undeprecate(l, targetRef, Option.None))

        sayShared(harmfulTwins, "no longer harmful", true)
        match SCM.PackageOps.add(branchId, ops) with
        | Ok(_) ->
          match standing() with
          | None ->
            Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Undeprecated {target}"))
            state
          | Some(_) ->
            printErr(
              "Still deprecated, though the op was written. That is a bug in op restatement -- please report it.")

            failed(state)
        | Error(e) ->
          printErr($"Undeprecate failed: {e}")
          failed(state)
  | _ ->
    printErr("usage: dark undeprecate <name>")
    failed(state)


/// `undeprecate`'s own help. Registered against `undeprecate`, not shared with `deprecate`, whose flags
/// are not this command's.
let undeprecateHelp(_state: AppState): String =
  [ "Put a deprecated fn, type, value, trait or impl back on the shelf."
    ""
    "Usage: undeprecate <name>"
    ""
    "  The name of a deprecated item; `dark ls --include-deprecated` finds them. Authors an"
    "  Undeprecate op in the current draft, so `dark commit` ships it."
    ""
    "Related:"
    "  deprecate -- mark an item superseded, harmful or obsolete" ]
  |> Stdlib.String.join("\n")


let help(_state: AppState): String =
  [ "Mark a function, type, value, trait, implementation or test as deprecated."
    ""
    "Usage: deprecate [<fn|type|value|trait|impl|test>] <name-or-hash> --kind <k> [options]"
    ""
    "  The kind is optional: `deprecate Acme.Point.Show --kind obsolete` infers it. Name it"
    "  when one name holds two kinds, which is the only case inference refuses."
    ""
    "Kinds:"
    "  superseded-by   new item exists -- use that instead (requires --replacement)"
    "  harmful         actively dangerous -- runtime halts unless --allow-harmful (fns only)"
    "  obsolete        don't use this anymore (catch-all)"
    ""
    "Options:"
    "  --kind <k>                    One of the three kinds above"
    "  --replacement <name-or-hash>  Replacement item (required for superseded-by)"
    "  -m, --message <text>          Free-form reason; tooling surfaces it"
    "  --yes, -y                     Skip confirmation prompt"
    "  --dry-run                     Print what would happen; emit no ops"
    "  --json                        Print the result as JSON; without --yes it is a dry run"
    ""
    "Examples:"
    "  deprecate fn Darklang.Stdlib.List.oldMap \\"
    "    --kind superseded-by --replacement Darklang.Stdlib.List.map_ \\"
    "    -m 'rewrite for perf' --yes"
    ""
    "  deprecate fn Darklang.Stdlib.Crypto.brokenHash \\"
    "    --kind harmful -m 'CVE-2026-XXXX' --yes"
    ""
    "  deprecate fn Darklang.Legacy.oldThing --kind obsolete --yes"
    ""
    "  deprecate Darklang.Legacy.oldThing --kind obsolete --yes"
    ""
    "Related:"
    "  delete -- sugar for `deprecate --kind obsolete` with dependents gate"
    "  undeprecate <name> -- put a deprecated item back on the shelf" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] -> [ "fn", "type", "value", "trait", "impl", "test" ] |> Stdlib.List.map(Completion.simple)
  | _ -> []
