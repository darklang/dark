module Darklang.Cli.Packages.Deprecate

// `deprecate` marks a fn/type/value as deprecated.
//
// TODO (v1.5): interactive kind picker when stdin is a TTY and --kind is
//   missing (reuse CompletionPicker).
// TODO (v1.5): `--json` output for agents.


type ParsedArgs =
  { itemType: Stdlib.Option.Option<String>
    target: Stdlib.Option.Option<String>
    kind: Stdlib.Option.Option<String>
    replacement: Stdlib.Option.Option<String>
    message: String
    autoConfirm: Bool
    dryRun: Bool
    parseErrors: List<FlagParser.ParseError> }


val argSpec =
  FlagParser.Spec
    { flags = [ ("--yes", [ "-y" ]); ("--dry-run", []) ]
      valueFlags =
        [ ("--kind", []); ("--replacement", []); ("--message", [ "-m" ]) ] }


/// Parse `--key value` / `--flag` style args into a ParsedArgs.
/// Positional args fill itemType, then target.
let parseArgs (args: List<String>) : ParsedArgs =
  let p = FlagParser.parse argSpec args
  ParsedArgs
    { itemType = Stdlib.List.getAt p.positionals 0
      target = Stdlib.List.getAt p.positionals 1
      kind = FlagParser.getOption p "--kind"
      replacement = FlagParser.getOption p "--replacement"
      message = FlagParser.getOptionOr p "--message" ""
      autoConfirm = FlagParser.hasFlag p "--yes"
      dryRun = FlagParser.hasFlag p "--dry-run"
      parseErrors = p.errors }


/// Build a Reference by resolving a location string (FQN).
/// Returns None if the name can't be resolved on the current branch.
/// TODO: the design doc also promises hash-prefix resolution (e.g.
///       `deprecate fn ab12cd34`); not implemented yet. Add when the first
///       caller needs it.
let resolveTarget
  (branchId: Uuid)
  (currentLocation: Packages.PackageLocation)
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  (target: String)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.Reference> =
  match Location.parseRelativeTo currentLocation target with
  | Ok location ->
    match itemKind with
    | Fn ->
      match LanguageTools.PackageManager.Function.find branchId location with
      | Some h ->
        Stdlib.Option.Option.Some (LanguageTools.ProgramTypes.Reference.PackageFn h)
      | None -> Stdlib.Option.Option.None
    | Type ->
      match LanguageTools.PackageManager.Type.find branchId location with
      | Some h ->
        Stdlib.Option.Option.Some
          (LanguageTools.ProgramTypes.Reference.PackageType h)
      | None -> Stdlib.Option.Option.None
    | Value ->
      match LanguageTools.PackageManager.Value.find branchId location with
      | Some h ->
        Stdlib.Option.Option.Some
          (LanguageTools.ProgramTypes.Reference.PackageValue h)
      | None -> Stdlib.Option.Option.None
  | Error _ -> Stdlib.Option.Option.None


let parseKind
  (itemKind: LanguageTools.ProgramTypes.ItemKind)
  (kindStr: String)
  (replacementRef:
    Stdlib.Option.Option<LanguageTools.ProgramTypes.Reference>)
  : Stdlib.Result.Result<LanguageTools.ProgramTypes.DeprecationKind, String> =
  match kindStr with
  | "superseded-by" ->
    match replacementRef with
    | Some r ->
      Stdlib.Result.Result.Ok
        (LanguageTools.ProgramTypes.DeprecationKind.SupersededBy r)
    | None ->
      Stdlib.Result.Result.Error
        "--kind superseded-by requires --replacement <location-or-hash>"
  | "harmful" -> Stdlib.Result.Result.Ok LanguageTools.ProgramTypes.DeprecationKind.Harmful
  | "obsolete" -> Stdlib.Result.Result.Ok LanguageTools.ProgramTypes.DeprecationKind.Obsolete
  | other ->
    Stdlib.Result.Result.Error
      $"Unknown kind '{other}'. Expected: superseded-by, harmful, obsolete"


/// Every live name on this branch bound to this exact content (item_hash + kind). Deprecation keys on CONTENT,
/// not name, so deprecating one deprecates ALL of these — for a trivial value (0/1/true/"") that can be many
/// unrelated names, including stdlib constants (deprecating a `= 1` retires `Errno.eperm`). We surface the
/// full set before the confirm so the collateral is never a surprise. A normal fn/type has a near-unique
/// hash, so this is a single name and no heads-up fires. (The real per-name fix is a canonical op change and
/// is Stachu's call; this is only the guard.)
let namesAtContent
  (branchId: Uuid)
  (hashStr: String)
  (itemType: String)
  : List<String> =
  let db = Darklang.Sync.localDbPath ()
  let sql =
    "SELECT owner, modules, name FROM locations "
    ++ "WHERE item_hash = @p0 AND item_type = @p1 AND branch_id = @p2 AND unlisted_at IS NULL"
  match Stdlib.Sqlite.queryP db sql [ hashStr; itemType; Stdlib.Uuid.toString branchId ] with
  | Ok rows ->
    rows
    |> Stdlib.List.map (fun row ->
      let owner = Stdlib.Sqlite.textField row "owner" |> Stdlib.Option.withDefault ""
      let modules = Stdlib.Sqlite.textField row "modules" |> Stdlib.Option.withDefault ""
      let name = Stdlib.Sqlite.textField row "name" |> Stdlib.Option.withDefault ""
      $"{owner}.{modules}.{name}")
    |> Stdlib.List.unique
  | Error _ -> []


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  let parsed = parseArgs args
  let branchId = state.currentBranchId

  match (parsed.itemType, parsed.target, parsed.kind) with
  | _ when Stdlib.Bool.not (Stdlib.List.isEmpty parsed.parseErrors) ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error (FlagParser.parseErrorsMessage parsed.parseErrors))
    Stdlib.printLine (help state)
    state

  | (None, _, _) ->
    Stdlib.printLine (help state)
    state

  // The first positional is the KIND, so a lone dotted name lands here. Reporting
  // only the missing target sends you looking for an argument you already gave.
  | (Some itemType, None, _) ->
    match Propagate.itemKindFromString itemType with
    | Some _ ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.error
          $"Error: Missing target (location or hash) after '{itemType}'")
    | None ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.error
          ($"Error: '{itemType}' is not a valid item kind. "
           ++ "Expected fn, type, or value."))

    state

  | (_, _, None) ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Error: Missing --kind. Use: superseded-by, harmful, or obsolete")
    state

  | (Some itemTypeStr, Some target, Some kindStr) ->
    match Propagate.itemKindFromString itemTypeStr with
    | None ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Error: Invalid item type '{itemTypeStr}'")
      Stdlib.printLine "Must be one of: fn, type, value"
      state
    | Some itemKind ->
      let currentLoc = state.packageData.currentLocation
      match resolveTarget branchId currentLoc itemKind target with
      | None ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Could not resolve {itemTypeStr} {target}")
        state
      | Some targetRef ->
        // --replacement has three outcomes we care about:
        //   - absent: None (only valid for non-superseded-by kinds)
        //   - given and resolves: Some ref
        //   - given and doesn't resolve: error out here, don't let parseKind
        //     report "missing" (which would be misleading)
        let replacementResult =
          match parsed.replacement with
          | None -> Stdlib.Result.Result.Ok Stdlib.Option.Option.None
          | Some r ->
            match resolveTarget branchId currentLoc itemKind r with
            | Some ref ->
              Stdlib.Result.Result.Ok (Stdlib.Option.Option.Some ref)
            | None ->
              Stdlib.Result.Result.Error
                $"Could not resolve --replacement {itemTypeStr} {r}"

        match replacementResult with
        | Error msg ->
          Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
          state
        | Ok replacementRef ->

        match parseKind itemKind kindStr replacementRef with
        | Error msg ->
          Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
          state
        | Ok deprecationKind ->
          let fullPath =
            match Location.parseRelativeTo currentLoc target with
            | Ok l -> PrettyPrinter.ProgramTypes.PackageLocation.packageLocation l
            | Error _ -> target

          Stdlib.printLine $"  Will deprecate {itemTypeStr} {fullPath}"
          Stdlib.printLine $"    kind: {kindStr}"
          if parsed.message != "" then
            Stdlib.printLine $"    message: {parsed.message}"
          match replacementRef with
          | Some _ ->
            match parsed.replacement with
            | Some r -> Stdlib.printLine $"    replacement: {r}"
            | None -> ()
          | None -> ()

          // Heads-up when this content is shared by more than one name: deprecation is content-keyed, so all of
          // them get deprecated together. `affected` always includes the target itself, so exactly one = no
          // collateral (silent); two or more = list them all so the confirm is informed.
          let affected =
            namesAtContent
              branchId
              (LanguageTools.ProgramTypes.hashToString
                (LanguageTools.ProgramTypes.Reference.hash targetRef))
              itemTypeStr
          match affected with
          | [] -> ()
          | [ _ ] -> ()
          | _ ->
            Stdlib.printLine
              (Stdlib.Cli.UI.Colors.warning
                $"  Heads up: this {itemTypeStr}'s content is bound to multiple names — deprecation keys on content, so ALL of these are deprecated together:")
            affected
            |> Stdlib.List.map (fun a -> $"    - {a}")
            |> Stdlib.printLines

          if parsed.dryRun then
            Stdlib.printLine "(dry-run, no op emitted)"
            state
          else
            let proceed =
              Cli.Prompt.confirmExplicit
                parsed.autoConfirm
                (Stdlib.Cli.UI.Colors.warning "Proceed? (y/n): ")

            if proceed then
              let op =
                LanguageTools.ProgramTypes.PackageOp.Deprecate
                  (targetRef, deprecationKind, parsed.message)
              match SCM.PackageOps.add branchId [ op ] with
              | Ok _ ->
                Stdlib.printLine
                  (Stdlib.Cli.UI.Colors.success $"Deprecated {itemTypeStr} {fullPath}")
                state
              | Error e ->
                Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"Deprecation failed: {e}")
                state
            else
              Stdlib.printLine "Deprecation cancelled."
              state


let help (_state: Cli.AppState) : String =
  [ "Mark a function, type, or value as deprecated."
    ""
    "Usage: deprecate <fn|type|value> <name-or-hash> --kind <k> [options]"
    ""
    "Kinds:"
    "  superseded-by   new item exists — use that instead (requires --replacement)"
    "  harmful         actively dangerous — runtime halts unless --allow-harmful"
    "  obsolete        don't use this anymore (catch-all)"
    ""
    "Options:"
    "  --kind <k>                    One of the three kinds above"
    "  --replacement <name-or-hash>  Replacement item (required for superseded-by)"
    "  -m, --message <text>          Free-form reason; tooling surfaces it"
    "  --yes, -y                     Skip confirmation prompt"
    "  --dry-run                     Print what would happen; emit no ops"
    ""
    "Examples:"
    "  deprecate fn Darklang.Stdlib.List.oldMap \\"
    "    --kind superseded-by --replacement Darklang.Stdlib.List.map_ \\"
    "    -m 'rewrite for perf' --yes"
    ""
    "  deprecate fn Darklang.Stdlib.Crypto.brokenHash \\"
    "    --kind harmful -m 'CVE-2026-XXXX' --yes"
    ""
    "  deprecate fn Darklang.Legacy.oldThing --kind obsolete --yes"
    ""
    "Related:"
    "  delete — sugar for `deprecate --kind obsolete` with dependents gate"
    "  undo   — reverse a WIP deprecate on the current branch" ]
  |> Stdlib.String.join "\n"


let complete
  (_state: Cli.AppState)
  (args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  match args with
  | [] -> ["fn"; "type"; "value"] |> Stdlib.List.map Cli.Completion.simple
  | _ -> []
