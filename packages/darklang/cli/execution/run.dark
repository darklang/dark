module Darklang.Cli.Run


/// Unit succeeds; BigInt and Int64 supply the script's exit code.
let exitCode(
  value: LanguageTools.RuntimeTypes.Dval)
  : Stdlib.Result.Result<Int64, ExecutionError.ExecutionError> =
  match value with
  | DUnit -> Ok(0)
  | DInt64(code) -> Ok(code)
  // a `BigInt` past Int64 is no exit code the OS could carry, so it fails like any other
  | DBigInt(code) -> Ok(Stdlib.BigInt.toInt64(code) |> Stdlib.Option.withDefault(1))
  | _ ->
    Error(
      ExecutionError.ExecutionError.Runtime(
        LanguageTools.RuntimeTypes.RuntimeError.Error.CLI(
          LanguageTools.RuntimeTypes.RuntimeError.CLIs.Error.NonIntReturned(value)),
        []))


/// Run a script and return its exit code and permission warnings.
/// <param allow> adds instance-policy rules for this run only; nothing is saved.
/// Sandbox mode adds a deny-all run policy.
/// Warning mode allows and reports calls outside the run and package policies.
/// Instance policy and function limits still apply.
/// Warnings include the resource, reason and caller when known.
let parseAndExecute(
  accountID: Stdlib.Option.Option<Uuid>,
  branchId: Uuid,
  filename: String,
  code: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  allow: List<LanguageTools.Permissions.Rule>)
  : Stdlib.Result.Result<(Int64 *
                          List<(String * String * Stdlib.Option.Option<String>)>),
                         ExecutionError.ExecutionError> =
  let result =
    Builtin.cliParseAndExecuteScript(
      accountID,
      branchId,
      filename,
      code,
      args,
      options.allowHarmful,
      options.sandbox,
      options.warnPermissions,
      allow)
  match result with
  | Ok((value, warnings)) ->
    let code = (exitCode(value))?
    Ok((code, warnings))
  | Error(error) -> Error(error)


/// Format permission warnings for the terminal; return [] when there are none.
let permissionWarningLines(
  violations: List<(String * String * Stdlib.Option.Option<String>)>)
  : List<String> =
  match violations with
  | [] -> []
  | vs ->
    let entries =
      vs
      |> Stdlib.List.map(fun v ->
        let (resource, needed, via) = v
        match via with
        | Some(fn) -> $"  - {resource}: {needed} (in {fn})"
        | None -> $"  - {resource}: {needed}")
    Stdlib.List.prepend(
      entries,
      "warning: this run went beyond the configured permission policy:")


// `run-script <path> [args...]` — execute a Dark script file, or a package function by name.

/// Split runner options from the script path and its arguments. Everything after the path stays
/// with the script, flags included; `--` ends the options and stays with them. The same rule as the
/// host's `ScriptArguments.split`, which splits the command line before any Dark runs.
let splitArguments(args: List<String>): (List<String> * List<String>) =
  splitArgumentsAfter([], args)


/// The split of <param remaining>, with <param options> (newest first) already taken.
let splitArgumentsAfter(
  options: List<String>,
  remaining: List<String>)
  : (List<String> * List<String>) =
  match remaining with
  | [ "--", ...rest ] -> (Stdlib.List.reverse(Stdlib.List.prepend(options, "--")), rest)
  | [ flag, value, ...rest ] when flag == "--branch" || flag == "--entry-point" || flag == "--allow" ->
    splitArgumentsAfter(Stdlib.List.prepend(Stdlib.List.prepend(options, flag), value), rest)
  | [ flag, ...rest ] when isFlag(flag) ->
    splitArgumentsAfter(Stdlib.List.prepend(options, flag), rest)
  | _ -> (Stdlib.List.reverse(options), remaining)


/// Whether <param arg> starts with a `-`. By its first byte, not its first character, so a `-`
/// that a combining mark follows still counts, as it does for the host.
let isFlag(arg: String): Bool =
  Stdlib.String.getByteAt(arg, 0) == Stdlib.Option.Option.Some(45u8)

let execute(state: AppState, args: List<String>): AppState =
  let (options, script) = splitArguments(args)
  let asksForHelp =
    Stdlib.List.contains(options, "--help")
    || Stdlib.List.contains(options, "-h")
    || (Stdlib.List.head(args) == Stdlib.Option.Option.Some("help"))
  if asksForHelp then
    Registry.executeCommandHelp("run-script", state)
  else
    executeOptions(
      state,
      options,
      script,
      Darklang.Tracing.ScriptOptions {
        allowHarmful = false
        sandbox = false
        warnPermissions = false },
      false,
      [])


/// Parse the options before the script path. <param stats> is `--stats` and <param allow> the
/// `--allow` rules: both kept out of `ScriptOptions` because those are saved with the trace for
/// replay, and a replay has no reason to report what the original cost, nor to grant anything.
let executeOptions(
  state: AppState,
  flags: List<String>,
  script: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  stats: Bool,
  allow: List<LanguageTools.Permissions.Rule>)
  : AppState =
  match flags with
  | ["--allow-harmful", ...rest] -> executeOptions(state, rest, script, { options with allowHarmful = true }, stats, allow)
  | ["--sandbox", ...rest] -> executeOptions(state, rest, script, { options with sandbox = true }, stats, allow)
  | ["--warn-permissions", ...rest] -> executeOptions(state, rest, script, { options with warnPermissions = true }, stats, allow)
  | ["--stats", ...rest] -> executeOptions(state, rest, script, options, true, allow)
  | ["--allow", text, ...rest] ->
    match LanguageTools.Permissions.parseRuleText(text) with
    | Some(rules) -> executeOptions(state, rest, script, options, stats, Stdlib.List.concat(allow, rules))
    | None ->
      Cli.printErr($"--allow: invalid permission rule: {text}")
      Cli.Stderr.hint("It takes one rule, written as for `permissions allow`, e.g. --allow 'http GET https://api.github.com'")
      Cli.failed(state)
  | [ "--allow" ] ->
    Cli.printErr("--allow needs a rule, e.g. --allow 'http GET https://api.github.com'")
    Cli.failed(state)
  | [] | [ "--" ] ->
    match script with
    | [scriptPath, ...scriptArgs] ->
      if options.sandbox && options.warnPermissions then
        Cli.printErr("--sandbox and --warn-permissions cannot be combined: warn-only mode executes denied effects")
        Cli.failed(state)
      else if options.sandbox && Stdlib.Bool.not(Stdlib.List.isEmpty(allow)) then
        Cli.printErr("--sandbox and --allow cannot be combined: the sandbox denies everything")
        Cli.failed(state)
      else
        allow
        |> Stdlib.List.iter(fun rule ->
          Cli.Stderr.hint($"allowed for this run only: {LanguageTools.Permissions.renderRule(rule)}"))
        executeScript(state, scriptPath, scriptArgs, options, stats, allow)
    | [] ->
      Stdlib.printLine(help(state))
      Cli.failed(state)
  | [flag, ...] ->
    Stdlib.printErrorLine($"Unknown run-script option: {flag}. Put script arguments after the file path; use -- before a path starting with '-'.")
    Cli.failed(state)


// Recognize a dotted package name so `run` can suggest `eval` instead of
// reporting an unhelpful "script not found" error.
let looksLikePackageName(path: String): Bool =
  (Stdlib.String.contains(path, "."))
  && (Stdlib.String.contains(path, "/") |> Stdlib.Bool.not)
  && (Stdlib.String.endsWith(path, ".dark") |> Stdlib.Bool.not)

let executeScript(
  state: AppState,
  scriptPath: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  stats: Bool,
  allow: List<LanguageTools.Permissions.Rule>)
  : AppState =
  match Stdlib.Cli.FileSystem.readFile(scriptPath) with
  | Error(NotFound) when looksLikePackageName(scriptPath) ->
    executePackageFn(state, scriptPath, args, options, stats, allow)
  | Error(e) ->
    match e with
    | NotFound -> Stdlib.printErrorLine($"Script not found: {scriptPath}")
    | OsAccessDenied -> Stdlib.printErrorLine($"Permission denied: {scriptPath}")
    | Other(msg) -> Stdlib.printErrorLine($"Could not read script {scriptPath}: {msg}")
    // Every branch above printed a reason the script did not run, so this is a failure. Saying
    // so in the exit code is the only part a script or an agent can read.
    { state with exitCode = 1 }
  | Ok(script) ->
    let scriptSourceCode = Stdlib.Utf8.decodeWithReplacement(script)
    runScriptMeasured(
      state,
      scriptPath,
      scriptSourceCode,
      args,
      options,
      true,
      stats,
      allow)


/// Run the package function <param name> the way a script runs: under the same policy, with
/// <param args> as its argument, and its Int64 result as the exit code. A function that takes
/// nothing is called with `()`; one with other parameters is refused with its signature.
let executePackageFn(
  state: AppState,
  name: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  stats: Bool,
  allow: List<LanguageTools.Permissions.Rule>)
  : AppState =
  let branchId = state.currentBranchId
  let fnName = TraceVerbs.canonicalFnName(branchId, name)
  let location = LanguageTools.ProgramTypes.parsePackageLocation(fnName)

  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | None ->
    Stdlib.printErrorLine($"No script file or function named {name}")
    { state with exitCode = 1 }
  | Some(hash) ->
    match LanguageTools.PackageManager.Function.getSignature(hash) with
    | Some(fn) ->
      match fn.parameters |> Stdlib.List.map(fun p -> p.typ) with
      | [] | [ TUnit ] -> runNullary(state, name, fnName, args, options, stats, allow)
      | [ TList(TString) ] ->
        runScriptMeasured(state, name, $"{fnName}(args)", args, options, true, stats, allow)
      | _ ->
        let modulePath = Stdlib.List.prepend(location.modules, location.owner)
        let ctx = Packages.Signatures.rootContext(branchId, modulePath)
        let shown =
          fn.parameters
          |> Stdlib.List.map(fun p ->
            $"{p.name}: {PrettyPrinter.ProgramTypes.typeReference(ctx, p.typ)}")
          |> Stdlib.String.join(", ")
        Stdlib.printErrorLine(
          $"{name} takes ({shown}); `run` passes the words as a List<String>. Call it with: dark eval '{name}(…)'")
        { state with exitCode = 1 }
    | None -> runScriptMeasured(state, name, $"{fnName}(args)", args, options, true, stats, allow)


/// <fn executePackageFn> for a function that takes nothing.
let runNullary(
  state: AppState,
  name: String,
  fnName: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  stats: Bool,
  allow: List<LanguageTools.Permissions.Rule>)
  : AppState =
  match args with
  | [] -> runScriptMeasured(state, name, $"{fnName}()", args, options, true, stats, allow)
  | _ ->
    Stdlib.printErrorLine($"{name} takes no arguments")
    { state with exitCode = 1 }


let allowAlways(): String = "Allow future runs (save to the instance policy)"
let denyChoice(): String = "Deny"

let printScriptError(state: AppState, e: ExecutionError.ExecutionError): AppState =
  ExecutionError.printCallStack(state.currentBranchId, "Script", e)
  let pretty = ExecutionError.toString(state.currentBranchId, e)
  Stdlib.printErrorLine($"Script error: {pretty}")
  { state with exitCode = 1 }

/// A denial, and when it names a rule, the `--allow` rerun that grants it for one run. A trace
/// resume or rerun (<param offerApproval> false) is not a command line to repeat.
let printDenied(
  state: AppState,
  denied: ExecutionError.PermissionDenied,
  offerApproval: Bool,
  rerun: String -> Stdlib.Option.Option<String>)
  : AppState =
  let newState = printScriptError(state, ExecutionError.ExecutionError.Denied(denied))
  match denied.rule |> Stdlib.Option.andThen(rerun) with
  | Some(command) when offerApproval ->
    Cli.Stderr.hint($"To allow it for this run only: `{command}`")
    newState
  | _ -> newState

/// Run a script. On denial, offer to save permission for a later run.
/// Never restart automatically: that could repeat writes or requests.
/// Only direct terminal runs prompt, with sandbox and warning mode off.
let runScript(
  state: AppState,
  scriptPath: String,
  code: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  offerApproval: Bool)
  : AppState =
  runScriptMeasured(state, scriptPath, code, args, options, offerApproval, false, [])


/// <fn runScript>, and with <param stats> also what the run cost, the same block `eval --stats`
/// prints. Only parsing and executing are measured: an approval prompt waits on a person, and
/// that is not the script's time.
let runScriptMeasured(
  state: AppState,
  scriptPath: String,
  code: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  offerApproval: Bool,
  stats: Bool,
  allow: List<LanguageTools.Permissions.Rule>)
  : AppState =
  let run = fun () ->
    parseAndExecute(
      state.accountID,
      state.currentBranchId,
      scriptPath,
      code,
      args,
      options,
      allow)

  let (measurement, result) =
    if stats then
      // What the script cost, net of the measuring harness itself: see Perf.floor.
      let harness = LanguageTools.Perf.floor()
      let (raw, result) = LanguageTools.Perf.measure(run)
      (Stdlib.Option.Option.Some(LanguageTools.Perf.minus(raw, harness)), result)
    else
      (Stdlib.Option.Option.None, run())

  // No hint for a rule this run already had: the saved policy denies it outright.
  let rerun = fun rule ->
    let granted =
      LanguageTools.Permissions.parseRuleText(rule)
      |> Stdlib.Option.map(fun rules ->
        Stdlib.List.all(rules, fun r -> Stdlib.List.contains(allow, r)))
      |> Stdlib.Option.withDefault(false)
    if granted then Stdlib.Option.Option.None
    else Stdlib.Option.Option.Some(rerunAllowing(scriptPath, args, options, allow, rule))
  let newState = handleResult(state, result, options, offerApproval, rerun)

  match measurement with
  | Some(m) ->
    // stdout, after whatever the script printed, as `eval --stats` does.
    let _ = Stdlib.printLine("")
    let _ = Stdlib.printLine(LanguageTools.Perf.render(m))
    let _ =
      Stdlib.printLine(
        "  (includes parsing the script; Perf.measure inside it brackets execution alone)")

    newState
  | None -> newState


/// A shell word for <param word>: as it is when nothing in it needs quoting, else quoted. A rule
/// that already single-quotes its URL or path goes in double quotes, unless something in it would
/// expand there.
let shellWord(word: String): String =
  let plain =
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-./:=@%+,"
  let isPlain =
    word != ""
    && (Stdlib.String.toList(word)
        |> Stdlib.List.all(fun c -> Stdlib.String.contains(plain, Stdlib.toString(c))))
  let expands =
    [ "$", "`", "\\", "\"", "!" ] |> Stdlib.List.any(fun c -> Stdlib.String.contains(word, c))
  if isPlain then word
  else if Stdlib.String.contains(word, "'") && Stdlib.Bool.not(expands) then "\"" + word + "\""
  else LanguageTools.Permissions.quoteToken(word)


/// The command that reruns this run with <param rule> allowed too, for a denial's hint: the same
/// options, the `--allow` rules it already had, the path or function, and its arguments.
let rerunAllowing(
  scriptPath: String,
  args: List<String>,
  options: Darklang.Tracing.ScriptOptions,
  allow: List<LanguageTools.Permissions.Rule>,
  rule: String)
  : String =
  let flag(on: Bool, name: String): List<String> = if on then [ name ] else []
  let allowFlags =
    Stdlib.List.concat(
      allow |> Stdlib.List.map(LanguageTools.Permissions.renderRule),
      [ rule ])
    |> Stdlib.List.map(fun r -> "--allow " + shellWord(r))
  let path = if isFlag(scriptPath) then [ "--", shellWord(scriptPath) ] else [ shellWord(scriptPath) ]
  Stdlib.List.flatten(
    [ [ "dark run" ]
      flag(options.allowHarmful, "--allow-harmful")
      flag(options.warnPermissions, "--warn-permissions")
      allowFlags
      path
      args |> Stdlib.List.map(shellWord) ])
  |> Stdlib.String.join(" ")


/// Report what <fn parseAndExecute> returned, and offer to save a denied permission.
/// <param rerun> is the command that reruns with a rule allowed, for the hint, when there is one.
let handleResult(
  state: AppState,
  result: Stdlib.Result.Result<(Int64 *
                                List<(String * String * Stdlib.Option.Option<String>)>),
                               ExecutionError.ExecutionError>,
  options: Darklang.Tracing.ScriptOptions,
  offerApproval: Bool,
  rerun: String -> Stdlib.Option.Option<String>)
  : AppState =
  match result with
  | Ok((exitCode, violations)) ->
    match permissionWarningLines(violations) with
    | [] -> ()
    | lines -> lines |> Stdlib.List.iter(fun l -> Stdlib.printErrorLine(l))
    // The script chose this code and printed its own reason, as a program in any language does.
    { state with exitCode = exitCode }
  | Error(Denied(denied)) ->
    let canAsk =
      offerApproval
      && Stdlib.Bool.not(options.sandbox)
      && Stdlib.Bool.not(options.warnPermissions)
      && Stdlib.Cli.UI.Prompt.canAsk()
    match denied.rule with
    | Some(rule) when canAsk ->
      match LanguageTools.Permissions.parseRuleText(rule) with
      | Some(rules) ->
        Stdlib.printErrorLine(
          (Stdlib.Cli.UI.Colors.warning(
            $"The script stopped: the instance policy does not allow {denied.resource}. Earlier effects may already have happened.")))
        let choice =
          Stdlib.Option.withDefault(
            Stdlib.Cli.UI.Prompt.select($"Allow `{rule}`?", [ denyChoice(), allowAlways() ]),
            denyChoice())
        if choice == allowAlways() then
          Darklang.Cli.Permissions.Command.editInstancePolicy(rules, [], [])
          Stdlib.printErrorLine("Permission saved. The script has not restarted; rerun it explicitly when ready.")
          { state with exitCode = 1 }
        else
          printDenied(state, denied, offerApproval, rerun)
      | None -> printDenied(state, denied, offerApproval, rerun)
    | _ -> printDenied(state, denied, offerApproval, rerun)
  | Error(e) -> printScriptError(state, e)


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] ->
    let files = Stdlib.Cli.FileSystem.getDirectoryContents(".")
    let currentDir = Stdlib.Cli.FileSystem.currentDirectory()

    let directories =
      files
      |> Stdlib.List.filter(fun name ->
        Stdlib.Cli.FileSystem.isDirectoryAtPath(currentDir, name))

    let darkFiles =
      files |> Stdlib.List.filter(fun name -> Stdlib.String.endsWith(name, ".dark"))

    let allFiles = Stdlib.List.concat(directories, darkFiles)
    allFiles |> Stdlib.List.map(Completion.simple)

  | [ partialArg ] ->
    (Darklang.Cli.Completion.completeFilesystemPath(partialArg))
    |> Stdlib.List.map(Completion.simple)

  | _ -> []


let help(_state: AppState): String =
  [ "Usage: run-script [options] <path or function> [args...]"
    "Execute a Dark script file, or a package function by name."
    ""
    "Examples:"
    "  run-script script.dark            - Run a script"
    "  run-script script.dark a b c      - Run with args"
    "  run-script --stats script.dark    - Run and report what it cost"
    "  run-script --allow 'http GET https://api.github.com' script.dark"
    "                                    - Run with one more permission, this time only"
    ""
    "Everything after the path is passed unchanged, including flags and --."
    "See `docs scripts` for arguments, exit codes and permissions."
    ""
    "Flags (before the path):"
    "  --sandbox          - Add a deny-all run policy (not OS containment)."
    "                       By default a script runs under your instance policy (see `permissions`)."
    "  --warn-permissions - UNSAFE audit mode: let requests beyond the run and package"
    "                       policies run and report them; the instance policy and function"
    "                       ceilings still deny. Not with --sandbox."
    "  --allow <rule>     - Allow one more rule for this run only, written as for"
    "                       `permissions allow`; repeatable. Nothing is saved, and the"
    "                       instance policy's deny rules still win. Not with --sandbox."
    "  --allow-harmful    - Opt out of Harmful-deprecation halting."
    "  --stats            - Also report what the run cost: allocation, time, instructions,"
    "                       calls and frame pushes, net of the measuring harness, tagged"
    "                       with the build they came from. Includes parsing the script;"
    "                       call Perf.measure inside it to measure the work alone."
    ""
    "A function as a command: a package function runs the same way, by name, when it"
    "takes a List<String> or nothing. The words after its name are the list, and the"
    "Int64 it returns is the exit code (Unit is 0):"
    "  let main(args: List<String>): Int64 = ...    // saved as Me.Todo.main"
    "  run-script Me.Todo.main add \"oat milk\"      // args = [\"add\", \"oat milk\"]"
    "A function with other parameters goes through eval." ]
  |> Stdlib.String.join("\n")
