module Darklang.Cli.Run

/// Command options. Temporary grants are never stored in a trace.
type Options =
  { allowHarmful: Bool
    sandbox: Bool
    grants: LanguageTools.Permissions.Policy }


/// Whether a protected operation the policy does not cover asks the user, or is just denied.
type Approval =
  | Offer
  | Skip


/// Unit succeeds; BigInt and Int64 supply the script's exit code.
let exitCode(value: LanguageTools.RuntimeTypes.Dval): Result<Int64, ExecutionError.ExecutionError> =
  match value with
  | DUnit -> Result.Ok(0)
  | DInt64(code) -> Result.Ok(code)
  // a `BigInt` past Int64 is no exit code the OS could carry, so it fails like any other
  | DBigInt(code) -> Result.Ok(Stdlib.BigInt.toInt64(code) |> Stdlib.Option.withDefault(1))
  | _ ->
    Result.Error(
      ExecutionError.ExecutionError.Runtime(
        LanguageTools.RuntimeTypes.RuntimeError.Error.CLI(
          LanguageTools.RuntimeTypes.RuntimeError.CLIs.Error.NonIntReturned(value)),
        [],
        []))


/// Run a script under its permissions and return its exit code.
let parseAndExecute(
  accountID: Option<Uuid>,
  branchId: Uuid,
  filename: String,
  code: String,
  args: List<String>,
  options: Options,
  approval: Approval,
  traceId: Uuid)
  : Result<Int64, ExecutionError.ExecutionError> =
  let result =
    Builtin.cliParseAndExecuteScript(
      accountID,
      branchId,
      filename,
      code,
      args,
      options.allowHarmful,
      options.sandbox,
      options.grants,
      (match approval with
       | Offer when Stdlib.Bool.not(options.sandbox) && Stdlib.Cli.UI.Prompt.canAsk() ->
         Option.Some(askPermission)
       | _ -> Option.None),
      Option.Some(traceId))

  match result with
  | Ok(value) -> exitCode(value)
  | Error(error) -> Result.Error(error)


// `run-script <path> [args...]` — execute a Dark script file, or a package function by name.

/// Split runner options from the script path and its arguments. Everything after the path stays
/// with the script, flags included; `--` ends the options and stays with them. The same rule as the
/// host's `ScriptArguments.split`, which splits the command line before any Dark runs.
let splitArguments(args: List<String>): (List<String> * List<String>) =
  splitArgumentsAfter([], args)


/// The split of <param remaining>, with <param options> (newest first) already taken.
let splitArgumentsAfter(
  options: List<String>,
  remaining: List<String>)
  : (List<String> * List<String>) =
  match remaining with
  | ["--", ...rest] -> (Stdlib.List.reverse(Stdlib.List.prepend(options, "--")), rest)
  | [flag, value, ...rest]
    when flag == "--branch" || flag == "--entry-point" || flag == "--allow" ->
    splitArgumentsAfter(Stdlib.List.prepend(Stdlib.List.prepend(options, flag), value), rest)
  | [flag, ...rest] when isFlag(flag) ->
    splitArgumentsAfter(Stdlib.List.prepend(options, flag), rest)
  | _ -> (Stdlib.List.reverse(options), remaining)


/// Whether <param arg> starts with a `-`. By its first byte, not its first character, so a `-`
/// that a combining mark follows still counts, as it does for the host.
let isFlag(arg: String): Bool =
  arg != "-" && Stdlib.String.getByteAt(arg, 0) == Option.Some(45u8)


let execute(state: AppState, args: List<String>): AppState =
  let (options, script) = splitArguments(args)
  let asksForHelp =
    Stdlib.List.contains(options, "--help")
    || Stdlib.List.contains(options, "-h")
    || Stdlib.List.head(args) == Option.Some("help")

  if asksForHelp then
    Registry.executeCommandHelp("run-script", state)
  else
    executeOptions(
      state,
      options,
      script,
      Options
        { allowHarmful = false
          sandbox = false
          grants = LanguageTools.Permissions.Policy { allow = [], deny = [] } },
      false)


/// Parse the options before the script path. <param stats> is `--stats`: kept out of
/// `ScriptOptions` because those are saved with the trace for replay, and a replay has no reason
/// to report what the original cost.
let executeOptions(
  state: AppState,
  flags: List<String>,
  script: List<String>,
  options: Options,
  stats: Bool)
  : AppState =
  match flags with
  | ["--allow-harmful", ...rest] ->
    executeOptions(state, rest, script, { options with allowHarmful = true }, stats)
  | ["--sandbox", ...rest] ->
    executeOptions(state, rest, script, { options with sandbox = true }, stats)
  | ["--allow", rules, ...rest] ->
    match Permissions.Command.replacePolicy([ rules ]) with
    | Error(message) ->
      printErr(message)
      failed(state)
    | Ok(grants) when Stdlib.Bool.not(Stdlib.List.isEmpty(grants.deny)) ->
      printErr(
        "--allow takes allow rules only; use --sandbox, or `permissions deny` for the instance policy")

      failed(state)
    | Ok(grants) ->
      let merged =
        LanguageTools.Permissions.Policy
          { allow = Stdlib.List.concat(options.grants.allow, grants.allow), deny = [] }

      executeOptions(state, rest, script, { options with grants = merged }, stats)
  | ["--stats", ...rest] -> executeOptions(state, rest, script, options, true)
  | [] | ["--"] ->
    match script with
    | ["-", ...scriptArgs] -> executeStdinScript(state, scriptArgs, options, stats)
    | [scriptPath, ...scriptArgs] -> executeScript(state, scriptPath, scriptArgs, options, stats)
    | [] ->
      Stdlib.printLine(help(state))
      failed(state)
  | [flag, ...] ->
    Stdlib.printErrorLine(
      $"Unknown run-script option: {flag}. Put script arguments after the file path; use -- before a path starting with '-'.")

    failed(state)


// Recognize a dotted package name so `run` can suggest `eval` instead of
// reporting an unhelpful "script not found" error.
let looksLikePackageName(path: String): Bool =
  Stdlib.String.contains(path, ".")
  && (Stdlib.String.contains(path, "/") |> Stdlib.Bool.not)
  && (Stdlib.String.endsWith(path, ".dark") |> Stdlib.Bool.not)


/// `run -`: the script is standard input.
let executeStdinScript(
  state: AppState,
  args: List<String>,
  options: Options,
  stats: Bool)
  : AppState =
  match Stdlib.Cli.Stdin.readAll() with
  | Error(message) ->
    printErr(message)
    failed(state)
  | Ok(source) -> runScriptMeasured(state, "-", source, args, options, Approval.Offer, stats)


let isNotFound(e: Stdlib.Cli.Posix.Error): Bool =
  Stdlib.Cli.Posix.Error.kind(e) == Stdlib.Cli.Posix.ErrorKind.NotFound


let executeScript(
  state: AppState,
  scriptPath: String,
  args: List<String>,
  options: Options,
  stats: Bool)
  : AppState =
  match Stdlib.Cli.FileSystem.readFile(scriptPath) with
  | Error(e) when isNotFound(e) && looksLikePackageName(scriptPath) ->
    executePackageFn(state, scriptPath, args, options, stats)
  | Error(e) ->
    match Stdlib.Cli.Posix.Error.kind(e) with
    | NotFound | NotADirectory -> Stdlib.printErrorLine($"Script not found: {scriptPath}")
    | PermissionDenied -> Stdlib.printErrorLine($"Permission denied: {scriptPath}")
    | _ -> Stdlib.printErrorLine($"Could not read script {scriptPath}: {Stdlib.display(e)}")

    // Every branch above printed a reason the script did not run, so this is a failure. Saying
    // so in the exit code is the only part a script or an agent can read.
    { state with exitCode = 1 }
  | Ok(script) ->
    let scriptSourceCode = Stdlib.Utf8.decodeWithReplacement(script)
    runScriptMeasured(state, scriptPath, scriptSourceCode, args, options, Approval.Offer, stats)


/// Run the package function <param name> the way a script runs: under the same policy, with
/// <param args> as its argument, and its Int64 result as the exit code. A function that takes
/// nothing is called with `()`; one with other parameters is refused with its signature.
let executePackageFn(
  state: AppState,
  name: String,
  args: List<String>,
  options: Options,
  stats: Bool)
  : AppState =
  let branchId = state.currentBranchId
  let fnName = TraceVerbs.canonicalFnName(branchId, name)
  let location = LanguageTools.ProgramTypes.parsePackageLocation(fnName)
  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | None ->
    Stdlib.printErrorLine($"No script file or function named {name}")
    { state with exitCode = 1 }
  | Some(hash) ->
    let deprecation =
      LanguageTools.PackageManager.currentDeprecation(
        branchId,
        location,
        hash,
        LanguageTools.ProgramTypes.ItemKind.Fn)

    match deprecation with
    | Some((WithReplacement(reference), _)) ->
      let replacement = Packages.View.resolveReplacementName(branchId, reference)
      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.warning(
          $"Warning: {fnName} is deprecated. Use {replacement} instead."))
    | Some(_) ->
      Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.warning($"Warning: {fnName} is deprecated."))
    | None -> ()

    match LanguageTools.PackageManager.Function.getSignature(hash) with
    | Some(fn) ->
      match fn.parameters |> Stdlib.List.map(fun p -> p.typ) with
      | [] | [TUnit] -> runNullary(state, name, fnName, args, options, stats)
      | [TList(TString)] ->
        runScriptMeasured(state, fnName, $"{fnName}(args)", args, options, Approval.Offer, stats)
      | _ ->
        let modulePath = Stdlib.List.prepend(location.modules, location.owner)
        let ctx = Packages.Signatures.rootContext(branchId, modulePath)
        let shown =
          fn.parameters
          |> Stdlib.List.map(fun p ->
            $"{p.name}: {PrettyPrinter.ProgramTypes.typeReference(ctx, p.typ)}")
          |> Stdlib.String.join(", ")

        Stdlib.printErrorLine(
          $"{name} takes ({shown}); `run` passes the words as a List<String>. Call it with: dark eval '{name}(…)'")

        { state with exitCode = 1 }
    | None ->
      runScriptMeasured(state, fnName, $"{fnName}(args)", args, options, Approval.Offer, stats)


/// <fn executePackageFn> for a function that takes nothing.
let runNullary(
  state: AppState,
  name: String,
  fnName: String,
  args: List<String>,
  options: Options,
  stats: Bool)
  : AppState =
  match args with
  | [] -> runScriptMeasured(state, fnName, $"{fnName}()", args, options, Approval.Offer, stats)
  | _ ->
    Stdlib.printErrorLine($"{name} takes no arguments")
    { state with exitCode = 1 }


/// The host supplies these exact requests; guest text cannot supply approval rules.
let askPermission(request: (String * List<String>)): Int64 =
  let (name, rules) = request
  Stdlib.printErrorLine($"{name} needs access:")
  Stdlib.List.iter(rules, fun rule -> Stdlib.printErrorLine("  " + rule))
  let fileRules =
    rules
    |> Stdlib.List.filterMap(LanguageTools.Permissions.parseRuleText)
    |> Stdlib.List.flatten

  let coversChildren = Stdlib.List.any(fileRules, fun rule ->
    match rule with
    | FileRead(Only(path)) | FileWrite(Only(path)) -> Stdlib.Cli.FileSystem.isDirectory(path)
    | FileRead(_) | FileWrite(_) -> true
    | _ -> false)

  let writes = Stdlib.List.any(fileRules, fun rule ->
    match rule with
    | FileWrite(_) -> true
    | _ -> false)

  let fileNote =
    [ (coversChildren, "File paths include children.")
      (writes, "Write access includes creating, overwriting and deleting.") ]
    |> Stdlib.List.filterMap(fun((shown, note)) -> if shown then Option.Some(note) else Option.None)

  if Stdlib.List.isEmpty(fileNote) then
    ()
  else
    Stdlib.printErrorLine(Stdlib.String.join(fileNote, " "))

  if Stdlib.List.any(rules, fun rule -> Stdlib.String.startsWith(rule, "http ")) then
    Stdlib.printErrorLine(
      "HTTP access covers only the exact path shown. Any query is allowed unless one is shown.")
  else
    ()

  if Stdlib.List.any(rules, fun rule -> Stdlib.String.startsWith(rule, "process-exact ")) then
    Stdlib.printErrorLine(
      "process-exact permits only the listed arguments; none listed means no arguments.")
  else
    ()

  let once = "Allow this run"
  let remember = "Remember for this code version"
  let cancel = "Cancel"
  match Stdlib.Cli.UI.Prompt.select(
          "Choose how long to allow this access:",
          [ once, remember, cancel ]) with
  | Some(choice) when choice == once -> 1
  | Some(choice) when choice == remember -> 2
  | _ ->
    Stdlib.printErrorLine("Cancelled. No new permissions were saved by this prompt.")
    0


let printScriptError(state: AppState, e: ExecutionError.ExecutionError): AppState =
  match e with
  // The prompt already said so.
  | Cancelled -> ()
  | Denied(_) ->
    Stdlib.printErrorLine(
      ExecutionError.formatForTerminal(state.accountID, state.currentBranchId, e))
  | _ ->
    ExecutionError.printCallStack(state.currentBranchId, e)
    let pretty = ExecutionError.formatForTerminal(state.accountID, state.currentBranchId, e)
    Stdlib.printErrorLine($"Script error: {pretty}")

  { state with exitCode = 1 }


/// Run a script with exact access review before protected operations.
/// Interactive grants never restart the script or repeat earlier work.
let runScript(
  state: AppState,
  scriptPath: String,
  code: String,
  args: List<String>,
  options: Tracing.ScriptOptions,
  approval: Approval)
  : AppState =
  let invocation =
    Options
      { allowHarmful = options.allowHarmful
        sandbox = options.sandbox
        grants = LanguageTools.Permissions.Policy { allow = [], deny = [] } }

  runScriptMeasured(state, scriptPath, code, args, invocation, approval, false)


/// <fn runScript>, and with <param stats> also what the run cost, the same block `eval --stats`
/// prints. Interactive permission review time is included; use pre-approved access
/// when measuring execution.
let runScriptMeasured(
  state: AppState,
  scriptPath: String,
  code: String,
  args: List<String>,
  options: Options,
  approval: Approval,
  stats: Bool)
  : AppState =
  let traceId = Stdlib.Uuid.generate()
  let run = fun () ->
    parseAndExecute(
      state.accountID,
      state.currentBranchId,
      scriptPath,
      code,
      args,
      options,
      approval,
      traceId)

  let (measurement, result) =
    if stats then
      // What the script cost, net of the measuring harness itself: see Perf.floor.
      let harness = LanguageTools.Perf.floor()
      let (raw, result) = LanguageTools.Perf.measure(run)
      (Option.Some(LanguageTools.Perf.minus(raw, harness)), result)
    else
      (Option.None, run())

  let newState = handleResult(state, result)
  match result with
  | Error(Cancelled) | Ok(_) -> ()
  | Error(_) -> Cli.Tracing.printFailedTrace(state.currentBranchId, traceId)

  noteMisplacedAllow(newState, scriptPath, args)
  match measurement with
  | Some(m) ->
    // stderr, as `eval --stats` does, so stdout carries only what the script printed.
    let _ = Stdlib.printErrorLine("")

    let _ = Stdlib.printErrorLine(LanguageTools.Perf.render(m))

    let _ =
      Stdlib.printErrorLine(
        "  (includes parsing the script; Perf.measure inside it brackets execution alone)")

    newState
  | None -> newState


/// A failed run whose arguments hold `--allow` most likely meant it for `run`: everything after
/// the name goes to the program, so the access was never granted.
let noteMisplacedAllow(state: AppState, name: String, args: List<String>): Unit =
  let misplaced =
    Stdlib.List.any(args, fun arg -> arg == "--allow" || Stdlib.String.startsWith(arg, "--allow="))

  if state.exitCode != 0 && misplaced then
    Stdlib.printErrorLine(
      $"Note: `--allow` came after {name}, so the program got it as an argument. Flags for `run` go before the name: dark run --allow \"<rules>\" {name} …")
  else
    ()


/// Report the completed run. Permission review happens before the operation.
let handleResult(state: AppState, result: Result<Int64, ExecutionError.ExecutionError>): AppState =
  match result with
  | Ok(exitCode) when exitCode >= 0 && exitCode <= 255 ->
    // The script chose this code and printed its own reason, as a program in any language does.
    { state with exitCode = exitCode }
  | Ok(exitCode) ->
    // the OS keeps only the low 8 bits, so 256 would read as success
    Stdlib.printErrorLine(
      $"Script returned {Stdlib.display(exitCode)}, but an exit code must be 0-255.")

    { state with exitCode = 1 }
  | Error(e) -> printScriptError(state, e)


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] ->
    let files = Stdlib.Cli.FileSystem.getDirectoryContents(".")
    let currentDir = Stdlib.Cli.FileSystem.currentDirectory()
    let directories =
      files
      |> Stdlib.List.filter(fun name -> Stdlib.Cli.FileSystem.isDirectoryAtPath(currentDir, name))

    let darkFiles = files |> Stdlib.List.filter(fun name -> Stdlib.String.endsWith(name, ".dark"))
    let allFiles = Stdlib.List.concat(directories, darkFiles)
    allFiles |> Stdlib.List.map(Completion.simple)
  | [partialArg] ->
    Completion.completeFilesystemPath(partialArg) |> Stdlib.List.map(Completion.simple)
  | _ -> []


let help(_state: AppState): String =
  [ "Usage: run-script [options] <function or path> [args...]"
    "Run a package function by name, or a Dark script file."
    ""
    "A package function runs by name when it takes a List<String> or nothing."
    "The words after its name are the list, and the Int64 it returns is the"
    "exit code (Unit is 0). It reads stdin and files as a script does:"
    "  let main(args: List<String>): Int64 = ...    // saved as Me.Todo.main"
    "  run-script Me.Todo.main add \"oat milk\"      // args = [\"add\", \"oat milk\"]"
    "A function with other parameters goes through eval."
    ""
    "Examples:"
    "  run-script Me.Todo.main list      - Run a package function"
    "  run-script script.dark a b c      - Run a script file with args"
    "  run-script --stats script.dark    - Run and report what it cost"
    "  run-script - a b < script.dark    - Read the script from stdin"
    ""
    "Everything after the name or path is passed unchanged, including flags and --."
    "A program you will run again goes in a module with tests: `docs for-ai`."
    "A script file is for a quick one-off; `test run script.dark` runs its tests: `docs scripts`."
    ""
    "At a terminal: Allow this run / Remember for this code version / Cancel."
    "Access Dark can see before starting is reviewed in one prompt; other access"
    "asks again before its operation, so a run can ask more than once."
    "Remembered access belongs to this entry, not every program."
    "Without a terminal, grant access in advance or use --allow."
    ""
    "Flags (before the path):"
    "  --allow <rules>    - Allow resources for this run only (; separates rules)."
    "  --sandbox          - Add a deny-all run policy (not OS containment)."
    "                       By default a script runs under your instance policy (see `permissions`)."
    "  --allow-harmful    - Opt out of Harmful-deprecation halting."
    "  --stats            - Also report what the run cost: allocation, time, instructions,"
    "                       calls and frame pushes, net of the measuring harness, tagged"
    "                       with the build they came from. Includes parsing the script;"
    "                       call Perf.measure inside it to measure the work alone." ]
  |> Stdlib.String.join("\n")
