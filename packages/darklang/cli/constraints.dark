module Darklang.Cli.ConstraintsCmd

// `dark constraints` -- standing checks over the store, and what you've decided about them.
//
// Three kinds today (`SCM.Constraints.Kind`), all of them cases of one command rather than commands of
// their own, because they share the whole detect / record / ack lifecycle and differ only in what a
// resolution would mean. The next one should be a case too.
//
// Checks you RUN rather than warnings at commit: in a distributed store, usages on non-current versions are
// the normal steady state. Another machine's caller of your fn cannot be propagated to and must not
// silently repoint when you sync, so reporting it at commit reports a permanent condition every time.
//
// TWO AUDIENCES. A person resolves two or three findings and wants to read them; an agent reconciling
// hundreds wants `--json` in and `--all` out, with no table to parse.
//
// Bulk applies to ACKING, not resolving. "Leave it, I've seen it" means the same for every finding, so it
// takes a list and lives at the root as `dark ack`. A resolution means something different per kind, so
// `resolve` makes you name it with `--as` once there is more than one to choose from.
//
// All SQL is siloed in `SCM.Constraints`; this file writes NO SQL, it only formats.

/// A propagation choice, as a word.
let policyName (p: LanguageTools.ProgramTypes.PropagationPolicy) : String =
  match p with
  | Pin -> "pin"
  | Follow -> "follow"
  | Unset -> "unset"


/// One finding, as two lines: who, and what about them.
///
/// A kind change reads differently on purpose: the usage is not behind, it points at a different KIND
/// of thing that happened to hold the name, and it still works. That is "know about this" rather than
/// "go fix this".
let line (f: SCM.Constraints.Finding) : String =
  let u = SCM.Constraints.fqnOf f.usage
  let d = SCM.Constraints.fqnOf f.dependency

  match (f.kind, f.detail) with
  | (KindChanged, _) ->
    let was = SCM.Deps.kindString f.dependencyKind
    $"  #{f.id}  {u}\n         uses {d} as a {was}; that name is something else now (still resolves, by hash)"
  | (StaleUsage, Versions(using, current)) ->
    $"  #{f.id}  {u}\n         still on the version it was written against ({Cli.shortHash using}); {d} is at {Cli.shortHash current} now"
  // Its own sentence: `dependency` is the location itself here, so the stale-usage phrasing ("uses X")
  // would read as if the name called itself.
  | (DecisionSuperseded, Versions(using, current)) ->
    $"  #{f.id}  {u}\n         you overrode this to the version you chose ({Cli.shortHash using}); a later edit rebound it to {Cli.shortHash current}"
  | (DecisionSuperseded, PolicyReplaced(was, now, by)) ->
    let whose = if by == "" then "a later choice" else by

    $"  #{f.id}  {u}\n         you chose {policyName was} here; {whose} replaced it with {policyName now}"
  | (_, _) -> $"  #{f.id}  {u}"


/// The same data the human view renders, not a subset. If an agent ever has to fall back to parsing the
/// pretty output for one field, this is incomplete and that's a bug, not a workaround.
let toJson (f: SCM.Constraints.Finding) : String =
  let k = Cli.jsonStr (SCM.Constraints.kindToString f.kind)
  let u = Cli.jsonStr (SCM.Constraints.fqnOf f.usage)
  let d = Cli.jsonStr (SCM.Constraints.fqnOf f.dependency)
  let uk = Cli.jsonStr (SCM.Deps.kindString f.usageKind)
  let dk = Cli.jsonStr (SCM.Deps.kindString f.dependencyKind)

  // The varying half is named for what it IS, so an agent reading this does not have to know that a
  // policy finding puts policy names in fields called `using` and `current`.
  let detail =
    match f.detail with
    | Versions(using, current) ->
      let usingStr = Cli.jsonStr (LanguageTools.ProgramTypes.hashToString using)
      let curStr = Cli.jsonStr (LanguageTools.ProgramTypes.hashToString current)
      $"\"using\":{usingStr},\"current\":{curStr}"
    | PolicyReplaced(was, now, by) ->
      $"\"was\":{Cli.jsonStr (policyName was)},\"now\":{Cli.jsonStr (policyName now)},\"replacedBy\":{Cli.jsonStr by}"

  $"{{\"id\":{Cli.jsonStr f.id},\"kind\":{k},\"usage\":{u},\"usageKind\":{uk},\"dependency\":{d},\"dependencyKind\":{dk},{detail}}}"


let selectKind
  (findings: List<SCM.Constraints.Finding>)
  (args: List<String>)
  : List<SCM.Constraints.Finding> =
  match Stdlib.List.findFirstIndex args (fun a -> a == "--kind") with
  | Some i ->
    match Stdlib.List.getAt args (i + 1) with
    | Some wanted ->
      findings
      |> Stdlib.List.filter (fun f ->
        SCM.Constraints.kindToString f.kind == wanted)
    | None -> findings
  | None -> findings


/// The `--kind` value, checked: `Error` explains rather than silently filtering to nothing on a typo,
/// and a bare `--kind` is a missing value, not an unknown flag.
let kindArgChecked (args: List<String>) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.List.findFirstIndex args (fun a -> a == "--kind") with
  | None -> Stdlib.Result.Result.Ok()
  | Some i ->
    match Stdlib.List.getAt args (i + 1) with
    | None ->
      Stdlib.Result.Result.Error
        "--kind needs a value: stale-usage, kind-changed, or decision-superseded."
    | Some wanted ->
      match SCM.Constraints.kindFromString wanted with
      | Some _ -> Stdlib.Result.Result.Ok()
      | None ->
        Stdlib.Result.Result.Error
          $"\"{wanted}\" isn't a kind -- stale-usage, kind-changed, or decision-superseded."


let executeJson (state: AppState) (args: List<String>) : AppState =
  let detected = SCM.Constraints.pending ()
  let findings = selectKind detected.findings args
  let body = findings |> Stdlib.List.map toJson |> (fun ls -> Stdlib.String.join ls ",")

  // Add-only, normally `[]`. Without it an agent reads "we didn't look" as "nothing to see".
  let blocked =
    detected.blocked
    |> Stdlib.List.map (fun b -> Stdlib.Json.serialize<String> b)
    |> (fun ls -> Stdlib.String.join ls ",")

  Stdlib.printLine $"{{\"findings\":[{body}],\"blocked\":[{blocked}]}}"
  state


let executeList (state: AppState) (args: List<String>) : AppState =
  let detected = SCM.Constraints.pending ()

  // Before the findings: "no constraints" is a claim about what was checked.
  let _ =
    detected.blocked
    |> Stdlib.List.iter (fun b ->
      Cli.printErr $"couldn't check everything: {b}")

  match selectKind detected.findings args with
  | [] ->
    // Says what was CHECKED, not just that nothing turned up, and short enough for a narrow terminal.
    if Stdlib.List.isEmpty detected.blocked then
      Cli.printOk "no constraints: nothing has drifted off its current version."
    else
      Cli.printOk "nothing found by the checks that DID run."

    state
  | findings ->
    Cli.printOk (Cli.Text.plural (Stdlib.List.length findings) "constraint")
    findings |> Stdlib.List.iter (fun f -> Stdlib.printLine (line f))
    Stdlib.printLine ""

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.hint
        "  dark ack <id>... [--why ...]   leave for now (`dark ack --all` for every one)")

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.hint
        "  dark constraints resolve <id>... [--as <how>]   fix it now, naming the fix")

    // A pin says a REFERENCE is deliberate, which is what every finding here describes, so it belongs
    // beside the other two verbs whenever there is anything on screen for it to answer.
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.hint
        "  dark propagate pin <name>          leave it for good; a pin is already a durable ack")

    state


/// Findings matching the ids given, or every pending one under `--all`.
///
/// Unknown ids are REPORTED and skipped rather than aborting the batch. An agent that has to bisect a failed
/// batch to find the one bad target is worse off than one that made N calls in the first place.
let selectTargets
  (ids: List<String>)
  : (List<SCM.Constraints.Finding> * List<String>) =
  // `detectAll` re-runs detection so a prefix can match a finding that has never been listed; `pending`
  // is enough for `--all`, which means "everything currently outstanding".
  if Stdlib.List.member ids "--all" then
    ((SCM.Constraints.pending ()).findings, [])
  else
    let all = (SCM.Constraints.detectAll ()).findings

    // Findings are printed as `#1d8740cd`, so a pasted id arrives with the `#`. Accept what we print.
    let normalize (i: String) : String =
      if Stdlib.String.startsWith i "#" then Stdlib.String.dropFirst i 1 else i

    // An EMPTY prefix must not match. `startsWith f.id ""` is true of every finding, so `dark ack ""`
    // would ack the first one: a mutation, chosen arbitrarily, from an argument that says nothing. It is
    // an unknown id, which reports and skips.
    // Flag VALUES are not targets: `--why` swallows the rest of the line (its text needn't be
    // quoted), and `--as` takes the one token after it. Without this, `resolve <id> --as repoint`
    // reports "no constraint matching \"repoint\"".
    let beforeWhy =
      match Stdlib.List.findFirstIndex ids (fun a -> a == "--why") with
      | Some i -> Stdlib.List.take ids i
      | None -> ids

    let withoutAsValue =
      match Stdlib.List.findFirstIndex beforeWhy (fun a -> a == "--as") with
      | Some i ->
        Stdlib.List.append
          (Stdlib.List.take beforeWhy i)
          (Stdlib.List.drop beforeWhy (i + 2))
      | None -> beforeWhy

    let real =
      withoutAsValue
      |> Stdlib.List.filter (fun i -> Stdlib.String.startsWith i "--" |> Stdlib.Bool.not)
      |> Stdlib.List.map normalize

    let matches (idPrefix: String) : Stdlib.Option.Option<SCM.Constraints.Finding> =
      if idPrefix == "" then
        Stdlib.Option.Option.None
      else
        all |> Stdlib.List.findFirst (fun f -> Stdlib.String.startsWith f.id idPrefix)

    let found = real |> Stdlib.List.filterMap matches

    let missing =
      real |> Stdlib.List.filter (fun idPrefix -> matches idPrefix |> Stdlib.Option.isNone)

    (found, missing)


/// `--why <text>`, or everything after `--why` when it wasn't quoted.
let whyFrom (args: List<String>) : String =
  match Stdlib.List.findFirstIndex args (fun a -> a == "--why") with
  | Some i ->
    args |> Stdlib.List.drop (i + 1) |> (fun rest -> Stdlib.String.join rest " ")
  | None -> ""


/// Constraints are a property of the whole STORE, not of a branch: detection runs over main's live bindings
/// and their dependency edges, which a branch's overlay doesn't change. So there is nothing branch-scoped to
/// ack, and acking from a branch would record an answer to a question that wasn't asked there.
///
/// Propagation choices are different: they genuinely differ per branch (a branch may want a different
/// pin), so they're scoped by `branch_id`. An ack isn't like that -- if the finding is real it's real
/// everywhere, and one answer is the right number of answers.
let onBranch () : Bool =
  Stdlib.Bool.not (SCM.Branch.isMain (SCM.PackageOps.currentBranch ()))


let executeAck (state: AppState) (args: List<String>) : AppState =
  if onBranch () then
    Cli.printErr "constraints are a property of the store, not of a branch -- switch to main to ack."
    Cli.printHint "  detection runs over main's bindings, so there's nothing branch-local here to answer."
    state
  else
    let (targets, missing) = selectTargets args
    let why = whyFrom args

    missing
    |> Stdlib.List.iter (fun m -> Cli.printErr $"no constraint matching \"{m}\" -- skipped.")

    match targets with
    | [] ->
      if Stdlib.List.isEmpty missing then
        Cli.printOk "nothing to ack."
      else
        ()

      state
    | _ ->
      targets
      |> Stdlib.List.iter (fun f ->
        match SCM.Constraints.ack state.currentBranchId f why with
        | Ok _ -> Cli.printOk $"acked #{f.id}  {SCM.Constraints.fqnOf f.usage}"
        | Error e -> Cli.printErr $"couldn't ack #{f.id}: {e}")

      // Both lines are about REFERENCES, which is what every finding here describes.
      Cli.printHint "  an ack comes back if that item later moves to some other old version."
      Cli.printHint "  `dark propagate pin` instead, if it's deliberate for good."
      state


/// `--as <choice>`, naming which resolution to apply.
let chosenResolution (args: List<String>) : String =
  match Stdlib.List.findFirstIndex args (fun a -> a == "--as") with
  | Some i -> Stdlib.List.getAt args (i + 1) |> Stdlib.Option.withDefault ""
  | None -> ""

/// Every resolution a set of targets could take, deduped, in the order the kinds offer them.
let resolutionsAcross
  (targets: List<SCM.Constraints.Finding>)
  : List<String> =
  targets
  |> Stdlib.List.map (fun f -> SCM.Constraints.resolutionsFor f.kind)
  |> Stdlib.List.flatten
  |> Stdlib.List.dedup

/// Can this batch proceed without being told which resolution to apply?
///
/// Only when every target offers exactly one, and it's the same one. Acking in bulk is fine because "leave
/// it" means one thing everywhere; RESOLVING in bulk is only fine when there is nothing to choose. As soon
/// as a kind offers two, or a batch spans kinds that resolve differently, the caller has to say what it
/// means -- otherwise the command picks on its behalf and calls that a resolution.
let resolutionFor
  (targets: List<SCM.Constraints.Finding>)
  (args: List<String>)
  : Stdlib.Result.Result<String, String> =
  let choices = resolutionsAcross targets

  match chosenResolution args with
  | "" ->
    match choices with
    | [ only ] ->
      // One choice ACROSS the batch is not one choice for EVERY member: a batch mixing a stale
      // usage with a superseded decision unions to ["repoint"], and repointing the decision
      // finding is not a thing. Every target has to offer it, same as the `--as` arm checks.
      let cannot =
        targets
        |> Stdlib.List.filter (fun f ->
          (SCM.Constraints.offersResolution f.kind only) |> Stdlib.Bool.not)

      match cannot with
      | [] -> Stdlib.Result.Result.Ok only
      | fs ->
        let ids =
          fs |> Stdlib.List.map (fun f -> $"#{f.id}") |> (fun l -> Stdlib.String.join l " ")

        Stdlib.Result.Result.Error
          $"{ids} can't be resolved as \"{only}\" -- ack those, or resolve them separately."
    | [] ->
      let noun = if Stdlib.List.length targets == 1 then "this finding offers" else "these findings offer"
      Stdlib.Result.Result.Error $"{noun} no resolution."
    | many ->
      let list = Stdlib.String.join many " | "

      Stdlib.Result.Result.Error
        $"these findings can be resolved more than one way -- say which with `--as <{list}>`."
  | asked ->
    let unsupported =
      targets
      |> Stdlib.List.filter (fun f ->
        (SCM.Constraints.offersResolution f.kind asked) |> Stdlib.Bool.not)

    match unsupported with
    | [] -> Stdlib.Result.Result.Ok asked
    | fs ->
      let ids =
        fs |> Stdlib.List.map (fun f -> $"#{f.id}") |> (fun l -> Stdlib.String.join l " ")

      Stdlib.Result.Result.Error $"{ids} can't be resolved as \"{asked}\"."


/// RESOLVE: apply a named resolution. `repoint` runs the same cascade an ordinary edit runs, so everything
/// above the item moves too.
///
/// Gated on main like `ack`, for the same reason: detection runs over MAIN's bindings, so a resolution
/// authored from a branch would repoint main's caller onto the branch's overlay, where main cannot see it,
/// while the finding it answers stays open on main.
let executeResolve (state: AppState) (args: List<String>) : AppState =
  if onBranch () then
    Cli.printErr "constraints are a property of the store, not of a branch -- switch to main to resolve."
    Cli.printHint "  detection runs over main's bindings, so there's nothing branch-local here to answer."
    state
  else

  let (targets, missing) = selectTargets args

  missing
  |> Stdlib.List.iter (fun m -> Cli.printErr $"no constraint matching \"{m}\" -- skipped.")

  match targets with
  | [] ->
    if Stdlib.List.isEmpty missing then
      Cli.printOk "nothing to resolve."
    else
      ()

    state
  | _ ->

  match resolutionFor targets args with
  | Error e ->
    Cli.printErr e
    Cli.printHint "  `dark ack <id>...` leaves them for now, which needs no choice."
    state
  | Ok resolution ->
    targets
    |> Stdlib.List.iter (fun f ->
      // A pinned item would be repointed and then held by the pin on the next change, which reads as the
      // command not working. Say so instead of doing something that won't stick.
      if (SCM.Propagation.shouldFollow f.usage) |> Stdlib.Bool.not then
        Cli.printErr
          $"#{f.id}: {SCM.Constraints.fqnOf f.usage} is pinned -- `dark propagate follow` it first, which also catches it up."
      else
        match f.detail with
        | Versions(using, current) ->
          PropagateCmd.cascadeAndForce state f.dependency f.dependencyKind using current
        | PolicyReplaced(_, _, _) ->
          // Nothing to cascade: the finding is that a CHOICE was replaced, and the versions already
          // agree. Acking it is the whole answer.
          ()
        Cli.printOk
          $"resolved #{f.id} as \"{resolution}\"  {SCM.Constraints.fqnOf f.usage}")

    state


let help (_state: AppState) : String =
  [ ""
    "  Checks you RUN, not warnings at commit. Three kinds today:"
    ""
    "    stale-usage    a live item still uses a version that is not"
    "                   what the name means now. NORMAL in a distributed"
    "                   store: another machine's caller of your fn cannot"
    "                   be propagated to, and must not silently repoint"
    "                   when you sync. Usually you ack it, or pin it."
    "                   The only kind resolve can fix: --as repoint."
    "    kind-changed   the name is a different KIND of thing now, so"
    "                   the usage cannot be repointed at all. Ack it, or"
    "                   edit the usage yourself."
    "    decision-superseded"
    "                   a conflict override of yours was undone by a"
    "                   later ordinary edit. Ack it, or override again"
    "                   with `dark conflicts override`."
    ""
    "  dark constraints                     what's outstanding"
    "  dark constraints --kind <kind>       just one kind"
    "  dark constraints --json              the same, for agents"
    "  dark ack <id>... [--why W]           leave for now"
    "                                       (bulk: `dark ack --all`)"
    "  dark constraints resolve <id>... [--as C]   apply resolution C"
    ""
    "  Ack is bulk: \"leave it, I have seen it\" means the same for every"
    "  finding. Resolve is not -- it means something different per kind,"
    "  so it asks you to name one with --as when there is a choice."
    ""
    "  `dark propagate pin <name>` is a durable, syncable way to say a"
    "  REFERENCE is deliberate, and it suppresses a stale-usage finding"
    "  for good." ]
  |> Stdlib.String.join "\n"

/// `dark ack` -- the bulk verb at the root, because acking is the boring high-volume case and burying it
/// under a noun makes an agent type a subcommand to say "seen it".
let executeAckCmd (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] ->
    Cli.printErr "which findings? `dark ack <id>...`, or `dark ack --all`."
    Cli.printHint "  `dark constraints` lists them."
    state
  | _ -> executeAck state args

/// The arguments the listing understands. Anything else is refused rather than listed past: `dark
/// constraints zzznope` would otherwise answer with the whole list as though nothing had been asked.
let listingUnderstands (args: List<String>) : Bool =
  let understands (rest: List<String>) : Bool =
    match rest with
    | [] -> true
    | "--json" :: more -> understands more
    | [ "--kind" ] -> true
    | "--kind" :: _ :: more -> understands more
    | _ -> false

  understands args

let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | "resolve" :: rest -> executeResolve state rest
  | "ack" :: rest -> executeAck state rest
  | _ ->
    if Stdlib.Bool.not (listingUnderstands args) then
      Cli.printErr $"`dark constraints` doesn't take \"{Stdlib.String.join args " "}\"."
      Cli.printHint "  dark constraints [--kind <kind>] [--json]   list; `resolve` and `ack` take ids"
      state
    else

    match kindArgChecked args with
    | Error why ->
      Cli.printErr why
      state
    | Ok _ ->

    if Stdlib.List.member args "--json" then
      executeJson state args
    else
      executeList state args


let complete
  (_state: AppState)
  (_args: List<String>)
  : List<Completion.CompletionItem> =
  []
