module Darklang.Cli.Branch

// Branches: isolated lines of work you can author and evaluate without touching main.
//
// A branch is a set of delta ops stored `effective = 0` in the shared `package_ops` and tagged in
// `op_branches`; a branch's package manager is main's with those ops overlaid. Nothing here writes SQL --
// all of it is siloed in `SCM.PackageOps` -- this file only parses arguments and formats what it returns.

let printOk (msg: String) : Unit = Stdlib.printLine (Colors.success msg)
let printErr (msg: String) : Unit = Stdlib.printLine (Colors.error msg)
let printHint (msg: String) : Unit = Stdlib.printLine (Colors.hint msg)

/// Report what a reconciliation (merge / rebase) auto-resolved. ONE line, never a wall: the point is that
/// nothing was lost silently, not to dump the divergence here.
let reportConflicts (conflicts: List<SCM.Conflicts.Conflict>) : Unit =
  match conflicts with
  | [] -> ()
  | cs ->
    let n = Stdlib.Int.toString (Stdlib.List.length cs)

    printOk
      $"{n} conflict(s) auto-resolved by recency and recorded -- the losing version is kept, not dropped."

/// The id of the branch <param branchRef> refers to, WITHOUT creating anything, or None.
///
/// Three spellings, because all three get printed at people and anything you can see you should be able to
/// paste:
///   1. a NAME, which is what you normally type
///   2. a full ID, which is what a bundle carries and what a branch with no name of its own goes by
///   3. an ID PREFIX, which is what `dark branches` actually shows -- it abbreviates to 8 characters, and
///      pasting that used to start a new empty branch LABELLED with the abbreviation
///
/// Ambiguity is refused rather than guessed. Returns None on no match too; the caller decides whether that
/// is an error to report or a name to start a branch under.
let lookupRef (branchRef: String) : Stdlib.Option.Option<String> =
  match SCM.PackageOps.branchIdForName branchRef with
  | Some id -> Stdlib.Option.Option.Some id
  | None ->
    if SCM.PackageOps.branchExists branchRef then
      Stdlib.Option.Option.Some branchRef
    else
      // Long enough not to be silly: a 1-2 character prefix would match half the store and "ambiguous" is
      // a worse answer than making you type more.
      if Stdlib.String.length branchRef < 4 then
        Stdlib.Option.Option.None
      else
        match
          SCM.Branches.list ()
          |> Stdlib.List.filter (fun b -> Stdlib.String.startsWith b.id branchRef)
        with
        | [ only ] -> Stdlib.Option.Option.Some only.id
        | [] -> Stdlib.Option.Option.None
        | _ ->
          printErr $"\"{branchRef}\" matches more than one branch -- use more of the id, or its name."
          Stdlib.Option.Option.None

/// The id of the branch you just named, or None having said why. What every READ verb goes through: a
/// branch we don't have is refused rather than started, so `dark merge typoo` says so instead of merging
/// an empty branch it just invented.
let resolveRef (branchRef: String) : Stdlib.Option.Option<String> =
  match lookupRef branchRef with
  | Some id -> Stdlib.Option.Option.Some id
  | None ->
    printErr $"no branch \"{branchRef}\"."
    printHint "  `dark branches` lists them."
    Stdlib.Option.Option.None

/// Show the current branch (or main).
///
/// Asks the PROCESS, not the config key: `--branch` and `DARK_BRANCH` both move the process without
/// touching the config, so reading the key would report the branch you'd be on if you hadn't asked for
/// another one.
let executeCurrent (state: AppState) : AppState =
  match SCM.PackageOps.currentBranch () with
  | "" -> printOk "on main."
  | id -> printOk $"on branch \"{SCM.PackageOps.branchName id}\"."

  state

/// Every branch, as the machine-readable shape. Same data the list renders, so the two can't drift.
let branchRows (unit: Unit) : List<ScmJson.BranchJson> =
  let current = SCM.PackageOps.currentBranch ()

  SCM.Branches.list ()
  |> Stdlib.List.map (fun b ->
    ScmJson.BranchJson
      { id = b.id
        name = if b.name == "" then b.id else b.name
        parent = b.parent
        parentName =
          if b.parent == "main" then
            ""
          else
            SCM.PackageOps.branchName b.parent
        ops = b.ops
        current = b.id == current
        merged = b.merged })

/// List all active branches.
let executeList (state: AppState) : AppState =
  let current = SCM.PackageOps.currentBranch ()

  printOk (
    if current == "" then
      "on main. branches:"
    else
      $"on \"{SCM.PackageOps.branchName current}\". branches:"
  )

  Stdlib.printLine (SCM.PackageOps.branchList ())
  state

/// Switch the current branch: persistently (the `current_branch` config key, so the next process starts
/// here) AND in this process (the overlay used for name resolution and execution). `switch main` (or
/// empty) returns to main.
///
/// Both halves are needed. The interactive REPL is one long-lived process, so writing only the config key
/// makes "authoring + eval target it now" a lie there: the process stays on whatever branch it booted on
/// while the status bar says otherwise.
let executeSwitch (state: AppState) (branchRef: String) : AppState =
  // The branch a switch lands on, as `AppState` spells it (`""` = main). Returned rather than assumed,
  // so the REPL's state moves with the process overlay instead of drifting from it for the rest of the
  // session -- the status bar and every command that reads `state.currentBranchId` depend on that.
  let landedOn =
    match branchRef with
    | ""
    | "main" ->
      let _ = Builtin.configSet "current_branch" ""
      let _ = Builtin.configSet "current_branch_name" ""
      let _ = SCM.PackageOps.selectBranch ""
      let _ = printOk "switched to main."
      ""
    | ref ->
      // A branch started while on another branch is parented to it (branches off branches). The parent
      // is whatever we're currently on, BY ID -- the parent link is a reference, and references don't
      // follow a rename. An existing branch is never re-parented, so switching onto one can't move it.
      let parentId =
        match SCM.PackageOps.currentBranch () with
        | "" -> "main"
        | cur -> cur

      // Resolve BEFORE creating, and accept either spelling. A name is what you normally type. An ID has
      // to work too, because it's what gets printed when a branch has no name of its own -- an imported
      // bundle registered by authoring rather than by `switch`. Taking the id as a name would start a
      // second branch LABELLED with that id, right next to the one you were trying to reach.
      // `lookupRef` resolves merged branches too, because READ verbs need them: `dark branches` lists a
      // merged branch, so `diff` and `log` have to accept its name. Switching is the one thing it must not
      // do -- its work is already in the parent, and the docs say so. A merged NAME is therefore free again,
      // and typing it starts a new branch, which is what any unused name does.
      let (branchId, created) =
        match lookupRef ref with
        | Some existing ->
          if SCM.PackageOps.branchIsMerged existing then
            SCM.PackageOps.ensureBranch ref parentId
          else
            (existing, false)
        | None -> SCM.PackageOps.ensureBranch ref parentId

      // The config holds the ID, with the name beside it for anyone reading the file. Names are
      // deliberately not unique, including across instances, and resolving one takes the most recent
      // branch under it -- so storing the name means a sync that brings in a peer's branch of the same
      // name can move you onto theirs without a word. The id cannot be confused for anything else.
      let handle =
        match SCM.PackageOps.branchName branchId with
        | "" -> branchId
        | named -> named

      let _ = Builtin.configSet "current_branch" branchId
      let _ = Builtin.configSet "current_branch_name" handle
      let _ = SCM.PackageOps.selectBranch branchId

      let parentNote =
        if parentId == "main" then
          ""
        else
          $" (off \"{SCM.PackageOps.branchName parentId}\")"

      let _ =
        if created then
          printOk $"started branch \"{handle}\"{parentNote}."
        else
          ()

      let _ =
        printOk
          $"switched to branch \"{handle}\" -- authoring + eval target it now (`dark switch main` to return)."

      branchId

  { state with currentBranchId = landedOn }

/// Where merging <branchId> leaves you: its parent, as (id, name). Main is the absence of a branch, so it
/// has no row and no id.
let parentOf (branchId: String) : (String * String) =
  match SCM.Branches.list () |> Stdlib.List.findFirst (fun b -> b.id == branchId) with
  | Some b ->
    if b.parent == "main" then
      ("", "main")
    else
      (b.parent, SCM.PackageOps.branchName b.parent)
  | None -> ("", "main")

/// Merge a branch's work into its parent (gated by canMerge: has-changes / no-active-children /
/// rebased). On success its ops become part of the parent.
let executeMerge (state: AppState) (branchRef: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId when SCM.PackageOps.branchIsMerged branchId ->
    // Merging it again would flip nothing and report "Merged 0 op(s)", which reads as a broken merge
    // rather than as "there was nothing to do".
    printOk $"\"{branchRef}\" is already merged into its parent."
    state
  | Some branchId ->
    match SCM.PackageOps.mergeBranch branchId with
    | Ok outcome ->
      printOk
        $"Merged {Stdlib.Int.toString outcome.merged} op(s) from branch \"{branchRef}\" into its parent."

      reportConflicts outcome.conflicts

      // Standing on the branch you just merged is standing on finished work: its ops belong to the parent
      // now, and the stored branch would be a name that no longer resolves. Worse, it would start
      // resolving again the day someone reuses that name, quietly moving a later session onto a branch it
      // never asked for. So move to the parent, and SAY so -- changing where the next edit lands without
      // mentioning it is the surprise this whole area exists to remove.
      let landedOn =
        if SCM.PackageOps.currentBranch () == branchId then
          let (parentId, parentName) = parentOf branchId
          let _ = Builtin.configSet "current_branch" parentId
          let _ =
            Builtin.configSet
              "current_branch_name"
              (if parentId == "" then "" else parentName)
          let _ = SCM.PackageOps.selectBranch parentId
          let _ = printOk $"now on \"{parentName}\" -- that's where the next edit lands."
          parentId
        else
          state.currentBranchId

      { state with currentBranchId = landedOn }
    | Error e ->
      printErr $"Merge failed: {e}"
      state

/// Rebase a branch onto main (accept main's current state; required before merge if main changed a
/// name the branch also changed). Reports what moved.
let executeRebase (state: AppState) (branchRef: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    match SCM.PackageOps.rebaseBranch branchId with
    | Ok outcome ->
      printOk outcome.message
      reportConflicts outcome.conflicts
    | Error e -> printErr e

    state

/// Present everything a branch changes vs its parent (+ new, ~ changed) -- review before merge.
let executeDiff (state: AppState) (branchRef: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    printOk (SCM.PackageOps.branchDiff branchId)
    state

/// The branch's authoring history: its frontier ops, oldest-first, pretty-printed (the op SEQUENCE,
/// complementary to `diff`'s net effect).
let executeLog (state: AppState) (branchRef: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    let ops = SCM.PackageOps.branchOps branchId

    if Stdlib.List.isEmpty ops then
      printOk $"branch \"{branchRef}\" has no ops (empty, merged, or unknown)."
    else
      printOk
        $"{Stdlib.Int.toString (Stdlib.List.length ops)} op(s) on branch \"{branchRef}\" (oldest first):"

      ops
      |> Stdlib.List.iter (fun op ->
        Stdlib.printLine
          (PrettyPrinter.ProgramTypes.PackageOp.packageOp branchId op))

    state

/// Resolve one conflicted name on a branch: `mine` keeps the branch's version (wins on merge),
/// `theirs` takes the parent's (drops the branch's binding). `hand-author` = just re-author on the branch.
let executeResolve
  (state: AppState)
  (branchRef: String)
  (name: String)
  (choice: String)
  : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    match SCM.PackageOps.resolveConflict branchId name choice with
    | Ok msg -> printOk msg
    | Error e -> printErr e

    state

/// Archive (soft-delete) a branch, discarding its unmerged work.
let executeArchive (state: AppState) (branchRef: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    match SCM.PackageOps.archiveBranch branchId with
    | Ok _ -> printOk $"archived branch \"{branchRef}\"."
    | Error e -> printErr $"Archive failed: {e}"

    state

/// Export a branch as a portable bundle file (registry + frontier ops) -- move it to another machine.
let executeExport (state: AppState) (branchRef: String) (path: String) : AppState =
  match resolveRef branchRef with
  | None -> state
  | Some branchId ->
    match Stdlib.Cli.File.writeText path (SCM.PackageOps.exportBranch branchId) with
    | Ok _ -> printOk $"Exported branch \"{branchRef}\" to {path}."
    | Error _ -> printErr $"Couldn't write {path}"

    state

/// Import a branch bundle file (from another machine): recreates the branch here (isolated from main).
let executeImport (state: AppState) (path: String) : AppState =
  match Stdlib.Cli.File.readText path with
  | Ok json ->
    match SCM.PackageOps.importBranch json with
    | Ok msg -> printOk msg
    | Error e -> printErr $"Import failed: {e}"
  | Error _ -> printErr $"Couldn't read {path}"

  state

/// Push a branch to a relay under your identity, so you can pull it on another machine.
let executePush (state: AppState) (branchRef: String) (url: String) : AppState =
  if url == "" then
    printErr "no relay -- `dark connect <url>` first, or pass a url."
    state
  else
    match resolveRef branchRef with
    | None -> state
    | Some branchId ->
      // No identity gate: an instance mints its own id on first use, so this can't be empty.
      match SCM.PackageOps.identity () with
      | id ->
        let bundle = Stdlib.String.toBlob (SCM.PackageOps.exportBranch branchId)

        // The relay keys on the branch ID, not the name: two machines can each have a `fix-auth`, and
        // they are different branches. The name travels inside the bundle, for display on the far end.
        match Sync.relayPostTo url $"/branch/push?owner={id}&branch={branchId}" bundle with
        | Ok _ -> printOk $"pushed branch \"{branchRef}\" to {url} as \"{id}\"."
        | Error e -> printErr $"branch push failed: {e}"

        state

/// Pull branches from a relay, yours by default or someone else's with <param owner>.
///
/// Branches are keyed by owner on the relay, which is what lets one of YOUR branches follow you between
/// your own machines. Pulling someone ELSE's is the other half of that, and it was missing: the endpoints
/// take an `?owner=`, the relay stores every owner's branches side by side, and the CLI only ever asked for
/// its own. So two people could each carry a branch across their own laptops and still had no way to work
/// on one together, which is the case a shared relay exists for.
///
/// A pulled branch arrives as a branch here like any other: isolated from main, yours to look at, merge or
/// discard. It does not become the same branch as theirs -- a branch id is minted by whoever created it, so
/// pulling gives you their ops under their id, and pushing it back is what shares your side.
let executePullFrom (state: AppState) (url: String) (owner: String) : AppState =
  if url == "" then
    printErr "no relay -- `dark connect <url>` first, or pass a url."
  else
    match owner with
    | id ->
      match Sync.relayGet $"{url}/branch/list?owner={id}" with
      | Ok listBody ->
        let ids =
          Stdlib.String.fromBlobWithReplacement listBody
          |> Stdlib.String.split "\n"
          |> Stdlib.List.filter (fun s -> s != "")

        if Stdlib.List.isEmpty ids then
          printOk $"no branches for \"{id}\" on {url}."
        else
          ids
          |> Stdlib.List.iter (fun bid ->
            match Sync.relayGet $"{url}/branch/pull?owner={id}&branch={bid}" with
            | Ok bundleBody ->
              match
                SCM.PackageOps.importBranch
                  (Stdlib.String.fromBlobWithReplacement bundleBody)
              with
              | Ok msg -> printOk msg
              | Error e -> printErr $"import {bid} failed: {e}"
            | Error e -> printErr $"pull {bid} failed: {e}")
      | Error e -> printErr $"branch list failed: {e}"

  state

/// Pull ALL your own branches from a relay.
let executePull (state: AppState) (url: String) : AppState =
  executePullFrom state url (SCM.PackageOps.identity ())


let help (state: AppState) : AppState =
  Stdlib.List.iter
    [ "dark branch - isolated lines of work; author and eval without\n  touching main."
      ""
      "  You name a branch; it gets a uuid underneath. Names are what you"
      "  type and can reuse; the uuid is what op tags, bundles and parent"
      "  links point at. `dark branches` shows both."
      ""
      "  dark branch                   show the current branch (or main)"
      "  dark branch <name>            switch to a branch, starting it if it's new"
      "  dark branch list              name (id) <- parent [status]"
      "  dark branch archive <name>    discard a branch + its unmerged work"
      "  dark branch diff <name>       what it changes vs its parent"
      "  dark branch log <name>        its ops, oldest-first"
      "  dark branch export <name> <f> write it to a file"
      "  dark branch import <f>        recreate a branch here from that file"
      "  dark branch push <name> [url] push a branch to a relay under your identity"
      "  dark branch pull [url]        pull all your branches back from a relay"
      "  dark branch pull --from <who> pull a COLLEAGUE's branches from the relay"
      ""
      "  Also at the root, because you reach for them constantly:"
      "  dark branches                 same as `dark branch list`"
      "  dark switch <name>            same as `dark branch <name>`"
      "  dark merge <name>             merge a branch into its parent"
      "  dark rebase <name>            accept the parent's changes into a branch"
      "  dark diff <name>              same as `dark branch diff`"
      "  dark log [name]               same, defaulting to the current one"
      "  dark resolve <branch> <name> mine|theirs"
      "                                keep the branch's, or the parent's"
      ""
      "  Conflicts: `dark conflicts branch <name>` previews; `dark"
      "  conflicts` reviews recorded ones."
      "  One-off, without switching: `dark --branch <name> eval <expr>`"
      "  One shell at a time: `export DARK_BRANCH=<name>`" ]
    (fun line -> Stdlib.printLine line)

  state

/// `dark branch ...`. Bare `dark branch <id>` switches (creating the branch if it's new), which is why
/// the subcommand arms come first: a subcommand name can't also be a branch you switch to.
let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] -> executeCurrent state
  | [ "list" ] -> executeList state
  | [ "current" ] -> executeCurrent state
  | [ "switch"; id ] -> executeSwitch state id
  | [ "new"; id ] -> executeSwitch state id
  | [ "archive"; id ] -> executeArchive state id
  | [ "diff"; id ] -> executeDiff state id
  | [ "log"; id ] -> executeLog state id
  | [ "merge"; id ] -> executeMerge state id
  | [ "rebase"; id ] -> executeRebase state id
  | [ "resolve"; id; name; choice ] -> executeResolve state id name choice
  | [ "export"; id; path ] -> executeExport state id path
  | [ "import"; path ] -> executeImport state path
  | [ "push"; id ] -> executePush state id (SCM.PackageOps.relay ())
  | [ "push"; id; url ] -> executePush state id url
  | [ "pull" ] -> executePull state (SCM.PackageOps.relay ())
  // `--from <who>` is how you get a COLLEAGUE's branch, which is the point of a shared relay. Without it
  // a branch could only ever follow one person between their own machines.
  | [ "pull"; "--from"; owner ] ->
    executePullFrom state (SCM.PackageOps.relay ()) owner
  // Both orders. The url reads naturally on either side of the flag, and taking only one of them meant
  // the other fell through to the help text -- which answers a question nobody asked, since the command
  // was right and only the word order was not.
  | [ "pull"; url; "--from"; owner ] -> executePullFrom state url owner
  | [ "pull"; "--from"; owner; url ] -> executePullFrom state url owner
  | [ "pull"; url ] -> executePull state url
  | [ id ] -> executeSwitch state id
  | _ ->
    // Printing help alone reads as though nothing happened, so say what was not understood first.
    printErr $"`dark branch {Stdlib.String.join args " "}` isn't a form of this command."
    help state

/// `dark branches`
let executeBranchesCmd (state: AppState) (args: List<String>) : AppState =
  if ScmJson.wantsJson args then
    Stdlib.printLine (ScmJson.branchesJson (branchRows ()))
    state
  else
    executeList state

/// `dark switch [<id>]`. No argument reports where you are rather than switching, so a bare `switch`
/// can't silently move you to main.
let executeSwitchCmd (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] -> executeCurrent state
  | [ id ] -> executeSwitch state id
  | _ ->
    printErr "usage: dark switch <branch>   (`dark switch main` returns to main)"
    state

/// `dark merge <id>`
let executeMergeCmd (state: AppState) (args: List<String>) : AppState =
  match args with
  | [ id ] -> executeMerge state id
  | _ ->
    printErr "usage: dark merge <branch>"
    printHint "  `dark branches` lists them."
    state

/// `dark rebase <id>`
let executeRebaseCmd (state: AppState) (args: List<String>) : AppState =
  match args with
  | [ id ] -> executeRebase state id
  | _ ->
    printErr "usage: dark rebase <branch>"
    printHint "  `dark branches` lists them."
    state

/// `dark diff <id>`
let executeDiffCmd (state: AppState) (args: List<String>) : AppState =
  // The flag is not the branch. Filtering it out first is what lets `dark diff foo --json` and
  // `dark diff --json foo` both mean the same thing, instead of one of them looking for a branch named
  // "--json".
  let refs = args |> Stdlib.List.filter (fun a -> Stdlib.Bool.not (Stdlib.String.startsWith a "-"))

  match refs with
  | [ id ] ->
    if ScmJson.wantsJson args then
      match resolveRef id with
      | None -> state
      | Some branchId ->
        Stdlib.printLine (
          ScmJson.branchDiffJson (SCM.PackageOps.branchDiffEntries branchId)
        )

        state
    else
      executeDiff state id
  | _ ->
    printErr "usage: dark diff <branch> [--json]"
    printHint "  `dark branches` lists them."
    state

/// `dark log [<id>]` -- history, meaning whichever history you're standing in.
///
/// On a BRANCH that's the branch's own ops, oldest first: what you've done since you forked. On MAIN
/// there is no delta, so it's the commits, which is what `log` means everywhere else and what it meant
/// here before the branch. Erroring on main instead would be technically defensible and useless.
/// The branch's ops as JSON, oldest first -- the same sequence the human view prints.
let branchOpsAsJson (branchRef: String) : Unit =
  match resolveRef branchRef with
  | None -> ()
  | Some branchId ->
    let rendered =
      SCM.PackageOps.branchOps branchId
      |> Stdlib.List.indexedMap (fun i op ->
        ScmJson.BranchOpJson
          { seq = i
            op = PrettyPrinter.ProgramTypes.PackageOp.packageOp branchId op })

    Stdlib.printLine (ScmJson.branchOpsJson rendered)

let executeLogCmd (state: AppState) (args: List<String>) : AppState =
  let wantsJson = ScmJson.wantsJson args
  let refs = args |> Stdlib.List.filter (fun a -> Stdlib.Bool.not (Stdlib.String.startsWith a "-"))

  match refs with
  | [ id ] ->
    if wantsJson then
      let _ = branchOpsAsJson id
      state
    else
      executeLog state id
  | [] ->
    match SCM.PackageOps.currentBranch () with
    | "" ->
      if wantsJson then
        // On main `log` IS the commit history, so it answers with exactly what `commits --json` answers.
        Stdlib.printLine (ScmJson.commitsJson (Commits.commitRows 20L))
        state
      else
        Commits.executeList state 20L
    // By NAME, because `executeLog` echoes back whatever it was handed and everything else the CLI
    // prints about a branch is its name. `resolveRef` turns it straight back into this id.
    | id ->
      let branchRef = SCM.PackageOps.branchName id

      if wantsJson then
        let _ = branchOpsAsJson branchRef
        state
      else
        executeLog state branchRef
  | _ ->
    printErr "usage: dark log [<branch>] [--json]"
    state

/// `dark resolve <id> <name> mine|theirs`
let executeResolveCmd (state: AppState) (args: List<String>) : AppState =
  match args with
  | [ id; name; choice ] -> executeResolve state id name choice
  | _ ->
    printErr "usage: dark resolve <branch> <name> mine|theirs"
    printHint "  `dark conflicts branch <branch>` shows what's conflicted."
    state

/// One `complete` is shared by branch/switch/merge/rebase/branches/resolve, so it can't tell which
/// word was typed. Branch names are the right answer for nearly all of them, so offer those plus the
/// subcommands and let the prefix filter sort it out.
let complete
  (state: AppState)
  (args: List<String>)
  : List<Completion.CompletionItem> =
  // the subcommands that take a branch as their next word
  let branchTakingSubcommands =
    [ "switch"
      "archive"
      "diff"
      "log"
      "merge"
      "rebase"
      "push"
      "resolve"
      "export" ]

  let subcommands =
    Stdlib.List.append
      branchTakingSubcommands
      [ "list"; "current"; "new"; "pull"; "import" ]

  let branchNames =
    SCM.Branches.list ()
    |> Stdlib.List.map (fun b -> b.name)
    |> Stdlib.List.filter (fun n -> n != "")

  let matching
    (options: List<String>)
    (partial: String)
    : List<Completion.CompletionItem> =
    options
    |> Stdlib.List.filter (fun o -> Stdlib.String.startsWith o partial)
    |> Stdlib.List.map Completion.simple

  match args with
  | [] -> matching (Stdlib.List.append branchNames subcommands) ""
  | [ partial ] -> matching (Stdlib.List.append branchNames subcommands) partial
  | [ sub; partial ] ->
    if Stdlib.List.member branchTakingSubcommands sub then
      matching (Stdlib.List.append branchNames [ "main" ]) partial
    else
      []
  | _ -> []
