module Darklang.Cli.Apps.Views.AiChats

/// Demo data: an AI coding thread
type Thread =
  { id: Int
    status: String
    topic: String
    branch: String
    cost: String
    tokens: String
    time: String
    detail: String }

let demoThreads () : List<Thread> =
  [ Thread
      { id = 1
        status = "running"
        topic = "Add binary serialization for sync"
        branch = "ai/sync"
        cost = "$4.82"
        tokens = "128k"
        time = "12m"
        detail = "Currently editing packages/darklang/sync/serialize.dark  •  14 files changed" }
    Thread
      { id = 2
        status = "review"
        topic = "Refactor HTTP handler error paths"
        branch = "ai/errs"
        cost = "$2.17"
        tokens = "64k"
        time = "8m"
        detail = "⚠ Awaiting your review: 3 questions about error propagation strategy" }
    Thread
      { id = 3
        status = "running"
        topic = "Write tests for package manager"
        branch = "ai/test"
        cost = "$1.53"
        tokens = "41k"
        time = "5m"
        detail = "Running test suite (pass: 12, fail: 2, pending: 6)  •  4 files changed" }
    Thread
      { id = 4
        status = "review"
        topic = "Design new DB migration system"
        branch = "ai/db"
        cost = "$6.31"
        tokens = "187k"
        time = "22m"
        detail = "⚠ Awaiting your review: proposed 2 migration approaches, needs decision" }
    Thread
      { id = 5
        status = "running"
        topic = "Fix canvas rendering perf regression"
        branch = "ai/perf"
        cost = "$0.89"
        tokens = "22k"
        time = "3m"
        detail = "Profiling render loop, found bottleneck in tree diff  •  1 file changed" }
    Thread
      { id = 6
        status = "done"
        topic = "Update stdlib List docs"
        branch = "ai/docs"
        cost = "$0.34"
        tokens = "9k"
        time = "1m"
        detail = "Completed. PR #5601 ready to merge  •  8 files changed" } ]


let statusBadge (status: String) : String =
  match status with
  | "running" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgGreen ++ Darklang.Stdlib.Cli.UI.Colors.black ++ Darklang.Stdlib.Cli.UI.Colors.bold) " RUNNING "
  | "review" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgYellow ++ Darklang.Stdlib.Cli.UI.Colors.black ++ Darklang.Stdlib.Cli.UI.Colors.bold) " REVIEW  "
  | "blocked" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgRed ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) " BLOCKED "
  | "done" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgBlue ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) " DONE    "
  | "paused" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.grayBg ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) " PAUSED  "
  | "error" -> Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgRed ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) " ERROR   "
  | _ -> Darklang.Stdlib.Cli.UI.Colors.dimText status

let hr (cols: Int) : String =
  Darklang.Stdlib.Cli.UI.Colors.dimText
    (Stdlib.String.repeat "─" (Stdlib.Int.max 1 cols))

let thinHr (cols: Int) : String =
  Darklang.Stdlib.Cli.UI.Colors.dimText
    (Stdlib.String.repeat "╌" (Stdlib.Int.max 1 cols))

let padRight (s: String) (width: Int) : String =
  Stdlib.Cli.Tui.Text.fitToWidth s width

let threadRows (cols: Int) (thread: Thread) : List<String> =
  let idStr = Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.cyan) ("#" ++ Stdlib.Int.toString thread.id)
  let badge = statusBadge thread.status
  let topicStr =
    if thread.status == "done" then
      Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight thread.topic 40)
    else
      Darklang.Stdlib.Cli.UI.Colors.boldText (padRight thread.topic 40)
  let branchStr = Darklang.Stdlib.Cli.UI.Colors.dimText (padRight thread.branch 10)
  let costColor =
    match thread.status with
    | "running" -> Darklang.Stdlib.Cli.UI.Colors.green
    | "review" -> Darklang.Stdlib.Cli.UI.Colors.yellow
    | _ -> Darklang.Stdlib.Cli.UI.Colors.dim
  let costStr = Darklang.Stdlib.Cli.UI.Colors.colorize costColor (padRight thread.cost 10)
  let tokensStr = Darklang.Stdlib.Cli.UI.Colors.dimText (padRight thread.tokens 10)
  let timeStr = Darklang.Stdlib.Cli.UI.Colors.dimText (padRight thread.time 8)

  let detailColor =
    match thread.status with
    | "review" -> Darklang.Stdlib.Cli.UI.Colors.yellow
    | _ -> Darklang.Stdlib.Cli.UI.Colors.dim
  [ "  " ++ idStr ++ "    " ++ badge ++ "  " ++ topicStr ++ "  " ++ branchStr ++ "  " ++ costStr ++ "  " ++ tokensStr ++ "  " ++ timeStr
    Darklang.Stdlib.Cli.UI.Colors.colorize detailColor
      ("       ╰─ " ++ thread.detail)
    thinHr cols ]


/// Build the complete AI-chats dashboard without reading or writing the
/// terminal. Rows are clipped by the gallery after it composes its footer.
let rowsAtSize
  (size: Darklang.Stdlib.Cli.Tui.Size)
  : List<String> =
  let threads = demoThreads ()
  let cols = Stdlib.Int.max 1 size.width

  let runningCount =
    threads
    |> Stdlib.List.filter (fun t -> t.status == "running")
    |> Stdlib.List.length

  let reviewCount =
    threads
    |> Stdlib.List.filter (fun t -> t.status == "review")
    |> Stdlib.List.length

  let threadCount = Stdlib.List.length threads

  // Column headers
  let headerLine =
    "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "ID" 4)
    ++ "    "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "STATUS" 10)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "TOPIC" 40)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "BRANCH" 10)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "COST" 10)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "TOKENS" 10)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim) (padRight "TIME" 8)
  let threadLines =
    threads
    |> Stdlib.List.map (threadRows cols)
    |> Stdlib.List.flatten

  let summary =
    ("  "
     ++ Darklang.Stdlib.Cli.UI.Colors.boldText "Session totals"
     ++ "  "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "│"
     ++ "  Cost: " ++ Darklang.Stdlib.Cli.UI.Colors.boldText "$16.06"
     ++ "  " ++ Darklang.Stdlib.Cli.UI.Colors.dimText "│"
     ++ "  Tokens: " ++ Darklang.Stdlib.Cli.UI.Colors.boldText "451k"
     ++ "  " ++ Darklang.Stdlib.Cli.UI.Colors.dimText "│"
     ++ "  Uptime: " ++ Darklang.Stdlib.Cli.UI.Colors.boldText "51m"
     ++ "  " ++ Darklang.Stdlib.Cli.UI.Colors.dimText "│"
     ++ "  Files changed: " ++ Darklang.Stdlib.Cli.UI.Colors.boldText "31")

  let hints =
    ("  "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[enter]" ++ " open thread   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[r]" ++ " review flagged   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[n]" ++ " new thread   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[k]" ++ " kill thread   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[q]" ++ " quit")

  Stdlib.List.flatten [
    [ ""
      "  "
      ++ Darklang.Stdlib.Cli.UI.Colors.boldText "dark ai chats"
      ++ "  "
      ++ Darklang.Stdlib.Cli.UI.Colors.dimText
          ("—  "
           ++ Stdlib.Int.toString threadCount
           ++ " threads  •  "
           ++ Stdlib.Int.toString runningCount
           ++ " running  •  "
           ++ Stdlib.Int.toString reviewCount
           ++ " awaiting review")
      ""
      hr cols
      headerLine
      hr cols ]
    threadLines
    [ hr cols; ""; summary; ""; hints; "" ]
  ]
