module Darklang.Cli.Apps.Views.App

type Screen =
  | ViewList of selected: Int
  /// The focused row is used as the dashboard's scroll position.
  | ViewDisplay of viewIndex: Int * focusedRow: Int

type State =
  { screen: Screen
    views: List<ViewEntry> }


// -- Screens --
//
// Two: a list of the gallery's views, and one of them filling the screen. Both are `Stdlib.Cli.UI` widgets
// in a `Chrome` frame, where they used to be hand-built rows with their own title bar, their own rule
// lines, their own footer and their own viewport arithmetic.

/// The picker labels: a view's name, and its description in dim text after it.
let listLabels (state: State) : List<String> =
  state.views
  |> Stdlib.List.map (fun entry ->
    (Stdlib.Cli.UI.Colors.boldText entry.name)
    ++ "   "
    ++ (Stdlib.Cli.UI.Colors.dimText entry.description))

let listPicker (state: State) (selected: Int) : Stdlib.Cli.UI.Picker.State =
  Stdlib.Cli.UI.Picker.moveTo (Stdlib.Cli.UI.Picker.make (listLabels state)) selected

/// One view's rows, scrolled to the focused row.
let displayRows
  (state: State)
  (viewIndex: Int)
  (focusedRow: Int)
  (size: Stdlib.Cli.Tui.Size)
  (region: Stdlib.Cli.UI.Layout.Region)
  : List<Stdlib.Cli.UI.Layout.Span> =
  let rows =
    match Stdlib.List.getAt state.views viewIndex with
    | Some entry -> rowsAtSize entry.kind size
    | None -> [ Stdlib.Cli.UI.Colors.error "View not found" ]

  Stdlib.Cli.Tui.Layout.viewport rows focusedRow region.rows
  |> Stdlib.List.indexedMap (fun i row -> Stdlib.Cli.UI.Layout.at region i 0 row)
  |> Stdlib.List.flatten

let chromeFor (state: State) : Stdlib.Cli.UI.Chrome.Frame =
  match state.screen with
  | ViewList _selected ->
    let count = Stdlib.Int.toString (Stdlib.List.length state.views)

    Stdlib.Cli.UI.Chrome.frame
      "Views"
      $"{count} available"
      "Up/Down: select   Enter: open   Esc: exit"
  | ViewDisplay(viewIndex, _focusedRow) ->
    let name =
      match Stdlib.List.getAt state.views viewIndex with
      | Some entry -> entry.name
      | None -> "View"

    Stdlib.Cli.UI.Chrome.frame name "PREVIEW" "Up/Down: scroll   Esc: back to the list"

/// Build the complete gallery view without terminal reads or writes.
let viewAtSize (state: State) (size: Stdlib.Cli.Tui.Size) : Stdlib.Cli.Tui.View =
  Stdlib.Cli.UI.Chrome.view (chromeFor state) size (fun region ->
    match state.screen with
    | ViewList selected -> Stdlib.Cli.UI.Picker.view (listPicker state selected) region
    | ViewDisplay(viewIndex, focusedRow) ->
      displayRows state viewIndex focusedRow size region)


// ── Key handling ──

type Action =
  | Continue of State
  | Exit of State

let handleKey
  (state: State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (_modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers)
  (_keyChar: Stdlib.Option.Option<String>)
  : Action =
  match state.screen with
  | ViewList selected ->
    let viewCount = Stdlib.List.length state.views
    match key with
    | Escape -> Action.Exit state
    | UpArrow ->
      let newIndex = if selected > 0 then selected - 1 else selected
      Action.Continue
        ({ state with screen = Screen.ViewList newIndex })
    | DownArrow ->
      let maxIndex = Stdlib.Int.max 0 (viewCount - 1)
      let newIndex =
        if selected < maxIndex then selected + 1 else selected
      Action.Continue
        ({ state with screen = Screen.ViewList newIndex })
    | Enter ->
      Action.Continue
        ({ state with
            screen = Screen.ViewDisplay(selected, 0) })
    | _ -> Action.Continue state

  | ViewDisplay(viewIndex, focusedRow) ->
    match key with
    | Escape ->
      Action.Continue
        ({ state with screen = Screen.ViewList viewIndex })
    | UpArrow ->
      let nextRow =
        if focusedRow > 0 then focusedRow - 1 else 0
      Action.Continue
        ({ state with
            screen = Screen.ViewDisplay(viewIndex, nextRow) })
    | DownArrow ->
      Action.Continue
        ({ state with
            screen =
              Screen.ViewDisplay(viewIndex, focusedRow + 1) })
    | _ -> Action.Continue state


// -- Component adapter --

let onKey
  (state: State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers)
  (keyChar: Stdlib.Option.Option<String>)
  : Darklang.Cli.Component.Step<State> =
  match handleKey state key modifiers keyChar with
  | Continue next -> Darklang.Cli.Component.Step.Stay next
  | Exit next -> Darklang.Cli.Component.Step.Exit next

val component =
  Darklang.Cli.Component.stateless viewAtSize onKey


// ── CLI command entry points ──

let slug (entry: ViewEntry) : String =
  Stdlib.String.toLowercase
    (Stdlib.String.replaceAll entry.name " " "-")

let execute
  (cliState: Darklang.Cli.AppState)
  (args: List<String>)
  : Darklang.Cli.AppState =
  let views = allViews ()

  match args with
  // Non-interactive: `views list` prints available views.
  | [ "list" ] ->
    Stdlib.printLine
      (Darklang.Stdlib.Cli.UI.Colors.boldText "Available views:")
    Stdlib.printLine ""
    views
    |> Stdlib.List.iter (fun entry ->
      Stdlib.printLine
        ("  "
         ++ Darklang.Stdlib.Cli.UI.Colors.boldText (slug entry)
         ++ "  "
         ++ Darklang.Stdlib.Cli.UI.Colors.dimText entry.description))
    Stdlib.printLine ""
    cliState

  // Non-interactive: `views <name>` prints one pure dashboard.
  | [ viewName ] ->
    let requested = Stdlib.String.toLowercase viewName
    let found =
      views
      |> Stdlib.List.findFirst (fun entry ->
        slug entry == requested)
    match found with
    | Some entry ->
      let size = Darklang.Stdlib.Cli.Tui.TerminalSession.currentSize ()
      rowsAtSize entry.kind size |> Stdlib.printLines
      cliState
    | None ->
      Stdlib.printLine
        (Darklang.Stdlib.Cli.UI.Colors.error
          ("Unknown view: " ++ viewName))
      Stdlib.printLine
        "Use 'views list' to see available views."
      cliState

  // Interactive: `views` opens the retained browser.
  | _ ->
    match views with
    | [] ->
      Stdlib.printLine
        (Darklang.Stdlib.Cli.UI.Colors.dimText "No views available.")
      cliState
    | _ ->
      let state =
        State {
          screen = Screen.ViewList 0
          views = views
        }
      Darklang.Cli.Component.launch cliState component state


let help
  (_state: Darklang.Cli.AppState)
  : String =
  [ "Usage: views [name|list]"
    "Browse and preview available CLI views."
    ""
    "Views are interactive terminal dashboards and displays."
    "Each view renders with demo data for quick previewing."
    ""
    "  views           Open interactive view browser"
    "  views list      List available views"
    "  views <name>    Render a specific view (e.g. views ai-chats)"
    ""
    "Interactive navigation:"
    "  Up/Down    Select a view or scroll its content"
    "  Enter      Open the selected view"
    "  Escape     Back to list / exit" ]
  |> Stdlib.String.join "\n"


let complete
  (_state: Darklang.Cli.AppState)
  (_args: List<String>)
  : List<Darklang.Cli.Completion.CompletionItem> =
  allViews ()
  |> Stdlib.List.map (fun entry ->
    Darklang.Cli.Completion.CompletionItem {
      value = slug entry
      display = slug entry
    })
