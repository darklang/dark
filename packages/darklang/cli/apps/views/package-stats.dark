module Darklang.Cli.Apps.Views.PackageStats

/// Demo data for package statistics
type ModuleStats =
  { name: String
    fnCount: Int
    typeCount: Int
    valueCount: Int
    submodules: Int }

let demoStats () : List<ModuleStats> =
  [ ModuleStats { name = "Darklang.Stdlib"; fnCount = 247; typeCount = 42; valueCount = 18; submodules = 23 }
    ModuleStats { name = "Darklang.Cli"; fnCount = 89; typeCount = 31; valueCount = 12; submodules = 15 }
    ModuleStats { name = "Darklang.LanguageTools"; fnCount = 156; typeCount = 67; valueCount = 8; submodules = 19 }
    ModuleStats { name = "Darklang.SCM"; fnCount = 43; typeCount = 14; valueCount = 5; submodules = 7 }
    ModuleStats { name = "Darklang.PrettyPrinter"; fnCount = 38; typeCount = 9; valueCount = 3; submodules = 4 }
    ModuleStats { name = "Darklang.LLM"; fnCount = 22; typeCount = 11; valueCount = 6; submodules = 3 }
    ModuleStats { name = "Darklang.Test"; fnCount = 34; typeCount = 8; valueCount = 2; submodules = 5 } ]


let padRight (s: String) (width: Int) : String =
  Stdlib.Cli.Tui.Text.fitToWidth s width

/// Exactly `width` terminal columns, right-aligned.
let padLeft (s: String) (width: Int) : String =
  Stdlib.String.padStartToWidth (Stdlib.Cli.Tui.Text.clipToWidth s width) width

let bar (value: Int) (maxVal: Int) (width: Int) (color: String) : String =
  let barLen =
    if maxVal == 0 then 0
    else Stdlib.Int.divide (value * width) maxVal
  let filled = Stdlib.String.repeat "█" (barLen)
  let empty = Stdlib.String.repeat "░" ((width - barLen))
  (Darklang.Stdlib.Cli.UI.Colors.colorize color filled) ++ (Darklang.Stdlib.Cli.UI.Colors.dimText empty)


/// Build the complete package-statistics dashboard without terminal I/O.
let rowsAtSize
  (size: Darklang.Stdlib.Cli.Tui.Size)
  : List<String> =
  let stats = demoStats ()
  let termCols = Stdlib.Int.max 1 size.width

  let totalFns = Stdlib.List.fold stats 0 (fun acc s -> acc + s.fnCount)
  let totalTypes = Stdlib.List.fold stats 0 (fun acc s -> acc + s.typeCount)
  let totalValues = Stdlib.List.fold stats 0 (fun acc s -> acc + s.valueCount)
  let totalModules = Stdlib.List.fold stats 0 (fun acc s -> acc + s.submodules)

  let summaryLine =
    "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgGreen ++ Darklang.Stdlib.Cli.UI.Colors.black ++ Darklang.Stdlib.Cli.UI.Colors.bold) (" " ++ Stdlib.Int.toString totalFns ++ " fns ")
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgBlue ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) (" " ++ Stdlib.Int.toString totalTypes ++ " types ")
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.bgMagenta ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) (" " ++ Stdlib.Int.toString totalValues ++ " values ")
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize (Darklang.Stdlib.Cli.UI.Colors.grayBg ++ Darklang.Stdlib.Cli.UI.Colors.white ++ Darklang.Stdlib.Cli.UI.Colors.bold) (" " ++ Stdlib.Int.toString totalModules ++ " modules ")
  let divider =
    Darklang.Stdlib.Cli.UI.Colors.dimText
      (Stdlib.String.repeat "─" termCols)

  let boldDim = Darklang.Stdlib.Cli.UI.Colors.bold ++ Darklang.Stdlib.Cli.UI.Colors.dim
  let headerLine =
    "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim (padRight "MODULE" 30)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim (padLeft "FNS" 6)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim (padLeft "TYPES" 6)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim (padLeft "VALS" 6)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim (padLeft "MODS" 6)
    ++ "  "
    ++ Darklang.Stdlib.Cli.UI.Colors.colorize boldDim "FUNCTIONS"
  let maxFns =
    stats
    |> Stdlib.List.map (fun s -> s.fnCount)
    |> Stdlib.List.fold 0 (fun acc n -> if n > acc then n else acc)

  let moduleRows =
    stats
    |> Stdlib.List.map (fun s ->
      let total = s.fnCount + s.typeCount + s.valueCount
      let nameStr =
        if total > 100 then
          Darklang.Stdlib.Cli.UI.Colors.boldText (padRight s.name 30)
        else
          padRight s.name 30
      let fnStr = Darklang.Stdlib.Cli.UI.Colors.colorize Darklang.Stdlib.Cli.UI.Colors.green (padLeft (Stdlib.Int.toString s.fnCount) 6)
      let typeStr = Darklang.Stdlib.Cli.UI.Colors.colorize Darklang.Stdlib.Cli.UI.Colors.blue (padLeft (Stdlib.Int.toString s.typeCount) 6)
      let valStr = Darklang.Stdlib.Cli.UI.Colors.colorize Darklang.Stdlib.Cli.UI.Colors.magenta (padLeft (Stdlib.Int.toString s.valueCount) 6)
      let modStr = Darklang.Stdlib.Cli.UI.Colors.dimText (padLeft (Stdlib.Int.toString s.submodules) 6)
      let barStr = bar s.fnCount maxFns 20 Darklang.Stdlib.Cli.UI.Colors.green

      "  " ++ nameStr ++ "  " ++ fnStr ++ "  " ++ typeStr ++ "  " ++ valStr ++ "  " ++ modStr ++ "  " ++ barStr)

  let hints =
    ("  "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[q]" ++ " quit   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[s]" ++ " sort by column   "
     ++ Darklang.Stdlib.Cli.UI.Colors.dimText "[/]" ++ " filter")

  Stdlib.List.flatten [
    [ ""
      "  "
      ++ Darklang.Stdlib.Cli.UI.Colors.boldText "Package Statistics"
      ++ "  "
      ++ Darklang.Stdlib.Cli.UI.Colors.dimText
          ("—  "
           ++ Stdlib.Int.toString (Stdlib.List.length stats)
           ++ " top-level modules")
      ""
      summaryLine
      ""
      divider
      headerLine
      divider ]
    moduleRows
    [ divider; ""; hints; "" ]
  ]
