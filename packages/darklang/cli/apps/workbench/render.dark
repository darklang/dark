/// The generic frame primitives every view mounts into (scrollable lines, boxed lines, the list+preview
/// split, the section switcher), plus the Home dashboard and the full-screen reader.
///
/// Part of `Darklang.Cli.Apps.Workbench.App`.
module Darklang.Cli.Apps.Workbench.App

/// (the split-pane preview insets 1; the full-screen reader doesn't). Backs both renderPreview and renderReading.
let renderScrollableLines
  (region: UI.Layout.Region)
  (colOffset: Int)
  (lines: List<String>)
  (display: List<String>)
  (scroll: Int)
  : List<UI.Layout.Span> =
  let len = Stdlib.List.length lines
  let off = Stdlib.Int.min scroll (Stdlib.Int.max 0 (len - 1))
  let maxFit = Stdlib.Int.max 0 (region.cols - 1)
  lines
  |> Stdlib.List.indexedMap (fun i l -> (i, l))
  |> Stdlib.List.drop off
  |> Stdlib.List.take region.rows
  |> Stdlib.List.map (fun pair ->
    let (i, p) = pair
    let row = i - off
    let disp = Stdlib.List.getAt display i |> Stdlib.Option.withDefault p
    UI.Layout.at region row colOffset (Tui.Text.clipToWidth disp maxFit))
  |> Stdlib.List.flatten

let renderPreview (state: State) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  let plain = previewLines state
  // Syntax-highlight the code previews (Inspect source, Changes WIP source). Docs/History-summary/Resolve
  // aren't code, so they stay plain. Highlighting emits ANSI; printAt truncates by raw length, so we only
  // print the highlighted line when the PLAIN line fits the pane width, else fall back to plain-truncated.
  // Changes (4) + Matter (13) show a pre-colored +/- diff, not highlighted source, so they're not re-highlighted.
  // Also skip highlighting anything already ANSI-colored (e.g. a tree-native render peek) - it's not plain source.
  let alreadyColored = Stdlib.String.contains (Stdlib.String.join plain "\n") ""
  let doHighlight = ((state.activeView == vMatter) || (state.activeView == vInspect)) && (Stdlib.Bool.not alreadyColored)
  let highlighted =
    if doHighlight then
      let h =
        SyntaxHighlighting.highlightCode (Stdlib.String.join plain "\n") |> Stdlib.String.split "\n"
      if Stdlib.List.length h == Stdlib.List.length plain then h else plain
    else
      plain
  // Split-pane preview: inset 1 column from the pane's left edge.
  renderScrollableLines region 1 plain highlighted state.detailScroll

/// "1 commit" / "2 commits" - count + correctly-pluralized noun.
let plural (n: Int) (noun: String) : String =
  (Stdlib.Int.toString n) ++ " " ++ noun ++ (if n == 1 then "" else "s")

/// Home, the landing dashboard. A header band over two columns of boxed panels (Status + Pick-up-where-you-
/// left-off on the left; Your Matter + Jump on the right), so the screen is used and the things a Dark dev
/// actually lands wanting (am I in a good state, what was I doing, what's here, where do I go) each get a home.
let renderHome (state: State) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  let wip = SCM.PackageOps.getWipSummary state.branchId
  let commits = SCM.PackageOps.getCommitCount state.branchId
  let rootItems = loadItems state.branchId (Packages.PackageLocation.Module [])
  let branch =
    match SCM.Branch.get state.branchId with
    | Some b -> b.name
    | None -> "main"
  let conflictCount = Stdlib.List.length (Darklang.Sync.Conflicts.list ())
  let lastCommit =
    match Stdlib.List.head (SCM.PackageOps.getCommitsWithAncestors state.branchId 1) with
    | Some c -> c.message
    | None -> "no commits yet"
  let owner = if state.accountName == "" then "there" else state.accountName

  let renderHeader (r: UI.Layout.Region) : List<UI.Layout.Span> =
    Stdlib.List.flatten
      [ UI.Layout.at r 0 2 (Colors.boldText ($"Welcome back, {owner}"))
        UI.Layout.at r 1 2 (Colors.dimText ($"on {branch}  ·  a workbench over Dark Matter")) ]

  let renderStatus (inner: UI.Layout.Region) : List<UI.Layout.Span> =
    let wipLine =
      if wip.total == 0 then Colors.colorize Colors.green "✓ working tree clean"
      else Colors.colorize Colors.pink (plural wip.total "uncommitted change")
    let syncLine =
      if conflictCount == 0 then Colors.dimText "✓ in sync"
      else Colors.colorize Colors.pink ("⚠ " ++ (plural conflictCount "divergence") ++ "  ·  5 › Conflicts")
    Stdlib.List.flatten
      [ UI.Layout.at inner 0 1 wipLine
        UI.Layout.at inner 1 1 (Colors.dimText (plural commits "commit" ++ " on this branch"))
        UI.Layout.at inner 2 1 (Colors.dimText ("last: " ++ lastCommit))
        UI.Layout.at inner 3 1 syncLine ]

  let renderWip (inner: UI.Layout.Region) : List<UI.Layout.Span> =
    if wip.total == 0 then
      UI.Layout.at inner 0 1 (Colors.dimText "nothing in progress - the tree is yours to edit")
    else
      SCM.PackageOps.getWipItems state.branchId
      |> Stdlib.List.take (Stdlib.Int.max 1 inner.rows)
      |> Stdlib.List.indexedMap (fun i d ->
        let name = Stdlib.Dict.get d "name" |> Stdlib.Option.withDefault "?"
        // Pink ● is the "uncommitted work" marker everywhere (matches the tree WIP badge); keep it consistent.
        UI.Layout.at inner i 1 (Colors.colorize Colors.pink ("● " ++ name)))
      |> Stdlib.List.flatten

  let renderMatterPanel (inner: UI.Layout.Region) : List<UI.Layout.Span> =
    let owners =
      rootItems
      |> Stdlib.List.take (Stdlib.Int.max 1 (inner.rows - 1))
      |> Stdlib.List.indexedMap (fun i it ->
        UI.Layout.at inner (i + 1) 1 (Colors.colorize Colors.cyan ("🗂 " ++ it.name)))
      |> Stdlib.List.flatten
    Stdlib.List.flatten
      [ UI.Layout.at inner 0 1 (Colors.dimText (plural (Stdlib.List.length rootItems) "top-level owner"))
        owners ]

  // The commands you'll actually reach for, as a landing reference. One cyan span per row (the command), plain
  // descriptions. Printed via printAtVisible so the cyan spans don't count toward the width and get clipped on
  // narrow terminals. The `:` bar runs any of these with autocomplete (see 6.B).
  let renderCommands (inner: UI.Layout.Region) : List<UI.Layout.Span> =
    let cy = fun t -> Colors.colorize Colors.cyan t
    let rows =
      [ (cy "fn / type / val") ++ "   create functions, types, values in the tree"
        (cy "eval <expr>") ++ "       evaluate, or run a fn:  eval MyMod.myFn 1 2"
        (cy "commit \"msg\"") ++ "      save to SCM  ·  status shows what changed"
        (cy "search <term>") ++ "     find anything  ·  docs [topic] reads these docs"
        (cy "sync") ++ "              share changes  ·  conflicts to resolve"
        (cy "apps") ++ "              run & manage apps  ·  agent <verb> for AI"
        (cy "1-9 / Ctrl+←→ / `") ++ "  switch views  ·  ? for all keys"
        ""
        (cy ":commands") ++ "  the old command-prompt mode (quit there returns here)" ]
      |> Stdlib.List.take (Stdlib.Int.max 1 inner.rows)
      |> Stdlib.List.indexedMap (fun i l -> UI.Layout.at inner i 1 l)
      |> Stdlib.List.flatten
    rows

  let leftCol (r: UI.Layout.Region) : List<UI.Layout.Span> =
    UI.Layout.vstack
      r
      [ UI.Layout.fixedSize 6 (fun rr -> UI.Box.panel rr "Status" false renderStatus)
        UI.Layout.greedy (fun rr -> UI.Box.panel rr "Pick up where you left off" false renderWip) ]

  UI.Layout.vstack
    region
    [ UI.Layout.fixedSize 3 renderHeader
      UI.Layout.fixedSize 11 (fun r ->
        UI.Layout.hstack
          r
          [ UI.Layout.greedyWidth leftCol
            UI.Layout.fixedWidth 40 (fun rr -> UI.Box.panel rr "Your Matter" false renderMatterPanel) ])
      UI.Layout.greedy (fun rr ->
        UI.Box.panel rr "Commands  ·  press : to run" false renderCommands) ]

/// A full-body scrollable reader (Docs topic content, etc.).
let renderReading (content: String) (isCode: Bool) (scroll: Int) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  let plain = Stdlib.String.split content "\n"
  // Highlight code readers (Tree-leaf / Changes source); ANSI-aware truncate keeps color even when a line
  // overflows the width. Non-code content stays plain.
  let highlighted =
    if isCode then
      let h = SyntaxHighlighting.highlightCode content |> Stdlib.String.split "\n"
      if Stdlib.List.length h == Stdlib.List.length plain then h else plain
    else
      plain
  // Full-screen reader: no inset.
  renderScrollableLines region 0 plain highlighted scroll

/// A framed box holding pre-built lines (for the static/instructional views). Lines may be pre-colored.
let boxedLines
  (region: UI.Layout.Region)
  (title: String)
  (lines: List<String>)
  : List<UI.Layout.Span> =
  UI.Box.panel region title true (fun inner ->
    lines
    |> Stdlib.List.indexedMap (fun i l -> (i, l))
    |> Stdlib.List.map (fun pair ->
      let (i, l) = pair
      if i < inner.rows then UI.Layout.at inner (i + 1) 1 l else [])
    |> Stdlib.List.flatten)

/// A list+preview view (the IDE three-panel shape): the list on the dominant left pane, a scrollable preview of
/// the selected item on the right. Tab toggles focus; the preview scrolls when focused. Falls back to a single
/// empty box (naming the fill action) when the list is empty.
let splitListPreview
  (state: State)
  (region: UI.Layout.Region)
  (leftTitle: String)
  (previewTitle: String)
  (emptyMsg: String)
  : List<UI.Layout.Span> =
  if Stdlib.List.isEmpty state.items then
    let msg =
      if state.filter == "" then emptyMsg
      else Colors.dimText ("no matches for filter: " ++ state.filter ++ "   (f to change)")
    UI.Box.panel region leftTitle true (fun inner -> UI.Layout.at inner 1 1 msg)
  else
    // Surface an active filter right in the list title (plain text - the box does width math on it) so a
    // narrowed list never looks like the whole set.
    let count = Stdlib.Int.toString (Stdlib.List.length state.items)
    let titled =
      if state.filter == "" then leftTitle ++ "  ·  " ++ count
      else leftTitle ++ "  ·  " ++ count ++ "  ·  filter: " ++ state.filter
    UI.SplitPane.render
      region
      UI.SplitPane.Orientation.Horizontal
      55
      state.focus
      titled
      (fun r -> renderTreeList state r)
      previewTitle
      (fun r -> renderPreview state r)

/// A "tab  [Active]   Other   Other" section switcher at `row` within the region: the active section bright in
/// brackets, the rest dim. Shared by the SCM (Changes/History/Conflicts/Branches) and AI (Agents/Prompts) views.
let renderSectionSwitcher (region: UI.Layout.Region) (row: Int) (sections: List<String>) (active: Int) : List<UI.Layout.Span> =
  let secLine =
    sections
    |> Stdlib.List.indexedMap (fun i s ->
      if i == active then Colors.colorize (Colors.bold ++ Colors.cyan) ("[" ++ s ++ "]")
      else Colors.dimText (" " ++ s ++ " "))
    |> Stdlib.String.join "  "
  UI.Layout.at region row 0 ("  " ++ (Colors.dimText "tab") ++ "  " ++ secLine)

/// The SCM status header - the always-true summary of Dark Matter's state on this branch.
