/// The SCM and REPL view bodies, plus the pipe-stepping that fakes live values.
///
/// Part of `Darklang.Cli.Apps.Workbench.App`.
module Darklang.Cli.Apps.Workbench.App

let renderScmHeader (state: State) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  let branchOpt = SCM.Branch.get state.branchId
  let branch = match branchOpt with | Some b -> b.name | None -> "main"
  let parent =
    match branchOpt with
    | Some b ->
      match b.parentBranchId with
      | Some pid -> (match SCM.Branch.get pid with | Some p -> p.name | None -> "?")
      | None -> "(root)"
    | None -> "(root)"
  let wip = (SCM.PackageOps.getWipSummary state.branchId).total
  let commits = SCM.PackageOps.getCommitCount state.branchId
  let conflicts = Stdlib.List.length (Darklang.Sync.Conflicts.list ())
  let peers = Stdlib.List.length (Darklang.Sync.status ())
  let line1 =
    "  " ++ (Colors.boldText ("branch: " ++ branch)) ++ (Colors.dimText ("   →   " ++ parent))
  let wipPart =
    if wip == 0 then Colors.colorize Colors.green "✓ clean"
    else Colors.colorize Colors.pink ("● " ++ (plural wip "change"))
  let confPart =
    if conflicts == 0 then Colors.dimText "no conflicts"
    else Colors.colorize Colors.pink ("⚠ " ++ (plural conflicts "conflict"))
  let syncPart = if peers == 0 then Colors.dimText "no peers" else Colors.dimText ((Stdlib.Int.toString peers) ++ " peers")
  let sep = Colors.dimText "     "
  let line2 =
    "  " ++ wipPart ++ sep ++ (Colors.dimText (plural commits "commit")) ++ sep ++ confPart ++ sep ++ syncPart
  Stdlib.List.flatten
    [ UI.Layout.at region 0 0 line1
      UI.Layout.at region 1 0 line2 ]

/// The SCM view: the status header, a section switcher (Changes / History / Conflicts, cycled by Tab), and
/// the active section's list + detail. One home for the state of Dark Matter and its version control; conflict
/// resolution lives here. The ahead/behind glance is in the header (setup + cross-instance health live in Devices).
let renderScm (state: State) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  let headerRows = 4
  let headerRegion = UI.Layout.Region { top = region.top; left = region.left; rows = 2; cols = region.cols }
  let _ = renderScmHeader state headerRegion
  let _ = renderSectionSwitcher region 2 [ "Changes"; "History"; "Conflicts"; "Branches" ] state.scmSection
  let bodyRegion =
    UI.Layout.Region
      { top = region.top + headerRows
        left = region.left
        rows = Stdlib.Int.max 1 (region.rows - headerRows)
        cols = region.cols }
  let (title, empty) =
    if state.scmSection == 1 then ("History", Colors.dimText "no commits yet")
    else if state.scmSection == 2 then ("Conflicts", Colors.colorize Colors.green "✓ nothing to resolve - in sync")
    else if state.scmSection == 3 then ("Branches", Colors.dimText "no branches")
    else ("Changes", Colors.colorize Colors.green "✓ working tree clean - nothing to commit")
  splitListPreview state bodyRegion title "Detail" empty

/// Evaluate `expr` as written, with whatever the evaluator prints on the way captured rather than let loose
/// on the frame (see `captureOutputAnd` - a runtime error prints a call-stack header, which would scroll the
/// alternate screen out from under the renderer).
///
/// Goes straight at `Eval.evaluate` rather than the `eval` command because the command joins its args with
/// spaces, which would flatten the binding chain's newlines.
let evalRaw (state: State) (expr: String) : Stdlib.Result.Result<Stdlib.Option.Option<String>, String> =
  let (result, _stray) =
    captureOutputAnd (fun () -> Darklang.Cli.Eval.evaluate (classicState state) expr false)
  result

/// Evaluate an expression **with the session's bindings in scope**, and return its result (or the error text).
let evalToString (state: State) (expr: String) : String =
  match evalRaw state (Darklang.Cli.Repl.withBindings state.replBindings expr) with
  | Ok(Some s) -> Stdlib.String.trim s
  | Ok None -> ""
  | Error message -> "Error: " ++ message

/// Bind `name` to `rhs` for the rest of the session. Evaluates it once now: if the value has a literal form
/// the binding holds the *value* (so the chain that re-establishes it on every later eval is free, and an
/// effectful right-hand side runs once); otherwise it holds the expression, which does re-run. Returns the
/// binding, or None if evaluating it failed, plus the line to show in the log.
/// Evaluating it once is also what separates "this expression is broken" (the evaluator errors, so nothing
/// binds) from "this value has no literal form" (it evaluated fine, `dvalToExpr` couldn't promote it).
let bindSession (state: State) (name: String) (rhs: String) : (Stdlib.Option.Option<Darklang.Cli.Repl.Binding> * String) =
  let fallback (reason: String) : (Stdlib.Option.Option<Darklang.Cli.Repl.Binding> * String) =
    (Stdlib.Option.Option.Some(
       Darklang.Cli.Repl.Binding { name = name; source = rhs; captured = false }),
     $"{name} = {rhs}   (re-run each eval: {reason})")
  match evalRaw state (Darklang.Cli.Repl.captureExpr state.replBindings state.branchId name rhs) with
  | Error message -> (Stdlib.Option.Option.None, "not bound - " ++ message)
  | Ok None -> fallback "nothing to capture"
  | Ok(Some out) ->
    match Darklang.Cli.Repl.readCaptured out with
    | Some source ->
      (Stdlib.Option.Option.Some(
         Darklang.Cli.Repl.Binding { name = name; source = source; captured = true }),
       $"{name} = {source}")
    | None -> fallback (Stdlib.String.trim (Stdlib.String.dropFirst (Stdlib.String.trim out) 4))

/// The REPL view: a persistent eval log on the left, the session on the right. ⏎ evaluates and appends to the
/// log; `let x = ...` binds for the rest of the session and shows up in the sidebar.
let renderRepl (state: State) (region: UI.Layout.Region) : List<UI.Layout.Span> =
  UI.SplitPane.render
    region
    UI.SplitPane.Orientation.Horizontal
    62
    state.focus
    "REPL"
    (fun inner ->
      let all =
        if Stdlib.List.isEmpty state.scratchLog then
          [ Colors.boldText "A REPL over your whole package space."
            ""
            Colors.dimText "Press ⏎, type an expression, run it. Results log here."
            ""
            Colors.dimText "try:"
            (Colors.colorize Colors.cyan "  1 + 1")
            (Colors.colorize Colors.cyan "  let xs = [ 1; 2; 3 ]")
            (Colors.colorize Colors.cyan "  Stdlib.List.map xs (fun x -> x * 2)")
            ""
            Colors.dimText "`let` binds for the session - the"
            Colors.dimText "sidebar lists what's bound."
            ""
            Colors.dimText "f clears the log, x the session." ]
        else state.scratchLog
      let shown = all |> Stdlib.List.reverse |> Stdlib.List.take inner.rows |> Stdlib.List.reverse
      shown
      |> Stdlib.List.indexedMap (fun i l -> (i, l))
      |> Stdlib.List.map (fun p ->
        let (i, l) = p
        UI.Layout.at inner i 1 l)
      |> Stdlib.List.flatten)
    "Session"
    (fun inner ->
      let bindingLines =
        if Stdlib.List.isEmpty state.replBindings then
          [ Colors.dimText "nothing bound yet."
            ""
            (Colors.colorize Colors.cyan "let x = 41 + 1")
            Colors.dimText "binds x for the rest of the"
            Colors.dimText "session, so the next"
            Colors.dimText "expression can use it." ]
        else
          state.replBindings
          |> Stdlib.List.map (fun b ->
            // A captured binding holds the value; an uncaptured one holds the expression and re-runs, which
            // is worth saying on the row rather than in a footnote.
            let marker = if b.captured then "" else Colors.dimText "  ~"
            (Colors.colorize Colors.cyan b.name)
            ++ (Colors.dimText " = ")
            ++ (Colors.colorize Colors.green b.source)
            ++ marker)
      let resultLines =
        if (Stdlib.String.trim state.replLast) == "" then
          []
        else
          [ ""; Colors.dimText "last result:"; Colors.colorize Colors.green state.replLast ]
      let count = Stdlib.List.length state.replBindings
      let heading =
        if count == 0 then Colors.dimText "session bindings:"
        else Colors.dimText ("session bindings  ·  " ++ (plural count "name") ++ ":")
      let lines =
        Stdlib.List.flatten [ [ heading; "" ]; bindingLines; resultLines ]
      lines
      |> Stdlib.List.indexedMap (fun i l -> (i, l))
      |> Stdlib.List.take inner.rows
      |> Stdlib.List.map (fun p ->
        let (i, l) = p
        UI.Layout.at inner i 1 l)
      |> Stdlib.List.flatten)

/// Real config (from cli-config.json) as (key, value) pairs - backs the Devices "Configuration" section and
/// the `c` reader. This is the actual persisted config, not mock.
