/// The `workbench` SubApp - the framed home the CLI-UX redesign is built around: the Frame chrome (tab bar
/// + breadcrumb + key hints) around a live, navigable body, one view per tab. `dark` with no args opens it.
/// See design main/notes/cli-ux/{03A,10,11,12}.
///
/// This module is split across files (Dark merges same-named modules; modelContextProtocol does the same).
/// This file holds only the CLI integration surface: the SubApp wrapper and the command entry points.
///
///   types.dark     State and the other records, the view-index constants, the view registry helpers
///   loaders.dark   reads - real data in, BodyItems and detail text out. No terminal output
///   render.dark    the body renderers: shared list/preview primitives, then one per view
///   viewdefs.dark  the extension-view registry (the seam for adding a view without the core knowing)
///   chrome.dark    body dispatch, hints, help/picker overlays, the full-frame paint
///   nav.dark       movement and actions; each returns a Step
///   input.dark     the `:` bar and the other single-line input modes, plus authoring
///   keys.dark      the key dispatcher
///   frame.dark     the shared chrome render helpers (its own module)
///
/// Rendering here is still the legacy absolute-positioning model (`UI.Layout` Region + printAt), which is
/// why the screen flashes. Everything else in the CLI now returns a `Tui.View` and lets the renderer diff
/// frames. Moving `render` to `viewAtSize : State -> Tui.Size -> Tui.View` is the remaining work.
module Darklang.Cli.Apps.Workbench.App


let makeSubApp (state: State) : Darklang.Cli.SubApp =
  Darklang.Cli.SubApp
    { onKey =
        fun key modifiers keyChar ->
          match handleKey state key modifiers keyChar with
          | Continue s -> (Darklang.Cli.SubAppAction.Continue, makeSubApp s)
          | Exit s -> (Darklang.Cli.SubAppAction.Exit, makeSubApp s)
          // Hand off to a foreground command; the CLI returns to this workbench (state s) when it exits.
          | Launch(s, cmd) -> (Darklang.Cli.SubAppAction.LaunchCommand cmd, makeSubApp s)
          | ToPrompt s -> (Darklang.Cli.SubAppAction.LaunchPrompt, makeSubApp s)
      onDisplay = fun () -> render state
      onSave = fun () -> ()
      // LEGACY surface management. Every other SubApp now hands its terminal to `Tui.TerminalSession`, which
      // owns the alternate screen, diffs frames, and arms a restore guard for crashes. The workbench still
      // paints by absolute positioning (see `UI.Layout`), so it drives the screen itself. These two go away
      // when `render` becomes a `viewAtSize : State -> Tui.Size -> Tui.View`.
      onTerminate =
        fun () ->
          // Reset style and show the cursor before leaving, so a Ctrl-C doesn't strand either.
          Stdlib.print "[0m[?25h[?1049l"
      onResume =
        fun () ->
          Stdlib.print "[?1049h"
          render state
          makeSubApp state }


// ── CLI command entry ──

let execute (cliState: Darklang.Cli.AppState) (_args: List<String>) : Darklang.Cli.AppState =
  Stdlib.print "\u001b[?1049h"
  let branchId = cliState.currentBranchId
  let rootLoc = Packages.PackageLocation.Module []
  // Which gated views (Devices, Crons, Calendar, ...) are enabled for this account - computed once from config
  // so there's no per-frame file I/O. Config-driven, not env vars: `config set devices.enabled true`,
  // `config set calendar.enabled stachu`, etc. (also on the `:` bar). Derived from `viewSpecs`, so a new
  // gateable view (base or extension) is picked up here with no edit.
  let enabledGatedViews =
    viewSpecs ()
    |> Stdlib.List.filter (fun spec ->
      let (_i, _n, g) = spec
      (g != "") && (gateEnabled g cliState.accountName))
    |> Stdlib.List.map (fun spec ->
      let (i, _n, _g) = spec
      i)
  // Register this instance's UUID on first run (durable in cli-config.json).
  let _ =
    match Darklang.Cli.Config.get "instance.id" with
    | Some _ -> ()
    | None ->
      let cfg = Darklang.Cli.Config.readConfig ()
      let cfg2 = Stdlib.Dict.setOverridingDuplicates cfg "instance.id" (Stdlib.Uuid.toString (Stdlib.Uuid.generate ()))
      Darklang.Cli.Config.writeConfig cfg2
  // Instance name: config override wins, else the machine hostname, else a safe fallback. Config-adjustable.
  let instanceName =
    match Darklang.Cli.Config.get "instance.name" with
    | Some n -> n
    | None ->
      match Stdlib.Cli.Sys.hostname () with
      | Ok h -> h
      | Error _ -> "this-machine"
  let state =
    State
      { activeView = 0
        location = rootLoc
        items = loadItems branchId rootLoc
        selected = 0
        focus = UI.SplitPane.Focus.First
        detailScroll = 0
        reading = Stdlib.Option.Option.None
        readingIsCode = false
        input = Stdlib.Option.Option.None
        editing = Stdlib.Option.Option.None
        accountId = cliState.accountID
        accountName = cliState.accountName
        instanceName = instanceName
        message = ""
        searchHits = []
        searchSelected = 0
        showHelp = false
        viewPicker = false
        pickerSelected = 0
        completionSel = 0
        scmSection = 0
        aiSection = 0
        enabledGatedViews = enabledGatedViews
        scratchLog = []
        replSteps = []
        matterLens = "all"
        filter = ""
        branchId = branchId }
  { cliState with
      currentPage = Darklang.Cli.Page.SubApp (makeSubApp state) }

let help (_state: Darklang.Cli.AppState) : Darklang.Cli.AppState =
  [ "Usage: workbench"
    "Open the workbench - a framed, navigable view of your package tree."
    ""
    "  Up/Down   move    Right/Enter into    Left up    1-9 switch view    Esc/q exit" ]
  |> Stdlib.printLines
  _state

let complete
  (_state: Darklang.Cli.AppState)
  (_args: List<String>)
  : List<Darklang.Cli.Completion.CompletionItem> =
  []
