/// HTTP-server daemon entrypoints. Each is a `(name) -> Unit` daemon: it claims its pidfile (so
/// `dark apps` manages it), reads its port from cli-config.json (`apps.<name>.port`, with a default),
/// then serves its router via `Stdlib.HttpServer.serve` (blocks until SIGTERM; override knobs with
/// record-update on `Config.defaults`). The generic daemon lifecycle (pidfile / liveness / stop) lives in
/// `Stdlib.Cli.Daemon`; these just bind a router to a port.
module Darklang.Cli.Apps.Servers

// Claim the pidfile, resolve the port (config `apps.<name>.port`, else `defaultPort`), then serve `router`.
let httpDaemon
  (name: String)
  (defaultPort: Int)
  (label: String)
  (router: Stdlib.Http.Request -> Stdlib.Http.Response)
  : Unit =
  let _claimed = Stdlib.Cli.Daemon.claimPidfile name
  let port = Config.getInt ("apps." + name + ".port") defaultPort

  let announce () : Unit =
    Stdlib.printLine
      $"{name}: serving {label} on http://localhost:{Stdlib.toString port}"

  match Stdlib.HttpServer.serve (Stdlib.HttpServer.Config.defaults port) router announce with
  | Ok _ -> ()
  | Error msg -> Stdlib.printLine msg


// `dark-packages` — the package API server that powers wip.darklang.com/packages. Defaults to 9090, a
// port the devcontainer forwards (9090–9099), so it's reachable from the host; override via config.
let darkPackages (name: String) : Unit =
  httpDaemon name 9090 "DarkPackages.router" Darklang.Internal.DarkPackages.router

// `demo-http` — a tiny demo server (/, /hello, /echo). Defaults to 9091 (a devcontainer-forwarded port).
let demoHttp (name: String) : Unit =
  httpDaemon name 9091 "HttpServerTest.router" Darklang.DemoData.HttpServerTest.router


/// One sync tick every <param intervalMs>, counter-bounded like `Examples.beat` (the unit's
/// Restart=on-failure brings it back regardless). With no relay configured it waits quietly --
/// enabling before `dark sync setup` is fine, and each tick re-reads the config so setup takes
/// effect without a restart.
let syncTick (name: String) (intervalMs: Int) (state: Cli.AppState) (remaining: Int) : Int =
  if remaining <= 0 then
    0
  else
    let url = SCM.PackageOps.relay ()

    let nextState =
      if url == "" then
        state
      else
        Cli.Sync.executeSync state url

    // Wait ON THE RELAY rather than on a timer: ask it to hold the request until its head moves,
    // for at most one interval. A relay that supports it answers the moment somebody else's push
    // lands, which is what turns "your edit is live in five seconds" into "in under a second".
    //
    // The interval is still the floor. An older relay ignores the parameters and answers at once,
    // so the wait returning early WITHOUT the head having moved means "this relay does not hold
    // requests", and the rest of the interval is slept as it always was. Without that a daemon
    // pointed at an old relay would spin.
    if url == "" then
      Stdlib.Cli.Posix.sleep (Stdlib.Int.toFloat intervalMs)
    else
      let startedAt = Cli.Telemetry.now ()
      let moved = Cli.Sync.waitForRelayHead url intervalMs
      let elapsed = (Cli.Telemetry.now ()) - startedAt

      if (Stdlib.Bool.not moved) && (elapsed < intervalMs) then
        Stdlib.Cli.Posix.sleep (Stdlib.Int.toFloat (intervalMs - elapsed))
      else
        ()

    syncTick name intervalMs nextState (remaining - 1)

/// The set-and-forget sync loop: `dark apps enable sync` runs this as an auto-starting daemon.
/// Each tick is exactly `dark sync` (push committed work, pull, print the story). A pull landing
/// mid-edit is safe -- the two-machine runs drove live authoring under this exact loop. Interval:
/// `apps.sync.intervalMs` in cli-config.json, default 30000.
let syncDaemon (name: String) : Int =
  let intervalMs = Config.getInt ("apps." + name + ".intervalMs") 30000

  let _logged =
    match Stdlib.Cli.Daemon.claimPidfile name with
    | Error e -> Stdlib.printLine $"{name}: could not write pidfile: {e}"
    | Ok _ ->
      Stdlib.printLine
        $"{name}: syncing every {Stdlib.toString intervalMs}ms (pid {Stdlib.toString (Stdlib.Cli.Sys.currentPid ())})"

  syncTick name intervalMs (Cli.initState ()) 1000000000
