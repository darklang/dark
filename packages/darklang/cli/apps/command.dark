module Darklang.Cli.Apps.Command

// `dark apps` — see, curate, run, and manage the Dark apps this instance cares about. `list` shows the
// apps you've INSTALLED (empty by default); `list-available` is the catalog. Foreground apps `run`
// attached; daemons `start`/`stop`/`status`/`logs`/`inspect` via `Stdlib.Cli.Daemon`. Apps are referenced
// by their kebab-case slug.

/// The port a running HTTP daemon bound to, read from its log (`… on http://localhost:<port>`). This is
/// the *actual* port (default or config override), so it's accurate without the browser knowing defaults.
/// `None` for daemons that aren't HTTP servers (they never log a port).
let daemonPort (slug: String) : Stdlib.Option.Option<Int> =
  let portLines =
    (Stdlib.Cli.Daemon.tailLog slug 25)
    |> Stdlib.List.filter (fun l -> Stdlib.String.contains l "localhost:")

  match Stdlib.List.last portLines with
  | None -> Stdlib.Option.Option.None
  | Some line ->
    match Stdlib.List.last (Stdlib.String.split line "localhost:") with
    | None -> Stdlib.Option.Option.None
    | Some tail -> Stdlib.Result.toOption (Stdlib.Int.parse (Stdlib.String.trim tail))

/// The config key holding the entrypoint's hash as it was when the daemon started.
let startedHashKey (slug: String) : String = "apps." ++ slug ++ ".startedHash"

/// The hash a daemon's entrypoint resolves to now, "" when it does not.
let entrypointHash (branchId: Uuid) (entrypoint: String) : String =
  match Stdlib.Live.locationOfName entrypoint with
  | None -> ""
  | Some entry ->
    match LanguageTools.PackageManager.Function.find branchId entry with
    | Some hash -> LanguageTools.ProgramTypes.hashToString hash
    | None -> ""

/// Remember what version a daemon started on, so `dark apps` can say when it has moved.
let recordStartedHash (branchId: Uuid) (app: Model.App) : Unit =
  match app.target with
  | Daemon entrypoint ->
    let cfg = Config.readConfig ()
    Config.writeConfig
      (Stdlib.Dict.setOverridingDuplicates cfg (startedHashKey app.slug) (entrypointHash branchId entrypoint))
  | _ -> ()

/// Start <param app>'s daemon detached (`dark apps daemon-main <slug>`), recording the version it
/// started on so `apps list` can say when it falls behind. The one launch path: `apps start` and
/// the apps editor both come through here.
let launchDaemon (branchId: Uuid) (app: Model.App) : Stdlib.Result.Result<Int, String> =
  match Stdlib.Cli.Daemon.startWith app.slug [ "apps", "daemon-main", app.slug ] with
  | Ok pid ->
    recordStartedHash branchId app
    Stdlib.Result.Result.Ok pid
  | Error e -> Stdlib.Result.Result.Error e

/// "behind" when the entrypoint a running daemon started on is no longer the version at its name.
/// A daemon on `Apps.Runner` follows its STEP between ticks and never needs this for the step; the
/// entrypoint itself, and any daemon written as one long-running fn, needs `apps restart`.
let behindSuffix (branchId: Uuid) (app: Model.App) : String =
  match app.target with
  | Daemon entrypoint ->
    match Config.get (startedHashKey app.slug) with
    | Some started when started != "" ->
      if (entrypointHash branchId entrypoint) == started then "" else ", behind (`apps restart`)"
    | _ -> ""
  | _ -> ""

/// The live state of a daemon, for listing: "running (pid N) :port" / "stale (pid N)" / "stopped".
/// HTTP daemons append the port they actually bound to.
let daemonState (slug: String) : String =
  match Stdlib.Cli.Daemon.recordedPid slug with
  | Some pid ->
    if Stdlib.Cli.Posix.isProcessRunning pid then
      let portStr =
        match daemonPort slug with
        | Some p -> $" :{Stdlib.Int.toString p}"
        | None -> ""
      $"running (pid {Stdlib.Int.toString pid}){portStr}"
    else
      $"stale (pid {Stdlib.Int.toString pid})"
  | None -> "stopped"

/// One list row: pretty label · (slug) · [kind] · description — daemons append their live state.
let row (branchId: Uuid) (app: Model.App) : String =
  let tag = Model.kindTag app.target
  let extra =
    match app.target with
    | Daemon _ ->
      let daemon = daemonState app.slug
      let running = Stdlib.String.startsWith daemon "running"
      let behind = if running then behindSuffix branchId app else ""
      "  " ++ Stdlib.Cli.UI.Colors.dimText ("· " ++ daemon ++ behind)
    | _ -> ""
  $"  {app.name}  {Stdlib.Cli.UI.Colors.dimText ($"({app.slug})  [{tag}]")}  {Stdlib.Cli.UI.Colors.dimText app.description}{extra}"


/// `apps run <slug>` — run a foreground app attached, dispatching its CLI command in-process.
let runApp (state: Cli.AppState) (slug: String) : Cli.AppState =
  match Registry.findBySlug state.currentBranchId slug with
  | None ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
    state
  | Some app ->
    match app.target with
    | Foreground command -> Cli.Registry.executeCommand command state []
    | Daemon _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"'{slug}' is a daemon — start it with `apps start {slug}`")
      state

/// `apps daemon-main <slug>` — the body of a daemon process: what `apps start` launches
/// detached, and what a unit file supervises. A CLI verb rather than `eval '<entrypoint>
/// "<slug>"'` because a command runs in the CLI's host state, and an `eval` guest does not
/// get the host's capabilities: the sync daemon's transport was refused that way.
let daemonMain (state: Cli.AppState) (slug: String) : Cli.AppState =
  match Registry.findBySlug state.currentBranchId slug with
  | None ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
    { state with exitCode = 1 }
  | Some app ->
    match app.target with
    | Daemon entrypoint ->
      if Stdlib.Bool.not (Model.isValidEntrypoint entrypoint) then
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.error $"'{slug}' has an entrypoint that isn't a plain function name")
        { state with exitCode = 1 }
      else
        match Stdlib.Live.applicableByName state.currentBranchId entrypoint with
        | Error e ->
          Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"{slug}: {e}")
          { state with exitCode = 1 }
        | Ok f ->
          // Applied here, in this frame, not through `Live.apply`: that makes the fn the
          // approval root of a guest run, and a guest has no host capabilities. The daemon
          // body runs as the CLI's own code, which is what a registered daemon is.
          let _ran = f slug
          state
    | _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"'{slug}' is not a daemon")
      { state with exitCode = 1 }

/// `apps start <slug>` — launch a daemon detached (verified) and report its pid.
let startDaemon (state: Cli.AppState) (slug: String) : Cli.AppState =
  if Service.platform () == Service.Platform.Unsupported then
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Background daemons need Linux or macOS — they're not supported on this platform yet.")
    state
  else

  match Registry.findBySlug state.currentBranchId slug with
  | None ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
  | Some app ->
    match app.target with
    | Daemon entrypoint ->
      // The same guard `enable` applies before writing a unit file. The entrypoint is spliced into an
      // expression a daemon evaluates, and it came from a package, which came from anywhere.
      if Stdlib.Bool.not (Model.isValidEntrypoint entrypoint) then
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.error $"'{slug}' has an entrypoint that isn't a plain function name")
      else

      match launchDaemon state.currentBranchId app with
      | Ok pid ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ {app.name} started (pid {Stdlib.Int.toString pid})")
      | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
    | Foreground _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"'{slug}' is a foreground app — run it with `apps run {slug}`")

  state

/// `apps view <slug> [<name>]` — open one of an app's live views; it follows edits until Esc.
///
/// The slug may also be a MODULE path (`My.Dashboard`): a module with `init`, `update` and `render`
/// is a view without anyone declaring an app for it, which is the shape a first edit-and-watch
/// session wants.
let viewApp
  (state: Cli.AppState)
  (slug: String)
  (name: String)
  (resume: Stdlib.Option.Option<String>)
  : Cli.AppState =
  match Registry.findBySlug state.currentBranchId slug with
  | None when Stdlib.String.contains slug "." ->
    match Host.openView state.currentBranchId (Model.viewAt slug slug slug) resume with
    | Ok _ -> state
    | Error e ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
      { state with exitCode = 1 }
  | None ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
    state
  | Some app ->
    match Model.viewNamed app.target name with
    | None ->
      match app.target with
      | Views views ->
        let names = views |> Stdlib.List.map (fun v -> v.name) |> Stdlib.String.join ", "
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"'{slug}' has no view '{name}' (it has: {names})")
      | _ ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"'{slug}' has no live views -- `apps run {slug}` or `apps start {slug}`")

      state
    | Some view ->
      match Host.openView state.currentBranchId view resume with
      | Ok _ -> state
      | Error e ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
        { state with exitCode = 1 }

/// `apps inspect <slug>` — label, slug, target, installed?, and (daemons) status + recent logs.
let inspect (state: Cli.AppState) (slug: String) : Cli.AppState =
  match Registry.findBySlug state.currentBranchId slug with
  | None ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
  | Some app ->
    Stdlib.printLine $"{app.name}  [{Model.kindTag app.target}]"
    Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"  {app.slug} — {app.description}")
    Stdlib.printLine $"  target:    {Model.reference app.target}"
    let installedStr = if Registry.isInstalled slug then "yes" else "no"
    Stdlib.printLine $"  installed: {installedStr}"

    match app.target with
    | Daemon _ ->
      Stdlib.printLine $"  status:    {Stdlib.Cli.Daemon.statusLine slug}"
      let logs = Stdlib.Cli.Daemon.tailLog slug 5
      if Stdlib.List.isEmpty logs then
        ()
      else
        Stdlib.printLine "  recent logs:"
        logs |> Stdlib.List.map (fun l -> "    " ++ l) |> Stdlib.printLines
    | Foreground _ -> ()
    | Views views ->
      views
      |> Stdlib.List.iter (fun v ->
        Stdlib.printLine $"  view:      {v.name}  ({v.render})")

  state


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  // `dark apps` with no args opens the interactive browser.
  | [] -> Editor.launch state

  | [ "list" ] ->
    let apps = Registry.installed state.currentBranchId
    if Stdlib.List.isEmpty apps then
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.dimText
          "No apps installed. `apps list-available` shows the catalog; `apps add <slug>` adds one.")
    else
      Stdlib.printLine "Installed apps:"
      apps |> Stdlib.List.map (fun a -> row state.currentBranchId a) |> Stdlib.printLines

    state

  | [ "list-available" ] | [ "available" ] ->
    Stdlib.printLine "Available apps:"
    (Registry.catalog state.currentBranchId)
    |> Stdlib.List.map (fun a ->
      let installedTag =
        if Registry.isInstalled a.slug then Stdlib.Cli.UI.Colors.success "  ✓ installed" else ""
      (row state.currentBranchId a) ++ installedTag)
    |> Stdlib.printLines

    Stdlib.printLine ""
    Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText "  `apps add <slug>` to add one to this instance")
    state

  | [ "add", slug ] ->
    match Registry.findBySlug state.currentBranchId slug with
    | None ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
      state
    | Some app ->
      if Registry.isInstalled slug then
        Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"'{app.name}' is already installed")
        state
      else
        Registry.addInstalled slug
        Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ added {app.name}")
        // Foreground apps get a PATH shim so `<slug>` runs from the shell; daemons are start/stop-managed.
        match app.target with
        | Foreground _ ->
          match Install.writeAlias app with
          | Ok path ->
            Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"  installed shim {path} — run `{slug}` from the shell (or `apps run {slug}`)")
          | Error e ->
            Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"  (couldn't write shell shim: {e}) — run it with `apps run {slug}`")
        | Daemon _ -> Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"  start it with `apps start {slug}`")
        state

  | [ "remove", slug ] ->
    if Registry.isInstalled slug then
      Registry.removeInstalled slug
      Install.removeAlias slug
      Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ removed '{slug}'")
    else
      Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"'{slug}' is not installed")

    state

  | [ "run", slug ] -> runApp state slug

  // No view named: the one `Live.show` points at, when something has pointed.
  | [ "view" ] ->
    match Stdlib.Live.shown () with
    | Some loc -> viewApp state (Stdlib.Live.entryName loc) "" Stdlib.Option.Option.None
    | None ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.error
          "nothing to show yet: `apps view <slug>` or `apps view <Module.Path>` opens one; `apps view` alone opens whatever `Stdlib.Live.show` last pointed at")
      { state with exitCode = 1 }

  | [ "view", slug ] -> viewApp state slug "" Stdlib.Option.Option.None
  | [ "view", slug, "--resume", saved ] -> viewApp state slug "" (Stdlib.Option.Option.Some saved)
  | [ "view", slug, name ] -> viewApp state slug name Stdlib.Option.Option.None
  | [ "view", slug, name, "--resume", saved ] -> viewApp state slug name (Stdlib.Option.Option.Some saved)

  // `spawn` is an alias for `start` (the verb for bringing a daemon to life).
  | [ "start", slug ] | [ "spawn", slug ] -> startDaemon state slug
  | [ "daemon-main", slug ] -> daemonMain state slug

  // Stop, then start: for a daemon that is `behind` (its entrypoint moved under it) and for one
  // written as a single long-running fn, which cannot follow an edit any other way.
  | [ "restart", slug ] ->
    let _ = Stdlib.Cli.Daemon.stop slug
    startDaemon state slug

  | [ "stop", slug ] ->
    match Stdlib.Cli.Daemon.stop slug with
    | Ok msg -> Stdlib.printLine (Stdlib.Cli.UI.Colors.success msg)
    | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)

    state

  | [ "status" ] ->
    // Every daemon that's installed OR currently running — a daemon started with `apps start` but not
    // "installed" (auto-start on login) is still running and MUST show here, else `apps status` misleadingly
    // reports "nothing" right after you start one (e.g. `apps start sync`).
    let daemons =
      (Registry.catalog state.currentBranchId)
      |> Stdlib.List.filter (fun a -> Model.isDaemon a.target)
      |> Stdlib.List.filter (fun a ->
        Registry.isInstalled a.slug || Stdlib.Cli.Daemon.isRunning a.slug)

    if Stdlib.List.isEmpty daemons then
      Stdlib.printLine (
        Stdlib.Cli.UI.Colors.dimText "No daemons running or installed. Start one, e.g.: dark apps start sync")
    else
      Stdlib.printLine "Daemon status:"
      daemons
      |> Stdlib.List.map (fun a -> "  " ++ Stdlib.Cli.Daemon.statusLine a.slug)
      |> Stdlib.printLines

    state

  | [ "status", slug ] ->
    Stdlib.printLine ("  " ++ Stdlib.Cli.Daemon.statusLine slug)
    state

  | [ "logs", slug ] ->
    let lines = Stdlib.Cli.Daemon.tailLog slug 20

    if Stdlib.List.isEmpty lines then
      Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"no logs for '{slug}' (has it run?)")
    else
      Stdlib.printLines lines

    state

  | [ "inspect", slug ] -> inspect state slug

  | [ "enable", slug ] ->
    match Registry.findBySlug state.currentBranchId slug with
    | None -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"no app '{slug}' (see `apps list-available`)")
    | Some app ->
      match Service.enable app with
      | Enabled msg -> Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ {msg}")
      | WroteOnly msg -> Stdlib.printLine (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow $"⚠ {msg}")
      | Failed e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
    state

  | [ "disable", slug ] ->
    match Service.disable slug with
    | Ok msg -> Stdlib.printLine (Stdlib.Cli.UI.Colors.success $"✓ {msg}")
    | Error e -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error e)
    state

  | _ ->
    Stdlib.printLine (Command.help state)
    state


// Show the stable app slug as the completion value, with the human name as the hint.
let slugs (apps: List<Model.App>) : List<Cli.Completion.CompletionItem> =
  apps |> Stdlib.List.map (fun a -> Cli.Completion.withDescription a.slug a.name)

let complete
  (state: Cli.AppState)
  (args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  match args with
  | [] ->
    [ "list", "list-available", "add", "remove", "run", "view", "start", "spawn"
      "restart", "stop", "status", "logs", "inspect", "enable", "disable" ]
    |> Stdlib.List.map Cli.Completion.simple
  // Only load the catalog once a verb needs slug completions.
  | [ verb ] ->
    let catalog = Registry.catalog state.currentBranchId
    let daemons = catalog |> Stdlib.List.filter (fun a -> Model.isDaemon a.target)

    match verb with
    | "add" ->
      slugs (catalog |> Stdlib.List.filter (fun a -> Stdlib.Bool.not (Registry.isInstalled a.slug)))
    | "remove" -> slugs (Registry.installed state.currentBranchId)
    | "run" -> slugs (catalog |> Stdlib.List.filter (fun a -> Stdlib.Bool.not (Model.isDaemon a.target)))
    | "view" -> slugs (catalog |> Stdlib.List.filter (fun a -> Model.kindTag a.target == "views"))
    | "start" | "spawn" | "restart" | "stop" | "status" | "logs" | "enable" | "disable" -> slugs daemons
    | "inspect" -> slugs catalog
    | _ -> []
  | _ -> []


// A single help line: "  cmd <args>   description", padded for a clean column.
let helpLine (usage: String) (desc: String) : String =
  let pad = Stdlib.String.padEndToWidth usage 26
  "  " ++ pad ++ Stdlib.Cli.UI.Colors.dimText desc

let help (_state: Cli.AppState) : String =
  Stdlib.printLine (Stdlib.Cli.UI.Colors.boldText "dark apps")
  Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText "  See, curate, run, and manage the Dark apps this instance cares about.")
  Stdlib.printLine ""
  // Shared — work on any app.
  [ helpLine "apps" "Interactive browser: review the catalog, install, start/stop"
    helpLine "apps list" "Apps you've installed (empty by default)"
    helpLine "apps list-available" "The full catalog (+ which you've installed)"
    helpLine "apps add <slug>" "Install an app (foreground apps get a shell shim)"
    helpLine "apps remove <slug>" "Uninstall it"
    helpLine "apps inspect <slug>" "Detail: target, installed?, status + logs" ]
  |> Stdlib.printLines

  Stdlib.printLine ""
  Stdlib.printLine (Stdlib.Cli.UI.Colors.boldText "  Foreground apps")
  [ helpLine "apps run <slug>" "Run attached in your terminal" ] |> Stdlib.printLines

  Stdlib.printLine ""
  Stdlib.printLine (Stdlib.Cli.UI.Colors.boldText "  Live views")
  [ helpLine "apps view <slug> [<name>]" "Open a view; it follows edits to its code until Esc"
    helpLine "apps view <Module.Path>" "The same for any module with init, update and render"
    helpLine "apps view" "The view `Stdlib.Live.show` last pointed at (an agent's channel)"
    helpLine "  ... --resume <val>" "Start from a model saved with Ctrl-S (a `val` under .Sessions)" ]
  |> Stdlib.printLines

  Stdlib.printLine ""
  Stdlib.printLine (Stdlib.Cli.UI.Colors.boldText "  Daemons")
  [ helpLine "apps start <slug>" "Launch detached (alias: spawn)"
    helpLine "apps restart <slug>" "Stop and start; for one `behind` an edit to its entrypoint"
    helpLine "apps stop <slug>" "Stop a running daemon"
    helpLine "apps status [slug]" "Running / stopped / stale (+ pid)"
    helpLine "apps logs <slug>" "Recent log lines"
    helpLine "apps enable <slug>" "Auto-start on login (OS service)"
    helpLine "apps disable <slug>" "Remove its auto-start" ]
  |> Stdlib.String.join "\n"
