module Darklang.Cli.Docs.Enums

let content(): String =
  """# Enums

## Define
  type Status = | Pending | Done(Int64)
  type Shape = | Seg(Point, Point)          # two fields, separated by commas
  type Shape = | Seg(Point * Point)         # one field, a tuple
  type Key = | Pressed(key: Char, shift: Bool)  # labels are documentation only

## Construct
  Status.Pending
  Status.Done(42)
  Some(5)            # Option/Result constructors can be bare
  Ok("yes")
  MyType.Case(value) # other enums need the type prefix
  Pair(1, 2)         # several fields: commas, like a call's arguments

## Match (the type prefix is optional)
  match status with
  | Pending -> "waiting"
  | Done(n) -> $"done: {n}"

  match opt with
  | Some(v) -> v
  | None -> default

## Gotcha: a tuple inside a constructor needs double parens
  match x with
  | Some((a, b)) -> ...     # one field containing a tuple
  | None -> ...
  # `Some(a, b)` is two fields, and Some has one."""
