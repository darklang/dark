module Darklang.Cli.Docs.Records

let content(): String =
  """# Records

Fields use commas or newlines. Semicolons are a parse error.

## Define
  type Person = { name: String, age: Int64 }

## Construct (alignment matters!)
  Person { name = "Jo", age = 30 }    # OK
  Person                                # OK
    { name = "Jo"
      age = 30 }
  Person
  { name = "Jo" }                       # WRONG - { left of type

## Access
  person.name

## Update
  { person with name = "Jane", age = 31 }

## Pattern matching
  match p with
  | { age = 0 } -> "newborn"         # fields you leave out are ignored
  | { name } -> name                 # short for { name = name }"""
