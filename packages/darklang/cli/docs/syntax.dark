module Darklang.Cli.Docs.Syntax

let content () : String =
  """# Syntax

## Basics
  let x = 5
  let add (a: Int) (b: Int) : Int = a + b
  if cond then a else b
  // comment

## Functions
  let greet (name: String) : String = $"Hello, {name}"

Nested functions are supported in a function body, but require parameter and
return annotations:
  let outer (n: Int) : Int =
    let double (x: Int) : Int = x * 2
    double n

## Match
  match x with
  | Some v -> v
  | None -> 0

## Result and Option: let!
  let total (a: String) (b: String) : Stdlib.Result.Result<Int, Stdlib.Int.ParseError> =
    let! x = Stdlib.Int.parse a
    let! y = Stdlib.Int.parse b
    Ok (x + y)

`let! x = e` binds the Ok/Some value, or returns the Error/None from the nearest
function or lambda. You still write Ok/Some on success. The function must return
the same kind; Result error types must agree. Convert with Stdlib.Option.toResult
when mixing. Fail on purpose with `let! _ = Error e`.

## Pipe (parens for complex LHS)
  (Stdlib.List.range 0 10) |> Stdlib.List.map fn

## Lists (comma separator)
  [1, 2, 3]

## Strings
  "hello" ++ " world"    # concat
  $"value: {x}"          # interpolation

## Lambda
  fun x -> x + 1
  fun (a, b) -> a + b

## Unit
  ()     # value
  Unit   # type

## Printing multiple lines
  // When printing 3+ lines, prefer printLines over repeated printLine:
  [ "line 1"
    "line 2"
    "line 3"
  ] |> Stdlib.printLines"""
