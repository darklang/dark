module Darklang.Cli.Docs.Command

// The docs command - in-CLI documentation system
// Usage: docs [topic] [subtopic]
// TODO: Add subtopic drill-down support (docs stdlib list, docs cli nav, etc.)
// TODO: Add detailed docs if AI agents need more depth:
//   - stdlib-list, stdlib-string, stdlib-option, stdlib-result
//   - cli-nav, cli-create, cli-scm
//   - errors-parse, errors-types
//   - testing

module Topics =
  // All available doc topics - maps name to (description, content-fn)
  // Content is stored in Docs submodules

  /// Where a doc topic is relevant: "general" for language docs, useful anywhere, or
  /// "cli" for CLI workflow and commands. There was a third, "internal", for monorepo and
  /// F# work; those two pages are repo-facing and moved out of the shipped CLI, so no topic
  /// carries it any more. See later/packages/darklang/cli/docs/command.dark.internal-topics.
  type DocTopic =
    { name: String
      description: String
      aliases: List<String>
      context: String
      content: Unit -> String
      subtopics: List<DocTopic> }


  let allTopics(): List<DocTopic> =
    [ DocTopic
        { name = "for-ai"
          description = "AI agent guide - start here"
          aliases = [ "ai", "agent" ]
          context = "cli"
          content = Docs.ForAI.content
          subtopics = forAISubtopics() }

      DocTopic
        { name = "scripts"
          description = "Run .dark files"
          aliases = [ "script", "run-script", "run" ]
          context = "cli"
          content = Docs.Scripts.content
          subtopics = [] }

      DocTopic
        { name = "syntax"
          description = "Language syntax reference"
          aliases = [ "lang" ]
          context = "general"
          content = Docs.Syntax.content
          subtopics = [] }

      DocTopic
        { name = "types"
          description = "Type system overview"
          aliases = []
          context = "general"
          content = Docs.Types.content
          subtopics = [] }

      DocTopic
        { name = "records"
          description = "Record types deep dive"
          aliases = []
          context = "general"
          content = Docs.Records.content
          subtopics = [] }

      DocTopic
        { name = "enums"
          description = "Enums/unions deep dive"
          aliases = [ "unions" ]
          context = "general"
          content = Docs.Enums.content
          subtopics = [] }

      DocTopic
        { name = "pattern-matching"
          description = "Match expressions"
          aliases = [ "match", "patterns" ]
          context = "general"
          content = Docs.PatternMatching.content
          subtopics = [] }

      DocTopic
        { name = "functions"
          description = "Functions and lambdas"
          aliases = [ "fn", "fns" ]
          context = "general"
          content = Docs.Functions.content
          subtopics = [] }

      DocTopic
        { name = "traits"
          description = "Traits: declare, implement, call, bound; the operators are traits"
          aliases = [ "trait", "impl", "impls" ]
          context = "general"
          content = Docs.Traits.content
          subtopics = [] }

      DocTopic
        { name = "operators"
          description = "Operators reference"
          aliases = [ "ops" ]
          context = "general"
          content = Docs.Operators.content
          subtopics = [] }

      DocTopic
        { name = "escapes"
          description = "String escapes: what a backslash means in a string or char"
          aliases = [ "escape", "string-escapes" ]
          context = "general"
          content = Docs.Escapes.content
          subtopics = [] }

      DocTopic
        { name = "stdlib"
          description = "Live: Stdlib module overview (counts + drill-in hints)"
          aliases = [ "lib" ]
          context = "cli"
          content = Docs.Stdlib.content
          subtopics = [] }

      DocTopic
        { name = "cli"
          description = "CLI commands reference"
          aliases = [ "commands" ]
          context = "cli"
          content = Docs.CLI.content
          subtopics = [] }

      DocTopic
        // Not internal: `Stdlib.Cli.Tui` is shipped, and anyone building a full-screen app in
        // Dark reads this to find out how a view, a frame and a session fit together.
        { name = "terminal-ui"
          description = "How the CLI draws: the Tui layer, and why it doesn't flicker"
          aliases = [ "tui" ]
          context = "cli"
          content = Docs.TerminalUI.content
          subtopics = [] }

      DocTopic
        { name = "errors"
          description = "Common errors and fixes"
          aliases = []
          context = "general"
          content = Docs.Errors.content
          subtopics = [] }

      DocTopic
        { name = "http-server"
          description = "HTTP server guide"
          aliases = [ "http", "server" ]
          context = "general"
          content = Docs.HttpServer.content
          subtopics = [] }

      DocTopic
        { name = "processes"
          description =
            "Things run at once, and what they did: await, Exec, ps, and reading a run back through your code"
          aliases =
            [ "ps"
              "traces"
              "await"
              "async"
              "concurrency"
              "spawn"
              "resume"
              "scheduler" ]
          context = "general"
          content = Docs.Processes.content
          subtopics = [] }

      DocTopic
        { name = "live"
          description = "Running things follow your edits: live views, a live serve, live values"
          aliases = [ "views", "live-values" ]
          context = "general"
          content = Docs.Live.content
          subtopics = [] }

      DocTopic
        { name = "packages"
          description = "Package system"
          aliases = []
          context = "general"
          content = Docs.Packages.content
          subtopics = [] }


      DocTopic
        { name = "scm"
          description = "Source control: edits, propagation, branches, merge, conflicts"
          // Every noun someone would reach for lands here, because the model is one thing and splitting it
          // into six topics would mean six places to learn a quarter of it.
          aliases =
            [ "git"
              "vcs"
              "commits"
              "commit"
              "propagate"
              "propagation"
              "branch"
              "branches"
              "merge"
              "rebase"
              "conflicts"
              "constraints"
              "draft"
              // NOT "ops" -- `operators` already claims that alias, and `findTopic` resolves in list
              // order, so adding it here would be a silent no-op rather than an ambiguity anyone notices.
              "undo" ]
          context = "cli"
          content = Docs.SCM.content
          subtopics = [] }

      DocTopic
        { name = "deprecation"
          description = "Mark package items as deprecated / obsolete / harmful"
          aliases = [ "deprecate", "delete" ]
          context = "cli"
          content = Docs.Deprecation.content
          subtopics = [] }

      // `signatures` is a *live* topic: rendered by querying the package DB
      // at call time. `dispatchLive` in `execute` recognises the name and
      // delegates to Packages.Signatures, forwarding any extra args. The
      // dummy `content` only fires if dispatch is somehow bypassed.
      DocTopic
        { name = "signatures"
          description = "Live: stdlib fns + signatures (drill-in for `docs stdlib`)"
          aliases = [ "sigs", "api" ]
          context = "cli"
          content = fun () -> "Run `docs signatures` to render. See `docs signatures --help`."
          subtopics = [] } ]


  /// The reference sections `docs for-ai` leaves out, so its first read stays short:
  /// `docs for-ai tests` and the rest.
  let forAISubtopics(): List<DocTopic> =
    [ subtopic(
        "packages",
        "Saving and changing declarations, the type checker, a command-line tool",
        [ "authoring", "edit" ],
        ForAIParts.packages)

      subtopic("tests", "Package tests in full", [ "test", "testing" ], ForAIParts.tests)

      subtopic(
        "permissions",
        "Rules, profiles and package approvals",
        [ "perms", "http", "files" ],
        ForAIParts.permissions)

      subtopic(
        "traces",
        "What a run did, and things that run at once",
        [ "live", "processes" ],
        ForAIParts.traces)

      subtopic(
        "scm",
        "Drafts, commits, branches, deprecation",
        [ "branches", "commits" ],
        ForAIParts.scm)

      subtopic(
        "syntax",
        "The full syntax notes and name resolution",
        [ "names" ],
        ForAIParts.syntax) ]


  let subtopic(
    name: String,
    description: String,
    aliases: List<String>,
    content: Unit -> String)
    : DocTopic =
    DocTopic
      { name = name
        description = description
        aliases = aliases
        context = "cli"
        content = content
        subtopics = [] }


  /// The topic in <param topics> called <param name>, or with it as an alias.
  let findIn(topics: List<DocTopic>, name: String): Option<DocTopic> =
    let lowerName = Stdlib.String.toLowercase(name)
    match Stdlib.List.findFirst(topics, fun t ->
            Stdlib.String.toLowercase(t.name) == lowerName) with
    | Some(t) -> Option.Some(t)
    | None ->
      topics
      |> Stdlib.List.findFirst(fun t ->
        t.aliases |> Stdlib.List.any(fun a -> Stdlib.String.toLowercase(a) == lowerName))


  /// `docs <topic>`'s subtopics, one per line, for when a name is not one of them.
  let formatSubtopicList(topic: DocTopic): String =
    topic.subtopics
    |> Stdlib.List.map(fun t -> $"  docs {topic.name} {t.name} - {t.description}")
    |> Stdlib.String.join("\n")


  let findTopic(name: String): Option<DocTopic> =
    let topics = allTopics()
    let lowerName = Stdlib.String.toLowercase(name)
    let byName =
      topics |> Stdlib.List.findFirst(fun t -> Stdlib.String.toLowercase(t.name) == lowerName)

    match byName with
    | Some(t) -> Option.Some(t)
    | None ->
      topics
      |> Stdlib.List.findFirst(fun t ->
        t.aliases |> Stdlib.List.any(fun a -> Stdlib.String.toLowercase(a) == lowerName))


  /// A topic printed from its text, so it can be read together with others.
  /// `signatures` renders from the store and runs on its own.
  let findStaticTopic(name: String): Option<DocTopic> =
    let live = [ "signatures", "sigs", "api" ]
    if Stdlib.List.contains(live, Stdlib.String.toLowercase(name)) then
      Option.None
    else
      findTopic(name)


  let formatTopicList(): String =
    let topics = allTopics()
    let lines =
      topics
      |> Stdlib.List.map(fun t ->
        let aliasStr =
          match t.aliases with
          | [] -> ""
          | aliases ->
            let joined = Stdlib.String.join(aliases, ", ")
            $" ({joined})"

        let contextTag =
          match t.context with
          | "general" -> ""
          | ctx -> Stdlib.Cli.UI.Colors.dimText($" [{ctx}]")

        $"  {Stdlib.Cli.UI.Colors.command(t.name)}{Stdlib.Cli.UI.Colors.dimText(aliasStr)} - {t.description}{contextTag}")

    let header = [ Stdlib.Cli.UI.Colors.info("Available documentation topics:"), "" ]
    let footer =
      [ ""
        "Usage: " + Stdlib.Cli.UI.Colors.command("docs <topic>")
        ""
        "Start with: " + Stdlib.Cli.UI.Colors.command("docs for-ai") ]

    Stdlib.List.concat(Stdlib.List.concat(header, lines), footer) |> Stdlib.String.join("\n")


// Topics that don't render from static text — they delegate to a live command
// with access to AppState. Returns Some new-state if `name` is a live topic.
let dispatchLive(state: AppState, name: String, rest: List<String>): Option<AppState> =
  let lower = Stdlib.String.toLowercase(name)
  match lower with
  | "signatures" -> Option.Some(Packages.Signatures.execute(state, rest))
  | "sigs" -> Option.Some(Packages.Signatures.execute(state, rest))
  | "api" -> Option.Some(Packages.Signatures.execute(state, rest))
  | "stdlib" -> Option.Some(StdlibOverview.execute(state, rest))
  | "lib" -> Option.Some(StdlibOverview.execute(state, rest))
  | _ -> Option.None


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    Stdlib.printLine(Topics.formatTopicList())
    state
  | [topicName, ...rest] ->
    match dispatchLive(state, topicName, rest) with
    | Some(newState) -> newState
    | None ->
      match Topics.findTopic(topicName) with
      | Some(topic) ->
        match rest with
        | [] ->
          let contentFn = topic.content
          Stdlib.printLine(contentFn())
          state
        | _ ->
          // Several pages in one call, so a reader needs one more turn at most. A name
          // is a part of <topic> or another topic; parts alone print without <topic>.
          let pages =
            rest
            |> Stdlib.List.map(fun name ->
              match Topics.findIn(topic.subtopics, name) with
              | Some(sub) -> (name, Option.Some((true, sub)))
              | None ->
                match Topics.findStaticTopic(name) with
                | Some(other) -> (name, Option.Some((false, other)))
                | None -> (name, Option.None))

          let unknown =
            pages
            |> Stdlib.List.filterMap(fun((name, page)) ->
              match page with
              | Some(_) -> Option.None
              | None -> Option.Some(name))

          match unknown with
          | [] ->
            let found = pages |> Stdlib.List.filterMap(fun((_, page)) -> page)
            let onlyParts = found |> Stdlib.List.all(fun((isPart, _)) -> isPart)
            let shown = if onlyParts then found else [ (false, topic), ...found ]
            shown
            |> Stdlib.List.uniqueBy(fun((isPart, t)) -> (isPart, t.name))
            |> Stdlib.List.map(fun((_, t)) ->
              let contentFn = t.content
              contentFn())
            |> Stdlib.String.join("\n\n")
            |> Stdlib.printLine

            state
          | _ ->
            let names = Stdlib.String.join(unknown, ", ")
            let plural = Stdlib.List.length(unknown) > 1
            match topic.subtopics with
            | [] ->
              let noun = if plural then "topics" else "topic"
              Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Unknown {noun}: {names}"))
              Stdlib.printErrorLine("")
              Stdlib.printErrorLine(Topics.formatTopicList())
            | _ ->
              let noun = if plural then "parts" else "part"
              Stdlib.printErrorLine(
                Stdlib.Cli.UI.Colors.error($"Unknown {noun} of docs {topic.name}: {names}"))

              Stdlib.printErrorLine("")

              Stdlib.printErrorLine(Topics.formatSubtopicList(topic))

              Stdlib.printErrorLine("Any other topic from `docs` can be added too.")

            failed(state)
      | None ->
        Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.error($"Unknown topic: {topicName}"))
        Stdlib.printErrorLine("")
        Stdlib.printErrorLine(Topics.formatTopicList())
        failed(state)


let help(_state: AppState): String =
  [ Stdlib.Cli.UI.Colors.info("Usage: ") + Stdlib.Cli.UI.Colors.command("docs [topic]")
    "Browse in-CLI documentation."
    ""
    Stdlib.Cli.UI.Colors.info("Examples:")
    "  " + Stdlib.Cli.UI.Colors.command("docs") + "         - List all topics"
    "  " + Stdlib.Cli.UI.Colors.command("docs for-ai") + "  - AI agent quick start"
    "  " + Stdlib.Cli.UI.Colors.command("docs for-ai tests") + "  - One of its longer sections"
    "  " + Stdlib.Cli.UI.Colors.command("docs for-ai tests scm") + "  - Several sections at once"
    "  "
    + Stdlib.Cli.UI.Colors.command("docs for-ai http-server")
    + "  - The quick start and another topic"

    "  " + Stdlib.Cli.UI.Colors.command("docs syntax") + "  - Language syntax reference"
    "  " + Stdlib.Cli.UI.Colors.command("docs errors") + "  - Common errors and fixes" ]
  |> Stdlib.String.join("\n")


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] ->
    let topics = Topics.allTopics()
    topics |> Stdlib.List.map(fun t -> Completion.withDescription(t.name, t.description))
  | [partial] ->
    let topics = Topics.allTopics()
    let lowerPartial = Stdlib.String.toLowercase(partial)
    topics
    |> Stdlib.List.filter(fun t ->
      Stdlib.String.startsWith(Stdlib.String.toLowercase(t.name), lowerPartial)
      || (t.aliases
          |> Stdlib.List.any(fun a ->
            Stdlib.String.startsWith(Stdlib.String.toLowercase(a), lowerPartial))))
    |> Stdlib.List.map(fun t -> Completion.withDescription(t.name, t.description))
  | [topicName, partial] ->
    match Topics.findTopic(topicName) with
    | Some(topic) ->
      let lowerPartial = Stdlib.String.toLowercase(partial)
      topic.subtopics
      |> Stdlib.List.filter(fun t ->
        Stdlib.String.startsWith(Stdlib.String.toLowercase(t.name), lowerPartial))
      |> Stdlib.List.map(fun t -> Completion.withDescription(t.name, t.description))
    | None -> []
  | _ -> []
