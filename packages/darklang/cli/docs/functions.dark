module Darklang.Cli.Docs.Functions

let content () : String =
  """# Functions

## Define (module-level only)
  let add (a: Int) (b: Int) : Int = a + b
  let greet (name: String) : String = $"Hi {name}"

## No params
  let now () : DateTime = Stdlib.DateTime.now ()

## Nested functions (fully-annotated form only)
  # OK — params and return type annotated:
  let outer (n: Int) : Int =
    let double (x: Int) : Int = x * 2
    double n
  # NOT supported — unannotated: let double x = x * 2
  # A nested fn can close over outer bindings and recurse by name; mutual recursion between
  # nested fns is not supported. When in doubt, define at module level.

## Call
  add 1 2
  Stdlib.String.length "hi"

## Lambda
  fun x -> x + 1
  fun (a, b) -> a + b

## Partial application
  let addFive = Stdlib.Int.add 5
  addFive 3   # 8

## Unit return
  let log (msg: String) : Unit = Stdlib.printLine msg"""
