module Darklang.Cli.Docs.Functions

let content () : String =
  """# Functions

## Define
  let add (a: Int) (b: Int) : Int = a + b
  let greet (name: String) : String = $"Hi {name}"

## No params
  let now () : DateTime = Stdlib.DateTime.now ()

## Nested functions
  let outer (n: Int) : Int =
    let double (x: Int) : Int = x * 2
    double n

  # The trigger is PARENTHESIZED params, not the annotations - `let double (x) = x * 2` is
  # a nested fn too. Types are optional here and discarded either way.
  # NOT a nested fn: let double x = x * 2   (no parens - parses as a plain binding)
  #
  # A nested fn can close over outer bindings, recurse by name, and call a nested fn
  # defined ABOVE it. What fails is a FORWARD reference: calling one defined further down.
  # A name that collides with something already in scope is an error, not shadowing.

## Call
  add 1 2
  Stdlib.String.length "hi"

## Lambda
  fun x -> x + 1
  fun (a, b) -> a + b

## Partial application
  let addFive = Stdlib.Int.add 5
  addFive 3   # 8

## Unit return
  let log (msg: String) : Unit = Stdlib.printLine msg"""
