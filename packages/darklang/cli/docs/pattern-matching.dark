module Darklang.Cli.Docs.PatternMatching

let content(): String =
  """# Pattern Matching

## Basic
  match x with
  | 0 -> "zero"
  | n -> $"other: {n}"

## Enums
  | Some(v) -> v
  | None -> default
  | Ok(data) -> data
  | Error(e) -> handle(e)
  | Result.Ok(data) -> data     # the type prefix is allowed, not needed

## Tuples
  | (a, b) -> a + b

## Constructor patterns
A constructor's fields go in parentheses, as a call's arguments do:
`| Ok(x)`, `| Pair(a, b)`. `| Ok x` is an error. The one real trap is a TUPLE
payload: `Some((a, b))` needs its inner parens -- `Some(a, b)` is two fields.
  | (Ok(x), Ok(y)) -> x + y
  | Some(Ok(v)) -> v
  | Some((a, b)) -> a + b       # NOT Some(a, b), which never matches

## Lists
  | [] -> "empty"
  | [x] -> "one"
  | [head, ...tail] -> "many"
  | [a, b, ...] -> "two or more"   # `...` goes last; a bare `...` ignores the rest

## Records
  Records can't be destructured in match. Use a variable and access fields:
  | user -> user.name

## Wildcard
  | _ -> default

## Nested
  | Some(Ok(v)) -> v            # fields always in parentheses

## Constructor wrapping a tuple
  | Some((a, b)) -> a + b       # Ctor((tuple)): the inner parens are the pattern
  # NOT: | Some(a, b) ->        # two fields, and Some has one"""
