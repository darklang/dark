module Darklang.Cli.Docs.PatternMatching

let content(): String =
  """# Pattern Matching

## Basic
  match x with
  | 0 -> "zero"
  | n -> $"other: {n}"

## Enums
  | Some(v) -> v
  | None -> default
  | Ok(data) -> data
  | Error(e) -> handle(e)
  | Result.Ok(data) -> data     # the type prefix is allowed, not needed

## Tuples
  | (a, b) -> a + b

## Constructor patterns
A constructor's fields go in parentheses, as a call's arguments do:
`| Ok(x)`, `| Pair(a, b)`. `| Ok x` is an error. The one real trap is a TUPLE
payload: `Some((a, b))` needs its inner parens -- `Some(a, b)` is two fields.
  | (Ok(x), Ok(y)) -> x + y
  | Some(Ok(v)) -> v
  | Some((a, b)) -> a + b       # NOT Some(a, b), which never matches

## Lists
  | [] -> "empty"
  | [x] -> "one"
  | [head, ...tail] -> "many"
  | [a, b, ...] -> "two or more"   # `...` goes last; a bare `...` ignores the rest

## Records
  Records can't be destructured in match. Use a variable and access fields:
  | user -> user.name

## Several patterns, one arm
  | 1 | 2 | 3 -> "small"
  | Ok(x) | Error(x) -> x        # every alternative binds the same names
  | Some(1 | 2) -> "one or two"  # also inside a field or a list element

## Naming the whole value: as
  | Some(_) as o -> o            # o is the whole Some(...)
  | [first, ...] as all -> all   # matches, and keeps the list
  | A | B as x -> x              # as is loosest: x is whichever matched
  | ((Some(_) as o), n) -> o     # inside a tuple, parenthesize the one you name
  | (a, b) as pair -> pair       # or name the whole tuple from outside

## Guards
  | n when n > 100 -> "big"      # a false guard falls through to the next arm
  | Some(x) when x == "" -> "empty"
  A guarded arm never counts toward covering every case.

## Wildcard
  | _ -> default

## Nested
  | Some(Ok(v)) -> v            # fields always in parentheses

## Constructor wrapping a tuple
  | Some((a, b)) -> a + b       # Ctor((tuple)): the inner parens are the pattern
  # NOT: | Some(a, b) ->        # two fields, and Some has one"""
