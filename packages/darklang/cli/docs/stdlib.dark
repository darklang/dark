module Darklang.Cli.Docs.Stdlib

let content(): String =
  """# Stdlib (Darklang.Stdlib)

The standard library provides common data-structure operations,
string handling, JSON, HTTP, and other utilities — all written in Dark.

## Explore
  tree Darklang.Stdlib --depth=2   # browse the module hierarchy
  search <term>                    # find by name
  view <fn>                        # see signature + source

## Key modules
  Stdlib.List(Stdlib.String, Stdlib.Option)
  Stdlib.Result(Stdlib.Dict, Stdlib.Int64)
  Stdlib.Json(Stdlib.Http, Stdlib.Uuid)

## Shortcut
  `Stdlib.X` always resolves to `Darklang.Stdlib.X` from any module.

## Param order (collection usually first)
  Stdlib.List.map(list, fn)
  Stdlib.String.join(list, separator)

## Counts and positions
A count clamps: too many means all, zero or less means none.
  Stdlib.List.take([ 1, 2, 3 ], 99) // [ 1, 2, 3 ]
  Stdlib.String.random(-1) // ""

A position that isn't there is refused: reading one item gives None,
writing or slicing gives an Error. There are no positions from the end.
  Stdlib.List.getAt([ 1, 2, 3 ], 10) // None
  Stdlib.List.setAt([ 1, 2, 3 ], -1, 9) // Error(IndexOutOfBounds)
  Stdlib.List.removeAt([ 1, 2, 3 ], 3) // Error(IndexOutOfBounds)

A size that can't make progress is an Error.
  Stdlib.List.chunkBySize([ 1, 2, 3 ], 0) // Error(SizeMustBeGreaterThanZero)"""
