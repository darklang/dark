module Darklang.Cli.Docs.Types

let content () : String =
  """# Types

## Primitives
  Int    5, -42
  Float    3.14, -0.5
  String   "hello"
  Bool     true, false
  Char     'a'

## Option
  Type: Stdlib.Option.Option<Int>
  Construct: Some 5, None

## Result
  Type: Stdlib.Result.Result<Int, String>
  Construct: Ok value, Error msg

## Collections
  List<T>     [1, 2]
  Dict<T>     Dict { key = "value" }
  (a, b)      tuple

## Records
  type Person = { name: String; age: Int }
  Person { name = "Jo"; age = 30 }

## Enums
  type Status = | Active | Inactive of String
  Status.Active
  Status.Inactive "reason"

## Generics
  type Box<'a> = { value: 'a }"""
