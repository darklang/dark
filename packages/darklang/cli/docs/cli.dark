module Darklang.Cli.Docs.CLI

let content () : String =
  """# CLI Commands

## Global Flags
  --branch <name>   # run command on a specific branch (default: main)
                    # required for non-interactive use on non-main branches

## Creating Code (main workflow)
  fn <name>       # create function - USE THIS TO WRITE CODE
  type <name>     # create type
  val <name>      # create value (let)

## Running/Testing
  eval <expr>     # evaluate an expression — also how you run a fn: eval MyMod.myFn 1 2
  run <file>      # run a .dark script file (alias: run-script)

## Navigation
  nav <path>      # go to module (cd)
  ls              # list contents
  back            # previous location
  tree            # show hierarchy

## Viewing
  view <name>     # inspect fn/type/value
  builtins        # list builtins
  search <term>   # find anything
  deps <name>     # show dependencies

## Version Control (SCM)
  status          # current branch + uncommitted changes
  commit <msg>    # commit on current branch
  log             # history for current branch
  show <hash>     # commit details
  discard         # undo uncommitted changes

## Branches
  branch          # list branches (* = current)
  branch create   # create + switch
  branch switch   # switch to branch
  rebase          # update from parent
  merge           # merge into parent
  (see: docs scm)

## Server
  serve <router> [--port N]   # start an HTTP server (alias: http-server; --port defaults to 8080)

## Workbench (the full-screen experience — `dark` with no args opens it)
  workbench       # open the framed, navigable workbench (alias: wb)
  views           # browse + preview the individual CLI views

## Account + config
  login [name]    # log in (no name lists accounts); persists across runs
  logout          # clear the active account
  config          # get/set/list CLI config (config set <key> <value>)

## Sync + apps + AI
  sync            # share package changes with other instances
  conflicts       # review + resolve sync divergences
  devices         # your tailnet devices (status/serve/ping)
  apps            # list, install, manage apps (daemons, foreground, UI)
  agent <verb>    # AI workflows: ask/code/review/fix/diff (alias: ai)
  traces          # list + view execution traces

## Other
  help [cmd]      # help
  docs [topic]    # documentation
  clear / quit

## Troubleshooting
If something hangs or behaves unexpectedly, check the logs:
  rundir/logs/cli.log    # main CLI log
  rundir/logs/           # other logs (parser, etc.)"""
