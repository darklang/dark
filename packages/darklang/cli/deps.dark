module Darklang.Cli.Deps

/// Resolve item hashes to display names, as a hash-string -> name dict.
///
/// For the workbench's dependency panes, which resolve a batch of hashes once and then look each up while
/// rendering.
let resolveNames
  (branchId: String)
  (itemHashes: List<LanguageTools.ProgramTypes.Hash>)
  : Dict<String> =
  (SCM.Deps.resolveLocations itemHashes)
  |> Stdlib.List.fold Stdlib.Dict.empty (fun acc (itemHash, location) ->
    let h = Darklang.LanguageTools.ProgramTypes.hashToString itemHash
    let displayName = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation location
    Stdlib.Dict.set acc h displayName)

/// A displayable name for an item, from a dict `resolveNames` built, falling back to the hash.
let getName
  (namesDict: Dict<String>)
  (hash: LanguageTools.ProgramTypes.Hash)
  : String =
  let h = Darklang.LanguageTools.ProgramTypes.hashToString hash

  match Stdlib.Dict.get namesDict h with
  | Some name -> name
  | None -> h


/// Display dependents: what uses this entity.
let showDependents
  (branchId: String)
  (targetLoc: LanguageTools.ProgramTypes.PackageLocation)
  (targetKind: LanguageTools.ProgramTypes.ItemKind)
  (entityName: String)
  : Unit =
  let dependents = SCM.Deps.dependentsOf [ (targetLoc, targetKind) ]

  match dependents with
  | [] ->
    Stdlib.printLine $"No dependents found for {entityName}"
  | deps ->
    let count = Stdlib.List.length deps
    Stdlib.printLine $"Found {Stdlib.Int.toString count} dependents of {entityName}:"
    Stdlib.printLine ""

    deps
    |> Stdlib.List.iter (fun (_sourceHash, sourceLoc, refType) ->
      let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation sourceLoc
      let kind = Darklang.Cli.Packages.Propagate.itemKindToString refType
      Stdlib.printLine $"  [{kind}] {name}")


/// Transitive traversal, collecting dependents via batched FQN-keyed queries. Each level's results carry
/// their own location, so the next level feeds straight back in without a hash -> location round-trip.
let collectTransitiveDependents
  (branchId: String)
  (processed: List<String>)
  (pending: List<LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind>)
  (accumulated: List<LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind>)
  : List<LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind> =
  let fqn = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation
  match pending with
  | [] -> accumulated
  | _ ->
    let toProcess =
      pending
      |> Stdlib.List.filter (fun (loc, kind) ->
        let key = $"{fqn loc}:{Darklang.Cli.Packages.Propagate.itemKindToString kind}"
        Stdlib.Bool.not (Stdlib.List.member processed key))

    match toProcess with
    | [] -> accumulated
    | targets ->
      let batchResults = SCM.Deps.dependentsOf targets

      let newDeps =
        batchResults
        |> Stdlib.List.map (fun result ->
          let (_sourceHash, sourceLoc, refType) = result
          (sourceLoc, refType))

      let newTargets =
        batchResults
        |> Stdlib.List.map (fun result ->
          let (_sourceHash, sourceLoc, _refType) = result
          (sourceLoc, _refType))

      let newProcessed =
        Stdlib.List.append
          processed
          (targets
           |> Stdlib.List.map (fun (loc, kind) ->
             $"{fqn loc}:{Darklang.Cli.Packages.Propagate.itemKindToString kind}"))
      let newAccumulated = Stdlib.List.append accumulated newDeps

      collectTransitiveDependents branchId newProcessed newTargets newAccumulated


/// Get all transitive dependents (everything that could break if this changes)
let getTransitiveDependents
  (branchId: String)
  (targetLoc: LanguageTools.ProgramTypes.PackageLocation)
  (targetKind: LanguageTools.ProgramTypes.ItemKind)
  : List<LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind> =
  (collectTransitiveDependents branchId [] [ (targetLoc, targetKind) ] [])
  |> Stdlib.List.uniqueBy (fun (loc, _) ->
    PrettyPrinter.ProgramTypes.PackageLocation.packageLocation loc)


/// Display all transitive dependents (what could break)
let showTransitiveDependents
  (branchId: String)
  (targetLoc: LanguageTools.ProgramTypes.PackageLocation)
  (targetKind: LanguageTools.ProgramTypes.ItemKind)
  (entityName: String)
  : Unit =
  let allDependents = getTransitiveDependents branchId targetLoc targetKind

  match allDependents with
  | [] ->
    Stdlib.printLine $"Nothing depends on {entityName}"
  | deps ->
    let count = Stdlib.List.length deps
    Stdlib.printLine $"Found {Stdlib.Int.toString count} items that could break if {entityName} changes:"
    Stdlib.printLine ""

    deps
    |> Stdlib.List.iter (fun (sourceLoc, refType) ->
      let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation sourceLoc
      let kind = Darklang.Cli.Packages.Propagate.itemKindToString refType
      Stdlib.printLine $"  [{kind}] {name}")


/// Display dependencies (what this entity uses).
///
/// Read off the EDGE, not looked up from the hash. The edge records the name the reference was resolved
/// by; a hash lookup answers "what is called this hash", which differs whenever two names share content --
/// and has no answer once the dependency has moved on, which is precisely when you're asking.
let showDependencies
  (branchId: String)
  (sourceHash: LanguageTools.ProgramTypes.Hash)
  (entityName: String)
  : Unit =
  match SCM.Deps.dependencyEdges sourceHash with
  | [] -> Stdlib.printLine $"No dependencies found for {entityName}"
  | deps ->
    let count = Stdlib.List.length deps
    Stdlib.printLine $"Found {Stdlib.Int.toString count} dependencies of {entityName}:"
    Stdlib.printLine ""

    deps
    |> Stdlib.List.iter (fun edge ->
      let (targetHash, refKind, loc) = edge
      let kind = Darklang.Cli.Packages.Propagate.itemKindToString refKind
      let mods = Stdlib.String.join loc.modules "."

      let name =
        if mods == "" then $"{loc.owner}.{loc.name}" else $"{loc.owner}.{mods}.{loc.name}"

      // Say when the reference is to a version that is no longer what the name means. It's the reason to
      // look at this list at all, and it's what `dark constraints` will report about you later.
      let behind =
        match SCM.Propagation.currentHash loc with
        | Some now ->
          if now == targetHash then
            ""
          else
            let h =
              LanguageTools.ProgramTypes.hashToString targetHash |> Stdlib.String.slice 0 8

            $"  (on {h}, no longer current)"
        | None -> ""

      Stdlib.printLine $"  [{kind}] {name}{behind}")


/// Resolve a path to (hash, location, kind, displayName).
/// Carries the location so dependents queries can stay FQN-keyed and
/// avoid cross-namespace false positives from content-hash collisions.
let resolvePath
  (branchId: String)
  (currentLocation: Packages.PackageLocation)
  (pathArg: String)
  : Stdlib.Result.Result<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * String * LanguageTools.ProgramTypes.ItemKind), String> =
  match Packages.Traversal.traverse branchId currentLocation pathArg with
  | Error errMsg -> Stdlib.Result.Result.Error errMsg
  | Ok loc ->
    match loc with
    | Module _ ->
      Stdlib.Result.Result.Error "Cannot show dependencies for a module, only for functions, types, or values"
    | Function fnLoc ->
      match Builtin.pmFindFn branchId fnLoc with
      | Some hash ->
        let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation fnLoc
        Stdlib.Result.Result.Ok((hash, fnLoc, name, LanguageTools.ProgramTypes.ItemKind.Fn))
      | None -> Stdlib.Result.Result.Error $"Function not found: {PrettyPrinter.ProgramTypes.PackageLocation.packageLocation fnLoc}"
    | Type typeLoc ->
      match Builtin.pmFindType branchId typeLoc with
      | Some hash ->
        let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation typeLoc
        Stdlib.Result.Result.Ok((hash, typeLoc, name, LanguageTools.ProgramTypes.ItemKind.Type))
      | None -> Stdlib.Result.Result.Error $"Type not found: {PrettyPrinter.ProgramTypes.PackageLocation.packageLocation typeLoc}"
    | Value valueLoc ->
      match Builtin.pmFindValue branchId valueLoc with
      | Some hash ->
        let name = PrettyPrinter.ProgramTypes.PackageLocation.packageLocation valueLoc
        Stdlib.Result.Result.Ok((hash, valueLoc, name, LanguageTools.ProgramTypes.ItemKind.Value))
      | None -> Stdlib.Result.Result.Error $"Value not found: {PrettyPrinter.ProgramTypes.PackageLocation.packageLocation valueLoc}"


/// One dependency edge as the machine-readable shape, read off the EDGE (see `showDependencies`).
let edgeJson
  (edge: (LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.ItemKind * LanguageTools.ProgramTypes.PackageLocation))
  : ScmJson.DependencyJson =
  let (targetHash, refKind, loc) = edge
  let mods = Stdlib.String.join loc.modules "."

  let name =
    if mods == "" then $"{loc.owner}.{loc.name}" else $"{loc.owner}.{mods}.{loc.name}"

  let behind =
    match SCM.Propagation.currentHash loc with
    | Some now -> now != targetHash
    | None -> false

  ScmJson.DependencyJson
    { name = name
      kind = Darklang.Cli.Packages.Propagate.itemKindToString refKind
      hash = LanguageTools.ProgramTypes.hashToString targetHash
      behind = behind }

/// `dark deps <path> --json`: what it uses and what uses it, in one object.
///
/// Both directions at once, plus which references are already behind -- what "what breaks if I change
/// this" actually needs.
let executeJson
  (state: AppState)
  (sourceHash: LanguageTools.ProgramTypes.Hash)
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  (kind: LanguageTools.ProgramTypes.ItemKind)
  (entityName: String)
  : AppState =
  let dependencies = SCM.Deps.dependencyEdges sourceHash |> Stdlib.List.map edgeJson

  let dependents =
    SCM.Deps.dependentsOf [ (loc, kind) ]
    |> Stdlib.List.map (fun d ->
      let (h, dLoc, dKind) = d
      edgeJson ((h, dKind, dLoc)))

  Stdlib.printLine (
    ScmJson.depsJson (
      ScmJson.DepsJson
        { item = entityName
          dependencies = dependencies
          dependents = dependents }
    )
  )

  state

let execute (state: AppState) (args: List<String>) : AppState =
  let wantsJson = ScmJson.wantsJson args
  let args = ScmJson.stripJson args
  let deep = Stdlib.List.member args "--deep"
  let filteredArgs = args |> Stdlib.List.filter (fun arg -> arg != "--deep")
  let branchId = state.currentBranchId

  // Any OTHER `--flag` is a mistake, not a path. Unrefused it reaches the lookup as though it were a
  // package name and answers "Not found", which reads as "no such package" about a flag.
  let unknownFlags =
    filteredArgs |> Stdlib.List.filter (fun a -> Stdlib.String.startsWith a "--")

  if Stdlib.Bool.not (Stdlib.List.isEmpty unknownFlags) then
    let f = Stdlib.String.join unknownFlags " "
    Stdlib.printLine
      (Colors.error $"deps doesn't understand {f}. The flags are --deep and --json.")
    state
  else

  match filteredArgs with
  | [] ->
    [ Colors.error "Usage: deps <subcommand> <path>"
      ""
      "Subcommands:"
      "  uses <path>         - Show what the entity uses (dependencies)"
      "  usedby <path>       - Show what uses the entity (dependents)"
      ""
      "Options:"
      "  --deep              - Show transitive dependents (everything that could break)" ]
    |> Stdlib.printLines
    state

  | ["uses"; pathArg] ->
    match resolvePath branchId state.packageData.currentLocation pathArg with
    | Error errMsg ->
      // Name what you ASKED for, not just where the path stopped resolving: "Not found: Zzz" is true and
      // unhelpful when you typed `Zzz.Nope.nope`, and both together tell a typo from a missing name.
      Stdlib.printLine (Colors.error $"Cannot show deps for {pathArg}: {errMsg}")
      state
    | Ok result ->
      let (hash, loc, name, entityType) = result

      // Honoured on EVERY arm, not just the bare one: an agent that asked for JSON must not get a table.
      if wantsJson then
        executeJson state hash loc entityType name
      else

      showDependencies branchId hash name
      state

  | ["usedby"; pathArg] ->
    match resolvePath branchId state.packageData.currentLocation pathArg with
    | Error errMsg ->
      // Name what you ASKED for as well as where it stopped resolving; see the `uses` arm.
      Stdlib.printLine (Colors.error $"Cannot show deps for {pathArg}: {errMsg}")
      state
    | Ok result ->
      let (hash, loc, name, entityType) = result

      // Same as the `uses` arm.
      if wantsJson then
        executeJson state hash loc entityType name
      else

      if deep then
        showTransitiveDependents branchId loc entityType name
      else
        showDependents branchId loc entityType name

      state

  | [pathArg] ->
    // Default to showing both uses and usedby
    match resolvePath branchId state.packageData.currentLocation pathArg with
    | Error errMsg ->
      // Name what you ASKED for as well as where it stopped resolving; see the `uses` arm.
      Stdlib.printLine (Colors.error $"Cannot show deps for {pathArg}: {errMsg}")
      state
    | Ok result ->
      let (hash, loc, name, entityType) = result

      if wantsJson then
        executeJson state hash loc entityType name
      else

      showDependencies branchId hash name
      Stdlib.printLine ""

      if deep then
        showTransitiveDependents branchId loc entityType name
      else
        showDependents branchId loc entityType name

      state

  | _ ->
    Stdlib.printLine (help state)
    state


let complete (state: AppState) (args: List<String>) : List<Completion.CompletionItem> =
  let branchId = state.currentBranchId
  match args with
  | [] ->
    [Completion.CompletionItem { display = "uses"; value = "uses" }; Completion.CompletionItem { display = "usedby"; value = "usedby" }]
  | ["uses"] ->
    Packages.Traversal.completePartialPath branchId state.packageData.currentLocation ""
  | ["usedby"] ->
    Packages.Traversal.completePartialPath branchId state.packageData.currentLocation ""
  | ["uses"; partialPath] ->
    Packages.Traversal.completePartialPath branchId state.packageData.currentLocation partialPath
  | ["usedby"; partialPath] ->
    Packages.Traversal.completePartialPath branchId state.packageData.currentLocation partialPath
  | [partialPath] ->
    let subcommands =
      ["uses"; "usedby"]
      |> Stdlib.List.filter (fun cmd -> Stdlib.String.startsWith cmd partialPath)
      |> Stdlib.List.map (fun cmd -> Completion.CompletionItem { display = cmd; value = cmd })
    let paths = Packages.Traversal.completePartialPath branchId state.packageData.currentLocation partialPath
    Stdlib.List.append subcommands paths
  | _ -> []


let help (_state: AppState) : String =
  [
    "Usage: deps [subcommand] <path> [--deep]"
    "Show dependencies and dependents of a function, type, or value."
    ""
    "Subcommands:"
    "  uses <path>    - Show what the entity uses (forward dependencies)"
    "  usedby <path>  - Show what uses the entity (direct dependents)"
    ""
    "Options:"
    "  --deep         - Show transitive dependents (everything that could break)"
    ""
    "Without subcommand, shows both uses and usedby."
    ""
    "Examples:"
    "  deps Stdlib.List.map              - Show all deps for List.map"
    "  deps uses Stdlib.List.map         - Show what List.map uses"
    "  deps usedby Stdlib.List.map       - Show what uses List.map"
    "  deps usedby Stdlib.Option --deep  - Show everything that could break if Option changes"
  ]
  |> Stdlib.String.join "\n"
