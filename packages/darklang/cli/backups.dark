module Darklang.Cli.Backups

// `dark backups`: see, make, and prune the copies of the store.
//
// The upgrade path writes one aside before it folds a new seed (one per build it upgrades to, kept
// next to the store), and nothing else prunes them. So the answer to "if this goes wrong, what can I go back to?"
// lives here rather than in `ls`, and so does the pruning.

/// The backups, newest first. The runtime keeps the folder and its names, the upgrade path's
/// backups among them (`LanguageTools.LocalStore.backups`).
let list(): List<LanguageTools.LocalStore.Backup> =
  match LanguageTools.LocalStore.backups(LanguageTools.LocalStore.BackupAction.List) with
  | Ok(backups) -> backups
  | Error(_) -> []


let names(): List<String> =
  list() |> Stdlib.List.map(fun b -> b.name)


/// `dark backups`
let executeList(state: AppState): AppState =
  match list() with
  | [] ->
    printOk("no backups yet.")
    printHint("  One is taken automatically before an upgrade folds a new seed.")
    printHint("  `dark backups now` takes one on demand.")
    state
  | [first, ...] as backups ->
    printOk(
      $"""{Text.plural(Stdlib.List.length(backups), "backup")} in {Stdlib.Cli.Path.parent(first.path)}""")

    backups |> Stdlib.List.iter(fun b -> Stdlib.printLine($"  {b.name}  ({Text.bytes(b.bytes)})"))
    Stdlib.printErrorLine("")
    printHint("  dark backups now             take one now")
    printHint("  dark backups restore <name>  put one in place of the store")
    printHint("  dark backups prune <n>       keep the newest n, delete the rest")
    state


/// `dark backups now`. Named for the moment rather than the day, so an on-demand copy never collides
/// with the upgrade path's daily one.
let executeNow(state: AppState): AppState =
  match LanguageTools.LocalStore.backups(LanguageTools.LocalStore.BackupAction.Create) with
  | Ok(taken) ->
    taken |> Stdlib.List.iter(fun b -> printOk($"copied the store to {b.path}"))
    state
  | Error(e) ->
    printErr($"couldn't copy the store: {e}")
    { state with exitCode = 1 }


/// `dark backups restore <name> [-y]`. Puts the named backup in place of the store. The store as it is
/// now is copied aside first (`data.db.pre-restore-<stamp>`), so a restore is itself undoable.
let executeRestore(state: AppState, name: String, confirm: Confirm): AppState =
  if Stdlib.Bool.not(Stdlib.List.contains(names(), name)) then
    printErr($"no backup named \"{name}\".")
    printHint("  `dark backups` lists them.")
    failed(state)
  else
    // Warning like DISCARDING: green on "replaces the store" reads as "already fine".
    Stderr.line(Stdlib.Cli.UI.Colors.warning($"  RESTORING {name} replaces the store."))
    Stderr.hint("  the store as it is now is copied aside first, so this is undoable.")
    let confirmed =
      Prompt.confirmExplicit(confirm, Stdlib.Cli.UI.Colors.warning("\n  Restore it? [y/N]: "))

    if Stdlib.Bool.not(confirmed) then
      Stderr.ok(
        "  kept. (`dark backups restore <name> -y` if you mean it -- a piped stdin can't answer this.)")

      failed(state)
    else
      match LanguageTools.LocalStore.backups(
              LanguageTools.LocalStore.BackupAction.Restore(name)) with
      | Ok(asides) ->
        let aside =
          asides
          |> Stdlib.List.map(fun b -> b.path)
          |> Stdlib.String.join(", ")

        printOk($"restored {name}. The store as it was is at {aside}.")
        printHint("  start `dark` again: this process is still holding the old store.")
        state
      | Error(e) ->
        printErr($"{e}.")
        { state with exitCode = 1 }


/// `dark backups prune <keep> [-y]`. Deletes the oldest, keeping the newest <keep>. Shows what would go
/// and takes an explicit yes, like every other verb that destroys something: a backup is the thing you
/// reach for AFTER a mistake, and the one command that must not make one.
let executePrune(state: AppState, keepArg: String, confirm: Confirm): AppState =
  match Stdlib.Int64.parse(keepArg) with
  | Error(_) ->
    printErr($"\"{keepArg}\" isn't a number of backups to keep.")
    failed(state)
  | Ok(keep) ->
    if keep < 0 then
      printErr("keep a non-negative number of backups.")
      failed(state)
    else
      let all = names()
      let doomed = Stdlib.List.drop(all, keep)
      if Stdlib.List.isEmpty(doomed) then
        printOk(
          $"""nothing to prune: {Text.plural(Stdlib.List.length(all), "backup")}, keeping {keepArg}.""")

        state
      else
        Stderr.line(
          Stdlib.Cli.UI.Colors.warning(
            $"""  PRUNING deletes {Text.plural(Stdlib.List.length(doomed), "backup")}:"""))

        doomed
        |> Stdlib.List.iter(fun name -> Stderr.line(Stdlib.Cli.UI.Colors.dimText($"    - {name}")))

        let confirmed =
          Prompt.confirmExplicit(confirm, Stdlib.Cli.UI.Colors.warning("\n  Delete them? [y/N]: "))

        if Stdlib.Bool.not(confirmed) then
          Stderr.ok(
            "  kept. (`dark backups prune <n> -y` if you mean it -- a piped stdin can't answer this.)")

          failed(state)
        else
          let deleted =
            doomed
            |> Stdlib.List.filterMap(fun name ->
              match LanguageTools.LocalStore.backups(
                      LanguageTools.LocalStore.BackupAction.Delete(name)) with
              | Ok(_) -> Option.Some(name)
              | Error(_) ->
                printErr($"  couldn't delete {name}")
                Option.None)

          printOk(
            $"""deleted {Text.plural(Stdlib.List.length(deleted), "backup")}, kept {keepArg}.""")

          exitWith(state, Stdlib.List.length(deleted) == Stdlib.List.length(doomed))


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] -> executeList(state)
  | ["list"] -> executeList(state)
  | ["now"] -> executeNow(state)
  | ["prune", keep] -> executePrune(state, keep, Confirm.Ask)
  | ["prune", keep, "-y"] | ["prune", keep, "--yes"] -> executePrune(state, keep, Confirm.Assume)
  | ["restore", name] -> executeRestore(state, name, Confirm.Ask)
  | ["restore", name, "-y"] | ["restore", name, "--yes"] ->
    executeRestore(state, name, Confirm.Assume)
  | ["restore"] ->
    printErr("restore needs a backup's name: `dark backups restore <name>`.")
    printHint("  `dark backups` lists them.")
    failed(state)
  | ["prune"] ->
    printErr("prune needs how many to keep: `dark backups prune 3`.")
    failed(state)
  | _ ->
    printErr($"""`dark backups {Stdlib.String.join(args, " ")}` isn't a form of this command.""")
    printHint(
      "  dark backups | dark backups now | dark backups restore <name> | dark backups prune <n>")

    failed(state)


let help(_state: AppState): String =
  [ ""
    "  dark backups                      what copies of the store exist"
    "  dark backups now                  take one now"
    "  dark backups restore <name> [-y]  put one in place of the store (asks first)"
    "  dark backups prune <n> [-y]       keep the newest n, delete the rest (asks first)"
    ""
    "  A backup is taken automatically before an upgrade folds a new seed:"
    "  one per calendar day, kept next to the store. Nothing prunes them for"
    "  you, which is why `prune` is here."
    "" ]
  |> Stdlib.String.join("\n")


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] -> [ "list", "now", "prune", "restore" ] |> Stdlib.List.map(Completion.simple)
  | _ -> []
