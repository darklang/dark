module Darklang.Cli.Permissions.Command

type AccessReportFacts =
  { hash: String
    effects: List<LanguageTools.Permissions.Effect>
    complete: Bool
    bundled: Bool
    approvals: List<(String * LanguageTools.Permissions.Policy)>
    approvedAs: List<String>
    /// The version an approval under this name is for, when that is another version.
    olderApproval: Option<String>
    instancePolicy: LanguageTools.Permissions.Policy }


// Builtin wrappers.
// The policy builtins are called only from these wrappers (tests/builtin).

let currentPolicy(): LanguageTools.Permissions.Policy =
  Builtin.pmPolicyGetInstance()


/// Change the instance policy: replace it whole, or add and remove rules.
let changePolicy(edit: LanguageTools.Permissions.PolicyEdit): Unit =
  Builtin.pmPolicyEditInstance(edit)


let writePolicy(policy: LanguageTools.Permissions.Policy): Unit =
  changePolicy(LanguageTools.Permissions.PolicyEdit.Replace(policy))


/// Atomically edit the instance policy. Removals apply before additions.
let editInstancePolicy(
  allow: List<LanguageTools.Permissions.Rule>,
  deny: List<LanguageTools.Permissions.Rule>,
  remove: List<LanguageTools.Permissions.Rule>)
  : Unit =
  changePolicy(LanguageTools.Permissions.PolicyEdit.Change(allow, deny, remove))


/// The effects a policy decides on: all but `Raise`, which no rule grants or denies.
let permissionEffects(
  effects: List<LanguageTools.Permissions.Effect>)
  : List<LanguageTools.Permissions.Effect> =
  effects |> Stdlib.List.filter(fun e -> e != LanguageTools.Permissions.Effect.Raise)


/// The transitive permission requirements and whether analysis was complete.
/// Incomplete analysis returns the effects found with `false`; fetch once and
/// pass the result around because this walks the function's closure.
let permissionRequirementsForHash(hash: String): (List<LanguageTools.Permissions.Effect> * Bool) =
  let (effects, complete) = Builtin.pmFnPermissionRequirements(hash)
  (permissionEffects(effects), complete)


/// Remove one named approval, or every named approval for a hash.
let withdraw(accountID: Option<Uuid>, target: LanguageTools.Permissions.ApprovalTarget): Unit =
  Builtin.pmPolicyWithdraw(accountID, target)


/// Withdraw every named approval for one immutable version.
let revokeHash(accountID: Option<Uuid>, hash: String): Unit =
  withdraw(accountID, LanguageTools.Permissions.ApprovalTarget.Hash(hash))


let approvedHashes(accountID: Option<Uuid>): List<String> =
  Builtin.pmPolicyListPackages(accountID)


/// Whether this immutable function is bundled first-party code, plus the
/// account's consumer policy when it has one.
let packageAccess(
  accountID: Option<Uuid>,
  hash: String)
  : (Bool * List<(String * LanguageTools.Permissions.Policy)>) =
  let approvals =
    approvalsOf(accountID, Option.Some(hash))
    |> Stdlib.List.filterMap(fun approval ->
      match approval.name, approval.policy with
      | Some(name), Some(policy) -> Option.Some((name, policy))
      | _ -> Option.None)

  (Builtin.pmFnIsBundled(hash), approvals)


/// The rules the consumer wrote when approving <param hash> as a root; None
/// for a derived approval.
let explicitApprovalFor(
  accountID: Option<Uuid>,
  name: String)
  : Option<LanguageTools.Permissions.Policy> =
  approvalsOf(accountID, Option.None)
  |> Stdlib.List.filter(fun a -> a.name == Option.Some(name))
  |> Stdlib.List.head
  |> Stdlib.Option.andThen(fun approval -> approval.explicitRules)


/// Whether existing approvals were recorded under different approval-analysis
/// semantics than this host's — a re-review signal (enforcement stays
/// fail-closed regardless).
let approvalsStale(): Bool =
  Builtin.pmPolicyApprovalsStale()


/// Every (logical name, approved version) pair for this account.
let approvedVersions(accountID: Option<Uuid>): List<(String * String)> =
  approvalsOf(accountID, Option.None)
  |> Stdlib.List.filterMap(fun approval ->
    approval.name |> Stdlib.Option.map(fun name -> (name, approval.hash)))


/// Approvals as this account sees them, one per (hash, name). With <param hash>, the entries for
/// that hash (one with no name when no name points at it); with None, one per approved name.
let approvalsOf(
  accountID: Option<Uuid>,
  hash: Option<String>)
  : List<LanguageTools.Permissions.Approval> =
  Builtin.pmPolicyApprovals(accountID, hash)


/// Each named approval, including separate names with identical code, marking
/// the ones whose function has changed since.
let namedApprovals(accountID: Option<Uuid>, branchId: Uuid): List<String> =
  approvedVersions(accountID)
  |> Stdlib.List.map(fun((name, hash)) ->
    let older =
      match latestVersion(branchId, name) with
      | Some(latest) when latest != hash -> ", for an older version"
      | _ -> ""

    $"  {name}  (version {shortVersion(hash)}{older})")


/// Capture before showing a review; mutations compare it atomically when saving.
let reviewToken(): String =
  Builtin.pmPolicyReviewToken()


/// Whether approving goes ahead when the shown requirements are incomplete.
type Incomplete =
  | Acknowledge
  | Refuse


/// Whether approving goes ahead when the permission contract changed since the last approval,
/// or refuses with the differences for a second review.
type ContractChange =
  | Acknowledge
  | Refuse


/// Remember access for an immutable closure under its logical name, atomically. The builtin
/// compares the contract before storing approval; a changed contract returns diffs for explicit
/// review. `rules` optionally narrows the consumer's policy; None approves the analyzed effect set.
let approveVersionFor(
  accountID: Option<Uuid>,
  name: String,
  expected: String,
  hash: String,
  rules: Option<LanguageTools.Permissions.Policy>,
  incomplete: Incomplete,
  contractChange: ContractChange)
  : Result<Unit, LanguageTools.Permissions.ApprovalFailure> =
  Builtin.pmPolicyApproveVersion(
    accountID,
    name,
    expected,
    hash,
    rules,
    incomplete == Incomplete.Acknowledge,
    contractChange == ContractChange.Acknowledge)


/// Withdraw a name's remembered access; name resolution is unchanged.
let unapproveVersionFor(accountID: Option<Uuid>, name: String): Unit =
  withdraw(accountID, LanguageTools.Permissions.ApprovalTarget.Name(name))


// Requirements display.

let shortVersion(hash: String): String =
  Stdlib.String.slice(hash, 0, 8)


let requirementSummary(requirements: List<LanguageTools.Permissions.Effect>): String =
  if Stdlib.List.isEmpty(requirements) then
    "effect-free"
  else
    Stdlib.String.join(requirements |> Stdlib.List.map(LanguageTools.Permissions.effectName), ", ")


/// One line for a `permissionRequirementsForHash` result. When the analysis
/// could not follow everything, the effects it did find are shown and the
/// remainder is called unknown. It does not say why: a callback, a package
/// value, and an implementation picked at run time all look the same here.
let describeRequirements(requirements: (List<LanguageTools.Permissions.Effect> * Bool)): String =
  match requirements with
  | effects, true -> requirementSummary(effects)
  | [], false -> "not fully known"
  | effects, false -> requirementSummary(effects) + ", possibly more"


let requirementDisplay(hash: String): String =
  describeRequirements(permissionRequirementsForHash(hash))


/// The bracketed requirements badge listings show next to a function,
/// e.g. `[file-read]`; callers colour it for their view.
let requirementBadge(hash: LanguageTools.ProgramTypes.Hash): String =
  "[" + requirementDisplay(LanguageTools.ProgramTypes.hashToString(hash)) + "]"


/// Effects describe the body; runtime permissions check the actual resources.
let policyLinesForHash(hash: String): List<String> =
  let requirementsLine = "permission requirements: " + requirementDisplay(hash)
  let (_, reasons) = Effects.reasons(hash)
  if
    Stdlib.List.any(reasons, fun((effect, _)) -> effect == LanguageTools.Permissions.Effect.Raise)
  then
    [ requirementsLine, "can raise a runtime error" ]
  else
    [ requirementsLine ]


/// Label grants and explicit blocks separately, including when either is empty.
let policyLines(policy: LanguageTools.Permissions.Policy): List<String> =
  let ruleLines(rules: List<LanguageTools.Permissions.Rule>): List<String> =
    if Stdlib.List.isEmpty(rules) then
      [ "  none" ]
    else
      rules |> Stdlib.List.map(fun rule -> "  " + LanguageTools.Permissions.renderRule(rule))

  Stdlib.List.flatten(
    [ [ "Allowed:" ], ruleLines(policy.allow), [ "Explicitly denied:" ], ruleLines(policy.deny) ])


/// The instance policy as `permissions list` prints it.
let instancePolicyLines(): List<String> =
  Stdlib.List.flatten(
    [ [ "Instance defaults:" ]
      policyLines(currentPolicy())
      [ "Unlisted access needs a remembered approval or --allow. Explicit denies win." ] ])


let indentedPolicyLines(policy: LanguageTools.Permissions.Policy): List<String> =
  policyLines(policy) |> Stdlib.List.map(fun line -> "    " + line)


/// Show only this function's effects and remembered approvals.
let renderAccessReport(name: String, facts: AccessReportFacts): List<String> =
  let effectFree = facts.complete && Stdlib.List.isEmpty(facts.effects)
  let effects =
    if effectFree then
      "none"
    else
      describeRequirements((facts.effects, facts.complete))

  let analysisLines =
    if facts.complete then
      []
    else
      [ "  Warning: analysis is incomplete; more permissions may be needed." ]

  let packageLines =
    if Stdlib.List.isEmpty(facts.approvals) then
      match facts.olderApproval with
      | Some(version) ->
        [ $"  Remembered approval: for an older version ({shortVersion(version)}); `permissions update {name}` reviews this one" ]
      | None -> [ "  Remembered approval: none" ]
    else
      facts.approvals
      |> Stdlib.List.map(fun((approvedName, policy)) ->
        Stdlib.List.prepend(
          indentedPolicyLines(policy),
          $"  Remembered approval for {approvedName} (version {shortVersion(facts.hash)}):"))
      |> Stdlib.List.flatten

  Stdlib.List.flatten(
    [ [ name, $"  Effects: {effects}" ]
      if effectFree then [ "  Permissions needed: none" ] else []
      analysisLines
      packageLines ])


/// Facts shared by the function report and workbench detail pane.
let accessFacts(accountID: Option<Uuid>, hash: String): AccessReportFacts =
  let (effects, complete) = permissionRequirementsForHash(hash)
  let (bundled, approvals) = packageAccess(accountID, hash)
  let approvedAs =
    approvedVersions(accountID)
    |> Stdlib.List.filter(fun pair ->
      let (_name, approvedHash) = pair
      approvedHash == hash)
    |> Stdlib.List.map(Stdlib.Tuple2.first)

  AccessReportFacts
    { hash = hash
      effects = effects
      complete = complete
      bundled = bundled
      approvals = approvals
      approvedAs = approvedAs
      olderApproval = Option.None
      instancePolicy = currentPolicy() }


// Instance policy edits.

let invalidRule(args: List<String>): String =
  invalidRuleText(Stdlib.String.join(args, " "))


/// The message for <param text> that did not parse, naming the current form of an old one.
let invalidRuleText(text: String): String =
  match Stdlib.String.split(Stdlib.String.trim(text), " ") with
  | ["http-server", port] when Stdlib.Result.isOk(Stdlib.Int64.parse(port)) ->
    $"invalid permission rule: {text}. http-server takes an address and a port, e.g. http-server 127.0.0.1 {port}"
  | _ -> $"invalid permission rule: {text}"


/// External shells have already grouped quoted arguments, while the
/// interactive CLI's general command splitter leaves quote fragments in the
/// list. Re-tokenize only the latter; direct argv remains lossless for an
/// argument that itself contains spaces.
let parseRuleArgs(args: List<String>): Option<List<LanguageTools.Permissions.Rule>> =
  let hasQuotedFragment =
    args
    |> Stdlib.List.any(fun arg ->
      Stdlib.String.startsWith(arg, "'") || Stdlib.String.startsWith(arg, "\""))

  if hasQuotedFragment then
    LanguageTools.Permissions.parseRuleText(Stdlib.String.join(args, " "))
  else
    LanguageTools.Permissions.parseRule(args)


/// Read-modify-write the instance policy and report. <param edit> returns the
/// next policy, or the message for input that did not parse.
let editPolicy(
  edit: LanguageTools.Permissions.Policy -> Result<LanguageTools.Permissions.Policy, String>,
  success: String)
  : Bool =
  match edit(currentPolicy()) with
  | Ok(next) ->
    writePolicy(next)
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(success))
    true
  | Error(message) ->
    printErr(message)
    false


/// One rule, or several separated by `;` like `set`. Error is the first rule that did not parse.
let parseRuleList(args: List<String>): Result<List<LanguageTools.Permissions.Rule>, String> =
  if Stdlib.List.any(args, fun arg -> Stdlib.String.contains(arg, ";")) then
    Stdlib.String.split(Stdlib.String.join(args, " "), ";")
    |> Stdlib.List.map(Stdlib.String.trim)
    |> Stdlib.List.filter(fun spec -> spec != "")
    |> Stdlib.List.fold(Result.Ok([]), fun(result, spec) ->
      match result with
      | Error(bad) -> Result.Error(bad)
      | Ok(rules) ->
        match LanguageTools.Permissions.parseRuleText(spec) with
        | Some(more) -> Result.Ok(Stdlib.List.concat(rules, more))
        | None -> Result.Error(spec))
  else
    match parseRuleArgs(args) with
    | Some(rules) -> Result.Ok(rules)
    | None -> Result.Error(Stdlib.String.join(args, " "))


/// Parse rule arguments and pass them to <param edit>, or report invalid input. One rule that does
/// not parse saves none of them.
let editRules(
  args: List<String>,
  edit: List<LanguageTools.Permissions.Rule> -> Unit,
  success: String)
  : Bool =
  match parseRuleList(args) with
  | Error(bad) ->
    printErr(invalidRule([ bad ]))
    false
  | Ok(rules) ->
    edit(rules)
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(success))
    true


/// `set a; deny b; c` replaces the whole policy.
let replacePolicy(specs: List<String>): Result<LanguageTools.Permissions.Policy, String> =
  let specs =
    Stdlib.String.split(Stdlib.String.join(specs, " "), ";")
    |> Stdlib.List.map(Stdlib.String.trim)
    |> Stdlib.List.filter(fun spec -> spec != "")

  match LanguageTools.Permissions.parse(specs) with
  | Ok(policy) -> Result.Ok(policy)
  | Error(bad) -> Result.Error(invalidRuleText(bad))


// Named consumer approvals.
// The user-facing surface for account-scoped package approvals and version
// approvals (docs/effects.md). Hashes stay internal; output shows short version
// identifiers only.

/// Resolve a logical name to its latest published version on this branch.
let latestVersion(branchId: Uuid, name: String): Option<String> =
  let location = LanguageTools.ProgramTypes.parsePackageLocation(name)
  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | Some(hash) -> Option.Some(LanguageTools.ProgramTypes.hashToString(hash))
  | None -> Option.None


/// The version this account has APPROVED for <param name>, if any.
let approvedVersionOf(accountID: Option<Uuid>, name: String): Option<String> =
  approvedVersions(accountID)
  |> Stdlib.List.findFirst(fun pair ->
    let (approvedName, _hash) = pair
    approvedName == name)
  |> Stdlib.Option.map(fun pair ->
    let (_name, hash) = pair
    hash)


/// `requirements`/`show` accept a logical name (resolved to its latest version)
/// or a raw hash for diagnostics.
let resolveVersionArg(state: AppState, arg: String): Option<String> =
  if Stdlib.String.contains(arg, ".") then
    latestVersion(state.currentBranchId, arg)
  else
    // A raw hash must name a stored version; otherwise the analysis would
    // report an unknown version as merely "incomplete".
    match LanguageTools.PackageManager.Function.get(LanguageTools.ProgramTypes.Hash.Hash(arg)) with
    | Some(_) -> Option.Some(arg)
    | None -> Option.None


/// Print a version's requirements, warning when analysis is incomplete.
/// Returns completeness so callers can acknowledge a possibly short list.
let showVersionRequirements(heading: String, hash: String): Bool =
  let requirements = permissionRequirementsForHash(hash)
  let (_effects, complete) = requirements
  Stdlib.printLine(heading)
  Stdlib.printLine($"  permission requirements: {describeRequirements(requirements)}")
  if Stdlib.Bool.not(complete) then
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.warning(
        "  some calls in this function could not be followed (a callback, a package value, or an implementation picked at run time), so the list above may be short. The instance and run policies still bound whatever it does."))
  else
    ()

  complete


/// Take `--yes`/`-y` out of the arguments, reporting whether it was there.
///
/// An unattended run must pass this explicitly: CI gives each step a pty, which
/// looks like a person. It is stripped before the rules are parsed, so it is
/// never mistaken for a permission rule.
let takeYesFlag(args: List<String>): (Bool * List<String>) =
  let isYesFlag(a: String): Bool = a == "--yes" || a == "-y"
  let yes = args |> Stdlib.List.any(isYesFlag)
  let rest = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(isYesFlag(a)))
  (yes, rest)


/// Show the full replacement before any write. Previewing never prompts or
/// edits policy; --yes uses the same host-only writer as `permissions set`.
let profile(args: List<String>): Bool =
  match args with
  | [] ->
    Stdlib.printLines(Profiles.listing)
    true
  | _ ->
    match takeYesFlag(args) with
    | _, [] ->
      printErr("profile needs a name")
      false
    | apply, [name, ...rest] ->
      match Profiles.resolve(name, rest) with
      | Error(message) ->
        printErr(message)
        false
      | Ok(policy) ->
        Stdlib.printLine($"Profile {name} replaces the entire instance policy, including denies:")
        Stdlib.printLines(indentedPolicyLines(policy))
        if apply then
          writePolicy(policy)
          Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"✓ applied profile {name}"))
        else
          Stderr.hint("Preview only. Repeat with --yes to apply.")

        true


/// The rules given after a name on `approve`/`update`, `;`-separated like
/// `set`. Ok None when there are none.
let parseApprovalRules(
  specs: List<String>)
  : Result<Option<LanguageTools.Permissions.Policy>, String> =
  if Stdlib.List.isEmpty(specs) then
    Result.Ok(Option.None)
  else
    match replacePolicy(specs) with
    | Ok(policy) -> Result.Ok(Option.Some(policy))
    | Error(message) -> Result.Error(message)


/// Refuse to remember access with nobody at a terminal to confirm it.
let needsYes(): String =
  "no terminal to confirm at; add --yes to remember this access"


/// Lines describing the policy a version is approved under, for the prompt.
let describeApprovalRules(rules: Option<LanguageTools.Permissions.Policy>): List<String> =
  match rules with
  | None -> []
  | Some(policy) ->
    Stdlib.List.prepend(
      indentedPolicyLines(policy),
      "  additional grants for this entry and its helpers:")


let approvalFailureText(failure: LanguageTools.Permissions.ApprovalFailure): String =
  match failure with
  | Refused(message) -> Stdlib.Cli.UI.Colors.error(message)
  | ContractChanged(diffs) ->
    Stdlib.Cli.UI.Colors.warning(
      "the permission contract changed — review required:\n"
      + (diffs
         |> Stdlib.List.map(fun diff -> $"    {diff}")
         |> Stdlib.String.join("\n")))


/// Approve <param hash> for <param name> and report: <param accepted> on success, the refusal (then
/// <param kept>) when it cannot be approved. Answers whether it approved, and Some diffs when
/// approving wants a second review of a changed contract and <param contractChange> was
/// `Refuse`; the caller shows them and asks.
let approveReporting(
  accountID: Option<Uuid>,
  name: String,
  expected: String,
  hash: String,
  rules: Option<LanguageTools.Permissions.Policy>,
  incomplete: Incomplete,
  contractChange: ContractChange,
  accepted: String,
  kept: String)
  : (Bool * Option<List<String>>) =
  match approveVersionFor(accountID, name, expected, hash, rules, incomplete, contractChange) with
  | Ok(_) ->
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(accepted))
    (true, Option.None)
  | Error(Refused(message)) ->
    printErr(message)
    if kept != "" then Stderr.line(kept) else ()
    (false, Option.None)
  | Error(ContractChanged(diffs)) -> (false, Option.Some(diffs))


let approveNamed(
  state: AppState,
  acceptWithoutPrompt: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  let expected = reviewToken()
  match parseApprovalRules(specs) with
  | Error(message) ->
    printErr(message)
    false
  | Ok(rules) ->
    match latestVersion(state.currentBranchId, name) with
    | None ->
      printErr($"unknown function: {name}")
      false
    | Some(hash) ->
      let complete = showVersionRequirements($"{name} {shortVersion(hash)}", hash)
      Stdlib.printLines(describeApprovalRules(rules))
      if Stdlib.Bool.not(acceptWithoutPrompt || Stdlib.Cli.UI.Prompt.canAsk()) then
        printErr(needsYes())
        false
      else if
        acceptWithoutPrompt
        || Stdlib.Cli.UI.Prompt.confirm("Remember this access for this code version?")
      then
        // An explicit `permissions approve <name>` showed the requirements and
        // named this exact version; that is the contract review, so a changed
        // contract is acknowledged up front and no second review can be asked.
        let (approved, _diffs) =
          approveReporting(
            state.accountID,
            name,
            expected,
            hash,
            rules,
            (if complete then Incomplete.Refuse else Incomplete.Acknowledge),
            ContractChange.Acknowledge,
            $"✓ remembered access for {name} {shortVersion(hash)}",
            "")

        approved
      else
        // Declining at the prompt is an answer, not a failure.
        Stdlib.printLine("not approved")
        true


/// Review access for newer code; declining leaves the old approval unchanged.
/// A changed contract requires a second confirmation. `--yes` is the explicit
/// yes to both, and is required without a terminal.
let updateNamed(
  state: AppState,
  acceptWithoutPrompt: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  let accountID = state.accountID
  let expected = reviewToken()
  match parseApprovalRules(specs) with
  | Error(message) ->
    printErr(message)
    false
  | Ok(givenRules) ->
    match approvedVersionOf(accountID, name) with
    | None ->
      printErr($"{name} has no remembered approval; run `permissions approve {name}` first")
      false
    | Some(approved) ->
      match latestVersion(state.currentBranchId, name) with
      | None ->
        printErr($"unknown function: {name}")
        false
      | Some(latest) ->
        // Rules given now win; otherwise the rules the consumer wrote when
        // approving carry over, and a derived effect set is recomputed from
        // the new version. Provenance is stored with the approval, so an
        // explicit `clock` is never mistaken for a derived one.
        let rules =
          match givenRules with
          | Some(_) -> givenRules
          | None -> explicitApprovalFor(accountID, name)

        let complete =
          showVersionRequirements(
            $"{name}: {shortVersion(approved)} → {shortVersion(latest)}",
            latest)

        Stdlib.printLines(describeApprovalRules(rules))
        let incomplete = if complete then Incomplete.Refuse else Incomplete.Acknowledge
        let kept = "Approval unchanged."
        let accepted = $"✓ remembered access for {name} {shortVersion(latest)}"
        let approve(contractChange: ContractChange): (Bool * Option<List<String>>) =
          approveReporting(
            accountID,
            name,
            expected,
            latest,
            rules,
            incomplete,
            contractChange,
            accepted,
            kept)

        if Stdlib.Bool.not(acceptWithoutPrompt || Stdlib.Cli.UI.Prompt.canAsk()) then
          printErr(needsYes())
          false
        else if
          Stdlib.Bool.not(
            acceptWithoutPrompt
            || Stdlib.Cli.UI.Prompt.confirm("Remember access for the current code version?"))
        then
          // Declining leaves the old approval unchanged; it cannot authorize the new code.
          Stdlib.printLine(kept)
          true
        else
          let (approvedFirst, review) = approve(ContractChange.Refuse)
          match review with
          | None -> approvedFirst
          | Some(diffs) ->
            // What the next question asks about, so on stderr with the question.
            Stdlib.printErrorLine(
              approvalFailureText(LanguageTools.Permissions.ApprovalFailure.ContractChanged(diffs)))

            // The differences were shown; accepting them is the review.
            let acceptChanged =
              acceptWithoutPrompt
              || Stdlib.Cli.UI.Prompt.confirm(
                "Approve this code version and its changed permission requirements?")

            if acceptChanged then
              let (approvedSecond, _review) = approve(ContractChange.Acknowledge)
              approvedSecond
            else
              Stdlib.printLine(kept)
              true


/// Run <param show> against the version <param target> names, or report an
/// unknown function.
let withVersion(state: AppState, target: String, show: String -> List<String>): Bool =
  match resolveVersionArg(state, target) with
  | None ->
    printErr($"unknown function: {target}")
    false
  | Some(hash) ->
    Stdlib.printLines(show(hash))
    true


let printListOrNone(items: List<String>): Unit =
  if Stdlib.List.isEmpty(items) then
    Stdlib.printLine("none")
  else
    Stdlib.printLines(items)


/// Every subcommand with the usage it prints when its argument is missing;
/// None for the ones that take no argument. Drives `execute`'s
/// missing-argument arm and `complete`.
val subcommands =
  [ ("list", Option.None)
    ("profile", Option.None)
    ("allow", Option.Some("allow <rule>;…"))
    ("deny", Option.Some("deny <rule>;…"))
    ("remove", Option.Some("remove <rule>;…"))
    // `set` with nothing would otherwise replace the policy with deny-all;
    // that is what `clear` is for.
    ("set", Option.Some("set <rule>;… (or `clear`)"))
    ("clear", Option.None)
    ("approve", Option.Some("approve <fn> [rule,…]"))
    ("update", Option.Some("update <fn> [rule,…]"))
    ("unapprove", Option.Some("unapprove <fn>"))
    ("approved", Option.None)
    ("requirements", Option.Some("requirements <fn|hash>"))
    ("show", Option.Some("show <fn|hash>"))
    ("approvals", Option.None)
    ("revoke-package", Option.Some("revoke-package <hash>")) ]


/// The usage line for a subcommand given without its argument, if it needs one.
let usageOf(subcommand: String): Option<String> =
  subcommands
  |> Stdlib.List.findFirst(fun((name, _usage)) -> name == subcommand)
  |> Stdlib.Option.andThen(fun((_name, usage)) -> usage)


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] | ["list"] ->
    Stdlib.printLines(instancePolicyLines())
    state
  | ["help"] ->
    Stdlib.printLine(help(state))
    state
  | ["profile", ...args] -> exitWith(state, profile(args))
  // Before the `[<subcommand>, ...args]` arms: a subcommand given with no
  // argument must report usage, not run with an empty argument list (`set`
  // with nothing would replace the policy with deny-all).
  | [subcommand] when Stdlib.Option.isSome(usageOf(subcommand)) ->
    let usage = Stdlib.Option.withDefault(usageOf(subcommand), "")
    printErr($"missing argument; usage: permissions {usage}")
    failed(state)
  | ["allow", ...rule] ->
    exitWith(
      state,
      editRules(rule, (fun rules -> editInstancePolicy(rules, [], [])), "✓ policy updated"))
  | ["deny", ...rule] ->
    exitWith(
      state,
      editRules(rule, (fun rules -> editInstancePolicy([], rules, [])), "✓ policy updated"))
  | ["remove", ...rule] ->
    exitWith(
      state,
      editRules(rule, (fun rules -> editInstancePolicy([], [], rules)), "✓ rule removed"))
  | ["clear"] ->
    exitWith(
      state,
      editPolicy(
        (fun _ -> Result.Ok(LanguageTools.Permissions.empty())),
        "✓ policy is now deny-all"))
  | ["set", ...specs] ->
    exitWith(state, editPolicy((fun _ -> replacePolicy(specs)), "✓ policy replaced"))
  | ["approve", ...rest] ->
    match takeYesFlag(rest) with
    | acceptWithoutPrompt, [name, ...rules] ->
      exitWith(state, approveNamed(state, acceptWithoutPrompt, name, rules))
    | _, [] ->
      printErr("approve needs a function name")
      failed(state)
  | ["update", ...rest] ->
    match takeYesFlag(rest) with
    | acceptWithoutPrompt, [name, ...rules] ->
      exitWith(state, updateNamed(state, acceptWithoutPrompt, name, rules))
    | _, [] ->
      printErr("update needs a function name")
      failed(state)
  | ["unapprove", name] ->
    // An approval is keyed by the name as it was approved, so an unmatched name withdraws nothing;
    // say so rather than report a release that did not happen.
    let approvedNames =
      approvedVersions(state.accountID)
      |> Stdlib.List.map(fun pair ->
        let (approvedName, _hash) = pair
        approvedName)

    if Stdlib.List.contains(approvedNames, name) then
      unapproveVersionFor(state.accountID, name)
      Stdlib.printLine(
        Stdlib.Cli.UI.Colors.success(
          $"✓ Removed remembered approval for {name}. Other rules may still allow access."))

      state
    else
      printErr($"{name} has no remembered approval; `permissions approved` lists the ones that do")
      failed(state)
  | ["requirements", target] ->
    exitWith(state, withVersion(state, target, fun hash -> [ requirementDisplay(hash) ]))
  | ["show", target] ->
    if Stdlib.String.startsWith(target, "script:") then
      match explicitApprovalFor(state.accountID, target) with
      | None ->
        printErr($"No remembered approval for {target}")
        failed(state)
      | Some(policy) ->
        Stdlib.printLine($"Remembered approval for {target}:")
        Stdlib.List.iter(indentedPolicyLines(policy), Stdlib.printLine)
        Stdlib.printLine("Applies only to the reviewed source and dependency versions.")
        Stdlib.printLine("Instance denies and run restrictions still win.")
        state
    else
      let name = TraceVerbs.canonicalFnName(state.currentBranchId, target)
      exitWith(
        state,
        withVersion(state, name, fun hash ->
          let facts = accessFacts(state.accountID, hash)
          let facts =
            if target == hash then
              facts
            else
              { facts with
                  approvals = Stdlib.List.filter(facts.approvals, fun((n, _)) -> n == name)
                  approvedAs = Stdlib.List.filter(facts.approvedAs, fun n -> n == name)
                  olderApproval =
                    match approvedVersionOf(state.accountID, name) with
                    | Some(version) when version != hash -> Option.Some(version)
                    | _ -> Option.None }

          renderAccessReport(name, facts)))
  | ["revoke-package", hash] ->
    // A hash that was never approved revokes nothing; say so rather than report a revoke.
    if Stdlib.List.contains(approvedHashes(state.accountID), hash) then
      revokeHash(state.accountID, hash)
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success("✓ package approval revoked"))
      state
    else
      printErr($"{hash} has no approval; `permissions approvals` lists the ones that do")
      failed(state)
  | ["approved"] | ["approvals"] ->
    let approvals = namedApprovals(state.accountID, state.currentBranchId)
    if Stdlib.List.isEmpty(approvals) then
      Stdlib.printLine("Remembered approvals: none")
    else
      Stdlib.printLine("Remembered approvals:")
      Stdlib.printLines(approvals)

    if approvalsStale() then
      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.warning(
          "! approval analysis changed since these were approved; re-review with `permissions approve <fn>`"))
    else
      ()

    state
  | _ ->
    printErr("unknown permissions command: " + Stdlib.String.join(args, " "))
    Stdlib.printErrorLine(help(state))
    failed(state)


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | ["profile"] -> Profiles.all |> Stdlib.List.map(fun profile -> Completion.simple(profile.name))
  // Wildcards, not `_root`: every branch of an or-pattern has to bind the same names, and the
  // first one binds nothing. Nothing here reads the root anyway.
  | ["profile", "default"] | ["profile", "read-only", _] | ["profile", "local-dev", _] ->
    [ Completion.simple("--yes") ]
  | ["profile", ...] -> []
  | _ -> subcommands |> Stdlib.List.map(fun((name, _usage)) -> Completion.simple(name))


let help(_state: AppState): String =
  [ "Usage: permissions [list] | allow <rule>;… | deny <rule>;… | remove <rule>;…"
    "                   | set <rule>;… | clear"
    "                   | profile [name [ABSOLUTE-ROOT] [--yes]]"
    "                   | approve <fn> [rules] | update <fn> [rules] | unapprove <fn>"
    "                   | approved"
    "                   | requirements <fn|hash> | show <fn|hash>"
    "                   | approvals | revoke-package <hash>"
    ""
    "The instance policy is local and deny-by-default. Every actual host operation"
    "needs an instance grant, a named entry approval, or a temporary run grant."
    "Explicit instance denies and run restrictions always win. Helpers inherit"
    "their caller's access. Effects describe behavior; they do not grant access."
    "Dark checks the actual file, URL or other resource before each operation."
    ""
    "Inspect permissions:"
    "  list           instance defaults: allowed rules and explicit denies"
    "  show <fn>      the function's effects and remembered approvals"
    "  approved       remembered approvals, each tied to a name and code version"
    "  approvals      the same as approved"
    "  effects <fn>   (a top-level command) effects and a call path for each"
    ""
    "allow, deny and remove take several rules separated by `;`, quoted for the shell:"
    "  permissions allow 'clock; random; file read /tmp'"
    "If any of them is not a rule, none are saved."
    ""
    "Profiles:"
    "  profile                         list the available presets"
    "  profile default                 preview the installation default"
    "  profile read-only <ROOT>        directory/store reads and HTTPS GET"
    "  profile local-dev <ROOT>        directory/store writes and HTTP serving too"
    "  Add --yes to apply. Replaces the entire instance policy, including denies."
    "  ROOT must be absolute; no process, native or environment access is granted."
    "  HTTPS GET permits any host on port 443; HTTP serving permits any port on 127.0.0.1."
    ""
    "Named approvals:"
    "  --yes, -y      skip the confirmation; required without a terminal"
    "  approve <fn>   remember access for the current code and its dependencies."
    "                 Edits run immediately but do not inherit the old approval."
    "                 Rules allow access to this entry and its helpers, in addition"
    "                 to instance defaults. Separate names have separate grants, e.g."
    "                 approve MyApp.fetch http GET 'https://api.example.com'"
    "  update <fn>    review access for the current version; declining leaves the"
    "                 approval unchanged. A changed permission contract asks again."
    "                 Rules on approve carry over unless new ones are given"
    "  unapprove <name> withdraw a function or script approval; other rules still apply"
    "  revoke-package <hash> withdraw all named approvals of that version"
    ""
    "Rules:"
    "  <effect>                         e.g. clock, random, stdout, http, process,"
    "                                   package-read, trace-write (all of an effect)"
    "  http <METHOD> [URL]              /api is exact; /api/* includes child paths"
    "                                   no path allows any path; no query allows any query"
    "  http-server <ADDRESS|*> <PORT|*>  IPv4 address, localhost, or any address"
    "  file read|write|read+write [ROOT]"
    "  env read|write|read+write [NAME]"
    "  process <ABSOLUTE-EXECUTABLE|*> [ARG…]"
    "  process-exact <ABSOLUTE-EXECUTABLE> [ARG…]  only those arguments (none means none)"
    "  native                           builtins that can reach anything (raw descriptors,"
    "                                   process handles); no narrower form exists"
    "  all"
    "  deny <rule> (in `set`)           an explicit deny; deny beats allow" ]
  |> Stdlib.String.join("\n")
