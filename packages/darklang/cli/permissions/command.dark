module Darklang.Cli.Permissions.Command

type AccessReportFacts =
  { hash: String
    effects: List<LanguageTools.Permissions.Effect>
    complete: Bool
    ceiling: Stdlib.Option.Option<List<LanguageTools.Permissions.Effect>>
    bundled: Bool
    packagePolicy: Stdlib.Option.Option<LanguageTools.Permissions.Policy>
    approvedAs: List<String>
    instancePolicy: LanguageTools.Permissions.Policy }

// Builtin wrappers.
// The policy builtins are called only from these wrappers (tests/builtin).

let currentPolicy(): LanguageTools.Permissions.Policy =
  Builtin.pmPolicyGetInstance()

/// Change the instance policy: replace it whole, or add and remove rules.
let changePolicy(edit: LanguageTools.Permissions.PolicyEdit): Unit =
  Builtin.pmPolicyEditInstance(edit)

let writePolicy(policy: LanguageTools.Permissions.Policy): Unit =
  Command.changePolicy(LanguageTools.Permissions.PolicyEdit.Replace(policy))

/// Atomically edit the instance policy. Removals apply before additions.
let editInstancePolicy(
  allow: List<LanguageTools.Permissions.Rule>,
  deny: List<LanguageTools.Permissions.Rule>,
  remove: List<LanguageTools.Permissions.Rule>)
  : Unit =
  Command.changePolicy(LanguageTools.Permissions.PolicyEdit.Change(allow, deny, remove))

/// The transitive permission requirements and whether analysis was complete.
/// Incomplete analysis returns the effects found with `false`; fetch once and
/// pass the result around because this walks the function's closure.
let permissionRequirementsForHash(
  hash: String)
  : (List<LanguageTools.Permissions.Effect> * Bool) =
  Builtin.pmFnPermissionRequirements(hash)

/// Take an approval back: a name's approved version, or a hash's approval. They are separate
/// records; withdrawing one leaves the other.
let withdraw(
  accountID: Stdlib.Option.Option<Uuid>,
  target: LanguageTools.Permissions.ApprovalTarget)
  : Unit =
  Builtin.pmPolicyWithdraw(accountID, target)

/// Drop the approval of one immutable version and the dependencies no other
/// approved root still needs. `unapprove` does not do this; a name's approved version and the
/// approval are separate records.
let revokeHash(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: String)
  : Unit =
  Command.withdraw(accountID, LanguageTools.Permissions.ApprovalTarget.Hash(hash))

let approvedHashes(accountID: Stdlib.Option.Option<Uuid>): List<String> =
  Builtin.pmPolicyListPackages(accountID)

/// Whether this immutable function is bundled first-party code, plus the
/// account's consumer policy when it has one.
let packageAccess(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: String)
  : (Bool * Stdlib.Option.Option<LanguageTools.Permissions.Policy>) =
  let policy =
    Command.approvalsOf(accountID, Stdlib.Option.Option.Some(hash))
    |> Stdlib.List.head
    |> Stdlib.Option.andThen(fun approval -> approval.policy)
  (Builtin.pmFnIsBundled(hash), policy)

/// The rules the consumer wrote when approving <param hash> as a root; None
/// for a derived approval.
let explicitApprovalFor(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: String)
  : Stdlib.Option.Option<LanguageTools.Permissions.Policy> =
  Command.approvalsOf(accountID, Stdlib.Option.Option.Some(hash))
  |> Stdlib.List.head
  |> Stdlib.Option.andThen(fun approval -> approval.explicitRules)

/// Whether existing approvals were recorded under different approval-analysis
/// semantics than this host's — a re-review signal (enforcement stays
/// fail-closed regardless).
let approvalsStale(): Bool =
  Builtin.pmPolicyApprovalsStale()

/// Every (logical name, approved version) pair for this account.
let approvedVersions(
  accountID: Stdlib.Option.Option<Uuid>)
  : List<(String * String)> =
  Command.approvalsOf(accountID, Stdlib.Option.Option.None)
  |> Stdlib.List.filterMap(fun approval ->
    approval.name |> Stdlib.Option.map(fun name -> (name, approval.hash)))

/// Approvals as this account sees them, one per (hash, name). With <param hash>, the entries for
/// that hash (one with no name when no name points at it); with None, one per approved name.
let approvalsOf(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: Stdlib.Option.Option<String>)
  : List<LanguageTools.Permissions.Approval> =
  Builtin.pmPolicyApprovals(accountID, hash)

/// The approved hashes, each labelled with the name that resolves to it when there is one. A hash
/// with no name is a dependency approved inside another root's closure.
let namedApprovals(
  accountID: Stdlib.Option.Option<Uuid>,
  branchId: Uuid)
  : List<String> =
  let byName = Command.approvedVersions(accountID)
  Command.approvedHashes(accountID)
  |> Stdlib.List.map(fun hash ->
    let named =
      byName
      |> Stdlib.List.filterMap(fun pair ->
        let (name, approvedHash) = pair
        if approvedHash == hash then Stdlib.Option.Option.Some(name)
        else Stdlib.Option.Option.None)
      |> Stdlib.List.head
    match named with
    | Some(name) -> $"{hash}  {name}"
    | None ->
      match Command.dependencyName(branchId, hash) with
      | Some(name) -> $"{hash}  {name} (dependency)"
      | None -> hash)

/// The store's name for an approved dependency's hash, when it has one on <param branchId>.
let dependencyName(
  branchId: Uuid,
  hash: String)
  : Stdlib.Option.Option<String> =
  let locations =
    LanguageTools.PackageManager.Function.locations(
      branchId,
      LanguageTools.ProgramTypes.Hash.Hash(hash))
  match
    LanguageTools.PackageManager.pickLocation(
      LanguageTools.PackageManager.PickContext.empty,
      locations)
  with
  | Some(l) ->
    Stdlib.Option.Option.Some(
      PrettyPrinter.RuntimeTypes.packageName(l.owner, l.modules, l.name)
    )
  | None -> Stdlib.Option.Option.None

/// Approve an immutable closure and point its logical name at that version, atomically. The builtin
/// compares the contract before storing approval; a changed contract returns diffs for explicit
/// review. `rules` optionally narrows the consumer's policy; None approves the analyzed effect set.
let approveVersionFor(
  accountID: Stdlib.Option.Option<Uuid>,
  name: String,
  hash: String,
  rules: Stdlib.Option.Option<LanguageTools.Permissions.Policy>,
  acknowledgeIncomplete: Bool,
  acknowledgeContractChange: Bool)
  : Stdlib.Result.Result<Unit, LanguageTools.Permissions.ApprovalFailure> =
  Builtin.pmPolicyApproveVersion(
    accountID,
    name,
    hash,
    rules,
    acknowledgeIncomplete,
    acknowledgeContractChange)

/// Withdraw a name's approved version, so it resolves to whatever is current again.
let unapproveVersionFor(
  accountID: Stdlib.Option.Option<Uuid>,
  name: String)
  : Unit =
  Command.withdraw(accountID, LanguageTools.Permissions.ApprovalTarget.Name(name))


// Requirements display.

let shortVersion(hash: String): String =
  Stdlib.String.slice(hash, 0, 8)

let requirementSummary(requirements: List<LanguageTools.Permissions.Effect>): String =
  if Stdlib.List.isEmpty(requirements) then "effect-free"
  else
    Stdlib.String.join(
      requirements |> Stdlib.List.map(LanguageTools.Permissions.effectName),
      ", ")

/// One line for a `permissionRequirementsForHash` result. When the analysis
/// could not follow everything, the effects it did find are shown and the
/// remainder is called unknown. It does not say why: a callback, a package
/// value, and an implementation picked at run time all look the same here.
let describeRequirements(
  requirements: (List<LanguageTools.Permissions.Effect> * Bool))
  : String =
  match requirements with
  | (effects, true) -> Command.requirementSummary(effects)
  | ([], false) -> "not fully known"
  | (effects, false) -> Command.requirementSummary(effects) + ", possibly more"

let requirementDisplay(hash: String): String =
  Command.describeRequirements(Command.permissionRequirementsForHash(hash))

/// The bracketed requirements badge listings show next to a function,
/// e.g. `[file-read]`; callers colour it for their view.
let requirementBadge(hash: LanguageTools.ProgramTypes.Hash): String =
  "[" + Command.requirementDisplay(LanguageTools.ProgramTypes.hashToString(hash)) + "]"

/// The author's `:{…}` ceiling for a function, when it declares one.
let ceilingForHash(
  hash: String)
  : Stdlib.Option.Option<List<LanguageTools.Permissions.Effect>> =
  match LanguageTools.PackageManager.Function.get(LanguageTools.ProgramTypes.Hash.Hash(hash)) with
  | Some(fn) -> fn.permissionCeiling
  | None -> Stdlib.Option.Option.None

/// The per-function permission facts, as `show` and the package viewers
/// print them: the requirements the body needs, the ceiling the author
/// declared, and a warning when the two disagree — a ceiling narrower than a
/// complete requirement set means those calls are denied at runtime.
let policyLinesForHash(hash: String): List<String> =
  let (effects, complete) = Command.permissionRequirementsForHash(hash)
  let requirementsLine =
    $"permission requirements: {Command.describeRequirements((effects, complete))}"
  match Command.ceilingForHash(hash) with
  | None -> [ requirementsLine ]
  | Some(ceiling) ->
    let row = LanguageTools.Permissions.ceilingRow(Stdlib.Option.Option.Some(ceiling))
    let exceeding =
      effects |> Stdlib.List.filter(fun e -> Stdlib.Bool.not(Stdlib.List.contains(ceiling, e)))
    let warning =
      if complete && Stdlib.Bool.not(Stdlib.List.isEmpty(exceeding)) then
        [ "  warning: the body requires "
          + Command.requirementSummary(exceeding)
          + ", which the ceiling denies at runtime" ]
      else []
    Stdlib.List.concat([ requirementsLine, $"function ceiling: {row}" ], warning)

/// A policy as rule lines; an empty policy is spelled out as `deny all`.
let policyLines(policy: LanguageTools.Permissions.Policy): List<String> =
  match LanguageTools.Permissions.render(policy) with
  | [] -> [ "deny all" ]
  | rules -> rules

/// The instance policy as `permissions list` prints it.
let instancePolicyLines(): List<String> =
  Command.policyLines(Command.currentPolicy())

let indentedPolicyLines(
  policy: LanguageTools.Permissions.Policy)
  : List<String> =
  Command.policyLines(policy) |> Stdlib.List.map(fun line -> "    " + line)

/// Pure rendering for the layered access explanation. Kept separate from the
/// host reads so its wording and security distinctions have executable tests.
let renderAccessReport(facts: Command.AccessReportFacts): List<String> =
  let requirements = Command.describeRequirements((facts.effects, facts.complete))
  let analysis =
    if facts.complete then "complete"
    else "incomplete: some calls could not be followed, so their effects are not known here"
  let ceilingText =
    match facts.ceiling with
    | None -> "not declared (inherits caller limits)"
    | Some(names) ->
      LanguageTools.Permissions.ceilingRow(Stdlib.Option.Option.Some(names))
  let approvalText =
    match facts.packagePolicy with
    | Some(_) -> "approved (rules below)"
    | None ->
      if facts.bundled then "not required (bundled Darklang code)"
      else "not approved for dependency use"
  let approvedAsText =
    if Stdlib.List.isEmpty(facts.approvedAs) then "none"
    else Stdlib.String.join(facts.approvedAs, ", ")
  let packageLines =
    match facts.packagePolicy with
    | Some(policy) ->
      Stdlib.List.prepend(
        Command.indentedPolicyLines(policy),
        "  package approval policy:")
    | None -> []
  let instanceLines =
    Stdlib.List.prepend(
      Command.indentedPolicyLines(facts.instancePolicy),
      "  instance policy:")
  let effective =
    if facts.bundled then
      "checked per operation: instance ∩ run ∩ function ceiling"
    else
      match facts.packagePolicy with
      | Some(_) ->
        "checked per operation: instance ∩ run ∩ package approval ∩ function ceiling"
      | None ->
        "blocked as a dependency; explicitly chosen entry points are treated as roots"
  Stdlib.List.flatten(
    [ [ "access"
        $"  version: {Command.shortVersion(facts.hash)}"
        $"  requires: {requirements}"
        $"  analysis: {analysis}"
        $"  author ceiling: {ceilingText}"
        $"  consumer approval: {approvalText}"
        $"  approved as: {approvedAsText}" ]
      packageLines
      instanceLines
      [ "  run policy: selected when invoked (`--sandbox` denies all)"
        $"  effective: {effective}"
        "  exact resources: paths, URLs, ports, names, and arguments are checked at call time" ] ])

/// A layered explanation of one immutable function's authority. Requirements
/// say what its reachable code may request; actual authorization remains the
/// runtime intersection shown here, with exact paths/URLs decided per call.
let accessReportLines(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: String)
  : List<String> =
  Command.renderAccessReport(Command.accessFacts(accountID, hash))

/// The facts behind `accessReportLines`, for a caller that renders them its
/// own way (the workbench's detail panes show a compact cut of them).
let accessFacts(
  accountID: Stdlib.Option.Option<Uuid>,
  hash: String)
  : Command.AccessReportFacts =
  let (effects, complete) = Command.permissionRequirementsForHash(hash)
  let (bundled, packagePolicy) = Command.packageAccess(accountID, hash)
  let approvedAs =
    Command.approvedVersions(accountID)
    |> Stdlib.List.filter(fun pair ->
      let (_name, approvedHash) = pair in approvedHash == hash)
    |> Stdlib.List.map(Stdlib.Tuple2.first)
  Command.AccessReportFacts
    { hash = hash
      effects = effects
      complete = complete
      ceiling = Command.ceilingForHash(hash)
      bundled = bundled
      packagePolicy = packagePolicy
      approvedAs = approvedAs
      instancePolicy = Command.currentPolicy() }


// Widening needs a person.
// Anything that lets code do more than it could before (a new allow rule, a deny taken away, an
// approval) is the person's to grant, at a terminal, by typing an answer. An agent's shell, a pipe
// and CI have no terminal, so there the command refuses and names what a person should run.
// `--yes` does not stand in for that answer. Narrowing never asks.

/// Whether a person can answer here: stdin, stdout and stderr are terminals, and nothing says
/// nobody is at them (CI, DARK_NO_INPUT, --no-input).
let personAtTerminal(): Bool =
  Stdlib.Cli.UI.Prompt.canAsk() && Stdlib.Cli.Sys.isTerminal(1)

/// The scripted-setup escape: the process was started with DARK_GRANTS_WITHOUT_A_PERSON=1. Read
/// once at startup, by the host, so nothing a run does can turn it on.
let grantsWithoutAPerson(): Bool =
  Builtin.pmPolicyGrantsWithoutAPerson()

type Consent =
  /// A person typed yes, or the process was started with the scripted-setup escape.
  | Given
  /// A person answered, and the answer was not yes.
  | Declined
  /// Nobody is at a terminal to ask.
  | NobodyToAsk

/// Ask the person at the terminal to confirm a widening change.
let consent(question: String): Command.Consent =
  if Command.grantsWithoutAPerson() then Command.Consent.Given
  else if Command.personAtTerminal() then
    if Stdlib.Cli.UI.Prompt.confirm(question) then Command.Consent.Given
    else Command.Consent.Declined
  else
    Command.Consent.NobodyToAsk

/// Say why a widening <param command> did nothing with nobody at a terminal, and what to run.
let refuseWithoutAPerson(command: String, yesGiven: Bool): Unit =
  Cli.printErr(
    "this widens what code may do, so a person has to confirm it at a terminal, and nobody can answer here (stdin, stdout or stderr isn't a terminal, or CI, DARK_NO_INPUT or --no-input is set). Nothing changed.")
  if yesGiven then
    Cli.Stderr.line("--yes only skips questions for changes that narrow permissions.")
  else
    ()
  Cli.Stderr.hint($"A person should run this in their own terminal: dark permissions {command}")

/// Whether <param next> could let through anything <param current> refuses: an allow rule it did
/// not have, or a deny rule it had and dropped while it still allows something. Judged by the
/// rules as written, so a rewrite that changes nothing in effect may still count as widening and
/// ask; a policy that allows nothing never widens.
let widens(
  current: LanguageTools.Permissions.Policy,
  next: LanguageTools.Permissions.Policy)
  : Bool =
  let added =
    next.allow
    |> Stdlib.List.any(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(current.allow, rule)))
  let dropped =
    current.deny
    |> Stdlib.List.any(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(next.deny, rule)))
  added || (dropped && Stdlib.Bool.not(Stdlib.List.isEmpty(next.allow)))

/// What <param next> grants that <param current> did not, one line each, for the question.
let wideningLines(
  current: LanguageTools.Permissions.Policy,
  next: LanguageTools.Permissions.Policy)
  : List<String> =
  let added =
    next.allow
    |> Stdlib.List.filter(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(current.allow, rule)))
    |> Stdlib.List.map(fun rule -> "  allow " + LanguageTools.Permissions.renderRule(rule))
  let dropped =
    current.deny
    |> Stdlib.List.filter(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(next.deny, rule)))
    |> Stdlib.List.map(fun rule -> "  no longer deny " + LanguageTools.Permissions.renderRule(rule))
  Stdlib.List.concat(added, dropped)

/// The instance policy after a `Change` edit, as the host applies it: removals first, then the
/// additions.
let afterChange(
  current: LanguageTools.Permissions.Policy,
  allow: List<LanguageTools.Permissions.Rule>,
  deny: List<LanguageTools.Permissions.Rule>,
  remove: List<LanguageTools.Permissions.Rule>)
  : LanguageTools.Permissions.Policy =
  let keep(rule: LanguageTools.Permissions.Rule): Bool =
    Stdlib.Bool.not(Stdlib.List.contains(remove, rule))
  LanguageTools.Permissions.Policy
    { allow = Stdlib.List.concat(current.allow |> Stdlib.List.filter(keep), allow)
      deny = Stdlib.List.concat(current.deny |> Stdlib.List.filter(keep), deny) }

/// The instance policy <param edit> leaves behind.
let afterEdit(
  current: LanguageTools.Permissions.Policy,
  edit: LanguageTools.Permissions.PolicyEdit)
  : LanguageTools.Permissions.Policy =
  match edit with
  | Replace(policy) -> policy
  | Change(allow, deny, remove) -> Command.afterChange(current, allow, deny, remove)

let applyEdit(edit: LanguageTools.Permissions.PolicyEdit, success: String): Bool =
  Command.changePolicy(edit)
  Stdlib.printLine(Stdlib.Cli.UI.Colors.success(success))
  true

/// Make an instance-policy change: at once when it only narrows, after a person confirms it when it
/// widens. True unless it was refused; declining at the question is an answer, not a failure.
/// <param command> is the `permissions` command a person would run, for the refusal.
let editInstanceAsked(
  command: String,
  yesGiven: Bool,
  edit: LanguageTools.Permissions.PolicyEdit,
  success: String)
  : Bool =
  let current = Command.currentPolicy()
  let next = Command.afterEdit(current, edit)
  if Stdlib.Bool.not(Command.widens(current, next)) then
    Command.applyEdit(edit, success)
  else
    Stdlib.printErrorLine("This widens the instance policy:")
    Command.wideningLines(current, next) |> Stdlib.List.iter(fun l -> Stdlib.printErrorLine(l))
    match Command.consent("Allow this for every run on this instance?") with
    | Given -> Command.applyEdit(edit, success)
    | Declined ->
      Stdlib.printLine("policy unchanged")
      true
    | NobodyToAsk ->
      Command.refuseWithoutAPerson(command, yesGiven)
      false


// Instance policy edits.

let invalidRule(args: List<String>): String =
  "invalid permission rule: " + Stdlib.String.join(args, " ")

/// External shells have already grouped quoted arguments, while the
/// interactive CLI's general command splitter leaves quote fragments in the
/// list. Re-tokenize only the latter; direct argv remains lossless for an
/// argument that itself contains spaces.
let parseRuleArgs(
  args: List<String>)
  : Stdlib.Option.Option<List<LanguageTools.Permissions.Rule>> =
  let hasQuotedFragment =
    args
    |> Stdlib.List.any(fun arg ->
      Stdlib.String.startsWith(arg, "'") || Stdlib.String.startsWith(arg, "\""))
  if hasQuotedFragment then
    LanguageTools.Permissions.parseRuleText(Stdlib.String.join(args, " "))
  else
    LanguageTools.Permissions.parseRule(args)

/// Replace the instance policy and report, asking first when that widens it. <param edit> returns
/// the next policy, or the message for input that did not parse. <param command> is the command
/// as a person would type it, for a refusal.
let editPolicy(
  command: String,
  edit: LanguageTools.Permissions.Policy -> Stdlib.Result.Result<LanguageTools.Permissions.Policy, String>,
  success: String)
  : Bool =
  match edit(Command.currentPolicy()) with
  | Ok(next) ->
    Command.editInstanceAsked(
      command,
      false,
      LanguageTools.Permissions.PolicyEdit.Replace(next),
      success)
  | Error(message) ->
    Cli.printErr(message)
    false

/// Parse rule arguments and make the edit <param edit> builds from them, asking first when it
/// widens the policy; or report invalid input.
let editRules(
  command: String,
  args: List<String>,
  edit: List<LanguageTools.Permissions.Rule> -> LanguageTools.Permissions.PolicyEdit,
  success: String)
  : Bool =
  match Command.parseRuleArgs(args) with
  | None ->
    Cli.printErr(Command.invalidRule(args))
    false
  | Some(rules) -> Command.editInstanceAsked(command, false, edit(rules), success)

/// One argument as a person would type it into a shell: quoted when it holds anything a shell
/// would read as more than text.
let shellWord(arg: String): String =
  let special =
    [ " ", "'", "\"", "*", "?", "$", "&", ";", "|", "<", ">", "(", ")", "`", "\\", "!", "#", "~", "{", "}", "[", "]" ]
  if arg != "" && Stdlib.Bool.not(special |> Stdlib.List.any(fun c -> Stdlib.String.contains(arg, c))) then
    arg
  else
    LanguageTools.Permissions.quoteToken(arg)

/// A `permissions` subcommand and its arguments, as a person would type them.
let commandText(args: List<String>): String =
  args |> Stdlib.List.map(Command.shellWord) |> Stdlib.String.join(" ")

/// `set a; deny b; c` replaces the whole policy.
let replacePolicy(
  specs: List<String>)
  : Stdlib.Result.Result<LanguageTools.Permissions.Policy, String> =
  let specs =
    (Stdlib.String.split(Stdlib.String.join(specs, " "), ";"))
    |> Stdlib.List.map(Stdlib.String.trim)
    |> Stdlib.List.filter(fun spec -> spec != "")
  match LanguageTools.Permissions.parse(specs) with
  | Ok(policy) -> Stdlib.Result.Result.Ok(policy)
  | Error(bad) -> Stdlib.Result.Result.Error($"invalid permission rule: {bad}")


// Named consumer approvals.
// The user-facing surface for account-scoped package approvals and version
// approvals (docs/effects.md). Hashes stay internal; output shows short version
// identifiers only.

/// Resolve a logical name to its latest published version on this branch.
let latestVersion(
  branchId: Uuid,
  name: String)
  : Stdlib.Option.Option<String> =
  let location = LanguageTools.ProgramTypes.parsePackageLocation(name)
  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | Some(hash) ->
    Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(hash))
  | None -> Stdlib.Option.Option.None

/// The version this account has APPROVED for <param name>, if any.
let approvedVersionOf(
  accountID: Stdlib.Option.Option<Uuid>,
  name: String)
  : Stdlib.Option.Option<String> =
  (Command.approvedVersions(accountID))
  |> Stdlib.List.findFirst(fun pair ->
    let (approvedName, _hash) = pair in approvedName == name)
  |> Stdlib.Option.map(fun pair -> let (_name, hash) = pair in hash)

/// `requirements`/`show` accept a logical name (resolved to its latest version)
/// or a raw hash for diagnostics.
let resolveVersionArg(
  state: Cli.AppState,
  arg: String)
  : Stdlib.Option.Option<String> =
  if Stdlib.String.contains(arg, ".") then
    Command.latestVersion(state.currentBranchId, arg)
  else
    // A raw hash must name a stored version; otherwise the analysis would
    // report an unknown version as merely "incomplete".
    match
      LanguageTools.PackageManager.Function.get(
        LanguageTools.ProgramTypes.Hash.Hash(arg))
    with
    | Some(_) -> Stdlib.Option.Option.Some(arg)
    | None -> Stdlib.Option.Option.None

/// Print a version's requirements, warning when analysis is incomplete.
/// Returns completeness so callers can acknowledge a possibly short list.
let showVersionRequirements(heading: String, hash: String): Bool =
  let requirements = Command.permissionRequirementsForHash(hash)
  let (_effects, complete) = requirements
  Stdlib.printLine(heading)
  Stdlib.printLine(
    $"  permission requirements: {Command.describeRequirements(requirements)}")
  if Stdlib.Bool.not(complete) then
    Stdlib.printErrorLine(
      (Stdlib.Cli.UI.Colors.warning(
        "  some calls in this function could not be followed (a callback, a package value, or an implementation picked at run time), so the list above may be short. The instance and run policies still bound whatever it does.")))
  else
    ()
  complete

/// Take `--yes`/`-y` out of the arguments, reporting whether it was there.
///
/// It is stripped before the rules are parsed, so it is never mistaken for a permission rule. It
/// applies a profile, but never answers for a person: a widening change still asks.
let takeYesFlag(args: List<String>): (Bool * List<String>) =
  let isYesFlag(a: String): Bool = (a == "--yes") || (a == "-y")
  let yes = args |> Stdlib.List.any(isYesFlag)
  let rest = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(isYesFlag(a)))
  (yes, rest)

/// Show the full replacement before any write. Previewing never prompts or
/// edits policy; --yes applies it the way `permissions set` would, so a profile
/// that widens the policy still needs a person to confirm it.
let profile(args: List<String>): Bool =
  match args with
  | [] ->
    Stdlib.printLines(Profiles.listing)
    true
  | _ ->
    match Command.takeYesFlag(args) with
    | (_, []) ->
      Cli.printErr("profile needs a name")
      false
    | (apply, [name, ...rest]) ->
      match Profiles.resolve(name, rest) with
      | Error(message) ->
        Cli.printErr(message)
        false
      | Ok(policy) ->
        Stdlib.printLine(
          $"Profile {name} replaces the entire instance policy, including denies:")
        Stdlib.printLines(Command.indentedPolicyLines(policy))
        if apply then
          Command.editInstanceAsked(
            Command.commandText(Stdlib.List.concat([ "profile", name ], Stdlib.List.concat(rest, [ "--yes" ]))),
            true,
            LanguageTools.Permissions.PolicyEdit.Replace(policy),
            $"✓ applied profile {name}")
        else
          Cli.Stderr.hint("Preview only. Repeat with --yes to apply.")
          true

/// The rules given after a name on `approve`/`update`, `;`-separated like
/// `set`. Ok None when there are none.
let parseApprovalRules(
  specs: List<String>)
  : Stdlib.Result.Result<Stdlib.Option.Option<LanguageTools.Permissions.Policy>, String> =
  if Stdlib.List.isEmpty(specs) then Stdlib.Result.Result.Ok(Stdlib.Option.Option.None)
  else
    match Command.replacePolicy(specs) with
    | Ok(policy) -> Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some(policy))
    | Error(message) -> Stdlib.Result.Result.Error(message)

/// Lines describing the policy a version is approved under, for the prompt.
let describeApprovalRules(
  rules: Stdlib.Option.Option<LanguageTools.Permissions.Policy>)
  : List<String> =
  match rules with
  | None -> []
  | Some(policy) ->
    Stdlib.List.prepend(
      Command.indentedPolicyLines(policy),
      "  approved under these rules (the package and everything it calls):")

let approvalFailureText(failure: LanguageTools.Permissions.ApprovalFailure): String =
  match failure with
  | Refused(message) -> Stdlib.Cli.UI.Colors.error(message)
  | ContractChanged(diffs) ->
    Stdlib.Cli.UI.Colors.warning(
      ("the permission contract changed — review required:\n"
       + (diffs |> Stdlib.List.map(fun diff -> $"    {diff}") |> Stdlib.String.join("\n"))))

/// Approve <param hash> for <param name> and report: <param accepted> on success, the refusal (then
/// <param kept>) when it cannot be approved. Answers whether it approved, and Some diffs when
/// approving wants a second review of a changed contract and <param acknowledgeContractChange> was
/// false; the caller shows them and asks.
let approveReporting(
  accountID: Stdlib.Option.Option<Uuid>,
  name: String,
  hash: String,
  rules: Stdlib.Option.Option<LanguageTools.Permissions.Policy>,
  acknowledgeIncomplete: Bool,
  acknowledgeContractChange: Bool,
  accepted: String,
  kept: String)
  : (Bool * Stdlib.Option.Option<List<String>>) =
  match
    Command.approveVersionFor(
      accountID,
      name,
      hash,
      rules,
      acknowledgeIncomplete,
      acknowledgeContractChange)
  with
  | Ok(_) ->
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(accepted))
    (true, Stdlib.Option.Option.None)
  | Error(Refused(message)) ->
    Cli.printErr(message)
    if kept != "" then Cli.Stderr.line(kept) else ()
    (false, Stdlib.Option.Option.None)
  | Error(ContractChanged(diffs)) -> (false, Stdlib.Option.Option.Some(diffs))

/// Approve the latest version of <param name>, once a person at the terminal says yes. With nobody
/// there it refuses: an approval widens what the name may do, so running the command is not
/// consent by itself, and neither is `--yes` (<param yesGiven>).
let approveNamed(
  state: Cli.AppState,
  yesGiven: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  match Command.parseApprovalRules(specs) with
  | Error(message) ->
    Cli.printErr(message)
    false
  | Ok(rules) ->
    match Command.latestVersion(state.currentBranchId, name) with
    | None ->
      Cli.printErr($"unknown function: {name}")
      false
    | Some(hash) ->
      let complete =
        Command.showVersionRequirements($"{name} {Command.shortVersion(hash)}", hash)
      Stdlib.printLines(Command.describeApprovalRules(rules))
      match Command.consent("Approve this version, so the name resolves to it?") with
      | Given ->
        // An explicit `permissions approve <name>` showed the requirements and
        // named this exact version; that is the contract review, so a changed
        // contract is acknowledged up front and no second review can be asked.
        let (approved, _diffs) =
          Command.approveReporting(
            state.accountID,
            name,
            hash,
            rules,
            Stdlib.Bool.not(complete),
            true,
            $"✓ approved {name} {Command.shortVersion(hash)}; the name follows this version",
            "")
        approved
      | Declined ->
        // Declining at the prompt is an answer, not a failure.
        Stdlib.printLine("not approved")
        true
      | NobodyToAsk ->
        Command.refuseWithoutAPerson(
          Command.commandText(Stdlib.List.concat([ "approve", name ], specs)),
          yesGiven)
        false

/// Review a newer version: only a person's typed yes accepts it; otherwise the approved version
/// stands. A changed contract requires a second confirmation. With nobody at a terminal it refuses,
/// `--yes` (<param yesGiven>) or not.
let updateNamed(
  state: Cli.AppState,
  yesGiven: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  let accountID = state.accountID
  match Command.parseApprovalRules(specs) with
  | Error(message) ->
    Cli.printErr(message)
    false
  | Ok(givenRules) ->
    match Command.approvedVersionOf(accountID, name) with
    | None ->
      Cli.printErr($"{name} has no approved version; run `permissions approve {name}` first")
      false
    | Some(approved) ->
      match Command.latestVersion(state.currentBranchId, name) with
      | None ->
        Cli.printErr($"unknown function: {name}")
        false
      | Some(latest) ->
        if latest == approved then
          Stdlib.printLine($"{name} is up to date ({Command.shortVersion(approved)})")
          true
        else
          // Rules given now win; otherwise the rules the consumer wrote when
          // approving carry over, and a derived effect set is recomputed from
          // the new version. Provenance is stored with the approval, so an
          // explicit `clock` is never mistaken for a derived one.
          let rules =
            match givenRules with
            | Some(_) -> givenRules
            | None -> Command.explicitApprovalFor(accountID, approved)
          let complete =
            Command.showVersionRequirements(
              $"{name}: {Command.shortVersion(approved)} → {Command.shortVersion(latest)}",
              latest)
          Stdlib.printLines(Command.describeApprovalRules(rules))
          let acknowledgeIncomplete = Stdlib.Bool.not(complete)
          let kept = $"keeping {Command.shortVersion(approved)}"
          let accepted = $"✓ {name} now follows {Command.shortVersion(latest)}"
          let approve(
            acknowledgeContractChange: Bool)
            : (Bool * Stdlib.Option.Option<List<String>>) =
            Command.approveReporting(
              accountID,
              name,
              latest,
              rules,
              acknowledgeIncomplete,
              acknowledgeContractChange,
              accepted,
              kept)
          let command = Command.commandText(Stdlib.List.concat([ "update", name ], specs))
          match Command.consent("Accept the new version?") with
          | NobodyToAsk ->
            Command.refuseWithoutAPerson(command, yesGiven)
            Cli.Stderr.line(kept)
            false
          | Declined ->
            // Declining is an answer: the approved version stands, as asked.
            Stdlib.printLine(kept)
            true
          | Given ->
            let (approvedFirst, review) = approve(false)
            match review with
            | None -> approvedFirst
            | Some(diffs) ->
              // What the next question asks about, so on stderr with the question.
              Stdlib.printErrorLine(
                (Command.approvalFailureText(
                  LanguageTools.Permissions.ApprovalFailure.ContractChanged(diffs))))
              // The differences were shown; accepting them is the review.
              match
                Command.consent("Accept the new version and its changed permission contract?")
              with
              | Given ->
                let (approvedSecond, _review) = approve(true)
                approvedSecond
              | Declined ->
                Stdlib.printLine(kept)
                true
              | NobodyToAsk ->
                Command.refuseWithoutAPerson(command, yesGiven)
                Cli.Stderr.line(kept)
                false

/// Run <param show> against the version <param target> names, or report an
/// unknown function.
let withVersion(
  state: Cli.AppState,
  target: String,
  show: String -> List<String>)
  : Bool =
  match Command.resolveVersionArg(state, target) with
  | None ->
    Cli.printErr($"unknown function: {target}")
    false
  | Some(hash) ->
    Stdlib.printLines(show(hash))
    true

let printListOrNone(items: List<String>): Unit =
  if Stdlib.List.isEmpty(items) then Stdlib.printLine("none")
  else Stdlib.printLines(items)


/// Every subcommand with the usage it prints when its argument is missing;
/// None for the ones that take no argument. Drives `execute`'s
/// missing-argument arm and `complete`.
val subcommands =
  [ ("list", Stdlib.Option.Option.None)
    ("profile", Stdlib.Option.Option.None)
    ("allow", Stdlib.Option.Option.Some("allow <rule>"))
    ("deny", Stdlib.Option.Option.Some("deny <rule>"))
    ("remove", Stdlib.Option.Option.Some("remove <rule>"))
    // `set` with nothing would otherwise replace the policy with deny-all;
    // that is what `clear` is for.
    ("set", Stdlib.Option.Option.Some("set <rule>;… (or `clear`)"))
    ("clear", Stdlib.Option.Option.None)
    ("approve", Stdlib.Option.Option.Some("approve <fn> [rule,…]"))
    ("update", Stdlib.Option.Option.Some("update <fn> [rule,…]"))
    ("unapprove", Stdlib.Option.Option.Some("unapprove <fn>"))
    ("approved", Stdlib.Option.Option.None)
    ("requirements", Stdlib.Option.Option.Some("requirements <fn|hash>"))
    ("show", Stdlib.Option.Option.Some("show <fn|hash>"))
    ("approvals", Stdlib.Option.Option.None)
    ("revoke-package", Stdlib.Option.Option.Some("revoke-package <hash>")) ]

/// The usage line for a subcommand given without its argument, if it needs one.
let usageOf(subcommand: String): Stdlib.Option.Option<String> =
  Command.subcommands
  |> Stdlib.List.findFirst(fun((name, _usage)) -> name == subcommand)
  |> Stdlib.Option.andThen(fun((_name, usage)) -> usage)

let execute(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | []
  | [ "list" ] ->
    Stdlib.printLines(Command.instancePolicyLines())
    state
  | [ "help" ] ->
    Stdlib.printLine(Command.help(state))
    state
  | ["profile", ...args] -> Cli.exitWith(state, Command.profile(args))
  // Before the `[<subcommand>, ...args]` arms: a subcommand given with no
  // argument must report usage, not run with an empty argument list (`set`
  // with nothing would replace the policy with deny-all).
  | [ subcommand ] when Stdlib.Option.isSome(Command.usageOf(subcommand)) ->
    let usage = Stdlib.Option.withDefault(Command.usageOf(subcommand), "")
    Cli.printErr($"missing argument; usage: permissions {usage}")
    Cli.failed(state)
  // `allow` always widens and `deny` never does; `remove` widens when it drops a deny, and `set`
  // when the new policy allows something the old one did not or drops a deny.
  | ["allow", ...rule] ->
    Cli.exitWith(state, (Command.editRules(
      Command.commandText(Stdlib.List.prepend(rule, "allow")),
      rule,
      (fun rules -> LanguageTools.Permissions.PolicyEdit.Change(rules, [], [])),
      "✓ policy updated")))
  | ["deny", ...rule] ->
    Cli.exitWith(state, (Command.editRules(
      Command.commandText(Stdlib.List.prepend(rule, "deny")),
      rule,
      (fun rules -> LanguageTools.Permissions.PolicyEdit.Change([], rules, [])),
      "✓ policy updated")))
  | ["remove", ...rule] ->
    Cli.exitWith(state, (Command.editRules(
      Command.commandText(Stdlib.List.prepend(rule, "remove")),
      rule,
      (fun rules -> LanguageTools.Permissions.PolicyEdit.Change([], [], rules)),
      "✓ rule removed")))
  | [ "clear" ] ->
    Cli.exitWith(state, (Command.editPolicy(
      "clear",
      (fun _ -> Stdlib.Result.Result.Ok(LanguageTools.Permissions.empty())),
      "✓ policy is now deny-all")))
  | ["set", ...specs] ->
    Cli.exitWith(state, (Command.editPolicy(
      "set " + LanguageTools.Permissions.quoteToken(Stdlib.String.join(specs, " ")),
      (fun _ -> Command.replacePolicy(specs)),
      "✓ policy replaced")))
  | ["approve", ...rest] ->
    match Command.takeYesFlag(rest) with
    | (yesGiven, [name, ...rules]) ->
      Cli.exitWith(state, Command.approveNamed(state, yesGiven, name, rules))
    | (_, []) ->
      Cli.printErr("approve needs a function name")
      Cli.failed(state)
  | ["update", ...rest] ->
    match Command.takeYesFlag(rest) with
    | (yesGiven, [name, ...rules]) ->
      Cli.exitWith(state, Command.updateNamed(state, yesGiven, name, rules))
    | (_, []) ->
      Cli.printErr("update needs a function name")
      Cli.failed(state)
  | [ "unapprove", name ] ->
    // An approval is keyed by the name as it was approved, so an unmatched name withdraws nothing;
    // say so rather than report a release that did not happen.
    let approvedNames =
      Command.approvedVersions(state.accountID)
      |> Stdlib.List.map(fun pair -> let (approvedName, _hash) = pair in approvedName)
    if Stdlib.List.contains(approvedNames, name) then
      Command.unapproveVersionFor(state.accountID, name)
      Stdlib.printLine(
        (Stdlib.Cli.UI.Colors.success(
          $"✓ {name} has no approved version; it follows the latest again")))
      state
    else
      Cli.printErr($"{name} has no approved version; `permissions approved` lists the ones that do")
      Cli.failed(state)
  | [ "approved" ] ->
    Command.printListOrNone(
      ((Command.approvedVersions(state.accountID))
       |> Stdlib.List.map(fun pair ->
         let (name, hash) = pair in $"{name}  {Command.shortVersion(hash)}")))
    state
  | [ "requirements", target ] ->
    Cli.exitWith(state, (Command.withVersion(state, target, fun hash ->
      [ Command.requirementDisplay(hash) ])))
  | [ "show", target ] ->
    Cli.exitWith(state, (Command.withVersion(state, target, fun hash ->
      Command.accessReportLines(state.accountID, hash))))
  | [ "revoke-package", hash ] ->
    // A hash that was never approved revokes nothing; say so rather than report a revoke.
    if Stdlib.List.contains(Command.approvedHashes(state.accountID), hash) then
      Command.revokeHash(state.accountID, hash)
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success("✓ package approval revoked"))
      state
    else
      Cli.printErr($"{hash} has no approval; `permissions approvals` lists the ones that do")
      Cli.failed(state)
  | [ "approvals" ] ->
    // Name the ones an approved version points at. The rest are dependencies approved as part of
    // some root's closure and have no name of their own, but a page of bare hashes gave no way to
    // tell those two apart.
    Command.printListOrNone(Command.namedApprovals(state.accountID, state.currentBranchId))
    if Command.approvalsStale() then
      Stdlib.printErrorLine(
        (Stdlib.Cli.UI.Colors.warning(
          "! approval analysis changed since these were approved; re-review with `permissions approve <fn>`")))
    else
      ()
    state
  | _ ->
    Cli.printErr("unknown permissions command: " + Stdlib.String.join(args, " "))
    Stdlib.printErrorLine(Command.help(state))
    Cli.failed(state)

let complete(
  _state: Cli.AppState,
  args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  match args with
  | [ "profile" ] ->
    Profiles.all |> Stdlib.List.map(fun profile -> Cli.Completion.simple(profile.name))
  // Wildcards, not `_root`: every branch of an or-pattern has to bind the same names, and the
  // first one binds nothing. Nothing here reads the root anyway.
  | [ "profile", "default" ]
  | [ "profile", "read-only", _ ]
  | [ "profile", "local-dev", _ ] -> [ Cli.Completion.simple("--yes") ]
  | ["profile", ...] -> []
  | _ ->
    Command.subcommands
    |> Stdlib.List.map(fun((name, _usage)) -> Cli.Completion.simple(name))

let help(_state: Cli.AppState): String =
  [ "Usage: permissions [list] | allow <rule> | deny <rule> | remove <rule>"
    "                   | set <rule>;… | clear"
    "                   | profile [name [ABSOLUTE-ROOT] [--yes]]"
    "                   | approve <fn> [rule,…] | update <fn> [rule,…] | unapprove <fn>"
    "                   | approved"
    "                   | requirements <fn|hash> | show <fn|hash>"
    "                   | approvals | revoke-package <hash>"
    ""
    "The instance policy is local and deny-by-default. Every actual host operation"
    "must be allowed by the instance, run and package layers."
    ""
    "A change that widens permissions (allow, approve, update, and a set, remove or"
    "profile that allows more or drops a deny) asks the person at the terminal, and"
    "refuses when nobody is there. --yes does not answer it. Narrowing never asks."
    ""
    "Profiles:"
    "  profile                         list the available presets"
    "  profile default                 preview the installation default"
    "  profile read-only <ROOT>        directory/store reads and HTTPS GET"
    "  profile local-dev <ROOT>        directory/store writes and HTTP serving too"
    "  Add --yes to apply; one that widens the policy still asks. Replaces the"
    "  entire instance policy, including denies."
    "  ROOT must be absolute; no process, native or environment access is granted."
    "  HTTPS GET permits any host on port 443; HTTP serving permits any port."
    ""
    "Named approvals:"
    "  approve <fn>   review the latest version's permission requirements and approve it, so"
    "                 the name resolves to that exact version until you review a newer"
    "                 one. Rules after the name confine the function and everything it"
    "                 calls to those resources, e.g."
    "                 approve MyApp.fetch http GET 'https://api.example.com'"
    "  update <fn>    review a newer version: y accepts, anything else keeps the approved"
    "                 one; a changed permission contract asks again. Rules given on"
    "                 approve carry over unless new ones are given"
    "  unapprove <fn> withdraw the approval; the name follows the latest version again"
    "  approved       the names with an approved version, and which version"
    "  approvals      the approved versions (hashes); revoke-package drops one and"
    "                 the dependencies nothing else needs"
    ""
    "Rules:"
    "  <effect>                         e.g. clock, random, stdout, http, process,"
    "                                   package-read, trace-write (all of an effect)"
    "  http <METHOD> [URL]              exact URL or explicit *"
    "  http-server <PORT|*>"
    "  file read|write|read+write [ROOT]"
    "  env read|write|read+write [NAME]"
    "  process <ABSOLUTE-EXECUTABLE|*> [ARG…]"
    "  native                           builtins that can reach anything (raw descriptors,"
    "                                   process handles); no narrower form exists"
    "  all"
    "  deny <rule> (in `set`)           an explicit deny; deny beats allow" ]
  |> Stdlib.String.join("\n")
