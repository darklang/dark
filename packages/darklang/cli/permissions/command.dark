module Darklang.Cli.Permissions.Command

type AccessReportFacts =
  { hash: String
    effects: List<LanguageTools.Permissions.Effect>
    complete: Bool
    bundled: Bool
    approvals: List<(String * LanguageTools.Permissions.Policy)>
    approvedAs: List<String>
    /// The version an approval under this name is for, when that is another version.
    olderApproval: Option<String>
    instancePolicy: LanguageTools.Permissions.Policy }


// Builtin wrappers.
// The policy builtins are called only from these wrappers (tests/builtin).

let currentPolicy(): LanguageTools.Permissions.Policy =
  Builtin.pmPolicyGetInstance()


/// Read the instance rules and a token used to detect changes before saving.
let instanceSnapshot(): (String * LanguageTools.Permissions.Policy) =
  Builtin.pmPolicyReviewToken()


/// Save only if permissions have not changed since this token was read.
let commitInstancePolicy(expected: String, policy: LanguageTools.Permissions.Policy): Unit =
  Builtin.pmPolicyEditInstance(expected, policy)


/// Move a policy file this build can't read out of the way, and return where it went.
let setAsideUnsupportedPolicy(): Option<String> =
  Builtin.pmPolicySetAsideUnsupported()


/// Normalize file paths before comparing rules, including relative paths and `~`.
/// Use the same host normalization as saving a rule.
let canonicalRule(rule: LanguageTools.Permissions.Rule): LanguageTools.Permissions.Rule =
  match rule with
  | FileRead(_) | FileWrite(_) -> Builtin.pmPolicyNormalizeRule(rule)
  | _ -> rule


/// Apply removals before additions, preserving rule order and eliminating duplicates.
let applyInstanceEdit(
  policy: LanguageTools.Permissions.Policy,
  allow: List<LanguageTools.Permissions.Rule>,
  deny: List<LanguageTools.Permissions.Rule>,
  remove: List<LanguageTools.Permissions.Rule>)
  : LanguageTools.Permissions.Policy =
  let keep(rule: LanguageTools.Permissions.Rule): Bool =
    Stdlib.Bool.not(Stdlib.List.contains(remove, rule))

  { policy with
      allow = Stdlib.List.unique(Stdlib.List.concat(Stdlib.List.filter(policy.allow, keep), allow))
      deny = Stdlib.List.unique(Stdlib.List.concat(Stdlib.List.filter(policy.deny, keep), deny)) }


/// Read the instance rules, apply the edit, and save if permissions are still unchanged.
let editInstancePolicy(
  allow: List<LanguageTools.Permissions.Rule>,
  deny: List<LanguageTools.Permissions.Rule>,
  remove: List<LanguageTools.Permissions.Rule>)
  : Unit =
  let (expected, policy) = instanceSnapshot()
  let remove = Stdlib.List.map(remove, canonicalRule)
  commitInstancePolicy(expected, applyInstanceEdit(policy, allow, deny, remove))


/// The effects a policy decides on: all but `Raise` and `Concurrency`, which no rule grants or denies.
let permissionEffects(
  effects: List<LanguageTools.Permissions.Effect>)
  : List<LanguageTools.Permissions.Effect> =
  effects
  |> Stdlib.List.filter(fun e ->
    e != LanguageTools.Permissions.Effect.Raise
    && e != LanguageTools.Permissions.Effect.Concurrency)


/// The transitive permission requirements and whether analysis was complete.
/// Incomplete analysis returns the effects found with `false`; fetch once and
/// pass the result around because this walks the function's closure.
let permissionRequirementsForHash(hash: String): (List<LanguageTools.Permissions.Effect> * Bool) =
  let (effects, complete) = Builtin.pmFnPermissionRequirements(hash)
  (permissionEffects(effects), complete)


/// Remove named approvals or commit the saved policy calculated by this command.
let removeSavedAccess(
  accountID: Option<Uuid>,
  target: LanguageTools.Permissions.ApprovalTarget)
  : Unit =
  Builtin.pmPolicyRemove(accountID, target)


/// Read this account's approvals and a token used to detect changes before saving.
let approvalSnapshot(accountID: Option<Uuid>): (String * List<LanguageTools.Permissions.Approval>) =
  Builtin.pmPolicyApprovals(accountID)


let approvalNamesForHash(
  approvals: List<LanguageTools.Permissions.Approval>,
  hash: String)
  : List<String> =
  approvals
  |> Stdlib.List.filter(fun approval -> approval.hash == hash)
  |> Stdlib.List.filterMap(fun approval -> approval.name)


let versionsFromApprovals(
  approvals: List<LanguageTools.Permissions.Approval>)
  : List<(String * String)> =
  approvals
  |> Stdlib.List.filterMap(fun approval ->
    approval.name |> Stdlib.Option.map(fun name -> (name, approval.hash)))


/// Return all approvals, or filter by hash.
/// If the hash has no approvals, return an entry with no name or policy.
let approvalsMatching(
  approvals: List<LanguageTools.Permissions.Approval>,
  hash: Option<String>)
  : List<LanguageTools.Permissions.Approval> =
  match hash with
  | None -> approvals
  | Some(hash) ->
    let matching = Stdlib.List.filter(approvals, fun approval -> approval.hash == hash)
    if Stdlib.List.isEmpty(matching) then
      [ LanguageTools.Permissions.Approval
          { hash = hash, name = Option.None, policy = Option.None, explicitRules = Option.None } ]
    else
      matching


/// Remove every approval for this hash together, if permissions are still unchanged.
let revokeHash(accountID: Option<Uuid>, hash: String): Bool =
  let (expected, approvals) = approvalSnapshot(accountID)
  let names = approvalNamesForHash(approvals, hash)
  if Stdlib.List.isEmpty(names) then
    printErr($"{hash} has no approval; `permissions approvals` lists the ones that do")
    false
  else
    removeSavedAccess(accountID, LanguageTools.Permissions.ApprovalTarget.Names(expected, names))
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success("✓ package approval revoked"))
    true


let approvedHashes(accountID: Option<Uuid>): List<String> =
  let (_, approvals) = approvalSnapshot(accountID)
  versionsFromApprovals(approvals)
  |> Stdlib.List.map(Stdlib.Tuple2.second)
  |> Stdlib.List.unique


let packageAccessFor(
  named: List<LanguageTools.Permissions.Approval>,
  hash: String)
  : (Bool * List<(String * LanguageTools.Permissions.Policy)>) =
  let approvals =
    approvalsMatching(named, Option.Some(hash))
    |> Stdlib.List.filterMap(fun approval ->
      match approval.name, approval.policy with
      | Some(name), Some(policy) -> Option.Some((name, policy))
      | _ -> Option.None)

  (Builtin.pmFnIsBundled(hash), approvals)


/// Return whether code is bundled, plus the named approvals for its hash.
let packageAccess(
  accountID: Option<Uuid>,
  hash: String)
  : (Bool * List<(String * LanguageTools.Permissions.Policy)>) =
  let (_, approvals) = approvalSnapshot(accountID)
  packageAccessFor(approvals, hash)


/// The rules the consumer wrote when approving <param hash> as a root; None
/// for a derived approval.
let explicitApprovalFor(
  accountID: Option<Uuid>,
  name: String)
  : Option<LanguageTools.Permissions.Policy> =
  approvalsOf(accountID, Option.None)
  |> Stdlib.List.filter(fun a -> a.name == Option.Some(name))
  |> Stdlib.List.head
  |> Stdlib.Option.andThen(fun approval -> approval.explicitRules)


/// Whether existing approvals were recorded under different approval-analysis
/// semantics than this host's — a re-review signal (enforcement stays
/// fail-closed regardless).
let approvalsStale(): Bool =
  Builtin.pmPolicyApprovalsStale()


/// Every (logical name, approved version) pair for this account.
let approvedVersions(accountID: Option<Uuid>): List<(String * String)> =
  let (_, approvals) = approvalSnapshot(accountID)
  versionsFromApprovals(approvals)


/// Approvals as this account sees them, one per (hash, name). With <param hash>, the entries for
/// that hash (one with no name when no name points at it); with None, one per approved name.
let approvalsOf(
  accountID: Option<Uuid>,
  hash: Option<String>)
  : List<LanguageTools.Permissions.Approval> =
  let (_, approvals) = approvalSnapshot(accountID)
  approvalsMatching(approvals, hash)


/// Each named approval, including separate names with identical code, marking
/// the ones whose function has changed since.
let namedApprovals(accountID: Option<Uuid>, branchId: Uuid): List<String> =
  approvedVersions(accountID)
  |> Stdlib.List.map(fun((name, hash)) ->
    let older =
      match latestVersion(branchId, name) with
      | Some(latest) when latest != hash -> ", for an older version"
      | _ -> ""

    $"  {name}  (version {shortVersion(hash)}{older})")


/// Capture before showing a review; mutations compare it atomically when saving.
let reviewToken(): String =
  let (expected, _) = instanceSnapshot()
  expected


/// Whether approving goes ahead when the shown requirements are incomplete.
type Incomplete =
  | Acknowledge
  | Refuse


/// Whether approving goes ahead when the permission contract changed since the last approval,
/// or returns the differences without saving.
type ContractChange =
  | Acknowledge
  | Refuse


/// Remember access for an immutable closure under its logical name, atomically. The builtin
/// compares the contract before storing approval; a changed contract returns diffs for explicit
/// review. `rules` optionally narrows the consumer's policy; None approves the analyzed effect set.
let approveVersionFor(
  accountID: Option<Uuid>,
  name: String,
  expected: String,
  hash: String,
  rules: Option<LanguageTools.Permissions.Policy>,
  incomplete: Incomplete,
  contractChange: ContractChange)
  : Result<Unit, LanguageTools.Permissions.ApprovalFailure> =
  Builtin.pmPolicyApproveVersion(
    accountID,
    name,
    expected,
    hash,
    rules,
    incomplete == Incomplete.Acknowledge,
    contractChange == ContractChange.Acknowledge)


/// Check the proposed update without saving, so all changes are visible before confirmation.
let reviewVersionFor(
  accountID: Option<Uuid>,
  name: String,
  expected: String,
  hash: String,
  rules: Option<LanguageTools.Permissions.Policy>,
  incomplete: Incomplete)
  : Result<(Bool * List<LanguageTools.Permissions.ApprovalReviewReason>), String> =
  Builtin.pmPolicyReviewVersion(
    accountID,
    name,
    expected,
    hash,
    rules,
    incomplete == Incomplete.Acknowledge)


/// Remove a name's remembered access; name resolution is unchanged.
let removeNamedApprovalFor(accountID: Option<Uuid>, expected: String, name: String): Unit =
  removeSavedAccess(accountID, LanguageTools.Permissions.ApprovalTarget.Names(expected, [ name ]))


// Requirements display.

let shortVersion(hash: String): String =
  Stdlib.String.first(hash, 8)


let requirementSummary(requirements: List<LanguageTools.Permissions.Effect>): String =
  if Stdlib.List.isEmpty(requirements) then
    "effect-free"
  else
    Stdlib.String.join(requirements |> Stdlib.List.map(LanguageTools.Permissions.effectName), ", ")


/// One line for a `permissionRequirementsForHash` result. When the analysis
/// could not follow everything, the effects it did find are shown and the
/// remainder is called unknown. It does not say why: a callback, a package
/// value, and an implementation picked at run time all look the same here.
let describeRequirements(requirements: (List<LanguageTools.Permissions.Effect> * Bool)): String =
  match requirements with
  | effects, true -> requirementSummary(effects)
  | [], false -> "not fully known"
  | effects, false -> requirementSummary(effects) + ", possibly more"


let requirementDisplay(hash: String): String =
  describeRequirements(permissionRequirementsForHash(hash))


/// The bracketed requirements badge listings show next to a function,
/// e.g. `[file-read]`; callers colour it for their view.
let requirementBadge(hash: LanguageTools.ProgramTypes.Hash): String =
  "[" + requirementDisplay(LanguageTools.ProgramTypes.hashToString(hash)) + "]"


/// Effects describe the body; runtime permissions check the actual resources.
let policyLinesForHash(hash: String): List<String> =
  let requirementsLine = "permission requirements: " + requirementDisplay(hash)
  let (_, reasons) = Effects.reasons(hash)
  if
    Stdlib.List.any(reasons, fun((effect, _)) -> effect == LanguageTools.Permissions.Effect.Raise)
  then
    [ requirementsLine, "can raise a runtime error" ]
  else
    [ requirementsLine ]


/// Label grants and explicit blocks separately, including when either is empty.
let policyLines(policy: LanguageTools.Permissions.Policy): List<String> =
  let ruleLines(rules: List<LanguageTools.Permissions.Rule>): List<String> =
    if Stdlib.List.isEmpty(rules) then
      [ "  none" ]
    else
      rules |> Stdlib.List.map(fun rule -> "  " + LanguageTools.Permissions.renderRule(rule))

  Stdlib.List.flatten(
    [ [ "Allowed:" ], ruleLines(policy.allow), [ "Explicitly denied:" ], ruleLines(policy.deny) ])


/// The instance policy as `permissions list` prints it.
let instancePolicyLines(): List<String> =
  Stdlib.List.flatten(
    [ [ "Instance defaults:" ]
      policyLines(currentPolicy())
      [ "Unlisted access needs a remembered approval or --allow. Explicit denies win." ] ])


let indentedPolicyLines(policy: LanguageTools.Permissions.Policy): List<String> =
  policyLines(policy) |> Stdlib.List.map(fun line -> "    " + line)


/// Show only this function's effects and remembered approvals.
let renderAccessReport(name: String, facts: AccessReportFacts): List<String> =
  let effectFree = facts.complete && Stdlib.List.isEmpty(facts.effects)
  let effects =
    if effectFree then
      "none"
    else
      describeRequirements((facts.effects, facts.complete))

  let analysisLines =
    if facts.complete then
      []
    else
      [ "  Warning: analysis is incomplete; more permissions may be needed." ]

  let packageLines =
    if Stdlib.List.isEmpty(facts.approvals) then
      match facts.olderApproval with
      | Some(version) ->
        [ $"  Remembered approval: for an older version ({shortVersion(version)}); `permissions update {name}` reviews this one" ]
      | None -> [ "  Remembered approval: none" ]
    else
      facts.approvals
      |> Stdlib.List.map(fun((approvedName, policy)) ->
        Stdlib.List.prepend(
          indentedPolicyLines(policy),
          $"  Remembered approval for {approvedName} (version {shortVersion(facts.hash)}):"))
      |> Stdlib.List.flatten

  Stdlib.List.flatten(
    [ [ name, $"  Effects: {effects}" ]
      if effectFree then [ "  Permissions needed: none" ] else []
      analysisLines
      packageLines ])


/// Facts shared by the function report and workbench detail pane.
let accessFacts(accountID: Option<Uuid>, hash: String): AccessReportFacts =
  let (effects, complete) = permissionRequirementsForHash(hash)
  let (_, named) = approvalSnapshot(accountID)
  let (bundled, approvals) = packageAccessFor(named, hash)
  let approvedAs = approvalNamesForHash(named, hash)
  AccessReportFacts
    { hash = hash
      effects = effects
      complete = complete
      bundled = bundled
      approvals = approvals
      approvedAs = approvedAs
      olderApproval = Option.None
      instancePolicy = currentPolicy() }


// Instance policy edits.

let invalidRule(args: List<String>): String =
  invalidRuleText(Stdlib.String.join(args, " "))


/// The message for <param text> that did not parse, naming the current form of an old one.
let invalidRuleText(text: String): String =
  match Stdlib.String.split(Stdlib.String.trim(text), " ") with
  | ["http-server", port] when Stdlib.Result.isOk(Stdlib.Int64.parse(port)) ->
    $"invalid permission rule: {text}. http-server takes an address and a port, e.g. http-server 127.0.0.1 {port}"
  | _ -> $"invalid permission rule: {text}"


/// External shells have already grouped quoted arguments, while the
/// interactive CLI's general command splitter leaves quote fragments in the
/// list. Re-tokenize only the latter; direct argv remains lossless for an
/// argument that itself contains spaces.
let parseRuleArgs(args: List<String>): Option<List<LanguageTools.Permissions.Rule>> =
  let hasQuotedFragment =
    args
    |> Stdlib.List.any(fun arg ->
      Stdlib.String.startsWith(arg, "'") || Stdlib.String.startsWith(arg, "\""))

  if hasQuotedFragment then
    LanguageTools.Permissions.parseRuleText(Stdlib.String.join(args, " "))
  else
    LanguageTools.Permissions.parseRule(args)


/// Read-modify-write the instance policy and report. <param edit> returns the
/// next policy, or the message for input that did not parse.
let editPolicy(
  edit: LanguageTools.Permissions.Policy -> Result<LanguageTools.Permissions.Policy, String>,
  success: String)
  : Bool =
  let (expected, current) = instanceSnapshot()
  match edit(current) with
  | Ok(next) ->
    commitInstancePolicy(expected, next)
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(success))
    true
  | Error(message) ->
    printErr(message)
    false


/// One rule, or several separated by `;` like `set`. Error is the first rule that did not parse.
let parseRuleList(args: List<String>): Result<List<LanguageTools.Permissions.Rule>, String> =
  if Stdlib.List.any(args, fun arg -> Stdlib.String.contains(arg, ";")) then
    LanguageTools.Permissions.splitRuleSpecs(Stdlib.String.join(args, " "))
    |> Stdlib.List.fold(Result.Ok([]), fun(result, spec) ->
      match result with
      | Error(bad) -> Result.Error(bad)
      | Ok(rules) ->
        match LanguageTools.Permissions.parseRuleText(spec) with
        | Some(more) -> Result.Ok(Stdlib.List.concat(rules, more))
        | None -> Result.Error(spec))
  else
    let parsed =
      match args with
      | [spec] -> LanguageTools.Permissions.parseRuleText(spec)
      | _ -> parseRuleArgs(args)

    match parsed with
    | Some(rules) -> Result.Ok(rules)
    | None -> Result.Error(Stdlib.String.join(args, " "))


/// Parse rule arguments and pass them to <param edit>, or report invalid input. One rule that does
/// not parse saves none of them.
let editRules(
  args: List<String>,
  edit: List<LanguageTools.Permissions.Rule> -> Unit,
  success: String)
  : Bool =
  match parseRuleList(args) with
  | Error(bad) ->
    printErr(invalidRule([ bad ]))
    false
  | Ok(rules) ->
    edit(rules)
    Stdlib.printLine(Stdlib.Cli.UI.Colors.success(success))
    true


/// `set a; deny b; c` replaces the whole policy.
let replacePolicy(specs: List<String>): Result<LanguageTools.Permissions.Policy, String> =
  let specs = LanguageTools.Permissions.splitRuleSpecs(Stdlib.String.join(specs, " "))
  match LanguageTools.Permissions.parse(specs) with
  | Ok(policy) -> Result.Ok(policy)
  | Error(bad) -> Result.Error(invalidRuleText(bad))


// Named consumer approvals.
// The user-facing surface for account-scoped package approvals and version
// approvals (docs/effects.md). Hashes stay internal; output shows short version
// identifiers only.

/// Resolve a logical name to its latest published version on this branch.
let latestVersion(branchId: Uuid, name: String): Option<String> =
  let location = LanguageTools.ProgramTypes.parsePackageLocation(name)
  match LanguageTools.PackageManager.Function.find(branchId, location) with
  | Some(hash) -> Option.Some(LanguageTools.ProgramTypes.hashToString(hash))
  | None -> Option.None


/// The version this account has APPROVED for <param name>, if any.
let approvedVersionOf(accountID: Option<Uuid>, name: String): Option<String> =
  approvedVersions(accountID)
  |> Stdlib.List.findFirst(fun pair ->
    let (approvedName, _hash) = pair
    approvedName == name)
  |> Stdlib.Option.map(fun pair ->
    let (_name, hash) = pair
    hash)


/// Whether two versions need the same permissions: the same effects, in any order.
let sameRequirements(
  a: (List<LanguageTools.Permissions.Effect> * Bool),
  b: (List<LanguageTools.Permissions.Effect> * Bool))
  : Bool =
  let (aEffects, aComplete) = a
  let (bEffects, bComplete) = b
  aComplete == bComplete
  && Stdlib.List.all(aEffects, fun e -> Stdlib.List.contains(bEffects, e))
  && Stdlib.List.all(bEffects, fun e -> Stdlib.List.contains(aEffects, e))


/// After an edit, keep the function's approval if the new version needs the same permissions.
/// It still allows only what you approved before. Returns the message to show if kept.
let carryApprovalForward(accountID: Option<Uuid>, branchId: Uuid, name: String): Option<String> =
  let (expected, named) = approvalSnapshot(accountID)
  let previous = named |> Stdlib.List.findFirst(fun approval -> approval.name == Option.Some(name))
  match previous, latestVersion(branchId, name) with
  | Some(approval), Some(latest) when approval.hash != latest ->
    let rules = approval.explicitRules
    let unchanged(reason: LanguageTools.Permissions.ApprovalReviewReason): Bool =
      match reason with
      // Incomplete analysis is no difference when both versions are incomplete in the same way.
      | PermissionAnalysisIncomplete ->
        sameRequirements(
          permissionRequirementsForHash(approval.hash),
          permissionRequirementsForHash(latest))
      | _ -> false

    match reviewVersionFor(accountID, name, expected, latest, rules, Incomplete.Acknowledge) with
    | Ok((_, reasons)) when Stdlib.List.all(reasons, unchanged) ->
      let saved =
        approveVersionFor(
          accountID,
          name,
          expected,
          latest,
          rules,
          Incomplete.Acknowledge,
          ContractChange.Acknowledge)

      match saved with
      | Ok(_) ->
        Option.Some($"Kept the approval for {name}: the edited version needs the same permissions.")
      | Error(_) -> Option.None
    | _ -> Option.None
  | _ -> Option.None


/// `requirements`/`show` accept a logical name (resolved to its latest version)
/// or a raw hash for diagnostics.
let resolveVersionArg(state: AppState, arg: String): Option<String> =
  if Stdlib.String.contains(arg, ".") then
    latestVersion(state.currentBranchId, arg)
  else
    // A raw hash must name a stored version; otherwise the analysis would
    // report an unknown version as merely "incomplete".
    match LanguageTools.PackageManager.Function.get(LanguageTools.ProgramTypes.Hash.Hash(arg)) with
    | Some(_) -> Option.Some(arg)
    | None -> Option.None


/// Keep version and requirements labels aligned; do not repeat an unchanged version.
let approvalMetadataLines(
  hash: String,
  previousVersion: Option<String>,
  requirements: (List<LanguageTools.Permissions.Effect> * Bool))
  : List<String> =
  let current = shortVersion(hash)
  let version =
    match previousVersion with
    | Some(previous) when previous == hash -> $"{current} (unchanged)"
    | Some(previous) -> $"{shortVersion(previous)} → {current}"
    | None -> current

  [ $"  Version:       {version}", $"  Requirements:  {describeRequirements(requirements)}" ]


/// Print the review heading and return the requirements already read for it.
let showVersionRequirements(
  name: String,
  previousVersion: Option<String>,
  hash: String)
  : (List<LanguageTools.Permissions.Effect> * Bool) =
  let requirements = permissionRequirementsForHash(hash)
  let (_effects, complete) = requirements
  Stdlib.printLine(Stdlib.Cli.UI.Colors.boldText(name))
  Stdlib.printLines(approvalMetadataLines(hash, previousVersion, requirements))
  if Stdlib.Bool.not(complete) then
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.warning(
        "  Analysis is incomplete; more permissions may be needed at runtime."))
  else
    ()

  requirements


/// Take `--yes`/`-y` out of the arguments, reporting whether it was there.
///
/// An unattended run must pass this explicitly: CI gives each step a pty, which
/// looks like a person. It is stripped before the rules are parsed, so it is
/// never mistaken for a permission rule.
let takeYesFlag(args: List<String>): (Bool * List<String>) =
  let isYesFlag(a: String): Bool = a == "--yes" || a == "-y"
  let yes = args |> Stdlib.List.any(isYesFlag)
  let rest = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(isYesFlag(a)))
  (yes, rest)


/// Show the full replacement before any write. Previewing never prompts or
/// edits policy; --yes uses the same host-only writer as `permissions set`.
let profile(args: List<String>): Bool =
  match args with
  | [] ->
    Stdlib.printLines(Profiles.listing)
    true
  | _ ->
    match takeYesFlag(args) with
    | _, [] ->
      printErr("profile needs a name")
      false
    | apply, [name, ...rest] ->
      match Profiles.resolve(name, rest) with
      | Error(message) ->
        printErr(message)
        false
      | Ok(policy) ->
        let (expected, _) = instanceSnapshot()
        Stdlib.printLine($"Profile {name} replaces the entire instance policy, including denies:")
        Stdlib.printLines(indentedPolicyLines(policy))
        if apply then
          // A profile replaces the whole policy, so an old file that can't be read needn't block it.
          match setAsideUnsupportedPolicy() with
          | Some(kept) -> Stdlib.printLine($"The old policy file was kept as {kept}")
          | None -> ()

          commitInstancePolicy(expected, policy)
          Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"✓ applied profile {name}"))
        else
          Stderr.hint("Preview only. Repeat with --yes to apply.")

        true


/// The rules given after a name on `approve`/`update`, `;`-separated like
/// `set`. Ok None when there are none.
let parseApprovalRules(
  specs: List<String>)
  : Result<Option<LanguageTools.Permissions.Policy>, String> =
  if Stdlib.List.isEmpty(specs) then
    Result.Ok(Option.None)
  else
    match replacePolicy(specs) with
    | Ok(policy) ->
      // Compare and show the same file paths the host will save.
      let normalize(
        rules: List<LanguageTools.Permissions.Rule>)
        : List<LanguageTools.Permissions.Rule> =
        rules
        |> Stdlib.List.map(canonicalRule)
        |> Stdlib.List.unique

      Result.Ok(
        Option.Some({ policy with allow = normalize(policy.allow), deny = normalize(policy.deny) }))
    | Error(message) -> Result.Error(message)


/// Adding access keeps both saved grants and explicit denies.
let addApprovalRules(
  saved: LanguageTools.Permissions.Policy,
  added: LanguageTools.Permissions.Policy)
  : LanguageTools.Permissions.Policy =
  { saved with
      allow = Stdlib.List.unique(Stdlib.List.concat(saved.allow, added.allow))
      deny = Stdlib.List.unique(Stdlib.List.concat(saved.deny, added.deny)) }


/// Show additions and removals separately for grants and explicit denies.
let approvalChanges(
  before: LanguageTools.Permissions.Policy,
  after: LanguageTools.Permissions.Policy)
  : List<String> =
  let changes(
    label: String,
    old: List<LanguageTools.Permissions.Rule>,
    next: List<LanguageTools.Permissions.Rule>)
    : List<String> =
    let removed =
      old
      |> Stdlib.List.filter(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(next, rule)))
      |> Stdlib.List.map(fun rule -> "  - " + label + LanguageTools.Permissions.renderRule(rule))

    let added =
      next
      |> Stdlib.List.filter(fun rule -> Stdlib.Bool.not(Stdlib.List.contains(old, rule)))
      |> Stdlib.List.map(fun rule -> "  + " + label + LanguageTools.Permissions.renderRule(rule))

    Stdlib.List.concat(removed, added)

  Stdlib.List.concat(
    changes("allow ", before.allow, after.allow),
    changes("deny ", before.deny, after.deny))


/// Show explicit rules, inferred permissions, or no extra access when analysis is incomplete.
let policyForReview(
  rules: Option<LanguageTools.Permissions.Policy>,
  requirements: (List<LanguageTools.Permissions.Effect> * Bool))
  : LanguageTools.Permissions.Policy =
  match rules, requirements with
  | Some(policy), _ -> policy
  | None, (effects, true) ->
    LanguageTools.Permissions.Policy
      { allow =
          Stdlib.List.map(effects, fun effect -> LanguageTools.Permissions.Rule.Effect(effect))
        deny = [] }
  | None, (_, false) -> LanguageTools.Permissions.empty()


/// Show the changes and complete result without repeating the old policy or empty sections.
let approvalReviewLines(
  previous: Option<LanguageTools.Permissions.Approval>,
  policy: LanguageTools.Permissions.Policy)
  : List<String> =
  let before =
    previous
    |> Stdlib.Option.andThen(fun approval -> approval.policy)
    |> Stdlib.Option.withDefault(LanguageTools.Permissions.empty())

  let changes = approvalChanges(before, policy)
  let after =
    Stdlib.List.concat(
      Stdlib.List.map(policy.allow, fun rule ->
        "  allow " + LanguageTools.Permissions.renderRule(rule)),
      Stdlib.List.map(policy.deny, fun rule ->
        "  deny " + LanguageTools.Permissions.renderRule(rule)))

  Stdlib.List.flatten(
    [ [ "", "Changes" ]
      if Stdlib.List.isEmpty(changes) then [ "  No rule changes." ] else changes
      [ "", "After saving" ]
      if Stdlib.List.isEmpty(after) then [ "  none" ] else after
      [ "" ] ])


/// Color reinforces the + / - markers; the text remains readable without it.
let showApprovalReview(
  previous: Option<LanguageTools.Permissions.Approval>,
  policy: LanguageTools.Permissions.Policy)
  : Unit =
  approvalReviewLines(previous, policy)
  |> Stdlib.List.iter(fun line ->
    let styled =
      if line == "Changes" || line == "After saving" then
        Stdlib.Cli.UI.Colors.boldText(line)
      else if Stdlib.String.startsWith(line, "  + ") then
        Stdlib.Cli.UI.Colors.success(line)
      else if Stdlib.String.startsWith(line, "  - ") then
        Stdlib.Cli.UI.Colors.error(line)
      else
        line

    Stdlib.printLine(styled))


/// Format the differences found by the host's version comparison.
let approvalReviewReasonText(reason: LanguageTools.Permissions.ApprovalReviewReason): String =
  match reason with
  | ApprovedVersionUnavailable(hash) ->
    $"the previously approved version {hash} is no longer available for comparison"
  | FunctionTypeChanged -> "the function's type changed"
  | PermissionAnalysisIncomplete -> "permission analysis is incomplete"
  | RequiredPermissionsChanged(before, after) ->
    "permission requirements changed from "
    + requirementSummary(before)
    + " to "
    + requirementSummary(after)


let approvalFailureText(failure: LanguageTools.Permissions.ApprovalFailure): String =
  match failure with
  | Refused(message) -> Stdlib.Cli.UI.Colors.error(message)
  | ContractChanged(diffs) ->
    Stdlib.Cli.UI.Colors.warning(
      "Review notes:\n"
      + (diffs
         |> Stdlib.List.map(fun diff -> "  " + approvalReviewReasonText(diff))
         |> Stdlib.String.join("\n")))


/// Ask only when the saved version, rules, or approval metadata would change.
let reviewAndApprove(
  accountID: Option<Uuid>,
  name: String,
  expected: String,
  hash: String,
  rules: Option<LanguageTools.Permissions.Policy>,
  requirements: (List<LanguageTools.Permissions.Effect> * Bool),
  previous: Option<LanguageTools.Permissions.Approval>,
  acceptWithoutPrompt: Bool,
  kept: String,
  command: String)
  : Bool =
  let (_effects, complete) = requirements
  let incomplete = if complete then Incomplete.Refuse else Incomplete.Acknowledge
  match reviewVersionFor(accountID, name, expected, hash, rules, incomplete) with
  | Error(message) ->
    printErr(message)
    Stderr.line(kept)
    false
  | Ok((false, _)) ->
    Stdlib.printLine("Already approved; no changes.")
    true
  | Ok((true, reasons)) ->
    if Stdlib.List.isEmpty(reasons) then
      ()
    else
      Stdlib.printErrorLine(
        approvalFailureText(LanguageTools.Permissions.ApprovalFailure.ContractChanged(reasons)))

    showApprovalReview(previous, policyForReview(rules, requirements))
    if Stdlib.Bool.not(acceptWithoutPrompt || Stdlib.Cli.UI.Prompt.canAsk()) then
      printErr(Prompt.refuseWithoutTerminal("Approval", command))
      false
    else if acceptWithoutPrompt || Stdlib.Cli.UI.Prompt.confirm("Save these permissions?") then
      match approveVersionFor(
              accountID,
              name,
              expected,
              hash,
              rules,
              incomplete,
              ContractChange.Acknowledge) with
      | Ok(_) ->
        Stdlib.printLine(
          Stdlib.Cli.UI.Colors.success($"✓ Saved permissions for {name} ({shortVersion(hash)})"))

        true
      | Error(failure) ->
        Stdlib.printErrorLine(approvalFailureText(failure))
        Stderr.line(kept)
        false
    else
      Stdlib.printLine(kept)
      true


/// Add only the rules the user supplied. Missing rules never save or ask for confirmation.
let approveNamed(
  state: AppState,
  acceptWithoutPrompt: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  match parseApprovalRules(specs) with
  | Error(message) ->
    printErr(message)
    false
  | Ok(givenRules) ->
    match latestVersion(state.currentBranchId, name) with
    | None ->
      printErr($"unknown function: {name}")
      false
    | Some(hash) ->
      let added = Stdlib.Option.withDefault(givenRules, LanguageTools.Permissions.empty())
      if Stdlib.List.isEmpty(added.allow) && Stdlib.List.isEmpty(added.deny) then
        printErr("No permission rules specified.")
        Stderr.line("Usage: permissions approve --for <fn> '<rule>'")
        let (effects, complete) = permissionRequirementsForHash(hash)
        if complete && Stdlib.List.isEmpty(effects) then
          Stderr.line("This function needs no permissions, so no approval is necessary.")
        else
          Stderr.hint($"Use `permissions requirements {name}` to inspect its requirements.")

        false
      else
        let (expected, named) = approvalSnapshot(state.accountID)
        let previous =
          named |> Stdlib.List.findFirst(fun approval -> approval.name == Option.Some(name))

        let policy =
          match previous with
          | Some(approval) when approval.hash == hash ->
            match approval.policy with
            | Some(saved) -> addApprovalRules(saved, added)
            | None -> added
          | _ -> added

        let rules = Option.Some(policy)
        let previousVersion = previous |> Stdlib.Option.map(fun approval -> approval.hash)
        let requirements = showVersionRequirements(name, previousVersion, hash)
        match previous with
        | Some(approval) when approval.hash != hash ->
          Stdlib.printLine("  Code changed. Previous grants are not carried forward by approve.")
          Stdlib.printLine("  Use `permissions update` to review carrying them to the new version.")
        | _ -> ()

        reviewAndApprove(
          state.accountID,
          name,
          expected,
          hash,
          rules,
          requirements,
          previous,
          acceptWithoutPrompt,
          "not approved",
          $"dark permissions approve --for {name} '<rule>'")


/// Show the complete update, then ask once. Declining keeps the saved approval.
/// `--yes` accepts the review without a prompt and is required without a terminal.
let updateNamed(
  state: AppState,
  acceptWithoutPrompt: Bool,
  name: String,
  specs: List<String>)
  : Bool =
  let accountID = state.accountID
  let (expected, named) = approvalSnapshot(accountID)
  let previous = named |> Stdlib.List.findFirst(fun approval -> approval.name == Option.Some(name))
  match parseApprovalRules(specs) with
  | Error(message) ->
    printErr(message)
    false
  | Ok(givenRules) ->
    match previous |> Stdlib.Option.map(fun approval -> approval.hash) with
    | None ->
      printErr(
        $"{name} has no remembered approval; run `permissions approve --for {name} '<rule>'` first")

      false
    | Some(approved) ->
      match latestVersion(state.currentBranchId, name) with
      | None ->
        printErr($"unknown function: {name}")
        false
      | Some(latest) ->
        // Keep rules the user explicitly approved and add any new rules.
        // For changed code, recompute rules inferred from its effects.
        // Use remove --for to take access away.
        let saved =
          if approved == latest && Stdlib.Option.isSome(givenRules) then
            previous |> Stdlib.Option.andThen(fun approval -> approval.policy)
          else
            previous |> Stdlib.Option.andThen(fun approval -> approval.explicitRules)

        let rules =
          match saved, givenRules with
          | Some(saved), Some(added) -> Option.Some(addApprovalRules(saved, added))
          | Some(saved), None -> Option.Some(saved)
          | None, _ -> givenRules

        let requirements = showVersionRequirements(name, Option.Some(approved), latest)
        reviewAndApprove(
          accountID,
          name,
          expected,
          latest,
          rules,
          requirements,
          previous,
          acceptWithoutPrompt,
          "Approval unchanged.",
          $"dark permissions update {name}")


/// Run <param show> against the version <param target> names, or report an
/// unknown function.
let withVersion(state: AppState, target: String, show: String -> List<String>): Bool =
  match resolveVersionArg(state, target) with
  | None ->
    printErr($"unknown function: {target}")
    false
  | Some(hash) ->
    Stdlib.printLines(show(hash))
    true


let printListOrNone(items: List<String>): Unit =
  if Stdlib.List.isEmpty(items) then
    Stdlib.printLine("none")
  else
    Stdlib.printLines(items)


/// Every subcommand with the usage it prints when its argument is missing;
/// None for the ones that take no argument. Drives `execute`'s
/// missing-argument arm and `complete`.
val subcommands =
  [ ("list", Option.None)
    ("profile", Option.None)
    ("allow", Option.Some("allow <rule>;…"))
    ("deny", Option.Some("deny <rule>;…"))
    ("remove", Option.Some("remove [--for <fn>] <rules> | remove --for <fn> --all"))
    // `set` with nothing would otherwise replace the policy with deny-all;
    // that is what `clear` is for.
    ("set", Option.Some("set <rule>;… (or `clear`)"))
    ("clear", Option.None)
    ("approve", Option.Some("approve --for <fn> <rules>"))
    ("update", Option.Some("update <fn> [<rule>;…]"))
    ("unapprove", Option.Some("unapprove <fn>"))
    ("approved", Option.None)
    ("requirements", Option.Some("requirements <fn|hash>"))
    ("show", Option.Some("show <fn|hash>"))
    ("approvals", Option.None)
    ("revoke-package", Option.Some("revoke-package <hash>")) ]


/// The usage line for a subcommand given without its argument, if it needs one.
let usageOf(subcommand: String): Option<String> =
  subcommands
  |> Stdlib.List.findFirst(fun((name, _usage)) -> name == subcommand)
  |> Stdlib.Option.andThen(fun((_name, usage)) -> usage)


/// Parse named permission options wherever they occur, including --for=<name>.
let permissionArgs(args: List<String>): FlagParser.Parsed =
  let normalized =
    args
    |> Stdlib.List.map(fun arg ->
      if Stdlib.String.startsWith(arg, "--for=") then
        [ "--for", Stdlib.String.dropFirst(arg, 6) ]
      else
        [ arg ])
    |> Stdlib.List.flatten

  FlagParser.parse(
    FlagParser.Spec
      { flags = [ ("--yes", [ "-y" ]), ("--all", []) ], valueFlags = [ ("--for", []) ] },
    normalized)


/// If --for is present, require one nonempty value and reject repeated flags.
let permissionTarget(parsed: FlagParser.Parsed): Result<Option<String>, String> =
  let targets = parsed.options |> Stdlib.List.filter(fun((flag, _)) -> flag == "--for")
  match targets with
  | [] -> Result.Ok(Option.None)
  | [(_, name)] when name != "" && Stdlib.Bool.not(Stdlib.String.startsWith(name, "-")) ->
    Result.Ok(Option.Some(name))
  | [_] -> Result.Error("--for needs a function name or a saved script name")
  | _ -> Result.Error("Specify --for only once.")


/// Remove all saved rules for a name, including approvals of older code or scripts.
let removeNamedApproval(state: AppState, name: String): AppState =
  let (expected, approvals) = approvalSnapshot(state.accountID)
  if Stdlib.List.any(approvals, fun approval -> approval.name == Option.Some(name)) then
    removeNamedApprovalFor(state.accountID, expected, name)
    Stdlib.printLine(
      Stdlib.Cli.UI.Colors.success(
        $"✓ Removed remembered approval for {name}. Other rules may still allow access."))

    state
  else
    printErr($"{name} has no remembered approval; `permissions approved` lists the ones that do")
    failed(state)


/// Calculate an exact rule removal before writing anything. Missing rules refuse the whole edit.
let removeApprovalRules(
  policy: LanguageTools.Permissions.Policy,
  rules: List<LanguageTools.Permissions.Rule>)
  : Result<LanguageTools.Permissions.Policy, String> =
  let saved = Stdlib.List.concat(policy.allow, policy.deny)
  if Stdlib.List.isEmpty(rules) then
    Result.Error("Give a saved rule to remove, or use --all.")
  else if
    Stdlib.List.any(rules, fun rule -> Stdlib.Bool.not(Stdlib.List.contains(saved, rule)))
  then
    Result.Error("A requested rule is not saved; nothing was removed.")
  else
    let keep(rule: LanguageTools.Permissions.Rule): Bool =
      Stdlib.Bool.not(Stdlib.List.contains(rules, rule))

    Result.Ok(
      { policy with
          allow = Stdlib.List.filter(policy.allow, keep)
          deny = Stdlib.List.filter(policy.deny, keep) })


/// Read the saved rules, remove the requested ones, and save if permissions are unchanged.
let removeNamedRules(
  state: AppState,
  name: String,
  rules: List<LanguageTools.Permissions.Rule>)
  : AppState =
  let (expected, approvals) = approvalSnapshot(state.accountID)
  let saved =
    approvals
    |> Stdlib.List.findFirst(fun approval -> approval.name == Option.Some(name))
    |> Stdlib.Option.andThen(fun approval -> approval.policy)

  match saved with
  | None ->
    printErr($"{name} has no remembered approval.")
    failed(state)
  | Some(policy) ->
    match removeApprovalRules(policy, Stdlib.List.map(rules, canonicalRule)) with
    | Error(message) ->
      printErr(message)
      Stderr.hint($"Use `permissions show {name}` to see its rules.")
      failed(state)
    | Ok(edited) ->
      removeSavedAccess(
        state.accountID,
        LanguageTools.Permissions.ApprovalTarget.EditPolicy(name, expected, edited))

      Stdlib.printLine(
        Stdlib.Cli.UI.Colors.success(
          $"✓ Removed saved rules for {name}. Other rules may still allow access."))

      state


/// Remove exact saved rules, or every saved rule for one named approval.
let removeRules(state: AppState, args: List<String>): AppState =
  let parsed = permissionArgs(args)
  let all = FlagParser.hasFlag(parsed, "--all")
  match permissionTarget(parsed), all, parsed.positionals with
  | Error(message), _, _ ->
    printErr(message)
    failed(state)
  | _, true, [_, ...] ->
    printErr("--all cannot be combined with individual rules; nothing was removed")
    failed(state)
  | Ok(None), true, [] ->
    printErr("--all requires --for <fn>; `permissions clear` clears instance rules")
    failed(state)
  | Ok(Some(name)), true, [] -> removeNamedApproval(state, name)
  | _, false, [] ->
    printErr("Give a rule to remove, or use --for <fn> --all.")
    failed(state)
  | Ok(target), false, specs ->
    match parseRuleList(specs) with
    | Error(bad) ->
      printErr(invalidRule([ bad ]))
      failed(state)
    | Ok(rules) ->
      if Stdlib.List.isEmpty(rules) then
        printErr("Give a rule to remove, or use --for <fn> --all.")
        failed(state)
      else
        match target with
        | None ->
          editInstancePolicy([], [], rules)
          Stdlib.printLine(Stdlib.Cli.UI.Colors.success("✓ rule removed"))
          state
        | Some(name) -> removeNamedRules(state, name, rules)


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [] | ["list"] ->
    Stdlib.printLines(instancePolicyLines())
    state
  | ["help"] ->
    Stdlib.printLine(help(state))
    state
  | ["profile", ...args] -> exitWith(state, profile(args))
  // Before the `[<subcommand>, ...args]` arms: a subcommand given with no
  // argument must report usage, not run with an empty argument list (`set`
  // with nothing would replace the policy with deny-all).
  | [subcommand] when Stdlib.Option.isSome(usageOf(subcommand)) ->
    let usage = Stdlib.Option.withDefault(usageOf(subcommand), "")
    printErr($"missing argument; usage: permissions {usage}")
    failed(state)
  | ["allow", ...rule] ->
    exitWith(
      state,
      editRules(rule, (fun rules -> editInstancePolicy(rules, [], [])), "✓ policy updated"))
  | ["deny", ...rule] ->
    exitWith(
      state,
      editRules(rule, (fun rules -> editInstancePolicy([], rules, [])), "✓ policy updated"))
  | ["remove", ...args] -> removeRules(state, args)
  | ["clear"] ->
    exitWith(
      state,
      editPolicy(
        (fun _ -> Result.Ok(LanguageTools.Permissions.empty())),
        "✓ policy is now deny-all"))
  | ["set", ...specs] ->
    exitWith(state, editPolicy((fun _ -> replacePolicy(specs)), "✓ policy replaced"))
  | ["approve", ...args] ->
    let parsed = permissionArgs(args)
    let yes = FlagParser.hasFlag(parsed, "--yes")
    match permissionTarget(parsed), parsed.positionals with
    | Error(message), _ ->
      printErr(message)
      failed(state)
    | Ok(Some(name)), rules -> exitWith(state, approveNamed(state, yes, name, rules))
    // Keep the positional spelling used by existing scripts.
    | Ok(None), [name, ...rules] -> exitWith(state, approveNamed(state, yes, name, rules))
    | Ok(None), [] ->
      printErr("approve needs --for <fn>")
      failed(state)
  | ["update", ...rest] ->
    match takeYesFlag(rest) with
    | acceptWithoutPrompt, [name, ...rules] ->
      exitWith(state, updateNamed(state, acceptWithoutPrompt, name, rules))
    | _, [] ->
      printErr("update needs a function name")
      failed(state)
  | ["unapprove", name] -> removeNamedApproval(state, name)
  | ["requirements", target] ->
    exitWith(state, withVersion(state, target, fun hash -> [ requirementDisplay(hash) ]))
  | ["show", target] ->
    if Stdlib.String.startsWith(target, "script:") then
      match explicitApprovalFor(state.accountID, target) with
      | None ->
        printErr($"No remembered approval for {target}")
        failed(state)
      | Some(policy) ->
        Stdlib.printLine($"Remembered approval for {target}:")
        Stdlib.List.iter(indentedPolicyLines(policy), Stdlib.printLine)
        Stdlib.printLine("Applies only to the reviewed source and dependency versions.")
        Stdlib.printLine("Instance denies and run restrictions still win.")
        state
    else
      let name = TraceVerbs.canonicalFnName(state.currentBranchId, target)
      exitWith(
        state,
        withVersion(state, name, fun hash ->
          let facts = accessFacts(state.accountID, hash)
          let facts =
            if target == hash then
              facts
            else
              { facts with
                  approvals = Stdlib.List.filter(facts.approvals, fun((n, _)) -> n == name)
                  approvedAs = Stdlib.List.filter(facts.approvedAs, fun n -> n == name)
                  olderApproval =
                    match approvedVersionOf(state.accountID, name) with
                    | Some(version) when version != hash -> Option.Some(version)
                    | _ -> Option.None }

          renderAccessReport(name, facts)))
  | ["revoke-package", hash] -> exitWith(state, revokeHash(state.accountID, hash))
  | ["approved"] | ["approvals"] ->
    let approvals = namedApprovals(state.accountID, state.currentBranchId)
    if Stdlib.List.isEmpty(approvals) then
      Stdlib.printLine("Remembered approvals: none")
    else
      Stdlib.printLine("Remembered approvals:")
      Stdlib.printLines(approvals)

    if approvalsStale() then
      Stdlib.printErrorLine(
        Stdlib.Cli.UI.Colors.warning(
          "! approval analysis changed since these were approved; re-review with `permissions update <fn>`"))
    else
      ()

    state
  | _ ->
    printErr("unknown permissions command: " + Stdlib.String.join(args, " "))
    Stdlib.printErrorLine(help(state))
    failed(state)


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | ["profile"] -> Profiles.all |> Stdlib.List.map(fun profile -> Completion.simple(profile.name))
  // Wildcards, not `_root`: every branch of an or-pattern has to bind the same names, and the
  // first one binds nothing. Nothing here reads the root anyway.
  | ["profile", "default"] | ["profile", "read-only", _] | ["profile", "local-dev", _] ->
    [ Completion.simple("--yes") ]
  | ["profile", ...] -> []
  | ["approve", ...] -> [ Completion.simple("--for"), Completion.simple("--yes") ]
  | ["remove", ...] -> [ Completion.simple("--for"), Completion.simple("--all") ]
  | _ -> subcommands |> Stdlib.List.map(fun((name, _usage)) -> Completion.simple(name))


let help(_state: AppState): String =
  [ "Usage: permissions [list] | allow <rule>;… | deny <rule>;… | remove <rule>;…"
    "                   | set <rule>;… | clear"
    "                   | profile [name [ABSOLUTE-ROOT] [--yes]]"
    "                   | approve --for <fn> <rules> | update <fn> [rules]"
    "                   | remove --for <name> <rules> | remove --for <name> --all"
    "                   | unapprove <name> | approved"
    "                   | requirements <fn|hash> | show <fn|hash>"
    "                   | approvals | revoke-package <hash>"
    ""
    "The instance policy is local and deny-by-default. Every actual host operation"
    "needs an instance grant, a named entry approval, or a temporary run grant."
    "Explicit instance denies and run restrictions always win. Helpers inherit"
    "their caller's access. Effects describe behavior; they do not grant access."
    "Dark checks the actual file, URL or other resource before each operation."
    ""
    "Inspect permissions:"
    "  list           instance defaults: allowed rules and explicit denies"
    "  show <fn>      the function's effects and remembered approvals"
    "  approved       remembered approvals, each tied to a name and code version"
    "  approvals      the same as approved"
    "  effects <fn>   (a top-level command) effects and a call path for each"
    ""
    "allow, deny and remove take several rules separated by `;`, quoted for the shell:"
    "  permissions allow 'clock; random; file read /tmp'"
    "If any of them is not a rule, none are saved."
    ""
    "Profiles:"
    "  profile                         list the available presets"
    "  profile default                 preview the installation default"
    "  profile read-only <ROOT>        directory/store reads and HTTPS GET"
    "  profile local-dev <ROOT>        directory/store writes and HTTP serving too"
    "  Add --yes to apply. Replaces the entire instance policy, including denies."
    "  ROOT must be absolute; no process, native or environment access is granted."
    "  HTTPS GET permits any host on port 443; HTTP serving permits any port on 127.0.0.1."
    ""
    "Named approvals:"
    "  --yes, -y      skip confirmation when saving; required without a terminal"
    "                 An unchanged approval returns immediately without saving or prompting."
    "  approve --for <fn> <rules> add access, keeping this version's saved rules."
    "                 Rules are required; omitting them saves nothing and never prompts."
    "                 Edits run immediately but do not inherit the old approval."
    "                 Rules allow access to this entry and its helpers, in addition"
    "                 to instance defaults. Separate names have separate grants, e.g."
    "                 approve --for MyApp.fetch 'http GET https://api.example.com'"
    "  remove --for <name> <rules> remove exact rules from this saved approval."
    "                 Other grants and denies stay; instance rules are unchanged."
    "  remove --for <name> --all forget all saved access for this name."
    "                 --all cannot be combined with rules. Plain `all` is one rule."
    "                 Names can also be script:/absolute/path from `approved`."
    "  update <fn>    review access for the current version; declining leaves the"
    "                 approval unchanged. Changes are shown before one confirmation."
    "                 Explicit rules carry over after review; new rules add to them."
    "                 Inferred effects are recomputed when the code changes."
    "  unapprove <name> alias for remove --for <name> --all; other rules still apply"
    "  approve <fn> <rules> remains accepted for existing scripts."
    "  revoke-package <hash> remove all named approvals of that version"
    ""
    "Rules:"
    "  <effect>                         e.g. clock, random, stdout, http, process,"
    "                                   package-read, trace-write (all of an effect)"
    "  http <METHOD> [URL]              /api is exact; /api/* includes child paths"
    "                                   no path allows any path; no query allows any query"
    "  http-server <ADDRESS|*> <PORT|*>  IPv4 address, localhost, or any address"
    "  file read|write|read+write [ROOT]"
    "  env read|write|read+write [NAME]"
    "  process <ABSOLUTE-EXECUTABLE|*> [ARG…]"
    "  process-exact <ABSOLUTE-EXECUTABLE> [ARG…]  only those arguments (none means none)"
    "  native                           builtins that can reach anything (raw descriptors,"
    "                                   process handles); no narrower form exists"
    "  all"
    "  deny <rule> (in `set`)           an explicit deny; deny beats allow" ]
  |> Stdlib.String.join("\n")
