/// Named starting policies. Profiles expand to ordinary typed rules; only
/// Command.writePolicy can install one through the host administration API.
module Darklang.Cli.Permissions.Profiles

type Profile =
  { name: String
    description: String
    needsRoot: Bool }


val all =
  [ Profile
      { name = "default"
        description = "the installation default: local stores, stdio, clock and random"
        needsRoot = false }

    Profile
      { name = "read-only"
        description = "read a directory and local stores; HTTPS GET, stdio, clock and random"
        needsRoot = true }

    Profile
      { name = "local-dev"
        description =
          "read/write a directory and local stores; HTTPS GET, local-only HTTP serving, following edits"
        needsRoot = true } ]


val readEffects =
  [ LanguageTools.Permissions.Effect.PackageRead
    LanguageTools.Permissions.Effect.TraceRead
    LanguageTools.Permissions.Effect.Stdin
    LanguageTools.Permissions.Effect.Stdout
    LanguageTools.Permissions.Effect.Clock
    LanguageTools.Permissions.Effect.Random ]


/// Kept aligned with the host's defaultInstance by the CLI integration test.
val defaultEffects =
  Stdlib.List.concat(
    readEffects,
    [ LanguageTools.Permissions.Effect.TraceWrite, LanguageTools.Permissions.Effect.Concurrency ])


val httpsGet =
  LanguageTools.Permissions.Rule.Http(
    LanguageTools.Permissions.HttpRule
      { method = LanguageTools.Permissions.Scope.Only("GET")
        scheme = LanguageTools.Permissions.Scope.Only("https")
        host = LanguageTools.Permissions.HostRule.Any
        port = LanguageTools.Permissions.Scope.Only(443)
        path = LanguageTools.Permissions.HttpPath.All
        query = LanguageTools.Permissions.Scope.All })


let fromEffects(effects: List<LanguageTools.Permissions.Effect>): LanguageTools.Permissions.Policy =
  LanguageTools.Permissions.Policy
    { allow = effects |> Stdlib.List.map(fun e -> LanguageTools.Permissions.Rule.Effect(e))
      deny = [] }


let usage(profile: Profile): String =
  "permissions profile "
  + profile.name
  + (if profile.needsRoot then " <ABSOLUTE-ROOT>" else "")
  + " [--yes]"


val listing =
  Stdlib.List.prepend(
    all |> Stdlib.List.map(fun profile -> "  " + usage(profile) + "\n    " + profile.description),
    "Permission profiles (preview first; --yes applies):")


/// Validate the complete command before constructing a policy. The root stays
/// a single typed field, so quotes, spaces and semicolons cannot inject rules.
let resolve(name: String, args: List<String>): Result<LanguageTools.Permissions.Policy, String> =
  let found = all |> Stdlib.List.findFirst(fun profile -> profile.name == name)
  match found with
  | None -> Result.Error($"unknown permission profile: {name}")
  | Some(profile) ->
    match profile.needsRoot, args with
    | false, [] -> Result.Ok(fromEffects(defaultEffects))
    | true, [root] ->
      if Stdlib.Bool.not(LanguageTools.Permissions.isAbsolutePath(root)) then
        Result.Error("profile root must be an absolute directory path; ~ and * are not expanded")
      else
        let read =
          LanguageTools.Permissions.Rule.FileRead(LanguageTools.Permissions.Scope.Only(root))

        let policy =
          if name == "read-only" then
            fromEffects(readEffects)
          else
            fromEffects(defaultEffects)

        let rules =
          if name == "read-only" then
            [ read, httpsGet ]
          else
            [ read
              LanguageTools.Permissions.Rule.FileWrite(LanguageTools.Permissions.Scope.Only(root))
              httpsGet
              LanguageTools.Permissions.Rule.HttpServer(
                LanguageTools.Permissions.Scope.Only("127.0.0.1"),
                LanguageTools.Permissions.Scope.All)

              LanguageTools.Permissions.Rule.Effect(LanguageTools.Permissions.Effect.PackageWrite)
              LanguageTools.Permissions.Rule.Effect(LanguageTools.Permissions.Effect.Runtime) ]

        Result.Ok({ policy with allow = Stdlib.List.concat(policy.allow, rules) })
    | _ -> Result.Error("usage: " + usage(profile))
