/// Inspect what code might do without running it.
module Darklang.Cli.Effects

/// The effects `effects <fn>` finds, by name, and whether every call was followed.
let namesOf(hash: String): (List<String> * Bool) =
  let (complete, found) = LanguageTools.Permissions.effectReasons(hash)
  (found |> Stdlib.List.map(fun((effect, _)) -> LanguageTools.Permissions.effectName(effect)),
   complete)


let without(names: List<String>, others: List<String>): List<String> =
  names |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(others, n)))


/// What the version <param hash> does that <param previous> did not; empty when nothing.
let added(previous: String, hash: String): List<String> =
  if previous == hash then
    []
  else
    let (before, _) = namesOf(previous)
    let (after, _) = namesOf(hash)
    without(after, before)


/// `  now also http, raise` for a fn a branch changed to do more than its parent's version.
let entryNote(e: SCM.PackageOps.BranchDiffEntry): String =
  if e.kind != "fn" || e.change == "new" then
    ""
  else
    match added(e.parentHash, e.hash) with
    | [] -> ""
    | names -> "  now also " + Stdlib.String.join(names, ", ")


/// What a fn save says about its effects: `none`, `http, raise (was none)`, `file-read (no longer http)`.
let saveSummary(previous: Option<String>, hash: String): String =
  let (now, complete) = namesOf(hash)
  let shown =
    match now, complete with
    | [], true -> "none"
    | [], false -> "not fully known"
    | _, true -> Stdlib.String.join(now, ", ")
    | _, false -> Stdlib.String.join(now, ", ") + ", possibly more"

  let change =
    match previous with
    | Some(previous) when previous != hash ->
      let (before, _) = namesOf(previous)
      let gained = without(now, before)
      let lost = without(before, now)
      if Stdlib.List.isEmpty(before) && Stdlib.Bool.not(Stdlib.List.isEmpty(now)) then
        " (was none)"
      else
        let parts =
          Stdlib.List.concat(
            (if Stdlib.List.isEmpty(gained) then
               []
             else
               [ "now also " + Stdlib.String.join(gained, ", ") ]),
            if Stdlib.List.isEmpty(lost) then
              []
            else
              [ "no longer " + Stdlib.String.join(lost, ", ") ])

        if Stdlib.List.isEmpty(parts) then
          ""
        else
          " (" + Stdlib.String.join(parts, "; ") + ")"
    | _ -> ""

  shown + change


let execute(state: AppState, args: List<String>): AppState =
  match args with
  | [name] ->
    let name = TraceVerbs.canonicalFnName(state.currentBranchId, name)
    match Permissions.Command.resolveVersionArg(state, name) with
    | None ->
      printErr($"Unknown function: {name}")
      failed(state)
    | Some(hash) ->
      let (complete, reasons) = LanguageTools.Permissions.effectReasons(hash)
      if Stdlib.List.isEmpty(reasons) then
        Stdlib.printLine(if complete then "effect-free" else "no known effects")
      else
        Stdlib.List.iter(reasons, fun((effect, path)) ->
          Stdlib.printLine(LanguageTools.Permissions.effectName(effect))
          Stdlib.printLine("  via " + Stdlib.String.join(path, " -> ")))

      if complete then
        ()
      else
        printErr("Incomplete: some calls could not be resolved. More effects may occur.")

      state
  | _ ->
    printErr("Usage: effects <function>")
    failed(state)


let help(_state: AppState): String =
  "Usage: effects <function>\nShow possible effects and the calls that cause them, without running code.\nExample: effects Me.reports.report\nSee allowed access with: permissions show Me.reports.report"


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
