/// The interactive loop: the prompt's inline region, key dispatch, and the render/read pass.
///
/// Part of `Darklang.Cli`.
module Darklang.Cli

/// Prepend the "you got here from somewhere, here's the way back" row when this prompt sits on a page stack.
///
/// This used to be the right-hand side of the bottom status bar. The status bar is gone: it reserved the last
/// terminal row with a scroll region, and a scroll region and an inline prompt region fight over the same
/// rows. A row directly above the prompt is arguably the better home anyway, since it's next to what you're
/// typing rather than parked at the far edge of the screen.
///
/// Presentation only. It's added on the render path and not by `releasePromptRegion`, so it disappears rather
/// than piling up in scrollback behind every command you run.
let withModeHint (state: AppState) (view: Tui.View) : Tui.View =
  if Stdlib.List.isEmpty state.pageStack then
    view
  else
    let hintRow =
      Colors.dimText "command prompt  ·  `quit` returns to the workbench"
    let rows = Stdlib.List.push view.rows hintRow
    // The prompt's cursor is addressed against its own rows, so inserting a row above it moves it down one.
    match view.cursor with
    | Visible(row, column) ->
      { view with rows = rows; cursor = Tui.Cursor.Visible(row + 1, column) }
    | Hidden -> { view with rows = rows }


/// Release the retained prompt before appending command output or handing the terminal to another page.
///
/// The region shrinks to the prompt rows alone, so the submitted command stays in scrollback while the
/// completion hint does not.
let releasePromptRegion (state: AppState) : AppState =
  match state.promptTerminal with
  | None -> state
  | Some terminal ->
    let parked =
      Prompt.Display.viewAtSize
        state.prompt
        (locationStr state)
        ""
        (Tui.TerminalSession.currentSize ())
    let _stopped =
      Tui.TerminalSession.stopInlineWithView terminal parked
    { state with promptTerminal = Stdlib.Option.Option.None }


/// Erase the rendered prompt region and release its terminal ownership.
///
/// Used on Ctrl-C and programmatic exit, where nothing from the region should
/// remain in scrollback and the shell prompt should reappear in its place.
let clearPromptRegion (state: AppState) : AppState =
  match state.promptTerminal with
  | None -> state
  | Some terminal ->
    let cleared =
      Tui.View {
        rows = []
        cursor = Tui.Cursor.Hidden
        mode = Tui.ViewMode.Inline
      }
    let _stopped =
      Tui.TerminalSession.stopInlineWithView terminal cleared
    { state with promptTerminal = Stdlib.Option.Option.None }


let handleKeyInput (state: AppState) (key: Stdlib.Cli.Stdin.Key.Key) (modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers) (keyChar: Stdlib.Option.Option<String>) : AppState =
  // Ctrl+C exits from any page
  if modifiers.ctrl && key == Stdlib.Cli.Stdin.Key.Key.C then
    let state =
      match state.currentPage with
      | MainPrompt -> clearPromptRegion state
      | CompletionPicker session ->
        let _stopped = CompletionPicker.stop session
        state
      | InteractiveNav session ->
        let _stopped = Tui.TerminalSession.stop session.terminal
        state
      | SubApp app ->
        app.onTerminate ()
        state
    { state with isExiting = true }
  else

  match state.currentPage with
  | MainPrompt ->
    // Normal command mode key handling
    match key with
    | Enter ->
      // Execute the current command
      if Stdlib.String.isEmpty (Stdlib.String.trim state.prompt.text) then
        let released = releasePromptRegion state
        Stdlib.printLine ""
        { released with
            prompt = Prompt.Editing.clear state.prompt }
      else
        let released = releasePromptRegion state
        Stdlib.printLine ""
        let commandToExecute = Stdlib.String.trim state.prompt.text
        let tCmd = Telemetry.now ()
        let newState =
          Commands.parseAndExecute released commandToExecute
        Telemetry.logWithContext "commandExec" tCmd [("cmd", commandToExecute)]
        let clearedPrompt = Prompt.Editing.clear newState.prompt
        let promptWithHistory = Prompt.History.addCommand clearedPrompt commandToExecute
        { newState with
            prompt = promptWithHistory }

    | Backspace ->
      { state with
          prompt = Prompt.Editing.deleteBeforeCursor state.prompt }

    | Delete ->
      { state with
          prompt = Prompt.Editing.deleteAtCursor state.prompt }

    | Tab ->
      // Handle tab completion
      let tTab = Telemetry.now ()
      let completions = Registry.getCompletions state state.prompt.text
      Telemetry.logWithContext "tabComplete" tTab [("resultCount", Stdlib.Int.toString (Stdlib.List.length completions)); ("input", state.prompt.text)]

      // CLEANUP: When there are multiple completions with a common prefix (e.g. "filter" and "filterMap"),
      // Tab should complete up to the common part ("filter") rather than just showing options
      match completions with
      | [] -> state  // No completions available
      | [singleCompletion] ->
        // Single completion - auto-complete it
        let parsed = Completion.parseInput state.prompt.text
        let newPromptText = Completion.buildCompletedCommand parsed singleCompletion.value
        { state with prompt = Prompt.Editing.setText state.prompt newPromptText }
      | multiple ->
        // Multiple completions - open interactive picker
        let released = releasePromptRegion state
        Stdlib.printLine ""
        let pickerState = CompletionPicker.create state.prompt.text multiple
        let size = Tui.TerminalSession.currentSize ()
        match CompletionPicker.startAtSize pickerState size with
        | Ok session ->
          { released with
              currentPage = Page.CompletionPicker session }
        | Error message ->
          Stdlib.printLine message
          released

    | UpArrow ->
      { state with
          prompt = Prompt.History.navigatePrevious state.prompt }

    | DownArrow ->
      { state with
          prompt = Prompt.History.navigateNext state.prompt }

    | LeftArrow ->
      { state with
          prompt = Prompt.Editing.moveCursorLeft state.prompt }

    | RightArrow ->
      { state with
          prompt = Prompt.Editing.moveCursorRight state.prompt }

    | Home ->
      { state with
          prompt = Prompt.Editing.moveCursorHome state.prompt }

    | End ->
      { state with
          prompt = Prompt.Editing.moveCursorEnd state.prompt }

    | _ ->
      // Add character to prompt at cursor position
      match keyChar with
      | Some char ->
        { state with
            prompt = Prompt.Editing.insertAtCursor state.prompt char }
      | None -> state

  | InteractiveNav session ->
    // Interactive navigation key handling
    Packages.NavInteractive.handleKey state key keyChar session

  | CompletionPicker session ->
    // Completion picker key handling
    let size = Tui.TerminalSession.currentSize ()
    match
      CompletionPicker.handleKeyAtSize
        session.state
        size
        key
    with
    | Continue newPickerState ->
      let nextSession =
        CompletionPicker.presentAtSize
          session
          newPickerState
          size
      { state with
          currentPage = Page.CompletionPicker nextSession }
    | SelectItem selection ->
      // User selected an item - update prompt and return to main
      let _stopped = CompletionPicker.stop session
      let newPromptText =
        CompletionPicker.buildCompletedCommand
          session.state
          selection
      { state with
          currentPage = Page.MainPrompt
          prompt = Prompt.Editing.setText state.prompt newPromptText }
    | Cancel ->
      // User cancelled - return to main with original prompt
      let _stopped = CompletionPicker.stop session
      { state with
          currentPage = Page.MainPrompt }
    | Unavailable message ->
      let _stopped = CompletionPicker.stop session
      Stdlib.printLine message
      { state with
          currentPage = Page.MainPrompt }

  | SubApp app ->
    let (action, newApp) = app.onKey key modifiers keyChar
    match action with
    | Continue ->
      { state with
          currentPage = Page.SubApp newApp }
    | Save ->
      newApp.onSave ()
      { state with
          currentPage = Page.SubApp newApp }
    | Exit ->
      newApp.onTerminate ()
      newApp.onSave ()
      match state.pageStack with
      | returnTo :: rest ->
        // Launched from another page (e.g. a foreground app opened from the workbench). Return to the
        // launcher instead of quitting. `onTerminate` above tore down the launched app's surface, so the
        // launcher's retained session is stale — resume it to restart the session and repaint from scratch,
        // rather than poking the alternate screen directly.
        let resumed =
          match returnTo with
          | SubApp app -> Page.SubApp (app.onResume ())
          | other -> other
        { state with currentPage = resumed; pageStack = rest }
      | [] ->
        // The workbench is the experience: leaving it leaves the CLI, no classic-prompt fallback.
        // (The classic prompt is only reachable via DARK_CLASSIC=1 at launch.)
        { state with isExiting = true }
    | LaunchCommand cmd ->
      // Release this app's surface before the replacement command takes ownership, and push this page so the
      // launched page's exit returns here.
      newApp.onTerminate ()
      let saved = Page.SubApp newApp
      // Launching from a live page is interactive by definition, even when the CLI itself was started
      // one-shot (`dark wb` takes the args path, which marks the session non-interactive). Without this, a
      // command that degrades when non-interactive prints its summary and leaves, instead of taking the
      // screen: `:review` from a workbench opened with `dark wb` did exactly that, while the same command
      // from a workbench opened with a bare `dark` worked.
      //
      // Safe to clear: LaunchCommand always pushes onto the page stack, so the launched app's exit pops back
      // here rather than consulting this flag to decide whether to leave the CLI.
      //
      // `currentPage` is pointed at MainPrompt before handing off, as a marker for "nobody took the screen".
      // It used to stay on this app, whose session `onTerminate` just stopped - so a command that bailed
      // before taking the terminal left a page that repaints nothing above a stack entry that never pops.
      // MainPrompt is the only page that can be recognised afterwards: a SubApp holds nothing but functions,
      // so two of them can't be compared.
      let launched =
        Registry.executeCommand
          cmd
          { state with
              currentPage = Page.MainPrompt
              pageStack = Stdlib.List.append [ saved ] state.pageStack
              nonInteractive = false }
          []
      match launched.currentPage with
      // A command that asked to end the CLI gets to: resuming would re-enter the alternate screen and then the
      // loop would return with nobody to tear it down, leaving the terminal in it. Nothing reachable through
      // LaunchCommand exits today, but `quit` has exactly this shape, so it's one list entry away.
      | MainPrompt when launched.isExiting -> launched
      | MainPrompt ->
        // Nothing took the screen. Undo the push and resume this page, rather than stranding the user at a
        // prompt they didn't ask for. Only pop when the stack is the length we left it: a command that
        // manipulated the stack itself owns it, and popping blindly would take the wrong entry.
        let resumed = Page.SubApp(newApp.onResume ())
        if (Stdlib.List.length launched.pageStack) == ((Stdlib.List.length state.pageStack) + 1) then
          { launched with
              currentPage = resumed
              pageStack = Stdlib.List.drop launched.pageStack 1 }
        else
          { launched with currentPage = resumed }
      | _ -> launched
    | LaunchPrompt ->
      // Drop to the classic prompt, pushing this page. Stopping the session releases the alternate screen so
      // the inline prompt renders in normal scrollback; `quit` there pops back (see Quit.execute).
      newApp.onTerminate ()
      { state with
          pageStack = Stdlib.List.append [ Page.SubApp newApp ] state.pageStack
          currentPage = Page.MainPrompt }


/// The most a single coalesced burst may be applied. See the fold in `runInteractiveLoop`.
val maxKeyRepeat = 64

module Update =
  let updateAppState (state: AppState) (msg: Msg) : AppState =
    match msg with
    | ProcessInput input ->
      Commands.parseAndExecute state input
    | KeyPressed (key, modifiers, keyChar) ->
      handleKeyInput state key modifiers keyChar
    | Exit ->
      { clearPromptRegion state with isExiting = true }

  let processInput (state: AppState) (input: String) : AppState =
    let trimmedInput = Stdlib.String.trim input
    if Stdlib.String.isEmpty trimmedInput then
      state
    else
      let msg = Msg.ProcessInput trimmedInput
      updateAppState state msg


let runInteractiveLoop (state: AppState) : Int =
  if state.isExiting then
    // Clear any retained prompt region so the shell prompt takes its place.
    let _cleared = clearPromptRegion state
    0
  else
    let tLoopStart = if state.telemetryEnabled then Telemetry.now () else 0
    if state.telemetryEnabled then
      let _ = LanguageTools.InterpreterStats.reset ()
      ()

    let location = locationStr state
    // Sampled once per pass. A resize while idle still repaints: SIGWINCH wakes the blocking read (see
    // Stdin.fs) with a keypress nobody handles, which sends us round again and re-samples here.
    let size = Tui.TerminalSession.currentSize ()

    let tHint = if state.telemetryEnabled then Telemetry.now () else 0
    let hintCached = state.cachedHintInput == state.prompt.text
    // Two tiers. The exact-text tier serves repaints (a resize, a redraw with no typing). The context tier
    // serves *typing*: "Sta" typed one key at a time is three different prompt strings but one completion
    // context, so the DB-hitting half runs once for the word instead of once per character.
    let contextKey = Registry.completionContextKey location state.prompt.text
    let contextCached = state.cachedCompletionKey == contextKey
    let contextItems =
      if contextCached then
        state.cachedCompletionItems
      else
        Registry.getCompletionsForContext state state.prompt.text
    // The narrowing base is only meaningful within one context; a context change invalidates it.
    let (prevPartial, prevItems) =
      if contextCached then
        (state.cachedFilterPartial, state.cachedFilterItems)
      else
        ("", [])
    let (hint, filterPartial, filterItems) =
      if hintCached then
        // `prevPartial`/`prevItems`, not the raw cached fields: a context change has to invalidate the
        // narrowing base here too, or a cache hit on the prompt text would carry the previous context's
        // items forward. Unreachable today (changing location goes through a command, which also changes
        // the prompt text), but it's one edit away from being live and the failure would be wrong
        // completions rather than slow ones.
        (state.cachedHintValue, prevPartial, prevItems)
      else
        Registry.getCompletionHintFromContext
          state
          state.prompt.text
          contextItems
          prevPartial
          prevItems
    if state.telemetryEnabled then
      Telemetry.logWithContext "completionHint" tHint [("inputLen", Stdlib.Int.toString (Stdlib.String.length state.prompt.text)); ("cached", Stdlib.Bool.toString hintCached); ("contextCached", Stdlib.Bool.toString contextCached)]

    // Display current page
    let tRender = if state.telemetryEnabled then Telemetry.now () else 0

    let renderedState =
      match state.currentPage with
      | MainPrompt ->
        let tView = if state.telemetryEnabled then Telemetry.now () else 0
        let promptView =
          withModeHint
            state
            (Prompt.Display.viewAtSize state.prompt location hint size)
        if state.telemetryEnabled then
          Telemetry.log "render.buildView" tView
        match state.promptTerminal with
        | Some terminal ->
          let tPresent = if state.telemetryEnabled then Telemetry.now () else 0
          let nextTerminal =
            Tui.TerminalSession.presentAtSize
              terminal
              size
              promptView
          if state.telemetryEnabled then
            Telemetry.log "render.present" tPresent
          { state with
              promptTerminal =
                Stdlib.Option.Option.Some nextTerminal }
        | None ->
          match Tui.TerminalSession.startAtSize size promptView with
          | Ok terminal ->
            { state with
                promptTerminal =
                  Stdlib.Option.Option.Some terminal }
          | Error message ->
            Stdlib.printLine message
            { state with isExiting = true }

      | InteractiveNav _ ->
        // Navigation presents on start and state transitions so its Page
        // retains the corresponding renderer history.
        state

      | CompletionPicker _ ->
        // The retained inline session presents on launch and transitions.
        state

      | SubApp app ->
        app.onDisplay ()
        state

    if renderedState.isExiting then
      // Nothing rendered because the terminal can't host the UI (not a tty, TERM=dumb, ...). The message is
      // already printed; blocking on a keystroke we'd immediately discard just makes it look hung. Non-zero
      // because "I can't run here" isn't a successful run.
      1
    else

      if renderedState.telemetryEnabled then
        let pageName =
          match renderedState.currentPage with
          | MainPrompt -> "MainPrompt"
          | InteractiveNav _ -> "InteractiveNav"
          | CompletionPicker _ -> "CompletionPicker"
          | SubApp _ -> "SubApp"
        Telemetry.logWithContext "render" tRender [("page", pageName)]
        Telemetry.log "preInput" tLoopStart

      // Read keystroke input
      let tReadKey =
        if renderedState.telemetryEnabled then Telemetry.now () else 0
      let keyInput = Stdlib.Cli.Stdin.readKey ()

      // Process the key. A coalesced burst (a mouse wheel, or a held-down key) arrives as one read with a
      // repeat count; applying it here means every page gets wheel-aware scrolling without knowing about it,
      // and the burst costs one loop iteration instead of one per event.
      //
      // Only movement repeats. A burst of Enter or Escape is coalesced too, but acting on it twenty times
      // would turn a stray wheel-click-on-the-wrong-key into twenty actions; movement is the case where
      // "do it N times" is unambiguously what was meant.
      let keyPressedMsg = Msg.KeyPressed (keyInput.key, keyInput.modifiers, Stdlib.Option.Option.Some keyInput.keyChar)
      let repeatable =
        match keyInput.key with
        | UpArrow | DownArrow | LeftArrow | RightArrow | PageUp | PageDown -> true
        | _ -> false
      // Cap the burst. `repeat` is however many events the terminal had buffered, and while the reader bounds
      // how long it drains, it doesn't bound how many it counts; a pathological producer shouldn't turn one
      // keypress into an unbounded interpreter loop.
      let times =
        if repeatable then Stdlib.Int.min maxKeyRepeat (Stdlib.Int.max 1 keyInput.repeat) else 1
      // A page transition ends the burst. Movement can cause one - a SubApp may return Exit or hand off to
      // another page on an arrow - and the rest of a burst must not be delivered to a page that never saw its
      // start. `pageStack` depth changes on every push and pop, so it's the cheap signal for "we're somewhere
      // else now"; `isExiting` covers leaving altogether.
      let startingDepth = Stdlib.List.length renderedState.pageStack
      // Sampled BEFORE the fold, which is the work being measured. Sampling after it and passing that as
      // the start instead times the preceding log call, and reports ~0 ms no matter how slow the fold is.
      let tUpdate = if renderedState.telemetryEnabled then Telemetry.now () else 0
      let newState =
        Stdlib.List.range 1 times
        |> Stdlib.List.fold renderedState (fun st _i ->
          if st.isExiting || (Stdlib.List.length st.pageStack) != startingDepth then st
          else Update.updateAppState st keyPressedMsg)

      if renderedState.telemetryEnabled then
        Telemetry.logWithContext "readKey" tReadKey [("char", keyInput.keyChar)]
        Telemetry.logWithContext "update" tUpdate [("char", keyInput.keyChar); ("repeats", Stdlib.Int.toString times)]
        let loopWorkMs = (Telemetry.elapsedMs tLoopStart) - (Telemetry.elapsedMs tReadKey)
        let interpStats = LanguageTools.InterpreterStats.get ()
        Telemetry.logWithContext "loopWork" tLoopStart [("workMs", Stdlib.Int.toString loopWorkMs); ("interp", interpStats)]

      runInteractiveLoop {
        newState with
          cachedHintInput = renderedState.prompt.text
          cachedHintValue = hint
          cachedCompletionKey = contextKey
          cachedCompletionItems = contextItems
          cachedFilterPartial = filterPartial
          cachedFilterItems = filterItems
      }
