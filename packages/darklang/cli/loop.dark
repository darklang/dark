/// The interactive loop: key dispatch to the page that owns the screen, and the render/read pass.
///
/// Part of `Darklang.Cli`.
module Darklang.Cli

let handleKeyInput(state: AppState, key: Stdlib.Cli.Stdin.Key.Key, modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers, keyChar: Stdlib.Option.Option<String>): AppState =
  // Ctrl+C exits from any page
  if modifiers.ctrl && key == Stdlib.Cli.Stdin.Key.Key.C then
    let _terminated =
      match state.currentPage with
      | SubApp app -> app.onTerminate()
      | Inline -> ()
    { state with isExiting = true }
  else

  match state.currentPage with
  // Nobody owns the screen, so nobody takes keys. `runInteractiveLoop` never waits for one here.
  | Inline -> state

  | SubApp app ->
    let (action, newApp) = app.onKey(key, modifiers, keyChar)
    match action with
    | Continue ->
      { state with
          currentPage = Page.SubApp newApp }
    | Save ->
      // The app may come back changed: a failed write leaves a message on it.
      let saved = newApp.onSave()
      { state with
          currentPage = Page.SubApp saved }
    | Exit ->
      newApp.onTerminate()
      // On the way out there's no frame left to say anything on, so whatever comes back is dropped.
      let _saved = newApp.onSave()
      match state.pageStack with
      | [returnTo, ...rest] ->
        // Launched from another page (e.g. a foreground app opened from the workbench). Return to the
        // launcher instead of quitting. `onTerminate` above tore down the launched app's surface, so the
        // launcher's retained session is stale — resume it to restart the session and repaint from scratch,
        // rather than poking the alternate screen directly.
        let resumed =
          match returnTo with
          | SubApp app -> Page.SubApp (app.onResume())
          | other -> other
        { state with currentPage = resumed, pageStack = rest }
      | [] ->
        // The workbench is the experience: leaving it leaves the CLI.
        { state with isExiting = true }
    | LaunchCommand cmd ->
      // Release this app's surface before the replacement command takes ownership, and push this page so the
      // launched page's exit returns here.
      newApp.onTerminate()
      let saved = Page.SubApp newApp
      // Launching from a live page is interactive by definition, even when the CLI itself was started
      // one-shot (`dark wb` takes the args path, which marks the session non-interactive). Without this, a
      // command that degrades when non-interactive prints its summary and leaves, instead of taking the
      // screen: `:review` from a workbench opened with `dark wb` did exactly that, while the same command
      // from a workbench opened with a bare `dark` worked.
      //
      // Safe to clear: LaunchCommand always pushes onto the page stack, so the launched app's exit pops back
      // here rather than consulting this flag to decide whether to leave the CLI.
      //
      // `currentPage` is pointed at Inline before handing off, as a marker for "nobody took the screen".
      // It used to stay on this app, whose session `onTerminate` just stopped - so a command that bailed
      // before taking the terminal left a page that repaints nothing above a stack entry that never pops.
      // Inline is the only page that can be recognised afterwards: a SubApp holds nothing but functions,
      // so two of them can't be compared.
      // `cmd` is a whole line, not just a name: the `:` bar hands off `backups restore 3` with its
      // arguments. A naive space split.
      let words = (Stdlib.String.split(cmd, " ")) |> Stdlib.List.filter(fun w -> w != "")
      let (cmdName, cmdArgs) =
        match words with
        | [first, ...rest] -> (first, rest)
        | [] -> ("", [])
      let launched =
        Registry.executeCommand(
          cmdName,
          { state with
              currentPage = Page.Inline
              pageStack = Stdlib.List.prepend(state.pageStack, saved)
              nonInteractive = false },
          cmdArgs)
      match launched.currentPage with
      // A command that asked to end the CLI gets to: resuming would re-enter the alternate screen and then the
      // loop would return with nobody to tear it down, leaving the terminal in it. Nothing reachable through
      // LaunchCommand exits today, but `quit` has exactly this shape, so it's one list entry away.
      | Inline when launched.isExiting -> launched
      | Inline ->
        // Nothing took the screen: the command ran inline in normal scrollback (a question flow,
        // a confirm, an $EDITOR -- see `Registry.promptsForInput`), or bailed before starting its
        // TUI. Either way its output is about to be covered by the alternate screen, so hold
        // until acknowledged rather than flashing it away.
        let _ = Stdlib.printError(Stdlib.Cli.UI.Colors.dimText("\n-- Enter to return to the workbench --"))
        let _ = Stdlib.Cli.Stdin.readLine()
        // Undo the push and resume this page. Only pop when the stack is the length we left it: a command that
        // manipulated the stack itself owns it, and popping blindly would take the wrong entry.
        let resumed = Page.SubApp(newApp.onResume())
        if (Stdlib.List.length(launched.pageStack)) == ((Stdlib.List.length(state.pageStack)) + 1) then
          { launched with
              currentPage = resumed
              pageStack = Stdlib.List.drop(launched.pageStack, 1) }
        else
          { launched with currentPage = resumed }
      | _ -> launched


/// The most a single coalesced burst may be applied. See the fold in `applyKeyRead`.
val maxKeyRepeat = 64

/// The page's name, for telemetry.
let pageName(page: Page): String =
  match page with
  | Inline -> "Inline"
  | SubApp _ -> "SubApp"


/// How many times one read's key should be applied.
let burstTimes(keyInput: Stdlib.Cli.Stdin.KeyRead.KeyRead): Int =
  // Only movement repeats. A burst of Enter or Escape is coalesced too, but acting on it twenty times
  // would turn a stray wheel-click-on-the-wrong-key into twenty actions; movement is the case where
  // "do it N times" is unambiguously what was meant.
  let repeatable =
    match keyInput.key with
    | UpArrow | DownArrow | LeftArrow | RightArrow | PageUp | PageDown -> true
    | _ -> false
  // Cap the burst. `repeat` is however many events the terminal had buffered, and while the reader bounds
  // how long it drains, it doesn't bound how many it counts; a pathological producer shouldn't turn one
  // keypress into an unbounded interpreter loop.
  if repeatable then Stdlib.min(maxKeyRepeat, Stdlib.max(1, keyInput.repeat)) else 1


/// Apply one read's worth of input to the state, `times` times (see `burstTimes`).
let applyKeyRead(
  state: AppState,
  keyInput: Stdlib.Cli.Stdin.KeyRead.KeyRead,
  times: Int)
  : AppState =
  let keyChar = Stdlib.Option.Option.Some keyInput.keyChar
  // A page transition ends the burst. Movement can cause one - a SubApp may return Exit or hand off to
  // another page on an arrow - and the rest of a burst must not be delivered to a page that never saw its
  // start. `pageStack` depth changes on every push and pop, so it's the cheap signal for "we're somewhere
  // else now"; `isExiting` covers leaving altogether.
  let startingDepth = Stdlib.List.length(state.pageStack)
  Stdlib.List.range(1, times)
  |> Stdlib.List.fold(state, fun st _i ->
    if st.isExiting || (Stdlib.List.length(st.pageStack)) != startingDepth then st
    else handleKeyInput(st, keyInput.key, keyInput.modifiers, keyChar))


let runInteractiveLoop(state: AppState): Int =
  if state.isExiting then
    0
  else
  match state.currentPage with
  // Nothing owns the screen and nothing is waiting under it, so there is nothing left to run.
  | Inline -> state.exitCode
  | SubApp app ->
    let tLoopStart = if state.telemetryEnabled then Telemetry.now() else 0
    if state.telemetryEnabled then
      let _ = LanguageTools.InterpreterStats.reset()
      ()

    // Display current page
    let tRender = if state.telemetryEnabled then Telemetry.now() else 0
    app.onDisplay()

    if state.telemetryEnabled then
      Telemetry.logWithContext("render", tRender, [("page", pageName(state.currentPage))])
      Telemetry.log("preInput", tLoopStart)

    // Wait for a key, or for the package store to change under the page. The waiting is
    // `Stdlib.Host.await`'s business; this loop only says what it is waiting for. A resize while idle
    // still repaints: SIGWINCH wakes the blocking read (see Stdin.fs) with a keypress nobody handles,
    // which sends us round again.
    let tReadKey =
      if state.telemetryEnabled then Telemetry.now() else 0

    let newState =
      match Stdlib.Host.await([ Stdlib.Host.EventSpec.Key, Stdlib.Host.EventSpec.StoreChanged ]) with
      | Key keyInput ->
        // Process the key. A coalesced burst (a mouse wheel, or a held-down key) arrives as one read
        // with a repeat count; applying it here means every page gets wheel-aware scrolling without
        // knowing about it, and the burst costs one loop iteration instead of one per event.
        let times = burstTimes(keyInput)
        // Sampled BEFORE the fold, which is the work being measured. Sampling after it and passing
        // that as the start instead times the preceding log call, and reports ~0 ms no matter how
        // slow the fold is.
        let tUpdate = if state.telemetryEnabled then Telemetry.now() else 0
        let newState = applyKeyRead(state, keyInput, times)

        if state.telemetryEnabled then
          Telemetry.logWithContext("readKey", tReadKey, [("char", keyInput.keyChar)])
          Telemetry.logWithContext("update", tUpdate, [("char", keyInput.keyChar), ("repeats", Stdlib.toString(times))])
          let loopWorkMs = (Telemetry.elapsedMs(tLoopStart)) - (Telemetry.elapsedMs(tReadKey))
          let interpStats = LanguageTools.InterpreterStats.get()
          Telemetry.logWithContext("loopWork", tLoopStart, [("workMs", Stdlib.toString(loopWorkMs)), ("interp", interpStats)])

        newState
      | StoreChanged change ->
        // A full-screen page re-reads what it shows.
        { state with currentPage = Page.SubApp(app.onStoreChanged(change)) }
      | _ -> state

    runInteractiveLoop(newState)
