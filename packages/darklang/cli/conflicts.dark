module Darklang.Cli.Conflicts

// `dark conflicts` — review + adjudicate sync divergences. When two instances edit the same name, sync
// auto-resolves by last-writer-wins but records the divergence here (never silent). You can acknowledge the
// auto choice, or override it — an override mints a SYNCED Resolution that propagates so peers converge on
// your pick.

let conflicts () : List<Darklang.Sync.Conflicts.Conflict> =
  Darklang.Sync.Conflicts.list ()

let short (h: String) : String =
  Stdlib.String.slice h 0 8

// The leaf name of a location ("Stachu.Lib.greet" -> "greet").
let leafName (location: String) : String =
  match Stdlib.List.last (Stdlib.String.split location ".") with
  | Some n -> n
  | None -> location

let unreviewed () : List<Darklang.Sync.Conflicts.Conflict> =
  Stdlib.List.filter (conflicts ()) (fun c -> c.status == "auto-resolved")

let findOpen
  (location: String)
  : Stdlib.Option.Option<Darklang.Sync.Conflicts.Conflict> =
  Stdlib.List.findFirst (unreviewed ()) (fun c -> c.location == location)

let noneMsg (location: String) : String =
  $"No open conflict at {location}. See: dark conflicts"

// The unreviewed conflict at a location, if any. One name holds one item, so there's at most one — no kind
// to disambiguate, which is why these commands take a location and nothing else.
let openAt (location: String) : Stdlib.Option.Option<Darklang.Sync.Conflicts.Conflict> =
  Stdlib.List.findFirst (unreviewed ()) (fun c -> c.location == location)


// Shared resolution flow for keep-mine/keep-theirs/ok: find the conflict, run <act> on it, report.
let resolveCmd
  (state: AppState)
  (rest: List<String>)
  (verb: String)
  (act: Darklang.Sync.Conflicts.Conflict -> Bool)
  (okMsg: Darklang.Sync.Conflicts.Conflict -> String)
  : AppState =
  match rest with
  | [ location ] ->
    let _ =
      match openAt location with
      | Some c ->
        if act c then
          Stdlib.printLine (Colors.success (okMsg c))
        else
          Stdlib.printLine (Colors.error (noneMsg location))
      | None -> Stdlib.printLine (Colors.error (noneMsg location))

    state
  | _ ->
    Stdlib.printLine (Colors.error $"usage: dark conflicts {verb} <loc>")

    state

// Pretty-print one candidate's actual content (its source), indented, so `show` lets you compare the two
// versions by WHAT THEY ARE — not just opaque hashes. pmGet* return the always-present PT definition (pt_def,
// never NULL), so both sides always render even when one isn't the active pick; falls back to the short hash
// if a version somehow can't be loaded.
let renderContent
  (branchId: Uuid)
  (location: String)
  (itemKind: String)
  (hashStr: String)
  : String =
  let hash = LanguageTools.ProgramTypes.Hash.Hash hashStr
  let ctx =
    PrettyPrinter.ProgramTypes.Context
      { branchId = branchId
        currentModule = Stdlib.Option.Option.None
        currentFunction = Stdlib.Option.Option.None }
  // Resolve the hash across kinds rather than by the conflict's stored `itemKind`. A hash is
  // content-addressed and kind-agnostic, and a CROSS-KIND conflict (one side bound the name to a value, the
  // other to a fn — reachable since a name holds ONE item regardless of kind, post one-name-one-item) stores
  // only the INCOMING side's kind. Rendering the local ("yours") hash by that kind looked up the wrong table
  // and fell to "content unavailable", even though the item is right there. Exactly one pmGet* matches a given
  // hash, so trying all three (the itemKind param is now just a legacy hint) shows both sides every time.
  let rendered =
    match Builtin.pmGetValue hash with
    | Some e ->
      Stdlib.Option.Option.Some(PrettyPrinter.ProgramTypes.packageValue ctx e)
    | None ->
      match Builtin.pmGetFn hash with
      | Some e -> Stdlib.Option.Option.Some(PrettyPrinter.ProgramTypes.packageFn ctx e)
      | None ->
        match Builtin.pmGetType hash with
        | Some e ->
          Stdlib.Option.Option.Some(PrettyPrinter.ProgramTypes.packageType ctx e)
        | None -> Stdlib.Option.Option.None
  match rendered with
  | Some src ->
    // A name isn't part of an item's content-addressed hash — the pretty-printer
    // resolves it from the live binding. The NON-ACTIVE candidate's hash has no
    // live binding, so it renders the item's own name as "<hash:SHORT>". We know
    // the real name (the conflict's location), so restore it for a readable diff.
    let restored =
      Stdlib.String.replaceAll
        src
        $"<hash:{LanguageTools.ProgramTypes.hashToShort hash}>"
        (leafName location)
    let indentedLines =
      Stdlib.List.map (Stdlib.String.split restored "\n") (fun line -> $"      {line}")
    Stdlib.String.join indentedLines "\n"
  | None -> $"      <{short hashStr}> (content unavailable)"

// A one-line preview of a candidate — for the conflict LIST, so you see WHAT each side set the name to at a
// glance without running `show`. It shows the DEFINITION BODY (the part after the first " = "): for a value
// that's the expression ("111"), for a fn the body ("(\"Hello, \") ++ name"), for a type the shape
// ("{ x: Int; y: Int }"). The name/signature is dropped — it's the same on both sides (and shown in the list
// header), so the body is the only thing that actually differs. Collapsed to one line and truncated to fit.
let renderInline
  (branchId: Uuid)
  (location: String)
  (itemKind: String)
  (hashStr: String)
  : String =
  // Collapse the (indented, possibly multi-line) render to a single trimmed line.
  let oneLine =
    Stdlib.String.split (renderContent branchId location itemKind hashStr) "\n"
    |> Stdlib.List.map (fun s -> Stdlib.String.trim s)
    |> Stdlib.List.filter (fun s -> s != "")
    |> Stdlib.String.join " "
  // Everything after the first " = " is the body (rejoin so a body containing " = " survives).
  let body =
    match Stdlib.String.split oneLine " = " with
    | [] -> oneLine
    | [ _ ] -> oneLine
    | _ :: rest -> Stdlib.String.join rest " = "
  let body = Stdlib.String.trim body
  if Stdlib.String.length body > 56 then
    (Stdlib.String.slice body 0 56) ++ "…"
  else
    body

// The static conflict list: header, each conflict's two sides stacked, and the commands to resolve them.
// Shown for `dark conflicts list`, and for a bare `dark conflicts` when non-interactive (one-shot / piped).
let printOpenList
  (state: AppState)
  (cs: List<Darklang.Sync.Conflicts.Conflict>)
  : AppState =
  let n = Stdlib.List.length cs
  let noun = if n == 1 then "conflict" else "conflicts"
  Stdlib.printLine $"{Stdlib.Int.toString n} unreviewed {noun}:"

  let branchId = state.currentBranchId
  Stdlib.List.iter cs (fun c ->
    let yoursV = renderInline branchId c.location c.itemKind c.localHash
    let theirsV = renderInline branchId c.location c.itemKind c.incomingHash
    let activeSide = if c.chosenHash == c.incomingHash then "theirs" else "yours"
    Stdlib.printLine ""
    Stdlib.printLine $"  {c.location} ({c.itemKind})"
    Stdlib.printLine (Colors.hint $"    yours:  {yoursV}")
    Stdlib.printLine (Colors.hint $"    theirs: {theirsV}")
    Stdlib.printLine (Colors.hint $"    active: {activeSide} ({c.resolvedBy})"))

  Stdlib.printLine ""
  Stdlib.printLine (Colors.hint "  What you can do:")
  Stdlib.printLine (Colors.hint "    dark conflicts show <loc>        see both versions in full")
  Stdlib.printLine (Colors.hint "    dark conflicts keep-mine <loc>   keep yours (syncs to peers)")
  Stdlib.printLine (Colors.hint "    dark conflicts keep-theirs <loc> keep theirs (syncs to peers)")
  Stdlib.printLine (Colors.hint "    dark conflicts ok <loc>          accept the auto pick, review done")
  state

// Step through each conflict: show both sides, pick mine / theirs / skip. Shown for a bare `dark conflicts`
// in an interactive session — the same `nonInteractive` gate `review`/`nav` use, so a one-shot/piped run falls
// back to `printOpenList`. Line prompts, no alternate screen — deliberately minimal; keep-mine/keep-theirs
// still exist for scripting one at a time.
let resolveInteractively
  (state: AppState)
  (cs: List<Darklang.Sync.Conflicts.Conflict>)
  : AppState =
  let branchId = state.currentBranchId
  let n = Stdlib.List.length cs
  let noun = if n == 1 then "conflict" else "conflicts"
  Stdlib.printLine $"{Stdlib.Int.toString n} {noun} to review — pick a side for each (or skip):"

  Stdlib.List.iter cs (fun c ->
    let yoursActive = if c.chosenHash == c.localHash then "  (auto pick)" else ""
    let theirsActive = if c.chosenHash == c.incomingHash then "  (auto pick)" else ""
    Stdlib.printLine ""
    Stdlib.printLine $"  {c.location} ({c.itemKind})"
    Stdlib.printLine $"  yours   {short c.localHash}{yoursActive}"
    Stdlib.printLine (renderContent branchId c.location c.itemKind c.localHash)
    Stdlib.printLine $"  theirs  {short c.incomingHash}{theirsActive}"
    Stdlib.printLine (renderContent branchId c.location c.itemKind c.incomingHash)

    let choice =
      Stdlib.Cli.UI.Prompt.select
        $"  keep which for {leafName c.location}?"
        [ "mine"; "theirs"; "skip (decide later)" ]

    match choice with
    | "mine" ->
      if Darklang.Sync.Conflicts.keep c.location c.localHash then
        Stdlib.printLine (Colors.success "    kept yours — syncs to peers")
      else
        Stdlib.printLine (Colors.error "    couldn't apply — still open")
    | "theirs" ->
      if Darklang.Sync.Conflicts.keep c.location c.incomingHash then
        Stdlib.printLine (Colors.success "    kept theirs — syncs to peers")
      else
        Stdlib.printLine (Colors.error "    couldn't apply — still open")
    | _ -> Stdlib.printLine (Colors.hint "    skipped — still open"))

  Stdlib.printLine ""
  Stdlib.printLine (Colors.hint "Run `dark sync` to share your picks with peers.")
  state

let help (_state: AppState) : String =
  [ "dark conflicts — review + resolve sync divergences"
    ""
    "  dark conflicts                   review them one at a time (a plain list if piped)"
    "  dark conflicts list              just print the unreviewed conflicts"
    "  dark conflicts show <loc>        the two candidate contents"
    "  dark conflicts ok <loc>          acknowledge (the auto choice stands)"
    "  dark conflicts keep-mine <loc>   override: keep your version (syncs)"
    "  dark conflicts keep-theirs <loc> override: keep their version (syncs)"
    ""
    "  `ok` reviews it HERE only — the auto pick stands and nothing tells your peers."
    "  `keep-mine`/`keep-theirs` mint a synced Resolution, so the conflict clears on peers too." ]
  |> Stdlib.String.join "\n"

let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] ->
    match unreviewed () with
    | [] ->
      Stdlib.printLine (Colors.success "No conflicts — everything's converged.")
      state
    // Bare `dark conflicts` in a session walks you through each; one-shot/piped prints the list to act on.
    | cs ->
      if state.nonInteractive then printOpenList state cs else resolveInteractively state cs

  | [ "list" ] ->
    match unreviewed () with
    | [] ->
      Stdlib.printLine (Colors.success "No conflicts — everything's converged.")
      state
    | cs -> printOpenList state cs

  | [ "show"; location ] ->
    match findOpen location with
    | Some c ->
      let branchId = state.currentBranchId
      let yoursActive =
        if c.chosenHash == c.localHash then "  (active — auto:last-writer-wins)" else ""
      let theirsActive =
        if c.chosenHash == c.incomingHash then "  (active — auto:last-writer-wins)" else ""

      Stdlib.printLine $"{c.location} — two versions ({c.itemKind}):"
      Stdlib.printLine ""
      Stdlib.printLine $"  yours   {short c.localHash}{yoursActive}"
      Stdlib.printLine (renderContent branchId c.location c.itemKind c.localHash)
      Stdlib.printLine ""
      Stdlib.printLine $"  theirs  {short c.incomingHash}{theirsActive}"
      Stdlib.printLine (renderContent branchId c.location c.itemKind c.incomingHash)
      Stdlib.printLine ""

      Stdlib.printLine (
        Colors.hint $"  keep yours:   dark conflicts keep-mine {location}")

      Stdlib.printLine (
        Colors.hint $"  keep theirs:  dark conflicts keep-theirs {location}")

      state
    | None ->
      Stdlib.printLine (Colors.error (noneMsg location))
      state

  | "ok" :: rest ->
    resolveCmd state rest "ok" (fun c ->
      Darklang.Sync.Conflicts.acknowledge c.location) (fun c ->
      let active =
        renderInline state.currentBranchId c.location c.itemKind c.chosenHash

      $"OK — {c.location} stays {active}   (reviewed here only; the auto pick stands)")

  | "keep-mine" :: rest ->
    resolveCmd state rest "keep-mine" (fun c -> Darklang.Sync.Conflicts.keep c.location c.localHash) (fun c ->
      let mine = renderInline state.currentBranchId c.location c.itemKind c.localHash

      let theirs =
        renderInline state.currentBranchId c.location c.itemKind c.incomingHash

      $"OK — {c.location} will be {mine}, not {theirs}   (syncs to your peers)")

  | "keep-theirs" :: rest ->
    resolveCmd state rest "keep-theirs" (fun c -> Darklang.Sync.Conflicts.keep c.location c.incomingHash) (fun c ->
      let mine = renderInline state.currentBranchId c.location c.itemKind c.localHash

      let theirs =
        renderInline state.currentBranchId c.location c.itemKind c.incomingHash

      $"OK — {c.location} will be {theirs}, not {mine}   (syncs to your peers)")

  | _ ->
    Stdlib.printLine (help state)
    state

let complete
  (state: AppState)
  (args: List<String>)
  : List<Completion.CompletionItem> =
  match args with
  | [] ->
    [ "list"; "show"; "ok"; "keep-mine"; "keep-theirs" ]
    |> Stdlib.List.map Completion.simple
  | _ -> []
