/// The terminal UI layer: the span canvas, Unicode-aware text, inline frame diffing, and session
/// lifecycle through the `Prepared` seam (so none of this needs a real terminal).
///
/// Part of `Darklang.Cli.Suite`.
module Darklang.Cli.Suite

// ── Workbench canvas (spans -> rows) ──

let canvasRegion () : Darklang.Stdlib.Cli.UI.Layout.Region =
  Darklang.Stdlib.Cli.UI.Layout.Region { top = 1; left = 1; rows = 4; cols = 10 }


let canvasRow (spans: List<Darklang.Stdlib.Cli.UI.Layout.Span>) : String =
  Darklang.Stdlib.Cli.UI.Canvas.compose 10 2 spans
  |> Stdlib.List.head
  |> Stdlib.Option.withDefault ""
  |> Darklang.Stdlib.Cli.Tui.Text.stripSgr


let testCanvasPlacesSpans (): TestResult =
  let region = canvasRegion ()
  let spans = Darklang.Stdlib.Cli.UI.Layout.at region 0 2 "hi"
  let row = canvasRow spans

  // No trailing pad: the renderer erases each row before writing it, so padding would be bytes on the wire
  // for nothing, and unpadded rows compare equal across frames more often.
  if row == "  hi" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected span at column 2, got '{row}'"


let testCanvasLayersLaterSpans (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Stdlib.Cli.UI.Layout.at region 0 0 "aaaaa"
        Darklang.Stdlib.Cli.UI.Layout.at region 0 2 "BB" ]
  let row = canvasRow spans

  // The later span wins. Where it lands inside an earlier one, the earlier one's right-hand remainder is
  // dropped rather than split in two: the only thing that ever gets covered this way is the uniform blank
  // padding an overlay lays down first, and the renderer erases each row before writing it, so a row that
  // stops early is indistinguishable from one padded out with spaces.
  if row == "aaBB" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected later span to layer over earlier, got '{row}'"


let testCanvasWideGlyphOccupiesTwoColumns (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Stdlib.Cli.UI.Layout.at region 0 0 "界"
        Darklang.Stdlib.Cli.UI.Layout.at region 0 2 "X" ]
  let row = canvasRow spans

  // The wide glyph eats two cells, so the next span still lands where it was asked to: no gap, no overlap.
  if row == "界X" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected wide glyph to occupy two columns, got '{row}'"


let testCanvasStylingIsZeroWidth (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Stdlib.Cli.UI.Layout.at region 0 0 (Stdlib.Cli.UI.Colors.info "ab")
        Darklang.Stdlib.Cli.UI.Layout.at region 0 2 "cd" ]
  let row = canvasRow spans

  // Colour codes carry no width, so the second span is not pushed sideways by them.
  if row == "abcd" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected SGR to consume no columns, got '{row}'"


let testCanvasUntouchedRowsAreEmpty (): TestResult =
  let region = canvasRegion ()
  let spans = Darklang.Stdlib.Cli.UI.Layout.at region 0 0 "x"
  let rows = Darklang.Stdlib.Cli.UI.Canvas.compose 10 3 spans

  match Stdlib.List.getAt rows 1 with
  | Some second ->
    // Rows nobody painted stay empty so they compare equal frame to frame and cost no redraw.
    if second == "" && Stdlib.List.length rows == 3 then
      TestResult.Pass
    else
      TestResult.Fail $"Expected untouched rows to be empty, got '{second}'"
  | None -> TestResult.Fail "Expected three composed rows"


// -- Stdlib.Cli.Tui.Text: fitting styled rows to a column count --

let testTextClipsByColumnsNotCharacters (): TestResult =
  let clipped = Stdlib.Cli.Tui.Text.clipToWidth "\u001b[31mabcdef" 3

  // SGR carries no width, so 3 columns means 3 visible characters, styling retained.
  if Stdlib.Cli.Tui.Text.stripSgr clipped == "abc" && Stdlib.String.contains clipped "\u001b[31m" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected styled clip to 'abc', got '{Stdlib.Cli.Tui.Text.stripSgr clipped}'"


let testTextNeverSplitsAWideGlyph (): TestResult =
  // Two double-width glyphs in three columns: the second cannot fit, and half of it must not be emitted.
  let clipped = Stdlib.Cli.Tui.Text.clipToWidth "界界" 3

  if Stdlib.String.displayWidth clipped == 2 then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected a wide glyph to be dropped whole, got width {Stdlib.Int.toString (Stdlib.String.displayWidth clipped)}"


let testTextDropsNonSgrEscapes (): TestResult =
  // A cursor-forward escape in dynamic content must not survive into a row: rows are text, not commands.
  let normalized = Stdlib.Cli.Tui.Text.normalizeToWidth "a\u001b[5Cb" 10

  if normalized == "ab" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected non-SGR escapes to be stripped, got '{normalized}'"


let testTextWrapReappliesStyleAcrossRows (): TestResult =
  let rows = Stdlib.Cli.Tui.Text.wrapAtColumn "\u001b[31mabcd" 2
  let first = Stdlib.List.getAt rows 0 |> Stdlib.Option.withDefault ""
  let second = Stdlib.List.getAt rows 1 |> Stdlib.Option.withDefault ""

  // The renderer resets style after every row, so a style spanning a wrap has to be restated on the next.
  if Stdlib.List.length rows == 2
     && Stdlib.Cli.Tui.Text.stripSgr first == "ab"
     && Stdlib.Cli.Tui.Text.stripSgr second == "cd"
     && Stdlib.String.contains second "\u001b[31m"
  then
    TestResult.Pass
  else
    TestResult.Fail "Expected wrapped rows to carry the active style onto the continuation row"


let testTextCursorAfterFullRowWraps (): TestResult =
  // Text that exactly fills the width leaves the cursor at the start of the following row, matching what
  // the terminal does. Prompt cursor placement depends on this.
  let (row, column) = Stdlib.Cli.Tui.Text.positionAfter "abcd" 4

  if row == 1 && column == 0 then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected (1, 0), got ({Stdlib.Int.toString row}, {Stdlib.Int.toString column})"


let testTextFitPadsByColumnsNotCharacters (): TestResult =
  // A wide glyph is one character in two columns, so padding by character count comes out short.
  let fitted = Stdlib.Cli.Tui.Text.fitToWidth "界a" 6

  if Stdlib.String.displayWidth fitted == 6 then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected 6 columns, got {Stdlib.Int.toString (Stdlib.String.displayWidth fitted)}"


let testTextFitIgnoresStylingWhenPadding (): TestResult =
  // Styling costs no columns, so a styled row pads to what its plain text would.
  let fitted = Stdlib.Cli.Tui.Text.fitToWidth "\u001b[31mab\u001b[0m" 5

  if Stdlib.Cli.Tui.Text.stripSgr fitted == "ab   " then
    TestResult.Pass
  else
    TestResult.Fail $"Expected 'ab' padded to 5 columns, got '{Stdlib.Cli.Tui.Text.stripSgr fitted}'"


let testTextWrapAtWordsBreaksAtSpaces (): TestResult =
  // The word wrapper stays in Dark, measuring whole words.
  let rows = Stdlib.Cli.Tui.Text.wrapAtWords "alpha beta gamma" 11

  if rows == [ "alpha beta", "gamma" ] then
    TestResult.Pass
  else
    TestResult.Fail $"Expected a break at the space, got {Stdlib.String.join rows " | "}"


// -- InlineFrame: relative addressing, the part that can wreck scrollback --

let inlineView (rows: List<String>) : Stdlib.Cli.Tui.View =
  Stdlib.Cli.Tui.View { rows = rows; cursor = Stdlib.Cli.Tui.Cursor.Hidden; mode = Stdlib.Cli.Tui.ViewMode.Inline }


let testInlineFrameEmitsNothingWhenUnchanged (): TestResult =
  let view = inlineView [ "a", "b" ]
  let output =
    Stdlib.Cli.Tui.InlineFrame.renderAtWidth 20 (Stdlib.Option.Option.Some view) view

  // An unchanged frame must write literally nothing, or an idle prompt would still churn the terminal.
  if output == "" then
    TestResult.Pass
  else
    TestResult.Fail "Expected an unchanged inline frame to emit no output"


let testInlineFrameMovesRelativeToPreviousCursor (): TestResult =
  let previous = inlineView [ "a", "b" ]
  let next = inlineView [ "a", "B" ]
  let output =
    Stdlib.Cli.Tui.InlineFrame.renderAtWidth 20 (Stdlib.Option.Option.Some previous) next

  // Only the changed row is rewritten, and it's addressed by moving from where the last frame left the
  // cursor rather than by absolute position, because inline rows travel with scrollback.
  if Stdlib.String.contains output "B"
     && Stdlib.Bool.not (Stdlib.String.contains output "a")
  then
    TestResult.Pass
  else
    TestResult.Fail $"Expected only the changed inline row to be rewritten, got '{output}'"


// -- TerminalSession lifecycle, through the `Prepared` seam that exists so this needs no real terminal --

let fullscreenView (rows: List<String>) : Stdlib.Cli.Tui.View =
  Stdlib.Cli.Tui.View { rows = rows; cursor = Stdlib.Cli.Tui.Cursor.Hidden; mode = Stdlib.Cli.Tui.ViewMode.Fullscreen }


let testSessionTakesAlternateScreenOnFirstPresent (): TestResult =
  let prepared =
    Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize
      (Stdlib.Cli.Tui.TerminalSession.init ())
      (Stdlib.Cli.Tui.Size { width = 20; height = 5 })
      (fullscreenView [ "hello" ])

  if Stdlib.String.contains prepared.output "\u001b[?1049h" then
    TestResult.Pass
  else
    TestResult.Fail "Expected the first fullscreen present to enter the alternate screen"


let testSessionSecondIdenticalPresentIsSilent (): TestResult =
  let size = Stdlib.Cli.Tui.Size { width = 20; height = 5 }
  let view = fullscreenView [ "hello" ]
  let first =
    Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize (Stdlib.Cli.Tui.TerminalSession.init ()) size view
  let second =
    Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize first.state size view

  // Presenting the same view again is the common case in a render loop; it must cost nothing.
  if second.output == "" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected a repeat present to emit nothing, got '{second.output}'"


let testSessionStopRestoresOnlyWhenRunning (): TestResult =
  let size = Stdlib.Cli.Tui.Size { width = 20; height = 5 }
  let started =
    Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize
      (Stdlib.Cli.Tui.TerminalSession.init ())
      size
      (fullscreenView [ "hello" ])
  let stopped = Stdlib.Cli.Tui.TerminalSession.prepareStop started.state
  let stoppedAgain = Stdlib.Cli.Tui.TerminalSession.prepareStop stopped.state

  // Stopping a live session leaves the alternate screen; stopping an already-stopped one is a no-op.
  if Stdlib.String.contains stopped.output "\u001b[?1049l" && stoppedAgain.output == "" then
    TestResult.Pass
  else
    TestResult.Fail "Expected stop to restore once and then be a no-op"


// ── Workbench: every view renders ──

/// A workbench state good enough to render, without touching the terminal.
let workbenchState () : Darklang.Cli.Workbench.State =
  Darklang.Cli.Workbench.initialState
    Darklang.SCM.Branch.mainBranchId
    Stdlib.Option.Option.None
    "test"
    "test-instance"
    // Every gateable view on, so the gated ones get rendered too.
    (Stdlib.List.range 0 40)


/// Render one view and report whether it produced a plausible frame.
let rendersView (viewIndex: Int) : Bool =
  let state = { (workbenchState ()) with activeView = viewIndex }
  let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }
  let view = Darklang.Cli.Workbench.viewAtSize state size
  // A frame is `height` rows, and a view that drew nothing at all is a bug even if it didn't crash.
  (Stdlib.List.length view.rows == 40)
  && (view.rows |> Stdlib.List.any (fun r -> (Stdlib.Cli.Tui.Text.stripSgr r) != ""))


/// The same for Matter's lenses. `Changed` is the interesting one: it reads the draft rather than the
/// package tree, so it is a different code path from the other two rather than a filter over the same one.
let rendersMatterLens (lens: Darklang.Cli.Workbench.Lens) : Bool =
  let base = workbenchState ()

  let state =
    { base with
        activeView = Darklang.Cli.Workbench.vMatter
        matter = Darklang.Cli.Workbench.MatterState { lens = lens } }

  let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }
  let view = Darklang.Cli.Workbench.viewAtSize state size

  (Stdlib.List.length view.rows == 40)
  && (view.rows |> Stdlib.List.any (fun r -> (Stdlib.Cli.Tui.Text.stripSgr r) != ""))


/// Matter's ITEM PAGE: the preview for a selected leaf, which is meta + source + access + references.
///
/// The deepest renderer in the workbench and the one nothing reached. It cannot be driven through the
/// terminal -- it is three interactions deep (open Matter, descend into a module, focus the preview) and
/// assertions stop being reliable past two, because the frame is painted as a diff. From state it is a
/// one-liner: put the location inside a real module so `loadItems` returns leaves rather than submodules,
/// and render.
let rendersMatterItemPage (path: List<String>) : Bool =
  let base = workbenchState ()
  let loc = Packages.PackageLocation.Module path
  let items = Darklang.Cli.Workbench.loadItems Darklang.SCM.Branch.mainBranchId loc

  // A path with no leaves would render the empty case and prove nothing, so say so rather than pass.
  if Stdlib.List.isEmpty items then
    false
  else
    let state =
      { base with
          activeView = Darklang.Cli.Workbench.vMatter
          location = loc
          items = items
          selected = 0
          focus = Stdlib.Cli.UI.SplitPane.Focus.Second }

    let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }
    let view = Darklang.Cli.Workbench.viewAtSize state size

    (Stdlib.List.length view.rows == 40)
    && (view.rows |> Stdlib.List.any (fun r -> (Stdlib.Cli.Tui.Text.stripSgr r) != ""))


let testWorkbenchItemPageRenders (): TestResult =
  // A module of fns, and one of types + values, because the item page branches on what the leaf IS.
  let paths = [ [ "Darklang", "Stdlib", "List" ], [ "Darklang", "Stdlib", "Option" ] ]

  let broken =
    paths |> Stdlib.List.filter (fun p -> Stdlib.Bool.not (rendersMatterItemPage p))

  if Stdlib.List.isEmpty broken then
    TestResult.Pass
  else
    let names =
      broken |> Stdlib.List.map (fun p -> Stdlib.String.join p ".") |> Stdlib.String.join ", "

    TestResult.Fail $"the item page drew nothing at: {names}"


/// Render one view's PREVIEW pane from state.
///
/// Opening a view draws its LIST; the preview is a separate function (`previewLines`) that nothing
/// reaches until something focuses it. That gap is measured, not assumed: with the Traces detail pane
/// deliberately broken, every assertion in `scripts/testing/gates workbench-views` still passed, because
/// none of them draw a preview. Focusing it through the terminal needs a third interaction, and the
/// frame diff stops being reliable past two -- so it belongs here, where rendering takes no terminal.
let rendersPreview (viewIndex: Int) : Bool =
  let base = workbenchState ()
  let state = { base with activeView = viewIndex }
  // A pane reads the SELECTED item, so a view with an empty list exercises only its empty case. That is
  // still worth running (it is the case a fresh store hits), and the item page has its own test.
  let lines = Darklang.Cli.Workbench.previewLines state
  // Any list at all, including an empty one, means it returned rather than raised. A pane that throws
  // takes this down loudly, which is the point.
  (Stdlib.List.length lines) >= 0


let testWorkbenchPreviewsRender (): TestResult =
  let broken =
    Darklang.Cli.Workbench.viewSpecs
    |> Stdlib.List.map (fun spec -> let (i, _name, _gate) = spec in i)
    |> Stdlib.List.filter (fun i -> Stdlib.Bool.not (rendersPreview i))

  if Stdlib.List.isEmpty broken then
    TestResult.Pass
  else
    let names = broken |> Stdlib.List.map Stdlib.Int.toString |> Stdlib.String.join ", "
    TestResult.Fail $"preview panes that drew nothing: {names}"


/// Every Matter lens draws a frame. No view has sections any more; the lenses are the one
/// remaining "same view, different list" switch, and `rendersView` only ever draws the default.
let testWorkbenchSectionsRender (): TestResult =
  let brokenLenses =
    [ Darklang.Cli.Workbench.Lens.WholeTree
      Darklang.Cli.Workbench.Lens.ValuesOnly
      Darklang.Cli.Workbench.Lens.Changed ]
    |> Stdlib.List.filter (fun l -> Stdlib.Bool.not (rendersMatterLens l))

  if Stdlib.List.isEmpty brokenLenses then
    TestResult.Pass
  else
    let nl = Stdlib.Int.toString (Stdlib.List.length brokenLenses)
    TestResult.Fail $"{nl} Matter lens(es) produced no frame"


let testWorkbenchEveryViewRenders (): TestResult =
  // Cheap guard for a renderer that type-checks and loads clean, then dies when the view opens.
  // Rendering is a pure function of state, so this needs no terminal. NB: a renderer that throws
  // takes the whole suite down (the harness does not catch runtime errors) -- caught either way,
  // just louder.
  let broken =
    Darklang.Cli.Workbench.viewSpecs
    |> Stdlib.List.map (fun spec -> let (i, _name, _gate) = spec in i)
    |> Stdlib.List.filter (fun i -> Stdlib.Bool.not (rendersView i))

  if Stdlib.List.isEmpty broken then
    TestResult.Pass
  else
    let names = broken |> Stdlib.List.map Stdlib.Int.toString |> Stdlib.String.join ", "
    TestResult.Fail $"Views produced no frame: {names}"


let testWorkbenchDiffLinesRenderThroughPipe (): TestResult =
  // Dark's pipe supplies its value as the first argument. Keep this call in
  // the same shape as the Home WIP preview so argument-order regressions fail
  // here instead of when the interactive workbench opens an edit.
  let rendered =
    [ Stdlib.Diff.DiffLine.Added "let added = 1"
      Stdlib.Diff.DiffLine.Removed "let removed = 2" ]
    |> Darklang.Cli.Workbench.renderDiffLines (workbenchState ())
  let plain =
    rendered
    |> Stdlib.List.map Stdlib.Cli.Tui.Text.stripSgr
    |> Stdlib.String.join "\n"
  if
    (Stdlib.List.length rendered == 2)
    && (Stdlib.String.contains plain "+ let added = 1")
    && (Stdlib.String.contains plain "- let removed = 2")
  then
    TestResult.Pass
  else
    TestResult.Fail "Expected piped diff lines to render additions and removals"


let testWorkbenchModuleInspectPreviewsChildren (): TestResult =
  let location =
    Darklang.Cli.Packages.PackageLocation.Module [ "Darklang" ]
  let items =
    Darklang.Cli.Workbench.loadItems
      Darklang.SCM.Branch.mainBranchId
      location
  let selected =
    Stdlib.List.findFirstIndex items (fun item -> item.name == "LspExtension")
    |> Stdlib.Option.withDefault 0
  let state =
    { (workbenchState ()) with
        activeView = Darklang.Cli.Workbench.vMatter
        location = location
        items = items
        selected = selected }
  let plain =
    Darklang.Cli.Workbench.previewLines state
    |> Stdlib.List.map Stdlib.Cli.Tui.Text.stripSgr
    |> Stdlib.String.join "\n"
  if
    (Stdlib.String.contains plain "LspExtension/")
    && (Stdlib.String.contains plain "FileSystemProvider/")
    && (Stdlib.String.contains plain "modules · ")
    && (Stdlib.String.contains plain "enter")
  then
    TestResult.Pass
  else
    TestResult.Fail "Expected Inspect to preview a module's immediate children, grouped by kind"


// ── Workbench: the nav walks ──

/// What the workbench dispatcher decided to do with a simulated keypress.
type WbAction =
  | Continued
  | Exited
  | Launched of command: String
  | Prompted

type WbResult =
  { state: Darklang.Cli.Workbench.State
    action: WbAction }

/// One keypress through the workbench's dispatcher in a plain-view context.
/// Keep the action beside the state: encoding Exit/Prompt as a fake status
/// message hid an unexpected Launch or ToPrompt.
let wbPress
  (state: Darklang.Cli.Workbench.State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (keyChar: Stdlib.Option.Option<String>)
  : WbResult =
  let mods = Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false; ctrl = false; shift = false }
  match Darklang.Cli.Workbench.handleKey state key mods keyChar with
  | Continue s -> WbResult { state = s; action = WbAction.Continued }
  | Exit s -> WbResult { state = s; action = WbAction.Exited }
  | Launch(s, cmd) -> WbResult { state = s; action = WbAction.Launched cmd }
  | ToPrompt s -> WbResult { state = s; action = WbAction.Prompted }

/// A printable key.
let wbChar (state: Darklang.Cli.Workbench.State) (c: String) : WbResult =
  wbPress state Stdlib.Cli.Stdin.Key.Key.NoName (Stdlib.Option.Option.Some c)

let wbKey
  (state: Darklang.Cli.Workbench.State)
  (k: Stdlib.Cli.Stdin.Key.Key)
  : WbResult =
  wbPress state k Stdlib.Option.Option.None

/// Move the nav cursor to a semantic row through the real key handler.
/// Tests care that REPL is reachable, not how many rows follow Code today.
/// The walking arrows depend on the nav's shape at the terminal size the
/// test runs under: along the strip, down the overlay.
let wbMoveNavbarTo
  (state: Darklang.Cli.Workbench.State)
  (matches: Darklang.Cli.Workbench.NavbarRow -> Bool)
  : Darklang.Cli.Workbench.State =
  let rows = Darklang.Cli.Workbench.navbarRows state 0 0
  match Stdlib.List.findFirstIndex rows matches with
  | None -> state
  | Some target ->
    let delta = target - state.navbarSel
    let steps = if delta < 0 then 0 - delta else delta
    let strip = Darklang.Cli.Workbench.navFitsNow ()
    let key =
      if delta < 0 then
        (if strip then Stdlib.Cli.Stdin.Key.Key.LeftArrow
         else Stdlib.Cli.Stdin.Key.Key.UpArrow)
      else
        (if strip then Stdlib.Cli.Stdin.Key.Key.RightArrow
         else Stdlib.Cli.Stdin.Key.Key.DownArrow)
    if steps == 0 then
      state
    else
      Stdlib.List.range 1 steps
      |> Stdlib.List.fold state (fun s _ -> (wbKey s key).state)

let wbMoveNavbarToDest
  (state: Darklang.Cli.Workbench.State)
  (dest: Darklang.Cli.Workbench.Dest)
  : Darklang.Cli.Workbench.State =
  wbMoveNavbarTo state (fun row -> row.dest == dest)

/// Is the nav cursor on the destination we expected?
let wbNavbarSelectionIsDest
  (state: Darklang.Cli.Workbench.State)
  (dest: Darklang.Cli.Workbench.Dest)
  : Bool =
  let rows = Darklang.Cli.Workbench.navbarRows state 0 0
  match Stdlib.List.getAt rows state.navbarSel with
  | Some row -> row.dest == dest
  | None -> false


let testWorkbenchNavbarNavigation (): TestResult =
  // End to end through `handleKey`: numbers jump to a view and hand the
  // keyboard to the content; esc goes back (never quits); arrows and ⏎ go to
  // a view; the nav is FLAT and no view has sections, so a number pressed
  // again stays put; a demoted view (Errors) is a key away from its parent
  // and lights the parent's item; q quits. Rendering is pure and so is this,
  // so it needs no terminal.
  let s0 = workbenchState ()
  let atStart =
    (s0.focus == Stdlib.Cli.UI.SplitPane.Focus.First)
    && (s0.activeView == Darklang.Cli.Workbench.vHome)
  // 2 → Code, landing on the tree with the content focused.
  let r1 = wbChar s0 "2"
  let s1 = r1.state
  let jumped =
    (r1.action == WbAction.Continued)
    && (s1.activeView == Darklang.Cli.Workbench.vMatter)
    && (Stdlib.Bool.not (Darklang.Cli.Workbench.navbarFocused s1))
    && (s1.focus == Stdlib.Cli.UI.SplitPane.Focus.First)
  // Esc at the top of the tree → back to Home, where 2 was pressed, content focused.
  let r2 = wbKey s1 Stdlib.Cli.Stdin.Key.Key.Escape
  let s2 = r2.state
  let backedOut =
    (r2.action == WbAction.Continued)
    && (s2.activeView == Darklang.Cli.Workbench.vHome)
    && (Stdlib.Bool.not (Darklang.Cli.Workbench.navbarFocused s2))
    && (Stdlib.List.isEmpty s2.back)
  // ` takes the nav, with the cursor on where you are.
  let s2n = (wbChar s2 "`").state
  let navTaken =
    (Darklang.Cli.Workbench.navbarFocused s2n)
    && (wbNavbarSelectionIsDest
      s2n
      (Darklang.Cli.Workbench.mkDest Darklang.Cli.Workbench.vHome 0))
  let atRepl =
    wbMoveNavbarToDest
      s2n
      (Darklang.Cli.Workbench.mkDest Darklang.Cli.Workbench.vScratch 0)
  let r3 = wbKey atRepl Stdlib.Cli.Stdin.Key.Key.Enter
  let s3 = r3.state
  let toRepl =
    (r3.action == WbAction.Continued)
    && (s3.activeView == Darklang.Cli.Workbench.vScratch)
    && (Stdlib.Bool.not (Darklang.Cli.Workbench.navbarFocused s3))
    && (s3.input == Stdlib.Option.Option.None)
  // The nav is one row per view: nothing under Changes, whichever section it is on.
  let rows = Darklang.Cli.Workbench.navbarRows s3 0 0
  let flat =
    (Stdlib.Bool.not (Stdlib.List.any rows (fun r -> r.label == "History")))
    && (Stdlib.List.length rows
        == Stdlib.List.length (Darklang.Cli.Workbench.visibleWorkspacesIn (Darklang.Cli.Workbench.visibleViews s3)))
  // ⏎ on Changes goes there and takes the content: there is nothing to expand.
  let s4 = (wbChar s3 "`").state
  let atChanges =
    wbMoveNavbarToDest s4 (Darklang.Cli.Workbench.mkDest Darklang.Cli.Workbench.vSCM 0)
  let s5 = (wbKey atChanges Stdlib.Cli.Stdin.Key.Key.Enter).state
  let entered =
    (s5.activeView == Darklang.Cli.Workbench.vSCM)
    && (Stdlib.Bool.not (Darklang.Cli.Workbench.navbarFocused s5))
  // `3` again stays: there is nothing under Changes to step to.
  let s6 = (wbChar s5 "3").state
  let cycled = (s6.activeView == Darklang.Cli.Workbench.vSCM) && (s6.items == s5.items)
  let s6b = (wbChar s6 "]").state
  let s6c = (wbChar s6b "[").state
  let stepped =
    (s6b.activeView == Darklang.Cli.Workbench.vSCM) && (s6c.activeView == Darklang.Cli.Workbench.vSCM)
  // Leaving and coming back by number returns to the view.
  let s7 = (wbChar (wbChar s6c "2").state "3").state
  let remembered = s7.activeView == Darklang.Cli.Workbench.vSCM
  // Errors has no nav row: `E` from Traces opens it, Traces stays lit, `6` comes back.
  let errors = Darklang.Cli.Workbench.extViewIndex "errors"
  let s8 = (wbChar (wbChar s7 "6").state "E").state
  let tracesRow =
    Stdlib.List.findFirstIndex
      (Darklang.Cli.Workbench.navbarRows s8 0 0)
      (fun r -> r.label == "Traces")
    |> Stdlib.Option.withDefault (0 - 1)
  let errorsCovered =
    (s8.activeView == errors)
    && (Darklang.Cli.Workbench.activeRow s8 (Darklang.Cli.Workbench.navbarRows s8 0 0) == tracesRow)
    && ((wbChar s8 "6").state.activeView == Darklang.Cli.Workbench.vTraces)
  // Assert q's action directly instead of smuggling it through `message`.
  let r9 = wbChar s7 "q"
  let quits = r9.action == WbAction.Exited
  let checks =
    [ (atStart, "starts on Home with the list focused")
      (jumped, "2 jumps to Code and focuses the content")
      (backedOut, "esc goes back to Home, content focused")
      (navTaken, "` hands the keyboard to the nav, cursor on where you are")
      (toRepl, "arrowing to REPL then pressing ⏎ opens it, prompt closed")
      (flat, "the nav has one row per view and none for a section")
      (entered, "⏎ on Changes opens it and takes the content")
      (cycled, "3 again stays on Changes")
      (stepped, "] and [ do nothing: no view has sections")
      (remembered, "a view's number key returns to it")
      (errorsCovered, "E opens Errors from Traces, Traces stays lit, 6 returns")
      (quits, "q quits") ]
  let failed =
    checks
    |> Stdlib.List.filter (fun c ->
      let (ok, _l) = c
      Stdlib.Bool.not ok)
    |> Stdlib.List.map (fun c -> let (_ok, l) = c in l)
  if Stdlib.List.isEmpty failed then TestResult.Pass
  else TestResult.Fail $"Navigation broke: {Stdlib.String.join failed "; "}"


// ── REPL session bindings ──

/// Shorthand for a captured binding (one holding a value rather than an expression).
let bound (name: String) (source: String) : Darklang.Cli.Repl.Binding =
  Darklang.Cli.Repl.Binding { name = name; source = source; value = source; captured = true }


let testReplParsesLetBinding (): TestResult =
  // What binds, and - more important - what doesn't. A pattern binding, a comparison typo, and a bare
  // expression all have to fall through to being evaluated rather than silently binding something wrong.
  let cases =
    [ ("let x = 1", Stdlib.Option.Option.Some(("x", "1")))
      ("  let  ys  =  [ 1, 2 ]  ", Stdlib.Option.Option.Some(("ys", "[ 1, 2 ]")))
      ("let _priv = 3", Stdlib.Option.Option.Some(("_priv", "3")))
      ("let x2 = x + 1", Stdlib.Option.Option.Some(("x2", "x + 1")))
      // The right-hand side keeps its own `=`, so a record or a lambda body survives.
      ("let r = f (a = 1)", Stdlib.Option.Option.Some(("r", "f (a = 1)")))
      ("1 + 1", Stdlib.Option.Option.None)
      ("let x == 3", Stdlib.Option.Option.None)
      ("let (a, b) = t", Stdlib.Option.Option.None)
      ("let x =", Stdlib.Option.Option.None)
      ("letter = 3", Stdlib.Option.Option.None)
      ("let 2x = 3", Stdlib.Option.Option.None)
      // A wrapped declaration binds, rhs and all - a pasted chain never reaches here, because
      // `splitStatements` has already separated it into one statement per binding.
      ("let xs = [ 1L\n  2L ]", Stdlib.Option.Option.Some(("xs", "[ 1L\n  2L ]"))) ]
  let wrong =
    cases
    |> Stdlib.List.filter (fun c ->
      let (input, expected) = c
      (Darklang.Cli.Repl.parseLetBinding input) != expected)
    |> Stdlib.List.map (fun c -> let (input, _e) = c in input)
  if Stdlib.List.isEmpty wrong then
    TestResult.Pass
  else
    TestResult.Fail $"parseLetBinding wrong for: {Stdlib.String.join wrong " | "}"


let testReplInjectsBindingChain (): TestResult =
  // The chain is what makes a binding survive to the next expression; order matters, because a later
  // binding is allowed to refer to an earlier one.
  let empty = Darklang.Cli.Repl.withBindings [] "x + 1"
  let one = Darklang.Cli.Repl.withBindings [ bound "x" "42" ] "x + 1"
  let two =
    Darklang.Cli.Repl.withBindings [ bound "x" "42", bound "y" "x + 1" ] "y * 2"
  if (empty == "x + 1")
     && (one == "let x = 42\nx + 1")
     && (two == "let x = 42\nlet y = x + 1\ny * 2") then
    TestResult.Pass
  else
    TestResult.Fail $"Unexpected binding chain: '{one}' / '{two}'"


let testReplUncapturedRebindMovesLast (): TestResult =
  // An uncaptured binding holds an EXPRESSION, so it must sit after anything it references. Rebinding it in
  // place produced `let a = d` above `let d = ...`, which left `d` undefined and wedged the session.
  let mk = (fun n s c -> Darklang.Cli.Repl.Binding { name = n; source = s; value = s; captured = c })
  let after =
    Darklang.Cli.Repl.upsert
      [ mk "a" "1" true, mk "d" "Stdlib.DateTime.now ()" false ]
      (mk "a" "d" false)
  let order = after |> Stdlib.List.map (fun b -> b.name) |> Stdlib.String.join ","
  if order == "d,a" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected the uncaptured rebind to move last (d,a), got {order}"


let testReplRebindKeepsPosition (): TestResult =
  // Rebinding `x` must not move it after `y`, or `y`'s chain entry would reference an undefined name.
  let after =
    Darklang.Cli.Repl.upsert
      [ bound "x" "1", bound "y" "x + 1" ]
      (bound "x" "99")
  let names = after |> Stdlib.List.map (fun b -> b.name) |> Stdlib.String.join ","
  let sources = after |> Stdlib.List.map (fun b -> b.source) |> Stdlib.String.join ","
  if (names == "x,y") && (sources == "99,x + 1") then
    TestResult.Pass
  else
    TestResult.Fail $"Expected x rebound in place, got {names} = {sources}"


let testReplReadsCapturedValue (): TestResult =
  // `captureValue` reports through a tagged string; anything that isn't an `ok:` means "hold the expression
  // instead", including an empty result.
  if (Darklang.Cli.Repl.readCaptured "ok:[1L, 2L]" == Stdlib.Option.Option.Some "[1L, 2L]")
     && (Darklang.Cli.Repl.readCaptured "err:no literal" == Stdlib.Option.Option.None)
     && (Darklang.Cli.Repl.readCaptured "" == Stdlib.Option.Option.None) then
    TestResult.Pass
  else
    TestResult.Fail "readCaptured did not round-trip the ok:/err: tagging"


let testReplSplitsPastedStatements (): TestResult =
  // A paste has to behave exactly like typing the lines one at a time, which means knowing where one
  // statement ends. Indentation is the signal: an indented line continues the one above, so a wrapped
  // expression stays whole while a chain separates.
  let cases =
    [ ("let a = 21L\na * 2L", [ "let a = 21L", "a * 2L" ])
      ("Stdlib.List.map xs\n  (fun x -> x * 2L)", [ "Stdlib.List.map xs\n  (fun x -> x * 2L)" ])
      // A blank line closes a statement rather than joining across it.
      ("let a = 1\n\nlet b = 2", [ "let a = 1", "let b = 2" ])
      ("one line", [ "one line" ])
      ("", []) ]
  let wrong =
    cases
    |> Stdlib.List.filter (fun c ->
      let (input, expected) = c
      (Darklang.Cli.Repl.splitStatements input) != expected)
    |> Stdlib.List.map (fun c -> let (input, _e) = c in Stdlib.toRepr input)
  if Stdlib.List.isEmpty wrong then
    TestResult.Pass
  else
    TestResult.Fail $"splitStatements wrong for: {Stdlib.String.join wrong " | "}"


let testReplCapturesRealValues (): TestResult =
  // The end of the round-trip that matters: a value goes out as source you could paste back in. Enums are
  // in here because they're what a REPL actually produces, and they only render as names because
  // `dvalToExpr` resolves the type's package location.
  let branch = Darklang.SCM.Branch.mainBranchId
  let cases =
    [ (Darklang.Cli.Repl.captureValue branch 42, "ok:42")
      (Darklang.Cli.Repl.captureValue branch [ 1L, 2L ], "ok:[1L, 2L]")
      (Darklang.Cli.Repl.captureValue branch "hi", "ok:\"hi\"")
      // An enum renders under a shortened package name, so `Option.Some(1)`. That and the
      // fully-qualified spelling both parse back to the same value, which is what matters here: the
      // property is that the output is source you could paste in, not that it is spelled one way.
      (Darklang.Cli.Repl.captureValue branch (Stdlib.Option.Option.Some 1),
       "ok:Option.Some(1)") ]
  let wrong =
    cases
    |> Stdlib.List.filter (fun c -> let (got, want) = c in got != want)
    |> Stdlib.List.map (fun c -> let (got, want) = c in $"{want} -> {got}")
  if Stdlib.List.isEmpty wrong then
    TestResult.Pass
  else
    TestResult.Fail $"captureValue: {Stdlib.String.join wrong " | "}"


let testWorkbenchCapturesStrayOutput (): TestResult =
  // The workbench owns the whole screen, so anything a command prints scrolls the alternate screen and every
  // frame after it lands that many rows off, which reads as two overlapping copies of the Stdlib.Cli.UI. It's easy to
  // hit: `cliEvaluateExpression` prints a three-line call-stack header on any runtime error, so a typo at the
  // REPL does it. `captureOutputAnd` returns the value AND the output, so a caller gets the result without
  // letting the print through.
  let (value, out) =
    Darklang.Cli.Workbench.captureOutputAnd (fun () ->
      Stdlib.printLine "this must not reach the terminal"
      41 + 1)
  if (value == 42) && (Stdlib.String.contains out "must not reach") then
    TestResult.Pass
  else
    TestResult.Fail $"Expected 42 and the captured line, got {Stdlib.Int.toString value} / '{out}'"


/// Does rendering view `viewIndex` put `marker` on the screen?
let viewShows (viewIndex: Int) (marker: String) : Bool =
  let state =
    Darklang.Cli.Workbench.focusNavbar
      { (workbenchState ()) with activeView = viewIndex }
  let view = Darklang.Cli.Workbench.viewAtSize state (Stdlib.Cli.Tui.Size { width = 160; height = 40 })
  view.rows
  |> Stdlib.List.any (fun r -> Stdlib.String.contains (Stdlib.Cli.Tui.Text.stripSgr r) marker)


/// `viewShows`, with the CONTENT holding the keyboard: the footer then carries the
/// view's own hints rather than the nav's.
let contentShows (viewIndex: Int) (marker: String) : Bool =
  let state =
    Darklang.Cli.Workbench.focusContent
      { (workbenchState ()) with activeView = viewIndex }
  let view = Darklang.Cli.Workbench.viewAtSize state (Stdlib.Cli.Tui.Size { width = 160; height = 40 })
  view.rows
  |> Stdlib.List.any (fun r -> Stdlib.String.contains (Stdlib.Cli.Tui.Text.stripSgr r) marker)


let testWorkbenchViewsShowTheirChrome (): TestResult =
  // `testWorkbenchEveryViewRenders` only asks whether a view drew *anything*,
  // which is why it once stayed green while two header bands rendered blank
  // (helpers that return spans, results discarded with `let _ =`). So: assert
  // on content a band actually contributes - a pane title, and the nav
  // rows above it.
  let checks =
    // Markers have to be unique to the band: something the context row
    // doesn't say. `2 Code` and `6 Traces` are numbered items on the strip,
    // which nothing else draws.
    [ (Darklang.Cli.Workbench.vSCM, "3 Changes", "nav: Changes is one numbered item")
      (Darklang.Cli.Workbench.vTraces, "6 Traces", "nav: Traces is its own item, not Activity")
      (Darklang.Cli.Workbench.vScratch, "to type", "REPL title row")
      (Darklang.Cli.Workbench.vMatter, "packages", "Code's root breadcrumb")
      (Darklang.Cli.Workbench.vHome, "recent commits", "Home's recent work")
      (Darklang.Cli.Workbench.vHome, "2 Code", "nav: a numbered workspace") ]
  // With the content focused, the footer is the view's: Changes advertises commit, and Home the
  // branch verbs it took over from the old Branches section.
  let contentChecks =
    [ (Darklang.Cli.Workbench.vSCM, "commit", "footer: Changes offers commit")
      (Darklang.Cli.Workbench.vHome, "merge", "footer: Home offers the branch verbs") ]
  let missing =
    Stdlib.List.append
      (checks
       |> Stdlib.List.filter (fun c -> let (v, marker, _label) = c in Stdlib.Bool.not (viewShows v marker))
       |> Stdlib.List.map (fun c -> let (_v, _m, label) = c in label))
      (contentChecks
       |> Stdlib.List.filter (fun c -> let (v, marker, _label) = c in Stdlib.Bool.not (contentShows v marker))
       |> Stdlib.List.map (fun c -> let (_v, _m, label) = c in label))
  if Stdlib.List.isEmpty missing then
    TestResult.Pass
  else
    TestResult.Fail $"Missing from the rendered frame: {Stdlib.String.join missing ", "}"


/// Home has no hidden inspector, and even a wide terminal gets one nav row.
let testWorkbenchHomeOverview (): TestResult =
  let base = workbenchState ()
  let longTitle = Stdlib.String.repeat "界" 30
  let state =
    { base with
        items =
          [ Darklang.Cli.Workbench.homeHeader "recent commits"
            Darklang.Cli.Workbench.BodyItem
              { name = longTitle; kind = "home-commit"; isModule = false
                desc = "Alex · yesterday" } ]
        selected = 1 }
  let plain =
    (Darklang.Cli.Workbench.viewAtSize state
      (Stdlib.Cli.Tui.Size { width = 120; height = 24 })).rows
    |> Stdlib.List.map Stdlib.Cli.Tui.Text.stripSgr
    |> Stdlib.String.join "\n"
  let narrow =
    (Darklang.Cli.Workbench.viewAtSize state
      (Stdlib.Cli.Tui.Size { width = 80; height = 24 })).rows
    |> Stdlib.List.map Stdlib.Cli.Tui.Text.stripSgr
    |> Stdlib.String.join "\n"
  let right = (wbKey state Stdlib.Cli.Stdin.Key.Key.RightArrow).state
  let tab = (wbKey state Stdlib.Cli.Stdin.Key.Key.Tab).state
  let back = (wbKey tab Stdlib.Cli.Stdin.Key.Key.Tab).state
  let scm =
    Darklang.Cli.Workbench.focusNavbar
      { state with activeView = Darklang.Cli.Workbench.vSCM }
  let nav =
    Darklang.Cli.Workbench.renderNavStrip scm 0 0
      (Stdlib.Cli.UI.Layout.Region { top = 1; left = 1; rows = 4; cols = 120 })
  let labels = nav |> Stdlib.List.map (fun span -> span.text) |> Stdlib.String.join " "
  let opened (kind: String) : Darklang.Cli.Workbench.State =
    let summary =
      { state with
          items =
            [ Darklang.Cli.Workbench.BodyItem
                { name = "summary"; kind = kind; isModule = false; desc = "" } ]
          selected = 0 }
    (wbKey summary Stdlib.Cli.Stdin.Key.Key.Enter).state
  let openSummary (kind: String) : Darklang.Cli.Workbench.Dest =
    Darklang.Cli.Workbench.activeDest (opened kind)
  let opensReader (kind: String) : Bool =
    match (opened kind).reading with
    | Some _ -> true
    | None -> false
  let checks =
    [ (Stdlib.String.contains plain longTitle, "Home uses the full width for a commit")
      (Stdlib.String.contains plain "Alex · yesterday", "commit metadata remains visible")
      (Stdlib.Bool.not (Stdlib.String.contains plain "Welcome"), "no welcome inspector")
      (Stdlib.Bool.not (Stdlib.String.contains narrow "⏎ go · esc"), "no startup menu overlay")
      (right.focus == Stdlib.Cli.UI.SplitPane.Focus.First, "right cannot focus a hidden pane")
      (Darklang.Cli.Workbench.navbarFocused tab, "tab opens navigation")
      (back.focus == Stdlib.Cli.UI.SplitPane.Focus.First, "tab returns to the list")
      (Stdlib.List.all nav (fun span -> span.row == 0), "navigation uses one row")
      (Stdlib.Bool.not (Stdlib.String.contains labels "History"), "the nav has no row for a section")
      ((wbChar scm "3").state.activeView == Darklang.Cli.Workbench.vSCM,
       "3 again stays on Changes")
      (opensReader "home-more-commits", "more commits opens the commit list in the reader")
      (openSummary "home-conflicts" == Darklang.Cli.Workbench.mkDest Darklang.Cli.Workbench.vSCM 0,
       "the conflict summary opens Changes, where the conflicts are") ]
  let failures =
    checks |> Stdlib.List.filterMap (fun check ->
      let (ok, label) = check
      if ok then Stdlib.Option.Option.None else Stdlib.Option.Option.Some label)
  if Stdlib.List.isEmpty failures then TestResult.Pass
  else TestResult.Fail (Stdlib.String.join failures "; ")
