module Darklang.Cli.Installation.Version

let execute(state: AppState, args: List<String>): AppState =
  // Named, not ignored: a mistyped `--locl` would otherwise fall through to the update
  // check, which is the one thing the caller was trying to skip.
  let unknown = args |> Stdlib.List.filter(fun a -> a != "--local" && a != "--check")
  match unknown with
  | [bad, ...] ->
    printErr($"version: unknown option `{bad}`")
    Stdlib.printErrorLine(help(state))
    failed(state)
  | [] ->
    // Says whether a newer release exists, from GitHub's answer of the last day (`Helpers.versionInfo`).
    // Asking GitHub is a round trip that costs ten times the rest of the command, so it happens once a
    // day, and `--check` asks now.
    //
    // `--local` answers from the binary alone. It is for callers that want to know WHICH binary this is
    // rather than whether it is current: a test, a script, a machine with no egress, where the check buys
    // a round trip and then prints "unable to check for updates". Measured at ~11s against a firewall that
    // drops rather than refuses, which is the shape of a CI runner.
    let line =
      if Stdlib.List.contains(args, "--local") then
        $"Darklang CLI {Helpers.cliVersion()}"
      else
        Helpers.versionInfo(Stdlib.List.contains(args, "--check"))

    Stdlib.printLine(line)
    // No store-format line: an op log needs no format coordinate. Ops are content-addressed and a binary
    // tops its own store up, so there is nothing for a version number to gate.
    state


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: version [--local|--check]"
    "Display the CLI version."
    ""
    "Shows the current version, and whether a newer release exists. GitHub is"
    "asked once a day; an older answer says how old it is."
    ""
    "  --check    Ask GitHub for the latest release now."
    "  --local    Skip the check for a newer release, which needs the network."
    "             Answers immediately, and says nothing about updates." ]
  |> Stdlib.String.join("\n")
