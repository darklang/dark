module Darklang.Cli.Installation.Update

let execute(state: AppState, args: List<String>): AppState =
  let currentVersion = Helpers.cliVersion()
  let host = Stdlib.Cli.Host.getRuntimeHost() |> Builtin.unwrap
  let parsed =
    FlagParser.parse(
      FlagParser.Spec { flags = [ ("--yes", [ "-y" ]) ], valueFlags = [ ("--to", []) ] },
      args)

  match parsed.errors with
  | [_, ...] ->
    printErr(FlagParser.parseErrorsMessage(parsed.errors))
    Stdlib.printErrorLine(help(state))
    failed(state)
  | [] ->
    let pinned = FlagParser.getOption(parsed, "--to")
    match System.installedBinaryPath(host) with
    | Error(e) ->
      Stdlib.printErrorLine(View.formatError(e))
      failed(state)
    | Ok(target) ->
      if Stdlib.Bool.not(System.isRunningInstalled(target)) then
        printErr($"This dark isn't the installed one ({target}), so there's nothing to update.")
        printHint("  dark install installs this one; the installed dark updates itself")
        failed(state)
      else
        let replace = fun () -> Download.installRelease(host, pinned)
        Stdlib.printErrorLine($"Checking for updates from Darklang CLI {currentVersion}...")
        match System.updateIfAvailable(currentVersion, pinned, replace) with
        | Ok(message) ->
          Stdlib.printLine(View.formatSuccess(message))
          state
        | Error(e) ->
          Stdlib.printErrorLine(View.formatError(e))
          failed(state)


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: update [--to <tag>] [--yes|-y]"
    "Update Darklang CLI to the latest version."
    ""
    "Checks GitHub for the latest release and replaces the installed CLI"
    "(~/.darklang/bin/dark) with it, after checking the download against the"
    "release's checksums and that the new one runs against a copy of your store."
    ""
    "Flags:"
    "  --to <tag>  Install this release instead of the latest (e.g. v0.0.42),"
    "              even an older one. Refused if it can't read your store."
    "  --yes, -y   Accepted for scripts; update never prompts" ]
  |> Stdlib.String.join("\n")
