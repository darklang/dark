module Darklang.Cli.Installation.Update


let execute(state: AppState, args: List<String>): AppState =
  let currentVersion = Helpers.cliVersion()
  let host = (Stdlib.Cli.Host.getRuntimeHost()) |> Builtin.unwrap

  let parsed =
    Cli.FlagParser.parse(
      Cli.FlagParser.Spec { flags = [ ("--yes", [ "-y" ]) ], valueFlags = [ ("--to", []) ] },
      args)

  match parsed.errors with
  | [_, ...] ->
    Cli.printErr(Cli.FlagParser.parseErrorsMessage(parsed.errors))
    Stdlib.printErrorLine(help(state))
    Cli.exitWith(state, false)
  | [] ->

  let pinned = Cli.FlagParser.getOption(parsed, "--to")

  match Installation.System.installedBinaryPath(host) with
  | Error(e) ->
    Stdlib.printErrorLine(View.formatError(e))
    Cli.exitWith(state, false)
  | Ok(target) ->

  if Stdlib.Bool.not(Installation.System.isRunningInstalled(target)) then
    Cli.printErr(
      $"This dark isn't the installed one ({target}), so there's nothing to update.")
    Cli.printHint("  dark install installs this one; the installed dark updates itself")
    Cli.exitWith(state, false)
  else
    let replace = fun () -> Installation.Download.installRelease(host, pinned)

    Stdlib.printLine($"Checking for updates from Darklang CLI {currentVersion}...")

    match Installation.System.updateIfAvailable(currentVersion, pinned, replace) with
    | Ok(message) ->
      Stdlib.printLine(View.formatSuccess(message))
      state
    | Error(e) ->
      Stdlib.printErrorLine(View.formatError(e))
      Cli.exitWith(state, false)


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: update [--to <tag>] [--yes|-y]"
    "Update Darklang CLI to the latest version."
    ""
    "Checks GitHub for the latest release and replaces the installed CLI"
    "(~/.darklang/bin/dark) with it, after checking the new one runs against"
    "a copy of your store."
    ""
    "Flags:"
    "  --to <tag>  Install this release instead of the latest (e.g. v0.0.42),"
    "              even an older one. Refused if it can't read your store."
    "  --yes, -y   Accepted for scripts; update never prompts" ]
  |> Stdlib.String.join("\n")
