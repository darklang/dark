module Darklang.Cli.Installation.Update


let execute (state: AppState) (args: List<String>) : AppState =
  let currentVersion = Helpers.cliVersion ()
  let currentMode = Installation.System.getInstallationMode ()
  let host = (Stdlib.Cli.Host.getRuntimeHost ()) |> Builtin.unwrap

  let parsed =
    Cli.FlagParser.parse
      (Cli.FlagParser.Spec { flags = [ ("--yes", [ "-y" ]) ]; valueFlags = [ ("--to", []) ] })
      args

  match parsed.errors with
  | _ :: _ ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error (Cli.FlagParser.parseErrorsMessage parsed.errors))
    Stdlib.printLine (help state)
    state
  | [] ->

  let pinned = Cli.FlagParser.getOption parsed "--to"

  let replace =
    match currentMode with
    | Installed -> fun () -> Installation.Download.installRelease host pinned
    | Portable -> fun () -> Installation.Download.updatePortableInPlace host pinned

  Stdlib.printLine $"Checking for updates from Darklang CLI {currentVersion}..."

  match Installation.System.updateIfAvailable currentVersion pinned replace with
  | Ok message ->
    Stdlib.printLine (View.formatSuccess message)
    state
  | Error e ->
    Stdlib.printLine (View.formatError e)
    state


let complete (_state: AppState) (_args: List<String>) : List<Completion.CompletionItem> =
  []


let help (_state: AppState) : String =
  [ "Usage: update [--to <tag>] [--yes|-y]"
    "Update Darklang CLI to the latest version."
    ""
    "Checks GitHub for the latest release and replaces this binary with it,"
    "after checking the new one runs against a copy of your store."
    "An installed CLI (~/.darklang/bin/dark) also records the new version"
    "and keeps its PATH entry; a portable one is replaced where it is."
    ""
    "Flags:"
    "  --to <tag>  Install this release instead of the latest (e.g. v0.0.42),"
    "              even an older one. Refused if it can't read your store."
    "  --yes, -y   Accepted for scripts; update never prompts" ]
  |> Stdlib.String.join "\n"
