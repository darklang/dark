/// Where the local installation of the Darklang CLI lives.
module Darklang.Cli.Installation.Config

/// Get the Darklang home directory path.
///
/// Takes a host it no longer reads: the layout used to differ on Windows, which is gone, and
/// every caller already has one.
let getDarklangHomeDir(_host: Stdlib.Cli.Host.Host): String =
  match Stdlib.Cli.Unix.getHomeDirectory() with
  | Ok(dir) -> $"{dir}/.darklang"
  | Error(_) -> "~/.darklang"