module Darklang.Cli.Installation.Status

let execute(state: AppState, args: List<String>): AppState =
  match Stdlib.Cli.Host.getRuntimeHost() with
  | Error(e) ->
    Stdlib.printErrorLine(e)
    failed(state)
  | Ok(host) ->
    let version = Helpers.versionInfo(false)
    let installationStatus =
      match System.installedBinaryPath(host) with
      | Error(e) -> Stdlib.Cli.UI.Colors.warning("Status: ") + $"Unknown ({e})"
      | Ok(target) ->
        if System.isInstalled(target) then
          Stdlib.Cli.UI.Colors.success("Status: ") + "Installed at " + target
        else
          Stdlib.Cli.UI.Colors.warning("Status: ")
          + "Not installed (run 'install' to put dark on your PATH)"

    Stdlib.printLine(Stdlib.Cli.UI.Colors.info("Version: ") + version)
    Stdlib.printLine(installationStatus)
    state


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: status"
    "Show current CLI installation status."
    ""
    "Displays the version, and whether dark is installed at ~/.darklang/bin/dark." ]
  |> Stdlib.String.join("\n")
