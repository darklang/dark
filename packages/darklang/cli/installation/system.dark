/// System integration utilities for CLI installation
module Darklang.Cli.Installation.System


/// Where the installed binary lives.
let installedBinaryPath(host: Stdlib.Cli.Host.Host): String =
  $"{Config.getDarklangHomeDir(host)}/bin/dark"


/// Is the running binary the installed one?
let isRunningInstalled(host: Stdlib.Cli.Host.Host): Bool =
  Stdlib.Cli.Sys.currentExecutablePath() == installedBinaryPath(host)


/// Is there an installed binary at all?
let isInstalled(host: Stdlib.Cli.Host.Host): Bool =
  Stdlib.Cli.Unix.fileExists(installedBinaryPath(host))


/// Is this binary the latest release?
///
/// Compares build hashes, the one identity a binary and a release share. The tag (`v0.0.54`) appears
/// nowhere in the binary, so comparing the two never matched and every update re-downloaded.
let isLatestBuild(currentVersion: String): Stdlib.Result.Result<Bool, String> =
  Darklang.GitHub.Releases.getLatestReleaseBuildHash()
  |> Stdlib.Result.map(fun latest -> latest == currentVersion)


/// Copy the running binary to `~/.darklang/bin/dark` and put it on the PATH.
let installFromCurrentBinary(host: Stdlib.Cli.Host.Host): Stdlib.Result.Result<String, String> =
  let currentBinaryPath = Stdlib.Cli.Sys.currentExecutablePath()
  let darklangHomeDir = Config.getDarklangHomeDir(host)

  let globalBinDir = $"{darklangHomeDir}/bin/"
  let globalBinaryPath = installedBinaryPath(host)

  let copied =
    match Stdlib.Cli.Unix.ensureDirectoryExists(globalBinDir) with
    | Ok(_) ->
      match Stdlib.Cli.Unix.copyFile(currentBinaryPath, globalBinaryPath) with
      | Ok(_) -> Stdlib.Cli.Unix.grantExecutePermission(globalBinaryPath)
      | Error(e) -> Stdlib.Result.Result.Error(e)
    | Error(e) -> Stdlib.Result.Result.Error(e)

  match copied with
  | Error(e) -> Stdlib.Result.Result.Error(e)
  | Ok(_) ->
    // Unexpanded, as `install.sh` writes it. A PATH we couldn't edit is a warning, not a failure.
    match Stdlib.Cli.Unix.addToPath(host.defaultShell, "$HOME/.darklang/bin/") with
    | Ok(_) -> ()
    | Error(e) ->
      Stdlib.printErrorLine(
        $"Couldn't add {globalBinDir} to your PATH ({e}). Add it in your shell's config to run `dark` from anywhere.")

    Stdlib.Result.Result.Ok($"Installed to {globalBinaryPath}. The 'dark' command should now be available.")


/// Update the CLI if a newer version is available. Never prompts, so `--yes` changes nothing here.
///
/// <param pinned> names a release to install instead of the latest. <param replace> does the work.
let updateIfAvailable(
  currentVersion: String,
  pinned: Stdlib.Option.Option<String>,
  replace: Unit -> Stdlib.Result.Result<String, String>)
  : Stdlib.Result.Result<String, String> =
  // A pinned tag is installed whatever is current: it is how you roll back.
  let check =
    match pinned with
    | Some(_) -> Stdlib.Result.Result.Ok(false)
    | None -> isLatestBuild(currentVersion)

  match check with
  | Error(_) ->
    Stdlib.Result.Result.Error(
      "Couldn't reach GitHub to find the latest release. Nothing was changed.")
  | Ok(true) -> Stdlib.Result.Result.Ok("Already up to date!")
  | Ok(false) ->
    match replace() with
    | Ok(tag) -> Stdlib.Result.Result.Ok($"Updated to {tag}.")
    | Error(e) -> Stdlib.Result.Result.Error(e)


/// Uninstall the CLI with user confirmation
/// If autoConfirm is true, skips confirmation prompt
let uninstallWithConfirmation(host: Stdlib.Cli.Host.Host, autoConfirm: Bool): Stdlib.Result.Result<String, String> =
  if Cli.Prompt.confirmExplicit(
       autoConfirm,
       $"Uninstall removes {Config.getDarklangHomeDir(host)}, including everything you've made. Are you sure? (y/n): ") then
    Stdlib.printErrorLine("Uninstalling...")
    match Uninstall.runUninstall(host) with
    | Ok(_) -> Stdlib.Result.Result.Ok("Uninstall complete")
    | Error(e) -> Stdlib.Result.Result.Error(e)
  else
    // An Error: the Ok arm reports success and exits the CLI as though the binary were gone.
    Stdlib.Result.Result.Error("Uninstall cancelled")
