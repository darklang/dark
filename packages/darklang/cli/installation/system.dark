/// System integration utilities for CLI installation
module Darklang.Cli.Installation.System

/// Where the installed binary lives, or why there is no home to put it in.
let installedBinaryPath(host: Stdlib.Cli.Host.Host): Result<String, String> =
  Config.getDarklangHomeDir(host) |> Stdlib.Result.map(fun home -> $"{home}/bin/dark")


/// Is the running binary the installed one, at <param installed>?
let isRunningInstalled(installed: String): Bool =
  Stdlib.Cli.Sys.currentExecutablePath() == installed


/// Is there an installed binary at <param installed>?
let isInstalled(installed: String): Bool =
  Stdlib.Cli.Unix.fileExists(installed)


/// Is this binary the latest release?
///
/// Compares build hashes, the one identity a binary and a release share. The tag (`v0.0.54`) appears
/// nowhere in the binary, so comparing the two never matched and every update re-downloaded.
let isLatestBuild(currentVersion: String): Result<Bool, String> =
  GitHub.Releases.getLatestReleaseBuildHash()
  |> Stdlib.Result.map(fun latest -> latest == currentVersion)


/// Copy the running binary to `~/.darklang/bin/dark` and put it on the PATH.
let installFromCurrentBinary(host: Stdlib.Cli.Host.Host): Result<String, String> =
  match Config.getDarklangHomeDir(host) with
  | Error(e) -> Result.Error(e)
  | Ok(darklangHomeDir) ->
    let currentBinaryPath = Stdlib.Cli.Sys.currentExecutablePath()
    let globalBinDir = $"{darklangHomeDir}/bin/"
    let globalBinaryPath = $"{darklangHomeDir}/bin/dark"
    let copied =
      match Stdlib.Cli.Unix.ensureDirectoryExists(globalBinDir) with
      | Ok(_) ->
        match Stdlib.Cli.Unix.copyFile(currentBinaryPath, globalBinaryPath) with
        | Ok(_) -> Stdlib.Cli.Unix.grantExecutePermission(globalBinaryPath)
        | Error(e) -> Result.Error(e)
      | Error(e) -> Result.Error(e)

    match copied with
    | Error(e) -> Result.Error(e)
    | Ok(_) ->
      // Unexpanded, as `install.sh` writes it. A PATH we couldn't edit is a warning, not a failure.
      match Stdlib.Cli.Unix.addToPath(host.defaultShell, "$HOME/.darklang/bin/") with
      | Ok(_) -> ()
      | Error(e) ->
        Stdlib.printErrorLine(
          $"Couldn't add {globalBinDir} to your PATH ({e}). Add it in your shell's config to run `dark` from anywhere.")

      Result.Ok($"Installed to {globalBinaryPath}. The 'dark' command should now be available.")


/// Update the CLI if a newer version is available. Never prompts, so `--yes` changes nothing here.
///
/// <param pinned> names a release to install instead of the latest. <param replace> does the work.
let updateIfAvailable(
  currentVersion: String,
  pinned: Option<String>,
  replace: Unit -> Result<String, String>)
  : Result<String, String> =
  // A pinned tag is installed whatever is current: it is how you roll back.
  let check =
    match pinned with
    | Some(_) -> Result.Ok(false)
    | None -> isLatestBuild(currentVersion)

  match check with
  | Error(_) ->
    Result.Error("Couldn't reach GitHub to find the latest release. Nothing was changed.")
  | Ok(true) -> Result.Ok("Already up to date!")
  | Ok(false) ->
    match replace() with
    | Ok(tag) -> Result.Ok($"Updated to {tag}.")
    | Error(e) -> Result.Error(e)


/// Uninstall the CLI with user confirmation, which {{Confirm.Assume}} skips
let uninstallWithConfirmation(
  host: Stdlib.Cli.Host.Host,
  confirm: Confirm)
  : Result<String, String> =
  match Config.getDarklangHomeDir(host) with
  | Error(e) -> Result.Error($"refusing to uninstall: {e}")
  | Ok(darklangHomeDir) ->
    if
      Prompt.confirmExplicit(
        confirm,
        $"Uninstall removes {darklangHomeDir}, including everything you've made. Are you sure? (y/n): ")
    then
      Stdlib.printErrorLine("Uninstalling...")
      match Uninstall.runUninstall(host) with
      | Ok(_) -> Result.Ok("Uninstall complete")
      | Error(e) -> Result.Error(e)
    // An Error: the Ok arm reports success and exits the CLI as though the binary were gone.
    else if Stdlib.Cli.UI.Prompt.canAsk() then
      Result.Error("Uninstall cancelled")
    else
      Result.Error(
        "Uninstall cancelled: there's no terminal to confirm it. `dark uninstall --yes` skips the prompt.")
