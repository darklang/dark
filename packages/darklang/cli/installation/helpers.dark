// CLEANUP this might as well be one dir up
// or moved to the version namespace
module Darklang.Cli.Installation.Helpers

/// The git sha this binary was built from. The one reader of the builtin: `cliVersion` prints it and
/// the sync wire stamps it, and both mean the same thing by it.
let buildHash () : String = Builtin.getBuildHash ()

let cliVersion () : String = "alpha-" + (buildHash ())

/// The release this binary was built as (`v0.0.74`), when it is one.
let releaseTag () : Stdlib.Option.Option<String> = Builtin.getReleaseTag ()

/// The newest release at or before the commit this binary was built from.
let releaseBefore () : Stdlib.Option.Option<String> = Builtin.getReleaseBefore ()

/// Which build this is, in one phrase, as `version` and `store` both name it:
/// `v0.0.74 (alpha-abe74e7)` for a release, `alpha-abe74e7, after v0.0.74 (not a release)` for a build
/// between releases, and the bare build where the build saw no release tags (a clone without them).
let describeBuild () : String =
  match releaseTag () with
  | Some tag -> $"{tag} ({cliVersion ()})"
  | None ->
    match releaseBefore () with
    | Some before -> $"{cliVersion ()}, after {before} (not a release)"
    | None -> cliVersion ()

/// The local version plus a check against the latest published release.
///
/// Costs a network round trip, which dominates the command. That's deliberate: both callers (`version`
/// and `install-status`) exist to tell you whether your install is current, so the check is the point
/// rather than a side errand. Worth knowing it's there before adding a third caller.
let versionInfoWithUpdateCheck () : String =
  let current = cliVersion ()
  match GitHub.Releases.getLatestRelease () with
  | Ok((latestTag, latestBuild)) ->
    if current == latestBuild then
      $"Darklang CLI {describeBuild ()}, the latest release"
    else if releaseTag () == Stdlib.Option.Option.None && releaseBefore () == Stdlib.Option.Option.Some latestTag then
      // Built after the latest release, so `dark update` would go backwards.
      $"Darklang CLI {describeBuild ()}, newer than the latest release"
    else
      $"Darklang CLI {describeBuild ()}; the latest release is {latestTag} (`dark update`)"
  | Error _ -> $"Darklang CLI {describeBuild ()} (could not check for a newer release)"

/// CLEANUP alias for `versionInfoWithUpdateCheck`, kept because `install-status` and the old_notes
/// command still call it. Fold them over and delete this.
let getVersionInfo () : String =
  versionInfoWithUpdateCheck ()