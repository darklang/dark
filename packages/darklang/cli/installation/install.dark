module Darklang.Cli.Installation.Install

/// Check if a flag is present in args (supports both --flag and -f forms)
let hasFlag(args: List<String>, longFlag: String, shortFlag: String): Bool =
  Stdlib.List.contains(args, longFlag) || Stdlib.List.contains(args, shortFlag)


let execute(state: AppState, args: List<String>): AppState =
  let host = Stdlib.Cli.Host.getRuntimeHost() |> Builtin.unwrap
  let confirm = Confirm.assumeIf(hasFlag(args, "--yes", "-y"))
  match System.installedBinaryPath(host) with
  | Error(e) ->
    Stdlib.printErrorLine(View.formatError(e))
    failed(state)
  | Ok(target) ->
    if System.isRunningInstalled(target) then
      Stdlib.printLine(View.formatSuccess($"Already installed at {target}"))
      state
    else
      let go =
        if System.isInstalled(target) then
          Prompt.confirmExplicit(
            confirm,
            $"A dark is already installed at {target}. Replace it with this one? (y/n): ")
        else
          true

      if go then
        match System.installFromCurrentBinary(host) with
        | Ok(message) ->
          Stdlib.printLine(View.formatSuccess(message))
          state
        | Error(e) ->
          Stdlib.printErrorLine(View.formatError(e))
          { state with exitCode = 1 }
      else
        printErr("Nothing installed.")
        printHint("  dark install --yes replaces it without asking")
        failed(state)


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [ "Usage: install [--yes|-y]"
    "Install this dark for your user account."
    ""
    "Copies this binary to ~/.darklang/bin/dark and puts it on your PATH."
    "Your data is already in ~/.darklang, so nothing else moves."
    ""
    "Flags:"
    "  --yes, -y  Replace an existing install without asking" ]
  |> Stdlib.String.join("\n")
