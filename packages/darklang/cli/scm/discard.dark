module Darklang.Cli.Discard

// `dark discard` -- decide against your draft.
//
// The draft is everything you've authored since the last `dark commit`. Authoring is live-on-write, so a
// draft is not pending work: it is already running, and discarding it takes those versions back out. What
// is already committed is never touched, which is what makes this safe to reach for.

let help(_state: AppState): String =
  [ ""
    "  dark discard          review what would go, then confirm"
    "  dark discard -y       skip the confirmation (also --yes)"
    "  dark discard <name>   restore the item and update callers that followed its draft versions"
    ""
    "  Committed work is never touched: this drops the uncommitted ops of the branch you're on,"
    "  main included, and each name they touched is back to its committed version."
    "  To step ONE item BACK a version, that's `dark undo <name>`. To remove one from"
    "  the draft entirely, which is what a NEW item needs since it has no version to"
    "  step back to, `dark discard <name>`." ]
  |> Stdlib.String.join("\n")


/// Repoint callers off the versions bound by this draft, keeping their current bodies.
let restoreCallers(
  branchId: Uuid,
  loc: LanguageTools.ProgramTypes.PackageLocation,
  discarded: List<LanguageTools.ProgramTypes.Reference>)
  : Unit =
  match SCM.PackageOps.liveBindingFor(branchId, loc) with
  | Some(binding) ->
    let kind = SCM.Deps.kindOf(binding.itemType)
    let restored = LanguageTools.ProgramTypes.Hash.Hash(binding.hash)
    let previous =
      discarded
      |> Stdlib.List.filterMap(fun target ->
        let hash = LanguageTools.ProgramTypes.Reference.hash(target)
        if LanguageTools.ProgramTypes.Reference.kind(target) == kind && hash != restored then
          Option.Some(hash)
        else
          Option.None)
      |> Stdlib.List.unique

    Packages.Propagate.repointNow(
      branchId,
      loc,
      previous,
      restored,
      kind,
      Packages.Propagate.FollowerCheck.Check)
    |> Packages.Propagate.printFollowed
  | None ->
    if Stdlib.Bool.not(Stdlib.List.isEmpty(discarded)) then
      let dotted = PropagateCmd.dotted(loc)
      match SCM.Deps.namedReferences(branchId) with
      | Ok(edges) ->
        edges
        |> Stdlib.List.filterMap(fun((caller, _, target, dependency)) ->
          if dependency == loc && Stdlib.List.contains(discarded, target) then
            Option.Some(PropagateCmd.dotted(caller))
          else
            Option.None)
        |> Stdlib.List.unique
        |> Stdlib.List.iter(fun caller ->
          Stderr.line(
            Stdlib.Cli.UI.Colors.warning($"  {caller} still uses the discarded {dotted}.")))
      | Error(e) ->
        Stderr.line(Stdlib.Cli.UI.Colors.warning($"  Couldn't check callers of {dotted}: {e}"))
    else
      ()


let execute(state: AppState, args: List<String>): AppState =
  let confirm =
    Confirm.assumeIf(Stdlib.List.contains(args, "-y") || Stdlib.List.contains(args, "--yes"))

  let named = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.String.startsWith(a, "-")))
  let branchId = SCM.PackageOps.currentBranch()
  let scope =
    match branchId with
    | id when SCM.Branch.isMain(id) -> SCM.Branch.mainBranchName
    | id -> $"branch \"{SCM.PackageOps.branchName(id)}\""

  // `dark discard <name>` drops just that name's uncommitted bindings. It is the only way out for a
  // newly-authored item: `undo` steps back a VERSION and a new item has none, so without this a typo in
  // a new item blocks `commit` until the whole draft goes.
  match named with
  | [arg] ->
    match Packages.Location.parseRelativeTo(state.packageData.currentLocation, arg) with
    | Error(e) ->
      printErr(e)
      failed(state)
    | Ok(loc) ->
      let dotted = PropagateCmd.dotted(loc)
      let mods = Stdlib.String.join(loc.modules, ".")
      let inDraft =
        SCM.PackageOps.draftBindings()
        |> Stdlib.List.filter(fun b ->
          b.owner == loc.owner && b.name == loc.name && b.modules == mods)

      let draft = SCM.PackageOps.draftEntriesFor(branchId)
      let isRenamed =
        draft
        |> Stdlib.List.any(fun entry ->
          match entry.op with
          | Rename(oldLocation, newLocation, _, _, _) -> oldLocation == loc || newLocation == loc
          | _ -> false)

      if Stdlib.List.isEmpty(inDraft) && Stdlib.Bool.not(isRenamed) then
        Stderr.ok($"{dotted} isn't in your draft on {scope} -- nothing to discard.")
        printHint("  `dark status` lists what is.")
        state
      else if
        Stdlib.Bool.not(
          Prompt.confirmExplicit(
            confirm,
            Stdlib.Cli.UI.Colors.warning($"\n  Drop {dotted} from your draft? [y/N]: ")))
      then
        if Stdlib.Cli.UI.Prompt.canAsk() then
          Stderr.ok("  kept.")
        else
          printErr(Prompt.refuseWithoutTerminal("Discard", $"dark discard {dotted}"))

        failed(state)
      else
        let discarded =
          draft
          |> Stdlib.List.filterMap(fun entry ->
            match entry.op with
            | SetName(location, target, _)
            | Decision(_, location, _, Override(target))
            | Decision(_, location, _, Restore(_, target, _))
              when location == loc ->
              Option.Some(target)
            | Rename(_, location, target, _, _) when location == loc -> Option.Some(target)
            | _ -> Option.None)

        match SCM.PackageOps.discardDraftName(loc.owner, loc.modules, loc.name) with
        | Ok(n) ->
          Stderr.ok($"dropped {dotted} from your draft ({Text.plural(n, "op")}).")
          restoreCallers(branchId, loc, discarded)
          match SCM.Constraints.outdatedUsagesOn(branchId) with
          | Ok(findings) ->
            let affected = Stdlib.List.filter(findings, fun finding -> finding.dependency == loc)
            if Stdlib.List.isEmpty(affected) then
              ()
            else
              Stderr.line(
                Stdlib.Cli.UI.Colors.warning($"  Callers still use another version of {dotted}:"))

              Stdlib.List.iter(affected, fun finding -> Stderr.line(ConstraintsCmd.line(finding)))
              Stderr.hint("  `dark constraints` lists these references and how to resolve them.")
          | Error(e) ->
            Stderr.line(Stdlib.Cli.UI.Colors.warning($"  Couldn't check callers of {dotted}: {e}"))

          state
        | Error(e) ->
          printErr($"couldn't drop {dotted}: {e}")
          failed(state)
  | [_, _, ...] ->
    printErr("dark discard takes at most one name.")
    printHint("  `dark discard` drops the whole draft; `dark discard <name>` drops one item.")
    failed(state)
  | [] ->
    let changed = SCM.PackageOps.draftBindings()
    let ops = SCM.PackageOps.draftOpCount()

    // Empty means NO OPS, not "no changed names". A draft can hold ops that bind nothing -- a
    // a version restore, a deprecation, an ack -- and deciding on the bindings alone would report
    // those as nothing to discard and leave them in place. The listing below is per binding and
    // stays that way; the count is the truth.
    if ops == 0 then
      Stderr.ok($"nothing to discard -- your draft on {scope} is empty.")
      state
    else
      // The plan is the answer, on stdout: what goes. The result line under it is a hint.
      //
      // A WARNING header, not a green one: this listing is what is about to be destroyed, and green
      // reads as "already fine".
      Stdlib.printLine(
        Stdlib.Cli.UI.Colors.warning(
          $"  DISCARDING ({Stdlib.display(Stdlib.List.length(changed))}) on {scope}, {Text.plural(ops, "op")}"))

      // Ops that bind no name have nothing to list per-name; say how many rather than showing an
      // empty listing under a header that promises one.
      let _ =
        if Stdlib.List.isEmpty(changed) then
          Stdlib.printLine(
            Stdlib.Cli.UI.Colors.dimText(
              "    (no changed names -- no new version: restores, deprecations, docs, acks)"))
        else
          ()

      changed
      |> Stdlib.List.iter(fun b ->
        // The FULL name, as `status` and the JSON spell it; a listing of what dies is the wrong place
        // to abbreviate.
        let name = SCM.Conflicts.fqn(b.owner, b.modules, b.name)
        Stdlib.printLine($"    - {name}"))

      // An explicit yes, not the usual default-yes: this is the one command here that destroys work, so a
      // stray Return or a piped stdin must not answer for you.
      if
        Stdlib.Bool.not(
          Prompt.confirmExplicit(confirm, Stdlib.Cli.UI.Colors.warning("\n  Drop these? [y/N]: ")))
      then
        if Stdlib.Cli.UI.Prompt.canAsk() then
          Stderr.ok("  kept.")
        else
          printErr(Prompt.refuseWithoutTerminal("Discard", "dark discard"))

        failed(state)
      else
        match SCM.PackageOps.discardDraft() with
        | Ok(n) ->
          Stderr.ok($"discarded {Text.plural(n, "op")} -- {scope} is back to its last commit.")
          state
        | Error(e) ->
          printErr($"couldn't discard: {e}")
          failed(state)


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []
