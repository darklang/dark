module Darklang.Cli.Discard

// `dark discard` -- decide against your draft.
//
// The draft is everything you've authored since the last `dark commit`. Authoring is live-on-write, so a
// draft is not pending work: it is already running, and discarding it takes those versions back out. What
// is already committed is never touched, which is what makes this safe to reach for.

let help(_state: AppState): String =
  [ ""
    "  dark discard          review what would go, then confirm"
    "  dark discard -y       skip the confirmation"
    "  dark discard <name>   drop just that item from your draft"
    ""
    "  Committed work is never touched: this drops the uncommitted ops of the branch you're on,"
    "  main included, and each name they touched is back to its committed version."
    "  To step ONE item BACK a version, that's `dark undo <name>`. To remove one from"
    "  the draft entirely, which is what a NEW item needs since it has no version to"
    "  step back to, `dark discard <name>`." ]
  |> Stdlib.String.join("\n")

let execute(state: AppState, args: List<String>): AppState =
  let confirm =
    Cli.Confirm.assumeIf(
      (Stdlib.List.contains(args, "-y")) || (Stdlib.List.contains(args, "--yes")))

  let named =
    args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.String.startsWith(a, "-")))

  let scope =
    match SCM.PackageOps.currentBranch() with
    | id when SCM.Branch.isMain(id) -> SCM.Branch.mainBranchName
    | id -> $"branch \"{SCM.PackageOps.branchName(id)}\""

  // `dark discard <name>` drops just that name's uncommitted bindings. It is the only way out for a
  // newly-authored item: `undo` steps back a VERSION and a new item has none, so without this a typo in
  // a new item blocks `commit` until the whole draft goes.
  match named with
  | [ arg ] ->
    match Packages.Location.parseRelativeTo(state.packageData.currentLocation, arg) with
    | Error(e) ->
      Cli.printErr(e)
      Cli.failed(state)
    | Ok(loc) ->
      let dotted = PropagateCmd.dotted(loc)
      let mods = Stdlib.String.join(loc.modules, ".")

      let inDraft =
        SCM.PackageOps.draftBindings()
        |> Stdlib.List.filter(fun b ->
          (b.owner == loc.owner) && (b.name == loc.name) && (b.modules == mods))

      let isRenamed = SCM.PackageOps.draftEntries() |> Stdlib.List.any(fun entry ->
        match entry.op with
        | Rename(oldLocation, newLocation, _, _, _) -> oldLocation == loc || newLocation == loc
        | _ -> false)

      if Stdlib.List.isEmpty(inDraft) && Stdlib.Bool.not(isRenamed) then
        Cli.Stderr.ok($"{dotted} isn't in your draft on {scope} -- nothing to discard.")
        Cli.printHint("  `dark status` lists what is.")
        state
      else if
        Stdlib.Bool.not((
          Cli.Prompt.confirmExplicit(
            confirm,
            Stdlib.Cli.UI.Colors.warning($"\n  Drop {dotted} from your draft? [y/N]: "))
        ))
      then
        Cli.Stderr.ok(
          $"  kept. (`dark discard {dotted} -y` if you mean it -- a piped stdin can't answer this.)")
        Cli.failed(state)
      else
        match SCM.PackageOps.discardDraftName(loc.owner, loc.modules, loc.name) with
        | Ok(n) ->
          Cli.printOk($"dropped {dotted} from your draft ({Cli.Text.plural(n, "op")}).")
          state
        | Error(e) ->
          Cli.printErr($"couldn't drop {dotted}: {e}")
          Cli.failed(state)
  | [_, _, ...] ->
    Cli.printErr("dark discard takes at most one name.")
    Cli.printHint("  `dark discard` drops the whole draft; `dark discard <name>` drops one item.")
    Cli.failed(state)
  | [] ->

  let changed = SCM.PackageOps.draftBindings()
  let ops = SCM.PackageOps.draftOpCount()

  // Empty means NO OPS, not "no changed names". A draft can hold ops that bind nothing -- a
  // a version restore, a deprecation, an ack -- and deciding on the bindings alone reported those
  // as nothing to discard and then left them in place, which `dark propagate` promptly showed
  // still there. The listing below is per binding and stays that way; the count is the truth.
  if ops == 0 then
    Cli.Stderr.ok($"nothing to discard -- your draft on {scope} is empty.")
    state
  else

  // A WARNING header, not a green one: this listing is what is about to be destroyed, and green
  // reads as "already fine".
  Cli.Stderr.line((
    Stdlib.Cli.UI.Colors.warning(
      $"  DISCARDING ({Stdlib.display(Stdlib.List.length(changed))}) on {scope}, {Cli.Text.plural(ops, "op")}")
  ))

  // Ops that bind no name have nothing to list per-name; say how many rather than showing an
  // empty listing under a header that promises one.
  let _ =
    if Stdlib.List.isEmpty(changed) then
      Cli.Stderr.line(
        (Stdlib.Cli.UI.Colors.dimText(
          "    (no changed names -- no new version: restores, deprecations, docs, acks)")))
    else
      ()

  changed
  |> Stdlib.List.iter(fun b ->
    // The FULL name, as `status` and the JSON spell it; a listing of what dies is the wrong place
    // to abbreviate.
    let name = SCM.Conflicts.fqn(b.owner, b.modules, b.name)
    Cli.Stderr.line($"    - {name}"))

  // An explicit yes, not the usual default-yes: this is the one command here that destroys work, so a
  // stray Return or a piped stdin must not answer for you.
  if
    Stdlib.Bool.not((
      Cli.Prompt.confirmExplicit(
        confirm,
        Stdlib.Cli.UI.Colors.warning("\n  Drop these? [y/N]: "))
    ))
  then
    Cli.Stderr.ok("  kept. (`dark discard -y` if you mean it -- a piped stdin can't answer this.)")
    Cli.failed(state)
  else

  match SCM.PackageOps.discardDraft() with
  | Ok(n) ->
    Cli.printOk($"discarded {Cli.Text.plural(n, "op")} -- {scope} is back to its last commit.")
    state
  | Error(e) ->
    Cli.printErr($"couldn't discard: {e}")
    Cli.failed(state)

let complete(
  _state: AppState,
  _args: List<String>)
  : List<Completion.CompletionItem> =
  []
