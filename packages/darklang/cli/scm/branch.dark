module Darklang.Cli.Branch

// Branches: isolated lines of work you can author and evaluate without touching main.
//
// A branch's ops are stored under its id, and its names resolve as its own work over what its
// parents committed. Nothing here writes SQL --
// all of it is siloed in `SCM.PackageOps` -- this file only parses arguments and formats what it returns.
//
// This file holds the lifecycle and registry surface (switch/list/archive, execute/help/complete). Merge and rebase are in branchMerge.dark, log and diff in
// branchHistory.dark; all three files share this module.

/// Where a branch id is, in words: `main`, or `branch "<name>"`. Main is never quoted and a branch
/// always is, so the two read differently in every message that names one.
let whereLabel(id: Uuid): String =
  if SCM.Branch.isMain(id) then
    SCM.Branch.mainBranchName
  else
    $"branch \"{SCM.PackageOps.branchName(id)}\""


/// The id of the branch <param branchRef> refers to, WITHOUT creating anything, or None.
///
/// Three spellings, because all three get printed at people and anything you can see you should be able to
/// paste: a NAME, which is what you normally type; a full ID, which a branch with no name of its own
/// goes by; and an ID PREFIX, which is what `dark branches` shows (8 characters).
///
/// Ambiguity is refused rather than guessed. Returns None on no match too; the caller decides whether that
/// is an error to report or a name to start a branch under.
let lookupRef(branchRef: String): Option<Uuid> =
  // The resolution itself is in `SCM.PackageOps.resolveBranchRef`, because the LSP needs the same
  // answer. What stays here is the WORDS.
  match SCM.PackageOps.resolveBranchRef(branchRef) with
  | Found(id) -> Some(id)
  | NotFound -> None
  | UnknownId(_) ->
    printErr($"no branch with id {branchRef} in this store.")
    printHint("  `dark branches` lists the branches here.")
    None
  | Ambiguous ->
    printErr($"\"{branchRef}\" matches more than one branch -- use more of the id, or its name.")
    None


/// The id of the branch you just named, or None having said why. What every READ verb goes through: a
/// branch we don't have is refused rather than started, so `dark merge typoo` says so instead of merging
/// an empty branch it just invented.
let resolveRef(branchRef: String): Option<Uuid> =
  match lookupRef(branchRef) with
  | Some(id) -> Some(id)
  | None ->
    printErr($"no branch \"{branchRef}\".")
    printHint("  `dark branches` lists them.")
    None


/// Show the current branch (or main).
///
/// Asks the PROCESS, not the config key: `--branch` and `DARK_BRANCH` both move the process without
/// touching the config, so reading the key would report the branch you'd be on if you hadn't asked for
/// another one.
let executeCurrent(state: AppState): AppState =
  printOk($"on {whereLabel(SCM.PackageOps.currentBranch())}.")
  state


/// Every branch, as the machine-readable shape. Same data the list renders, so the two can't drift.
let branchRows(unit: Unit): List<ScmJson.BranchJson> =
  let current = SCM.PackageOps.currentBranch()
  SCM.Branches.list()
  |> Stdlib.List.map(fun b ->
    ScmJson.BranchJson
      { // Ids are `Uuid` inside and text only where the medium is text. JSON is text.
        id = Stdlib.display(b.id)
        name = if b.name == "" then Stdlib.display(b.id) else b.name
        parent = Stdlib.display(b.parent)
        parentName = if SCM.Branch.isMain(b.parent) then "" else SCM.PackageOps.branchName(b.parent)
        ops = b.ops
        current = b.id == current
        merged = b.merged })


/// Whether `branches` shows merged branches. `--all` asks for them.
type Merged =
  | Show
  | Hide


module Merged =
  /// {{Show}} when <param asked>, the way `branches` reads `--all`.
  let showIf(asked: Bool): Merged =
    if asked then Merged.Show else Merged.Hide


/// List all active branches.
let executeList(state: AppState, merged: Merged): AppState =
  let includeMerged = merged == Merged.Show
  let header = $"on {whereLabel(SCM.PackageOps.currentBranch())}. branches:"
  let listing = SCM.PackageOps.branchList(includeMerged)
  if Stdlib.List.isEmpty(SCM.Branches.listLines(includeMerged)) then
    Stderr.ok(header)
    Stderr.line(listing)
  else
    printOk(header)
    Stdlib.printLine(listing)

  state


/// Switch the current branch: persistently (the `current_branch` config key, so the next process starts
/// here) AND in this process (the branch names resolve on and code runs on). `switch main` (or
/// empty) returns to main.
///
/// Both halves are needed: the interactive REPL is one long-lived process, so writing only the config key
/// leaves it on whatever branch it booted on while the status bar says otherwise.
/// What a switch does with a name no unmerged branch has.
type IfMissing =
  | Refuse
  | Start


/// `dark switch <ref>`: move onto an existing branch.
let executeSwitch(state: AppState, branchRef: String): AppState =
  executeSwitchTo(state, branchRef, IfMissing.Refuse)


let executeSwitchTo(state: AppState, branchRef: String, ifMissing: IfMissing): AppState =
  // Decided BEFORE the switch, which can create a branch and change what the name resolves to.
  let refused =
    if Stdlib.String.startsWith(branchRef, "-") then
      true
    else if branchRef == "" || branchRef == SCM.Branch.mainBranchName then
      false
    else
      match SCM.PackageOps.resolveBranchRef(branchRef), ifMissing with
      | UnknownId(_), _ -> true
      | Ambiguous, _ -> true
      | NotFound, Refuse -> true
      | Found(existing), Refuse -> SCM.PackageOps.branchIsMerged(existing)
      | _ -> false

  // The branch a switch lands on, RETURNED rather than assumed, so the REPL's state moves with the process's
  // branch instead of drifting from it for the rest of the session.
  let landedOn =
    match branchRef with
    // A leading dash is a mistyped flag or a sweep's argument, never a branch name. Without this
    // arm `dark switch --help` starts a branch called "--help" and moves the store onto it.
    | ref when Stdlib.String.startsWith(ref, "-") ->
      let _ = printErr($"\"{ref}\" starts with a dash, so it's a flag rather than a branch name.")
      let _ = printHint("  `dark switch <branch>`, and `dark branches` lists them.")
      SCM.PackageOps.currentBranch()
    | ref when ref == "" || ref == SCM.Branch.mainBranchName ->
      let _ = SCM.PackageOps.selectBranch(SCM.Branch.mainBranchId)
      let _ = printOk($"switched to {SCM.Branch.mainBranchName}.")
      SCM.Branch.mainBranchId
    | ref ->
      // A branch started while on another branch is parented to it (branches off branches). The parent
      // is whatever we're currently on, BY ID -- the parent link is a reference, and references don't
      // follow a rename. An existing branch is never re-parented, so switching onto one can't move it.
      let parentId =
        match SCM.PackageOps.currentBranch() with
        | id when SCM.Branch.isMain(id) -> SCM.Branch.mainBranchId
        | cur -> cur

      // Resolve BEFORE creating; `lookupRef` takes a name or an id. It also resolves MERGED branches,
      // because read verbs need them -- but switching onto one must not, since its work is already in the
      // parent. A merged name is therefore free again, and `switch -c` starts a new branch under it.
      // A foreign uuid or an ambiguous prefix is refused, with the reason `lookupRef` printed; starting
      // a branch NAMED after either read as success.
      let resolved =
        match SCM.PackageOps.resolveBranchRef(ref) with
        | Found(existing) ->
          if SCM.PackageOps.branchIsMerged(existing) then
            startOrRefuse(ref, parentId, ifMissing)
          else
            Some((existing, false))
        | NotFound -> startOrRefuse(ref, parentId, ifMissing)
        | UnknownId(_) ->
          let _ = lookupRef(ref)
          None
        | Ambiguous ->
          let _ = lookupRef(ref)
          None

      match resolved with
      | None -> SCM.PackageOps.currentBranch()
      | Some(pair) ->
        let (branchId, created) = pair
        let handle =
          match SCM.PackageOps.branchName(branchId) with
          | "" -> Stdlib.display(branchId)
          | named -> named

        // Moves this process and stores the branch, by id, for the next command.
        let _ = SCM.PackageOps.selectBranch(branchId)
        let parentNote =
          if SCM.Branch.isMain(parentId) then
            ""
          else
            $" (off \"{SCM.PackageOps.branchName(parentId)}\")"

        let _ =
          if created then
            printOk($"started branch \"{handle}\"{parentNote}.")

            // A merged namesake exists: the "come back after lunch" move is `switch <old name>`, and
            // silently starting an empty impostor lets you edit a branch you believe holds your work.
            let namesake =
              SCM.Branches.list()
              |> Stdlib.List.any(fun b -> b.name == handle && b.merged && b.id != branchId)

            if namesake then
              printHint(
                $"  note: an earlier \"{handle}\" was merged; this one is fresh. `dark branches --all` shows both.")
            else
              ()
          else
            ()

        let _ =
          printOk(
            $"switched to branch \"{handle}\" -- authoring + eval target it now (`dark switch main` to return).")

        branchId

  exitWith({ state with currentBranchId = landedOn }, Stdlib.Bool.not(refused))


/// Where merging <branchId> leaves you: its parent, as (id, name). A branch with no row is treated as
/// parented to main, which is what ops under an id with no registry row look like.
let parentOf(branchId: Uuid): (Uuid * String) =
  match SCM.Branches.list() |> Stdlib.List.findFirst(fun b -> b.id == branchId) with
  | Some(b) -> (b.parent, SCM.PackageOps.branchName(b.parent))
  | None -> (SCM.Branch.mainBranchId, SCM.Branch.mainBranchName)


/// `dark branch rename <branch> <new-name>`
///
/// One UPDATE and nothing else moves: a name is an alias, and ops, per-name bases and parent links all
/// point at the id.
let executeRename(state: AppState, branchRef: String, newName: String): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) ->
    if SCM.Branch.isMain(branchId) then
      printErr("main is the trunk; it has no name to change.")
      failed(state)
    else
      let was = SCM.PackageOps.branchName(branchId)
      match SCM.Branch.rename(branchId, newName) with
      | Ok(b) ->
        // The store keeps the name beside the id, so it goes stale on a rename of the branch you
        // are standing on. Selecting it again stores the new one.
        if SCM.PackageOps.currentBranch() == branchId then
          let _ = SCM.PackageOps.selectBranch(branchId)
          ()
        else
          ()

        printOk($"renamed \"{was}\" to \"{b.name}\". Nothing else moved: references are by id.")
        state
      | Error(e) ->
        printErr(e)
        failed(state)


/// Archive (soft-delete) a branch: its unmerged ops are discarded and it leaves every listing, `--all`
/// included. So it asks the same way `discard` and `merge` do: say what would go, then take an explicit
/// yes, which a piped stdin cannot give.
///
/// A branch with nothing unmerged has nothing to lose, so that case goes straight through -- the whole
/// point of the question is the work, and there is none.
let executeArchive(state: AppState, branchRef: String, confirm: Confirm): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  // A child resolves names through its parent chain, so archiving a parent takes the parent's work
  // out from under it: the child's code stops resolving, its listing shows a parent "not in this
  // store", and merging it lands ops whose dependencies are gone. Merge has refused this since it
  // was written; archive is the same act by another route and now refuses it too.
  | Some(branchId)
    when Stdlib.Bool.not(Stdlib.List.isEmpty(SCM.Branches.activeChildNames(branchId))) ->
    let kids = SCM.Branches.activeChildNames(branchId)
    printErr(
      $"cannot archive \"{branchRef}\": {Text.plural(Stdlib.List.length(kids), "branch")} still branch off it.")

    kids |> Stdlib.List.iter(fun k -> printHint($"    - {k}"))
    printHint("  merge or archive them first, and this one can go.")
    failed(state)
  | Some(branchId) ->
    let entries = SCM.PackageOps.branchDiffEntries(branchId)
    let confirmed =
      if entries == [] || confirm == Confirm.Assume then
        true
      else
        // Warning-colored like DISCARDING: this listing is what is about to be destroyed, and
        // green reads as "already fine".
        Stderr.line(
          Stdlib.Cli.UI.Colors.warning(
            $"  ARCHIVING \"{branchRef}\" discards {Text.plural(Stdlib.List.length(entries), "unmerged name")}:"))

        entries
        |> Stdlib.List.iter(fun e ->
          Stderr.line(Stdlib.Cli.UI.Colors.dimText($"    - {e.name}  [{e.kind}]")))

        Stderr.hint("  `dark merge` first if you meant to keep them.")
        Prompt.confirmExplicit(confirm, Stdlib.Cli.UI.Colors.warning("\n  Archive it? [y/N]: "))

    if Stdlib.Bool.not(confirmed) then
      if Stdlib.Cli.UI.Prompt.canAsk() then
        Stderr.ok("  kept.")
      else
        printErr(Prompt.refuseWithoutTerminal("Archive", $"dark branch archive {branchRef}"))

      failed(state)
    else
      // The parent, read BEFORE the archive: an archived branch drops out of the listing `parentOf`
      // reads, so asking afterwards answers main even for a branch of a branch.
      let (parentId, _) = parentOf(branchId)
      match SCM.PackageOps.archiveBranch(branchId) with
      | Ok(_) ->
        printOk($"archived branch \"{branchRef}\".")
        // Same as merge: standing on the branch you just archived is standing on finished work, and the
        // next edit would land there and revive it. Move to the parent, in this process and in the
        // config the next one reads, and say so.
        if SCM.PackageOps.currentBranch() == branchId then
          let _ = SCM.PackageOps.selectBranch(parentId)
          printOk($"now on {whereLabel(parentId)} -- that's where the next edit lands.")
          { state with currentBranchId = parentId }
        else
          state
      | Error(e) ->
        printErr($"couldn't archive: {e}")
        failed(state)


/// The page for `dark branch` AND for the root commands that share this file's subject: `branches`,
/// `switch`, `rebase`, `diff`, `log`, `resolve`. They are one thing seen from six angles, and the "Also
/// at the root" block below is where each of them is documented. `merge` gets its own page
/// (`mergeHelp`) because it is the one that moves work into a parent and the questions are different.
let help(_state: AppState): String =
  [ ""
    "  You name a branch; it gets a uuid underneath. Names are what you"
    "  type and can reuse; the uuid is what its ops and parent links"
    "  point at. `dark branches` shows both."
    ""
    "  dark branch                   show the current branch (or main)"
    "  dark branch create <name>     start a branch off this one and switch to it"
    "  dark branch switch <name>     switch to a branch"
    "  dark branch list              name (id) <- parent [status]"
    "  dark branch list --all        include the ones already merged"
    "  dark branch rename <old> <new>   give a branch a different name"
    "  dark branch archive <name> [-y|--yes]  discard a branch + its unmerged work"
    "  dark branch diff <name> [--source]  what it changes vs its parent, with source"
    "  dark branch log <name>        its ops, oldest-first"
    ""
    "  Also at the root, because you reach for them constantly:"
    "  dark branches                 same as `dark branch list`"
    "  dark branches --all           merged branches too (hidden by default)"
    "  dark switch <name>            same as `dark branch switch`"
    "  dark switch -c <name>         same as `dark branch create` (or --create)"
    "  dark merge <name>             merge a branch into its parent"
    "  dark merge <name> --allow-type-errors   even with type errors in it"
    "  dark rebase <name> [--dry-run]  accept the parent's changes into a branch"
    "  dark diff <name>              same as `dark branch diff`"
    "  dark log [name]               its ops; on main, the commits"
    "  dark resolve <branch> <name> mine|theirs"
    "                                keep the branch's, or the parent's"
    "  `branches`, `diff` and `log` take --json."
    ""
    "  Conflicts: `dark conflicts branch <name>` previews; `dark"
    "  conflicts` reviews recorded ones."
    "  One-off, without switching: `dark --branch <name> eval <expr>`"
    "  One shell at a time: `export DARK_BRANCH=<name>`" ]
  |> Stdlib.String.join("\n")


/// `dark branch ...`. A word here is always a subcommand, never a branch name, so a typo can't start a
/// branch and a branch can be called anything; `create` is how one starts.
let execute(state: AppState, args: List<String>): AppState =
  // Flags come out before the words are matched, so they work anywhere on the line:
  // `archive -y x` is `archive x -y`. `Accepts` has already refused any a subcommand doesn't take.
  let (flags, words) = Stdlib.List.partition(args, fun a -> Stdlib.String.startsWith(a, "-"))
  let has(flag: String): Bool = Stdlib.List.contains(flags, flag)
  match words with
  | [] -> executeCurrent(state)
  | ["list"] -> executeBranchesCmd(state, flags)
  | ["current"] -> executeCurrent(state)
  | ["switch", id] -> executeSwitch(state, id)
  | ["new", id] -> executeCreate(state, id)
  | ["create", id] -> executeCreate(state, id)
  | ["archive", id] -> executeArchive(state, id, Confirm.assumeIf(has("-y") || has("--yes")))
  | ["rename", id, newName] -> executeRename(state, id, newName)
  | ["diff", id] -> executeDiffCmd(state, Stdlib.List.prepend(flags, id))
  | ["log", id] -> executeLogCmd(state, [ id ])
  | ["merge", id] -> executeMergeCmd(state, Stdlib.List.prepend(flags, id))
  | ["rebase", id] -> executeRebase(state, id)
  | ["resolve", id, name, choice] -> executeResolve(state, id, name, choice)
  | [word] ->
    printErr($"`dark branch` does not take `{word}`.{Accepts.didYouMean(word, knownSubcommands)}")
    if hasActiveBranchNamed(word) then
      printHint($"  to switch to the branch `{word}`, run `dark switch {word}`")
    else
      printHint($"  to create a branch named `{word}`, run `dark branch create {word}`")

    printHint("  `dark branch --help` shows what it takes.")
    failed(state)
  | _ ->
    // Printing help alone reads as though nothing happened, so say what was not understood first.
    printErr($"`dark branch {Stdlib.String.join(args, " ")}` isn't a form of this command.")
    Stdlib.printErrorLine(help(state))
    failed(state)


/// Subcommands `dark branch` knows, for "did you mean".
val knownSubcommands =
  [ "list"
    "current"
    "switch"
    "new"
    "create"
    "rename"
    "archive"
    "diff"
    "log"
    "merge"
    "rebase"
    "resolve" ]


/// Whether <param name> is main or an unmerged branch's name. A merged branch's name is free again.
let hasActiveBranchNamed(name: String): Bool =
  name == SCM.Branch.mainBranchName
  || (SCM.Branches.list() |> Stdlib.List.any(fun b -> b.name == name && Stdlib.Bool.not(b.merged)))


/// `dark branch create <name>`: start a branch off the current one and move onto it. A name a branch
/// already has is refused rather than switched to.
let executeCreate(state: AppState, name: String): AppState =
  if hasActiveBranchNamed(name) then
    printErr($"{name} already exists, so it can't be created.")
    printHint($"  `dark switch {name}` goes to it.")
    failed(state)
  else
    executeSwitchTo(state, name, IfMissing.Start)


/// `dark branches`
let executeBranchesCmd(state: AppState, args: List<String>): AppState =
  // A program wants the whole set rather than the readable subset.
  Output.answer(
    state,
    (fun () -> executeList(state, Merged.showIf(Stdlib.List.contains(args, "--all")))),
    fun () -> branchRows())


/// Start the branch named <param name> off <param parentId>, or say why it could not be.
/// A switch to a name no unmerged branch has: start it, or say how to.
let startOrRefuse(name: String, parentId: Uuid, ifMissing: IfMissing): Option<(Uuid * Bool)> =
  match ifMissing with
  | Start -> start(name, parentId)
  | Refuse ->
    let names =
      SCM.Branches.list()
      |> Stdlib.List.filter(fun b -> Stdlib.Bool.not(b.merged) && b.name != "")
      |> Stdlib.List.map(fun b -> b.name)
      |> Stdlib.List.prepend(SCM.Branch.mainBranchName)

    printErr($"There is no branch named `{name}`.{Accepts.didYouMean(name, names)}")
    printHint($"  to start it: dark switch -c {name}")
    printHint("  `dark branches` lists them.")
    None


let start(name: String, parentId: Uuid): Option<(Uuid * Bool)> =
  match SCM.PackageOps.ensureBranch(name, parentId) with
  | Ok(pair) -> Some(pair)
  | Error(e) ->
    printErr(SCM.Actions.failureMessage(e))
    None


/// `dark switch [-c] [<id>]`. No argument reports where you are rather than switching, so a bare
/// `switch` can't silently move you to main. Only `-c` starts a branch, so a typo can't.
let executeSwitchCmd(state: AppState, args: List<String>): AppState =
  let create = Stdlib.List.contains(args, "-c") || Stdlib.List.contains(args, "--create")
  let words = Stdlib.List.filter(args, fun a -> a != "-c" && a != "--create")
  match words, create with
  | [], false -> executeCurrent(state)
  | [id], false -> executeSwitch(state, id)
  | [id], true -> executeCreate(state, id)
  | _, _ ->
    printErr(
      "usage: dark switch <branch>, or dark switch -c <new branch>   (`dark switch main` returns to main)")

    failed(state)


/// One `complete` is shared by branch/switch/merge/rebase/branches/resolve, so it can't tell which
/// word was typed. Branch names are the right answer for nearly all of them, so offer those plus the
/// subcommands and let the prefix filter sort it out.
let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  let branchTakingSubcommands = [ "switch", "archive", "diff", "log", "merge", "rebase", "resolve" ]
  let subcommands =
    Stdlib.List.concat(branchTakingSubcommands, [ "list", "current", "create", "new", "rename" ])

  let branchNames =
    SCM.Branches.list()
    |> Stdlib.List.map(fun b -> b.name)
    |> Stdlib.List.filter(fun n -> n != "")

  let matching(options: List<String>, partial: String): List<Completion.CompletionItem> =
    options
    |> Stdlib.List.filter(fun o -> Stdlib.String.startsWith(o, partial))
    |> Stdlib.List.map(Completion.simple)

  match args with
  | [] -> matching(Stdlib.List.concat(branchNames, subcommands), "")
  | [partial] -> matching(Stdlib.List.concat(branchNames, subcommands), partial)
  | [sub, partial] ->
    if Stdlib.List.contains(branchTakingSubcommands, sub) then
      matching(Stdlib.List.append(branchNames, SCM.Branch.mainBranchName), partial)
    else
      []
  | _ -> []
