module Darklang.Cli.Branch

// `log` and `diff`: a branch's op sequence, its net effect vs its parent, and their rendering.
// Part of the Darklang.Cli.Branch module, shared with branch.dark and branchMerge.dark.

/// The module part of a dotted name, for grouping. `Stachu.Thing.foo` -> `Stachu.Thing`.
let moduleOf(dotted: String): String =
  match Stdlib.List.dropLast(Stdlib.String.split(dotted, ".")) with
  | [] -> dotted
  | parts -> Stdlib.String.join(parts, ".")


/// Whether `diff` prints each changed definition under its name. `--source` asks for it.
type Source =
  | Show
  | Hide


module Source =
  /// {{Show}} when <param asked>, the way `diff` reads `--source`.
  let showIf(asked: Bool): Source =
    if asked then Source.Show else Source.Hide


/// `dark branch diff <name> [--source]`
///
/// Grouped by module, because a branch that touched nine names in three modules is three things you did,
/// not nine. `--source` prints each definition underneath, which a list of hashes cannot give you: seeing
/// WHAT changed without opening another command per name.
let executeDiff(state: AppState, branchRef: String, source: Source): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) ->
    match SCM.PackageOps.branchDiffEntries(branchId) with
    | [] ->
      if SCM.PackageOps.branchIsMerged(branchId) then
        let n = Text.plural(Stdlib.List.length(SCM.PackageOps.mergedOpsOf(branchId)), "op")
        printOk($"\"{branchRef}\" is merged: its {n} are its parent's now.")
        printHint($"  `dark log {branchRef}` lists them.")
      else
        printOk($"\"{branchRef}\" changes nothing vs its parent.")

      state
    | entries ->
      let n = Text.plural(Stdlib.List.length(entries), "name")
      printOk($"\"{branchRef}\" changes {n} vs its parent:")
      entries
      |> Stdlib.List.groupBy(fun e -> moduleOf(e.name))
      |> Stdlib.List.iter(fun group ->
        let (modulePath, inModule) = group
        Stdlib.printLine("")
        Stdlib.printLine(Stdlib.Cli.UI.Colors.boldText($"  {modulePath}"))
        inModule
        |> Stdlib.List.iter(fun e ->
          let mark = if e.change == "new" then "+" else "~"
          let leaf =
            Stdlib.Option.withDefault(Stdlib.List.last(Stdlib.String.split(e.name, ".")), e.name)

          let short = SCM.Conflicts.shortHash(e.hash)
          let was =
            if e.change == "new" then
              ""
            else
              $" (was {SCM.Conflicts.shortHash(e.parentHash)})"

          Stdlib.printLine($"    {mark} {leaf}  [{e.kind}] {short}{was}")
          if source == Source.Show then
            Stdlib.printLine(
              Stdlib.Cli.UI.Colors.dimText(
                Conflicts.indentBlock(Conflicts.renderItem(branchId, e.kind, e.hash, leaf))))
          else
            ()))

      if source == Source.Hide then
        Stdlib.printErrorLine("")
        printHint("  `dark diff <branch> --source` shows each definition.")
      else
        ()

      state


/// The branch's authoring history: its frontier ops, oldest-first, pretty-printed (the op SEQUENCE,
/// complementary to `diff`'s net effect).
let executeLog(state: AppState, branchRef: String): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) ->
    let ops = SCM.PackageOps.branchOps(branchId)
    // A merged branch's tags are gone; its merge events still say what it carried.
    let merged = if Stdlib.List.isEmpty(ops) then SCM.PackageOps.mergedOpsOf(branchId) else []
    let n = Text.plural(Stdlib.List.length(ops), "op")
    let m = Text.plural(Stdlib.List.length(merged), "op")
    if Stdlib.Bool.not(Stdlib.List.isEmpty(ops)) then
      printOk($"{n} on branch \"{branchRef}\" (oldest first):")
      ops
      |> Stdlib.List.iter(fun op ->
        Stdlib.printLine(PrettyPrinter.ProgramTypes.PackageOp.packageOp(branchId, op)))
    else if Stdlib.Bool.not(Stdlib.List.isEmpty(merged)) then
      printOk($"{m} merged from branch \"{branchRef}\" into its parent (oldest first):")
      // Names resolve against the PARENT: the ops are its now, and the merged branch holds none of
      // them, so resolving against it would print every hash bare.
      let parent = SCM.PackageOps.branchParentOf(branchId)
      merged
      |> Stdlib.List.iter(fun op ->
        Stdlib.printLine(PrettyPrinter.ProgramTypes.PackageOp.packageOp(parent, op)))
    else
      printOk($"branch \"{branchRef}\" has no ops yet.")

    state


/// `dark diff <id>`
let executeDiffCmd(state: AppState, args: List<String>): AppState =
  // The flag is not the branch. Filtering flags out first is what lets `dark diff foo --json` and
  // `dark diff --json foo` mean the same thing, rather than one looking for a branch named "--json".
  let refs = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.String.startsWith(a, "-")))
  match refs with
  // No branch named: the draft. The commonest question -- what have I changed and not committed --
  // gets the name every other tool gives it. `dark commit` reviews the same list, but reviewing is
  // not what `diff` asks for.
  | [] ->
    let r = Commit.review(state)
    if ScmJson.wantsJson(args) then
      let printed =
        printJson(
          ScmJson.draftDiffJson(
            ScmJson.DraftDiffJson
              { draftOps = (SCM.Draft.counts()).ops, changed = r.items, removed = r.removed }))

      exitWith(state, printed)
    else if Stdlib.List.isEmpty(r.changed) then
      // Ops that bind no name (a deprecation, a restore, an ack) have nothing to show in a per-name
      // listing, but "clean" about them is a lie: they are uncommitted. Same fix as `status`.
      let ops = (SCM.Draft.counts()).ops
      if ops == 0 then
        printOk("clean: nothing changed since your last commit.")
      else
        printOk(
          $"""{Text.plural(ops, "op")} to commit, no changed names (no new version: restores, deprecations, docs, acks)""")

      printHint("  `dark diff <branch>` compares a branch with its parent.")
      state
    else
      let nameWidth = Commit.widest(r.items |> Stdlib.List.map(fun i -> i.name))
      printOk($"  CHANGED ({Stdlib.display(Stdlib.List.length(r.changed))})")
      r.items |> Stdlib.List.iter(fun item -> Stdlib.printLine(Commit.changedLine(nameWidth, item)))
      printHint("  `dark commit` reviews and commits it; `dark diff <branch>` compares a branch.")
      state
  | [id] ->
    if ScmJson.wantsJson(args) then
      match resolveRef(id) with
      | None -> failed(state)
      | Some(branchId) ->
        exitWith(
          state,
          printJson(ScmJson.branchDiffJson(SCM.PackageOps.branchDiffEntries(branchId))))
    else
      executeDiff(state, id, Source.showIf(Stdlib.List.contains(args, "--source")))
  | _ ->
    printErr("usage: dark diff <branch> [--source] [--json]")
    printHint("  `dark branches` lists them.")
    failed(state)


/// The branch's ops as JSON, oldest first -- the same sequence the human view prints.
/// False when the branch is not found, so `log --json` exits 1 rather than reading as an empty log.
let branchOpsAsJson(branchRef: String): Bool =
  match resolveRef(branchRef) with
  | None -> false
  | Some(branchId) ->
    let rendered =
      SCM.PackageOps.branchOps(branchId)
      |> Stdlib.List.indexedMap(fun(i, op) ->
        ScmJson.BranchOpJson
          { seq = i, op = PrettyPrinter.ProgramTypes.PackageOp.packageOp(branchId, op) })

    printJson(ScmJson.branchOpsJson(rendered))


/// `dark log [<id>]` -- history, meaning whichever history you're standing in. On a BRANCH that's the
/// branch's own ops, oldest first; on MAIN there is no delta, so it's the commits.
let executeLogCmd(state: AppState, args: List<String>): AppState =
  let wantsJson = ScmJson.wantsJson(args)
  let refs = args |> Stdlib.List.filter(fun a -> Stdlib.Bool.not(Stdlib.String.startsWith(a, "-")))
  match refs with
  | [id] ->
    if wantsJson then
      exitWith(state, branchOpsAsJson(id))
    else
      executeLog(state, id)
  | [] ->
    match SCM.PackageOps.currentBranch() with
    | id when SCM.Branch.isMain(id) ->
      if wantsJson then
        // On main `log` IS the commit history, so it answers with exactly what `commits --json` answers.
        exitWith(state, printJson(ScmJson.commitsJson(Commits.commitRows(20))))
      else
        Commits.executeList(state, 20, Commits.Housekeeping.Hide)
    // By NAME, because `executeLog` echoes back whatever it was handed and everything else the CLI
    // prints about a branch is its name. `resolveRef` turns it straight back into this id.
    | id ->
      let branchRef = SCM.PackageOps.branchName(id)
      if wantsJson then
        exitWith(state, branchOpsAsJson(branchRef))
      else
        executeLog(state, branchRef)
  | _ ->
    printErr("usage: dark log [<branch>] [--json]")
    failed(state)
