/// `dark squash`: collapse the run of your own unpushed commits at the tip into one.
///
/// What it is for: with `live.autopush` on, every save is its own commit, so a morning's work is
/// forty commits on the relay. This is the "collapse afterwards" half of that problem. It does NOT
/// reduce how many times you pushed; see the note in `help`.
///
/// It mints no op and deletes no op. An op's id is its content hash and membership in a commit is
/// `package_ops.commit_hash`, so this is an UPDATE of one column; `SCM.Commits.squashRun` says more.
module Darklang.Cli.Squash

/// The run at the tip that is safe to collapse: YOUR commits, none of whose ops has been pushed,
/// oldest first.
///
/// Both tests matter and they fail differently. A commit that is not yours is a peer's, pulled, and
/// its ops are filed under the author's commit on purpose; sweeping it in would reattribute somebody
/// else's work to you. A commit that has been pushed is one the relay has already filed, and it will
/// not hear a correction. So the walk stops at the first commit failing either, rather than skipping
/// it and carrying on, because a run with a hole in it is not a parent chain.
let runAtTip (state: Cli.AppState) : List<SCM.Commits.Commit> =
  let me = Cli.Commit.commitAuthor state

  let walk
    (hash: String)
    (acc: List<SCM.Commits.Commit>)
    : List<SCM.Commits.Commit> =
    if hash == "" then
      acc
    else
      match SCM.Commits.byHashPrefix hash with
      | None -> acc
      | Some c ->
        if c.author != me then
          acc
        else if SCM.Wire.commitHasPushedOps c.hash then
          acc
        else
          walk c.parent (Stdlib.List.push acc c)

  walk (SCM.PackageOps.parentCommitFor state.currentBranchId) []

let help (_state: Cli.AppState) : String =
  [ ""
    "Usage: dark squash [message]"
    ""
    "Collapses the run of YOUR unpushed commits at the tip into one. With"
    "`live.autopush` on, every save is its own commit, and this is how a"
    "morning of them becomes one."
    ""
    "It stops at the first commit that is already pushed, or that somebody"
    "else wrote. Both are deliberate: a relay has already filed a pushed"
    "op under its old commit and will not hear a correction, and a peer's"
    "ops are filed under the author's commit on purpose."
    ""
    "It does NOT reduce how many times you pushed. Autopush pushes once per"
    "save, which is the point of it; this only tidies the log afterwards. If"
    "the push count is what hurts rather than the log, what you want is a"
    "batching window on autopush, which does not exist yet."
    ""
    "  dark squash                   collapse them, with a generated message"
    "  dark squash \"the morning\"      collapse them under your own message"
    ""
    "No op is minted, deleted or re-inserted; only which commit each op"
    "names. `dark commits` afterwards shows the one."
    "" ]
  |> Stdlib.String.join "\n"

let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [ "--help" ] ->
    Stdlib.printLine (help state)
    state
  | _ ->
    let run = runAtTip state

    match run with
    | [] ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint
          "nothing to squash -- the commit at the tip is either already pushed or not yours")
      state
    | [ _ ] ->
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint "nothing to squash -- one unpushed commit is already one commit")
      state
    | _ ->
      let count = Stdlib.List.length run

      let message =
        match args with
        | [] -> $"squashed {Stdlib.toString count} commits"
        | _ -> Stdlib.String.join args " "

      match SCM.Commits.squashRun run message (Cli.Commit.commitAuthor state) with
      | Ok hash ->
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.success
            $"✓ squashed {Stdlib.toString count} commits into {Stdlib.String.first hash 8}")

        Stdlib.printLine (Stdlib.Cli.UI.Colors.hint $"  {message}")
        state
      | Error e ->
        Cli.printErr $"cannot squash: {e}"
        { state with exitCode = 1 }

let complete
  (_state: Cli.AppState)
  (_args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  []
