module Darklang.Cli.Status

// `dark status` -- the ONE signal you get while editing.
//
// Editing is silent by design: no propagation prompts, no walls of generated ops, nothing nagging you when
// you change a fn five times in a row. The cost of that quiet is that you need somewhere to look, and this
// is it: one line saying what's in your draft, what committing it would repoint, and whether anything is
// waiting on you. If it can't be said in a line or two, it belongs in `dark commit`, not here.

/// The full structured view. `dark status` prints a line of it; `--json` hands over all of it.
let statusJson (state: AppState) : ScmJson.StatusJson =
  let p = SCM.Draft.read ()

  let items =
    p.bindings
    |> Stdlib.List.map (fun b ->
      ScmJson.changedItem
        state.currentBranchId
        p.propagated
        b
        (Commit.previousHashesOf state.currentBranchId b))

  ScmJson.StatusJson
    { branch =
        // The NAME, like everywhere else user-facing: what `--json`'s reader can pass to another command.
        SCM.PackageOps.branchName (SCM.PackageOps.currentBranch ())
      draftOps = p.ops
      changed = items
      removed = p.removed
      propagates = p.repoints
      leftBehind = p.leftBehind
      conflicts = p.conflicts
      // A COUNT, never a list; see `Summary.constraints`.
      constraints = p.constraints }

/// Where you are, always, before what you have: a draft summary that doesn't name its branch reads the
/// same on main as on a branch.
let branchLine (state: AppState) : Unit =
  match state.currentBranchId with
  | id when SCM.Branch.isMain id ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.hint $"On branch {SCM.Branch.mainBranchName}")
  | id ->
    // Fall back to the id: a branch first registered by authoring rather than by `switch` has no name, and
    // "On branch " with nothing after it is worse than an id you can act on.
    let handle =
      match SCM.Branch.get id with
      | Some b -> if b.name == "" then Stdlib.Uuid.toString id else b.name
      | None -> Stdlib.Uuid.toString id

    Stdlib.printLine (Stdlib.Cli.UI.Colors.hint $"On branch {handle}")

let executePretty (state: AppState) : AppState =
  // `SCM.Draft.counts`, not a `Picture`: this runs on every invocation and only ever prints numbers.
  //
  // `changed` counts what you edited AND what followed your edit, since both get committed; `followed`
  // is how many of them propagation did, and one number for both would hide it. `removed` counts names
  // the draft takes away, which are bindings gone rather than bindings changed. `constraints` is a
  // COUNT and never a list: they are a standing property of the STORE rather than of your draft, so
  // they show even on a clean tree, and a list here is a thing you learn to scroll past.
  let s = SCM.Draft.counts ()
  branchLine state

  // `s.ops` is in the clean test, not just the three name-shaped counts. An op that binds no name --
  // a deprecation, a pin, an ack -- is still uncommitted work, and counting only bindings reported
  // "clean" right after `dark delete X`, with the Deprecate sitting in the draft waiting to be swept
  // into whatever got committed next. Same mistake `discard` made about the same ops.
  if
    (s.changed == 0) && (s.removed == 0) && (s.conflicts == 0L) && (s.ops == 0L)
  then
    Cli.printOk "clean: nothing changed since your last commit."

    // Nothing in a clean tree is yours, so say the constraints stand on their own.
    if s.constraints > 0 then
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint
          $"""  {Cli.Text.plural s.constraints "standing constraint"} in the store -> `dark constraints`""")
  else
    let parts =
      Stdlib.List.append
        (Stdlib.List.append
          (if s.changed == 0 then
             []
           else if s.followed == 0 then
             [ $"{Cli.Text.plural s.changed "item"} changed" ]
           else if s.changed == s.followed then
             // Everything here followed something (a pin/follow round trip, a cascade from a pull);
             // "0 items changed, 1 followed" states a zero nobody typed.
             [ $"{Cli.Text.plural s.followed "item"} followed" ]
           else
             // What you did and what followed, separately; see `Summary.followed`.
             [ $"{Cli.Text.plural (s.changed - s.followed) "item"} changed, {Stdlib.Int.toString s.followed} followed" ])
          (if s.removed == 0 then [] else [ $"{Cli.Text.plural s.removed "item"} removed" ]))
        (Stdlib.List.append
          (if s.repoints == 0 then
             []
           else
             [ $"{Cli.Text.plural s.repoints "dependent"} will repoint" ])
          (if s.conflicts == 0L then
             []
           else
             [ $"{Cli.Text.plural (Stdlib.Int.fromInt64 s.conflicts) "conflict"} to review" ]))

    // Nothing name-shaped to describe, but ops all the same: say what they are rather than printing
    // "draft: " with an empty list after it.
    if Stdlib.List.isEmpty parts then
      Cli.printOk
        $"""draft: {Cli.Text.plural (Stdlib.Int.fromInt64 s.ops) "op"}, no changed names (no new version: pins, deprecations, docs, acks)"""
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint "  -> `dark commit` to review + commit (it asks first)")
    else
      Cli.printOk $"""draft: {Stdlib.String.join parts ", "}"""

    if s.conflicts > 0L then
      Stdlib.printLine (Stdlib.Cli.UI.Colors.hint "  -> `dark conflicts` to review them")

    // Split what this draft caused from what was already there: on a store with standing
    // constraints, one number reads as "your edit broke N things".
    if s.constraints > 0 then
      let mine =
        if s.constraintsFromDraft == 0 then
          "none from this draft"
        else
          $"{Stdlib.Int.toString s.constraintsFromDraft} from this draft"
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint
          $"""  {Cli.Text.plural s.constraints "constraint"} outstanding, {mine} -> `dark constraints`""")

    if (s.changed > 0) || (s.removed > 0) then
      // "it asks first": to a git reflex, commit is the one verb you do not run to look, and the
      // review screen is exactly where the names this line withholds live.
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.hint "  -> `dark commit` to review + commit (it asks first)")

  // Store health, reported here rather than behind a verb: a check you have to remember to run is a check
  // nobody runs. Silent when the store is fine, which is almost always.
  match SCM.StoreHealth.problems () with
  | [] -> ()
  | problems ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error "store problems:")

    problems
    |> Stdlib.List.iter (fun p -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"  {p.text}"))

    // Two different remedies, and offering the wrong one is worse than offering none: a reload is a full
    // rebuild, and someone who runs it against a damaged LOG spends it to watch the same line come back.
    let anyRefoldable = problems |> Stdlib.List.any (fun p -> p.refoldable)

    let anyCanonical =
      problems |> Stdlib.List.any (fun p -> p.refoldable |> Stdlib.Bool.not)

    if anyRefoldable then
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.dimText
          "  `dark --safe <cmd>` boots the shipped CLI; a reload rebuilds the projections.")

    if anyCanonical then
      // "the rest" only when there IS a rest to be the rest of.
      let lead = if anyRefoldable then "the rest are" else "these are"

      // Only what the canonical problems have in COMMON. What each one costs differs, so that belongs in
      // the problem's own line, not in a shared footer.
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.dimText
          $"  {lead} in the op log itself, so a reload replays them unchanged.")

  // What your code starts with, reported the same way store health is: silent when everything is
  // on, which is the default and almost always. A narrowed instance is a thing you will otherwise
  // rediscover as a confusing "not active" error three commands later, and the line that would
  // have told you is worth more than the line it costs.
  match Platforms.activated () with
  | None -> ()
  | Some names ->
    let n = Stdlib.List.length names

    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.hint
        $"""{Cli.Text.plural n "platform"} active -> `dark platforms`""")

  state

let execute (state: AppState) (args: List<String>) : AppState =
  if ScmJson.wantsJson args then
    Stdlib.printLine (ScmJson.statusJson (statusJson state))
    state
  else
    executePretty state

let help (_state: AppState) : String =
  [ "dark status - what's in your draft, in one line."
    ""
    "Editing is live and silent: an edit takes effect immediately, and"
    "nothing prompts you mid-flow."
    "This is the only signal you get until you ask for more."
    ""
    "  draft: 3 items changed, 2 dependents will repoint, 1 conflict to review"
    ""
    "  items changed        names you bound since your last commit"
    "                       (five edits to one fn count once)"
    "  dependents repoint   what still references an older version, and"
    "                       would be repointed on commit"
    "  conflicts            recorded by a merge, rebase or sync, already"
    "                       auto-resolved, waiting on your ok"
    ""
    "  dark commit      review the above and commit it"
    "  dark conflicts   review what was auto-resolved"
    ""
    "  --json           the same data, typed, for an agent" ]
  |> Stdlib.String.join "\n"

let complete
  (_state: AppState)
  (_args: List<String>)
  : List<Completion.CompletionItem> =
  []
