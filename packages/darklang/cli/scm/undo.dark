module Darklang.Cli.Undo

// Undo follows authored revisions, including reference-only edits.
// A restore records its selected revision so repeated undo keeps moving backward.

let execute(state: AppState, args: List<String>): AppState =
  // A `--flag` is not a name. Without this it reaches the location parser, which answers that a name
  // needs an owner -- a complaint about the name rather than the flag. `undo` takes no flags at all.
  let flags = args |> Stdlib.List.filter(fun a -> Stdlib.String.startsWith(a, "--"))

  if Stdlib.Bool.not(Stdlib.List.isEmpty(flags)) then
    let f = Stdlib.String.join(flags, " ")
    Cli.printErr($"undo takes no flags, and {f} isn't a name.")
    Cli.printHint("  usage: dark undo <name>")
    Cli.failed(state)
  else

  match args with
  | [ arg ] ->
    match Packages.Location.parseRelativeTo(state.packageData.currentLocation, arg) with
    | Error(e) ->
      Cli.printErr(e)
      Cli.failed(state)
    | Ok(loc) ->
      match SCM.Propagation.kindAt(loc) with
      | None ->
        Cli.printErr($"nothing named {PropagateCmd.dotted(loc)}.")
        Cli.printHint("  `dark ls <module>` lists what's there; `dark status` shows what you've changed.")
        Cli.failed(state)
      | Some(_) ->
        // Keep the old hash so callers can follow the restored version.
        let wasAt =
          SCM.Propagation.currentHash(loc)
          |> Stdlib.Option.withDefault(LanguageTools.ProgramTypes.Hash.Hash(""))

        match SCM.PackageOps.previousRevision(state.currentBranchId, loc) with
        | None ->
          Cli.printErr($"{PropagateCmd.dotted(loc)} is at its first version -- nothing further to undo.")
          Cli.printHint($"  to remove it from your draft entirely: dark discard {PropagateCmd.dotted(loc)}")
          Cli.failed(state)
        | Some((revision, snapshot)) ->
          match SCM.PackageOps.restoreRevision(state.currentBranchId, revision, snapshot) with
          | Error(error) ->
            Cli.printErr($"couldn't undo: {error}")
            Cli.failed(state)
          | Ok(_) ->
            let prev = LanguageTools.ProgramTypes.Reference.hash(snapshot.target)
            Cli.printOk($"{PropagateCmd.dotted(loc)} is back on the version before that edit ({Cli.shortHash(prev)}).")
            let followed =
              if prev == wasAt then true else PropagateCmd.cascadeAndForce(state, loc, LanguageTools.ProgramTypes.Reference.kind(snapshot.target), wasAt, prev)
            Cli.exitWith(state, followed)

  | _ ->
    Cli.printErr("usage: dark undo <name>")
    Cli.printHint("  steps that item back to the version it had before your last change.")
    Cli.failed(state)


let help(_state: AppState): String =
  [ "dark undo <name> - step one item back a version."
    ""
    "  Rebinds the name to the version it had before your last change, and brings anything"
    "  that followed that change back down with it."
    ""
    "  Run it repeatedly to step further back. It walks the order versions were WRITTEN in, so"
    "  it never bounces between two, and stops at the first, saying so."
    ""
    "  Nothing is destroyed -- every version stays in the store, so re-authoring the version"
    "  you stepped off gets you back." ]
  |> Stdlib.String.join("\n")

let complete(
  _state: AppState,
  _args: List<String>)
  : List<Completion.CompletionItem> =
  []
