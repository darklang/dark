module Darklang.Cli.Branch

// Merge, rebase and per-name conflict resolution: the previews, the commands, and their reporting.
// Part of the Darklang.Cli.Branch module, shared with branch.dark and branchHistory.dark.

/// Report what a reconciliation (merge / rebase) auto-resolved. ONE line, never a wall: the point is that
/// nothing was lost silently, not to dump the divergence here.
let reportConflicts(conflicts: List<SCM.Conflicts.Conflict>): Unit =
  match conflicts with
  | [] -> ()
  | cs ->
    let n = Stdlib.display(Stdlib.List.length(cs))

    // "conflict(s)" is the shape `scripts/testing/gates sync-multi-instance` asserts on.
    printOk(
      $"{n} conflict(s) auto-resolved by recency and recorded -- the losing version is kept, not dropped.")

    // The merge IS the moment; sending the reader through `status` to learn the next verb costs a
    // round trip at the point they most want it.
    printHint($"  -> `dark conflicts` to review the {n} auto-pick(s)")


/// The branch's callers a merge repointed at the parent's version before landing them.
let reportRepointed(names: List<String>): Unit =
  match names with
  | [] -> ()
  | names ->
    let n = Stdlib.display(Stdlib.List.length(names))
    let listed = Stdlib.String.join(names, "\n  ")
    printOk($"{n} caller(s) on the branch now point at the parent's version:\n  {listed}")


/// Where a merge preview is printed.
type Preview =
  /// As the whole command, `merge --dry-run`: it ends by saying how to merge.
  | Alone
  /// Just before the confirm prompt, where the next line is the question.
  | BeforeAsking


/// Everything a merge would do, and nothing recorded.
let executeMergePreview(state: AppState, branchRef: String, preview: Preview): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) when SCM.PackageOps.branchIsMerged(branchId) ->
    printOk($"\"{branchRef}\" is already merged into its parent.")
    state
  | Some(branchId) ->
    let (_, parentName) = parentOf(branchId)
    match SCM.Branches.canMerge(branchId) with
    | Error(r) ->
      printErr($"would NOT merge: {SCM.Branches.refusalMessage(r)}")
      failed(state)
    | Ok(_) ->
      printOk($"\"{branchRef}\" would merge into \"{parentName}\".")
      match SCM.PackageOps.branchDiffEntries(branchId) with
      | [] -> printQuiet("  it changes nothing vs its parent.")
      | entries ->
        printQuiet($"  {Text.plural(Stdlib.List.length(entries), "name")} would land:")
        entries
        |> Stdlib.List.iter(fun e ->
          let mark = if e.change == "new" then "+" else "~"
          Stdlib.printLine(Stdlib.Cli.UI.Colors.dimText($"    {mark} {e.name}  [{e.kind}]")))

      // The conflicts a merge WOULD auto-resolve. Nothing is recorded by looking, which is the whole
      // point of asking first.
      match SCM.PackageOps.branchPreview(branchId) with
      | [] -> printQuiet("  no conflicts: neither side moved a name the other did.")
      | cs ->
        printQuiet(
          $"  {Text.plural(Stdlib.List.length(cs), "conflict")} would be auto-resolved by recency, and recorded for review.")

      // Only when this IS the whole command. In the confirm flow the next line is the question, and
      // telling someone to run the thing they are being asked to approve reads as a non-sequitur.
      if preview == Preview.Alone then
        printHint($"  `dark merge {branchRef}` to do it.")

      state


/// `dark merge <branch> --dry-run`: show what would land and change nothing.
let executeMergeDryRun(state: AppState, branchRef: String): AppState =
  executeMergePreview(state, branchRef, Preview.Alone)


/// What a merge does with a branch the at-rest type check found definite errors in.
type TypeErrors =
  /// Refuse it, and say how to fix it or how to merge anyway.
  | Refuse
  /// Merge anyway, deliberately: `--allow-type-errors`.
  | Allow


/// Merge a branch's work into its parent, gated by `canMerge` (has-changes / no-active-children /
/// rebased). On success its ops become part of the parent.
/// The two things a merge refuses, checked in one place so every path into `executeMerge`
/// (bare, named, from the workbench) is gated the same way.
///
/// WIP: a branch's uncommitted ops are work nobody has reviewed. Merging them moves them into
/// the parent with no commit of their own, so they arrive as somebody else's history and the
/// message explaining them never gets written. Commit them, or discard them, and then merge.
///
/// Type errors: `commit` refuses definite at-rest errors, and merging around that gate landed
/// exactly what it exists to stop -- a branch whose commit was REFUSED could still be merged,
/// and main got code that does not typecheck with no record of the decision. Same checker, same
/// verdict rule (only `Failed`; `Incomplete` is not knowing, which is not the same as knowing it
/// is wrong), same way past: `--allow-type-errors`, typed out.
let mergeRefusal(branchId: Uuid, branchRef: String, typeErrors: TypeErrors): Bool =
  let uncommitted = SCM.PackageOps.draftOpCountFor(branchId)
  if uncommitted != 0 then
    printErr($"cannot merge \"{branchRef}\": it has {Text.plural(uncommitted, "uncommitted op")}.")
    printHint(
      $"  commit them (`dark --branch {branchRef} commit \"<message>\"`) or drop them (`dark --branch {branchRef} discard`), then merge.")

    true
  else if typeErrors == TypeErrors.Allow then
    false
  else
    let frontier =
      SCM.Branches.ownFrontierOps(branchId)
      |> Stdlib.List.map(fun entry -> Stdlib.Tuple2.second(entry))

    match (SCM.PackageOps.typeCheckOps(frontier)).verdict with
    | Failed ->
      printErr($"cannot merge \"{branchRef}\": the at-rest type check found definite errors in it.")
      printHint("  `dark typecheck --failed` lists them; fix and commit on the branch, then merge.")
      printHint("  `dark merge <branch> --allow-type-errors` merges anyway, deliberately.")
      true
    | Checked -> false
    | Incomplete -> false


/// The tests a merge of <param branchId> touches: the tests it changes, and every test that
/// uses something it changes, directly or through other code, read on the branch. The rest
/// cannot have changed, so a merge does not run them.
let touchedTests(
  branchId: Uuid)
  : List<
  LanguageTools.ProgramTypes.LocatedItem<LanguageTools.ProgramTypes.PackageTest.PackageTest>> =
  let changed =
    SCM.PackageOps.branchDiffEntries(branchId)
    |> Stdlib.List.filterMap(fun e ->
      match SCM.Branches.parseFqn(e.name), LanguageTools.ProgramTypes.ItemKind.fromString(
              e.kind) with
      | Some((owner, modules, name)), Some(kind) ->
        Option.Some((SCM.Deps.locationOf(owner, modules, name), kind))
      | _ -> Option.None)

  let names =
    Stdlib.List.concat(changed, Cli.Deps.getTransitiveDependentsOn(branchId, changed))
    |> Stdlib.List.filterMap(fun((loc, kind)) ->
      if kind == LanguageTools.ProgramTypes.ItemKind.Test then
        Option.Some((Deps.fqnOf(loc), true))
      else
        Option.None)
    |> Stdlib.Dict.fromList

  // Listing every test is the slow part, and most merges touch none.
  if Stdlib.Dict.isEmpty(names) then
    []
  else
    Packages.Test.liveTests(branchId)
    |> Stdlib.List.filter(fun item -> Stdlib.Dict.containsKey(names, Packages.Test.fullPath(item)))


/// Which of the touched tests a merge runs. `--skip-tests` is `Skip`, `--run-all-tests` is
/// `All`, and the default runs them unless there are more isolated ones than the cap.
type TouchedTestRun =
  | Skip
  | UpToCap
  | All


/// Over this many isolated test groups -- each its own process and store copy -- a merge prints
/// the command that runs them instead of running them: 662 that drive the CLI took 75 s.
val touchedTestCap = 50


/// Whether a merge leaves its <param isolated> touched isolated test groups to the person.
let overTheCap(run: TouchedTestRun, isolated: Int64): Bool =
  match run with
  | UpToCap -> isolated > touchedTestCap
  | Skip | All -> false


/// The command that runs <param names> on <param branchRef>, as a person would type it.
let testRunCommand(branchRef: String, names: List<String>): String =
  Stdlib.String.join(
    Stdlib.List.concat([ "dark", "--branch", branchRef, "test", "run" ], names),
    " ")


/// Run the tests merging <param branchId> touches, the way `dark test run` runs them: only
/// those, in parallel, reusing cached passes. A failure is a warning, not a refusal: the
/// merge still asks, and still goes ahead on a yes. Over the cap, it prints the command instead.
let runTouchedTests(branchId: Uuid, branchRef: String, run: TouchedTestRun): Unit =
  match run with
  | Skip -> ()
  | _ ->
    match touchedTests(branchId) with
    | [] -> printQuiet("  no tests use what this branch changes.")
    | tests ->
      let n = Text.plural(Stdlib.List.length(tests), "test group")
      let isolated =
        tests
        |> Stdlib.List.filter(fun item ->
          Stdlib.Bool.not(LanguageTools.PackageManager.Test.runsInProcess(item.entity.hash)))
        |> Stdlib.List.length

      if overTheCap(run, isolated) then
        printOk(
          $"\"{branchRef}\" touches {n}, {Stdlib.display(isolated)} of them isolated: over the cap of {Stdlib.display(touchedTestCap)}, so the merge does not run them.")

        printQuiet("  to run them:")
        Stdlib.printLine(
          "  " + testRunCommand(branchRef, Stdlib.List.map(tests, Packages.Test.fullPath)))

        printQuiet($"  or `dark merge {branchRef} --run-all-tests` runs them before the merge.")
      else
        printOk($"Running the {n} that \"{branchRef}\" touches:")
        let counts =
          LanguageTools.PackageManager.Test.withStoreSnapshot(branchId, fun snapshot ->
            Packages.Test.runAndSummarize(
              snapshot,
              branchId,
              Packages.Test.defaultRunOptions(),
              tests))

        if counts.failed > 0 then
          let failed = Text.plural(counts.failed, "touched test group")
          printErr($"warning: {failed} failed on \"{branchRef}\". Merging lands them failing.")
          printHint($"  `dark --branch {branchRef} test run <name>` reruns one after a fix.")


/// `dark merge <branch>`.
///
/// Asks the same way the bare form does. Naming the branch is not the confirmation: a merge moves
/// somebody's committed work onto main and there is no undo verb for it, and the piped case is the
/// one that matters -- an unattended run that meant to merge says `-y`, and one that did not gets
/// told rather than obeyed.
let executeMerge(
  state: AppState,
  branchRef: String,
  confirm: Confirm,
  typeErrors: TypeErrors,
  tests: TouchedTestRun)
  : AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) when SCM.PackageOps.branchIsMerged(branchId) ->
    // Merging it again would flip nothing and report "Merged 0 op(s)", which reads as a broken merge
    // rather than as "there was nothing to do".
    printOk($"\"{branchRef}\" is already merged into its parent.")
    state
  | Some(branchId) when mergeRefusal(branchId, branchRef, typeErrors) -> failed(state)
  | Some(branchId) ->
    // The structural gate runs BEFORE the question. Asking "merge it?" about a branch that cannot
    // merge is a question with one answer, and on a pipe the refusal would come back as a declined
    // prompt rather than as the reason. `mergeBranch` asks the same gate again and is the authority;
    // this is only about which sentence the person reads.
    match SCM.Branches.canMerge(branchId) with
    | Error(r) ->
      printErr($"couldn't merge: {SCM.Branches.refusalMessage(r)}")
      failed(state)
    | Ok(_) ->
      // Before the question, so whoever answers it has seen the results.
      let _ = runTouchedTests(branchId, branchRef, tests)
      if
        Stdlib.Bool.not(
          Prompt.confirmExplicit(
            confirm,
            Stdlib.Cli.UI.Colors.warning($"\n  Merge \"{branchRef}\" into its parent? [y/N]: ")))
      then
        Stderr.ok(
          $"  not merged. (`dark merge {branchRef} -y` if you mean it -- a piped stdin can't answer this.)")

        failed(state)
      else
        match SCM.PackageOps.mergeBranch(branchId) with
        | Ok(outcome) ->
          // "Merged N op(s)" is the shape `scripts/testing/gates sync-multi-instance` asserts on.
          printOk(
            $"Merged {Stdlib.display(outcome.merged)} op(s) from branch \"{branchRef}\" into its parent.")

          reportRepointed(outcome.repointed)
          reportConflicts(outcome.conflicts)

          // The merge landed either way; this is what went wrong after it, so it does not change the exit.
          let _ = if outcome.warning == "" then () else printErr($"  {outcome.warning}")

          // Standing on the branch you just merged is standing on finished work, and the stored name would
          // start resolving again the day someone reuses it. Move to the parent, and SAY so: changing where
          // the next edit lands without mentioning it is a surprise.
          let landedOn =
            if SCM.PackageOps.currentBranch() == branchId then
              let (parentId, _) = parentOf(branchId)
              let _ = SCM.PackageOps.selectBranch(parentId)
              let _ = printOk($"now on {whereLabel(parentId)} -- that's where the next edit lands.")
              parentId
            else
              state.currentBranchId

          { state with currentBranchId = landedOn }
        | Error(e) ->
          printErr($"couldn't merge: {SCM.PackageOps.mergeErrorMessage(e)}")
          failed(state)


/// What a rebase would reconcile, and nothing recorded.
///
/// Narrower than `merge --dry-run` on purpose. A rebase brings the PARENT's changes since the fork, and
/// Dark cannot enumerate those: a branch records per-name bases only for names it touched itself, and
/// the query that would find the rest (`LibDB.Branches.nameConflicts`) has no builtin. So this reports
/// the conflicts -- names BOTH sides moved -- and says plainly that it is not the whole picture, rather
/// than printing "nothing to worry about" over changes it cannot see.
let executeRebaseDryRun(state: AppState, branchRef: String): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) when SCM.Branch.isMain(branchId) ->
    // Reachable only when main is NAMED: the bare form goes through `bareTargetBranch`, which has its
    // own message for standing on main. So this describes the ARGUMENT, not where you are.
    printErr("main is the trunk -- rebase moves a BRANCH onto its parent, and main has none.")
    failed(state)
  | Some(branchId) ->
    let (_, parentName) = parentOf(branchId)
    match SCM.PackageOps.branchPreview(branchId) with
    | [] ->
      printOk(
        $"rebasing \"{branchRef}\" onto \"{parentName}\" would reconcile nothing: no name has moved on both sides.")
    | cs ->
      let n = Text.plural(Stdlib.List.length(cs), "name")
      printOk(
        $"rebasing \"{branchRef}\" onto \"{parentName}\" would reconcile {n} by recency, and record them for review:")

      cs
      |> Stdlib.List.iter(fun c ->
        let dotted = SCM.Conflicts.fqn(c.owner, c.modules, c.name)
        Stdlib.printLine(Stdlib.Cli.UI.Colors.dimText($"    ~ {dotted}  [{c.itemType}]")))

    printHint(
      "  it also brings the parent's other changes, which are not listed here: a branch records bases")

    printHint("  only for names it touched, so those arrive without a conflict.")

    printHint($"  `dark rebase {branchRef}` to do it.")
    state


/// Rebase a branch onto its parent: accept the parent's current state, which a merge requires when the
/// parent moved a name the branch also moved. Reports what moved.
let executeRebase(state: AppState, branchRef: String): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) ->
    match SCM.PackageOps.rebaseBranch(branchId) with
    | Ok(outcome) ->
      printOk(outcome.message)
      reportConflicts(outcome.conflicts)
      state
    | Error(e) ->
      printErr(e)
      failed(state)


/// Resolve one conflicted name on a branch: `mine` keeps the branch's version (wins on merge),
/// `theirs` takes the parent's (drops the branch's binding). Anything else is re-authoring on the branch.
let executeResolve(state: AppState, branchRef: String, name: String, choice: String): AppState =
  match resolveRef(branchRef) with
  | None -> failed(state)
  | Some(branchId) ->
    match SCM.PackageOps.resolveConflict(branchId, name, choice) with
    | Ok(msg) ->
      printOk(msg)
      state
    | Error(e) ->
      printErr(e)
      failed(state)


/// `dark merge`'s own page, rather than `dark branch`'s: that one never mentions merging, so the two
/// questions a person actually has here -- what does this take, and what will it do to a conflict --
/// would both go unanswered.
let mergeHelp(_state: AppState): String =
  [ ""
    "  dark merge                 merge the branch you're on, after showing what would land"
    "  dark merge -y              the same, without the confirmation"
    "  dark merge <branch>        merge that one"
    "  dark merge --dry-run       show what would land, change nothing"
    "  dark merge <branch> --dry-run"
    "  dark merge --skip-tests    merge without running the tests it touches"
    "  dark merge --run-all-tests run them even over the cap"
    ""
    "  Before it asks, a merge runs the tests the branch touches: the ones it"
    "  changes, and every one that uses something it changes. A failure is"
    "  reported, and the merge still goes ahead on a yes. Over 50 isolated"
    "  test groups it prints the `dark test run` command instead."
    ""
    "  Conflicts do not block a merge. Both sides are folded, the later edit wins by"
    "  recency, and the version that lost is recorded rather than dropped --"
    "  `dark conflicts` steps through them afterwards."
    ""
    "  A merged branch stays addressable: `dark branches --all` lists it, and its"
    "  commits keep their place in the log." ]
  |> Stdlib.String.join("\n")


/// The branch a bare `dark merge` or `dark rebase` means: the one you are standing on.
///
/// On main there is no such branch, and the answer is the usage line rather than a guess. `dark diff`
/// already works this way for the same reason: the commonest form of the question is the one you are
/// standing in, and making it the only form you cannot type is a papercut you pay every time.
let bareTargetBranch(verb: String): Result<String, Unit> =
  match SCM.PackageOps.currentBranch() with
  | id when SCM.Branch.isMain(id) ->
    printErr($"usage: dark {verb} <branch>")
    printHint($"  on main there is no branch to {verb}. `dark branches` lists them.")
    Result.Error()
  | id -> Result.Ok(SCM.PackageOps.branchName(id))


/// `dark merge` with no branch named merges whatever you are standing on, which is the one form where
/// nobody typed the thing being changed. So it shows the same preview `--dry-run` would and asks, the way
/// `dark discard` does. Naming a branch is already a deliberate act and goes straight through.
///
/// An explicit yes, not a default-yes: a stray Return or a piped stdin must not move work into main.
let executeMergeBare(
  state: AppState,
  confirm: Confirm,
  typeErrors: TypeErrors,
  tests: TouchedTestRun)
  : AppState =
  match bareTargetBranch("merge") with
  | Error(_) -> failed(state)
  | Ok(name) ->
    let previewed = executeMergePreview(state, name, Preview.BeforeAsking)

    // Here rather than in `executeMerge`, which this calls after the question: the results
    // belong before it. Not for a branch the preview already said cannot merge.
    let _ =
      if previewed.exitCode == 0 then
        match resolveRef(name) with
        | Some(branchId) -> runTouchedTests(branchId, name, tests)
        | None -> ()
      else
        ()

    if
      Stdlib.Bool.not(
        Prompt.confirmExplicit(confirm, Stdlib.Cli.UI.Colors.warning("\n  Merge it? [y/N]: ")))
    then
      Stderr.ok(
        "  not merged. (`dark merge -y` if you mean it -- a piped stdin can't answer this.)")

      failed(previewed)
    else
      executeMerge(previewed, name, Confirm.Assume, typeErrors, TouchedTestRun.Skip)


/// `dark merge [branch] [-y] [--allow-type-errors] [--skip-tests] [--run-all-tests] [--dry-run]`
///
/// One parse for every combination, rather than an arm per spelling: the arm list missed
/// `merge <branch> -y` entirely, so the named form had no way to say yes in advance.
let executeMergeCmd(state: AppState, args: List<String>): AppState =
  let (flags, rest) = Stdlib.List.partition(args, fun a -> Stdlib.String.startsWith(a, "-"))
  let confirm =
    Confirm.assumeIf(Stdlib.List.contains(flags, "-y") || Stdlib.List.contains(flags, "--yes"))

  let typeErrors =
    if Stdlib.List.contains(flags, "--allow-type-errors") then
      TypeErrors.Allow
    else
      TypeErrors.Refuse

  let dryRun = Stdlib.List.contains(flags, "--dry-run")
  let tests =
    if Stdlib.List.contains(flags, "--skip-tests") then
      TouchedTestRun.Skip
    else if Stdlib.List.contains(flags, "--run-all-tests") then
      TouchedTestRun.All
    else
      TouchedTestRun.UpToCap

  let unknown =
    flags
    |> Stdlib.List.filter(fun f ->
      f != "-y"
      && f != "--yes"
      && f != "--allow-type-errors"
      && f != "--skip-tests"
      && f != "--run-all-tests"
      && f != "--dry-run")

  match unknown with
  | [bad, ...] ->
    printErr($"unknown flag: {bad}")
    printHint(
      "usage: dark merge [branch] [-y] [--allow-type-errors] [--skip-tests] [--run-all-tests] [--dry-run]")

    { state with exitCode = 1 }
  | [] ->
    match rest with
    | [] ->
      if dryRun then
        match bareTargetBranch("merge") with
        | Ok(name) -> executeMergeDryRun(state, name)
        | Error(_) -> failed(state)
      else
        executeMergeBare(state, confirm, typeErrors, tests)
    | [id] ->
      if dryRun then
        executeMergeDryRun(state, id)
      else
        executeMerge(state, id, confirm, typeErrors, tests)
    | _ ->
      printErr("usage: dark merge <branch>")
      printHint("  `dark branches` lists them.")
      failed(state)


/// `dark rebase <id>`, or bare on the branch you are standing on.
let executeRebaseCmd(state: AppState, args: List<String>): AppState =
  match args with
  | [] ->
    match bareTargetBranch("rebase") with
    | Ok(name) -> executeRebase(state, name)
    | Error(_) -> failed(state)
  | ["--dry-run"] ->
    match bareTargetBranch("rebase") with
    | Ok(name) -> executeRebaseDryRun(state, name)
    | Error(_) -> failed(state)
  | [id] -> executeRebase(state, id)
  | [id, "--dry-run"] -> executeRebaseDryRun(state, id)
  | ["--dry-run", id] -> executeRebaseDryRun(state, id)
  | _ ->
    printErr("usage: dark rebase <branch>")
    printHint("  `dark branches` lists them.")
    failed(state)


/// `dark resolve <id> <name> mine|theirs`
let executeResolveCmd(state: AppState, args: List<String>): AppState =
  match args with
  | [id, name, choice] -> executeResolve(state, id, name, choice)
  | _ ->
    printErr("usage: dark resolve <branch> <name> mine|theirs")
    printHint("  `dark conflicts branch <branch>` shows what's conflicted.")
    failed(state)
