module Darklang.Cli.PropagateCmd

// Shared helpers for restoring a version and updating its callers.

let dotted (loc: LanguageTools.ProgramTypes.PackageLocation) : String =
  let mods = SCM.Propagation.modulesOf loc
  if mods == "" then $"{loc.owner}.{loc.name}" else $"{loc.owner}.{mods}.{loc.name}"


/// Turn what a human typed into a location, resolved relative to where they are.
let resolve
  (state: AppState)
  (arg: String)
  : Stdlib.Result.Result<LanguageTools.ProgramTypes.PackageLocation, String> =
  Packages.Location.parseRelativeTo state.packageData.currentLocation arg


/// Restore callers and report any failure to the command.
let cascadeAndForce
  (state: AppState)
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  (kind: LanguageTools.ProgramTypes.ItemKind)
  (fromHash: LanguageTools.ProgramTypes.Hash)
  (toHash: LanguageTools.ProgramTypes.Hash)
  : Bool =
  match SCM.Propagation.repointDependents state.currentBranchId loc kind [fromHash] toHash with
  | Error e ->
    Cli.printErr $"  cascade failed: {e}"
    false
  | Ok _ -> true
