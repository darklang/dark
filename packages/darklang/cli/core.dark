/// The CLI's core: the page/state model, startup, and the pieces every other file leans on.
///
/// This module is split across files (Dark merges same-named modules):
///   core.dark        the model, startup, and error/view helpers
///   registry.dark    the command table and completion
///   loop.dark        key handling, the prompt region, and the interactive loop
///   entry.dark       argument parsing and the process entry point
module Darklang.Cli

type SubAppAction =
  | Continue
  | Save
  | Exit
  /// Hand off to another command (e.g. a browser launching a foreground app), replacing this page.
  | LaunchCommand of String
  /// Drop to the classic prompt, pushing this page so `quit` there returns here instead of leaving the CLI.
  | LaunchPrompt

type SubApp =
  { onKey: Stdlib.Cli.Stdin.Key.Key -> Stdlib.Cli.Stdin.Modifiers.Modifiers -> Stdlib.Option.Option<String> -> (SubAppAction * SubApp)
    onDisplay: Unit -> Unit
    onSave: Unit -> Unit
    /// Restore the app's terminal surface when the CLI exits on Ctrl-C,
    /// bypassing the app's own exit action. Safe when already stopped.
    onTerminate: Unit -> Unit
    /// Re-take the terminal after another page owned it (see `pageStack`).
    ///
    /// The returned SubApp must hold a freshly started terminal session: the retained one is stale, because
    /// whatever ran on top tore the surface down when it stopped. Diffing against that stale view would
    /// paint garbage, so resuming repaints from scratch.
    onResume: Unit -> SubApp }

type Page =
  | MainPrompt
  | InteractiveNav of Packages.NavInteractive.Session
  | CompletionPicker of CompletionPicker.Session
  | SubApp of SubApp

type AppState =
  { isExiting: Bool
    prompt: Prompt.State
    packageData: Packages.State
    currentPage: Page
    /// Pages to return to, innermost first. A SubApp that launches another page (e.g. the workbench opening a
    /// foreground app) pushes itself here; when the launched page exits, we pop back instead of quitting.
    pageStack: List<Page>
    /// The branch this session is on: an ID, "" for main. A NAME is what you type; the entry point resolves
    /// it once.
    currentBranchId: String
    accountID: Stdlib.Option.Option<Uuid>
    accountName: String
    /// Retained presentation state while the main prompt owns an inline region.
    promptTerminal: Stdlib.Option.Option<Tui.TerminalSession.State>
    /// True when invoked from the command line (not the interactive REPL)
    nonInteractive: Bool
    /// Cached completion hint — skip recompute when prompt text unchanged
    cachedHintInput: String
    cachedHintValue: String
    /// Completion results for the current *context* (command + completed args), which is what an expensive
    /// completion actually depends on. Keyed by `Registry.completionContextKey`, so it survives every
    /// keystroke of the word being typed rather than being thrown away on each character.
    cachedCompletionKey: String
    cachedCompletionItems: List<Completion.CompletionItem>
    /// The last partial token filtered and what it produced, so the next keystroke can narrow from it
    /// instead of re-filtering the whole context list. Empty partial means "no usable base".
    cachedFilterPartial: String
    cachedFilterItems: List<Completion.CompletionItem>
    /// Cached command list and option strings — built once at startup
    allCommandsCache: List<Registry.CommandHandler>
    commandOptionsCache: List<String>
    /// When true, write telemetry to rundir/logs/telemetry.jsonl
    telemetryEnabled: Bool }

/// What the prompt shows to your left: where you are in the package tree, and WHICH BRANCH, when you're on
/// one.
///
/// The branch belongs in the prompt rather than in a status bar. The bar this replaced was positioned
/// absolutely at the bottom of the terminal, which the frame-based renderer has no place for -- it owns the
/// screen and composes views out of rows. The prompt is a row, it's already showing you context, and both
/// the styled output and the cursor math derive from this one string, so the cursor stays correct for free.
///
/// Only when you're on a branch. Everyone is on main almost all the time, and a prompt that says so every
/// line is noise you learn to stop reading.
let locationStr (state: AppState) : String =
  let where = Packages.formatLocation state.packageData.currentLocation

  match state.currentBranchId with
  | "" -> where
  | id -> $"{where} @{SCM.PackageOps.branchName id}"

/// Takes the command list rather than calling `Registry.allCommands ()` itself: `initState` needs both the
/// list and the options, and building the list is 60 records of 6 fields including 3 fn refs each. Calling it
/// twice per process start was pure duplicate work, on every invocation including `dark version`.
let commandOptions (commands: List<Registry.CommandHandler>) : List<String> =
  let allNames = Stdlib.List.map commands (fun cmd -> cmd.name)
  let allAliases = Stdlib.List.fold commands [] (fun acc cmd -> Stdlib.List.append acc cmd.aliases)
  Stdlib.List.append allNames allAliases

// Restore the persisted account from cli-config.json (written by
// `login`). Returns (None, "") if the file is absent / the entry is
// missing / the account no longer exists.
let restoreSessionAccount () : (Stdlib.Option.Option<Uuid> * String) =
  match Config.get "session.account_id" with
  | None -> (Stdlib.Option.Option.None, "")
  | Some idStr ->
    match Stdlib.Uuid.parse idStr with
    | Error _ -> (Stdlib.Option.Option.None, "")
    | Ok id ->
      match SCM.Account.getById id with
      | None -> (Stdlib.Option.Option.None, "")
      | Some account ->
        (Stdlib.Option.Option.Some account.id, account.name)


/// The branch this run starts on, `"main"` for main.
///
/// The three-tier resolution (`--branch` for this command, `DARK_BRANCH` for this shell, the
/// `current_branch` config for this machine) happens in the CLI entry point before any Dark runs, so all
/// that is left here is to read the answer. It gets read ONCE, into `AppState.currentBranchId`, and is
/// passed from there: a command that wants to know which branch it is on asks its state, not the process.
let resolveStartingBranch () : String = SCM.PackageOps.currentBranch ()


let initState () : AppState =
  let (accountID, accountName) = restoreSessionAccount ()
  let branchId = resolveStartingBranch ()
  let commands = Registry.allCommands ()
  AppState
    { isExiting = false
      prompt = Prompt.initState ()
      packageData = Packages.initState ()
      currentPage = Page.MainPrompt
      pageStack = []
      currentBranchId = branchId
      accountID = accountID
      accountName = accountName
      promptTerminal = Stdlib.Option.Option.None
      nonInteractive = false
      cachedHintInput = ""
      cachedHintValue = ""
      cachedCompletionKey = ""
      cachedCompletionItems = []
      cachedFilterPartial = ""
      cachedFilterItems = []
      allCommandsCache = commands
      commandOptionsCache = commandOptions commands
      telemetryEnabled = (Builtin.environmentGet "DARK_TELEMETRY") == Stdlib.Option.Option.Some "1" }

type Msg =
  | ProcessInput of String
  | KeyPressed of key: Stdlib.Cli.Stdin.Key.Key * modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers * keyChar: Stdlib.Option.Option<String>
  | Exit


module ExecutionError =
  /// Host-side exception that escaped the normal error path. `metadata` is
  /// a string map; the F# host pre-stringifies values since `Exception.toMetadata`
  /// only ever produces strings.
  type Unhandled =
    { message: String
      metadata: List<(String * String)> }

  /// Boundary type for CLI command failures. Each variant carries its own
  /// structured payload — no flattening to strings at the boundary.
  type ExecutionError =
    | Parse of LanguageTools.Parser.CliScript.ParseError
    | Runtime of LanguageTools.RuntimeTypes.RuntimeError.Error
    | Unhandled of Unhandled

  let toString (branchId: String) (err: ExecutionError) : String =
    match err with
    | Parse pe -> LanguageTools.Parser.CliScript.ParseError.toString pe
    | Runtime rte ->
      PrettyPrinter.RuntimeTypes.RuntimeError.toString branchId rte
    | Unhandled u ->
      match u.metadata with
      | [] -> $"Internal error: {u.message}"
      | _ ->
        let lines =
          u.metadata
          |> Stdlib.List.map (fun (k, v) -> $"  {k}: {v}")
          |> Stdlib.String.join "\n"
        $"Internal error: {u.message}\n{lines}"


module View =
  let formatError (message: String) : String =
    Colors.error ("Error: " ++ message)

  let formatSuccess (message: String) : String =
    Colors.success message

  let formatWelcome () : String = Registry.getCompactCommandList ()
