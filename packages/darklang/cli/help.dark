module Darklang.Cli.Help


let execute (state: AppState) (args: List<String>) : AppState =
  match args with
  | [] ->
    Stdlib.printLine (Registry.getDetailedCommandList ())
    state
  | [commandName] ->
    let known =
      state.allCommandsCache
      |> Stdlib.List.any (fun cmd ->
        cmd.name == commandName || Stdlib.List.member cmd.aliases commandName)

    if known then
      Registry.executeCommandHelp commandName state
    else
      Cli.printErr $"No command called `{commandName}`."
      Cli.printHint "  `dark help` lists them."
      Cli.exitWith state false
  | _ ->
    Cli.printErr "Usage: help [command]"
    Cli.printHint "Too many arguments. Use 'help' for general help or 'help <command>' for specific help."
    Cli.exitWith state false


let complete (state: AppState) (args: List<String>) : List<Completion.CompletionItem> =
  Completion.commandNamesCompletion state args


let help (_state: AppState) : String =

  // CLEANUP I wanted this somewhere but couldn't decide where.
  let swatches =
    [ Stdlib.Cli.UI.Colors.purpleBg
      Stdlib.Cli.UI.Colors.magentaBg
      Stdlib.Cli.UI.Colors.lightPinkBg
      Stdlib.Cli.UI.Colors.pinkBg
      Stdlib.Cli.UI.Colors.blueBg
      Stdlib.Cli.UI.Colors.greenBg
      Stdlib.Cli.UI.Colors.yellowBg
      Stdlib.Cli.UI.Colors.brownBg
      Stdlib.Cli.UI.Colors.orangeBg
      Stdlib.Cli.UI.Colors.peachBg
      Stdlib.Cli.UI.Colors.salmonBg ]
    |> Stdlib.List.map (fun color -> $"{color}  {Stdlib.Cli.UI.Colors.reset}")
    |> Stdlib.String.join ""

  [
    swatches
    (Stdlib.Cli.UI.Colors.info "Usage: " + Stdlib.Cli.UI.Colors.command "help [command]")
    "Show general help or help for a specific command."
    ""
    (Stdlib.Cli.UI.Colors.info "Examples:")
    ("  " + Stdlib.Cli.UI.Colors.command "help" + "        - Show all available commands")
    ("  " + Stdlib.Cli.UI.Colors.command "help quit" + "   - Show help for the quit command")
  ]
  |> Stdlib.String.join "\n"

