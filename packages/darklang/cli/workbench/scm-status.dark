/// The workbench's ONE reading of SCM state, held in `State` and refreshed on transitions.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

// One read, on transition, cached in `State`. That's the same treatment (and the same reason) the tree's
// wip/deprecated badges get -- the renderer runs on every keypress and has to stay a pure function of
// state for frame diffing to be sound, so a DB read cannot live inside it.
//
// The counts come from `SCM.Draft`, which is also what `dark status` and `dark commit` read. That's the
// point: one owner, many mentions. If the workbench and the CLI disagree about your draft, it is because
// something stopped going through here.

/// What every workbench surface needs to know about SCM, read once.
type ScmStatus =
  { /// The NAME, never the uuid. Every surface here is something a person reads.
    branchName: String
    /// Names in the draft, fully qualified -- the Matter tree's badge set.
    wipNames: List<String>
    /// The three-way split. `changed` counts both halves, because both are in the draft and both get
    /// committed, but a bare total is nearly useless: "3 changed" after you edited one thing is either fine or
    /// a disaster, and the number can't say which.
    changed: Int
    authored: Int
    followed: Int
    /// References a pin is holding on an older version. On screen because it's the thing people forget they
    /// asked for.
    /// Conflicts plus standing findings: everything waiting on a person.
    needsYou: Int
    conflicts: List<SCM.Conflicts.Conflict>
    commits: Int
    lastCommit: String
    /// The draft's op count. Carried so `refreshScmStatus` has a cheap thing to compare against: it's one
    /// indexed count, and it moves whenever anything in here could have.
    ops: Int64
    /// Has this ever been read, as opposed to being the placeholder a fresh state starts with?
    ///
    /// Needed because the placeholder's `ops` is 0, which is ALSO the honest answer on a clean tree -- so
    /// without this the comparison says "nothing changed" on the very first frame and the workbench opens
    /// showing zeroes for everything.
    loaded: Bool }

let emptyScmStatus(): ScmStatus =
  ScmStatus
    { branchName = SCM.Branch.mainBranchName
      wipNames = []
      changed = 0
      authored = 0
      followed = 0
      needsYou = 0
      conflicts = []
      commits = 0
      lastCommit = ""
      ops = 0L
      loaded = false }

/// Read the whole SCM picture for <param branchId>.
let readScmStatus(branchId: Uuid): ScmStatus = scmStatusFrom(branchId, SCM.Draft.read())

/// `readScmStatus` over a draft already read.
let scmStatusFrom(branchId: Uuid, p: SCM.Draft.Picture): ScmStatus =
  // This branch's commits, not the store's: the row says "N commits on this branch", and a store-wide
  // count is the same number everywhere and right only on main.
  let recent = SCM.PackageOps.commitsOnBranch(branchId, 1000L)

  ScmStatus
    { branchName = SCM.PackageOps.branchName(branchId)
      wipNames =
        p.bindings
        |> Stdlib.List.map(fun b -> SCM.Conflicts.fqn(b.owner, b.modules, b.name))
      changed = Stdlib.List.length(p.bindings)
      authored = SCM.Draft.authoredCount(p)
      followed = SCM.Draft.followedCount(p)
      needsYou = SCM.Draft.needsYouCount(p)
      conflicts = p.conflicts
      commits = Stdlib.List.length(recent)
      lastCommit =
        match Stdlib.List.head(recent) with
        | Some c -> c.message
        | None -> ""
      ops = p.ops
      loaded = true }
