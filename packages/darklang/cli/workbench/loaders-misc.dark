/// Reads for the remaining views: AI threads and prompts, things, conflicts, branches, docs, errors.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

let loadAiThreadItems () : List<BodyItem> =
  Darklang.Cli.Apps.Views.AiChats.demoThreads ()
  |> Stdlib.List.map (fun t ->
    BodyItem
      { name = "[" ++ (Stdlib.String.toUppercase t.status) ++ "]  " ++ t.topic ++ "   " ++ t.branch
        kind = t.status
        isModule = false; desc = "" })

/// The selected AI thread's detail (for the AI preview).
let aiThreadDetail (selected: Int) : String =
  match Stdlib.List.getAt (Darklang.Cli.Apps.Views.AiChats.demoThreads ()) selected with
  | Some t ->
    "topic:   " ++ t.topic ++ "\n"
    ++ "status:  " ++ t.status ++ "\n"
    ++ "branch:  " ++ t.branch ++ "\n"
    ++ "cost:    " ++ t.cost ++ "   tokens: " ++ t.tokens ++ "   time: " ++ t.time ++ "\n\n"
    ++ t.detail
    ++ "\n\n"
    ++ "(demo data · press a to ask the agent a new prompt)"
  | None -> "(no thread selected)"

/// A preview library of reusable prompts (the AI · Prompts subsection).
let demoPrompts () : List<(String * String)> =
  [ ("review-diff", "Review this diff for correctness, edge cases, and naming.")
    ("explain-fn", "Explain what the selected function does and who calls it.")
    ("gen-tests", "Generate tests for the selected function, including edge cases.")
    ("name-this", "Suggest three clearer names for this item, each with a reason.")
    ("port-to-dark", "Port this snippet to Darklang, using stdlib idioms.")
    ("summarize-module", "Summarize this module: purpose, key fns, gotchas.") ]

let loadPromptItems () : List<BodyItem> =
  demoPrompts ()
  |> Stdlib.List.map (fun p ->
    let (name, _desc) = p
    BodyItem { name = name; kind = "prompt"; isModule = false; desc = "" })

/// The selected prompt's detail (for the AI · Prompts preview).
let promptDetail (selected: Int) : String =
  match Stdlib.List.getAt (demoPrompts ()) selected with
  | Some p ->
    let (name, desc) = p
    (Stdlib.Cli.UI.Colors.boldText name)
    ++ "\n\n"
    ++ desc
    ++ "\n\n"
    ++ "⏎ use (fills the ask bar)  ·  e edit  ·  n new"
    ++ "\n\n"
    ++ (Stdlib.Cli.UI.Colors.dimText "(mock data)")
  | None -> "(no prompt selected)"

/// All package values for Tree's flat values-only lens.
let loadThingItems (branchId: Uuid) : List<BodyItem> =
  let q =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = []
        text = ""
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Value ]
        exactMatch = false }
  (LanguageTools.PackageManager.Search.search branchId q).values
  |> Stdlib.List.map (fun i ->
    let full =
      Stdlib.String.join (Stdlib.List.flatten [ [ i.location.owner ], i.location.modules, [ i.location.name ] ]) "."
    BodyItem { name = full; kind = "val"; isModule = false; desc = "" })

/// The source of the selected Thing (value), for the preview - looked up by its full path.
let thingDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> "(nothing selected)"
  | Some item ->
    let parts = Stdlib.String.split item.name "."
    let leaf = Stdlib.List.last parts |> Stdlib.Option.withDefault item.name
    let mods = Stdlib.List.take parts (Stdlib.Int.max 0 ((Stdlib.List.length parts) - 1))
    let results = Packages.Query.searchExactMatch state.branchId mods leaf
    match results.values with
    | i :: _ ->
      // `mods` is the value's own module, and the pane knows its width: the last two places in the
      // workbench still printing against neither.
      let ctx =
        { PrettyPrinter.ProgramTypes.Context.forModule state.branchId mods with
            width = previewInnerWidth state }
      PrettyPrinter.ProgramTypes.packageValue ctx i.entity
    | [] -> "(not found)"

/// Every branch on this instance, for the reader Home's "more branches" row opens. Current
/// branch marked ●, merged ones noted, and each described the way Home describes it -- current,
/// draft, how far ahead, when it last committed -- so the list answers "which one" without
/// opening each.
let loadBranchItems (currentBranchId: Uuid) : List<BodyItem> =
  let describe (id: Uuid) (ahead: Int64) : String =
    let last =
      match Stdlib.List.head (SCM.PackageOps.commitsOnBranch id 1L) with
      | Some c -> agoText c.originTs
      | None -> ""
    Stdlib.List.filter
      [ (if id == currentBranchId then "current" else "")
        (if SCM.PackageOps.draftOpCountFor id > 0L then "draft" else "")
        (if ahead > 0L then (Stdlib.Int64.toString ahead) ++ " ops ahead" else "")
        last ]
      (fun part -> part != "")
    |> Stdlib.String.join " · "
  // Main first, written out: it has no row in the branch table, so a list read
  // from the table never had it, and from a branch there was nothing here to
  // ⏎ back to.
  let onMain = Darklang.SCM.Branch.isMain currentBranchId
  let mainRow =
    BodyItem
      { name = (branchMarker onMain) ++ Darklang.SCM.Branch.mainBranchName
        kind = "branch"
        isModule = false
        desc = describe Darklang.SCM.Branch.mainBranchId 0L }
  let others =
    Darklang.SCM.Branch.list ()
    |> Stdlib.List.map (fun b ->
      let tag = if b.merged then "   (merged)" else ""
      BodyItem
        { name = (branchMarker (b.id == currentBranchId)) ++ b.name ++ tag
          kind = "branch"
          isModule = false
          desc = describe b.id b.ops })
  Stdlib.List.append [ mainRow ] others

/// The branch list as reader text.
let branchListText (currentBranchId: Uuid) : String =
  let rows =
    loadBranchItems currentBranchId
    |> Stdlib.List.map (fun it ->
      "  " ++ (Stdlib.String.padEndToWidth it.name 30) ++ (Stdlib.Cli.UI.Colors.dimText it.desc))
  Stdlib.String.join
    (Stdlib.List.flatten [ [ Stdlib.Cli.UI.Colors.boldText "Branches", "" ], rows ])
    "\n"

/// The two-character lead on a branch row: filled for the one you're on.
let branchMarker (current: Bool) : String = if current then "● " else "○ "

/// Is this branch row main's? Main has no `branches` row, so `selectedBranch`
/// cannot name it; the rows that stand for it are known by name instead.
let isMainRow (item: BodyItem) : Bool =
  (Stdlib.String.dropFirst item.name 2) == Darklang.SCM.Branch.mainBranchName

/// Is the cursor on a branch row for main (Home's)?
let cursorOnMainRow (state: State) : Bool =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    ((item.kind == "branch") || (item.kind == "home-branch")) && (isMainRow item)
  | None -> false

/// Where ⏎ on the branch row under the cursor would take you: id and name.
/// Main comes from its constants, everything else through `selectedBranch`.
let branchRowTarget (state: State) : Stdlib.Option.Option<(Uuid * String)> =
  if cursorOnMainRow state then
    Stdlib.Option.Option.Some(
      (Darklang.SCM.Branch.mainBranchId, Darklang.SCM.Branch.mainBranchName))
  else
    match selectedBranch state with
    | Some b -> Stdlib.Option.Option.Some((b.id, b.name))
    | None -> Stdlib.Option.Option.None

/// The branch the cursor is on, resolved by name rather than by position.
///
/// `state.selected` indexes `state.items`, which the in-view filter (`f`) narrows. Indexing straight into
/// `SCM.Branch.list ()` therefore targeted whatever branch sat at that position in the FULL list: with the
/// Branches section filtered to one entry, the cursor was visibly on it while `x` offered to delete `main`.
/// A destructive action naming the wrong target is the worst version of this bug, so every branch action and
/// the preview go through here.
let selectedBranch (state: State) : Stdlib.Option.Option<Darklang.SCM.Branch.Branch> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> Stdlib.Option.Option.None
  | Some item ->
    // Rows read "<marker> <name>[   (merged)]" - see `loadBranchItems`.
    let name =
      item.name
      |> Stdlib.String.dropFirst 2
      |> fun s -> Stdlib.String.split s "   (merged)" |> Stdlib.List.head |> Stdlib.Option.withDefault s
      |> Stdlib.String.trim
    Darklang.SCM.Branch.list () |> Stdlib.List.findFirst (fun b -> b.name == name)

/// The branch a merge or rebase acts on: the row under the cursor when that
/// row is one of Home's branch rows, else the branch you're on. Home
/// advertises `m`/`r` on *other* branches, so acting on `state.branchId`
/// there would mutate the wrong one.
let branchForAction (state: State) : Stdlib.Option.Option<Darklang.SCM.Branch.Branch> =
  let onBranchRow =
    match Stdlib.List.getAt state.items state.selected with
    | Some item -> item.kind == "home-branch"
    | None -> false
  if onBranchRow then selectedBranch state else Darklang.SCM.Branch.get state.branchId

/// The conflict the cursor is on, by location. Same filtered-cursor reasoning as `selectedBranch`.
let selectedConflict (state: State) : Stdlib.Option.Option<SCM.Conflicts.Conflict> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> Stdlib.Option.Option.None
  | Some item ->
    let location =
      Stdlib.String.split item.name "  ·  " |> Stdlib.List.head |> Stdlib.Option.withDefault item.name

    SCM.Conflicts.pending ()
    |> Stdlib.List.findFirst (fun c ->
      (SCM.Conflicts.fqn c.owner c.modules c.name) == location)

/// In-CLI documentation topics (for the Docs view).
let loadDocBodyItems () : List<BodyItem> =
  Docs.Command.Topics.allTopics ()
  |> Stdlib.List.map (fun t ->
    BodyItem { name = t.name; kind = "doc"; isModule = false; desc = t.description })

/// The Errors view - the high-importance issues an operator running software on Dark cares about. Real
/// conflicts (genuine) first, then a mock set of the other error kinds until those signals are wired.
/// The Sync view's rows: this machine, what is not on the relay yet (main's
/// standing, and the branches with ops to push), the other instances the
/// relay knows, and what sync did lately.
///
/// Sections are header rows (kind `sync-sec`, drawn dim) over fact rows
/// (kind `sync-row`: a label in `name`, the fact in `desc`), like Home. All
/// of it is a local read, so opening the view is free and it renders
/// offline. The other instances are the relay's to know, and asking it can
/// block for the connect timeout when it is down, so that section is filled
/// only on `o` (`syncPeerItems`), never on the transition into the view:
/// `peers` is the relay's answer when it has been asked, else a hint row.
let loadSyncItemsWith (peers: Stdlib.Option.Option<List<BodyItem>>) : List<BodyItem> =
  let row (label: String) (fact: String) : BodyItem =
    BodyItem { name = label; kind = "sync-row"; isModule = false; desc = fact }
  let section (label: String) (rows: List<BodyItem>) : List<BodyItem> =
    Stdlib.List.flatten
      [ [ BodyItem { name = ""; kind = "sync-sec"; isModule = false; desc = "" }
          BodyItem { name = label; kind = "sync-sec"; isModule = false; desc = "" } ]
        rows ]
  let facts = readSyncFacts ()
  let relay = facts.relay
  let identity = SCM.PackageOps.identity ()
  let scopeAll =
    match Darklang.Cli.Config.get "sync.branches" with
    | Some "all" -> true
    | _ -> false

  let machine =
    if relay == "" then
      [ row "identity" identity
        row "relay" "none · `:sync setup` names this instance and connects one" ]
    else
      let secret =
        if Darklang.Cli.Sync.hasRelaySecret relay then "secret stored" else "no secret: this instance can pull, not push"
      let unpushed = facts.mainUnpushed
      let waiting =
        if unpushed == 0L then "no main ops waiting to push"
        else (Stdlib.Int64.toString unpushed) ++ " op(s) to push"
      let cursor = SCM.Wire.pullCursor relay
      let pulled =
        if cursor == 0L then "nothing pulled yet" else "pulled up to op " ++ (Stdlib.Int64.toString cursor)
      [ row "identity" identity
        row "relay" (relay ++ " · " ++ secret)
        row "standing" (waiting ++ " · " ++ pulled)
        row "scope" (if scopeAll then "every branch (sync.branches = all)" else "main only · `:config set sync.branches all` for every branch")
        row "daemon" "`:apps status sync` · `:apps enable sync` syncs every 30s" ]

  // What is not on the relay yet: main's standing always, then only the open branches holding
  // ops the relay lacks, and one row counting the rest. A branch with nothing to push has
  // nothing to say here, and Home is where branches are listed and picked. The scope caveat
  // (automatic sync moves main only) is on the "scope" row above, once. No relay, no section:
  // there is no standing to report.
  let branches =
    if relay == "" then []
    else
      let current = SCM.PackageOps.currentBranch ()
      let open_ = SCM.Branch.list () |> Stdlib.List.filter (fun b -> Stdlib.Bool.not b.merged)
      let mainRow =
        row
          ((branchMarker (SCM.Branch.isMain current)) ++ SCM.Branch.mainBranchName)
          (syncBranchStanding facts SCM.Branch.mainBranchName true)
      let waiting =
        open_
        |> Stdlib.List.filter (fun b -> (branchUnpushed facts b.name false) > 0L)
        |> Stdlib.List.map (fun b ->
          row ((branchMarker (b.id == current)) ++ b.name) (syncBranchStanding facts b.name false))
      let rest = (Stdlib.List.length open_) - (Stdlib.List.length waiting)
      let restRow =
        if rest == 0 then []
        else
          let noun = if Stdlib.List.isEmpty waiting then "branch" else "other branch"
          [ row "" ((plural rest noun) ++ " with nothing to push") ]
      Stdlib.List.flatten [ [ mainRow ], waiting, restRow ]

  let peerRows =
    match peers with
    | Some rows -> rows
    | None ->
      if relay == "" then [ row "" "connect a relay to see who else syncs with it" ]
      else [ row "" "o asks the relay who else syncs with it" ]

  let activity =
    let entries = Darklang.Cli.Sync.recentActivity ()
    if Stdlib.List.isEmpty entries then [ row "" "nothing yet · s syncs now" ]
    else entries |> Stdlib.List.map (fun e -> row (agoText e.at) (e.verb ++ " " ++ e.detail))

  Stdlib.List.flatten
    [ section "this machine" machine
      (if Stdlib.List.isEmpty branches then [] else section "branches" branches)
      section "other instances" peerRows
      section "recent activity" activity ]
  |> Stdlib.List.drop 1

let loadSyncItems () : List<BodyItem> = loadSyncItemsWith Stdlib.Option.Option.None

/// The other instances the relay knows, as rows for the Sync view's "other
/// instances" section: who has pushed a branch there, and how many of those
/// this instance has not pulled. The one network call the view makes, and
/// it is made on `o`, not on opening the view: with the relay down this
/// waits out the connect timeout, and an unreachable relay is a row, not a
/// crash.
let syncPeerItems () : List<BodyItem> =
  let row (label: String) (fact: String) : BodyItem =
    BodyItem { name = label; kind = "sync-row"; isModule = false; desc = fact }
  let relay = SCM.PackageOps.relay ()
  let me = SCM.PackageOps.identity ()
  if relay == "" then
    [ row "" "connect a relay to see who else syncs with it" ]
  else
    match Darklang.Cli.Sync.relayGetAuthed relay "/branch/owners" with
    | Error e -> [ row "relay" ("unreachable: " ++ e) ]
    | Ok body ->
      let knownIds = SCM.Branch.list () |> Stdlib.List.map (fun b -> Stdlib.Uuid.toString b.id)
      let entries =
        Stdlib.String.fromBlobWithReplacement body
        |> Stdlib.String.splitOnNewline
        |> Stdlib.List.filterMap (fun line ->
          match Stdlib.String.split (Stdlib.String.trim line) " " with
          | [ owner, bid ] -> if owner == me then Stdlib.Option.Option.None else Stdlib.Option.Option.Some (owner, bid)
          | _ -> Stdlib.Option.Option.None)
      let owners = entries |> Stdlib.List.map (fun pair -> let (o, _b) = pair in o) |> Stdlib.List.unique
      if Stdlib.List.isEmpty owners then [ row "" "no other instance has pushed a branch to this relay" ]
      else
        owners
        |> Stdlib.List.map (fun owner ->
          let theirs = entries |> Stdlib.List.filter (fun pair -> let (o, _b) = pair in o == owner)
          let notPulled =
            theirs |> Stdlib.List.filter (fun pair -> let (_o, b) = pair in Stdlib.Bool.not (Stdlib.List.member knownIds b))
            |> Stdlib.List.length
          let fact =
            (plural (Stdlib.List.length theirs) "branch") ++ " on the relay"
            ++ (if notPulled == 0 then "" else " · " ++ (Stdlib.Int.toString notPulled) ++ " not pulled · `:branch pull --from " ++ owner ++ "`")
          row owner fact)

let loadErrorItems () : List<BodyItem> =
  let conflicts =
    SCM.Conflicts.pending ()
    |> Stdlib.List.map (fun c ->
      let location = SCM.Conflicts.fqn c.owner c.modules c.name
      BodyItem
        { name = "⚠ conflict    " ++ location ++ "  ·  " ++ c.status
          kind = "error"
          isModule = false
          desc = "" })
  // Invented rows showing the shape of the thing. Tagged apart from the real conflicts above so the
  // detail pane can say which one you are looking at.
  let mock =
    [ BodyItem { name = "⚠ 500         POST /checkout - 12 in the last hour"; kind = "error-sample"; isModule = false; desc = "" }
      BodyItem { name = "✗ test        Stachu.Auth.login passes but shouldn't"; kind = "error-sample"; isModule = false; desc = "" }
      BodyItem { name = "⚠ 500         GET /api/user/:id - 3 in the last hour"; kind = "error-sample"; isModule = false; desc = "" }
      BodyItem { name = "✗ deprecated  Stdlib.List.oldMap still called by 4 fns"; kind = "error-sample"; isModule = false; desc = "" }
      BodyItem { name = "⚠ perf        Stachu.report.build - 4.2s p95 (was 0.8s)"; kind = "error-sample"; isModule = false; desc = "" } ]
  Stdlib.List.append conflicts mock

let errorDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    // The conflict rows are real; only the sample rows are invented.
    let provenance =
      if item.kind == "error-sample" then
        Stdlib.Cli.UI.Colors.dimText "(mock data) - a real Errors view aggregates: test failures + tests that"
      else
        Stdlib.Cli.UI.Colors.dimText "this is a real recorded conflict. The rest of an Errors view aggregates:"
    (Stdlib.Cli.UI.Colors.boldText item.name)
    ++ "\n\n"
    ++ provenance
    ++ "\n"
    ++ (Stdlib.Cli.UI.Colors.dimText "pass but shouldn't, HTTP 5xx on tracked endpoints, unresolved conflicts,")
    ++ "\n"
    ++ (Stdlib.Cli.UI.Colors.dimText "deprecations still in use, and perf regressions.")
    ++ "\n\n"
    ++ "⏎ open the source / trace     f filter by kind"
  | None -> Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green "✓ all clear - no errors"

/// The Crons view - scheduled jobs on this instance (mock until a Darklang.Cron value type + engine exist;
/// see notes/cli-ux/22-things.md and classic Dark's cron model). Columns: status · name · schedule · last · next.
let loadCronItems () : List<BodyItem> =
  [ BodyItem { name = "●  nightly-backup    daily 02:00    14h ago ok    in 9h"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "⏸  digest-email      weekly Mon     3d ago  ok    paused"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "⚠  sync-metrics      every 1h       52m ago fail  in 8m"; kind = "cron"; isModule = false; desc = "" }
    BodyItem { name = "○  cleanup-temp      every 12h      never         in 12h"; kind = "cron"; isModule = false; desc = "" } ]

let cronDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    (Stdlib.Cli.UI.Colors.boldText item.name)
    ++ "\n\n"
    ++ "schedule : daily at 02:00  (EveryDay)\n"
    ++ "handler  : Stachu.Backups.nightly  @9fa3…\n"
    ++ "last run : 2026-07-24 02:00  ok  1.2s\n"
    ++ "next run : 2026-07-25 02:00  (in 9h)\n"
    ++ "state    : enabled · runs 41 · fails 0 · ● this instance\n\n"
    ++ (Stdlib.Cli.UI.Colors.dimText "(mock data)")
    ++ "\n\n"
    ++ "r run-now   p pause/resume   t traces   e edit"
  | None -> Stdlib.Cli.UI.Colors.dimText "no crons yet - declare a Darklang.Cron value"

/// Recent execution traces (for the Traces view). Real traces if any are recorded; otherwise a labeled
/// preview set so the surface reads as complete rather than empty (this env records none).
let loadTraceBodyItems () : List<BodyItem> =
  let real =
    Darklang.Tracing.Store.list 30
    |> Stdlib.List.map (fun t ->
      BodyItem { name = t.handler; kind = "trace"; isModule = false; desc = t.timestamp })
  if Stdlib.Bool.not (Stdlib.List.isEmpty real) then
    real
  else
    // Nothing recorded here yet, so show a shape-of-the-thing sample. Tagged distinctly so the detail pane
    // can say which it's looking at, rather than calling every trace mock.
    [ BodyItem { name = "✓ eval   Stdlib.List.map [1,2,3] (fun x -> x * 2)"; kind = "trace-sample"; isModule = false; desc = "" }
      BodyItem { name = "✓ GET    /echo → 200            heartbeat"; kind = "trace-sample"; isModule = false; desc = "" }
      BodyItem { name = "✗ POST   /sync → 500            syncer"; kind = "trace-sample"; isModule = false; desc = "" }
      BodyItem { name = "✓ eval   @stachu.fizzbuzz 3"; kind = "trace-sample"; isModule = false; desc = "" }
      BodyItem { name = "✓ CLI    dark status"; kind = "trace-sample"; isModule = false; desc = "" } ]

/// Installed + available apps (for the Apps view). A filled dot marks installed; a hollow one available.
let loadAppItems (branchId: Uuid) : List<BodyItem> =
  let slugs = Darklang.Cli.Apps.Registry.installedSlugs ()
  Darklang.Cli.Apps.Registry.available ()
  |> Stdlib.List.map (fun a ->
    let mark = if Stdlib.List.member slugs a.slug then "● " else "○ "
    BodyItem { name = mark ++ a.name; kind = "app"; isModule = false; desc = a.description })

/// The body items for a given view. Home lists the branch's state (see
/// `loadHomeItems`); Matter the packages (with a Values lens); Changes this
/// branch's uncommitted work; AI/Apps/Traces/Docs their own; Scratch/Devices
/// render their own bodies (no list). The AI section and the lens come from
/// the view states.
let itemsForView
  (view: Int)
  (branchId: Uuid)
  (location: Packages.PackageLocation)
  (aiSection: AiSection)
  (matterLens: Lens)
  : List<BodyItem> =
  if view == vHome then loadHomeItems branchId
  else if view == vMatter then
    if matterLens == Lens.ValuesOnly then loadThingItems branchId
    else if matterLens == Lens.Changed then loadChangedItems branchId
    else loadItems branchId location
  else if view == vSCM then loadChangedItems branchId
  else if view == vAI then
    if aiSection == AiSection.Prompts then loadPromptItems () else loadAiThreadItems ()
  else if view == vApps then loadAppItems branchId
  else if view == vTraces then loadTraceBodyItems ()
  else if view == vDocs then loadDocBodyItems ()
  else
    // Extension views compose their own item loader (see `extensionViews`); built-ins fall through to [].
    match extensionViewAt view with
    | Some vd ->
      let load = vd.loadItems
      load ()
    | None -> []

/// Reload the CURRENT view's item list, i.e. `itemsForView` fed the live state. This is the "refresh what I'm
/// looking at" call every mutating action (write / rename / branch op / section switch) makes; naming it once
/// keeps those call sites to a single line instead of the six-argument spell.
/// Narrow a list by the active filter, case-insensitively. "" narrows nothing.
///
/// Items first, filter second, so `items |> applyFilter f` reads correctly: Dark's `|>` puts the piped value
/// in the FIRST parameter, the opposite of F#.
let applyFilter (items: List<BodyItem>) (filter: String) : List<BodyItem> =
  if filter == "" then
    items
  else
    let needle = Stdlib.String.toLowercase filter
    items |> Stdlib.List.filter (fun it -> Stdlib.String.contains (Stdlib.String.toLowercase it.name) needle)

/// Reload the current view's items, keeping any active filter applied.
///
/// Applying the filter here makes it a property of the state, not a one-shot: otherwise
/// every later reload (commit, discard, rename, save) silently widens the list while the
/// title still says "filter: foo" -- the only way ~17 reload sites stay correct.
///
/// Switching to a DIFFERENT list is the other case, and those sites clear `filter` instead: a filter you
/// typed for Changes has no business narrowing History.
let reloadItems (state: State) : List<BodyItem> =
  itemsForView state.activeView state.branchId state.location state.ai.section state.matter.lens
  |> applyFilter state.filter


// ── Rendering ──
