/// Reads for the package tree and SCM: items, commits, diffs, search, dependencies.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

let modulePathOf (location: Packages.PackageLocation) : List<String> =
  match location with
  | Module path -> path
  | Type t -> Stdlib.List.append [ t.owner ] t.modules
  | Value v -> Stdlib.List.append [ v.owner ] v.modules
  | Function f -> Stdlib.List.append [ f.owner ] f.modules

/// A one-line, clipped rendering of a value's body for the row description:
/// `= "hello"`, `= [1, 2, 3]`. First line only, and no more than `width`
/// columns - a value can be a whole table.
let valueDesc (ctx: PrettyPrinter.ProgramTypes.Context) (body: LanguageTools.ProgramTypes.Expr) (width: Int) : String =
  let printed = PrettyPrinter.ProgramTypes.expr ctx body
  let firstLine = Stdlib.String.split printed "\n" |> Stdlib.List.head |> Stdlib.Option.withDefault printed
  let clipped =
    if Stdlib.String.length firstLine > width then (Stdlib.String.slice firstLine 0 (width - 1)) ++ "…"
    else firstLine
  "= " ++ clipped

/// The rows of a module: its submodules, then types, values and fns, each
/// with a description built from the entity the search already returned - a
/// fn's signature, a type's shape, a value's literal - so a module reads as a
/// table of contents rather than a list of names.
let loadItems (branchId: Uuid) (location: Packages.PackageLocation) : List<BodyItem> =
  let modulePath = modulePathOf location
  let results = Packages.Query.allDirectDescendants branchId modulePath
  let subs = Packages.Query.getDirectSubmodules results (Stdlib.List.length modulePath)
  // Anchored at the module being listed, so a signature spells its neighbours
  // by their short names.
  let ctx = PrettyPrinter.ProgramTypes.Context.forModule branchId modulePath
  let typeRef (t: LanguageTools.ProgramTypes.TypeReference) : String = PrettyPrinter.ProgramTypes.typeReference ctx t
  let moduleItems =
    subs |> Stdlib.List.map (fun n -> BodyItem { name = n; kind = "module"; isModule = true; desc = "" })
  let typeItems =
    results.types
    |> Stdlib.List.map (fun t ->
      let shape =
        match t.entity.declaration.definition with
        | Record fields -> "record · " ++ (Stdlib.Int.toString (Stdlib.List.length fields)) ++ " fields"
        | Enum cases -> "enum · " ++ (Stdlib.Int.toString (Stdlib.List.length cases)) ++ " cases"
        | Alias tr -> "= " ++ (typeRef tr)
      BodyItem { name = t.location.name; kind = "type"; isModule = false; desc = shape })
  let valItems =
    results.values
    |> Stdlib.List.map (fun v ->
      BodyItem { name = v.location.name; kind = "val"; isModule = false; desc = valueDesc ctx v.entity.body 40 })
  let fnItems =
    results.fns
    |> Stdlib.List.map (fun f ->
      let params = f.entity.parameters |> Stdlib.List.map (fun p -> typeRef p.typ)
      let args = if Stdlib.List.isEmpty params then "()" else Stdlib.String.join params " -> "
      let sig_ = args ++ " -> " ++ (typeRef f.entity.returnType)
      let effects =
        Permissions.Command.requirementDisplay
          (LanguageTools.ProgramTypes.hashToString f.entity.hash)
      BodyItem
        { name = f.location.name
          kind = "fn"
          isModule = false
          desc = sig_ ++ "  [" ++ effects ++ "]" })
  Stdlib.List.flatten [ moduleItems, typeItems, valItems, fnItems ]

/// How many names the draft touches -- the same number the Changes list shows.
///
/// Items, not ops: authoring one value emits two ops (AddValue + SetName), so an op count would say
/// "2 changes" above a list titled "Changes . 1". Ops are the right unit for a commit's size; items
/// are the right unit for "how much have I changed".
///
/// No branch to pass: `SCM.Draft.read ()` resolves through the process branch overlay, which `onBranch`
/// keeps in step with `state.branchId`. For any OTHER branch, ask `draftBindingsFor` by id.
let wipItemCount () : Int =
  Stdlib.List.length (SCM.Draft.read ()).bindings

/// Feeds the SCM changes list and Matter's Changed lens -- one list, two angles. The
/// lens shows the draft as your code filtered to what moved, with the real tree
/// renderer and edit-in-place.
///
/// Flat and fully qualified, like the Values lens, because a draft is scattered across modules and
/// filtering a tree to five leaves in five places is worse than a list.
let loadChangedItems (branchId: Uuid) : List<BodyItem> =
  // The branch ASKED about, not the process overlay: a caller that just switched hands the new id
  // before the overlay follows, and an ignored parameter here answered for the old branch.
  SCM.PackageOps.draftBindingsFor branchId
  |> Stdlib.List.map (fun b ->
    BodyItem
      { name = SCM.Conflicts.fqn b.owner b.modules b.name
        kind = b.itemType
        isModule = false
        desc = "" })

/// Recent commits (this branch + ancestors) as body items (for the History view).
let loadCommitBodyItems () : List<BodyItem> =
  Cli.Commits.commitRows 30L
  |> Stdlib.List.map (fun c ->
    // `c.hash` is already the hex string, not a `Hash`. `hashToShort` takes the wrapper.
    let short = Stdlib.String.first c.hash 8
    let ops = Stdlib.Int64.toString c.ops
    BodyItem
      { name = c.message
        kind = "commit"
        isModule = false
        desc = short ++ " · " ++ ops ++ (if ops == "1" then " op" else " ops") })

/// The ops of the selected commit, rendered for the reader. Capped - a seed commit can have 10k+ ops.
let commitOpsText (branchId: Uuid) (selected: Int) : String =
  let commits = Cli.Commits.commitRows 30L
  match Stdlib.List.getAt commits selected with
  | None -> "(no commit selected)"
  | Some c ->
    let hashStr = c.hash
    // Fetch the 20 we show, not all of them: the seed commit holds ~17k ops, and deserializing every blob
    // to display twenty of them freezes this pane for as long as that takes.
    let opCount = Stdlib.Int.fromInt64 (SCM.PackageOps.opCountIn hashStr)
    let shown = SCM.PackageOps.opsInCommitLimited hashStr 20L
    let opLines =
      shown
      |> Stdlib.List.map (fun op -> "  " ++ (PrettyPrinter.ProgramTypes.PackageOp.packageOp branchId op))
      |> Stdlib.String.join "\n"
    let more =
      if opCount > 20 then
        "\n\n  … and " ++ (Stdlib.Int.toString (opCount - 20)) ++ " more ops"
      else
        ""
    c.message ++ "  (" ++ (Stdlib.Int.toString opCount) ++ " ops)\n\n" ++ opLines ++ more

/// A cheap commit summary for the History preview - hash, message, op count - WITHOUT fetching every op (the
/// seed commit has 10k+; fetching them per keystroke would make the list crawl). Full ops are behind Enter.
let commitSummary (selected: Int) : String =
  let commits = Cli.Commits.commitRows 30L
  match Stdlib.List.getAt commits selected with
  | None -> "(no commit selected)"
  | Some c ->
    // Message first: it answers "what is this commit"; the hash is only for copy/paste, so it sits
    // dimmed underneath rather than in the brightest slot.
    c.message
    ++ "\n\n"
    ++ (Stdlib.Cli.UI.Colors.dimText c.hash)
    ++ "\n\n"
    ++ (Stdlib.Int64.toString c.ops)
    ++ (if c.ops == 1L then " op  ·  press ⏎ to view it" else " ops  ·  press ⏎ to view them")

/// Render diff lines as syntax-highlighted code with a faint wash behind what
/// changed: green behind added lines, red behind removed, nothing behind
/// context. The code keeps its normal highlighting either way.
///
/// Highlighting is a whole-program pass, so it runs twice - once over the old
/// side (context + removed), once over the new (context + added) - and the
/// diff is walked once more to pick each line's coloured form from the side
/// it belongs to. A highlighted line carries resets, which would end the wash
/// mid-line; the wash is re-asserted after each, and the line is padded so it
/// reads as a highlighter stroke to the pane's edge.
let renderDiffLines (lines: List<Stdlib.Diff.DiffLine>) (state: State) : List<String> =
  let textOf (dl: Stdlib.Diff.DiffLine) : String =
    match dl with
    | Same s -> s
    | Added s -> s
    | Removed s -> s
  let isOld (dl: Stdlib.Diff.DiffLine) : Bool =
    match dl with
    | Added _ -> false
    | _ -> true
  let isNew (dl: Stdlib.Diff.DiffLine) : Bool =
    match dl with
    | Removed _ -> false
    | _ -> true
  let highlightSide (keep: Stdlib.Diff.DiffLine -> Bool) : List<String> =
    let src = lines |> Stdlib.List.filter keep |> Stdlib.List.map textOf |> Stdlib.String.join "\n"
    let h = SyntaxHighlighting.highlightCode src |> Stdlib.String.split "\n"
    let n = lines |> Stdlib.List.filter keep |> Stdlib.List.length
    // The parser can't change the line count, but be safe: fall back to plain
    // text if it somehow did.
    if Stdlib.List.length h == n then h else lines |> Stdlib.List.filter keep |> Stdlib.List.map textOf
  let oldSide = highlightSide isOld
  let newSide = highlightSide isNew
  // Pad to the preview pane's width, no further: `wrapRow` folds anything
  // wider than `innerWidth - 2`, so a fixed 160 turned one short line into
  // several rows of blank wash on a narrow pane.
  let fillWidth = Stdlib.Int.max 1 ((previewInnerWidth state) - 2)
  let wash (bg: String) (gutter: String) (code: String) : String =
    // Re-assert the background after every reset in the line - the gutter's
    // own and the highlighter's.
    let washed = Stdlib.String.replaceAll (gutter ++ code) Stdlib.Cli.UI.Colors.reset (Stdlib.Cli.UI.Colors.reset ++ bg)
    let visible = Stdlib.Cli.Tui.Text.styledWidth (gutter ++ code)
    let pad = Stdlib.String.repeat " " (Stdlib.Int.max 0 (fillWidth - visible))
    bg ++ washed ++ pad ++ Stdlib.Cli.UI.Colors.reset
  // Walk the diff, consuming from each side as its lines come up: (oldIdx,
  // newIdx, rendered so far).
  let (_o, _n, out) =
    lines
    |> Stdlib.List.fold (0, 0, []) (fun acc dl ->
      let (o, n, done_) = acc
      match dl with
      | Same _ ->
        let code = Stdlib.List.getAt newSide n |> Stdlib.Option.withDefault (textOf dl)
        (o + 1, n + 1, Stdlib.List.append done_ [ "  " ++ code ])
      | Added _ ->
        let code = Stdlib.List.getAt newSide n |> Stdlib.Option.withDefault (textOf dl)
        (o, n + 1, Stdlib.List.append done_ [ wash Stdlib.Cli.UI.Colors.faintGreenBg (Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.green ++ Stdlib.Cli.UI.Colors.bold) "+ ") code ])
      | Removed _ ->
        let code = Stdlib.List.getAt oldSide o |> Stdlib.Option.withDefault (textOf dl)
        (o + 1, n, Stdlib.List.append done_ [ wash Stdlib.Cli.UI.Colors.faintRedBg (Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.red ++ Stdlib.Cli.UI.Colors.bold) "- ") code ]))
  out

/// A real old-vs-new SOURCE diff for one draft item.
///
/// A NEW item has no previous version, so it diffs against empty and comes out as all-added, which is
/// exactly right.
let sourceDiffFor (branchId: Uuid) (fqn: String) : List<Stdlib.Diff.DiffLine> =
  let binding =
    SCM.PackageOps.draftBindingsFor branchId
    |> Stdlib.List.findFirst (fun b ->
      (SCM.Conflicts.fqn b.owner b.modules b.name) == fqn)

  match binding with
  | None -> [ Stdlib.Diff.DiffLine.Same "(nothing in the draft touches this name)" ]
  | Some b ->
    // `b.name` on both sides: the PREVIOUS version of a name is bound to nothing live, so the printer
    // cannot name it and would render `let <hash:...>` on the left of every diff.
    let newText = Cli.Conflicts.renderItem branchId b.itemType b.hash b.name

    let oldText =
      match Cli.Commit.previousHashesOf branchId b with
      | [] -> ""
      | prev :: _ ->
        Cli.Conflicts.renderItem
          branchId
          b.itemType
          (LanguageTools.ProgramTypes.hashToString prev)
          b.name

    Stdlib.Diff.lines oldText newText

/// The selected draft item's diff, as text. Matched by name so it lines up with the workbench's
/// own WIP list regardless of ordering.
let wipDiffText (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> "(no change selected)"
  | Some item ->
    sourceDiffFor state.branchId item.name
    |> Stdlib.List.map (fun dl ->
      match dl with
      | Same s -> Stdlib.Cli.UI.Colors.dimText ("  " ++ s)
      | Added s -> Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green ("+ " ++ s)
      | Removed s -> Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.red ("- " ++ s))
    |> Stdlib.String.join "\n"

/// The current source of the selected WIP item, for the Changes reader.
let changesSourceText (branchId: Uuid) (selected: Int) : String =
  let items = loadChangedItems branchId
  match Stdlib.List.getAt items selected with
  | None -> "(no change selected)"
  | Some d ->
    let name = d.name
    let kind = d.kind
    // `name` is the full path (owner.Module.leaf) - split into the module path + leaf for the lookup.
    let parts = Stdlib.String.split name "."
    let leaf = Stdlib.List.last parts |> Stdlib.Option.withDefault name
    let mods = Stdlib.List.take parts (Stdlib.Int.max 0 ((Stdlib.List.length parts) - 1))
    let results = Packages.Query.searchExactMatch branchId mods leaf
    let ctx = PrettyPrinter.ProgramTypes.Context.forBranch branchId
    let src =
      if kind == "type" then
        match results.types with
        | i :: _ -> PrettyPrinter.ProgramTypes.packageType ctx i.entity
        | [] -> "(not found)"
      else if kind == "value" then
        match results.values with
        | i :: _ -> PrettyPrinter.ProgramTypes.packageValue ctx i.entity
        | [] -> "(not found)"
      else
        match results.fns with
        | i :: _ -> PrettyPrinter.ProgramTypes.packageFn ctx i.entity
        | [] -> "(not found)"
    name ++ "  (" ++ kind ++ ", uncommitted)\n\n" ++ src

/// Run a package search across the whole tree and return jumpable hits (each carries its module path + leaf so
/// Enter can navigate there). The `/` global action opens these in the search-results mode.
let runSearch (branchId: Uuid) (queryText: String) : List<SearchHit> =
  let query =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = []
        text = queryText
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes = []
        exactMatch = false }
  let r = LanguageTools.PackageManager.Search.search branchId query
  let hit (tag: String) (location: LanguageTools.ProgramTypes.PackageLocation) : SearchHit =
    let modules = Stdlib.List.append [ location.owner ] location.modules
    let full = Stdlib.String.join (Stdlib.List.append modules [ location.name ]) "."
    SearchHit { modules = modules; name = location.name; kind = tag; display = "  " ++ tag ++ "  " ++ full }
  // Rank by how well the LEAF NAME matches, because the search also matches descriptions and those hits
  // otherwise interleave alphabetically with the real ones: searching `toUppercase` put
  // `Stdlib.String.toUppercase` sixth, behind `Stdlib.Blob.fromHex`, which matched on its description.
  let needle = Stdlib.String.toLowercase (Stdlib.String.trim queryText)
  let rank (h: SearchHit) : Int =
    let name = Stdlib.String.toLowercase h.name
    if name == needle then 0
    else if Stdlib.String.startsWith name needle then 1
    else if Stdlib.String.contains name needle then 2
    else 3
  Stdlib.List.flatten
    [ r.types |> Stdlib.List.map (fun i -> hit "type" i.location)
      r.values |> Stdlib.List.map (fun i -> hit "val " i.location)
      r.fns |> Stdlib.List.map (fun i -> hit "fn  " i.location) ]
  |> Stdlib.List.sortBy rank

/// Dependencies of the selected Tree leaf (what it uses), formatted for the reader. `d` shows this.
let depsText (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> "(nothing selected)"
  | Some item ->
    if item.isModule then
      "Modules have no dependencies - select a fn, type, or value."
    else
      let modulePath = modulePathOf state.location
      let results = Packages.Query.searchExactMatch state.branchId modulePath item.name
      let picked =
        if item.kind == "fn" then
          results.fns |> Stdlib.List.head |> Stdlib.Option.map (fun i -> (i.entity.hash, i.location, LanguageTools.ProgramTypes.ItemKind.Fn))
        else if item.kind == "type" then
          results.types |> Stdlib.List.head |> Stdlib.Option.map (fun i -> (i.entity.hash, i.location, LanguageTools.ProgramTypes.ItemKind.Type))
        else
          results.values |> Stdlib.List.head |> Stdlib.Option.map (fun i -> (i.entity.hash, i.location, LanguageTools.ProgramTypes.ItemKind.Value))
      match picked with
      | None -> "(not found)"
      | Some((hash, loc, kind)) ->
        // Dependencies - what this item uses.
        let deps = Packages.Query.getDependencies hash
        let depLines =
          if Stdlib.List.isEmpty deps then [ Stdlib.Cli.UI.Colors.dimText "  (none)" ]
          else
            let namesDict =
              Darklang.Cli.Deps.resolveNamesIn
                state.branchId
                (modulePathOf state.location)
                (deps |> Stdlib.List.map (fun p -> let (h, _) = p in h))
            deps |> Stdlib.List.map (fun p -> let (th, _rt) = p in "  " ++ (Darklang.Cli.Deps.getName namesDict th))
        // Dependents - what uses this item.
        // The same Dark-side query `dark deps` uses, so the pane and the command cannot disagree.
        let dependents = SCM.Deps.dependentsOf [ (loc, kind) ]
        let dependentLines =
          if Stdlib.List.isEmpty dependents then [ Stdlib.Cli.UI.Colors.dimText "  (none)" ]
          else
            // Spelled from where the reader is standing, like everything else on this page.
            let here = modulePathOf state.location
            dependents
            |> Stdlib.List.map (fun t ->
              let (_h, sLoc, _rt) = t
              "  " ++ (PrettyPrinter.ProgramTypes.PackageLocation.packageLocationIn here sLoc))
        // No item name here: `inspectPageLines` composes this under a page already headed by that
        // item's source, so including it printed the name twice on one screen.
        //
        // Counts use the same `label  ·  count` shape as the pane titles and the meta strip, rather
        // than a third punctuation for the same idea on the same screen.
        (Stdlib.Cli.UI.Colors.dimText ("Dependencies (uses)  ·  " ++ (Stdlib.Int.toString (Stdlib.List.length deps))))
        ++ "\n"
        ++ (Stdlib.String.join depLines "\n")
        ++ "\n\n"
        ++ (Stdlib.Cli.UI.Colors.dimText ("Dependents (used by)  ·  " ++ (Stdlib.Int.toString (Stdlib.List.length dependents))))
        ++ "\n"
        ++ (Stdlib.String.join dependentLines "\n")

/// AI threads for the AI view (the thread board - demo data for now, via the shared Views.AiChats source).


/// Read the badge sets for a state: which items have uncommitted edits, and which are deprecated.
let readBadges (state: State) : (List<String> * List<String>) =
  // Only the Matter tree shows badges, and the values lens hides them, so everything else skips both reads.
  if (state.activeView != vMatter) || (state.matter.lens == Lens.ValuesOnly) then
    ([], [])
  else
    // The draft names come off the cached SCM status rather than a read of their own: the tree's pink dot
    // and Home's "N changed" are the same fact, and two reads of it could disagree.
    let wip = state.scmStatus.wipNames
    let sets = Packages.Query.loadDeprecationSets state.branchId
    let results = Packages.Query.allDirectDescendants state.branchId (modulePathOf state.location)
    let pick = fun pairs ->
      pairs
      |> Stdlib.List.filter (fun (hash, _name) -> Packages.Query.isDeprecated sets hash)
      |> Stdlib.List.map (fun (_hash, name) -> name)
    (wip,
     Stdlib.List.flatten
       [ pick (results.fns |> Stdlib.List.map (fun i -> (i.entity.hash, i.location.name)))
         pick (results.types |> Stdlib.List.map (fun i -> (i.entity.hash, i.location.name)))
         pick (results.values |> Stdlib.List.map (fun i -> (i.entity.hash, i.location.name))) ])


/// Carry the cached badge sets forward, re-reading only when something they depend on moved.
///
/// The dependency is the branch, where you are, the lens, the view, and the item list itself (a commit or a
/// discard changes what's uncommitted without moving you). Comparing those is cheap; the reads are not.
let refreshBadges (previous: State) (next: State) : State =
  let unchanged =
    (previous.branchId == next.branchId)
    && (previous.location == next.location)
    && (previous.matter.lens == next.matter.lens)
    && (previous.activeView == next.activeView)
    && (previous.items == next.items)

  if unchanged then
    next
  else
    let (wip, deprecated) = readBadges next
    { next with wipNames = wip; deprecatedNames = deprecated }

/// Re-read the SCM picture when anything that could have moved it did.
///
/// A WIDER rule than `refreshBadges` uses, and deliberately so. The badges depend on where you are; the SCM
/// status depends on what you've DONE. Committing, discarding, pinning and settling a conflict all change it
/// without moving the branch, the location or the item list, so the badges' comparison would carry a stale
/// answer forward. The extra input is the draft's op count, which is one indexed count and is the cheapest
/// question the op log can answer.
///
/// The op count is not enough on its own: an ACK writes no op, and a pull can land nothing but committed
/// ops, so on those paths the comparison would carry a stale "N need you" over work you have just
/// answered. `forceScmRefresh` covers them, and it is a separate function rather than a flag so a caller
/// has to mean it.
let refreshScmStatus (previous: State) (next: State) : State =
  let unchanged =
    next.scmStatus.loaded
    && (previous.branchId == next.branchId)
    && ((SCM.PackageOps.draftOpCountFor next.branchId) == next.scmStatus.ops)

  if unchanged then
    next
  else
    { next with scmStatus = readScmStatus next.branchId }

/// Re-read the SCM picture whatever the counts say. For the actions that change it without moving an op
/// count: an ack, and any command run in a frame (a pull lands other people's commits).
let forceScmRefresh (state: State) : State =
  { state with scmStatus = readScmStatus state.branchId }

/// Run the selected `render` fn and hold its output, for the tree-native view peek.
///
/// This evaluates user code, so it happens here on the transition, not in `detailLines`:
/// the renderer stays a pure function of state, which frame diffing requires.
///
/// Deliberately NOT cached across transitions: the only key available (location +
/// cursor) doesn't change when you edit the selected `render` fn, so a cache can't tell
/// "you edited this" from "nothing happened".
///
/// Your own edit won't show within a session anyway -- the runtime's in-process package
/// cache serves the pre-edit fn until the CLI restarts. That's above this fn.
///
/// The `vMatter` test matches `detailLines`'.
let refreshPeek (next: State) : State =
  let peek =
    if (next.activeView != vMatter) || (next.matter.lens == Lens.ValuesOnly) then
      ""
    else
      match Stdlib.List.getAt next.items next.selected with
      | Some item ->
        if (Stdlib.Bool.not item.isModule) && (item.kind == "fn") && (item.name == "render") then
          let fullpath =
            Stdlib.String.join (Stdlib.List.append (modulePathOf next.location) [ item.name ]) "."
          captureOutput (fun () ->
            Eval.evaluateRaw next.accountId next.branchId (fullpath ++ " ()") [] false)
        else
          ""
      | None -> ""
  { next with renderPeek = peek }
