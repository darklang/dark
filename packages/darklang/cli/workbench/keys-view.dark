/// The plain-view key map (no modal layer above it), and the dispatcher that routes a keypress through
/// the layers in visual stacking order.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

/// The keys that mean the same thing everywhere: find, command, help, the
/// prompt, quit, ` for the sidebar, and the number keys for the workspaces.
/// None if `keyChar` isn't one of them. Both the sidebar and the plain view
/// fall through to this, so neither has to repeat it.
let globalKey (state: State) (keyChar: Stdlib.Option.Option<String>) : Stdlib.Option.Option<Step> =
  match keyChar with
  | Some "q" -> Stdlib.Option.Option.Some (Step.Exit state)
  | Some "?" -> Stdlib.Option.Option.Some (Step.Continue { state with overlay = Overlay.Keymap })
  // The way back to the prompt, on one key. It's an escape hatch, and an
  // escape hatch you have to type a command to reach isn't much of one.
  // `:prompt` still works for anyone who'd rather type it.
  | Some "p" -> Stdlib.Option.Option.Some (Step.ToPrompt state)
  // ` is "go somewhere": the sidebar takes the keyboard (as an overlay on a
  // narrow terminal).
  | Some "`" -> Stdlib.Option.Option.Some (Step.Continue (focusSidebar state))
  | Some ":" ->
    // Command bar - run any old-school command (or eval an expression) from
    // anywhere in the workbench.
    Stdlib.Option.Option.Some
      (Step.Continue
        { state with
            completionSel = 0
            input = Stdlib.Option.Option.Some (InputState { prompt = ": "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "command" }) })
  | Some "/" ->
    // Search prompt - find any package item across the whole tree.
    Stdlib.Option.Option.Some
      (Step.Continue
        { state with
            input = Stdlib.Option.Option.Some (InputState { prompt = "search "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "search" }) })
  | Some s ->
    match Stdlib.Int.parse s with
    | Ok n -> Stdlib.Option.Option.Some (Step.Continue (jumpToWorkspace state n))
    | Error _ -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None

/// Is the cursor on a Home row of this kind?
let homeRowIs (state: State) (kind: String) : Bool =
  (state.activeView == vHome)
  && (match Stdlib.List.getAt state.items state.selected with
      | Some it -> it.kind == kind
      | None -> false)

/// Movement and view actions when no modal layer owns the key.
let handleViewKey
  (state: State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (keyChar: Stdlib.Option.Option<String>)
  : Step =
  match key with
  | UpArrow -> navUp state
  | DownArrow -> navDown state
  // ←/→ move between the panes - sidebar, list, detail - the way they sit on
  // screen. Going into a module is ⏎ (and back out is esc), so the arrows
  // mean one thing everywhere.
  | RightArrow -> focusRight state
  | LeftArrow -> focusLeft state
  | Enter ->
    if state.activeView == vHome then
      // Home: ⏎ goes to the thing the row is about - see `openHomeRow`.
      openHomeRow state
    else if state.activeView == vApps then
      // Apps: ⏎ opens the app - its status, target, and recent logs - in the reader (i toggles install).
      runAppsSubcommand state "inspect"
    else if state.activeView == vDocs then
      // Docs: open the selected topic in the full-body reader (prose, not code). By name, not by index - the
      // list is filterable, see `selectedDocTopic`.
      match selectedDocTopic state with
      | Some t -> openReader state (t.content ()) false
      | None -> Step.Continue state
    else if state.activeView == vSCM then
      // SCM: open the section item - commit ops (History), WIP source (Changes), switch (Branches).
      if state.scm.section == ScmSection.History then openReader state (commitOpsText state.branchId state.selected) false
      else if state.scm.section == ScmSection.Changes then openReader state (changesSourceText state.branchId state.selected) true
      else if state.scm.section == ScmSection.Branches then
        match selectedBranch state with
        | Some b ->
          Step.Continue
            { state with
                branchId = b.id
                items = itemsForView vSCM b.id state.location state.scm.section state.ai.section state.matter.lens
                filter = ""
                message = "switched to " ++ b.name }
        | None -> Step.Continue state
      else Step.Continue state
    else if state.activeView == vScratch then
      // Scratch: open the eval prompt; the result appends to the log.
      Step.Continue
        { state with
            input = Stdlib.Option.Option.Some (InputState { prompt = "repl> "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "scratch" }) }
    else if state.activeView == vAI then
      // AI: ⏎ is the primary action. Prompts → use the prompt (fill the ask bar); Agents → open the thread.
      if state.ai.section == AiSection.Prompts then
        match Stdlib.List.getAt (demoPrompts ()) state.selected with
        | Some p ->
          let (_name, desc) = p
          Step.Continue
            { state with
                input = Stdlib.Option.Option.Some (InputState { prompt = "ask the agent: "; field = Stdlib.Cli.UI.TextField.fromText desc; action = "agent" }) }
        | None -> Step.Continue state
      else openReader state (aiThreadDetail state.selected) false
    else if state.activeView == vTraces then
      // Traces: ⏎ opens the selected trace's detail.
      openReader state (traceDetail state) false
    else if state.activeView == vMatter then
      // Matter: Enter descends into a module, or opens a leaf's source full-screen.
      match Stdlib.List.getAt state.items state.selected with
      | Some item ->
        if item.isModule then descend state
        else openReader state (detailLines state |> Stdlib.String.join "\n") true
      | None -> descend state
    else
      descend state
  | Tab ->
    // Tab moves to the next pane: list → detail → sidebar (when it's a
    // column) → list.
    if state.focus == Stdlib.Cli.UI.SplitPane.Focus.First then
      Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.Second }
    else if sidebarIsColumnNow () then
      Step.Continue (focusSidebar state)
    else
      Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.First }
  | Escape ->
    // Escape is "back", one level, everywhere - never quit (that's `q`).
    // Inside a module it goes up one (the only way up, since ← moves panes);
    // at the top of a view it hands the keyboard to the sidebar.
    if (state.activeView == vMatter) && (Stdlib.Bool.not (Stdlib.List.isEmpty (modulePathOf state.location))) then
      ascend state
    else
      Step.Continue (focusSidebar state)
  | _ ->
    match keyChar with
    // Vim motion - the same movement as the arrows, so muscle memory works either way.
    | Some "k" -> navUp state
    | Some "j" -> navDown state
    | Some "h" -> focusLeft state
    | Some "l" -> focusRight state
    | Some "g" -> navTop state
    | Some "G" -> navBottom state
    | Some "a" ->
      // SCM Conflicts: acknowledge. AI: ask the agent. Devices: add an instance (placeholder).
      if ((state.activeView == vSCM) && (state.scm.section == ScmSection.Conflicts)) || (homeRowIs state "home-conflict") then resolveConflict state "ok"
      else if state.activeView == vAI then
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some
                  (InputState { prompt = "ask the agent: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "agent" }) }
      else if state.activeView == vDevices then Step.Continue { state with message = "add instance - coming soon" }
      else Step.Continue state
    | Some "e" ->
      // Matter: edit the selected fn in place (prefill the editor from its source).
      if state.activeView == vMatter then
        match Stdlib.List.getAt state.items state.selected with
        | Some item ->
          if item.isModule then Step.Continue state else openEditExisting state item
        | None -> Step.Continue state
      else
        Step.Continue state
    | Some "n" ->
      if state.activeView == vMatter then startNew state "fn" else Step.Continue state
    | Some "t" ->
      if state.activeView == vMatter then startNew state "type"
      else if ((state.activeView == vSCM) && (state.scm.section == ScmSection.Conflicts)) || (homeRowIs state "home-conflict") then resolveConflict state "theirs"
      else Step.Continue state
    | Some "o" ->
      if ((state.activeView == vSCM) && (state.scm.section == ScmSection.Conflicts)) || (homeRowIs state "home-conflict") then resolveConflict state "ours"
      else Step.Continue state
    | Some "v" ->
      if state.activeView == vMatter then startNew state "value" else Step.Continue state
    | Some "L" ->
      // Matter: toggle the values-only lens - the whole tree vs. every value
      // across the branch, flat. A filter on the tree, not a place, so it
      // lives here rather than in the sidebar. (L, not V, to avoid clashing
      // with v = new value.)
      if state.activeView == vMatter then
        let nl = otherLens state.matter.lens
        Step.Continue
          { state with
              matter = { state.matter with lens = nl }
              items = itemsForView vMatter state.branchId state.location state.scm.section state.ai.section nl
              selected = 0
              detailScroll = 0
              filter = "" }
      else Step.Continue state
    | Some "f" ->
      // Scratch: clear the log. Elsewhere: open a find-as-you-type filter for the current list.
      // The log and the session are separate: clearing the scrollback shouldn't silently unbind your names.
      if state.activeView == vScratch then
        Step.Continue { state with repl = { state.repl with log = []; last = "" } }
      else
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some (InputState { prompt = "filter: "; field = Stdlib.Cli.UI.TextField.fromText state.filter; action = "filter" }) }
    | Some "i" ->
      // Apps: install/uninstall the selected app (also the primary ⏎ action).
      if state.activeView == vApps then toggleInstall state else Step.Continue state
    | Some "c" ->
      if (state.activeView == vSCM) || (state.activeView == vHome) then
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some (InputState { prompt = "commit message: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "commit" }) }
      else if state.activeView == vDevices then
        // Devices: c opens the real config (cli-config.json) in the reader; edits go through :config set.
        openReader state (deviceConfigText ()) false
      else Step.Continue state
    | Some "x" ->
      // Matter: the traces that called the selected fn. REPL: x drops the
      // session bindings. SCM Branches section: x deletes the selected
      // branch. Otherwise (SCM) x discards all WIP.
      if state.activeView == vMatter then
        match Stdlib.List.getAt state.items state.selected with
        | Some item ->
          if item.isModule then Step.Continue state else openReader state (tracesText state) false
        | None -> Step.Continue state
      else if state.activeView == vScratch then
        Step.Continue
          { state with
              repl = { state.repl with bindings = [] }
              message = "session bindings cleared" }
      else if ((state.activeView == vSCM) && (state.scm.section == ScmSection.Branches)) || (homeRowIs state "home-branch") then
        match selectedBranch state with
        | Some b ->
          Step.Continue
            { state with
                input =
                  Stdlib.Option.Option.Some
                    (InputState { prompt = "delete branch " ++ b.name ++ "? type y then enter: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "branch-delete" }) }
        | None -> Step.Continue state
      else if (state.activeView == vSCM) || (homeRowIs state "home-wip") then
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some
                  (InputState { prompt = "discard ALL uncommitted? type y then enter: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "discard" }) }
      else Step.Continue state
    | Some "b" ->
      if (state.activeView == vSCM) || (state.activeView == vHome) then
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some (InputState { prompt = "new branch name: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "branch-create" }) }
      else Step.Continue state
    | Some "s" ->
      // SCM: switch branch. Devices: sync now. Apps: stop (placeholders where not yet wired).
      if (state.activeView == vSCM) || (state.activeView == vHome) then
        Step.Continue
          { state with
              input =
                Stdlib.Option.Option.Some (InputState { prompt = "switch to branch: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "branch-switch" }) }
      else if state.activeView == vDevices then Step.Continue { state with message = "sync now - coming soon" }
      else if state.activeView == vApps then runAppsSubcommand state "stop"
      else Step.Continue state
    | Some "m" ->
      if (state.activeView == vSCM) || (state.activeView == vHome) then
        match branchForAction state with
        | Some b ->
          Step.Continue
            { state with
                input =
                  Stdlib.Option.Option.Some (InputState { prompt = "merge " ++ b.name ++ " into parent? type y then enter: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "merge" }) }
        | None -> Step.Continue state
      else Step.Continue state
    | Some "r" ->
      // SCM: rebase (or rename a branch in the Branches section). Apps: run. Matter: rename the selected leaf.
      if (state.activeView == vSCM) && (state.scm.section == ScmSection.Branches) then
        match selectedBranch state with
        | Some b ->
          Step.Continue
            { state with
                input =
                  Stdlib.Option.Option.Some (InputState { prompt = "rename branch to: "; field = Stdlib.Cli.UI.TextField.fromText b.name; action = "branch-rename" }) }
        | None -> Step.Continue state
      else if (state.activeView == vSCM) || (state.activeView == vHome) then
        match branchForAction state with
        | Some b ->
          Step.Continue
            { state with
                input =
                  Stdlib.Option.Option.Some
                    (InputState { prompt = "rebase " ++ b.name ++ " onto parent? type y then enter: "; field = Stdlib.Cli.UI.TextField.fromText ""; action = "rebase" }) }
        | None -> Step.Continue state
      else if state.activeView == vApps then launchOrStartApp state
      else if state.activeView == vMatter then
        match Stdlib.List.getAt state.items state.selected with
        | Some item ->
          if item.isModule then Step.Continue state
          else
            Step.Continue
              { state with
                  input =
                    Stdlib.Option.Option.Some
                      (InputState { prompt = "rename to: "; field = Stdlib.Cli.UI.TextField.fromText item.name; action = "rename" }) }
        | None -> Step.Continue state
      else
        Step.Continue state
    | _ ->
      match globalKey state keyChar with
      | Some step -> step
      | None -> Step.Continue state


// ── SubApp wrapper ──


/// Route a keypress through the modal layers, innermost first.
///
/// Each layer either owns the key or defers to the next. The order is the visual stacking order: an overlay
/// beats the editor, the editor beats the command bar, and so on down to the plain view.
let handleKey
  (state: State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers)
  (keyChar: Stdlib.Option.Option<String>)
  : Step =
  // A transient toast lives for exactly one keypress: clear it here, so any key dismisses the last message.
  let state = if state.message == "" then state else { state with message = "" }

  // An overlay is modal: it takes the key before anything else acts on it.
  match state.overlay with
  | Keymap ->
    // Any key closes the keymap.
    Step.Continue { state with overlay = Overlay.NoOverlay }
  | NoOverlay ->
    match state.editing with
    | Some es -> handleEditorKey state es key modifiers keyChar
    | None ->
      match state.input with
      | Some inp -> handleInputKey state inp key modifiers keyChar
      | None ->
        match state.reading with
        | Some content -> handleReaderKey state content key keyChar
        | None ->
          if Stdlib.Bool.not (Stdlib.List.isEmpty state.search.hits) then
            handleSearchResultsKey state key keyChar
          else if sidebarFocused state then
            // Let Home's welcome shortcut work before content has focus.
            if (state.activeView == vHome) && (keyChar == Stdlib.Option.Option.Some "b") then handleViewKey state key keyChar
            else handleSidebarKey state key keyChar
          else
            handleViewKey state key keyChar
