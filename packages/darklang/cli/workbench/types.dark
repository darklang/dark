/// Workbench state, the view registry's shape, and the small helpers everything else leans on.
///
/// Part of `Darklang.Cli.Workbench`, split across files (see app.dark for the overview).
module Darklang.Cli.Workbench


/// The most of the Matter body the tree pane may take, as a percent.
///
/// A ceiling rather than the split itself: `matterSplitFor` narrows it to what the names actually need.
/// A flat 45 gave eight short names 117 columns on a wide terminal while the pane that was clipping got
/// the smaller half.
val matterSplitMaxPct = 45

/// The least of it, so the tree doesn't collapse to nothing in a narrow window.
val matterSplitMinPct = 18

/// One row of a list. `desc` is the dim one-liner after the name - a
/// signature, `= value`, `record · 3 fields`, a timestamp - which is how a
/// row says what it is without an icon. "" for rows that have nothing to add.
type BodyItem =
  { name: String
    kind: String
    isModule: Bool
    desc: String }

/// A search result the user can jump to: the containing module path (owner + modules), the leaf name, its kind,
/// and a pre-formatted display line.
type SearchHit =
  { modules: List<String>
    name: String
    kind: String
    display: String }

/// Which part of the SCM view is showing. Picked in the sidebar.
///
/// These were 0, 1, 2 and 3, compared as numbers in five files with the mapping written down in a comment
/// here. A reader had to hold "2 means conflicts" in their head to follow `if state.scm.section == ScmSection.Conflicts then
/// resolveConflict ...`.
type ScmSection =
  | Changes
  | History
  | Conflicts
  | Branches

type ScmState =
  { section: ScmSection }

/// Which part of the AI view is showing. Picked in the sidebar.
type AiSection =
  | Agents
  | Prompts

type AiState =
  { section: AiSection }

/// What the Matter view is showing: the whole tree, or values only (the Values lens, `L`).
///
/// This was a String compared against "values", which meant every other string was a silently valid state
/// that behaved like "all".
type Lens =
  | WholeTree
  | ValuesOnly
  /// Just what the draft has touched. Like `ValuesOnly` its items are FULL paths rather than leaves,
  /// because what changed is not confined to where you are standing.
  | Changed

type MatterState =
  { lens: Lens }

let emptyScm () : ScmState =
  ScmState { section = ScmSection.Changes }

/// Position in the sidebar's Changes workspace, and the `Dest.section` the
/// sidebar carries for it.
let scmSectionIndex (section: ScmSection) : Int =
  match section with
  | Changes -> 0
  | History -> 1
  | Conflicts -> 2
  | Branches -> 3

/// Convert a sidebar section index to an SCM section.
let scmSectionAt (index: Int) : ScmSection =
  if index == 1 then ScmSection.History
  else if index == 2 then ScmSection.Conflicts
  else if index == 3 then ScmSection.Branches
  else ScmSection.Changes

let emptyAi () : AiState =
  AiState { section = AiSection.Agents }

let aiSectionIndex (section: AiSection) : Int =
  match section with
  | Agents -> 0
  | Prompts -> 1

/// The inverse of `aiSectionIndex` (see `scmSectionAt`).
let aiSectionAt (index: Int) : AiSection =
  if index == 1 then AiSection.Prompts else AiSection.Agents

let emptyMatter () : MatterState =
  MatterState { lens = Lens.WholeTree }

/// The next lens the toggle key moves to. Three of them now, so it cycles rather than flipping.
let otherLens (lens: Lens) : Lens =
  match lens with
  | WholeTree -> Lens.ValuesOnly
  | ValuesOnly -> Lens.Changed
  | Changed -> Lens.WholeTree


/// The search-results mode: a jumpable list of matches, and the cursor into it. Enter navigates to the
/// hit's location. No hits means it isn't open.
type SearchState =
  { hits: List<SearchHit>
    selected: Int }

let emptySearch () : SearchState =
  SearchState { hits = []; selected = 0 }


/// A place the sidebar can open: a view and its section within that view.
/// `section` is meaningful for SCM and AI; it is zero for other views.
type Dest = { view: Int; section: Int }


/// What's drawn over the frame, and holding the keyboard while it is.
///
/// One field avoids representing two overlays as open at once. The sidebar is
/// tracked by `State.focus`, because it is also a permanent column when wide.
type Overlay =
  | NoOverlay
  /// The `?` keymap, drawn centred with its interior cleared. Any key closes it.
  | Keymap


/// The REPL view's state: what's been run, what's bound, and what's half-typed.
type ReplState =
  { /// The eval log, newest last, each entry already rendered (the `> expr` and its result lines).
    log: List<String>
    /// Session bindings, in the order they were first bound. `let x = ...` at the REPL records one, and
    /// every later expression is evaluated with them in scope (see `Darklang.Cli.Repl`). Session-lived:
    /// they go away when the CLI exits.
    bindings: List<Darklang.Cli.Repl.Binding>
    /// The result of the last expression, unstyled - what the session pane shows under "last result".
    /// Held rather than scraped back out of `log`, which is display text.
    last: String
    /// Lines of a multi-line statement typed so far, each ended with a `\`. Empty except while one is being
    /// assembled; the next unbackslashed line completes it and the whole thing runs as one statement.
    pending: String }

let emptyRepl () : ReplState =
  ReplState { log = []; bindings = []; last = ""; pending = "" }


type State =
  { activeView: Int
    location: Packages.PackageLocation
    items: List<BodyItem>
    selected: Int
    /// Which content pane has focus. `Neither` while the sidebar does.
    focus: Stdlib.Cli.UI.SplitPane.Focus
    detailScroll: Int
    /// When Some, a full-body reader is open (e.g. a Docs topic); its text scrolls via detailScroll.
    reading: Stdlib.Option.Option<String>
    /// Whether the open reader's content is Dark code (so it gets syntax-highlighted). False for docs/help/
    /// search/ops which aren't code.
    readingIsCode: Bool
    /// When Some, a single-line text prompt is open (e.g. a commit message).
    input: Stdlib.Option.Option<InputState>
    /// When Some, the multiline editor is open (authoring a fn body).
    editing: Stdlib.Option.Option<EditingState>
    accountId: Stdlib.Option.Option<Uuid>
    accountName: String
    /// This instance's human name for the context line - config `instance.name` if set, else the machine
    /// hostname. Each instance also registers a UUID (`instance.id`) in config on first run.
    instanceName: String
    /// A transient status message (e.g. "committed", "saved foo") shown in the footer after a write action,
    /// then cleared on the next keypress. "" = nothing to show.
    message: String
    /// The search-results mode: open when it has hits, with its own cursor.
    search: SearchState
    /// The overlay drawn over the frame, if any.
    overlay: Overlay
    /// The sidebar cursor, as a position into `sidebarRows`. `focus ==
    /// Neither` means the sidebar owns the keyboard.
    sideSel: Int
    /// The last destination visited in each workspace.
    wsLast: List<(Int * Dest)>
    /// `:` command bar: which completion in the dropdown is highlighted (↑↓ move, tab accepts it). Reset to 0
    /// whenever the text changes.
    completionSel: Int
    /// SCM view: which section is showing. Picked in the sidebar.
    scm: ScmState
    /// AI view: which section is showing. Picked in the sidebar.
    ai: AiState
    /// The gated views (Devices, Crons, Calendar, ...) enabled for this
    /// account, computed once at launch from (see `viewSpecs` /
    /// `gateEnabled`). Hidden gated views drop out of the sidebar.
    enabledGatedViews: List<Int>
    /// Names of items with uncommitted edits, and of deprecated items in the current module.
    ///
    /// Cached rather than read in the renderer. Both are DB reads, the renderer runs on every keypress, and
    /// rendering has to stay a pure function of state for frame diffing to be sound. Refreshed on transitions
    /// by `refreshBadges`.
    wipNames: List<String>
    deprecatedNames: List<String>
    /// The whole SCM picture, read once per transition rather than per surface.
    ///
    /// Home, the tree's badges, the SCM view and the frame's conflict badge all describe these same facts
    /// and each used to read them separately, which is how they could disagree between redraws. Refreshed
    /// by `refreshScmStatus`, whose invalidation rule is deliberately wider than the badges' -- committing,
    /// discarding and pinning all change this without moving you or the item list.
    scmStatus: ScmStatus
    /// The tree-native view peek: the captured output of the selected `render` fn, or "" when the selection
    /// isn't one.
    ///
    /// Cached for the same reason as the badges above, and more urgently: this one runs *user code*, and the
    /// renderer has to stay a pure function of state for frame diffing to be sound. Refreshed on transitions
    /// by `refreshPeek`.
    renderPeek: String
    /// Cached Home commit details as `(hash, lines)`. A seed commit may have
    /// thousands of ops, so `refreshCommitDetail` builds this off-render.
    commitDetail: (String * List<String>)
    /// The REPL view's own state. Everything in here belongs to that one view, so it lives in one field
    /// rather than as four more on the workbench: a view you can hand a record to is a view you could mount
    /// somewhere else, and the parent stops being the place every view keeps its things.
    repl: ReplState
    matter: MatterState
    /// In-view find-as-you-type filter (`f`); "" = no filter. Narrows the current list by substring.
    filter: String
    branchId: Uuid }

/// A single-line text entry. `action` tags what Enter does (e.g. "commit").
type InputState =
  { prompt: String
    /// The text being typed, as a `Stdlib.Cli.UI.TextField`: a cursor you can move, rather than a string you could
    /// only append to and backspace off the end of.
    field: Stdlib.Cli.UI.TextField.State
    action: String }

/// The multiline editor's state: the item kind ("fn"/"type"/"value"), the fully-qualified name being
/// authored, the text buffer, and a last-error line.
type EditingState =
  { kind: String
    nameStr: String
    /// The module (owner.Module...) the item saves into - from the tree location, or asked for when you're too
    /// shallow to have one. Lets you author from anywhere, not just inside a module.
    targetModule: List<String>
    buf: Stdlib.Cli.UI.Editor.Buf
    err: String }

type Step =
  | Continue of State
  | Exit of State
  /// Hand off to a foreground command (e.g. a full-screen app opened from the Apps view). The CLI pushes the
  /// workbench and returns to it when that command's page exits. Carries the workbench State to return to.
  | Launch of State * String
  /// Drop to the classic prompt (`:classic`), pushing the workbench so `quit` there returns here.
  | ToPrompt of State

/// Everything needed to load and render an extension view. Navigation
/// grouping is defined separately by `workspaces`.
type ViewDef =
  { /// Stable slug, independent of its numeric view index.
    id: String
    /// sidebar label
    name: String
    /// "" = always visible; anything else marks the view gated (shown only to `gatedViewAccounts`)
    gateKey: String
    /// the selectable rows (for the shared cursor + list pane); Unit-in since extension views are self-contained
    loadItems: Unit -> List<BodyItem>
    /// the body's spans for the region (returned, not printed, so frames can be diffed)
    render: State -> Stdlib.Cli.UI.Layout.Region -> List<Stdlib.Cli.UI.Layout.Span>
    /// preview/detail lines for the selected row
    detail: State -> List<String>
    /// context key-hints for the footer
    hints: State -> List<(String * String)> }


// ── Stable view indices; built-in labels match Frame.viewNames. ──
val vHome = 0
val vMatter = 1
val vScratch = 3
val vSCM = 4
val vDevices = 5
val vAI = 6
val vApps = 7
val vTraces = 8
val vDocs = 9
// Extension indices are `baseViewCount + position in extensionViews`.
val baseViewCount = 10

/// Built-in view indices and their optional gate keys. Extension views are
/// appended by `viewSpecs`.
// Index 2 remains reserved for the former Inspect view, keeping later indices
// stable without exposing Inspect in the sidebar.
val baseViewSpecs =
  [ (vHome, "")
    (vMatter, "")
    (vScratch, "")
    (vSCM, "")
    (vDevices, "devices.enabled")
    (vAI, "")
    (vApps, "")
    (vTraces, "")
    (vDocs, "") ]

/// Accounts that can see gated workbench views.
val gatedViewAccounts = [ "stachu"; "feriel" ]

/// Does this account see the gated views?
///
/// This was a per-key config lookup, so each gated view could be switched on by name or for everyone. That
/// was machinery ahead of a need: there is exactly one rule today, which is "is this one of the two people
/// building it". A config key can come back when someone actually wants a third answer.
let gateEnabled (accountName: String) : Bool =
  Stdlib.List.member gatedViewAccounts (Stdlib.String.toLowercase accountName)

/// Every view as `(absolute index, label, gate key)`, used for visibility and
/// label lookup. `workspaces` separately defines sidebar placement.
val viewSpecs =
  let base =
    baseViewSpecs
    |> Stdlib.List.map (fun pair ->
      let (i, g) = pair
      (i, Frame.viewName i, g))
  let exts =
    extensionViews ()
    |> Stdlib.List.indexedMap (fun i vd -> (baseViewCount + i, vd.name, vd.gateKey))
  Stdlib.List.append base exts

/// The extension `ViewDef` at an absolute view index (None for a built-in, or out of range).
let extensionViewAt (idx: Int) : Stdlib.Option.Option<ViewDef> =
  if idx < baseViewCount then
    Stdlib.Option.Option.None
  else
    Stdlib.List.getAt (extensionViews ()) (idx - baseViewCount)

/// The display label for any view index.
let viewLabel (idx: Int) : String =
  match extensionViewAt idx with
  | Some vd -> vd.name
  | None -> Frame.viewName idx

/// Which gated views (Devices, Crons, Calendar, ...) this account has switched on.
///
/// Computed at launch (and again after a login change) rather than per frame.
let gatedViewsFor (accountName: String) : List<Int> =
  viewSpecs
  |> Stdlib.List.filter (fun spec ->
    let (_i, _n, g) = spec
    (g != "") && (gateEnabled accountName))
  |> Stdlib.List.map (fun spec ->
    let (i, _n, _g) = spec
    i)


/// Re-read the gates for a running workbench.
let recomputeGatedViews (state: State) : List<Int> =
  gatedViewsFor state.accountName


/// The view indices the sidebar may show, in `viewSpecs` order. A view shows
/// if it isn't gated, or it's gated and enabled for this account (see
/// `enabledGatedViews`, recomputed on launch and after a config change).
let visibleViews (state: State) : List<Int> =
  viewSpecs
  |> Stdlib.List.filter (fun spec ->
    let (i, _n, g) = spec
    (g == "") || (Stdlib.List.member state.enabledGatedViews i))
  |> Stdlib.List.map (fun spec ->
    let (i, _n, _g) = spec
    i)


/// Run `f` with anything it writes to stdout captured, and hand back both its value and that output. The
/// single place `Builtin.stdoutCapture*` is used, so the many "run a command, show its output inside the
/// frame" sites go through one wrapper instead of each touching the builtins directly.
///
/// Capturing is not optional in here. The workbench owns the whole screen, so a stray `printLine` from
/// inside a command scrolls the alternate screen, and every frame after it lands that many rows off - which
/// looks like two overlapping copies of the UI, not like a missing line. `cliEvaluateExpression` prints a
/// three-line call-stack header on any runtime error, so this is reachable by typing a typo at the REPL.
let captureOutputAnd (f: Unit -> 'a) : ('a * String) =
  // `stdoutCaptureStart` returns false when a capture is ALREADY open, and deliberately changes nothing in
  // that case - so we don't own the buffer and must not stop it. Calling stop regardless would hand the
  // outer capture's collected output to the inner caller and clear the flag, so everything the outer one
  // was collecting would print straight onto the alternate screen: exactly the corruption capturing exists
  // to prevent. Nothing nests today, but this is a one-line guard against a hard-to-see failure.
  let owned = Builtin.stdoutCaptureStart ()
  let value = f ()
  if owned then (value, Builtin.stdoutCaptureStop ()) else (value, "")

/// `captureOutputAnd` when only the output matters (running a classic command for its printed result).
let captureOutput (f: Unit -> 'a) : String =
  let (_value, output) = captureOutputAnd f
  output


/// A throwaway classic-CLI AppState carrying just this workbench's identity (branch + account) for handing to
/// the classic command Registry (executeCommand / getCompletions / getCompletionHint). Everything else is the
/// init default; the workbench only ever needs those three fields to run a command on the right branch as you.
let classicState (state: State) : Darklang.Cli.AppState =
  { (Darklang.Cli.initState ()) with
      currentBranchId = state.branchId
      accountID = state.accountId
      accountName = state.accountName }
