/// The item list, and the text behind the detail/preview pane: what a selected thing is, what it
/// depends on, what its source looks like. Strings in, strings out; no regions.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench


/// Render Tree items as aligned name/description rows with selection state,
/// WIP and deprecation badges, and a scrollable viewport.
let renderTreeList (state: State) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  if Stdlib.List.isEmpty state.items then
    Stdlib.Cli.UI.Layout.at region 1 2 (Stdlib.Cli.UI.Colors.dimText "(no items here)")
  else
    let modPath = modulePathOf state.location
    let wipNames = state.wipNames
    let deprecatedNames = state.deprecatedNames
    let focused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.First
    // Changes rows (and the Changed lens) lead with a glyph for what the row is.
    let iconed = (state.activeView == vSCM) || ((state.activeView == vMatter) && (state.matter.lens == Lens.Changed))
    let displayOf (item: BodyItem) : String =
      if item.isModule then item.name ++ "/"
      else if iconed then (changeIcon item.kind) ++ " " ++ item.name
      else item.name
    // The description column: after the longest name, capped so one long name
    // doesn't push every description off the pane - a name longer than the
    // cap is clipped with an ellipsis instead, so the column stays straight.
    // Only when something has a description at all.
    let anyDesc = state.items |> Stdlib.List.any (fun it -> it.desc != "")
    let nameCap =
      if state.activeView == vHome then
        Stdlib.Int.max 16 (Stdlib.Int.divide (region.cols * 2) 3)
      else 36
    let nameCol =
      if Stdlib.Bool.not anyDesc then 0
      else
        state.items
        |> Stdlib.List.filter (fun it -> Stdlib.Bool.not (isSectionHeader it))
        |> Stdlib.List.map (fun it -> Stdlib.String.displayWidth (displayOf it))
        |> Stdlib.List.fold 0 (fun acc n -> Stdlib.Int.max acc n)
        |> Stdlib.Int.min nameCap
    let fitName (s: String) : String =
      if (Stdlib.String.displayWidth s) <= nameCap then s
      else (Stdlib.Cli.Tui.Text.clipToWidth s (nameCap - 1)) ++ "…"
    // Hoisted: both were being asked once per item. `isEmpty` is a package call, and a `member`
    // against an empty list still costs a call and the `isSome` inside it, so the guard is worth
    // having on both -- `isWip` had one and `isDeprecated` did not.
    let anyWip = Stdlib.Bool.not (Stdlib.List.isEmpty wipNames)
    let anyDeprecated = Stdlib.Bool.not (Stdlib.List.isEmpty deprecatedNames)

    let lines =
      state.items
      |> Stdlib.List.indexedMap (fun i item ->
        let display = if item.desc == "" then displayOf item else fitName (displayOf item)
        let fullName = Stdlib.String.join (Stdlib.List.append modPath [ item.name ]) "."
        let isWip = anyWip && (Stdlib.List.member wipNames fullName)
        // A module is uncommitted work's when something under it is: the draft names are full
        // paths, so "under" is a prefix test.
        let holdsWip =
          item.isModule && anyWip
          && (wipNames |> Stdlib.List.any (fun n -> Stdlib.String.startsWith n (fullName ++ ".")))
        let isDeprecated = anyDeprecated && (Stdlib.List.member deprecatedNames item.name)
        let badges =
          (if isWip then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.pink " ●" else "")
          ++ (if isDeprecated then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow " ⚠" else "")
        let gap =
          if item.desc == "" then ""
          else Stdlib.String.repeat " " (Stdlib.Int.max 2 (nameCol + 2 - (Stdlib.String.displayWidth display)))
        // A description that arrives coloured (a change kind, a diff stat) keeps its colours; a
        // plain one is dim.
        let descStyled =
          if item.desc == "" then ""
          else if Stdlib.String.contains item.desc "\u001b" then item.desc
          else Stdlib.Cli.UI.Colors.dimText item.desc
        let rest = gap ++ descStyled ++ badges
        if isSectionHeader item then
          // A section label (or a blank spacer), not a row: dim, and never
          // the cursor (see `selectableRow`).
          if item.name == "" then "" else "  " ++ (Stdlib.Cli.UI.Colors.dimText item.name)
        else if i == state.selected then
          selectionBar display rest focused
        else
          // A module holding uncommitted work is grayed rather than bold: not yet part of what
          // everyone else sees, and the leaf dots inside say exactly what.
          let name =
            if holdsWip then Stdlib.Cli.UI.Colors.grayText display
            else if item.isModule then Stdlib.Cli.UI.Colors.boldText display
            else display
          "  " ++ name ++ rest)
    Stdlib.Cli.UI.ListView.render region lines state.selected

/// A fn's requirements badge, coloured by what granting it means: nothing
/// (green), scoped effects a rule can name (cyan), and the ones a policy can
/// only hand over whole -- native, process -- in orange. The callback caveat
/// is a caveat, so it stays dim.
let effectsText (effects: String) : String =
  let paint (part: String) : String =
    if part == "effect-free" then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green part
    else if (part == "native") || (part == "process") then
      Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.orange part
    else if Stdlib.String.contains part "callbacks" then Stdlib.Cli.UI.Colors.dimText part
    else Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan part
  let parts = Stdlib.String.split effects ", " |> Stdlib.List.map paint
  Stdlib.String.join parts (Stdlib.Cli.UI.Colors.dimText ", ")

/// `effectsText` in brackets, for a row description beside a signature.
let effectsBadge (effects: String) : String =
  (Stdlib.Cli.UI.Colors.dimText "[") ++ (effectsText effects) ++ (Stdlib.Cli.UI.Colors.dimText "]")

/// A section heading on the item page: one word, bold cyan, no rules. Cyan
/// so it cannot be mistaken for the frame's purple focus title.
let sectionHeading (label: String) : String =
  Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.bold ++ Stdlib.Cli.UI.Colors.cyan) label

/// A `label   value` row under a section heading: the label dim in a fixed
/// column, the value as it came.
let factRow (label: String) (value: String) : String =
  "  " ++ (Stdlib.Cli.UI.Colors.dimText (Stdlib.String.padEndToWidth label 11)) ++ value

/// A dim note under a fact row, aligned with its value.
let factNote (note: String) : String =
  "  " ++ (Stdlib.String.repeat " " 11) ++ (Stdlib.Cli.UI.Colors.dimText note)

/// The essentials of a fn's authority, for a detail pane: what it needs, the
/// ceiling its author set (and whether the body exceeds it), and whether this
/// account has approved it. `permissions show` prints the whole layered
/// report; the version is already on the meta strip, the instance policy is
/// the same for every fn on the machine, and the closing lines about run
/// policy and call-time resource checks describe the runtime rather than
/// this fn, so none of that earns a line here.
/// The line the access block opens with; `inspectPageLines` splits on it.
val accessHeading = sectionHeading "access"

let accessSummaryLines (state: State) (hash: String) : List<String> =
  let facts = Permissions.Command.accessFacts state.accountId hash
  let requires =
    Stdlib.List.flatten
      [ [ factRow "requires" (effectsText (Permissions.Command.describeRequirements (facts.effects, facts.complete))) ]
        (if facts.complete then [] else [ factNote "incomplete · it runs code it is given" ]) ]
  let ceiling =
    match facts.ceiling with
    | None -> []
    | Some names ->
      let exceeding =
        facts.effects |> Stdlib.List.filter (fun e -> Stdlib.Bool.not (Stdlib.List.``member`` names e))
      let warning =
        if facts.complete && (Stdlib.Bool.not (Stdlib.List.isEmpty exceeding)) then
          [ factNote
              ("⚠ narrower than the body needs: "
               ++ (Stdlib.String.join (exceeding |> Stdlib.List.map LanguageTools.Permissions.effectName) ", ")
               ++ " denied at runtime") ]
        else []
      Stdlib.List.append
        [ factRow "ceiling" (LanguageTools.Permissions.ceilingRow (Stdlib.Option.Option.Some names)) ]
        warning
  let approval =
    if facts.bundled then
      [ factRow "approval" ((Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green "none needed") ++ (Stdlib.Cli.UI.Colors.dimText " · bundled Darklang code")) ]
    else if Stdlib.Bool.not (Stdlib.List.isEmpty facts.approvedAs) then
      [ factRow "approval" (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green ("approved as " ++ (Stdlib.String.join facts.approvedAs ", "))) ]
    else
      match facts.packagePolicy with
      | Some _ -> [ factRow "approval" (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.green "approved for this account") ]
      | None ->
        [ factRow "approval" (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow "not approved")
          factNote "blocked as a dependency · runs as an entry point" ]
  Stdlib.List.flatten [ [ accessHeading ], requires, ceiling, approval ]

/// The selected module's immediate children for the Inspect pane. This is a
/// preview of the next Tree level, not a recursive package listing.
///
/// Grouped by kind under a dim label with a count, names in a column, and the
/// description coloured by what it is: a type's shape or alias target, a
/// value's literal, a fn's signature with its requirements badge. One flat
/// run of 25 `name  desc` rows read as a dump; the kinds are how a person
/// scans a module, so they are how it is laid out.
let modulePreviewLines (state: State) (item: BodyItem) : List<String> =
  let path = Stdlib.List.append (modulePathOf state.location) [ item.name ]
  let location = Packages.PackageLocation.Module path
  let children = moduleContents state.branchId location
  let ofKind (kind: String) : List<BodyItem> =
    children |> Stdlib.List.filter (fun c -> c.kind == kind)
  // One column across every group, so a value's literal and a fn's signature
  // start at the same place.
  let nameCol =
    children
    |> Stdlib.List.map (fun c -> Stdlib.String.displayWidth (if c.isModule then c.name ++ "/" else c.name))
    |> Stdlib.List.fold 0 (fun acc n -> Stdlib.Int.max acc n)
    |> Stdlib.Int.min 28
  let fnDesc (desc: String) : String =
    // `moduleContents` spells a fn as `sig  [effects]`; paint the two halves apart.
    match Stdlib.String.lastIndexOf desc "  [" with
    | Some i ->
      let sig_ = Stdlib.String.slice desc 0 i
      let effects = Stdlib.String.slice desc (i + 3) ((Stdlib.String.length desc) - 1)
      (Stdlib.Cli.UI.Colors.dimText sig_) ++ "  " ++ (effectsBadge effects)
    | None -> Stdlib.Cli.UI.Colors.dimText desc
  let childLine (child: BodyItem) : String =
    let display = if child.isModule then child.name ++ "/" else child.name
    let padded = Stdlib.String.padEndToWidth display (nameCol + 2)
    let name =
      if child.isModule then Stdlib.Cli.UI.Colors.boldText padded
      else if child.kind == "type" then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan padded
      else if child.kind == "val" then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.purple padded
      else padded
    let desc =
      if child.desc == "" then ""
      else if child.kind == "fn" then fnDesc child.desc
      else if child.kind == "type" then Stdlib.Cli.UI.Colors.dimText child.desc
      else Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow child.desc
    "    " ++ name ++ desc
  let group (label: String) (rows: List<BodyItem>) : List<String> =
    if Stdlib.List.isEmpty rows then []
    else
      Stdlib.List.flatten
        [ [ "  " ++ (Stdlib.Cli.UI.Colors.dimText (label ++ " · " ++ (Stdlib.Int.toString (Stdlib.List.length rows)))) ]
          Stdlib.List.map rows childLine
          [ "" ] ]
  let contents =
    if Stdlib.List.isEmpty children then
      [ Stdlib.Cli.UI.Colors.dimText "  (empty module)", "" ]
    else
      Stdlib.List.flatten
        [ group "modules" (ofKind "module")
          group "types" (ofKind "type")
          group "values" (ofKind "val")
          group "functions" (ofKind "fn") ]
  Stdlib.List.flatten
    [ [ Stdlib.Cli.UI.Colors.boldText (item.name ++ "/")
        Stdlib.Cli.UI.Colors.dimText (plural (Stdlib.List.length children) "item")
        "" ]
      contents
      [ Stdlib.Cli.UI.Colors.dimText "⏎ enter" ] ]

/// The source/detail of the currently-selected item, as lines for the Inspect pane.
let detailLines (state: State) : List<String> =
  // The flat lenses carry FULL paths (owner.mod.name), so they look up by full path rather than
  // leaf-in-location the way the tree does. Values renders one kind; Changed renders whichever kind the
  // draft touched, which is why they don't share a function.
  if (state.activeView == vMatter) && (state.matter.lens == Lens.ValuesOnly) then
    Stdlib.String.split (thingDetail state) "\n"
  else if (state.activeView == vMatter) && (state.matter.lens == Lens.Changed) then
    Stdlib.String.split (changesSourceText state.branchId (Stdlib.List.getAt state.items state.selected)) "\n"
  else
  match Stdlib.List.getAt state.items state.selected with
  | None -> [ "(nothing selected)" ]
  | Some item ->
    if item.isModule then
      modulePreviewLines state item
    else if (state.activeView == vMatter) && item.kind == "fn" && item.name == "render" then
      // Tree-native view peek: a `render` fn shows its rendered frame instead of source,
      // just by cursoring onto it. The evaluation is `refreshPeek`'s, on the state
      // transition -- never here: frame diffing is only sound if rendering is a pure
      // function of state. This `vMatter` test must match the one `refreshPeek` applies,
      // or this branch reads an unpopulated `renderPeek` and reports "no output".
      if (Stdlib.String.trim state.renderPeek) == "" then [ Stdlib.Cli.UI.Colors.dimText "(view produced no output)" ]
      else Stdlib.String.split state.renderPeek "\n"
    else
      let modulePath = modulePathOf state.location
      let results = Packages.Query.searchExactMatch state.branchId modulePath item.name
      // Anchored at the module being browsed, so the Inspect pane spells references the way someone
      // standing in that module would. `modulePath` is owner-first, which is what `forModule` wants.
      //
      // And laid out for the pane it is going into, rather than for the printers' default 80. Reading
      // the pane width is the caller's job -- the printer can't, by design -- so it happens here.
      // Wrapping in `renderScrollableLines` stays as the floor under a line no layout could shorten.
      let ctx =
        { PrettyPrinter.ProgramTypes.Context.forModule state.branchId modulePath with
            width = previewInnerWidth state }

      let (src, accessReport) =
        match item.kind with
        | "fn" ->
          match results.fns with
          | i :: _ ->
            (PrettyPrinter.ProgramTypes.packageFn ctx i.entity,
             accessSummaryLines state (LanguageTools.ProgramTypes.hashToString i.entity.hash))
          | [] -> ("(not found)", [])
        | "type" ->
          match results.types with
          | i :: _ -> (PrettyPrinter.ProgramTypes.packageType ctx i.entity, [])
          | [] -> ("(not found)", [])
        | "trait" ->
          match results.traits with
          | i :: _ -> (PrettyPrinter.ProgramTypes.packageTrait ctx i.entity, [])
          | [] -> ("(not found)", [])
        | "impl" ->
          match results.impls with
          | i :: _ -> (PrettyPrinter.ProgramTypes.packageImpl ctx i.entity, [])
          | [] -> ("(not found)", [])
        | _ ->
          match results.values with
          | i :: _ -> (PrettyPrinter.ProgramTypes.packageValue ctx i.entity, [])
          | [] -> ("(not found)", [])
      let sourceLines = Stdlib.String.split src "\n"
      match accessReport with
      | [] -> sourceLines
      | report -> Stdlib.List.flatten [ sourceLines, [ "" ], report ]

/// The Docs topic the cursor is on, resolved by name rather than by position.
///
/// The row list is filterable (`f`), so `selected` indexes the FILTERED items and not `allTopics`. Indexing
/// straight into `allTopics` meant a narrowed Docs list previewed and opened whatever topic happened to sit at
/// that position in the full list: filter to `terminal-ui`, get `for-ai`.
let selectedDocTopic (state: State) : Stdlib.Option.Option<Docs.Command.Topics.DocTopic> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> Stdlib.Option.Option.None
  | Some item ->
    // Rows read "<name>  ·  <description>"; the name is what identifies the topic.
    let leaf =
      Stdlib.String.split item.name "  ·  "
      |> Stdlib.List.head
      |> Stdlib.Option.withDefault item.name
    Docs.Command.Topics.allTopics ()
    |> Stdlib.List.findFirst (fun t -> t.name == leaf)

/// The Docs topic content for the selected row.
let docContent (state: State) : String =
  match selectedDocTopic state with
  | Some t -> t.content ()
  | None -> "(no topic selected)"

/// A recorded divergence's detail for the Conflicts preview. It resolves by
/// location because the section is filterable, like `selectedBranch`.
let conflictDetail (state: State) : String =
  match selectedConflict state with
  | Some c ->
    // A conflict holds its competing versions in `candidates`, with the fold's pick named separately by
    // hash -- not as flat local/incoming/chosen fields. A field that isn't there is a runtime error, and
    // this pane only draws once a conflict exists, so getting the shape wrong here is invisible on an
    // empty store.
    let dotted = SCM.Conflicts.fqn c.owner c.modules c.name

    // "ours"/"theirs", matching the footer's `o ours · t theirs` keys: two vocabularies for the
    // same two sides on one screen made the o/t choice a translation exercise. Relative times,
    // like every other pane.
    let sides =
      c.candidates
      |> Stdlib.List.map (fun cand ->
        let mark = if cand.hash == c.autoResolvedTo then "kept" else "other"

        let who =
          if cand.side == "local" then "ours"
          else if cand.author == "" then "theirs"
          else $"theirs ({cand.author})"

        $"  {mark}   {who}  {SCM.Conflicts.shortHash cand.hash}  {agoText cand.originTs}")
      |> Stdlib.String.join "\n"

    // The reason, as a sentence rather than the fold's internal token.
    let whyText =
      match c.reason with
      | "later-origin-ts" -> "both sides changed it; the newer edit was kept"
      | "tie-break-by-hash" -> "both sides changed it at the same stamp; the tie broke deterministically"
      | other -> other

    let why = if c.reason == "" then "" else $"\nwhy:        {whyText}"

    let by =
      if c.resolvedBy == "" then
        ""
      else
        $"\nresolved by: {c.resolvedBy}"

    $"name:       {dotted}\nkind:       {c.itemType}\nstatus:     {c.status}{why}{by}\n\nversions:\n{sides}"
  | None -> "(no conflict selected)"

/// The selected app's detail (name/description + lifecycle hints). Placeholder actions for now.
let appDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    item.name
    ++ "\n\n"
    ++ "⏎ inspect    i install/uninstall    r start    s stop\n\n"
    ++ "(each runs the matching `apps` subcommand in-frame - output opens in the reader)"
  | None -> "(no app selected)"

/// The selected trace's detail. Placeholder - the walkable trace tree + live values come later.
let traceDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    // The list is real whenever anything has been recorded (see `loadTraceBodyItems`); only the fallback
    // rows are invented. Saying "mock data" over a run that genuinely happened undersells what works.
    let provenance =
      if item.kind == "trace-sample" then
        Stdlib.Cli.UI.Colors.dimText "(mock data) - nothing recorded in this environment yet"
      else
        Stdlib.Cli.UI.Colors.dimText "this run is real; what it recorded is not stored yet"
    (Stdlib.Cli.UI.Colors.boldText item.name)
    ++ "\n\n"
    ++ provenance
    ++ "\n\n"
    ++ "A real trace carries the inputs, the return value, and the value\n"
    ++ "that flowed through every sub-expression. From here you'll:\n\n"
    ++ "  r  replay this run\n"
    ++ "  t  turn it into a test\n"
    ++ "  j  jump to the source of a value\n"
    ++ "  ⏎  walk the trace tree"
  | None -> "(no trace recorded yet - eval something or run an app)"

/// The item page's first line: the kind with its glyph, the short content
/// hash, and a deprecation mark only when it is deprecated. Nothing that is
/// true of every item earns a word here.
let itemMeta (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> ""
  | Some item ->
    if item.isModule then ""
    else
      let modulePath = modulePathOf state.location
      let results = Packages.Query.searchExactMatch state.branchId modulePath item.name
      let hashOpt =
        if item.kind == "fn" then results.fns |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else if item.kind == "type" then results.types |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else if item.kind == "trait" then results.traits |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else if item.kind == "impl" then results.impls |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else results.values |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
      let short =
        match hashOpt with
        | Some h -> LanguageTools.ProgramTypes.hashToShort h
        | None -> "?"
      let kindLabel =
        if item.kind == "fn" then "fn"
        else if item.kind == "type" then "type"
        else if item.kind == "trait" then "trait"
        else if item.kind == "impl" then "impl"
        else "value"
      // Real deprecation status (same read path as the tree badge).
      let deprecation =
        match hashOpt with
        | Some h ->
          let sets = Packages.Query.loadDeprecationSets state.branchId
          if Packages.Query.isDeprecated sets h then
            "  " ++ (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow "⚠ deprecated")
          else ""
        | None -> ""
      (Stdlib.Cli.UI.Colors.dimText ((changeIcon kindLabel) ++ " " ++ kindLabel ++ " · " ++ short)) ++ deprecation

/// The runs that called the selected fn, for the `x` reader: one row per
/// trace, newest first, or a line saying nothing has called it yet and how to
/// change that.
let tracesText (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> "(nothing selected)"
  | Some item ->
    let fullName = Stdlib.String.join (Stdlib.List.append (modulePathOf state.location) [ item.name ]) "."
    let rows =
      Darklang.Tracing.Store.listByFn fullName 30
      |> Stdlib.List.map (fun t -> "  " ++ t.handler ++ "  ·  " ++ t.timestamp)
    // Empty means one of two things, and `traces list` already knows which:
    // nothing has called it, or recording is off (the default) so nothing
    // would show whatever ran. Say the same thing it says.
    let body =
      if Stdlib.List.isEmpty rows then
        [ Stdlib.Cli.UI.Colors.dimText "  no recorded calls", Stdlib.Cli.UI.Colors.dimText ("  " ++ (Darklang.Cli.Tracing.emptyStateHint ())) ]
      else
        rows
    Stdlib.String.join
      (Stdlib.List.flatten
        [ [ Stdlib.Cli.UI.Colors.boldText ("Traces calling " ++ fullName), "" ]
          body
          [ "", Stdlib.Cli.UI.Colors.dimText "  6 › Traces lists every run" ] ])
      "\n"

let inspectPageLines (state: State) : List<String> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> [ Stdlib.Cli.UI.Colors.dimText "(nothing selected - browse the tree)" ]
  | Some item ->
    if item.isModule then
      modulePreviewLines state item
    else
      // Highlight only the source portion (the page mixes code with colored ref/meta
      // lines, so renderPreview can't blanket-highlight). Guard on line count:
      // highlighting re-lexes the text, and a changed line count would land colors on
      // the wrong rows -- fall back to plain source, and say so rather than silently
      // losing highlighting.
      //
      // `detailLines` is the source followed, for a fn, by the access block, which is already
      // coloured. Re-lexing a coloured line strips its escapes down to literal `[36m`, so the
      // block is split off at its heading and only the source above it is highlighted.
      let page = detailLines state
      let srcCount =
        Stdlib.List.findFirstIndex page (fun l -> l == accessHeading)
        |> Stdlib.Option.withDefault (Stdlib.List.length page)
      let srcPlain = Stdlib.List.take page srcCount
      let access = Stdlib.List.drop page srcCount
      let src =
        let h =
          SyntaxHighlighting.highlightCode (Stdlib.String.join srcPlain "\n") |> Stdlib.String.split "\n"
        let highlighted =
          if Stdlib.List.length h == Stdlib.List.length srcPlain then
            h
          else
            Stdlib.List.append
              srcPlain
              [ Stdlib.Cli.UI.Colors.warning
                  $"(syntax highlighting off: re-lexing produced {Stdlib.Int.toString (Stdlib.List.length h)} lines, source has {Stdlib.Int.toString (Stdlib.List.length srcPlain)})" ]
        Stdlib.List.append highlighted access
      // The order a reader wants: what this is, the code, what running it needs, who it touches.
      // The keys that act on it are in the footer, so they are not repeated here.
      let refs = Stdlib.String.split (depsText state) "\n"
      Stdlib.List.flatten
        [ [ itemMeta state, "" ]
          src
          [ "" ]
          refs ]

/// The preview content for the selected item in the current view. One function so the preview pane, its
/// scroll bounds, and the full-screen reader all agree. SCM previews depend on the active section.
let previewLines (state: State) : List<String> =
  if state.activeView == vHome then []
  else if state.activeView == vSCM then
    match Stdlib.List.getAt state.items state.selected with
    | Some it ->
      if it.kind == "conflict" then Stdlib.String.split (conflictDetail state) "\n"
      else if it.kind == "removed" then
        [ Stdlib.Cli.UI.Colors.dimText "removed on this branch; the last commit still holds the previous version" ]
      else changedItemDetail state
    | None -> changedItemDetail state
  else if state.activeView == vMatter then
    // Matter folds in the old Inspect: its preview IS the item page (source + meta + references + actions).
    // The flat lenses are the exception: their items are full paths, and the item page resolves a leaf
    // against where you're standing, so it would report every one of them as missing.
    if (state.matter.lens == Lens.ValuesOnly) || (state.matter.lens == Lens.Changed) then
      detailLines state
    else
      inspectPageLines state
  else if state.activeView == vAI then
    if state.ai.section == AiSection.Prompts then Stdlib.String.split (promptDetail state.selected) "\n"
    else Stdlib.String.split (aiThreadDetail state.selected) "\n"
  else if state.activeView == vApps then Stdlib.String.split (appDetail state) "\n"
  else if state.activeView == vTraces then Stdlib.String.split (traceDetail state) "\n"
  else if state.activeView == vDocs then Stdlib.String.split (docContent state) "\n"
  else
    // Extension views supply their own detail; built-ins fall through to the generic item detail.
    match extensionViewAt state.activeView with
    | Some vd ->
      let d = vd.detail
      d state
    | None -> detailLines state
