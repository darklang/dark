/// The item list, and the text behind the detail/preview pane: what a selected thing is, what it
/// depends on, what its source looks like. Strings in, strings out; no regions.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench


/// Render Tree items as aligned name/description rows with selection state,
/// WIP and deprecation badges, and a scrollable viewport.
let renderTreeList (state: State) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  if Stdlib.List.isEmpty state.items then
    Stdlib.Cli.UI.Layout.at region 1 2 (Stdlib.Cli.UI.Colors.dimText "(no items here)")
  else
    let modPath = modulePathOf state.location
    let wipNames = state.wipNames
    let deprecatedNames = state.deprecatedNames
    let focused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.First
    let displayOf (item: BodyItem) : String = if item.isModule then item.name ++ "/" else item.name
    // The description column: after the longest name, capped so one long name
    // doesn't push every description off the pane - a name longer than the
    // cap is clipped with an ellipsis instead, so the column stays straight.
    // Only when something has a description at all.
    let anyDesc = state.items |> Stdlib.List.any (fun it -> it.desc != "")
    let nameCap = 36
    let nameCol =
      if Stdlib.Bool.not anyDesc then 0
      else
        state.items
        |> Stdlib.List.filter (fun it -> Stdlib.Bool.not (isHomeHeader it))
        |> Stdlib.List.map (fun it -> Stdlib.String.displayWidth (displayOf it))
        |> Stdlib.List.fold 0 (fun acc n -> Stdlib.Int.max acc n)
        |> Stdlib.Int.min nameCap
    let fitName (s: String) : String =
      if (Stdlib.String.displayWidth s) <= nameCap then s
      else (Stdlib.Cli.Tui.Text.clipToWidth s (nameCap - 1)) ++ "…"
    // Hoisted: both were being asked once per item. `isEmpty` is a package call, and a `member`
    // against an empty list still costs a call and the `isSome` inside it, so the guard is worth
    // having on both -- `isWip` had one and `isDeprecated` did not.
    let anyWip = Stdlib.Bool.not (Stdlib.List.isEmpty wipNames)
    let anyDeprecated = Stdlib.Bool.not (Stdlib.List.isEmpty deprecatedNames)

    let lines =
      state.items
      |> Stdlib.List.indexedMap (fun i item ->
        let display = if item.desc == "" then displayOf item else fitName (displayOf item)
        let fullName = Stdlib.String.join (Stdlib.List.append modPath [ item.name ]) "."
        let isWip = anyWip && (Stdlib.List.member wipNames fullName)
        let isDeprecated = anyDeprecated && (Stdlib.List.member deprecatedNames item.name)
        let badges =
          (if isWip then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.pink " ●" else "")
          ++ (if isDeprecated then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow " ⚠" else "")
        let gap =
          if item.desc == "" then ""
          else Stdlib.String.repeat " " (Stdlib.Int.max 2 (nameCol + 2 - (Stdlib.String.displayWidth display)))
        let rest = gap ++ (if item.desc == "" then "" else Stdlib.Cli.UI.Colors.dimText item.desc) ++ badges
        if isHomeHeader item then
          // A section label (or a blank spacer), not a row: dim, and never
          // the cursor (see `homeSelectable`).
          if item.name == "" then "" else "  " ++ (Stdlib.Cli.UI.Colors.dimText item.name)
        else if i == state.selected then
          selectionBar display rest focused
        else
          let name = if item.isModule then Stdlib.Cli.UI.Colors.boldText display else display
          "  " ++ name ++ rest)
    Stdlib.Cli.UI.ListView.render region lines state.selected

/// The selected module's immediate children for the Inspect pane. This is a
/// preview of the next Tree level, not a recursive package listing.
let modulePreviewLines (state: State) (item: BodyItem) : List<String> =
  let path = Stdlib.List.append (modulePathOf state.location) [ item.name ]
  let location = Packages.PackageLocation.Module path
  let children = loadItems state.branchId location
  let childLine (child: BodyItem) : String =
    let display = if child.isModule then child.name ++ "/" else child.name
    let name = if child.isModule then Stdlib.Cli.UI.Colors.boldText display else display
    let desc =
      if child.desc == "" then ""
      else "  " ++ (Stdlib.Cli.UI.Colors.dimText child.desc)
    "  " ++ name ++ desc
  let contents =
    if Stdlib.List.isEmpty children then
      [ Stdlib.Cli.UI.Colors.dimText "  (empty module)" ]
    else
      Stdlib.List.map children childLine
  Stdlib.List.flatten
    [ [ Stdlib.Cli.UI.Colors.boldText (item.name ++ "/")
        Stdlib.Cli.UI.Colors.dimText (plural (Stdlib.List.length children) "item")
        "" ]
      contents
      [ "", Stdlib.Cli.UI.Colors.dimText "⏎ enter" ] ]

/// The source/detail of the currently-selected item, as lines for the Inspect pane.
let detailLines (state: State) : List<String> =
  // Values lens: items carry full paths (owner.mod.name), so look them up by full path, not leaf-in-location.
  if (state.activeView == vMatter) && (state.matter.lens == Lens.ValuesOnly) then
    Stdlib.String.split (thingDetail state) "\n"
  else
  match Stdlib.List.getAt state.items state.selected with
  | None -> [ "(nothing selected)" ]
  | Some item ->
    if item.isModule then
      modulePreviewLines state item
    else if (state.activeView == vMatter) && item.kind == "fn" && item.name == "render" then
      // Tree-native view peek: a `render` fn lights up its output right here - show the rendered frame instead
      // of source. Any view value in the Matter tree previews just by cursoring onto it.
      //
      // The evaluation itself is `refreshPeek`'s, on the state transition. It used to happen here, which put
      // user code inside the render path - the one thing everything else in this file is careful not to do,
      // since frame diffing is only sound if rendering is a pure function of state.
      //
      // The `vMatter` test has to match the one `refreshPeek` applies, or this branch reads a `renderPeek` that
      // was never populated and reports "no output" for something that renders fine.
      if (Stdlib.String.trim state.renderPeek) == "" then [ Stdlib.Cli.UI.Colors.dimText "(view produced no output)" ]
      else Stdlib.String.split state.renderPeek "\n"
    else
      let modulePath = modulePathOf state.location
      let results = Packages.Query.searchExactMatch state.branchId modulePath item.name
      // Anchored at the module being browsed, so the Inspect pane spells references the way someone
      // standing in that module would. `modulePath` is owner-first, which is what `forModule` wants.
      //
      // And laid out for the pane it is going into, rather than for the printers' default 80. Reading
      // the pane width is the caller's job -- the printer can't, by design -- so it happens here.
      // Wrapping in `renderScrollableLines` stays as the floor under a line no layout could shorten.
      let ctx =
        { PrettyPrinter.ProgramTypes.Context.forModule state.branchId modulePath with
            width = previewInnerWidth state }
      let src =
        match item.kind with
        | "fn" ->
          match results.fns with
          | i :: _ -> PrettyPrinter.ProgramTypes.packageFn ctx i.entity
          | [] -> "(not found)"
        | "type" ->
          match results.types with
          | i :: _ -> PrettyPrinter.ProgramTypes.packageType ctx i.entity
          | [] -> "(not found)"
        | _ ->
          match results.values with
          | i :: _ -> PrettyPrinter.ProgramTypes.packageValue ctx i.entity
          | [] -> "(not found)"
      Stdlib.String.split src "\n"

/// The Docs topic the cursor is on, resolved by name rather than by position.
///
/// The row list is filterable (`f`), so `selected` indexes the FILTERED items and not `allTopics`. Indexing
/// straight into `allTopics` meant a narrowed Docs list previewed and opened whatever topic happened to sit at
/// that position in the full list: filter to `terminal-ui`, get `for-ai`.
let selectedDocTopic (state: State) : Stdlib.Option.Option<Docs.Command.Topics.DocTopic> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> Stdlib.Option.Option.None
  | Some item ->
    // Rows read "<name>  ·  <description>"; the name is what identifies the topic.
    let leaf =
      Stdlib.String.split item.name "  ·  "
      |> Stdlib.List.head
      |> Stdlib.Option.withDefault item.name
    Docs.Command.Topics.allTopics ()
    |> Stdlib.List.findFirst (fun t -> t.name == leaf)

/// The Docs topic content for the selected row.
let docContent (state: State) : String =
  match selectedDocTopic state with
  | Some t -> t.content ()
  | None -> "(no topic selected)"

/// A recorded divergence's detail for the Conflicts preview. It resolves by
/// location because the section is filterable, like `selectedBranch`.
let conflictDetail (state: State) : String =
  match selectedConflict state with
  | Some c ->
    "location:    " ++ c.location ++ "\n"
    ++ "kind:        " ++ c.itemKind ++ "\n"
    ++ "status:      " ++ c.status ++ "\n\n"
    ++ "local:       " ++ c.localHash ++ "\n"
    ++ "incoming:    " ++ c.incomingHash ++ "\n"
    ++ "chosen:      " ++ c.chosenHash ++ "\n"
    ++ "resolved by: " ++ c.resolvedBy
  | None -> "(no conflict selected)"

/// The selected app's detail (name/description + lifecycle hints). Placeholder actions for now.
let appDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    item.name
    ++ "\n\n"
    ++ "⏎ inspect    i install/uninstall    r start    s stop\n\n"
    ++ "(each runs the matching `apps` subcommand in-frame - output opens in the reader)"
  | None -> "(no app selected)"

/// The selected trace's detail. Placeholder - the walkable trace tree + live values come later.
let traceDetail (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    // The list is real whenever anything has been recorded (see `loadTraceBodyItems`); only the fallback
    // rows are invented. Saying "mock data" over a run that genuinely happened undersells what works.
    let provenance =
      if item.kind == "trace-sample" then
        Stdlib.Cli.UI.Colors.dimText "(mock data) - nothing recorded in this environment yet"
      else
        Stdlib.Cli.UI.Colors.dimText "this run is real; what it recorded is not stored yet"
    (Stdlib.Cli.UI.Colors.boldText item.name)
    ++ "\n\n"
    ++ provenance
    ++ "\n\n"
    ++ "A real trace carries the inputs, the return value, and the value\n"
    ++ "that flowed through every sub-expression. From here you'll:\n\n"
    ++ "  r  replay this run\n"
    ++ "  t  turn it into a test\n"
    ++ "  j  jump to the source of a value\n"
    ++ "  ⏎  walk the trace tree"
  | None -> "(no trace recorded yet - eval something or run an app)"

/// A one-line metadata strip for the Inspect item page: kind, short content hash (real, content-addressed),
/// and a stability marker (placeholder until deprecation metadata is surfaced).
let itemMeta (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> ""
  | Some item ->
    if item.isModule then ""
    else
      let modulePath = modulePathOf state.location
      let results = Packages.Query.searchExactMatch state.branchId modulePath item.name
      let hashOpt =
        if item.kind == "fn" then results.fns |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else if item.kind == "type" then results.types |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
        else results.values |> Stdlib.List.head |> Stdlib.Option.map (fun i -> i.entity.hash)
      let short =
        match hashOpt with
        | Some h -> LanguageTools.ProgramTypes.hashToShort h
        | None -> "?"
      let kindLabel = if item.kind == "fn" then "fn" else if item.kind == "type" then "type" else "value"
      // Real deprecation status (same read path as the tree badge), not a placeholder.
      let deprecation =
        match hashOpt with
        | Some h ->
          let sets = Packages.Query.loadDeprecationSets state.branchId
          if Packages.Query.isDeprecated sets h then Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow "deprecated ⚠" else "not deprecated"
        | None -> "not deprecated"
      kindLabel ++ "  ·  hash " ++ short ++ "  ·  current  ·  " ++ deprecation

/// Per-node actions offered on the item page. Only what's wired: every key
/// named here does something, and nothing named here means something else in
/// this view (`t` is new-type, so it isn't "try").
///
/// `d deps` used to lead here. It opened the item's dependencies in the reader, which is the same text
/// this page already prints under `── references ──`, so it was a keystroke to see what was on screen.
let itemActions (item: BodyItem) : List<String> =
  if item.kind == "fn" then [ "", Stdlib.Cli.UI.Colors.dimText "x traces  ·  e edit  ·  r rename" ]
  else [ "", Stdlib.Cli.UI.Colors.dimText "e edit  ·  r rename" ]

/// The runs that called the selected fn, for the `x` reader: one row per
/// trace, newest first, or a line saying nothing has called it yet and how to
/// change that.
let tracesText (state: State) : String =
  match Stdlib.List.getAt state.items state.selected with
  | None -> "(nothing selected)"
  | Some item ->
    let fullName = Stdlib.String.join (Stdlib.List.append (modulePathOf state.location) [ item.name ]) "."
    let rows =
      Darklang.Tracing.Store.listByFn fullName 30
      |> Stdlib.List.map (fun t -> "  " ++ t.handler ++ "  ·  " ++ t.timestamp)
    // Empty means one of two things, and `traces list` already knows which:
    // nothing has called it, or recording is off (the default) so nothing
    // would show whatever ran. Say the same thing it says.
    let body =
      if Stdlib.List.isEmpty rows then
        [ Stdlib.Cli.UI.Colors.dimText "  no recorded calls", Stdlib.Cli.UI.Colors.dimText ("  " ++ (Darklang.Cli.Tracing.emptyStateHint ())) ]
      else
        rows
    Stdlib.String.join
      (Stdlib.List.flatten
        [ [ Stdlib.Cli.UI.Colors.boldText ("Traces calling " ++ fullName), "" ]
          body
          [ "", Stdlib.Cli.UI.Colors.dimText "  6 › Traces lists every run" ] ])
      "\n"

let inspectPageLines (state: State) : List<String> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> [ Stdlib.Cli.UI.Colors.dimText "(nothing selected - browse the tree)" ]
  | Some item ->
    if item.isModule then
      modulePreviewLines state item
    else
      // Highlight the source portion here (the page mixes code + colored ref/meta lines, so renderPreview
      // can't blanket-highlight it).
      //
      // The guard is a line-count check: highlighting re-lexes the rendered text, and if that comes back
      // with a different number of lines the colors would land on the wrong rows. Falling back to the
      // plain source is right, but it used to be silent, so a printer change that altered the line count
      // just quietly turned syntax highlighting off and nothing said why. Say it.
      let srcPlain = detailLines state
      let src =
        let h =
          SyntaxHighlighting.highlightCode (Stdlib.String.join srcPlain "\n") |> Stdlib.String.split "\n"
        if Stdlib.List.length h == Stdlib.List.length srcPlain then
          h
        else
          Stdlib.List.append
            srcPlain
            [ Stdlib.Cli.UI.Colors.warning
                $"(syntax highlighting off: re-lexing produced {Stdlib.Int.toString (Stdlib.List.length h)} lines, source has {Stdlib.Int.toString (Stdlib.List.length srcPlain)})" ]
      let refs = Stdlib.String.split (depsText state) "\n"
      Stdlib.List.flatten
        [ src
          [ "", Stdlib.Cli.UI.Colors.dimText (itemMeta state) ]
          (itemActions item)
          [ "", Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan "── references ──", "" ]
          refs ]

/// The preview content for the selected item in the current view. One function so the preview pane, its
/// scroll bounds, and the full-screen reader all agree. SCM previews depend on the active section.
let previewLines (state: State) : List<String> =
  if state.activeView == vHome then homeDetail state
  else if state.activeView == vSCM then
    if state.scm.section == ScmSection.History then Stdlib.String.split (commitSummary state.branchId state.selected) "\n"
    else if state.scm.section == ScmSection.Conflicts then Stdlib.String.split (conflictDetail state) "\n"
    else if state.scm.section == ScmSection.Branches then Stdlib.String.split (branchDetail state) "\n"
    else Stdlib.String.split (wipDiffText state) "\n"
  else if state.activeView == vMatter then
    // Matter folds in the old Inspect: its preview IS the item page (source + meta + references + actions),
    // except under the Values lens, where the value's own detail is what you want.
    if state.matter.lens == Lens.ValuesOnly then detailLines state else inspectPageLines state
  else if state.activeView == vAI then
    if state.ai.section == AiSection.Prompts then Stdlib.String.split (promptDetail state.selected) "\n"
    else Stdlib.String.split (aiThreadDetail state.selected) "\n"
  else if state.activeView == vApps then Stdlib.String.split (appDetail state) "\n"
  else if state.activeView == vTraces then Stdlib.String.split (traceDetail state) "\n"
  else if state.activeView == vDocs then Stdlib.String.split (docContent state) "\n"
  else
    // Extension views supply their own detail; built-ins fall through to the generic item detail.
    match extensionViewAt state.activeView with
    | Some vd ->
      let d = vd.detail
      d state
    | None -> detailLines state
