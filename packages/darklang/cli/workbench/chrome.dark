/// Body dispatch and the pieces that sit around it: the editor pane, search
/// results, per-view key hints, and the help overlay.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

let renderViewBody (state: State) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  if state.activeView == vHome then
    renderHome state region
  else if state.activeView == vMatter then
    // Matter owns its split, so its title carries the path or lens, item
    // count, and active filter here.
    // The breadcrumb, or `packages` at the root: the nav says Code already.
    let path = Stdlib.String.join (modulePathOf state.location) " › "
    let where = if path == "" then "packages" else path
    let lens =
      if state.matter.lens == Lens.ValuesOnly then "values only"
      else if state.matter.lens == Lens.Changed then "changed"
      else ""
    let listFocused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.First
    let detailFocused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second
    paneSplit
      region
      (matterSplitFor state)
      state.focus
      (paneTitle where (Stdlib.List.append [ lens ] (listTrailer state "item")) listFocused)
      (fun r -> renderTreeList state r)
      (paneTitle "Inspect" [] detailFocused)
      (fun r -> renderPreview state r)
  else if state.activeView == vScratch then
    renderRepl state region
  else if state.activeView == vSCM then
    renderScm state region
  else if state.activeView == vDevices then
    renderDevices state region
  else if state.activeView == vAI then
    renderAI state region
  else if state.activeView == vApps then
    splitListPreview state region "" "app" "Detail" (Stdlib.Cli.UI.Colors.dimText "no apps registered")
  else if state.activeView == vTraces then
    // Sample rows must SAY so in the title, not only in the detail pane: the first sample is the
    // REPL's own "try:" example, which someone who just ran it will believe tracing recorded.
    let sample =
      if state.items |> Stdlib.List.any (fun it -> it.kind == "trace-sample") then "(sample)" else ""
    let listFocused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.First
    let detailFocused = state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second
    splitListPreviewTitled
      state
      region
      (paneTitle "" (Stdlib.List.append (listTrailer state "run") [ sample ]) listFocused)
      (paneTitle "Detail" [] detailFocused)
      (Stdlib.Cli.UI.Colors.dimText "no traces yet - eval or run an app to record")
  else if state.activeView == vDocs then
    splitListPreview state region "" "topic" "Topic" (Stdlib.Cli.UI.Colors.dimText "(no topics)")
  else
    // Extension views render themselves (see `extensionViews`); anything unrecognised shows a stub.
    match extensionViewAt state.activeView with
    | Some vd ->
      let draw = vd.render
      draw state region
    | None ->
      titledLines
        region
        (paneTitle (viewLabel state.activeView) [] false)
        [ Stdlib.Cli.UI.Colors.dimText ((viewLabel state.activeView) ++ " - coming soon") ]

/// The multiline editor, under a title naming what's being written: a spacious authoring surface (not
/// the bottom prompt bar). The error line (if any) sits just under the title; the buffer renders below
/// with a reverse-video cursor at (row, col).
let renderEditing (es: EditingState) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  let inner = paneContent region
  let title = paneTitle es.nameStr [ es.kind, "^s saves · esc cancels" ] true
  let errSpans =
    if es.err != "" then Stdlib.Cli.UI.Layout.at inner 0 0 (Stdlib.Cli.UI.Colors.error es.err) else []
  let bodyTop = if es.err != "" then 1 else 0
  let visible = Stdlib.Int.max 1 (inner.rows - bodyTop)
  let scroll = Stdlib.Int.max 0 (es.buf.row - visible + 1)
  let bodySpans =
    es.buf.lines
    |> Stdlib.List.indexedMap (fun i l -> (i, l))
    |> Stdlib.List.drop scroll
    |> Stdlib.List.take visible
    |> Stdlib.List.map (fun pair ->
      let (i, l) = pair
      let screenRow = bodyTop + (i - scroll)
      if i == es.buf.row then
        let llen = Stdlib.String.length l
        let before = Stdlib.String.slice l 0 es.buf.col
        let atCursor = if es.buf.col < llen then Stdlib.String.slice l es.buf.col (es.buf.col + 1) else " "
        let after = if es.buf.col < llen then Stdlib.String.slice l (es.buf.col + 1) llen else ""
        Stdlib.Cli.UI.Layout.at inner screenRow 0 (before ++ (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.reverse atCursor) ++ after)
      else
        Stdlib.Cli.UI.Layout.at inner screenRow 0 l)
    |> Stdlib.List.flatten
  Stdlib.List.flatten [ frameWithTitles region title "" (0 - 1), errSpans, bodySpans ]

/// The jumpable search-results list. ⏎ navigates to the hit.
let renderSearchResults (state: State) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  let title = paneTitle "Search" [ plural (Stdlib.List.length state.search.hits) "result", "⏎ jump · esc close" ] true
  let inner = paneContent region
  let lines =
    state.search.hits
    |> Stdlib.List.indexedMap (fun i h ->
      if i == state.search.selected then
        selectionRow inner.cols ("  " ++ h.display)
      else "  " ++ h.display)
  Stdlib.List.flatten
    [ frameWithTitles region title "" (0 - 1)
      Stdlib.Cli.UI.ListView.render inner lines state.search.selected ]

/// Dispatch the body: the editor, then a reader, then search results, else the active view's body.
let renderBody (state: State) (region: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  match state.editing with
  | Some es -> renderEditing es region
  | None ->
  match state.reading with
  | Some content -> renderReading content state.readingIsCode state.detailScroll region
  | None ->
    if Stdlib.Bool.not (Stdlib.List.isEmpty state.search.hits) then renderSearchResults state region
    else renderViewBody state region

/// A view's purpose and data caveat. An empty caveat means real data.
let viewBlurb (idx: Int) : (String * String) =
  if idx == vMatter then ("browse and edit the package tree", "")
  else if idx == vScratch then
    ("evaluate expressions -- ⏎ to start typing, esc to stop; `let` binds for the session", "")
  else if idx == vSCM then ("changes, commits, branches, conflicts", "")
  else if idx == vDevices then ("this instance's config, and the peers it syncs with", "part sketch")
  else if idx == vAI then ("agent threads and prompts", "sample data")
  else if idx == vApps then ("install, run and stop packaged apps", "")
  else if idx == vTraces then ("what ran recently - samples until something does", "")
  else if idx == vDocs then ("the CLI's docs, read without leaving", "")
  else
    match extensionViewAt idx with
    | Some vd ->
      if vd.id == "errors" then ("real conflicts, plus samples for the rest", "part sample")
      else if vd.id == "crons" then ("scheduled handlers", "sample data")
      else if vd.id == "calendar" then ("nothing behind it yet", "sketch")
      else if vd.id == "builtins" then ("every builtin, searchable", "")
      else ("", "")
    | None -> ("", "")

/// Key hints for the focused pane, followed by global shortcuts.
///
/// Fitted to `width` rather than concatenated and clipped: clipping one long string loses the hints at the
/// END, which are `?` (the keymap) and `q` (the way out) -- the two a person needs most when lost. The
/// row drops whole hints cheapest-first instead: secondary globals, then the view's own actions, and
/// `?`/`q` never.
let hintsForView (state: State) (width: Int) : String =
  let view = state.activeView
  // Pane movement only applies when a preview exists.
  let hasPreview = hasDetailPane state
  let paneHint = if hasPreview then [ ("←→", "pane") ] else []
  // `p` earns a slot here: it's the way out to the prompt, and an escape hatch nobody can see isn't one.
  // Split by what a person cannot do without: `?` opens the keymap and `q` leaves; everything else on
  // this row is discoverable THROUGH `?`, so everything else can give way on a narrow terminal.
  //
  // `q`, not `esc/q`: Escape is BACK one level everywhere and never quits (see `keys-view.dark` and the
  // `?` overlay, which both say so). The one hint that has to survive every width said the opposite.
  let essential = [ ("?", "help"), ("q", "quit") ]
  // Where esc goes, named: `esc ← Stdlib`, `esc ← Home`. Nothing on Home with nowhere left to go.
  let backHint =
    let label = backLabel state
    if label == "" then [] else [ ("esc", "← " ++ label) ]
  let secondaryGlobal = [ ("S", "branches"), ("/", "search"), (":", "cmd"), ("p", "prompt"), ("`", "views") ]
  let ctx =
    if navbarFocused state then
      // The arrows follow the nav's shape: along the strip, down the overlay
      // (see `handleNavbarKey`). The strip shows each workspace's number, so
      // the row doesn't repeat `1-9`; the overlay does the same.
      // `p prompt` lives in secondaryGlobal already; repeating it here printed the footer's one
      // duplicate entry.
      let (walk, leave) =
        if navFits width then (("←→", "move"), ("↓", "to view"))
        else (("↑↓", "move"), ("→", "to view"))
      [ walk, ("⏎", "go"), leave ]
    else if view == vMatter then
      Stdlib.List.flatten
        // Spelled out: `n/t/v new` read as one key, and `t` alone got taken
        // for "try".
        [ [ ("↑↓", "move"), ("⏎", "open") ]
          backHint
          [ ("e", "edit"), ("n/t/v", "new fn/type/val"), ("r", "rename"), ("x", "traces"), ("f", "filter") ]
          (if Stdlib.List.member (visibleViews state) (extViewIndex "builtins") then [ ("B", "builtins") ] else [])
          paneHint ]
    else if view == vHome then
      let enter =
        if (homeRowIs state "home-branch") && (Stdlib.Bool.not (homeRowIsCurrentBranch state)) then
          ("⏎", "switch")
        else ("⏎", "open")
      // Branch verbs live here now: Home is where the branches are listed.
      Stdlib.List.flatten [ [ ("↑↓", "move"), enter ], backHint, [ ("s", "switch branch"), ("b", "new branch"), ("c", "commit"), ("m", "merge") ] ]
    else if view == vScratch then
      Stdlib.List.flatten [ [ ("⏎", "type") ], backHint, [ ("f", "clear log"), ("x", "clear session") ] ]
    else if view == vSCM then
      // On a conflict row the row's own verbs; otherwise the draft's. `u/d` stay: they are the
      // only way to sync from in here, and a key nobody can see is a key nobody uses.
      if cursorRowIs state "conflict" then
        Stdlib.List.flatten
          [ [ ("↑↓", "move"), ("⏎", "open") ], backHint, [ ("o", "ours"), ("t", "theirs"), ("a", "ack") ], paneHint ]
      else
        Stdlib.List.flatten
          [ [ ("↑↓", "move"), ("⏎", "open") ]
            backHint
            [ ("c", "commit"), ("x", "discard"), ("u/d", "push/pull") ]
            paneHint ]
    else if view == vDevices then
      [ ("c", "config"), ("s", "sync now"), ("a", "setup") ]
    else if view == vAI then
      let enterHint = if state.ai.section == AiSection.Prompts then ("⏎", "use") else ("⏎", "open")
      Stdlib.List.flatten [ [ ("↑↓", "move"), enterHint, ("[]", "section"), ("a", "ask") ], paneHint ]
    else if view == vApps then
      Stdlib.List.flatten [ [ ("↑↓", "move"), ("⏎", "inspect") ], backHint, [ ("i", "install"), ("r", "start"), ("s", "stop") ] ]
    else if view == vTraces then
      Stdlib.List.flatten
        [ [ ("↑↓", "move"), ("⏎", "open") ], backHint, paneHint, [ ("f", "filter"), ("E", "errors") ] ]
    else if view == vDocs then
      Stdlib.List.flatten [ [ ("↑↓", "move"), ("⏎", "read") ], backHint, paneHint ]
    else
      // Extension views compose their own key-hints (see `extensionViews`).
      match extensionViewAt view with
      | Some vd ->
        let h = vd.hints
        Stdlib.List.append (h state) backHint
      | None -> Stdlib.List.append [ ("↑↓", "move") ] backHint
  // Fitted rather than concatenated. The droppable run is ordered cheapest-last, so this view's own actions
  // outlive the secondary global keys, and `?`/`q` outlive everything.
  // Home already lists `s switch branch`, so `S branches` would repeat it; the rest stay, `p`
  // above all (see the note on it above).
  let globals =
    if view == vHome then secondaryGlobal |> Stdlib.List.filter (fun pair -> let (k, _l) = pair in k != "S")
    else secondaryGlobal
  Frame.formatHintsFitted (Stdlib.List.append ctx globals) essential width

/// The keymap, grouped, for the `?` overlay - (category, keys).
val helpGroups =
  [ ("Go", "` nav   ←→ walk it   ↓ into the view   ⏎ go   1-8 view   S switch branch   esc one step back, the footer says where (never quits)")
    ("Move", "↑↓ or j/k   g/G top/bottom   ←→ or h/l between panes   tab next pane")
    ("Open", "⏎ into a module / open a row   backspace up a module")
    ("Find", "/ find   : command   ? this   q quit")
    ("Code", "e edit   n new fn   t new type   v new value   r rename   x traces   L lens   C changed   f filter   B builtins")
    ("REPL", "⏎ type (esc leaves the prompt)   f clear log   x clear session")
    ("Home", "⏎ open / switch to the row's branch   c commit   b new branch   s choose branch   m merge   r rebase   x delete branch")
    ("Changes", "⏎ source   c commit   x discard   u/d push/pull   o/t/a resolve the conflict under the cursor")
    ("Apps", "⏎ inspect   i install   r run   s stop")
    ("Traces", "⏎ open   f filter   E errors")
    ("Sync", "s sync now   u push   d pull   o other instances")
    ("Search", "↑↓ move   ⏎ jump   esc close")
    // Last, and spelled out, because it's the way back to the pre-workbench CLI. Anything you could type at
    // the prompt runs from the `:` bar; `p` hands you the prompt itself.
    ("Prompt", "p drops to the command prompt (quit returns here)   : runs one command without leaving") ]

/// A centered, boxed keymap overlay drawn over the frame. The interior is cleared so nothing shows through.
let renderHelpOverlay (screen: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  // Wide enough for the longest group, not a round number. A fixed 70 clipped the Matter row - the single most
  // useful line in the keymap - on a terminal with room to spare. 11 is where the keys column starts, plus the
  // border and a column of padding either side.
  let widest =
    helpGroups
    |> Stdlib.List.map (fun pair ->
      let (_label, keys) = pair
      Stdlib.String.displayWidth keys)
    |> Stdlib.List.fold 0 (fun acc n -> Stdlib.Int.max acc n)
  let w = Stdlib.Int.min (Stdlib.Int.max 40 (widest + 14)) (Stdlib.Int.max 40 (screen.cols - 4))
  let rows = (Stdlib.List.length helpGroups) * 2 + 3
  let h = Stdlib.Int.min (Stdlib.Int.max 8 rows) (screen.rows - 2)
  let top = screen.top + (Stdlib.Int.divide (Stdlib.Int.max 0 (screen.rows - h)) 2)
  let left = screen.left + (Stdlib.Int.divide (Stdlib.Int.max 0 (screen.cols - w)) 2)
  let region = Stdlib.Cli.UI.Layout.Region { top = top; left = left; rows = h; cols = w }
  Stdlib.List.flatten
    [ Stdlib.Cli.UI.Layout.clearRegion region
      Stdlib.Cli.UI.Box.panel region "Keys  ·  any key closes" true (fun inner ->
        helpGroups
        |> Stdlib.List.indexedMap (fun i pair -> (i, pair))
        |> Stdlib.List.map (fun ipair ->
          let (i, pair) = ipair
          let (label, keys) = pair
          let row = (i * 2) + 1
          Stdlib.List.flatten
            [ Stdlib.Cli.UI.Layout.at inner row 1 (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan label)
              Stdlib.Cli.UI.Layout.at inner row 11 (Stdlib.Cli.UI.Colors.dimText keys) ])
        |> Stdlib.List.flatten) ]
