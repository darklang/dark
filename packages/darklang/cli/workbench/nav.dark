/// Movement and the actions a keypress can trigger. Each returns a `Step`.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

/// Move focus left: detail → list → sidebar when visible.
let focusLeft (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.First }
  else if sidebarIsColumnNow () then
    Step.Continue (focusSidebar state)
  else
    Step.Continue state

/// Move focus from the list to an available detail pane.
let focusRight (state: State) : Step =
  if (state.focus == Stdlib.Cli.UI.SplitPane.Focus.First) && (Stdlib.Bool.not (Stdlib.List.isEmpty state.items)) then
    Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.Second }
  else
    Step.Continue state

/// Enter the selected Matter module.
let descend (state: State) : Step =
  if state.activeView == vHome then Step.Continue state else
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    if item.isModule then
      let newPath = Stdlib.List.append (modulePathOf state.location) [ item.name ]
      let newLoc = Packages.PackageLocation.Module newPath
      Step.Continue
        { state with
            location = newLoc
            items = loadItems state.branchId newLoc
            selected = 0
            detailScroll = 0
            // The items we just loaded are unfiltered, so the filter has to go with them. Leaving it set
            // made the title claim a filter that wasn't applied, and the next reload would then silently
            // narrow the list under you.
            filter = "" }
    else
      Step.Continue state
  | None -> Step.Continue state

let ascend (state: State) : Step =
  if state.activeView == vHome then Step.Continue state else
  let path = modulePathOf state.location
  match Stdlib.List.reverse path with
  | [] -> Step.Continue state
  | _ :: revParent ->
    let newPath = Stdlib.List.reverse revParent
    let newLoc = Packages.PackageLocation.Module newPath
    Step.Continue
      { state with
          location = newLoc
          items = loadItems state.branchId newLoc
          selected = 0
          filter = "" }

// ── Movement (shared by arrows + vim keys, so j/k/h/l/g/G mean the same as the arrows) ──

/// Up: scroll the inspector when it's focused, else move the list selection up.
let navUp (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    Step.Continue { state with detailScroll = Stdlib.Int.max 0 (state.detailScroll - 1) }
  else
    let target = Stdlib.Int.max 0 (state.selected - 1)
    // Home's section headers aren't rows: step over them (and stay put if
    // there's nothing above).
    let landed =
      if state.activeView == vHome then
        let s = homeSelectable state.items target (0 - 1)
        if s > state.selected then state.selected else s
      else target
    Step.Continue { state with selected = landed; detailScroll = 0 }

/// Down: scroll the inspector when it's focused, else move the list selection down.
let navDown (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    // Screen rows, not logical lines: a long line wraps to several, and bounding on the unwrapped count
    // stops the scroll before its tail is reachable.
    let maxScroll = Stdlib.Int.max 0 ((previewRowCount state) - 1)
    Step.Continue { state with detailScroll = Stdlib.Int.min maxScroll (state.detailScroll + 1) }
  else
    let maxIdx = (Stdlib.List.length state.items) - 1
    let target = Stdlib.Int.min maxIdx (state.selected + 1)
    let landed =
      if state.activeView == vHome then
        let s = homeSelectable state.items target 1
        if s < state.selected then state.selected else s
      else target
    Step.Continue { state with selected = landed; detailScroll = 0 }

/// Jump to the top / bottom of the list (vim g / G).
let navTop (state: State) : Step =
  let top = if state.activeView == vHome then homeSelectable state.items 0 1 else 0
  Step.Continue { state with selected = top; detailScroll = 0 }

let navBottom (state: State) : Step =
  let maxIdx = Stdlib.Int.max 0 ((Stdlib.List.length state.items) - 1)
  Step.Continue { state with selected = maxIdx; detailScroll = 0 }

/// Open the full-screen reader on `content`. `isCode` toggles syntax highlighting (true for source, false for
/// docs/help/search/ops). Resets scroll.
let openReader (state: State) (content: String) (isCode: Bool) : Step =
  Step.Continue
    { state with
        reading = Stdlib.Option.Option.Some content
        readingIsCode = isCode
        detailScroll = 0 }

/// Resolve the selected conflict (Conflicts view): keep ours (local), theirs (incoming), or just acknowledge.
let resolveConflict (state: State) (which: String) : Step =
  match selectedConflict state with
  | None -> Step.Continue { state with message = "no conflict selected" }
  | Some c ->
    let ok =
      if which == "ours" then Darklang.Sync.Conflicts.keep c.location c.localHash
      else if which == "theirs" then Darklang.Sync.Conflicts.keep c.location c.incomingHash
      else Darklang.Sync.Conflicts.acknowledge c.location
    let label = if which == "ok" then "acknowledged" else "kept " ++ which
    Step.Continue
      { state with
          items = reloadItems state
          selected = 0
          message = if ok then "resolved: " ++ label else "resolve failed" }

/// The app the cursor is on, resolved by name rather than by position.
///
/// Same filtered-cursor reasoning as `selectedBranch`: the Apps list narrows under `f`, so indexing straight
/// into `Apps.Registry.available ()` would install, start or stop whichever app sat at that position in the
/// full list.
let selectedApp (state: State) : Stdlib.Option.Option<Darklang.Cli.Apps.Model.App> =
  match Stdlib.List.getAt state.items state.selected with
  | None -> Stdlib.Option.Option.None
  | Some item ->
    // Rows read "<marker> <name>  ·  <description>" - see `loadAppItems`.
    let name =
      item.name
      |> Stdlib.String.dropFirst 2
      |> fun rest ->
        Stdlib.String.split rest "  ·  " |> Stdlib.List.head |> Stdlib.Option.withDefault rest
    Darklang.Cli.Apps.Registry.available () |> Stdlib.List.findFirst (fun a -> a.name == name)

/// Apps: install/uninstall the selected app (updates the installed set + the ●/○ marker). Bound to both the
/// primary key (⏎) and the explicit `i`.
let toggleInstall (state: State) : Step =
  match selectedApp state with
  | Some app ->
    let slugs = Darklang.Cli.Apps.Registry.installedSlugs ()
    let (newSlugs, msg) =
      if Stdlib.List.member slugs app.slug then
        (slugs |> Stdlib.List.filter (fun s -> s != app.slug), "uninstalled " ++ app.slug)
      else
        (Stdlib.List.append slugs [ app.slug ], "installed " ++ app.slug)
    let _ = Darklang.Cli.Apps.Registry.saveInstalled newSlugs
    Step.Continue
      { state with
          items = itemsForView vApps state.branchId state.location state.scm.section state.ai.section state.matter.lens
          message = msg }
  | None -> Step.Continue state

/// Run `apps <sub> <slug>` for the selected app in-frame (captured), refresh the list, and show the output in
/// the reader - so start/stop/inspect act here instead of forcing a drop to the `:` bar.
let runAppsSubcommand (state: State) (sub: String) : Step =
  match selectedApp state with
  | None -> Step.Continue state
  | Some app ->
    let appState =
      classicState state
    let out = captureOutput (fun () -> Darklang.Cli.Registry.executeCommand "apps" appState [ sub, app.slug ])
    let refreshed =
      itemsForView vApps state.branchId state.location state.scm.section state.ai.section state.matter.lens
    let shown =
      if (Stdlib.String.trim out) == "" then $"apps {sub} {app.slug}\n\n(done)" else out
    openReader { state with items = refreshed } shown false

/// The `r` action for the selected app: a foreground app hands off to its full-screen command (the CLI returns
/// to the workbench when it exits); a daemon starts detached, in-frame.
let launchOrStartApp (state: State) : Step =
  match selectedApp state with
  | None -> Step.Continue state
  | Some app ->
    match app.target with
    | Foreground cmd -> Step.Launch(state, cmd)
    | Daemon _ -> runAppsSubcommand state "start"

/// Jump from a search result to its home in the Tree: open the containing module, select the leaf, close the
/// results mode.
let jumpToHit (state: State) (hit: SearchHit) : Step =
  let newLoc = Packages.PackageLocation.Module hit.modules
  let items = loadItems state.branchId newLoc
  let idx =
    items
    |> Stdlib.List.indexedMap (fun i it -> (i, it))
    |> Stdlib.List.findFirst (fun pair -> let (_i, it) = pair in it.name == hit.name)
    |> Stdlib.Option.map (fun pair -> let (i, _it) = pair in i)
    |> Stdlib.Option.withDefault 0
  // Through `goTo` so the sidebar and the workspace memory follow; then land
  // on the leaf, which `goTo` can't know about (it reloads the list for the
  // location it's given).
  let moved = goTo { state with location = newLoc } (mkDest vMatter 0) false
  Step.Continue
    { moved with
        items = items
        selected = idx
        search = emptySearch ()
        message = "jumped to " ++ hit.name }
