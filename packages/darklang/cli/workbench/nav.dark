/// Movement and the actions a keypress can trigger. Each returns a `Step`.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

/// Move focus left: detail → list. It stops there: the nav is above the
/// body, not beside it, and esc, tab and ` all reach it.
let focusLeft (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.First }
  else
    Step.Continue state

/// Move focus from the list to an available detail pane.
let focusRight (state: State) : Step =
  if (hasDetailPane state) && (state.focus == Stdlib.Cli.UI.SplitPane.Focus.First) then
    Step.Continue { state with focus = Stdlib.Cli.UI.SplitPane.Focus.Second }
  else
    Step.Continue state

// ── Going back ──

/// How many places esc remembers.
val backCap = 50

/// Where you are, as something to come back to.
let returnPointOf (state: State) : ReturnPoint =
  ReturnPoint
    { view = state.activeView
      location = state.location
      lens = state.matter.lens
      selected = state.selected
      filter = state.filter }

/// The only navigation transition: remember where you were once, restore
/// all destination coordinates, then load and clamp its filtered list.
/// Back navigation passes false so it cannot create a return trip of its own.
let moveToPoint (state: State) (point: ReturnPoint) (recordHistory: Bool) : State =
  let here = returnPointOf state
  let back =
    if recordHistory && (here != point) then
      Stdlib.List.take (Stdlib.List.prepend state.back here) backCap
    else state.back
  let dest = mkDest point.view 0
  let ws = workspaceOf dest
  let restored =
    { state with
        activeView = point.view
        location = point.location
        matter = { state.matter with lens = point.lens }
        filter = point.filter
        detailScroll = 0
        back = back
        wsLast =
          Stdlib.List.append
            (state.wsLast |> Stdlib.List.filter (fun pair ->
              let (i, _d) = pair in i != ws))
            (ws, dest) }
  let items = reloadItems restored
  let selected =
    Stdlib.max 0
      (Stdlib.min point.selected ((Stdlib.List.length items) - 1))
  focusContent (fixSelection { restored with items = items, selected = selected })

/// What esc will return to, for the footer: the module you were in, or the
/// view you came from; "" on Home with nowhere left to go.
let backLabel (state: State) : String =
  match state.back with
  | [] -> if state.activeView == vHome then "" else "Home"
  | [p, ...] ->
    if (p.view == state.activeView) && (p.view == vMatter) then
      match Stdlib.List.last (Packages.modulePathOf p.location) with
      | Some m -> if p.lens == state.matter.lens then m else "Tree"
      | None -> "Tree"
    else
      // The strip's name for the view (Code, not Matter), so the hint reads like the nav.
      match Stdlib.List.getAt workspaces (workspaceOf (mkDest p.view 0)) with
      | Some w -> w.name
      | None -> viewLabel p.view

/// One step back: the most recent place, restored, with its list reloaded and
/// the cursor where it was. With nothing remembered, Home; on Home, nothing.
/// Never quits: that is `q`.
let goBack (state: State) : Step =
  match state.back with
  | [] ->
    if state.activeView == vHome then Step.Continue state
    else
      // The bottom of the stack: Home, without remembering the view just left, or esc would
      // ping-pong between the two.
      let moved = goTo state (mkDest vHome 0) false
      Step.Continue { moved with back = [] }
  | [p, ...rest] ->
    Step.Continue (moveToPoint { state with back = rest } p false)

/// Enter a tree module, remembering its parent and cursor.
let descend (state: State) : Step =
  if state.activeView != vMatter then Step.Continue state else
  match Stdlib.List.getAt state.items state.selected with
  | Some item ->
    if item.isModule then
      let path = Stdlib.List.append (Packages.modulePathOf state.location) item.name
      let point =
        { (returnPointOf state) with
            location = Packages.PackageLocation.Module path
            lens = Lens.WholeTree
            selected = 0
            filter = "" }
      Step.Continue (moveToPoint state point true)
    else Step.Continue state
  | None -> Step.Continue state

/// Backspace goes to the parent module; Escape follows navigation history.
let ascend (state: State) : Step =
  if state.activeView != vMatter then Step.Continue state else
  match Stdlib.List.reverse (Packages.modulePathOf state.location) with
  | [] -> Step.Continue state
  | [_, ...parent] ->
    let point =
      { (returnPointOf state) with
          location = Packages.PackageLocation.Module (Stdlib.List.reverse parent)
          lens = Lens.WholeTree
          selected = 0
          filter = "" }
    Step.Continue (moveToPoint state point true)

// ── Movement (the arrows, Home/End and PageUp/PageDown; there is no second key set) ──

/// The nearest selectable row to `from`, looking in `dir` (+1 / -1) past any
/// section headers; `from` itself if it's selectable. Falls back to the other
/// direction at the ends, so the cursor never sits on a header.
let selectableRow (items: List<BodyItem>) (from: Int) (dir: Int) : Int =
  let n = Stdlib.List.length items
  let isOk (i: Int) : Bool =
    match Stdlib.List.getAt items i with
    | Some it -> Stdlib.Bool.not (isSectionHeader it)
    | None -> false
  let scan (i: Int) (step: Int) : Int =
    if (i < 0) || (i >= n) then 0 - 1
    else if isOk i then i
    else scan (i + step) step
  let forward = scan from dir
  if forward >= 0 then forward
  else
    let back = scan from (0 - dir)
    if back >= 0 then back else Stdlib.max 0 (Stdlib.min from (n - 1))

/// Keep a sectioned list's cursor off its headers. Run on every transition
/// (see `refresh`), so a reload that lands the cursor on a header - a commit
/// empties the uncommitted section, say - moves it on. Other behaviors pass
/// through untouched.
let fixSelection (state: State) : State =
  if Stdlib.Bool.not (isSectioned state) then state
  else
    let fixed = selectableRow state.items state.selected 1
    if fixed == state.selected then state else { state with selected = fixed }

/// Ten of whatever the arrow does, for shift+arrow.
///
/// Ten steps rather than a screenful, and by repeating the arrow rather than reimplementing it:
/// both ends clamp for free, section headers are stepped over exactly as they are one at a time,
/// and a pane that scrolls its document scrolls it. Home and PageUp exist and he does not use
/// them; this needs no fn key and no letter taken away from something else.
let repeatStep (state: State) (step: State -> Step) (times: Int) : Step =
  let go (s: State) (n: Int) : State =
    if n <= 0 then
      s
    else
      match step s with
      | Continue next -> go next (n - 1)
      | _ -> s

  Step.Continue(go state times)


/// Up: scroll the inspector when it's focused, else move the list selection up.
let navUp (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    Step.Continue { state with detailScroll = Stdlib.max 0 (state.detailScroll - 1) }
  else
    let target = Stdlib.max 0 (state.selected - 1)
    // Section headers aren't rows: step over them (and stay put if there's
    // nothing above).
    let landed =
      if isSectioned state then
        let s = selectableRow state.items target (0 - 1)
        if s > state.selected then state.selected else s
      else target
    Step.Continue { state with selected = landed, detailScroll = 0 }

/// Down: scroll the inspector when it's focused, else move the list selection down.
let navDown (state: State) : Step =
  if state.focus == Stdlib.Cli.UI.SplitPane.Focus.Second then
    // Screen rows, not logical lines: a long line wraps to several, and bounding on the unwrapped count
    // stops the scroll before its tail is reachable.
    let maxScroll = Stdlib.max 0 ((previewRowCount state) - 1)
    Step.Continue { state with detailScroll = Stdlib.min maxScroll (state.detailScroll + 1) }
  else
    let maxIdx = (Stdlib.List.length state.items) - 1
    let target = Stdlib.min maxIdx (state.selected + 1)
    let landed =
      if isSectioned state then
        let s = selectableRow state.items target 1
        if s < state.selected then state.selected else s
      else target
    Step.Continue { state with selected = landed, detailScroll = 0 }

/// Jump to the top / bottom of the list (Home / End).
let navTop (state: State) : Step =
  let top = if isSectioned state then selectableRow state.items 0 1 else 0
  Step.Continue { state with selected = top, detailScroll = 0 }

let navBottom (state: State) : Step =
  let maxIdx = Stdlib.max 0 ((Stdlib.List.length state.items) - 1)
  Step.Continue { state with selected = maxIdx, detailScroll = 0 }

/// Open the full-screen reader on `content`. `isCode` toggles syntax highlighting (true for source, false for
/// docs/help/search/ops). Resets scroll.
let openReader (state: State) (content: String) (isCode: Bool) : Step =
  Step.Continue
    { state with
        reading = Stdlib.Option.Option.Some content
        readingIsCode = isCode
        detailScroll = 0 }

/// Resolve the selected conflict (Conflicts view): keep ours (local), theirs (incoming), or just acknowledge.
let resolveConflict (state: State) (which: String) : Step =
  match selectedConflict state with
  | None -> Step.Continue { state with messageKind = MessageKind.Refused, message = "no conflict selected" }
  | Some c ->
    // `Candidate.side` holds "local" / "incoming", so those are the only two labels that match. A label
    // that matches nothing yields "", and an empty hash reaching the resolver binds a live name to
    // nothing.
    let sideFor (side: String) : String =
      match SCM.Conflicts.candidateFor c side with
      | Some cand -> cand.hash
      | None -> ""

    let outcome =
      if which == "ours" then
        SCM.PackageOps.settleConflict state.branchId c (sideFor "local")
      else if which == "theirs" then
        SCM.PackageOps.settleConflict state.branchId c (sideFor "incoming")
      else
        let _ = SCM.Conflicts.setStatus c.id "acked" ""
        Stdlib.Result.Result.Ok()

    let label = if which == "ok" then "acknowledged" else "kept " + which

    let (message, kind) =
      match outcome with
      | Ok _ -> ("resolved: " + label, MessageKind.Succeeded)
      | Error e -> ("resolve failed: " + e, MessageKind.Failed)

    // Forced: an ack writes no op, so the comparison in `refreshScmStatus` would carry the old
    // "N need you" forward over a conflict you just answered.
    let refreshed = forceScmRefresh state

    Step.Continue
      { refreshed with items = reloadItems refreshed, selected = 0, messageKind = kind, message = message }

/// Run a top-level command in-frame (captured) and show its output in the reader.
let runCommandInFrame (state: State) (command: String) (args: List<String>) : Step =
  let out =
    captureOutput (fun () ->
      Darklang.Cli.Registry.executeCommand command (classicState state) args)

  let shown =
    if (Stdlib.String.trim out) == "" then
      $"""{command} {Stdlib.String.join args " "}\n\n(done)"""
    else
      out

  // Forced, not compared: the command may have landed committed ops and conflicts without moving
  // this branch's draft count.
  let refreshed = forceScmRefresh state
  openReader refreshed shown false


/// Jump from a search result to its home in the Tree: open the containing module, select the leaf, close the
/// results mode.
let jumpToHit (state: State) (hit: SearchHit) : Step =
  let newLoc = Packages.PackageLocation.Module hit.modules
  let items = loadItems state.branchId newLoc
  let idx =
    items
    |> Stdlib.List.indexedMap (fun i it -> (i, it))
    |> Stdlib.List.findFirst (fun pair -> let (_i, it) = pair in it.name == hit.name)
    |> Stdlib.Option.map (fun pair -> let (i, _it) = pair in i)
    |> Stdlib.Option.withDefault 0
  let point =
    { (returnPointOf state) with
        view = vMatter
        location = newLoc
        lens = Lens.WholeTree
        selected = idx
        filter = "" }
  let moved = moveToPoint state point true
  Step.Continue
    { moved with
        items = items
        selected = idx
        search = emptySearch ()
        messageKind = MessageKind.Succeeded
        message = "jumped to " + hit.name }
