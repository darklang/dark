/// Frame - the always-on workbench chrome (tab bar + breadcrumb). Render helpers used by the workbench
/// SubApp; the bottom status bar is the CLI's existing one. See design main/notes/cli-ux/03A.
module Darklang.Cli.Workbench.Frame

/// The built-in views (indices 0-9), in tab-bar order. Kept in sync with the view-index constants in App
/// (vHome..vDocs). Extension views (index 10+) are named by their `ViewDef` in App's registry, not here - the
/// tab bar receives already-resolved labels (see `renderTabBar`), so this stays the base-name table only.
/// Index 2 is a placeholder: Inspect was folded into Matter's preview, but the views after it are addressed
/// by index (number keys, the SCM badge), so the slot stays rather than shifting everything down one.
val viewNames =
  [ "Home"; "Matter"; "(unused)"; "REPL"; "SCM"
    "Devices"; "AI"; "Apps"; "Traces"; "Docs" ]

let viewName (i: Int) : String =
  Stdlib.List.getAt viewNames i |> Stdlib.Option.withDefault "Home"

/// Render the tab bar into `region` (one row). `visible` is the ordered list of (view index, label) pairs to
/// show - labels are resolved by the caller so the frame needn't know about extension views (some views, e.g.
/// Devices, are opt-in and hidden). `active` is the active view index, rendered bright with a ◆ marker, the
/// rest dim. When `conflictCount` > 0, the SCM tab carries a red count badge so an attention state is visible
/// from any view.
let renderTabBar (region: UI.Layout.Region) (visible: List<(Int * String)>) (active: Int) (conflictCount: Int) : List<UI.Layout.Span> =
  let segs =
    visible
    |> Stdlib.List.map (fun pair ->
      let (i, name) = pair
      // SCM is index 4 - badge it when there's a conflict to resolve (conflicts live in SCM now).
      let label =
        if i == 4 && conflictCount > 0 then name ++ (Colors.colorize Colors.pink (" ⚠" ++ Stdlib.Int.toString conflictCount))
        else name
      if i == active then
        Colors.colorize (Colors.bold ++ Colors.cyan) ("◆ " ++ label)
      else if i == 4 && conflictCount > 0 then
        // Keep the badge visible even when the tab isn't active (name dim, badge already colored).
        (Colors.colorize Colors.dim name) ++ (Colors.colorize Colors.pink (" ⚠" ++ Stdlib.Int.toString conflictCount))
      else
        Colors.colorize Colors.dim name)
  UI.Layout.at region 0 0 ("  " ++ (Stdlib.String.join segs "   "))

/// Render the breadcrumb row: the current package path on the left, and a pre-built right segment (branch +
/// sync status) right-aligned. `rightColored` is the ANSI-colored text; `rightVisibleLen` is its visible width
/// (so placement math isn't thrown off by the color codes).
let renderBreadcrumb
  (region: UI.Layout.Region)
  (path: String)
  (rightColored: String)
  (rightVisibleLen: Int)
  : List<UI.Layout.Span> =
  let rightCol = Stdlib.Int.max 0 (region.cols - rightVisibleLen - 2)
  Stdlib.List.flatten
    [ UI.Layout.at region 0 0 ("  " ++ (Colors.boldText path))
      UI.Layout.at region 0 rightCol rightColored ]

/// Format a list of (key, label) hints into a footer string: the key bright (cyan), the label dim, pairs
/// separated by three dim spaces (kept plain so a footer full of hints doesn't clip on a narrow terminal).
/// Per the TUI rule "key emphasized, label muted" so shortcuts actually read.
let formatHints (pairs: List<(String * String)>) : String =
  pairs
  |> Stdlib.List.map (fun pair ->
    let (k, l) = pair
    (Colors.colorize Colors.cyan k) ++ " " ++ (Colors.dimText l))
  |> Stdlib.String.join (Colors.dimText "   ")

/// Fit key hints to a row: <param keep> always survives, <param droppable> gives way from its END.
///
/// The row used to be one long string clipped from the right, so the things at the end went first -- and
/// the things at the end were `?` (the keymap) and `esc/q` (the way out). Those are the two a person needs
/// most when the window is small and they are lost, which is exactly when they disappeared. A hint cut
/// mid-word ("p promp") teaches nothing either.
///
/// Callers order <param droppable> cheapest-last: a view's own actions come first and the secondary global
/// keys after them, so `c commit` outlives `` ` views``. Anything dropped is still reachable through `?`,
/// which is precisely why `?` is the thing that must not drop.
///
/// Dropping stops at the first hint that does not fit, so the order a person learns them in stays put.
let formatHintsFitted
  (droppable: List<(String * String)>)
  (keep: List<(String * String)>)
  (width: Int)
  : String =
  let plainOf (pairs: List<(String * String)>) : String =
    pairs
    |> Stdlib.List.map (fun p ->
      let (k, l) = p
      k ++ " " ++ l)
    |> Stdlib.String.join "   "

  // 2 for the indent, 3 for the join between the droppable run and the kept keys.
  let room =
    Stdlib.Int.max 0 (width - (Tui.Text.displayWidth (plainOf keep)) - 5)

  let (fitted, _stopped) =
    droppable
    |> Stdlib.List.fold ([], false) (fun acc p ->
      let (sofar, stopped) = acc

      if stopped then
        (sofar, true)
      else
        let candidate = Stdlib.List.append sofar [ p ]

        if (Tui.Text.displayWidth (plainOf candidate)) <= room then
          (candidate, false)
        else
          (sofar, true))

  formatHints (Stdlib.List.append fitted keep)

/// Render a one-row, pre-colored key-hint bar at the bottom of the body. The string is already styled
/// (see `formatHints`), so this just indents + places it.
let renderKeyHints (region: UI.Layout.Region) (hints: String) : List<UI.Layout.Span> =
  UI.Layout.at region 0 0 ("  " ++ hints)
