/// Frame - the always-on workbench chrome: the view-name table and the
/// footer's key-hint helpers. Render helpers used by the workbench SubApp.
/// See design main/notes/cli-ux/03A.
module Darklang.Cli.Workbench.Frame

/// Labels for stable built-in view indices. Index 2 stays reserved for the
/// former Inspect view so later indices do not change.
val viewNames =
  [ "Home", "Matter", "(unused)", "REPL", "SCM"
    "Devices", "AI", "Apps", "Traces", "Docs" ]

let viewName (i: Int) : String =
  Stdlib.List.getAt viewNames i |> Stdlib.Option.withDefault "Home"

/// Format a list of (key, label) hints into a footer string: the key in plain
/// white, the label dim, pairs separated by a dim `·`. Quiet on purpose - the
/// help row is a reference, not a call to action - and per the TUI rule "key
/// emphasized, label muted" so shortcuts still read at a glance.
let formatHints (pairs: List<(String * String)>) : String =
  pairs
  |> Stdlib.List.map (fun pair ->
    let (k, l) = pair
    (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.white k) ++ " " ++ (Stdlib.Cli.UI.Colors.dimText l))
  |> Stdlib.String.join (Stdlib.Cli.UI.Colors.dimText " · ")

/// Render a one-row, pre-colored key-hint bar at the bottom of the body. The string is already styled
/// (see `formatHints`), so this just indents + places it.
let renderKeyHints (region: Stdlib.Cli.UI.Layout.Region) (hints: String) : List<Stdlib.Cli.UI.Layout.Span> =
  Stdlib.Cli.UI.Layout.at region 0 0 ("  " ++ hints)
