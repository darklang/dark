/// Assembling the whole frame: the chrome rows around the body, the command bar's completion dropdown,
/// and `viewAtSize`, which is what the terminal session actually renders.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

let renderFull (state: State) (size: Tui.Size) : List<UI.Layout.Span> =
  // Clamp to sane minimums - mid-resize the terminal reports 0/tiny sizes; without this the region math
  // goes negative and the whole view crashes back to the prompt. A safe default renders one off frame; the
  // next keypress picks up the real size.
  let h = if size.height < 8 then 24 else size.height
  let w = if size.width < 24 then 80 else size.width
  // Full height now: the last row used to be reserved for the CLI's status bar, and that's gone.
  let screen = UI.Layout.Region { top = 1; left = 1; rows = h; cols = w }
  // The breadcrumb only earns its row when it has something the rest of the frame doesn't already say.
  //
  // It used to show the view name and item count for every view, which meant "Builtins" appeared three times
  // on screen - the tab bar's ◆ marker, this row, and the pane's own box title - and the count twice. The tab
  // bar owns which view you're in and the box title owns what's in the pane, so all this row can add is a
  // package path. Matter has one; nothing else does, so nothing else gets the row.
  let path =
    if state.activeView == vMatter then Packages.formatLocation state.location else ""
  let branch = state.scmStatus.branchName
  // Off the cached SCM status rather than a query here. This runs per keypress, and it drives both the
  // Resolve tab badge and the context line, so it has to agree with what Home and the SCM view say -- which
  // it can't if each of them counts for itself.
  let conflictCount = Stdlib.List.length state.scmStatus.conflicts
  // Conflicts AND standing findings, because they're one question ("is anything waiting on me?") and they
  // fail the same way when they're separate: the record is correct, and nobody looks. The tab badge stays
  // conflicts-only, since that's the tab it marks.
  //
  // This used to read "✓ synced", which it never was: it counted conflicts and said nothing about sync.
  let needsYou = state.scmStatus.needsYou
  let (syncColored, syncPlain) =
    if needsYou > 0 then
      let s = "⚠ " ++ (Stdlib.Int.toString needsYou) ++ " need you"
      (Colors.colorize Colors.pink s, s)
    else
      (Colors.colorize Colors.green "✓ nothing waiting", "✓ nothing waiting")
  // Columns, not graphemes: `⚠`/`✓` are non-ASCII, and `String.length` counts one per grapheme, so a wide
  // glyph would right-align this past the edge of the row.
  let syncVisibleLen = Tui.Text.displayWidth syncPlain
  // The context line - the workbench's `pwd`: where edits land. Account, instance, branch, and the sync
  // glance right-aligned. Branch is here and nowhere else; it used to be on this row AND the breadcrumb.
  let context =
    UI.Layout.fixedSize
      1
      (fun r ->
        // The draft, split, on the row you always have on screen. This is the highest-value thing in the
        // SCM work and it deliberately does NOT live in the SCM view: "what moved because of what I just
        // did" is asked many times an hour, while you're looking at code, and if the only way to answer it
        // is to switch views then people stop asking and lose track of their own draft.
        //
        // The split rather than the total, because "3 changed" right after you edited one thing is either
        // completely fine or a disaster and the number alone cannot tell you which.
        let draft = scmStatusLine state.scmStatus

        let draftPart =
          if draft == "" then "" else (Colors.dimText ("    " ++ draft))

        // The right-aligned glance is written over this row, so anything the left side spills past its
        // start is simply lost. It used to spill: at 100 columns the draft summary ran under "nothing
        // waiting" and the tail went with it -- and the tail is `N behind`, which is the part people forget
        // they asked for and the least guessable from anywhere else.
        //
        // So drop whole segments in priority order instead of letting the row overwrite itself. The draft
        // split is the most valuable thing here and the branch is the second, so `instance:` goes first and
        // the account name second. Only if it still does not fit does the draft get clipped.
        let room = Stdlib.Int.max 0 (r.cols - syncVisibleLen - 4)

        let widthOf (plain: String) : Int = Tui.Text.displayWidth plain

        let fullPlain =
          "  " ++ state.accountName ++ "    instance: " ++ state.instanceName
          ++ "    branch: " ++ branch ++ (if draft == "" then "" else "    " ++ draft)

        let noInstancePlain =
          "  " ++ state.accountName ++ "    branch: " ++ branch
          ++ (if draft == "" then "" else "    " ++ draft)

        let noAccountPlain =
          "  branch: " ++ branch ++ (if draft == "" then "" else "    " ++ draft)

        let line =
          if widthOf fullPlain <= room then
            "  "
            ++ (Colors.boldText state.accountName)
            ++ (Colors.dimText "    instance: ")
            ++ (Colors.dimText state.instanceName)
            ++ (Colors.dimText "    branch: ")
            ++ (Colors.dimText branch)
            ++ draftPart
          else if widthOf noInstancePlain <= room then
            "  "
            ++ (Colors.boldText state.accountName)
            ++ (Colors.dimText "    branch: ")
            ++ (Colors.dimText branch)
            ++ draftPart
          else if widthOf noAccountPlain <= room then
            "  " ++ (Colors.dimText "branch: ") ++ (Colors.dimText branch) ++ draftPart
          else
            Colors.dimText (Tui.Text.clipToWidth ("  branch: " ++ branch ++ "  " ++ draft) room)

        Stdlib.List.flatten
          [ UI.Layout.at r 0 0 line
            UI.Layout.at r 0 (Stdlib.Int.max 0 (r.cols - syncVisibleLen - 2)) syncColored ])
  let tabSegs = visibleViews state |> Stdlib.List.map (fun i -> (i, viewLabel i))
  let tabbar = UI.Layout.fixedSize 1 (fun r -> Frame.renderTabBar r tabSegs state.activeView conflictCount)
  let crumb = UI.Layout.fixedSize 1 (fun r -> Frame.renderBreadcrumb r path "" 0)
  let body = UI.Layout.greedy (fun r -> renderBody state r)
  let hints =
    UI.Layout.fixedSize
      1
      (fun r ->
        let h =
          match state.editing with
          | Some _ ->
            Frame.formatHints
              [ ("type", "edit"); ("↑↓←→", "move"); ("home/end", "line"); ("^k", "kill"); ("tab", "indent"); ("^s", "save"); ("esc", "cancel") ]
          | None ->
            match state.input with
            | Some inp ->
              // "You can type here" affordance: a bright prompt glyph, the label, the live text, and a
              // reverse-video block caret so it's unmistakable the app is capturing keystrokes. For the command
              // bar, trail a dim ghost of the completion (fish-style; tab accepts it).
              let ghost =
                if inp.action == "command" then Colors.dimText (commandCompletionHint state inp.text)
                else ""
              (Colors.colorize Colors.cyan "› ")
              ++ (Colors.boldText inp.prompt)
              ++ inp.text
              ++ (Colors.colorize Colors.reverse " ")
              ++ ghost
            | None ->
              match state.reading with
              | Some _ -> Frame.formatHints [ ("↑↓", "scroll"); ("PgUp/PgDn", "page"); (":", "cmd"); ("esc", "back") ]
              | None ->
                if Stdlib.Bool.not (Stdlib.List.isEmpty state.searchHits) then
                  Frame.formatHints [ ("↑↓", "move"); ("⏎", "jump"); ("esc", "close"); ("q", "quit") ]
                else hintsForView state r.cols
        // A toast sits *beside* the hints, right-aligned, rather than replacing the row. It used to take the
        // whole row, so every message cost you the shortcuts until you pressed a key to clear it - exactly
        // when a new arrival is most likely to be looking for them.
        // A failure/guidance toast reads pink with ✗; a success reads green with ✓.
        let toastPlain =
          if state.message == "" then
            ""
          else
            let bad =
              (Stdlib.String.contains state.message "fail")
              || (Stdlib.String.contains state.message "conflict")
              || (Stdlib.String.contains state.message "descend")
            (if bad then "✗ " else "✓ ") ++ state.message
        let toastWidth = Tui.Text.displayWidth toastPlain
        let toast =
          if toastPlain == "" then
            []
          else
            let bad = Stdlib.String.startsWith toastPlain "✗"
            let colored = Colors.colorize (if bad then Colors.pink else Colors.green) toastPlain
            UI.Layout.at r 0 (Stdlib.Int.max 0 (r.cols - toastWidth - 2)) colored
        // Clip the hints to stop short of the toast rather than letting the toast overwrite them. Canvas lets a
        // later span truncate an earlier one, which worked, but left the two abutting with no gap on a long
        // hint row - it read as a collision rather than two things sharing a line.
        let hintRoom =
          if toastPlain == "" then r.cols else Stdlib.Int.max 0 (r.cols - toastWidth - 8)
        // An ellipsis where the row was cut, so a hint list that lost its tail reads as truncated rather than
        // as a key whose name happens to end mid-word.
        let shownHints =
          if (Tui.Text.styledWidth h) <= hintRoom then
            h
          else
            (Tui.Text.clipToWidth h (Stdlib.Int.max 0 (hintRoom - 2))) ++ (Colors.dimText "…")
        Stdlib.List.flatten [ Frame.renderKeyHints r shownHints; toast ])
  Stdlib.List.flatten
    [ UI.Layout.vstack screen (Stdlib.List.flatten [ [ context; tabbar ]; (if path == "" then [] else [ crumb ]); [ body; hints ] ])
      if state.showHelp then renderHelpOverlay screen else []
      if state.viewPicker then renderViewPicker state screen else []
      renderCommandCompletions state screen ]


/// The ghost-completion suffix for the `:` command bar - the chars that would complete the current command or
/// argument, from the shared CLI completion engine (so the bar has the same typeahead the classic prompt did).
/// Empty when there's nothing to suggest. Only called while the command bar is open, so the per-frame cost of
/// building a throwaway AppState is bounded to that.
let commandCompletionHint (state: State) (text: String) : String =
  if text == "" then
    ""
  else
    let appState =
      classicState state
    Darklang.Cli.Registry.getCompletionHint appState text

/// The full list of completions for the `:` command bar's current text - the same engine the classic prompt's
/// picker used. Backs the live dropdown so you see the options, not just the ghost of the top one.
let commandCompletions (state: State) (text: String) : List<Darklang.Cli.Completion.CompletionItem> =
  if text == "" then
    []
  else
    let appState =
      classicState state
    Darklang.Cli.Registry.getCompletions appState text

/// Replace the last whitespace-delimited word of `text` with `value` - how accepting a dropdown selection
/// inserts it (the last word is the partial being completed; an empty last word means append a fresh arg).
let applyCompletionValue (text: String) (value: String) : String =
  match Stdlib.List.reverse (Stdlib.String.split text " ") with
  | _last :: revInit ->
    Stdlib.String.join (Stdlib.List.append (Stdlib.List.reverse revInit) [ value ]) " "
  | [] -> value

/// A live dropdown of command completions anchored just above the `:` input line - the "pretty typeahead" menu
/// from the classic prompt. Shown only while the command bar is open and there are matches. Drawn as an overlay
/// (the full frame redraws each keystroke, so it clears itself when the bar closes).
let renderCommandCompletions (state: State) (screen: UI.Layout.Region) : List<UI.Layout.Span> =
  match state.input with
  | None -> []
  | Some inp ->
    if inp.action != "command" then
      []
    else
      let items = commandCompletions state inp.text |> Stdlib.List.take 8
      if Stdlib.List.isEmpty items then
        []
      else
        let n = Stdlib.List.length items
        let boxRows = n + 2
        let footerRow = screen.top + screen.rows - 1
        let top = Stdlib.Int.max screen.top (footerRow - boxRows)
        // Full width so it fully covers the body band underneath (no bleed-through of the body's box borders).
        let region = UI.Layout.Region { top = top; left = screen.left; rows = boxRows; cols = screen.cols }
        UI.Box.panel region "complete  ·  tab to accept" true (fun inner ->
          let rows =
            items
            |> Stdlib.List.indexedMap (fun i item ->
              let selected = i == state.completionSel
              let raw = (if selected then "> " else "  ") ++ item.display
              let line = if selected then Colors.colorize Colors.cyan raw else raw
              UI.Layout.at inner i 0 line)
            |> Stdlib.List.flatten
          // Clear the interior first - this floats over the body, which would otherwise bleed through.
          Stdlib.List.flatten [ UI.Layout.clearRegion inner; rows ])

/// Render the workbench. Below a usable size, show an explicit "too small" hint instead of a garbled frame
/// (per the TUI rule: degrade with a message, never render garbage). A real 0/tiny size mid-resize still falls
/// through to renderFull's clamp, which draws one safe frame until the next keypress.
let viewAtSize (state: State) (size: Tui.Size) : Tui.View =
  let tooSmall =
    (size.width >= 24 && size.width < 56) || (size.height >= 8 && size.height < 12)

  let spans =
    if tooSmall then
      // Two lines, because one was 44 columns wide and the guard fires from 24. The canvas clips at the
      // width, so the single-line version lost its tail -- and the tail was the size you needed, which is
      // the only thing the message is for. Both lines fit in 24.
      let screen =
        UI.Layout.Region { top = 1; left = 1; rows = size.height; cols = size.width }

      let centred (text: String) (row: Int) : List<UI.Layout.Span> =
        let col =
          Stdlib.Int.max 0 (Stdlib.Int.divide (size.width - (Tui.Text.displayWidth text)) 2)
        UI.Layout.at screen row col (Colors.dimText text)

      let row = Stdlib.Int.max 0 (Stdlib.Int.divide size.height 2)

      Stdlib.List.flatten
        [ centred "terminal too small" (Stdlib.Int.max 0 (row - 1))
          centred "resize to at least 56x12" row ]
    else
      renderFull state size

  UI.Canvas.toView size spans
