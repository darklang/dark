/// Assembling the whole frame: the context row, the sidebar beside the body,
/// the footer, the command bar's completion dropdown, and `viewAtSize`, which
/// is what the terminal session actually renders.
///
/// Part of `Darklang.Cli.Workbench`.
module Darklang.Cli.Workbench

let renderFull (state: State) (size: Stdlib.Cli.Tui.Size) : List<Stdlib.Cli.UI.Layout.Span> =
  // Clamp to sane minimums - mid-resize the terminal reports 0/tiny sizes; without this the region math
  // goes negative and the whole view crashes back to the prompt. A safe default renders one off frame; the
  // next keypress picks up the real size.
  let h = if size.height < 8 then 24 else size.height
  let w = if size.width < 24 then 80 else size.width
  // Full height now: the last row used to be reserved for the CLI's status bar, and that's gone.
  let screen = Stdlib.Cli.UI.Layout.Region { top = 1; left = 1; rows = h; cols = w }
  let branch =
    match SCM.Branch.get state.branchId with
    | Some b -> b.name
    | None -> "main"
  // Real state, computed per-frame (render runs per-keypress, so it never
  // goes stale). Drives the glance at the right of the context row and the
  // sidebar's badges.
  let conflictCount = Stdlib.List.length (Darklang.Sync.Conflicts.list ())
  let wip = wipItemCount state.branchId
  // The state segment: green "synced" while nothing needs you, orange "to
  // resolve" when something does.
  let (syncColored, syncPlain) =
    if conflictCount > 0 then
      let s = " ⚠ " ++ (Stdlib.Int.toString conflictCount) ++ " to resolve "
      (Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.orangeBg ++ Stdlib.Cli.UI.Colors.black) s, s)
    else
      (Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.greenBg ++ Stdlib.Cli.UI.Colors.black) " ✓ synced ", " ✓ synced ")
  let (wipColored, wipPlain) =
    if wip > 0 then
      let s = "● " ++ (Stdlib.Int.toString wip) ++ " uncommitted"
      (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.pink s, s ++ "  ")
    else
      ("", "")
  // Columns, not graphemes: `⚠`/`✓`/`●` are non-ASCII, and `String.length`
  // counts one per grapheme, so a wide glyph would right-align this past the
  // edge of the row.
  let glancePlain = wipPlain ++ syncPlain
  let glanceColored = if wip > 0 then wipColored ++ "  " ++ syncColored else syncColored
  let glanceLen = Stdlib.Cli.Tui.Text.displayWidth glancePlain
  // The status row - the workbench's `pwd`, as segments: who (purple), on
  // which instance (grey), on which branch; and at the right, the glance:
  // uncommitted work and sync. This is the only row that says any of it; the
  // panels don't repeat it.
  let account = if state.accountName == "" then "guest" else state.accountName
  let context =
    Stdlib.Cli.UI.Layout.fixedSize
      1
      (fun r ->
        let line =
          " "
          ++ (Stdlib.Cli.UI.Colors.colorize (Stdlib.Cli.UI.Colors.purpleBg ++ Stdlib.Cli.UI.Colors.white ++ Stdlib.Cli.UI.Colors.bold) (" " ++ account ++ " "))
          ++ (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.grayBg (" " ++ state.instanceName ++ " "))
          ++ (Stdlib.Cli.UI.Colors.dimText "  ⎇ ")
          ++ (Stdlib.Cli.UI.Colors.boldText branch)
        Stdlib.List.flatten
          [ Stdlib.Cli.UI.Layout.at r 0 0 line
            Stdlib.Cli.UI.Layout.at r 0 (Stdlib.Int.max 0 (r.cols - glanceLen - 1)) glanceColored ])
  // The body: the sidebar column beside the view when there's room, else the
  // view alone (the sidebar becomes an overlay, see below).
  let sidebarColumn = sidebarIsColumn w
  let body =
    Stdlib.Cli.UI.Layout.greedy (fun r ->
      if sidebarColumn then
        Stdlib.Cli.UI.Layout.hstack
          r
          [ Stdlib.Cli.UI.Layout.fixedWidth sidebarCols (fun rr -> renderSidebar state wip conflictCount rr)
            Stdlib.Cli.UI.Layout.greedyWidth (fun rr -> renderBody state rr) ]
      else
        renderBody state r)
  let hints =
    Stdlib.Cli.UI.Layout.fixedSize
      1
      (fun r ->
        let h =
          match state.editing with
          | Some _ ->
            Frame.formatHints
              [ ("type", "edit"); ("↑↓←→", "move"); ("home/end", "line"); ("^k", "kill"); ("tab", "indent"); ("^s", "save"); ("esc", "cancel") ]
          | None ->
            match state.input with
            | Some inp ->
              // "You can type here" affordance: a bright prompt glyph, the label, the live text, and a
              // reverse-video block caret so it's unmistakable the app is capturing keystrokes. For the command
              // bar, trail a dim ghost of the completion (fish-style; tab accepts it).
              let ghost =
                if inp.action == "command" then Stdlib.Cli.UI.Colors.dimText (commandCompletionHint state inp.field.text)
                else ""
              // The caret comes from the field now, and sits wherever the cursor is rather than always at
              // the end - which is the visible half of being able to move it at all.
              let room =
                Stdlib.Int.max 8 (size.width - 6 - (Stdlib.Cli.Tui.Text.displayWidth inp.prompt))

              (Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.cyan "› ")
              ++ (Stdlib.Cli.UI.Colors.boldText inp.prompt)
              ++ (Stdlib.Cli.UI.TextField.renderInline inp.field room)
              ++ ghost
            | None ->
              match state.reading with
              | Some _ -> Frame.formatHints [ ("↑↓", "scroll"); ("PgUp/PgDn", "page"); (":", "cmd"); ("esc", "back") ]
              | None ->
                if Stdlib.Bool.not (Stdlib.List.isEmpty state.search.hits) then
                  Frame.formatHints [ ("↑↓", "move"); ("⏎", "jump"); ("esc", "close"); ("q", "quit") ]
                else hintsForView state
        // A toast sits *beside* the hints, right-aligned, rather than
        // replacing the row. It used to take the whole row, so every message
        // cost you the shortcuts until you pressed a key to clear it -
        // exactly when a new arrival is most likely to be looking for them. A
        // failure/guidance toast reads pink with ✗; a success reads green
        // with ✓. Drawn as a segment (dark text on green, or on pink for a
        // failure), like the status row's.
        let toastPlain =
          if state.message == "" then
            ""
          else
            let bad =
              (Stdlib.String.contains state.message "fail")
              || (Stdlib.String.contains state.message "conflict")
              || (Stdlib.String.contains state.message "descend")
            (if bad then " ✗ " else " ✓ ") ++ state.message ++ " "
        let toastWidth = Stdlib.Cli.Tui.Text.displayWidth toastPlain
        let toast =
          if toastPlain == "" then
            []
          else
            let bad = Stdlib.String.startsWith toastPlain " ✗"
            let colored =
              Stdlib.Cli.UI.Colors.colorize ((if bad then Stdlib.Cli.UI.Colors.pinkBg else Stdlib.Cli.UI.Colors.greenBg) ++ Stdlib.Cli.UI.Colors.black) toastPlain
            Stdlib.Cli.UI.Layout.at r 0 (Stdlib.Int.max 0 (r.cols - toastWidth - 1)) colored
        // Clip the hints to stop short of the toast rather than letting the toast overwrite them. Canvas lets a
        // later span truncate an earlier one, which worked, but left the two abutting with no gap on a long
        // hint row - it read as a collision rather than two things sharing a line.
        let hintRoom =
          if toastPlain == "" then r.cols else Stdlib.Int.max 0 (r.cols - toastWidth - 8)
        // An ellipsis where the row was cut, so a hint list that lost its tail reads as truncated rather than
        // as a key whose name happens to end mid-word.
        let shownHints =
          if (Stdlib.Cli.Tui.Text.styledWidth h) <= hintRoom then
            h
          else
            (Stdlib.Cli.Tui.Text.clipToWidth h (Stdlib.Int.max 0 (hintRoom - 2))) ++ (Stdlib.Cli.UI.Colors.dimText "…")
        Stdlib.List.flatten [ Frame.renderKeyHints r shownHints; toast ])
  Stdlib.List.flatten
    [ Stdlib.Cli.UI.Layout.vstack screen [ context; body; hints ]
      match state.overlay with
      | NoOverlay -> []
      | Keymap -> renderHelpOverlay screen
      // A narrow terminal has no sidebar column, so focusing the sidebar
      // draws it as an overlay instead.
      if (sidebarFocused state) && (Stdlib.Bool.not sidebarColumn) then
        renderSidebarOverlay state wip conflictCount screen
      else
        []
      renderCommandCompletions state screen ]


/// The ghost-completion suffix for the `:` command bar - the chars that would complete the current command or
/// argument, from the shared CLI completion engine (so the bar has the same typeahead the classic prompt did).
/// Empty when there's nothing to suggest. Only called while the command bar is open, so the per-frame cost of
/// building a throwaway AppState is bounded to that.
let commandCompletionHint (state: State) (text: String) : String =
  if text == "" then
    ""
  else
    let appState =
      classicState state
    Darklang.Cli.Registry.getCompletionHint appState text

/// The full list of completions for the `:` command bar's current text - the same engine the classic prompt's
/// picker used. Backs the live dropdown so you see the options, not just the ghost of the top one.
let commandCompletions (state: State) (text: String) : List<Darklang.Cli.Completion.CompletionItem> =
  if text == "" then
    []
  else
    let appState =
      classicState state
    Darklang.Cli.Registry.getCompletions appState text

/// Replace the last whitespace-delimited word of `text` with `value` - how accepting a dropdown selection
/// inserts it (the last word is the partial being completed; an empty last word means append a fresh arg).
let applyCompletionValue (text: String) (value: String) : String =
  match Stdlib.List.reverse (Stdlib.String.split text " ") with
  | _last :: revInit ->
    Stdlib.String.join (Stdlib.List.append (Stdlib.List.reverse revInit) [ value ]) " "
  | [] -> value

/// A live dropdown of command completions anchored just above the `:` input line - the "pretty typeahead" menu
/// from the classic prompt. Shown only while the command bar is open and there are matches. Drawn as an overlay
/// (the full frame redraws each keystroke, so it clears itself when the bar closes).
let renderCommandCompletions (state: State) (screen: Stdlib.Cli.UI.Layout.Region) : List<Stdlib.Cli.UI.Layout.Span> =
  match state.input with
  | None -> []
  | Some inp ->
    if inp.action != "command" then
      []
    else
      let items = commandCompletions state inp.field.text |> Stdlib.List.take 8
      if Stdlib.List.isEmpty items then
        []
      else
        let n = Stdlib.List.length items
        let boxRows = n + 2
        let footerRow = screen.top + screen.rows - 1
        let top = Stdlib.Int.max screen.top (footerRow - boxRows)
        // Full width so it fully covers the body band underneath (no bleed-through of the body's box borders).
        let region = Stdlib.Cli.UI.Layout.Region { top = top; left = screen.left; rows = boxRows; cols = screen.cols }
        Stdlib.Cli.UI.Box.panel region "complete  ·  tab to accept" true (fun inner ->
          let rows =
            items
            |> Stdlib.List.indexedMap (fun i item ->
              let raw = "  " ++ item.display
              let line =
                if i == state.completionSel then selectionRow inner.cols raw else raw
              Stdlib.Cli.UI.Layout.at inner i 0 line)
            |> Stdlib.List.flatten
          // Clear the interior first - this floats over the body, which would otherwise bleed through.
          Stdlib.List.flatten [ Stdlib.Cli.UI.Layout.clearRegion inner; rows ])

/// Render the workbench. Below a usable size, show an explicit "too small" hint instead of a garbled frame
/// (per the TUI rule: degrade with a message, never render garbage). A real 0/tiny size mid-resize still falls
/// through to renderFull's clamp, which draws one safe frame until the next keypress.
let viewAtSize (state: State) (size: Stdlib.Cli.Tui.Size) : Stdlib.Cli.Tui.View =
  let tooSmall =
    (size.width >= 24 && size.width < 56) || (size.height >= 8 && size.height < 12)

  let spans =
    if tooSmall then
      let msg = "terminal too small - resize to at least 56x12"
      let screen =
        Stdlib.Cli.UI.Layout.Region { top = 1; left = 1; rows = size.height; cols = size.width }
      let row = Stdlib.Int.max 0 (Stdlib.Int.divide size.height 2)
      let col =
        Stdlib.Int.max 0 (Stdlib.Int.divide (size.width - (Stdlib.Cli.Tui.Text.displayWidth msg)) 2)
      Stdlib.Cli.UI.Layout.at screen row col (Stdlib.Cli.UI.Colors.dimText msg)
    else
      renderFull state size

  Stdlib.Cli.UI.Canvas.toView size spans
