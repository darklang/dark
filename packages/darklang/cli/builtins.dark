module Darklang.Cli.Builtins

// Known groups in display order with their display names.
// Format: (prefix, displayName)
//
// The prefix is what `extractGroup` reads off a builtin's name: the longest prefix here that ends
// where a word does, so `bigIntParse` is `bigInt`, and otherwise the characters before the first
// capital, so `int64ToString` is `int64` and `httpClientRequest` is `http`. A prefix with no
// entry here is shown uppercased and sorted after every named group, which is how 49 of the
// 69 live prefixes were being displayed -- including `pm` (57 builtins) and the whole integer
// family (302 between them). `tests/cli/builtinGroups.dark` fails when a prefix carrying three
// or more builtins has no entry, and when an entry here names a prefix no builtin carries.
val knownGroups =
  [ ("bigInt", "BigInt")
    ("int8", "Int8")
    ("int16", "Int16")
    ("int32", "Int32")
    ("int64", "Int64")
    ("int128", "Int128")
    ("uint8", "UInt8")
    ("uint16", "UInt16")
    ("uint32", "UInt32")
    ("uint64", "UInt64")
    ("uint128", "UInt128")
    ("float64", "Float64")
    ("float32", "Float32")
    ("decimal", "Decimal")
    ("bool", "Bool")
    ("char", "Char")
    ("codepoint", "Codepoint")
    ("string", "String")
    ("list", "List")
    ("dict", "Dict")
    ("bytes", "Bytes")
    ("stream", "Stream")
    ("json", "JSON")
    ("utf8", "UTF-8")
    ("base16", "Base16")
    ("base64", "Base64")
    ("uuid", "UUID")
    ("date", "DateTime")
    ("math", "Math")
    ("bitwise", "Bitwise")
    ("crypto", "Crypto")
    ("x509", "X509")
    ("http", "HTTP")
    ("regex", "Regex")
    ("cli", "CLI")
    ("stdin", "Stdin")
    ("stdout", "Stdout")
    ("syscall", "Syscall")
    ("host", "Host")
    ("exec", "Exec")
    ("local", "Local DB")
    ("config", "Config")
    ("pm", "Package Manager")
    ("scm", "SCM")
    ("traces", "Traces")
    ("test", "Test")
    ("runtime", "Runtime")
    ("interpreter", "Interpreter")
    ("applicable", "Applicable")
    // A misnomer the table cannot fix: these six are `getAllBuiltinFns`, `getBuildHash` and
    // friends, which are reflection rather than a `get` family. The real fix is to rename the
    // builtins, which moves their `Builtin.x` wrappers too, so it is not done in passing.
    ("get", "Reflection")
    ("print", "Print") ]


// Extract the group prefix from a camelCase builtin name
let extractGroup(name: String): String =
  let endsAWord(prefix: String): Bool =
    let rest = Stdlib.String.dropFirst(name, Stdlib.String.length(prefix))
    let atCapital =
      match Stdlib.String.head(rest) with
      | Some(c) -> Stdlib.Char.isUppercase(c)
      | None -> true

    Stdlib.String.startsWith(name, prefix) && atCapital

  let known =
    knownGroups
    |> Stdlib.List.map(fun((prefix, _)) -> prefix)
    |> Stdlib.List.filter(fun prefix -> endsAWord(prefix))
    |> Stdlib.List.maxBy(fun prefix -> Stdlib.String.length(prefix))

  match known with
  | Some(prefix) -> prefix
  | None ->
    let groupChars =
      Stdlib.List.takeWhile(Stdlib.String.toList(name), fun c ->
        Stdlib.Bool.not(Stdlib.Char.isUppercase(c)))

    if Stdlib.List.isEmpty(groupChars) then
      "other"
    else
      Stdlib.String.fromList(groupChars)


let getDisplayName(prefix: String): String =
  let found = Stdlib.List.findFirst(knownGroups, fun((groupPrefix, _)) -> groupPrefix == prefix)
  match found with
  | Some((_, displayName)) -> displayName
  | None -> Stdlib.String.toUppercase(prefix)


let isKnownGroup(prefix: String): Bool =
  Stdlib.List.any(knownGroups, fun((groupPrefix, _)) -> groupPrefix == prefix)


let versionSuffix(v: Int32): String =
  if v == 0s32 then "" else $"_v{Stdlib.display(v)}"


let purityTag(purity: LanguageTools.BuiltinFunctionPurity): String =
  match purity with
  | Pure -> "[pure]"
  | Impure -> "[impure]"


// Sort groups: known groups first in order, then unknown groups alphabetically
let sortGroups(
  groups: List<(String * List<LanguageTools.BuiltinFunction>)>)
  : List<(String * List<LanguageTools.BuiltinFunction>)> =
  let knownPrefixes = Stdlib.List.map(knownGroups, fun((groupPrefix, _)) -> groupPrefix)
  let knownInOrder =
    knownPrefixes
    |> Stdlib.List.filterMap(fun prefix ->
      let found = Stdlib.List.findFirst(groups, fun((groupPrefix, _)) -> groupPrefix == prefix)
      found)

  let unknown =
    groups
    |> Stdlib.List.filter(fun((groupPrefix, _)) -> Stdlib.Bool.not(isKnownGroup(groupPrefix)))
    |> Stdlib.List.sortBy(fun((groupPrefix, _)) -> groupPrefix)

  Stdlib.List.concat(knownInOrder, unknown)


/// The builtin values whose name contains <param filter>, or all of them without one.
let matchingValues(filter: Option<String>): List<LanguageTools.BuiltinValue> =
  let all = LanguageTools.allBuiltinValues()
  match filter with
  | None -> all
  | Some(pattern) ->
    all |> Stdlib.List.filter(fun v -> Stdlib.String.contains(v.name.name, pattern))


let execute(state: AppState, args: List<String>): AppState =
  let allBuiltins = LanguageTools.allBuiltinFns()
  let withSigs = Stdlib.List.any(args, fun arg -> arg == "--with-sigs")
  let withPurity = Stdlib.List.any(args, fun arg -> arg == "--with-purity")
  let filterArgs =
    args |> Stdlib.List.filter(fun arg -> arg != "--with-sigs" && arg != "--with-purity")

  let filter =
    match filterArgs with
    | [] -> Option.None
    | [pattern] -> Option.Some(pattern)
    | _ -> Option.None

  let grouped =
    allBuiltins
    |> Stdlib.List.fold(Stdlib.Dict.empty, fun(acc, fn) ->
      let group = extractGroup(fn.name.name)
      let existing =
        match Stdlib.Dict.get(acc, group) with
        | Some(list) -> list
        | None -> []

      Stdlib.Dict.set(acc, group, Stdlib.List.append(existing, fn)))

  let allGroups = Stdlib.Dict.toEntries(grouped)
  let sortedGroups = sortGroups(allGroups)
  let filteredGroups =
    match filter with
    | None -> sortedGroups
    | Some(pattern) ->
      sortedGroups
      |> Stdlib.List.filterMap(fun pair ->
        let group = Stdlib.Tuple2.first(pair)
        let fns = Stdlib.Tuple2.second(pair)
        let matchingFns =
          fns
          |> Stdlib.List.filter(fun fn ->
            Stdlib.String.contains(fn.name.name, pattern) || Stdlib.String.contains(group, pattern))

        if Stdlib.List.isEmpty(matchingFns) then
          Option.None
        else
          Option.Some((group, matchingFns)))

  if withSigs then
    filteredGroups
    |> Stdlib.List.iter(fun pair ->
      let group = Stdlib.Tuple2.first(pair)
      let fns = Stdlib.Tuple2.second(pair)
      Stdlib.printLine("")

      Stdlib.printLine(
        Stdlib.Cli.UI.Colors.colorize(Stdlib.Cli.UI.Colors.bold, getDisplayName(group)))

      fns
      |> Stdlib.List.iter(fun fn ->
        let branchId = SCM.Branch.mainBranchId
        let params =
          fn.parameters
          |> Stdlib.List.map(fun p ->
            let typStr = PrettyPrinter.RuntimeTypes.typeReference(branchId, p.type)
            $"{p.name}: {typStr}")
          |> Stdlib.String.join(", ")

        let returnTypeStr = PrettyPrinter.RuntimeTypes.typeReference(branchId, fn.returnType)
        let suffix = if withPurity then $" {purityTag(fn.purity)}" else ""
        Stdlib.printLine(
          $"  {fn.name.name}{versionSuffix(fn.name.version)}({params}) -> {returnTypeStr}{suffix}")))
  else
    // Compact output: comma-separated names
    filteredGroups
    |> Stdlib.List.iter(fun pair ->
      let group = Stdlib.Tuple2.first(pair)
      let fns = Stdlib.Tuple2.second(pair)
      let names =
        fns
        |> Stdlib.List.map(fun fn ->
          let suffix = if withPurity then $" {purityTag(fn.purity)}" else ""
          $"{fn.name.name}{versionSuffix(fn.name.version)}{suffix}")
        |> Stdlib.String.join(", ")

      Stdlib.printLine("")

      Stdlib.printLine(
        $"{Stdlib.Cli.UI.Colors.colorize(Stdlib.Cli.UI.Colors.bold, getDisplayName(group))}: {names}"))

  let values = matchingValues(filter)
  let valuesHeading = Stdlib.Cli.UI.Colors.colorize(Stdlib.Cli.UI.Colors.bold, "Values")
  if Stdlib.List.isEmpty(values) then
    ()
  else if withSigs then
    Stdlib.printLine("")
    Stdlib.printLine(valuesHeading)
    values
    |> Stdlib.List.iter(fun v ->
      let typStr = PrettyPrinter.RuntimeTypes.typeReference(SCM.Branch.mainBranchId, v.type)
      Stdlib.printLine($"  {v.name.name}{versionSuffix(v.name.version)}: {typStr}"))
  else
    let names =
      values
      |> Stdlib.List.map(fun v -> $"{v.name.name}{versionSuffix(v.name.version)}")
      |> Stdlib.String.join(", ")

    Stdlib.printLine("")
    Stdlib.printLine($"{valuesHeading}: {names}")

  let totalCount =
    filteredGroups
    |> Stdlib.List.map(fun pair -> Stdlib.List.length(Stdlib.Tuple2.second(pair)))
    |> Stdlib.List.fold(0, fun(acc, n) -> acc + n)

  let fnCount = Stdlib.display(totalCount)
  let valueCount = Stdlib.List.length(values)
  let valueText = Stdlib.display(valueCount) + (if valueCount == 1 then " value" else " values")
  let summary =
    match filter with
    | None -> $"Total: {fnCount} builtin functions, {valueText}"
    | Some(pattern) -> $"Showing {fnCount} functions and {valueText} matching '{pattern}'"

  Stdlib.printErrorLine("")
  Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.hint(summary))
  if Stdlib.Bool.not(withSigs) then
    Stdlib.printErrorLine(
      Stdlib.Cli.UI.Colors.hint(
        "Use --with-sigs to see full function signatures, --with-purity to tag pure/impure"))

  state


let help(_state: AppState): String =
  [ "Usage: builtins [--with-sigs] [--with-purity] [filter]"
    ""
    "Lists all builtin functions grouped by category, then the builtin values."
    ""
    "Options:"
    "  --with-sigs    Show full function signatures with parameter types"
    "  --with-purity  Tag each fn with [pure] / [impure]"
    ""
    "Arguments:"
    "  filter         Optional pattern to filter fns by name or group, values by name"
    ""
    "Examples:"
    "  builtins                                - List all builtins (compact)"
    "  builtins --with-sigs                    - List all builtins with signatures"
    "  builtins --with-purity                  - Compact + purity tag"
    "  builtins --with-sigs --with-purity http - HTTP fns, sigs + purity"
    "  builtins json                           - Filter by 'json'" ]
  |> Stdlib.String.join("\n")


let complete(state: AppState, args: List<String>): List<Completion.CompletionItem> =
  []
