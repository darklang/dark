module Darklang.Cli.Builtins

// Known groups in display order with their display names
// Format: (prefix, displayName)
val knownGroups =
  [ ("int", "Int")
    ("float", "Float")
    ("bool", "Bool")
    ("char", "Char")
    ("string", "String")
    ("list", "List")
    ("dict", "Dict")
    ("tuple", "Tuple")
    ("option", "Option")
    ("result", "Result")
    ("bytes", "Bytes")
    ("json", "JSON")
    ("altJson", "AltJSON")
    ("base64", "Base64")
    ("uuid", "UUID")
    ("date", "DateTime")
    ("math", "Math")
    ("random", "Random")
    ("crypto", "Crypto")
    ("x509", "X509")
    ("http", "HTTP")
    ("httpClient", "HttpClient")
    ("parser", "Parser")
    ("regex", "Regex")
    ("cli", "CLI")
    ("debug", "Debug")
    ("print", "Print") ]


// Extract the group prefix from a camelCase builtin name
let extractGroup (name: String): String =
  let chars = Stdlib.String.toList name

  let groupChars =
    Stdlib.List.takeWhile chars (fun c -> Stdlib.Bool.not (Stdlib.Char.isUppercase c))

  if Stdlib.List.isEmpty groupChars then
    "other"
  else
    Stdlib.String.fromList groupChars


let getDisplayName (prefix: String): String =
  let found =
    Stdlib.List.findFirst knownGroups (fun (groupPrefix, _) -> groupPrefix == prefix)

  match found with
  | Some((_, displayName)) -> displayName
  | None -> Stdlib.String.toUppercase prefix


/// Group label. Platform and effect names are already display-ready; module prefixes need the
/// table.
let getDisplayNameFor (alreadyADisplayName: Bool) (prefix: String) : String =
  if alreadyADisplayName then prefix else getDisplayName prefix


let isKnownGroup (prefix: String): Bool =
  Stdlib.List.any knownGroups (fun (groupPrefix, _) -> groupPrefix == prefix)


let versionSuffix (v: Int32) : String =
  if v == 0l then "" else $"_v{Stdlib.Int32.toString v}"


let purityTag (purity: LanguageTools.BuiltinFunctionPurity) : String =
  match purity with
  | Pure -> "[pure]"
  | ImpurePreviewable -> "[impure-previewable]"
  | Impure -> "[impure]"


/// Marks a builtin that only bundled first-party Dark may call, whatever the policy says.
///
/// Always shown, not behind a flag. A second gate you have to ask for is a second gate nobody
/// knows to ask about, and the whole point of listing it is that it was invisible.
let trustTag (fn: LanguageTools.BuiltinFunction) : String =
  if fn.firstPartyOnly then " *" else ""


// Sort groups: known groups first in order, then unknown groups alphabetically
let sortGroups
  (groups: List<String * List<LanguageTools.BuiltinFunction>>)
  : List<String * List<LanguageTools.BuiltinFunction>> =
  let knownPrefixes = Stdlib.List.map knownGroups (fun (groupPrefix, _) -> groupPrefix)

  let knownInOrder =
    knownPrefixes
    |> Stdlib.List.filterMap (fun prefix ->
      let found =
        Stdlib.List.findFirst groups (fun (groupPrefix, _) -> groupPrefix == prefix)

      found)

  let unknown =
    groups
    |> Stdlib.List.filter (fun (groupPrefix, _) ->
      Stdlib.Bool.not (isKnownGroup groupPrefix))
    |> Stdlib.List.sortBy (fun (groupPrefix, _) -> groupPrefix)

  Stdlib.List.append knownInOrder unknown


/// Builtin name -> the platform that declares it.
///
/// Derived from the installed platforms rather than from a table of name prefixes. A prefix table
/// has no way to learn about a builtin added after it was written, and no way to be wrong out
/// loud when it guesses a module that does not exist.
let platformOf (name: String) : String =
  let owning =
    LanguageTools.platforms ()
    |> Stdlib.List.findFirst (fun p -> Stdlib.List.``member`` p.fns name)

  match owning with
  | Some p -> p.name
  | None -> "(no platform)"


/// How many DISTINCT builtins these groups hold.
///
/// Not the sum of the group sizes: under `--by-effect` a function reaching two effects is listed
/// under both, and adding the sizes would report more builtins than exist.
let countDistinct
  (groups: List<String * List<LanguageTools.BuiltinFunction>>)
  : Int =
  groups
  |> Stdlib.List.map (fun (_, fns) -> fns |> Stdlib.List.map (fun fn -> fn.name.name))
  |> Stdlib.List.flatten
  |> Stdlib.List.unique
  |> Stdlib.List.length


let execute (state: AppState) (args: List<String>): AppState =
  let allBuiltins = LanguageTools.allBuiltinFns ()

  let withSigs = Stdlib.List.any args (fun arg -> arg == "--with-sigs")
  let withPurity = Stdlib.List.any args (fun arg -> arg == "--with-purity")
  let byPlatform = Stdlib.List.any args (fun arg -> arg == "--by-platform")
  let byEffect = Stdlib.List.any args (fun arg -> arg == "--by-effect")

  let filterArgs =
    args
    |> Stdlib.List.filter (fun arg ->
      arg != "--with-sigs"
      && arg != "--with-purity"
      && arg != "--by-platform"
      && arg != "--by-effect")

  let filter =
    match filterArgs with
    | [] -> Stdlib.Option.Option.None
    | [ pattern ] -> Stdlib.Option.Option.Some pattern
    | _ -> Stdlib.Option.Option.None

  // One builtin can land in SEVERAL groups, which is only true of `--by-effect`: a function that
  // reaches two effects is a door to both, and counting it once under whichever came first would
  // undercount exactly the functions worth looking at.
  let placements =
    allBuiltins
    |> Stdlib.List.map (fun fn ->
      let groups =
        if byEffect then
          if Stdlib.List.isEmpty fn.effects then [ "(reaches nothing)" ] else fn.effects
        else if byPlatform then
          [ platformOf fn.name.name ]
        else
          [ extractGroup fn.name.name ]

      groups |> Stdlib.List.map (fun group -> (group, fn)))
    |> Stdlib.List.flatten

  let grouped =
    placements
    |> Stdlib.List.fold Stdlib.Dict.empty (fun acc (group, fn) ->
      let existing =
        match Stdlib.Dict.get acc group with
        | Some list -> list
        | None -> []

      Stdlib.Dict.setOverridingDuplicates
        acc
        group
        (Stdlib.List.append existing [ fn ]))

  let allGroups = Stdlib.Dict.toList grouped

  // Platform names have no canonical display order, so sort them by size: the biggest platform is
  // the one worth looking at first, and how much of the total `Core` is says what shape the whole
  // floor has.
  let sortedGroups =
    if byEffect then
      // Widest first. The effect with the most doors is the one a policy rule says least about,
      // so it is the one worth reading, and "(reaches nothing)" sinks to the bottom on its own
      // only if it is small, which it is not: it goes last explicitly.
      let (nothing, reaching) =
        allGroups
        |> Stdlib.List.partition (fun (name, _) -> name == "(reaches nothing)")

      Stdlib.List.append
        (reaching
         |> Stdlib.List.sortBy (fun pair ->
           0 - (Stdlib.List.length (Stdlib.Tuple2.second pair))))
        nothing
    else if byPlatform then
      allGroups
      |> Stdlib.List.sortBy (fun pair ->
        0 - (Stdlib.List.length (Stdlib.Tuple2.second pair)))
    else
      sortGroups allGroups

  let filteredGroups =
    match filter with
    | None -> sortedGroups
    | Some pattern ->
      sortedGroups
      |> Stdlib.List.filterMap (fun pair ->
        let group = Stdlib.Tuple2.first pair
        let fns = Stdlib.Tuple2.second pair

        let matchingFns =
          fns
          |> Stdlib.List.filter (fun fn ->
            (Stdlib.String.contains fn.name.name pattern)
            || (Stdlib.String.contains group pattern))

        if Stdlib.List.isEmpty matchingFns then
          Stdlib.Option.Option.None
        else
          Stdlib.Option.Option.Some ((group, matchingFns)))

  if withSigs then
    filteredGroups
    |> Stdlib.List.iter (fun pair ->
      let group = Stdlib.Tuple2.first pair
      let fns = Stdlib.Tuple2.second pair
      Stdlib.printLine ""
      Stdlib.printLine
        (Stdlib.Cli.UI.Colors.colorize
          Stdlib.Cli.UI.Colors.bold
          (getDisplayNameFor (byPlatform || byEffect) group))

      fns
      |> Stdlib.List.iter (fun fn ->
        let branchId = SCM.Branch.mainBranchId

        let params =
          fn.parameters
          |> Stdlib.List.map (fun p ->
            let typStr = PrettyPrinter.RuntimeTypes.typeReference branchId p.``type``
            $"{p.name}: {typStr}")
          |> Stdlib.String.join ", "

        let returnTypeStr =
          PrettyPrinter.RuntimeTypes.typeReference branchId fn.returnType

        let suffix =
          if withPurity then $" {purityTag fn.purity}" else ""

        Stdlib.printLine
          $"  {fn.name.name}{versionSuffix fn.name.version}({params}) -> {returnTypeStr}{suffix}{trustTag fn}"))
  else
    // Compact output: comma-separated names
    filteredGroups
    |> Stdlib.List.iter (fun pair ->
      let group = Stdlib.Tuple2.first pair
      let fns = Stdlib.Tuple2.second pair

      let names =
        fns
        |> Stdlib.List.map (fun fn ->
          let suffix =
            if withPurity then $" {purityTag fn.purity}" else ""
          $"{fn.name.name}{versionSuffix fn.name.version}{suffix}{trustTag fn}")
        |> Stdlib.String.join ", "

      Stdlib.printLine ""
      let label =
        Stdlib.Cli.UI.Colors.colorize
          Stdlib.Cli.UI.Colors.bold
          (getDisplayNameFor (byPlatform || byEffect) group)

      Stdlib.printLine $"{label}: {names}")

  // DISTINCT, not the sum of the groups: under `--by-effect` a function reaching two effects is
  // listed under both, and adding the group sizes would report more builtins than exist.
  let totalCount = Builtins.countDistinct filteredGroups

  let reaching =
    filteredGroups
    |> Stdlib.List.filter (fun (name, _) -> name != "(reaches nothing)")
    |> Builtins.countDistinct

  let summary =
    match filter with
    | Some pattern ->
      $"Showing {Stdlib.Int.toString totalCount} functions matching '{pattern}'"
    | None ->
      if byEffect then
        // The number worth reading here is how much of the surface is a door at all. Most of it
        // is arithmetic and string handling, and that is the encouraging half of the door count.
        $"{Stdlib.Int.toString reaching} of {Stdlib.Int.toString totalCount} builtins reach an effect; the rest are doors to nothing"
      else
        $"Total: {Stdlib.Int.toString totalCount} builtin functions"

  [ ""
    Stdlib.Cli.UI.Colors.hint summary ]
  |> Stdlib.printLines

  // Only when one is on screen. A legend for a mark nobody saw is noise on every other run.
  let anyFirstParty =
    filteredGroups
    |> Stdlib.List.map (fun (_, fns) -> fns)
    |> Stdlib.List.flatten
    |> Stdlib.List.any (fun fn -> fn.firstPartyOnly)

  if anyFirstParty then
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.hint
        "* only bundled first-party Dark may call this, whatever the policy says")

  if Stdlib.Bool.not withSigs then
    Stdlib.printLine (Stdlib.Cli.UI.Colors.hint "Use --with-sigs to see full function signatures, --with-purity to tag pure/impure")

  state


let help (_state: AppState) : String =
  [ "Usage: builtins [--by-platform | --by-effect] [--with-sigs] [--with-purity] [filter]"
    ""
    "Lists all builtin functions, grouped by name prefix."
    ""
    "Options:"
    "  --by-effect    Group by what a fn may DO, widest effect first. A fn reaching two"
    "                 effects appears under both, since it is a door to both. Read it to"
    "                 see which effects are categories rather than capabilities."
    "  --by-platform  Group by the platform that declares each fn, biggest first,"
    "                 instead of by name prefix. The prefixes are a display"
    "                 convention; the platforms are what a binary actually links"
    "                 and what a policy actually grants. They disagree in places"
    "                 worth seeing: `intRandom` looks like an Int function and is"
    "                 in `Random`."
    "  --with-sigs    Show full function signatures with parameter types"
    "  --with-purity  Tag each fn with [pure] / [impure-previewable] / [impure]"
    ""
    "Arguments:"
    "  filter         Optional pattern to filter functions by name or group"
    ""
    "Examples:"
    "  builtins                                - List all builtins (compact)"
    "  builtins --by-platform                  - Grouped by platform"
    "  builtins --with-sigs                    - List all builtins with signatures"
    "  builtins --with-purity                  - Compact + purity tag"
    "  builtins --with-sigs --with-purity http - HTTP fns, sigs + purity"
    "  builtins json                           - Filter by 'json'" ]
  |> Stdlib.String.join "\n"


let complete
  (state: AppState)
  (args: List<String>)
  : List<Completion.CompletionItem> =
  []
