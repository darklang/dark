module Darklang.Cli.Quit


let execute(state: AppState, _args: List<String>): AppState =
  match state.pageStack with
  | [returnTo, ...rest] ->
    // Launched from another page (e.g. the workbench): go back instead of leaving the CLI. Resuming the
    // launcher restarts its terminal session and repaints, rather than us poking the alt-screen here.
    let resumed =
      match returnTo with
      | SubApp app -> Page.SubApp (app.onResume())
      | other -> other
    { state with currentPage = resumed, pageStack = rest }
  | [] ->
    Stdlib.printLine("Goodbye!")
    { state with isExiting = true }


let complete(_state: AppState, _args: List<String>): List<Completion.CompletionItem> =
  []


let help(_state: AppState): String =
  [
    "Usage: quit"
    "Exit the CLI immediately."
  ] |> Stdlib.String.join("\n")

