module Darklang.Cli.Tests


type TestResult =
  | Pass
  | Fail of message: String


let runWithCommand (args: List<String>): String =
  let escapedArgs =
    args
    |> Stdlib.List.map (fun arg ->
      if Stdlib.String.contains arg " " ||
          Stdlib.String.contains arg "|" ||
          Stdlib.String.contains arg "\""
      then
        let escapedArg = Stdlib.String.replaceAll arg "\"" "\\\""
        $"'{escapedArg}'"
      else arg)

  let argsString = Stdlib.String.join escapedArgs " "
  let command = $"./scripts/run-cli {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput "." command

  if result.exitCode == 0 then
    Stdlib.String.trim result.stdout
  else
    $"ERROR: {result.stderr}"


let testHelpCommand (): TestResult =
  let output = runWithCommand ["help"]

  // Help is grouped by category now, so assert on the groups and a command from a few of them rather than
  // on a heading that no longer exists.
  if Stdlib.String.contains output "Packages:" &&
      Stdlib.String.contains output "nav" &&
      Stdlib.String.contains output "help" &&
      Stdlib.String.contains output "version" &&
      Stdlib.String.contains output "status" then
      TestResult.Pass
  else
    TestResult.Fail "Expected help text grouped by category, listing nav/help/version/status"


let testVersionCommand (): TestResult =
  let output = runWithCommand ["version"]
  if Stdlib.String.contains output "Darklang CLI" &&
      Stdlib.String.contains output "alpha-" then
      TestResult.Pass
  else
    TestResult.Fail "Expected version string with 'Darklang CLI alpha-'"


let testStatusCommand (): TestResult =
  let output = runWithCommand ["status"]
  if Stdlib.String.contains output "On branch" &&
      (Stdlib.String.contains output "No uncommitted changes." ||
       Stdlib.String.contains output "Uncommitted changes:") then
    TestResult.Pass
  else
    TestResult.Fail "Expected status output with branch and uncommitted change summary"


let testRunBoolAnd (): TestResult =
  // `run` is for script files now; calling a package function is `eval`'s job, without the `@`.
  let output = runWithCommand ["eval"; "Stdlib.Bool.and true false"]
  if output == "false" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected 'false', got '{output}'"


let testRunInt64Add (): TestResult =
  let output = runWithCommand ["eval"; "Stdlib.Int64.add 5L 3L"]
  if output == "8" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '8', got '{output}'"


let testEvalStringLength (): TestResult =
  let output = runWithCommand ["eval"; "Stdlib.String.length \"hello\""]
  if output == "5" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '5', got '{output}'"


let testEvalListLength (): TestResult =
  let output = runWithCommand ["eval"; "[1; 2; 3] |> Stdlib.List.length"]
  if output == "3" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '3', got '{output}'"


let testListFunctions (): TestResult =
  let output = runWithCommand ["ls"; "Stdlib.List"]
  if Stdlib.String.contains output "Functions" &&
      Stdlib.String.contains output "head" then
      TestResult.Pass
  else
    TestResult.Fail "Expected directory listing with functions"


let testViewFunction (): TestResult =
  let output = runWithCommand ["view"; "Stdlib.List.head"]
  Builtin.debug "output" output
  if Stdlib.String.contains output "head"
    && Stdlib.String.contains output "Option"
    && Stdlib.String.contains output "->"
  then
      TestResult.Pass
  else
    TestResult.Fail "Expected function signature for List.head"


let testListTypes (): TestResult =
  let output = runWithCommand ["ls"; "Stdlib.Option"]
  if Stdlib.String.contains output "Types" &&
      Stdlib.String.contains output "Option" then
      TestResult.Pass
  else
    TestResult.Fail "Expected directory listing with types"


let testHelpForRun (): TestResult =
  let output = runWithCommand ["help"; "run"]
  if Stdlib.String.contains output "run" &&
      (Stdlib.String.contains output "function" || Stdlib.String.contains output "execute") then
      TestResult.Pass
  else
    TestResult.Fail "Expected help text for 'run' command"


let testHelpForLs (): TestResult =
  let output = runWithCommand ["help"; "ls"]
  if Stdlib.String.contains output "ls" &&
      (Stdlib.String.contains output "list" || Stdlib.String.contains output "List") then
      TestResult.Pass
  else
    TestResult.Fail "Expected help text for 'ls' command"


let testEvalSimpleExpression (): TestResult =
  let output = runWithCommand ["eval"; "2L + 3L"]
  if output == "5" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '5', got '{output}'"


let testEvalStringExpression (): TestResult =
  let output = runWithCommand ["eval"; "\"hello\" ++ \"world\""]
  if output == "helloworld" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected 'helloworld', got '{output}'"


let completionPickerState (itemCount: Int) : CompletionPicker.State =
  let items =
    Stdlib.List.range 1 itemCount
    |> Stdlib.List.map (fun index ->
      Completion.simple $"item-{Stdlib.Int.toString index}")
  CompletionPicker.create "" items


let testCompletionPickerTwoRows (): TestResult =
  let size = Tui.Size { width = 80; height = 2 }
  let state = completionPickerState 3
  let layout = CompletionPicker.layoutAtSize state size
  let view = CompletionPicker.viewAtSize state size

  match Stdlib.List.last view.rows with
  | Some helpRow ->
    if layout.itemCapacity == 1
       && Stdlib.Bool.not layout.showScrollIndicator
       && Stdlib.List.length view.rows == 2
       && Stdlib.String.contains helpRow "Enter"
    then
      TestResult.Pass
    else
      TestResult.Fail
        "Two-row picker should show one item and one complete help row"
  | None ->
    TestResult.Fail "Two-row picker should include a help row"


let testCompletionPickerNarrowHelp (): TestResult =
  let width = CompletionPicker.minimumWidth
  let help = CompletionPicker.helpTextAtWidth width

  if CompletionPicker.supportsSize (Tui.Size { width = width; height = 2 })
     && Stdlib.Bool.not
          (CompletionPicker.supportsSize
            (Tui.Size { width = width - 1; height = 2 }))
     && help == CompletionPicker.minimumHelpText
     && Tui.Text.displayWidth help <= width
  then
    TestResult.Pass
  else
    TestResult.Fail
      "Narrow picker should use an untruncated minimum help row"


let testCompletionPickerLongList (): TestResult =
  let size = Tui.Size { width = 80; height = 3 }
  let state = completionPickerState 5
  let layout = CompletionPicker.layoutAtSize state size
  let view = CompletionPicker.viewAtSize state size

  if layout.itemCapacity == 1
     && layout.showScrollIndicator
     && Stdlib.List.length view.rows == 3
  then
    TestResult.Pass
  else
    TestResult.Fail
      "Long picker should reserve rows for its indicator and help"


let testFullscreenRowCancelsDeferredWrap (): TestResult =
  let output =
    Tui.Frame.renderRowChangeAtWidth
      3
      (Tui.Frame.RowChange { row = 0; content = "abc" })

  if Stdlib.String.endsWith output "\r" then
    TestResult.Pass
  else
    TestResult.Fail
      "Fullscreen rows should return to column one after filling the terminal"


// ── Workbench canvas (spans -> rows) ──

let canvasRegion () : Darklang.Cli.UI.Layout.Region =
  Darklang.Cli.UI.Layout.Region { top = 1; left = 1; rows = 4; cols = 10 }


let canvasRow (spans: List<Darklang.Cli.UI.Layout.Span>) : String =
  Darklang.Cli.UI.Canvas.compose 10 2 spans
  |> Stdlib.List.head
  |> Stdlib.Option.withDefault ""
  |> Darklang.Cli.Tui.Text.stripSgr


let testCanvasPlacesSpans (): TestResult =
  let region = canvasRegion ()
  let spans = Darklang.Cli.UI.Layout.at region 0 2 "hi"
  let row = canvasRow spans

  // No trailing pad: the renderer erases each row before writing it, so padding would be bytes on the wire
  // for nothing, and unpadded rows compare equal across frames more often.
  if row == "  hi" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected span at column 2, got '{row}'"


let testCanvasLayersLaterSpans (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Cli.UI.Layout.at region 0 0 "aaaaa"
        Darklang.Cli.UI.Layout.at region 0 2 "BB" ]
  let row = canvasRow spans

  // The later span wins. Where it lands inside an earlier one, the earlier one's right-hand remainder is
  // dropped rather than split in two: the only thing that ever gets covered this way is the uniform blank
  // padding an overlay lays down first, and the renderer erases each row before writing it, so a row that
  // stops early is indistinguishable from one padded out with spaces.
  if row == "aaBB" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected later span to layer over earlier, got '{row}'"


let testCanvasWideGlyphOccupiesTwoColumns (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Cli.UI.Layout.at region 0 0 "界"
        Darklang.Cli.UI.Layout.at region 0 2 "X" ]
  let row = canvasRow spans

  // A double-width glyph eats two cells, so the next span still lands where it was asked to.
  // The wide glyph eats two cells, so the next span still lands where it was asked to: no gap, no overlap.
  if row == "界X" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected wide glyph to occupy two columns, got '{row}'"


let testCanvasStylingIsZeroWidth (): TestResult =
  let region = canvasRegion ()
  let spans =
    Stdlib.List.flatten
      [ Darklang.Cli.UI.Layout.at region 0 0 (Colors.info "ab")
        Darklang.Cli.UI.Layout.at region 0 2 "cd" ]
  let row = canvasRow spans

  // Colour codes carry no width, so the second span is not pushed sideways by them.
  if row == "abcd" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected SGR to consume no columns, got '{row}'"


let testCanvasUntouchedRowsAreEmpty (): TestResult =
  let region = canvasRegion ()
  let spans = Darklang.Cli.UI.Layout.at region 0 0 "x"
  let rows = Darklang.Cli.UI.Canvas.compose 10 3 spans

  match Stdlib.List.getAt rows 1 with
  | Some second ->
    // Rows nobody painted stay empty so they compare equal frame to frame and cost no redraw.
    if second == "" && Stdlib.List.length rows == 3 then
      TestResult.Pass
    else
      TestResult.Fail $"Expected untouched rows to be empty, got '{second}'"
  | None -> TestResult.Fail "Expected three composed rows"


// -- Tui.Text: the hand-rolled escape parser and the width math on top of it --

let testTextClipsByColumnsNotCharacters (): TestResult =
  let clipped = Tui.Text.clipToWidth "\u001b[31mabcdef" 3

  // SGR carries no width, so 3 columns means 3 visible characters, styling retained.
  if Tui.Text.stripSgr clipped == "abc" && Stdlib.String.contains clipped "\u001b[31m" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected styled clip to 'abc', got '{Tui.Text.stripSgr clipped}'"


let testTextNeverSplitsAWideGlyph (): TestResult =
  // Two double-width glyphs in three columns: the second cannot fit, and half of it must not be emitted.
  let clipped = Tui.Text.clipToWidth "界界" 3

  if Tui.Text.displayWidth clipped == 2 then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected a wide glyph to be dropped whole, got width {Stdlib.Int.toString (Tui.Text.displayWidth clipped)}"


let testTextDropsNonSgrEscapes (): TestResult =
  // A cursor-forward escape in dynamic content must not survive into a row: rows are text, not commands.
  let normalized = Tui.Text.normalizeToWidth "a\u001b[5Cb" 10

  if normalized == "ab" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected non-SGR escapes to be stripped, got '{normalized}'"


let testTextWrapReappliesStyleAcrossRows (): TestResult =
  let rows = Tui.Text.wrapStyled "\u001b[31mabcd" 2
  let first = Stdlib.List.getAt rows 0 |> Stdlib.Option.withDefault ""
  let second = Stdlib.List.getAt rows 1 |> Stdlib.Option.withDefault ""

  // The renderer resets style after every row, so a style spanning a wrap has to be restated on the next.
  if Stdlib.List.length rows == 2
     && Tui.Text.stripSgr first == "ab"
     && Tui.Text.stripSgr second == "cd"
     && Stdlib.String.contains second "\u001b[31m"
  then
    TestResult.Pass
  else
    TestResult.Fail "Expected wrapped rows to carry the active style onto the continuation row"


let testTextCursorAfterFullRowWraps (): TestResult =
  // Text that exactly fills the width leaves the cursor at the start of the following row, matching what
  // the terminal does. Prompt cursor placement depends on this.
  let (row, column) = Tui.Text.positionAfter "abcd" 4

  if row == 1 && column == 0 then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected (1, 0), got ({Stdlib.Int.toString row}, {Stdlib.Int.toString column})"


// -- InlineFrame: relative addressing, the part that can wreck scrollback --

let inlineView (rows: List<String>) : Tui.View =
  Tui.View { rows = rows; cursor = Tui.Cursor.Hidden; mode = Tui.ViewMode.Inline }


let testInlineFrameEmitsNothingWhenUnchanged (): TestResult =
  let view = inlineView [ "a"; "b" ]
  let output =
    Tui.InlineFrame.renderAtWidth 20 (Stdlib.Option.Option.Some view) view

  // An unchanged frame must write literally nothing, or an idle prompt would still churn the terminal.
  if output == "" then
    TestResult.Pass
  else
    TestResult.Fail "Expected an unchanged inline frame to emit no output"


let testInlineFrameMovesRelativeToPreviousCursor (): TestResult =
  let previous = inlineView [ "a"; "b" ]
  let next = inlineView [ "a"; "B" ]
  let output =
    Tui.InlineFrame.renderAtWidth 20 (Stdlib.Option.Option.Some previous) next

  // Only the changed row is rewritten, and it's addressed by moving from where the last frame left the
  // cursor rather than by absolute position, because inline rows travel with scrollback.
  if Stdlib.String.contains output "B"
     && Stdlib.Bool.not (Stdlib.String.contains output "a")
  then
    TestResult.Pass
  else
    TestResult.Fail $"Expected only the changed inline row to be rewritten, got '{output}'"


// -- TerminalSession lifecycle, through the `Prepared` seam that exists so this needs no real terminal --

let fullscreenView (rows: List<String>) : Tui.View =
  Tui.View { rows = rows; cursor = Tui.Cursor.Hidden; mode = Tui.ViewMode.Fullscreen }


let testSessionTakesAlternateScreenOnFirstPresent (): TestResult =
  let prepared =
    Tui.TerminalSession.preparePresentAtSize
      (Tui.TerminalSession.init ())
      (Tui.Size { width = 20; height = 5 })
      (fullscreenView [ "hello" ])

  if Stdlib.String.contains prepared.output "\u001b[?1049h" then
    TestResult.Pass
  else
    TestResult.Fail "Expected the first fullscreen present to enter the alternate screen"


let testSessionSecondIdenticalPresentIsSilent (): TestResult =
  let size = Tui.Size { width = 20; height = 5 }
  let view = fullscreenView [ "hello" ]
  let first =
    Tui.TerminalSession.preparePresentAtSize (Tui.TerminalSession.init ()) size view
  let second =
    Tui.TerminalSession.preparePresentAtSize first.state size view

  // Presenting the same view again is the common case in a render loop; it must cost nothing.
  if second.output == "" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected a repeat present to emit nothing, got '{second.output}'"


let testSessionStopRestoresOnlyWhenRunning (): TestResult =
  let size = Tui.Size { width = 20; height = 5 }
  let started =
    Tui.TerminalSession.preparePresentAtSize
      (Tui.TerminalSession.init ())
      size
      (fullscreenView [ "hello" ])
  let stopped = Tui.TerminalSession.prepareStop started.state
  let stoppedAgain = Tui.TerminalSession.prepareStop stopped.state

  // Stopping a live session leaves the alternate screen; stopping an already-stopped one is a no-op.
  if Stdlib.String.contains stopped.output "\u001b[?1049l" && stoppedAgain.output == "" then
    TestResult.Pass
  else
    TestResult.Fail "Expected stop to restore once and then be a no-op"


type TestFunction = Unit -> TestResult

let allTests (): List<String * TestFunction> =
  [ ("Help", fun () -> testHelpCommand ())
    ("Version", fun () -> testVersionCommand ())
    ("Status", fun () -> testStatusCommand ())

    ("Eval Bool.and", fun () -> testRunBoolAnd ())
    ("Eval Int64.add", fun () -> testRunInt64Add ())

    ("Eval String Length", fun () -> testEvalStringLength ())
    ("Eval List Length", fun () -> testEvalListLength ())

    ("List Functions", fun () -> testListFunctions ())
    ("View Function", fun () -> testViewFunction ())
    ("List Types", fun () -> testListTypes ())

    ("Help for Run", fun () -> testHelpForRun ())
    ("Help for Ls", fun () -> testHelpForLs ())

    ("Eval Simple Expression", fun () -> testEvalSimpleExpression ())
    ("Eval String Expression", fun () -> testEvalStringExpression ())

    ("Completion Picker Two Rows", fun () -> testCompletionPickerTwoRows ())
    ("Completion Picker Narrow Help", fun () -> testCompletionPickerNarrowHelp ())
    ("Completion Picker Long List", fun () -> testCompletionPickerLongList ())
    ("Fullscreen Deferred Wrap", fun () -> testFullscreenRowCancelsDeferredWrap ())

    ("Canvas Places Spans", fun () -> testCanvasPlacesSpans ())
    ("Canvas Layers Spans", fun () -> testCanvasLayersLaterSpans ())
    ("Canvas Wide Glyph", fun () -> testCanvasWideGlyphOccupiesTwoColumns ())
    ("Canvas SGR Zero Width", fun () -> testCanvasStylingIsZeroWidth ())
    ("Canvas Empty Rows", fun () -> testCanvasUntouchedRowsAreEmpty ())

    ("Text Clips By Columns", fun () -> testTextClipsByColumnsNotCharacters ())
    ("Text Wide Glyph Whole", fun () -> testTextNeverSplitsAWideGlyph ())
    ("Text Drops Non-SGR Escapes", fun () -> testTextDropsNonSgrEscapes ())
    ("Text Wrap Reapplies Style", fun () -> testTextWrapReappliesStyleAcrossRows ())
    ("Text Cursor After Full Row", fun () -> testTextCursorAfterFullRowWraps ())

    ("InlineFrame Silent Unchanged", fun () -> testInlineFrameEmitsNothingWhenUnchanged ())
    ("InlineFrame Relative Move", fun () -> testInlineFrameMovesRelativeToPreviousCursor ())

    ("Session Takes Alt Screen", fun () -> testSessionTakesAlternateScreenOnFirstPresent ())
    ("Session Repeat Is Silent", fun () -> testSessionSecondIdenticalPresentIsSilent ())
    ("Session Stop Restores Once", fun () -> testSessionStopRestoresOnlyWhenRunning ())
  ]

type TestSummary =
  { totalTests: Int
    passedTests: Int
    failedTests: Int
    failedTestNames: List<String> }

// Sequential test execution - proven to be ~30-50% faster than parallel for CLI tests
// due to process startup overhead and resource contention
let runAllTests (): Int =
  let tests = allTests ()

  Stdlib.printLine ""
  Stdlib.printLine "Darklang CLI Tests"
  Stdlib.printLine "=================="

  let initialSummary =
    TestSummary
      { totalTests = 0
        passedTests = 0
        failedTests = 0
        failedTestNames = [] }

  let finalSummary =
    tests
    |> Stdlib.List.fold initialSummary (fun summary (name, testFn) ->
      Stdlib.printLine ""
      Stdlib.printLine $"Running: {name} ..."

      let newSummary =
        { summary with totalTests = summary.totalTests + 1 }

      match testFn () with
      | Pass ->
        Stdlib.printLine $"✓ PASS - {name}"
        { newSummary with passedTests = newSummary.passedTests + 1 }
      | Fail message ->
        Stdlib.printLine $"✗ FAIL - {name}"
        Stdlib.printLine $"  Reason: {message}"
        { newSummary with
            failedTests = newSummary.failedTests + 1
            failedTestNames = Stdlib.List.push newSummary.failedTestNames name })

  Stdlib.printLine ""
  Stdlib.printLine "📊 Test Results Summary"
  Stdlib.printLine "======================"
  Stdlib.printLine $"Total tests:  {Stdlib.Int.toString finalSummary.totalTests}"
  Stdlib.printLine $"Passed:       {Stdlib.Int.toString finalSummary.passedTests}"
  Stdlib.printLine $"Failed:       {Stdlib.Int.toString finalSummary.failedTests}"

  if finalSummary.failedTests == 0 then
    Stdlib.printLine "🎉 All tests passed!"
    0
  else
    Stdlib.printLine "🚨 Some tests failed!"
    if Stdlib.Bool.not (Stdlib.List.isEmpty finalSummary.failedTestNames) then
      Stdlib.printLine "Failed tests:"
      finalSummary.failedTestNames
      |> Stdlib.List.iter (fun testName ->
        Stdlib.printLine $"  ✗ {testName}")
    1
