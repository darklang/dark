/// CLI tests: the command surface, driven by shelling out to the real binary.
///
/// Split across files; the registry and runner are in tests-runner.dark.
module Darklang.Cli.Tests



type TestResult =
  | Pass
  | Fail of message: String


/// The binary these tests drive.
///
/// Defaults to the dev wrapper, which is what you want locally. CI points it at
/// a freshly-published artifact instead (`DARK_CLI_UNDER_TEST=clis/darklang-...`)
/// so the suite validates the thing we're about to ship rather than a Debug
/// build. That matters most under NativeAOT, where a trimming failure is
/// invisible at build time and only shows up in the one command that hits it.
let cliUnderTest () : String =
  match Stdlib.Env.get "DARK_CLI_UNDER_TEST" with
  | Some path -> path
  | None -> "./scripts/run-cli"


/// What a call printed. A failure EXITS NONZERO and explains itself on stdout (a refused eval, a
/// halted harmful call), so dropping stdout on a nonzero exit hid the very text these tests assert
/// on. Stderr is only surfaced when stdout said nothing: appending it broke exact-match assertions
/// on any stray diagnostic line.
let callOutput (result: Stdlib.Cli.ExecutionOutcome) : String =
  let out = Stdlib.String.trim result.stdout

  if out != "" then out
  else
    let err = Stdlib.String.trim result.stderr
    if err == "" then "" else $"ERROR: {err}"


let runWithCommand (args: List<String>): String =
  let escapedArgs =
    args
    |> Stdlib.List.map (fun arg ->
      if Stdlib.String.contains arg " " ||
          Stdlib.String.contains arg "|" ||
          Stdlib.String.contains arg "\""
      then
        let escapedArg = Stdlib.String.replaceAll arg "\"" "\\\""
        $"'{escapedArg}'"
      else arg)

  let argsString = Stdlib.String.join escapedArgs " "
  let command = $"{cliUnderTest ()} {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput "." command

  callOutput result


/// The same, but with <param input> on stdin. For the commands that ASK: `conflicts walk` reads a line
/// per conflict, and nothing else in this suite can drive it.
let runWithStdinAndCommand (input: String) (args: List<String>): String =
  let argsString = Stdlib.String.join args " "
  let command = $"printf '{input}' | {cliUnderTest ()} {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput "." command
  callOutput result


/// Run a command and compare its whole output exactly.
let expectExact (args: List<String>) (expected: String): TestResult =
  let output = runWithCommand args
  if output == expected then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '{expected}', got '{output}'"


/// `dark conflicts walk`, on a conflict this test makes for itself.
///
/// Everything happens between a throwaway parent and its child, so main gains nothing.
let testConflictWalkthrough (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let parent = "cli-walk-parent-" ++ suffix
  let child = "cli-walk-child-" ++ suffix
  let fnName = "Tests.CliWalk.f" ++ suffix

  let _ = runWithCommand [ "branch", "create", parent ]
  // A shared base for the name: both sides have to move it from something.
  let _ = runWithCommand [ "--branch", parent, "fn", "/" ++ fnName, "() : Int64 = 1L" ]
  let _ = runWithCommand [ "--branch", parent, "branch", "create", child ]
  let _ = runWithCommand [ "--branch", child, "fn", "/" ++ fnName, "() : Int64 = 222L" ]
  let _ = runWithCommand [ "--branch", parent, "fn", "/" ++ fnName, "() : Int64 = 111L" ]

  let merged = runWithCommand [ "--branch", child, "merge", child ]
  let beforeJson = runWithCommand [ "--branch", parent, "conflicts", "--json" ]
  // `b` takes the other side, which is the answer that has to WRITE something.
  let walked = runWithStdinAndCommand "b\n" [ "--branch", parent, "conflicts", "walk" ]
  let afterJson = runWithCommand [ "--branch", parent, "conflicts", "--json" ]
  let onMain = runWithCommand [ "--branch", "main", "eval", fnName ++ " ()" ]

  // Archive before asserting, not after: every arm below returns, so a trailing cleanup only runs
  // on the passing path, and these branches are otherwise permanent.
  let _ = runWithCommand [ "branch", "archive", child, "-y" ]
  let _ = runWithCommand [ "branch", "archive", parent, "-y" ]

  if Stdlib.Bool.not (Stdlib.String.contains merged "conflict") then
    TestResult.Fail $"Expected the merge to record a conflict; got: {merged}"
  else if Stdlib.Bool.not (Stdlib.String.contains beforeJson "\"pending\":1") then
    TestResult.Fail $"Expected one pending conflict before the walk; got: {beforeJson}"
  else if Stdlib.String.contains walked "ERROR:" then
    TestResult.Fail $"`conflicts walk` failed: {walked}"
  else if Stdlib.Bool.not (Stdlib.String.contains walked "took theirs") then
    TestResult.Fail $"Expected the walk to take the other side on `b`; got: {walked}"
  else if Stdlib.Bool.not (Stdlib.String.contains afterJson "\"pending\":0") then
    TestResult.Fail $"Expected nothing pending after the walk; got: {afterJson}"
  else if Stdlib.Bool.not (Stdlib.String.contains onMain "not found") then
    TestResult.Fail
      $"A conflict resolved between two branches reached MAIN. Got: {onMain}"
  else
    TestResult.Pass


let testHelpCommand (): TestResult =
  let output = runWithCommand ["help"]

  // Assert on the groups and a command from a few of them.
  //
  // Assert the RENDERED ROW, not the bare word. `contains output "nav"` passed on the word "navigable" in
  // the workbench's description, so it would have stayed green with the `nav` command deleted; "help",
  // "version" and "status" all appear in other commands' descriptions too. The row shape
  // (`  name (aliases) - `) is what `formatCommandGroup` emits and is unique per command.
  if Stdlib.String.contains output "Packages:" &&
      Stdlib.String.contains output "  nav (cd) -" &&
      Stdlib.String.contains output "  ls (dir) -" &&
      Stdlib.String.contains output "  version (--version, -v) -" &&
      Stdlib.String.contains output "  status (wip, changes) -" then
      TestResult.Pass
  else
    TestResult.Fail "Expected help grouped by category, with the nav/ls/version/status rows rendered"


let testVersionCommand (): TestResult =
  let output = runWithCommand ["version"]
  if Stdlib.String.contains output "Darklang CLI" &&
      Stdlib.String.contains output "alpha-" then
      TestResult.Pass
  else
    TestResult.Fail "Expected version string with 'Darklang CLI alpha-'"


let testStatusCommand (): TestResult =
  // Two things, because `status` is the one signal you get while editing: WHERE you are, and WHAT you have.
  // The branch line matters most when several branches are in play, which is the normal case now.
  let output = runWithCommand ["status"]
  if Stdlib.String.contains output "On branch" &&
      (Stdlib.String.contains output "clean:" ||
       Stdlib.String.contains output "draft:") then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected `status` to name the branch and summarise the draft; got: {output}"


let testEvalBoolAnd (): TestResult =
  // `run` is for script files now; calling a package function is `eval`'s job, without the `@`.
  expectExact ["eval", "Stdlib.Bool.and true false"] "false"


let testEvalInt64Add (): TestResult =
  expectExact ["eval", "Stdlib.Int64.add 5L 3L"] "8"


let testEvalStringLength (): TestResult =
  expectExact ["eval", "Stdlib.String.length \"hello\""] "5"


let testEvalListLength (): TestResult =
  expectExact ["eval", "[1, 2, 3] |> Stdlib.List.length"] "3"


/// Create, update, and what happens to a module that does not type-check.
///
/// A declaration that fails the at-rest check is SAVED AS WIP and refused at `commit`, not rejected
/// at author time: a draft may be broken because you write the caller before the callee, a commit may
/// not, because a commit is what other machines pull. So after an invalid module the item EXISTS, the
/// message says it is WIP, and the definitions that were already there are untouched.
let testModuleCommand (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let branchName = "cli-module-test-" ++ suffix
  let moduleName = "Tests.CliModule"
  let initialSource =
    [ "type Counter = { value: Int }"
      ""
      "val initial = Counter { value = 0 }"
      ""
      "let double (n: Int) : Int = n * 2"
      ""
      "let quadruple (n: Int) : Int = double (double n)"
    ] |> Stdlib.String.join "\n"
  let updatedSource =
    [ "type Counter = { value: Int }"
      ""
      "val initial = Counter { value = 1 }"
      ""
      "let double (n: Int) : Int = n * 3"
      ""
      "let quadruple (n: Int) : Int = double (double n)"
    ] |> Stdlib.String.join "\n"
  let invalidSource =
    [ "type Wrapped = Wrap of (Int * String)"
      ""
      "let shouldNotExist (value: Wrapped) : Wrapped ="
      "  match value with"
      "  | Wrap((number, text)) -> Wrapped.Wrap(number, text)"
    ] |> Stdlib.String.join "\n"
  let initialPath = Stdlib.Cli.File.createTemp () |> Builtin.unwrap
  let updatedPath = Stdlib.Cli.File.createTemp () |> Builtin.unwrap
  let invalidPath = Stdlib.Cli.File.createTemp () |> Builtin.unwrap
  let _ =
    (Stdlib.Cli.File.writeAtomic initialPath initialSource) |> Builtin.unwrap
  let _ =
    (Stdlib.Cli.File.writeAtomic updatedPath updatedSource) |> Builtin.unwrap
  let _ =
    (Stdlib.Cli.File.writeAtomic invalidPath invalidSource) |> Builtin.unwrap
  let _ = runWithCommand ["branch", "create", branchName]
  let moduleOutput =
    runWithCommand
      [ "--branch"
        branchName
        "module"
        "/" ++ moduleName
        initialPath ]
  let initialEval =
    runWithCommand
      [ "--branch", branchName, "eval", moduleName ++ ".quadruple 3" ]
  let updateOutput =
    runWithCommand
      [ "--branch"
        branchName
        "module"
        "/" ++ moduleName
        updatedPath ]
  let updatedEval =
    runWithCommand
      [ "--branch", branchName, "eval", moduleName ++ ".quadruple 3" ]
  let invalidOutput =
    runWithCommand
      [ "--branch"
        branchName
        "module"
        "/" ++ moduleName
        invalidPath ]
  let searchOutput =
    runWithCommand
      [ "--branch"
        branchName
        "search"
        moduleName ++ ".shouldNotExist"
        "--exact"
        "--fn" ]
  let afterInvalidEval =
    runWithCommand
      [ "--branch", branchName, "eval", moduleName ++ ".quadruple 3" ]
  let _ = runWithCommand ["branch", "archive", branchName, "-y"]
  let _ = Stdlib.Cli.File.delete initialPath
  let _ = Stdlib.Cli.File.delete updatedPath
  let _ = Stdlib.Cli.File.delete invalidPath

  if
    Stdlib.String.contains moduleOutput "Defined 4 declarations"
    && initialEval == "12"
    && Stdlib.String.contains updateOutput "Defined 4 declarations"
    && updatedEval == "27"
    && Stdlib.String.contains invalidOutput "expects 1 field"
    && Stdlib.String.contains invalidOutput "saved as WIP"
    && Stdlib.String.contains searchOutput "shouldNotExist"
    && afterInvalidEval == "27"
  then
    TestResult.Pass
  else
    let details =
      [ $"create: {moduleOutput}"
        $"initial eval: {initialEval}"
        $"update: {updateOutput}"
        $"updated eval: {updatedEval}"
        $"invalid: {invalidOutput}"
        $"invalid item search: {searchOutput}"
        $"eval after invalid: {afterInvalidEval}"
      ] |> Stdlib.String.join "; "
    TestResult.Fail
      $"Expected atomic create, update, and rejection; got {details}"


let testModuleRejectsDuplicateNames (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let branchName = "cli-module-duplicate-test-" ++ suffix
  let moduleName = "Tests.CliModuleDuplicate"
  let source =
    [ "let duplicate (n: Int) : Int = n"
      ""
      "let duplicate (n: Int) : Int = n + 1"
    ] |> Stdlib.String.join "\n"
  let sourcePath = Stdlib.Cli.File.createTemp () |> Builtin.unwrap
  let _ = Stdlib.Cli.File.writeAtomic sourcePath source |> Builtin.unwrap
  let _ = runWithCommand ["branch", "create", branchName]
  let moduleOutput =
    runWithCommand
      [ "--branch", branchName, "module", "/" ++ moduleName, sourcePath ]
  let searchOutput =
    runWithCommand
      [ "--branch"
        branchName
        "search"
        moduleName ++ ".duplicate"
        "--exact"
        "--fn" ]
  let _ = runWithCommand ["branch", "archive", branchName, "-y"]
  let _ = Stdlib.Cli.File.delete sourcePath

  if
    Stdlib.String.contains moduleOutput "duplicate declaration names"
    && Stdlib.String.contains moduleOutput "duplicate"
    && Stdlib.String.contains searchOutput "No results found"
  then
    TestResult.Pass
  else
    TestResult.Fail
      ($"Expected duplicate declarations to be rejected without mutation; "
       ++ $"module={moduleOutput}; search={searchOutput}")


/// Merging a branch, end to end, through the CLI.
///
/// So this drives the real binary. It merges a child into a THROWAWAY PARENT rather than into main, so a
/// run leaves no fn behind on main.
let testMergeRoundTrip (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let parent = "cli-merge-parent-" ++ suffix
  let child = "cli-merge-child-" ++ suffix
  let fnName = "Tests.CliMerge.landed" ++ suffix

  let _ = runWithCommand [ "branch", "create", parent ]
  let _ = runWithCommand [ "--branch", parent, "branch", "create", child ]
  let _ =
    runWithCommand
      [ "--branch", child, "fn", "/" ++ fnName, "() : Int64 = 7L" ]

  // --dry-run records nothing, so it has to answer the same question the merge does without doing it.
  let dryRun = runWithCommand [ "--branch", child, "merge", child, "--dry-run" ]
  let merged = runWithCommand [ "--branch", child, "merge", child ]
  let onParent = runWithCommand [ "--branch", parent, "eval", fnName ++ " ()" ]
  let onMain = runWithCommand [ "--branch", "main", "eval", fnName ++ " ()" ]

  // Archived before the assertions, because each arm returns and a trailing cleanup would only run
  // on the passing path.
  let _ = runWithCommand [ "branch", "archive", child, "-y" ]
  let _ = runWithCommand [ "branch", "archive", parent, "-y" ]

  if Stdlib.String.contains dryRun "ERROR:" then
    TestResult.Fail $"`merge --dry-run` failed: {dryRun}"
  else if Stdlib.Bool.not (Stdlib.String.contains dryRun parent) then
    TestResult.Fail $"Expected `merge --dry-run` to name the parent it would merge into; got: {dryRun}"
  else if Stdlib.Bool.not (Stdlib.String.contains dryRun fnName) then
    TestResult.Fail $"Expected `merge --dry-run` to list the name that would land; got: {dryRun}"
  else if Stdlib.Bool.not (Stdlib.String.contains merged "Merged") then
    TestResult.Fail $"Expected `merge` to report what it merged; got: {merged}"
  else if onParent != "7" then
    TestResult.Fail $"Expected the merged fn to resolve on the parent as 7; got: {onParent}"
  else if onMain == "7" then
    TestResult.Fail
      $"A merge into \"{parent}\" reached MAIN -- the branch overlay leaked. Got: {onMain}"
  else
    TestResult.Pass


let testFnAcceptsCompleteDeclaration (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let branchName = "cli-authoring-test-" ++ suffix
  let moduleName = "Tests.CliAuthoring"
  let fnSource =
    [ "/// Greets someone by name."
      "let main (name: String) : String ="
      "  \"Hello, \" ++ name"
    ] |> Stdlib.String.join "\n"
  let mismatchedSource =
    "let other (name: String) : String = name"
  let multipleSource =
    [ "let extra (n: Int) : Int = n"
      "let ignored (n: Int) : Int = n" ]
    |> Stdlib.String.join "\n"
  let _ = runWithCommand [ "branch", "create", branchName ]
  let fnOutput =
    runWithCommand
      [ "--branch"
        branchName
        "fn"
        "/" ++ moduleName ++ ".main"
        fnSource ]
  let evalOutput =
    runWithCommand
      [ "--branch"
        branchName
        "eval"
        moduleName ++ ".main \"Dark\"" ]
  let fragmentOutput =
    runWithCommand
      [ "--branch"
        branchName
        "fn"
        "/" ++ moduleName ++ ".double"
        "(n: Int) : Int = n * 2" ]
  let fragmentEval =
    runWithCommand
      [ "--branch", branchName, "eval", moduleName ++ ".double 4" ]
  let mismatchOutput =
    runWithCommand
      [ "--branch"
        branchName
        "fn"
        "/" ++ moduleName ++ ".main"
        mismatchedSource ]
  let multipleOutput =
    runWithCommand
      [ "--branch"
        branchName
        "fn"
        "/" ++ moduleName ++ ".extra"
        multipleSource ]
  let _ = runWithCommand [ "branch", "archive", branchName, "-y" ]

  if
    Stdlib.String.contains fnOutput "Created function"
    && evalOutput == "Hello, Dark"
    && Stdlib.String.contains fragmentOutput "Created function"
    && fragmentEval == "8"
    && Stdlib.String.contains mismatchOutput "does not match target"
    && Stdlib.String.contains multipleOutput "exactly one function declaration"
    && Stdlib.Bool.not (Stdlib.String.contains multipleOutput "Created function")
  then
    TestResult.Pass
  else
    TestResult.Fail
      ($"Expected complete and fragment fn input with target-name validation; "
       ++ $"fn={fnOutput}; eval={evalOutput}; fragment={fragmentOutput}; "
       ++ $"fragment eval={fragmentEval}; mismatch={mismatchOutput}; "
       ++ $"multiple={multipleOutput}")


let testListFunctions (): TestResult =
  let output = runWithCommand ["ls", "Stdlib.List"]
  if Stdlib.String.contains output "Functions" &&
      Stdlib.String.contains output "head" then
      TestResult.Pass
  else
    TestResult.Fail "Expected directory listing with functions"


let testViewFunction (): TestResult =
  let output = runWithCommand ["view", "Stdlib.List.head"]
  if Stdlib.String.contains output "head"
    && Stdlib.String.contains output "Option"
    && Stdlib.String.contains output "->"
  then
      TestResult.Pass
  else
    TestResult.Fail "Expected function signature for List.head"


/// The harmful gate, end to end, through a real CLI process.
///
/// Tested via a real invocation because the gate lives in the CLI HOST: the RT default is
/// permissive by design ("tests run permissive" in `Execution.createState`), so an in-harness
/// RT-level test guards nothing.
let testHarmfulGate (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let fnName = $"Tests.HarmGate.g{suffix}"

  let _ = runWithCommand [ "fn", fnName, "(x: Int64) : Int64 = Stdlib.Int64.add x 31L" ]

  let _ =
    runWithCommand
      [ "deprecate", "fn", fnName, "--kind", "harmful", "-m", "test", "--yes" ]

  let halted = runWithCommand [ "eval", $"{fnName} 0L" ]
  let allowed = runWithCommand [ "eval", $"{fnName} 0L", "--allow-harmful" ]

  if Stdlib.Bool.not (Stdlib.String.contains halted "Harmful") then
    TestResult.Fail
      $"a fn marked harmful should refuse to run without the flag, got: {halted}"
  else if Stdlib.Bool.not (Stdlib.String.contains allowed "31") then
    // The halt message names `--allow-harmful`, so the flag has to do what the message promises.
    TestResult.Fail $"--allow-harmful should run it anyway, got: {allowed}"
  else
    TestResult.Pass


