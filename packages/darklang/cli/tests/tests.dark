/// CLI tests: the command surface, driven by shelling out to the real binary.
///
/// Split across files; the registry and runner are in tests-runner.dark.
module Darklang.Cli.Tests



type TestResult =
  | Pass
  | Fail of message: String


/// The binary these tests drive.
///
/// Defaults to the dev wrapper, which is what you want locally. CI points it at
/// a freshly-published artifact instead (`DARK_CLI_UNDER_TEST=clis/darklang-...`)
/// so the suite validates the thing we're about to ship rather than a Debug
/// build. That matters most under NativeAOT, where a trimming failure is
/// invisible at build time and only shows up in the one command that hits it.
let cliUnderTest () : String =
  match Stdlib.Env.get "DARK_CLI_UNDER_TEST" with
  | Some path -> path
  | None -> "./scripts/run-cli"


let runWithCommand (args: List<String>): String =
  let escapedArgs =
    args
    |> Stdlib.List.map (fun arg ->
      if Stdlib.String.contains arg " " ||
          Stdlib.String.contains arg "|" ||
          Stdlib.String.contains arg "\""
      then
        let escapedArg = Stdlib.String.replaceAll arg "\"" "\\\""
        $"'{escapedArg}'"
      else arg)

  let argsString = Stdlib.String.join escapedArgs " "
  let command = $"{cliUnderTest ()} {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput "." command

  if result.exitCode == 0 then
    Stdlib.String.trim result.stdout
  else
    $"ERROR: {result.stderr}"


/// The same, but with <param input> on stdin. For the commands that ASK: `conflicts walk` reads a line
/// per conflict, and nothing else in this suite can drive it.
let runWithStdinAndCommand (input: String) (args: List<String>): String =
  let argsString = Stdlib.String.join args " "
  let command = $"printf '{input}' | {cliUnderTest ()} {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput "." command

  if result.exitCode == 0 then
    Stdlib.String.trim result.stdout
  else
    $"ERROR: {result.stderr}"


/// `dark conflicts walk`, on a conflict this test makes for itself.
///
/// The walkthrough reads a line per conflict, so no sweep and no other case here reaches it; it was
/// written and then never driven. A conflict does NOT need two instances -- a branch merge where both
/// sides moved one name records one -- so this stays a single-instance test.
///
/// Everything happens between a throwaway parent and its child, so main gains nothing.
let testConflictWalkthrough (): TestResult =
  let suffix = Stdlib.Int.toString (Stdlib.Int.random 100000 999999)
  let parent = "cli-walk-parent-" ++ suffix
  let child = "cli-walk-child-" ++ suffix
  let fnName = "Tests.CliWalk.f" ++ suffix

  let _ = runWithCommand [ "branch"; "create"; parent ]
  // A shared base for the name: both sides have to move it from something.
  let _ = runWithCommand [ "--branch"; parent; "fn"; "/" ++ fnName; "() : Int64 = 1L" ]
  let _ = runWithCommand [ "--branch"; parent; "branch"; "create"; child ]
  let _ = runWithCommand [ "--branch"; child; "fn"; "/" ++ fnName; "() : Int64 = 222L" ]
  let _ = runWithCommand [ "--branch"; parent; "fn"; "/" ++ fnName; "() : Int64 = 111L" ]

  let merged = runWithCommand [ "--branch"; child; "merge"; child ]
  let beforeJson = runWithCommand [ "--branch"; parent; "conflicts"; "--json" ]
  // `b` takes the other side, which is the answer that has to WRITE something.
  let walked = runWithStdinAndCommand "b\n" [ "--branch"; parent; "conflicts"; "walk" ]
  let afterJson = runWithCommand [ "--branch"; parent; "conflicts"; "--json" ]
  let onMain = runWithCommand [ "--branch"; "main"; "eval"; fnName ++ " ()" ]

  if Stdlib.Bool.not (Stdlib.String.contains merged "conflict") then
    TestResult.Fail $"Expected the merge to record a conflict; got: {merged}"
  else if Stdlib.Bool.not (Stdlib.String.contains beforeJson "\"pending\":1") then
    TestResult.Fail $"Expected one pending conflict before the walk; got: {beforeJson}"
  else if Stdlib.String.contains walked "ERROR:" then
    TestResult.Fail $"`conflicts walk` failed: {walked}"
  else if Stdlib.Bool.not (Stdlib.String.contains walked "took theirs") then
    TestResult.Fail $"Expected the walk to take the other side on `b`; got: {walked}"
  else if Stdlib.Bool.not (Stdlib.String.contains afterJson "\"pending\":0") then
    TestResult.Fail $"Expected nothing pending after the walk; got: {afterJson}"
  else if Stdlib.Bool.not (Stdlib.String.contains onMain "not found") then
    TestResult.Fail
      $"A conflict resolved between two branches reached MAIN. Got: {onMain}"
  else
    TestResult.Pass


let testHelpCommand (): TestResult =
  let output = runWithCommand ["help"]

  // Help is grouped by category now, so assert on the groups and a command from a few of them rather than
  // on a heading that no longer exists.
  //
  // Assert the RENDERED ROW, not the bare word. `contains output "nav"` passed on the word "navigable" in
  // the workbench's description, so it would have stayed green with the `nav` command deleted; "help",
  // "version" and "status" all appear in other commands' descriptions too. The row shape
  // (`  name (aliases) - `) is what `formatCommandGroup` emits and is unique per command.
  if Stdlib.String.contains output "Packages:" &&
      Stdlib.String.contains output "  nav (cd) -" &&
      Stdlib.String.contains output "  ls (dir) -" &&
      Stdlib.String.contains output "  version (--version, -v) -" &&
      Stdlib.String.contains output "  status (wip, changes) -" then
      TestResult.Pass
  else
    TestResult.Fail "Expected help grouped by category, with the nav/ls/version/status rows rendered"


let testVersionCommand (): TestResult =
  let output = runWithCommand ["version"]
  if Stdlib.String.contains output "Darklang CLI" &&
      Stdlib.String.contains output "alpha-" then
      TestResult.Pass
  else
    TestResult.Fail "Expected version string with 'Darklang CLI alpha-'"


let testStatusCommand (): TestResult =
  // Two things, because `status` is the one signal you get while editing: WHERE you are, and WHAT you have.
  // The branch line matters most when several branches are in play, which is the normal case now.
  let output = runWithCommand ["status"]
  if Stdlib.String.contains output "On branch" &&
      (Stdlib.String.contains output "clean:" ||
       Stdlib.String.contains output "draft:") then
    TestResult.Pass
  else
    TestResult.Fail
      $"Expected `status` to name the branch and summarise the draft; got: {output}"


let testEvalBoolAnd (): TestResult =
  // `run` is for script files now; calling a package function is `eval`'s job, without the `@`.
  let output = runWithCommand ["eval"; "Stdlib.Bool.and true false"]
  if output == "false" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected 'false', got '{output}'"


let testEvalInt64Add (): TestResult =
  let output = runWithCommand ["eval"; "Stdlib.Int64.add 5L 3L"]
  if output == "8" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '8', got '{output}'"


let testEvalStringLength (): TestResult =
  let output = runWithCommand ["eval"; "Stdlib.String.length \"hello\""]
  if output == "5" then
    TestResult.Pass
  else
    TestResult.Fail $"Expected '5', got '{output}'"


let testEvalListLength (): TestResult =
