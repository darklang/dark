module Darklang.Cli.Config

/// Every key `config` answers for. The runtime keeps the list, and checks every value on set:
/// nothing reads an unknown key, so storing one would only hide a typo.
let knownKeys(): List<String> = Stdlib.LocalStore.configKeys()

let smaller(a: Int64, b: Int64): Int64 = if a < b then a else b

/// Edits (insert, delete, substitute) between two strings, for "did you mean".
let editDistance(a: String, b: String): Int64 =
  let bs = Stdlib.String.toList(b)
  let firstRow = Stdlib.List.range(0, Stdlib.List.length(bs))

  let lastRow =
    Stdlib.String.toList(a)
    |> Stdlib.List.indexedMap(fun(i, ca) -> (i, ca))
    |> Stdlib.List.fold(firstRow, fun(prev, pair) ->
      let (i, ca) = pair

      bs
      |> Stdlib.List.indexedMap(fun(j, cb) -> (j, cb))
      |> Stdlib.List.fold([ i + 1 ], fun(row, pair) ->
        let (j, cb) = pair
        // `row` is built back to front, so its head is the cell to the left.
        let left = Stdlib.Option.withDefault(Stdlib.List.head(row), 0)
        let up = Stdlib.Option.withDefault(Stdlib.List.getAt(prev, j + 1), 0)
        let diag = Stdlib.Option.withDefault(Stdlib.List.getAt(prev, j), 0)
        let cost = if ca == cb then 0 else 1
        Stdlib.List.prepend(row, Config.smaller(Config.smaller(left + 1, up + 1), diag + cost)))
      |> Stdlib.List.reverse)

  Stdlib.Option.withDefault(Stdlib.List.last(lastRow), 0)

/// The key a typo most likely meant, when one is obvious: the same name in another case, the
/// part after the dot alone (`record` for `trace.record`), or two edits away at most.
let nearestKey(key: String): Stdlib.Option.Option<String> =
  let lower = Stdlib.String.toLowercase(key)
  let keys = Config.knownKeys()

  let bySuffix =
    keys
    |> Stdlib.List.filter(fun k ->
      Stdlib.String.endsWith(Stdlib.String.toLowercase(k), "." + lower))

  match bySuffix with
  | [only] -> Stdlib.Option.Option.Some(only)
  | _ ->
    let scored =
      keys
      |> Stdlib.List.map(fun k -> (Config.editDistance(lower, Stdlib.String.toLowercase(k)), k))
      |> Stdlib.List.sortBy(fun pair ->
        let (d, _) = pair
        d)

    match scored with
    | [(d, k), ...rest] when d <= 2 ->
      match rest with
      // A tie is not obvious.
      | [(d2, _), ...] when d2 == d -> Stdlib.Option.Option.None
      | _ -> Stdlib.Option.Option.Some(k)
    | _ -> Stdlib.Option.Option.None

/// A key `config list` describes: what it does, and what applies while it is not set.
type Setting = { key: String, what: String, byDefault: String }

/// The keys a person is likely to set, in the order `config list` shows them. The runtime takes a
/// few more (the expert `exec.spread*` knobs), which `config get` answers for without a default.
let settings(): List<Setting> =
  [ Setting { key = "exec.workers", what = "Scheduler worker threads", byDefault = "one per core" }
    Setting { key = "exec.policy", what = "Expert: a Dark fn picking the next process", byDefault = "round robin" }
    Setting { key = "exec.maxInstructions", what = "Expert: stop a process past this many instructions", byDefault = "none" }
    Setting { key = "exec.maxBytes", what = "Expert: stop a process past this many bytes allocated", byDefault = "none" }
    Setting { key = "exec.storePollMs", what = "How often a --live view looks for a change, in ms, at least 10", byDefault = "25" }
    Setting { key = "http.requestTimeoutMs", what = "serve cancels a handler past this many ms and answers 504; 0 = none", byDefault = "30000" }
    Setting { key = "trace.record", what = "Keep a record of every run, on or off", byDefault = "off" }
    Setting { key = "http.loopback", what = "let your code reach 127.0.0.1, on or off", byDefault = "off" }
    Setting { key = "http.private", what = "let your code reach private network addresses, on or off", byDefault = "off" }
    Setting { key = "trace.keep", what = "How many traces to keep, a served request being one; 0 = all", byDefault = "200" }
    Setting { key = "trace.maxMb", what = "How many MB traces may hold, logs and captured bodies; 0 = all", byDefault = "256" }
    Setting { key = "instance.name", what = "The name in the workbench header", byDefault = "this machine's hostname" } ]

/// What applies while <param key> is not set, when `config list` says.
let defaultOf(key: String): Stdlib.Option.Option<String> =
  Config.settings()
  |> Stdlib.List.findFirst(fun s -> s.key == key)
  |> Stdlib.Option.map(fun s -> s.byDefault)

let unknownKeyMessage(key: String): String =
  let hint =
    match Config.nearestKey(key) with
    | Some(k) -> $" Did you mean {k}?"
    | None -> ""
  $"{key} is not a config key.{hint} `config list` names the keys."

let execute(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | ["get", key] when Stdlib.List.contains(Config.knownKeys(), key) ->
    match Stdlib.LocalStore.configGet(key) with
    | Some(value) -> Stdlib.printLine($"{key} = {value}")
    | None ->
      match Config.defaultOf(key) with
      | Some(d) -> Stdlib.printLine($"{key} is not set (default: {d})")
      | None -> Stdlib.printLine($"{key} is not set")
    state

  | ["set", key, value] when Stdlib.List.contains(Config.knownKeys(), key) ->
    match Stdlib.LocalStore.configSet(key, value) with
    | Error(problem) ->
      Cli.printErr(problem)
      { state with exitCode = 1 }
    | Ok(_) ->
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Set {key} = {value}"))
      state

  | ["unset", key] when Stdlib.List.contains(Config.knownKeys(), key) ->
    match Stdlib.LocalStore.configUnset(key) with
    | Error(problem) ->
      Cli.printErr(problem)
      { state with exitCode = 1 }
    | Ok(_) ->
      let back =
        match Config.defaultOf(key) with
        | Some(d) -> $" ({d})"
        | None -> ""
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"{key} is back to its default{back}"))
      state

  | ["get", key] ->
    Cli.printErr(Config.unknownKeyMessage(key))
    { state with exitCode = 1 }

  | ["unset", key] ->
    Cli.printErr(Config.unknownKeyMessage(key))
    { state with exitCode = 1 }

  | ["set", key, _] ->
    Cli.printErr(Config.unknownKeyMessage(key))
    { state with exitCode = 1 }

  | ["list"] ->
    let lines =
      Config.settings()
      |> Stdlib.List.map(fun s ->
        let key = Stdlib.Text.padEndToWidth(s.key, 25)
        $"  {key}- {s.what} (default: {s.byDefault})")

    Stdlib.List.flatten(
      [ [ "Common configuration keys:", "" ]
        lines
        [ ""
          "Use 'config get <key>' to read a value"
          "Use 'config set <key> <value>' to set a value"
          "Use 'config unset <key>' to go back to the default" ] ])
    |> Stdlib.printLines
    state

  | _ ->
    Cli.printErr("Invalid arguments")
    Stdlib.printErrorLine("")
    Stdlib.printErrorLine(help(state))
    { state with exitCode = 1 }


let complete(_state: Cli.AppState, args: List<String>): List<Cli.Completion.CompletionItem> =
  match args with
  | [] ->
    ["get", "set", "unset", "list"] |> Stdlib.List.map(Cli.Completion.simple)
  | ["get"] | ["set"] | ["unset"] ->
    Config.knownKeys() |> Stdlib.List.map(Cli.Completion.simple)
  | _ -> []


let help(_state: Cli.AppState): String =
  [ "Usage:"
    "  config get <key>           - Get a configuration value"
    "  config set <key> <value>   - Set a configuration value"
    "  config unset <key>         - Go back to the default"
    "  config list                - List common configuration keys"
    ""
    "Examples:"
    "  config set trace.record on"
    "  config get exec.workers"
    "  config unset trace.record"
    ""
    "`config list` names every key a person sets, with its default; any other key is refused."
    "http.loopback, http.private and trace.record are yours alone: code you run cannot change them." ]
  |> Stdlib.String.join("\n")
