module Darklang.Cli.Config

/// Every key `config` answers for. The runtime keeps the list, and checks every value on set:
/// nothing reads an unknown key, so storing one would only hide a typo.
let knownKeys(): List<String> =
  LanguageTools.LocalStore.configKeys()


/// The key a typo most likely meant, when one is obvious: the part after the dot alone
/// (`record` for `trace.record`), or else the one nearest key. A tie is not obvious.
let nearestKey(key: String): Option<String> =
  let lower = Stdlib.String.toLowercase(key)
  let keys = knownKeys()
  let bySuffix =
    keys
    |> Stdlib.List.filter(fun k ->
      Stdlib.String.endsWith(Stdlib.String.toLowercase(k), "." + lower))

  match bySuffix with
  | [only] -> Option.Some(only)
  | _ ->
    match LanguageTools.Suggest.near(key, keys, []) with
    | [only] -> Option.Some(only)
    | _ -> Option.None


/// A key `config list` describes: what it does, and what applies while it is not set.
type Setting =
  { key: String
    what: String
    byDefault: String }


/// The keys a person is likely to set, in the order `config list` shows them. The runtime takes a
/// few more (the expert `exec.spread*` knobs), which `config get` answers for without a default.
let settings(): List<Setting> =
  [ Setting { key = "exec.workers", what = "Scheduler worker threads", byDefault = "one per core" }
    Setting
      { key = "exec.policy"
        what = "Expert: a Dark fn picking the next process"
        byDefault = "round robin" }

    Setting
      { key = "exec.maxInstructions"
        what = "Expert: stop a process past this many instructions"
        byDefault = "none" }

    Setting
      { key = "exec.maxBytes"
        what = "Expert: stop a process past this many bytes allocated"
        byDefault = "none" }

    Setting
      { key = "exec.spread"
        what = "Spread list work across idle cores, on or off"
        byDefault = "on" }

    Setting
      { key = "exec.storePollMs"
        what = "How often a --live view looks for a change, in ms, at least 10"
        byDefault = "25" }

    Setting
      { key = "http.requestTimeoutMs"
        what = "serve cancels a handler past this many ms and answers 504; 0 = none"
        byDefault = "30000" }

    Setting
      { key = "http.maxConnectionsPerHost"
        what = "How many connections your code's requests keep open to one host at once"
        byDefault = "50" }

    Setting
      { key = "trace.record", what = "Keep a record of every run, on or off", byDefault = "off" }

    Setting
      { key = "http.loopback"
        what = "let your code reach 127.0.0.1, on or off"
        byDefault = "off" }

    Setting
      { key = "http.private"
        what = "let your code reach private network addresses, on or off"
        byDefault = "off" }

    Setting
      { key = "trace.keep"
        what = "How many traces to keep, a served request being one; 0 = all"
        byDefault = "200" }

    Setting
      { key = "trace.maxMb"
        what = "How many MB traces may hold, logs and captured bodies; 0 = all"
        byDefault = "256" }

    Setting
      { key = "instance.name"
        what = "The name in the workbench header"
        byDefault = "this machine's hostname" } ]


/// The `DARK_CONFIG_*` name the runtime falls back to for <param key> while it is not set.
let shellSettingOf(key: String): Option<String> =
  match key with
  | "http.loopback" -> Option.Some("DARK_CONFIG_HTTP_LOOPBACK")
  | "http.private" -> Option.Some("DARK_CONFIG_HTTP_PRIVATE")
  | _ -> Option.None


/// One row of `config list`: the value in effect, and where it came from.
type Current =
  { key: String
    value: String
    /// `set`, `env` or `default`
    source: String
    what: String }


let row(s: Setting, value: String, source: String): Current =
  Current { key = s.key, value = value, source = source, what = s.what }


let current(s: Setting): Current =
  match LanguageTools.LocalStore.configGet(s.key) with
  | Some(v) -> row(s, v, "set")
  | None ->
    let fromEnv =
      match shellSettingOf(s.key) with
      | Some(name) -> Stdlib.Cli.Env.get(name)
      | None -> Option.None

    match fromEnv with
    | Some(v) when Stdlib.String.trim(v) != "" ->
      // the runtime takes only `on`; anything else leaves it off
      let on = Stdlib.String.toLowercase(Stdlib.String.trim(v)) == "on"
      row(s, (if on then "on" else "off"), "env")
    | _ -> row(s, s.byDefault, "default")


/// What applies while <param key> is not set, when `config list` says.
let defaultOf(key: String): Option<String> =
  settings()
  |> Stdlib.List.findFirst(fun s -> s.key == key)
  |> Stdlib.Option.map(fun s -> s.byDefault)


let unknownKeyMessage(key: String): String =
  let hint =
    match nearestKey(key) with
    | Some(k) -> $" Did you mean {k}?"
    | None -> ""

  $"{key} is not a config key.{hint} `config list` names the keys."


let execute(state: AppState, args: List<String>): AppState =
  let wantsJson = Stdlib.List.contains(args, "--json")
  let args = args |> Stdlib.List.filter(fun a -> a != "--json")
  match args with
  | ["get", key] when Stdlib.List.contains(knownKeys(), key) ->
    match LanguageTools.LocalStore.configGet(key) with
    | Some(value) -> Stdlib.printLine($"{key} = {value}")
    | None ->
      match defaultOf(key) with
      | Some(d) -> Stdlib.printLine($"{key} is not set (default: {d})")
      | None -> Stdlib.printLine($"{key} is not set")

    state
  | ["set", key, value] when Stdlib.List.contains(knownKeys(), key) ->
    match LanguageTools.LocalStore.configSet(key, value) with
    | Error(problem) ->
      printErr(problem)
      { state with exitCode = 1 }
    | Ok(_) ->
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Set {key} = {value}"))
      state
  | ["unset", key] when Stdlib.List.contains(knownKeys(), key) ->
    match LanguageTools.LocalStore.configUnset(key) with
    | Error(problem) ->
      printErr(problem)
      { state with exitCode = 1 }
    | Ok(_) ->
      let back =
        match defaultOf(key) with
        | Some(d) -> $" ({d})"
        | None -> ""

      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"{key} is back to its default{back}"))
      state
  | ["get", key] ->
    printErr(unknownKeyMessage(key))
    { state with exitCode = 1 }
  | ["unset", key] ->
    printErr(unknownKeyMessage(key))
    { state with exitCode = 1 }
  | ["set", key, _] ->
    printErr(unknownKeyMessage(key))
    { state with exitCode = 1 }
  | [] | ["list"] ->
    let rows = settings() |> Stdlib.List.map(current)
    if wantsJson then
      if printJson(Stdlib.Json.checkedSerialize<List<Current>>(rows)) then
        state
      else
        { state with exitCode = 1 }
    else
      let valueWidth =
        rows
        |> Stdlib.List.fold(0, fun(w, r) ->
          let rw = Stdlib.String.displayWidth(r.value)
          if rw > w then rw else w)

      let lines =
        rows
        |> Stdlib.List.map(fun r ->
          let key = Stdlib.Text.padEndToWidth(r.key, 28)
          let value = Stdlib.Text.padEndToWidth(r.value, valueWidth + 2)
          let source = Stdlib.Text.padEndToWidth(r.source, 9)
          $"  {key}{value}{source}{r.what}")

      Stdlib.List.flatten(
        [ [ "Common configuration keys:", "" ]
          lines
          [ ""
            "Use 'config get <key>' to read a value"
            "Use 'config set <key> <value>' to set a value"
            "Use 'config unset <key>' to go back to the default" ] ])
      |> Stdlib.printLines

      state
  | _ ->
    printErr("Invalid arguments")
    Stdlib.printErrorLine("")
    Stdlib.printErrorLine(help(state))
    { state with exitCode = 1 }


let complete(_state: AppState, args: List<String>): List<Completion.CompletionItem> =
  match args with
  | [] -> [ "get", "set", "unset", "list" ] |> Stdlib.List.map(Completion.simple)
  | ["get"] | ["set"] | ["unset"] -> knownKeys() |> Stdlib.List.map(Completion.simple)
  | _ -> []


let help(_state: AppState): String =
  [ "Usage:"
    "  config get <key>           - Get a configuration value"
    "  config set <key> <value>   - Set a configuration value"
    "  config unset <key>         - Go back to the default"
    "  config [list] [--json]     - List common keys, each with its value and where it came from"
    ""
    "Examples:"
    "  config set trace.record on"
    "  config get exec.workers"
    "  config unset trace.record"
    ""
    "`config list` names every key a person sets: its value, and whether that was set, came from"
    "the environment, or is the default. Any other key is refused."
    "http.loopback, http.private and trace.record are yours alone: code you run cannot change them." ]
  |> Stdlib.String.join("\n")
