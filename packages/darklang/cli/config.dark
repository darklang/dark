module Darklang.Cli.Config

// The config lives next to this instance's store (`localDbPath`), so the path is absolute and its
// directory always exists -- independent of the process CWD and of install mode. A CWD-relative
// path here makes `login` silently persist nothing.
let configFilePath(): String =
  let dbPath = Stdlib.LocalStore.path()
  let dir = Stdlib.String.join(Stdlib.List.dropLast(Stdlib.String.split(dbPath, "/")), "/")
  $"{dir}/cli-config.json"

let readConfig(): Dict<String, String> =
  match Stdlib.Cli.FileSystem.pathExists(configFilePath()) with
  | true ->
    match Stdlib.Cli.FileSystem.readFile(configFilePath()) with
    | Ok bytes ->
      let contents = Stdlib.Utf8.decodeWithReplacement(bytes)

      match Stdlib.Json.parse<Dict<String, String>>(contents) with
      | Ok config -> config
      | Error _ -> Dict {}

    | Error _ -> Dict {}

  | false -> Dict {}


let writeConfig(config: Dict<String, String>): Unit =
  let json = Stdlib.Json.serialize<Dict<String, String>>(config)
  let jsonBytes = Stdlib.Utf8.encode(json)
  let _ = Stdlib.Cli.FileSystem.overwriteFile(configFilePath(), jsonBytes)
  ()


let get(key: String): Stdlib.Option.Option<String> =
  let config = readConfig()
  Stdlib.Dict.get(config, key)

// A single Int config value, falling back to `default_` when absent or unparseable.
let getInt(key: String, default_: Int): Int =
  match get(key) with
  | Some s -> Stdlib.Result.withDefault(Stdlib.Int.parse(s), default_)
  | None -> default_


/// The keys the F# boot reads before any Dark runs (`exec.workers` sizes the scheduler's
/// worker pool, `trace.keep` the retention), so they live in the store's config rather than
/// in the json file. `startupSettings` and the `http.*` reads in `Cli.fs` are the readers.
val storeKeys =
  [ "exec.workers"
    "exec.policy"
    "exec.maxInstructions"
    "exec.maxBytes"
    "exec.storePollMs"
    "exec.spreadCrossover"
    "exec.spreadMinChunk"
    "exec.spreadPredict"
    "http.requestTimeoutMs"
    "http.loopback"
    "http.private"
    "trace.record"
    "trace.keep"
    "trace.maxMb" ]

/// The keys the json file holds, which the workbench reads. `instance.id` is written there on
/// first start and only read back here, never set.
val fileKeys = [ "instance.name", "instance.id" ]

/// Every key `config` answers for. Anything else is refused: nothing reads an unknown key, so
/// storing one would only hide a typo.
let knownKeys(): List<String> = Stdlib.List.append(Config.storeKeys, "instance.name")

let isStoreKey(key: String): Bool = Stdlib.List.contains(Config.storeKeys, key)

let smaller(a: Int, b: Int): Int = if a < b then a else b

/// Edits (insert, delete, substitute) between two strings, for "did you mean".
let editDistance(a: String, b: String): Int =
  let bs = Stdlib.String.toList(b)
  let firstRow = Stdlib.List.range(0, Stdlib.List.length(bs))

  let lastRow =
    Stdlib.String.toList(a)
    |> Stdlib.List.indexedMap(fun i ca -> (i, ca))
    |> Stdlib.List.fold(firstRow, fun prev pair ->
      let (i, ca) = pair

      bs
      |> Stdlib.List.indexedMap(fun j cb -> (j, cb))
      |> Stdlib.List.fold([ i + 1 ], fun row pair ->
        let (j, cb) = pair
        // `row` is built back to front, so its head is the cell to the left.
        let left = Stdlib.Option.withDefault(Stdlib.List.head(row), 0)
        let up = Stdlib.Option.withDefault(Stdlib.List.getAt(prev, j + 1), 0)
        let diag = Stdlib.Option.withDefault(Stdlib.List.getAt(prev, j), 0)
        let cost = if ca == cb then 0 else 1
        Stdlib.List.prepend(row, Config.smaller(Config.smaller(left + 1, up + 1), diag + cost)))
      |> Stdlib.List.reverse)

  Stdlib.Option.withDefault(Stdlib.List.last(lastRow), 0)

/// The key a typo most likely meant, when one is obvious: the same name in another case, the
/// part after the dot alone (`record` for `trace.record`), or two edits away at most.
let nearestKey(key: String): Stdlib.Option.Option<String> =
  let lower = Stdlib.String.toLowercase(key)
  let keys = Config.knownKeys()

  let bySuffix =
    keys
    |> Stdlib.List.filter(fun k ->
      Stdlib.String.endsWith(Stdlib.String.toLowercase(k), "." + lower))

  match bySuffix with
  | [only] -> Stdlib.Option.Option.Some only
  | _ ->
    let scored =
      keys
      |> Stdlib.List.map(fun k -> (Config.editDistance(lower, Stdlib.String.toLowercase(k)), k))
      |> Stdlib.List.sortBy(fun pair ->
        let (d, _) = pair
        d)

    match scored with
    | [(d, k), ...rest] when d <= 2 ->
      match rest with
      // A tie is not obvious.
      | [(d2, _), ...] when d2 == d -> Stdlib.Option.Option.None
      | _ -> Stdlib.Option.Option.Some k
    | _ -> Stdlib.Option.Option.None

let unknownKeyMessage(key: String): String =
  let hint =
    match Config.nearestKey(key) with
    | Some k -> $" Did you mean {k}?"
    | None -> ""
  $"{key} is not a config key.{hint} `config list` names the keys."

/// A package function `exec.policy` can name: a dotted name, or `#` and an exact hash, as
/// `resolvePackageFn` in `Cli.fs` reads it.
let policyResolves(branchId: Uuid, name: String): Bool =
  if Stdlib.String.startsWith(name, "#") then
    let hash = Stdlib.String.dropFirst(name, 1)
    (Stdlib.String.length(hash) == 64)
    && (Stdlib.Option.isSome(
      LanguageTools.PackageManager.Function.get(LanguageTools.ProgramTypes.Hash.Hash hash)))
  else
    Stdlib.Option.isSome(
      LanguageTools.PackageManager.Function.find(
        branchId,
        LanguageTools.ProgramTypes.parsePackageLocation(name)))

/// What a value must look like, or `None` when it will do: the boot falls back silently on a
/// value it cannot read, so the refusal has to happen here.
let checkValue(
  branchId: Uuid,
  key: String,
  value: String)
  : Stdlib.Option.Option<String> =
  let wholeNumber =
    [ "exec.workers"
      "exec.maxInstructions"
      "exec.maxBytes"
      "exec.storePollMs"
      "exec.spreadMinChunk"
      "http.requestTimeoutMs"
      "trace.keep"
      "trace.maxMb" ]
  if Stdlib.List.contains(wholeNumber, key) then
    match Stdlib.Int.parse(value) with
    // The boot ignores a poll under 10 ms (`Cli.fs`), so refuse it here rather than store it.
    | Ok n when key == "exec.storePollMs" && n < 10 ->
      Stdlib.Option.Option.Some $"{key} takes a whole number of ms, 10 or more, not {value}"
    | Ok n when n >= 0 -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.Some $"{key} takes a whole number (0 = none), not {value}"
  else if key == "exec.spreadCrossover" then
    match Stdlib.Int.parse(value) with
    | Ok _ -> Stdlib.Option.Option.None
    | _ ->
      Stdlib.Option.Option.Some $"{key} takes a whole number (below 0 = never spread), not {value}"
  else if
    Stdlib.List.contains(
      [ "trace.record", "http.loopback", "http.private", "exec.spreadPredict" ],
      key)
  then
    if (value == "on") || (value == "off") then Stdlib.Option.Option.None
    else Stdlib.Option.Option.Some $"{key} is on or off"
  else if key == "exec.policy" then
    // Empty is the round-robin default again.
    if (value == "") || (Config.policyResolves(branchId, value)) then
      Stdlib.Option.Option.None
    else
      Stdlib.Option.Option.Some
        $"{key} names a package function, and {value} is not one on this branch"
  else if key == "instance.name" then
    if Stdlib.String.trim(value) == "" then
      Stdlib.Option.Option.Some $"{key} needs a name"
    else
      Stdlib.Option.Option.None
  else
    Stdlib.Option.Option.None

let execute(state: Cli.AppState, args: List<String>): Cli.AppState =
  match args with
  | ["get", key] when isStoreKey(key) ->
    let value = Stdlib.LocalStore.configGet(key)
    if value == "" then
      Stdlib.printLine($"{key} is not set (the default applies; `config list` has it)")
    else
      Stdlib.printLine($"{key} = {value}")
    state

  | ["set", key, value] when isStoreKey(key) ->
    match checkValue(state.currentBranchId, key, value) with
    | Some problem ->
      Cli.printErr(problem)
      { state with exitCode = 1 }
    | None ->
      let _ = Stdlib.LocalStore.configSet(key, value)
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Set {key} = {value}"))
      state

  | ["get", key] when Stdlib.List.contains(Config.fileKeys, key) ->
    match get(key) with
    | Some value -> Stdlib.printLine($"{key} = {value}")
    | None -> Stdlib.printLine($"{key} is not set (the default applies; `config list` has it)")
    state

  | ["set", "instance.id", _] ->
    Cli.printErr("instance.id is written by the workbench on first start, and cannot be set")
    { state with exitCode = 1 }

  | ["set", "instance.name", value] ->
    match checkValue(state.currentBranchId, "instance.name", value) with
    | Some problem ->
      Cli.printErr(problem)
      { state with exitCode = 1 }
    | None ->
      writeConfig(Stdlib.Dict.set(readConfig(), "instance.name", value))
      Stdlib.printLine(Stdlib.Cli.UI.Colors.success($"Set instance.name = {value}"))
      state

  | ["get", key] ->
    Cli.printErr(Config.unknownKeyMessage(key))
    { state with exitCode = 1 }

  | ["set", key, _] ->
    Cli.printErr(Config.unknownKeyMessage(key))
    { state with exitCode = 1 }

  | ["list"] ->
    // List all common config keys
    [ "Common configuration keys:"
      ""
      "  exec.workers             - Scheduler worker threads (default: one per core)"
      "  exec.policy              - Expert: a Dark fn picking the next process (default: round robin)"
      "  exec.maxInstructions     - Expert: stop a process past this many instructions (default: none)"
      "  exec.maxBytes            - Expert: stop a process past this many bytes allocated (default: none)"
      "  exec.storePollMs         - How often a --live view looks for a change (default: 25; minimum 10)"
      "  http.requestTimeoutMs    - serve cancels a handler past this and answers 504 (default: 30000; 0 = none)"
      "  trace.record             - Keep a record of every run (on/off; default: off)"
      "  http.loopback            - let your code reach 127.0.0.1 (on/off; default: off)"
      "  http.private             - let your code reach private network addresses (on/off; default: off)"
      "  trace.keep               - How many traces to keep (a served request is one; default: 200; 0 = all)"
      "  trace.maxMb              - How many MB traces may hold, logs and captured bodies (default: 256; 0 = all)"
      "  instance.name            - The name in the workbench header (default: this machine's hostname)"
      ""
      "Use 'config get <key>' to read a value"
      "Use 'config set <key> <value>' to set a value" ]
    |> Stdlib.printLines
    state

  | _ ->
    Cli.printErr("Invalid arguments")
    Stdlib.printErrorLine("")
    Stdlib.printErrorLine(help(state))
    { state with exitCode = 1 }


let complete(_state: Cli.AppState, args: List<String>): List<Cli.Completion.CompletionItem> =
  match args with
  | [] ->
    ["get", "set", "list"] |> Stdlib.List.map(Cli.Completion.simple)
  | ["get"] | ["set"] ->
    Config.knownKeys() |> Stdlib.List.map(Cli.Completion.simple)
  | _ -> []


let help(_state: Cli.AppState): String =
  [ "Usage:"
    "  config get <key>           - Get a configuration value"
    "  config set <key> <value>   - Set a configuration value"
    "  config list                - List common configuration keys"
    ""
    "Examples:"
    "  config set trace.record on"
    "  config get exec.workers"
    ""
    "`config list` names every key a person sets, with its default; any other key is refused." ]
  |> Stdlib.String.join("\n")
