module Darklang.Cli.Caps.App

// The interactive capability editor as a `Cli.Component`: the http/exec/access rule editors + flag toggles
// + profile picker over a working copy of the grant, written via `pmCapsSet`. The terminal lifecycle lives
// in `Cli.Component`.

let view (state: Main.State) (size: Darklang.Stdlib.Cli.Tui.Size) : Darklang.Stdlib.Cli.Tui.View =
  Main.viewAtSize state size

let onKey
  (state: Main.State)
  (key: Stdlib.Cli.Stdin.Key.Key)
  (modifiers: Stdlib.Cli.Stdin.Modifiers.Modifiers)
  (keyChar: Stdlib.Option.Option<String>)
  : Darklang.Cli.Component.Step<Main.State> =
  match Main.handleKey state key modifiers keyChar with
  | Continue next -> Darklang.Cli.Component.Step.Stay next
  | Save next -> Darklang.Cli.Component.Step.Save next
  // Escape/q discard the working copy. The persisted grant is already `state.saved`, so exiting must not
  // rewrite it.
  | Exit next -> Darklang.Cli.Component.Step.Exit next

let save (state: Main.State) : Main.State =
  Main.save state
  state

val component =
  Darklang.Cli.Component.simple view onKey save

let execute (cliState: Darklang.Cli.AppState) (_args: List<String>) : Darklang.Cli.AppState =
  Darklang.Cli.Component.launch cliState component (Main.load ())

let help (_state: Darklang.Cli.AppState) : String =
  [ "Usage: caps-edit"
    "Interactive editor for this instance's capability grant."
    ""
    "  Up/Down      Move between rows"
    "  Space        Toggle a flag capability (random, clock, …)"
    "  Enter        Edit the selected rule (or toggle a flag)"
    "  a            Add a rule (http-client / file / env / db / exec)"
    "  d            Delete the selected rule"
    "  p            Apply a profile (replaces the grant)"
    "  w            Write the grant to ~/.darklang/capabilities.bin"
    "  Esc          Exit (discards unsaved edits)"
    ""
    "Inside a rule editor: Tab switches field, arrows cycle/move, Enter saves, Esc cancels." ]
  |> Stdlib.String.join "\n"

let complete
  (_state: Darklang.Cli.AppState)
  (_args: List<String>)
  : List<Darklang.Cli.Completion.CompletionItem> =
  []
