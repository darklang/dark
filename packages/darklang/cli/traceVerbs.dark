/// The trace half of `dark traces`: showing one trace, resuming it, forking it, pinning it.
///
/// These verbs and the reading verbs in `cli/tracing.dark` work on the
/// same rows. What is running right now is `dark ps`; this is what ran, kept.
module Darklang.Cli.TraceVerbs


/// The name the trace index would have recorded, given what a person typed.
///
/// `Stdlib.List.map` is how everyone writes it and how the rest of the CLI accepts
/// it, but the index stores the name a hash resolves to, which is owner-first:
/// `Darklang.Stdlib.List.map`. Without this, `traces calls Stdlib.List.map` answered
/// "no recorded trace went through Stdlib.List.map" about a function with plenty of
/// traces -- an empty ANSWER to what was really a spelling this command did not take,
/// which is the worst of both. `dark view` takes the short form, so these should
/// too.
let canonicalFnName (branchId: Uuid) (typed: String) : String =
  let resolves (name: String) : Bool =
    (LanguageTools.PackageManager.Function.find
      branchId
      (LanguageTools.ProgramTypes.parsePackageLocation name))
    != Stdlib.Option.Option.None

  if resolves typed then
    typed
  else
    let qualified = $"Darklang.{typed}"
    if resolves qualified then qualified else typed


/// Why a trace question came back empty, as the line or two that goes under the
/// answer.
///
/// "Nothing here" has more than one cause, they are not equally the person's fault,
/// and the advice under each is different. Recording OFF means nothing could have
/// been kept and doing the thing again will not help; recording ON means it simply
/// has not happened yet. One vague line covering both used to tell someone with
/// recording off to go and run it again, which is the one piece of advice that
/// cannot work.
///
/// <param doing> is what they would do about it, in the imperative: "run something
/// that calls it", "run something".
let whyEmpty (doing: String) : List<String> =
  if Darklang.Tracing.Store.enabled () then
    [ $"  recording is on, so {doing} and look again" ]
  else
    [ "  recording is off, so nothing has been kept at all"
      $"  dark traces record on    then {doing}" ]


/// The shortest prefix that tells THESE ids apart, which is what a table should print.
///
/// Eight is almost always enough, and a table that prints more than it needs to spends the
/// width on nothing. Git shortens commit ids the same way, for the same reason.
let idWidth (ids: List<String>) : Int =
  let distinct (w: Int) : Bool =
    let prefixes = ids |> Stdlib.List.map (fun id -> Stdlib.String.slice id 0 w)
    (Stdlib.List.length (Stdlib.List.unique prefixes)) == (Stdlib.List.length ids)

  match Stdlib.List.findFirst [ 8, 12, 16, 24 ] (fun w -> distinct w) with
  | Some w -> w
  | None -> 36


let statusText (status: Darklang.Tracing.Status) : String =
  match status with
  | Running -> "running"
  | Done -> "done"
  | Failed -> "failed"
  | Suspended -> "suspended"


/// The trace whose id starts with `prefix`, when exactly one does.
let find (prefix: String) : Stdlib.Result.Result<Darklang.Tracing.Trace, String> =
  match Darklang.Tracing.Store.resolveID prefix with
  | Error e -> Stdlib.Result.Result.Error e
  | Ok id ->
    match Darklang.Tracing.Store.get id with
    | Some t -> Stdlib.Result.Result.Ok t
    | None -> Stdlib.Result.Result.Error $"no trace has the id {id}"


/// "22 minutes ago", from the stamp the store keeps (ISO with fractional seconds, which the
/// parser does not take: the fraction is cut).
let whenText (created: String) : String =
  let whole =
    match Stdlib.String.split created "." with
    | [ s ] -> s
    | s :: _ -> s ++ "Z"
  match Stdlib.DateTime.parse whole with
  | Ok t -> Cli.RelativeTime.ago t
  | Error _ -> created


/// One row of the trace table. Deliberately narrow: `Table.print` pads to the widest cell and
/// does not wrap, so a column that is usually empty costs every row its width. The fork lineage
/// and the full input are in `traces show`.
let row (width: Int) (e: Darklang.Tracing.Trace) : List<String> =
  // A `*` on the id rather than a column of its own. A pin column is four characters of width on
  // every row for a flag almost no row has, and `input` is the column that truncates.
  let id =
    if e.pinned then
      $"*{Stdlib.String.slice e.id 0 width}"
    else
      $" {Stdlib.String.slice e.id 0 width}"

  [ id
    statusText e.status
    whenText e.created
    Cli.Text.oneLineAt 22 e.entry
    Cli.Text.oneLineAt 22 e.input ]


/// Any list of traces, as a table. The ONE renderer: `dark traces`, `traces list --fn`,
/// `traces find` and `traces calls` all come through here, so none of them can drift into
/// showing a different set of columns for the same rows.
let printTable (traces: List<Darklang.Tracing.Trace>) : Unit =
  let width = idWidth (traces |> Stdlib.List.map (fun e -> e.id))
  Stdlib.Cli.UI.Table.print
    [ " id", "status", "when", "what ran", "input" ]
    (traces |> Stdlib.List.map (fun e -> row width e))



/// Where a fork branched from: the trace, and the position in its log the fork kept.
type ForkJson =
  { trace: String
    at: Int64 }


/// A trace as `--json` hands it over.
///
/// Every recorded value is a STRING here, rendered the way the terminal renders it. The stored
/// form is a typed Dval, and serializing that gives `{"Some":[{"DInt64":[42]}]}` -- faithful,
/// and not what the program said. Whoever reads this wants `42`, and a value they can paste
/// back into Dark. The type is also flat, so `.answered` does not mean reaching through an
/// option-of-a-union.
type TraceJson =
  { id: String
    /// `eval`, `run <file>`, `GET /path`.
    entry: String
    input: String
    /// What the trace answered. Absent while it is still going, and for one that failed.
    answered: Stdlib.Option.Option<String>
    status: String
    pinned: Bool
    /// Wall clock for the whole trace. Absent for one still going.
    durationMs: Stdlib.Option.Option<Int64>
    forkedFrom: Stdlib.Option.Option<ForkJson>
    created: String
    updated: String }


/// One recorded call, as `--json` hands it over. Same rule about values as `TraceJson`.
type CallJson =
  { /// Where the call sits in the trace's log: what `fork --at` takes.
    pos: Int64
    fn: String
    args: List<String>
    result: String
    durationMs: Int
    /// The process that made the call, for a trace that spawned any.
    process: Stdlib.Option.Option<String> }


/// What `traces inspect --json` hands back: the trace, and the impure calls it logged.
type TraceWithCallsJson =
  { trace: TraceJson
    calls: List<CallJson> }


/// What `traces show --json` hands back: which trace was read, and what each expression in the
/// code evaluated to, keyed by the expression's id. `problem` is set when the replay stopped.
/// One pass of one loop, for `--json`: what an agent needs to ask for it, and what it produced.
type LoopPassJson =
  { pass: Int64
    /// `--expand map:3`, ready to use.
    expand: String
    /// The values this pass produced, by expression id. Everything the pass saw, at once, so an
    /// agent never has to walk in one step at a time.
    values: Dict<String, String> }


/// A repeated call site, for `--json`.
type LoopJson =
  { /// `map`, `fold`, `map#2`: the function this is a loop of. What `--expand` takes.
    name: String
    passCount: Int
    passes: List<LoopPassJson> }


type ValuesJson =
  { trace: String
    fn: String
    values: Dict<String, String>
    /// The loops, with every pass and every pass's values.
    ///
    /// A person navigates a step at a time because a screen holds one thing. An agent has no
    /// such limit and a round trip costs it more than the bytes do, so the whole tree comes back
    /// in one call. `values` above is still the flat view, which is what a reader of the code
    /// wants; these are what tells pass 3 from pass 7.
    loops: List<LoopJson>
    problem: Stdlib.Option.Option<String> }


/// A trace, for `--json`. The ONE converter: `list`, `find`, `calls`, `follow` and `inspect` all come
/// through here, so no two of them can hand back a trace with different fields in it.
let traceJson (branchId: Uuid) (trace: Darklang.Tracing.Trace) : TraceJson =
  TraceJson
    { id = trace.id
      entry = trace.entry
      input = trace.input
      answered =
        trace.result
        |> Stdlib.Option.map (fun dv -> Darklang.Tracing.Format.compactDval branchId dv)
      status = statusText trace.status
      pinned = trace.pinned
      durationMs =
        if trace.durationMs > 0L then
          Stdlib.Option.Option.Some trace.durationMs
        else
          Stdlib.Option.Option.None
      forkedFrom =
        trace.parent
        |> Stdlib.Option.map (fun p ->
          let (id, at) = p
          ForkJson { trace = id; at = at })
      created = trace.created
      updated = trace.updated }


/// One logged call, for `--json`.
let callJson (branchId: Uuid) (call: Darklang.Tracing.FnCall) : CallJson =
  CallJson
    { pos = call.seq
      fn = call.fnName
      args =
        call.args
        |> Stdlib.List.map (fun a -> Darklang.Tracing.Format.compactDval branchId a)
      result = Darklang.Tracing.Format.compactDval branchId call.result
      durationMs = call.durationMs
      process = call.processId |> Stdlib.Option.map (fun p -> Stdlib.Uuid.toString p) }


/// A list of traces, as JSON. Every listing verb prints through this.
let printTracesJson (branchId: Uuid) (traces: List<Darklang.Tracing.Trace>) : Unit =
  Stdlib.printLine
    (Stdlib.Json.serialize<List<TraceJson>>
      (traces |> Stdlib.List.map (fun r -> traceJson branchId r)))


/// One run and its log, as JSON.
let printInspectJson (branchId: Uuid) (prefix: String) : Bool =
  match find prefix with
  | Error e ->
    Cli.printErr e
    false
  | Ok trace ->
    let calls =
      match Darklang.Tracing.Store.view trace.id with
      | Some data ->
        data.functionCalls
        |> Stdlib.List.filter (fun c -> c.ord >= 0L)
        |> Stdlib.List.map (fun c -> callJson branchId c)
      | None -> []
    Stdlib.printLine
      (Stdlib.Json.serialize<TraceWithCallsJson>
        (TraceWithCallsJson { trace = traceJson branchId trace; calls = calls }))
    true


/// Run the trace's input again, replaying its log. `eval` and `run <file>` go through the paths
/// they always do; the armed resume is what makes them replay.
/// The functions a trace went through that have been EDITED since it ran.
///
/// A resume replays the log the trace recorded against whatever those names mean now,
/// so the old trace meets the new callees. That is often the point (resume after you
/// fixed the thing that stopped it), and it is never something the trace itself can
/// notice, so it is said rather than refused -- the same call the replay table makes
/// for a file whose bytes moved.
///
/// A name that has since been DELETED is not in here: the resume will fail on it for
/// itself, with a better message than this could give.
///
/// The names come from `trace_fns`, which resolves each hash the trace went through to a name at
/// store time. A package hash is STRUCTURAL, so two functions with identical bodies share one and
/// the name you get is whichever of them the store resolves it to. The comparison is still sound
/// -- that name is bound to that hash -- but the name printed can be a sibling's.
let movedSince
  (branchId: Uuid)
  (traceID: String)
  : List<String> =
  (Darklang.Tracing.Store.fnsWithHashes traceID)
  |> Stdlib.List.filterMap (fun pair ->
    let (name, recorded) = pair
    let location = LanguageTools.ProgramTypes.parsePackageLocation name

    match LanguageTools.PackageManager.Function.find branchId location with
    | Some current ->
      if (LanguageTools.ProgramTypes.hashToString current) == recorded then
        Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.Some name
    | None -> Stdlib.Option.Option.None)


let resume (state: AppState) (prefix: String) : AppState =
  match find prefix with
  | Error e ->
    Cli.printErr e
    { state with exitCode = 1 }
  | Ok e ->
    if Darklang.Tracing.Store.armResume e.id then
      Stdlib.printLine $"resuming {Cli.Text.shortIdText e.id}: {Cli.Text.oneLine e.input}"

      match movedSince state.currentBranchId e.id with
      | [] -> ()
      | moved ->
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.warning "  edited since this ran:")
        Stdlib.List.iter moved (fun name ->
          Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"    {name}"))
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.dimText
            "  the log answers what already happened; everything after it runs the new code")
      // An entry is `eval` or `run <file>`, as the host records them; a served request is a run
      // too, but re-running one needs the server, so it is refused here rather than guessed at.
      if e.entry == "eval" then
        match Eval.evaluate state e.input false with
        | Ok(Some s) ->
          Stdlib.printLine s
          state
        | Ok None -> state
        | Error message ->
          Stdlib.printLine $"Error: {message}"
          { state with exitCode = 1 }
      else if Stdlib.String.startsWith e.entry "run " then
        let filename = Stdlib.String.dropFirst e.entry 4
        Run.runScript state filename e.input [] false false false [] 0
      else
        Cli.printErr
          $"{Cli.Text.shortIdText e.id} was a served request ({e.entry}); resume only re-runs `eval` and"
        Stdlib.printLine
          $"  `run <file>`. `dark traces show <fn> {Cli.Text.shortIdText e.id}` shows what it did."
        { state with exitCode = 1 }
    else
      Cli.printErr $"{Cli.Text.shortIdText e.id} is gone: it was deleted while this command ran"
      { state with exitCode = 1 }


let fork (prefix: String) (at: Stdlib.Option.Option<Int64>) : Bool =
  match find prefix with
  | Error e ->
    Cli.printErr e
    false
  | Ok e ->
    match Darklang.Tracing.Store.fork e.id at with
    | Ok child ->
      Stdlib.printLine $"forked {Cli.Text.shortIdText e.id} as {Cli.Text.shortIdText child}"
      Stdlib.printLine $"  resume it with: dark traces resume {Cli.Text.shortIdText child}"
      true
    | Error msg ->
      Cli.printErr msg
      false


let pin (prefix: String) (pinned: Bool) : Bool =
  match find prefix with
  | Error e ->
    Cli.printErr e
    false
  | Ok e ->
    if Darklang.Tracing.Store.setPinned e.id pinned then
      if pinned then
        Stdlib.printLine
          $"pinned {Cli.Text.shortIdText e.id} -- it will not be dropped to make room"
      else
        Stdlib.printLine $"unpinned {Cli.Text.shortIdText e.id}"
      true
    else
      Cli.printErr $"{Cli.Text.shortIdText e.id} is gone: it was deleted while this command ran"
      false


// ───────── the call inbox: which runs went through a function, and its values ─────────
//
// Classic showed a handler's requests as dots down the left and, for the selected one, the
// value of every expression beside the code. These two verbs are that, for any function.
//
// `traces calls <fn>` is the dots: the traces that went through the function, from the names-only
// index every recorded trace writes.
//
// `traces show <fn> [<trace>]` is the code with the values. It replays the whole trace with every
// effectful call answered from that trace's log -- by name and arguments, classic's key -- and
// performs none of them. Looking at code never touches the world. A call the log cannot answer
// stops the view and says which one it was, rather than going and doing it.


/// "12 minutes ago  GET /orders  a1b2c3d4", one line per trace that went through the function.
/// The branch is not a parameter: the index records the name a trace went through, so a run
/// recorded against another branch's version of the function is still a trace that went through
/// this name. `values` resolves the CODE on the branch you are standing on.
/// Unit, not Bool, unlike its neighbours: "no recorded trace went through this function" is an
/// ANSWER, not a refusal. A command that was asked a question and answered it truthfully
/// succeeded, however empty the answer. Naming something that does not exist is the other
/// thing, and that is what exits non-zero.
let printCalls (branchId: Uuid) (typed: String) : Unit =
  let fnName = canonicalFnName branchId typed

  match Darklang.Tracing.Store.wentThrough fnName 25L with
  | [] ->
    Stdlib.printLine $"no recorded trace went through {fnName}"
    (whyEmpty "run something that calls it")
    |> Stdlib.List.iter (fun line ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText line))
  | traces ->
    printTable traces
    Stdlib.printLine ""
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  dark traces show <fn> <trace>  the code, with that trace's values beside it")


/// The values `traces show` would print beside the code, as JSON: the ids and the values,
/// with no source. What an agent wants, since it can read the code already.
let printValuesJson
  (branchId: Uuid)
  (typed: String)
  (tracePrefix: Stdlib.Option.Option<String>)
  : Bool =
  let fnName = canonicalFnName branchId typed

  let chosen =
    match tracePrefix with
    | Some prefix -> find prefix
    | None ->
      match Darklang.Tracing.Store.wentThrough fnName 1L with
      | [ newest ] -> Stdlib.Result.Result.Ok newest
      | _ ->
        Stdlib.Result.Result.Error $"no recorded trace went through {fnName}"

  match chosen with
  | Error e ->
    Cli.printErr e
    false
  | Ok trace ->
    let (collected, frames, frameValues, problem) =
      Darklang.Tracing.Store.viewTraceTree branchId trace.id

    let values =
      collected
      |> Stdlib.List.map (fun pair ->
        let (id, dv) = pair
        (Stdlib.Int64.toString id, Darklang.Tracing.Format.compactDval branchId dv))
      |> Stdlib.Dict.fromListOverwritingDuplicates

    let loops =
      (loopSites frames (Darklang.Tracing.Store.fnsWithHashes trace.id))
      |> Stdlib.List.map (fun loop ->
        let passes =
          loop.passes
          |> Stdlib.List.map (fun f ->
            let mine =
              frameValues
              |> Stdlib.List.filter (fun row ->
                let (fid, _, _) = row
                fid == f.id)
              |> Stdlib.List.map (fun row ->
                let (_, exprId, dv) = row

                (Stdlib.Int64.toString exprId,
                 Darklang.Tracing.Format.compactDval branchId dv))
              |> Stdlib.Dict.fromListOverwritingDuplicates

            let p = Stdlib.Int64.toString (f.pass + 1L)

            LoopPassJson
              { pass = f.pass + 1L
                expand = $"{loop.name}:{p}"
                values = mine })

        LoopJson
          { name = loop.name
            passCount = Stdlib.List.length loop.passes
            passes = passes })

    Stdlib.printLine
      (Stdlib.Json.serialize<ValuesJson>
        (ValuesJson
          { trace = trace.id
            fn = fnName
            values = values
            loops = loops
            problem = problem }))
    true


/// A repeated call site in one trace: a lambda that ran more than once, which is what a loop is.
///
/// Numbered `[1]`, `[2]` in the order the passes first ran, because that is a label a person can
/// type. Expression ids are the real key and are sixteen digits of nothing to a reader.
type LoopSite =
  { /// What a person types: `--expand map`.
    ///
    /// The function the lambda was passed to, short: `map`, `fold`, `filter`. A name from the
    /// code rather than a number from the rendering, so it survives another loop being added
    /// above it and means something without a legend. Two loops of the same function in one
    /// place are `map` and `map#2`, in the order they run.
    name: String
    /// The lambda's expression id, which is what the frames are keyed by.
    callSite: Int64
    /// One frame per pass, in the order they ran.
    passes: List<Darklang.Tracing.Store.ViewFrame> }


/// The repeated call sites of a trace, numbered, in the order they first ran.
///
/// A call site that ran ONCE is not a loop and is not listed: there is nothing to choose between,
/// and its value is already on the line.
let loopSites
  (frames: List<Darklang.Tracing.Store.ViewFrame>)
  (fnNames: List<String * String>)
  : List<LoopSite> =
  let lambdas =
    frames |> Stdlib.List.filter (fun f -> f.kind == "lambda")

  // The function a lambda was passed to is its PARENT frame: `List.map` pushes a frame, and
  // applies the lambda inside it. That is where a loop's name comes from.
  // A package frame carries the callee's HASH. The trace records hash-to-name for every
  // function it went through, which is what turns it back into `map`.
  let shortNameOf (frameId: String) : String =
    frames
    |> Stdlib.List.findFirst (fun f -> f.id == frameId)
    |> Stdlib.Option.map (fun parent ->
      if parent.kind == "function" then
        fnNames
        |> Stdlib.List.findFirst (fun pair -> (Stdlib.Tuple2.second pair) == parent.callee)
        |> Stdlib.Option.map (fun pair ->
          Stdlib.Tuple2.first pair
          |> Stdlib.String.split "."
          |> Stdlib.List.last
          |> Stdlib.Option.withDefault "loop")
        |> Stdlib.Option.withDefault "loop"
      else
        "loop")
    |> Stdlib.Option.withDefault "loop"

  // The distinct call sites, in the order they first appear.
  let sites =
    lambdas
    |> Stdlib.List.fold [] (fun acc f ->
      if Stdlib.List.member acc f.callSite then acc else Stdlib.List.append acc [ f.callSite ])

  sites
  |> Stdlib.List.map (fun site ->
    let passes =
      lambdas
      |> Stdlib.List.filter (fun f -> f.callSite == site)
      |> Stdlib.List.sortBy (fun f -> f.pass)

    (site, passes))
  |> Stdlib.List.filter (fun pair ->
    let (_site, passes) = pair
    (Stdlib.List.length passes) > 1)
  |> Stdlib.List.map (fun pair ->
    let (site, passes) = pair

    let base' =
      passes
      |> Stdlib.List.head
      |> Stdlib.Option.map (fun f -> shortNameOf f.parent)
      |> Stdlib.Option.withDefault "loop"

    (base', site, passes))
  // Two loops of the same function get `map` and `map#2`, in the order they ran. Numbering only
  // the repeats keeps the common case a plain word.
  |> Stdlib.List.fold [] (fun acc triple ->
    let (base', site, passes) = triple

    let seen =
      acc
      |> Stdlib.List.filter (fun l ->
        (l.name == base') || (Stdlib.String.startsWith l.name $"{base'}#"))
      |> Stdlib.List.length

    let name = if seen == 0 then base' else $"{base'}#{Stdlib.Int.toString (seen + 1)}"

    Stdlib.List.append
      acc
      [ LoopSite { name = name; callSite = site; passes = passes } ])


/// Put a set of passes' values onto the page, for one loop.
///
/// Several passes on one line, comma-separated: `// = "/r/AA.json", "/r/BBBB.json"`. That is
/// what expanding a loop MEANS here -- the line is the same line, and it carries what it was
/// each time round rather than what it happened to be on the last.
///
/// Built on top of the flat values, so every line OUTSIDE the loop keeps what it did. Without
/// that, expanding a loop would blank the function around it, which is the context that makes
/// the pass mean anything.
let mergePassValues
  (branchId: Uuid)
  (base': Dict<String, String>)
  (frameValues: List<(String * Int64 * LanguageTools.RuntimeTypes.Dval)>)
  (passes: List<Darklang.Tracing.Store.ViewFrame>)
  : Dict<String, String> =
  let ids = passes |> Stdlib.List.map (fun f -> f.id)

  let mine =
    frameValues
    |> Stdlib.List.filter (fun row ->
      let (fid, _, _) = row
      Stdlib.List.member ids fid)
    |> Stdlib.List.map (fun row ->
      let (_, exprId, dv) = row

      (Stdlib.Int64.toString exprId,
       PrettyPrinter.RuntimeTypes.dvalOneLine branchId 40 dv))

  // One entry per expression, its passes joined in the order they ran. Built by walking the
  // distinct keys rather than folding into a dict, because `Dict.set` refuses a key it already
  // has -- it adds, it does not overwrite.
  let keys =
    mine
    |> Stdlib.List.fold [] (fun acc pair ->
      let k = Stdlib.Tuple2.first pair
      if Stdlib.List.member acc k then acc else Stdlib.List.append acc [ k ])

  let joined =
    keys
    |> Stdlib.List.map (fun k ->
      let vs =
        mine
        |> Stdlib.List.filter (fun pair -> (Stdlib.Tuple2.first pair) == k)
        |> Stdlib.List.map (fun pair -> Stdlib.Tuple2.second pair)

      (k, Stdlib.String.join vs ", "))

  // The expanded values last, so they win over the flat one on the same line.
  Stdlib.List.append (Stdlib.Dict.toList base') joined
  |> Stdlib.Dict.fromListOverwritingDuplicates


/// The function's source, with `// = value` beside each call, for one trace.
let printValues
  (state: AppState)
  (typed: String)
  (tracePrefix: Stdlib.Option.Option<String>)
  (expand: Stdlib.Option.Option<String>)
  : AppState =
  let branchId = state.currentBranchId
  let fnName = canonicalFnName branchId typed
  let entry = LanguageTools.ProgramTypes.parsePackageLocation fnName

  // Does the function exist at all? Asked FIRST, because the two failures read the same way
  // and are not the same thing: a name nothing has run is an empty answer, and a name that is
  // not a function is a refusal. Asking in the other order told you "no recorded trace went
  // through Stdlib.List.mpa" about a typo.
  if
    (LanguageTools.PackageManager.Function.find branchId entry)
    == Stdlib.Option.Option.None
  then
    Cli.printErr $"no function named {fnName} on this branch"
    { state with exitCode = 1 }
  else

  let chosen =
    match tracePrefix with
    | Some prefix ->
      match find prefix with
      | Ok r -> Stdlib.Option.Option.Some r
      | Error e ->
        Cli.printErr e
        Stdlib.Option.Option.None
    | None ->
      match Darklang.Tracing.Store.wentThrough fnName 1L with
      | [ newest ] -> Stdlib.Option.Option.Some newest
      | _ ->
        Stdlib.printLine $"no recorded trace went through {fnName}"

        (whyEmpty "run something that calls it")
        |> Stdlib.List.iter (fun line ->
          Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText line))
        Stdlib.printLine
          (Stdlib.Cli.UI.Colors.dimText
            "  run something that calls it, then look again")
        Stdlib.Option.Option.None

  match chosen with
  // Either a trace id that matches nothing, which is a refusal, or a function nothing has run,
  // which is an empty answer. Both leave nothing to print, and only the first is a failure.
  | None ->
    match tracePrefix with
    | Some _ -> { state with exitCode = 1 }
    | None -> state
  | Some trace ->
    // The function is looked up BEFORE the trace is replayed: a replay is the whole cost of this
    // command, and a typo should not pay it.
    match LanguageTools.PackageManager.Function.find branchId entry with
    | None ->
      Cli.printErr $"no function named {fnName} on this branch"
      { state with exitCode = 1 }
    | Some hash ->
      match LanguageTools.PackageManager.Function.get hash with
      | None ->
        Cli.printErr
          $"{fnName} resolves to a version this store cannot load; the store is damaged"
        { state with exitCode = 1 }
      | Some fn ->
        // One call: it loads the trace's log, replays the trace with every effect answered from it
        // and none performed, and hands back what every expression evaluated to, plus the frames
        // it walked. The frames are what make a loop navigable rather than a single line showing
        // whichever pass happened to run last.
        let (collected, frames, frameValues, problem) =
          Darklang.Tracing.Store.viewTraceTree branchId trace.id

        let loops = loopSites frames (Darklang.Tracing.Store.fnsWithHashes trace.id)

        // WHICH LOOPS ARE EXPANDED, as a SET: `--expand map,fold`.
        //
        // Collapsed, a looped line shows its last pass: a value that is true, is one of several,
        // and does not say so. Expanded, the line carries every pass. `map:2` narrows to one.
        let requested =
          match expand with
          | None -> []
          | Some raw -> Stdlib.String.split raw ","

        let wantsAll = Stdlib.List.member requested "all"

        let chosenPassesOf (loop: LoopSite) : List<Darklang.Tracing.Store.ViewFrame> =
          let selector =
            requested
            |> Stdlib.List.findFirst (fun r ->
              (r == loop.name) || (Stdlib.String.startsWith r $"{loop.name}:"))

          match selector with
          | None -> if wantsAll then loop.passes else []
          | Some sel ->
            match Stdlib.String.split sel ":" with
            | [ _, p ] ->
              (match Stdlib.Int64.parse p with
               | Ok n -> loop.passes |> Stdlib.List.filter (fun f -> f.pass == (n - 1L))
               | Error _ -> loop.passes)
            | _ -> loop.passes

        // A name nobody can act on is a refusal, not a silently unchanged page.
        let unknown =
          requested
          |> Stdlib.List.filter (fun r ->
            let nm =
              Stdlib.String.split r ":" |> Stdlib.List.head |> Stdlib.Option.withDefault r

            (nm != "all")
            && ((loops |> Stdlib.List.findFirst (fun l -> l.name == nm))
                == Stdlib.Option.Option.None))

        match unknown with
        | bad :: _ ->
          let names = loops |> Stdlib.List.map (fun l -> l.name) |> Stdlib.String.join ", "
          Cli.printErr $"no loop called `{bad}` in this trace"

          if names != "" then
            Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText $"  loops here: {names}")

          { state with exitCode = 1 }
        | [] ->
          // The flat view first, so every line outside a loop keeps its value, then each
          // expanded loop's lines replaced by the passes asked for.
          let flat =
            collected
            |> Stdlib.List.map (fun pair ->
              let (id, dv) = pair
              (Stdlib.Int64.toString id, PrettyPrinter.RuntimeTypes.dvalOneLine branchId 60 dv))
            |> Stdlib.Dict.fromListOverwritingDuplicates

          let values =
            loops
            |> Stdlib.List.fold flat (fun acc loop ->
              match chosenPassesOf loop with
              | [] -> acc
              | chosen -> mergePassValues branchId acc frameValues chosen)

          Stdlib.printLine
            (Stdlib.Cli.UI.Colors.dimText
              $"trace {Cli.Text.shortIdText trace.id}  {trace.entry}  {whenText trace.created}")

          let ctx =
            { PrettyPrinter.ProgramTypes.Context.forBranch branchId with
                liveValues = values
                breakForValues = true }

          Stdlib.printLine (PrettyPrinter.ProgramTypes.packageFn ctx fn)

          match problem with
          | Some message ->
            Stdlib.printLine
              (Stdlib.Cli.UI.Colors.error $"  the view stopped here: {message}")
          | None -> ()

          // What is on the page, and what else there is. Saying which loops are collapsed is
          // the difference between trusting the page and being misled by it: a collapsed line
          // shows one pass of several and looks exactly like a line that ran once.
          match loops with
          | [] -> state
          | _ ->
            Stdlib.printLine ""

            loops
            |> Stdlib.List.iter (fun loop ->
              let n = Stdlib.Int.toString (Stdlib.List.length loop.passes)

              match chosenPassesOf loop with
              | [] ->
                Stdlib.printLine
                  (Stdlib.Cli.UI.Colors.dimText
                    $"  {loop.name}: {n} passes, showing the last")
              | [ _ ] ->
                Stdlib.printLine
                  (Stdlib.Cli.UI.Colors.dimText $"  {loop.name}: 1 of {n} passes")
              | chosen ->
                let c = Stdlib.Int.toString (Stdlib.List.length chosen)

                Stdlib.printLine
                  (Stdlib.Cli.UI.Colors.dimText $"  {loop.name}: all {c} passes"))

            let collapsed = loops |> Stdlib.List.filter (fun l -> (chosenPassesOf l) == [])

            match collapsed with
            | [] -> state
            | _ ->
              let names =
                collapsed |> Stdlib.List.map (fun l -> l.name) |> Stdlib.String.join ","

              Stdlib.printLine
                (Stdlib.Cli.UI.Colors.dimText
                  $"       dark traces show {fnName} --expand {names}")

              state


