/// `dark traces`: the runs this instance kept, and what to do with one.
///
/// A trace IS a run, so the reading verbs here (`list`, `view`, `find`, `stats`, `hotspots`,
/// `follow`) and the run verbs in `cli/traceRuns.dark` (`show`, `resume`, `fork`, `pin`,
/// `calls`, `values`) work on the same rows. This file dispatches all of them.
module Darklang.Cli.Tracing


type TraceSummary = Darklang.Tracing.Trace
type InputVar = Darklang.Tracing.InputVar
type FnCall = Darklang.Tracing.FnCall
type TraceData = Darklang.Tracing.TraceData


/// The line to print when the WHOLE list comes back with nothing.
///
/// "no traces found" reads as "nothing ran", and with recording off that is the wrong
/// conclusion: every query comes back empty no matter what ran. So ask, rather than guess.
let emptyStateHint () : String =
  if Darklang.Tracing.Store.enabled () then
    "nothing has run yet -- every `dark eval`, `dark run` and served request is kept here"
  else
    "recording is off, so this stays empty whatever runs: DARK_CONFIG_TRACE_DETAIL=effects to keep them"


/// Print the empty-result explanation, dimmed.
let printEmptyStateHint () : Unit =
  Stdlib.printLine (Stdlib.Cli.UI.Colors.dimText (emptyStateHint ()))


/// Print, after a FILTERED search came back empty, the one thing that would explain it
/// whatever you searched for. Silent when recording is on: then the empty result is the answer.
let printRecordingOffHint () : Unit =
  if Darklang.Tracing.Store.enabled () then
    ()
  else
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  recording is off, so nothing is kept to search: DARK_CONFIG_TRACE_DETAIL=effects")


/// Filters applied when rendering a trace tree. Each filter hides matching
/// nodes but recurses into their children at the SAME indent level so the
/// surrounding structure stays intact.
type ViewOptions =
  { maxDepth: Stdlib.Option.Option<Int>
    hideBuiltins: Bool
    hideStdlib: Bool
    filter: Stdlib.Option.Option<String>
    /// Inverse of `filter` — hide calls whose name contains this pattern.
    /// Children still recurse so the surrounding structure stays intact.
    exclude: Stdlib.Option.Option<String>
    /// When Some N, hide calls whose durationMs < N (keeps the slow stuff).
    slowThresholdMs: Stdlib.Option.Option<Int> }


val defaultViewOptions =
  ViewOptions
    { maxDepth = Stdlib.Option.Option.None
      hideBuiltins = false
      hideStdlib = false
      filter = Stdlib.Option.Option.None
      exclude = Stdlib.Option.Option.None
      slowThresholdMs = Stdlib.Option.Option.None }


/// English ordinal suffix for a non-negative integer. "1st", "2nd",
/// "3rd", "4th"… honoring the 11/12/13 exception (always "th").
let ordinalSuffix (n: Int) : String =
  let mod100 = n % 100
  if mod100 >= 11 && mod100 <= 13 then "th"
  else
    match n % 10 with
    | 1 -> "st"
    | 2 -> "nd"
    | 3 -> "rd"
    | _ -> "th"


/// Format the error for a positional integer arg. Distinguishes
/// "looks like a misplaced flag" (`-`-prefixed) from "actually
/// non-numeric" — `traces list --fake-arg` should say "unknown flag",
/// not "Invalid limit", since the user clearly didn't intend to
/// type a number there.
let parsePositionalErr (input: String) (label: String) : String =
  if Stdlib.String.startsWith input "-" then
    $"unknown flag: {input}"
  else
    $"Invalid {label}: {input}"


/// Resolve a trace ID prefix to the full ID, printing the not-found /
/// ambiguous-match error and returning `None` if resolution fails. The
/// caller short-circuits on `None`.
///
/// `-`-prefixed input is reported as "unknown flag" before the lookup —
/// trace IDs are UUIDs, so no real ID ever starts with `-`. This catches
/// misplaced-flag typos that would otherwise yield the misleading
/// "Trace not found: --fake-arg".
let resolveTraceID (input: String) : Stdlib.Option.Option<String> =
  if Stdlib.String.startsWith input "-" then
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"unknown flag: {input}")
    Stdlib.Option.Option.None
  else
    // Trim accidental whitespace from copy-paste; never part of a UUID.
    let trimmed = Stdlib.String.trim input
    if trimmed == "" then
      Cli.printErr "that is an empty id; `dark traces` lists the runs and their ids"
      Stdlib.Option.Option.None
    else
      match Darklang.Tracing.Store.resolveID trimmed with
      | Ok fullID -> Stdlib.Option.Option.Some fullID
      | Error msg ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
        Stdlib.Option.Option.None


let parseViewOptions
  (opts: ViewOptions)
  (args: List<String>)
  : Stdlib.Result.Result<ViewOptions, String> =
  match args with
  | [] -> Stdlib.Result.Result.Ok opts
  | "--depth" :: n :: rest
  | "-d" :: n :: rest ->
    match Stdlib.Int.parse n with
    | Ok depth ->
      if depth < 0 then
        Stdlib.Result.Result.Error $"--depth is a number of levels, so it cannot be negative (got {n})"
      else
        parseViewOptions
          { opts with maxDepth = Stdlib.Option.Option.Some depth }
          rest
    | Error _ -> Stdlib.Result.Result.Error (parsePositionalErr n "depth")
  | "--no-builtins" :: rest ->
    parseViewOptions { opts with hideBuiltins = true } rest
  | "--no-stdlib" :: rest ->
    parseViewOptions { opts with hideStdlib = true } rest
  | "--filter" :: pattern :: rest ->
    if Stdlib.String.startsWith pattern "-" then
      Stdlib.Result.Result.Error $"unknown flag: {pattern}"
    else if pattern == "" then
      Stdlib.Result.Result.Error "--filter takes part of a call's name"
    else
      parseViewOptions
        { opts with filter = Stdlib.Option.Option.Some pattern }
        rest
  | "--exclude" :: pattern :: rest ->
    if Stdlib.String.startsWith pattern "-" then
      Stdlib.Result.Result.Error $"unknown flag: {pattern}"
    else if pattern == "" then
      Stdlib.Result.Result.Error "--exclude takes part of a call's name"
    else
      parseViewOptions
        { opts with exclude = Stdlib.Option.Option.Some pattern }
        rest
  | "--slow" :: rest ->
    // Bare `--slow` defaults to 10ms. For a custom threshold, use --slow-ms.
    parseViewOptions
      { opts with slowThresholdMs = Stdlib.Option.Option.Some 10 }
      rest
  | "--slow-ms" :: numStr :: rest ->
    match Stdlib.Int.parse numStr with
    | Ok n ->
      if n < 0 then
        Stdlib.Result.Result.Error $"--slow-ms is a number of milliseconds, so it cannot be negative (got {numStr})"
      else
        parseViewOptions
          { opts with slowThresholdMs = Stdlib.Option.Option.Some n }
          rest
    | Error _ ->
      Stdlib.Result.Result.Error (parsePositionalErr numStr "--slow-ms threshold")
  // Recognized value-taking flag with no value left — distinguish from the
  // catch-all `unknown :: _` so the user gets "missing value" not the
  // misleading "unknown flag".
  | [ "--depth" ]
  | [ "-d" ] ->
    Stdlib.Result.Result.Error "--depth requires a value (e.g. `--depth 3`)"
  | [ "--filter" ] ->
    Stdlib.Result.Result.Error "--filter requires a pattern (e.g. `--filter List.map`)"
  | [ "--exclude" ] ->
    Stdlib.Result.Result.Error "--exclude requires a pattern (e.g. `--exclude listAppend`)"
  | [ "--slow-ms" ] ->
    Stdlib.Result.Result.Error "--slow-ms requires a value (e.g. `--slow-ms 100`)"
  | unknown :: _ ->
    Stdlib.Result.Result.Error $"unknown flag: {unknown}"


/// Confirm a destructive op. Returns true to proceed, false to bail.
///
let confirmDestructive (autoConfirm: Bool) (action: String) : Bool =
  Cli.Prompt.confirm autoConfirm $"{action} (y/n): "


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  // Hoist boolean flags out to single bools so each subcommand's arms
  // don't have to enumerate their position. `--yes`/`-y` for destructive
  // confirmations; `--json` for output format; `--view` is find-only.
  let autoConfirm =
    (Stdlib.List.member args "--yes") || (Stdlib.List.member args "-y")
  let wantsJson = Stdlib.List.member args "--json"
  let wantsFindView = Stdlib.List.member args "--view"
  let args =
    args
    |> Stdlib.List.filter (fun a ->
      a != "--yes" && a != "-y" && a != "--json" && a != "--view")
  match args with
  | [] ->
    printMatches "" (Darklang.Tracing.Store.list 50)
    state

  | [ "list" ] ->
    if wantsJson then executeListJson state 20 else executeList state 20
  | [ "list", "--fn" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces list --fn <name> [limit] [--json]")
    state
  | [ "list", "--route" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces list --route <substring> [limit] [--json]")
    state
  | [ "list", limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit ->
      if wantsJson then executeListJson state limit else executeList state limit
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state
  | [ "list", "--fn", fnName ] ->
    executeListByFn state fnName 20 wantsJson
  | [ "list", "--fn", fnName, limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit -> executeListByFn state fnName limit wantsJson
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state
  | [ "list", "--route", route ] ->
    executeListByRoute state route 20 wantsJson
  | [ "list", "--route", route, limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit -> executeListByRoute state route limit wantsJson
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state

  | [ "follow" ] ->
    executeFollow state Stdlib.Option.Option.None wantsJson
  | [ "follow", "--route", route ] ->
    executeFollow state (Stdlib.Option.Option.Some route) wantsJson

  | [ "stats" ] ->
    if wantsJson then executeStatsJson state 100 else executeStats state 100
  | [ "stats", limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit ->
      if wantsJson then executeStatsJson state limit else executeStats state limit
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state

  | [ "tail" ] -> executeTail state Stdlib.Option.Option.None 1
  // Flag-without-arg case must precede the `[ "tail", nStr ]` arm
  // (which would otherwise treat "--route" as a malformed N).
  | [ "tail", "--route" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces tail [N] --route <substring>")
    state
  | [ "tail", nStr ] ->
    match Stdlib.Int.parse nStr with
    | Ok n -> executeTail state Stdlib.Option.Option.None n
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr nStr "trace number"))
      state
  | [ "tail", "--route", route ] ->
    executeTail state (Stdlib.Option.Option.Some route) 1
  | [ "tail", "--route", route, nStr ]
  | [ "tail", nStr, "--route", route ] ->
    match Stdlib.Int.parse nStr with
    | Ok n -> executeTail state (Stdlib.Option.Option.Some route) n
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr nStr "trace number"))
      state

  | [ "find", pattern ] ->
    if wantsFindView then
      executeFindView state pattern
    elif wantsJson then
      executeFindJson state pattern 20
    else
      executeFind state pattern 20
  | [ "find", pattern, limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit ->
      if wantsJson then executeFindJson state pattern limit
      else executeFind state pattern limit
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state

  | [ "hotspots" ] ->
    if wantsJson then executeHotspotsJson state 100
    else executeHotspots state 100
  | [ "hotspots", limitStr ] ->
    match Stdlib.Int.parse limitStr with
    | Ok limit ->
      if wantsJson then executeHotspotsJson state limit
      else executeHotspots state limit
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr limitStr "limit"))
      state

  | "view" :: traceID :: flagArgs ->
    match parseViewOptions defaultViewOptions flagArgs with
    | Ok opts ->
      match resolveTraceID traceID with
      | Some full -> executeView state full opts
      | None -> state
    | Error msg ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
      state

  // The run verbs (`cli/traceRuns.dark`). `resume` replays the log; `rerun` performs
  // everything again, which is why they are two words.
  | [ "show", prefix ] ->
    Cli.TraceRuns.printShow prefix
    state
  | [ "resume", prefix ] -> Cli.TraceRuns.resume state prefix
  | [ "fork", prefix ] ->
    Cli.TraceRuns.fork prefix Stdlib.Option.Option.None
    state
  | [ "fork", prefix, "--at", at ] ->
    match Stdlib.Int64.parse at with
    | Ok n -> Cli.TraceRuns.fork prefix (Stdlib.Option.Option.Some n)
    | Error _ ->
      Cli.printErr $"--at wants a position from the `pos` column of `traces show`, not {at}"
    state
  | [ "pin", prefix ] ->
    Cli.TraceRuns.pin prefix true
    state
  | [ "unpin", prefix ] ->
    Cli.TraceRuns.pin prefix false
    state
  // The call inbox: one function's recorded calls, and the code with that call's values.
  | [ "calls", fnName ] ->
    Cli.TraceRuns.printCalls fnName
    state
  | [ "values", fnName ] ->
    Cli.TraceRuns.printValues state fnName Stdlib.Option.Option.None
  | [ "values", fnName, run ] ->
    Cli.TraceRuns.printValues state fnName (Stdlib.Option.Option.Some run)
  | [ "calls" ] | [ "values" ] ->
    let verb = Stdlib.Option.withDefault (Stdlib.List.head args) ""
    Cli.printErr $"traces {verb} needs a function name, like Darklang.Stdlib.List.map"
    state

  | [ "show" ] | [ "resume" ] | [ "fork" ] | [ "pin" ] | [ "unpin" ] ->
    let verb = Stdlib.Option.withDefault (Stdlib.List.head args) ""
    Cli.printErr $"traces {verb} needs an id prefix -- `dark traces` lists them"
    state

  | [ "rerun", traceID ] ->
    match resolveTraceID traceID with
    | Some full -> executeReplay state full
    | None -> state

  // `delete` covers all four shapes: by ID, --keep N, --before <duration>, and --all.
  | [ "delete", "--all" ] ->
    if confirmDestructive autoConfirm "Delete all traces?" then
      executeClear state
    else
      Stdlib.printLine "Cancelled."
      state

  | [ "delete", "--before", durationStr ] ->
    if confirmDestructive
         autoConfirm
         $"Delete traces older than {durationStr}?" then
      executeClearBefore state durationStr
    else
      Stdlib.printLine "Cancelled."
      state

  | [ "delete", "--keep", nStr ] ->
    match Stdlib.Int.parse nStr with
    | Ok n ->
      if confirmDestructive
           autoConfirm
           $"Keep the {Stdlib.Int.toString n} most-recent traces and drop the rest?" then
        executePruneKeep state n
      else
        Stdlib.printLine "Cancelled."
        state
    | Error _ ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error (parsePositionalErr nStr "--keep N"))
      state

  | [ "delete", traceID ] ->
    match resolveTraceID traceID with
    | Some full ->
      if confirmDestructive autoConfirm $"Delete trace {full}?" then
        executeDelete state full
      else
        Stdlib.printLine "Cancelled."
        state
    | None -> state

  // Focused usage messages for the remaining "flag without arg" cases
  // that don't conflict with positional-catching arms higher up
  // (the list/tail variants are handled inline above).
  | [ "follow", "--route" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces follow --route <substring> [--json]")
    state
  | [ "delete", "--keep" ] ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error "Usage: traces delete --keep <N>")
    state
  | [ "delete", "--before" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces delete --before <duration> (e.g. 30s, 5m, 1h, 2d)")
    state

  // Focused usage messages for arity-1 commands when invoked with no
  // argument. Better than dumping the full multi-page help — the user
  // ran a known command, just forgot the id/path.
  | [ "view" ] ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error "Usage: traces view <trace-id> [flags]")
    state
  | [ "rerun" ] ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error "Usage: traces rerun <trace-id>")
    state
  | [ "delete" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces delete <trace-id> | --all | --keep <N> | --before <duration>")
    state
  | [ "find" ] ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces find <pattern> [limit] [--view] [--json]")
    state

  // Catch any other malformed follow invocation — anything not matched
  // by the earlier specific arms (e.g. `traces follow --fake-arg`).
  | "follow" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces follow [--route <substring>] [--json]")
    state

  // Catch malformed arity-1 invocations (e.g. `traces rerun <id> --fake-arg`)
  // that the strict-length arms above missed.
  | "rerun" :: _ ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error "Usage: traces rerun <trace-id>")
    state
  | "delete" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces delete <trace-id> | --all | --keep <N> | --before <duration>")
    state
  | "tail" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces tail [N] [--route <substring>]")
    state
  | "list" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces list [limit] | list --fn <substring> [limit] [--json] | list --route <substring> [limit] [--json]")
    state
  | "find" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error
        "Usage: traces find <pattern> [limit] [--view] [--json]")
    state
  | "hotspots" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces hotspots [trace-limit] [--json]")
    state
  | "stats" :: _ ->
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.error "Usage: traces stats [limit] [--json]")
    state

  | _ ->
    // If the first token isn't a known subcommand, surface that
    // explicitly before dumping help so a typo'd `traces lst` doesn't
    // look like it succeeded silently.
    let knownSubcommands =
      [ "help", "list", "view", "tail", "follow", "find", "hotspots"
        "stats", "rerun", "delete", "show", "resume", "fork", "pin", "unpin", "calls",
        "values" ]
    let isKnownHead =
      match args with
      | head :: _ ->
        Stdlib.List.any knownSubcommands (fun s -> s == head)
      | [] -> true
    if Stdlib.Bool.not isKnownHead then
      match args with
      | head :: _ ->
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error $"unknown subcommand: {head}")
        Stdlib.printLine ""
        Stdlib.printLine (help state)
        state
      | [] ->
        Stdlib.printLine (help state)
        state
    else
      Stdlib.printLine (help state)
      state


let executeList (state: Cli.AppState) (limit: Int) : Cli.AppState =
  if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    printMatches "" (Darklang.Tracing.Store.list limit)
    state


/// `traces list --json [N]` — same data as `traces list` but emitted as a
/// JSON array of `{traceId, handler, timestamp}` objects, no headers or
/// footers. Designed for piping into jq / scripts. Empty store prints `[]`.
let executeListJson (state: Cli.AppState) (limit: Int) : Cli.AppState =
  if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    Stdlib.printLine
      (Stdlib.Json.serialize<List<TraceSummary>> (Darklang.Tracing.Store.list limit))
    state


let executeListByFn
  (state: Cli.AppState)
  (fnName: String)
  (limit: Int)
  (jsonMode: Bool)
  : Cli.AppState =
  if Stdlib.String.trim fnName == "" then
    Cli.printErr "--fn takes a function name, or part of one"
    state
  else if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.listByFn fnName limit
    if jsonMode then
      Stdlib.printLine (Stdlib.Json.serialize<List<TraceSummary>> rows)
      state
    else
      printMatches $"no kept run went through {fnName}" rows
      state


/// `traces hotspots [limit]` — across the last <limit> traces (default 100),
/// aggregate per-fn timing: call count, total ms, max ms. Sort by total ms
/// descending. The "where is my time going?" view.
let executeHotspots
  (state: Cli.AppState)
  (traceLimit: Int)
  : Cli.AppState =
  if traceLimit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.hotspots traceLimit

    match rows with
    | [] ->
      Stdlib.printLine $"No fn-call data in the last {Stdlib.Int.toString traceLimit} traces."
      state
    | _ ->
      let fnCount = Stdlib.List.length rows
      let fnWord = if fnCount == 1 then "fn" else "fns"
      Stdlib.printLine
        $"Hotspots (last {Stdlib.Int.toString traceLimit} traces, top {Stdlib.Int.toString fnCount} {fnWord} by total ms):"
      Stdlib.printLine ""
      Stdlib.printLine "  total ms │   max ms │ count │ fn"
      Stdlib.printLine "  ─────────┼──────────┼───────┼─────────────────────────"
      Stdlib.List.iter rows (fun row ->
        let (name, count, total, max) = row
        let totalStr = padNum total 9
        let maxStr = padNum max 8
        let countStr = padNum count 5
        Stdlib.printLine $"  {totalStr} │ {maxStr} │ {countStr} │ {name}")
      state


/// `traces hotspots --json [limit]` — same data as a JSON array of
/// `{name, count, totalMs, maxMs}` objects, no headers/footers, for
/// piping. Empty store prints `[]`.
let executeHotspotsJson
  (state: Cli.AppState)
  (traceLimit: Int)
  : Cli.AppState =
  if traceLimit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.hotspots traceLimit
    let body =
      rows
      |> Stdlib.List.map (fun row ->
        let (name, count, total, max) = row
        $"{{\"name\":\"{jsonEscape name}\""
        ++ $",\"count\":{Stdlib.Int.toString count}"
        ++ $",\"totalMs\":{Stdlib.Int.toString total}"
        ++ $",\"maxMs\":{Stdlib.Int.toString max}}}")
      |> Stdlib.String.join ","
    Stdlib.printLine $"[{body}]"
    state


/// Right-align a number in a field of `width` chars.
let padNum (n: Int) (width: Int) : String =
  Darklang.Tracing.Format.padNum n width

let jsonEscape (s: String) : String = Darklang.Tracing.Format.jsonEscape s


/// `traces find <pattern> [limit]` — list traces whose recorded input or any
/// fn-call args/result contain the substring (case-sensitive, matches the
/// stored JSON form). Useful for "show me everywhere user 42 was touched"
/// or "show me traces where errCode 503 came back."
let executeFind
  (state: Cli.AppState)
  (pattern: String)
  (limit: Int)
  : Cli.AppState =
  if pattern == "" then
    Cli.printErr "find takes something to look for: part of an id, or of what was run"
    state
  else if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    printMatches
      $"no kept run matches {pattern}"
      (Darklang.Tracing.Store.find pattern limit)
    state


/// `traces find <pattern> --json [limit]` — same data as `traces find`
/// but as a JSON array of `{traceId, handler, timestamp}` objects, no
/// banner. Designed for piping into jq / scripts.
let executeFindJson
  (state: Cli.AppState)
  (pattern: String)
  (limit: Int)
  : Cli.AppState =
  if pattern == "" then
    Cli.printErr "find takes something to look for: part of an id, or of what was run"
    state
  else if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.find pattern limit
    Stdlib.printLine (Stdlib.Json.serialize<List<TraceSummary>> rows)
    state


/// `traces find <pattern> --view` — search-then-drill in one step. Opens
/// the most-recent matching trace's view directly. If multiple match,
/// the others are noted but the user gets the freshest one.
let executeFindView (state: Cli.AppState) (pattern: String) : Cli.AppState =
  if pattern == "" then
    Cli.printErr "find takes something to look for: part of an id, or of what was run"
    state
  else
    let rows = Darklang.Tracing.Store.find pattern 1
    match rows with
    | [] ->
      Stdlib.printLine $"no kept run matches {pattern}"
      printRecordingOffHint ()
      state
    | row :: _ ->
      Stdlib.printLine $"the newest run matching {pattern}: {row.id}"
      Stdlib.printLine ""
      executeView state row.id defaultViewOptions


/// `traces tail [N] [--route <substring>]` — open the Nth-most-recent
/// trace's full view (default N=1, the very latest). Skips the
/// list-then-copy-id round-trip you'd otherwise do with `traces list` →
/// `traces view <id>`. `tail 2` peeks back one without copying IDs.
/// Optional route filter narrows to traces matching the substring
/// before counting.
let executeTail
  (state: Cli.AppState)
  (routeFilter: Stdlib.Option.Option<String>)
  (n: Int)
  : Cli.AppState =
  let routeIsEmpty =
    match routeFilter with
    | Some r -> Stdlib.String.trim r == ""
    | None -> false
  if n < 1 then
    Cli.printErr "tail takes which run back to open, so it has to be 1 or more"
    state
  else if routeIsEmpty then
    Cli.printErr "--route takes part of a path or a method, like /orders or GET"
    state
  else
    // Over-fetch so route-filtered Nth candidate is reachable; the
    // unfiltered case picks straight from the first N rows.
    let fetch =
      match routeFilter with
      | Some _ -> 500
      | None -> n
    let allRows = Darklang.Tracing.Store.list fetch
    let candidates =
      match routeFilter with
      | Some route ->
        let routeUpper = Stdlib.String.toUppercase route
        allRows
        |> Stdlib.List.filter (fun row ->
          Stdlib.String.contains
            (Stdlib.String.toUppercase row.entry) routeUpper)
      | None -> allRows

    // Drop the first (n-1) — the Nth-most-recent is what's left at head.
    let after = Stdlib.List.drop candidates (n - 1)
    match after with
    | [] ->
      let suffix =
        match routeFilter with
        | Some r -> $" matching '{r}'"
        | None -> ""
      // N=1 is "nothing yet"; past that, English ordinals (2nd/3rd/22nd) via `ordinalSuffix`.
      let msg =
        if n == 1 then $"nothing has run yet{suffix}"
        else
          let nStr = Stdlib.Int.toString n
          $"there is no {nStr}{ordinalSuffix n}-most-recent run{suffix}"
      Stdlib.printLine msg
      state
    | row :: _ -> executeView state row.id defaultViewOptions


/// `traces stats` — per-handler aggregate over the last N traces:
/// trace count, total ms (sum of every fn-call duration in each trace),
/// max single-call ms. Pairs with `traces hotspots` (per-fn aggregate)
/// for "which routes are heavy?" vs "which fns are heavy?".
let executeStats (state: Cli.AppState) (limit: Int) : Cli.AppState =
  if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.statsByHandler limit

    match rows with
    | [] ->
      printEmptyStateHint ()
      state
    | _ ->
      Stdlib.printLine
        $"per entry, over the last {Stdlib.Int.toString limit} runs:"
      Stdlib.printLine ""
      Stdlib.printLine "  total ms │   max ms │ count │ handler"
      Stdlib.printLine "  ─────────┼──────────┼───────┼─────────────────────────"
      Stdlib.List.iter rows (fun row ->
        let (handler, count, total, max) = row
        let totalStr = padNum total 9
        let maxStr = padNum max 8
        let countStr = padNum count 5
        Stdlib.printLine $"  {totalStr} │ {maxStr} │ {countStr} │ {handler}")
      Stdlib.printLine ""
      // The route-drill hint only makes sense if there are HTTP
      // handlers in the result; eval/run-only stores get no help
      // from `--route`. HTTP handler descriptions look like
      // `<METHOD> <path>` so a `/` is a reliable shibboleth.
      let hasHttp =
        rows
        |> Stdlib.List.any (fun row ->
          let (handler, _, _, _) = row
          Stdlib.String.contains handler "/")
      if hasHttp then
        Stdlib.printLine "Use 'traces list --route <substring>' to drill into a route."
      state


/// `traces stats --json [limit]` — same data as a JSON array of
/// `{handler, count, totalMs, maxMs}` objects, no headers/footers,
/// for piping. Empty store prints `[]`.
let executeStatsJson (state: Cli.AppState) (limit: Int) : Cli.AppState =
  if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    let rows = Darklang.Tracing.Store.statsByHandler limit
    let body =
      rows
      |> Stdlib.List.map (fun row ->
        let (handler, count, total, max) = row
        $"{{\"handler\":\"{jsonEscape handler}\""
        ++ $",\"count\":{Stdlib.Int.toString count}"
        ++ $",\"totalMs\":{Stdlib.Int.toString total}"
        ++ $",\"maxMs\":{Stdlib.Int.toString max}}}")
      |> Stdlib.String.join ","
    Stdlib.printLine $"[{body}]"
    state


/// One iteration of the follow loop: pull recent rows, find newer
/// than `lastSeen`, optionally filter by route, print, then sleep.
/// Returns the new `lastSeen` (the newest id pulled this tick). When
/// `jsonMode`, each new trace prints as one NDJSON line; otherwise the
/// human-readable two-space-indent form.
let followLoop
  (routeFilter: Stdlib.Option.Option<String>)
  (lastSeen: String)
  (jsonMode: Bool)
  : Unit =
  let rows = Darklang.Tracing.Store.list 50

  let candidates =
    rows |> Stdlib.List.takeWhile (fun row -> row.id != lastSeen)

  let filtered =
    match routeFilter with
    | Some r ->
      let rUpper = Stdlib.String.toUppercase r
      candidates
      |> Stdlib.List.filter (fun row ->
        Stdlib.String.contains (Stdlib.String.toUppercase row.entry) rUpper)
    | None -> candidates

  let chronological = filtered |> Stdlib.List.reverse

  Stdlib.List.iter chronological (fun row ->
    if jsonMode then
      Stdlib.printLine (Stdlib.Json.serialize<TraceSummary> row)
    else
      Stdlib.printLine $"  {row.created}  {row.id}  {row.entry}")

  let newLastSeen =
    match rows with
    | [] -> lastSeen
    | row :: _ -> row.id

  Stdlib.Cli.Posix.sleep 500.0
  followLoop routeFilter newLastSeen jsonMode


/// Tail-style live view: poll every 500ms, print new traces as they
/// arrive, in chronological order. Optional `--route <substring>`
/// filter narrows the stream. With `--json`, output is NDJSON
/// (one JSON object per line) for piping to log aggregators / scripts;
/// the "Following…" banner is suppressed so consumers see only data.
///
/// Hold Ctrl+C to exit (the loop never returns on its own).
let executeFollow
  (state: Cli.AppState)
  (routeFilter: Stdlib.Option.Option<String>)
  (jsonMode: Bool)
  : Cli.AppState =
  let routeIsEmpty =
    match routeFilter with
    | Some r -> Stdlib.String.trim r == ""
    | None -> false
  if routeIsEmpty then
    Cli.printErr "--route takes part of a path or a method, like /orders or GET"
    state
  else
  if jsonMode == false then
    let label =
      match routeFilter with
      | Some r -> $"route '{r}'"
      | None -> "all routes"
    Stdlib.printLine $"Following traces for {label}. Ctrl+C to stop."
    Stdlib.printLine ""

  // Anchor: ignore traces that already existed when we started.
  let initialRows = Darklang.Tracing.Store.list 1
  let initialSeen =
    match initialRows with
    | [] -> ""
    | row :: _ -> row.id

  followLoop routeFilter initialSeen jsonMode
  state


/// Filter recent traces by a substring of the trace's `handler` field
/// (which for HTTP traces is `"<METHOD> <path>"` like `"GET /hello"`).
/// Substring match makes both `"/hello"` and `"GET"` work.
let executeListByRoute
  (state: Cli.AppState)
  (route: String)
  (limit: Int)
  (jsonMode: Bool)
  : Cli.AppState =
  if Stdlib.String.trim route == "" then
    Cli.printErr "--route takes part of a path or a method, like /orders or GET"
    state
  else if limit < 1 then
    Cli.printErr "a limit is a number of runs, so it has to be 1 or more"
    state
  else
    // Over-fetch then filter; tracesList returns the most-recent N rows
    // unfiltered, so to find N matching we may need to pull more. Cap at
    // 500 to bound the fetch.
    let overFetch = if limit < 50 then 500 else limit * 10
    let allRows = Darklang.Tracing.Store.list overFetch
    let routeUpper = Stdlib.String.toUppercase route
    let matching =
      allRows
      |> Stdlib.List.filter (fun row ->
        Stdlib.String.contains
          (Stdlib.String.toUppercase row.entry) routeUpper)
      |> Stdlib.List.take limit

    if jsonMode then
      Stdlib.printLine (Stdlib.Json.serialize<List<TraceSummary>> matching)
      state
    else
      printMatches $"no kept run served a request matching {route}" matching
      state




/// A listing of runs: the one table, and the one line saying what to type next. <param nothing>
/// is what to say when the list is empty; "" when the empty-state hint says it already.
let printMatches (nothing: String) (rows: List<TraceSummary>) : Unit =
  match rows with
  | [] ->
    if nothing == "" then
      printEmptyStateHint ()
    else
      Stdlib.printLine nothing
      printRecordingOffHint ()
  | _ ->
    Cli.TraceRuns.printTable rows
    Stdlib.printLine ""
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  dark traces show <id>   one run: its input, its log, where it stands")


let formatInputs (branchId: Uuid) (inputs: List<InputVar>) : String =
  match inputs with
  | [] -> "  (none)"
  | _ ->
    inputs
    |> Stdlib.List.map (fun input ->
      let repr = compactDval branchId input.value
      $"  {input.name} = {repr}")
    |> Stdlib.String.join "\n"


/// Single-line render of a dval for the trace viewer; strategy lives in
/// `Tracing.Format.compactDval`.
let compactDval (branchId: Uuid) (dv: LanguageTools.RuntimeTypes.Dval) : String =
  Darklang.Tracing.Format.compactDval branchId dv


/// Decide whether to render a given call line. Hidden lines still recurse
/// into children — the children appear at the parent's depth so the
/// surrounding structure stays intact.
let isVisible (opts: ViewOptions) (call: FnCall) (ancestorMatched: Bool) : Bool =
  let stdlibInternal =
    opts.hideStdlib
    && Stdlib.String.startsWith call.fnName "Stdlib."
    && call.parentCallId != Stdlib.Option.Option.None
  let builtinHidden = opts.hideBuiltins && call.kind == "builtin"
  let belowSlowThreshold =
    match opts.slowThresholdMs with
    | Some thr -> call.durationMs < thr
    | None -> false
  // --filter / --exclude match case-insensitively, parallel to the
  // SQL `LIKE` semantics of `list --fn` / `find`.
  let fnNameUpper = Stdlib.String.toUppercase call.fnName
  let excluded =
    match opts.exclude with
    | Some pat ->
      Stdlib.String.contains fnNameUpper (Stdlib.String.toUppercase pat)
    | None -> false
  if stdlibInternal || builtinHidden || belowSlowThreshold || excluded then
    false
  else
    match opts.filter with
    | None -> true
    | Some pat ->
      ancestorMatched
        || Stdlib.String.contains fnNameUpper (Stdlib.String.toUppercase pat)


/// Render one call and (recursively) its children. Lifted out of
/// formatFnCalls because Darklang doesn't allow nested let-recs.
let renderCall
  (opts: ViewOptions)
  (branchId: Uuid)
  (childrenMap: Dict<String, List<FnCall>>)
  (call: FnCall)
  (depth: Int)
  (ancestorMatched: Bool)
  : List<String> =
  let depthExceeded =
    match opts.maxDepth with
    | Some max -> depth >= max
    | None -> false
  if depthExceeded then
    []
  else
    let visible = isVisible opts call ancestorMatched
    let matchedHere =
      match opts.filter with
      | Some pat -> ancestorMatched || Stdlib.String.contains call.fnName pat
      | None -> true
    let children =
      match Stdlib.Dict.get childrenMap call.callId with
      | Some xs -> xs
      | None -> []
    // When this call is hidden we keep child indent at our level so the
    // tree doesn't develop ghost gaps where the hidden line would have been.
    let childDepth = if visible then depth + 1 else depth
    let childrenRendered =
      children
      |> Stdlib.List.map (fun c ->
        renderCall opts branchId childrenMap c childDepth matchedHere)
      |> Stdlib.List.flatten
    if visible then
      let indent = Stdlib.String.repeat "  " (depth + 1)
      let resultRepr = compactDval branchId call.result
      let durationSuffix =
        if call.durationMs > 0 then
          $"  ({Stdlib.Int.toString call.durationMs}ms)"
        else
          ""
      let header =
        match call.args with
        | [] -> $"{indent}{call.fnName} → {resultRepr}{durationSuffix}"
        | _ ->
          let argsRepr =
            call.args
            |> Stdlib.List.map (fun arg -> compactDval branchId arg)
            |> Stdlib.String.join ", "
          $"{indent}{call.fnName}({argsRepr}) → {resultRepr}{durationSuffix}"
      Stdlib.List.append [ header ] childrenRendered
    else
      childrenRendered


let formatFnCalls
  (opts: ViewOptions)
  (branchId: Uuid)
  (fnCalls: List<FnCall>)
  : String =
  match fnCalls with
  | [] -> "  (none)"
  | _ ->
    // Build (roots, parent_call_id -> children) by folding the flat list.
    // Roots are events whose parentCallId is None (top-level user calls).
    let buildResult =
      fnCalls
      |> Stdlib.List.fold
        ([], Stdlib.Dict.empty)
        (fun acc call ->
          let (roots, dict) = acc
          match call.parentCallId with
          | None -> (Stdlib.List.append roots [ call ], dict)
          | Some pid ->
            let existing =
              match Stdlib.Dict.get dict pid with
              | Some xs -> xs
              | None -> []
            let updated = Stdlib.List.append existing [ call ]
            (roots, Stdlib.Dict.setOverridingDuplicates dict pid updated))
    let (roots, childrenMap) = buildResult

    let rendered =
      roots
      |> Stdlib.List.map (fun r ->
        renderCall opts branchId childrenMap r 0 false)
      |> Stdlib.List.flatten
    match rendered with
    | [] ->
      // The empty case can happen for several reasons; help the user
      // figure out which by surfacing the most-likely cause first.
      match opts.maxDepth with
      | Some 0 -> "  (depth limit 0 -- no calls shown)"
      | _ -> "  (no calls match the active filters)"
    | _ -> Stdlib.String.join rendered "\n"


let executeView
  (state: Cli.AppState)
  (traceID: String)
  (opts: ViewOptions)
  : Cli.AppState =
  let result = Darklang.Tracing.Store.view traceID

  match result with
  | None ->
    Cli.printErr $"no run whose id starts with {traceID} -- `dark traces` lists them"
    state
  | Some trace ->
    let input = formatInputs state.currentBranchId trace.inputs
    let fnCalls = formatFnCalls opts state.currentBranchId trace.functionCalls
    [ $"Run:    {trace.trace.id}"
      $"Entry:  {trace.trace.entry}"
      $"Status: {Cli.TraceRuns.statusText trace.trace.status}"
      $"Time:   {trace.trace.created}"
      ""
      "Input:"
      input
      ""
      "Function calls:"
      fnCalls ]
    |> Stdlib.printLines
    state


/// `traces rerun <id>` — re-evaluate a run's recorded eval/run input, performing every effect
/// again. `traces resume` is the other one: it answers the effects from the log.
/// HTTP traces (input is a Request record, not a string) aren't supported;
/// the row's input is fetched via `tracesGetInput` which returns None for
/// non-string inputs. Each rerun is recorded as a run of its own.
let executeReplay (state: Cli.AppState) (traceID: String) : Cli.AppState =
  match Darklang.Tracing.Store.getInput traceID with
  | None ->
    Cli.printErr
      $"no kept run has the id {traceID}, or its input is not something to evaluate"
    Stdlib.printLine
      (Stdlib.Cli.UI.Colors.dimText
        "  a served request's input is a record, not source: `traces values` reads one instead")
    state
  | Some code ->
    Stdlib.printLine
      $"rerunning {Cli.Text.shortIdText traceID}: {Cli.Text.oneLine code}"
    Stdlib.printLine ""
    match
      Eval.evaluateRaw
        state.accountID state.currentBranchId code [] false
    with
    | Ok outputOpt ->
      match outputOpt with
      | Some output -> Stdlib.printLine output
      | None -> ()
      Stdlib.printLine ""
      Stdlib.printLine
        "rerun complete; it was kept as a run of its own (`dark traces` lists it)"
      state
    | Error err ->
      let pretty = Cli.ExecutionError.toString state.currentBranchId err
      Cli.printErr $"the rerun failed: {pretty}"
      state


let executeClear (state: Cli.AppState) : Cli.AppState =
  let count = Darklang.Tracing.Store.clear ()
  match count with
  | 0 ->
    Stdlib.printLine "nothing to clear"
    state
  | _ ->
    Stdlib.printLine $"cleared {Cli.Text.plural count "run"}"
    state


/// Parse a CLI duration arg. `-`-prefixed inputs are reported as
/// "unknown flag" rather than "Invalid duration" — same logic as
/// `parsePositionalErr`. Otherwise delegates to `Stdlib.Duration.parse`.
let parseDuration (s: String) : Stdlib.Result.Result<Int, String> =
  if Stdlib.String.startsWith s "-" then
    Stdlib.Result.Result.Error $"unknown flag: {s}"
  else
    Stdlib.Duration.parse s


/// `traces delete --before <duration>` — drop traces older than the
/// given duration; complement to `--keep N` (count-based).
let executeClearBefore
  (state: Cli.AppState)
  (durationStr: String)
  : Cli.AppState =
  match parseDuration durationStr with
  | Error msg ->
    Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
    state
  | Ok seconds ->
    let now = Stdlib.DateTime.now ()
    // cleanup
    let cutoffDt =
      Stdlib.DateTime.subtractSeconds now seconds
    let cutoff = Stdlib.DateTime.toString cutoffDt
    let count = Darklang.Tracing.Store.clearBefore cutoff
    match count with
    | 0 ->
      Stdlib.printLine $"no kept run is older than {durationStr}"
      state
    | _ ->
      Stdlib.printLine
        $"deleted {Cli.Text.plural count "run"} older than {durationStr}"
      state


/// `traces delete <id>` — remove one trace and its fn_calls. ID accepts
/// the same prefix-resolution as view/rerun.
let executeDelete (state: Cli.AppState) (traceID: String) : Cli.AppState =
  let deleted = Darklang.Tracing.Store.delete traceID
  match deleted with
  | 0 ->
    Cli.printErr $"no run whose id starts with {traceID} -- `dark traces` lists them"
    state
  | _ ->
    Stdlib.printLine $"deleted {Cli.Text.shortIdText traceID}"
    state


/// `traces delete --keep <N>` — keep the N most-recent traces, drop the
/// rest (with their fn_calls). For bounded retention as the trace store
/// grows; pair with `traces delete --all` for a full wipe.
let executePruneKeep (state: Cli.AppState) (keepN: Int) : Cli.AppState =
  if keepN < 0 then
    Cli.printErr "--keep takes a number of runs to keep, so it cannot be negative"
    state
  else
    let deleted = Darklang.Tracing.Store.pruneKeep keepN
    match deleted with
    | 0 ->
      Stdlib.printLine
        $"already at or below {Stdlib.Int.toString keepN} runs; nothing to delete"
      state
    | _ ->
      let keptPhrase =
        if keepN == 0 then "none kept"
        else if keepN == 1 then "kept the most-recent"
        else $"kept the {Stdlib.Int.toString keepN} most-recent"
      Stdlib.printLine $"deleted {Cli.Text.plural deleted "run"}; {keptPhrase}"
      state


let complete (_state: Cli.AppState) (args: List<String>) : List<Completion.CompletionItem> =
  match args with
  | [] ->
    [ Completion.simple "list"
      Completion.simple "view"
      Completion.simple "tail"
      Completion.simple "follow"
      Completion.simple "stats"
      Completion.simple "find"
      Completion.simple "hotspots"
      Completion.simple "rerun"
      Completion.simple "delete"
      Completion.simple "help" ]
  | [ "list" ] ->
    [ Completion.simple "--fn"
      Completion.simple "--route"
      Completion.simple "--json" ]
  | [ "tail" ] -> [ Completion.simple "--route" ]
  | [ "follow" ] ->
    [ Completion.simple "--route", Completion.simple "--json" ]
  | [ "find" ] ->
    [ Completion.simple "--view", Completion.simple "--json" ]
  | [ "delete" ] ->
    [ Completion.simple "--all"
      Completion.simple "--keep"
      Completion.simple "--before" ]
  | [ "stats" ] -> [ Completion.simple "--json" ]
  | [ "hotspots" ] -> [ Completion.simple "--json" ]
  // After `traces view <id>` the next token is a flag — surface them.
  | "view" :: _ :: _ ->
    [ Completion.simple "--depth"
      Completion.simple "-d"
      Completion.simple "--no-builtins"
      Completion.simple "--no-stdlib"
      Completion.simple "--filter"
      Completion.simple "--exclude"
      Completion.simple "--slow"
      Completion.simple "--slow-ms" ]
  // After a value-taking flag, the next token is a user-supplied
  // substring/path — no canonical completion to suggest. Returning
  // an empty list forces the user to type a value rather than
  // tab-cycling through the wrong flags.
  | [ "list", "--fn" ]
  | [ "list", "--route" ]
  | [ "tail", "--route" ]
  | [ "follow", "--route" ] -> []
  | "find" :: _ :: _ ->
    [ Completion.simple "--view", Completion.simple "--json" ]
  | "tail" :: _ :: _ -> [ Completion.simple "--route" ]
  | "list" :: _ :: _ ->
    [ Completion.simple "--json" ]
  | _ -> []


let help (_state: Cli.AppState) : String =
  [ "Every `dark eval`, `dark run` and served request is kept here as a RUN: what it was"
    "given, where it stands, and every impure call it made, in order. A run can be looked"
    "at, taken forward, branched, and read back beside the code that made it."
    ""
    "Usage: dark traces [<subcommand>]"
    ""
    "  dark traces                   the runs, newest first"
    ""
    "Take one forward"
    "  show <run>                    what it ran, where it stands, its effect log"
    "  resume <run>                  carry on where it stopped: the log answers what already"
    "                                happened, then the run goes live"
    "  fork <run> [--at <n>]         a new run branching from any position of an old one"
    "  rerun <run>                   run the input again, performing every effect for real"
    "  pin <run> | unpin <run>       keep it whatever retention says"
    ""
    "Read the code through a run"
    "  calls <fn>                    the runs that went through one function, newest first"
    "  values <fn> [<run>]           that function's code, with that run's values beside it."
    "                                Answers every effect from the log and performs none"
    ""
    "Look around"
    "  list [n] [--json]             the runs, newest first"
    "  list --fn <substring> [n]     ... only the ones that called a matching function"
    "  list --route <substring> [n]  ... only the served requests matching a path or method"
    "  find <pattern> [n]            ... only the ones whose recorded values contain it"
    "  view <run> [flags]            one run as a call tree, with the flags below"
    "  tail [n] [--route <s>]        the nth-most-recent run as a call tree (default 1)"
    "  follow [--route <s>]          print runs as they arrive"
    "  stats [n] | hotspots [n]      runs per entry; time per function across recent runs"
    ""
    "Throw some away"
    "  delete <run>                  one run"
    "  delete --all | --keep <n> | --before <duration>   (duration: 30s, 10m, 2h, 7d)"
    ""
    "A <run> is any unambiguous prefix of its id: `show fe62`, `resume fe6219e9-4705`."
    "`--json` works on list, find, stats, hotspots and follow, for piping into jq."
    ""
    "Flags for `view` and `tail`, combinable:"
    "  -d, --depth <n>               cap the tree at <n> levels"
    "  --no-builtins | --no-stdlib   hide builtin calls; hide stdlib below the entry point"
    "  --filter <pattern>            only calls matching it (and their children)"
    "  --exclude <pattern>           hide calls matching it (children stay, at the parent's"
    "                                indent)"
    "  --slow | --slow-ms <n>        only calls over 10ms, or over <n>ms"
    ""
    "What is recorded, and for how long"
    "  The default is the impure calls only -- what a run read, wrote, sent and got back --"
    "  which is the log a resume and a fork replay. Secret headers and environment values"
    "  are kept out of it (`dark docs processes`); everything else an effect saw is in it."
    "  The oldest go once there are more than `trace.keep` runs or `trace.maxMb` of log,"
    "  except a pinned one, a suspended one, and the newest of each entry."
    "  DARK_CONFIG_TRACE_DETAIL is the ladder: off | inputs | effects | values." ]
  |> Stdlib.String.join "\n"
