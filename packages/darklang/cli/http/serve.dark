module Darklang.Cli.Http.Serve

// Run an HTTP server backed by a Darklang router. `usageLines` is the usage.

/// Parsed flags + positional. `routerPath = ""` means "no router given".
type Args =
  { routerPath: String
    port: Int
    maxBodyBytes: Int
    /// `--live`: resolve the router by name per request, on the last version that passes its
    /// checks (`Stdlib.Live`), and tell an open browser page to reload itself when the version
    /// moves. OFF unless asked for: a server that changes under you while you edit is a thing
    /// to opt into, not something to discover.
    live: Bool
    error: Stdlib.Option.Option<String> }

let defaultArgs (): Args =
  Args
    { routerPath = ""
      port = 8080
      maxBodyBytes = Stdlib.HttpServer.Config.defaultMaxBodyBytes
      live = false
      error = Stdlib.Option.Option.None }

/// Parse a list of args left-to-right. Recognized: a single positional
/// (the router path), `--port N`, `--max-body-bytes N`, `--live`. Unknown flags or a duplicate
/// positional -> an error string in `args.error`. `--dev` and `--no-live` were the two halves of
/// this before it was one flag, and each is refused by name rather than ignored.
let parseArgs (rest: List<String>) (acc: Args) : Args =
  match rest with
  | [] -> acc
  | "--port" :: value :: tail ->
    match Stdlib.Int.parse value with
    | Error _ ->
      { acc with error = Stdlib.Option.Option.Some $"Invalid --port: {value}" }
    | Ok p -> parseArgs tail { acc with port = p }
  | "--max-body-bytes" :: value :: tail ->
    match Stdlib.Int.parse value with
    | Error _ ->
      { acc with
          error = Stdlib.Option.Option.Some $"Invalid --max-body-bytes: {value}" }
    | Ok n -> parseArgs tail { acc with maxBodyBytes = n }
  | "--live" :: tail -> parseArgs tail { acc with live = true }
  | "--no-live" :: _ ->
    { acc with
        error =
          Stdlib.Option.Option.Some
            "--no-live is what happens anyway: a server follows edits only with --live." }
  | "--dev" :: _ ->
    { acc with
        error =
          Stdlib.Option.Option.Some
            "--dev is --live: it follows edits and reloads an open page." }
  | flag :: _ when Stdlib.String.startsWith flag "--" ->
    { acc with
        error = Stdlib.Option.Option.Some $"Unknown or incomplete flag: {flag}" }
  | positional :: tail ->
    if acc.routerPath == "" then
      parseArgs tail { acc with routerPath = positional }
    else
      { acc with
          error =
            Stdlib.Option.Option.Some
              $"Unexpected extra argument: {positional} (router path already given as {acc.routerPath})" }


let usageLines () : List<String> =
  [ "Usage: serve <router-path> [--port N] [--max-body-bytes N] [--live]"
    ""
    "Arguments:"
    "  router-path        Dotted path to a router fn or value (Request -> Response)"
    "  --port N           TCP port to listen on (default: 8080)"
    "  --max-body-bytes N Reject request bodies larger than N bytes (default: 31457280, 30 MB)"
    "  --live             Follow edits: each request runs the newest version of the router that"
    "                     passes its checks, a broken save keeps the previous one, and an open"
    "                     browser page reloads itself when the version moves. Without it the"
    "                     version resolved at start serves until you restart. Not for"
    "                     production: every HTML response carries a small script."
    ""
    "Each request runs as a process of its own (`ps` shows them under the server). A handler"
    "past `http.requestTimeoutMs` (config; 30 s unset) is cancelled and answers 504; one that"
    "raises answers 500 with its error; one stopped from `ps cancel` answers 503."
    ""
    "Examples:"
    "  serve Darklang.DemoData.HttpServerTest.router"
    "  serve Some.Adhoc.Router --port 9000"
    "  serve My.Service.app --port 80 --max-body-bytes 5242880"
    "  serve My.Site.router --port 9095 --live      # follows your edits while you work" ]

let printUsage () : Unit = (usageLines ()) |> Stdlib.printLines


let execute (state: Cli.AppState) (args: List<String>) : Cli.AppState =
  match args with
  | [] ->
    printUsage ()
    state

  | _ ->
    let parsed = parseArgs args (defaultArgs ())

    match parsed.error with
    | Some err ->
      Stdlib.printLine (Stdlib.Cli.UI.Colors.error err)
      printUsage ()
      { state with exitCode = 1 }
    | None ->
      if parsed.routerPath == "" then
        Stdlib.printLine (Stdlib.Cli.UI.Colors.error "Missing router path.")
        printUsage ()
        state
      else
        let portStr = Stdlib.Int.toString parsed.port
        let maxBytesStr = Stdlib.Int.toString parsed.maxBodyBytes

        let baseConfig = Stdlib.HttpServer.Config.defaults parsed.port

        let config =
          if parsed.maxBodyBytes == Stdlib.HttpServer.Config.defaultMaxBodyBytes then
            baseConfig
          else
            { baseConfig with maxBodyBytes = parsed.maxBodyBytes }

        // Resolve the router to a callable value and call serve DIRECTLY — no string-eval. The CLI expression
        // parser mis-tokenizes an int literal in argument position (`defaults 8080` → "no variable named: I"),
        // which breaks the string-eval form of serve; applicableByName sidesteps it.
        // TODO(serve-parser): fix the underlying parser (NI-literal in argument position) — pre-existing platform bug.
        // Resolve BEFORE announcing "Listening" so a bad router name reports cleanly, never a false start.
        // This resolved VALUE is the whole router only under `--no-live`; the live server holds the
        // location and resolves per request, and uses this one for the bind-time approval root.
        match Stdlib.Live.applicableByName state.currentBranchId parsed.routerPath with
        | Ok router ->
          // Announce only once the port is actually bound (via onListening), so a taken port never prints a
          // "Listening" that then turns out to be false. Requests are logged (Config.defaults sets
          // logRequests), but nothing ever said so — leaving you to wonder whether a request arrived at all.
          // In the dev container the host reaches this port on a per-clone offset, set as
          // DARK_HOST_PORT_BASE at startup. Unset outside it, so there's nothing to add.
          let hostLines =
            match Stdlib.Env.get "DARK_HOST_PORT_BASE" with
            | None -> []
            | Some baseStr ->
              match Stdlib.Int.parse baseStr with
              | Error _ -> []
              | Ok hostBase ->
                let offset = parsed.port - 9090
                if (offset < 0) || (offset > 9) || (hostBase == 9090) then
                  []
                else
                  let hostStr = Stdlib.Int.toString (hostBase + offset)
                  [ Stdlib.Cli.UI.Colors.hint $"  From the host: http://localhost:{hostStr}" ]

          let announce () : Unit =
            let following =
              if parsed.live then
                "  Following edits (--live): the next request runs the newest version, and an open page reloads itself."
              else
                "  Pinned: the version resolved at start serves until restart (--live follows edits)."

            let head =
              [ $"Using router: {parsed.routerPath}"
                $"Max body bytes: {maxBytesStr}"
                following
                ""
                Stdlib.Cli.UI.Colors.success
                  $"Listening on http://localhost:{portStr}, and on every interface" ]

            // It binds `http://*:port`. Saying "localhost" read as local-only, and there is
            // no flag to change what it binds because there does not need to be.
            let tail =
              [ Stdlib.Cli.UI.Colors.hint $"  http://localhost:{portStr} here, or this machine's address from anywhere else."
                Stdlib.Cli.UI.Colors.hint "  Requests print here as they arrive (method, path, status, duration)."
                "Press Ctrl+C to stop"
                "" ]

            Stdlib.printLines (Stdlib.List.append head (Stdlib.List.append hostLines tail))

          let served =
            match (parsed.live, Stdlib.Live.locationOfName parsed.routerPath) with
            | (true, Some location) ->
              Stdlib.HttpServer.serveLive
                config
                (Stdlib.Live.Router.start state.currentBranchId location)
                Stdlib.Live.Router.step
                router
                // `--live` is one flag: following edits and telling an open page to reload are
                // the same intent, and a page that reloads itself to fetch a pinned version is
                // nothing.
                true
                announce
            | _ -> Stdlib.HttpServer.serve config router announce

          match served with
          | Ok _ -> ()
          | Error msg -> Stdlib.printLine (Stdlib.Cli.UI.Colors.error msg)
          state
        | Error msg ->
          Stdlib.printLine (
            Stdlib.Cli.UI.Colors.error $"{msg} -- is it defined and committed on this branch?")

          state


let help (_state: Cli.AppState) : String =
  [ "Start an HTTP server backed by a Darklang router."
    "" ]
  |> Stdlib.List.append (usageLines ())
  |> Stdlib.String.join "\n"


let complete
  (state: Cli.AppState)
  (args: List<String>)
  : List<Cli.Completion.CompletionItem> =
  []
