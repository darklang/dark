/// Tools collection for the Darklang Internal MCP server
module Darklang.Internal.DarklangInternalMcpServer.Tools

/// Execute Darklang code and return the result
let executeDarklang () : ModelContextProtocol.ServerBuilder.Tool =
  ModelContextProtocol.ServerBuilder.Tool {
    name = "execute_darklang"
    description = "Execute Darklang code and return the result"
    handler =
      fun code ->
        match Builtin.cliEvaluateExpression (Stdlib.Option.Option.None) SCM.Branch.mainBranchId code false with
        | Ok (Some result) -> $"Result: {result}"
        | Ok None -> "Result: ()"
        | Error err ->
            $"Error: {Cli.ExecutionError.toString SCM.Branch.mainBranchId err}"
  }


/// Search for Darklang functions by name or description
let searchFunctions () : ModelContextProtocol.ServerBuilder.Tool =
  ModelContextProtocol.ServerBuilder.Tool {
    name = "search_functions"
    description = "Search for Darklang functions by name or description"
    handler =
      fun query ->
        let searchQuery =
          LanguageTools.ProgramTypes.Search.SearchQuery
            { currentModule = [ "Darklang" ]
              text = query
              searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
              entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Fn ]
              exactMatch = false }
        let results =
          LanguageTools.PackageManager.Search.search SCM.Branch.mainBranchId searchQuery
        let resultCount = (Stdlib.List.length results.fns) |> Stdlib.Int.toString
        let formattedResults =
          results.fns
          |> Stdlib.List.map (fun fn ->
            let full =
              Stdlib.String.join
                (Stdlib.List.flatten
                  [ [ fn.location.owner ]; fn.location.modules; [ fn.location.name ] ])
                "."
            if fn.entity.description == "" then
              "- " ++ full
            else
              "- " ++ full ++ ": " ++ fn.entity.description)
          |> Stdlib.String.join "\n"
        $"Found {resultCount} functions:\n{formattedResults}"
  }


/// Type check Darklang code without executing it
let typecheck () : ModelContextProtocol.ServerBuilder.Tool =
  ModelContextProtocol.ServerBuilder.Tool {
    name = "typecheck"
    description = "Check Darklang code for syntax errors without executing it"
    handler = fun code ->
      match Builtin.parserParseDiagnostics code with
      | [] -> "Parse check passed: no syntax errors found"
      | diagnostics ->
          let errorList =
            diagnostics
            |> Stdlib.List.map (fun (range, message) ->
              $"- {message} (line {range.start.row |> Stdlib.Int.toString})")
            |> Stdlib.String.join "\n"
          $"Syntax errors found:\n{errorList}"
  }


/// List all available Darklang packages
let listPackages () : ModelContextProtocol.ServerBuilder.Tool =
  ModelContextProtocol.ServerBuilder.Tool {
    name = "list_packages"
    description = "List all available Darklang packages"
    handler = fun filter ->
      let query =
        LanguageTools.ProgramTypes.Search.SearchQuery
          { currentModule = [ "Darklang" ]
            text = filter
            searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
            entityTypes = []
            exactMatch = false }
      let results =
        LanguageTools.PackageManager.Search.search SCM.Branch.mainBranchId query
      let packageCount = (Stdlib.List.length results.submodules) |> Stdlib.Int.toString
      let formattedPackages =
        results.submodules
        |> Stdlib.List.map (fun path -> "- " ++ (Stdlib.String.join path "."))
        |> Stdlib.String.join "\n"
      $"Found {packageCount} modules:\n{formattedPackages}"
  }