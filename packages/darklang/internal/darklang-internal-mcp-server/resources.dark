/// Resources collection for the Darklang Internal MCP server
module Darklang.Internal.DarklangInternalMcpServer.Resources

/// Darklang built-in functions and types
let builtins () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://builtins"
    name = "Darklang Builtins"
    description = "Documentation for Darklang built-in functions and types"
    handler = fun _uri ->
      "# Darklang Built-in Functions and Types\n\nBuilt-in functions include:\n- Basic arithmetic operations\n- String manipulation\n- List operations\n- Type conversions\n\nSee the full documentation for complete details."
  }


/// Darklang standard library functions
let stdlib () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://stdlib"
    name = "Darklang Standard Library"
    description = "Documentation for Darklang standard library functions"
    handler = fun _uri ->
      "# Darklang Standard Library\n\nThe standard library provides:\n- Advanced data structures\n- File I/O operations\n- HTTP client functions\n- Date/time utilities\n- JSON parsing\n- Regular expressions\n\nAll functions are organized by module for easy discovery."
  }


/// Available Darklang packages
let packages () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://packages/manifest"
    name = "Package Manifest"
    description = "List of available Darklang packages and their capabilities"
    handler = fun _uri ->
      let query =
        LanguageTools.ProgramTypes.Search.SearchQuery
          { currentModule = [ "Darklang" ]
            text = ""
            searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.OnlyDirectDescendants
            entityTypes = []
            exactMatch = false }
      let results =
        LanguageTools.PackageManager.Search.search SCM.Branch.mainBranchId query
      let formattedPackages =
        results.submodules
        |> Stdlib.List.map (fun path -> "## " ++ (Stdlib.String.join path "."))
        |> Stdlib.String.join "\n"
      $"# Available Darklang Packages\n\n{formattedPackages}"
  }


/// Darklang type system documentation
let types () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://types"
    name = "Type System"
    description = "Documentation for Darklang's type system"
    handler = fun _uri ->
      "# Darklang Type System\n\n## Basic Types\n- Int\n- Float\n- Bool\n- String\n- Unit\n\n## Complex Types\n- List<T>\n- Dict<K, V>\n- Option<T>\n- Result<T, E>\n\n## Custom Types\n- Records\n- Enums\n- Type aliases\n\nThe type system is designed to be expressive yet simple to use."
  }


/// Darklang configuration and settings
let config () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://config"
    name = "Configuration"
    description = "Current Darklang configuration and settings"
    handler = fun _uri ->
      "# Darklang Configuration\n\n## Current Settings\n- Environment: Development\n- Package loading: Enabled\n- Type checking: Strict\n- Execution timeout: 30s\n\n## Logging\n- Level: Info\n- Output: rundir/logs/\n\nConfiguration can be modified through environment variables or config files."
  }


/// Development logs and debugging information
let logs () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://logs/packages"
    name = "Package Logs"
    description = "Recent package loading and compilation logs"
    handler = fun _uri ->
      match Stdlib.Cli.FileSystem.readFile "rundir/logs/packages.log" with
      | Ok bytes ->
          let content = Stdlib.String.fromBlobWithReplacement bytes
          let lines = Stdlib.String.split content "\n"
          let lineCount = Stdlib.List.length lines
          let recentLines =
            if lineCount > 50 then Stdlib.List.drop lines (lineCount - 50) else lines
          let formattedLines = Stdlib.String.join recentLines "\n"
          $"# Recent Package Logs\n\n```\n{formattedLines}\n```"
      | Error _ -> "# Package Logs\n\nNo recent logs available."
  }


/// Code examples and snippets
let examples () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://examples"
    name = "Code Examples"
    description = "Common Darklang code patterns and examples"
    handler = fun _uri ->
      "# Darklang Code Examples\n\n## Basic Function\n```darklang\nlet add (x: Int) (y: Int) : Int =\n  Stdlib.Int.add x y\n```\n\n## List Processing\n```darklang\nlet processNumbers (numbers: List<Int>) : List<Int> =\n  numbers\n  |> Stdlib.List.filter (fun n -> Stdlib.Int.greaterThan n 0)\n  |> Stdlib.List.map (fun n -> Stdlib.Int.multiply n 2)\n```\n\n## HTTP Request\n```darklang\nlet fetchData (url: String) : String =\n  match Stdlib.HttpClient.get url with\n  | Ok response -> response.body\n  | Error err -> $\"Error: {err}\"\n```"
  }


/// Darklang syntax reference
let syntax () : ModelContextProtocol.ServerBuilder.Resource =
  ModelContextProtocol.ServerBuilder.Resource {
    uri = "darklang://reference/syntax"
    name = "Syntax Reference"
    description = "Complete Darklang syntax reference and grammar"
    handler = fun _uri ->
      "# Darklang Syntax Reference\n\n## Functions\n```darklang\nlet functionName (param1: Type1) (param2: Type2) : ReturnType =\n  expression\n```\n\n## Pattern Matching\n```darklang\nmatch value with\n| Pattern1 -> result1\n| Pattern2 -> result2\n| _ -> defaultResult\n```\n\n## Pipe Operator\n```darklang\nvalue\n|> function1\n|> function2\n```\n\n## Records\n```darklang\ntype Person = { name: String; age: Int }\n\nlet person = Person { name = \"Alice\"; age = 30 }\n```\n\n## Enums\n```darklang\ntype Color =\n  | Red\n  | Green\n  | Blue\n```"
  }