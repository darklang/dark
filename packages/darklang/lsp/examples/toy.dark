/// A language server for a toy language of `name = value` lines: a warning on a line that is
/// not one, a name's value on hover, and the names as completions.
module Darklang.Lsp.Examples.Toy

type Line = { number: Int64, name: String, value: String }

/// The lines that say `name = value`, and the numbers of those that don't.
type Parsed = { lines: List<Line>, bad: List<Int64> }


let parse(text: String): Parsed =
  Stdlib.String.split(text, "\n")
  |> Stdlib.List.indexedMap(fun(n, line) -> (n, Stdlib.String.split(line, " = ")))
  |> Stdlib.List.fold(Parsed { lines = [], bad = [] }, fun(p, (n, parts)) ->
    match parts with
    | [ "" ] -> p
    | [ name, value ] -> { p with lines = Stdlib.List.append(p.lines, Line { number = n, name = name, value = value }) }
    | _ -> { p with bad = Stdlib.List.append(p.bad, n) })


let warning(line: Int64): Lsp.Diagnostic =
  Lsp.Diagnostic
    { range = Lsp.line(line)
      severity = Lsp.Severity.Warning
      code = Option.None
      message = "expected `name = value`"
      data = Option.None }


let hover(_: Lsp.Session<Unit, Parsed>, doc: Lsp.Document<Parsed>, at: Lsp.Position): Option<Lsp.Hover> =
  match Lsp.analysis(doc), Lsp.Text.wordAt(doc.text, at) with
  | Some(parsed), Some(word) ->
    parsed.lines
    |> Stdlib.List.findFirst(fun l -> l.name == word)
    |> Stdlib.Option.map(fun l -> Lsp.Hover { markdown = $"`{l.name}` is {l.value}", range = Option.None })
  | _ -> Option.None


let names(_: Lsp.Session<Unit, Parsed>, doc: Lsp.Document<Parsed>, _: Lsp.Position): List<Lsp.CompletionItem> =
  match Lsp.analysis(doc) with
  | Some(parsed) -> Stdlib.List.map(parsed.lines, fun l -> Lsp.completion(l.name, Lsp.CompletionKind.Variable))
  | None -> []


let server(): Lsp.Server<Unit, Parsed> =
  { Lsp.server("toy", ()) with
      analyser =
        Option.Some(
          Lsp.Analyser
            { analyse = fun(_, doc) -> parse(doc.text)
              diagnostics = fun parsed -> Stdlib.List.map(parsed.bad, warning) })
      handlers =
        { Lsp.noHandlers() with
            hover = Option.Some(hover)
            completion = Option.Some(Lsp.Completion { triggers = [], items = names, resolve = Option.None }) } }


let main(_args: List<String>): Int64 =
  Lsp.run(server())
