/// Specs for any type, from its declaration. This is what makes "your own type" editable with no code:
/// a record becomes `Name { f = ⟨f⟩; ... }`, an enum a case picker on the hole and then `Case(⟨a⟩, ⟨b⟩)`,
/// with the leaves handled by `Prims`. It is also the fallback the registry reaches for when a named
/// kind has no registered spec, and the thing `fluid generate` writes out as source for people to edit.
module Darklang.Fluid.Derive

type TypeReference = Darklang.LanguageTools.ProgramTypes.TypeReference

/// The expectation for a slot of this type.
let expectFor (t: TypeReference) (label: String) : Expect =
  let withKind (k: Kind) : Expect =
    Expect { kind = Stdlib.Option.Option.Some k; typ = Stdlib.Option.Option.Some t; label = label; optional = false }
  match t with
  | TInt -> withKind (Prims.intKind ())
  | TInt8 -> withKind (Prims.intKind ())
  | TUInt8 -> withKind (Prims.intKind ())
  | TInt16 -> withKind (Prims.intKind ())
  | TUInt16 -> withKind (Prims.intKind ())
  | TInt32 -> withKind (Prims.intKind ())
  | TUInt32 -> withKind (Prims.intKind ())
  | TInt64 -> withKind (Prims.intKind ())
  | TUInt64 -> withKind (Prims.intKind ())
  | TInt128 -> withKind (Prims.intKind ())
  | TUInt128 -> withKind (Prims.intKind ())
  | TString -> withKind (Prims.stringKind ())
  | TChar -> withKind (Prims.stringKind ())
  | TBool -> withKind (Prims.boolKind ())
  | TFloat -> withKind (Prims.floatKind ())
  | TUnit -> withKind (Prims.unitKind ())
  | TList _ -> withKind (Prims.listKind ())
  | TCustomType(nr, _) ->
    match typeNameOf nr with
    | Some name -> withKind (Kind.named name)
    | None -> Expect.ofType t label
  | _ -> Expect.ofType t label

/// "Owner.Module.Name" for a resolved type name, or the name as written when it isn't resolved.
let typeNameOf
  (nr: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName>)
  : Stdlib.Option.Option<String> =
  match nr.resolved with
  | Ok r ->
    match r.location with
    | Some loc ->
      Stdlib.Option.Option.Some(
        Stdlib.String.join (Stdlib.List.flatten [ [ loc.owner ], loc.modules, [ loc.name ] ]) ".")
    | None ->
      if Stdlib.List.isEmpty nr.originalName then Stdlib.Option.Option.None
      else Stdlib.Option.Option.Some(Stdlib.String.join nr.originalName ".")
  | Error _ ->
    if Stdlib.List.isEmpty nr.originalName then Stdlib.Option.Option.None
    else Stdlib.Option.Option.Some(Stdlib.String.join nr.originalName ".")

/// The short name to show: the last segment.
let shortName (typeName: String) : String =
  Stdlib.String.split typeName "." |> Stdlib.List.last |> Stdlib.Option.withDefault typeName


// --- Records ---

let recordSummary (n: Node) : String = (shortName (Kind.typeName n.kind)) ++ " {...}"

let recordEmpty
  (typeName: String)
  (fields: List<Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField>)
  : Node =
  Node.make
    (Kind.named typeName)
    (fields |> Stdlib.List.map (fun f -> (f.name, Field.One(Slot.Empty(expectFor f.typ f.name)))))

let recordPieces
  (typeName: String)
  (fields: List<Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField>)
  : List<Piece> =
  // One line when it fits, one field per line when it does not. A soft break, like the printer's, and
  // like the hand-written record specs in pt.dark. This used to be a HARD line for any record with more
  // than one field, on the bias that structure you can scan down a column beats structure packed onto a
  // line; reversed on Stachu's call so a generated editor and the printer agree.
  let break_ = Piece.Line
  let fieldPieces =
    fields
    |> Stdlib.List.indexedMap (fun i f ->
      let sep = if i == 0 then [] else [ Piece.Punct ";", break_ ]
      Stdlib.List.append sep [ Piece.Dim (f.name ++ " = "), Piece.Slot f.name ])
    |> Stdlib.List.flatten
  [ Piece.Group
      [ Piece.Label (shortName typeName)
        Piece.Space
        Piece.Punct "{"
        Piece.Nest(2, Stdlib.List.append [ break_ ] fieldPieces)
        break_
        Piece.Punct "}" ] ]

let recordSpec
  (typeName: String)
  (fields: List<Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField>)
  : Spec =
  let empty = recordEmpty typeName fields
  Spec
    { kind = Kind.named typeName
      pieces = recordPieces typeName fields
      holeRules = [ HoleRule { onChar = "{"; fill = HoleFill.Node empty } ]
      wrapRules = []
      textClasses = []
      maxItems = Spec.noMaxItems
      noSequence = []
      opensItems = []
      closer = Stdlib.Option.Option.None
      operands = Stdlib.Option.Option.None
      segments = Stdlib.Option.Option.None
      collapsesTo = Stdlib.Option.Option.None
      collapsesWhenEmptied = Stdlib.Option.Option.None
      textSlot = Stdlib.Option.Option.None
      bindsNames = false
      completions = [ Spec.candidate (shortName typeName) "record" empty ]
      complete = Spec.noCompletions
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = empty
      summary = recordSummary }


// --- Enums ---

let enumFieldSlot (i: Int) (f: Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField) : String =
  match f.label with
  | Some l -> l
  | None -> "f" ++ (Stdlib.Int.toString i)

let caseSummary (n: Node) : String =
  match n.kind.case with
  | Some c -> c
  | None -> Kind.toString n.kind

let caseEmpty
  (typeName: String)
  (c: Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase)
  : Node =
  Node.make
    (Kind.ofCase typeName c.name)
    (c.fields
     |> Stdlib.List.indexedMap (fun i f ->
       let slotName = enumFieldSlot i f
       (slotName, Field.One(Slot.Empty(expectFor f.typ slotName)))))

let casePieces
  (c: Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase)
  : List<Piece> =
  match c.fields with
  | [] -> [ Piece.Label c.name ]
  | fields ->
    let slots =
      fields
      |> Stdlib.List.indexedMap (fun i f ->
        let sep = if i == 0 then [] else [ Piece.Punct ",", Piece.Line ]
        Stdlib.List.append sep [ Piece.Slot(enumFieldSlot i f) ])
      |> Stdlib.List.flatten
    [ Piece.Group
        [ Piece.Label c.name
          Piece.Punct "("
          Piece.Nest(2, Stdlib.List.append [ Piece.SoftLine ] slots)
          Piece.SoftLine
          Piece.Punct ")" ] ]

let caseSpec
  (typeName: String)
  (c: Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase)
  : Spec =
  let empty = caseEmpty typeName c
  Spec
    { kind = Kind.ofCase typeName c.name
      pieces = casePieces c
      holeRules = []
      wrapRules = []
      textClasses = []
      maxItems = Spec.noMaxItems
      noSequence = []
      opensItems = []
      closer = Stdlib.Option.Option.None
      operands = Stdlib.Option.Option.None
      segments = Stdlib.Option.Option.None
      collapsesTo = Stdlib.Option.Option.None
      collapsesWhenEmptied = Stdlib.Option.Option.None
      textSlot = Stdlib.Option.Option.None
      bindsNames = false
      completions = []
      complete = Spec.noCompletions
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = empty
      summary = caseSummary }

/// The type-level spec: owns the hole. Its completions are the cases.
let enumTypeSpec
  (typeName: String)
  (cases: List<Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase>)
  : Spec =
  let candidates =
    cases
    |> Stdlib.List.map (fun c ->
      let arity = Stdlib.List.length c.fields
      let detail =
        if arity == 0 then shortName typeName
        else (shortName typeName) ++ ", " ++ (Stdlib.Int.toString arity) ++ " field(s)"
      Spec.candidate c.name detail (caseEmpty typeName c))
  let empty =
    match cases with
    | first :: _ -> caseEmpty typeName first
    | [] -> Node.make (Kind.named typeName) []
  Spec
    { kind = Kind.named typeName
      pieces = [ Piece.Dim ("?" ++ (shortName typeName)) ]
      holeRules = []
      wrapRules = []
      textClasses = []
      maxItems = Spec.noMaxItems
      noSequence = []
      opensItems = []
      closer = Stdlib.Option.Option.None
      operands = Stdlib.Option.Option.None
      segments = Stdlib.Option.Option.None
      collapsesTo = Stdlib.Option.Option.None
      collapsesWhenEmptied = Stdlib.Option.Option.None
      textSlot = Stdlib.Option.Option.None
      bindsNames = false
      completions = candidates
      complete = Spec.noCompletions
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = empty
      summary = caseSummary }


// --- Entry point ---

let specsFor
  (typeName: String)
  (decl: Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration)
  : List<Spec> =
  match decl.definition with
  | Record fields -> [ recordSpec typeName fields ]
  | Enum cases -> Stdlib.List.append [ enumTypeSpec typeName cases ] (cases |> Stdlib.List.map (fun c -> caseSpec typeName c))
  | Alias _ -> []


// --- Runtime lookup + source generation (for `fluid generate`) ---

/// Look a type up on the branch and derive its specs. Empty if the type isn't found.
let specsForName (branchId: Uuid) (typeName: String) : List<Spec> =
  let loc = Darklang.LanguageTools.ProgramTypes.parsePackageLocation typeName
  match Darklang.LanguageTools.PackageManager.Type.find branchId loc with
  | Some hash ->
    match Darklang.LanguageTools.PackageManager.Type.get hash with
    | Some pt -> specsFor typeName pt.declaration
    | None -> []
  | None -> []

/// The spec for one CASE of an enum, for a generated module to build on. Same fallback shape.
let specForCase (branchId: Uuid) (typeName: String) (caseName: String) : Spec =
  let wanted = Kind.ofCase typeName caseName
  match specsForName branchId typeName |> Stdlib.List.findFirst (fun sp -> sp.kind == wanted) with
  | Some spec -> spec
  | None -> Spec.simple wanted [ Piece.Dim ("?" ++ caseName) ] (Node.make wanted [])

/// The one spec that owns a type's own holes (the record spec, or the enum's type-level spec), for
/// `fluid generate` to build on. A labelled fallback if the type isn't found.
let specForName (branchId: Uuid) (typeName: String) : Spec =
  match specsForName branchId typeName |> Stdlib.List.head with
  | Some spec -> spec
  | None ->
    Spec.simple (Kind.named typeName) [ Piece.Dim ("?" ++ (shortName typeName)) ] (Node.make (Kind.named typeName) [])

let quoted (s: String) : String =
  let escaped =
    s
    |> fun x -> Stdlib.String.replaceAll x "\\" "\\\\"
    |> fun x -> Stdlib.String.replaceAll x "\"" "\\\""
  "\"" ++ escaped ++ "\""

let styleSource (style: Layout.Style) : String =
  let name =
    match style with
    | Plain -> "Plain"
    | Keyword -> "Keyword"
    | Punct -> "Punct"
    | Literal -> "Literal"
    | Name -> "Name"
    | Hole -> "Hole"
    | Partial -> "Partial"
    | Dim -> "Dim"
    | Error -> "Error"
  "Darklang.Fluid.Layout.Style." ++ name

let pieceSource (p: Piece) : String =
  let listSource (ps: List<Piece>) : String =
    "[ " ++ (ps |> Stdlib.List.map (fun x -> pieceSource x) |> Stdlib.String.join ", ") ++ " ]"
  match p with
  | Text(slot, style) ->
    "Darklang.Fluid.Piece.Text(" ++ (quoted slot) ++ ", " ++ (styleSource style) ++ ")"
  | Punct str -> "Darklang.Fluid.Piece.Punct " ++ (quoted str)
  | Keyword str -> "Darklang.Fluid.Piece.Keyword " ++ (quoted str)
  | Dim str -> "Darklang.Fluid.Piece.Dim " ++ (quoted str)
  | Label str -> "Darklang.Fluid.Piece.Label " ++ (quoted str)
  | Slot slot -> "Darklang.Fluid.Piece.Slot " ++ (quoted slot)
  | Space -> "Darklang.Fluid.Piece.Space"
  | Line -> "Darklang.Fluid.Piece.Line"
  | HardLine -> "Darklang.Fluid.Piece.HardLine"
  | SoftLine -> "Darklang.Fluid.Piece.SoftLine"
  | Each(slot, sep) ->
    "Darklang.Fluid.Piece.Each(" ++ (quoted slot) ++ ", " ++ (listSource sep) ++ ")"
  | EachWith(slot, before, sep) ->
    "Darklang.Fluid.Piece.EachWith("
    ++ (quoted slot) ++ ", " ++ (listSource before) ++ ", " ++ (listSource sep) ++ ")"
  | EachWrapped(slot, openP, sep, closeP) ->
    "Darklang.Fluid.Piece.EachWrapped("
    ++ (quoted slot) ++ ", " ++ (quoted openP) ++ ", " ++ (listSource sep) ++ ", " ++ (quoted closeP) ++ ")"
  | Group ps -> "Darklang.Fluid.Piece.Group " ++ (listSource ps)
  | Flat ps -> "Darklang.Fluid.Piece.Flat " ++ (listSource ps)
  | Nest(n, ps) ->
    "Darklang.Fluid.Piece.Nest(" ++ (Stdlib.Int.toString n) ++ ", " ++ (listSource ps) ++ ")"
  // The rest of the vocabulary. This match had no fallback and knew fifteen of the twenty-four pieces, so
  // it was a crash waiting for the first spec that used one of the others. Derived specs only ever use the
  // fifteen, which is why nothing had hit it.
  | FieldText(slot, style) ->
    "Darklang.Fluid.Piece.FieldText(" ++ (quoted slot) ++ ", " ++ (styleSource style) ++ ")"
  | QuietText(slot, style) ->
    "Darklang.Fluid.Piece.QuietText(" ++ (quoted slot) ++ ", " ++ (styleSource style) ++ ")"
  | NameText(slot, style) ->
    "Darklang.Fluid.Piece.NameText(" ++ (quoted slot) ++ ", " ++ (styleSource style) ++ ")"
  | Table(slot, columns) ->
    let cols = columns |> Stdlib.List.map (fun c -> quoted c) |> Stdlib.String.join ", "
    "Darklang.Fluid.Piece.Table(" ++ (quoted slot) ++ ", [ " ++ cols ++ " ])"
  | ArgSlots(slot, sep) ->
    "Darklang.Fluid.Piece.ArgSlots(" ++ (quoted slot) ++ ", " ++ (listSource sep) ++ ")"
  | OperandSlot(slot, isRight) ->
    "Darklang.Fluid.Piece.OperandSlot("
    ++ (quoted slot) ++ ", " ++ (if isRight then "true" else "false") ++ ")"
  | ParenLowSlot slot -> "Darklang.Fluid.Piece.ParenLowSlot " ++ (quoted slot)
  | FieldTargetSlot slot -> "Darklang.Fluid.Piece.FieldTargetSlot " ++ (quoted slot)
  // These carry a PREDICATE, and a function has no source to print. Saying so in the output is the honest
  // answer: the generated module will not compile until a person writes the predicate back, which is
  // better than emitting something that looks right and means something else.
  | ParenIfSlot(slot, _) ->
    "(* a ParenIfSlot on " ++ (quoted slot) ++ " -- its predicate is a function, write it here *)"
  | ParenIfEach(slot, _, _) ->
    "(* a ParenIfEach on " ++ (quoted slot) ++ " -- its predicate is a function, write it here *)"
  | LineOrHard(slot, _) ->
    "(* a LineOrHard on " ++ (quoted slot) ++ " -- its predicate is a function, write it here *)"
  | Choose(slot, _, _, _) ->
    "(* a Choose on " ++ (quoted slot) ++ " -- its predicate is a function, write it here *)"
  // WhenEmpty carries no function, so unlike its neighbours here it could be printed in full. It is not,
  // because `pieceSource` prints ONE piece and this one holds two lists of them; the recursion that would
  // need is worth writing when something actually derives one.
  | WhenEmpty(slot, _, _) ->
    "(* a WhenEmpty on " ++ (quoted slot) ++ " -- two layouts, write them here *)"

/// A whole editable editor module for `typeName`: a `val` of type Spec that starts from the derived spec
/// and overrides `pieces` with the derived layout inlined, so a person edits the layout and keeps the
/// rest. Discovery (any Spec value, by type) picks it up with no further wiring.
let generateOne (name: String) (from: String) (pieces: List<Piece>) : String =
  let piecesText =
    pieces
    |> Stdlib.List.map (fun p -> "          " ++ (pieceSource p))
    |> Stdlib.String.join "\n"
  [ "val " ++ name ++ " ="
    "  { (" ++ from ++ ") with"
    "      pieces ="
    "        ["
    piecesText
    "        ] }" ]
  |> Stdlib.String.join "\n"

/// A kind written the way `Kind.toString` writes it and the panel shows it: `Type.Case`, or just `Type`
/// for a type-level one. Both readings are tried, because the string alone cannot say which it is.
let kindFromString (s: String) : List<Kind> =
  let parts = Stdlib.String.split s "."

  match Stdlib.List.last parts with
  | Some lastPart ->
    let front = Stdlib.List.take parts ((Stdlib.List.length parts) - 1) |> Stdlib.String.join "."

    if front == "" then
      [ Kind.named s ]
    else
      [ Kind.ofCase front lastPart, Kind.named s ]
  | None -> [ Kind.named s ]

/// The source of an editor for a kind that already SHIPS one, ready to edit and declare.
///
/// Replacing a built-in editor is the thing this whole design is for, and until now it meant writing a
/// `Spec` from scratch against a kind string you had to find in the source. This prints the one that is
/// there, starting from it by name so an edit keeps everything it did not touch.
let generateForKind (kind: Kind) (sp: Spec) : String =
  let short =
    match kind.case with
    | Some c -> c
    | None -> shortName (Kind.typeName kind)

  let fromExpr =
    "Darklang.Fluid.App.builtinSpec "
    ++ (match kind.case with
        | Some c ->
          "(Darklang.Fluid.Kind.ofCase " ++ (quoted (Kind.typeName kind)) ++ " " ++ (quoted c) ++ ")"
        | None -> "(Darklang.Fluid.Kind.named " ++ (quoted (Kind.typeName kind)) ++ ")")
    ++ " |> Stdlib.Option.withDefault (Darklang.Fluid.Spec.simple "
    ++ (match kind.case with
        | Some c ->
          "(Darklang.Fluid.Kind.ofCase " ++ (quoted (Kind.typeName kind)) ++ " " ++ (quoted c) ++ ")"
        | None -> "(Darklang.Fluid.Kind.named " ++ (quoted (Kind.typeName kind)) ++ ")")
    ++ " [] (Darklang.Fluid.Node.make (Darklang.Fluid.Kind.named \"?\") []))"

  [ "/// An editor for " ++ (Kind.toString kind) ++ ", starting from the one that ships."
    "///"
    "/// Edit `pieces` and declare this value anywhere on the branch: Fluid finds every value of type"
    "/// `Darklang.Fluid.Spec` and uses it in place of the built-in for that kind."
    generateOne ("My" ++ short ++ "Editor") fromExpr sp.pieces ]
  |> Stdlib.String.join "
"

let generateModule (typeName: String) (pieces: List<Piece>) : String =
  let short = shortName typeName
  generateOne
    (short ++ "Editor")
    ("Darklang.Fluid.Derive.specForName Darklang.SCM.Branch.mainBranchId " ++ (quoted typeName))
    pieces

/// Every editor a type needs, as source. A RECORD is one value. An ENUM is one per case plus the
/// type-level one that owns the hole -- `fluid generate` used to emit only the head of the derived list,
/// which for an enum is the type-level spec whose pieces are the `?Name` placeholder. So generating an
/// editor for `Option` handed you a stub, and editing it changed nothing you could see, while the derived
/// per-case layouts it was meant to start from went unmentioned.
let generateModuleFor (branchId: Uuid) (typeName: String) : String =
  let short = shortName typeName
  let header =
    [ "/// A Fluid editor for " ++ typeName ++ ", generated from its type declaration."
      "/// Edit `pieces` to change how it is laid out; the rest is derived at load time."
      "///"
      "/// Declaring these values is all it takes: Fluid discovers every value of type"
      "/// `Darklang.Fluid.Spec` by type and uses it in place of the built-in editor." ]
    |> Stdlib.String.join "\n"
  let vals =
    specsForName branchId typeName
    |> Stdlib.List.map (fun sp ->
      match sp.kind.case with
      | Some caseName ->
        generateOne
          (short ++ caseName ++ "Editor")
          ("Darklang.Fluid.Derive.specForCase Darklang.SCM.Branch.mainBranchId "
           ++ (quoted typeName) ++ " " ++ (quoted caseName))
          sp.pieces
      | None ->
        generateOne
          (short ++ "Editor")
          ("Darklang.Fluid.Derive.specForName Darklang.SCM.Branch.mainBranchId " ++ (quoted typeName))
          sp.pieces)
  match vals with
  | [] -> header ++ "\n" ++ (generateModule typeName [ Piece.Dim ("?" ++ short) ])
  | _ -> header ++ "\n" ++ (Stdlib.String.join vals "\n\n")
