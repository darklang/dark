/// The editing kernel: a document, a caret, and what every key does. Pure; no terminal anywhere.
///
/// Two levels. INSERT is the text-like one: the caret sits inside a text run, on a hole, or in a partial,
/// and printable keys type. NAV is the node one: the caret is on a whole node and hjkl walk the tree.
/// Esc goes from INSERT to NAV; from NAV it asks the parent to leave. Nothing here decides colours or
/// draws; `view` in the widget does that from `layout`.
module Darklang.Fluid.Editor

type Mode =
  | Insert
  | Nav

type Snapshot =
  { root: Slot
    caret: Caret }

type State =
  { reg: Registry
    root: Slot
    caret: Caret
    mode: Mode
    /// Layout width the caret is resolved against. The widget sets it from the region on every view.
    width: Int
    history: List<Snapshot>
    future: List<Snapshot>
    /// Which candidate is selected, or NOTHING CHOSEN when negative.
    ///
    /// A blank arrives with nothing chosen. The menu on a fresh hole is "everything that could go here",
    /// and a highlighted first row there is a promise the editor should not make: Enter would either take
    /// something arbitrary, or -- as it did -- refuse, while the status line said `Enter accept`. Typing
    /// picks the first match, because typing is intent; arrowing picks one; until then, none.
    completionIndex: Int
    /// The completion menu for the current caret, computed once per keystroke (a store search is
    /// expensive and was being run several times a frame). Read this everywhere; refresh it after a key.
    menu: List<Candidate>
    /// The menu was dismissed with Escape and stays hidden until the next edit. `candidates` returns [].
    menuDismissed: Bool
    /// The command palette (NAV): open?, the filter typed so far, which action is highlighted.
    paletteOpen: Bool
    paletteFilter: String
    paletteIndex: Int
    /// The last node yanked (NAV `y`), to put elsewhere (NAV `p`). A whole subtree, not text.
    /// The nodes last yanked or cut, to put elsewhere. A LIST, because a selection can be a run of
    /// siblings; empty when there is nothing to put. One node is the ordinary case and stays a
    /// one-element list rather than a separate shape.
    clipboard: List<Node>
    /// The text run currently being typed into, so a run of characters is ONE undo step rather than one
    /// per keystroke. `None` outside a typing run; any structural edit or Esc clears it.
    lastTyped: Stdlib.Option.Option<String>
    /// The character typed by the PREVIOUS keystroke, or None if the last key was not a character.
    ///
    /// Only one rule reads it, and it needs it: `||` and `|>` are two-character tokens whose first half
    /// leaves nothing on screen. Every other two-character token in this language -- `->`, `::`, `|>`
    /// after a settled node -- is recognised from the DRAWING, because the editor has already drawn its
    /// first half by the time the second arrives. The lead punct of a list is the exception: the `|` that
    /// starts a match arm is drawn by the arm, so a `|` typed to start one leaves the screen looking
    /// exactly as it would if Enter had made the arm instead. The two are the same document, the same
    /// caret, and different intentions, so the only thing that separates them is which key came before.
    lastChar: Stdlib.Option.Option<String>
    message: String
    docVersion: Int
    drawn: Stdlib.Option.Option<(Int * Int * List<Layout.Row>)>

    /// The other end of a SIBLING RANGE, when one is being made. `V` sets it to the caret's own node;
    /// `J`/`K` then move the caret and the selection is every sibling between the two.
    ///
    /// A range rather than a rectangle or a character span, because this is a tree: the things you can
    /// sensibly select together are the items of ONE list. Two statements, three list elements, two
    /// match arms. Classic Fluid had a character range over the token stream, which could select half a
    /// node; here that has no meaning, and the sibling run is the honest structural equivalent.
    ///
    /// Cleared by anything that leaves the list, by Escape, and by any edit.
    anchor: Stdlib.Option.Option<Path>

    /// The deepest path `h` has climbed out of, so `l` can climb back INTO it.
    ///
    /// `navChild` takes the first child, which from a `let` is the pattern -- a leaf. So expand then
    /// collapse did not return you where you started, and the value was unreachable without switching to
    /// `j`. Two keys that each worked, and did not compose. Stachu asked for expand/collapse and could
    /// not find it, which is the same complaint from the other side.
    ///
    /// One field rather than a stack: `h` records the deepest point once (it keeps an existing descent
    /// that is still below the caret), and `l` steps one level along it. So three `h` then three `l`
    /// returns exactly, and `l` still descends sensibly when there is nothing remembered.
    descent: Stdlib.Option.Option<Path> }

/// What the editor tells its parent.
type Msg =
  /// Esc at NAV level: the user wants out.
  | Back
  /// Ctrl-S: the document as it is.
  | Save of Slot

val historyLimit = 100

type Outcome = Stdlib.Cli.UI.Widget.Outcome<State, Msg>


// --- Construction ---

let init (reg: Registry) (root: Slot) (width: Int) : State =
  let caret =
    match root with
    | Empty _ -> Caret.inSlot [] "" 0
    | _ -> Caret.onNode []
  State
    { reg = reg
      root = root
      caret = caret
      mode = (match root with
              | Empty _ -> Mode.Insert
              | _ -> Mode.Nav)
      width = width
      history = []
      future = []
      // A blank starts with nothing chosen; see the field.
      completionIndex = -1
      menu = []
      menuDismissed = false
      paletteOpen = false
      paletteFilter = ""
      paletteIndex = 0
      clipboard = []
      lastTyped = Stdlib.Option.Option.None
      lastChar = Stdlib.Option.Option.None
      message = ""
      docVersion = 0
      drawn = Stdlib.Option.Option.None
      anchor = Stdlib.Option.Option.None
      descent = Stdlib.Option.Option.None }
  |> fun s -> { s with menu = computeCandidates s }

let layout (st: State) : List<Layout.Row> =
  Project.render st.reg st.width st.root

let withLayout (st: State) : (State * List<Layout.Row>) =
  match st.drawn with
  | Some((v, w, rows)) when (v == st.docVersion) && (w == st.width) -> (st, rows)
  | _ ->
    let rows = layout st
    ({ st with drawn = Stdlib.Option.Option.Some((st.docVersion, st.width, rows)) }, rows)

let withCells (st: State) : (State * List<(Int * Int * Layout.Cell)>) =
  let (st1, rows) = withLayout st
  (st1, Layout.taggedCells rows)

let withWidth (st: State) (width: Int) : State = { st with width = width }


// --- History ---

let remember (st: State) : State =
  let snap = Snapshot { root = st.root; caret = st.caret }
  let kept = Stdlib.List.take (Stdlib.List.push st.history snap) historyLimit
  { st with history = kept; future = [] }

let undo (st: State) : State =
  match st.history with
  | [] -> { st with message = "nothing to undo" }
  | snap :: rest ->
    let now = Snapshot { root = st.root; caret = st.caret }
    { st with
        root = snap.root
        docVersion = st.docVersion + 1
        caret = snap.caret
        history = rest
        future = Stdlib.List.push st.future now
        lastTyped = Stdlib.Option.Option.None
        lastChar = Stdlib.Option.Option.None
        message = "" }

let redo (st: State) : State =
  match st.future with
  | [] -> { st with message = "nothing to redo" }
  | snap :: rest ->
    let now = Snapshot { root = st.root; caret = st.caret }
    { st with
        root = snap.root
        docVersion = st.docVersion + 1
        caret = snap.caret
        future = rest
        history = Stdlib.List.push st.history now
        lastTyped = Stdlib.Option.Option.None
        lastChar = Stdlib.Option.Option.None
        message = "" }

/// Apply edits as one undoable step, then put the caret where the edit says. A structural edit, so it
/// always takes a snapshot and ends any typing run.
let commit (st: State) (edits: List<Edit>) (caret: Caret) : State =
  let st1 = remember st
  { st1 with
      root = Edit.applyAll st1.root edits
      docVersion = st1.docVersion + 1
      caret = caret
      message = ""
      // A structural edit lands somewhere new, usually a blank, so nothing is chosen there yet.
      completionIndex = -1
      lastTyped = Stdlib.Option.Option.None
      lastChar = Stdlib.Option.Option.None
      menuDismissed = false
      // An edit invalidates the `h`/`l` trail: it is a path into a tree that has just changed shape.
      anchor = Stdlib.Option.Option.None
      descent = Stdlib.Option.Option.None }

/// Apply typing edits, coalescing consecutive characters in the SAME text run into one undo step. The
/// first character of a run snapshots; the rest edit the same snapshot, so Ctrl-Z undoes the whole word,
/// not one letter. `runKey` identifies the run (a path plus slot); a different run, or any structural
/// edit, starts a new undo step.
let commitRun (st: State) (runKey: String) (edits: List<Edit>) (caret: Caret) : State =
  let continuing = st.lastTyped == (Stdlib.Option.Option.Some runKey)
  let base = if continuing then st else remember st
  { base with
      root = Edit.applyAll base.root edits
      docVersion = base.docVersion + 1
      caret = caret
      message = ""
      completionIndex = 0
      lastTyped = Stdlib.Option.Option.Some runKey
      menuDismissed = false }


// --- Where the caret can go ---

/// The first place a caret can be put in a node: its first text run or hole, depth first. `OnNode` when
/// the node has nothing editable at all (a keyword, `()`).
let firstEditable (path: Path) (n: Node) : Caret =
  let inSlot (slotCaret: Caret) (childPath: Path) (s: Slot) : Stdlib.Option.Option<Caret> =
    match s with
    | Empty _ -> Stdlib.Option.Option.Some slotCaret
    | Partial(text, _) -> Stdlib.Option.Option.Some { slotCaret with offset = Stdlib.String.length text }
    | Filled child ->
      let c = firstEditable childPath child
      match c.part with
      | OnNode -> Stdlib.Option.Option.None
      | _ -> Stdlib.Option.Option.Some c
  let found =
    n.fields
    |> Stdlib.List.filterMap (fun f ->
      let (name, fld) = f
      match fld with
      | Text t ->
        if Stdlib.String.startsWith name "_" then Stdlib.Option.Option.None
        else Stdlib.Option.Option.Some(Caret.inText path name 0)
      | One s -> inSlot (Caret.inSlot path name 0) (Path.child path name) s
      | Many(items, _) ->
        items
        |> Stdlib.List.indexedMap (fun i s -> inSlot (Caret.inItem path name i 0) (Path.item path name i) s)
        |> Stdlib.List.filterMap (fun x -> x)
        |> Stdlib.List.head)
    |> Stdlib.List.head
  match found with
  | Some c -> c
  | None -> Caret.onNode path

/// Same, but the last: end of the last text run.
let lastEditable (path: Path) (n: Node) : Caret =
  let inSlot (slotCaret: Caret) (childPath: Path) (s: Slot) : Stdlib.Option.Option<Caret> =
    match s with
    | Empty _ -> Stdlib.Option.Option.Some slotCaret
    | Partial(text, _) -> Stdlib.Option.Option.Some { slotCaret with offset = Stdlib.String.length text }
    | Filled child ->
      let c = lastEditable childPath child
      match c.part with
      | OnNode -> Stdlib.Option.Option.None
      | _ -> Stdlib.Option.Option.Some c
  let found =
    n.fields
    |> Stdlib.List.reverse
    |> Stdlib.List.filterMap (fun f ->
      let (name, fld) = f
      match fld with
      | Text t ->
        if Stdlib.String.startsWith name "_" then Stdlib.Option.Option.None
        else Stdlib.Option.Option.Some(Caret.inText path name (Stdlib.String.length t))
      | One s -> inSlot (Caret.inSlot path name 0) (Path.child path name) s
      | Many(items, _) ->
        items
        |> Stdlib.List.indexedMap (fun i s -> inSlot (Caret.inItem path name i 0) (Path.item path name i) s)
        |> Stdlib.List.filterMap (fun x -> x)
        |> Stdlib.List.last)
    |> Stdlib.List.head
  match found with
  | Some c -> c
  | None -> Caret.onNode path

/// Where the caret goes after a typed character created `n`: at the END of its first text run (the
/// character just typed is in it), or on its first hole.
let landAfterFill (path: Path) (n: Node) : Caret =
  let c = firstEditable path n
  match c.part with
  | InText slot ->
    let len =
      nodeAtPath (Slot.Filled n) (Stdlib.List.drop c.node (Stdlib.List.length path))
      |> Stdlib.Option.andThen (fun inner -> Node.text inner slot)
      |> Stdlib.Option.map (fun t -> Stdlib.String.length t)
      |> Stdlib.Option.withDefault 0
    { c with offset = len }
  | _ -> c

/// The text under the caret, if it is in a text run or partial.
let textUnder (st: State) : Stdlib.Option.Option<String> =
  match st.caret.part with
  | InText slot ->
    match nodeAtPath st.root st.caret.node with
    | Some n -> Node.text n slot
    | None -> Stdlib.Option.Option.None
  | _ ->
    match Caret.slotPath st.caret with
    | Some sp ->
      match slotAtPath st.root sp with
      | Some(Partial(text, _)) -> Stdlib.Option.Option.Some text
      | _ -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

/// The slot the caret is on (hole or partial), if any.
let slotUnder (st: State) : Stdlib.Option.Option<Slot> =
  match Caret.slotPath st.caret with
  | Some sp -> slotAtPath st.root sp
  | None -> Stdlib.Option.Option.None

let sameTag (t: Layout.Tag) (c: Caret) : Bool =
  Layout.tagMatches t c.node c.part

/// Caret for landing on a tagged cell from the left (offset 0) or the right (end of text).
let caretForCell (c: Layout.Cell) (atEnd: Bool) : Stdlib.Option.Option<Caret> =
  match c.tag with
  | Some t ->
    let offset =
      if atEnd then
        // A HOLE's text is its label, not something you are editing, so the end of it is not a place to
        // be. Real text is, whatever colour it happens to be drawn in.
        //
        // `Dim` used to be treated the same way, back when an empty text slot drew its own name dimmed.
        // Those are drawn as holes now, and the only remaining dim TAGGED text is a doc comment -- so
        // `End` on one did nothing and typing after it went in at the front.
        (match c.style with
         | Hole -> 0
         | _ -> Stdlib.String.length c.text)
      else
        0
    Stdlib.Option.Option.Some(Caret { node = t.node; part = t.part; offset = offset })
  | None -> Stdlib.Option.Option.None


// --- Motion ---

/// Index of the caret's cell in the reading-order list of tagged cells.
let caretCellIndex (cells: List<(Int * Int * Layout.Cell)>) (caret: Caret) : Stdlib.Option.Option<Int> =
  cells
  |> Stdlib.List.indexedMap (fun i rc -> (i, rc))
  |> Stdlib.List.findFirst (fun irc ->
    let (_, rc) = irc
    let (_, _, c) = rc
    match c.tag with
    | Some t -> sameTag t caret
    | None -> false)
  |> Stdlib.Option.map (fun irc ->
    let (i, _) = irc
    i)

let moveLeft (st: State) : State =
  let textLen = textUnder st |> Stdlib.Option.map (fun t -> Stdlib.String.length t)
  let caret = st.caret
  match caret.part with
  | AfterNode ->
    // Left from just-after a node steps back into its end, undoing a step-past.
    match nodeAtPath st.root caret.node with
    | Some n -> { st with caret = lastEditable caret.node n }
    | None -> st
  | _ ->
  if caret.offset > 0 && (Stdlib.Option.isSome textLen) then
    { st with caret = { caret with offset = caret.offset - 1 } }
  else
    let (st, cells) = withCells st
    match caretCellIndex cells caret with
    | Some i ->
      if i == 0 then
        st
      else
        match Stdlib.List.getAt cells (i - 1) with
        | Some((_, _, c)) ->
          match caretForCell c true with
          | Some nc -> { st with caret = nc }
          | None -> st
        | None -> st
    | None -> st

let moveRight (st: State) : State =
  let caret = st.caret
  match caret.part with
  | AfterNode ->
    // Right from just-after a node advances to the next editable cell beyond the whole construct.
    let (st, cells) = withCells st
    let lastIdx =
      cells
      |> Stdlib.List.indexedMap (fun i rcc -> (i, rcc))
      |> Stdlib.List.filter (fun irc ->
        let (_, rcc) = irc
        let (_, _, c) = rcc
        match c.tag with
        | Some t -> Path.isPrefixOf caret.node t.node
        | None -> false)
      |> Stdlib.List.last
      |> Stdlib.Option.map (fun irc ->
        let (i, _) = irc
        i)
    match lastIdx with
    | Some i ->
      match Stdlib.List.getAt cells (i + 1) with
      | Some((_, _, c)) ->
        match caretForCell c false with
        | Some nc -> { st with caret = nc }
        | None -> st
      | None -> st
    | None -> st
  | _ ->
  let textLen = textUnder st |> Stdlib.Option.map (fun t -> Stdlib.String.length t)
  let canAdvance =
    match textLen with
    | Some n -> caret.offset < n
    | None -> false
  // At the end of a partial that exactly matches a candidate, moving right accepts it (commit-on-move-off,
  // like classic Fluid) rather than sliding the caret past an unresolved name.
  let atPartialEnd =
    match slotUnder st with
    | Some(Partial(typed, _)) -> caret.offset >= (Stdlib.String.length typed)
    | _ -> false
  if atPartialEnd && (Stdlib.Option.isSome (exactCandidate st)) then
    commitCandidate st
  elif canAdvance then
    { st with caret = { caret with offset = caret.offset + 1 } }
  else
    let (st, cells) = withCells st
    // The cell after the caret is the next place a caret can GO. When it is punctuation the node itself
    // draws -- a string's closing quote -- there is no cell to take, and Right did nothing at all.
    //
    // So `"a` then Right stayed inside the string, and the only way out was to type an operator, which
    // used to break out and wrap. That is the escape hatch a pin was using, and it stopped working the
    // moment an operator inside a string became content, which is what it always should have been. The
    // hatch was covering for this.
    //
    // Landing AFTER the node is where Right from the end of one belongs, and it is where the closing
    // quote already puts you.
    let afterOwnNode = { st with caret = Caret.afterNode caret.node }
    match caretCellIndex cells caret with
    | Some i ->
      match Stdlib.List.getAt cells (i + 1) with
      | Some((_, _, c)) ->
        match caretForCell c false with
        | Some nc -> { st with caret = nc }
        | None -> afterOwnNode
      | None -> afterOwnNode
    | None -> st

/// Up or down one row, keeping the column where we can.
let moveVertical (st: State) (delta: Int) : State =
  let (st, rows) = withLayout st
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | None -> st
  | Some((row, col)) ->
    let target = row + delta
    if target < 0 || target >= (Stdlib.List.length rows) then
      st
    else
      match Layout.cellAt rows target col with
      | Some((t, offset)) ->
        { st with caret = Caret { node = t.node; part = t.part; offset = offset } }
      | None ->
        // Nothing editable under that column: take the nearest tagged cell on the row, preferring left.
        let onRow =
          Layout.taggedCells rows
          |> Stdlib.List.filter (fun rc ->
            let (r, _, _) = rc
            r == target)
        let leftOf =
          onRow
          |> Stdlib.List.filter (fun rc ->
            let (_, c0, _) = rc
            c0 <= col)
          |> Stdlib.List.last
        let pick =
          match leftOf with
          | Some x -> Stdlib.Option.Option.Some x
          | None -> Stdlib.List.head onRow
        match pick with
        | Some((_, c0, c)) ->
          match caretForCell c (c0 <= col) with
          | Some nc -> { st with caret = nc }
          | None -> st
        | None -> st

/// The tagged cells on the caret's current row, in reading order.
let cellsOnCaretRow (st: State) : List<(Int * Int * Layout.Cell)> =
  let (st, rows) = withLayout st
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, _)) ->
    Layout.taggedCells rows
    |> Stdlib.List.filter (fun rc ->
      let (r, _, _) = rc
      r == row)
  | None -> []

/// Home / End: jump to the first / last editable position on the current line.
let moveLineStart (st: State) : State =
  match Stdlib.List.head (cellsOnCaretRow st) with
  | Some((_, _, c)) ->
    match caretForCell c false with
    | Some nc -> { st with caret = nc }
    | None -> st
  | None -> st

let moveLineEnd (st: State) : State =
  match Stdlib.List.last (cellsOnCaretRow st) with
  | Some((_, _, c)) ->
    match caretForCell c true with
    | Some nc -> { st with caret = nc }
    | None -> st
  | None -> st

/// Holes in reading order.
let holeCarets (st: State) : List<Caret> =
  Layout.taggedCells (layout st)
  |> Stdlib.List.filterMap (fun rc ->
    let (_, _, c) = rc
    match c.style with
    | Hole -> caretForCell c false
    | _ -> Stdlib.Option.Option.None)

let nextHole (st: State) : State =
  let (st, cells) = withCells st
  let here = caretCellIndex cells st.caret |> Stdlib.Option.withDefault (-1)
  let after =
    cells
    |> Stdlib.List.indexedMap (fun i rc -> (i, rc))
    |> Stdlib.List.filter (fun irc ->
      let (i, rc) = irc
      let (_, _, c) = rc
      i > here && c.style == Layout.Style.Hole)
    |> Stdlib.List.head
  let pick =
    match after with
    | Some x -> Stdlib.Option.Option.Some x
    | None ->
      // Wrap around.
      cells
      |> Stdlib.List.indexedMap (fun i rc -> (i, rc))
      |> Stdlib.List.filter (fun irc ->
        let (_, rc) = irc
        let (_, _, c) = rc
        c.style == Layout.Style.Hole)
      |> Stdlib.List.head
  match pick with
  | Some((_, (_, _, c))) ->
    match caretForCell c false with
    | Some nc -> { st with caret = nc; mode = Mode.Insert }
    | None -> st
  | None -> { st with message = "no holes" }

let prevHole (st: State) : State =
  let (st, cells) = withCells st
  let total = Stdlib.List.length cells
  let here = caretCellIndex cells st.caret |> Stdlib.Option.withDefault total
  let before =
    cells
    |> Stdlib.List.indexedMap (fun i rc -> (i, rc))
    |> Stdlib.List.filter (fun irc ->
      let (i, rc) = irc
      let (_, _, c) = rc
      i < here && c.style == Layout.Style.Hole)
    |> Stdlib.List.last
  let pick =
    match before with
    | Some x -> Stdlib.Option.Option.Some x
    | None ->
      cells
      |> Stdlib.List.indexedMap (fun i rc -> (i, rc))
      |> Stdlib.List.filter (fun irc ->
        let (_, rc) = irc
        let (_, _, c) = rc
        c.style == Layout.Style.Hole)
      |> Stdlib.List.last
  match pick with
  | Some((_, (_, _, c))) ->
    match caretForCell c false with
    | Some nc -> { st with caret = nc; mode = Mode.Insert }
    | None -> st
  | None -> { st with message = "no holes" }


// --- Actions (the palette) ---

/// Actions applicable to the node the NAV caret is on: from that kind's own spec and its type-level spec.
let paletteActions (st: State) : List<Action> =
  match nodeAtPath st.root (navPath st) with
  | Some n ->
    let fromSpec (spec: Stdlib.Option.Option<Spec>) : List<Action> =
      match spec with
      | Some sp -> sp.actions |> Stdlib.List.filter (fun a -> a.applies n)
      | None -> []
    // A kind with no CASE is its own type level -- `findTypeLevel` strips the case, and there is none to
    // strip -- so asking both is asking one question twice, and the panel drew every action on a Function
    // twice under ACTIONS. It also inflated the `:` palette and the panel's "7 shown, N more" count.
    //
    // Only here. Every other caller of `findTypeLevel` uses it as a `| None ->` fallback or ORs the two
    // booleans, and a duplicate is invisible in both; this is the one place that flattens them into a
    // LIST. So the guard goes here rather than in the lookup, which is correct as it stands.
    let typeLevel =
      match n.kind.case with
      | Some _ -> fromSpec (Registry.findTypeLevel st.reg n.kind)
      | None -> []

    Stdlib.List.flatten
      [ fromSpec (Registry.findExact st.reg n.kind)
        typeLevel
        unwrapActions n (navPath st) ]
  | None -> []

/// The palette actions matching the current filter.
let visibleActions (st: State) : List<Action> =
  let f = Stdlib.String.toLowercase st.paletteFilter
  if f == "" then paletteActions st
  else paletteActions st |> Stdlib.List.filter (fun a -> Stdlib.String.contains (Stdlib.String.toLowercase a.name) f)

/// Generic conversions the kernel can offer on any node, without a per-kind spec: replace the node with
/// one of its child sub-nodes of the same type ("unwrap"). Keeps a branch of an `if`, an operand of a
/// `+`, an element of a list.
let unwrapActions (n: Node) (path: Path) : List<Action> =
  let childOfType (child: Node) : Bool = child.kind.typ == n.kind.typ
  let fromField (name: String) (fld: Field) : List<Action> =
    match fld with
    | One(Filled child) ->
      if childOfType child then
        [ Action
            { name = "unwrap to " ++ name
              key = Stdlib.Option.Option.None
              doc = "replace this with its " ++ name
              applies = (fun _ -> true)
              run = (fun _ -> Slot.Filled child) } ]
      else
        []
    | Many(items, _) ->
      items
      |> Stdlib.List.indexedMap (fun i s -> (i, s))
      |> Stdlib.List.filterMap (fun pair ->
        let (i, s) = pair
        match s with
        | Filled child ->
          if childOfType child then
            Stdlib.Option.Option.Some(
              Action
                { name = "unwrap to " ++ name ++ "[" ++ (Stdlib.Int.toString i) ++ "]"
                  key = Stdlib.Option.Option.None
                  doc = "replace this with that element"
                  applies = (fun _ -> true)
                  run = (fun _ -> Slot.Filled child) })
          else
            Stdlib.Option.Option.None
        | _ -> Stdlib.Option.Option.None)
    | _ -> []
  n.fields
  |> Stdlib.List.map (fun f ->
    let (name, fld) = f
    fromField name fld)
  |> Stdlib.List.flatten

let openPalette (st: State) : State =
  if Stdlib.List.isEmpty (paletteActions st) then { st with message = "no actions here" }
  else { st with paletteOpen = true; paletteFilter = ""; paletteIndex = 0 }

let closePalette (st: State) : State = { st with paletteOpen = false; paletteIndex = 0 }

let movePalette (st: State) (delta: Int) : State =
  let n = Stdlib.List.length (visibleActions st)
  if n == 0 then st
  else { st with paletteIndex = Stdlib.Int.clamp (st.paletteIndex + delta) 0 (n - 1) }

/// Run the highlighted action: replace the current node's slot with what the action returns.
/// Run one action on the node the NAV caret is on. Shared by the palette and by an action's own key, so
/// the two can't drift: whatever the palette does when you pick an action, the key does too.
let applyAction (st: State) (action: Action) : State =
  match nodeAtPath st.root (navPath st) with
  | Some n ->
    let here = navPath st
    let replacement = action.run n
    let st1 = commit { st with paletteOpen = false } [ Edit.Replace(here, replacement) ] st.caret

    // If the action left a HOLE, go to it and start typing. An action that adds something -- a parameter,
    // a let above this, a match around it -- has just made a blank that only you can fill, and leaving the
    // caret on the node you were already on meant the next keystroke went nowhere. This is the same
    // landing rule the kernel already used after filling a hole or wrapping a node; actions were the one
    // path that did not.
    //
    // An action that leaves no hole -- unwrap, convert to match -- keeps the caret where it was, in NAV.
    match replacement with
    | Filled c when Stdlib.Bool.not (Stdlib.List.isEmpty (holes (Slot.Filled c))) ->
      { st1 with
          caret = landAfterCommit here c
          mode = Mode.Insert
          message = action.name }
    | _ -> { st1 with caret = navCaretFor st1.root here; message = action.name }
  | None -> closePalette st

/// The action a SPEC binds to `ch` on the node the caret is on, if any.
///
/// `Action.key` has been in the spec vocabulary since the palette was written and the kernel never read
/// it: a spec could say which key it wanted and nothing happened. This is the whole point of the keymap
/// being data -- someone writing their own kind, or a DSL on top, binds keys on their own nodes without
/// touching the kernel's dispatch. Only `:` is reserved, because the palette is the escape hatch that
/// lists everything and has to keep working whatever a spec has bound.
let actionForKey (st: State) (ch: String) : Stdlib.Option.Option<Action> =
  if ch == "" || ch == ":" then
    Stdlib.Option.Option.None
  else
    paletteActions st
    |> Stdlib.List.findFirst (fun a -> a.key == Stdlib.Option.Option.Some ch)

let runPaletteAction (st: State) : State =
  match Stdlib.List.getAt (visibleActions st) st.paletteIndex with
  | Some action -> applyAction st action
  | None -> closePalette st


// --- NAV: walking nodes ---

/// Every node path in pre-order, holes included as leaves (so NAV can land on them).
let nodePaths (root: Slot) : List<Path> =
  let walk (path: Path) (s: Slot) : List<Path> =
    match s with
    | Filled n ->
      let below =
        n.fields
        |> Stdlib.List.map (fun f ->
          let (name, fld) = f
          match fld with
          | Text _ -> []
          | One child -> walk (Path.child path name) child
          | Many(items, _) ->
            items
            |> Stdlib.List.indexedMap (fun i child -> walk (Path.item path name i) child)
            |> Stdlib.List.flatten)
        |> Stdlib.List.flatten
      Stdlib.List.append [ path ] below
    | _ -> [ path ]
  walk [] root

/// The NAV caret for a path: OnNode when there is a node, on the hole/partial otherwise.
let navCaretFor (root: Slot) (path: Path) : Caret =
  match slotAtPath root path with
  | Some(Filled _) -> Caret.onNode path
  | _ ->
    match Path.parent path with
    | Some parentPath ->
      match Path.last path with
      | Some(Into slot) -> Caret.inSlot parentPath slot 0
      | Some(Item(slot, i)) -> Caret.inItem parentPath slot i 0
      | None -> Caret.onNode path
    | None -> Caret.inSlot [] "" 0

/// The path NAV considers "current": the node, or the slot the caret is on.
let navPath (st: State) : Path =
  match Caret.slotPath st.caret with
  | Some sp -> sp
  | None -> st.caret.node

/// Inside a grid, the same COLUMN one row along -- the path with its row index moved and everything after
/// it kept. Reading order would walk sideways along the row instead, which is not what Down means in a
/// table.
///
/// The two Nones are different answers and the caller has to tell them apart, which is why this is nested
/// rather than flat. Outer None: the caret is not in a table, so reading order is right. Inner None: the
/// caret IS in one and there is no row that way, so nothing happens. Flattened, Down on the last row fell
/// through to reading order and walked sideways into the next COLUMN -- which is what `l` means, so two
/// keys did one thing and one of them lied about its direction.
let tableRowTarget (st: State) (delta: Int) : Stdlib.Option.Option<Stdlib.Option.Option<Path>> =
  let here = navPath st
  let len = Stdlib.List.length here
  // The innermost enclosing table wins, so a grid inside a grid still moves the row you are in.
  Stdlib.List.range 0 (len - 1)
  |> Stdlib.List.reverse
  |> Stdlib.List.filterMap (fun k ->
    match Stdlib.List.getAt here k with
    | Some(Item(slotName, i)) ->
      let prefix = Stdlib.List.take here k
      let rest = Stdlib.List.drop here (k + 1)
      (match nodeAtPath st.root prefix with
       | Some parent ->
         (match Registry.findTypeLevel st.reg parent.kind with
          | Some spec ->
            if Stdlib.List.member (Project.tableSlots spec.pieces) slotName then
              let target = i + delta
              let count = Stdlib.List.length (Node.items parent slotName)
              if (target >= 0) && (target < count) then
                Stdlib.Option.Option.Some(
                  Stdlib.Option.Option.Some(
                    Stdlib.List.flatten [ prefix, [ Step.Item(slotName, target) ], rest ]))
              else Stdlib.Option.Option.Some(Stdlib.Option.Option.None)
            else Stdlib.Option.Option.None
          | None -> Stdlib.Option.Option.None)
       | None -> Stdlib.Option.Option.None)
    | _ -> Stdlib.Option.Option.None)
  |> Stdlib.List.head

/// Inside a grid, the next or previous COLUMN of the row you are on. `l` on a ROW still descends into its
/// first cell; this is what `l` means once you are IN one, and `h` from the first column still steps out
/// to the row, so you are never stuck.
let tableColumnTarget (st: State) (delta: Int) : Stdlib.Option.Option<Path> =
  let here = navPath st
  match Stdlib.List.last here with
  | Some(Into colName) ->
    let rowPath = Stdlib.List.take here ((Stdlib.List.length here) - 1)
    (match Stdlib.List.last rowPath with
     | Some(Item(slotName, _)) ->
       let gridPath = Stdlib.List.take rowPath ((Stdlib.List.length rowPath) - 1)
       (match nodeAtPath st.root gridPath with
        | Some grid ->
          (match Registry.findTypeLevel st.reg grid.kind with
           | Some spec ->
             let cols = Project.tableColumnsFor spec.pieces slotName
             (match Stdlib.List.findFirstIndex cols (fun c -> c == colName) with
              | Some idx ->
                let target = idx + delta
                if (target >= 0) && (target < (Stdlib.List.length cols)) then
                  Stdlib.List.getAt cols target
                  |> Stdlib.Option.map (fun c -> Stdlib.List.append rowPath [ Step.Into c ])
                else Stdlib.Option.Option.None
              | None -> Stdlib.Option.Option.None)
           | None -> Stdlib.Option.Option.None)
        | None -> Stdlib.Option.Option.None)
     | _ -> Stdlib.Option.Option.None)
  | _ -> Stdlib.Option.Option.None

/// Reading order, one node along.
let navByReadingOrder (st: State) (delta: Int) : State =
  let paths = nodePaths st.root
  let here = navPath st
  let idx =
    paths
    |> Stdlib.List.indexedMap (fun i p -> (i, p))
    |> Stdlib.List.findFirst (fun ip ->
      let (_, p) = ip
      p == here)
    |> Stdlib.Option.map (fun ip ->
      let (i, _) = ip
      i)
    |> Stdlib.Option.withDefault 0
  let target = Stdlib.Int.clamp (idx + delta) 0 ((Stdlib.List.length paths) - 1)
  match Stdlib.List.getAt paths target with
  | Some p -> { st with caret = navCaretFor st.root p }
  | None -> st

let navBy (st: State) (delta: Int) : State =
  // Reading-order motion abandons the trail, which describes where `h` came from and is now a lie.
  let st = { st with descent = Stdlib.Option.Option.None }

  match tableRowTarget st delta with
  | Some(Some p) -> { st with caret = navCaretFor st.root p }

  // Off the end of a table. The two directions are deliberately not symmetric, and the existing pins had
  // already settled it for `h`/`l`: BACKWARDS at an edge steps out, so you are never stuck; FORWARDS at an
  // edge sticks, so nothing runs off the end. `l` off the last column already stuck and `k` off the first
  // row already stepped out; `j` off the LAST row was the one that did neither -- it fell through to
  // reading order, which walks sideways into the next COLUMN. That is what `l` means, so two keys did one
  // thing and one of them lied about its direction.
  | Some None -> if delta > 0 then st else navByReadingOrder st delta

  | None -> navByReadingOrder st delta

/// The paths currently selected: just the caret's node, or the whole run between it and the anchor.
///
/// Both ends must be children of the same parent. They always are while `V` and `J`/`K` are the only
/// way to make one, but `h` or `j` can move the caret elsewhere, and a range whose ends are in
/// different lists is not a range -- so that collapses back to the single node rather than selecting
/// something arbitrary between them.
let selectedPaths (st: State) : List<Path> =
  let here = navPath st
  match st.anchor with
  | None -> [ here ]
  | Some a ->
    if (Path.parent a) != (Path.parent here) then
      [ here ]
    else
      let sibs =
        nodePaths st.root
        |> Stdlib.List.filter (fun p -> (Path.parent p) == (Path.parent here))
      let indexOf (target: Path) : Stdlib.Option.Option<Int> =
        sibs
        |> Stdlib.List.indexedMap (fun i p -> (i, p))
        |> Stdlib.List.findFirst (fun ip -> let (_, p) = ip in p == target)
        |> Stdlib.Option.map (fun ip -> let (i, _) = ip in i)
      match (indexOf a, indexOf here) with
      | (Some i, Some j) ->
        let lo = Stdlib.Int.min i j
        let hi = Stdlib.Int.max i j
        sibs
        |> Stdlib.List.indexedMap (fun k p -> (k, p))
        |> Stdlib.List.filterMap (fun kp ->
          let (k, p) = kp
          if (k >= lo) && (k <= hi) then Stdlib.Option.Option.Some p else Stdlib.Option.Option.None)
      | _ -> [ here ]

/// Start a sibling range at the caret, or drop the one in progress.
let toggleAnchor (st: State) : State =
  match st.anchor with
  | Some _ -> { st with anchor = Stdlib.Option.Option.None; message = "range dropped" }
  | None ->
    if Stdlib.List.isEmpty (navPath st) then
      { st with message = "nothing to select here" }
    else
      { st with
          anchor = Stdlib.Option.Option.Some(navPath st)
          message = "range from here; J/K to extend" }

/// The next or previous SIBLING: another child of the same parent, in drawing order.
///
/// `j`/`k` walk READING order, which goes into everything. In a function anyone would call realistic that
/// is one press per node: getting from the signature of a twenty-line function to its body is dozens of
/// keys, and there was no coarser motion in the editor at all -- found by opening a real store function in
/// a terminal and trying to get anywhere in it.
///
/// `h` climbs to the parent and this walks the parent's children, which together are the motion that makes
/// a big document navigable. Siblings are read off the same reading-order walk `j` uses, so a slot, a list
/// item and a text field are all siblings if the spec draws them under the same node -- no second notion of
/// what a child is, and a DSL gets it for nothing.
///
/// At either end it stays put. `h` is the key for going out, and a sibling walk that silently climbed would
/// do something different every few presses when you held it down.
let navSibling (st: State) (delta: Int) : State =
  let st = { st with descent = Stdlib.Option.Option.None }
  let here = navPath st

  match Path.parent here with
  | Some parentPath ->
    let sibs =
      nodePaths st.root
      |> Stdlib.List.filter (fun p -> (Path.parent p) == (Stdlib.Option.Option.Some parentPath))

    let idx =
      sibs
      |> Stdlib.List.indexedMap (fun i p -> (i, p))
      |> Stdlib.List.findFirst (fun ip ->
        let (_, p) = ip
        p == here)
      |> Stdlib.Option.map (fun ip ->
        let (i, _) = ip
        i)

    (match idx with
     | Some i ->
       (match Stdlib.List.getAt sibs (i + delta) with
        | Some p -> { st with caret = navCaretFor st.root p }
        | None -> st)
     | None -> st)
  | None -> st

let navParent (st: State) : State =
  match tableColumnTarget st (-1) with
  | Some p -> { st with caret = navCaretFor st.root p }
  | None ->
  let here = navPath st
  // Keep an existing descent when it is still below where we are, so climbing several levels remembers
  // the DEEPEST point rather than overwriting it with each step out.
  let remembered =
    match st.descent with
    | Some d ->
      if (Path.isPrefixOf here d) && ((Stdlib.List.length d) > (Stdlib.List.length here)) then
        st.descent
      else
        Stdlib.Option.Option.Some here
    | None -> Stdlib.Option.Option.Some here

  match Path.parent here with
  | Some p -> { st with caret = navCaretFor st.root p; descent = remembered }
  | None -> st

let navChild (st: State) : State =
  match tableColumnTarget st 1 with
  | Some p -> { st with caret = navCaretFor st.root p }
  | None ->
  let here = navPath st
  // Back down the way we came, when `h` left a trail that still fits: one level along it, so repeated
  // `l` retraces a repeated `h` exactly.
  let remembered =
    match st.descent with
    | Some d ->
      if (Path.isPrefixOf here d) && ((Stdlib.List.length d) > (Stdlib.List.length here)) then
        Stdlib.Option.Option.Some(Stdlib.List.take d ((Stdlib.List.length here) + 1))
      else
        Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

  let firstChild =
    nodePaths st.root
    |> Stdlib.List.findFirst (fun p ->
      (Stdlib.List.length p) == ((Stdlib.List.length here) + 1) && Path.isPrefixOf here p)

  match (match remembered with
         | Some d -> Stdlib.Option.Option.Some d
         | None -> firstChild) with
  | Some p -> { st with caret = navCaretFor st.root p }
  | None -> st

/// Enter INSERT at the first editable part of the current node.
let enterInsert (st: State) : State =
  let here = navPath st
  match slotAtPath st.root here with
  | Some(Filled n) -> { st with mode = Mode.Insert; caret = firstEditable here n }
  | Some _ -> { st with mode = Mode.Insert; caret = navCaretFor st.root here }
  | None -> st

/// Expect for a slot we are about to clear: what the parent said, or the kind that was there.
/// A readable name for a type of node: "expression", "type", "pattern", else the last name segment.
let friendlyType (k: Kind) : String =
  match k.typ with
  | Prim p -> p
  | Named name ->
    let last = Stdlib.String.split name "." |> Stdlib.List.last |> Stdlib.Option.withDefault name
    if last == "Expr" then "expression"
    elif last == "TypeReference" then "type"
    elif last == "MatchPattern" then "pattern"
    elif last == "LetPattern" then "pattern"
    elif last == "PipeExpr" then "pipe step"
    else last

let expectForSlot (st: State) (path: Path) : Expect =
  match slotAtPath st.root path with
  | Some s ->
    match Slot.expect s with
    | Some e -> e
    | None ->
      let fromParent =
        match Path.parent path with
        | Some pp ->
          match Path.last path with
          | Some(Item(slot, _)) ->
            nodeAtPath st.root pp
            |> Stdlib.Option.andThen (fun n -> Node.itemExpect n slot)
          // What a FILLED slot expects is nowhere on the node: the Expect lived on the Empty that got
          // replaced. The spec still has it, because its template is the same node with every slot empty,
          // so the declared label survives being typed into. The fallback below is the slot's NAME, which
          // is close enough to look right and is not the same thing -- a let's binder is the slot `pat`
          // and the hole says `⟨name⟩`.
          | Some(Into slot) ->
            nodeAtPath st.root pp
            |> Stdlib.Option.andThen (fun n -> Registry.find st.reg n.kind)
            |> Stdlib.Option.andThen (fun spec -> Node.slot spec.empty slot)
            |> Stdlib.Option.andThen (fun sl -> Slot.expect sl)
          | _ -> Stdlib.Option.Option.None
        | None -> Stdlib.Option.Option.None
      match fromParent with
      | Some e -> e
      | None ->
        match s with
        | Filled n ->
          // The TYPE, not the specific case, so a change can become anything of that type -- not another
          // node of the same constructor.
          let typeLevel = Kind { typ = n.kind.typ; case = Stdlib.Option.Option.None }
          let label =
            match Path.last path with
            | Some(Into slot) -> slot
            | Some(Item(slot, _)) -> slot
            | None -> friendlyType n.kind
          Expect.ofKind typeLevel label
        | _ -> Expect.any "?"
  | None -> Expect.any "?"

/// Change the current node: clear it to a hole of the same expectation and drop into INSERT with the
/// menu open, so you immediately retype or pick a different kind. Undo restores the old node. This is the
/// general "make this something else" move; it works on any node -- an expression, a type, a pattern.
let changeNode (st: State) : State =
  let here = navPath st
  match slotAtPath st.root here with
  | Some(Filled _) ->
    let e = expectForSlot st here
    let st1 = commit st [ Edit.Replace(here, Slot.Empty e) ] st.caret
    { st1 with mode = Mode.Insert; caret = navCaretFor st1.root here }
  | Some(Partial(_, _)) -> { st with mode = Mode.Insert }
  | _ -> st

/// Clear the current node back to a hole.
let clearNode (st: State) : State =
  let paths = selectedPaths st
  if (Stdlib.List.length paths) > 1 then
    // A RANGE clears to one hole rather than several. Three statements selected and deleted leaves the
    // place they were, not three empty places: an empty slot is something still to fill, and a range
    // delete is not a request for three of those. The first item becomes the hole and the rest are
    // removed, highest index first so the earlier removals do not shift the later ones.
    match (Stdlib.List.head paths, enclosingListItem st.caret) with
    | (Some firstPath, Some _) ->
      let e = expectForSlot st firstPath
      let removals =
        paths
        |> Stdlib.List.tail
        |> Stdlib.Option.withDefault []
        |> Stdlib.List.reverse
        |> Stdlib.List.filterMap (fun p ->
          match (Path.parent p, Path.last p) with
          | (Some par, Some(Item(slot, i))) -> Stdlib.Option.Option.Some(Edit.RemoveItem(par, slot, i))
          | _ -> Stdlib.Option.Option.None)
      let st1 =
        commit
          st
          (Stdlib.List.append [ Edit.Replace(firstPath, Slot.Empty e) ] removals)
          (navCaretFor st.root firstPath)
      { st1 with
          caret = navCaretFor st1.root firstPath
          anchor = Stdlib.Option.Option.None
          message = "cleared " ++ (Stdlib.Int.toString (Stdlib.List.length paths)) ++ " nodes" }
    | _ -> { st with message = "nothing to clear" }
  else
  let here = navPath st
  match slotAtPath st.root here with
  | Some(Filled _) ->
    let e = expectForSlot st here
    let st1 = commit st [ Edit.Replace(here, Slot.Empty e) ] (navCaretFor st.root here)
    { st1 with caret = navCaretFor st1.root here }
  | Some(Partial(_, was)) ->
    let st1 = commit st [ Edit.Replace(here, was) ] st.caret
    { st1 with caret = navCaretFor st1.root here }
  | _ -> st

/// Move the thing under the caret one place along the sequence it sits in. `(1, 2)` with the caret on the
/// `2` and Ctrl-Left is `(2, 1)`, with the caret still on the `2`.
///
/// Both axes, bound to the same move: Ctrl-Left and Ctrl-Up go towards the start, Ctrl-Right and
/// Ctrl-Down towards the end. A sequence is drawn along ONE of the two axes and which one is the spec's
/// choice, not the kernel's -- a tuple's items sit side by side and a grid's rows sit stacked, and
/// reaching for the horizontal gesture on a table reads as wrong even when it works. Rather than have
/// the kernel ask the layout which way a particular list runs, both gestures do the same thing, so
/// whichever you reach for is the one that works.
///
/// A structural move rather than a cut and a paste: the node keeps its children, its holes and whatever
/// was half-typed inside it, and undo puts it back in one step. This is the edit a projectional editor
/// should be best at and a text editor is worst at -- swapping two arguments in text means selecting
/// exactly the right span twice and getting the commas right afterwards.
///
/// Asked of the caret, not of any kind, so it works on every sequence the language draws: a tuple's
/// items, a call's arguments, a list, a match's arms, a record's fields, the statements of a block, the
/// stages of a pipe. A DSL's own Many gets it without saying anything.
///
/// It does NOT reach a binary operator's two operands, which are `One` slots rather than a list. The spec
/// says which they are (`operands`, used by the `(`/`)` rotations), so that is a small addition; it is
/// left out here because swapping them changes what the program means for every operator that is not
/// commutative, and that deserves its own decision rather than falling out of a key.
let moveSibling (st: State) (delta: Int) : State =
  match enclosingListItem st.caret with
  | Some entry ->
    let (parentPath, slot, i) = entry
    let j = i + delta

    match nodeAtPath st.root parentPath with
    | Some parent ->
      let items = Node.items parent slot

      // At either end, nothing happens and nothing is said. Running off the end of a list is the ordinary
      // way to find out where the end is, not a mistake to report.
      if (j < 0) || (j >= (Stdlib.List.length items)) then
        st
      else
        match (Stdlib.List.getAt items i, Stdlib.List.getAt items j) with
        | (Some here, Some there) ->
          let herePath = Path.item parentPath slot i
          let therePath = Path.item parentPath slot j
          let st1 = commit st [ Edit.Replace(herePath, there), Edit.Replace(therePath, here) ] st.caret
          // The caret follows what MOVED, which is what makes the key repeatable: hold it down and the
          // node walks along the list. Landing on the index instead would leave you looking at whatever
          // swapped into place behind you.
          let landed =
            match Slot.node here with
            | Some moved ->
              if st.mode == Mode.Nav then navCaretFor st1.root therePath else lastEditable therePath moved
            | None -> Caret.inItem parentPath slot j 0

          { st1 with caret = landed }
        | _ -> st
    | None -> st
  | None -> st


/// Copy the node under the caret into the clipboard (a whole subtree).
/// What the selection names, as nodes. Empty if any of them cannot be read.
let selectedNodes (st: State) : List<Node> =
  selectedPaths st |> Stdlib.List.filterMap (fun p -> nodeAtPath st.root p)

/// How to describe a yank or a cut: the node's own short name when there is one, a count when more.
let clipboardSummary (ns: List<Node>) : String =
  match ns with
  | [ n ] -> crumbName n
  | ns -> (Stdlib.Int.toString (Stdlib.List.length ns)) ++ " nodes"

/// Yank every node in the selection. One node is the ordinary case; a range takes the whole run.
let yankNode (st: State) : State =
  match selectedNodes st with
  | [] -> { st with message = "nothing to yank" }
  | ns ->
    { st with
        clipboard = ns
        anchor = Stdlib.Option.Option.None
        message = "yanked " ++ (clipboardSummary ns) }

/// Put the clipboard node into the slot under the caret (a hole, a partial, or over a node).
///
/// REFUSED when the slot wants a different kind of thing. Put replaced whatever was there without asking,
/// so yanking a string and putting it on a pipe STEP gave `|> ""` -- a pipe step that is a string
/// literal, which is not a shape the language has. An editor whose whole promise is that you cannot build
/// something ill-formed by editing has to check this, and it is the same test a hole applies to a
/// candidate: by kind TYPE, so any case of the right thing fits.
/// Several nodes go in as SIBLINGS, which is the only reading that preserves what was cut: a run of
/// statements put back is a run of statements. So the first replaces what is under the caret and the
/// rest are inserted after it, which needs the caret to be in a list. Putting three nodes onto a
/// single slot has no meaning and says so rather than silently taking the first.
let putNode (st: State) : State =
  match st.clipboard with
  | [] -> { st with message = "clipboard is empty" }
  | first :: rest ->
    let here = navPath st
    let e = expectForSlot st here

    let fits =
      match e.kind with
      | Some k -> Kind.sameType first.kind k
      | None -> true

    if Stdlib.Bool.not fits then
      { st with message = "can't put " ++ (crumbName first) ++ " into " ++ e.label }
    elif Stdlib.List.isEmpty rest then
      let st1 = commit st [ Edit.Replace(here, Slot.Filled first) ] st.caret
      { st1 with caret = navCaretFor st1.root here; message = "put " ++ (crumbName first) }
    else
      match enclosingListItem st.caret with
      | None ->
        { st with
            message =
              "can't put " ++ (Stdlib.Int.toString (Stdlib.List.length st.clipboard))
              ++ " nodes here: " ++ e.label ++ " takes one" }
      | Some entry ->
        let (parentPath, slot, i) = entry
        let inserts =
          rest
          |> Stdlib.List.indexedMap (fun k n -> Edit.InsertItem(parentPath, slot, i + k + 1, Slot.Filled n))
        let st1 = commit st (Stdlib.List.append [ Edit.Replace(here, Slot.Filled first) ] inserts) st.caret
        { st1 with
            caret = navCaretFor st1.root here
            message = "put " ++ (clipboardSummary st.clipboard) }


// --- INSERT: typing ---

/// The language's punctuation comes from the REGISTRY now, not from a list in here, so someone spelling
/// their own syntax can say what an operator is without editing the kernel.
let isOperatorChar (syn: Syntax) (c: String) : Bool = Stdlib.List.member syn.operatorChars c

let charClassMatches (syn: Syntax) (onChar: String) (c: String) : Bool =
  if onChar == c then true
  elif onChar == "<digit>" then TextEdit.isDigitString c
  elif onChar == "<letter>" then TextEdit.isLetterString c
  elif onChar == "<identifier>" then isIdentifierChar c
  // A qualified name carries its modules: `Stdlib.printLine` is ONE name, and the dots are part of it.
  elif onChar == "<qualifiedName>" then (isIdentifierChar c) || (c == ".")
  elif onChar == "<nameStart>" then (TextEdit.isLetterString c) || (c == "_")
  // A pattern splits on case the way the language does: `ok` binds, `Ok` names a constructor. The
  // lowercase half can go straight to a variable; the uppercase half has to stay a partial long enough
  // for completion to offer the case and its fields.
  elif onChar == "<lowerStart>" then
    ((TextEdit.isLetterString c) && ((Stdlib.String.toLowercase c) == c)) || (c == "_")
  // A number may open with a sign and may not carry one anywhere else, which is the same shape a name
  // has: a first character with its own class.
  elif onChar == "<numberStart>" then (TextEdit.isDigitString c) || (c == "-")
  // A number's REST: its digits, plus the `u`/`U` that marks a width suffix unsigned. Darklang's suffixes
  // are one or two characters (`y`, `uy`, `L`, `UL`, ...) and a wrap rule fires on one, so the marker is
  // carried as ordinary text and the final character looks back at it. A marker with no suffix after it
  // is dropped when the number settles: it was never part of the value.
  elif onChar == "<intSuffixChar>" then
    (TextEdit.isDigitString c) || (c == "u") || (c == "U")
  elif onChar == "<operator>" then isOperatorChar syn c
  // Enter is not a character anyone types into text, but it IS a thing a spec should be able to claim:
  // in Darklang a newline after a finished expression starts the next statement. Named like the other
  // classes so the rule stays in the spec rather than in the kernel.
  elif onChar == "<newline>" then c == "\n"
  else false

let ruleMatches (syn: Syntax) (rule: HoleRule) (c: String) : Bool = charClassMatches syn rule.onChar c

/// Apply a wrap rule to the node the caret is on -- or the one precedence picks, so `1 * 2 + 3`
/// associates as `(1 * 2) + 3` and `1 * 2` then `|>` pipes the product rather than the `2`.
///
/// Two different climbs, because there are two kinds of wrapping construct. An infix has a power and
/// walks up the right spine past whatever binds tighter. A construct that SWALLOWS what follows it (a
/// pipe, a statement) binds looser than every operator there is, so it takes the whole expression that
/// ends at the caret, which is what `statementTarget` already worked out for Enter.
///
/// Asking the rule what it builds, rather than naming the pipe here, is the point: a DSL that adds its
/// own swallowing construct gets the same reach without the kernel hearing about it.
let applyWrap (st: State) (caret: Caret) (n: Node) (rule: WrapRule) (c: String) : State =
  let targetPath =
    if rule.opSlot == "op" then
      reassocTarget st.reg st.root caret.node c
    else if (Project.nodePower (rule.wrap n c)) == Darklang.LanguageTools.Precedence.swallowingPower then
      statementTarget st caret.node
    else
      caret.node
  let target = nodeAtPath st.root targetPath |> Stdlib.Option.withDefault n
  let wrapped = rule.wrap target c
  let st1 = commit st [ Edit.Replace(targetPath, Slot.Filled wrapped) ] caret

  if rule.opSlot == "" then
    { st1 with caret = landAfterCommit targetPath wrapped }
  else
    let opLen = Node.text wrapped rule.opSlot |> Stdlib.Option.withDefault "" |> Stdlib.String.length
    { st1 with caret = Caret.inText targetPath rule.opSlot opLen }

/// The wrap rule for typing `c` at the end of node `n`: the KIND's own rules first, then the type's.
///
/// Only the type had them before, so a character could mean exactly one thing across a whole language.
/// That is fine for `.` and for an operator, which do mean one thing wherever they appear, and wrong for
/// anything that depends on what it is typed after: `L` makes an integer an Int64 and means nothing at
/// all on a lambda. It is the first wall a DSL hits for the same reason.
let wrapRuleFor (reg: Registry) (n: Node) (c: String) : Stdlib.Option.Option<WrapRule> =
  let own =
    match Registry.findExact reg n.kind with
    | Some spec -> spec.wrapRules |> Stdlib.List.findFirst (fun r -> charClassMatches reg.syntax r.onChar c)
    | None -> Stdlib.Option.Option.None

  match own with
  | Some r -> Stdlib.Option.Option.Some r
  | None ->
    (match Registry.findTypeLevel reg n.kind with
     | Some spec -> spec.wrapRules |> Stdlib.List.findFirst (fun r -> charClassMatches reg.syntax r.onChar c)
     | None -> Stdlib.Option.Option.None)

/// The wrap rule a spec carries under a given NAME, rather than the one a character matches. Some rules
/// are triggered by a position rather than a keystroke -- `<apply>` fires where a name follows a finished
/// value -- and `charClassMatches` turns their names away, so they are unreachable through `wrapRuleFor`
/// and reachable here. Same shape as `landSettled` asking whether a spec carries `<operator>`.
let wrapRuleNamed (reg: Registry) (n: Node) (name: String) : Stdlib.Option.Option<WrapRule> =
  let own =
    match Registry.findExact reg n.kind with
    | Some spec -> spec.wrapRules |> Stdlib.List.findFirst (fun r -> r.onChar == name)
    | None -> Stdlib.Option.Option.None

  match own with
  | Some r -> Stdlib.Option.Option.Some r
  | None ->
    (match Registry.findTypeLevel reg n.kind with
     | Some spec -> spec.wrapRules |> Stdlib.List.findFirst (fun r -> r.onChar == name)
     | None -> Stdlib.Option.Option.None)

/// The item slot that typing `c` OPENS on this node, when the spec claims the character and the list is
/// still empty.
///
/// Two places settle a name onto a node and both have to ask: typing at the end of a node that already
/// exists, and RESOLVING a partial into one. `| Delayed` typed into a case hole is text until something
/// commits it, so the space that should have opened the fields was spent on the commit and it took two
/// spaces to write `| Delayed of Int` -- where a record field, whose type hole is already drawn, takes
/// one. Same question, two answers, which is the shape nearly every bug here has had.
///
/// The spec says which character and which slot. What stays here is the part that is true of any
/// language: the list must be a Many, and it must be EMPTY, because after that the character means
/// whatever it means next to a filled list.
let opensItemSlot (reg: Registry) (n: Node) (c: String) : Stdlib.Option.Option<String> =
  match Registry.find reg n.kind with
  | Some spec ->
    spec.opensItems
    |> Stdlib.List.findFirst (fun pair ->
      let (onChar, itemSlot) = pair
      (onChar == c)
      && (Stdlib.List.isEmpty (Node.items n itemSlot))
      && (Stdlib.Option.isSome (Node.itemExpect n itemSlot)))
    |> Stdlib.Option.map (fun pair ->
      let (_onChar, itemSlot) = pair
      itemSlot)
  | None -> Stdlib.Option.Option.None

/// Is the caret in the operator slot of a node made by a wrap rule?
let inOpSlot (reg: Registry) (n: Node) (slot: String) : Stdlib.Option.Option<WrapRule> =
  match Registry.findTypeLevel reg n.kind with
  | Some spec -> spec.wrapRules |> Stdlib.List.findFirst (fun r -> r.opSlot == slot)
  | None -> Stdlib.Option.Option.None

/// What typing `c` into a hole with expectation `e` creates, if a spec says: the node, and whether the
/// caret goes after the typed character (true) or to the node's first editable part (false).
let holeFill (reg: Registry) (e: Expect) (c: String) : Stdlib.Option.Option<(Node * Bool)> =
  match Registry.forExpect reg e with
  | Some spec ->
    spec.holeRules
    |> Stdlib.List.findFirst (fun r -> ruleMatches reg.syntax r c)
    |> Stdlib.Option.map (fun r ->
      match r.fill with
      | Node n -> (n, false)
      | WithChar f -> (f c e, true))
  | None -> Stdlib.Option.Option.None

/// The nearest enclosing tuple that holds exactly ONE thing, with the caret inside that thing.
///
/// `(` opens a tuple, so a `)` has to be able to say "that was a grouping paren" -- Darklang has no
/// one-tuples, and `(1 + 2)` and `(fun x -> ...)` are both how the PRINTER writes things. Typing them
/// back gave `(1 + 2, <item>)`.
///
/// It climbs, because the tuple is an ANCESTOR by then: `(` leaves the caret on the empty item and the
/// first character sends it down into whatever that built. `emptyTupleToUnit` can read the caret's own
/// node only because nothing has been typed there yet.
///
/// The caret has to be in the FILLED item, which is what separates `(1 + 2` then `)` from `(1, ` then
/// `)`. In the second the comma was deliberate and the caret sits in the empty item: a tuple with a hole
/// left in it, not a group.
/// The slots this node's spec calls its operands, if it is a binary operator.
///
/// `isInfix` was four hand-written copies of `kind.case == Some "EInfix"`, in the two functions that
/// reassociate by precedence and the two that rotate on request. Precedence itself is already spec data;
/// this is the other half, which slots swap.
let operandsOf (reg: Registry) (n: Node) : Stdlib.Option.Option<Operands> =
  match Registry.find reg n.kind with
  | Some spec -> spec.operands
  | None -> Stdlib.Option.Option.None

let isBinary (reg: Registry) (n: Node) : Bool = Stdlib.Option.isSome (operandsOf reg n)

/// The `(trigger, survivor)` pair this node's spec declares for a collapse-on-empty, if it has one.
let emptiedCollapseOf (reg: Registry) (n: Node) : Stdlib.Option.Option<(String * String)> =
  match Registry.find reg n.kind with
  | Some spec -> spec.collapsesWhenEmptied
  | None -> Stdlib.Option.Option.None

/// The closing behaviour this node's spec declares, if it has one. See `Spec.Closer`.
///
/// Three questions used to be answered here by naming kinds: `)` in an untouched tuple is `()`, `]` in an
/// untouched list is `[]`, and `)` in a tuple holding one filled item is a GROUPING paren. They are one
/// thing, and the spec says which character, which slot, what an empty one becomes, and whether a
/// one-item form is spelled like a grouping.
let closerOf (reg: Registry) (n: Node) : Stdlib.Option.Option<Closer> =
  match Registry.find reg n.kind with
  | Some spec -> spec.closer
  | None -> Stdlib.Option.Option.None

/// Does the container AT `path` hold exactly one thing, with item `i` being it, and is its one-item form
/// a grouping rather than a container? A list is exempt: `[x]` is a perfectly good list.
let soloTupleHere (st: State) (path: Path) (slot: String) (i: Int) : Bool =
  match nodeAtPath st.root path with
  | Some n ->
    let isTuple =
      match closerOf st.reg n with
      | Some cl -> cl.soloIsGroup && (slot == cl.slot)
      | None -> false
    let items = Node.items n "items"
    let filled = items |> Stdlib.List.filter (fun sl -> Stdlib.Bool.not (Slot.isEmpty sl))
    let caretItemFilled =
      match Stdlib.List.getAt items i with
      | Some sl -> Stdlib.Bool.not (Slot.isEmpty sl)
      | None -> false

    isTuple && (slot == "items") && caretItemFilled && ((Stdlib.List.length filled) == 1)
  | None -> false

let soloTupleAncestor (st: State) (from: Path) : Stdlib.Option.Option<Path> =
  match Path.parent from with
  | None -> Stdlib.Option.Option.None
  | Some parent ->
    match (Path.last from, nodeAtPath st.root parent) with
    | (Some(Item(slot, i)), Some pn) ->
      let isTuple =
        match closerOf st.reg pn with
        | Some cl -> cl.soloIsGroup && (slot == cl.slot)
        | None -> false

      let items = Node.items pn "items"
      let filled = items |> Stdlib.List.filter (fun sl -> Stdlib.Bool.not (Slot.isEmpty sl))
      let caretItemFilled =
        match Stdlib.List.getAt items i with
        | Some sl -> Stdlib.Bool.not (Slot.isEmpty sl)
        | None -> false

      // Stop at the first ancestor that IS a tuple, whether or not it turns out to be solo.
      //
      // The climb exists because the caret is usually not standing on the tuple: after `(1 + 2` it is
      // inside the EInfix, so non-tuple ancestors have to be walked through. It was walking through
      // TUPLES too, and that is a different thing. Closing the inner bracket of `((1, 2), 3)` found the
      // inner tuple holding two items, decided it was not the one, and carried on to the outer, which
      // held exactly one filled item (the inner tuple) and so looked solo. The `)` typed for the inner
      // bracket collapsed the outer one, and `((1, 2), 3)` came out `(1, 2)`.
      //
      // `(1, (2, 3))` always worked, which is the tell: by the time the inner closes there, the outer
      // already holds two filled items and never looks solo. The bug needed a tuple nested as the FIRST
      // item, closed before the later items exist. Patterns had it too, via `MPTuple`.
      if isTuple && (slot == "items") then
        if caretItemFilled && ((Stdlib.List.length filled) == 1) then
          Stdlib.Option.Option.Some parent
        else
          Stdlib.Option.Option.None
      else
        soloTupleAncestor st parent
    | _ -> soloTupleAncestor st parent

/// Re-associate an infix whose operator has just GROWN, and return where its op slot now lives.
///
/// An operator is typed one character at a time, and the wrap that placed it happened on the FIRST one.
/// `&&` starts as `&`, which `infixPowerOfText` scores as the default 5 rather than the 2 that `&&`
/// actually has, so it did not climb past the `==` next to it and `a == b && c` came out as
/// `a == (b && c)`. Same for `||`.
///
/// Deciding again once the operator is complete means rotating rather than re-wrapping, because the tree
/// already exists: `a == (b && r)` becomes `(a == b) && r`. Standard left rotation, repeated while the
/// parent still binds at least as tightly, which is the same test `reassocTarget` makes on the way in.
let reassocGrown (st: State) (opPath: Path) : (State * Path) =
  match (Path.parent opPath, nodeAtPath st.root opPath) with
  | (Some parentPath, Some n) ->
    (match (Path.last opPath, nodeAtPath st.root parentPath) with
     | (Some(Into step), Some pn) ->
       // Slot names off the spec. All three rotations used to spell `left`, `right` and `op` here, so a
       // DSL declaring its own binary construct got the precedence machinery only if it happened to name
       // its slots the way Darklang names them.
       (match (operandsOf st.reg n, operandsOf st.reg pn) with
        | (Some ops, Some pOps) when step == pOps.right ->
         let (newPow, newRight) = Project.infixPowerOf (Node.text n ops.op |> Stdlib.Option.withDefault "+")
         let (pPow, _) = Project.infixPowerOf (Node.text pn pOps.op |> Stdlib.Option.withDefault "+")
         let climb = if newRight then pPow > newPow else pPow >= newPow

         (match Node.slot n ops.left with
         | Some myLeft ->
           if climb then
             // The parent keeps everything to ITS left and adopts our left as its right; we take the
             // parent as our own left. Nothing else in the document moves.
             let newLeft = Node.setField pn pOps.right (Field.One myLeft)
             let rotated = Node.setField n ops.left (Field.One(Slot.Filled newLeft))
             let st1 = commit st [ Edit.Replace(parentPath, Slot.Filled rotated) ] st.caret
             reassocGrown st1 parentPath
           else
             (st, opPath)
         | _ -> (st, opPath))
        | _ -> (st, opPath))
     | _ -> (st, opPath))
  | _ -> (st, opPath)

/// Where to leave the caret after settling a node in slot `sp`, with nothing left unfilled in it.
///
/// Landing AFTER the node is for the case where the next keystroke says what you meant: an operator
/// wraps what you just settled, so `if total <space> > 0` works. Somewhere an operator cannot follow,
/// that landing has no purpose and the next character went missing instead -- `| None ` left the caret
/// nowhere useful and ate the `1` after it.
///
/// So ask the SPEC rather than naming the types here: a type whose wrap rules include `<operator>` can
/// be wrapped by what follows and is worth waiting on. One without cannot, and the next thing really is
/// the next hole.
/// A settle that landed the caret in a fresh hole has already moved you. That hole IS the next one, and
/// moving again skips the thing you just made.
///
/// `commitCandidate` has carried this rule in both of its branches for a while, with the comment
/// "Committing a construct or a function lands in its own first hole to fill, so it stays there" written
/// above one of them. The `resolve` path never got it, three lines below, and nothing showed -- because a
/// freshly resolved node has no hole AFTER it to overshoot into, which `landSettled`'s own comment says.
///
/// `Size { width = { r with x =` supplies one. The `=` settled the field, the settle put the caret in the
/// new `⟨value⟩`, the key moved again, and the `1` went into the OUTER record's `height`.
/// Is the caret sitting on something still to be filled?
///
/// An empty SLOT, or an empty TEXT field. `landAfterCommit` has always counted both -- "`blanks`, not
/// `holes`: an empty TEXT field is the next thing to type too" -- and the stay-here checks counted only
/// the first. So committing a construct whose first blank is a TEXT slot landed you in it and then moved
/// on anyway: picking `int` in a match pattern built the empty pattern and then started the next ARM.
let onABlankNow (st: State) : Bool =
  match slotUnder st with
  | Some(Empty _) -> true
  | _ ->
    match st.caret.part with
    | InText slot ->
      (match nodeAtPath st.root st.caret.node with
       | Some n -> (Node.text n slot |> Stdlib.Option.withDefault "") == ""
       | None -> false)
    | _ -> false

/// Is the caret in a hole that INTRODUCES a name?
///
/// Asked of the expectation rather than of the node, because the hole is empty: what it will hold is all
/// there is to go on.
let inBindingPosition (st: State) : Bool =
  match Caret.slotPath st.caret with
  | Some sp ->
    (match slotAtPath st.root sp with
     | Some s ->
       (match Slot.expect s with
        | Some e ->
          (match Registry.forExpect st.reg e with
           | Some spec -> spec.bindsNames
           | None -> false)
        | None -> false)
     | None -> false)
  | None -> false

let stayIfOnHole (st: State) (move: State -> State) : State =
  if onABlankNow st then st else move st

let landSettled (st: State) (sp: Path) : State =
  // Any type-level rule that fires from AFTER the node, not just the one named `<operator>`.
  //
  // The question is "could the next character wrap what was just settled", and `continuesText = false`
  // is precisely how a rule says it acts on a finished node rather than on its text. Naming `<operator>`
  // answered a narrower question that happens to coincide in expressions, where the operator rule is
  // always there, and does not in PATTERNS, where `::` and `|` are wrap rules under their own names. So
  // a space after a pattern walked out to the right-hand side and `| h :: t ->` could not be typed with
  // the spaces the printer writes: `h::t` worked, `h :: t` gave `| h -> ::t`.
  let canBeWrappedAfter =
    match nodeAtPath st.root sp with
    | Some n ->
      (match Registry.findTypeLevel st.reg n.kind with
       | Some spec -> spec.wrapRules |> Stdlib.List.any (fun r -> Stdlib.Bool.not r.continuesText)
       | None -> false)
    | None -> false

  // ...and a space-separated list is the other reason to wait: `fun a b` and `f x y` write the next item
  // with nothing but a space in front of it, so leaving the caret after the one just settled is what lets
  // the next letter grow the list. A call already worked this way (its args are drawn with a leading
  // space); a lambda's params did not, and `fun a b -> a + b` came out as `(fun a -> b -> a + b)` because
  // the space walked out of the params and into the body.
  // ...and a node that can be APPLIED is the third reason to wait. An argument could follow, which is the
  // same thing the operator case says: leaving would abandon what the next key is about to attach to.
  //
  // A pipe step is where that showed. `EVariable` carries an `<operator>` rule, so the caret lands after
  // it and the apply rule can reach it; `EPipeVariable` carries none, so `landSettled` fell to `nextHole`,
  // a freshly resolved one has no holes to find, and `xs |> zork 1` put the digit in the NAME: `zork1`.
  let canBeApplied =
    match nodeAtPath st.root sp with
    | Some n -> Stdlib.Option.isSome (wrapRuleNamed st.reg n "<apply>")
    | None -> false

  if canBeWrappedAfter || canBeApplied || (inSpaceSepList st sp) then
    { st with caret = Caret.afterNode sp }
  else
    nextHole st

/// The keyword the editor already drew, typed back into the slot it drew you into. `match n with` writes
/// the `with` for you and lands the caret in the first arm's PATTERN, so typing `with` there is the same
/// reflex that re-types a drawn `=` or a drawn `then`. Put the hole back and stay in it.
///
/// Reads the NODE's text rather than a partial's: a pattern hole becomes a node the moment you press a
/// letter, so there is no partial left to throw away by the time anyone asks.
///
/// Shared, because space and Enter both need it and only space had it -- `match n with <space>` was right
/// and `match n with <Enter>` built a first arm whose pattern was the literal keyword.
let clearsDrawnKeyword (st: State) : Stdlib.Option.Option<State> =
  match st.caret.part with
  | InText slot ->
    if (slot == "body") || (slot == "text") then
      Stdlib.Option.Option.None
    else
      (match nodeAtPath st.root st.caret.node with
       | Some n ->
         let old = Node.text n slot |> Stdlib.Option.withDefault ""
         if (old != "")
            && (st.caret.offset >= (Stdlib.String.length old))
            && ((prevKeyword st) == Stdlib.Option.Option.Some old) then
           let e = Expect.ofKind (Kind.named (Kind.typeName n.kind)) "pattern"
           let st1 = commit st [ Edit.Replace(st.caret.node, Slot.Empty e) ] st.caret
           Stdlib.Option.Option.Some { st1 with caret = navCaretFor st1.root st.caret.node; mode = Mode.Insert }
         else
           Stdlib.Option.Option.None
       | None -> Stdlib.Option.Option.None)
  // ...and the other half of the same question. A PATTERN hole becomes a node the moment you press a
  // letter, which is the case above; an EXPRESSION hole stays a partial, and that is this one. `if` draws
  // its own `then`, and typing the one you can see left `Partial "then"` in the branch -- which Enter
  // then handed to the menu, whose best fuzzy match for `then` is `andThen`. `if a then` and Enter built
  // `if a then Stdlib.Result.andThen ⟨result⟩ ⟨fn⟩ else ⟨else⟩`.
  //
  // Space already had this, written out separately in the partial-typing path; it now calls here so the
  // two holes get one answer instead of one each. Restores the slot's own `was` rather than a rebuilt
  // expectation, which is what that path always did and is the better of the two.
  //
  // An ITEM asks it too. A partial in a list item was falling through to the catch-all, so the rule held
  // for a hole and not for the same hole one comma over -- and an enum case's fields ARE items, so
  // `| Delayed of Int`, typed the way the source spells it, kept the `of` and came out
  // `| Delayed of ofInt`. `Caret.slotPath` already answers for both; only the match arm was missing.
  | InSlot _ -> clearsPartialKeyword st
  | InItem(_, _) -> clearsPartialKeyword st
  | _ -> Stdlib.Option.Option.None

/// The half of `clearsDrawnKeyword` that works on a PARTIAL, whichever kind of slot holds it.
let clearsPartialKeyword (st: State) : Stdlib.Option.Option<State> =
  match Caret.slotPath st.caret with
  | Some sp ->
    (match slotAtPath st.root sp with
     | Some(Partial(typed, was)) ->
       if (typed != "")
          && (st.caret.offset >= (Stdlib.String.length typed))
          && ((prevKeyword st) == Stdlib.Option.Option.Some typed) then
         let st1 = commit st [ Edit.Replace(sp, was) ] st.caret
         Stdlib.Option.Option.Some { st1 with caret = { st.caret with offset = 0 } }
       else
         Stdlib.Option.Option.None
     | _ -> Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None

/// Type one grapheme. A paste (many graphemes at once) is decomposed by `typeChar` into a sequence of
/// these, so a rule keyed on the first character still fires and the rest follow.
/// The glyph rendered immediately to the right of the caret, if any. Used to skip past a closing
/// delimiter you re-type: the layout draws `]`/`)`/`}`/`"` as punctuation, so this reads it back.
let glyphAfterCaretIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    match Stdlib.List.getAt rows row with
    | Some r ->
      Layout.rowText r
      |> Stdlib.String.toList
      |> Stdlib.List.getAt col
      |> Stdlib.Option.map (fun ch -> Stdlib.Char.toString ch)
    | None -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None


let glyphAfterCaret (st: State) : Stdlib.Option.Option<String> = glyphAfterCaretIn (layout st) st
/// The first non-space glyph drawn to the right of the caret on its row, if any. Used to skip past a
/// separator you re-type (the `=` between a let's name and value, a record/annotation `:`).
let nextNonSpaceGlyphIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    match Stdlib.List.getAt rows row with
    | Some r ->
      Layout.rowText r
      |> Stdlib.String.toList
      |> Stdlib.List.drop col
      |> Stdlib.List.map (fun ch -> Stdlib.Char.toString ch)
      |> Stdlib.List.filter (fun g -> g != " ")
      |> Stdlib.List.head
    | None -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None


let nextNonSpaceGlyph (st: State) : Stdlib.Option.Option<String> = nextNonSpaceGlyphIn (layout st) st

/// The punctuation drawn immediately ahead of the caret, if the next thing drawn IS punctuation. The
/// mirror of `prevPunctIn`, and like it, the whole token: the `->` of a lambda comes back as `->`, not
/// as `-`. Multi-character punctuation is the point -- typing its first character is how you say you
/// meant the one already drawn.
let nextPunctIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    let mine (c: Layout.Cell) : Bool =
      match c.tag with
      | Some t -> Layout.tagMatches t st.caret.node st.caret.part
      | None -> false
    let firstOfRow (r: Layout.Row) (from: Int) : Stdlib.Option.Option<Layout.Cell> =
      let step (acc: (Int * Stdlib.Option.Option<Layout.Cell>)) (c: Layout.Cell) : (Int * Stdlib.Option.Option<Layout.Cell>) =
        let (x, best) = acc
        let ends = x + c.width
        if (Stdlib.Option.isSome best) || (x < from) then (ends, best)
        elif ((Stdlib.String.trim c.text) == "") || (mine c) then (ends, best)
        else (ends, Stdlib.Option.Option.Some c)
      let (_, cell) = Stdlib.List.fold r (0, Stdlib.Option.Option.None) step
      cell
    (match Stdlib.List.getAt rows row with
     | Some r -> firstOfRow r col
     | None -> Stdlib.Option.Option.None)
    |> Stdlib.Option.andThen (fun c ->
      if c.style == Layout.Style.Punct then Stdlib.Option.Option.Some(Stdlib.String.trim c.text)
      else Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None

/// The first non-space glyph drawn to the LEFT of the caret on its row, if any. The mirror of
/// `nextNonSpaceGlyph`, for a separator you type after the editor has already drawn it AND moved you past
/// it: in `let x = 1`, typing the `=` once the caret is in the value hole.
let prevNonSpaceGlyphIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    match Stdlib.List.getAt rows row with
    | Some r ->
      Layout.rowText r
      |> Stdlib.String.toList
      |> Stdlib.List.take col
      |> Stdlib.List.map (fun ch -> Stdlib.Char.toString ch)
      |> Stdlib.List.filter (fun g -> g != " ")
      |> Stdlib.List.last
    | None -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None


let prevNonSpaceGlyph (st: State) : Stdlib.Option.Option<String> = prevNonSpaceGlyphIn (layout st) st
/// The cell drawn immediately before the caret, ignoring blanks, punctuation and the caret's own text.
/// Cells carry their style, so callers can ask what KIND of thing was drawn rather than guess from text.
let prevDrawnIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<Layout.Cell> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    // The last non-blank cell before the caret ANYWHERE above it, not just on its row: a construct puts
    // its keyword at the end of one line and the hole on the next (`if c then` / `  <then>`), which is
    // exactly the case this is for.
    // Cells belonging to the caret's OWN slot don't count: the text being typed sits between the keyword
    // and the caret, and it is the thing we are asking about.
    let mine (c: Layout.Cell) : Bool =
      match c.tag with
      | Some t -> Layout.tagMatches t st.caret.node st.caret.part
      | None -> false
    let lastOfRow (r: Layout.Row) (upto: Int) : Stdlib.Option.Option<Layout.Cell> =
      let step (acc: (Int * Stdlib.Option.Option<Layout.Cell>)) (c: Layout.Cell) : (Int * Stdlib.Option.Option<Layout.Cell>) =
        let (x, best) = acc
        let ends = x + c.width
        // Punctuation doesn't stop the search: a match arm draws `| ` between the `with` and the pattern
        // hole. A NAME does stop it, which is what keeps `Stdlib.List.map f f` from eating its second arg.
        if (ends <= upto)
           && ((Stdlib.String.trim c.text) != "")
           && (Stdlib.Bool.not (mine c))
           && (c.style != Layout.Style.Punct)
        then
          (ends, Stdlib.Option.Option.Some c)
        else (ends, best)
      let (_, cell) = Stdlib.List.fold r (0, Stdlib.Option.Option.None) step
      cell
    let onRow =
      match Stdlib.List.getAt rows row with
      | Some r -> lastOfRow r col
      | None -> Stdlib.Option.Option.None
    let cell =
      match onRow with
      | Some c -> Stdlib.Option.Option.Some c
      | None ->
        Stdlib.List.range 0 (row - 1)
        |> Stdlib.List.reverse
        |> Stdlib.List.filterMap (fun i ->
          match Stdlib.List.getAt rows i with
          | Some r -> lastOfRow r 100000
          | None -> Stdlib.Option.Option.None)
        |> Stdlib.List.head
    cell
  | None -> Stdlib.Option.Option.None


let prevDrawn (st: State) : Stdlib.Option.Option<Layout.Cell> = prevDrawnIn (layout st) st
/// The keyword drawn immediately before the caret: `then` in `if c then <hole>`. A NAME never matches,
/// which is what keeps `Stdlib.List.map f f` from eating its second argument.
let prevKeywordIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  prevDrawnIn rows st
  |> Stdlib.Option.andThen (fun c ->
    if c.style == Layout.Style.Keyword then Stdlib.Option.Option.Some(Stdlib.String.trim c.text)
    else Stdlib.Option.Option.None)


let prevKeyword (st: State) : Stdlib.Option.Option<String> = prevKeywordIn (layout st) st

/// The next KEYWORD drawn after the caret, if the very next thing drawn is one.
///
/// The mirror of `prevKeyword`, and needed for the same reason from the other side. Typing a keyword the
/// editor has already drawn is swallowed when the caret can SEE it behind -- `match n with` lands you in
/// the pattern hole with `with` just before you. After a CALL it never gets there: an apply keeps taking
/// arguments, so `match Stdlib.List.length xs with` made `with` a third argument and drew `with with`.
///
/// Punctuation does not stop the scan (a match arm draws `| ` between the `with` and the hole) and blanks
/// do not either, but a NAME does: the next drawn name is someone else's, not a keyword we are about to
/// duplicate.
let nextKeywordIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    let mine (c: Layout.Cell) : Bool =
      match c.tag with
      | Some t -> Layout.tagMatches t st.caret.node st.caret.part
      | None -> false

    let firstOfRow (r: Layout.Row) (from: Int) : Stdlib.Option.Option<Layout.Cell> =
      let step (acc: (Int * Stdlib.Option.Option<Layout.Cell>)) (c: Layout.Cell) : (Int * Stdlib.Option.Option<Layout.Cell>) =
        let (x, best) = acc
        let ends = x + c.width
        if (Stdlib.Option.isSome best) || (x < from) then (ends, best)
        elif ((Stdlib.String.trim c.text) == "") || (mine c) || (c.style == Layout.Style.Punct) then (ends, best)
        else (ends, Stdlib.Option.Option.Some c)
      let (_, cell) = Stdlib.List.fold r (0, Stdlib.Option.Option.None) step
      cell

    let onRow =
      match Stdlib.List.getAt rows row with
      | Some r -> firstOfRow r col
      | None -> Stdlib.Option.Option.None

    let cell =
      match onRow with
      | Some c -> Stdlib.Option.Option.Some c
      | None ->
        Stdlib.List.range (row + 1) ((Stdlib.List.length rows) - 1)
        |> Stdlib.List.filterMap (fun i ->
          match Stdlib.List.getAt rows i with
          | Some r -> firstOfRow r 0
          | None -> Stdlib.Option.Option.None)
        |> Stdlib.List.head

    cell
    |> Stdlib.Option.andThen (fun c ->
      if c.style == Layout.Style.Keyword then Stdlib.Option.Option.Some(Stdlib.String.trim c.text)
      else Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None

let nextKeyword (st: State) : Stdlib.Option.Option<String> = nextKeywordIn (layout st) st
/// The punctuation drawn immediately before the caret, as one token: the `->` of a lambda or a match arm,
/// the `|` before a pattern. `prevDrawn` skips punctuation to find a keyword, so this walks the raw row.
let prevPunctIn (rows: List<Layout.Row>) (st: State) : Stdlib.Option.Option<String> =
  match Layout.locate rows st.caret.node st.caret.part st.caret.offset with
  | Some((row, col)) ->
    let mine (c: Layout.Cell) : Bool =
      match c.tag with
      | Some t -> Layout.tagMatches t st.caret.node st.caret.part
      | None -> false
    let lastOfRow (r: Layout.Row) (upto: Int) : Stdlib.Option.Option<Layout.Cell> =
      let step (acc: (Int * Stdlib.Option.Option<Layout.Cell>)) (c: Layout.Cell) : (Int * Stdlib.Option.Option<Layout.Cell>) =
        let (x, best) = acc
        let ends = x + c.width
        if (ends <= upto) && ((Stdlib.String.trim c.text) != "") && (Stdlib.Bool.not (mine c)) then
          (ends, Stdlib.Option.Option.Some c)
        else (ends, best)
      let (_, cell) = Stdlib.List.fold r (0, Stdlib.Option.Option.None) step
      cell
    let onRow =
      match Stdlib.List.getAt rows row with
      | Some r -> lastOfRow r col
      | None -> Stdlib.Option.Option.None
    let cell =
      match onRow with
      | Some c -> Stdlib.Option.Option.Some c
      | None ->
        Stdlib.List.range 0 (row - 1)
        |> Stdlib.List.reverse
        |> Stdlib.List.filterMap (fun i ->
          match Stdlib.List.getAt rows i with
          | Some r -> lastOfRow r 100000
          | None -> Stdlib.Option.Option.None)
        |> Stdlib.List.head
    cell
    |> Stdlib.Option.andThen (fun c ->
      if c.style == Layout.Style.Punct then Stdlib.Option.Option.Some(Stdlib.String.trim c.text)
      else Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None




let prevPunct (st: State) : Stdlib.Option.Option<String> = prevPunctIn (layout st) st

let nextPunct (st: State) : Stdlib.Option.Option<String> = nextPunctIn (layout st) st
/// Separators you can type to skip forward to the next hole, the way you'd type past punctuation that's
/// already on screen: `=` between a let's name and value, `:` before a record value or a type annotation.


/// Which node an infix operator typed at `path` should wrap, so precedence associates the way it reads.
/// A looser operator takes the tighter subtree as its left: `+` after `1 * 2` wraps the whole `1 * 2`,
/// while `*` after `1 + 2` wraps just the `2`. Walks up the right spine while the ancestor infix binds at
/// least as tightly (strictly tighter for a right-associative new operator, so `2 ^ 3 ^ 2` stays right).
let reassocTarget (reg: Registry) (root: Slot) (path: Path) (newOp: String) : Path =
  let (newPow, newRight) = Project.infixPowerOf newOp
  let climbUp (p: Path) : Path =
    match Path.parent p with
    | None -> p
    | Some parent ->
      match Path.last p with
      | Some(Into "right") ->
        match nodeAtPath root parent with
        | Some pn ->
          if isBinary reg pn then
            let (pPow, _) = Project.infixPowerOf (Node.text pn "op" |> Stdlib.Option.withDefault "+")
            let climb = if newRight then pPow > newPow else pPow >= newPow
            if climb then climbUp parent else p
          else p
        | None -> p
      | _ -> p
  climbUp path

/// Group rightward: `1 - 3 + 2` becomes `1 - (3 + 2)`.
///
/// Stachu asked for this and there was no way to do it. You cannot select `3 + 2` and wrap it, because
/// in `(1 - 3) + 2` there IS no `3 + 2` node. What looks like "put parens here" is a RE-ASSOCIATION, and
/// in text those are the same gesture, which is why its absence reads as a bug rather than a gap.
///
/// The rotation is the mirror of the one `reassocGrown` already does for precedence. There, a left
/// rotation turns `a == (b && r)` into `(a == b) && r`; here a right rotation on A whose left child L is
/// itself an infix:
///
///     A.left  <- L.right          (1 - 3) + 2
///     L.right <- A            ->   1 - (3 + 2)
///     result  <- L
///
/// The caret does not have to be standing on A. Walk up to the first ancestor infix whose LEFT child is
/// an infix and contains the caret, so standing on the `3` and standing on the outer `+` both mean the
/// same thing -- two readings of "put parens around 3 + 2" landing on one rotation.
///
/// Unlike the parens the drawing adds and removes for precedence, this CHANGES THE PROGRAM.
/// `1 - (3 + 2)` is not `(1 - 3) + 2`, so it is a real edit: it commits, and undo takes it back.
let regroupTarget (st: State) (from: Path) : Stdlib.Option.Option<Path> =
  let isInfix (x: Node) : Bool = isBinary st.reg x

  // Standing ON the infix is the same request as standing inside its left operand, and has to be checked
  // FIRST: at the root there is no parent to walk up to, so the climb alone answers None for the caret
  // position a person is most likely to be in after pressing `h`.
  let hereRotates =
    match nodeAtPath st.root from with
    | Some n ->
      (match operandsOf st.reg n with
       | Some ops ->
         (match Node.slot n ops.left with
          | Some(Filled l) -> isInfix l
          | _ -> false)
       | None -> false)
    | None -> false

  if hereRotates then
    Stdlib.Option.Option.Some from
  else

  match Path.parent from with
  | None -> Stdlib.Option.Option.None
  | Some parentPath -> regroupTarget st parentPath

let regroupRight (st: State) : Stdlib.Option.Option<State> =
  match regroupTarget st (navPath st) with
  | None -> Stdlib.Option.Option.None
  | Some aPath ->
    (match nodeAtPath st.root aPath with
     | None -> Stdlib.Option.Option.None
     | Some a ->
       (match operandsOf st.reg a with
        | Some ops ->
         (match Node.slot a ops.left with
          | Some(Filled l) ->
           (match (operandsOf st.reg l) with
            | Some lOps ->
             (match (Node.slot l lOps.right, Node.slot a ops.right) with
              | (Some lRight, Some _) ->
               let newA = Node.setField a ops.left (Field.One lRight)
               let rotated = Node.setField l lOps.right (Field.One(Slot.Filled newA))
               let st1 = commit st [ Edit.Replace(aPath, Slot.Filled rotated) ] st.caret
               Stdlib.Option.Option.Some { st1 with caret = navCaretFor st1.root aPath }
              | _ -> Stdlib.Option.Option.None)
            | None -> Stdlib.Option.Option.None)
          | _ -> Stdlib.Option.Option.None)
        | _ -> Stdlib.Option.Option.None))

/// Ungroup: `1 - (3 + 2)` becomes `(1 - 3) + 2`. The other direction, and the same rotation
/// `reassocGrown` performs for precedence -- a left rotation, where `regroupRight` is a right one.
///
///     A.right <- R.left           1 - (3 + 2)
///     R.left  <- A            ->  (1 - 3) + 2
///     result  <- R
///
/// Undo already reverses a grouping you just made. What this adds is regrouping code you did NOT write:
/// opening `1 - (3 + 2)` from the store and wanting the other reading. Undo cannot reach that.
let ungroupTarget (st: State) (from: Path) : Stdlib.Option.Option<Path> =
  let isInfix (x: Node) : Bool = isBinary st.reg x

  let hereRotates =
    match nodeAtPath st.root from with
    | Some n ->
      (match operandsOf st.reg n with
       | Some ops ->
         (match Node.slot n ops.right with
          | Some(Filled r) -> isInfix r
          | _ -> false)
       | None -> false)
    | None -> false

  if hereRotates then
    Stdlib.Option.Option.Some from
  else

  match Path.parent from with
  | None -> Stdlib.Option.Option.None
  | Some parentPath -> ungroupTarget st parentPath

let ungroupLeft (st: State) : Stdlib.Option.Option<State> =
  match ungroupTarget st (navPath st) with
  | None -> Stdlib.Option.Option.None
  | Some aPath ->
    (match nodeAtPath st.root aPath with
     | None -> Stdlib.Option.Option.None
     | Some a ->
       (match operandsOf st.reg a with
        | Some ops ->
         (match Node.slot a ops.right with
          | Some(Filled r) ->
           (match operandsOf st.reg r with
            | Some rOps ->
             (match Node.slot r rOps.left with
              | Some rLeft ->
               let newA = Node.setField a ops.right (Field.One rLeft)
               let rotated = Node.setField r rOps.left (Field.One(Slot.Filled newA))
               let st1 = commit st [ Edit.Replace(aPath, Slot.Filled rotated) ] st.caret
               Stdlib.Option.Option.Some { st1 with caret = navCaretFor st1.root aPath }
              | _ -> Stdlib.Option.Option.None)
            | None -> Stdlib.Option.Option.None)
          | _ -> Stdlib.Option.Option.None)
        | _ -> Stdlib.Option.Option.None))

/// The enclosing interpolated string and the segment index the caret is under, if any. Handles both being
/// directly in a text segment and being down inside an interpolation's expression.
let enclosingStringSeg (reg: Registry) (root: Slot) (path: Path) : Stdlib.Option.Option<(Path * Int)> =
  let (_, found) =
    Stdlib.List.fold path ((0, Stdlib.Option.Option.None)) (fun acc step ->
      let (idx, best) = acc
      match step with
      // The slot NAME comes off the spec too, not just the kind: a DSL that calls its parts `pieces` is
      // the same construct, and hard-coding "segments" would have found nothing in it.
      | Item(slot, i) ->
        let prefix = Stdlib.List.take path idx
        match nodeAtPath root prefix with
        | Some n ->
          (match segmentsOf reg n with
           | Some seg ->
             if seg.slot == slot then (idx + 1, Stdlib.Option.Option.Some((prefix, i))) else (idx + 1, best)
           | None -> (idx + 1, best))
        | None -> (idx + 1, best)
      | _ -> (idx + 1, best))
  found

/// String-interpolation editing: `{` in a text segment splits it and drops an interpolation between the
/// halves; `}` inside an interpolation steps to the text after it; `"` in a text segment ends the whole
/// string (a leading `"` right after `$` is swallowed). Returns None when the caret isn't in a string.
let handleStringI (st: State) (c: String) : Stdlib.Option.Option<State> =
  let caret = st.caret
  match enclosingStringSeg st.reg st.root caret.node with
  | None -> Stdlib.Option.Option.None
  | Some((ePath, i)) ->
    match nodeAtPath st.root ePath with
    | None -> Stdlib.Option.Option.None
    | Some eNode ->
      // Every name below comes off the spec. Each one used to be a literal here, which meant a DSL could
      // declare its content segmented and still only work if it happened to call its parts `segments`,
      // its text `text` and its hole `expr`.
      match segmentsOf st.reg eNode with
      | None -> Stdlib.Option.Option.None
      | Some seg ->
      let segType =
        Node.itemExpect eNode seg.slot
        |> Stdlib.Option.andThen (fun e -> e.kind)
        |> Stdlib.Option.map (fun k -> Kind.typeName k)
        |> Stdlib.Option.withDefault (Kind.typeName eNode.kind)
      let exprTy = Kind.typeName eNode.kind
      // Directly in this segment's text? (as opposed to nested in an interpolation's expression)
      let directText =
        match caret.part with
        | InText slot -> (slot == seg.textSlot) && (Path.last caret.node == Stdlib.Option.Option.Some(Step.Item(seg.slot, i)))
        | _ -> false
      let segNode = Stdlib.List.getAt (Node.items eNode seg.slot) i |> Stdlib.Option.andThen (fun s -> Slot.node s)
      let isText =
        match segNode with
        | Some sn -> isTextSegment st.reg eNode sn
        | None -> false
      if (c == st.reg.syntax.stringDelimiter) && directText then
        let text = Node.text (segNode |> Stdlib.Option.withDefault eNode) seg.textSlot |> Stdlib.Option.withDefault ""
        let onlySeg = (Stdlib.List.length (Node.items eNode seg.slot)) == 1
        if (text == "") && onlySeg && (caret.offset == 0) then
          Stdlib.Option.Option.Some st
        else
          Stdlib.Option.Option.Some { st with caret = Caret.afterNode ePath }
      elif (c == st.reg.syntax.interpolationOpen) && directText then
        let segPath = Path.item ePath seg.slot i
        let text = Node.text (segNode |> Stdlib.Option.withDefault eNode) seg.textSlot |> Stdlib.Option.withDefault ""
        let before = Stdlib.String.slice text 0 caret.offset
        let after = Stdlib.String.dropFirst text caret.offset
        let interp =
          Node.make
            (Kind.ofCase segType seg.holeCase)
            [ (seg.holeSlot, Field.One(Slot.Empty(Expect.ofKind (Kind.named exprTy) seg.holeSlot))) ]
        let tail = Node.make (Kind.ofCase segType seg.textCase) [ (seg.textSlot, Field.Text after) ]
        let st1 =
          commit
            st
            [ Edit.SetText(segPath, seg.textSlot, before)
              Edit.InsertItem(ePath, seg.slot, i + 1, Slot.Filled interp)
              Edit.InsertItem(ePath, seg.slot, i + 2, Slot.Filled tail) ]
            caret
        Stdlib.Option.Option.Some { st1 with caret = Caret.inSlot (Path.item ePath seg.slot (i + 1)) seg.holeSlot 0 }
      elif (c == st.reg.syntax.interpolationClose) && (Stdlib.Bool.not directText) && (Stdlib.Bool.not isText) then
        // Inside an interpolation's expression: step to the text segment after it.
        let nextIsText =
          Stdlib.List.getAt (Node.items eNode seg.slot) (i + 1)
          |> Stdlib.Option.andThen (fun s -> Slot.node s)
          |> Stdlib.Option.map (fun sn -> isTextSegment st.reg eNode sn)
          |> Stdlib.Option.withDefault false
        if nextIsText then
          // Stepping out settles what was typed inside the interpolation. Without this, `$"hi {name}"`
          // left `name` an unresolved partial the caret had already left behind, and the whole document
          // refused to lower -- while the same string without the closing `}` lowered fine.
          let settled = resolvePartial st |> Stdlib.Option.withDefault st
          Stdlib.Option.Option.Some { settled with caret = Caret.inText (Path.item ePath seg.slot (i + 1)) seg.textSlot 0 }
        else
          Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.None

let typeOne (st: State) (c: String) : State =
  let caret = st.caret
  // ONE layout for the whole decision below.
  //
  // Each of these questions ("is the glyph after the caret the closer I just typed", "is there already a
  // separator here", "what punctuation was drawn before me") used to render the entire document to answer
  // itself, and the chain asks four of them in a row. Measured on a 20-node document: 31ms a render,
  // 224ms a keystroke, so about seven renders per key. Nothing has changed the document between these
  // questions -- they are all asked of `st`, before any edit -- so one drawing answers all of them.
  let (st, rows) = withLayout st
  match handleStringI st c with
  | Some handled -> handled
  | None ->
  // The lead punctuation typed again, in the fresh empty item it just made: the operator was meant.
  match leadPunctRevision st c with
  | Some revised -> revised
  | None ->
  // The character a spec draws BEFORE EACH ITEM of a list starts the next item: `|` at the end of a match
  // arm's rhs is a new arm, which is how anyone writing the source would type it. Asked of the projection
  // rather than hard-coded, so a DSL that separates its items some other way gets it too.
  //
  // Up here rather than in the text branch below, because the caret is not always in text at the end of an
  // item: type a string and the closing quote leaves you AFTER the node, and `| 0 -> "zero"` then `|` built
  // a pipe.
  // Settle what is being typed before starting the next item. Adding a sibling moves the caret into the
  // NEW one, so a name still half-typed in the old was resolved by nothing afterwards -- and Escape then
  // settles what the caret is on, which by then is somewhere else. `[Stdlib.Option.None, 1]` drew right
  // and refused to lower, "unresolved", and so did anything else whose last act in an item was a name.
  //
  // Same fix the closer branch below gets, and the same one the `)` group collapse got: three ways out of
  // an item, three places that had to remember. Enter already did this.
  let settledForSibling = resolvePartial st |> Stdlib.Option.withDefault st
  match statementPipeRevision st c with
  | Some revised -> revised
  | None ->
  match leadPunctSibling settledForSibling c with
  | Some added -> added
  | None ->
  // ...and the one it draws BETWEEN them. Lead first: if a spec somehow drew the same character in both
  // places, starting the next item where the character is WRITTEN is the one that matches what you typed.
  match sepPunctSibling settledForSibling c with
  | Some added -> added
  | None ->
  // A comma adds the next element of the enclosing list/tuple (the natural key inside `[1, 2]`), unless
  // you're typing inside a string, where it's a literal comma.
  // Asked of the SPEC, which says so by drawing the slot with `QuietText`. It was `slot == "body"`, a
  // name that happened to be right for a string and wrong for a char.
  let inStringBody = inContentText st
  // `|` on an expression builds a pipe, which draws `|>` already; the `>` completing the arrow lands in
  // the fresh step, so swallow it. Only at the very start of an empty item, where a leading operator
  // character can never mean anything else.
  //
  // Asked of the spec, which drew the `|>`. It used to name EPipe and the `steps` slot, so a DSL whose
  // items are led by a two-character operator had to have this written for it in the kernel.
  let inFreshPipeStep =
    (caret.offset == 0)
    && (match caret.part with
        | InItem(s, _) ->
          (match nodeAtPath st.root caret.node with
           | Some n -> continuesDrawnPunct (leadPunctOf st n s) c
           | None -> false)
        | _ -> false)
    && (match Caret.slotPath caret with
        | Some sp -> (match slotAtPath st.root sp with
                      | Some(Empty _) -> true
                      | _ -> false)
        | None -> false)
  // Re-typing a closing delimiter that's already drawn to the right steps past it instead of dropping a
  // stray literal: with the caret at `[1~]`, another `]` moves out of the list, matching how you'd close
  // a bracket you can already see.
  // The second `:` of `::` is already drawn by the cons the first `:` built, so swallow it (a fresh cons
  // tail never legitimately starts with `:`). Same sentence as `inFreshPipeStep`, one slot over: there the
  // construct leads each ITEM with the punct, here it draws it before a single slot.
  let inFreshConsTail =
    (caret.offset == 0)
    && (match caret.part with
        | InSlot s ->
          (match nodeAtPath st.root caret.node with
           | Some n -> continuesDrawnPunct (slotLeadPunctOf st n s) c
           | None -> false)
        | _ -> false)
    && (match Caret.slotPath caret with
        | Some sp -> (match slotAtPath st.root sp with
                      | Some(Empty _) -> true
                      | _ -> false)
        | None -> false)
  // A `|` while already in a pipe step starts the NEXT stage (rather than nesting a pipe in the step), so
  // `x |> f |> g` chains flat. The `>` that follows is swallowed by inFreshPipeStep.
  // Asked of the spec. Two facts, both already declared: this list's items are LED by the character you
  // typed (`|>` for a pipe, and the first character of it is the key you press), and emptying the list
  // collapses the construct back to the slot that held its operand -- which is exactly the undo this
  // branch performs when the pipe turns out to have been an accident.
  //
  // Three specs declare `collapsesWhenEmptied` and only the pipe's names a LIST, so `InItem` plus the lead
  // punct picks it out today; MPListCons and EInfix collapse a One slot and have no item lead at all. A
  // DSL whose own led list collapses the same way gets this without a kernel branch.
  let inPipeSteps =
    (match caret.part with
     | InItem(s, _) ->
       (match nodeAtPath st.root caret.node with
        | Some n ->
          (match emptiedCollapseOf st.reg n with
           | Some pair ->
             let (emptiedSlot, _survivor) = pair
             (emptiedSlot == s) && (leadsItemsWith st n s c)
           | None -> false)
        | None -> false)
     | _ -> false)
  // `)` while sitting in an untouched tuple is the unit literal `()`, not a one-element tuple: `(` opens a
  // tuple and an immediate `)` collapses it to unit.
  //
  // Asked of the spec: which character closes this, which slot it closes, and what an all-empty one
  // becomes. A tuple becomes its unit case; a list stays a list with nothing in it. The kernel used to
  // name all four kinds and pick `MPUnit` or `EUnit` by testing for `MPTuple`.
  let closingAnEmptyOne =
    match nodeAtPath st.root caret.node with
    | Some n ->
      (match closerOf st.reg n with
       | Some cl ->
         if (c == cl.char)
            && (match caret.part with
                | InItem(s, _) -> s == cl.slot
                | _ -> false)
            && (Node.items n cl.slot |> Stdlib.List.all (fun s -> Slot.isEmpty s)) then
           Stdlib.Option.Option.Some cl
         else
           Stdlib.Option.Option.None
       | None -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None

  let emptyTupleToUnit =
    match closingAnEmptyOne with
    | Some cl -> Stdlib.Option.isSome cl.whenEmpty
    | None -> false
  // `)` in a tuple holding ONE thing is a grouping paren, not a one-element tuple -- Darklang has no
  // one-tuples. `(` opens a tuple, so `(1 + 2)` came out as `(1 + 2, ⟨item⟩)` and `(fun x -> x)` could
  // not be typed at all. That matters because both are how the PRINTER writes things: a precedence group,
  // and the parenthesised lambda in `Stdlib.List.filter (fun x -> ...)`. The printer's output has to be
  // typeable.
  //
  // Only when the caret is in the filled item, which is what separates `(1 + 2` + `)` from `(1, ` + `)`.
  // In the second the comma was typed deliberately and the caret sits in the empty item, so it is a tuple
  // with a hole left in it, not a group.
  // A `)` collapses an enclosing ONE-ITEM tuple to that item (see `soloTupleAncestor`).
  // The caret's OWN node first, then upwards. How deep `caret.node` sits depends on what is in the item:
  // a filled node pushes the caret down into itself, so the tuple is its parent, while a PARTIAL leaves
  // the caret on the tuple as `InItem`. Looking only upwards meant `((a)` matched the OUTER tuple and
  // collapsed the wrong one, so `((a))` stopped at `(a, <item>)` while `((1 + 2))` went all the way.
  // ...and not when the closer belongs to an ARGUMENT list the caret is inside. A `)` closes the
  // innermost bracketed thing, and an arg list is bracketed even though its brackets are not drawn, so
  // looking straight past it to an ancestor tuple closed the wrong one: `(parse(t)` collapsed the tuple
  // to a group and came out as `parse t`.
  let soloTuple =
    if (c != ")") || (closesAnArgList st caret c) then
      Stdlib.Option.Option.None
    else
      match caret.part with
      | InItem(sl, i) ->
        if soloTupleHere st caret.node sl i then
          Stdlib.Option.Option.Some caret.node
        else
          soloTupleAncestor st caret.node
      | _ -> soloTupleAncestor st caret.node


  // `]` in a list holding just one empty item is the empty list `[]`: `[` opens a list and an immediate
  // `]` closes it empty. (Empty collections now carry a caret anchor, so the caret is findable.)
  let emptyListToNil =
    match closingAnEmptyOne with
    | Some cl -> Stdlib.Option.isNone cl.whenEmpty
    | None -> false
  if emptyTupleToUnit then
    match nodeAtPath st.root caret.node with
    | Some n ->
      // The spec names the case, so `MPTuple` becoming `MPUnit` and `ETuple` becoming `EUnit` is one
      // rule rather than a test for one of them.
      let unitCase =
        closingAnEmptyOne
        |> Stdlib.Option.andThen (fun cl -> cl.whenEmpty)
        |> Stdlib.Option.withDefault "EUnit"
      let unit = Node.make (Kind.ofCase (Kind.typeName n.kind) unitCase) []
      let st1 = commit st [ Edit.Replace(caret.node, Slot.Filled unit) ] caret
      { st1 with caret = Caret.afterNode caret.node }
    | None -> st
  elif Stdlib.Option.isSome soloTuple then
    match soloTuple with
    | Some tuplePath ->
      // Settle what you were typing first. The collapse lands the caret AFTER the whole group, so a name
      // still half-typed under it was never resolved by anything afterwards -- not even Escape, which only
      // settles what the caret is on. `(fun x -> x * x)` drew correctly and then refused to lower, with
      // "unresolved: x" for the `x` the `)` had walked away from.
      let settled = resolvePartial st |> Stdlib.Option.withDefault st
      (match nodeAtPath settled.root tuplePath with
       | Some tn ->
         (match Node.items tn "items" |> Stdlib.List.findFirst (fun sl -> Stdlib.Bool.not (Slot.isEmpty sl)) with
          | Some kept ->
            let st1 = commit settled [ Edit.Replace(tuplePath, kept) ] caret
            { st1 with caret = Caret.afterNode tuplePath }
          | None -> settled)
       | None -> settled)
    | None -> st
  elif emptyListToNil then
    match nodeAtPath st.root caret.node with
    | Some n ->
      let each = Node.itemExpect n "items" |> Stdlib.Option.withDefault (Expect.any "item")
      let emptied = Node.make n.kind [ ("items", Field.Many([], each)) ]
      let st1 = commit st [ Edit.Replace(caret.node, Slot.Filled emptied) ] caret
      { st1 with caret = Caret.afterNode caret.node }
    | None -> st
  elif inFreshPipeStep then
    st
  elif inFreshConsTail then
    st
  elif inPipeSteps then
    // A second `|` on a FRESH pipe (one empty step, made by the first `|`) means the user is typing `||`,
    // the OR operator, not a pipe. Convert the pipe back into an infix. On a pipe with real stages, `|`
    // just starts the next stage.
    match nodeAtPath st.root caret.node with
    | Some pn ->
      let steps = Node.items pn "steps"
      let fresh =
        ((Stdlib.List.length steps) == 1)
        && (match Stdlib.List.head steps with
            | Some(Empty _) -> true
            | _ -> false)
      if fresh then
        // Unwrap the accidental pipe back to its operand, then wrap with `||` at the node precedence says
        // it should take (left-associative), so `x || y || z` is `(x || y) || z` and prints without parens.
        // Through the spec's wrap rule for a doubled operator, not by building an `EInfix` here. This was
        // the last place the kernel named a Darklang node case, and it built the node's slots (`left`,
        // `op`, `right`) as well as its kind, so a DSL whose `|` doubled into something else got a
        // Darklang infix. `leadPunctRevision` says the same sentence through the registry; this is that
        // sentence for the case where the fresh thing is a pipe STEP rather than a list item.
        let firstSlot = Node.slot pn "first" |> Stdlib.Option.withDefault (Slot.Empty(Expect.any "left"))
        let doubled = c ++ c
        let target = reassocTarget st.reg st.root caret.node doubled
        let st0 = commit st [ Edit.Replace(caret.node, firstSlot) ] caret
        match nodeAtPath st0.root target with
        | Some targetNode ->
          let rules =
            match Registry.findTypeLevel st.reg targetNode.kind with
            | Some spec -> spec.wrapRules
            | None -> []

          (match rules |> Stdlib.List.findFirst (fun r -> r.onChar == "<operator>") with
           | Some rule ->
             let wrapped = rule.wrap targetNode doubled
             let st1 = commit st0 [ Edit.Replace(target, Slot.Filled wrapped) ] st0.caret
             if rule.opSlot == "" then
               typeOne { st1 with caret = landAfterCommit target wrapped } c
             else
               let opLen = Node.text wrapped rule.opSlot |> Stdlib.Option.withDefault "" |> Stdlib.String.length
               { st1 with caret = Caret.inText target rule.opSlot opLen }
           | None -> st0)
        | None -> st0
      else
        let settled = resolvePartial st |> Stdlib.Option.withDefault st
        match addSibling settled with
        | Some added -> added
        | None -> typeOneRaw st c
    | None -> typeOneRaw st c
  elif
    (Stdlib.List.member st.reg.syntax.closingDelimiters c)
    && ((glyphAfterCaretIn rows st == Stdlib.Option.Option.Some c)
        // ...or the closer is drawn by the construct we are inside, wherever the layout put it. A record
        // breaks onto lines, so its `}` sits on one of its own and the glyph test could never see it:
        // typing the printed `Zork { x = 1 }` read the `}` as the start of another FIELD.
        || (match enclosingListItem caret with
            | Some((parentPath, _, _)) ->
              (match nodeAtPath st.root parentPath with
               | Some pn -> drawsPunct st pn c
               | None -> false)
            | None -> false)
        // ...or it closes an ARGUMENT list, which is the one bracketed list the editor draws without its
        // brackets. `parse(t` opens the arguments and the drawing is `parse t`, so there is no `)` on
        // screen for the two tests above to find, and `parse(t) + 1` put the `+ 1` inside the argument.
        // The pairing is a fact about the language rather than about the drawing, so the syntax table
        // answers it.
        || (closesAnArgList st caret c))
  then
    // Step past the closer by landing after the whole construct it closes: a string is the node the caret
    // sits in; a `]`/`)`/`}` closes the enclosing list/tuple. From there a comma or a new element targets
    // the OUTER scope, which is what makes nested `[[1], 2]` type naturally.
    let target =
      if (c == "\"") || (c == "'") then
        Stdlib.Option.Option.Some caret.node
      else
        match enclosingListItem caret with
        | Some((parentPath, _, _)) -> Stdlib.Option.Option.Some parentPath
        | None -> Stdlib.Option.Option.None
    // Settle what you were typing before leaving it behind. Landing after the whole construct puts the
    // caret somewhere else entirely, and Escape afterwards settles what the caret is ON -- so a name still
    // being typed as the last thing before a `]` or a `)` was resolved by nothing at all. `[zork]` drew
    // exactly right and then refused to lower, "unresolved: zork", and so did every constructor written
    // inside a collection.
    //
    // The `)` that collapses a one-item tuple learned this two ticks ago and the note then said the other
    // closers wanted the same audit. This is that audit: one branch, same call, and it is the branch every
    // closing bracket goes through.
    let settled = resolvePartial st |> Stdlib.Option.withDefault st
    // A closer also drops a trailing item nothing was typed into. The printer puts its `}` or `]` on a
    // line of its own, so transcribing one ends with a line break that starts an item, and then the closer
    // arrives to find it empty: `Size { width = 1; height = 2 }` came out with a third field, and
    // `[a, b]` with a third element.
    //
    // Only the LAST one, only when it is entirely holes, and never the only one -- `[⟨item⟩]` is a list
    // you are still filling in, not one to empty.
    let dropped =
      match enclosingListItem caret with
      | Some((parentPath, slot, _)) ->
        (match nodeAtPath settled.root parentPath with
         | Some parent ->
           let items = Node.items parent slot
           let n = Stdlib.List.length items
           if n <= 1 then
             settled
           else
             (match Stdlib.List.getAt items (n - 1) with
              | Some(Empty _) -> commit settled [ Edit.RemoveItem(parentPath, slot, n - 1) ] settled.caret
              | Some(Filled child) ->
                if isAllHoles child then commit settled [ Edit.RemoveItem(parentPath, slot, n - 1) ] settled.caret
                else settled
              | None -> settled)
         | None -> settled)
      | None -> settled
    match target with
    | Some p -> { dropped with caret = Caret.afterNode p }
    | None -> moveRight dropped
  elif (Stdlib.List.member st.reg.syntax.separators c) && (Stdlib.Bool.not inStringBody) && (nextNonSpaceGlyphIn rows st == Stdlib.Option.Option.Some c) then
    // The separator you typed is already drawn just ahead (a let's `=`, a `:`): skip to the next hole
    // instead of typing it into the name. In an expression hole nothing like that is drawn, so `=` there
    // still starts an operator as before.
    nextHole st
  elif
    (Stdlib.List.member st.reg.syntax.separators c)
    && (Stdlib.Bool.not inStringBody)
    && (match slotUnder st with
        | Some(Empty _) -> true
        | _ -> false)
    && (prevNonSpaceGlyphIn rows st == Stdlib.Option.Option.Some c)
  then
    // The same separator, on the other side of the caret. `let x <space>` settles the name and leaves you
    // in the VALUE, past the `=` the editor drew -- so typing the `=` of `let x = 1`, which is what anyone
    // writes, landed it in the value and gave `let x = =`. Swallow it: you typed punctuation that is
    // already there. Guarded on an empty hole, so `a == b` still builds its operator.
    st
  elif
    (c == ">")
    && (Stdlib.Bool.not inStringBody)
    && (match nodeAtPath st.root caret.node with
        | Some n ->
          (match mergeSlotOf st.reg n with
           | Some sn -> (Node.text n sn |> Stdlib.Option.withDefault "") == "-"
           | None -> false)
        | None -> false)
  then
    // The `->` of a lambda or a match arm is drawn FOR you, and typing it starts a negative number on the
    // hole and then wraps it in an operator: `fun x -> x` came out as `ERR not an Int: -`. A minus sign
    // with no digits after it is never a number, and `- >` is not an expression in any reading, so this
    // can only be the arrow that is already there. Put the hole back.
    (match nodeAtPath st.root caret.node with
     | Some n ->
       let e = Expect.ofKind (Kind.named (Kind.typeName n.kind)) "expression"
       let st1 = commit st [ Edit.Replace(caret.node, Slot.Empty e) ] caret
       { st1 with caret = navCaretFor st1.root caret.node; mode = Mode.Insert }
     | None -> st)
  elif
    (Stdlib.Bool.not inStringBody)
    && (c != ",")
    && (match slotUnder st with
        // Only punctuation that can't START anything here. `[` and `(` open a list and a tuple, `-` opens
        // a negative number, `,` adds another item -- those all MEAN something on an empty hole and must
        // go through. A match arm's `|` means nothing there, so re-typing the one already drawn is just
        // the reflex that re-types a let's `=` or an `if`'s `then`.
        | Some(Empty e) -> Stdlib.Option.isNone (holeFill st.reg e c)
        | _ -> false)
    && (prevPunctIn rows st == Stdlib.Option.Option.Some c)
  then
    st
  elif
    (Stdlib.Bool.not inStringBody)
    && (match nextPunctIn rows st with
        | Some pn -> ((Stdlib.String.length pn) > 1) && (Stdlib.String.startsWith pn c)
        | None -> false)
    && (match caret.part with
        // Nowhere the character could go: it is not part of the text under the caret and it does not wrap
        // what is there either.
        | InText slot ->
          (match nodeAtPath st.root caret.node with
           | Some n ->
             let old = Node.text n slot |> Stdlib.Option.withDefault ""
             (Stdlib.Option.isSome (textSlotRejection st.reg n slot c (TextEdit.insertAt old caret.offset c)))
             && (Stdlib.Option.isNone (wrapRuleFor st.reg n c))
           | None -> false)
        | AfterNode ->
          (match nodeAtPath st.root caret.node with
           | Some n -> Stdlib.Option.isNone (wrapRuleFor st.reg n c)
           | None -> false)
        | _ -> false)
  then
    // You typed the first character of the punctuation drawn just ahead, somewhere that character cannot
    // go: you meant the one already there. `fun a b` then `-` is the arrow, so skip past it to the body.
    //
    // Only for punctuation of more than one character. A single-character one has its own rule above
    // (the `=` of a let, a closing bracket), and firing here as well would take `,` and `)` away from
    // them. The multi-character ones -- `->`, `|>`, `::` -- are the ones you type in halves, which is why
    // typing the FIRST half is a reliable signal and the second half is swallowed below.
    nextHole st
  elif
    (Stdlib.Bool.not inStringBody)
    && (caret.offset == 0)
    && (match slotUnder st with
        | Some(Empty _) -> true
        | _ -> false)
    && (match prevPunctIn rows st with
        | Some pp -> ((Stdlib.String.length pp) > 1) && (Stdlib.String.endsWith pp c)
        | None -> false)
  then
    // ...and the second half, at the start of the hole the first half moved you into. `-` skipped past
    // the `->`, and the `>` that follows it in anyone's typing would otherwise start an operator on an
    // empty body. The pipe's `|>` and the cons's `::` each had this written out for them by hand; this is
    // the same rule asked of the drawing.
    st
  elif
    (Stdlib.Bool.not inStringBody)
    && (Stdlib.List.member st.reg.syntax.separators c)
    && (match caretSlotPath caret with
        | Some sp ->
          (match (labelForSlot st sp, slotLeafText st sp) with
           | (Some label, Some typed) -> label == typed
           | _ -> false)
        | None -> false)
  then
    // The LABEL of this slot, typed again, followed by the separator that is also already drawn. A record
    // literal arrives with its declared field names written in it, so typing the printed
    // `Size { width = 1 }` back put a variable called `width` in the value and then made an operator of
    // the `=`: `width = width = 1`.
    //
    // The same reflex that retypes a drawn keyword, one level down, and it has to be keyed on the
    // SEPARATOR rather than on the name alone: `Size { width = width }` with a local called `width` is a
    // perfectly good thing to write, and nobody writing it types a second `=`.
    (match caretSlotPath caret with
     | Some sp ->
       let e =
         match slotAtPath st.root sp with
         | Some(Partial(_, was)) -> Slot.expect was |> Stdlib.Option.withDefault (Expect.any "value")
         | Some(Filled n) -> Expect.ofKind (Kind.named (Kind.typeName n.kind)) "value"
         | _ -> Expect.any "value"
       let st1 = commit st [ Edit.Replace(sp, Slot.Empty e) ] caret
       { st1 with caret = navCaretFor st1.root sp; mode = Mode.Insert }
     | None -> st)
  elif (c == ",") && (Stdlib.Bool.not inStringBody) then
    // The FALLBACK for `,`, kept deliberately. `sepPunctSibling` above handles every list whose spec says
    // what separates its items, and it only fires at the END of an item; this catches the rest of what the
    // hardcoded comma used to do, so nothing that worked stops working.
    // Not past a FULL one, for the reason typing a value is not: a comma inside `Some(a` asked for a
    // second field of a one-field case, and walking out to the arm list answered a question nobody asked
    // by starting `| b -> <rhs>`. A full fixed-arity slot has no next item, here or anywhere out from it.
    match addSiblingNotPastAFullOne settledForSibling with
    | Some added -> added
    | None -> typeOneRaw st c
  else
    typeOneRaw st c

let typeOneRaw (st: State) (c: String) : State =
  let caret = st.caret
  match caret.part with
  | InText slot ->
    match nodeAtPath st.root caret.node with
    | Some n ->
      let old = Node.text n slot |> Stdlib.Option.withDefault ""
      let atEnd = caret.offset >= (Stdlib.String.length old)
      // A character that OPENS an empty item list, from the end of one of the node's text slots: `(`
      // after a constructor pattern's case name opens its fields and drops into the first one, so
      // `Ok(x)` types straight through and the closing paren draws itself.
      //
      // The pairs come from the spec. This tested `n.kind.case == Some "MPEnum" && slot == "case"`, so
      // the only construct that could grow a list this way was the one the branch had been written for,
      // and an enum case in a type DECLARATION -- the same shape one level over -- could be READ and
      // never written: `| Foo of Int` printed correctly and no key made one. `EnumCase` claims a space
      // where `MPEnum` claims `(`, and neither is spelled here.
      //
      // What stays in the kernel is what is true of any language: the list must be EMPTY (otherwise the
      // character means whatever it means after a filled list) and it must actually be a Many.
      let openFields =
        if atEnd then opensItemSlot st.reg n c else Stdlib.Option.Option.None
      // Space at the end of a completed leaf means "done here" -> advance to the next hole, so you can type
      // `let x <space> 1 <space> body` close to writing it as text. A STRING body (slot "body") keeps its
      // spaces; everything else (names, digits, float parts) treats space as "next".
      if Stdlib.Option.isSome openFields then
        let itemSlot = openFields |> Stdlib.Option.withDefault ""
        // Built the way `addSibling` builds one, not as a bare hole. `newItemForEach` gives a kind with
        // nothing to type into its TEMPLATE, so the hole you land in is one that means something.
        //
        // An enum field is a wrapper -- an optional label and the type that does the work -- so as a bare
        // hole it was a slot expecting a wrapper, and text there became a partial in the wrapper, which
        // has no resolve and no completion and could never settle. `| Tri of Int` typed after the space
        // that opens the fields drew perfectly and lowered as "unresolved: Int". The SIBLING path never
        // had the bug, because it already asked this question.
        let each = Node.itemExpect n itemSlot |> Stdlib.Option.withDefault (Expect.any "field")
        let item = newItemForEach st each
        let st1 = commit st [ Edit.InsertItem(caret.node, itemSlot, 0, item) ] caret
        // ...and the caret goes INSIDE it when it is a node, which is the other half `addSiblingAt`
        // already does. Landing on the item slot of a filled wrapper put the caret nowhere the drawing
        // has -- "caret not found" -- and the next character went into the wrapper instead of its type.
        { st1 with caret = firstEditableIn (Path.item caret.node itemSlot 0) item }
      elif (Stdlib.Bool.not (isIdentChar c)) && (Stdlib.Option.isSome (clearsDrawnKeyword st)) then
        // The keyword the editor already drew, typed again. See `clearsDrawnKeyword`, which Enter asks
        // the same question of.
        //
        // Any character that cannot CONTINUE the keyword ends it, not just a space. It was space-only, so
        // `match args with[]` kept a pattern called `with` and dropped the `[]`, while
        // `match args with []` was fine. An identifier character is the one thing that must not clear:
        // `with0` is a name somebody may mean, and only the person typing knows.
        let cleared = clearsDrawnKeyword st |> Stdlib.Option.withDefault st
        if c == " " then cleared else typeOne cleared c
      elif (c == " ") && (slot != "body") && (slot != "text") && atEnd && (Stdlib.Bool.not (old == "")) then
        // Space at the end of a finished name means "done here", but NOT always "and on to the next
        // hole". Where an operator could follow, it has to leave the caret on what was just settled so
        // the operator can wrap it. Jumping cost `if s.width > 20` its condition: the space left the
        // field access, the `>` landed in the THEN branch, and out came `if s.width then > else 20`.
        //
        // A plain variable never had this bug because it commits through the menu, which already lands
        // after the node. A field access settles as TEXT and came through here instead.
        //
        // Except in a slot holding an OPERATOR. An operator is not a settled value: what it is waiting
        // for is its right operand, which sits INSIDE the node, so leaving the caret after the whole
        // infix sends the next thing you type past it. Top level hid that -- with nothing after the
        // infix, the next hole IS the right operand -- while `(a + b` put the `b` in the tuple's second
        // item.
        //
        // Keyed on the rule's own trigger, not on "is this an op slot", because the `.` rule's op-slot
        // holds a field NAME. `AnOperatorAfterAFieldNameWraps` made that distinction once already; using
        // the coarser test here brought its bug straight back as `if s.width > 20`.
        let holdsAnOperator =
          match inOpSlot st.reg n slot with
          | Some rule -> rule.onChar == "<operator>"
          | None -> false

        if holdsAnOperator then nextHole st else landSettled st caret.node
      else
      // In an operator slot, a non-operator character moves on to the next slot and types there.
      match inOpSlot st.reg n slot with
      | Some rule ->
        if (charClassMatches st.reg.syntax rule.onChar c) && atEnd && (rule.opSlot == rule.nextSlot) then
          // Re-typing the trigger while sitting in the op-slot itself starts another wrap: with the caret
          // at the end of the `a` in `r.a`, another `.` makes `(r.a).b`, not a field named `a.b`.
          let wrapped = rule.wrap n c
          let st1 = commit st [ Edit.Replace(caret.node, Slot.Filled wrapped) ] caret
          let opLen = Node.text wrapped rule.opSlot |> Stdlib.Option.withDefault "" |> Stdlib.String.length
          { st1 with caret = Caret.inText caret.node rule.opSlot opLen }
        // When the op-slot IS the destination it holds a NAME, not an operator -- a field after `.` -- so
        // an operator character is not part of it and wraps the whole access instead, the way it would
        // anywhere else. Typing `+` at the end of `s.width` was inserting it INTO the name, and
        // `formatFieldName` then drew the result honestly as ``s.`width+```.
        else if (rule.opSlot == rule.nextSlot) && (isOperatorChar st.reg.syntax c) then
          if atEnd && (old != "") then
            (match wrapRuleFor st.reg n c with
             | Some wr -> applyWrap st caret n wr c
             | None -> st)
          else
            // No name to wrap yet, so there is nothing for the operator to attach to and it is not part
            // of a name either. Say so, the way every other rejected character does.
            (match textSlotRejection st.reg n slot c (TextEdit.insertAt old caret.offset c) with
             | Some msg -> { st with message = msg }
             | None -> st)
        else if isOperatorChar st.reg.syntax c then
          let updated = TextEdit.insertAt old caret.offset c
          // An op text on its way to nothing. The slot's class lists the operators this language has, so
          // `-` is on its way to `-` and `<` to `<` or `<=`, and `->` is on its way to neither.
          //
          // That is the arrow a match arm and a lambda draw for you, and it is two operator characters,
          // so an expression followed by one grew an operator no parser would take: a guard typed as
          // `| x when x > 0 -> 1` lowered as "not an operator: ->". The FIRST character is genuinely
          // ambiguous -- `x > 0 - 1 -> 2` is a real program -- so nothing can be decided until the second
          // one arrives, and by then it is decided.
          //
          // Only when the drawn punctuation ahead is exactly the text we refused. Otherwise the character
          // is simply wrong here and says so, the way every other refused character does.
          if Stdlib.Option.isSome (textSlotRejection st.reg n slot c updated) then
            // Asked of the SPEC, not of the screen. `nextPunctIn` reads the drawing and finds nothing from
            // inside an op slot -- the hole for the right operand sits between the caret and the arrow --
            // so the question goes to the construct the caret is standing in, which is the one that draws
            // the arrow in the first place.
            let drawnAhead =
              match enclosingListItem caret with
              | Some((parentPath, _, _)) ->
                (match nodeAtPath st.root parentPath with
                 | Some pn -> drawsPunct st pn updated
                 | None -> false)
              | None -> false

            if drawnAhead then
              let collapsed = collapseInfix st caret.node n
              nextHole collapsed
            else
              (match textSlotRejection st.reg n slot c updated with
               | Some msg -> { st with message = msg }
               | None -> st)
          else
          let grown =
            commitRun st ((Path.toString caret.node) ++ "|op|" ++ slot) [ Edit.SetText(caret.node, slot, updated) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
          // The operator is only now complete, so this is the first moment its real power is known.
          let (settled, opPath) = reassocGrown grown caret.node
          { settled with caret = Caret.inText opPath slot (Stdlib.String.length updated) }
        else if rule.opSlot == rule.nextSlot then
          // The op-slot IS the destination (a field name after `.`): type into it normally.
          match textSlotRejection st.reg n slot c (TextEdit.insertAt old caret.offset c) with
          | Some msg -> { st with message = msg }
          | None ->
            let updated = TextEdit.insertAt old caret.offset c
            commitRun st ((Path.toString caret.node) ++ "|" ++ slot) [ Edit.SetText(caret.node, slot, updated) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
        else
          let next = Caret.inSlot caret.node rule.nextSlot 0
          typeOne { st with caret = next } c
      | None ->
        // At the end of a node's text, an operator wraps the node (`1` then `+` gives `1 + ⟨right⟩`).
        //
        // Except inside a STRING, where every character is content. `"a/b"` came out as `"a" / b`, and so
        // did every other operator: `+ - * / % ^ > < = ! &` all broke out and wrapped the string in an
        // infix, and `.` made a field access of it. No path, no URL and no message with punctuation in it
        // could be typed -- `"$HOME/.bashrc"` is the real body that found this.
        //
        // Its neighbours in this chain all ask: `typeOne` guards eight branches on `inStringBody`, and the
        // space rule two lines up asks `slot != "body"`. This one did not, so `isOperatorChar` won.
        //
        // The closing quote is what ends a string, and it has its own rule. From after it the caret is
        // AfterNode and `"abc" + "def"` wraps exactly as it always did.
        let inString = slot == "body"
        match (if atEnd && (Stdlib.Bool.not inString) then wrapRuleFor st.reg n c else Stdlib.Option.Option.None) with
        // An infix operator wraps the node precedence says it should, not always the one under the caret.
        | Some rule -> applyWrap st caret n rule c
        | None ->
          match textSlotRejection st.reg n slot c (TextEdit.insertAt old caret.offset c) with
          | Some msg -> { st with message = msg }
          | None ->
            let updated = TextEdit.insertAt old caret.offset c
            commitRun st ((Path.toString caret.node) ++ "|" ++ slot) [ Edit.SetText(caret.node, slot, updated) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
    | None -> st
  | OnNode ->
    // Nothing to type INTO here, so type against what follows instead. `OnNode` is where the caret lands
    // on a node with no text and no hole -- `_` is a whole pattern drawn as a LABEL, and so is a type like
    // `Int` -- and this branch answered every key with `st`. `fun _ ->` swallowed the arrow, the body, and
    // everything up to the next argument, which then landed in the body and left the call a hole short.
    //
    // Handled HERE rather than by landing the caret elsewhere when the node is built: `OnNode` is a real
    // position, it is what `j`/`k` and the change action select, and the type pins say a freshly built
    // `Int` is selected rather than passed. What was wrong is that typing there did nothing, not where
    // the caret was.
    typeOne { st with caret = Caret.afterNode caret.node } c
  | AfterNode ->
    // Space from just-after a node advances to the next hole -- unless an operator could follow, in which
    // case it stays, because leaving would abandon the thing the operator is about to wrap. `landSettled`
    // asks the spec that question everywhere else; this branch was answering it with an unconditional
    // "advance", so `(1 + 2) * 3` inside anything with a later hole lost the group: the space stepped to
    // the tuple's next item and the `*` built `(1 + 2, *3)`. Without the spaces it was already right.
    if c == " " then
      landSettled st caret.node
    else
    // Just after a closed construct: an operator or `.` wraps the WHOLE construct (`[1]` then `+` gives
    // `[1] + ⟨right⟩`, `[1].` a field access on the list); anything that starts a new element grows the
    // enclosing list without an explicit comma (`[[1]` then `2` -> `[[1], 2]`).
    match nodeAtPath st.root caret.node with
    | Some n ->
      // A rule that CONTINUES the node's text does not apply here: the caret is past the node, and the
      // character is the start of whatever comes next. `let a = 1 let b = ...` is where that showed.
      match wrapRuleFor st.reg n c |> Stdlib.Option.andThen (fun r -> if r.continuesText then Stdlib.Option.Option.None else Stdlib.Option.Option.Some r) with
      // Through `applyWrap`, so precedence picks WHAT gets wrapped. This branch used to wrap
      // `caret.node` itself, which is the node you are standing after and not always the one the
      // operator takes: after `x * 2 <space>`, a `+` wrapped just the `2` and gave `x * (2 + 3)`.
      //
      // It only started mattering once space began leaving the caret here rather than jumping to the
      // next hole, which is why arithmetic typed WITHOUT spaces was always right and the same
      // expression with them was not.
      | Some rule -> applyWrap st caret n rule c
      | None ->
        if (isOperatorChar st.reg.syntax c) || (c == ".") then
          st
        else
          // Growing the enclosing list must not step over what is still unfilled INSIDE the item you are
          // standing in. `(if x > 0 ` leaves the caret after the `0`, inside the tuple's first item, and
          // the `then` drawn just ahead of it was read as a second ITEM instead:
          // `(if x > 0 then ⟨then⟩ else ⟨else⟩, then, 1, else, 2)`. The same `if` with no list around it
          // was always right, which is the tell -- one question, and the answer depended on what happened
          // to enclose the caret.
          // A value after a settled node is usually the next ITEM of whatever list it sits in. Not when the
          // node can take it as an ARGUMENT and nothing else can: `xs |> zork 1` means the step applied to
          // `1`, not a second stage `1`.
          //
          // Three facts have to hold together, and each is what keeps one of the pinned readings:
          //
          //   the caret's node IS the item      a match's rhs sits INSIDE its arm, so `| 0 -> "z"` then
          //                                     `1` is the next arm and stays that way
          //   the list is not an ArgSlots one   an item there is already an argument, so
          //                                     `Stdlib.List.map xs` then `f` is the next argument
          //   the node can be applied           an EList cannot, so `[[1]` then `2` is the next element
          //
          // I tried "a list drawn with a LEAD punct is grown by typing that punct" first, which is a rule
          // about the LIST, and a pin killed it: a match's arms are led by `|` and are grown by typing a
          // value on purpose. The question is about the node and where the caret is on it.
          let appliesHere =
            match enclosingListItem caret with
            | Some((parentPath, slot, i)) ->
              ((Path.item parentPath slot i) == caret.node)
              && (Stdlib.Bool.not (inArgSlotsList st caret))
              && (match nodeAtPath st.root caret.node with
                  | Some n -> Stdlib.Option.isSome (wrapRuleNamed st.reg n "<apply>")
                  | None -> false)
            | None -> false

          match (if (itemHasHoles st caret) || appliesHere then Stdlib.Option.Option.None else addSiblingNotPastAFullOne st) with
          | Some added -> typeOne added c
          | None ->
            // Nothing to grow. A name after a finished value that CAN be applied is a call: `f xs` is
            // `f` applied to `xs`. The args were dropped with nothing said -- `f xs` drew `f`, `f 1 2`
            // drew `f` -- so `let add = fun a b -> a + b` could be written and then never used.
            //
            // Asked of the spec by name, and only EVariable carries the rule, so the two readings below
            // it are untouched: a list is not a function and `let xs = [1] xs` still means the body.
            // Typing a name just after a finished value means "on to the next thing", so step to the
            // next hole and type it there. Anything but that drops the keystroke silently, which is how
            // `let xs = [1] xs` ate the whole name with the screen never changing.
            let moved = nextHole st
            if moved.caret != st.caret then
              typeOne moved c
            else
              // Nowhere left to go. A name after a finished value that CAN be applied is a call: `f xs`
              // is `f` applied to `xs`. The arguments were dropped with nothing said -- `f xs` drew `f`,
              // `f 1 2` drew `f` -- so a local function could be written and then never used.
              //
              // LAST, after both the sibling and the next hole, because those are the editor asking for
              // something specific and this is only what is left. Ahead of them it took a hole that was
              // already waiting: `Stdlib.List.map xs (fun x -> x)` has its args capped at the arity, so
              // `addSibling` declines, and applying there gave `Stdlib.List.map (xs (fun x -> x)) ⟨fn⟩`.
              //
              // Asked of the spec by name, and only EVariable carries the rule, so a list is still not a
              // function.
              match wrapRuleNamed st.reg n "<apply>" with
              | Some rule ->
                let wrapped = rule.wrap n c
                let st1 = commit st [ Edit.Replace(caret.node, Slot.Filled wrapped) ] caret
                typeOne { st1 with caret = Caret.inItem caret.node rule.nextSlot 0 0 } c
              | None -> { st with message = "nowhere to type here -- Esc for nav" }
    | None -> st
  | _ ->
    match Caret.slotPath caret with
    | None -> st
    | Some sp ->
      match slotAtPath st.root sp with
      | Some(Empty e) ->
        // A space in an empty hole is leading whitespace: there is nothing typed to commit and nothing
        // to advance past, so swallow it. Without this, typing `[1, 2]` by hand gave the second item the
        // text " 2" -- the comma made the hole, and the space people naturally type after it landed in it.
        if c == " " then st
        else
        match holeFill st.reg e c with
        | Some((n, afterChar)) ->
          let st1 = commit st [ Edit.Replace(sp, Slot.Filled n) ] caret
          { st1 with caret = (if afterChar then landAfterFill sp n else firstEditable sp n) }
        | None ->
          let st1 = commitRun st ((Path.toString sp) ++ "|partial") [ Edit.Replace(sp, Slot.Partial(c, Slot.Empty e)) ] caret
          { st1 with caret = { caret with offset = Stdlib.String.length c } }
      | Some(Partial(text, was)) ->
        let atEnd = caret.offset >= (Stdlib.String.length text)
        // Space accepts the menu: it commits the highlighted candidate (so `let ` builds the let
        // construct, not a variable named "let") and is swallowed. With no candidate it settles the
        // partial to a variable. This is the single biggest "why did typing let make a variable" fix.
        // A `.` after a bare lowercase name is a field access, not part of a qualified name: settle the
        // name to a variable, then apply the `.` (which wraps it). `Stdlib.List` keeps building as one
        // partial because it isn't a bare lowercase word.
        let dotOnName =
          (c == ".") && atEnd
          && (Stdlib.String.length text) > 0
          && (TextEdit.isLetterString (Stdlib.String.first text 1))
          && (Stdlib.Bool.not (Stdlib.String.contains text "."))
          && ((Stdlib.String.toLowercase text) == text)
        if atEnd && (Stdlib.Bool.not (isIdentChar c)) && (Stdlib.Option.isSome (clearsDrawnKeyword st)) then
          // You typed the keyword the editor had already drawn. `if x > 0 then 1 else 2` is written with
          // its `then` and `else` by anyone with muscle memory, and they were landing in the branch holes
          // as variables named `then` and `else`. Same shape as re-typing the `=` of a let. Throw it away
          // and stay in the hole, which is where the branch itself goes.
          //
          // Shared with Enter now, which had the same question and a different answer. And with every
          // character that cannot continue the keyword, not just the space: `match args with[]` used to
          // keep a pattern called `with` and throw the `[]` away.
          let cleared = clearsDrawnKeyword st |> Stdlib.Option.withDefault st
          if c == " " then cleared else typeOne cleared c
        elif atEnd && ((c == " ") || ((c == "(") && (Stdlib.Option.isSome (exactCandidate st)))) then
          // Space commits the menu only when it's unambiguous -- exactly one candidate (a keyword prefix
          // like `le`->let) or an exact match (`let`). A loose prefix with several candidates (`f` ->
          // fun/false) finalises what you typed as a variable and advances instead, so `f ` stays `f`.
          //
          // `(` after a fully-typed name means the same thing and has to, because both spellings are real
          // Darklang and the stdlib writes both: `| Ok v ->` and `| Ok(row :: _) ->`. It only commits on
          // an EXACT match, never on a lone prefix -- `(` after a half-typed name is someone opening a
          // group, not accepting a completion they cannot see the end of.
          // The keyword the editor has ALREADY DRAWN, typed again. `prevKeyword` catches this when the
          // keyword sits behind the caret; after a call it is ahead, because an apply keeps taking
          // arguments and the caret never leaves the arg list. `match Stdlib.List.length xs with` made
          // `with` a third argument and drew `with with`, while `match n with` was fine -- the same
          // question answered two ways depending on how the scrutinee settled.
          //
          // Drop the argument rather than committing it, and let the space do what it would have done
          // with no argument there.
          let typedText =
            match slotUnder st with
            | Some(Partial(t, _)) -> t
            | _ -> ""

          let duplicatesNextKeyword =
            (typedText != "") && ((nextKeyword st) == Stdlib.Option.Option.Some typedText)

          // The LABEL this slot already carries, typed back. `Size {` arrives with `width` and `height`
          // written in it, so typing the printed `Size { width = 1 }` had the space commit the menu's best
          // guess for `height` -- `Darklang.Cli.CompletionPicker.minimumHeight` -- and there was no way
          // back from that.
          //
          // Neither commit nor resolve: leave the partial exactly as typed and swallow the space. The
          // space is where the ambiguity sits, not where it is settled. `Size { width = width }` with a
          // local called `width` is a real thing to write and reads identically up to here; the NEXT key
          // says which was meant, `=` for the label (the rule in `typeOne`) and anything else for the
          // variable.
          let duplicatesLabel = (typedText != "") && ((labelForSlot st sp) == Stdlib.Option.Option.Some typedText)

          // The keyword that opens an optional slot of the construct you are standing in. `when` typed in a
          // match arm's right-hand side is the arm's guard, not a variable called `when`, and the arm's
          // spec is where that is written down.
          let keywordSlot = opensKeywordSlot st sp typedText

          if duplicatesLabel then
            st
          elif Stdlib.Option.isSome keywordSlot then
            match keywordSlot with
            | Some target ->
              let (parentPath, slotName) = target

              (match nodeAtPath st.root parentPath with
               | Some pn ->
                 let each = Node.itemExpect pn slotName |> Stdlib.Option.withDefault (Expect.any slotName)
                 // The slot the word was typed in goes back to what it was before the word -- a hole, or
                 // whatever the partial was standing on. `was` is what the partial has been carrying for
                 // exactly this.
                 let st1 =
                   commit st [ Edit.Replace(sp, was), Edit.InsertItem(parentPath, slotName, 0, Slot.Empty each) ] caret
                 { st1 with caret = Caret.inItem parentPath slotName 0 0 }
               | None -> st)
            | None -> st
          elif duplicatesNextKeyword then
            match (Path.parent sp, Path.last sp) with
            | (Some parentPath, Some(Item(slot, i))) ->
              let st1 = commit st [ Edit.RemoveItem(parentPath, slot, i) ] caret
              nextHole { st1 with caret = Caret.onNode parentPath }
            | _ -> nextHole st
          else

          // Only a KEYWORD candidate. The rule above was written for keywords -- `le` can only be `let`,
          // and no variable is called `let` -- and stayed correct only while every candidate was reserved.
          // The moment the menu learned ordinary words, a lone `c` was an unambiguous `char` and
          // `if c then` came out `if '' then`; `r` became a record update, `s` an empty string.
          // `takesSpace`, not `keyword`: Tab still reaches a record from a name you typed, and a space
          // does not, because the space after a type name is the one you type before its `{`.
          let cands = candidates st |> Stdlib.List.filter (fun c -> c.takesSpace)
          let exact = exactCandidate st |> Stdlib.Option.andThen (fun c -> if c.takesSpace then Stdlib.Option.Option.Some c else Stdlib.Option.Option.None)
          // A variable named EXACTLY what was typed outranks a keyword this is merely a prefix of.
          //
          // The filter above decides among KEYWORDS, and the comment justifying it says "no variable is
          // called `let`". True of `let`. False of `f` against `fun`, and in a pipe stage `fun` is the
          // only keyword offered -- `if`, `let` and `match` are not stages -- so `f` was its lone
          // candidate. `xs |> f` committed a lambda and threw the name away, and since the lambda then
          // took parameters, `if c then xs |> f else ys` drew `(fun else ys -> <body>)`.
          //
          // Keyed on an EXACT variable rather than any competing candidate, so an ordinary keyword prefix
          // is untouched: `l ` is still `let` even with `list` in scope, because nothing is named `l`.
          let exactVariable =
            (typedText != "")
            && (candidates st
                |> Stdlib.List.any (fun c -> (Stdlib.Bool.not c.keyword) && (c.label == typedText)))

          // A lone unambiguous candidate commits, EXCEPT where the hole introduces a name. There `t` is
          // the tail of a list and not an abbreviation for `true`; only an exact match commits, because
          // no variable can be named `true`.
          let commitMenu =
            (Stdlib.Bool.not (Stdlib.List.isEmpty cands))
            && ((Stdlib.Option.isSome exact)
                || (((Stdlib.List.length cands) == 1)
                    && (Stdlib.Bool.not (inBindingPosition st))
                    && (Stdlib.Bool.not exactVariable)))
          if commitMenu then
            // Committing a leaf (an in-scope variable, a bool) finishes it and leaves the caret JUST AFTER
            // it, not at the next hole. That matters because the next keystroke is what says which you
            // meant: an operator wraps what you just settled (`if total <space> > 0`), a name means "on to
            // the next thing" and the AfterNode rule steps to the next hole and types it there (so
            // `let b = a <space> b` still reaches the body), and another space advances. Jumping straight
            // to the next hole made `if total > 0` and `let n = a + b` untypeable with the spacing anyone
            // actually uses: the operator landed in the THEN branch.
            // Committing a construct or a function lands in its own first hole to fill, so it stays there.
            // The KEYWORD one, not the selected one. `commitCandidate` takes whatever the menu is
            // pointing at, and the menu is the whole list -- so after filtering the DECISION but not the
            // CHOICE, `t ` built the tuple sitting at index 0 rather than the `true` that made the
            // decision, and `l ` built a `let` where it used to leave `l` alone.
            let taken =
              match exact with
              | Some c -> Stdlib.Option.Option.Some c
              | None -> Stdlib.List.head cands

            match taken with
            | Some c ->
              let committed = commitNamed st c

              (if onABlankNow committed then committed else landSettled committed sp)
            | None -> landSettled st sp
          else
            match resolvePartial st with
            | Some resolved ->
              // The name has just BECOME a node, so this is the first moment it can be asked whether the
              // character opens one of its lists. Only when resolving left nothing unfilled: a construct
              // that came back with holes wants the caret in them, and that is what `stayIfOnHole` is for.
              (match nodeAtPath resolved.root sp with
               | Some rn ->
                 if Stdlib.List.isEmpty (blanks (Slot.Filled rn)) then
                   (match opensItemSlot resolved.reg rn c with
                    | Some itemSlot ->
                      let each = Node.itemExpect rn itemSlot |> Stdlib.Option.withDefault (Expect.any "field")
                      let item = newItemForEach resolved each
                      let st1 = commit resolved [ Edit.InsertItem(sp, itemSlot, 0, item) ] resolved.caret
                      { st1 with caret = firstEditableIn (Path.item sp itemSlot 0) item }
                    | None -> stayIfOnHole resolved (fun r -> landSettled r sp))
                 else
                   stayIfOnHole resolved (fun r -> landSettled r sp)
               | None -> stayIfOnHole resolved (fun r -> landSettled r sp))
            | None -> nextHole st
        elif dotOnName then
          match resolvePartial st with
          | Some resolved -> typeOne resolved c
          | None ->
            let updated = TextEdit.insertAt text caret.offset c
            commitRun st ((Path.toString sp) ++ "|partial") [ Edit.Replace(sp, Slot.Partial(updated, was)) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
        elif atEnd && (Stdlib.Bool.not (isIdentChar c)) then
          // An operator or other punctuation ends the name: settle to a variable, then apply the char
          // (so `x+` wraps x in an infix).
          match resolvePartial st with
          | Some resolved -> typeOne resolved c
          | None ->
            let updated = TextEdit.insertAt text caret.offset c
            commitRun st ((Path.toString sp) ++ "|partial") [ Edit.Replace(sp, Slot.Partial(updated, was)) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
        else
          let updated = TextEdit.insertAt text caret.offset c
          commitRun st ((Path.toString sp) ++ "|partial") [ Edit.Replace(sp, Slot.Partial(updated, was)) ] { caret with offset = caret.offset + (Stdlib.String.length c) }
      | Some(Filled n) ->
        // The caret says slot but a node is there: treat as typing over it.
        let st1 = commit st [ Edit.Replace(sp, Slot.Partial(c, Slot.Filled n)) ] caret
        { st1 with caret = { caret with offset = Stdlib.String.length c } }
      | None -> st

/// Type `c`, which may be one grapheme or many (a paste). Multi-grapheme input is applied one grapheme at
/// a time, so hole rules and wrap rules that look at a single character behave the same as live typing.
let typeChar (st: State) (c: String) : State =
  // Recorded AFTER the keystroke, because `commit` clears it: making the sibling that a lead punct starts
  // is a structural edit, and it would wipe the very fact the next character needs.
  if (Stdlib.String.length c) <= 1 then
    { (typeOne st c) with lastChar = Stdlib.Option.Option.Some c }
  else
    // A run of characters arrives as ONE key press: the reader coalesces fast typing (and pastes) into a
    // single event. The completion menu is a cache refreshed once per key press, so folding the run
    // without refreshing leaves every character after the first deciding on a menu computed for the state
    // BEFORE the run. That is how typing `Stdlib.List.filter ` quickly committed the empty hole's only
    // candidate (`fun`, a lambda) and threw the whole name away, while typing it slowly worked.
    // Refresh between characters so a run behaves exactly like typing it.
    // ...but only before a character that READS it. A space is the one, in the commit-on-space branch of
    // typeOne; every other character just goes into the text. Refreshing before all of them cost a package
    // search each -- ~70ms, measured -- and discarded all but the last. The end-of-keypress refresh in
    // withRefreshedMenu still happens either way, so what the popover shows is unchanged.
    Stdlib.List.fold (Stdlib.String.toList c) st (fun acc g ->
      let ch = Stdlib.Char.toString g
      let ready = if ch == " " then refreshMenu acc else acc
      { (typeOne ready ch) with lastChar = Stdlib.Option.Option.Some ch })


/// The text slot a leaf carries its content in, if it's the kind we can merge by concatenation: an int's
/// digits, a variable's name. Anything else (or a non-leaf) returns None and won't be merged.
let mergeSlotOf (reg: Registry) (n: Node) : Stdlib.Option.Option<String> =
  match Registry.find reg n.kind with
  | Some spec -> spec.textSlot
  | None -> Stdlib.Option.Option.None

let isIdentifierChar (c: String) : Bool =
  (TextEdit.isLetterString c) || (TextEdit.isDigitString c) || (c == "_")

/// What a class is called when text is turned away from it.
let classDescription (cls: String) : String =
  if cls == "<qualifiedName>" then "a name"
  elif cls == "<digit>" then "a number"
  elif cls == "<numberStart>" then "a number"
  // Every class needs a line here. The fallthrough prints the class ITSELF, so a new one without a
  // description leaks `<intSuffixChar>` into a message a person reads, which is how this line got added.
  elif cls == "<intSuffixChar>" then "a number"
  elif cls == "<identifier>" then "a name"
  elif cls == "<nameStart>" then "a name"
  elif cls == "<letter>" then "a word"
  // A pattern splits on case: a lowercase start binds a variable, an uppercase one names a constructor.
  elif cls == "<lowerStart>" then "a name that binds"
  elif cls == "<operator>" then "an operator"
  elif cls == "<newline>" then "a line break"
  // Never the class itself. This message is read by a person, and the fallthrough used to print
  // `<intSuffixChar>` at them -- an internal token, and a promise that the next class added without a
  // line here will do it again. Vague beats leaked.
  else "what goes here"

/// The class a node's slot declares, if it declares one.
/// Whether the spec draws `slot` with `NameText` -- that is, whether it has already said the slot holds
/// a NAME. Recurses through the pieces that only group other pieces.
let drawsAsName (pieces: List<Piece>) (slot: String) : Bool =
  pieces
  |> Stdlib.List.any (fun p ->
    match p with
    | NameText(s, _) -> s == slot
    // `FieldText` draws a name too -- it differs from `NameText` in how it QUOTES one, not in what one is.
    // Leaving it out meant the five slots drawn with it had no character class at all and took anything:
    // typing the printed `Zork { x = 1 }` put the space and the `}` INTO the field name, and the drawing
    // then honestly showed them back as `` ` x` `` and `` `}` ``.
    | FieldText(s, _) -> s == slot
    | Group ps -> drawsAsName ps slot
    | Flat ps -> drawsAsName ps slot
    | Nest(_, ps) -> drawsAsName ps slot
    | _ -> false)

/// Whether the spec draws `slot` with `QuietText` -- that is, whether it has already said every
/// character in the slot is CONTENT and not syntax. Recurses the same way `drawsAsName` does.
///
/// Derived rather than repeated, for the reason `drawsAsName` gives above: the piece already carries the
/// fact. The hand-written version of this was `slot == "body"`, which named the string's slot and missed
/// the CHAR's, so `'` then `+` broke out of the literal and wrapped it as `'' + <right>`.
let drawsAsContent (pieces: List<Piece>) (slot: String) : Bool =
  pieces
  |> Stdlib.List.any (fun p ->
    match p with
    | QuietText(s, _) -> s == slot
    | Group ps -> drawsAsContent ps slot
    | Flat ps -> drawsAsContent ps slot
    | Nest(_, ps) -> drawsAsContent ps slot
    | _ -> false)

/// Is the caret inside a slot whose every character is content -- a string body, a char, a segment of an
/// interpolated string? Nine rules in `typeOne` need to stand down when it is.
let inContentText (st: State) : Bool =
  match st.caret.part with
  | InText slot ->
    (match nodeAtPath st.root st.caret.node with
     | Some n ->
       (match Registry.findExact st.reg n.kind with
        | Some spec -> drawsAsContent spec.pieces slot
        | None -> false)
     | None -> false)
  | _ -> false

/// The optional slots a spec draws behind a KEYWORD, as (slot, keyword) pairs.
///
/// `Piece.EachWrapped(slot, opener, _, _)` puts the opener in front of a list that has items and draws
/// nothing at all when it has none. A match arm's `when` guard is spelled that way, and so is an enum
/// case's ` of`. So the keyword is in the spec, never on screen while the slot is empty, and nothing
/// could type it: `| x when x > 0 -> 1` put the word `when` in the arm's right-hand side as a variable.
///
/// Only openers that are WORDS. `(`, `<` and the rest are punctuation a character rule already opens.
let keywordOpenedSlots (pieces: List<Piece>) : List<(String * String)> =
  pieces
  |> Stdlib.List.map (fun p ->
    match p with
    | EachWrapped(slot, openP, _, _) ->
      let word = Stdlib.String.trim openP
      if (word != "") && (TextEdit.isLetterString (Stdlib.String.first word 1)) then
        [ (slot, word) ]
      else
        []
    | Group ps -> keywordOpenedSlots ps
    | Flat ps -> keywordOpenedSlots ps
    | Nest(_, ps) -> keywordOpenedSlots ps
    | _ -> [])
  |> Stdlib.List.flatten

/// The keyword slot `typed` names on the node the caret's slot hangs off, when that slot is still empty.
///
/// Asked of the PARENT, because the word is typed in a sibling: `when` arrives in the arm's right-hand
/// side, and it is the arm that has the guard.
let opensKeywordSlot (st: State) (sp: Path) (typed: String) : Stdlib.Option.Option<(Path * String)> =
  if typed == "" then
    Stdlib.Option.Option.None
  else
    match Path.parent sp with
    | Some parentPath ->
      (match nodeAtPath st.root parentPath with
       | Some pn ->
         (match Registry.find st.reg pn.kind with
          | Some spec ->
            keywordOpenedSlots spec.pieces
            |> Stdlib.List.findFirst (fun pair ->
              let (slot, word) = pair
              (word == typed)
              && (Stdlib.List.isEmpty (Node.items pn slot))
              && ((Path.last sp) != (Stdlib.Option.Option.Some(Step.Into slot))))
            |> Stdlib.Option.map (fun pair ->
              let (slot, _) = pair
              (parentPath, slot))
          | None -> Stdlib.Option.Option.None)
       | None -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None

let textClassOf (reg: Registry) (k: Kind) (slot: String) : Stdlib.Option.Option<TextClass> =
  match Registry.findExact reg k with
  | Some spec ->
    let declared =
      spec.textClasses
      |> Stdlib.List.findFirst (fun pair ->
        let (s, _) = pair
        s == slot)
      |> Stdlib.Option.map (fun pair ->
        let (_, c) = pair
        c)

    match declared with
    | Some c -> Stdlib.Option.Option.Some c
    | None ->
      // A slot drawn with `NameText` is a name, and the spec said so by choosing that piece. An operator
      // is never part of one, so `Stdlib.printLine` then `+` used to give the single name
      // `Stdlib.printLine+1` -- the same bug `AnOperatorAfterAFieldNameWraps` fixed for field names, in
      // the four other places a name is drawn.
      //
      // Derived rather than repeated in each spec, because `NameText` already carries the fact. A DSL
      // that wants something else still says so with an explicit `textClasses` entry, which wins above.
      if drawsAsName spec.pieces slot then
        Stdlib.Option.Option.Some(TextClass.Word(("<nameStart>", "<qualifiedName>")))
      else
        Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None

/// Whether `t` is text this class allows.
///
/// `partial` is the difference between typing and merging. Typing asks about text you are still in the
/// middle of, so half a keyword is fine; merging asks whether the finished literal is one, so it is not.
/// For the other two classes every prefix of something valid is valid, and the two answers coincide.
let textFits (reg: Registry) (cls: TextClass) (t: String) (partial: Bool) : Bool =
  match cls with
  | Chars klass -> Stdlib.String.toList t |> Stdlib.List.all (fun g -> charClassMatches reg.syntax klass (Stdlib.Char.toString g))
  | Word((firstKlass, restKlass)) ->
    (match Stdlib.String.toList t with
     | [] -> true
     | first :: rest ->
       (charClassMatches reg.syntax firstKlass (Stdlib.Char.toString first))
       && (rest |> Stdlib.List.all (fun g -> charClassMatches reg.syntax restKlass (Stdlib.Char.toString g))))
  | OneOf words ->
    if partial then words |> Stdlib.List.any (fun w -> Stdlib.String.startsWith w t)
    else words |> Stdlib.List.any (fun w -> w == t)

/// Why a text slot can't hold `c`, if it can't. There is more than one place that inserts into a slot --
/// a field name after `.` goes through the wrap path, not the plain one -- so the rule lives here and both
/// call it. A live check caught exactly that: `user.name(` was still accepted after the plain path was
/// guarded.
///
/// The kernel used to carry two lists of PT kinds to answer this: which kinds have digit slots, and which
/// have name slots. It reads the spec now. The question is asked of `next`, the text the slot WOULD hold,
/// rather than of the character alone, because where a character sits is part of whether it belongs.
let textSlotRejection (reg: Registry) (n: Node) (slot: String) (c: String) (next: String) : Stdlib.Option.Option<String> =
  match textClassOf reg n.kind slot with
  | Some cls ->
    if textFits reg cls next true then
      Stdlib.Option.Option.None
    else
      (match cls with
       | Chars klass -> Stdlib.Option.Option.Some $"`{c}` isn't part of {classDescription klass}"
       // Which half turned it away decides what to say. A `(` is not a name character at all; a digit is
       // one, and is only wrong where it landed.
       | Word((firstKlass, restKlass)) ->
         let startsIt =
           match Stdlib.String.toList next with
           | first :: _ -> (Stdlib.Char.toString first) == c
           | [] -> false

         if startsIt && (Stdlib.Bool.not (charClassMatches reg.syntax firstKlass c)) then
           Stdlib.Option.Option.Some $"{classDescription firstKlass} can't start with `{c}`"
         else
           Stdlib.Option.Option.Some $"`{c}` isn't part of {classDescription restKlass}"
       // A keyword slot stays a keyword the whole way in: `t`, `tr`, `tru`, `true` are all prefixes,
       // `trueL` is not. Typing a letter after `true` used to be accepted, and `fromDoc` then read the
       // result as `false` without a word.
       | OneOf words -> Stdlib.Option.Option.Some $"`{c}` doesn't make {Stdlib.String.join words " or "}")

  | None -> Stdlib.Option.Option.None

/// A mergeable operand contributes (kind, slot-name, text): a filled int/variable by its content, a
/// partial (a name still being typed) by its text with no committed kind. A hole or anything else, None.
let operandMerge (reg: Registry) (s: Slot) : Stdlib.Option.Option<(Stdlib.Option.Option<Kind> * Stdlib.Option.Option<String> * String)> =
  match s with
  | Filled n ->
    match mergeSlotOf reg n with
    | Some sn ->
      Stdlib.Option.Option.Some((Stdlib.Option.Option.Some n.kind, mergeSlotOf reg n, Node.text n sn |> Stdlib.Option.withDefault ""))
    | None -> Stdlib.Option.Option.None
  | Partial(t, _) -> Stdlib.Option.Option.Some((Stdlib.Option.Option.None, Stdlib.Option.Option.None, t))
  | Empty _ -> Stdlib.Option.Option.None

/// Whether concatenated text is a valid literal of this kind. Guards against merging `1` with a
/// half-typed name into a bogus int `1t`, or `1` and `x` into a variable called `1x`.
///
/// This wrote out the digit rule and the identifier rule a second time, and had the first-character rule
/// the typing path did not. Both ask the slot what it holds now, so the two paths agree because they are
/// the same question rather than because someone kept them in step.
let mergedTextValid (reg: Registry) (k: Kind) (slot: String) (t: String) : Bool =
  if t == "" then
    false
  else
    match textClassOf reg k slot with
    | Some cls -> textFits reg cls t false
    | None -> false

/// Deleting the operator collapses an infix. Compatible operands merge into one leaf (`12 + 34` -> `1234`,
/// `foo + bar` -> `foobar`, the join under the caret); incompatible ones don't (`true + false` -> `true`,
/// dropping the right); a hole on either side just leaves the other operand.
/// Two operand slots joined into one leaf, with the caret offset at the seam, when they're compatible:
/// `12`/`34` -> `1234` at 2, `foo`/`bar` -> `foobar`. None when they don't fuse -- differing kinds (an
/// int and a bool), two kindless partials, or text that wouldn't parse as the target (`1` and `t`).
let mergeSlots (reg: Registry) (a: Slot) (b: Slot) : Stdlib.Option.Option<(Node * Int)> =
  match (operandMerge reg a, operandMerge reg b) with
  | (Some((ak, asn, at_)), Some((bk, bsn, bt))) ->
    let kind = if Stdlib.Option.isSome ak then ak else bk
    let sn = if Stdlib.Option.isSome asn then asn else bsn
    let kindsAgree =
      match (ak, bk) with
      | (Some x, Some y) -> x.case == y.case
      | _ -> true
    match (kind, sn) with
    | (Some k, Some slotName) ->
      let joined = at_ ++ bt
      if kindsAgree && (mergedTextValid reg k slotName joined) then
        Stdlib.Option.Option.Some((Node.make k [ (slotName, Field.Text joined) ], Stdlib.String.length at_))
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None
  | _ -> Stdlib.Option.Option.None

let collapseInfix (st: State) (p: Path) (n: Node) : State =
  let leftSlot = Node.slot n "left" |> Stdlib.Option.withDefault (Slot.Empty(Expect.any "left"))
  let rightSlot = Node.slot n "right" |> Stdlib.Option.withDefault (Slot.Empty(Expect.any "right"))
  // Keep one of the original operand slots (hole and all), landing the caret where you'd keep typing.
  let keep (s: Slot) (atEnd: Bool) : State =
    let st1 = commit st [ Edit.Replace(p, s) ] st.caret
    let caret =
      match Slot.node s with
      | Some child -> if atEnd then lastEditable p child else firstEditable p child
      | None -> Caret.inSlot p "" 0
    { st1 with caret = caret }
  let present (s: Slot) : Bool =
    match s with
    | Empty _ -> false
    | _ -> true
  match mergeSlots st.reg leftSlot rightSlot with
  | Some((merged, off)) ->
    let sn = mergeSlotOf st.reg merged |> Stdlib.Option.withDefault "digits"
    let st1 = commit st [ Edit.Replace(p, Slot.Filled merged) ] st.caret
    { st1 with caret = Caret.inText p sn off }
  | None ->
    if present leftSlot then keep leftSlot true
    elif present rightSlot then keep rightSlot false
    else keep leftSlot false

/// When you delete a construct keyword, it collapses to this slot: a let/lambda to its body, an if to its
/// then-branch, a match to its scrutinee. Each is an expression hole carrying the right expectation, so
/// the collapse lands on a clean blank rather than a fabricated one.
///
/// The slot comes from the spec. It was four kind names here, one line each, which is the same thing the
/// `MPEnum` branch was doing before `opensItems`: a real question answered by a list of the constructs
/// somebody had got round to. `collapsesToHole`, three lines further down, already asks its half of this
/// question of the SHAPE and says so in its comment.
let constructTargetSlot (reg: Registry) (n: Node) : Stdlib.Option.Option<Slot> =
  match Registry.find reg n.kind with
  | Some spec ->
    (match spec.collapsesTo with
     | Some slot -> Node.slot n slot
     | None -> Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None

/// Nothing has been typed anywhere in this node: every slot is a hole (or a structural child that is itself
/// all holes, like a fresh match arm), and no text has been entered. Hash slots (`_hash`) don't count.
let allHolesEmpty (n: Node) : Bool =
  n.fields
  |> Stdlib.List.all (fun f ->
    let (name, fld) = f
    let slotHollow (s: Slot) : Bool =
      match s with
      | Empty _ -> true
      | Partial(_, _) -> false
      | Filled child -> allHolesEmpty child
    match fld with
    | Text t -> (t == "") || (Stdlib.String.startsWith name "_")
    | One s -> slotHollow s
    | Many(items, _) -> items |> Stdlib.List.all (fun s -> slotHollow s))

/// A node that collapses to a plain HOLE rather than to one of its children.
///
/// `constructTargetSlot` answers "what does this construct become" for the four that have an obvious
/// survivor -- a let becomes its body, an if its then. An empty COLLECTION has no survivor: `[]` and `()`
/// and `{}` should just become a hole again. They had no rule at all, so Backspace on them did nothing
/// and the only way back was undo.
///
/// Asked of the shape rather than by naming kinds: a list with no items, or a node with no fields at all
/// (which is what `()` is). Anything a DSL builds with the same shape gets the same key for free.
let collapsesToHole (n: Node) : Bool =
  // Items that are all HOLES count as empty, not just an item list of length zero: `[]` and `[<item>]`
  // are the same list to anyone looking at it, and only one of them collapsing is the kind of split this
  // editor keeps producing. The caller has already checked `allHolesEmpty`, so nothing filled is at risk.
  let emptyCollection =
    n.fields
    |> Stdlib.List.any (fun f ->
      let (_, fld) = f
      match fld with
      | Many(items, _) -> items |> Stdlib.List.all (fun s -> Slot.isEmpty s)
      | _ -> false)

  emptyCollection || (Stdlib.List.isEmpty n.fields)

/// Backspace at the very start of an untouched construct deletes it: an empty `let`/`if`/`match`/lambda
/// collapses to a blank expression hole, so a keyword typed by mistake is one keystroke to undo. Only
/// fires from the construct's first hole and only when nothing is filled in, so real work is never lost.
let tryCollapseConstruct (st: State) : Stdlib.Option.Option<State> =
  let caret = st.caret
  if caret.offset != 0 then
    Stdlib.Option.Option.None
  else
    match nodeAtPath st.root caret.node with
    | Some n ->
      let fe = firstEditable caret.node n
      let atStart = (fe.part == caret.part) && (allHolesEmpty n)

      match constructTargetSlot st.reg n with
      | Some target ->
        if atStart then
          let st1 = commit st [ Edit.Replace(caret.node, target) ] caret
          Stdlib.Option.Option.Some { st1 with caret = navCaretFor st1.root caret.node; mode = Mode.Insert }
        else
          Stdlib.Option.Option.None
      | None ->
        // No survivor to collapse to, but an empty collection still has to go somewhere: back to the
        // hole it came from.
        if atStart && (collapsesToHole n) then
          let st1 = commit st [ Edit.Replace(caret.node, Slot.Empty(expectForSlot st caret.node)) ] caret
          Stdlib.Option.Option.Some { st1 with caret = navCaretFor st1.root caret.node; mode = Mode.Insert }
        else
          Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

/// Backspace at the start of a list/tuple element deletes the separator before it, merging the two
/// adjacent elements when they're compatible: `[12, 34]` -> `[1234]`, the caret at the seam. The same
/// rule as deleting an infix operator (mergeSlots), so incompatible neighbours stay separate.
let tryMergeListItems (st: State) : Stdlib.Option.Option<State> =
  let caret = st.caret
  if caret.offset != 0 then
    Stdlib.Option.Option.None
  else
    match Path.last caret.node with
    | Some(Item(slot, i)) ->
      if i <= 0 then
        Stdlib.Option.Option.None
      else
        match Path.parent caret.node with
        | Some parentPath ->
          match nodeAtPath st.root parentPath with
          | Some parent ->
            // Which lists merge this way, asked of the spec rather than named. Two facts and the `closer`
            // carries both: it is a BRACKETED list, which rules out a call's arguments and a match's arms
            // and a record's fields -- none of which is text to concatenate -- and its one-element form is
            // still a list rather than a grouping, which rules out the tuple. `soloIsGroup` was written
            // for the `)` that collapses `(1 + 2)`, and it is the same distinction: a container that
            // cannot drop below two elements cannot have two of them fused into one.
            let mergesByConcat =
              match closerOf st.reg parent with
              | Some cl -> (cl.slot == slot) && (Stdlib.Bool.not cl.soloIsGroup)
              | None -> false
            match (if mergesByConcat then Node.field parent slot else Stdlib.Option.Option.None) with
            | Some(Many(items, _)) ->
              // Only from the very start of item i, and only if it and its neighbour actually fuse.
              let atStart =
                match nodeAtPath st.root caret.node with
                | Some itemNode -> (firstEditable caret.node itemNode).part == caret.part
                | None -> false
              match (Stdlib.List.getAt items (i - 1), Stdlib.List.getAt items i) with
              | (Some prev, Some cur) ->
                if Stdlib.Bool.not atStart then
                  Stdlib.Option.Option.None
                else
                  match mergeSlots st.reg prev cur with
                  | Some((merged, off)) ->
                    let sn = mergeSlotOf st.reg merged |> Stdlib.Option.withDefault "digits"
                    let prevPath = Path.item parentPath slot (i - 1)
                    let st1 =
                      commit st [ Edit.Replace(prevPath, Slot.Filled merged), Edit.RemoveItem(parentPath, slot, i) ] caret
                    Stdlib.Option.Option.Some { st1 with caret = Caret.inText prevPath sn off }
                  | None -> Stdlib.Option.Option.None
              | _ -> Stdlib.Option.Option.None
            | _ -> Stdlib.Option.Option.None
          | None -> Stdlib.Option.Option.None
        | None -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None

/// Backspace on the empty trailing hole of a binary construct collapses it to its primary operand: an
/// infix `1 + ⟨⟩` back to `1`, a cons `h :: ⟨⟩` to `h`, a fresh pipe `a |> ⟨⟩` to `a`. So deleting the
/// right operand then pressing backspace again undoes the operator, rather than stranding an empty hole.
///
/// Which slot triggers it and which survives comes from `collapsesWhenEmptied`. This comment stated the
/// general rule for a while; the code under it was three arms naming EInfix, MPListCons and EPipe.
let tryCollapseBinary (st: State) : Stdlib.Option.Option<State> =
  let caret = st.caret
  if caret.offset != 0 then
    Stdlib.Option.Option.None
  else
    match nodeAtPath st.root caret.node with
    | Some n ->
      let onEmptySlot (slotName: String) : Bool =
        (match caret.part with
         | InSlot s -> s == slotName
         | _ -> false)
        && (Node.slot n slotName |> Stdlib.Option.map (fun s -> Slot.isEmpty s) |> Stdlib.Option.withDefault false)
      let collapseTo (keep: String) : Stdlib.Option.Option<State> =
        match Node.slot n keep with
        | Some keepSlot ->
          let st1 = commit st [ Edit.Replace(caret.node, keepSlot) ] caret
          let caret2 =
            match Slot.node keepSlot with
            | Some kn -> lastEditable caret.node kn
            | None -> navCaretFor st1.root caret.node
          Stdlib.Option.Option.Some { st1 with caret = caret2; mode = Mode.Insert }
        | None -> Stdlib.Option.Option.None
      // A `Many` trigger fires only when it holds exactly ONE item and that item is empty, which is what
      // a fresh pipe stage looks like. Emptying the last of several steps is a step being deleted, not
      // the pipe being undone.
      let onEmptyItems (slotName: String) : Bool =
        let items = Node.items n slotName
        (match caret.part with
         | InItem(s, _) -> s == slotName
         | _ -> false)
        && ((Stdlib.List.length items) == 1)
        && (match Stdlib.List.head items with
            | Some(Empty _) -> true
            | _ -> false)
      match emptiedCollapseOf st.reg n with
      | Some pair ->
        let (trigger, survivor) = pair
        if (onEmptySlot trigger) || (onEmptyItems trigger) then
          collapseTo survivor
        else
          Stdlib.Option.Option.None
      | None -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

/// Backspace in an empty `${}` interpolation removes it and merges the text segments on either side back
/// into one, so an interpolation you opened by mistake folds back into plain text.
let tryCollapseInterp (st: State) : Stdlib.Option.Option<State> =
  let caret = st.caret
  let inEmptyExpr =
    (caret.offset == 0)
    && (match caret.part with
        | InSlot s -> s == "expr"
        | _ -> false)
  if Stdlib.Bool.not inEmptyExpr then
    Stdlib.Option.Option.None
  else
    match enclosingStringSeg st.reg st.root caret.node with
    | None -> Stdlib.Option.Option.None
    | Some((ePath, i)) ->
      if i < 1 then
        Stdlib.Option.Option.None
      else
        match nodeAtPath st.root ePath with
        | Some eNode ->
          (match segmentsOf st.reg eNode with
           | None -> Stdlib.Option.Option.None
           | Some seg ->
             let segs = Node.items eNode seg.slot
             let segAt (j: Int) : Stdlib.Option.Option<Node> =
               Stdlib.List.getAt segs j |> Stdlib.Option.andThen (fun s -> Slot.node s)
             let isText (j: Int) : Bool =
               match segAt j with
               | Some n -> isTextSegment st.reg eNode n
               | None -> false
             // Only fold when both neighbours are text segments (the shape a split leaves behind).
             if (isText (i - 1)) && (isText (i + 1)) then
               let before = segAt (i - 1) |> Stdlib.Option.andThen (fun n -> Node.text n seg.textSlot) |> Stdlib.Option.withDefault ""
               let after = segAt (i + 1) |> Stdlib.Option.andThen (fun n -> Node.text n seg.textSlot) |> Stdlib.Option.withDefault ""
               let prevPath = Path.item ePath seg.slot (i - 1)
               let st1 =
                 commit
                   st
                   [ Edit.SetText(prevPath, seg.textSlot, before ++ after)
                     Edit.RemoveItem(ePath, seg.slot, i + 1)
                     Edit.RemoveItem(ePath, seg.slot, i) ]
                   caret
               Stdlib.Option.Option.Some
                 { st1 with
                     caret = Caret.inText prevPath seg.textSlot (Stdlib.String.length before)
                     mode = Mode.Insert }
             else
               Stdlib.Option.Option.None)
        | None -> Stdlib.Option.Option.None

let backspace (st: State) : State =
  // Just AFTER a node there is no text behind the caret to delete, and Backspace did nothing at all --
  // silently, for `[1]`, `(1, 2)`, `"abc"`, `()` and `[]` alike. A key that does nothing is the thing
  // this file keeps saying to avoid.
  //
  // Step back INSIDE instead, to the last place there is something to delete, which is where `moveLeft`
  // already goes from here. Non-destructive, and it puts the next Backspace somewhere it can work: hold
  // the key and it deletes, which is what holding it is for. Deleting the whole node instead would be a
  // lot to do for one keystroke on a construct you can no longer see the inside of.
  if st.caret.part == Part.AfterNode then
    match nodeAtPath st.root st.caret.node with
    | Some n -> { st with caret = lastEditable st.caret.node n }
    | None -> st
  else

  match tryCollapseInterp st with
  | Some collapsed -> collapsed
  | None ->
  match tryCollapseConstruct st with
  | Some collapsed -> collapsed
  | None ->
  match tryCollapseBinary st with
  | Some collapsed -> collapsed
  | None ->
  match tryMergeListItems st with
  | Some merged -> merged
  | None ->
  let caret = st.caret
  match caret.part with
  | InText slot ->
    match nodeAtPath st.root caret.node with
    | Some n ->
      let old = Node.text n slot |> Stdlib.Option.withDefault ""
      // Backspacing a single-character infix operator deletes the operator, collapsing the infix onto its
      // operands rather than leaving `12  34` with no operator. Fires wherever the caret sits in the op.
      let updated = TextEdit.removeBefore old caret.offset
      // A single-text leaf (an int, string, char, variable) whose only editable content is this slot goes
      // back to a hole when its last character is deleted, instead of lingering as a zombie empty node.
      let onlyEditable =
        n.fields
        |> Stdlib.List.all (fun f ->
          let (name, _) = f
          (name == slot) || (Stdlib.String.startsWith name "_"))
      // The text slot being emptied is the OPERATOR of a binary construct: the spec says which slots are
      // its operands, and a text field that is neither of them is the thing between them. `isBinary` and
      // `operandsOf` were already here for the `(`/`)` rotations, which need the same fact.
      let isTheOperator =
        match operandsOf st.reg n with
        | Some ops -> slot == ops.op
        | None -> false
      if isTheOperator && ((Stdlib.String.length old) <= 1) then
        collapseInfix st caret.node n
      elif (caret.offset > 0) && (updated == "") && onlyEditable then
        // What the hole left behind EXPECTS is the parent's question, and `expectForSlot` is where it is
        // already answered -- it is what `x` uses. This built its own instead, from the deleted node's
        // own kind plus a label sniffed out of the type name, so the two paths to the same empty slot
        // disagreed: `[1` backspaced gave `[⟨expression⟩]` where clearing it gave `[⟨item⟩]`, and the
        // wrong one is not just a label, it is what completes there.
        let st1 = commit st [ Edit.Replace(caret.node, Slot.Empty(expectForSlot st caret.node)) ] caret
        { st1 with caret = navCaretFor st1.root caret.node; mode = Mode.Insert }
      elif caret.offset <= 0 then
        st
      else
        commitRun st ((Path.toString caret.node) ++ "|" ++ slot) [ Edit.SetText(caret.node, slot, updated) ] { caret with offset = caret.offset - 1 }
    | None -> st
  | OnNode -> st
  | _ ->
    match Caret.slotPath caret with
    | None -> st
    | Some sp ->
      match slotAtPath st.root sp with
      | Some(Partial(text, was)) ->
        if caret.offset <= 0 then
          st
        else
          let updated = TextEdit.removeBefore text caret.offset
          if updated == "" then
            let st1 = commit st [ Edit.Replace(sp, was) ] caret
            { st1 with caret = { caret with offset = 0 } }
          else
            commitRun st ((Path.toString sp) ++ "|partial") [ Edit.Replace(sp, Slot.Partial(updated, was)) ] { caret with offset = caret.offset - 1 }
      | Some(Empty _) ->
        // Backspace on an empty list/tuple element removes it (down to the last one) and steps to the
        // previous element -- the natural way to undo one comma/Enter too many.
        match caret.part with
        | InItem(slot, i) ->
          match nodeAtPath st.root caret.node with
          | Some n ->
            match Node.field n slot with
            | Some(Many(items, _)) ->
              if (Stdlib.List.length items) > 1 then
                let st1 = commit st [ Edit.RemoveItem(caret.node, slot, i) ] caret
                let newI = if i > 0 then i - 1 else 0
                let itemPath = Path.item caret.node slot newI
                let caret2 =
                  match slotAtPath st1.root itemPath with
                  | Some(Filled child) -> lastEditable itemPath child
                  | _ -> Caret.inItem caret.node slot newI 0
                { st1 with caret = caret2 }
              else
                st
            | _ -> st
          | None -> st
        | _ -> st
      | _ -> st


// --- Completion ---

let labelMatches (typed: String) (label: String) : Bool =
  Stdlib.String.startsWith (Stdlib.String.toLowercase label) (Stdlib.String.toLowercase typed)

/// The candidate pool for a hole expecting `e`, given the text typed so far. Fixed completions are
/// prefix-filtered here; computed ones (`complete`) match themselves.
/// Prefix-match, then bring an exact-name match to the front so "Int" beats "Int8"; everything else keeps
/// its declared order (enum cases, keywords), which is meaningful. A partition, not a sort, so ties are
/// never reshuffled.
let rankCompletions (typed: String) (cs: List<Candidate>) : List<Candidate> =
  let t = Stdlib.String.toLowercase typed
  let matched = cs |> Stdlib.List.filter (fun c -> labelMatches typed c.label)
  let exact = matched |> Stdlib.List.filter (fun c -> (Stdlib.String.toLowercase c.label) == t)
  let rest = matched |> Stdlib.List.filter (fun c -> (Stdlib.String.toLowercase c.label) != t)
  Stdlib.List.append exact rest

let candidatePool (st: State) (e: Expect) (typed: String) : List<Candidate> =
  let scoped = scopeCandidates st e typed
  // What an ancestor suggests here, filtered to the kind this hole actually asked for: an offer travels
  // down a whole subtree, and a match's cases have no business in the arm's right-hand side.
  let offered =
    offeredCandidates st
    |> Stdlib.List.filter (fun c ->
      match e.kind with
      // By TYPE, not by exact kind: a hole that expects "a match pattern" expects any CASE of one, and the
      // offered nodes are cases. Comparing exactly dropped every one of them silently.
      | Some k -> Kind.sameType c.node.kind k
      | None -> true)
    |> Stdlib.List.filter (fun c -> labelMatches typed c.label)

  match Registry.forExpect st.reg e with
  | Some spec ->
    Stdlib.List.flatten
      [ offered
        scoped
        rankCompletions typed spec.completions
        spec.complete e typed ]
  | None ->
    match e.kind with
    | Some _ -> []
    | None ->
      rankCompletions typed (st.reg.specs |> Stdlib.List.map (fun s -> s.completions) |> Stdlib.List.flatten)

/// Compute the candidate menu for the current caret. A partial filters by what's typed; a fresh empty
/// hole shows its options immediately. This can run a package-store search, so it is computed once per
/// keystroke (see `refreshMenu`) and everything else reads the cached `menu`.
let computeCandidates (st: State) : List<Candidate> =
  match slotUnder st with
  | Some(Partial(typed, was)) ->
    candidatePool st (Slot.expect was |> Stdlib.Option.withDefault (Expect.any "")) typed
  | Some(Empty e) -> candidatePool st e ""
  | _ ->
    // A TEXT slot can have candidates too: the fields of the record you just typed a `.` after. There is
    // no `Expect` to ask, because a text slot is not a hole in the tree -- the node is already there and
    // only its text is unfinished -- so the pool is whatever an `offers` named for this slot produced,
    // filtered by what has been typed so far.
    match (st.caret.part, nodeAtPath st.root st.caret.node) with
    | (InText slotName, Some n) ->
      let typed = Node.text n slotName |> Stdlib.Option.withDefault ""

      offeredCandidates st
      |> Stdlib.List.filter (fun c -> Kind.sameType c.node.kind n.kind)
      |> Stdlib.List.filter (fun c -> labelMatches typed c.label)
      // ...but not the one you have already taken. After committing `s.width` the menu still offered
      // `width`, which is a menu whose only entry does nothing.
      |> Stdlib.List.filter (fun c -> c.label != typed)
    | _ -> []

/// The cached completion menu. Cheap; refreshed once per key. Empty while dismissed with Escape.
let candidates (st: State) : List<Candidate> =
  if st.menuDismissed then [] else st.menu

/// Recompute the menu for the state as it now stands. Call after every key.
let refreshMenu (st: State) : State = { st with menu = computeCandidates st }

/// The candidate whose label exactly matches the partial's text (case-insensitive), if any. Used for
/// commit-on-move-off: arrowing away from a fully-typed name accepts it.
let exactCandidate (st: State) : Stdlib.Option.Option<Candidate> =
  match slotUnder st with
  | Some(Partial(typed, _)) ->
    let t = Stdlib.String.toLowercase typed
    // The menu labels a candidate the way the printer would write it from HERE, and someone typing the
    // printed form of something declared further away types MORE segments than the label carries:
    // `Stdlib.Option.None` against a label of `Option.None`. That is the same name written from a
    // greater distance, so it is still exact.
    //
    // One-way on purpose. Typing more qualification than the label says exactly which thing you mean;
    // typing LESS does not, and matching that way would commit `Size` to the first of three types whose
    // labels merely end in it. Space finalising what was typed is the right answer there and stays.
    candidates st
    |> Stdlib.List.findFirst (fun c ->
      let l = Stdlib.String.toLowercase c.label
      (l == t) || (Stdlib.String.endsWith t ("." ++ l)))
  | _ -> Stdlib.Option.Option.None

/// Is the caret on a partial (text typed but not resolved)? Tab commits a candidate only here; on a
/// fresh hole Tab still means "next hole".
let onPartial (st: State) : Bool =
  match slotUnder st with
  | Some(Partial(_, _)) -> true
  | _ -> false

/// What is in scope at the caret: walk from the root along the caret's node path, and at each ancestor
/// collect the bindings it makes that are visible in the slot we descend into.
///
/// Carries the declared TYPE alongside each name, when the binder declared one, because that is what lets
/// a `match` know what its scrutinee is.
let scopeBindings (st: State) : List<Binding> =
  let step (acc: (Slot * List<Binding>)) (stp: Step) : (Slot * List<Binding>) =
    let (node, names) = acc
    match node with
    | Filled n ->
      let slot =
        match stp with
        | Into s -> s
        | Item(s, _) -> s
      let bound =
        match Registry.find st.reg n.kind with
        | Some spec ->
          spec.binders n
          |> Stdlib.List.filter (fun group ->
            let (_, slots) = group
            Stdlib.List.member slots slot)
          |> Stdlib.List.map (fun group ->
            let (vars, _) = group
            vars)
          |> Stdlib.List.flatten
        | None -> []

      match Node.slotAt n stp with
      | Some child -> (child, Stdlib.List.append names bound)
      | None -> (node, Stdlib.List.append names bound)
    | _ -> (node, names)
  // Walk to the slot the caret is on (one deeper than the node) when it is on a hole/partial, so a
  // binder that is visible in that slot is collected; otherwise walk to the node the caret is in.
  let targetPath =
    match Caret.slotPath st.caret with
    | Some sp -> sp
    | None -> st.caret.node
  let (_, names) = Stdlib.List.fold targetPath ((st.root, [])) step
  names |> Stdlib.List.filter (fun b -> b.name != "_")

let scopeNames (st: State) : List<String> =
  scopeBindings st |> Stdlib.List.map (fun b -> b.name)

/// The candidates the ANCESTORS offer into the slot the caret is in: the same walk as `scopeBindings`,
/// asking each node what it suggests below it given what it can see.
///
/// Kept separate from the binding walk because an offer needs the scope as it stood WHERE THE OFFERING
/// NODE SITS -- a match's scrutinee is typed by something above the match, not by the match's own arms.
/// Drop repeats by label, keeping the first of each and the order they came in.
let dedupeCandidates (cs: List<Candidate>) : List<Candidate> =
  cs
  |> Stdlib.List.fold [] (fun acc c ->
    if acc |> Stdlib.List.any (fun k -> k.label == c.label) then acc else Stdlib.List.append acc [ c ])

let offeredCandidates (st: State) : List<Candidate> =
  // An offer names a PATH of slots, not one slot: `EMatch` offers its cases into `cases.pat`, the arm's
  // own pattern, and not into everything underneath it. Keyed on one slot, the cases of the enum being
  // matched were also offered for the FIELDS of a case -- `Some(⟨field⟩)` suggesting `Some` and `None` --
  // which are patterns of an entirely different type.
  //
  // So each pending offer carries the segments it still has to see. It goes LIVE when there are none
  // left, for exactly the node that step reached, and is dropped on any further descent.
  let step
    (acc: (Slot * List<Binding> * List<(List<String> * List<Candidate>)> * List<Candidate>))
    (stp: Step)
    : (Slot * List<Binding> * List<(List<String> * List<Candidate>)> * List<Candidate>) =
    let (node, scope, pending, _live) = acc

    match node with
    | Filled n ->
      let slot =
        match stp with
        | Into s -> s
        | Item(s, _) -> s

      let spec = Registry.find st.reg n.kind

      let bound =
        match spec with
        | Some sp ->
          sp.binders n
          |> Stdlib.List.filter (fun g ->
            let (_, slots) = g
            Stdlib.List.member slots slot)
          |> Stdlib.List.map (fun g ->
            let (xs, _) = g
            xs)
          |> Stdlib.List.flatten
        | None -> []

      // This node's own offers, as (path segments, candidates).
      let fresh =
        match spec with
        | Some sp ->
          sp.offers scope n
          |> Stdlib.List.map (fun g ->
            let (cs, paths) = g
            paths |> Stdlib.List.map (fun p -> ((Stdlib.String.split p "."), cs)))
          |> Stdlib.List.flatten
        | None -> []

      let advanced =
        Stdlib.List.append pending fresh
        |> Stdlib.List.filterMap (fun o ->
          let (segs, cs) = o

          match segs with
          | first :: rest -> if first == slot then Stdlib.Option.Option.Some((rest, cs)) else Stdlib.Option.Option.None
          | [] -> Stdlib.Option.Option.None)

      let stillPending = advanced |> Stdlib.List.filter (fun o ->
        let (segs, _) = o
        Stdlib.Bool.not (Stdlib.List.isEmpty segs))

      let nowLive =
        advanced
        |> Stdlib.List.filterMap (fun o ->
          let (segs, cs) = o
          if Stdlib.List.isEmpty segs then Stdlib.Option.Option.Some cs else Stdlib.Option.Option.None)
        |> Stdlib.List.flatten

      (match Node.slotAt n stp with
       | Some child -> (child, Stdlib.List.append scope bound, stillPending, nowLive)
       | None -> (node, Stdlib.List.append scope bound, stillPending, nowLive))
    | _ -> (node, scope, pending, [])

  let targetPath =
    match Caret.slotPath st.caret with
    | Some sp -> sp
    | None -> st.caret.node

  let (here, scope, pending, offered) = Stdlib.List.fold targetPath ((st.root, [], [], [])) step

  // A text slot is not descended into, so an offer naming one is settled here rather than by the walk:
  // the node the caret is IN is asked for its own, and an ANCESTOR's offer with exactly that one segment
  // left goes live too -- a record update offers the record's field names into `updates.name`, and `name`
  // is text on the field rather than a slot to descend into. Anything already LIVE for this node stays,
  // which is what keeps `S` typed into a case's name reading as the arm's pattern.
  match (st.caret.part, here) with
  | (InText slotName, Filled n) ->
    let fromAbove =
      pending
      |> Stdlib.List.filterMap (fun o ->
        let (segs, cs) = o
        if segs == [ slotName ] then Stdlib.Option.Option.Some cs else Stdlib.Option.Option.None)
      |> Stdlib.List.flatten

    let own =
      match Registry.find st.reg n.kind with
      | Some spec ->
        spec.offers scope n
        |> Stdlib.List.filter (fun g ->
          let (_, slots) = g
          Stdlib.List.member slots slotName)
        |> Stdlib.List.map (fun g ->
          let (cs, _) = g
          cs)
        |> Stdlib.List.flatten
      | None -> []

    // Deduped by label, keeping the FIRST of each: an offer that names both the field and the field's
    // NAME reaches a text slot by two routes -- live for the node, and pending for its text -- and should
    // still be one entry. `uniqueBy` does not keep the order, and the order here is the order the fields
    // were declared in, which is the one worth reading.
    dedupeCandidates (Stdlib.List.flatten [ offered, fromAbove, own ])
  | _ -> dedupeCandidates offered

/// Variable candidates for the hole under the caret: the in-scope names matching the typed prefix,
/// turned into nodes by the expected kind's `scopeCandidate`. Empty when the kind has no variables.
let scopeCandidates (st: State) (e: Expect) (typed: String) : List<Candidate> =
  match Registry.forExpect st.reg e with
  | Some spec ->
    match spec.scopeCandidate with
    | Some make ->
      scopeNames st
      |> Stdlib.List.filter (fun name -> labelMatches typed name)
      |> Stdlib.List.uniqueBy (fun name -> name)
      |> Stdlib.List.map (fun name -> Spec.candidate name "in scope" (make name))
    | None -> []
  | None -> []

let selectedCandidate (st: State) : Stdlib.Option.Option<Candidate> =
  let cs = candidates st
  match cs with
  | [] -> Stdlib.Option.Option.None
  | _ ->
    // Negative is "nothing chosen", which is what a blank starts as, so nothing can be committed by
    // accident before you have said anything.
    //
    // Except an OFFER. `fromContext` candidates are the cases of the scrutinee's type, the fields of the
    // record you just named -- a short list that IS the answer to where you are, not the generic
    // "everything that could go here". Arriving in one of those is already a choice of sorts, and Enter
    // taking the first has been the behaviour and is pinned. The generic menu is what must not presume.
    if st.completionIndex < 0 then
      (match Stdlib.List.head cs with
       | Some c -> if c.fromContext then Stdlib.Option.Option.Some c else Stdlib.Option.Option.None
       | None -> Stdlib.Option.Option.None)
    else
      Stdlib.List.getAt cs (Stdlib.Int.clamp st.completionIndex 0 ((Stdlib.List.length cs) - 1))

/// After committing a candidate: its first hole if it has one, else the end of its text.
let landAfterCommit (path: Path) (n: Node) : Caret =
  // `blanks`, not `holes`: an empty TEXT field is the next thing to type too, and landing off `holes`
  // walked past a parameter with no name straight into its type.
  match blanks (Slot.Filled n) with
  | AtText(textPath, slotName) :: _ -> Caret.inText (Stdlib.List.append path textPath) slotName 0
  | AtSlot holePath :: _ ->
    let full = Stdlib.List.append path holePath
    match Path.parent full with
    | Some parentPath ->
      match Path.last full with
      | Some(Into slot) -> Caret.inSlot parentPath slot 0
      | Some(Item(slot, i)) -> Caret.inItem parentPath slot i 0
      | None -> lastEditable path n
    | None -> lastEditable path n
  | [] -> lastEditable path n

/// Characters that continue an identifier or a qualified name. A pasted string counts when every
/// grapheme in it does.
let isIdentChar (c: String) : Bool =
  Stdlib.String.toList c
  |> Stdlib.List.all (fun ch ->
    (Stdlib.Char.isAlphanumeric ch) || ((Stdlib.Char.toString ch) == "_") || ((Stdlib.Char.toString ch) == "."))

/// Turn the partial under the caret into what its spec says it resolves to, if anything. The caret goes
/// to the end of the new node's text.
let resolvePartial (st: State) : Stdlib.Option.Option<State> =
  match Caret.slotPath st.caret with
  | None -> Stdlib.Option.Option.None
  | Some sp ->
    match slotAtPath st.root sp with
    | Some(Partial(typed, was)) ->
      let e = Slot.expect was |> Stdlib.Option.withDefault (Expect.any "")
      match Registry.forExpect st.reg e with
      | Some spec ->
        // What you typed IS one of the options, so settling takes it. A spec's `resolve` is for the
        // things no menu can list -- a variable name, a type variable -- and it said no to `Int`, because
        // `Int` is a CANDIDATE. So Escape left a partial that drew exactly like a resolved type and then
        // refused to lower: "not saved: unresolved: Int", under a screen reading `(n: Int): Int`. The menu
        // already treats an exact match as nothing to wave off; this is the same rule one step later.
        //
        // Asked FIRST, which it was not. `resolve` now accepts a qualified name -- so that
        // `Builtin.charToAsciiCode` settles rather than sticking -- and a qualified name is exactly what
        // an enum constructor is: `Stdlib.Option.None` started settling as a VARIABLE with that name
        // before the menu, which holds the real constructor, was ever asked. A candidate is the more
        // specific answer wherever both have one, and `resolve` is the fallback for what no menu lists.
        // A KEYWORD candidate only. Settling is not choosing: Esc, a space, or typing on means "I have
        // finished writing this name", and `list`, `string`, `char`, `int` and `tuple` are names people
        // write. They joined the menu as suggestions and immediately started winning here -- typing
        // `list` and settling built an empty EList, `string` built `""`.
        //
        // A reserved word cannot be a variable, so a keyword candidate still wins, which is what keeps
        // `Stdlib.Option.None` settling as the constructor rather than as a variable of that name. Enter
        // and Tab still take a suggestion, because those keys mean "take what the menu is showing".
        //
        // `takesSpace` rather than `keyword`, for the reason this comment already gives: this is
        // SETTLING. A record must not win here either -- settling `Stdlib.Cli.Tui.Size` should leave the
        // name, so the `{` you type next builds the record, which is what the short `Size {` always did.
        // Tab and Enter are choosing, and still take it.
        match exactCandidate st |> Stdlib.Option.andThen (fun c -> if c.takesSpace then Stdlib.Option.Option.Some c else Stdlib.Option.Option.None) with
        | Some c ->
          let st1 = commit st [ Edit.Replace(sp, Slot.Filled c.node) ] st.caret
          Stdlib.Option.Option.Some { st1 with caret = lastEditable sp c.node }
        | None ->
          (match spec.resolve typed with
           | Some n ->
             let st1 = commit st [ Edit.Replace(sp, Slot.Filled n) ] st.caret
             Stdlib.Option.Option.Some { st1 with caret = lastEditable sp n }
           | None -> Stdlib.Option.Option.None)
      | None -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None

/// Replace the partial under the caret with the selected candidate.
let commitCandidate (st: State) : State =
  match Caret.slotPath st.caret with
  | Some sp ->
    match selectedCandidate st with
    | Some c ->
      let st1 = commit st [ Edit.Replace(sp, Slot.Filled c.node) ] st.caret
      { st1 with caret = landAfterCommit sp c.node }
    | None -> st
  // In a text slot there is no slot path -- the node is already there. The candidate replaces the NODE,
  // which is why an offer for a text slot carries a whole replacement rather than a string.
  | None ->
    match st.caret.part with
    | InText _ ->
      (match selectedCandidate st with
       | Some c ->
         let sp = st.caret.node
         let st1 = commit st [ Edit.Replace(sp, Slot.Filled c.node) ] st.caret
         { st1 with caret = landAfterCommit sp c.node }
       | None -> st)
    | _ -> st

/// Commit a NAMED candidate, rather than whichever one the menu is pointing at.
///
/// `commitCandidate` is right for Enter and Tab, where the selection IS the choice. A space chooses by
/// rule instead -- the one unambiguous keyword -- and that is not always the selected row.
let commitNamed (st: State) (c: Candidate) : State =
  match Caret.slotPath st.caret with
  | Some sp ->
    let st1 = commit st [ Edit.Replace(sp, Slot.Filled c.node) ] st.caret
    { st1 with caret = landAfterCommit sp c.node }
  | None ->
    match st.caret.part with
    | InText _ ->
      let sp = st.caret.node
      let st1 = commit st [ Edit.Replace(sp, Slot.Filled c.node) ] st.caret
      { st1 with caret = landAfterCommit sp c.node }
    | _ -> st

let cycleCandidate (st: State) (delta: Int) : State =
  let n = Stdlib.List.length (candidates st)

  // Where the selection EFFECTIVELY is. An offer already shows its first row as chosen, so moving from
  // it has to start there and land on the second; a generic menu shows nothing chosen, and moving into
  // it lands on the first. Reading `completionIndex` raw made Down on an offer re-select the row it was
  // already on.
  let effective =
    if st.completionIndex >= 0 then
      st.completionIndex
    else
      (match Stdlib.List.head (candidates st) with
       | Some c -> if c.fromContext then 0 else -1
       | None -> -1)

  if n == 0 then
    st
  else if effective < 0 then
    // Entering a generic list from "nothing chosen": down takes the first, up takes the last.
    { st with completionIndex = (if delta > 0 then 0 else n - 1) }
  else
    { st with completionIndex = Stdlib.Int.remainder (effective + delta + n) n |> Stdlib.Result.withDefault 0 }


/// The list the caret is inside, as (node holding the list, slot, index of the current item). Used by
/// Enter-to-add: from a match arm's body it finds the `cases` list; from a list element it finds the list.
let enclosingListItem (c: Caret) : Stdlib.Option.Option<(Path * String * Int)> =
  match c.part with
  | InItem(slot, i) -> Stdlib.Option.Option.Some((c.node, slot, i))
  | _ ->
    // The last `Item` step in the caret's node path is the nearest enclosing list element.
    let (_, found) =
      Stdlib.List.fold c.node ((0, Stdlib.Option.Option.None)) (fun acc step ->
        let (idx, best) = acc
        match step with
        | Item(slot, i) -> (idx + 1, Stdlib.Option.Option.Some((idx, slot, i)))
        | Into _ -> (idx + 1, best))
    match found with
    | Some((atIdx, slot, i)) ->
      let parentPath = Stdlib.List.take c.node atIdx
      Stdlib.Option.Option.Some((parentPath, slot, i))
    | None -> Stdlib.Option.Option.None

/// EVERY enclosing list item, nearest first. A node can be inside several: a field of a case of an enum,
/// where the fields are one list and the cases another. Which one a keystroke means depends on what the
/// spec draws, so the answer has to be all of them.
let enclosingListItems (c: Caret) : List<(Path * String * Int)> =
  let fromPath =
    let (_, found) =
      Stdlib.List.fold c.node ((0, [])) (fun acc step ->
        let (idx, out) = acc
        match step with
        | Item(slot, i) -> (idx + 1, Stdlib.List.push out ((Stdlib.List.take c.node idx, slot, i)))
        | Into _ -> (idx + 1, out))
    // `push` prepends, so this is already nearest-first.
    found
  match c.part with
  | InItem(slot, i) -> Stdlib.List.append [ ((c.node, slot, i)) ] fromPath
  | _ -> fromPath


/// A fresh element for a list whose items expect `each`: a hole when items are filled by typing/picking
/// (expressions, types), or a filled template when they're structural (a match arm, a record field).
/// Where the caret goes when an item is inserted: inside it if it is a node, on the slot if it is a hole.
let firstEditableIn (at: Path) (item: Slot) : Caret =
  match item with
  | Filled child -> firstEditable at child
  | _ -> Caret.inSlot at "" 0

let newItemForEach (st: State) (each: Expect) : Slot =
  match Registry.forExpect st.reg each with
  | Some spec ->
    if (Stdlib.Bool.not (Stdlib.List.isEmpty spec.holeRules)) || (Stdlib.Bool.not (Stdlib.List.isEmpty spec.completions)) then
      Slot.Empty each
    else
      Slot.Filled spec.empty
  | None -> Slot.Empty each

/// Does `parent`'s spec draw `slot`'s items each led by `c`? The `|` of a match's cases is the case in
/// hand; the answer comes from the spec's own pieces, so nothing here knows what a match is.
let leadPunctOf (st: State) (parent: Node) (slot: String) : Stdlib.Option.Option<String> =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<String> =
    match spec with
    | Some sp -> Project.itemLeadPunct sp.pieces slot
    | None -> Stdlib.Option.Option.None
  match fromSpec (Registry.findExact st.reg parent.kind) with
  | Some p -> Stdlib.Option.Option.Some p
  | None -> fromSpec (Registry.findTypeLevel st.reg parent.kind)

/// The punctuation `parent`'s spec draws immediately before `slot`, if it draws any.
let slotLeadPunctOf (st: State) (parent: Node) (slot: String) : Stdlib.Option.Option<String> =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<String> =
    match spec with
    | Some sp -> Project.slotLeadPunct sp.pieces slot
    | None -> Stdlib.Option.Option.None
  match fromSpec (Registry.findExact st.reg parent.kind) with
  | Some p -> Stdlib.Option.Option.Some p
  | None -> fromSpec (Registry.findTypeLevel st.reg parent.kind)

/// Is `c` the REST of a multi-character punctuation the construct has already drawn just here?
///
/// `|` on an expression builds a pipe, and the pipe draws `|>` in full, so the `>` that completes the
/// arrow lands at the start of the fresh empty stage where it is already on the screen. The `::` of a cons
/// is the same sentence one slot over: the first `:` built the cons and the cons drew both colons.
///
/// The first character is deliberately NOT included -- that one is what built the construct, and typing it
/// again means something (a second `|` is `||`). Only the tail is redundant by construction.
let continuesDrawnPunct (lead: Stdlib.Option.Option<String>) (c: String) : Bool =
  match lead with
  | Some p -> ((Stdlib.String.length p) > 1) && (Stdlib.String.contains (Stdlib.String.dropFirst p 1) c)
  | None -> false

let leadsItemsWith (st: State) (parent: Node) (slot: String) (c: String) : Bool =
  match leadPunctOf st parent slot with
  // The FIRST character of a multi-character lead is enough to mean it, the same way the first character
  // of multi-character punctuation drawn ahead is. A pipe leads its stages with `|>` and the key you press
  // is `|`, so the exact comparison never matched and the rule that starts the next stage was unreachable
  // from anywhere but the pipe node itself.
  | Some lead -> (lead == c) || (((Stdlib.String.length lead) > 1) && (Stdlib.String.startsWith lead c))
  | None -> false

/// Is every leaf of this node still a hole? A freshly added list item is; one you have typed into isn't.
/// Is every part of this node still a hole?
///
/// A node with NOTHING in it is not "all holes", it is finished. `()` has no fields at all and an empty
/// list has no items, so `List.all` was vacuously true for both and the closing-bracket rule that drops
/// an untouched trailing item dropped them: `(1, ())` came out `(1)`, `[[], ()]` came out `[[]]`, and
/// `((), [])` came out `(())`. An empty container IS the value you meant.
///
/// So a node has to HAVE a hole before it can be all holes. `hasAny` is what separates "nothing was typed
/// here" from "what was typed here is empty".
let isAllHoles (n: Node) : Bool =
  let slotEmpty (s: Slot) : Bool =
    match s with
    | Empty _ -> true
    | Partial(_, _) -> false
    | Filled c -> isAllHoles c

  let hasAny =
    n.fields
    |> Stdlib.List.any (fun f ->
      let (_name, fld) = f
      match fld with
      | Text _ -> true
      | One _ -> true
      | Many(items, _) -> Stdlib.Bool.not (Stdlib.List.isEmpty items))

  hasAny
  && (n.fields
      |> Stdlib.List.all (fun f ->
        let (name, fld) = f
        match fld with
        | Text t -> t == ""
        | One s -> slotEmpty s
        | Many(items, _) -> items |> Stdlib.List.all (fun s -> slotEmpty s)))

/// The last node in an item's subtree, in reading order -- where the caret was when the lead punct that
/// made the next item was typed.
let lastNodePathUnder (root: Slot) (itemPath: Path) : Stdlib.Option.Option<Path> =
  match slotAtPath root itemPath with
  | Some s ->
    nodePaths s
    |> Stdlib.List.map (fun p -> Stdlib.List.append itemPath p)
    |> Stdlib.List.last
  | None -> Stdlib.Option.Option.None

/// Typing a list's lead punctuation AGAIN, in the fresh empty item it just made, means the OPERATOR was
/// meant after all: `2` then `|` then `|` inside a match is `2 || ⟨right⟩` in the arm you were in, not an
/// arm with an empty pattern. Stateless, and it needs to be: the lead punct is never valid at the START of
/// an empty item, and an item still made entirely of holes is one nothing has been typed into.
/// `xs` then Enter then `|>` -- the printer's own multi-line pipe, which it writes whenever the stages do
/// not fit on one line. Enter made a STATEMENT, correctly, and then `|` at the start of its empty `next`
/// went in as text: `xs / |>Stdlib.List.length`, spaces and all.
///
/// This is `leadPunctRevision`'s sentence with SLOT for item -- the lead punctuation typed again, in the
/// fresh empty thing the last key just made, means the operator was meant. There the fresh thing is a list
/// item; here it is a statement's second half.
///
/// Unambiguous, which is what separates it from the `|` in a fresh match arm that I left alone: nothing in
/// Darklang begins with `|>`, so a statement starting with one can only be a stage of the pipe above it.
let statementPipeRevision (st: State) (c: String) : Stdlib.Option.Option<State> =
  match st.caret.part with
  | InSlot slot ->
    if st.caret.offset != 0 then
      Stdlib.Option.Option.None
    else
      (match nodeAtPath st.root st.caret.node with
       | Some n ->
         // Which construct this is, and which of its slots is the fresh half, comes off the spec. It used
         // to name EStatement and its two slots; a language whose statement sequence is spelled some other
         // way could not have this at all.
         let seq =
           let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<(String * String)> =
             match spec with
             | Some sp -> sp.sequence
             | None -> Stdlib.Option.Option.None
           match fromSpec (Registry.findExact st.reg n.kind) with
           | Some p -> Stdlib.Option.Option.Some p
           | None -> fromSpec (Registry.findTypeLevel st.reg n.kind)

         match seq with
         | None -> Stdlib.Option.Option.None
         | Some pair ->
           let (beforeSlot, nextSlot) = pair
           if slot != nextSlot then
             Stdlib.Option.Option.None
           else
           (match (Node.slot n nextSlot, Node.slot n beforeSlot) with
            | (Some(Empty _), Some(Filled firstNode)) ->
              (match wrapRuleFor st.reg firstNode c with
               | Some rule ->
                 let wrapped = rule.wrap firstNode c
                 let st1 = commit st [ Edit.Replace(st.caret.node, Slot.Filled wrapped) ] st.caret
                 Stdlib.Option.Option.Some { st1 with caret = landAfterCommit st.caret.node wrapped }
               | None -> Stdlib.Option.Option.None)
            | _ -> Stdlib.Option.Option.None)
       | None -> Stdlib.Option.Option.None)
  | _ -> Stdlib.Option.Option.None

/// A list whose items are led by an OPERATOR punct -- a match's arms are led by `|` -- reads an operator
/// typed in a fresh last item as meaning the lead punct: `||` repeats it, `|>` continues it. So `a || b`
/// and `a |> b` can be typed where an arm's `|` was already drawn.
///
/// Not inside string content. This was the ninth rule in `typeOne`'s chain and the only one that did not
/// ask: with the caret between the quotes of an empty string in a second match arm, any operator wiped
/// the arm out and piped the PREVIOUS arm's right-hand side into a partial. `| [] -> opts` then a new arm
/// then `"` then `+` gave `| [] -> opts |> +`. The empty string is what made the arm read as fresh, and
/// the operator did the rest.
let leadPunctRevision (st: State) (c: String) : Stdlib.Option.Option<State> =
  if inContentText st then
    Stdlib.Option.Option.None
  else
  match enclosingListItem st.caret with
  | Some((parentPath, slot, i)) ->
    match nodeAtPath st.root parentPath with
    | Some parent ->
      let items = Node.items parent slot
      let fresh =
        match Stdlib.List.getAt items i with
        | Some(Filled n) -> isAllHoles n
        | Some(Empty _) -> true
        | _ -> false
      let lead = leadPunctOf st parent slot |> Stdlib.Option.withDefault ""
      // The typed character either REPEATS the lead punct (`||`) or continues it into another operator
      // (`|>`). Anything else is someone typing a pattern, and the new item is exactly what they wanted.
      let meansOperator =
        (lead != "") && (isOperatorChar st.reg.syntax lead)
        && ((c == lead) || (isOperatorChar st.reg.syntax c))
      // ...and only when the PREVIOUS keystroke was that lead punct, which is what makes this a revision
      // of something you just did rather than a reading of where you happen to be standing.
      //
      // Without it, an arm made by ENTER was indistinguishable from an arm made by an optimistic `|`:
      // same document, same caret, and the `|` that starts the next arm of a printed match was eaten as
      // the first half of an `||`. So `match n with` and three arms typed the way the printer writes them
      // failed from the second arm on -- and so did the `x || y` this rule exists for, since its `|` never
      // survived either.
      let followsTheLeadPunct = st.lastChar == (Stdlib.Option.Option.Some lead)

      if (i > 0) && fresh && followsTheLeadPunct && (i == ((Stdlib.List.length items) - 1)) && meansOperator then
        match lastNodePathUnder st.root (Path.item parentPath slot (i - 1)) with
        | Some p ->
          // Precedence picks WHICH node the operator takes, the same way typing it normally would, so
          // `1 + 2` then the doubled punct is `(1 + 2) || _` rather than `1 + (2 || _)`.
          let targetPath = reassocTarget st.reg st.root p (c ++ c)
          match nodeAtPath st.root targetPath with
          | Some target ->
            // Repeating it is an infix (`||`); continuing it is whatever rule the LEAD punct has of its own
            // (`|` builds a pipe, and the `>` that follows is swallowed in the fresh step as it always was).
            let wanted = if c == lead then "<operator>" else lead
            let rules =
              match Registry.findTypeLevel st.reg target.kind with
              | Some spec -> spec.wrapRules
              | None -> []
            match rules |> Stdlib.List.findFirst (fun r -> r.onChar == wanted) with
            | Some rule ->
              let wrapped = rule.wrap target (if c == lead then c ++ c else lead)
              let st1 =
                commit
                  st
                  [ Edit.Replace(targetPath, Slot.Filled wrapped), Edit.RemoveItem(parentPath, slot, i) ]
                  st.caret
              if rule.opSlot == "" then
                Stdlib.Option.Option.Some(typeOne { st1 with caret = landAfterCommit targetPath wrapped } c)
              else
                let opLen = Node.text wrapped rule.opSlot |> Stdlib.Option.withDefault "" |> Stdlib.String.length
                Stdlib.Option.Option.Some { st1 with caret = Caret.inText targetPath rule.opSlot opLen }
            | None -> Stdlib.Option.Option.None
          | None -> Stdlib.Option.Option.None
        | None -> Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None

/// The whole expression that ENDS where the caret is.
///
/// Climbs while the parent is the same KIND of thing, still ends here, and is not one of the constructs
/// that swallow what follows them. So at the end of the `2` in `1 + 2` the answer is the infix, and at the
/// end of a `let`'s body it is the body rather than the let -- a statement written after a let belongs
/// INSIDE it, which is what the language means too.
let statementTarget (st: State) (p: Path) : Path =
  // A slot that will not hold a statement will not let one climb OUT of it either.
  //
  // The climb below is right for statements: the body is the last thing under a `let`, so a pipe typed
  // at the end of it takes the whole body. It is wrong for a bracketed collection, where an item is
  // bounded by the `]`: being the LAST item does not make the list part of what the pipe swallows.
  // `[1 |> f` was building `[1] |> f`, and `[1, 2 |> f` gave `[1, 2] |> f`, so the last element of a
  // list could never be piped.
  //
  // `(1 |> f, 2)` worked, and not for a good reason -- the tuple carried a trailing empty hole, so its
  // first item was not the last node under it. That accident was hiding this.
  //
  // Asked of `slotRefusesSequence`, which Enter already asks. One question, and the wrap path was not
  // asking it.
  if slotRefusesSequence st p then
    p
  else

  match nodeAtPath st.root p with
  | Some child ->
    (match Path.parent p with
     | Some parentPath ->
       (match nodeAtPath st.root parentPath with
        | Some parent ->
          if Stdlib.Bool.not (Kind.sameType parent.kind child.kind) then
            p
          else if (Project.nodePower parent) == Darklang.LanguageTools.Precedence.swallowingPower then
            p
          else if (lastNodePathUnder st.root parentPath) == (lastNodePathUnder st.root p) then
            statementTarget st parentPath
          else
            p
        | None -> p)
     | None -> p)
  | None -> p

/// Does the slot this node sits in refuse to hold a statement?
///
/// The spec of the node's PARENT names them. `{ width = 1; height = 2 }` with the caret after the `2`
/// used to grow `height = 2 / ⟨next⟩` -- a hole drawn between the braces, where a reader sees the next
/// FIELD rather than a second statement in the field's value.
///
/// Asked of the slot rather than of the node or the list, because neither of those separates the cases.
/// An `EInt` sequences perfectly well in a body. And a match arm's rhs IS a statement position while its
/// list is capped exactly like a resolved record's fields are, so "the list cannot grow" is true of both.
let slotRefusesSequence (st: State) (p: Path) : Bool =
  match (Path.parent p, Path.last p) with
  | (Some parentPath, Some step) ->
    let slotName =
      match step with
      | Into slot -> slot
      | Item(slot, _) -> slot

    (match nodeAtPath st.root parentPath with
     | Some parent ->
       (match Registry.find st.reg parent.kind with
        | Some spec -> Stdlib.List.member spec.noSequence slotName
        | None -> false)
     | None -> false)
  | _ -> false

/// Enter at the end of a finished expression: whatever the spec says a NEWLINE does there.
///
/// Only when nothing is left unfinished. While a hole remains anywhere, Enter's job is to take you to it,
/// and a key that quietly did two different things depending on the document would be worse than one that
/// does nothing.
let sequenceHere (st: State) : Stdlib.Option.Option<State> =
  if Stdlib.Bool.not (Stdlib.List.isEmpty (blanks st.root)) then
    Stdlib.Option.Option.None
  else
    let targetPath = statementTarget st st.caret.node

    if slotRefusesSequence st targetPath then
      Stdlib.Option.Option.None
    else

    match nodeAtPath st.root targetPath with
    | Some target ->
      (match wrapRuleFor st.reg target "\n" with
       | Some rule ->
         let wrapped = rule.wrap target "\n"
         let st1 = commit st [ Edit.Replace(targetPath, Slot.Filled wrapped) ] st.caret
         Stdlib.Option.Option.Some { st1 with caret = landAfterCommit targetPath wrapped }
       | None -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None

/// Typing that character at the end of a finished item starts the next one.
/// Is the caret at the END of item `i` of this list? Starting the NEXT item is meaningless anywhere else,
/// and the difference matters: `|` on a match arm's PATTERN is an or-pattern, and that spec's own wrap rule
/// has to keep winning there.
///
/// "At the end" has four shapes, which is how the first version of this shipped broken -- it knew about
/// one. Type `2` and the caret is IN the number's text; type `"zero"` and the closing quote leaves it AFTER
/// the node; type `[1]` and it leaves you after the LIST, while the item's last node is the `1` inside it;
/// type a name you have not settled and it is a PARTIAL, whose caret is in the slot rather than any text.
let atEndOfItem (st: State) (parentPath: Path) (slot: String) (i: Int) : Bool =
  let lastPath = lastNodePathUnder st.root (Path.item parentPath slot i)
  let onLastNode = lastPath == Stdlib.Option.Option.Some st.caret.node
  // Being AFTER a container is being after everything in it.
  let afterLastNode =
    match lastPath with
    | Some p -> Path.isPrefixOf st.caret.node p
    | None -> false
  match st.caret.part with
  | AfterNode -> afterLastNode
  | InText textSlot ->
    onLastNode
    && (match nodeAtPath st.root st.caret.node with
        | Some n -> st.caret.offset >= (Stdlib.String.length (Node.text n textSlot |> Stdlib.Option.withDefault ""))
        | None -> false)
  // An empty hole is `InSlot` too, and typing the lead punct there must NOT add an item: there is nothing
  // in this one yet. The difference is whether anything has been typed.
  | InSlot _ ->
    onLastNode
    && (match Caret.slotPath st.caret with
        | Some sp ->
          (match slotAtPath st.root sp with
           | Some(Partial(typed, _)) -> st.caret.offset >= (Stdlib.String.length typed)
           | _ -> false)
        | None -> false)
  | _ -> false

/// The character a spec draws BETWEEN the items of this list, if it draws one.
let sepPunctOf (st: State) (parent: Node) (slot: String) : Stdlib.Option.Option<String> =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<String> =
    match spec with
    | Some sp -> Project.itemSepPunct sp.pieces slot
    | None -> Stdlib.Option.Option.None
  match fromSpec (Registry.findExact st.reg parent.kind) with
  | Some p -> Stdlib.Option.Option.Some p
  | None -> fromSpec (Registry.findTypeLevel st.reg parent.kind)

/// Is `slot`'s list one whose items are written with only a space between them (a lambda's parameters,
/// a call's arguments)? Asked of the spec, like every other separator question.
let spaceSepOf (st: State) (parent: Node) (slot: String) : Bool =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Bool =
    match spec with
    | Some sp -> Project.itemSepIsSpace sp.pieces slot
    | None -> false
  (fromSpec (Registry.findExact st.reg parent.kind)) || (fromSpec (Registry.findTypeLevel st.reg parent.kind))

/// Is the node at `sp` an item of a list whose items are separated by a space? Then a space at the end of
/// it means the next item, not "done with the list".
let inSpaceSepList (st: State) (sp: Path) : Bool =
  match (Path.last sp, Path.parent sp) with
  | (Some(Item(slot, _)), Some(parentPath)) ->
    (match nodeAtPath st.root parentPath with
     | Some parent -> spaceSepOf st parent slot
     | None -> false)
  | _ -> false

/// Is the caret standing in a list that a spec draws as a call's ARGUMENTS?
///
/// Enter grows a sequence, and a sequence is something you build up deliberately: a list's items, a
/// record's fields, a match's arms, a lambda's params. Arguments are not that -- you write them by typing
/// one after another -- and a RESOLVED call hid the difference, because its args are capped at its arity
/// and Enter found the sibling refused anyway. Applying a bare name has no arity to cap, and Enter there
/// grew the arguments for ever: `add 1 2` then Enter gave `add 1 2 ⟨arg⟩` with no way to say "done".
/// Does typing `ch` close the ARGUMENT list the caret is in? See `Syntax.bracketPairs`.
let closesAnArgList (st: State) (c: Caret) (ch: String) : Bool =
  (inArgSlotsList st c)
  && (st.reg.syntax.bracketPairs
      |> Stdlib.List.any (fun pair ->
        let (_open, close) = pair
        close == ch))

let inArgSlotsList (st: State) (c: Caret) : Bool =
  match enclosingListItem c with
  | Some((parentPath, slot, _)) ->
    (match nodeAtPath st.root parentPath with
     | Some parent ->
       let fromSpec (spec: Stdlib.Option.Option<Spec>) : Bool =
         match spec with
         | Some sp -> Project.isArgSlots sp.pieces slot
         | None -> false
       (fromSpec (Registry.findExact st.reg parent.kind)) || (fromSpec (Registry.findTypeLevel st.reg parent.kind))
     | None -> false)
  | None -> false

/// Is the item the caret stands in an untouched BLANK -- a bare hole, not a node with holes in it?
///
/// The difference decides whether Enter may add another. A list's items are bare holes: `[a,` already put
/// you in an empty one, so the line break that follows it in the printer's multi-line layout was adding a
/// SECOND, and `[a, / b]` came out `[a, ⟨item⟩, b]`. A match's arms are not -- a fresh arm is a FILLED
/// MatchCase whose slots happen to be holes -- and Enter adding one of those is pinned behaviour, with a
/// comment saying so.
///
/// I had this as "does the item have holes", which cannot tell the two apart and broke the match.
let itemIsBlank (st: State) (c: Caret) : Bool =
  match enclosingListItem c with
  | Some((parentPath, slot, i)) ->
    (match slotAtPath st.root (Path.item parentPath slot i) with
     | Some(Empty _) -> true
     | _ -> false)
  | None -> false

/// Does the item the caret stands in still hold something unfilled? Growing the enclosing list past that
/// skips over what you are in the middle of writing.
let itemHasHoles (st: State) (c: Caret) : Bool =
  match enclosingListItem c with
  | Some((parentPath, slot, i)) ->
    (match slotAtPath st.root (Path.item parentPath slot i) with
     | Some s -> Stdlib.Bool.not (Stdlib.List.isEmpty (holes s))
     | None -> false)
  | None -> false

/// `addSibling` for the ENTER key. It does not grow an argument list, and it does not grow past a hole in
/// the item you are standing in.
///
/// Enter already declines when the candidate it just COMMITTED has holes of its own -- that is what stops
/// `fun` in an argument giving two parameters. This is the same judgement about an item that was already
/// there, which is the case the commit path cannot see.
let addSiblingOnEnter (st: State) : Stdlib.Option.Option<State> =
  if (inArgSlotsList st st.caret) || (itemIsBlank st st.caret) then Stdlib.Option.Option.None
  else addSibling st

/// The (list slot, text case) of a construct whose content is text with embedded holes, if it is one.
let segmentsOf (reg: Registry) (n: Node) : Stdlib.Option.Option<Segments> =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<Segments> =
    match spec with
    | Some sp -> sp.segments
    | None -> Stdlib.Option.Option.None
  match fromSpec (Registry.findExact reg n.kind) with
  | Some p -> Stdlib.Option.Option.Some p
  | None -> fromSpec (Registry.findTypeLevel reg n.kind)

/// Is `n` the literal-TEXT part of the segmented construct `parent`, rather than an embedded hole?
let isTextSegment (reg: Registry) (parent: Node) (n: Node) : Bool =
  match segmentsOf reg parent with
  | Some seg -> n.kind.case == Stdlib.Option.Option.Some seg.textCase
  | None -> false

/// Does this node's spec draw `c` as punctuation? Asked of the construct that encloses the caret, to
/// recognise the closer it drew.
let drawsPunct (st: State) (n: Node) (c: String) : Bool =
  let fromSpec (spec: Stdlib.Option.Option<Spec>) : Bool =
    match spec with
    | Some sp -> Stdlib.List.member (Project.punctTexts sp.pieces) c
    | None -> false
  (fromSpec (Registry.findExact st.reg n.kind)) || (fromSpec (Registry.findTypeLevel st.reg n.kind))

/// The label a node already carries for the slot at `sp`: a record field's NAME, which its spec draws
/// just before the value. `None` when the spec draws no label there, or the node's is still blank.
let labelForSlot (st: State) (sp: Path) : Stdlib.Option.Option<String> =
  match (Path.last sp, Path.parent sp) with
  | (Some(Into valueSlot), Some(parentPath)) ->
    (match nodeAtPath st.root parentPath with
     | Some parent ->
       let fromSpec (spec: Stdlib.Option.Option<Spec>) : Stdlib.Option.Option<String> =
         match spec with
         | Some sp2 -> Project.labelTextSlot sp2.pieces valueSlot
         | None -> Stdlib.Option.Option.None

       (match fromSpec (Registry.findExact st.reg parent.kind) with
        | Some ns -> Stdlib.Option.Option.Some ns
        | None -> fromSpec (Registry.findTypeLevel st.reg parent.kind))
       |> Stdlib.Option.andThen (fun ns -> Node.text parent ns)
       |> Stdlib.Option.andThen (fun t -> if t == "" then Stdlib.Option.Option.None else Stdlib.Option.Option.Some t)
     | None -> Stdlib.Option.Option.None)
  | _ -> Stdlib.Option.Option.None

/// The bare text sitting in a slot: what is still being typed, or the content of a leaf that settled.
let slotLeafText (st: State) (sp: Path) : Stdlib.Option.Option<String> =
  match slotAtPath st.root sp with
  | Some(Partial(t, _)) -> Stdlib.Option.Option.Some t
  | Some(Filled n) -> mergeSlotOf st.reg n |> Stdlib.Option.andThen (fun ms -> Node.text n ms)
  | _ -> Stdlib.Option.Option.None

/// The slot the caret is working in, whether it is standing in one, typing in a leaf inside one, or
/// sitting just after it. `Caret.slotPath` only answers the first.
let caretSlotPath (c: Caret) : Stdlib.Option.Option<Path> =
  match c.part with
  | AfterNode -> Stdlib.Option.Option.Some c.node
  | InText _ -> Stdlib.Option.Option.Some c.node
  | _ -> Caret.slotPath c

/// Typing the separator a spec draws BETWEEN a list's items, at the end of a finished item, starts the
/// next one. Same shape as the lead-punct rule and tried the same way, from the inside out.
///
/// `,` was written into the kernel, in two places, so this was the `,` of a list and nothing else. Asking
/// the projection means a DSL whose lists are separated by `;` gets the key it actually writes.
let sepPunctSibling (st: State) (c: String) : Stdlib.Option.Option<State> =
  enclosingListItems st.caret
  |> Stdlib.List.filter (fun entry ->
    let (parentPath, slot, i) = entry
    match nodeAtPath st.root parentPath with
    | Some parent ->
      ((sepPunctOf st parent slot) == Stdlib.Option.Option.Some c) && (atEndOfItem st parentPath slot i)
    | None -> false)
  |> Stdlib.List.head
  |> Stdlib.Option.andThen (fun entry ->
    let (parentPath, slot, i) = entry
    // A separator typed between items that ALREADY EXIST and are not finished means "on to the next one",
    // not "put another one here". A record's fields come from its type: typing `80` then `;` in
    // `Size { width = ⟨w⟩; height = ⟨h⟩ }` means the height, and inserting a third field between them is
    // not something the type allows. A list is the other way round -- `[1, 2]` and a `,` after the `1` is a
    // new element -- and there the next item has nothing left to fill, so this does not fire.
    let nextHasHole =
      match nodeAtPath st.root parentPath with
      | Some parent ->
        (match Stdlib.List.getAt (Node.items parent slot) (i + 1) with
         | Some(Filled child) ->
           Stdlib.Bool.not (Stdlib.List.isEmpty (holes (Slot.Filled child)))
         | _ -> false)
      | None -> false
    if nextHasHole then
      match slotAtPath st.root (Path.item parentPath slot (i + 1)) with
      | Some(Filled child) ->
        // To the next HOLE in it, not its first editable text: a record field's first editable is its NAME,
        // which is already written, so `;` landed the caret in `height` and typing put digits in the name.
        Stdlib.Option.Option.Some
          { st with caret = landAfterCommit (Path.item parentPath slot (i + 1)) child }
      | _ -> addSiblingAt st parentPath slot i
    else
      addSiblingAt st parentPath slot i)

/// Typing the character a spec draws before each of a list's items, at the end of a finished item, starts
/// the next item.
///
/// Tried from the INSIDE OUT, because a node sits inside several lists at once: at the end of an enum
/// case's last field, the nearest list is that case's FIELDS, and the one that draws a `|` is the enum's
/// CASES one further out. Looking only at the nearest meant `|` there went in as a literal character.
let leadPunctSibling (st: State) (c: String) : Stdlib.Option.Option<State> =
  enclosingListItems st.caret
  |> Stdlib.List.filter (fun entry ->
    let (parentPath, slot, i) = entry
    match nodeAtPath st.root parentPath with
    | Some parent -> (leadsItemsWith st parent slot c) && (atEndOfItem st parentPath slot i)
    | None -> false)
  |> Stdlib.List.head
  |> Stdlib.Option.andThen (fun entry ->
    let (parentPath, slot, i) = entry
    addSiblingAt st parentPath slot i)


/// Enter inside a list adds a sibling element after the current one and moves to it. This is how you grow
/// a match (a new arm), a list, a record, a set of parameters -- without leaving the keyboard row.
/// Add an element after item `i` of `parentPath`'s `slot`, and move to it.
/// Is this Many at its spec's cap? `addSiblingAt` asks the same question to refuse to grow; this is the
/// half a caller needs to tell "full" apart from "not a list at all", which are the same `None` there.
let listIsFull (st: State) (parentPath: Path) (slot: String) : Bool =
  match nodeAtPath st.root parentPath with
  | Some n ->
    (match Node.field n slot with
     | Some(Many(items, _)) ->
       (match Registry.find st.reg n.kind with
        | Some spec ->
          (match spec.maxItems n slot with
           | Some cap -> (Stdlib.List.length items) >= cap
           | None -> false)
        | None -> false)
     | _ -> false)
  | None -> false

let addSiblingAt (st: State) (parentPath: Path) (slot: String) (i: Int) : Stdlib.Option.Option<State> =
    match nodeAtPath st.root parentPath with
    | Some n ->
      match Node.field n slot with
      | Some(Many(items, each)) ->
        // A slot the spec caps does not grow past its cap. An `if`'s `else` is a Many holding zero or
        // one, used as an option, and typing past a settled else added a SECOND branch: the drawing
        // gained an `else` that lowering threw away, so the screen showed a program nobody had.
        let capped =
          match Registry.find st.reg n.kind with
          | Some spec ->
            (match spec.maxItems n slot with
             | Some cap -> (Stdlib.List.length items) >= cap
             | None -> false)
          | None -> false

        if capped then
          Stdlib.Option.Option.None
        else
        // If the next element is already an empty hole (e.g. a tuple's second slot), move to it rather
        // than inserting a new one. Otherwise add a sibling after this one.
        match Stdlib.List.getAt items (i + 1) with
        | Some(Empty _) -> Stdlib.Option.Option.Some { st with caret = Caret.inItem parentPath slot (i + 1) 0 }
        | _ ->
          let item = newItemForEach st each
          let st1 = commit st [ Edit.InsertItem(parentPath, slot, i + 1, item) ] st.caret
          let caret =
            match item with
            | Filled child -> firstEditable (Path.item parentPath slot (i + 1)) child
            | _ -> Caret.inItem parentPath slot (i + 1) 0
          Stdlib.Option.Option.Some { st1 with caret = caret }
      | _ -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.None

/// Start the next item in the nearest list that will take one.
///
/// From the INSIDE OUT, past any list that is capped, the way `leadPunctSibling` already walks. A node
/// sits inside several lists at once, and the nearest is not always the one that can grow: at the end of
/// `Ok(1)` in a match arm the nearest list is the constructor's FIELDS, whose length the case declares.
/// Stopping there meant Enter opened a statement inside the arm rather than starting the next arm.
let addSibling (st: State) : Stdlib.Option.Option<State> =
  enclosingListItems st.caret
  |> Stdlib.List.fold Stdlib.Option.Option.None (fun acc entry ->
    match acc with
    | Some _ -> acc
    | None ->
      let (parentPath, slot, i) = entry
      addSiblingAt st parentPath slot i)

/// The same walk, stopping at the first list that is FULL rather than climbing past it.
///
/// Enter wants the climb: at the end of `Ok(1)` in a match arm, Enter means the next arm, and the arm
/// list is two levels out. TYPING a value there does not -- a full fixed-arity slot is the construct
/// saying it is complete, so the value belongs to whatever comes after it, not to the enclosing list.
/// `match input Ok v 1` started a second arm `| 1 ->` and left the first one's right-hand side empty.
///
/// It only became reachable when a space stopped walking out of a pattern on its own, which is the same
/// keystroke arriving somewhere it had never arrived before.
let addSiblingNotPastAFullOne (st: State) : Stdlib.Option.Option<State> =
  enclosingListItems st.caret
  |> Stdlib.List.fold (false, Stdlib.Option.Option.None) (fun acc entry ->
    let (stopped, found) = acc

    if stopped then
      acc
    else
      match found with
      | Some _ -> acc
      | None ->
        let (parentPath, slot, i) = entry

        match addSiblingAt st parentPath slot i with
        | Some next -> (true, Stdlib.Option.Option.Some next)
        | None -> ((listIsFull st parentPath slot), Stdlib.Option.Option.None))
  |> fun r ->
    let (_stopped, found) = r
    found


// --- Keys ---

let isPrintable (kp: Stdlib.Cli.UI.Widget.KeyPress) : Bool =
  match kp.char with
  | Some c -> (Stdlib.String.length c) >= 1 && (Stdlib.Bool.not kp.modifiers.ctrl) && (Stdlib.Bool.not kp.modifiers.alt)
  | None -> false

let onKeyInsert (st: State) (kp: Stdlib.Cli.UI.Widget.KeyPress) : Outcome =
  let handled (s: State) : Outcome = Stdlib.Cli.UI.Widget.Outcome.Handled s
  let completing = Stdlib.Bool.not (Stdlib.List.isEmpty (candidates st))
  // Leaving a partial (Esc, save) resolves it if it can be resolved, so `x + y` then Esc is an
  // expression, not an expression with an unresolved tail.
  let settled = resolvePartial st |> Stdlib.Option.withDefault st
  match kp.key with
  | Escape ->
    // Escape dismisses a live menu first (staying in INSERT), so you can wave off completions without
    // leaving the field; a second Escape settles and leaves to NAV. But if what you typed is exactly a
    // candidate, there's nothing to wave off -- settle it and leave in one Escape.
    if (onPartial st) && completing && (Stdlib.Option.isNone (exactCandidate st)) then
      handled { st with menuDismissed = true }
    else
      let here = navPath settled
      handled { settled with mode = Mode.Nav; caret = navCaretFor settled.root here }
  | LeftArrow -> if kp.modifiers.ctrl then handled (moveSibling st (-1)) else handled (moveLeft st)
  | RightArrow -> if kp.modifiers.ctrl then handled (moveSibling st 1) else handled (moveRight st)
  // Ctrl before the menu check: moving a node is not choosing a candidate, and a list you want to reorder
  // is very often one you are mid-way through typing.
  | UpArrow ->
    if kp.modifiers.ctrl then handled (moveSibling st (-1))
    elif completing then handled (cycleCandidate st (-1))
    else handled (moveVertical st (-1))
  | DownArrow ->
    if kp.modifiers.ctrl then handled (moveSibling st 1)
    elif completing then handled (cycleCandidate st 1)
    else handled (moveVertical st 1)
  | Home -> handled (moveLineStart st)
  | End -> handled (moveLineEnd st)
  | Enter ->
    // The keyword the editor already drew, typed back. Space has always put the hole back here; Enter
    // settled the keyword into a node and then added a sibling around it, so `match n with <Enter>` built
    // a first arm whose pattern was the literal `with` and left the real one to be typed in a second.
    // Same question, two keys, two answers.
    match clearsDrawnKeyword st with
    | Some cleared -> handled cleared
    | None ->
    // Just after a finished value, Enter means what space means: on to the next hole. Since space started
    // landing the caret there rather than jumping, Enter at that spot did NOTHING, and a key that does
    // nothing is the thing to avoid.
    if st.caret.part == Part.AfterNode then
      // Start the next ITEM before starting the next statement, which is the order the branch below has
      // always used. Skipping it here made Enter depend on the SHAPE of what you had just written: after
      // a match arm whose rhs was `1` or `v` the caret sits in a text slot and Enter added the next arm,
      // while after `"zero"` the closing quote leaves it AfterNode and Enter opened a statement inside
      // the arm instead. Same key, same place, two answers.
      match addSibling settled with
      | Some added -> handled added
      | None ->
        match sequenceHere settled with
        | Some seq -> handled seq
        | None -> handled (nextHole st)
    else
    // In a sequence (list element, match arm, record field), Enter settles what you typed and starts the
    // next item -- even with a menu up, so a bound variable that matches the rhs doesn't hijack Enter into
    // just accepting the completion. On a standalone hole, Enter accepts the menu (so `le<Enter>` builds
    // let). A keyword/single-candidate is still committed on the way (so a construct can be built here too).
    // A candidate the DOCUMENT implied -- the cases of the enum this match is on, the fields of the record
    // you typed a `.` after -- is a specific answer, and Enter takes it wherever you are. Everything below
    // is about the GENERIC menu, which on a fresh hole is mostly "everything that could go here" and whose
    // first entry Enter must NOT take; these are not that. Showing you the cases and not letting you pick
    // one is worse than not showing them.
    // Enter ACCEPTS the choice, wherever the menu came from.
    //
    // It used to take one only when the candidate was `fromContext` -- a match's offered cases -- so the
    // same two keystrokes worked in one menu and silently stepped past another, with the status line
    // promising `Enter accept` in both. The rule that made that necessary was the defensive one: a
    // highlighted first row on a fresh hole must not be committable, because the generic menu there is
    // "everything that could go here".
    //
    // That is fixed at the source instead: a blank now starts with NOTHING chosen, so there is no default
    // to take by accident and Enter can mean one thing everywhere.
    if completing && (Stdlib.Bool.not (onPartial st)) && (Stdlib.Option.isSome (selectedCandidate st)) then
      handled (commitCandidate st)
    else

    match enclosingListItem st.caret with
    | Some _ ->
      // Only a menu you opened by TYPING is Enter's to accept. On an untouched hole the menu is just the
      // list of everything that could go here, and committing its first entry meant a bare Enter built a
      // `let`, or gave a match arm the pattern `true`.
      if completing && (onPartial st) then
        // A menu is up. If what you typed IS a candidate (an in-scope variable), you're done: commit it
        // and start the next item. If the menu offers something else to accept (a store function like
        // `List.len` -> `Stdlib.List.length`), accept it and stay.
        let committed = commitCandidate st
        // ...but only if what was committed has nothing left to fill. A candidate WITH holes leaves the
        // caret INSIDE itself, and "start the next item" then meant the new node's own list: `fun` in a
        // function argument committed the lambda, landed in its first parameter, and added a SECOND
        // parameter, so `List.map (fun ⟨param⟩ ⟨param⟩ -> ⟨body⟩)` was what you got for typing `fun`.
        // `blanks`, not `holes`. An empty TEXT field is something left to fill just as much as an empty
        // slot is, and `landAfterCommit` learned that long ago: "an empty TEXT field is the next thing to
        // type too, and landing off `holes` walked past a parameter with no name straight into its type".
        //
        // This one never learned it. `int` in a match pattern commits to an `MPInt` whose only blank is
        // its digits TEXT, so `holes` said there was nothing left, and Enter committed the pattern and
        // then started the next arm -- leaving an empty `| ⟨digits⟩ ->` behind and the caret two arms
        // away from the number you were about to type.
        let leavesHoles =
          match selectedCandidate st with
          | Some c -> Stdlib.Bool.not (Stdlib.List.isEmpty (blanks (Slot.Filled c.node)))
          | None -> false
        // A candidate you did not name EXACTLY, which arrives with blanks in it, and which you have barely
        // typed any of, is not what you were reaching for -- it is a construct, and every construct has
        // its own way in. `| 0 -> c` then
        // Enter to start the next arm replaced the `c` with `''`, because `char` was the one thing in the
        // menu starting with a `c`. Seven of the twenty-six letters did this: c f i l m s t, which are
        // char, fun, if, let, match, string and tuple, and are also the names anyone gives a variable.
        //
        // The other three combinations stay as they were. Named exactly and complete: commit and move on.
        // Named exactly and with holes: you asked for it, commit and stay inside it. Not exact but
        // complete: a store function you were part-way through (`List.len` -> `Stdlib.List.length`),
        // accept it and stay.
        let namedIt = Stdlib.Option.isSome (exactCandidate st)
        // How much of the candidate you actually typed, as a PROPORTION of it. An absolute threshold does
        // not work: `fun` and `let` are three characters long, so every prefix of them is short, and `fu`
        // is plainly reaching for `fun`. Half is the line -- more than half of it and you meant it.
        //
        //     fu / fun               0.67   meant it
        //     le / let               0.67   meant it
        //     Stdlib.List.leng       0.89   meant it
        //     i  / if                0.5    did not
        //     c  / char              0.25   did not
        //     l  / let               0.33   did not
        //
        // A candidate the DOCUMENT implied is exempt whatever its length: the cases of the enum this match
        // is on, the fields of the record you typed a `.` after. `S` for `Some` is a quarter of the label
        // and is still a specific answer to a specific question, which is what `fromContext` means.
        let barelyTyped =
          match selectedCandidate st with
          | Some cand ->
            if cand.fromContext then
              false
            else
              // Compared on the LAST segment of each, because a completion fills in the qualifier for you:
              // `Size` becomes `Stdlib.Cli.Tui.Size`, and against the whole label four characters looks
              // like a fifth of it when it is in fact the entire part anyone types. `Stdlib.List.leng`
              // reduces to `leng` against `length` and is still two thirds.
              let lastSegment (t: String) : String =
                Stdlib.String.split t "." |> Stdlib.List.last |> Stdlib.Option.withDefault t
              (match Caret.slotPath st.caret |> Stdlib.Option.andThen (fun sp -> slotLeafText st sp) with
               | Some typed ->
                 ((Stdlib.String.length (lastSegment typed)) * 2) <= (Stdlib.String.length (lastSegment cand.label))
               | None -> false)
          | None -> false
        if namedIt && (Stdlib.Bool.not leavesHoles) then
          match addSibling committed with
          | Some added -> handled added
          | None -> handled committed
        elif (Stdlib.Bool.not namedIt) && leavesHoles && barelyTyped then
          match addSiblingOnEnter settled with
          | Some added -> handled added
          | None ->
            match sequenceHere settled with
            | Some seq -> handled seq
            | None -> handled settled
        else
          handled committed
      else
        // SETTLE what you typed, then start the next item. This added the sibling first and only fell back
        // to settling when there was nothing to add, so in a list whose items are TYPED rather than picked
        // -- an enum's cases, a record's fields -- every item but the last stayed a partial. It drew
        // exactly like the real thing, and `type Colour = | Red | Green | Blue` then refused to save with
        // "unresolved: Red".
        match addSiblingOnEnter settled with
        | Some added -> handled added
        | None ->
          match sequenceHere settled with
          | Some seq -> handled seq
          | None ->
            // Nothing to add and nothing to sequence: go to the next hole, which is what the AfterNode
            // branch above already does. They disagreed, and a capped list is where it showed --
            // `Stdlib.List.map xs` then Enter had a `<fn>` hole waiting and did NOTHING, because the
            // sibling was refused (the call is as long as its arity) and the blank stopped the statement.
            let onABlank =
              match slotUnder settled with
              | Some(Empty _) -> true
              | _ -> false

            let moved = nextHole settled
            if onABlank || (moved.caret == st.caret) then
              (if settled == st then Stdlib.Cli.UI.Widget.Outcome.Ignored else handled settled)
            else handled moved
    | None ->
      if completing && (onPartial st) then handled (commitCandidate st)
      else
        // Same rule outside a list: settle first.
        match addSiblingOnEnter settled with
        | Some added -> handled added
        | None ->
          match sequenceHere settled with
          | Some seq -> handled seq
          | None ->
            // ...and then the next hole -- but not when the caret is ALREADY in one. Enter meaning "on to
            // the next blank" makes sense from something finished; from a blank you have not filled yet it
            // skips the very thing it is pointing at. The printer's multi-line record is where that shows:
            // `Size {` leaves the caret in the first field's VALUE, and the Enter that ends that line sent
            // it to the SECOND field, so `width = 1` was written into `height`.
            //
            // A line break in printed source is layout. It should cost nothing to type.
            //
            // The branch above has done the next-hole step since a capped argument list
            // showed the two disagreeing. They disagreed here too, and what decided it was the SHAPE of
            // the thing just finished: a string leaves the caret AfterNode, which has this fallback, and
            // a number leaves it in the digits, which did not. So `let x = "a"` then Enter reached the
            // body and `let x = 1` then Enter did nothing at all -- and the next keystroke was refused by
            // the number, so `if a then 1` then Enter then `2` quietly made the number 12.
            //
            // `sequenceHere` is what makes this the right answer rather than a guess: it declines while
            // the document still holds a blank, which is already the rule "fill the holes before starting
            // a new statement". The hole it declined for is the one to go to.
            let moved = nextHole settled
            if moved.caret != st.caret then
              handled moved
            else if settled == st then Stdlib.Cli.UI.Widget.Outcome.Ignored
            else handled settled
  | Tab ->
    if kp.modifiers.shift then handled (prevHole st)
    // Tab commits a partial that's being typed, then advances -- UNLESS the commit landed on a fresh hole
    // (a construct like `let`, or a function's argument holes), where you want to fill it, not skip past.
    // So `let<Tab>` sits at the name, but `r<Tab>` (an in-scope variable) finalises and moves to the next
    // hole rather than swallowing what you type next into the same slot.
    // A KEYWORD candidate only, for the same reason space wants one. Tab's own comment says what it
    // means here -- "`r<Tab>` (an in-scope variable) finalises and moves to the next hole" -- so Tab is
    // settle-and-advance, not take-what-is-shown. Once `record update` was in the menu, `{ r <Tab>` took
    // it and built a nested update where the pin wanted the variable `r`.
    //
    // ENTER is the key that means take what is shown, and it still does.
    elif completing
         && (onPartial st)
         && (selectedCandidate st |> Stdlib.Option.map (fun c -> c.keyword) |> Stdlib.Option.withDefault false)
         && ((Stdlib.Option.isSome (exactCandidate st)) || (Stdlib.Bool.not (inBindingPosition st))) then
      let committed = commitCandidate st

      if onABlankNow committed then handled committed else handled (nextHole committed)
    // Same for a candidate the DOCUMENT implied, which is not a partial: the node is already there and
    // only its text is half-written. `S<Tab>` in a pattern used to move on and leave a case called `S`,
    // which is a name the type does not have.
    elif completing
         && (selectedCandidate st |> Stdlib.Option.map (fun c -> c.fromContext) |> Stdlib.Option.withDefault false) then
      let committed = commitCandidate st

      if onABlankNow committed then handled committed else handled (nextHole committed)
    else
      match resolvePartial st with
      | Some resolved -> handled (stayIfOnHole resolved nextHole)
      | None -> handled (nextHole st)
  | Backspace -> handled (backspace st)
  | _ ->
    if kp.modifiers.ctrl then
      match kp.key with
      | Z -> handled (undo st)
      | Y -> handled (redo st)
      | S -> Stdlib.Cli.UI.Widget.Outcome.Emitted({ settled with message = "" }, Msg.Save settled.root)
      | _ -> Stdlib.Cli.UI.Widget.Outcome.Ignored
    elif isPrintable kp then
      match kp.char with
      | Some c -> handled (typeChar st c)
      | None -> Stdlib.Cli.UI.Widget.Outcome.Ignored
    else
      Stdlib.Cli.UI.Widget.Outcome.Ignored

let onKeyPalette (st: State) (kp: Stdlib.Cli.UI.Widget.KeyPress) : Outcome =
  let handled (s: State) : Outcome = Stdlib.Cli.UI.Widget.Outcome.Handled s
  match kp.key with
  | Escape -> handled (closePalette st)
  | UpArrow -> handled (movePalette st (-1))
  | DownArrow -> handled (movePalette st 1)
  | Enter -> handled (runPaletteAction st)
  | Backspace ->
    let f = st.paletteFilter
    let trimmed = if (Stdlib.String.length f) > 0 then Stdlib.String.slice f 0 ((Stdlib.String.length f) - 1) else f
    handled { st with paletteFilter = trimmed; paletteIndex = 0 }
  | _ ->
    // Type to filter. Ctrl-J/Ctrl-K move so j/k can be part of an action name being typed.
    if kp.modifiers.ctrl then
      match kp.key with
      | J -> handled (movePalette st 1)
      | K -> handled (movePalette st (-1))
      | _ -> handled st
    else
      match kp.char with
      | Some c ->
        if (Stdlib.String.length c) >= 1 && (Stdlib.Bool.not kp.modifiers.alt) then
          handled { st with paletteFilter = st.paletteFilter ++ c; paletteIndex = 0 }
        else
          handled st
      | None -> handled st

/// The document-level command bound to `ch`, if any.
///
/// Consulted after the caret's own spec and before the kernel's chain. `:` is reserved here for the same
/// reason it is reserved for spec bindings: the palette lists everything and has to keep working whatever
/// has been bound.
let commandForKey (st: State) (ch: String) : Stdlib.Option.Option<Command> =
  if ch == "" || ch == ":" then
    Stdlib.Option.Option.None
  else
    st.reg.keymap
    |> Stdlib.List.findFirst (fun b -> b.key == ch)
    |> Stdlib.Option.map (fun b -> b.command)

/// Run one bound command. The motions are the half of this that no `Action` can reach.
let runCommand (st: State) (cmd: Command) : State =
  match cmd with
  | NavNext -> navBy st 1
  | NavPrev -> navBy st (-1)
  | NavParent -> navParent st
  | NavChild -> navChild st
  | NavSiblingNext -> navSibling st 1
  | NavSiblingPrev -> navSibling st (-1)
  | Delete -> clearNode st
  | Yank -> yankNode st
  | Put -> putNode st
  | AddSibling ->
    (match addSibling st with
     | Some s2 -> { s2 with mode = Mode.Insert }
     | None -> { st with message = "nothing here is in a list" })
  | Undo -> undo st
  | Redo -> redo st
  | ToggleAnchor -> toggleAnchor st
  | EnterInsert -> enterInsert st
  | RunAction name ->
    match paletteActions st |> Stdlib.List.findFirst (fun a -> a.name == name) with
    | Some a -> applyAction st a
    | None -> { st with message = "no action here called " ++ name }


let onKeyNav (st: State) (kp: Stdlib.Cli.UI.Widget.KeyPress) : Outcome =
  let handled (s: State) : Outcome = Stdlib.Cli.UI.Widget.Outcome.Handled s
  let ch = kp.char |> Stdlib.Option.withDefault ""
  if st.paletteOpen then
    onKeyPalette st kp
  else
  match kp.key with
  | Escape -> Stdlib.Cli.UI.Widget.Outcome.Emitted(st, Msg.Back)
  | Enter -> handled (enterInsert st)
  | Tab -> if kp.modifiers.shift then handled (prevHole st) else handled (nextHole st)
  | DownArrow -> if kp.modifiers.ctrl then handled (moveSibling st 1) else handled (navBy st 1)
  | UpArrow -> if kp.modifiers.ctrl then handled (moveSibling st (-1)) else handled (navBy st (-1))
  | LeftArrow -> if kp.modifiers.ctrl then handled (moveSibling st (-1)) else handled (navParent st)
  | RightArrow -> if kp.modifiers.ctrl then handled (moveSibling st 1) else handled (navChild st)
  | _ ->
    if kp.modifiers.ctrl then
      match kp.key with
      | S -> Stdlib.Cli.UI.Widget.Outcome.Emitted(st, Msg.Save st.root)
      | R -> handled (redo st)
      | _ -> Stdlib.Cli.UI.Widget.Outcome.Ignored
    else
      // A spec's own key bindings are consulted BEFORE the kernel's, so a kind can rebind anything except
      // the palette, and the document's keymap sits between the two. The kernel's keys are the fallback,
      // not the law.
      //
      // Written as an Option rather than nested matches so the chain below stays where it is: half of it
      // is conditional or produces its own message on failure, and converting it wholesale into a default
      // keymap is a bigger change than it reads like.
      let bound =
        match actionForKey st ch with
        | Some a -> Stdlib.Option.Option.Some(applyAction st a)
        | None ->
          match commandForKey st ch with
          | Some c -> Stdlib.Option.Option.Some(runCommand st c)
          | None -> Stdlib.Option.Option.None

      match bound with
      | Some s2 -> handled s2
      | None ->
        if ch == "(" then
          // Group rightward. Unbound in NAV until now, and `(` already means "open a group" in INSERT,
          // so the meaning carries rather than competes.
          (match regroupRight st with
           | Some s2 -> handled s2
           | None -> handled { st with message = "nothing to group here" })
        elif ch == ")" then
          (match ungroupLeft st with
           | Some s2 -> handled s2
           | None -> handled { st with message = "nothing to ungroup here" })
        elif ch == "j" then handled (navBy st 1)
        elif ch == "k" then handled (navBy st (-1))
        // Shifted, next to the keys they are the coarse version of.
        elif ch == "J" then handled (navSibling st 1)
        elif ch == "K" then handled (navSibling st (-1))
        elif ch == "h" then handled (navParent st)
        elif ch == "l" then handled (navChild st)
        // Add another item to the list the caret's node is IN, and land in it. NAV had no way to grow a
        // list at all: every sibling in this editor is made by pressing Enter at the end of the last one,
        // and `addSibling` walks OUTWARD to the nearest enclosing item -- which, once anything is nested,
        // is always the inner list.
        //
        // So a match inside a match arm could be built and then never left: `|` and Enter both continue
        // the INNER arms, and there was no key anywhere that meant "another arm of the outer one". NAV can
        // already put the caret exactly on the outer arm; this gives that position something to do.
        //
        // `o` for the same reason vi uses it, and it was unbound.
        elif ch == "V" then handled (toggleAnchor st)
        elif ch == "o" then
          // ...and drops into INSERT, the way vi's does. Landing in a fresh hole in NAV means the next
          // thing you type is read as a command and thrown away, which is the whole reason the key exists.
          (match addSibling st with
           | Some s2 -> handled { s2 with mode = Mode.Insert }
           | None -> handled { st with message = "nothing here is in a list" })
        elif ch == "i" then handled (enterInsert st)
        elif ch == "x" then handled (clearNode st)
        elif ch == "u" then handled (undo st)
        elif ch == ":" then handled (openPalette st)
        elif ch == "y" then handled (yankNode st)
        elif ch == "p" then handled (putNode st)
        elif ch == "c" then handled (changeNode st)
        else Stdlib.Cli.UI.Widget.Outcome.Ignored

// --- Context (breadcrumb + expected-type hint, for the chrome) ---

/// A short name for a node: its kind's case, or the last segment of its type.
let crumbName (n: Node) : String =
  match n.kind.case with
  | Some c -> c
  | None ->
    match n.kind.typ with
    | Named name -> Stdlib.String.split name "." |> Stdlib.List.last |> Stdlib.Option.withDefault name
    | Prim p -> p

/// The trail of node names from the root to the caret's node.
let breadcrumb (st: State) : String =
  let step (acc: (Slot * List<String>)) (stp: Step) : (Slot * List<String>) =
    let (node, names) = acc
    match node with
    | Filled n ->
      match Node.slotAt n stp with
      | Some child -> (child, Stdlib.List.append names [ crumbName n ])
      | None -> (node, names)
    | _ -> (node, names)
  let (endNode, names) = Stdlib.List.fold st.caret.node ((st.root, [])) step
  let full =
    match endNode with
    | Filled n -> Stdlib.List.append names [ crumbName n ]
    | _ -> names
  Stdlib.String.join full " > "

let kindLabel (k: Kind) : String =
  match k.typ with
  | Named name -> Stdlib.String.split name "." |> Stdlib.List.last |> Stdlib.Option.withDefault name
  | Prim p -> p

/// What the caret is on, in a few words: the type a hole expects, or the kind of the node.
let expectHint (st: State) : String =
  match slotUnder st with
  | Some(Empty e) ->
    let what =
      match e.kind with
      | Some k -> friendlyType k
      | None -> "value"
    // Drop a redundant "(label)" when the label just repeats the type.
    if (e.label == what) || (e.label == "") then "expects " ++ what
    else "expects " ++ what ++ " (" ++ e.label ++ ")"
  | Some(Partial(typed, was)) ->
    let what =
      match Slot.expect was |> Stdlib.Option.andThen (fun e -> e.kind) with
      | Some k -> friendlyType k
      | None -> "value"
    "typing " ++ what
  | _ ->
    match nodeAtPath st.root st.caret.node with
    | Some n -> crumbName n
    | None -> ""

/// Refresh the cached menu on whatever state an outcome carries, so the next frame's menu is current.
let withRefreshedMenu (o: Outcome) : Outcome =
  match o with
  | Handled s -> Stdlib.Cli.UI.Widget.Outcome.Handled(refreshMenu s)
  | Emitted(s, m) -> Stdlib.Cli.UI.Widget.Outcome.Emitted(refreshMenu s, m)
  | Ignored -> Stdlib.Cli.UI.Widget.Outcome.Ignored

/// A run of NAV keys, applied one at a time. The terminal reader coalesces fast typing and key-repeat
/// into ONE press carrying the whole run, and NAV compares `char` against a single character -- so holding
/// `j` to move down the document, or pressing it three times quickly, did nothing at all. INSERT already
/// decomposes a run in `typeChar`; this is the same thing for navigation.
let onKeyNavRun (st: State) (kp: Stdlib.Cli.UI.Widget.KeyPress) (run: String) : Outcome =
  let step (acc: (State * Outcome)) (g: Char) : (State * Outcome) =
    let (s, o) = acc
    match o with
    | Emitted(_, _) -> acc
    | _ ->
      let one = Stdlib.Cli.UI.Widget.press kp.key kp.modifiers (Stdlib.Option.Option.Some(Stdlib.Char.toString g))
      match onKeyNav s one with
      | Handled s2 -> (s2, Stdlib.Cli.UI.Widget.Outcome.Handled s2)
      | Emitted(s2, m) -> (s2, Stdlib.Cli.UI.Widget.Outcome.Emitted(s2, m))
      | Ignored -> acc
  let (_, out) = Stdlib.List.fold (Stdlib.String.toList run) (st, Stdlib.Cli.UI.Widget.Outcome.Ignored) step
  out

/// Does this key MOVE rather than edit? A typing run ends at one, so the next character starts a fresh
/// undo step.
///
/// The run key is the path and the slot, and nothing else, so without this any later edit of the same
/// text joined the run that first filled it, however long ago and whatever happened in between -- and one
/// Ctrl-Z took the lot:
///
///     "ab"  Esc  i  c  Ctrl-Z   gave  ""     and should give  "ab"
///     "ab   Left    c  Ctrl-Z   gave  ""     and should give  "ab"
///
/// Typing a word, going away, coming back and adding one character cost you the word. Found in the grid
/// demo, where undoing one keystroke emptied a cell typed several edits earlier.
///
/// Asked once, here, rather than by clearing the run at each of the dozen places that move the caret --
/// which is the shape of bug this branch keeps finding. Backspace is not on the list on purpose: holding
/// it down should still be one undo, the same as holding a letter down.
let keyMoves (kp: Stdlib.Cli.UI.Widget.KeyPress) : Bool =
  match kp.key with
  | LeftArrow -> true
  | RightArrow -> true
  | UpArrow -> true
  | DownArrow -> true
  | Home -> true
  | End -> true
  | Tab -> true
  | Escape -> true
  | Enter -> true
  | _ -> false

let onKey (st0: State) (kp: Stdlib.Cli.UI.Widget.KeyPress) : Outcome =
  let st = if keyMoves kp then { st0 with lastTyped = Stdlib.Option.Option.None } else st0

  let raw =
    match st.mode with
    | Insert -> onKeyInsert st kp
    | Nav ->
      match kp.char with
      | Some run ->
        if (Stdlib.String.length run) > 1 then onKeyNavRun st kp run else onKeyNav st kp
      | None -> onKeyNav st kp
  withRefreshedMenu raw
