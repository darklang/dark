/// Where the caret is, in terms of the document rather than the screen.
///
/// A caret names a node by path, a part of that node, and an offset inside the part. It is resolved to a
/// row and column only after layout, and re-resolved after every edit, which is what lets an edit that
/// reflows the whole document leave the caret exactly where the user expects. (Classic Fluid called this
/// a CaretTarget, and it was the one idea there that never caused trouble.)
module Darklang.Fluid

/// Which part of a node the caret is on.
type Part =
  /// The node as a whole (NAV level).
  | OnNode
  /// Inside the text run in field `slot`; `offset` counts graphemes from its start.
  | InText(slot: String)
  /// On the hole or partial in single slot `slot`; `offset` is inside the partial's text, 0 for a hole.
  | InSlot(slot: String)
  /// On the hole or partial that is item `i` of list `slot`.
  | InItem(slot: String, i: Int64)
  /// Just after this whole node, in its parent's scope. Where the caret lands after stepping past a
  /// closing delimiter, so the next comma or element targets the enclosing list, not the one just closed.
  | AfterNode
  /// Not a place the caret can be: punctuation a node DRAWS, tagged so the node's extent includes it.
  ///
  /// `AfterNode` is located by walking to the end of the cells belonging to a node, and punctuation used
  /// to be drawn untagged, so a node's extent stopped before its own closing bracket. The caret then drew
  /// inside it -- `[1~]` for a caret that is after the list, `"abc~"` for one after the string -- which
  /// also made AfterNode and end-of-content look identical on screen.
  ///
  /// `taggedCells` filters these out, so navigation never lands on one; only `locate` counts them.
  | Decoration


type Caret =
  { node: Path
    part: Part
    offset: Int64 }


module Caret =
  let onNode(path: Path): Caret =
    Caret { node = path, part = Part.OnNode, offset = 0 }


  let inText(path: Path, slot: String, offset: Int64): Caret =
    Caret { node = path, part = Part.InText(slot), offset = offset }


  let inSlot(path: Path, slot: String, offset: Int64): Caret =
    Caret { node = path, part = Part.InSlot(slot), offset = offset }


  let inItem(path: Path, slot: String, i: Int64, offset: Int64): Caret =
    Caret { node = path, part = Part.InItem(slot, i), offset = offset }


  let afterNode(path: Path): Caret =
    Caret { node = path, part = Part.AfterNode, offset = 0 }


  /// The path of the SLOT the caret is on, when it is on a hole or partial. `InSlot ""` at `[]` is the
  /// root slot itself.
  let slotPath(c: Caret): Option<Path> =
    match c.part with
    | InSlot(slot) ->
      if slot == "" && c.node == [] then
        Option.Some([])
      else
        Option.Some(Path.child(c.node, slot))
    | InItem(slot, i) -> Option.Some(Path.item(c.node, slot, i))
    | _ -> Option.None


  let isInsert(c: Caret): Bool =
    match c.part with
    | OnNode -> false
    | _ -> true


  let partToString(p: Part): String =
    match p with
    | OnNode -> "node"
    | InText(slot) -> "text:" + slot
    | InSlot(slot) -> "slot:" + slot
    | InItem(slot, i) -> "item:" + slot + "[" + Stdlib.display(i) + "]"
    | AfterNode -> "after"
    | Decoration -> "decoration"


  let toString(c: Caret): String =
    Path.toString(c.node) + " @ " + partToString(c.part) + "+" + Stdlib.display(c.offset)
