/// ProgramTypes as a Fluid document: `Expr` (and the patterns it contains) to `Node` and back.
///
/// Every Expr case gets a node kind under the Expr type, so one type-level spec owns "a hole expecting an
/// expression" (its hole rules and completions) and each case has its own pieces. What this file does not
/// handle yet goes through `Opaque`: the pretty-printed source held as text, parsed again on the way back,
/// so nothing is dropped while the coverage grows.
module Darklang.Fluid.PT

type Expr = Darklang.LanguageTools.ProgramTypes.Expr
type LetPattern = Darklang.LanguageTools.ProgramTypes.LetPattern

type MatchPattern = Darklang.LanguageTools.ProgramTypes.MatchPattern
type PipeExpr = Darklang.LanguageTools.ProgramTypes.PipeExpr
type MatchCase = Darklang.LanguageTools.ProgramTypes.MatchCase
type StringSegment = Darklang.LanguageTools.ProgramTypes.StringSegment

val exprType = "Darklang.LanguageTools.ProgramTypes.Expr"
val letPatType = "Darklang.LanguageTools.ProgramTypes.LetPattern"
val matchPatType = "Darklang.LanguageTools.ProgramTypes.MatchPattern"
val pipeExprType = "Darklang.LanguageTools.ProgramTypes.PipeExpr"
val matchCaseType = "Darklang.LanguageTools.ProgramTypes.MatchCase"
val recordFieldType = "Darklang.Fluid.PT.RecordField"
val dictPairType = "Darklang.Fluid.PT.DictPair"
val segmentType = "Darklang.LanguageTools.ProgramTypes.StringSegment"

let exprKind (case: String) : Kind = Kind.ofCase exprType case
let letPatKind (case: String) : Kind = Kind.ofCase letPatType case
let matchPatKind (case: String) : Kind = Kind.ofCase matchPatType case
let pipeKind (case: String) : Kind = Kind.ofCase pipeExprType case
let segmentKind (case: String) : Kind = Kind.ofCase segmentType case

/// A hole that takes any expression.
let exprExpect (label: String) : Expect = Expect.ofKind (Kind.named exprType) label

let letPatExpect (label: String) : Expect = Expect.ofKind (Kind.named letPatType) label
let matchPatExpect (label: String) : Expect = Expect.ofKind (Kind.named matchPatType) label
let pipeExpect (label: String) : Expect = Expect.ofKind (Kind.named pipeExprType) label
let caseExpect () : Expect = Expect.ofKind (Kind.named matchCaseType) "case"
let fieldExpect () : Expect = Expect.ofKind (Kind.named recordFieldType) "field"
let pairExpect () : Expect = Expect.ofKind (Kind.named dictPairType) "pair"
let segmentExpect () : Expect = Expect.ofKind (Kind.named segmentType) "segment"

let gid () : Int64 = Stdlib.Int64.random 0L 922337203685477580L

let text (name: String) (value: String) : (String * Field) = (name, Field.Text value)
let one (name: String) (n: Node) : (String * Field) = (name, Field.One(Slot.Filled n))
let many (name: String) (ns: List<Node>) (each: Expect) : (String * Field) =
  (name, Field.Many(ns |> Stdlib.List.map (fun n -> Slot.Filled n), each))

// --- Doc comments ---
//
// A description is carried as a LIST of lines rather than one text field, for the same reason an enum
// field's label is: an empty list draws nothing, so `Piece.Each` over it needs no conditional. The lines
// are ordinary nodes, so the doc comment is editable like everything else -- it was carried opaquely and
// drawn nowhere, which meant opening a real function silently dropped what it said about itself.

val docLineType = "Darklang.Fluid.PT.DocLine"

let docLineKind () : Kind = Kind.named docLineType

let docExpect () : Expect = Expect.ofKind (docLineKind ()) "doc line"

let docLines (description: String) : List<Node> =
  if description == "" then
    []
  else
    description
    |> Stdlib.String.split "\n"
    |> Stdlib.List.map (fun l -> Node.make (docLineKind ()) [ ("text", Field.Text l) ])

/// The description a document's `doc` lines spell, ready to go back on a PackageFn / PackageType.
let docText (n: Node) : String =
  Node.items n "doc"
  |> Stdlib.List.map (fun s ->
    match s with
    | Filled c -> Node.text c "text" |> Stdlib.Option.withDefault ""
    | _ -> "")
  |> Stdlib.String.join "\n"

let docField (description: String) : (String * Field) =
  ("doc", Field.Many(docLines description |> Stdlib.List.map (fun n -> Slot.Filled n), docExpect ()))

let emptyDocField () : (String * Field) = ("doc", Field.Many([], docExpect ()))

// --- The optional else ---
//
// An `if` without an else is valid (`EIf(_, _, _, None)`), and drawing its else slot as a hole invented a
// branch the program does not have: `if b then 1` came out as `if b then 1 else ⟨else⟩`.
//
// `Field.One(Slot.Empty _)` cannot say which of two things it means -- "there is no else" or "there is an
// else, not yet written" -- and those need different renderings. A Many field of ZERO OR ONE says exactly
// that: a parsed else-less `if` carries zero and draws nothing, while a freshly typed one carries one
// empty branch, so `else ⟨else⟩` is still there to Tab into. Same shape as a doc comment, for the same
// reason.

val elseBranchType = "Darklang.Fluid.PT.ElseBranch"

let elseBranchKind () : Kind = Kind.named elseBranchType

let elseExpect () : Expect = Expect.ofKind (elseBranchKind ()) "else"

let elseBranch (inner: Slot) : Node =
  Node.make (elseBranchKind ()) [ ("expr", Field.One inner) ]

let elseBranchSpec () : Spec =
  Spec.simple
    (elseBranchKind ())
    [ Piece.HardLine, Piece.Keyword "else", Piece.Nest(2, [ Piece.HardLine, Piece.Slot "expr" ]) ]
    (elseBranch (Slot.Empty(exprExpect "else")))

let docLineSpec () : Spec =
  Spec.simple
    (docLineKind ())
    [ Piece.Punct "///", Piece.Space, Piece.Text("text", Layout.Style.Dim), Piece.HardLine ]
    (Node.make (docLineKind ()) [ ("text", Field.Text "") ])


let printerContext () : Darklang.PrettyPrinter.ProgramTypes.Context =
  Darklang.PrettyPrinter.ProgramTypes.Context.forBranch Darklang.SCM.Branch.mainBranchId

/// Source text of something this file cannot yet take apart.
let opaque (e: Expr) : Node =
  Node.make (exprKind "Opaque") [ text "source" (Darklang.PrettyPrinter.ProgramTypes.expr (printerContext ()) e) ]

let nameOf
  (nr: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQFnName.FQFnName>)
  : String =
  match nr.resolved with
  | Ok r ->
    match r.location with
    | Some loc -> Stdlib.String.join (Stdlib.List.flatten [ [ loc.owner ], loc.modules, [ loc.name ] ]) "."
    | None -> Stdlib.String.join nr.originalName "."
  | Error _ -> Stdlib.String.join nr.originalName "."

let hashOf
  (nr: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQFnName.FQFnName>)
  : String =
  match nr.resolved with
  | Ok r ->
    match r.name with
    | Package h -> Darklang.LanguageTools.ProgramTypes.hashToString h
    | Builtin b -> "builtin:" ++ b.name ++ "_v" ++ (Stdlib.Int32.toString b.version)
  | Error _ -> ""

let typeNameOf
  (nr: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName>)
  : String =
  match nr.resolved with
  | Ok r ->
    match r.location with
    | Some loc -> Stdlib.String.join (Stdlib.List.flatten [ [ loc.owner ], loc.modules, [ loc.name ] ]) "."
    | None -> Stdlib.String.join nr.originalName "."
  | Error _ -> Stdlib.String.join nr.originalName "."

let typeHashOf
  (nr: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName>)
  : String =
  match nr.resolved with
  | Ok r ->
    match r.name with
    | Package h -> Darklang.LanguageTools.ProgramTypes.hashToString h
  | Error _ -> ""

let typeNameResolution
  (name: String)
  (hash: String)
  : Stdlib.Result.Result<Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName>, String> =
  if hash == "" then
    Stdlib.Result.Result.Error("unresolved type name: " ++ name)
  else
    Stdlib.Result.Result.Ok(
      Darklang.LanguageTools.ProgramTypes.NameResolution
        { originalName = Stdlib.String.split name "."
          resolved =
            Stdlib.Result.Result.Ok(
              Darklang.LanguageTools.ProgramTypes.ResolvedName
                { name = Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName.Package(Darklang.LanguageTools.ProgramTypes.Hash.Hash hash)
                  location = Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.parsePackageLocation name) }) })

/// `builtin:listLength_v0` back into its parts. The `_v` suffix is written by the two `toDoc` sides, and
/// a builtin name never contains one, so splitting on the LAST is unambiguous.
let builtinFromHash (hash: String) : Stdlib.Option.Option<(String * Int32)> =
  if Stdlib.Bool.not (Stdlib.String.startsWith hash "builtin:") then
    Stdlib.Option.Option.None
  else
    let body = Stdlib.String.dropFirst hash 8
    match Stdlib.String.lastIndexOf body "_v" with
    | Some i ->
      let name = Stdlib.String.slice body 0 i
      let versionText = Stdlib.String.dropFirst body (i + 2)
      (match Stdlib.Int32.parse versionText with
       | Ok v -> Stdlib.Option.Option.Some((name, v))
       | Error _ -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None


/// A doc comment with its inline markers unwrapped: `<param fn>` reads as `fn`.
///
/// Split on `<` and put back every piece that isn't one of the known markers, so a type written in a
/// description -- `List<'a>` -- comes through untouched.
let stripDocMarkup (s: String) : String =
  let tags = [ "param ", "var ", "fn ", "type ", "const ", "arg " ]

  Stdlib.String.split s "<"
  |> Stdlib.List.indexedMap (fun i part ->
    if i == 0 then
      part
    else
      match tags |> Stdlib.List.findFirst (fun t -> Stdlib.String.startsWith part t) with
      | Some t ->
        let rest = Stdlib.String.dropFirst part (Stdlib.String.length t)

        (match Stdlib.String.indexOf rest ">" with
         | Some j -> (Stdlib.String.slice rest 0 j) ++ (Stdlib.String.dropFirst rest (j + 1))
         | None -> rest)
      | None -> "<" ++ part)
  |> Stdlib.String.join ""


/// The declaration and doc comment behind a type hash, for `nodeDocs`.
let typeDocs (hash: String) (shown: String) : Stdlib.Option.Option<(String * String * String)> =
  match Darklang.LanguageTools.PackageManager.Type.get (Darklang.LanguageTools.ProgramTypes.Hash.Hash hash) with
  | Some t ->
    Stdlib.Option.Option.Some(
      (shown,
       Stdlib.Pretty.render 40 (Darklang.PrettyPrinter.ProgramTypes.customTypeDoc (printerContext ()) t.declaration),
       stripDocMarkup t.description))
  | None -> Stdlib.Option.Option.None


/// What a node's hash points at: the name to show, its signature, and its doc comment.
///
/// Every package item carries a description and nothing in the editor has ever shown one. This is where
/// they surface. It goes through the HASH the document already stores, not through the name, so the
/// answer is the thing itself and cannot be a near-miss: a shortened name could match two items, a hash
/// matches one.
///
/// Only nodes that carry a hash have an answer, which is the honest boundary -- there is no inference
/// here, just a lookup.
let nodeDocs (n: Node) : Stdlib.Option.Option<(String * String * String)> =
  let ctx = printerContext ()

  match n.kind.case with
  // Standing on a call is standing on the function, as far as "what is this" goes, and the call is where
  // the caret usually is.
  | Some "EApply" ->
    (match Node.slot n "fn" with
     | Some(Filled c) -> nodeDocs c
     | _ -> Stdlib.Option.Option.None)

  | Some "EFnName" ->
    let hash = textOf n "_hash"

    (match builtinFromHash hash with
     | Some(pair) ->
       let (bname, version) = pair

       (match
         Darklang.LanguageTools.allBuiltinFns ()
         |> Stdlib.List.filter (fun f -> f.name.name == bname && f.name.version == version)
         |> Stdlib.List.head
        with
        | Some f ->
          let params =
            f.parameters
            |> Stdlib.List.map (fun p ->
              "(" ++ p.name ++ ": " ++ (Darklang.PrettyPrinter.RuntimeTypes.typeReference Darklang.SCM.Branch.mainBranchId p.``type``) ++ ")")
            |> Stdlib.String.join " "
          let ret = Darklang.PrettyPrinter.RuntimeTypes.typeReference Darklang.SCM.Branch.mainBranchId f.returnType
          Stdlib.Option.Option.Some(("Builtin." ++ bname, params ++ " -> " ++ ret, stripDocMarkup f.description))
        | None -> Stdlib.Option.Option.None)
     | None ->
       (match Darklang.LanguageTools.PackageManager.Function.get (Darklang.LanguageTools.ProgramTypes.Hash.Hash hash) with
        | Some fn ->
          Stdlib.Option.Option.Some(
            (textOf n "name",
             Darklang.PrettyPrinter.ProgramTypes.PackageFn.signature ctx fn,
             stripDocMarkup fn.description))
        | None -> Stdlib.Option.Option.None))

  | Some "EValue" ->
    (match Darklang.LanguageTools.PackageManager.Value.get (Darklang.LanguageTools.ProgramTypes.Hash.Hash (textOf n "_hash")) with
     | Some v -> Stdlib.Option.Option.Some((textOf n "name", "", stripDocMarkup v.description))
     | None -> Stdlib.Option.Option.None)

  | Some "ERecord" -> typeDocs (textOf n "_typeHash") (displayName (textOf n "type"))
  | Some "EEnum" -> typeDocs (textOf n "_typeHash") (displayName (textOf n "type"))
  | _ -> Stdlib.Option.Option.None


let fnNameResolution
  (name: String)
  (hash: String)
  : Stdlib.Result.Result<Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQFnName.FQFnName>, String> =
  if hash == "" then
    Stdlib.Result.Result.Error("unresolved function name: " ++ name)
  elif Stdlib.String.startsWith hash "builtin:" then
    // A builtin resolves to itself, with no package location -- which is what the printer expects when it
    // writes `Builtin.listLength`. This used to refuse, so every stdlib wrapper (`let length list =
    // Builtin.listLength list`) was a function Fluid could draw and could not save.
    (match builtinFromHash hash with
     | Some(pair) ->
       let (bname, version) = pair
       Stdlib.Result.Result.Ok(
         Darklang.LanguageTools.ProgramTypes.NameResolution
           { originalName = Stdlib.String.split name "."
             resolved =
               Stdlib.Result.Result.Ok(
                 Darklang.LanguageTools.ProgramTypes.ResolvedName
                   { name =
                       Darklang.LanguageTools.ProgramTypes.FQFnName.FQFnName.Builtin(
                         Darklang.LanguageTools.ProgramTypes.FQFnName.Builtin { name = bname; version = version })
                     location = Stdlib.Option.Option.None }) })
     | None -> Stdlib.Result.Result.Error("builtin name without a version: " ++ name))
  else
    Stdlib.Result.Result.Ok(
      Darklang.LanguageTools.ProgramTypes.NameResolution
        { originalName = Stdlib.String.split name "."
          resolved =
            Stdlib.Result.Result.Ok(
              Darklang.LanguageTools.ProgramTypes.ResolvedName
                { name = Darklang.LanguageTools.ProgramTypes.FQFnName.FQFnName.Package(Darklang.LanguageTools.ProgramTypes.Hash.Hash hash)
                  location = Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.parsePackageLocation name) }) })

let infixText (i: Darklang.LanguageTools.ProgramTypes.Infix) : String =
  Darklang.LanguageTools.Precedence.infix i

let infixOfText (s: String) : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.Infix> =
  let fn (n: Darklang.LanguageTools.ProgramTypes.InfixFnName) : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.Infix> =
    Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.Infix.InfixFnCall n)
  match s with
  | "+" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticPlus
  | "-" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticMinus
  | "*" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticMultiply
  | "/" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticDivide
  | "%" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticModulo
  | "^" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticPower
  | ">" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonGreaterThan
  | ">=" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonGreaterThanOrEqual
  | "<" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonLessThan
  | "<=" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonLessThanOrEqual
  | "==" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonEquals
  | "!=" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.ComparisonNotEquals
  | "++" -> fn Darklang.LanguageTools.ProgramTypes.InfixFnName.StringConcat
  | "&&" -> Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.Infix.BinOp Darklang.LanguageTools.ProgramTypes.BinaryOperation.BinOpAnd)
  | "||" -> Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.Infix.BinOp Darklang.LanguageTools.ProgramTypes.BinaryOperation.BinOpOr)
  | _ -> Stdlib.Option.Option.None


// --- To the document ---

let letPatToDoc (p: LetPattern) : Node =
  match p with
  | LPUnit _ -> Node.make (letPatKind "LPUnit") []
  | LPWildcard _ -> Node.make (letPatKind "LPWildcard") []
  | LPVariable(_, name) -> Node.make (letPatKind "LPVariable") [ text "name" name ]
  | LPTuple(_, a, b, rest) ->
    Node.make
      (letPatKind "LPTuple")
      [ many "items" (Stdlib.List.map (Stdlib.List.flatten [ [ a, b ], rest ]) (fun x -> letPatToDoc x)) (letPatExpect "pattern") ]

/// Patterns this file can take apart. A match with any other pattern goes opaque as a whole.
let matchPatSupported (p: MatchPattern) : Bool =
  match p with
  | MPVariable(_, _) -> true
  | MPUnit _ -> true
  | MPBool(_, _) -> true
  | MPInt(_, _) -> true
  | MPInt64(_, _) -> true
  | MPFloat(_, _, _, _) -> true
  | MPChar(_, _) -> true
  | MPString(_, _) -> true
  | MPList(_, items) -> items |> Stdlib.List.all (fun x -> matchPatSupported x)
  | MPListCons(_, h, t) -> (matchPatSupported h) && (matchPatSupported t)
  | MPTuple(_, a, b, rest) -> Stdlib.List.flatten [ [ a, b ], rest ] |> Stdlib.List.all (fun x -> matchPatSupported x)
  | MPEnum(_, _, fields) -> fields |> Stdlib.List.all (fun x -> matchPatSupported x)
  | MPOr(_, alts) -> alts |> Stdlib.List.all (fun x -> matchPatSupported x)
  | _ -> false

let matchPatToDoc (p: MatchPattern) : Node =
  let pats (ps: List<MatchPattern>) : List<Node> = ps |> Stdlib.List.map (fun x -> matchPatToDoc x)
  match p with
  | MPVariable(_, name) -> Node.make (matchPatKind "MPVariable") [ text "name" name ]
  | MPUnit _ -> Node.make (matchPatKind "MPUnit") []
  | MPBool(_, b) -> Node.make (matchPatKind "MPBool") [ text "value" (if b then "true" else "false") ]
  | MPInt(_, i) -> Node.make (matchPatKind "MPInt") [ text "digits" (Stdlib.Int.toString i) ]
  | MPInt64(_, i) -> Node.make (matchPatKind "MPInt64") [ text "digits" (Stdlib.Int64.toString i) ]
  | MPFloat(_, sign, whole, fraction) ->
    let signed =
      match sign with
      | Negative -> "-" ++ whole
      | Positive -> whole
    Node.make (matchPatKind "MPFloat") [ text "whole" signed, text "fraction" fraction ]
  | MPChar(_, c) -> Node.make (matchPatKind "MPChar") [ text "char" c ]
  | MPString(_, str) -> Node.make (matchPatKind "MPString") [ text "body" str ]
  | MPList(_, items) -> Node.make (matchPatKind "MPList") [ many "items" (pats items) (matchPatExpect "pattern") ]
  | MPListCons(_, h, t) ->
    Node.make (matchPatKind "MPListCons") [ one "head" (matchPatToDoc h), one "tail" (matchPatToDoc t) ]
  | MPTuple(_, a, b, rest) ->
    Node.make (matchPatKind "MPTuple") [ many "items" (pats (Stdlib.List.flatten [ [ a, b ], rest ])) (matchPatExpect "pattern") ]
  | MPEnum(_, caseName, fields) ->
    Node.make (matchPatKind "MPEnum") [ text "case" caseName, many "fields" (pats fields) (matchPatExpect "field") ]
  | MPOr(_, alts) -> Node.make (matchPatKind "MPOr") [ many "alts" (pats alts) (matchPatExpect "pattern") ]
  | _ -> Node.make (matchPatKind "MPUnit") []

let caseToDoc (c: MatchCase) : Node =
  let whenItems =
    match c.whenCondition with
    | Some w -> [ toDoc w ]
    | None -> []
  Node.make
    (Kind.named matchCaseType)
    [ one "pat" (matchPatToDoc c.pat), many "when" whenItems (exprExpect "when"), one "rhs" (toDoc c.rhs) ]

let recordFieldToDoc (f: (String * Expr)) : Node =
  let (name, value) = f
  Node.make (Kind.named recordFieldType) [ text "name" name, one "value" (toDoc value) ]

let pairToDoc (p: (Expr * Expr)) : Node =
  let (key, value) = p
  Node.make (Kind.named dictPairType) [ one "key" (toDoc key), one "value" (toDoc value) ]

let segmentToDoc (seg: StringSegment) : Node =
  match seg with
  | StringText t -> Node.make (segmentKind "StringText") [ text "text" t ]
  | StringInterpolation e -> Node.make (segmentKind "StringInterpolation") [ one "expr" (toDoc e) ]

let pipeSupported (p: PipeExpr) : Bool =
  match p with
  | EPipeFnCall(_, _, typeArgs, _) -> Stdlib.List.isEmpty typeArgs
  | _ -> true

let pipeToDoc (p: PipeExpr) : Node =
  let args (es: List<Expr>) : (String * Field) = many "args" (es |> Stdlib.List.map (fun x -> toDoc x)) (exprExpect "arg")
  match p with
  | EPipeVariable(_, name, es) -> Node.make (pipeKind "EPipeVariable") [ text "name" (displayName name), args es ]
  | EPipeLambda(_, params, body) ->
    Node.make
      (pipeKind "EPipeLambda")
      [ many "params" (params |> Stdlib.List.map (fun x -> letPatToDoc x)) (letPatExpect "param"), one "body" (toDoc body) ]
  | EPipeInfix(_, op, e) -> Node.make (pipeKind "EPipeInfix") [ text "op" (infixText op), one "expr" (toDoc e) ]
  | EPipeFnCall(_, nr, _, es) -> Node.make (pipeKind "EPipeFnCall") [ text "name" (nameOf nr), text "_hash" (hashOf nr), args es ]
  | EPipeEnum(_, tnr, caseName, es) ->
    Node.make
      (pipeKind "EPipeEnum")
      [ text "type" (typeNameOf tnr), text "_typeHash" (typeHashOf tnr), text "case" caseName
        many "fields" (es |> Stdlib.List.map (fun x -> toDoc x)) (exprExpect "field") ]

let allText (segments: List<Darklang.LanguageTools.ProgramTypes.StringSegment>) : Stdlib.Option.Option<String> =
  let parts =
    segments
    |> Stdlib.List.map (fun seg ->
      match seg with
      | StringText t -> Stdlib.Option.Option.Some t
      | StringInterpolation _ -> Stdlib.Option.Option.None)
  if parts |> Stdlib.List.all (fun p -> Stdlib.Option.isSome p) then
    Stdlib.Option.Option.Some(parts |> Stdlib.List.filterMap (fun p -> p) |> Stdlib.String.join "")
  else
    Stdlib.Option.Option.None

/// Replace `EArg i` with the i-th parameter name and `ESelf` with the function name, as `EVariable`s, so
/// a function body edits with the names a person reads and writes. On save the body is printed with those
/// names and the parser re-lowers them to `EArg`/`ESelf` in context, so nothing is lost. Only used by the
/// function shell; a free-standing expression has no args or self.
let namedArgs (paramNames: List<String>) (selfName: String) (e: Expr) : Expr =
  let go (x: Expr) : Expr = namedArgs paramNames selfName x
  let goSeg (seg: StringSegment) : StringSegment =
    match seg with
    | StringText t -> StringSegment.StringText t
    | StringInterpolation ie -> StringSegment.StringInterpolation(go ie)
  let goPipe (pe: PipeExpr) : PipeExpr =
    match pe with
    | EPipeVariable(id, n, es) -> PipeExpr.EPipeVariable(id, n, es |> Stdlib.List.map (fun a -> go a))
    | EPipeLambda(id, ps, b) -> PipeExpr.EPipeLambda(id, ps, go b)
    | EPipeInfix(id, op, ie) -> PipeExpr.EPipeInfix(id, op, go ie)
    | EPipeFnCall(id, nr, ta, es) -> PipeExpr.EPipeFnCall(id, nr, ta, es |> Stdlib.List.map (fun a -> go a))
    | EPipeEnum(id, tnr, c, es) -> PipeExpr.EPipeEnum(id, tnr, c, es |> Stdlib.List.map (fun a -> go a))
  let goCase (c: MatchCase) : MatchCase =
    Darklang.LanguageTools.ProgramTypes.MatchCase
      { pat = c.pat
        whenCondition = (match c.whenCondition with | Some w -> Stdlib.Option.Option.Some(go w) | None -> Stdlib.Option.Option.None)
        rhs = go c.rhs }
  match e with
  | EArg(id, i) ->
    match Stdlib.List.getAt paramNames i with
    | Some nm -> Expr.EVariable(id, nm)
    | None -> e
  | ESelf id -> Expr.EVariable(id, selfName)
  | EList(id, es) -> Expr.EList(id, es |> Stdlib.List.map (fun x -> go x))
  | EDict(id, ps) -> Expr.EDict(id, ps |> Stdlib.List.map (fun kv -> let (k, v) = kv
                                                                     (go k, go v)))
  | ETuple(id, a, b, rest) -> Expr.ETuple(id, go a, go b, rest |> Stdlib.List.map (fun x -> go x))
  | ERecord(id, tn, ta, fs) -> Expr.ERecord(id, tn, ta, fs |> Stdlib.List.map (fun nv -> let (n, v) = nv
                                                                                         (n, go v)))
  | ERecordUpdate(id, r, us) -> Expr.ERecordUpdate(id, go r, us |> Stdlib.List.map (fun nv -> let (n, v) = nv
                                                                                             (n, go v)))
  | EEnum(id, tn, ta, c, fs) -> Expr.EEnum(id, tn, ta, c, fs |> Stdlib.List.map (fun x -> go x))
  | ELet(id, p, v, b) -> Expr.ELet(id, p, go v, go b)
  | ERecordFieldAccess(id, r, f) -> Expr.ERecordFieldAccess(id, go r, f)
  | EIf(id, c, t, el) -> Expr.EIf(id, go c, go t, (match el with | Some x -> Stdlib.Option.Option.Some(go x) | None -> Stdlib.Option.Option.None))
  | EMatch(id, a, cs) -> Expr.EMatch(id, go a, cs |> Stdlib.List.map (fun c -> goCase c))
  | EPipe(id, first, steps) -> Expr.EPipe(id, go first, steps |> Stdlib.List.map (fun st -> goPipe st))
  | EInfix(id, op, l, r) -> Expr.EInfix(id, op, go l, go r)
  | ELambda(id, ps, b) -> Expr.ELambda(id, ps, go b)
  | EApply(id, f, ta, args) -> Expr.EApply(id, go f, ta, args |> Stdlib.List.map (fun x -> go x))
  | EString(id, segs) -> Expr.EString(id, segs |> Stdlib.List.map (fun sg -> goSeg sg))
  | EStatement(id, a, b) -> Expr.EStatement(id, go a, go b)
  | _ -> e

let toDoc (e: Expr) : Node =
  match e with
  | EUnit _ -> Node.make (exprKind "EUnit") []
  | EBool(_, b) -> Node.make (exprKind "EBool") [ text "value" (if b then "true" else "false") ]
  | EInt(_, i) -> Node.make (exprKind "EInt") [ text "digits" (Stdlib.Int.toString i) ]
  | EInt64(_, i) -> Node.make (exprKind "EInt64") [ text "digits" (Stdlib.Int64.toString i) ]
  | EFloat(_, sign, whole, fraction) ->
    let signed =
      match sign with
      | Negative -> "-" ++ whole
      | Positive -> whole
    Node.make (exprKind "EFloat") [ text "whole" signed, text "fraction" fraction ]
  | EChar(_, c) -> Node.make (exprKind "EChar") [ text "char" c ]
  | EString(_, segments) ->
    match allText segments with
    | Some body -> Node.make (exprKind "EString") [ text "body" body ]
    | None ->
      Node.make (exprKind "EStringI") [ many "segments" (segments |> Stdlib.List.map (fun x -> segmentToDoc x)) (segmentExpect ()) ]
  | EList(_, items) ->
    Node.make (exprKind "EList") [ many "items" (Stdlib.List.map items (fun x -> toDoc x)) (exprExpect "item") ]
  | ETuple(_, a, b, rest) ->
    Node.make
      (exprKind "ETuple")
      [ many "items" (Stdlib.List.map (Stdlib.List.flatten [ [ a, b ], rest ]) (fun x -> toDoc x)) (exprExpect "item") ]
  | EVariable(_, name) -> Node.make (exprKind "EVariable") [ text "name" name ]
  | ELet(_, pat, value, body) ->
    Node.make (exprKind "ELet") [ one "pat" (letPatToDoc pat), one "value" (toDoc value), one "body" (toDoc body) ]
  | EIf(_, cond, thenExpr, elseExpr) ->
    // Zero branches when the program has none, so nothing is drawn for it.
    let elseItems =
      match elseExpr with
      | Some x -> [ Slot.Filled(elseBranch (Slot.Filled(toDoc x))) ]
      | None -> []
    Node.make
      (exprKind "EIf")
      [ one "cond" (toDoc cond), one "then" (toDoc thenExpr), ("else", Field.Many(elseItems, elseExpect ())) ]
  | EInfix(_, op, left, right) ->
    Node.make (exprKind "EInfix") [ one "left" (toDoc left), text "op" (infixText op), one "right" (toDoc right) ]
  | ELambda(_, params, body) ->
    Node.make
      (exprKind "ELambda")
      [ many "params" (Stdlib.List.map params (fun p -> letPatToDoc p)) (letPatExpect "param")
        one "body" (toDoc body) ]
  | EApply(_, fn, typeArgs, args) ->
    if Stdlib.List.isEmpty typeArgs then
      Node.make
        (exprKind "EApply")
        [ one "fn" (toDoc fn), many "args" (Stdlib.List.map args (fun a -> toDoc a)) (exprExpect "arg") ]
    else
      opaque e
  | EFnName(_, nr) -> Node.make (exprKind "EFnName") [ text "name" (displayName (nameOf nr)), text "_hash" (hashOf nr) ]
  | EStatement(_, first, next) ->
    Node.make (exprKind "EStatement") [ one "first" (toDoc first), one "next" (toDoc next) ]
  | EMatch(_, arg, cases) ->
    if cases |> Stdlib.List.all (fun c -> matchPatSupported c.pat) then
      Node.make
        (exprKind "EMatch")
        [ one "arg" (toDoc arg), many "cases" (cases |> Stdlib.List.map (fun c -> caseToDoc c)) (caseExpect ()) ]
    else
      opaque e
  | EPipe(_, first, steps) ->
    if steps |> Stdlib.List.all (fun p -> pipeSupported p) then
      Node.make
        (exprKind "EPipe")
        [ one "first" (toDoc first), many "steps" (steps |> Stdlib.List.map (fun p -> pipeToDoc p)) (pipeExpect "step") ]
    else
      opaque e
  | ERecord(_, tnr, typeArgs, fields) ->
    if Stdlib.List.isEmpty typeArgs then
      Node.make
        (exprKind "ERecord")
        [ text "type" (typeNameOf tnr), text "_typeHash" (typeHashOf tnr)
          many "fields" (fields |> Stdlib.List.map (fun f -> recordFieldToDoc f)) (fieldExpect ()) ]
    else
      opaque e
  | ERecordUpdate(_, record, updates) ->
    Node.make
      (exprKind "ERecordUpdate")
      [ one "record" (toDoc record), many "updates" (updates |> Stdlib.List.map (fun f -> recordFieldToDoc f)) (fieldExpect ()) ]
  | EEnum(_, tnr, typeArgs, caseName, fields) ->
    if Stdlib.List.isEmpty typeArgs then
      Node.make
        (exprKind "EEnum")
        [ text "type" (typeNameOf tnr), text "_typeHash" (typeHashOf tnr), text "case" caseName
          many "fields" (fields |> Stdlib.List.map (fun x -> toDoc x)) (exprExpect "field") ]
    else
      opaque e
  | EDict(_, pairs) ->
    Node.make (exprKind "EDict") [ many "pairs" (pairs |> Stdlib.List.map (fun p -> pairToDoc p)) (pairExpect ()) ]
  | ERecordFieldAccess(_, record, field) ->
    Node.make (exprKind "ERecordFieldAccess") [ one "record" (toDoc record), text "field" field ]
  | EValue(_, nr) ->
    let name =
      match nr.resolved with
      | Ok r ->
        match r.location with
        | Some loc -> Stdlib.String.join (Stdlib.List.flatten [ [ loc.owner ], loc.modules, [ loc.name ] ]) "."
        | None -> Stdlib.String.join nr.originalName "."
      | Error _ -> Stdlib.String.join nr.originalName "."
    let hash =
      match nr.resolved with
      | Ok r ->
        match r.name with
        | Package h -> Darklang.LanguageTools.ProgramTypes.hashToString h
        // The VERSION goes in too. It was dropped here and kept for functions, so a builtin value could
        // not be rebuilt even in principle.
        | Builtin b -> "builtin:" ++ b.name ++ "_v" ++ (Stdlib.Int32.toString b.version)
      | Error _ -> ""
    // Shortened, the way a function name is. This drew the FULL name while `EFnName` next to it drew the
    // short one, so `Stdlib.Cli.UI.Colors.colorize Darklang.Stdlib.Cli.UI.Colors.yellow` had one of each in
    // the same call. Exactly the drift t88 was about: two paths to the same decision, one of them missed.
    Node.make (exprKind "EValue") [ text "name" (displayName name), text "_hash" hash ]
  | _ -> opaque e


// --- Back to the program ---

let slotExpr (n: Node) (name: String) : Stdlib.Result.Result<Expr, String> =
  match Node.slot n name with
  | Some(Filled child) -> fromDoc child
  | Some(Empty e) -> Stdlib.Result.Result.Error("hole: " ++ e.label)
  | Some(Partial(t, _)) -> Stdlib.Result.Result.Error("unresolved: " ++ t)
  | None -> Stdlib.Result.Result.Error("missing slot " ++ name)

let itemExprs (n: Node) (name: String) : Stdlib.Result.Result<List<Expr>, String> =
  Node.items n name
  |> Stdlib.List.map (fun s ->
    match s with
    | Filled child -> fromDoc child
    | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
    | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
  |> Stdlib.Result.collect

let textOf (n: Node) (name: String) : String =
  Node.text n name |> Stdlib.Option.withDefault ""

let letPatFromDoc (n: Node) : Stdlib.Result.Result<LetPattern, String> =
  match n.kind.case with
  | Some "LPUnit" -> Stdlib.Result.Result.Ok(LetPattern.LPUnit(gid ()))
  | Some "LPWildcard" -> Stdlib.Result.Result.Ok(LetPattern.LPWildcard(gid ()))
  | Some "LPVariable" -> Stdlib.Result.Result.Ok(LetPattern.LPVariable(gid (), textOf n "name"))
  | Some "LPTuple" ->
    let items =
      Node.items n "items"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled child -> letPatFromDoc child
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
    match items with
    | Ok(a :: b :: rest) -> Stdlib.Result.Result.Ok(LetPattern.LPTuple(gid (), a, b, rest))
    | Ok _ -> Stdlib.Result.Result.Error "a tuple pattern needs two items"
    | Error err -> Stdlib.Result.Result.Error err
  | _ -> Stdlib.Result.Result.Error("not a let pattern: " ++ (Kind.toString n.kind))

let letPatSlot (n: Node) (name: String) : Stdlib.Result.Result<LetPattern, String> =
  match Node.slot n name with
  | Some(Filled child) -> letPatFromDoc child
  | Some(Empty e) -> Stdlib.Result.Result.Error("hole: " ++ e.label)
  | Some(Partial(t, _)) -> Stdlib.Result.Result.Error("unresolved: " ++ t)
  | None -> Stdlib.Result.Result.Error("missing slot " ++ name)

let slotResults (items: List<Slot>) (f: Node -> Stdlib.Result.Result<'a, String>) : Stdlib.Result.Result<List<'a>, String> =
  items
  |> Stdlib.List.map (fun s ->
    match s with
    | Filled child -> f child
    | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
    | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
  |> Stdlib.Result.collect

let matchPatFromDoc (n: Node) : Stdlib.Result.Result<MatchPattern, String> =
  let ok (p: MatchPattern) : Stdlib.Result.Result<MatchPattern, String> = Stdlib.Result.Result.Ok p
  let items (name: String) : Stdlib.Result.Result<List<MatchPattern>, String> =
    slotResults (Node.items n name) (fun c -> matchPatFromDoc c)
  match n.kind.case with
  | Some "MPVariable" -> ok (MatchPattern.MPVariable(gid (), textOf n "name"))
  | Some "MPUnit" -> ok (MatchPattern.MPUnit(gid ()))
  | Some "MPBool" -> ok (MatchPattern.MPBool(gid (), (textOf n "value") == "true"))
  | Some "MPInt" ->
    match Stdlib.Int.parse (textOf n "digits") with
    | Ok i -> ok (MatchPattern.MPInt(gid (), i))
    | Error _ -> Stdlib.Result.Result.Error("not an Int: " ++ (textOf n "digits"))
  | Some "MPInt64" ->
    match Stdlib.Int64.parse (textOf n "digits") with
    | Ok i -> ok (MatchPattern.MPInt64(gid (), i))
    | Error _ -> Stdlib.Result.Result.Error("not an Int64: " ++ (textOf n "digits"))
  | Some "MPFloat" ->
    let whole = textOf n "whole"
    let (sign, digits) =
      if Stdlib.String.startsWith whole "-" then
        (Darklang.LanguageTools.Sign.Negative, Stdlib.String.dropFirst whole 1)
      else
        (Darklang.LanguageTools.Sign.Positive, whole)
    ok (MatchPattern.MPFloat(gid (), sign, digits, textOf n "fraction"))
  | Some "MPChar" -> ok (MatchPattern.MPChar(gid (), textOf n "char"))
  | Some "MPString" -> ok (MatchPattern.MPString(gid (), textOf n "body"))
  | Some "MPList" -> items "items" |> Stdlib.Result.map (fun ps -> MatchPattern.MPList(gid (), ps))
  | Some "MPListCons" ->
    match (Node.slot n "head", Node.slot n "tail") with
    | (Some(Filled h), Some(Filled t)) ->
      match (matchPatFromDoc h, matchPatFromDoc t) with
      | (Ok hp, Ok tp) -> ok (MatchPattern.MPListCons(gid (), hp, tp))
      | (Error err, _) -> Stdlib.Result.Result.Error err
      | (_, Error err) -> Stdlib.Result.Result.Error err
    | _ -> Stdlib.Result.Result.Error "hole: list pattern"
  | Some "MPTuple" ->
    match items "items" with
    | Ok(a :: b :: rest) -> ok (MatchPattern.MPTuple(gid (), a, b, rest))
    | Ok _ -> Stdlib.Result.Result.Error "a tuple pattern needs two items"
    | Error err -> Stdlib.Result.Result.Error err
  | Some "MPEnum" -> items "fields" |> Stdlib.Result.map (fun ps -> MatchPattern.MPEnum(gid (), textOf n "case", ps))
  | Some "MPOr" -> items "alts" |> Stdlib.Result.map (fun ps -> MatchPattern.MPOr(gid (), ps))
  | _ -> Stdlib.Result.Result.Error("not a match pattern: " ++ (Kind.toString n.kind))

let caseFromDoc (n: Node) : Stdlib.Result.Result<MatchCase, String> =
  let pat =
    match Node.slot n "pat" with
    | Some(Filled p) -> matchPatFromDoc p
    | Some(Empty e) -> Stdlib.Result.Result.Error("hole: " ++ e.label)
    | Some(Partial(t, _)) -> Stdlib.Result.Result.Error("unresolved: " ++ t)
    | None -> Stdlib.Result.Result.Error "missing pattern"
  let whenCond =
    match Node.items n "when" with
    | [] -> Stdlib.Result.Result.Ok Stdlib.Option.Option.None
    | [ Filled w ] -> fromDoc w |> Stdlib.Result.map (fun x -> Stdlib.Option.Option.Some x)
    | _ -> Stdlib.Result.Result.Error "hole: when"
  match (pat, whenCond, slotExpr n "rhs") with
  | (Ok p, Ok w, Ok r) -> Stdlib.Result.Result.Ok(MatchCase { pat = p; whenCondition = w; rhs = r })
  | (Error err, _, _) -> Stdlib.Result.Result.Error err
  | (_, Error err, _) -> Stdlib.Result.Result.Error err
  | (_, _, Error err) -> Stdlib.Result.Result.Error err

let recordFieldFromDoc (n: Node) : Stdlib.Result.Result<(String * Expr), String> =
  slotExpr n "value" |> Stdlib.Result.map (fun v -> (textOf n "name", v))

let pairFromDoc (n: Node) : Stdlib.Result.Result<(Expr * Expr), String> =
  match (slotExpr n "key", slotExpr n "value") with
  | (Ok k, Ok v) -> Stdlib.Result.Result.Ok((k, v))
  | (Error err, _) -> Stdlib.Result.Result.Error err
  | (_, Error err) -> Stdlib.Result.Result.Error err

let segmentFromDoc (n: Node) : Stdlib.Result.Result<StringSegment, String> =
  match n.kind.case with
  | Some "StringText" -> Stdlib.Result.Result.Ok(StringSegment.StringText(textOf n "text"))
  | Some "StringInterpolation" -> slotExpr n "expr" |> Stdlib.Result.map (fun e -> StringSegment.StringInterpolation e)
  | _ -> Stdlib.Result.Result.Error "not a string segment"

let pipeFromDoc (n: Node) : Stdlib.Result.Result<PipeExpr, String> =
  match n.kind.case with
  | Some "EPipeVariable" -> itemExprs n "args" |> Stdlib.Result.map (fun es -> PipeExpr.EPipeVariable(gid (), textOf n "name", es))
  | Some "EPipeLambda" ->
    match (slotResults (Node.items n "params") (fun c -> letPatFromDoc c), slotExpr n "body") with
    | (Ok ps, Ok b) -> Stdlib.Result.Result.Ok(PipeExpr.EPipeLambda(gid (), ps, b))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EPipeInfix" ->
    match infixOfText (textOf n "op") with
    | None -> Stdlib.Result.Result.Error("not an operator: " ++ (textOf n "op"))
    | Some op -> slotExpr n "expr" |> Stdlib.Result.map (fun e -> PipeExpr.EPipeInfix(gid (), op, e))
  | Some "EPipeFnCall" ->
    match (fnNameResolution (textOf n "name") (textOf n "_hash"), itemExprs n "args") with
    | (Ok nr, Ok es) -> Stdlib.Result.Result.Ok(PipeExpr.EPipeFnCall(gid (), nr, [], es))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EPipeEnum" ->
    match (typeNameResolution (textOf n "type") (textOf n "_typeHash"), itemExprs n "fields") with
    | (Ok tnr, Ok es) -> Stdlib.Result.Result.Ok(PipeExpr.EPipeEnum(gid (), tnr, textOf n "case", es))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | _ -> Stdlib.Result.Result.Error("not a pipe step: " ++ (Kind.toString n.kind))

let fromDoc (n: Node) : Stdlib.Result.Result<Expr, String> =
  let ok (e: Expr) : Stdlib.Result.Result<Expr, String> = Stdlib.Result.Result.Ok e
  match n.kind.case with
  | Some "EUnit" -> ok (Expr.EUnit(gid ()))
  | Some "EBool" -> ok (Expr.EBool(gid (), (textOf n "value") == "true"))
  | Some "EInt" ->
    match Stdlib.Int.parse (textOf n "digits") with
    | Ok i -> ok (Expr.EInt(gid (), i))
    | Error _ -> Stdlib.Result.Result.Error("not an Int: " ++ (textOf n "digits"))
  | Some "EInt64" ->
    match Stdlib.Int64.parse (textOf n "digits") with
    | Ok i -> ok (Expr.EInt64(gid (), i))
    | Error _ -> Stdlib.Result.Result.Error("not an Int64: " ++ (textOf n "digits"))
  | Some "EFloat" ->
    let whole = textOf n "whole"
    let (sign, digits) =
      if Stdlib.String.startsWith whole "-" then
        (Darklang.LanguageTools.Sign.Negative, Stdlib.String.dropFirst whole 1)
      else
        (Darklang.LanguageTools.Sign.Positive, whole)
    ok (Expr.EFloat(gid (), sign, digits, textOf n "fraction"))
  | Some "EChar" -> ok (Expr.EChar(gid (), textOf n "char"))
  | Some "EString" ->
    ok (Expr.EString(gid (), [ Darklang.LanguageTools.ProgramTypes.StringSegment.StringText(textOf n "body") ]))
  | Some "EList" ->
    match itemExprs n "items" with
    | Ok items -> ok (Expr.EList(gid (), items))
    | Error err -> Stdlib.Result.Result.Error err
  | Some "ETuple" ->
    match itemExprs n "items" with
    | Ok(a :: b :: rest) -> ok (Expr.ETuple(gid (), a, b, rest))
    | Ok _ -> Stdlib.Result.Result.Error "a tuple needs two items"
    | Error err -> Stdlib.Result.Result.Error err
  | Some "EVariable" -> ok (Expr.EVariable(gid (), textOf n "name"))
  | Some "ELet" ->
    match (letPatSlot n "pat", slotExpr n "value", slotExpr n "body") with
    | (Ok p, Ok v, Ok b) -> ok (Expr.ELet(gid (), p, v, b))
    | (Error err, _, _) -> Stdlib.Result.Result.Error err
    | (_, Error err, _) -> Stdlib.Result.Result.Error err
    | (_, _, Error err) -> Stdlib.Result.Result.Error err
  | Some "EIf" ->
    // No branch, or a branch nobody wrote into, is None either way.
    let elseResult =
      match Stdlib.List.head (Node.items n "else") with
      | Some(Filled branch) ->
        (match Node.slot branch "expr" with
         | Some(Filled child) -> fromDoc child |> Stdlib.Result.map (fun x -> Stdlib.Option.Option.Some x)
         | Some(Partial(t, _)) -> Stdlib.Result.Result.Error("unresolved: " ++ t)
         | _ -> Stdlib.Result.Result.Ok Stdlib.Option.Option.None)
      | _ -> Stdlib.Result.Result.Ok Stdlib.Option.Option.None
    match (slotExpr n "cond", slotExpr n "then", elseResult) with
    | (Ok c, Ok t, Ok el) -> ok (Expr.EIf(gid (), c, t, el))
    | (Error err, _, _) -> Stdlib.Result.Result.Error err
    | (_, Error err, _) -> Stdlib.Result.Result.Error err
    | (_, _, Error err) -> Stdlib.Result.Result.Error err
  | Some "EInfix" ->
    match infixOfText (textOf n "op") with
    | None -> Stdlib.Result.Result.Error("not an operator: " ++ (textOf n "op"))
    | Some op ->
      match (slotExpr n "left", slotExpr n "right") with
      | (Ok l, Ok r) -> ok (Expr.EInfix(gid (), op, l, r))
      | (Error err, _) -> Stdlib.Result.Result.Error err
      | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "ELambda" ->
    let params =
      Node.items n "params"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled child -> letPatFromDoc child
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
    match (params, slotExpr n "body") with
    | (Ok ps, Ok b) -> ok (Expr.ELambda(gid (), ps, b))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EApply" ->
    match (slotExpr n "fn", itemExprs n "args") with
    | (Ok f, Ok args) -> ok (Expr.EApply(gid (), f, [], args))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EFnName" ->
    // Resolved names come back by hash; a name typed in the editor and not yet resolved is an error here,
    // until completion (which knows the hash) is wired to package search.
    fnNameResolution (textOf n "name") (textOf n "_hash") |> Stdlib.Result.map (fun nr -> Expr.EFnName(gid (), nr))
  | Some "EStatement" ->
    match (slotExpr n "first", slotExpr n "next") with
    | (Ok a, Ok b) -> ok (Expr.EStatement(gid (), a, b))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EStringI" ->
    slotResults (Node.items n "segments") (fun c -> segmentFromDoc c)
    |> Stdlib.Result.map (fun segs -> Expr.EString(gid (), segs))
  | Some "EMatch" ->
    match (slotExpr n "arg", slotResults (Node.items n "cases") (fun c -> caseFromDoc c)) with
    | (Ok a, Ok cs) -> ok (Expr.EMatch(gid (), a, cs))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EPipe" ->
    match (slotExpr n "first", slotResults (Node.items n "steps") (fun c -> pipeFromDoc c)) with
    | (Ok f, Ok steps) -> ok (Expr.EPipe(gid (), f, steps))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "ERecord" ->
    match (typeNameResolution (textOf n "type") (textOf n "_typeHash"), slotResults (Node.items n "fields") (fun c -> recordFieldFromDoc c)) with
    | (Ok tnr, Ok fields) -> ok (Expr.ERecord(gid (), tnr, [], fields))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "ERecordUpdate" ->
    match (slotExpr n "record", slotResults (Node.items n "updates") (fun c -> recordFieldFromDoc c)) with
    | (Ok r, Ok updates) -> ok (Expr.ERecordUpdate(gid (), r, updates))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EEnum" ->
    match (typeNameResolution (textOf n "type") (textOf n "_typeHash"), itemExprs n "fields") with
    | (Ok tnr, Ok fields) -> ok (Expr.EEnum(gid (), tnr, [], textOf n "case", fields))
    | (Error err, _) -> Stdlib.Result.Result.Error err
    | (_, Error err) -> Stdlib.Result.Result.Error err
  | Some "EDict" ->
    slotResults (Node.items n "pairs") (fun c -> pairFromDoc c) |> Stdlib.Result.map (fun pairs -> Expr.EDict(gid (), pairs))
  | Some "ERecordFieldAccess" ->
    slotExpr n "record" |> Stdlib.Result.map (fun r -> Expr.ERecordFieldAccess(gid (), r, textOf n "field"))
  | Some "EValue" ->
    let hash = textOf n "_hash"
    if hash == "" then
      Stdlib.Result.Result.Error("unresolved value name: " ++ (textOf n "name"))
    elif Stdlib.String.startsWith hash "builtin:" then
      (match builtinFromHash hash with
       | Some(pair) ->
         let (bname, version) = pair
         ok (
           Expr.EValue(
             gid (),
             Darklang.LanguageTools.ProgramTypes.NameResolution
               { originalName = Stdlib.String.split (textOf n "name") "."
                 resolved =
                   Stdlib.Result.Result.Ok(
                     Darklang.LanguageTools.ProgramTypes.ResolvedName
                       { name =
                           Darklang.LanguageTools.ProgramTypes.FQValueName.FQValueName.Builtin(
                             Darklang.LanguageTools.ProgramTypes.FQValueName.Builtin { name = bname; version = version })
                         location = Stdlib.Option.Option.None }) }))
       | None -> Stdlib.Result.Result.Error("builtin name without a version: " ++ (textOf n "name")))
    else
      let nr =
        Darklang.LanguageTools.ProgramTypes.NameResolution
          { originalName = Stdlib.String.split (textOf n "name") "."
            resolved =
              Stdlib.Result.Result.Ok(
                Darklang.LanguageTools.ProgramTypes.ResolvedName
                  { name = Darklang.LanguageTools.ProgramTypes.FQValueName.FQValueName.Package(Darklang.LanguageTools.ProgramTypes.Hash.Hash hash)
                    location = Stdlib.Option.Option.Some(Darklang.LanguageTools.ProgramTypes.parsePackageLocation (textOf n "name")) }) }
      ok (Expr.EValue(gid (), nr))
  | Some "Opaque" -> Darklang.LanguageTools.Parser.Parse.parsePTExpr (textOf n "source")
  | _ -> Stdlib.Result.Result.Error("not an expression node: " ++ (Kind.toString n.kind))


// --- Specs ---

let intFromDigit (c: String) (e: Expect) : Node = Node.make (exprKind "EInt") [ text "digits" c ]

let stringFromQuote (c: String) (e: Expect) : Node = Node.make (exprKind "EString") [ text "body" "" ]

/// `$` starts an interpolated string: an EStringI with one empty text segment to type into. Editor.dark
/// handles the segment transitions (`{` splits in an interpolation, `"` ends the string).
let stringInterpFromDollar (c: String) (e: Expect) : Node =
  Node.make
    (exprKind "EStringI")
    [ ("segments", Field.Many([ Slot.Filled(Node.make (segmentKind "StringText") [ text "text" "" ]) ], segmentExpect ())) ]

let listFromBracket (c: String) (e: Expect) : Node =
  Node.make (exprKind "EList") [ ("items", Field.Many([ Slot.Empty(exprExpect "item") ], exprExpect "item")) ]

/// `{` in an expression hole: a record UPDATE, `{ r with name = value }`.
///
/// The record LITERAL cannot be reached by punctuation at all -- `ERecord` needs a resolved type hash, so
/// it is built by completion on the type name -- which leaves `{` free for the one record form that needs
/// nothing resolved. It reads in source order: `{`, then the record, then the fields.
let recordUpdateFromBrace (c: String) (e: Expect) : Node =
  Node.make
    (exprKind "ERecordUpdate")
    [ ("record", Field.One(Slot.Empty(exprExpect "record")))
      ("updates",
       Field.Many(
         [ Slot.Filled(
             Node.make
               (Kind.named recordFieldType)
               [ text "name" "", ("value", Field.One(Slot.Empty(exprExpect "value"))) ]) ],
         fieldExpect ())) ]

let tupleFromParen (c: String) (e: Expect) : Node =
  Node.make
    (exprKind "ETuple")
    [ ("items", Field.Many([ Slot.Empty(exprExpect "item"), Slot.Empty(exprExpect "item") ], exprExpect "item")) ]

let emptyLet () : Node =
  Node.make
    (exprKind "ELet")
    [ ("pat", Field.One(Slot.Empty(letPatExpect "name")))
      ("value", Field.One(Slot.Empty(exprExpect "value")))
      ("body", Field.One(Slot.Empty(exprExpect "body"))) ]

let emptyIf () : Node =
  Node.make
    (exprKind "EIf")
    [ ("cond", Field.One(Slot.Empty(exprExpect "cond")))
      ("then", Field.One(Slot.Empty(exprExpect "then")))
      // ONE empty branch, not zero: a fresh `if` still draws `else ⟨else⟩` to Tab into. Settle without
      // filling it and lowering reads it as None, so it saves else-less and reopens drawing nothing.
      ("else", Field.Many([ Slot.Filled(elseBranch (Slot.Empty(exprExpect "else"))) ], elseExpect ())) ]

let emptyLambda () : Node =
  Node.make
    (exprKind "ELambda")
    [ ("params", Field.Many([ Slot.Empty(letPatExpect "param") ], letPatExpect "param"))
      ("body", Field.One(Slot.Empty(exprExpect "body"))) ]

/// `left` then `.`: `left.⟨field⟩`, a field access with the caret in the (empty) field name.
let wrapFieldAccess (left: Node) (c: String) : Node =
  Node.make (exprKind "ERecordFieldAccess") [ ("record", Field.One(Slot.Filled left)), text "field" "" ]

/// `left` then an operator character: `left <op> ⟨right⟩`.
let wrapInfix (left: Node) (c: String) : Node =
  Node.make
    (exprKind "EInfix")
    [ ("left", Field.One(Slot.Filled left)), text "op" c, ("right", Field.One(Slot.Empty(exprExpect "right"))) ]

/// `left` then `|`: `left |> ⟨step⟩`.
let wrapPipe (left: Node) (c: String) : Node =
  Node.make
    (exprKind "EPipe")
    [ ("first", Field.One(Slot.Filled left))
      ("steps", Field.Many([ Slot.Empty(pipeExpect "step") ], pipeExpect "step")) ]

/// `|` between patterns makes an or-pattern: the current pattern becomes the first alternative and a fresh
/// hole the next, so `0 | 1 | 2` types straight through.
let wrapMatchOr (pat: Node) (c: String) : Node =
  Node.make
    (matchPatKind "MPOr")
    [ ("alts", Field.Many([ Slot.Filled pat, Slot.Empty(matchPatExpect "pattern") ], matchPatExpect "pattern")) ]

/// `::` makes a cons pattern: the current pattern is the head, a fresh hole the tail. `::` is
/// right-associative, so `a :: b :: c` nests to the right, which is what typing it left-to-right builds.
let wrapListCons (head: Node) (c: String) : Node =
  Node.make
    (matchPatKind "MPListCons")
    [ ("head", Field.One(Slot.Filled head)), ("tail", Field.One(Slot.Empty(matchPatExpect "tail"))) ]

// --- Completion from the package tree ---

let locationName (loc: Darklang.LanguageTools.ProgramTypes.PackageLocation) : String =
  Stdlib.String.join (Stdlib.List.flatten [ [ loc.owner ], loc.modules, [ loc.name ] ]) "."

/// "Stdlib.List.map" for Darklang.Stdlib.List.map: the way people write it.
/// How a name is written on screen. This defers to the pretty-printer's own shortening rather than
/// stripping a prefix by hand, because the two answers were drifting: Fluid drew
/// `Darklang.Stdlib.Option.Option<'a>` for a parameter the printer writes as `Option<'a>`, long enough to
/// break the line mid-type. Same function, same answer.
/// The empty module path is what Context.forBranch uses, so this matches the context Fluid prints with.
/// CLEANUP: the fn editor KNOWS which module it is showing, and Context.forModule exists for exactly
/// that -- names inside `Stdlib.Option.map` should be spelled the way someone standing in that module
/// would say them.
/// How a name is written on screen from inside `currentModule`: the prefix you would already have said
/// out loud is dropped, which is what the printer does and what the source reads like. Standing in
/// `Darklang.LanguageTools.ProgramTypes`, `Darklang.LanguageTools.ID` is just `ID`.
let displayNameIn (currentModule: List<String>) (name: String) : String =
  let loc = Darklang.LanguageTools.ProgramTypes.parsePackageLocation name

  // A name with no dots in it has nothing to shorten, and must not be sent through the shortener:
  // `parsePackageLocation "Colour"` reads a bare name as an OWNER with an empty name, and shortening
  // owner="Colour"/name="" hands back `Colour.`. So `Colour.Red` drew as `Colour..Red` and a record
  // literal `Foo { a = 1 }` drew as `Foo. { ... }`. That is what any type declared in the module you are
  // standing in looks like, and what a type you have just typed and not resolved looks like.
  if loc.name == "" then
    name
  else
    Darklang.PrettyPrinter.shortenName currentModule loc.owner loc.modules loc.name

/// From nowhere in particular, so everything is fully qualified. For the callers that STORE a shortened
/// name in the document rather than drawing one.
let displayName (name: String) : String = displayNameIn [] name

let fnNameNode (name: String) (hash: String) : Node =
  Node.make (exprKind "EFnName") [ text "name" (displayName name), text "_hash" hash ]

/// A call with one hole per parameter, labelled by the parameter's name.
let applyNode (fn: Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn) (name: String) : Node =
  let hash = Darklang.LanguageTools.ProgramTypes.hashToString fn.hash
  match fn.parameters with
  | [] -> fnNameNode name hash
  | params ->
    Node.make
      (exprKind "EApply")
      [ ("fn", Field.One(Slot.Filled(fnNameNode name hash)))
        ("args", Field.Many(params |> Stdlib.List.map (fun p -> Slot.Empty(exprExpect p.name)), exprExpect "arg")) ]

/// The same call as a pipe step: the first parameter is what's piped in, so one hole fewer.
let pipeCallNode (fn: Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn) (name: String) : Node =
  let hash = Darklang.LanguageTools.ProgramTypes.hashToString fn.hash
  let rest = Stdlib.List.drop fn.parameters 1
  Node.make
    (pipeKind "EPipeFnCall")
    [ text "name" name, text "_hash" hash
      ("args", Field.Many(rest |> Stdlib.List.map (fun p -> Slot.Empty(exprExpect p.name)), exprExpect "arg")) ]

val maxSearchCandidates = 5

/// The store's search wants a module path and a name, and matches the name by substring inside that
/// module; a fuzzy fallback at the root is wide and capped, so `List.ma` at the root never reaches
/// `List.map`. So: split what was typed into module segments and a last segment, search under a few
/// roots (as written, under Darklang, under Darklang.Stdlib), and let `ranked` sort the union.
let searchRoots () : List<List<String>> = [ [], [ "Darklang" ], [ "Darklang", "Stdlib" ] ]

let searchFor (typed: String) : Darklang.LanguageTools.ProgramTypes.Search.SearchResults =
  let segments = Stdlib.String.split typed "."
  let lastSegment = Stdlib.List.last segments |> Stdlib.Option.withDefault typed
  let modules = Stdlib.List.dropLast segments
  let one (root: List<String>) : Darklang.LanguageTools.ProgramTypes.Search.SearchResults =
    let query =
      Darklang.LanguageTools.ProgramTypes.Search.SearchQuery
        { currentModule = Stdlib.List.append root modules
          text = lastSegment
          searchDepth = Darklang.LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
          entityTypes =
            [ Darklang.LanguageTools.ProgramTypes.Search.EntityType.Fn
              Darklang.LanguageTools.ProgramTypes.Search.EntityType.Value ]
          exactMatch = false }
    Darklang.LanguageTools.PackageManager.Search.search Darklang.SCM.Branch.mainBranchId query
  let all = searchRoots () |> Stdlib.List.map (fun root -> one root)
  Darklang.LanguageTools.ProgramTypes.Search.SearchResults
    { submodules = []
      types = []
      values = all |> Stdlib.List.map (fun r -> r.values) |> Stdlib.List.flatten
      fns = all |> Stdlib.List.map (fun r -> r.fns) |> Stdlib.List.flatten }

/// Drop duplicates (the same hash under two roots), keeping the first.
let dedupe
  (items: List<Darklang.LanguageTools.ProgramTypes.LocatedItem<'a>>)
  : List<Darklang.LanguageTools.ProgramTypes.LocatedItem<'a>> =
  let (_, kept) =
    Stdlib.List.fold items (([], [])) (fun acc item ->
      let (seen, out) = acc
      let name = locationName item.location
      if Stdlib.List.member seen name then (seen, out)
      else (Stdlib.List.push seen name, Stdlib.List.push out item))
  Stdlib.List.reverse kept

let paramSummary (fn: Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn) : String =
  fn.parameters |> Stdlib.List.map (fun p -> p.name) |> Stdlib.String.join " "

/// Only hit the store once the query is specific enough to be useful: 3+ characters, or a dotted
/// qualifier (`List.m`). Below that, a two-letter query matches a hundred names and buries the keyword or
/// in-scope name you actually want.
let shouldSearch (typed: String) : Bool =
  (Stdlib.String.length typed) >= 3 || (Stdlib.String.contains typed ".")

/// Package functions and values whose names match, as calls with placeholder arguments.
/// Record literals, completed from the TYPE you are naming.
///
/// `ERecord` needs a resolved type hash -- `typeNameResolution` refuses an empty one -- so a record can't
/// be built by typing punctuation the way a list or a tuple can; the type has to be RESOLVED first. That
/// makes completion the natural build path rather than a `{` trigger, and it pays for itself: the search
/// hands back the declaration, so the shell arrives with the real field NAMES already in it and the caret
/// in the first value. Typing `Size` and pressing space gives `Size { width = <>; height = <> }`.
let recordCandidates (typed: String) : List<Candidate> =
  if (Stdlib.Bool.not (shouldSearch typed)) || (Stdlib.Bool.not (looksLikeATypeName typed)) then
    []
  else
    let query =
      Darklang.LanguageTools.ProgramTypes.Search.SearchQuery
        { currentModule = []
          text = Stdlib.String.split typed "." |> Stdlib.List.last |> Stdlib.Option.withDefault typed
          searchDepth = Darklang.LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
          entityTypes = [ Darklang.LanguageTools.ProgramTypes.Search.EntityType.Type ]
          exactMatch = false }
    // Ranked the same way function candidates are, so `Size` offers Size before it offers Stamp.
    ranked typed (Darklang.LanguageTools.PackageManager.Search.search Darklang.SCM.Branch.mainBranchId query).types
    |> Stdlib.List.filterMap (fun item ->
      match item.entity.declaration.definition with
      | Record fields ->
        let name = locationName item.location
        let hash = Darklang.LanguageTools.ProgramTypes.hashToString item.entity.hash
        let fieldSlots =
          fields
          |> Stdlib.List.map (fun f ->
            Slot.Filled(
              Node.make
                (Kind.named recordFieldType)
                [ text "name" f.name, ("value", Field.One(Slot.Empty(exprExpect f.name))) ]))
        let summary = Stdlib.String.join (fields |> Stdlib.List.map (fun f -> f.name)) ", "
        Stdlib.Option.Option.Some(
          Spec.candidate
            (displayName name)
            ("{ " ++ summary ++ " }")
            (Node.make
              (exprKind "ERecord")
              [ text "type" name, text "_typeHash" hash, ("fields", Field.Many(fieldSlots, fieldExpect ())) ]))
      | _ -> Stdlib.Option.Option.None)
    |> Stdlib.List.take 3

/// Does what you have typed look like a TYPE rather than a function? In this language a type and an enum
/// case are capitalised and a function is not, which is the cheap test that keeps the searches below off
/// the common path.
/// It is the LAST segment that says which: `Stdlib.Cli.Tui.Size` names a type, `Stdlib.List.length` names
/// a function, and both start with a capital.
let looksLikeATypeName (typed: String) : Bool =
  let lastSegment = Stdlib.String.split typed "." |> Stdlib.List.last |> Stdlib.Option.withDefault typed
  match Stdlib.String.first lastSegment 1 with
  | "" -> false
  | firstChar -> (Stdlib.String.toUppercase firstChar) == firstChar && (TextEdit.isLetterString firstChar)

/// Enum constructors, completed from the CASE you are naming: `Ok` offers `Result.Ok`.
///
/// Same wall as records -- EEnum carries a type name and hash, so the case has to be resolved to the type
/// that declares it. Unlike a record, the search cannot do the matching: you type a CASE name, and the
/// store indexes types by their own name. So this reads the enum declarations and matches the cases
/// itself, which is why it is gated on the name looking like a type: a lowercase query never pays for it.
let enumCandidates (typed: String) : List<Candidate> =
  // Two characters is enough for a CASE, because `Ok` is two characters and is the one everybody types.
  // The general search wants three, to keep a stray keystroke from scanning the store; a capitalised
  // two-letter word is specific enough to be worth it.
  if ((Stdlib.String.length typed) < 2) || (Stdlib.Bool.not (looksLikeATypeName typed)) then
    []
  else
    let wanted = Stdlib.String.toLowercase typed
    let query =
      Darklang.LanguageTools.ProgramTypes.Search.SearchQuery
        { currentModule = []
          text = ""
          searchDepth = Darklang.LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
          entityTypes = [ Darklang.LanguageTools.ProgramTypes.Search.EntityType.Type ]
          exactMatch = false }
    (Darklang.LanguageTools.PackageManager.Search.search Darklang.SCM.Branch.mainBranchId query).types
    |> Stdlib.List.map (fun item ->
      match item.entity.declaration.definition with
      | Enum cases ->
        let name = locationName item.location
        let hash = Darklang.LanguageTools.ProgramTypes.hashToString item.entity.hash
        cases
        |> Stdlib.List.filter (fun c -> Stdlib.String.startsWith (Stdlib.String.toLowercase c.name) wanted)
        |> Stdlib.List.map (fun c ->
          // A case's fields become holes, the way a record's do, so `Ok` lands you inside `Result.Ok(<>)`.
          let fieldSlots = c.fields |> Stdlib.List.map (fun _f -> Slot.Empty(exprExpect "field"))
          let detail =
            if Stdlib.List.isEmpty c.fields then "case"
            else "case of " ++ (Stdlib.Int.toString (Stdlib.List.length c.fields))
          Spec.candidate
            ((displayName name) ++ "." ++ c.name)
            detail
            (Node.make
              (exprKind "EEnum")
              [ text "type" name, text "_typeHash" hash, text "case" c.name
                ("fields", Field.Many(fieldSlots, exprExpect "field")) ]))
      | _ -> [])
    |> Stdlib.List.flatten
    // Shortest first, so `Ok` offers `Result.Ok` before anything that merely starts with it.
    |> Stdlib.List.sortBy (fun c -> Stdlib.String.length c.label)
    |> Stdlib.List.take 4

let completeExpr (e: Expect) (typed: String) : List<Candidate> =
  // A capitalised last segment goes down the TYPE path -- records and constructors -- even at two
  // characters, because `Ok` is two characters. The general function search still runs alongside it once
  // there are three, so nothing is lost; below three, a lowercase name waits rather than scan the store.
  let typeish = looksLikeATypeName typed
  let typeCandidates =
    if typeish then Stdlib.List.flatten [ recordCandidates typed, enumCandidates typed ] else []
  if Stdlib.Bool.not (shouldSearch typed) then
    typeCandidates
  else
    let results = searchFor typed
    let fns =
      ranked typed results.fns
      |> Stdlib.List.take maxSearchCandidates
      |> Stdlib.List.map (fun item ->
        let name = locationName item.location
        Spec.candidate (displayName name) (paramSummary item.entity) (applyNode item.entity name))
    let values =
      ranked typed results.values
      |> Stdlib.List.take 3
      |> Stdlib.List.map (fun item ->
        let name = locationName item.location
        let hash = Darklang.LanguageTools.ProgramTypes.hashToString item.entity.hash
        Spec.candidate (displayName name) "value" (Node.make (exprKind "EValue") [ text "name" name, text "_hash" hash ]))
    // A record or a constructor leads when what you typed looks like one; otherwise functions do.
    if typeish then Stdlib.List.flatten [ typeCandidates, fns, values ]
    else Stdlib.List.flatten [ fns, values ]

let completePipeStep (e: Expect) (typed: String) : List<Candidate> =
  if Stdlib.Bool.not (shouldSearch typed) then
    []
  else
    ranked typed (searchFor typed).fns
    |> Stdlib.List.take maxSearchCandidates
    |> Stdlib.List.map (fun item ->
      let name = locationName item.location
      Spec.candidate (displayName name) (paramSummary item.entity) (pipeCallNode item.entity name))

/// An identifier typed into an expression hole is a variable once the user types past it.
let isIdentifier (t: String) : Bool =
  (Stdlib.String.length t) > 0
  && (TextEdit.isLetterString (Stdlib.String.first t 1) || (Stdlib.String.first t 1) == "_")
  && (Stdlib.String.toList t
      |> Stdlib.List.all (fun ch -> (Stdlib.Char.isAlphanumeric ch) || ((Stdlib.Char.toString ch) == "_")))

let resolveExprPartial (typed: String) : Stdlib.Option.Option<Node> =
  if isIdentifier typed then
    Stdlib.Option.Option.Some(Node.make (exprKind "EVariable") [ text "name" typed ])
  else
    Stdlib.Option.Option.None

/// Rank search hits for what was typed: a name that ends with it first, then one that contains it, then
/// one whose last segment starts with the last typed segment. Anything else is dropped; the store's
/// fuzzy search is wider than completion wants.
let rankFor (typed: String) (name: String) : Stdlib.Option.Option<Int> =
  let t = Stdlib.String.toLowercase typed
  let n = Stdlib.String.toLowercase name
  let lastOf (x: String) : String = Stdlib.String.split x "." |> Stdlib.List.last |> Stdlib.Option.withDefault x
  if Stdlib.String.endsWith n t then Stdlib.Option.Option.Some 0
  elif Stdlib.String.startsWith (lastOf n) (lastOf t) && (Stdlib.String.contains n t) then Stdlib.Option.Option.Some 1
  elif Stdlib.String.startsWith (lastOf n) (lastOf t) then Stdlib.Option.Option.Some 2
  elif Stdlib.String.contains n t then Stdlib.Option.Option.Some 3
  else Stdlib.Option.Option.None

let ranked
  (typed: String)
  (items: List<Darklang.LanguageTools.ProgramTypes.LocatedItem<'a>>)
  : List<Darklang.LanguageTools.ProgramTypes.LocatedItem<'a>> =
  items
  |> Stdlib.List.filterMap (fun item ->
    let name = displayName (locationName item.location)
    rankFor typed name |> Stdlib.Option.map (fun r -> ((r, Stdlib.String.length name), item)))
  |> Stdlib.List.sortBy (fun pair ->
    let (key, _) = pair
    key)
  |> Stdlib.List.map (fun pair ->
    let (_, item) = pair
    item)
  |> dedupe

let emptyPipeLambda () : Node =
  Node.make
    (pipeKind "EPipeLambda")
    [ ("params", Field.Many([ Slot.Empty(letPatExpect "param") ], letPatExpect "param"))
      ("body", Field.One(Slot.Empty(exprExpect "body"))) ]

/// The type-level spec for a pipe step: what a hole after `|>` accepts.
let pipeTypeSpec () : Spec =
  Spec
    { kind = Kind.named pipeExprType
      pieces = [ Piece.Dim "?step" ]
      holeRules = []
      wrapRules = []
      completions = [ Spec.candidate "fun" "lambda step" (emptyPipeLambda ()) ]
      complete = completePipeStep
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = emptyPipeLambda ()
      summary = exprSummary }

// --- Binders (for scope-aware completion) ---

let letPatNames (n: Node) : List<String> =
  match n.kind.case with
  | Some "LPVariable" -> [ textOf n "name" ]
  | Some "LPTuple" ->
    Node.items n "items"
    |> Stdlib.List.filterMap (fun s -> Slot.node s)
    |> Stdlib.List.map (fun c -> letPatNames c)
    |> Stdlib.List.flatten
  | _ -> []

let matchPatNames (n: Node) : List<String> =
  let itemNames (name: String) : List<String> =
    Node.items n name
    |> Stdlib.List.filterMap (fun s -> Slot.node s)
    |> Stdlib.List.map (fun c -> matchPatNames c)
    |> Stdlib.List.flatten
  let slotNames (name: String) : List<String> =
    match Node.slot n name with
    | Some(Filled c) -> matchPatNames c
    | _ -> []
  match n.kind.case with
  | Some "MPVariable" -> [ textOf n "name" ]
  | Some "MPList" -> itemNames "items"
  | Some "MPTuple" -> itemNames "items"
  | Some "MPEnum" -> itemNames "fields"
  | Some "MPListCons" -> Stdlib.List.append (slotNames "head") (slotNames "tail")
  | Some "MPOr" -> itemNames "alts"
  | _ -> []

let namesFromSlot (n: Node) (slot: String) (extract: Node -> List<String>) : List<String> =
  match Node.slot n slot with
  | Some(Filled c) -> extract c
  | _ -> []

let namesFromItems (n: Node) (slot: String) (extract: Node -> List<String>) : List<String> =
  Node.items n slot
  |> Stdlib.List.filterMap (fun s -> Slot.node s)
  |> Stdlib.List.map (fun c -> extract c)
  |> Stdlib.List.flatten

// A `let`, a lambda parameter and a match pattern all bind a NAME and declare no type, so they bind
// `Spec.bound`. A function's parameters are the ones that carry a declared type; see `Fn.fnBinders`.
let letBinders (n: Node) : List<(List<Binding> * List<String>)> =
  [ (namesFromSlot n "pat" letPatNames |> Stdlib.List.map (fun nm -> Spec.bound nm), [ "body" ]) ]

let lambdaBinders (n: Node) : List<(List<Binding> * List<String>)> =
  [ (namesFromItems n "params" letPatNames |> Stdlib.List.map (fun nm -> Spec.bound nm), [ "body" ]) ]

let caseBinders (n: Node) : List<(List<Binding> * List<String>)> =
  [ (namesFromSlot n "pat" matchPatNames |> Stdlib.List.map (fun nm -> Spec.bound nm), [ "rhs", "when" ]) ]

let variableNode (name: String) : Node = Node.make (exprKind "EVariable") [ text "name" name ]

// --- Actions (palette) ---

let anyExpr (n: Node) : Bool = true

/// Wrap the node as the scrutinee of a match with one empty case.
let wrapInMatch (n: Node) : Slot =
  Slot.Filled(
    Node.make
      (exprKind "EMatch")
      [ ("arg", Field.One(Slot.Filled n))
        ("cases", Field.Many([ Slot.Filled(emptyCase ()) ], caseExpect ())) ])

/// Wrap the node as the condition of an if.
let wrapInIf (n: Node) : Slot =
  Slot.Filled(
    Node.make
      (exprKind "EIf")
      [ ("cond", Field.One(Slot.Filled n))
        ("then", Field.One(Slot.Empty(exprExpect "then")))
        ("else", Field.Many([ Slot.Filled(elseBranch (Slot.Empty(exprExpect "else"))) ], elseExpect ())) ])

/// Put a let above the node: `let ⟨name⟩ = ⟨value⟩` and the node as the body.
let wrapInLet (n: Node) : Slot =
  Slot.Filled(
    Node.make
      (exprKind "ELet")
      [ ("pat", Field.One(Slot.Empty(letPatExpect "name")))
        ("value", Field.One(Slot.Empty(exprExpect "value")))
        ("body", Field.One(Slot.Filled n)) ])

/// Pipe the node into a new step: `node |> ⟨step⟩`.
let wrapInPipe (n: Node) : Slot =
  Slot.Filled(
    Node.make
      (exprKind "EPipe")
      [ ("first", Field.One(Slot.Filled n))
        ("steps", Field.Many([ Slot.Empty(pipeExpect "step") ], pipeExpect "step")) ])

/// `if c then t else e`  ->  `match c with | true -> t | false -> e`. Keeps the condition as the
/// scrutinee and the two branches as the arm bodies, so nothing typed is lost.
let ifToMatch (n: Node) : Slot =
  let boolCase (b: String) (bodySlot: Stdlib.Option.Option<Slot>) : Node =
    let body = match bodySlot with | Some s -> s | None -> Slot.Empty(exprExpect "rhs")
    Node.make
      (Kind.named matchCaseType)
      [ ("pat", Field.One(Slot.Filled(Node.make (matchPatKind "MPBool") [ text "value" b ])))
        ("when", Field.Many([], exprExpect "when"))
        ("rhs", Field.One body) ]
  let condSlot = Node.slot n "cond" |> Stdlib.Option.withDefault (Slot.Empty(exprExpect "arg"))
  let thenSlot = Node.slot n "then"
  // The else is a branch NODE now, so the false arm's body is what is inside it -- and an `if` with no
  // else converts to a match whose false arm is a hole, which is what it was before.
  let elseSlot =
    match Stdlib.List.head (Node.items n "else") with
    | Some(Filled branch) -> Node.slot branch "expr"
    | _ -> Stdlib.Option.Option.None
  Slot.Filled(
    Node.make
      (exprKind "EMatch")
      [ ("arg", Field.One condSlot)
        ("cases",
         Field.Many(
           [ Slot.Filled(boolCase "true" thenSlot), Slot.Filled(boolCase "false" elseSlot) ],
           caseExpect ())) ])

// Two of these carry a key now that the kernel reads `Action.key`. Both are on keys NAV had free, and
// both are the kind of thing you reach for often enough that the palette is friction: `m` turns the `if`
// you are on into a `match`, `>` pipes what you are on into something else.
let ifActions () : List<Action> =
  [ Action { name = "convert to match"; key = Stdlib.Option.Option.Some "m"; doc = "match on the condition"; applies = anyExpr; run = ifToMatch } ]

let exprActions () : List<Action> =
  [ Action { name = "wrap in let"; key = Stdlib.Option.Option.None; doc = "let ... = ...  above this"; applies = anyExpr; run = wrapInLet }
    Action { name = "wrap in match"; key = Stdlib.Option.Option.None; doc = "match on this"; applies = anyExpr; run = wrapInMatch }
    Action { name = "wrap in if"; key = Stdlib.Option.Option.None; doc = "if this then ... else ..."; applies = anyExpr; run = wrapInIf }
    Action { name = "pipe into"; key = Stdlib.Option.Option.Some ">"; doc = "this |> ..."; applies = anyExpr; run = wrapInPipe } ]

/// `expr` becomes `expr; ⟨next⟩` -- the first thing, then a hole for what follows it.
let wrapStatement (n: Node) (c: String) : Node =
  Node.make
    (exprKind "EStatement")
    [ ("first", Field.One(Slot.Filled n))
      ("next", Field.One(Slot.Empty(exprExpect "next"))) ]

/// The cases of the enum the scrutinee is declared to be, as patterns.
///
/// This is the one thing "your own type, your own editor" could not do: you declare an enum, you match on
/// it, and the pattern hole offered `true` / `false` / `()` because nothing carried the scrutinee's type
/// to it. The `match` knows its scrutinee is a variable; SCOPE knows that variable was declared with a
/// type; the store knows that type's cases. All three are here now.
///
/// An MPEnum carries only a case NAME, no type, so a wrong guess can only produce a worse menu -- never a
/// wrong program. That is what makes reading the declared type good enough, without inference.
let matchOffers (scope: List<Binding>) (n: Node) : List<(List<Candidate> * List<String>)> =
  let scrutineeName =
    match Node.slot n "arg" with
    | Some(Filled a) ->
      if a.kind.case == Stdlib.Option.Option.Some "EVariable" then
        Stdlib.Option.Option.Some(textOf a "name")
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None

  let typeHash =
    match scrutineeName with
    | Some nm ->
      (match scope |> Stdlib.List.findFirst (fun b -> b.name == nm) with
       | Some b ->
         (match b.typ with
          | Some t ->
            if t.kind == Types.typeKind "TCustomType" then
              Stdlib.Option.Option.Some(textOf t "_hash")
            else
              Stdlib.Option.Option.None
          | None -> Stdlib.Option.Option.None)
       | None -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None

  match typeHash with
  | Some h ->
    if h == "" then
      []
    else
      (match Darklang.LanguageTools.PackageManager.Type.get (Darklang.LanguageTools.ProgramTypes.Hash.Hash h) with
       | Some t ->
         (match t.declaration.definition with
          | Enum cases ->
            let cands =
              cases
              |> Stdlib.List.map (fun c ->
                let fieldSlots = c.fields |> Stdlib.List.map (fun _ -> Slot.Empty(matchPatExpect "field"))

                Spec.contextCandidate
                  c.name
                  "case"
                  (Node.make
                    (matchPatKind "MPEnum")
                    [ text "case" c.name, ("fields", Field.Many(fieldSlots, matchPatExpect "field")) ]))

            // `cases.pat`: the arm's own pattern, not everything under it. Keyed on `cases` alone, these
            // were also offered for the FIELDS of a case, which are patterns of a different type entirely.
            [ (cands, [ "cases.pat" ]) ]
          | _ -> [])
       | None -> [])
  | None -> []

/// The fields of the record the target is declared to be, as whole field accesses.
///
/// Same three facts as a match's cases, one node over: the access knows its target is a variable, scope
/// knows what that variable was declared as, and the store knows that type's fields. Typing `r.` used to
/// leave you spelling the field name from memory.
///
/// A field name is TEXT on this node rather than a hole in the tree, so each candidate carries the whole
/// access with the name filled in, and committing replaces the node.
let fieldAccessOffers (scope: List<Binding>) (n: Node) : List<(List<Candidate> * List<String>)> =
  let targetName =
    match Node.slot n "record" with
    | Some(Filled r) ->
      if r.kind.case == Stdlib.Option.Option.Some "EVariable" then
        Stdlib.Option.Option.Some(textOf r "name")
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None

  let typeHash =
    match targetName with
    | Some nm ->
      (match scope |> Stdlib.List.findFirst (fun b -> b.name == nm) with
       | Some b ->
         (match b.typ with
          | Some t ->
            if t.kind == Types.typeKind "TCustomType" then
              Stdlib.Option.Option.Some(textOf t "_hash")
            else
              Stdlib.Option.Option.None
          | None -> Stdlib.Option.Option.None)
       | None -> Stdlib.Option.Option.None)
    | None -> Stdlib.Option.Option.None

  match typeHash with
  | Some h ->
    if h == "" then
      []
    else
      (match Darklang.LanguageTools.PackageManager.Type.get (Darklang.LanguageTools.ProgramTypes.Hash.Hash h) with
       | Some t ->
         (match t.declaration.definition with
          | Record fields ->
            let cands =
              fields
              |> Stdlib.List.map (fun f ->
                Spec.contextCandidate
                  f.name
                  "field"
                  (Node.make
                    (exprKind "ERecordFieldAccess")
                    [ ("record", Node.field n "record" |> Stdlib.Option.withDefault (Field.One(Slot.Empty(exprExpect "record"))))
                      text "field" f.name ]))

            [ (cands, [ "field" ]) ]
          | _ -> [])
       | None -> [])
  | None -> []

let exprSummary (n: Node) : String =
  match n.kind.case with
  | Some c -> c
  | None -> "expr"

let simpleExpr (case: String) (pieces: List<Piece>) (empty: Node) : Spec =
  { (Spec.simple (exprKind case) pieces empty) with summary = exprSummary }

let simpleLetPat (case: String) (pieces: List<Piece>) (empty: Node) : Spec =
  { (Spec.simple (letPatKind case) pieces empty) with summary = exprSummary }

/// The type-level spec: owns holes that expect an expression.
let exprTypeSpec () : Spec =
  Spec
    { kind = Kind.named exprType
      pieces = [ Piece.Dim "?expr" ]
      holeRules =
        [ HoleRule { onChar = "<digit>"; fill = HoleFill.WithChar intFromDigit }
          // `-` on an empty hole starts a negative number: the digits accumulate (and `.` still makes it a
          // float), so `-5` and `-5.5` are literals, not an unresolvable partial.
          HoleRule { onChar = "-"; fill = HoleFill.WithChar intFromDigit }
          HoleRule { onChar = "'"; fill = HoleFill.Node(Node.make (exprKind "EChar") [ text "char" "" ]) }
          HoleRule { onChar = "\""; fill = HoleFill.WithChar stringFromQuote }
          HoleRule { onChar = "$"; fill = HoleFill.WithChar stringInterpFromDollar }
          HoleRule { onChar = "["; fill = HoleFill.WithChar listFromBracket }
          HoleRule { onChar = "("; fill = HoleFill.WithChar tupleFromParen }
          HoleRule { onChar = "{"; fill = HoleFill.WithChar recordUpdateFromBrace }
          HoleRule { onChar = "\\"; fill = HoleFill.Node(emptyLambda ()) } ]
      wrapRules =
        [ WrapRule { onChar = "|"; wrap = wrapPipe; opSlot = ""; nextSlot = "steps" }
          // Enter after a finished expression starts the next STATEMENT, which is what a newline means
          // between two expressions in this language. A wrap rule and not kernel behaviour, because
          // "a newline sequences two things" is a fact about Darklang: a DSL whose newline means
          // something else says so here.
          WrapRule { onChar = "<newline>"; wrap = wrapStatement; opSlot = ""; nextSlot = "next" }
          WrapRule { onChar = "."; wrap = wrapFieldAccess; opSlot = "field"; nextSlot = "field" }
          WrapRule { onChar = "<operator>"; wrap = wrapInfix; opSlot = "op"; nextSlot = "right" } ]
      completions =
        [ Spec.candidate "let" "bind a name" (emptyLet ())
          Spec.candidate "if" "conditional" (emptyIf ())
          Spec.candidate "match" "pattern match" (emptyMatch ())
          Spec.candidate "fun" "lambda" (emptyLambda ())
          Spec.candidate "true" "Bool" (Node.make (exprKind "EBool") [ text "value" "true" ])
          Spec.candidate "false" "Bool" (Node.make (exprKind "EBool") [ text "value" "false" ])
          Spec.candidate "()" "Unit" (Node.make (exprKind "EUnit") []) ]
      complete = completeExpr
      resolve = resolveExprPartial
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.Some variableNode
      actions = exprActions ()
      empty = Node.make (exprKind "EUnit") []
      summary = exprSummary }

let letPatTypeSpec () : Spec =
  Spec
    { kind = Kind.named letPatType
      pieces = [ Piece.Dim "?pattern" ]
      holeRules =
        [ HoleRule { onChar = "<letter>"; fill = HoleFill.WithChar letPatVarFromLetter }
          HoleRule { onChar = "_"; fill = HoleFill.Node(Node.make (letPatKind "LPWildcard") []) } ]
      wrapRules = []
      completions = [ Spec.candidate "()" "unit pattern" (Node.make (letPatKind "LPUnit") []) ]
      complete = Spec.noCompletions
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = Node.make (letPatKind "LPWildcard") []
      summary = exprSummary }

let letPatVarFromLetter (c: String) (e: Expect) : Node =
  Node.make (letPatKind "LPVariable") [ text "name" c ]

let simpleOf (kind: Kind) (pieces: List<Piece>) (empty: Node) : Spec =
  { (Spec.simple kind pieces empty) with summary = exprSummary }

let matchPatVarFromLetter (c: String) (e: Expect) : Node =
  // A capitalised first letter is a constructor pattern (matches the `Ok` case), a lowercase one binds a
  // variable (`x` matches anything). Getting this right is the difference between matching a case and
  // shadowing everything with a binding named after it.
  if (Stdlib.String.toUppercase c) == c then
    Node.make (matchPatKind "MPEnum") [ text "case" c, ("fields", Field.Many([], matchPatExpect "field")) ]
  else
    Node.make (matchPatKind "MPVariable") [ text "name" c ]

let matchPatIntFromDigit (c: String) (e: Expect) : Node =
  Node.make (matchPatKind "MPInt") [ text "digits" c ]

let emptyCase () : Node =
  Node.make
    (Kind.named matchCaseType)
    [ ("pat", Field.One(Slot.Empty(matchPatExpect "pattern")))
      ("when", Field.Many([], exprExpect "when"))
      ("rhs", Field.One(Slot.Empty(exprExpect "rhs"))) ]

let emptyMatch () : Node =
  Node.make
    (exprKind "EMatch")
    [ ("arg", Field.One(Slot.Empty(exprExpect "arg")))
      ("cases", Field.Many([ Slot.Filled(emptyCase ()) ], caseExpect ())) ]

let matchPatTypeSpec () : Spec =
  Spec
    { kind = Kind.named matchPatType
      pieces = [ Piece.Dim "?pattern" ]
      holeRules =
        [ HoleRule { onChar = "<letter>"; fill = HoleFill.WithChar matchPatVarFromLetter }
          HoleRule { onChar = "<digit>"; fill = HoleFill.WithChar matchPatIntFromDigit }
          HoleRule { onChar = "-"; fill = HoleFill.WithChar matchPatIntFromDigit }
          HoleRule { onChar = "'"; fill = HoleFill.Node(Node.make (matchPatKind "MPChar") [ text "char" "" ]) }
          HoleRule { onChar = "\""; fill = HoleFill.Node(Node.make (matchPatKind "MPString") [ text "body" "" ]) }
          HoleRule { onChar = "["; fill = HoleFill.Node(Node.make (matchPatKind "MPList") [ ("items", Field.Many([ Slot.Empty(matchPatExpect "pattern") ], matchPatExpect "pattern")) ]) }
          HoleRule { onChar = "("; fill = HoleFill.Node(Node.make (matchPatKind "MPTuple") [ ("items", Field.Many([ Slot.Empty(matchPatExpect "a"), Slot.Empty(matchPatExpect "b") ], matchPatExpect "pattern")) ]) } ]
      wrapRules =
        [ WrapRule { onChar = "|"; wrap = wrapMatchOr; opSlot = ""; nextSlot = "alts" }
          WrapRule { onChar = ":"; wrap = wrapListCons; opSlot = ""; nextSlot = "tail" } ]
      completions =
        [ Spec.candidate "true" "Bool" (Node.make (matchPatKind "MPBool") [ text "value" "true" ])
          Spec.candidate "false" "Bool" (Node.make (matchPatKind "MPBool") [ text "value" "false" ])
          Spec.candidate "()" "unit" (Node.make (matchPatKind "MPUnit") []) ]
      complete = Spec.noCompletions
      resolve = Spec.noResolve
      binders = Spec.noBinders
      offers = Spec.noOffers
      scopeCandidate = Stdlib.Option.Option.None
      actions = []
      empty = Node.make (matchPatKind "MPVariable") [ text "name" "_" ]
      summary = exprSummary }

let caseSpec () : Spec =
  simpleOf
    (Kind.named matchCaseType)
    [ Piece.Slot "pat"
      Piece.EachWrapped("when", " when ", [], "")
      Piece.Space
      Piece.Punct "->"
      Piece.Group [ Piece.Nest(2, [ Piece.Line, Piece.Slot "rhs" ]) ] ]
    (emptyCase ())
  |> fun sp -> Spec.withBinders sp caseBinders

let listSepPieces () : List<Piece> = [ Piece.Punct ",", Piece.Line ]

let bracketedPieces (openP: String) (slot: String) (closeP: String) : List<Piece> =
  [ Piece.Group
      [ Piece.Punct openP
        Piece.Nest(2, [ Piece.SoftLine, Piece.Each(slot, listSepPieces ()) ])
        Piece.SoftLine
        Piece.Punct closeP ] ]

let moreSpecs () : List<Spec> =
  [ matchPatTypeSpec ()
    pipeTypeSpec ()
    caseSpec ()
    simpleOf (matchPatKind "MPVariable") [ Piece.Text("name", Layout.Style.Name) ] (Node.make (matchPatKind "MPVariable") [ text "name" "" ])
    simpleOf (matchPatKind "MPUnit") [ Piece.Label "()" ] (Node.make (matchPatKind "MPUnit") [])
    simpleOf (matchPatKind "MPBool") [ Piece.Text("value", Layout.Style.Keyword) ] (Node.make (matchPatKind "MPBool") [ text "value" "false" ])
    simpleOf (matchPatKind "MPInt") [ Piece.Text("digits", Layout.Style.Literal) ] (Node.make (matchPatKind "MPInt") [ text "digits" "" ])
    simpleOf (matchPatKind "MPInt64") [ Piece.Text("digits", Layout.Style.Literal), Piece.Punct "L" ] (Node.make (matchPatKind "MPInt64") [ text "digits" "" ])
    simpleOf (matchPatKind "MPFloat") [ Piece.Text("whole", Layout.Style.Literal), Piece.Punct ".", Piece.Text("fraction", Layout.Style.Literal) ] (Node.make (matchPatKind "MPFloat") [ text "whole" "", text "fraction" "" ])
    simpleOf (matchPatKind "MPChar") [ Piece.Punct "'", Piece.QuietText("char", Layout.Style.Literal), Piece.Punct "'" ] (Node.make (matchPatKind "MPChar") [ text "char" "" ])
    simpleOf (matchPatKind "MPString") [ Piece.Punct "\"", Piece.QuietText("body", Layout.Style.Literal), Piece.Punct "\"" ] (Node.make (matchPatKind "MPString") [ text "body" "" ])
    simpleOf (matchPatKind "MPList") (bracketedPieces "[" "items" "]") (Node.make (matchPatKind "MPList") [ ("items", Field.Many([], matchPatExpect "pattern")) ])
    simpleOf (matchPatKind "MPListCons") [ Piece.Slot "head", Piece.Space, Piece.Punct "::", Piece.Space, Piece.Slot "tail" ] (Node.make (matchPatKind "MPListCons") [ ("head", Field.One(Slot.Empty(matchPatExpect "head"))), ("tail", Field.One(Slot.Empty(matchPatExpect "tail"))) ])
    simpleOf (matchPatKind "MPTuple") (bracketedPieces "(" "items" ")") (Node.make (matchPatKind "MPTuple") [ ("items", Field.Many([ Slot.Empty(matchPatExpect "a"), Slot.Empty(matchPatExpect "b") ], matchPatExpect "pattern")) ])
    simpleOf (matchPatKind "MPEnum") [ Piece.Text("case", Layout.Style.Name), Piece.EachWrapped("fields", "(", listSepPieces (), ")") ] (Node.make (matchPatKind "MPEnum") [ text "case" "", ("fields", Field.Many([], matchPatExpect "field")) ])
    simpleOf (matchPatKind "MPOr") [ Piece.Group [ Piece.Each("alts", [ Piece.Space, Piece.Punct "|", Piece.Line ]) ] ] (Node.make (matchPatKind "MPOr") [ ("alts", Field.Many([ Slot.Empty(matchPatExpect "a"), Slot.Empty(matchPatExpect "b") ], matchPatExpect "pattern")) ])
    Spec.withOffers
      (simpleExpr
        "EMatch"
        [ Piece.Keyword "match"
        Piece.Space
        Piece.ParenLowSlot "arg"
        Piece.Space
        Piece.Keyword "with"
        Piece.HardLine
        Piece.EachWith("cases", [ Piece.Punct "|", Piece.Space ], [ Piece.HardLine ]) ]
        (emptyMatch ()))
      matchOffers
    simpleExpr
      "EPipe"
      [ Piece.Slot "first", Piece.HardLine, Piece.EachWith("steps", [ Piece.Punct "|>", Piece.Space ], [ Piece.HardLine ]) ]
      (Node.make (exprKind "EPipe") [ ("first", Field.One(Slot.Empty(exprExpect "value"))), ("steps", Field.Many([ Slot.Empty(pipeExpect "step") ], pipeExpect "step")) ])
    simpleOf (pipeKind "EPipeVariable") [ Piece.Text("name", Layout.Style.Name), Piece.Nest(2, [ Piece.ArgSlots("args", [ Piece.Line ]) ]) ] (Node.make (pipeKind "EPipeVariable") [ text "name" "", ("args", Field.Many([], exprExpect "arg")) ])
    simpleOf (pipeKind "EPipeFnCall") [ Piece.Group [ Piece.NameText("name", Layout.Style.Name), Piece.Nest(2, [ Piece.Line, Piece.ArgSlots("args", [ Piece.Line ]) ]) ] ] (Node.make (pipeKind "EPipeFnCall") [ text "name" "", text "_hash" "", ("args", Field.Many([], exprExpect "arg")) ])
    simpleOf (pipeKind "EPipeLambda") [ Piece.Group [ Piece.Keyword "fun", Piece.Space, Piece.Each("params", [ Piece.Space ]), Piece.Space, Piece.Punct "->", Piece.Nest(2, [ Piece.Line, Piece.Slot "body" ]) ] ] (Node.make (pipeKind "EPipeLambda") [ ("params", Field.Many([ Slot.Empty(letPatExpect "param") ], letPatExpect "param")), ("body", Field.One(Slot.Empty(exprExpect "body"))) ])
    |> fun sp -> Spec.withBinders sp lambdaBinders
    simpleOf (pipeKind "EPipeInfix") [ Piece.Punct "(", Piece.Text("op", Layout.Style.Punct), Piece.Punct ")", Piece.Space, Piece.Slot "expr" ] (Node.make (pipeKind "EPipeInfix") [ text "op" "+", ("expr", Field.One(Slot.Empty(exprExpect "expr"))) ])
    simpleOf (pipeKind "EPipeEnum") [ Piece.NameText("type", Layout.Style.Name), Piece.Punct ".", Piece.Text("case", Layout.Style.Name), Piece.EachWrapped("fields", "(", listSepPieces (), ")") ] (Node.make (pipeKind "EPipeEnum") [ text "type" "", text "_typeHash" "", text "case" "", ("fields", Field.Many([], exprExpect "field")) ])
    simpleOf (Kind.named recordFieldType) [ Piece.FieldText("name", Layout.Style.Name), Piece.Space, Piece.Punct "=", Piece.Space, Piece.Slot "value" ] (Node.make (Kind.named recordFieldType) [ text "name" "", ("value", Field.One(Slot.Empty(exprExpect "value"))) ])
    simpleOf (Kind.named dictPairType) [ Piece.Slot "key", Piece.Punct ":", Piece.Space, Piece.Slot "value" ] (Node.make (Kind.named dictPairType) [ ("key", Field.One(Slot.Empty(exprExpect "key"))), ("value", Field.One(Slot.Empty(exprExpect "value"))) ])
    simpleExpr
      "ERecord"
      [ Piece.Group
          [ Piece.NameText("type", Layout.Style.Name)
            Piece.Space
            Piece.Punct "{"
            Piece.Nest(2, [ Piece.HardLine, Piece.Each("fields", [ Piece.Punct ";", Piece.HardLine ]) ])
            Piece.HardLine
            Piece.Punct "}" ] ]
      (Node.make (exprKind "ERecord") [ text "type" "", text "_typeHash" "", ("fields", Field.Many([], fieldExpect ())) ])
    simpleExpr
      "ERecordUpdate"
      [ Piece.Group
          [ Piece.Punct "{"
            Piece.Space
            Piece.Slot "record"
            Piece.Space
            Piece.Keyword "with"
            Piece.Nest(2, [ Piece.HardLine, Piece.Each("updates", [ Piece.Punct ";", Piece.HardLine ]) ])
            Piece.HardLine
            Piece.Punct "}" ] ]
      (Node.make (exprKind "ERecordUpdate") [ ("record", Field.One(Slot.Empty(exprExpect "record"))), ("updates", Field.Many([], fieldExpect ())) ])
    simpleExpr
      "EEnum"
      [ Piece.NameText("type", Layout.Style.Name), Piece.Punct ".", Piece.Text("case", Layout.Style.Name), Piece.EachWrapped("fields", "(", listSepPieces (), ")") ]
      (Node.make (exprKind "EEnum") [ text "type" "", text "_typeHash" "", text "case" "", ("fields", Field.Many([], exprExpect "field")) ])
    simpleExpr
      "EDict"
      [ Piece.Group
          [ Piece.Keyword "Dict"
            Piece.Space
            Piece.Punct "{"
            Piece.Nest(2, [ Piece.HardLine, Piece.Each("pairs", [ Piece.Punct ";", Piece.HardLine ]) ])
            Piece.HardLine
            Piece.Punct "}" ] ]
      (Node.make (exprKind "EDict") [ ("pairs", Field.Many([], pairExpect ())) ])
    Spec.withOffers
      (simpleExpr "ERecordFieldAccess" [ Piece.FieldTargetSlot "record", Piece.Punct ".", Piece.FieldText("field", Layout.Style.Name) ] (Node.make (exprKind "ERecordFieldAccess") [ ("record", Field.One(Slot.Empty(exprExpect "record"))), text "field" "" ]))
      fieldAccessOffers
    simpleExpr "EValue" [ Piece.Text("name", Layout.Style.Name) ] (Node.make (exprKind "EValue") [ text "name" "", text "_hash" "" ])
    // Flat, not Group: everything between the quotes is part of a string LITERAL, so a break inside it
    // would put a newline and an indent into the string's value.
    simpleExpr "EStringI" [ Piece.Flat [ Piece.Punct "$\"", Piece.Each("segments", []), Piece.Punct "\"" ] ] (Node.make (exprKind "EStringI") [ ("segments", Field.Many([], segmentExpect ())) ])
    simpleOf (segmentKind "StringText") [ Piece.QuietText("text", Layout.Style.Literal) ] (Node.make (segmentKind "StringText") [ text "text" "" ])
    simpleOf (segmentKind "StringInterpolation") [ Piece.Punct "{", Piece.Slot "expr", Piece.Punct "}" ] (Node.make (segmentKind "StringInterpolation") [ ("expr", Field.One(Slot.Empty(exprExpect "expr"))) ]) ]

let baseSpecs () : List<Spec> =
  [ exprTypeSpec ()
    letPatTypeSpec ()
    simpleExpr "EUnit" [ Piece.Label "()" ] (Node.make (exprKind "EUnit") [])
    simpleExpr "EBool" [ Piece.Text("value", Layout.Style.Keyword) ] (Node.make (exprKind "EBool") [ text "value" "false" ])
    simpleExpr "EInt" [ Piece.Text("digits", Layout.Style.Literal) ] (Node.make (exprKind "EInt") [ text "digits" "" ])
    simpleExpr "EInt64" [ Piece.Text("digits", Layout.Style.Literal), Piece.Punct "L" ] (Node.make (exprKind "EInt64") [ text "digits" "" ])
    simpleExpr
      "EFloat"
      [ Piece.Text("whole", Layout.Style.Literal), Piece.Punct ".", Piece.Text("fraction", Layout.Style.Literal) ]
      (Node.make (exprKind "EFloat") [ text "whole" "", text "fraction" "" ])
    simpleExpr "EChar" [ Piece.Punct "'", Piece.QuietText("char", Layout.Style.Literal), Piece.Punct "'" ] (Node.make (exprKind "EChar") [ text "char" "" ])
    simpleExpr "EString" [ Piece.Punct "\"", Piece.QuietText("body", Layout.Style.Literal), Piece.Punct "\"" ] (Node.make (exprKind "EString") [ text "body" "" ])
    simpleExpr
      "EList"
      [ Piece.Group
          [ Piece.Punct "["
            Piece.Nest(2, [ Piece.SoftLine, Piece.Each("items", [ Piece.Punct ",", Piece.Line ]) ])
            Piece.SoftLine
            Piece.Punct "]" ] ]
      (listFromBracket "[" (exprExpect "item"))
    simpleExpr
      "ETuple"
      [ Piece.Group
          [ Piece.Punct "("
            Piece.Nest(2, [ Piece.SoftLine, Piece.Each("items", [ Piece.Punct ",", Piece.Line ]) ])
            Piece.SoftLine
            Piece.Punct ")" ] ]
      (tupleFromParen "(" (exprExpect "item"))
    simpleExpr "EVariable" [ Piece.Text("name", Layout.Style.Name) ] (Node.make (exprKind "EVariable") [ text "name" "" ])
    simpleExpr
      "ELet"
      [ Piece.Keyword "let"
        Piece.Space
        Piece.Slot "pat"
        Piece.Space
        Piece.Punct "="
        Piece.Group [ Piece.Nest(2, [ Piece.Line, Piece.Slot "value" ]) ]
        Piece.HardLine
        Piece.Slot "body" ]
      (emptyLet ())
    |> fun sp -> Spec.withBinders sp letBinders
    simpleExpr
      "EIf"
      [ Piece.Keyword "if"
        Piece.Space
        Piece.ParenLowSlot "cond"
        Piece.Space
        Piece.Keyword "then"
        Piece.Nest(2, [ Piece.HardLine, Piece.Slot "then" ])
        // Zero or one branch, each drawing its own `else` keyword. Nothing here when there is none.
        Piece.Each("else", []) ]
      (emptyIf ())
    |> fun sp -> { sp with actions = ifActions () }
    simpleExpr
      "EInfix"
      [ Piece.Group [ Piece.OperandSlot("left", false), Piece.Space, Piece.Text("op", Layout.Style.Punct), Piece.Line, Piece.OperandSlot("right", true) ] ]
      (Node.make
        (exprKind "EInfix")
        [ ("left", Field.One(Slot.Empty(exprExpect "left"))), text "op" "+", ("right", Field.One(Slot.Empty(exprExpect "right"))) ])
    simpleExpr
      "ELambda"
      [ Piece.Group
          [ Piece.Keyword "fun"
            Piece.Space
            Piece.Each("params", [ Piece.Space ])
            Piece.Space
            Piece.Punct "->"
            Piece.Nest(2, [ Piece.Line, Piece.Slot "body" ]) ] ]
      (emptyLambda ())
    |> fun sp -> Spec.withBinders sp lambdaBinders
    simpleExpr
      "EApply"
      [ Piece.Group [ Piece.Slot "fn", Piece.Nest(2, [ Piece.Line, Piece.ArgSlots("args", [ Piece.Line ]) ]) ] ]
      (Node.make
        (exprKind "EApply")
        [ ("fn", Field.One(Slot.Empty(exprExpect "fn"))), ("args", Field.Many([ Slot.Empty(exprExpect "arg") ], exprExpect "arg")) ])
    simpleExpr "EFnName" [ Piece.Text("name", Layout.Style.Name) ] (Node.make (exprKind "EFnName") [ text "name" "", text "_hash" "" ])
    simpleExpr "EStatement" [ Piece.Slot "first", Piece.HardLine, Piece.Slot "next" ] (Node.make (exprKind "EStatement") [ ("first", Field.One(Slot.Empty(exprExpect "first"))), ("next", Field.One(Slot.Empty(exprExpect "next"))) ])
    simpleExpr "Opaque" [ Piece.Text("source", Layout.Style.Dim) ] (Node.make (exprKind "Opaque") [ text "source" "" ])
    simpleLetPat "LPUnit" [ Piece.Label "()" ] (Node.make (letPatKind "LPUnit") [])
    simpleLetPat "LPWildcard" [ Piece.Label "_" ] (Node.make (letPatKind "LPWildcard") [])
    simpleLetPat "LPVariable" [ Piece.Text("name", Layout.Style.Name) ] (Node.make (letPatKind "LPVariable") [ text "name" "" ])
    // `simpleLetPat`, not `simpleExpr`. Registered under the EXPRESSION kind, this spec was never found
    // for a LetPattern node, so `let (a, b) = t` drew as `let ?pattern = t`: a tuple destructuring you
    // could not see or edit. The pattern survived a save (it is carried whole), so nothing was lost -- it
    // was invisible, which is its own kind of bad in an editor.
    simpleLetPat
      "LPTuple"
      [ Piece.Group [ Piece.Punct "(", Piece.Each("items", [ Piece.Punct ",", Piece.Line ]), Piece.Punct ")" ] ]
      (Node.make (letPatKind "LPTuple") [ ("items", Field.Many([ Slot.Empty(letPatExpect "a"), Slot.Empty(letPatExpect "b") ], letPatExpect "pattern")) ]) ]


// The doc-line spec lives with the expressions rather than with the function shell, because a function, a
// type and a value all draw the same lines and no one of them owns it.
let specs () : List<Spec> =
  Stdlib.List.flatten [ baseSpecs (), moreSpecs (), [ docLineSpec (), elseBranchSpec () ] ]


module Test =
  /// Drive keys from `root`, then the program that results, printed; or the first thing missing.
  let program (reg: Registry) (root: Slot) (keys: List<String>) : String =
    // The same guard `Test.run` has. This drives the editor directly, so without it a mistyped key token
    // is TYPED and the pin quietly tests something else.
    match Fluid.Test.unknownKeys keys with
    | _ :: _ -> "UNKNOWN TEST KEY: " ++ (Stdlib.String.join (Fluid.Test.unknownKeys keys) ", ")
    | [] ->
    let final = Fluid.Test.drive (Editor.init reg root 60) keys
    match final.root with
    | Filled n ->
      match fromDoc n with
      | Ok e -> Darklang.PrettyPrinter.ProgramTypes.expr (printerContext ()) e
      | Error err -> "ERR " ++ err
    | Empty e -> "ERR hole: " ++ e.label
    | Partial(t, _) -> "ERR unresolved: " ++ t


// ============================================================================
// TypeReference: editing types, so signatures and declarations become editable
// (Fluid is for all Darklang code, not only data values).
// ============================================================================

module Types =
  type TypeReference = Darklang.LanguageTools.ProgramTypes.TypeReference

  val typeRefType = "Darklang.LanguageTools.ProgramTypes.TypeReference"

  let typeKind (case: String) : Kind = Kind.ofCase typeRefType case
  let typeExpect (label: String) : Expect = Expect.ofKind (Kind.named typeRefType) label

  // The nullary built-in types: constructor case name paired with how it's written.
  let prims () : List<(String * String)> =
    [ ("TUnit", "Unit"), ("TBool", "Bool"), ("TInt8", "Int8"), ("TUInt8", "UInt8")
      ("TInt16", "Int16"), ("TUInt16", "UInt16"), ("TInt32", "Int32"), ("TUInt32", "UInt32")
      ("TInt64", "Int64"), ("TUInt64", "UInt64"), ("TInt128", "Int128"), ("TUInt128", "UInt128")
      ("TInt", "Int"), ("TFloat", "Float"), ("TChar", "Char"), ("TString", "String")
      ("TDateTime", "DateTime"), ("TUuid", "Uuid"), ("TBlob", "Blob") ]

  let primNode (case: String) : Node = Node.make (typeKind case) []

  let toDoc (t: TypeReference) : Node =
    match t with
    | TVariable name -> Node.make (typeKind "TVariable") [ PT.text "name" name ]
    | TUnit -> primNode "TUnit"
    | TBool -> primNode "TBool"
    | TInt8 -> primNode "TInt8"
    | TUInt8 -> primNode "TUInt8"
    | TInt16 -> primNode "TInt16"
    | TUInt16 -> primNode "TUInt16"
    | TInt32 -> primNode "TInt32"
    | TUInt32 -> primNode "TUInt32"
    | TInt64 -> primNode "TInt64"
    | TUInt64 -> primNode "TUInt64"
    | TInt128 -> primNode "TInt128"
    | TUInt128 -> primNode "TUInt128"
    | TInt -> primNode "TInt"
    | TFloat -> primNode "TFloat"
    | TChar -> primNode "TChar"
    | TString -> primNode "TString"
    | TDateTime -> primNode "TDateTime"
    | TUuid -> primNode "TUuid"
    | TBlob -> primNode "TBlob"
    | TList inner -> Node.make (typeKind "TList") [ PT.one "arg" (toDoc inner) ]
    | TStream inner -> Node.make (typeKind "TStream") [ PT.one "arg" (toDoc inner) ]
    | TDB inner -> Node.make (typeKind "TDB") [ PT.one "arg" (toDoc inner) ]
    | TDict(k, v) -> Node.make (typeKind "TDict") [ PT.one "key" (toDoc k), PT.one "value" (toDoc v) ]
    | TTuple(a, b, rest) ->
      Node.make (typeKind "TTuple") [ PT.many "items" ((Stdlib.List.flatten [ [ a, b ], rest ]) |> Stdlib.List.map (fun x -> toDoc x)) (typeExpect "type") ]
    | TFn(args, ret) ->
      Node.make (typeKind "TFn") [ PT.many "args" (args |> Stdlib.List.map (fun x -> toDoc x)) (typeExpect "arg"), PT.one "ret" (toDoc ret) ]
    | TCustomType(nr, targs) ->
      Node.make
        (typeKind "TCustomType")
        [ PT.text "name" (PT.typeNameOf nr), PT.text "_hash" (PT.typeHashOf nr)
          PT.many "args" (targs |> Stdlib.List.map (fun x -> toDoc x)) (typeExpect "type arg") ]

  let itemTypes (n: Node) (name: String) : Stdlib.Result.Result<List<TypeReference>, String> =
    Node.items n name
    |> Stdlib.List.map (fun s ->
      match s with
      | Filled c -> fromDoc c
      | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
      | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
    |> Stdlib.Result.collect

  let slotType (n: Node) (name: String) : Stdlib.Result.Result<TypeReference, String> =
    match Node.slot n name with
    | Some(Filled c) -> fromDoc c
    | Some(Empty e) -> Stdlib.Result.Result.Error("hole: " ++ e.label)
    | Some(Partial(t, _)) -> Stdlib.Result.Result.Error("unresolved: " ++ t)
    | None -> Stdlib.Result.Result.Error("missing " ++ name)

  let fromDoc (n: Node) : Stdlib.Result.Result<TypeReference, String> =
    let ok (t: TypeReference) : Stdlib.Result.Result<TypeReference, String> = Stdlib.Result.Result.Ok t
    match n.kind.case with
    | Some "TVariable" -> ok (TypeReference.TVariable(PT.textOf n "name"))
    | Some "TUnit" -> ok TypeReference.TUnit
    | Some "TBool" -> ok TypeReference.TBool
    | Some "TInt8" -> ok TypeReference.TInt8
    | Some "TUInt8" -> ok TypeReference.TUInt8
    | Some "TInt16" -> ok TypeReference.TInt16
    | Some "TUInt16" -> ok TypeReference.TUInt16
    | Some "TInt32" -> ok TypeReference.TInt32
    | Some "TUInt32" -> ok TypeReference.TUInt32
    | Some "TInt64" -> ok TypeReference.TInt64
    | Some "TUInt64" -> ok TypeReference.TUInt64
    | Some "TInt128" -> ok TypeReference.TInt128
    | Some "TUInt128" -> ok TypeReference.TUInt128
    | Some "TInt" -> ok TypeReference.TInt
    | Some "TFloat" -> ok TypeReference.TFloat
    | Some "TChar" -> ok TypeReference.TChar
    | Some "TString" -> ok TypeReference.TString
    | Some "TDateTime" -> ok TypeReference.TDateTime
    | Some "TUuid" -> ok TypeReference.TUuid
    | Some "TBlob" -> ok TypeReference.TBlob
    | Some "TList" -> slotType n "arg" |> Stdlib.Result.map (fun t -> TypeReference.TList t)
    | Some "TStream" -> slotType n "arg" |> Stdlib.Result.map (fun t -> TypeReference.TStream t)
    | Some "TDB" -> slotType n "arg" |> Stdlib.Result.map (fun t -> TypeReference.TDB t)
    | Some "TDict" ->
      match (slotType n "key", slotType n "value") with
      | (Ok k, Ok v) -> ok (TypeReference.TDict(k, v))
      | (Error e, _) -> Stdlib.Result.Result.Error e
      | (_, Error e) -> Stdlib.Result.Result.Error e
    | Some "TTuple" ->
      match itemTypes n "items" with
      | Ok(a :: b :: rest) -> ok (TypeReference.TTuple(a, b, rest))
      | Ok _ -> Stdlib.Result.Result.Error "a tuple type needs two members"
      | Error e -> Stdlib.Result.Result.Error e
    | Some "TFn" ->
      match (itemTypes n "args", slotType n "ret") with
      | (Ok args, Ok ret) -> ok (TypeReference.TFn(args, ret))
      | (Error e, _) -> Stdlib.Result.Result.Error e
      | (_, Error e) -> Stdlib.Result.Result.Error e
    | Some "TCustomType" ->
      match (PT.typeNameResolution (PT.textOf n "name") (PT.textOf n "_hash"), itemTypes n "args") with
      | (Ok nr, Ok targs) -> ok (TypeReference.TCustomType(nr, targs))
      | (Error e, _) -> Stdlib.Result.Result.Error e
      | (_, Error e) -> Stdlib.Result.Result.Error e
    | _ -> Stdlib.Result.Result.Error("not a type: " ++ (Kind.toString n.kind))

  // --- Specs ---

  let simpleType (case: String) (pieces: List<Piece>) (empty: Node) : Spec =
    { (Spec.simple (typeKind case) pieces empty) with summary = PT.exprSummary }

  let primSpecs () : List<Spec> =
    prims ()
    |> Stdlib.List.map (fun pair ->
      let (case, written) = pair
      simpleType case [ Piece.Label written ] (primNode case))

  /// A completion candidate for each built-in type, the containers (with holes), and any custom types
  /// whose name matches. This is what a type hole offers the moment you land on it.
  let completeType (e: Expect) (typed: String) : List<Candidate> =
    if Stdlib.Bool.not (PT.shouldSearch typed) then
      []
    else
      let query =
        Darklang.LanguageTools.ProgramTypes.Search.SearchQuery
          { currentModule = []
            text = Stdlib.String.split typed "." |> Stdlib.List.last |> Stdlib.Option.withDefault typed
            searchDepth = Darklang.LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
            entityTypes = [ Darklang.LanguageTools.ProgramTypes.Search.EntityType.Type ]
            exactMatch = false }
      // RANKED, like function and record candidates already are. The store's order is the store's, so
      // typing `Colour` offered `Darklang.Fluid.Layout.Style` above `Stachu.Scratch.Colour` -- the exact
      // name, second. Same shape as the fix that stopped `Size` offering `Stdlib.Dict.size` first.
      PT.ranked typed (Darklang.LanguageTools.PackageManager.Search.search Darklang.SCM.Branch.mainBranchId query).types
      |> Stdlib.List.take 5
      |> Stdlib.List.map (fun item ->
        let name = PT.locationName item.location
        let hash = Darklang.LanguageTools.ProgramTypes.hashToString item.entity.hash
        Spec.candidate (PT.displayName name) "type" (Node.make (typeKind "TCustomType") [ PT.text "name" name, PT.text "_hash" hash, ("args", Field.Many([], typeExpect "type arg")) ]))

  /// Is this node a function type? The printer brackets one only when it is nested inside another, so
  /// this is the test the TFn spec hands to ParenIf.
  let isFnType (n: Node) : Bool = n.kind.case == Stdlib.Option.Option.Some "TFn"

  let typeVarFromLetter (c: String) (e: Expect) : Node = Node.make (typeKind "TVariable") [ PT.text "name" c ]

  let resolveTypePartial (typed: String) : Stdlib.Option.Option<Node> =
    // A lowercase identifier is a type variable (`a`, `key`); anything else stays a partial. A leading
    // quote is how the language writes one, so `'a` resolves to the same thing as `a` rather than sitting
    // there as a partial nothing can lower.
    let bare = if Stdlib.String.startsWith typed "'" then Stdlib.String.dropFirst typed 1 else typed
    if PT.isIdentifier bare && (Stdlib.String.toLowercase bare) == bare then
      Stdlib.Option.Option.Some(Node.make (typeKind "TVariable") [ PT.text "name" bare ])
    else
      Stdlib.Option.Option.None

  let primCandidates () : List<Candidate> =
    prims () |> Stdlib.List.map (fun pair ->
      let (case, written) = pair
      Spec.candidate written "type" (primNode case))

  let containerCandidates () : List<Candidate> =
    [ Spec.candidate "List" "List<_>" (Node.make (typeKind "TList") [ ("arg", Field.One(Slot.Empty(typeExpect "item"))) ])
      Spec.candidate "Dict" "Dict<_, _>" (Node.make (typeKind "TDict") [ ("key", Field.One(Slot.Empty(typeExpect "key"))), ("value", Field.One(Slot.Empty(typeExpect "value"))) ])
      Spec.candidate "Tuple" "(_ * _)" (Node.make (typeKind "TTuple") [ ("items", Field.Many([ Slot.Empty(typeExpect "a"), Slot.Empty(typeExpect "b") ], typeExpect "type")) ])
      Spec.candidate "Fn" "(_ -> _)" (Node.make (typeKind "TFn") [ ("args", Field.Many([ Slot.Empty(typeExpect "arg") ], typeExpect "arg")), ("ret", Field.One(Slot.Empty(typeExpect "return"))) ]) ]

  let typeTypeSpec () : Spec =
    Spec
      { kind = Kind.named typeRefType
        pieces = [ Piece.Dim "?type" ]
        holeRules =
          // A type variable is written `'a`, and now that the screen SAYS `'a`, that is what people type.
          // The quote opens the variable and the letters go in its name; the piece draws the quote back.
          [ HoleRule { onChar = "'"; fill = HoleFill.Node(Node.make (typeKind "TVariable") [ PT.text "name" "" ]) }
            HoleRule { onChar = "["; fill = HoleFill.Node(Node.make (typeKind "TList") [ ("arg", Field.One(Slot.Empty(typeExpect "item"))) ]) }
            HoleRule { onChar = "("; fill = HoleFill.Node(Node.make (typeKind "TTuple") [ ("items", Field.Many([ Slot.Empty(typeExpect "a"), Slot.Empty(typeExpect "b") ], typeExpect "type")) ]) } ]
        wrapRules = []
        completions = Stdlib.List.append (primCandidates ()) (containerCandidates ())
        complete = completeType
        resolve = resolveTypePartial
        binders = Spec.noBinders
        offers = Spec.noOffers
        scopeCandidate = Stdlib.Option.Option.None
        actions = []
        empty = primNode "TInt"
        summary = PT.exprSummary }

  /// `Name<...>`: the argument list breaks exactly the way the printer's `wrapExprs` does -- brackets on
  /// their own lines, arguments at a two-space indent. Written out here rather than reused from
  /// EachWrapped because these containers have NAMED slots rather than a list of them.
  let angled (name: String) (inner: List<Piece>) : List<Piece> =
    [ Piece.Keyword name
      Piece.Group
        [ Piece.Punct "<"
          Piece.Nest(2, Stdlib.List.append [ Piece.SoftLine ] inner)
          Piece.SoftLine
          Piece.Punct ">" ] ]

  let specs () : List<Spec> =
    Stdlib.List.flatten
      [ [ typeTypeSpec () ]
        primSpecs ()
        [ // A type variable is written with its quote: the pretty-printer emits `'a` (programTypes.dark and
          // runtimeTypes.dark both do `"'" ++ varName`), and Fluid drew a bare `a`, so a generic signature on
          // screen wasn't the signature the printer would write.
          simpleType "TVariable" [ Piece.Punct "'", Piece.Text("name", Layout.Style.Name) ] (Node.make (typeKind "TVariable") [ PT.text "name" "" ])
          // `List<...>`, `Stream<...>`, `DB<...>` and `Dict<..., ...>` used to be written with hard brackets
          // and a hard space, so nothing in them could break: a long element type ran off the end of the
          // line instead of going to its own, and `List<(A * B)>` inside an enum case overflowed the width
          // where the printer breaks it. The generic `TCustomType` had already been fixed; these four were
          // spelled separately and kept the old shape.
          simpleType "TList" (angled "List" [ Piece.Slot "arg" ]) (Node.make (typeKind "TList") [ ("arg", Field.One(Slot.Empty(typeExpect "item"))) ])
          simpleType "TStream" (angled "Stream" [ Piece.Slot "arg" ]) (Node.make (typeKind "TStream") [ ("arg", Field.One(Slot.Empty(typeExpect "item"))) ])
          simpleType "TDB" (angled "DB" [ Piece.Slot "arg" ]) (Node.make (typeKind "TDB") [ ("arg", Field.One(Slot.Empty(typeExpect "item"))) ])
          simpleType "TDict" (angled "Dict" [ Piece.Slot "key", Piece.Punct ",", Piece.Line, Piece.Slot "value" ]) (Node.make (typeKind "TDict") [ ("key", Field.One(Slot.Empty(typeExpect "key"))), ("value", Field.One(Slot.Empty(typeExpect "value"))) ])
          // A tuple breaks after the star, not around it, and the continuation lines up one column in --
          // under the opening paren -- because the printer nests by 1 inside its `parens`.
          simpleType "TTuple" [ Piece.Group [ Piece.Punct "(", Piece.Nest(1, [ Piece.ParenIfEach("items", [ Piece.Space, Piece.Punct "*", Piece.Line ], isFnType) ]), Piece.Punct ")" ] ] (Node.make (typeKind "TTuple") [ ("items", Field.Many([ Slot.Empty(typeExpect "a"), Slot.Empty(typeExpect "b") ], typeExpect "type")) ])
          // Written bare, with brackets only where one function type is nested in another -- which is what the
          // printer does, and what `(fn: 'a -> 'b)` should read as.
          // An arrow chain breaks AFTER each arrow, all the arrows together, which is the printer's single
          // group over `join parts (" ->" ++ line)`. With hard spaces it could not break at all, and a
          // record field holding a four-argument function ran off the end of the line.
          simpleType "TFn" [ Piece.Group [ Piece.ParenIfEach("args", [ Piece.Space, Piece.Punct "->", Piece.Line ], isFnType), Piece.Space, Piece.Punct "->", Piece.Line, Piece.ParenIfSlot("ret", isFnType) ] ] (Node.make (typeKind "TFn") [ ("args", Field.Many([ Slot.Empty(typeExpect "arg") ], typeExpect "arg")), ("ret", Field.One(Slot.Empty(typeExpect "return"))) ])
          simpleType "TCustomType" [ Piece.NameText("name", Layout.Style.Name), Piece.EachWrapped("args", "<", [ Piece.Punct ",", Piece.Line ], ">") ] (Node.make (typeKind "TCustomType") [ PT.text "name" "", PT.text "_hash" "", ("args", Field.Many([], typeExpect "type arg")) ]) ] ]


// ============================================================================
// The function shell: a whole PackageFn as one document (name, typed params,
// return type, body), so `dark edit <fn>` edits the signature, not just the body.
// ============================================================================

module Fn =
  type PackageFn = Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn
  type Parameter = Darklang.LanguageTools.ProgramTypes.PackageFn.Parameter

  val fnType = "Darklang.Fluid.PT.Fn.Function"
  val paramType = "Darklang.Fluid.PT.Fn.Param"

  let fnKind () : Kind = Kind.named fnType
  let paramKind () : Kind = Kind.named paramType

  /// A nullary function's one parameter. It is a CASE of the param kind, not a type of its own, so a param
  /// hole still finds the ordinary `(name: Type)` spec at the type level and nothing about holes changes.
  let unitParamKind () : Kind = Kind.ofCase paramType "Unit"

  let paramExpect () : Expect = Expect.ofKind (paramKind ()) "param"

  /// `()` in a declaration parses as ONE parameter named `_` of type Unit. Drawn through the general
  /// `(name: Type)` shape that came out as `(_: Unit)`, which the parser then rejects -- so a nullary
  /// function drew as source you could not save back. The printer already special-cases this exact shape
  /// (see `parameterDoc`); Fluid did not. Two paths to the same decision, one of them missed, again.
  let paramToDoc (p: Parameter) : Node =
    let isUnitPlaceholder =
      match p.typ with
      | TUnit -> p.name == "_"
      | _ -> false

    if isUnitPlaceholder then
      Node.make (unitParamKind ()) []
    else
      Node.make (paramKind ()) [ PT.text "name" p.name, PT.one "type" (Types.toDoc p.typ) ]

  /// A function as a document. `name` is seeded from the item's location; `_hash`, typeParams and
  /// description are carried opaquely so a save can rebuild the whole PackageFn.
  let toDoc (name: String) (fn: PackageFn) : Node =
    Node.make
      (fnKind ())
      [ PT.text "name" name
        PT.text "_hash" (Darklang.LanguageTools.ProgramTypes.hashToString fn.hash)
        PT.docField fn.description
        // A generic function is written `let map<'a, 'b> (...)`, and Fluid drew `let map (...)` -- the
        // params were carried opaquely on the original record, so they survived a save but were invisible
        // while you edited. The node is TypeDecl's TypeParam, deliberately: a declaration and a function
        // spell a type param the same way, and one spec means they can't drift apart.
        PT.many "typeParams" (fn.typeParams |> Stdlib.List.map (fun tp -> TypeDecl.paramToDoc tp)) (TypeDecl.paramExpect ())
        PT.many "params" (fn.parameters |> Stdlib.List.map (fun p -> paramToDoc p)) (paramExpect ())
        PT.one "ret" (Types.toDoc fn.returnType)
        PT.one "body" (PT.toDoc (PT.namedArgs (fn.parameters |> Stdlib.List.map (fun p -> p.name)) name fn.body)) ]

  let paramFromDoc (n: Node) : Stdlib.Result.Result<Parameter, String> =
    if n.kind == unitParamKind () then
      Stdlib.Result.Result.Ok(
        Darklang.LanguageTools.ProgramTypes.PackageFn.Parameter
          { name = "_"
            typ = Darklang.LanguageTools.ProgramTypes.TypeReference.TUnit
            description = "" })
    else
      match Types.slotType n "type" with
      | Ok t ->
        Stdlib.Result.Result.Ok(
          Darklang.LanguageTools.ProgramTypes.PackageFn.Parameter
            { name = PT.textOf n "name"; typ = t; description = "" })
      | Error e -> Stdlib.Result.Result.Error e

  /// Rebuild a PackageFn from `orig` (for the fields the document doesn't edit) plus the document's
  /// params, return type and body. Returns the (possibly changed) name alongside.
  let fromDoc (orig: PackageFn) (n: Node) : Stdlib.Result.Result<(String * PackageFn), String> =
    let params =
      Node.items n "params"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled c -> paramFromDoc c
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
    let ret =
      match Node.slot n "ret" with
      | Some(Filled c) -> Types.fromDoc c
      | _ -> Stdlib.Result.Result.Error "the return type is a hole"
    let body =
      match Node.slot n "body" with
      | Some(Filled c) -> PT.fromDoc c
      | _ -> Stdlib.Result.Result.Error "the body is a hole"
    let tps =
      Node.items n "typeParams"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled c -> Stdlib.Result.Result.Ok(PT.textOf c "name")
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
    match (params, ret, body, tps) with
    | (Ok ps, Ok r, Ok b, Ok tp) ->
      Stdlib.Result.Result.Ok(
        (PT.textOf n "name",
         { orig with
             typeParams = tp
             parameters = ps
             returnType = r
             body = b
             description = PT.docText n }))
    | (Error e, _, _, _) -> Stdlib.Result.Result.Error e
    | (_, Error e, _, _) -> Stdlib.Result.Result.Error e
    | (_, _, Error e, _) -> Stdlib.Result.Result.Error e
    | (_, _, _, Error e) -> Stdlib.Result.Result.Error e

  // --- Specs ---

  let paramSpec () : Spec =
    { (Spec.simple
        (paramKind ())
        [ Piece.Punct "("
          Piece.Text("name", Layout.Style.Name)
          Piece.Punct ":"
          Piece.Space
          Piece.Slot "type"
          Piece.Punct ")" ]
        (Node.make (paramKind ()) [ PT.text "name" "", ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])) with
        summary = PT.exprSummary }

  /// The empty parameter list, drawn as it is written and parsed. No fields, like `EUnit` one level down.
  let unitParamSpec () : Spec =
    { (Spec.simple (unitParamKind ()) [ Piece.Label "()" ] (Node.make (unitParamKind ()) [])) with
        summary = PT.exprSummary }

  /// A parameter with nothing filled in: `(⟨name⟩: ⟨type⟩)`. The name is an empty text slot, which is a
  /// hole, so Tab stops there before the type.
  let blankParam () : Slot =
    Slot.Filled(
      Node.make
        (paramKind ())
        [ PT.text "name" "", ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])

  /// A function that does not exist yet: a name, `()` for its parameters, and a hole for the return type
  /// and the body. Shared with the spec's `empty` so a blank function has one shape, whether it came from
  /// the palette or from `dark fn <name>` with nothing after it.
  ///
  /// `()` and not an empty list, because a function with NO parameter list is not a function -- `let f:
  /// Int = 3` is a value. So the blank shape is one you could save as it stands, and `(` turns it into a
  /// real parameter.
  let emptyDocFor (name: String) : Node =
    Node.make
      (fnKind ())
      [ PT.text "name" name
        PT.text "_hash" ""
        PT.emptyDocField ()
        ("params", Field.Many([ Slot.Filled(Node.make (unitParamKind ()) []) ], paramExpect ()))
        ("ret", Field.One(Slot.Empty(Types.typeExpect "return")))
        ("body", Field.One(Slot.Empty(PT.exprExpect "body"))) ]

  /// Is this the `()` that stands for "no parameters"?
  let isUnitParam (s: Slot) : Bool =
    match s with
    | Filled c -> c.kind == unitParamKind ()
    | _ -> false

  /// Add a parameter. A lone `()` is REPLACED rather than appended to: `()` means the function takes
  /// nothing, so `() (x: Int)` is not a shape the language has.
  let addParam (n: Node) : Slot =
    let existing = Node.items n "params"
    let kept =
      if ((Stdlib.List.length existing) == 1) && (existing |> Stdlib.List.all isUnitParam) then
        []
      else
        existing
    Slot.Filled(Node.setField n "params" (Field.Many(Stdlib.List.append kept [ blankParam () ], paramExpect ())))

  /// Back to `()`, for a function that turns out to take nothing.
  let clearParams (n: Node) : Slot =
    Slot.Filled(
      Node.setField
        n
        "params"
        (Field.Many([ Slot.Filled(Node.make (unitParamKind ()) []) ], paramExpect ())))

  /// A function's parameters are in scope in its body.
  ///
  /// They were in scope NOWHERE: `scopeNames` walks each ancestor's `binders`, and the function shell had
  /// none, so writing a body offered no completion for the arguments you had just declared. Typing them
  /// worked only because a lowercase identifier resolves to a variable whatever it is.
  /// Each parameter's name AND the type it was declared with -- the only binder in the language that
  /// declares one, and the reason `Binding` carries a type at all.
  let fnBinders (n: Node) : List<(List<Binding> * List<String>)> =
    let bindings =
      Node.items n "params"
      |> Stdlib.List.filterMap (fun s ->
        match s with
        | Filled c ->
          let name = PT.textOf c "name"

          if name == "" then
            Stdlib.Option.Option.None
          else
            Stdlib.Option.Option.Some(
              Binding
                { name = name
                  typ =
                    match Node.slot c "type" with
                    | Some(Filled t) -> Stdlib.Option.Option.Some t
                    | _ -> Stdlib.Option.Option.None })
        | _ -> Stdlib.Option.Option.None)

    [ (bindings, [ "body" ]) ]

  let fnActions () : List<Action> =
    [ Action
        { name = "add a parameter"
          key = Stdlib.Option.Option.Some "("
          doc = "one more (name: Type)"
          applies = (fun _ -> true)
          run = addParam }
      Action
        { name = "takes nothing"
          key = Stdlib.Option.Option.None
          doc = "back to ()"
          applies = (fun _ -> true)
          run = clearParams } ]

  /// The whole function, laid out the way it reads as source: `let name (params) : ret =` then the body,
  /// indented on its own lines (vertical bias).
  let fnSpec () : Spec =
    { (Spec.simple
        (fnKind ())
        // The doc comment sits OUTSIDE the signature's group: each line ends in a HardLine, and inside the
        // group they would be flattened along with it.
        [ Piece.Each("doc", [])
          Piece.Group
            [ Piece.Keyword "let"
              Piece.Space
              Piece.Text("name", Layout.Style.Name)
              Piece.EachWrapped("typeParams", "<", [ Piece.Punct ",", Piece.Space ], ">")
              // The parameters are separated by a LINE, not a hard space, so a signature that doesn't fit
              // puts one parameter per line the way the printer does. With a hard space the list could not
              // break at all, and the only thing left that could was a type INSIDE a parameter -- so
              // `Result.map2` came out with `Result<` split across three lines mid-parameter. Same bug as
              // the type arguments, one level up.
              Piece.Nest(
                2,
                [ Piece.EachWith("params", [ Piece.Line ], [])
                  // Nothing before the colon when it fits, a newline when it doesn't: the printer writes
                  // `(list: List<'a>): Int` on one line and `  : Result<'c, 'e> =` on its own.
                  Piece.SoftLine
                  Piece.Punct ":"
                  Piece.Space
                  Piece.Slot "ret"
                  Piece.Space
                  Piece.Punct "=" ]) ]
          Piece.Nest(2, [ Piece.HardLine, Piece.Slot "body" ]) ]
        (emptyDocFor "unnamed")) with
        actions = fnActions ()
        binders = fnBinders
        summary = (fun n -> "let " ++ (PT.textOf n "name")) }

  let specs () : List<Spec> = [ fnSpec (), paramSpec (), unitParamSpec () ]


// ============================================================================
// The type-declaration shell: a whole PackageType as one document -- name, type
// params, and a record / enum / alias definition. Reuses PT.Types for every type.
// ============================================================================

module TypeDecl =
  type PackageType = Darklang.LanguageTools.ProgramTypes.PackageType.PackageType
  type Def = Darklang.LanguageTools.ProgramTypes.TypeDeclaration.Definition
  type RecordField = Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField
  type EnumCase = Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase
  type EnumField = Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField

  val ns = "Darklang.Fluid.PT.TypeDecl"
  let k (case: String) : Kind = Kind.ofCase ns case
  let defExpect () : Expect = Expect.ofKind (Kind.named (ns ++ ".Def")) "definition"
  let fieldExpect () : Expect = Expect.ofKind (k "RecordField") "field"
  let caseExpect2 () : Expect = Expect.ofKind (k "EnumCase") "case"
  let efExpect () : Expect = Expect.ofKind (k "EnumField") "field"
  let efLabelExpect () : Expect = Expect.ofKind (k "EnumFieldLabel") "label"
  let paramExpect () : Expect = Expect.ofKind (k "TypeParam") "type param"

  // --- to the document ---

  let paramToDoc (name: String) : Node = Node.make (k "TypeParam") [ PT.text "name" name ]

  let recordFieldToDoc (f: RecordField) : Node =
    Node.make (k "RecordField") [ PT.text "name" f.name, PT.one "type" (Types.toDoc f.typ) ]

  /// An enum field is a type, optionally LABELLED (`| TDict of key: X * value: Y`). The label used to be
  /// dropped on the way into the document and rebuilt as None on the way out, and since saveType prints
  /// the rebuilt declaration and applies it as source, saving a labelled type silently erased its labels.
  /// Pieces have no conditional, so the label is a list of nought-or-one: `Each` already draws nothing for
  /// an empty one.
  let enumFieldToDoc (ef: EnumField) : Node =
    let labels =
      match ef.label with
      | Some l -> [ Node.make (k "EnumFieldLabel") [ PT.text "name" l ] ]
      | None -> []
    Node.make (k "EnumField") [ PT.many "label" labels (efLabelExpect ()), PT.one "type" (Types.toDoc ef.typ) ]

  let enumCaseToDoc (c: EnumCase) : Node =
    Node.make
      (k "EnumCase")
      [ PT.text "name" c.name
        PT.many "fields" (c.fields |> Stdlib.List.map (fun ef -> enumFieldToDoc ef)) (efExpect ()) ]

  let defToDoc (d: Def) : Node =
    match d with
    | Alias t -> Node.make (k "Alias") [ PT.one "type" (Types.toDoc t) ]
    | Record fields ->
      Node.make (k "Record") [ PT.many "fields" (fields |> Stdlib.List.map (fun f -> recordFieldToDoc f)) (fieldExpect ()) ]
    | Enum cases ->
      Node.make (k "Enum") [ PT.many "cases" (cases |> Stdlib.List.map (fun c -> enumCaseToDoc c)) (caseExpect2 ()) ]

  let toDoc (name: String) (pt: PackageType) : Node =
    Node.make
      (k "Type")
      [ PT.text "name" name
        PT.text "_hash" (Darklang.LanguageTools.ProgramTypes.hashToString pt.hash)
        PT.docField pt.description
        PT.many "params" (pt.declaration.typeParams |> Stdlib.List.map (fun p -> paramToDoc p)) (paramExpect ())
        PT.one "def" (defToDoc pt.declaration.definition) ]

  // --- back to the program ---

  let typeItems (n: Node) (name: String) : Stdlib.Result.Result<List<Darklang.LanguageTools.ProgramTypes.TypeReference>, String> =
    Node.items n name
    |> Stdlib.List.map (fun s ->
      match s with
      | Filled c -> Types.fromDoc c
      | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
      | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
    |> Stdlib.Result.collect

  let recordFieldFromDoc (n: Node) : Stdlib.Result.Result<RecordField, String> =
    match Types.slotType n "type" with
    | Ok t ->
      Stdlib.Result.Result.Ok(
        Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField { name = PT.textOf n "name"; typ = t; description = "" })
    | Error e -> Stdlib.Result.Result.Error e

  let enumFieldFromDoc (n: Node) : Stdlib.Result.Result<EnumField, String> =
    match Types.slotType n "type" with
    | Ok t ->
      let label =
        Node.items n "label"
        |> Stdlib.List.head
        |> Stdlib.Option.andThen (fun s -> Slot.node s)
        |> Stdlib.Option.map (fun ln -> PT.textOf ln "name")
      Stdlib.Result.Result.Ok(
        Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField { typ = t; label = label; description = "" })
    | Error e -> Stdlib.Result.Result.Error e

  let enumCaseFromDoc (n: Node) : Stdlib.Result.Result<EnumCase, String> =
    let efs =
      Node.items n "fields"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled c -> enumFieldFromDoc c
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
    match efs with
    | Ok fields ->
      Stdlib.Result.Result.Ok(
        Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase { name = PT.textOf n "name"; fields = fields; description = "" })
    | Error e -> Stdlib.Result.Result.Error e

  let defFromDoc (n: Node) : Stdlib.Result.Result<Def, String> =
    match n.kind.case with
    | Some "Alias" ->
      match Types.slotType n "type" with
      | Ok t -> Stdlib.Result.Result.Ok(Def.Alias t)
      | Error e -> Stdlib.Result.Result.Error e
    | Some "Record" ->
      Node.items n "fields"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled c -> recordFieldFromDoc c
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
      |> Stdlib.Result.map (fun fs -> Def.Record fs)
    | Some "Enum" ->
      Node.items n "cases"
      |> Stdlib.List.map (fun s ->
        match s with
        | Filled c -> enumCaseFromDoc c
        | Empty e -> Stdlib.Result.Result.Error("hole: " ++ e.label)
        | Partial(t, _) -> Stdlib.Result.Result.Error("unresolved: " ++ t))
      |> Stdlib.Result.collect
      |> Stdlib.Result.map (fun cs -> Def.Enum cs)
    | _ -> Stdlib.Result.Result.Error("not a type definition: " ++ (Kind.toString n.kind))

  /// Rebuild a PackageType from `orig` plus the document's params and definition. Returns the name too.
  let fromDoc (orig: PackageType) (n: Node) : Stdlib.Result.Result<(String * PackageType), String> =
    let params =
      Node.items n "params"
      |> Stdlib.List.filterMap (fun s -> Slot.node s)
      |> Stdlib.List.map (fun c -> PT.textOf c "name")
    let def =
      match Node.slot n "def" with
      | Some(Filled c) -> defFromDoc c
      | _ -> Stdlib.Result.Result.Error "the definition is a hole"
    match def with
    | Ok d ->
      let decl =
        Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration { typeParams = params; definition = d }
      Stdlib.Result.Result.Ok(
        (PT.textOf n "name", { orig with declaration = decl; description = PT.docText n }))
    | Error e -> Stdlib.Result.Result.Error e

  // --- specs ---

  let simpleT (case: String) (pieces: List<Piece>) (empty: Node) : Spec =
    { (Spec.simple (k case) pieces empty) with summary = PT.exprSummary }

  /// A type that does not exist yet: the name you gave and a hole for the definition. Shared with the
  /// spec's `empty`, so a blank type has one shape whether it came from the palette or from
  /// `dark type <name>` with nothing after it.
  let emptyDocFor (name: String) : Node =
    Node.make
      (k "Type")
      [ PT.text "name" name
        PT.text "_hash" ""
        PT.emptyDocField ()
        ("params", Field.Many([], paramExpect ()))
        ("def", Field.One(Slot.Empty(defExpect ()))) ]

  /// Typing a name into a case hole makes that case, and into a field hole makes that field.
  ///
  /// A case and a field are NAMES. There is no menu of them to match against, so nothing settled what you
  /// typed and it sat there as a partial that draws exactly like the real thing and refuses to lower:
  /// "not saved: unresolved: Red", under a screen reading `| Red`. `resolve` is the spec's own answer to
  /// "what does this text mean here", and for these two kinds it had none.
  let resolveCase (typed: String) : Stdlib.Option.Option<Node> =
    if PT.isIdentifier typed then
      Stdlib.Option.Option.Some(
        Node.make (k "EnumCase") [ PT.text "name" typed, ("fields", Field.Many([], efExpect ())) ])
    else
      Stdlib.Option.Option.None

  let resolveField (typed: String) : Stdlib.Option.Option<Node> =
    if PT.isIdentifier typed then
      Stdlib.Option.Option.Some(
        Node.make
          (k "RecordField")
          [ PT.text "name" typed, ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])
    else
      Stdlib.Option.Option.None

  let specs () : List<Spec> =
    [ simpleT
        "Type"
        [ Piece.Each("doc", [])
          Piece.Group
            [ Piece.Keyword "type"
              Piece.Space
              Piece.Text("name", Layout.Style.Name)
              Piece.EachWrapped("params", "<", [ Piece.Punct ",", Piece.Space ], ">")
              Piece.Space
              Piece.Punct "=" ]
          Piece.Nest(2, [ Piece.HardLine, Piece.Slot "def" ]) ]
        (emptyDocFor "Unnamed")
      // A declaration's own type params carry the quote too: the printer writes `type Option<'v>`, and
      // Fluid drew `type Option<v>`. The CASES were already right, because those are TypeReferences.
      simpleT "TypeParam" [ Piece.Punct "'", Piece.Text("name", Layout.Style.Name) ] (Node.make (k "TypeParam") [ PT.text "name" "" ])
      // definition: a hole here offers record / enum / alias
      { (Spec.simple (Kind.named (ns ++ ".Def")) [ Piece.Dim "?definition" ] (Node.make (k "Record") [ ("fields", Field.Many([], fieldExpect ())) ])) with
          completions =
            [ Spec.candidate "record" "{ fields }" (Node.make (k "Record") [ ("fields", Field.Many([ Slot.Empty(fieldExpect ()) ], fieldExpect ())) ])
              Spec.candidate "enum" "| cases" (Node.make (k "Enum") [ ("cases", Field.Many([ Slot.Empty(caseExpect2 ()) ], caseExpect2 ())) ])
              Spec.candidate "alias" "= a type" (Node.make (k "Alias") [ ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ]) ]
          summary = PT.exprSummary }
      simpleT
        "Record"
        [ Piece.Punct "{"
          Piece.Space
          Piece.Nest(2, [ Piece.Each("fields", [ Piece.HardLine ]) ])
          Piece.Space
          Piece.Punct "}" ]
        (Node.make (k "Record") [ ("fields", Field.Many([ Slot.Empty(fieldExpect ()) ], fieldExpect ())) ])
      simpleT
        "Enum"
        [ Piece.EachWith("cases", [ Piece.Punct "|", Piece.Space ], [ Piece.HardLine ]) ]
        (Node.make (k "Enum") [ ("cases", Field.Many([ Slot.Empty(caseExpect2 ()) ], caseExpect2 ())) ])
      simpleT "Alias" [ Piece.Slot "type" ] (Node.make (k "Alias") [ ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])
      { (simpleT
          "RecordField"
          [ Piece.FieldText("name", Layout.Style.Name), Piece.Punct ":", Piece.Space, Piece.Slot "type" ]
          (Node.make (k "RecordField") [ PT.text "name" "", ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])) with
          resolve = resolveField }
      { (simpleT
          "EnumCase"
          [ Piece.Text("name", Layout.Style.Name), Piece.EachWrapped("fields", " of", [ Piece.Space, Piece.Punct "*", Piece.Line ], "") ]
          (Node.make (k "EnumCase") [ PT.text "name" "", ("fields", Field.Many([], efExpect ())) ])) with
          resolve = resolveCase }
      simpleT
        "EnumField"
        // A function type in an enum case gets brackets: the case's fields are a `*` product, and
        // `| WithChar of String -> Expect -> Node` reads as one arrow chain rather than one field.
        [ Piece.Each("label", []), Piece.ParenIfSlot("type", Types.isFnType) ]
        (Node.make (k "EnumField") [ ("label", Field.Many([], efLabelExpect ())), ("type", Field.One(Slot.Empty(Types.typeExpect "type"))) ])
      simpleT
        "EnumFieldLabel"
        [ Piece.FieldText("name", Layout.Style.Name), Piece.Punct ":", Piece.Space ]
        (Node.make (k "EnumFieldLabel") [ PT.text "name" "" ]) ]


// ============================================================================
// The value shell: a PackageValue as one document (name + body Expr).
// ============================================================================

module Value =
  type PackageValue = Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue

  val valType = "Darklang.Fluid.PT.Value.Value"
  let valKind () : Kind = Kind.named valType

  /// A value that does not exist yet: the name you gave and a hole for the body. Shared with the spec's
  /// `empty`, so a blank value has one shape whether it came from the palette or from `dark val <name>`
  /// with nothing after it.
  let emptyDocFor (name: String) : Node =
    Node.make
      (valKind ())
      [ PT.text "name" name
        PT.text "_hash" ""
        PT.emptyDocField ()
        ("body", Field.One(Slot.Empty(PT.exprExpect "body"))) ]

  let toDoc (name: String) (pv: PackageValue) : Node =
    Node.make
      (valKind ())
      [ PT.text "name" name
        PT.text "_hash" (Darklang.LanguageTools.ProgramTypes.hashToString pv.hash)
        PT.docField pv.description
        PT.one "body" (PT.toDoc pv.body) ]

  let fromDoc (orig: PackageValue) (n: Node) : Stdlib.Result.Result<(String * PackageValue), String> =
    match Node.slot n "body" with
    | Some(Filled c) ->
      match PT.fromDoc c with
      | Ok body ->
        Stdlib.Result.Result.Ok((PT.textOf n "name", { orig with body = body; description = PT.docText n }))
      | Error e -> Stdlib.Result.Result.Error e
    | _ -> Stdlib.Result.Result.Error "the value's body is a hole"

  let specs () : List<Spec> =
    [ { (Spec.simple
          (valKind ())
          [ Piece.Each("doc", [])
            Piece.Group
              [ Piece.Keyword "val"
                Piece.Space
                Piece.Text("name", Layout.Style.Name)
                Piece.Space
                Piece.Punct "="
                // The printer writes `val name = body` on ONE line -- it interpolates the body straight in
                // and lets the body's own layout wrap. Fluid hard-broke after the `=`, so every value in
                // the store displayed on two lines where the printer uses one. (A FUNCTION does break
                // before its body; that difference is the printer's, and Fluid follows it.)
                Piece.Space
                Piece.Slot "body" ] ]
          (emptyDocFor "unnamed")) with
          summary = (fun n -> "val " ++ (PT.textOf n "name")) } ]
