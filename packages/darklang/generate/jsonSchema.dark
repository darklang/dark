module Darklang.Generate.JsonSchema

// Types from a JSON Schema document, and the schema-to-type mapping the OpenAPI
// generator shares.
//
// An object schema becomes a record; a property not in `required` is an `Option`;
// `$ref` becomes the referenced definition's name; arrays become lists; `integer`,
// `number`, `boolean`, `string` map to `Int64`, `Float`, `Bool`, `String`. What the
// schema says that this cannot express (`oneOf`, `allOf`, no type) becomes `String`
// with a doc comment saying so, rather than a guess. Definitions under `$defs` or
// `definitions` become named records of their own.

let obj(
  key: String,
  fields: List<(String * Stdlib.AltJson.Json)>)
  : List<(String * Stdlib.AltJson.Json)> =
  Stdlib.AltJson.Helpers.getObject(key, fields)


let str(key: String, fields: List<(String * Stdlib.AltJson.Json)>): Option<String> =
  Stdlib.AltJson.Helpers.getString(key, fields)


let arr(key: String, fields: List<(String * Stdlib.AltJson.Json)>): List<Stdlib.AltJson.Json> =
  Stdlib.AltJson.Helpers.getArray(key, fields)


/// The shape of a schema, plus every record it needs, named under <param parent>,
/// and a note when the schema said something the shape cannot carry. A `$ref`
/// becomes the referenced definition's name.
let schemaShape(
  parent: String,
  schema: List<(String * Stdlib.AltJson.Json)>)
  : (Model.Shape * List<Model.Record> * Option<String>) =
  match str("$ref", schema) with
  | Some(ref) ->
    let name =
      Stdlib.String.split(ref, "/")
      |> Stdlib.List.last
      |> Stdlib.Option.withDefault(ref)
      |> Source.typeName

    (Model.Shape.Named(name), [], Option.None)
  | None ->
    let combinator =
      [ "oneOf", "anyOf", "allOf" ]
      |> Stdlib.List.findFirst(fun k -> Stdlib.Bool.not(Stdlib.List.isEmpty(arr(k, schema))))

    match combinator with
    | Some(k) -> (Model.Shape.Any, [], Option.Some($"`{k}` in the document; left as raw JSON"))
    | None ->
      match str("type", schema) with
      | Some("integer") -> (Model.Shape.Int, [], Option.None)
      | Some("number") -> (Model.Shape.Float, [], Option.None)
      | Some("boolean") -> (Model.Shape.Bool, [], Option.None)
      | Some("string") ->
        match arr("enum", schema) with
        | [] -> (Model.Shape.String, [], Option.None)
        | values ->
          let names =
            values
            |> Stdlib.List.filterMap(fun v ->
              match v with
              | String(s) -> Option.Some(s)
              | _ -> Option.None)
            |> Stdlib.String.join(", ")

          (Model.Shape.String, [], Option.Some($"one of: {names}"))
      | Some("array") ->
        let (item, nested, note) = schemaShape(parent, obj("items", schema))
        (Model.Shape.List(item), nested, note)
      | Some("object") ->
        let records = recordOf(parent, schema)
        (Model.Shape.Named(parent), records, Option.None)
      | _ ->
        if Stdlib.List.isEmpty(obj("properties", schema)) then
          (Model.Shape.Any, [], Option.Some("the document gives no type"))
        else
          let records = recordOf(parent, schema)
          (Model.Shape.Named(parent), records, Option.None)


/// The record for an object schema named <param name>, first, followed by the
/// inline records its properties needed. A property not in `required` is an
/// `Option`.
let recordOf(name: String, schema: List<(String * Stdlib.AltJson.Json)>): List<Model.Record> =
  let required =
    arr("required", schema)
    |> Stdlib.List.filterMap(fun v ->
      match v with
      | String(s) -> Option.Some(s)
      | _ -> Option.None)

  let (fields, nested) =
    obj("properties", schema)
    |> Stdlib.List.fold(([], []), fun((fields, nested), (key, propJson)) ->
      let prop =
        match propJson with
        | Object(fs) -> fs
        | _ -> []

      let (shape, propRecords, note) = schemaShape(name + Source.typeName(key), prop)
      let shape =
        if Stdlib.List.contains(required, key) then
          shape
        else
          Model.Shape.Optional(shape)

      let field =
        Model.Field { name = Source.identifier(key), key = key, shape = shape, note = note }

      (Stdlib.List.append(fields, field), Stdlib.List.concat(nested, propRecords)))

  Stdlib.List.prepend(nested, Model.Record { name = name, fields = fields })


/// The records for every named definition in <param doc> (`$defs`, or the older
/// `definitions`), in document order.
let definitions(doc: List<(String * Stdlib.AltJson.Json)>): List<Model.Record> =
  let defs =
    match obj("$defs", doc) with
    | [] -> obj("definitions", doc)
    | ds -> ds

  defs
  |> Stdlib.List.map(fun((name, schemaJson)) ->
    let schema =
      match schemaJson with
      | Object(fs) -> fs
      | _ -> []

    definitionRecords(Source.typeName(name), schema))
  |> Stdlib.List.flatten


/// A named definition's records. One that is not an object becomes a one-field
/// record (`value`).
let definitionRecords(
  typeName: String,
  schema: List<(String * Stdlib.AltJson.Json)>)
  : List<Model.Record> =
  if Stdlib.List.isEmpty(obj("properties", schema)) then
    let (shape, nested, note) = schemaShape(typeName, schema)
    let field = Model.Field { name = "value", key = "value", shape = shape, note = note }
    Stdlib.List.prepend(nested, Model.Record { name = typeName, fields = [ field ] })
  else
    recordOf(typeName, schema)


/// Types for <param schema>, a JSON Schema document: its definitions as records, the
/// root as a record named <param name> when the root is an object.
let types(name: String, schema: Bytes): Run =
  match jsonObject("schema", schema) with
  | Error(e) -> failed([ e ])
  | Ok(doc) ->
    let rootName = Source.typeName(name)
    let defs = definitions(doc)
    let root =
      if Stdlib.List.isEmpty(obj("properties", doc)) then
        []
      else
        recordOf(rootName, doc)

    match Stdlib.List.concat(defs, root) with
    | [] ->
      failed(
        [ "the schema has no properties and no definitions; there is nothing to "
          + "make a type from" ])
    | records ->
      let parseFn = if Stdlib.List.isEmpty(root) then [] else [ Model.parseFn(rootName) ]
      ofSource(Source.module_(Stdlib.List.concat(Model.declarations(records), parseFn)))
