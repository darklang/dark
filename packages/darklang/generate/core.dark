module Darklang.Generate

// Generators: Dark fns that write Dark.
//
// A generator is a pure fn returning a `Run`: a module's source text, and where it
// lands. What it makes is named, hashed, printed and synced like anything
// hand-written; there is no second-class "generated" kind. A saved run is itself a fn:
//
//   let orderGenerator () : Generate.Run =
//     Generate.Json.fromSample "Order" (Generate.input "7f3a1c9e...")
//
// It references its inputs by hash, so it repoints when they change and re-runs in the
// draft as part of propagation. A file on disk is re-read only on an explicit run.


/// What one run of a generator produced.
type Run =
  { /// The module the source lands under, as a path `dark module` would accept
    /// (`Acme.Orders`). A library generator leaves it empty; `dark generate --into`
    /// fills it, and a saved generator's own module is the default.
    into: String

    /// A module's worth of Dark source: types, fns, values. Staged through the same
    /// path as `dark module`, so it has to parse and resolve like typed code.
    source: String

    /// Why there is nothing worth staging, when there is not. A generator reports
    /// its own problems here (an input that would not parse, a shape it cannot
    /// express) rather than failing, so a saved generator keeps a plain `Run`
    /// signature and the CLI can print the reasons. Non-empty means `source` is not
    /// staged.
    errors: List<String>

    /// Files rather than package items: a relative path and its text, for output
    /// that lives outside the store (a `.d.ts` for an editor, a schema for another
    /// system). Written by `dark generate --out <dir>`; a propagation re-run does
    /// not touch the disk, so these are only ever written on an explicit run.
    artifacts: List<(String * String)> }


/// A run that has nothing to say but why.
let failed (errors: List<String>) : Run =
  Run { into = ""; source = ""; errors = errors; artifacts = [] }


/// A run of <param source>, destination to be filled in by the caller.
let ofSource (source: String) : Run =
  Run { into = ""; source = source; errors = []; artifacts = [] }


/// A run that produces files, not package items.
let ofArtifacts (artifacts: List<(String * String)>) : Run =
  Run { into = ""; source = ""; errors = []; artifacts = artifacts }


/// The persistent blob stored under <param hash>, for use inside a saved generator.
///
/// A missing input is not a case a generator can do anything with, so this does not
/// return an Option: it yields the empty blob, and every library generator treats an
/// empty input as an error it reports in `Run.errors`. That keeps the saved fn's
/// body a one-liner and its signature `Generate.Run`.
let input (hash: String) : Blob =
  (Stdlib.Blob.load hash) |> Stdlib.Option.withDefault Stdlib.Blob.empty


/// The text of a blob input, or why there is none. Every generator that reads a file
/// starts here, so "empty" and "not text" are worded the same everywhere.
///
/// <param noun> is what the generator's own messages call this input, which is the name
/// of the flag that carried it (`sample`, `schema`, `dump`, `spec`). Without it one run
/// says "the input is empty" and the next line says "the sample has no header row", two
/// nouns for one file.
let text (noun: String) (input: Blob) : Stdlib.Result.Result<String, String> =
  if Stdlib.Blob.length input == 0 then
    Stdlib.Result.Result.Error $"the {noun} is empty; a missing file reads as empty"
  else
    match Stdlib.Blob.toString input with
    | Ok t -> Stdlib.Result.Result.Ok t
    | Error _ -> Stdlib.Result.Result.Error $"the {noun} is not UTF-8 text"


/// The JSON object at the top of a blob input, for the generators that read one.
let jsonObject
  (noun: String)
  (input: Blob)
  : Stdlib.Result.Result<List<(String * Stdlib.AltJson.Json)>, String> =
  match text noun input with
  | Error e -> Stdlib.Result.Result.Error e
  | Ok t ->
    match Stdlib.AltJson.parse t with
    | Error e ->
      let why = Stdlib.AltJson.ParseError.toString e
      Stdlib.Result.Result.Error $"the {noun} did not parse as JSON: {why}"
    | Ok(Object fields) -> Stdlib.Result.Result.Ok fields
    | Ok _ -> Stdlib.Result.Result.Error $"the {noun}'s top level is not an object"


/// The items directly inside a module, with the printer context that spells a sibling
/// bare. Two generators read a module this way (the mirror and the TypeScript one), and
/// they refuse the same things in the same words.
///
/// `String.split` never gives back an empty list, so there is no "no path at all" case:
/// one segment is an owner, and anything longer is a module path.
let moduleItems
  (source: String)
  : Stdlib.Result.Result<(PrettyPrinter.ProgramTypes.Context *
    LanguageTools.ProgramTypes.Search.SearchResults), String> =
  let branchId = SCM.Branches.current ()
  let segments = Stdlib.String.split source "."

  match segments with
  | [ _ ] ->
    Stdlib.Result.Result.Error
      $"{source} is an owner, not a module; name a module under it, like Acme.Core"
  | _ ->
    let query =
      LanguageTools.ProgramTypes.Search.SearchQuery
        { currentModule = segments
          text = ""
          searchDepth =
            LanguageTools.ProgramTypes.Search.SearchDepth.OnlyDirectDescendants
          entityTypes = []
          exactMatch = false }

    let results = LanguageTools.PackageManager.Search.search branchId query
    let ctx = PrettyPrinter.ProgramTypes.Context.forModule branchId segments
    Stdlib.Result.Result.Ok((ctx, results))


/// Why a generator that reads a type cannot read this one. Three of them refuse it, and
/// the type argument is the same thing in all three.
val notAPackageType =
  "the type argument is not a package type; a builtin type, a type variable and a list "
  ++ "have no declaration to read"


/// Nothing was found directly in a module the person named.
let nothingIn (source: String) : String =
  $"there is nothing directly in {source}; the path is spelled owner first, like Acme.Core"


/// Text emission helpers. Every generator writes source through these so that the
/// output is stable across runs (sorted where order is not meaningful, one layout)
/// and so that names are legal before the parser sees them.
module Source =

  /// A name the parser accepts anywhere an identifier goes (a fn, a parameter, a local):
  /// lower-case first character, then ASCII letters, digits and underscore. Anything
  /// else is dropped; an empty or digit-leading result gets a leading underscore, and a
  /// keyword gets a trailing one.
  ///
  /// ASCII rather than `Char.isAlphanumeric`, which is unicode-aware by design: `café`
  /// survives that filter and then fails to parse as a bare identifier.
  ///
  /// This is NOT for a record field whose name has to match a wire key. That is
  /// `fieldName`, which keeps the key and backticks it.
  let identifier (raw: String) : String =
    let kept =
      raw
      |> Stdlib.String.toList
      |> Stdlib.List.filter (fun c ->
        (Stdlib.Char.isASCIILetter c) || (Stdlib.Char.isDigit c) || (c == '_'))
      |> Stdlib.String.fromList

    let lowered =
      match Stdlib.String.toList kept with
      | [] -> "_"
      | first :: rest ->
        if Stdlib.Char.isDigit first then
          "_" ++ kept
        else
          (Stdlib.Char.toLowercase first |> Stdlib.Char.toString)
          ++ (Stdlib.String.fromList rest)

    // `type`, `let`, `match` and friends look like identifiers and are not. The printer
    // decides what needs quoting, so asking it is the same list the lexer uses.
    if (PrettyPrinter.formatFieldName lowered) == lowered then
      lowered
    else
      lowered ++ "_"


  /// A type name the parser accepts: upper-case first character, then ASCII letters and
  /// digits. ASCII for the reason `identifier` says.
  let typeName (raw: String) : String =
    let kept =
      raw
      |> Stdlib.String.toList
      |> Stdlib.List.filter (fun c ->
        (Stdlib.Char.isASCIILetter c) || (Stdlib.Char.isDigit c))
      |> Stdlib.String.fromList

    match Stdlib.String.toList kept with
    | [] -> "T"
    | first :: rest ->
      if Stdlib.Char.isDigit first then
        "T" ++ kept
      else
        (Stdlib.Char.toUppercase first |> Stdlib.Char.toString)
        ++ (Stdlib.String.fromList rest)


  /// <param text> as a Dark string literal, quotes and escapes included.
  let stringLiteral (text: String) : String =
    "\"" ++ (PrettyPrinter.escapeSpecialCharacters text) ++ "\""


  /// A field name Dark accepts for the key the DATA uses, backticked when the key is
  /// not a bare identifier (``user-id``, ``type``). The two have to be the same string:
  /// `Stdlib.Json` matches a record field against the JSON key by name, so a field
  /// renamed to look tidy reads as absent, which for an `Option` field is silently
  /// `None`. The pretty printer prints declarations, literals and field access this
  /// way, so generated source that uses it stays round-trippable.
  let fieldName (key: String) : String = PrettyPrinter.formatFieldName key


  /// One record field line, with a doc comment when there is something to say.
  let field
    (name: String)
    (typ: String)
    (doc: Stdlib.Option.Option<String>)
    : String =
    match doc with
    | None -> $"{name}: {typ}"
    | Some text -> $"/// {text}\n    {name}: {typ}"


  /// A record type declaration over already-rendered field lines.
  ///
  /// No fields is not a record the parser accepts ("a record type needs at least one
  /// field"), and an object with no keys is a dict anyway, so it becomes one. Callers
  /// that can see an empty object coming say `Dict` themselves; this is the net.
  let recordType (name: String) (fields: List<String>) : String =
    match fields with
    | [] -> $"type {name} = Dict<String, String>"
    | _ ->
      let body = Stdlib.String.join fields "\n    "
      $"type {name} =\n  {{ {body} }}"


  /// A fn declaration.
  let fn
    (name: String)
    (params_: String)
    (returnType: String)
    (body: String)
    : String =
    $"let {name} {params_} : {returnType} =\n  {body}"


  /// Declarations joined into one module source, two blank lines apart, the way the
  /// formatter lays out a file.
  let module_ (declarations: List<String>) : String =
    Stdlib.String.join declarations "\n\n\n"


/// What a generator has learned about the data's shape, and the type it becomes.
/// Shared by the JSON, JSON Schema, OpenAPI and CSV generators.
///
/// Its records are read and written with `Stdlib.Json` directly, with no codec of their
/// own: an absent or null key is `None` there and a `None` field is left out. That holds
/// only while a field's name IS its key, which is what `Source.fieldName` is for.
module Model =

  type Shape =
    | Int
    | Float
    | String
    | Bool
    /// Not pinned down by the input: `String`, and the field carries a note saying so.
    /// It has to be a type `Stdlib.Json.parse` can read, which rules out a JSON-value
    /// union: a document that puts something else there fails with the field named,
    /// which is the honest outcome for a guess.
    | Any
    | List of Shape
    | Optional of Shape
    /// A record emitted in the same run (or already in the module), by type name.
    | Named of String


  type Field =
    { /// An identifier for the field, for a generator that builds expressions from it.
      name: String
      /// The key as the data spells it, which is what the declaration carries.
      key: String
      shape: Shape
      note: Stdlib.Option.Option<String> }


  type Record = { name: String; fields: List<Field> }


  let typeText (shape: Shape) : String =
    match shape with
    | Int -> "Int"
    | Float -> "Float"
    | String -> "String"
    | Bool -> "Bool"
    | Any -> "String"
    | List inner -> $"List<{typeText inner}>"
    | Optional inner -> $"Stdlib.Option.Option<{typeText inner}>"
    | Named name -> name


  let recordSource (r: Record) : String =
    let fields =
      r.fields
      |> Stdlib.List.map (fun f ->
        Source.field (Source.fieldName f.key) (typeText f.shape) f.note)
    Source.recordType r.name fields


  /// The declarations for a set of records, in the order given.
  let declarations (records: List<Record>) : List<String> =
    records |> Stdlib.List.map recordSource


  /// A `parse` fn over the root record: text in, record out.
  let parseFn (root: String) : String =
    Source.fn
      "parse"
      "(json: String)"
      $"Stdlib.Result.Result<{root}, Stdlib.Json.ParseError.ParseError>"
      $"Stdlib.Json.parse<{root}> json"
