/// The relay WEBSITE: the browsable pages -- landing, module and item views, search --
/// and the HTML machinery they share. Routing and the store queries live in server.dark;
/// same module, so the router there sees these page fns.
module Darklang.Matter

/// The stylesheet, as one blob. It is CSS: read it as CSS.
val css =
  """
  :root{--ink:#16161a;--dim:#6b6b76;--line:#e6e6ea;--bg:#fff;--accent:#4338ca;--chip:#f4f4f7}
  @media(prefers-color-scheme:dark){:root{--ink:#ececf0;--dim:#9a9aa6;--line:#2a2a32;--bg:#111114;--accent:#a5b4fc;--chip:#1c1c22}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.65 ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}
  .wrap{max-width:52rem;margin:0 auto;padding:4rem 1.5rem 5rem}
  header{margin-bottom:3rem}
  .logo{display:inline-flex;align-items:baseline;gap:0;text-decoration:none;color:inherit;font-size:1.6rem;letter-spacing:-.03em}
  .logo b{font-weight:700;color:var(--accent)}
  .logo span{color:var(--dim);font-weight:400}
  h1{font-size:2.1rem;line-height:1.15;letter-spacing:-.03em;font-weight:650;margin:1.75rem 0 .75rem;max-width:30ch}
  .lede{color:var(--dim);font-size:1.05rem;margin:0;max-width:56ch}
  h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--dim);font-weight:600;margin:3rem 0 1rem;padding-bottom:.5rem;border-bottom:1px solid var(--line)}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:.6rem}
  .card{border:1px solid var(--line);border-radius:.6rem;padding:.75rem .9rem}
  .card .n{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.9rem;word-break:break-word}
  .card .c{color:var(--dim);font-size:.78rem;margin-top:.15rem}
  .chips{display:flex;flex-wrap:wrap;gap:.4rem}
  .chip{background:var(--chip);border-radius:2rem;padding:.3rem .8rem;font-size:.85rem}
  .chip b{font-weight:600}
  .chip span{color:var(--dim)}
  code{font-family:ui-monospace,SFMono-Regular,monospace;background:var(--chip);padding:.12rem .4rem;border-radius:.3rem;font-size:.88em}
  pre{background:var(--chip);padding:.9rem 1rem;border-radius:.6rem;overflow-x:auto;font-size:.88rem;margin:.6rem 0}
  pre code{background:none;padding:0}
  details{margin-top:1rem;border-top:1px solid var(--line);padding-top:1rem}
  summary{cursor:pointer;color:var(--dim);font-size:.9rem}
  table{border-collapse:collapse;width:100%;margin-top:.9rem;font-size:.87rem}
  td,th{text-align:left;padding:.35rem .6rem;border-bottom:1px solid var(--line)}
  th{color:var(--dim);font-weight:500;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em}
  .m{color:var(--accent);font-weight:600}
  footer{margin-top:4rem;padding-top:1.25rem;border-top:1px solid var(--line);color:var(--dim);font-size:.88rem}
  p a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}
  .feats{display:grid;grid-template-columns:repeat(auto-fill,minmax(16rem,1fr));gap:1.1rem 1.6rem}
  .feat b{display:block;font-weight:600;font-size:.95rem;margin-bottom:.2rem}
  .feat p{margin:0;color:var(--dim);font-size:.88rem;line-height:1.5}
  .stat{display:flex;gap:2rem;flex-wrap:wrap;margin:.5rem 0 0}
  .stat div{display:flex;flex-direction:column}
  .stat .k{font-size:1.5rem;font-weight:650;letter-spacing:-.02em}
  .stat .l{color:var(--dim);font-size:.8rem;text-transform:uppercase;letter-spacing:.06em}
  header{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}
  .find input{font:inherit;font-size:.9rem;padding:.4rem .75rem;border:1px solid var(--line);border-radius:2rem;background:var(--bg);color:var(--ink);min-width:14rem}
  .find input:focus{outline:2px solid var(--accent);outline-offset:-1px}
  .crumbs{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.85rem;color:var(--dim);margin-bottom:.25rem}
  .crumbs a{color:var(--dim);text-decoration:none}
  .crumbs a:hover{color:var(--accent);text-decoration:underline}
  .crumbs .sep{opacity:.5;padding:0 .1rem}
  .meta{color:var(--dim);font-size:.9rem;margin:.25rem 0 1rem}
  .rows{display:flex;flex-direction:column;border-top:1px solid var(--line)}
  .row{display:block;padding:.6rem .2rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit}
  .row:hover{background:var(--chip)}
  .row .n{font-size:.95rem}
  .row .c{color:var(--dim);font-size:.85rem;margin-top:.1rem}
  .pills{display:flex;flex-wrap:wrap;gap:.35rem}
  .pill{text-decoration:none;color:inherit;background:var(--chip);border-radius:.4rem;padding:.2rem .5rem;font-size:.85rem}
  .pill:hover{outline:1px solid var(--accent)}
  .pill code{background:none;padding:0}
  .tag{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;background:var(--chip);color:var(--dim);border-radius:.3rem;padding:.1rem .4rem;vertical-align:middle}
  :root{--k:#8250df;--s:#0a7c42;--n:#0550ae;--c:#6b6b76;--t:#953800;--f:#0550ae;--m:#6b6b76}
  @media(prefers-color-scheme:dark){:root{--k:#d2a8ff;--s:#7ee787;--n:#79c0ff;--c:#8b949e;--t:#ffa657;--f:#79c0ff;--m:#8b949e}}
  pre .k{color:var(--k)}
  pre .s{color:var(--s)}
  pre .n{color:var(--n)}
  pre .c{color:var(--c);font-style:italic}
  pre .t{color:var(--t)}
  pre .e{color:var(--t)}
  pre .f{color:var(--f)}
  pre .m{color:var(--m)}
  pre .p{color:var(--ink)}
  pre .v{color:var(--ink)}
  pre .o{color:var(--dim)}
  a.card{text-decoration:none;color:inherit;display:block}
  a.card:hover{outline:1px solid var(--accent)}
  """

let feature (title: String) (desc: String) : String =
  Stdlib.Html.div
    [ Stdlib.Html.classes [ "feat" ] ]
    [ Stdlib.Html.b [] [ Stdlib.Html.text title ]
      Stdlib.Html.p [] [ Stdlib.Html.text desc ] ]
  |> Stdlib.Html.nodeToString


/// A count, grouped for reading: 12241 -> "12,241". These pages are mostly large numbers, and an
/// ungrouped run of digits gets read digit by digit.
let num (n: Int64) : String =
  if n < 0L then
    "-" ++ num (Stdlib.Int64.negate n)
  else if n < 1000L then
    Stdlib.Int64.toString n
  else
    let rest = Stdlib.Int64.toString (n % 1000L) |> Stdlib.String.padStart "0" 3
    // `padStart` only fails when the pad string is not one character, and "0" is.
    let padded = rest |> Stdlib.Result.withDefault ""
    (num (n / 1000L)) ++ "," ++ padded


/// "1 item", "12 items". A count next to a bare plural reads as unfinished, and these pages are made of
/// counts.
let itemCount (n: Int64) : String =
  if n == 1L then "1 item" else $"{num n} items"


/// A card linking to the module page for <param name>, showing <param label> and how many items it
/// holds. The label is separate because a submodule card shows its leaf, not its full path.
let card (name: String) (label: String) (n: Int64) : String =
  let c = itemCount n

  Stdlib.Html.a
    [ Stdlib.Html.classes [ "card" ]
      ("href", Stdlib.Option.Option.Some $"/m?name={name}") ]
    [ Stdlib.Html.div [ Stdlib.Html.classes [ "n" ] ] [ Stdlib.Html.text label ]
      Stdlib.Html.div [ Stdlib.Html.classes [ "c" ] ] [ Stdlib.Html.text c ] ]
  |> Stdlib.Html.nodeToString


/// Splits `backticked` spans out of a description and renders them as <code>, so an endpoint's query
/// parameters read as parameters. Everything goes through `Html.text`, so nothing here can inject markup.
///
/// Odd-indexed pieces of a backtick split are the code spans, which is only true for balanced backticks;
/// an unbalanced one renders its tail as code rather than failing, which is the harmless way to be wrong.
let describe (s: String) : List<Stdlib.Html.Node> =
  s
  |> Stdlib.String.split "`"
  |> Stdlib.List.indexedMap (fun i piece ->
    if (i % 2) == 1 then
      Stdlib.Html.code [] [ Stdlib.Html.text piece ]
    else
      Stdlib.Html.text piece)


/// One row of the endpoint table. Every field is escaped, so `what` is prose rather than markup.
let route (m: String) (path: String) (what: String) : String =
  Stdlib.Html.tr
    []
    [ Stdlib.Html.td [] [ Stdlib.Html.span [ Stdlib.Html.classes [ "m" ] ] [ Stdlib.Html.text m ] ]
      Stdlib.Html.td [] [ Stdlib.Html.code [] [ Stdlib.Html.text path ] ]
      Stdlib.Html.td [] (describe what) ]
  |> Stdlib.Html.nodeToString


/// The landing page. Written for someone who has never heard of this: what's here, then how to get it, and
/// only then the machine-facing endpoints -- which live behind a fold, because a relay's HTTP surface is
/// what a MACHINE wants and almost nobody arrives wanting it first.
let landingHandlerFn (req: HttpRequest) : HttpResponse =
  // The copy-paste command names the relay THIS page came from: a hardcoded hostname failed for
  // anyone who tried it against a differently-named deployment (which is every deployment so far).
  let selfUrl =
    match Stdlib.Http.Request.header req "host" with
    | Some h -> $"https://{h}"
    | None -> "https://<your-relay>"

  let featBlock =
    (feature "No setup" "Point a machine here and pull. No tailscale, no infra, nothing exposed to the internet.")
    ++ (feature "Pick up where you left off" "Write on your laptop, keep going on your desktop. Your packages follow you.")
    ++ (feature "Nothing ever breaks" "Every version is kept forever, content-addressed. Nothing is overwritten, so code that worked keeps working.")
    ++ (feature "You're in control" "Pull for review and changes land pending until you approve them. The relay never runs your code, so it's safe to point at.")

  // The pitch is for someone who has never heard of this; the browse block is for everyone who has. Both
  // are on the front page because a relay with nothing to look at reads like a status endpoint.
  let items = totalItems ()
  let pubs = publisherCount ()

  let modCards =
    topModules 12L
    |> Stdlib.List.map (fun m ->
      let (nm, n) = m
      card nm nm n)
    |> (fun l -> Stdlib.String.join l "")

  let itemsStr = num items
  let pubsStr = num pubs

  page
    "matter.darklang.com"
    // Lead with the strongest true thing, concretely; adjectives are where a product hides.
    ("<h1>Your packages, on every machine.</h1>"
     ++ "<p class=\"lede\">Commit on one machine, pull on another. Every version is kept forever, "
     ++ "content-addressed, and nothing runs until you approve it.</p>"
     ++ "<h2>What's here</h2>"
     ++ $"<div class=\"stat\"><div><span class=\"k\">{itemsStr}</span><span class=\"l\">items</span></div>"
     ++ $"<div><span class=\"k\">{pubsStr}</span><span class=\"l\">publishers</span></div></div>"
     ++ "<p class=\"lede\" style=\"margin-top:1rem\">Search above, or start from the biggest modules. "
     ++ "The package set this relay runs is browsable down to source without installing anything -- "
     ++ "<a href=\"/owners\">by publisher</a>, or <a href=\"/stats\">by the numbers</a>.</p>"
     ++ $"<div class=\"grid\" style=\"margin-top:1rem\">{modCards}</div>"
     ++ "<h2>Why matter</h2>"
     ++ $"<div class=\"feats\">{featBlock}</div>"
     ++ "<h2>Try it</h2>"
     ++ "<p>Pulled changes land <strong>pending</strong> until you approve them. Reading needs no "
     ++ "secret; pushing does, from whoever runs the relay.</p>"
     ++ $"<pre><code>dark connect {selfUrl} --secret &lt;secret&gt;\ndark review pull\ndark review approve</code></pre>"
     ++ "<h2>Or keep it local</h2>"
     ++ "<p>Your Matter -- all your packages -- lives on your own machine no matter what. Syncing it "
     ++ "<em>through matter.darklang.com</em> is the optional part: point your machines at your own "
     ++ "<a href=\"https://docs.darklang.com/sync/tailscale\">tailscale</a> instead, or skip sync entirely and "
     ++ "work fully offline. Local-first, always.</p>"
     ++ "<details><summary>HTTP endpoints (for tooling)</summary>"
     ++ "<table><tr><th>method</th><th>path</th><th>what it does</th></tr>"
     ++ route "GET" "/sync/head" "how much it holds, without transferring anything"
     ++ route "GET" "/sync/pull" "ops as wire records; `?sinceSeq=` pages, `?owner=` filters"
     ++ route "POST" "/sync/push" "ingest ops; content-addressed, so a re-push is a no-op"
     ++ route "GET" "/branch/list" "branches held for an owner"
     ++ route "GET" "/branch/owners" "every hosted branch with its owner"
     ++ route "GET" "/branch/pull" "one branch bundle"
     ++ route "POST" "/branch/push" "store a branch bundle"
     ++ route "GET" "/ping" "health"
     ++ "</table></details>"
     ++ "<p class=\"lede\" style=\"margin-top:2rem\">It only stores and hands back your changes, and it never "
     ++ "runs your code. Pull for review and nothing lands until you've looked at it, so the worst a relay can "
     ++ "do is hold something back. That's what makes it safe to point your machines at.</p>")


/// Everything user-supplied that reaches a page goes through this. A search box that echoes its query is
/// the one place on a read-only site where someone else picks the markup, so it is not optional.
let esc (s: String) : String = Stdlib.String.htmlEscape s


/// A path like `Darklang.Stdlib.List` as links to each of its parents, because arriving on a deep module
/// from a search result with no way back up is how a browser stops being a browser.
let crumbs (path: String) : String =
  let segs = Stdlib.String.split path "."

  let links =
    segs
    |> Stdlib.List.indexedMap (fun i label ->
      let upto = segs |> Stdlib.List.take (i + 1) |> (fun l -> Stdlib.String.join l ".")
      Stdlib.Html.a
        [ ("href", Stdlib.Option.Option.Some $"/m?name={upto}") ]
        [ Stdlib.Html.text label ]
      |> Stdlib.Html.nodeToString)
    |> (fun l ->
      let sep =
        Stdlib.Html.span [ Stdlib.Html.classes [ "sep" ] ] [ Stdlib.Html.text "." ]
        |> Stdlib.Html.nodeToString

      Stdlib.String.join l sep)

  Stdlib.Html.nav
    [ Stdlib.Html.classes [ "crumbs" ] ]
    [ Stdlib.Html.stringNode links ]
  |> Stdlib.Html.nodeToString


let pageWithStatus (title: String) (body: String) (status: Int) : HttpResponse =
  let html =
    "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
    ++ "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    ++ $"<title>{esc title} -- matter</title><style>"
    ++ css
    ++ "</style></head><body><div class=\"wrap\">"
    ++ "<header><a class=\"logo\" href=\"/\"><b>matter</b><span>darklang packages</span></a>"
    ++ "<form class=\"find\" action=\"/search\" method=\"get\">"
    ++ "<input name=\"q\" placeholder=\"Search packages\" autocomplete=\"off\" spellcheck=\"false\">"
    ++ "</form></header>"
    ++ body
    ++ "<footer>Every version here is kept forever and addressed by the hash of its content. "
    ++ "<a href=\"/stats\">What this relay holds</a>.</footer>"
    ++ "</div></body></html>"

  Stdlib.Http.responseWithHtml html status


/// A page that was found. Almost every page is this one.
let page (title: String) (body: String) : HttpResponse = pageWithStatus title body 200


/// A page saying the thing you asked for is not here, WITH the status that says so.
let notFoundPage (title: String) (body: String) : HttpResponse =
  pageWithStatus title body 404


/// A doc comment, as HTML.
///
/// Darklang doc comments carry two bits of markup: `{{expr}}` for inline code and `<param name>` for a
/// parameter reference. Raw, they reach the page as literal braces and escaped angle brackets.
///
/// Escaping happens FIRST and the markers are recognised in their escaped form, so nothing in a doc
/// comment can introduce markup of its own -- the only tags here are the ones this function adds.
let renderDoc (raw: String) : String =
  // The tags that actually occur, enumerated rather than matched loosely, so a stray `&lt;` in prose
  // stays prose instead of swallowing the rest of the sentence into a code span. Each marker closes at
  // its OWN `&gt;` -- the first one after it -- so a bare `>` in prose ("a -> b", "x > 0") is left
  // alone rather than turned into a stray close tag.
  let openMarker (d: String) (marker: String) : String =
    d
    |> Stdlib.String.split marker
    |> Stdlib.List.indexedMap (fun i piece ->
      if i == 0 then
        piece
      else
        match Stdlib.String.split piece "&gt;" with
        | first :: rest ->
          "<code>" ++ first ++ "</code>" ++ (Stdlib.String.join rest "&gt;")
        | [] -> "<code>"
    )
    |> (fun pieces -> Stdlib.String.join pieces "")

  let markers =
    [ "&lt;param ", "&lt;type ", "&lt;var ", "&lt;fn ", "&lt;list ", "&lt;returns " ]

  markers
  |> Stdlib.List.fold
    (esc raw
     |> (fun d -> Stdlib.String.replaceAll d "{{" "<code>")
     |> (fun d -> Stdlib.String.replaceAll d "}}" "</code>"))
    openMarker


/// A semantic token type as a CSS class.
///
/// The same tokens the CLI colours, so a name reads the same in a terminal and on a page. Short class
/// names because they repeat once per token across a whole file.
let tokenClass (t: LanguageTools.SemanticTokens.TokenType) : String =
  match t with
  | Keyword -> "k"
  | Symbol -> "o"
  | Operator -> "o"
  | String -> "s"
  | RegularExpression -> "s"
  | Number -> "n"
  | Comment -> "c"
  | ModuleName -> "m"
  | TypeName -> "t"
  | TypeParameter -> "t"
  | EnumMember -> "e"
  | FunctionName -> "f"
  | Method -> "f"
  | ParameterName -> "p"
  | VariableName -> "v"
  | Property -> "v"


/// One line as HTML, with each token wrapped and everything else escaped.
///
/// Escaping happens per SEGMENT rather than up front: escaping first would change the string's length and
/// every token column after it would point at the wrong character.
let highlightLineHtml
  (line: String)
  (lineTokens: List<LanguageTools.SemanticTokens.SemanticToken>)
  : String =
  let ordered =
    lineTokens |> Stdlib.List.sortBy (fun tk -> tk.range.start.column)

  let stepped =
    ordered
    |> Stdlib.List.fold (0, "") (fun acc tk ->
      let (cursor, out) = acc
      let startCol = tk.range.start.column
      let endCol = tk.range.end_.column

      if startCol < cursor || endCol > (Stdlib.String.length line) || endCol <= startCol then
        // Overlapping or out-of-range: drop the token rather than slice past the end of the line.
        acc
      else
        let before = esc (Stdlib.String.slice line cursor startCol)
        let body = esc (Stdlib.String.slice line startCol endCol)
        let cls = tokenClass tk.tokenType
        (endCol, out ++ before ++ $"<span class=\"{cls}\">{body}</span>"))

  let (cursor, out) = stepped
  out ++ esc (Stdlib.String.slice line cursor (Stdlib.String.length line))


/// Source as highlighted HTML, falling back to escaped plain text when it will not parse.
///
/// The parser is best-effort and recovers from malformed input, so `None` means a hard lex failure. A page
/// that renders nothing would be worse than one without colour.
let highlightHtml (source: String) : String =
  match LanguageTools.Parser.Parse.toWrittenTypes source with
  | None -> esc source
  | Some parsed ->
    let tokens = LanguageTools.SemanticTokens.ParsedFile.tokenize parsed
    let lines = Stdlib.String.split source "\n"

    let perLine =
      tokens
      |> Stdlib.List.map (Darklang.Cli.SyntaxHighlighting.splitTokenByLine lines)
      |> Stdlib.List.flatten

    lines
    |> Stdlib.List.indexedMap (fun i line ->
      let onThisLine =
        perLine |> Stdlib.List.filter (fun tk -> tk.range.start.row == i)

      if Stdlib.List.isEmpty onThisLine then
        // The tokenizer does not mark doc comments, and a `///` line rendering identically to code is the
        // most visible thing on the page reading wrong.
        if Stdlib.String.startsWith (Stdlib.String.trim line) "//" then
          $"<span class=\"c\">{esc line}</span>"
        else
          esc line
      else
        highlightLineHtml line onThisLine)
    |> (fun ls -> Stdlib.String.join ls "\n")


let kindLabel (k: String) : String =
  match k with
  | "fn" -> "function"
  | "type" -> "type"
  | _ -> "value"


/// One row in a list of items: name, kind, and the first line of its doc comment -- the description is
/// what turns a wall of names into something you can skim.
let itemRow (modulePath: String) (nm: String) (kind: String) (hash: String) : String =
  let full = $"{modulePath}.{nm}"
  let desc = descriptionOf kind hash

  // `renderDoc` returns MARKUP it built itself, so it goes in as a raw node rather than as text.
  let blurb =
    match Stdlib.String.split desc "\n" with
    | first :: _ ->
      if first == "" then
        []
      else
        [ Stdlib.Html.div
            [ Stdlib.Html.classes [ "c" ] ]
            [ Stdlib.Html.stringNode (renderDoc first) ] ]
    | [] -> []

  let dep =
    if isDeprecated hash then
      [ Stdlib.Html.stringNode " "
        Stdlib.Html.span [ Stdlib.Html.classes [ "tag" ] ] [ Stdlib.Html.text "deprecated" ] ]
    else
      []

  Stdlib.Html.a
    [ Stdlib.Html.classes [ "row" ]
      ("href", Stdlib.Option.Option.Some $"/p?name={full}") ]
    (Stdlib.List.append
      [ Stdlib.Html.div
          [ Stdlib.Html.classes [ "n" ] ]
          (Stdlib.List.append
            [ Stdlib.Html.code [] [ Stdlib.Html.text nm ] ]
            dep) ]
      blurb)
  |> Stdlib.Html.nodeToString


/// A module: what's under it, then what's in it. Grouped by kind, because "the types in here" and "the
/// functions in here" are different questions and a single alphabetical list answers neither.
let moduleHandlerFn (req: HttpRequest) : HttpResponse =
  let name =
    Stdlib.Http.Request.queryParam req "name" |> Stdlib.Option.withDefault ""

  let items = itemsIn name
  let subs = submodulesOf name

  match (items, subs) with
  | ([], []) ->
    // A relay renders only the package set it ships with; what clients push is held and served,
    // never folded into these pages. So an empty module is usually one that exists on every
    // client and not here, and "nothing here" would read as data loss.
    notFoundPage
      name
      ($"{crumbs name}<h1>{esc name}</h1>"
       ++ "<p class=\"lede\">Not in the package set this server runs. If it was pushed here, it is "
       ++ "held and served to whoever pulls it, but these pages do not render hosted code yet: "
       ++ "browse it from any client with <code>dark view</code>. "
       ++ "<a href=\"/stats\">Why a relay works this way.</a></p>")
  | _ ->
    let subBlock =
      if subs == [] then
        ""
      else
        let cards =
          subs
          |> Stdlib.List.map (fun sm ->
            let (smName, n) = sm
            let leaf =
              Stdlib.String.split smName "." |> Stdlib.List.last |> Stdlib.Option.withDefault smName
            card smName leaf n)
          |> (fun l -> Stdlib.String.join l "")

        $"<h2>Modules</h2><div class=\"grid\">{cards}</div>"

    let section (kind: String) (heading: String) : String =
      let ofKind =
        items |> Stdlib.List.filter (fun i -> let (_, k, _) = i in k == kind)

      if ofKind == [] then
        ""
      else
        let rows =
          ofKind
          |> Stdlib.List.map (fun i ->
            let (nm, k, h) = i
            itemRow name nm k h)
          |> (fun l -> Stdlib.String.join l "")

        $"<h2>{heading}</h2><div class=\"rows\">{rows}</div>"

    let count = Stdlib.List.length items

    let lede =
      if items == [] then
        "A module of modules."
      else
        let asInt64 = Stdlib.Int.toInt64 count |> Stdlib.Option.withDefault 0L
        $"{itemCount asInt64}."

    page
      name
      ($"{crumbs name}<h1>{esc name}</h1><p class=\"lede\">{lede}</p>"
       ++ subBlock
       ++ (section "type" "Types")
       ++ (section "fn" "Functions")
       ++ (section "value" "Values"))


/// One item: its source, what it needs, and who needs it.
///
/// The dependents list is the half you cannot get by reading the code in front of you, and it is the one
/// that decides whether changing this is safe. It comes from the fold, so it is the real call graph.
let itemHandlerFn (req: HttpRequest) : HttpResponse =
  let name =
    Stdlib.Http.Request.queryParam req "name" |> Stdlib.Option.withDefault ""

  let parts = Stdlib.String.split name "."
  let leaf = Stdlib.List.last parts |> Stdlib.Option.withDefault ""

  let modulePath =
    parts |> Stdlib.List.dropLast |> (fun ps -> Stdlib.String.join ps ".")

  let found =
    itemsIn modulePath |> Stdlib.List.findFirst (fun i -> let (n, _, _) = i in n == leaf)

  match found with
  | None ->
    notFoundPage
      name
      ((crumbs modulePath)
       ++ (Stdlib.Html.h1 [] [ Stdlib.Html.text leaf ] |> Stdlib.Html.nodeToString)
       ++ (Stdlib.Html.p
             [ Stdlib.Html.classes [ "lede" ] ]
             [ Stdlib.Html.text "Not found here. It may live under a different module, or "
               Stdlib.Html.a
                 [ ("href", Stdlib.Option.Option.Some $"/search?q={leaf}") ]
                 [ Stdlib.Html.text "search for it" ]
               Stdlib.Html.text "." ]
           |> Stdlib.Html.nodeToString))
  | Some item ->
    let (_, kind, hashStr) = item
    let h = LanguageTools.ProgramTypes.Hash.Hash hashStr

    // The relay holds no branches of its own, so everything it serves is main's view.
    let ctx = PrettyPrinter.ProgramTypes.Context.forBranch SCM.Branch.mainBranchId

    let src =
      match kind with
      | "fn" ->
        (match LanguageTools.PackageManager.Function.get h with
         | Some f -> PrettyPrinter.ProgramTypes.packageFn ctx f
         | None -> "(not stored here)")
      | "type" ->
        (match LanguageTools.PackageManager.Type.get h with
         | Some t -> PrettyPrinter.ProgramTypes.packageType ctx t
         | None -> "(not stored here)")
      | _ ->
        (match LanguageTools.PackageManager.Value.get h with
         | Some v -> PrettyPrinter.ProgramTypes.packageValue ctx v
         | None -> "(not stored here)")

    let short = Stdlib.String.slice hashStr 0 12
    let desc = descriptionOf kind hashStr

    let descBlock =
      if desc == "" then "" else $"<p class=\"lede\">{renderDoc desc}</p>"

    let depBadge =
      if isDeprecated hashStr then
        " <span class=\"tag\">deprecated</span>"
      else
        ""

    // Built as nodes: the name goes in twice, once as an attribute and once as text, and both are
    // escaped by the renderer rather than by remembering to call `esc` at each of them.
    let pillsFor (items: List<(String * String)>) : String =
      items
      |> Stdlib.List.map (fun d ->
        let (full, _k) = d

        Stdlib.Html.a
          [ Stdlib.Html.classes [ "pill" ]
            ("href", Stdlib.Option.Option.Some $"/p?name={full}") ]
          [ Stdlib.Html.code [] [ Stdlib.Html.text full ] ]
        |> Stdlib.Html.nodeToString)
      |> (fun l -> Stdlib.String.join l "")

    // A widely-used function has hundreds of callers, and a flat wall of them is the page. Show a sample,
    // say the real total, and put the rest behind a disclosure so the page below stays reachable.
    let visibleCallers = 24

    let h2 (text: String) : String =
      Stdlib.Html.h2 [] [ Stdlib.Html.text text ] |> Stdlib.Html.nodeToString

    let lede (text: String) : String =
      Stdlib.Html.p [ Stdlib.Html.classes [ "lede" ] ] [ Stdlib.Html.text text ]
      |> Stdlib.Html.nodeToString

    /// A div of already-rendered pills. The children are HTML, so they go in as a string node: escaping
    /// them again would show the markup instead of the links.
    let pillsDiv (style: String) (renderedPills: String) : String =
      let attrs =
        if style == "" then
          [ Stdlib.Html.classes [ "pills" ] ]
        else
          [ Stdlib.Html.classes [ "pills" ]
            ("style", Stdlib.Option.Option.Some style) ]

      Stdlib.Html.div attrs [ Stdlib.Html.stringNode renderedPills ]
      |> Stdlib.Html.nodeToString

    let linkList (title: String) (items: List<(String * String)>) (empty: String) : String =
      if items == [] then
        (h2 title) ++ (lede empty)
      else
        (h2 title) ++ (pillsDiv "" (pillsFor items))

    /// `linkList`, but for a list that can be enormous. <param total> is the true count, which may exceed
    /// what was fetched.
    let cappedLinkList
      (title: String)
      (items: List<(String * String)>)
      (total: Int64)
      (empty: String)
      : String =
      if items == [] then
        (h2 title) ++ (lede empty)
      else
        let shown = items |> Stdlib.List.take visibleCallers
        let rest = items |> Stdlib.List.drop visibleCallers
        let n = num total

        let heading =
          Stdlib.Html.h2
            []
            [ Stdlib.Html.text $"{title} "
              Stdlib.Html.span [ Stdlib.Html.classes [ "tag" ] ] [ Stdlib.Html.text n ] ]
          |> Stdlib.Html.nodeToString

        if Stdlib.List.isEmpty rest then
          heading ++ (pillsDiv "" (pillsFor shown))
        else
          let more = Stdlib.Int.toString (Stdlib.List.length rest)
          let fetched = Stdlib.List.length items
          // Past the fetch cap the list on the page is a sample, and saying so is the whole point of
          // having counted separately.
          let truncated =
            if (Stdlib.Int.fromInt64 total) > fetched then
              lede $"Showing the first {Stdlib.Int.toString fetched} of {n}."
            else
              ""

          let disclosure =
            Stdlib.Html.details
              []
              [ Stdlib.Html.summary [] [ Stdlib.Html.text $"{more} more" ]
                Stdlib.Html.stringNode (pillsDiv "margin-top:.6rem" (pillsFor rest))
                Stdlib.Html.stringNode truncated ]
            |> Stdlib.Html.nodeToString

          heading ++ (pillsDiv "" (pillsFor shown)) ++ disclosure

    let deps = dependenciesOf hashStr
    let dependents = dependentsOf hashStr

    page
      name
      ((crumbs modulePath)
       ++ (Stdlib.Html.h1
             []
             [ Stdlib.Html.text leaf, Stdlib.Html.stringNode depBadge ]
           |> Stdlib.Html.nodeToString)
       // `&middot;` is markup, not text, so it goes in as a string node; escaping it would print the
       // entity rather than the dot.
       ++ (Stdlib.Html.p
             [ Stdlib.Html.classes [ "meta" ] ]
             [ Stdlib.Html.text $"{kindLabel kind} "
               Stdlib.Html.stringNode "&middot; "
               Stdlib.Html.code
                 [ ("title", Stdlib.Option.Option.Some hashStr) ]
                 [ Stdlib.Html.text short ] ]
           |> Stdlib.Html.nodeToString)
       ++ descBlock
       ++ $"<pre><code>{highlightHtml src}</code></pre>"
       ++ (linkList "Uses" deps "Nothing. This stands on its own.")
       ++ (cappedLinkList
             "Used by"
             dependents
             (dependentsCountOf hashStr)
             "Nothing here calls it yet.")
       ++ "<details><summary>What the hash means</summary><p class=\"lede\">Content-addressed: this hash "
       ++ "is this code, forever. Editing the name publishes a different hash, and this one stays "
       ++ "reachable and keeps working for anything already calling it.</p></details>")


/// Search across every listed name. Deliberately name-and-module only: it is the query people actually
/// type, and it stays a single indexed-ish scan rather than a full-text engine the relay has to maintain.
let searchHandlerFn (req: HttpRequest) : HttpResponse =
  let q =
    Stdlib.Http.Request.queryParam req "q" |> Stdlib.Option.withDefault ""

  if Stdlib.String.trim q == "" then
    page "Search" "<h1>Search</h1><p class=\"lede\">Type a name above.</p>"
  else
    let results = searchItems (Stdlib.String.trim q)
    let n = Stdlib.List.length results
    let total = searchCount (Stdlib.String.trim q)

    if n == 0 then
      page
        $"Search: {q}"
        ((Stdlib.Html.h1 [] [ Stdlib.Html.text "No matches" ]
          |> Stdlib.Html.nodeToString)
         ++ (Stdlib.Html.p
               [ Stdlib.Html.classes [ "lede" ] ]
               [ Stdlib.Html.text "Nothing here matches "
                 Stdlib.Html.code [] [ Stdlib.Html.text q ]
                 Stdlib.Html.text "." ]
             |> Stdlib.Html.nodeToString))
    else
      let rows =
        results
        |> Stdlib.List.map (fun r ->
          let (full, kind, mods) = r
          Stdlib.Html.a
            [ Stdlib.Html.classes [ "row" ]
              ("href", Stdlib.Option.Option.Some $"/p?name={full}") ]
            [ Stdlib.Html.div
                [ Stdlib.Html.classes [ "n" ] ]
                [ Stdlib.Html.code [] [ Stdlib.Html.text full ] ]
              Stdlib.Html.div
                [ Stdlib.Html.classes [ "c" ] ]
                [ Stdlib.Html.text (kindLabel kind) ] ]
          |> Stdlib.Html.nodeToString)
        |> (fun l -> Stdlib.String.join l "")

      let capped =
        if (Stdlib.Int.fromInt64 total) > n then
          let shown = Stdlib.Int.toString n

          $"<p class=\"lede\">Showing the first {shown} of {num total}. Narrow the search to see the rest.</p>"
        else
          ""

      page
        $"Search: {q}"
        ($"<h1>{num total} {(if total == 1L then "match" else "matches")}</h1>"
         ++ (Stdlib.Html.p
               [ Stdlib.Html.classes [ "lede" ] ]
               [ Stdlib.Html.text "for ", Stdlib.Html.code [] [ Stdlib.Html.text q ] ]
             |> Stdlib.Html.nodeToString)
         ++ capped
         ++ $"<div class=\"rows\">{rows}</div>")
