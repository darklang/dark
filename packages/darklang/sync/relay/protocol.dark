/// The relay's PROTOCOL surface: the endpoints another instance talks to.
///
/// Separate from the website in `Darklang.Matter` because they answer to different readers. These are a
/// wire contract -- a peer depends on their shapes and status codes -- while the pages beside them are
/// free to be rewritten whenever they read badly.
///
/// A relay stores and hands back ops. It never folds them, so it cannot change what anyone's code means;
/// the worst a bad relay does is withhold. That is what makes it safe to point machines at.
module Darklang.Matter.Relay

type HttpResponse = Stdlib.Http.Response
type HttpRequest = Stdlib.Http.Request

let pingHandlerFn (_req: HttpRequest) : HttpResponse =
  Stdlib.Http.responseWithText "pong" 200


/// Hand out ops as portable wire records. `?sinceSeq=<n>` makes it INCREMENTAL, paging by the RELAY's OWN
/// arrival order and returning the position to resume from in the bundle's `cursor`.
///
/// Deliberately not the client's `max(origin_ts)`: a stamp cursor assumes ops arrive in stamp order, and
/// concurrent editing on two machines then skips exactly the interesting ops, silently and forever.
let pullHandlerFn (req: HttpRequest) : HttpResponse =
  // A cursor that is not a number is REFUSED, not read as zero. Read as zero it would answer 200 with the
  // whole log and a `cursor` of 0, telling a client whose stored cursor had gone bad that it had synced
  // incrementally. Failing loudly is the only version of this a client can act on.
  let parsed =
    match Stdlib.Http.Request.queryParam req "sinceSeq" with
    | Some raw ->
      (match Stdlib.Int64.parse raw with
       | Ok n -> Stdlib.Result.Result.Ok n
       | Error _ -> Stdlib.Result.Result.Error raw)
    | None -> Stdlib.Result.Result.Ok 0L

  match parsed with
  | Error raw ->
    Stdlib.Http.responseWithText
      $"?sinceSeq= has to be a number, and \"{raw}\" isn't one"
      400
  | Ok sinceSeq ->

  let owner =
    Stdlib.Http.Request.queryParam req "owner" |> Stdlib.Option.withDefault ""

  if owner == "" then
    // The common case by far, and the one a first sync spends all its time in: everything the relay
    // holds, encoded natively rather than through 2,000 Dark values per page.
    let (json, _cursor) = SCM.Wire.exportPageJsonSince sinceSeq
    Stdlib.Http.responseWithJson json 200
  else
    // Owner-filtered pages are rare and small, so they keep the Dark path.
    let (ops, cursor) = SCM.Wire.exportOwnedSince owner sinceSeq
    Stdlib.Http.responseWithJson (SCM.Wire.wireEncodeAt cursor ops) 200

/// Cheap "what do you hold?" summary (op count + cursor) -- no full-log transfer. Powers
/// `dark sync status <url>`.
let headHandlerFn (_req: HttpRequest) : HttpResponse =
  Stdlib.Http.responseWithJson (SCM.Wire.headEncode (SCM.Wire.localHead ())) 200


/// May this request write?
///
/// FAIL CLOSED: a relay with no `DARK_MATTER_WRITE_SECRET` set refuses every write and says so. A relay is
/// a thing you stand up and walk away from, so the other default is an open write endpoint nobody
/// remembers is open.
///
/// The secret comes from the ENVIRONMENT, never from the package store. This server publishes its own
/// store as HTML at `/m` and `/p`, so a secret that lived in a package would be readable by anyone who can
/// load a page -- including this file, which is itself a package.
///
/// Write-AUTHORISATION, not authorship: everyone holding the secret can write as anyone, the accepted
/// trade for a relay shared between people who have met.
let writeAllowed (req: HttpRequest) : Stdlib.Result.Result<Unit, String> =
  match Stdlib.Env.get "DARK_MATTER_WRITE_SECRET" with
  | None | Some "" ->
    Stdlib.Result.Result.Error
      "this relay has no write secret configured (DARK_MATTER_WRITE_SECRET is unset or empty), so it accepts no writes. Set it where the relay runs."
  | Some expected ->
    // Split the scheme off at the FIRST space and compare it case-INSENSITIVELY, as RFC 7235 says an auth
    // scheme is. Both halves matter: a secret is allowed to contain the word "Bearer", so stripping the
    // scheme wherever it appears would lock out a perfectly good secret, and `bearer <secret>` is as
    // valid as `Bearer <secret>`.
    //
    // A credential with no scheme is taken as-is, which is what a hand-written `curl -H "Authorization:
    // <secret>"` sends.
    let presented =
      match Stdlib.Http.Request.header req "authorization" with
      | Some h ->
        let trimmed = Stdlib.String.trim h

        match Stdlib.String.split trimmed " " with
        | [] -> ""
        | scheme :: rest ->
          // Rejoined, not taken as one piece: a secret is allowed to contain a space.
          if (Stdlib.String.toLowercase scheme) == "bearer" then
            Stdlib.String.trim (Stdlib.String.join rest " ")
          else
            trimmed
      | None -> ""

    // Constant time: `==` stops at the first wrong character, and how long the relay took to say no
    // would then say how many leading characters were right.
    if Stdlib.Crypto.constantTimeEquals presented expected then
      Stdlib.Result.Result.Ok()
    else if presented == "" then
      Stdlib.Result.Result.Error
        "push needs the relay's write secret: `dark connect <url> --secret <secret>`"
    else
      // A different message from the empty case: "you have not set this up" and "the value is wrong" are
      // different problems, and only the relay can tell them apart.
      Stdlib.Result.Result.Error
        "that write secret isn't the one this relay expects. Check it with whoever runs the relay, then `dark connect <url> --secret <secret>` again."


/// Ingest pushed ops into the relay's store (pending; origin_ts preserved). Ops are content-addressed,
/// so a re-push is a no-op.
let pushHandlerFn (req: HttpRequest) : HttpResponse =
  match writeAllowed req with
  | Error why -> Stdlib.Http.responseWithText why 401
  | Ok _ ->

  let owner =
    Stdlib.Http.Request.queryParam req "owner" |> Stdlib.Option.withDefault ""

  // Refused, the way `/branch/push` refuses the same shape. Ops stored under owner "" are invisible to
  // every `?owner=` pull, forever, so accepting them would answer 200 to a client whose work the relay
  // has just dropped on the floor.
  if owner == "" then
    Stdlib.Http.badRequest "push needs ?owner="
  else

  match SCM.Wire.wireDecode req.body with
  | Ok bundle ->
    match SCM.Wire.storeWithOwner owner bundle.ops bundle.commits with
    | Ok n ->
      // A JSON body, not a sentence: the client acts on this count, and a protocol a client
      // parses out of English is one wording change from silent breakage.
      Stdlib.Http.responseWithText
        $"{{\"stored\": {Stdlib.Int.toString n}, \"owner\": \"{owner}\"}}"
        200
    | Error e -> Stdlib.Http.serverError e
  | Error _ ->
    Stdlib.Http.badRequest "expected a versioned SyncBundle {formatVersion, darkBuild, ops, commits}"


/// A branch is somebody's unmerged work, so READING one takes the same secret as writing.
///
/// The package log stays open: `/m` and `/p` already serve it as HTML, so gating `/sync/pull` would
/// protect nothing. A branch has never been published anywhere, which is the whole point of it.
let branchAccessAllowed (req: HttpRequest) : Stdlib.Result.Result<Unit, String> =
  match writeAllowed req with
  | Ok _ -> Stdlib.Result.Result.Ok()
  | Error why ->
    // A relay with no secret CONFIGURED is the relay's fault, and `writeAllowed`'s message says so;
    // replacing it with "connect with the secret" would send the client chasing a credential that
    // cannot exist. Only the credential cases get the branch-specific wording.
    if Stdlib.String.contains why "accepts no writes" then
      Stdlib.Result.Result.Error why
    else
      Stdlib.Result.Result.Error
        "branches are not public: this needs the relay's secret. `dark connect <url> --secret <secret>`"


/// Store a pushed branch BUNDLE (registry + frontier ops) keyed by (owner, branch). `?owner=X&branch=Y`,
/// body = the export JSON. The relay is a dumb store; it never folds or runs the branch.
let branchPushHandlerFn (req: HttpRequest) : HttpResponse =
  match writeAllowed req with
  | Error why -> Stdlib.Http.responseWithText why 401
  | Ok _ ->

  let owner =
    Stdlib.Http.Request.queryParam req "owner" |> Stdlib.Option.withDefault ""

  let branch =
    Stdlib.Http.Request.queryParam req "branch" |> Stdlib.Option.withDefault ""

  // Validate before claiming anything: storing whatever arrives and always answering 200 means an empty
  // body with no query params gets a success message and a junk row keyed on "".
  let body = Stdlib.String.fromBlobWithReplacement req.body

  if owner == "" || branch == "" then
    Stdlib.Http.responseWithText
      "branch push needs ?owner= and ?branch="
      400
  else if body == "" then
    Stdlib.Http.responseWithText $"branch push for \"{branch}\" had an empty body" 400
  // A BRANCH bundle, not a sync bundle: `exportBranch` emits {"branchId":..,"name":..,"ops":[..]}, which
  // `wireDecode` rightly rejects, so validate the shape THIS endpoint receives instead.
  else if Stdlib.Bool.not (Stdlib.String.startsWith (Stdlib.String.trim body) "{") then
    Stdlib.Http.responseWithText "branch push body wasn't JSON" 400
  else if Stdlib.Bool.not (Stdlib.String.contains body "\"ops\"") then
    Stdlib.Http.responseWithText "branch push body had no ops" 400
  else
    // A URL is text and a branch id is a Uuid, so this is where one becomes the other. Refusing a
    // non-id here rather than storing under it keeps the relay's branch table keyed on real ids.
    match Stdlib.Uuid.parse branch with
    | Error _ ->
      Stdlib.Http.responseWithText
        $"branch push needs ?branch= to be a branch id, and \"{branch}\" isn't one"
        400
    | Ok branchId ->
      // A push that loses to a newer stored bundle is ANSWERED, not silently dropped: the pusher is
      // usually a machine that has fallen behind, and the one thing it must not conclude is that
      // the relay now serves what it just sent.
      if SCM.PackageOps.relayStoreBranch owner branchId body then
        Stdlib.Http.responseWithText $"stored branch \"{branch}\" for \"{owner}\"" 200
      else
        Stdlib.Http.responseWithText
          $"kept the newer copy of branch \"{branch}\" for \"{owner}\"; nothing was replaced"
          409

/// Serve a stored branch bundle (`?owner=X&branch=Y`), or "" if none.
let branchPullHandlerFn (req: HttpRequest) : HttpResponse =
  match branchAccessAllowed req with
  | Error why -> Stdlib.Http.responseWithText why 401
  | Ok _ ->

  let owner =
    Stdlib.Http.Request.queryParam req "owner" |> Stdlib.Option.withDefault ""

  let branch =
    Stdlib.Http.Request.queryParam req "branch" |> Stdlib.Option.withDefault ""

  if owner == "" then
    // Refused, the way `/branch/list` refuses it and the way push refuses ops under owner "".
    // Answering 200 with "" instead reads to a client as "that branch isn't here" rather than
    // "you didn't say whose".
    Stdlib.Http.badRequest "branch pull needs ?owner="
  else
    match Stdlib.Uuid.parse branch with
    // Malformed input is refused, the way push refuses it; only a MISSING bundle answers "" 200.
    | Error _ ->
      Stdlib.Http.badRequest
        $"branch pull needs ?branch= to be a branch id, and \"{branch}\" isn't one"
    | Ok branchId ->
      Stdlib.Http.responseWithText (SCM.PackageOps.relayGetBranch owner branchId) 200

/// List the branch ids an owner has pushed (`?owner=X`), newline-joined.
let branchListHandlerFn (req: HttpRequest) : HttpResponse =
  match branchAccessAllowed req with
  | Error why -> Stdlib.Http.responseWithText why 401
  | Ok _ ->

  let owner =
    Stdlib.Http.Request.queryParam req "owner" |> Stdlib.Option.withDefault ""

  if owner == "" then
    Stdlib.Http.badRequest "branch list needs ?owner="
  else
    Stdlib.Http.responseWithText (SCM.PackageOps.relayListBranches owner) 200

/// Every hosted branch with its owner (`owner branch-id` per line). Same secret as the other branch
/// reads: whose branches exist is itself unpublished work.
let branchOwnersHandlerFn (req: HttpRequest) : HttpResponse =
  match branchAccessAllowed req with
  | Error why -> Stdlib.Http.responseWithText why 401
  | Ok _ -> Stdlib.Http.responseWithText (SCM.PackageOps.relayListAllBranches ()) 200


// ---------------------
// Seeds
// ---------------------
//
// A SEED is the op log as a file: what a fresh install folds to become this store, and what CI fetches
// instead of parsing `packages/` out of text. It is cut from the SAME log `/sync/pull` pages out, so the
// two can never disagree about what this relay holds.
//
// Cut AT A COMMIT, always, even when the caller asked for "latest": that is what makes a pin
// reproducible. Two machines asking for the same commit get the same OPS however far the store has
// moved in between, which is the property `scripts/packages/pin` rests on. The file is not
// byte-identical across servers -- the stamp says which build cut it and when -- and nothing needs
// it to be, since ids are derived from op content rather than from the file.

val seedRoute = "/seed/:file"


/// Where a cut seed is cached: beside the store, named for the commit it was cut at.
///
/// A cut is decided entirely by its commit -- commits are immutable and ops only ever append -- so a
/// file here never needs invalidating. Beside the store rather than inside it, like the source cache:
/// it is derived, it is per-install, and it has no business travelling inside a seed of its own.
let seedCachePath (commit: String) : String =
  let storeDir = Stdlib.Cli.Path.parent (Stdlib.LocalStore.path ())
  Stdlib.Cli.Path.join [ storeDir, "seeds", $"{commit}.db" ]


/// The commit main is at here, or "" when nothing has been committed yet.
let headCommit () : String =
  match SCM.Commits.recent 1L with
  | c :: _ -> c.hash
  | [] -> ""


/// Cut a seed at <param commit>, or hand back the one already cut there.
let cutSeedAt (commit: String) : Stdlib.Result.Result<String, String> =
  let path = seedCachePath commit

  if Stdlib.Cli.File.exists path then
    Stdlib.Result.Result.Ok path
  else
    match Stdlib.Cli.Dir.createRecursive (Stdlib.Cli.Path.parent path) with
    | Error e ->
      Stdlib.Result.Result.Error
        $"could not make the seed cache directory: {Stdlib.Cli.Posix.Error.toString e}"
    | Ok _ ->
      match Stdlib.LocalStore.seedTo path (Stdlib.Option.Option.Some commit) with
      | Error e -> Stdlib.Result.Result.Error e
      | Ok _ -> Stdlib.Result.Result.Ok path


/// What a seed cut from this relay says about itself, so a pin can be checked without downloading
/// tens of megabytes to read four fields.
type SeedMeta =
  { /// The commit the seed this describes would be cut at: the current head, or the resolved
    /// `?commit=` when one was asked about. "" only when nothing is committed here at all.
    head: String
    /// The op-blob layout a seed from here is written in. A fetcher that reads a different one must
    /// refuse rather than fold it.
    format: String
    /// The build that would cut it, for tracing a bad seed back to a binary. This server's own
    /// build, not whatever its store says: the store's `kernel` records the build that cut the seed
    /// it GREW from, which is a different fact and older.
    kernel: String
    /// What a seed cut at `head` would carry. A client comparing these with its own knows whether
    /// a fetch would tell it anything.
    ops: Int64
    commits: Int64 }


/// `/seed/meta`: the fields a pin needs, without the seed.
///
/// `?commit=<c>` asks about THAT commit instead of the head, which is how a pin is checked: it
/// answers 404 if the commit does not resolve here, and otherwise the shape the cut would have.
/// Two counts rather than twelve megabytes.
let seedMetaHandlerFn (req: HttpRequest) : HttpResponse =
  let asked =
    Stdlib.Http.Request.queryParam req "commit" |> Stdlib.Option.withDefault ""

  let resolved =
    if asked == "" then
      Stdlib.Result.Result.Ok(Stdlib.Option.Option.None)
    else
      match SCM.PackageOps.resolveCommit asked with
      | Some hash -> Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some hash)
      | None -> Stdlib.Result.Result.Error $"no single commit here starts with \"{asked}\""

  match resolved with
  | Error why -> Stdlib.Http.responseWithText why 404
  | Ok at ->
    let shape =
      match at with
      | Some hash -> SCM.PackageOps.seedShapeAt hash
      | None ->
        Stdlib.Option.Option.Some(
          (SCM.PackageOps.committedCountOnMain (),
           SCM.PackageOps.commitCountOnBranch SCM.Branch.mainBranchId)
        )

    match shape with
    | None -> Stdlib.Http.responseWithText $"no commit here named \"{asked}\"" 404
    | Some counts ->
      let (ops, commits) = counts

      let meta =
        SeedMeta
          { head =
              match at with
              | Some hash -> hash
              | None -> headCommit ()
            format = SCM.StoreMeta.get "format"
            kernel = Darklang.Cli.Installation.Helpers.buildHash ()
            ops = ops
            commits = commits }

      Stdlib.Http.responseWithJson (Stdlib.Json.serialize<SeedMeta> meta) 200


/// `/seed/latest.db` and `/seed/<commit>.db`: the store as a file, cut at a commit.
///
/// `latest.db` resolves to the current head and is served as the cut AT that head, so it is the same
/// bytes as asking for that commit by name. A short commit prefix resolves like git's; an ambiguous
/// one is refused rather than guessed at, because guessing here pins the wrong package set.
let seedHandlerFn (req: HttpRequest) : HttpResponse =
  let requested =
    Stdlib.HttpServer.getPathParam req seedRoute "file"
    |> Stdlib.Option.withDefault ""

  // `.db` is part of the route rather than a query param so a browser, `curl -O` and a CI cache all
  // end up with a file named like what it is.
  if Stdlib.Bool.not (Stdlib.String.endsWith requested ".db") then
    Stdlib.Http.badRequest
      "a seed is asked for as `/seed/latest.db` or `/seed/<commit>.db`"
  else

  let asked = Stdlib.String.dropLast requested 3

  let resolved =
    if asked == "" then
      // `/seed/.db` asks for nothing. Refused rather than read as an empty prefix, which matches
      // every commit and so resolves to one whenever a store happens to hold exactly one.
      Stdlib.Result.Result.Error
        "a seed is asked for as `/seed/latest.db` or `/seed/<commit>.db`"
    else if asked == "latest" then
      let head = headCommit ()

      if head == "" then
        Stdlib.Result.Result.Error
          "nothing has been committed here yet, so there is no seed to cut"
      else
        Stdlib.Result.Result.Ok head
    else
      // `resolveCommit`, not `SCM.Commits.byHashPrefix`: that one takes the newest on a tie, which is
      // the right rule for a listing and the wrong one here. An ambiguous prefix would pin a package
      // set nobody chose, and silently.
      match SCM.PackageOps.resolveCommit asked with
      | Some hash -> Stdlib.Result.Result.Ok hash
      | None ->
        Stdlib.Result.Result.Error
          $"no single commit here starts with \"{asked}\""

  match resolved with
  | Error why -> Stdlib.Http.responseWithText why 404
  | Ok commit ->
    match cutSeedAt commit with
    | Error why -> Stdlib.Http.serverError why
    | Ok path ->
      match Stdlib.Cli.File.readBytes path with
      | Error e ->
        Stdlib.Http.serverError
          $"cut the seed but could not read it back: {Stdlib.Cli.Posix.Error.toString e}"
      | Ok bytes ->
        // The commit is in the bytes too (`store_meta.cut_at`), so this header is a convenience for
        // a fetcher that wants it without opening SQLite -- not the only record of it.
        Stdlib.Http.responseWithHeaders
          bytes
          [ ("Content-Type", "application/vnd.sqlite3"),
            ("X-Dark-Seed-Commit", commit),
            ("Content-Disposition", "attachment; filename=\"seed.db\"") ]
          200
