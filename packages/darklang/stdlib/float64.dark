module Darklang.Stdlib.Float64

type ParseError =
  | BadFormat


/// Not a number, the result of {{0.0 / 0.0}}. It is not equal to anything, itself
/// included; test for it with <fn Float64.isNaN>.
val nan = 0.0 / 0.0


/// Positive infinity, the result of {{1.0 / 0.0}}
val infinity = 1.0 / 0.0


/// Negative infinity, the result of {{-1.0 / 0.0}}
val negativeInfinity = -1.0 / 0.0


// A Float64's 64 bits are 1 sign bit, then 11 exponent bits, then 52 fraction bits

/// The sign bit, bit 63
val __signBit: UInt64 = 1u64 << 63u64


/// The 52 fraction bits, the lowest
val __fractionBits: UInt64 = (1u64 << 52u64) - 1u64


/// Every bit but the sign
val __allButSignBit: UInt64 = __signBit - 1u64


/// Every bit but the exponent's: the sign and the fraction
val __allButExponentBits: UInt64 = __signBit | __fractionBits


/// 2^52. A normal number's significand is 1.fraction, so as an integer it is fraction +
/// 2^52; and a subnormal number times 2^52 is normal
val __twoToThe52: Float64 = 2.0 ** 52.0


/// Round up to an integer value. Raises for NaN, infinity, or a result past Int64;
/// <fn Int64.fromFloatCeiling> returns an {{Error}} instead.
let ceiling(a: Float64): Int64 =
  Builtin.float64Ceiling(a)


/// Round up to an integer value
let roundUp(a: Float64): Int64 =
  ceiling(a)


/// Round down to an integer value.
/// Consider <fn Float64.truncate> if your goal
/// is to discard the fractional part of a number: {{Float64.floor(-1.9) == -2}}
/// but {{Float64.truncate(-1.9) == -1}}. Raises for NaN, infinity, or a result past
/// Int64; <fn Int64.fromFloatFloor> returns an {{Error}} instead.
let floor(a: Float64): Int64 =
  Builtin.float64Floor(a)


/// Round down to an integer value.
/// Consider <fn Float64.truncate> if your goal is to discard the fractional part
/// of a number: {{Float64.floor(-1.9) == -2}} but {{Float64.truncate(-1.9) == -1}}
let roundDown(a: Float64): Int64 =
  floor(a)


/// Round to the nearest integer value. Raises for NaN, infinity, or a result past Int64;
/// <fn Int64.fromFloatRounded> returns an {{Error}} instead.
let round(a: Float64): Int64 =
  Builtin.float64Round(a)


/// Discard the fractional portion of the float, rounding towards zero
let roundTowardsZero(a: Float64): Int64 =
  truncate(a)


/// Discard the fractional portion of the float, rounding towards zero. Raises for NaN,
/// infinity, or a result past Int64; <fn Int64.fromFloat64> returns an {{Error}} instead.
let truncate(a: Float64): Int64 =
  Builtin.float64Truncate(a)


impl Negate for Float64 =
  /// Returns the negation of <param a>, {{-a}}
  let negate(a: Float64): Float64 =
    a * -1.0


/// Get the square root of a float
let sqrt(a: Float64): Float64 =
  Builtin.float64Sqrt(a)


/// The natural logarithm of <param a>. {{-Infinity}} for zero, NaN for a negative
/// number or NaN.
let log(a: Float64): Float64 =
  Builtin.float64Log(a)


/// The base-10 logarithm of <param a>. {{-Infinity}} for zero, NaN for a negative
/// number or NaN.
let log10(a: Float64): Float64 =
  Builtin.float64Log10(a)


/// e raised to the power of <param a>. {{Infinity}} where the result is too large,
/// {{0.0}} where it is too small.
let exp(a: Float64): Float64 =
  Builtin.float64Exp(a)


/// <param x> rounded to <param places> decimal places, a tie going to the even neighbour
/// as in <fn Float64.round>: {{Float64.roundTo(37.777777, 2) == 37.78}},
/// {{Float64.roundTo(0.125, 2) == 0.12}}. A negative <param places> rounds to tens,
/// hundreds and so on: {{Float64.roundTo(1250.0, -2) == 1200.0}}. NaN and the infinities
/// come back unchanged, and a result too large for a Float64 is an infinity.
///
/// It rounds the exact value <param x> holds, which is not always the decimal it prints
/// as: 2.675 is held as 2.67499999999999982236431605997495353221893310546875, so
/// {{Float64.roundTo(2.675, 2) == 2.67}}, as in Python. {{Decimal.round(2.675dec, 2)}}
/// is {{Ok(2.68dec)}}.
let roundTo(x: Float64, places: Int64): Float64 =
  if isFinite(x) then
    match parse(__roundToText(x, places)) with
    | Ok(r) -> r
    | Error(_) -> x
  else
    x


/// The exact value of a finite <param x> rounded to <param places> places, ties to even,
/// as text the parsers read back, such as {{"-3778e-2"}}
let __roundToText(x: Float64, places: Int64): String =
  // past 1074 places every Float64 is exact, and past -309 every one rounds to zero
  let places =
    if places > 1074 then
      1074
    else if places < -309 then
      -309
    else
      places

  let bits = BigInt.fromUInt64(toBits(x))
  let unit = 2z ** 52z
  let biased = bits / unit % 2048z
  let fraction = bits % unit
  let (mantissa, exponent) =
    if biased == 0z then (fraction, -1074z) else (fraction + unit, biased - 1075z)

  // x * 10^places as the fraction num / den
  let p = BigInt.fromInt64(places)
  let num2 = if exponent > 0z then 2z ** exponent else 1z
  let den2 = if exponent < 0z then 2z ** (0z - exponent) else 1z
  let num10 = if p > 0z then 10z ** p else 1z
  let den10 = if p < 0z then 10z ** (0z - p) else 1z
  let num = mantissa * num2 * num10
  let den = den2 * den10
  let kept = num / den
  let twice = num % den * 2z
  let kept = if twice > den || twice == den && kept % 2z == 1z then kept + 1z else kept
  let sign = if bits >= 2z ** 63z then "-" else ""
  $"{sign}{kept}e{0 - places}"


/// Returns the smallest <type Float64> greater than <param a>. The next after
/// the largest finite value is infinity; NaN stays NaN.
let nextUp(a: Float64): Float64 =
  if isNaN(a) || a == infinity then
    a
  else if a == 0.0 then
    // after 0.0 or -0.0 comes the smallest positive number
    fromBits(1u64)
  else if a > 0.0 then
    fromBits(toBits(a) + 1u64)
  else
    fromBits(toBits(a) - 1u64)


/// Returns the largest <type Float64> less than <param a>. The next before the
/// smallest finite value is negative infinity; NaN stays NaN.
let nextDown(a: Float64): Float64 =
  if isNaN(a) || a == negativeInfinity then
    a
  else if a == 0.0 then
    // before 0.0 or -0.0 comes the negative number closest to zero
    fromBits(__signBit | 1u64)
  else if a > 0.0 then
    fromBits(toBits(a) - 1u64)
  else
    fromBits(toBits(a) + 1u64)


/// Returns {{a * 2^exponent}}, exact unless it overflows to an infinity or loses
/// bits below the smallest <type Float64>: C's `ldexp`.
let scaleByPowerOfTwo(a: Float64, exponent: Int64): Float64 =
  if a == 0.0 || Bool.not(isFinite(a)) then
    a
  else
    // Beyond +-5000 every result is 0 or infinity anyway, and clamping keeps the sums
    // below from overflowing
    let exponent =
      if exponent > 5000 then
        5000
      else if exponent < -5000 then
        -5000
      else
        exponent

    // A subnormal number has no implicit leading 1 bit; times 2^52 it is normal
    let (a, exponent) =
      if __exponentField(a) == 0 then
        (a * __twoToThe52, exponent - 52)
      else
        (a, exponent)

    let target = __exponentField(a) - 1023 + exponent
    if target > 1023 then
      if a < 0.0 then negativeInfinity else infinity
    else if target < -1075 then
      if a < 0.0 then -0.0 else 0.0
    else
      // Write the target exponent into a's bits. If the result is subnormal, build a
      // number 2^53 times too big instead and multiply by 2^-53, so that a single
      // multiplication does the rounding
      let (field, scale) =
        if target < -1022 then
          (target + 53 + 1023, 2.0 ** -53.0)
        else
          (target + 1023, 1.0)

      let fieldBits = UInt64.fromInt64(field) |> Option.withDefault(0u64)
      fromBits(toBits(a) & __allButExponentBits | fieldBits << 52u64) * scale


/// Returns the power of two <param a> lies within, {{floor(log2(|a|))}}, read from its
/// bits: {{binaryExponent(10.0)}} is {{Some 3}}. {{None}} for zero, infinities and NaN.
/// With <fn Float64.scaleByPowerOfTwo>, it splits a number into C's `frexp` parts.
let binaryExponent(a: Float64): Option<Int64> =
  let field = __exponentField(a)
  if field == 2047 || a == 0.0 then
    None
  else if field == 0 then
    // subnormal: times 2^52 it is normal, so read that exponent and subtract 52
    Some(__exponentField(a * __twoToThe52) - 1023 - 52)
  else
    Some(field - 1023)


/// The 11-bit exponent field of <param a>, which holds the exponent plus 1023: 0 for zero
/// and subnormal numbers, 2047 for infinities and NaN
let __exponentField(a: Float64): Int64 =
  UInt64.toInt64(toBits(a) >> 52u64 & 2047u64) |> Option.withDefault(0)


/// A finite, non-negative <param a> as an integer significand m and a power of two e, so
/// that {{a == m * 2^e}} exactly
let __significandAndExponent(a: Float64): (BigInt * Int64) =
  let field = __exponentField(a)
  let fraction = toBits(a) & __fractionBits
  if field == 0 then
    // subnormal: no implicit leading 1 bit, and the smallest exponent
    (BigInt.fromUInt64(fraction), -1074)
  else
    (BigInt.fromUInt64(fraction + (1u64 << 52u64)), field - 1075)


impl Add for Float64 =
  /// Add <type Float64> <param a> to <type Float64> <param b>
  let add(a: Float64, b: Float64): Float64 =
    Builtin.add(a, b)


impl Subtract for Float64 =
  /// Subtract <type Float64> <param b> from <type Float64> <param a>
  let subtract(a: Float64, b: Float64): Float64 =
    Builtin.subtract(a, b)


impl Multiply for Float64 =
  /// Multiply <type Float64> <param a> by <type Float64> <param b>
  let multiply(a: Float64, b: Float64): Float64 =
    Builtin.multiply(a, b)


impl Power for Float64 =
  /// Returns <param base> raised to the power of <param exponent>
  let power(base: Float64, exponent: Float64): Float64 =
    Builtin.power(base, exponent)


impl Divide for Float64 =
  /// Divide <type Float64> <param a> by <type Float64> <param b>
  let divide(a: Float64, b: Float64): Float64 =
    Builtin.divide(a, b)


// Checked arithmetic. The operators follow IEEE 754 and give NaN or an infinity
// where the answer is not a finite number; these return {{Error}} instead.

/// {{Ok}} <param result> if it is finite, otherwise {{Error Overflow}}
let __noOverflow(result: Float64): Result<Float64, Math.Overflow> =
  if isFinite(result) then Ok(result) else Error(Math.Overflow.Overflow)


/// {{Ok}} <param result> if it is finite, otherwise {{Error NotANumber}} for NaN or
/// {{Error}} <param ifInfinite> for an infinity
let __finite(result: Float64, ifInfinite: Math.NonFinite): Result<Float64, Math.NonFinite> =
  if isFinite(result) then
    Ok(result)
  else if isNaN(result) then
    Error(Math.NonFinite.NotANumber)
  else
    Error(ifInfinite)


/// Adds <param a> to <param b>, or {{Error Overflow}} where the sum is not finite
let checkedAdd(a: Float64, b: Float64): Result<Float64, Math.Overflow> =
  __noOverflow(a + b)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where the difference is
/// not finite
let checkedSubtract(a: Float64, b: Float64): Result<Float64, Math.Overflow> =
  __noOverflow(a - b)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where the product is not
/// finite
let checkedMultiply(a: Float64, b: Float64): Result<Float64, Math.Overflow> =
  __noOverflow(a * b)


/// Divides <param a> by <param b>, or {{Error DivisionByZero}} where <param b> is zero
/// and {{Error Overflow}} where the quotient is too large
let checkedDivide(a: Float64, b: Float64): Result<Float64, Math.NonFinite> =
  if b == 0.0 then
    Error(Math.NonFinite.DivisionByZero)
  else
    __finite(a / b, Math.NonFinite.Overflow)


/// <param base> raised to the power of <param exponent>, or {{Error}} where the result
/// is not finite: {{DivisionByZero}} for zero to a negative power, {{NotANumber}} for a
/// negative base to a fractional power, and {{Overflow}} where it is too large
let checkedPower(base: Float64, exponent: Float64): Result<Float64, Math.NonFinite> =
  let ifInfinite = if base == 0.0 then Math.NonFinite.DivisionByZero else Math.NonFinite.Overflow
  __finite(base ** exponent, ifInfinite)


/// The square root of <param a>, or {{Error NotANumber}} where <param a> is negative
let checkedSqrt(a: Float64): Result<Float64, Math.NonFinite> =
  __finite(sqrt(a), Math.NonFinite.Overflow)


/// <fn Float64.parse>, but {{Error BadFormat}} for text that is not a finite number, such
/// as {{"NaN"}}, {{"Infinity"}} or a number too large for the type
let checkedParse(s: String): Result<Float64, ParseError> =
  match parse(s) with
  | Ok(f) when isFinite(f) -> Ok(f)
  | _ -> Error(ParseError.BadFormat)


impl Compare for Float64 =
  /// Returns true if a is less than b
  let lessThan(a: Float64, b: Float64): Bool =
    Builtin.lessThan(a, b)

  /// Returns true if a is less than or equal to b
  let lessThanOrEqualTo(a: Float64, b: Float64): Bool =
    Builtin.lessThanOrEqualTo(a, b)

  /// Returns true if a is greater than b
  let greaterThan(a: Float64, b: Float64): Bool =
    Builtin.greaterThan(a, b)

  /// Returns true if a is greater than or equal to b
  let greaterThanOrEqualTo(a: Float64, b: Float64): Bool =
    Builtin.greaterThanOrEqualTo(a, b)


/// If <param value> is within the range given by <param limitA> and <param
/// limitB>, returns <param value>.
/// If <param value> is outside the range, returns <param limitA> or <param
/// limitB>, whichever is closer to <param value>.
/// Returns <param value> wrapped in a {{Result}}.
/// <param limitA> and <param limitB> can be provided in any order.
///
/// The difference from <fn clamp>, which works on any type that compares: this one refuses a
/// NaN limit rather than answering. The generic cannot, since NaN is a Float64's business and
/// NaN compares false against everything, so there it comes back unclamped.
let clampRefusingNaN(value: Float64, limitA: Float64, limitB: Float64): Result<Float64, String> =
  if isNaN(limitA) || isNaN(limitB) then
    Error("clampRefusingNaN requires limits that are numbers")
  else
    let (lower, upper) = if limitA < limitB then (limitA, limitB) else (limitB, limitA)
    if value < lower then
      Ok(lower)
    else if value > upper then
      Ok(upper)
    else
      Ok(value)


/// Returns the <type Float64> value wrapped in a {{Result}} of the <type String>
let parse(s: String): Result<Float64, ParseError> =
  Builtin.float64Parse(s)


/// Returns true if <param f> is NaN
let isNaN(f: Float64): Bool =
  // NaN is the only float that does not equal itself
  f != f


/// Returns {{true}} if <param f> is a finite number, and {{false}} for NaN
/// and for positive or negative infinity
let isFinite(f: Float64): Bool =
  // NaN and ±infinity give NaN here, which equals nothing
  f - f == 0.0


/// Convert <param a> to an <type Int64> by discarding its fractional part.
/// Raises for NaN and infinities. Alias of <fn Float64.roundTowardsZero>.
let toInt64(a: Float64): Int64 =
  roundTowardsZero(a)


/// Return <param a>'s IEEE 754 binary64 bits as an unsigned 64-bit value.
let toBits(a: Float64): UInt64 =
  Builtin.float64ToBits(a)


/// Returns the <type Float64> whose IEEE 754 binary64 bits are <param bits>, the
/// inverse of <fn Float64.toBits>: {{fromBits(toBits(x))}} is {{x}}, {{-0.0}} and
/// NaN included.
let fromBits(bits: UInt64): Float64 =
  Builtin.float64FromBits(bits)


impl Display for Float64 =
  /// Stringify <param float> as the shortest decimal that parses back to the same value, e.g. `1.5`,
  /// `0.30000000000000004`, `1e+16`, `1e-5`.
  let display(a: Float64): String =
    Builtin.float64ToString(a)


impl Zero for Float64 =
  let zero(): Float64 =
    0.0


impl One for Float64 =
  let one(): Float64 =
    1.0
