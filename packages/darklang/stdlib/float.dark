module Darklang.Stdlib.Float


type ParseError = | BadFormat

/// Round up to an integer value
let ceiling(a: Float): Int64 = Builtin.floatCeiling(a)


/// Round up to an integer value
let roundUp(a: Float): Int64 = ceiling(a)

/// Round down to an integer value.
/// Consider <fn Float.truncate> if your goal
/// is to discard the fractional part of a number: {{Float.floor(-1.9) == -2}}
/// but {{Float.truncate(-1.9) == -1}}
let floor(a: Float): Int64 = Builtin.floatFloor(a)


/// Round down to an integer value.
/// Consider <fn Float.truncate> if your goal is to discard the fractional part
/// of a number: {{Float.floor(-1.9) == -2}} but {{Float.truncate(-1.9) == -1}}
let roundDown(a: Float): Int64 = floor(a)


/// Round to the nearest integer value
let round(a: Float): Int64 = Builtin.floatRound(a)


/// Returns the <type Float> value wrapped in a {{Result}} of the <type String>
let roundTowardsZero(a: Float): Int64 = truncate(a)


/// Discard the fractional portion of the float, rounding towards zero
let truncate(a: Float): Int64 = Builtin.floatTruncate(a)


impl Negate for Float =
  /// Returns the negation of <param a>, {{-a}}
  let negate(a: Float): Float = a * -1.0


/// Get the square root of a float
let sqrt(a: Float): Float = Builtin.floatSqrt(a)


impl Add for Float =
  /// Add <type Float> <param a> to <type Float> <param b>
  let add(a: Float, b: Float): Float = Builtin.floatAdd(a, b)


impl Subtract for Float =
  /// Subtract <type Float> <param b> from <type Float> <param a>
  let subtract(a: Float, b: Float): Float = Builtin.floatSubtract(a, b)


impl Multiply for Float =
  /// Multiply <type Float> <param a> by <type Float> <param b>
  let multiply(a: Float, b: Float): Float = Builtin.floatMultiply(a, b)


impl Power for Float =
  /// Returns <param base> raised to the power of <param exponent>
  let power(``base``: Float, exponent: Float): Float =
    Builtin.floatPower(``base``, exponent)


impl Divide for Float =
  /// Divide <type Float> <param a> by <type Float> <param b>
  let divide(a: Float, b: Float): Float = Builtin.floatDivide(a, b)


// Checked arithmetic. The operators follow IEEE 754 and give NaN or an infinity
// where the answer is not a finite number; these return {{Error}} instead.

/// {{Ok}} <param result> if it is finite, otherwise {{Error Overflow}}
let __noOverflow(result: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  if isFinite(result) then Ok(result) else Error(Stdlib.Math.Overflow.Overflow)


/// {{Ok}} <param result> if it is finite, otherwise {{Error NotANumber}} for NaN or
/// {{Error}} <param ifInfinite> for an infinity
let __finite(
  result: Float,
  ifInfinite: Stdlib.Math.NonFinite)
  : Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  if isFinite(result) then
    Ok(result)
  else if isNaN(result) then
    Error(Stdlib.Math.NonFinite.NotANumber)
  else
    Error(ifInfinite)


/// Adds <param a> to <param b>, or {{Error Overflow}} where the sum is not finite
let checkedAdd(a: Float, b: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  __noOverflow(a + b)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where the difference is
/// not finite
let checkedSubtract(a: Float, b: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  __noOverflow(a - b)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where the product is not
/// finite
let checkedMultiply(a: Float, b: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  __noOverflow(a * b)


/// Divides <param a> by <param b>, or {{Error DivisionByZero}} where <param b> is zero
/// and {{Error Overflow}} where the quotient is too large
let checkedDivide(a: Float, b: Float): Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  if b == 0.0 then
    Error(Stdlib.Math.NonFinite.DivisionByZero)
  else
    __finite(a / b, Stdlib.Math.NonFinite.Overflow)


/// <param base> raised to the power of <param exponent>, or {{Error}} where the result
/// is not finite: {{DivisionByZero}} for zero to a negative power, {{NotANumber}} for a
/// negative base to a fractional power, and {{Overflow}} where it is too large
let checkedPower(
  ``base``: Float,
  exponent: Float)
  : Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  let ifInfinite =
    if ``base`` == 0.0 then
      Stdlib.Math.NonFinite.DivisionByZero
    else
      Stdlib.Math.NonFinite.Overflow

  __finite(``base`` ** exponent, ifInfinite)


/// The square root of <param a>, or {{Error NotANumber}} where <param a> is negative
let checkedSqrt(a: Float): Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  __finite(sqrt(a), Stdlib.Math.NonFinite.Overflow)


/// <fn Float.parse>, but {{Error BadFormat}} for text that is not a finite number, such
/// as {{"NaN"}}, {{"Infinity"}} or a number too large for the type
let checkedParse(s: String): Stdlib.Result.Result<Float, ParseError> =
  match parse(s) with
  | Ok(f) when isFinite(f) -> Ok(f)
  | _ -> Error(ParseError.BadFormat)


impl Compare for Float =
  /// Returns true if a is less than b
  let lessThan(a: Float, b: Float): Bool = Builtin.floatLessThan(a, b)
  /// Returns true if a is less than or equal to b
  let lessThanOrEqualTo(a: Float, b: Float): Bool =
    Builtin.floatLessThanOrEqualTo(a, b)
  /// Returns true if a is greater than b
  let greaterThan(a: Float, b: Float): Bool = Builtin.floatGreaterThan(a, b)
  /// Returns true if a is greater than or equal to b
  let greaterThanOrEqualTo(a: Float, b: Float): Bool =
    Builtin.floatGreaterThanOrEqualTo(a, b)


/// If <param value> is within the range given by <param limitA> and <param
/// limitB>, returns <param value>.
/// If <param value> is outside the range, returns <param limitA> or <param
/// limitB>, whichever is closer to <param value>.
/// Returns <param value> wrapped in a {{Result}}.
/// <param limitA> and <param limitB> can be provided in any order.
///
/// The difference from <fn clamp>, which works on any type that compares: this one refuses a
/// NaN limit rather than answering. The generic cannot, since NaN is a Float's business and
/// NaN compares false against everything, so there it comes back unclamped.
let clampRefusingNaN(
  value: Float,
  limitA: Float,
  limitB: Float)
  : Stdlib.Result.Result<Float, String> =
  if Stdlib.Float.isNaN(limitA) || Stdlib.Float.isNaN(limitB) then
    Stdlib.Result.Result.Error("clampRefusingNaN requires limits that are numbers")
  else
    let (lower, upper) =
      if (limitA < limitB) then
        (limitA, limitB)
      else
        (limitB, limitA)

    if (value < lower) then
      Stdlib.Result.Result.Ok(lower)
    else if (value > upper) then
      Stdlib.Result.Result.Ok(upper)
    else
      Stdlib.Result.Result.Ok(value)


/// Returns the <type Float> value wrapped in a {{Result}} of the <type String>
let parse(s: String): Stdlib.Result.Result<Float, ParseError> =
  Builtin.floatParse(s)


/// Returns true if <param f> is NaN
let isNaN(f: Float): Bool =
  // NaN is the only float that does not equal itself
  f != f


/// Returns {{true}} if <param f> is a finite number, and {{false}} for NaN
/// and for positive or negative infinity
let isFinite(f: Float): Bool =
  // NaN and ±infinity give NaN here, which equals nothing
  (f - f) == 0.0


/// Convert <param a> to an <type Int64> by discarding its fractional part.
/// Raises for NaN and infinities. Alias of <fn Float.roundTowardsZero>.
let toInt64(a: Float): Int64 = Stdlib.Float.roundTowardsZero(a)


/// Return <param a>'s IEEE 754 binary64 bits as an unsigned 64-bit value.
let toBits(a: Float): UInt64 = Builtin.floatToBits(a)

impl ToString for Float =
  /// Stringify <param float> as the shortest decimal that parses back to the same value, e.g. `1.5`,
  /// `0.30000000000000004`, `1e+16`, `1e-5`.
  let toString(a: Float): String = Builtin.floatToString(a)

impl Zero for Float =
  let zero(): Float = 0.0

impl One for Float =
  let one(): Float = 1.0
