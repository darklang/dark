module Darklang.Stdlib.UInt128


type ParseError =
  | BadFormat
  | OutOfRange


/// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
/// The modulus <param b> must be greater than 0.
/// Use <fn UInt128.remainder> if you want the remainder after division, which has
/// a different behavior for negative numbers.
let ``mod`` (a: UInt128) (b: UInt128) : UInt128 = Builtin.uint128Mod a b


/// Adds two 128-bit unsigned integers together (wraps on overflow)
let add (a: UInt128) (b: UInt128) : UInt128 = Builtin.uint128Add a b


/// Subtracts two 128-bit unsigned integers (wraps on overflow)
let subtract (a: UInt128) (b: UInt128) : UInt128 = Builtin.uint128Subtract a b


/// Multiplies two 128-bit unsigned integers (wraps on overflow)
let multiply (a: UInt128) (b: UInt128) : UInt128 = Builtin.uint128Multiply a b


/// Divides two 128-bit unsigned integers
let divide (a: UInt128) (b: UInt128) : UInt128 = Builtin.uint128Divide a b


/// Returns {{true}} if <param a> is greater than <param b>
let greaterThan (a: UInt128) (b: UInt128) : Bool =
  Builtin.uint128GreaterThan a b


/// Returns {{true}} if <param a> is greater than or equal to <param b>
let greaterThanOrEqualTo (a: UInt128) (b: UInt128) : Bool =
  Builtin.uint128GreaterThanOrEqualTo a b


/// Returns {{true}} if <param a> is less than <param b>
let lessThan (a: UInt128) (b: UInt128) : Bool = Builtin.uint128LessThan a b


/// Returns {{true}} if <param a> is less than or equal to <param b>
let lessThanOrEqualTo (a: UInt128) (b: UInt128) : Bool =
  Builtin.uint128LessThanOrEqualTo a b


/// Get the square root of an <type UInt128>
let sqrt (a: UInt128) : Float = Builtin.uint128Sqrt a


/// Converts a <type UInt128> to a <type Float>
let toFloat (a: UInt128) : Float = Builtin.uint128ToFloat a


/// Stringify <param uint128>
let toString (uint128: UInt128) : String = Builtin.uint128ToString uint128


/// Parses a <type String> into a <type UInt128>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt128> range).
let parse
  (s: String)
  : Stdlib.Result.Result<UInt128, Stdlib.UInt128.ParseError> =
  Builtin.uint128Parse s


/// Converts a <type UInt8> to an <type UInt128>.
let fromUInt8 (i: UInt8) : UInt128 = Builtin.uint128FromUInt8 i


/// Converts a <type UInt16> to an <type UInt128>.
let fromUInt16 (i: UInt16) : UInt128 = Builtin.uint128FromUInt16 i


/// Converts a <type UInt32> to an <type UInt128>.
let fromUInt32 (i: UInt32) : UInt128 = Builtin.uint128FromUInt32 i


/// Converts a <type UInt64> to an <type UInt128>.
let fromUInt64 (i: UInt64) : UInt128 = Builtin.uint128FromUInt64 i


/// Bitwise AND on two <type UInt128> values
let bitwiseAnd (a: UInt128) (b: UInt128) : UInt128 =
  Builtin.uint128BitwiseAnd a b


/// Bitwise OR on two <type UInt128> values
let bitwiseOr (a: UInt128) (b: UInt128) : UInt128 =
  Builtin.uint128BitwiseOr a b


/// Bitwise XOR on two <type UInt128> values
let bitwiseXor (a: UInt128) (b: UInt128) : UInt128 =
  Builtin.uint128BitwiseXor a b


/// Bitwise NOT on a <type UInt128> value
let bitwiseNot (a: UInt128) : UInt128 = Builtin.uint128BitwiseNot a


/// Bitwise left shift of a <type UInt128> value
let shiftLeft (a: UInt128) (b: UInt128) : UInt128 =
  Builtin.uint128ShiftLeft a b


/// Bitwise right shift of a <type UInt128> value
let shiftRight (a: UInt128) (b: UInt128) : UInt128 =
  Builtin.uint128ShiftRight a b


// The operator traits, over the fns above.

impl Add for UInt128 =
  let add = Stdlib.UInt128.add


impl Subtract for UInt128 =
  let subtract = Stdlib.UInt128.subtract


impl Multiply for UInt128 =
  let multiply = Stdlib.UInt128.multiply


impl Divide for UInt128 =
  let divide = Stdlib.UInt128.divide


impl Modulo for UInt128 =
  let modulo = Stdlib.UInt128.``mod``


impl Compare for UInt128 =
  let lessThan = Stdlib.UInt128.lessThan
  let lessThanOrEqualTo = Stdlib.UInt128.lessThanOrEqualTo
  let greaterThan = Stdlib.UInt128.greaterThan
  let greaterThanOrEqualTo = Stdlib.UInt128.greaterThanOrEqualTo


impl ToString for UInt128 =
  let toString = Stdlib.UInt128.toString


impl Zero for UInt128 =
  let zero () : UInt128 = 0Z


impl One for UInt128 =
  let one () : UInt128 = 1Z


impl BitwiseAnd for UInt128 =
  let bitwiseAnd = Stdlib.UInt128.bitwiseAnd


impl BitwiseOr for UInt128 =
  let bitwiseOr = Stdlib.UInt128.bitwiseOr


impl BitwiseXor for UInt128 =
  let bitwiseXor = Stdlib.UInt128.bitwiseXor


impl BitwiseNot for UInt128 =
  let bitwiseNot = Stdlib.UInt128.bitwiseNot


impl ShiftLeft for UInt128 =
  let shiftLeft = Stdlib.UInt128.shiftLeft


impl ShiftRight for UInt128 =
  let shiftRight = Stdlib.UInt128.shiftRight
