module Darklang.Stdlib.Sqlite

/// A single SQLite cell value — the five storage classes SQLite uses.
/// A query returns rows of these so cell types survive the round-trip (in
/// particular <param Bytes> for BLOB columns like an op log's serialized blob),
/// rather than being stringified.
type Value =
  | Null
  | Int of Int64
  | Real of Float
  | Text of String
  | Bytes of Blob


/// The String of a <param Text> cell (Some), else None — pull a text column out of a row.
let asText (v: Value) : Stdlib.Option.Option<String> =
  match v with
  | Text s -> Stdlib.Option.Option.Some s
  | _ -> Stdlib.Option.Option.None

/// The Int64 of an <param Int> cell (Some), else None.
let asInt (v: Value) : Stdlib.Option.Option<Int64> =
  match v with
  | Int i -> Stdlib.Option.Option.Some i
  | _ -> Stdlib.Option.Option.None

/// The Blob of a <param Bytes> cell (Some), else None -- pull a BLOB column out of a row.
///
/// The <type Value> type carries BLOBs through the round-trip rather than stringifying
/// them, and this is how you get one back out. Without it a caller has to match the case
/// by hand, which is where a stringified blob comes from.
let asBytes (v: Value) : Stdlib.Option.Option<Blob> =
  match v with
  | Bytes b -> Stdlib.Option.Option.Some b
  | _ -> Stdlib.Option.Option.None


/// Run a statement (CREATE/INSERT/UPDATE/DELETE/DDL) against the SQLite file at
/// <param dbPath>; returns the number of rows affected. Users call this, not the
/// raw builtin.
/// Like <fn exec> but binds <param params> to @p0..@pN placeholders in <param sql>,
/// so values are never string-spliced into SQL (injection-safe). The single caller of the exec builtin —
/// <fn exec> delegates here — so the builtin keeps exactly one package reference.
let execP (dbPath: String) (sql: String) (params: List<String>) : Stdlib.Result.Result<Int, String> =
  Builtin.sqliteExec dbPath sql params

/// Run several statements against <param dbPath> in ONE transaction: either all of it lands or none
/// does.
///
/// Each entry is a statement and the parameter rows to run it for, so one statement can be run many
/// times (the bulk-insert shape). A statement with no rows runs once with no parameters.
///
/// Returns rows affected per PARAMETER ROW, in order, flattened across statements. Not a total: a
/// caller has to be able to tell a real insert from an `INSERT OR IGNORE` that deduped, and a sum
/// cannot express that.
let execBatch
  (dbPath: String)
  (statements: List<(String * List<List<String>>)>)
  : Stdlib.Result.Result<List<Int>, String> =
  Builtin.sqliteExecBatch dbPath statements


let exec (dbPath: String) (sql: String) : Stdlib.Result.Result<Int, String> =
  execP dbPath sql []

/// <fn execP> for a write the caller has no way to recover from: a failure RAISES, carrying SQLite's
/// message, rather than coming back as a Result to be dropped on the floor.
///
/// `let _ = Stdlib.Sqlite.execP ...` is the shape this exists to replace: a write whose failure goes
/// nowhere, with the caller printing "archived" or "recorded" on the strength of the call returning at
/// all. A write that fails and says nothing is worse than one that crashes, because the crash at least
/// tells you the store and your belief about it have parted ways.
///
/// Use <fn execP> when a failure is a case the caller handles. Use this when it is not.
let mustExec (dbPath: String) (sql: String) (params: List<String>) : Int =
  Builtin.unwrap (execP dbPath sql params)


/// <fn execBatch>, raising on failure. Same reasoning as <fn mustExec>.
let mustExecBatch
  (dbPath: String)
  (statements: List<(String * List<List<String>>)>)
  : List<Int> =
  Builtin.unwrap (execBatch dbPath statements)

/// Like <fn query> but binds <param params> to @p0..@pN placeholders (injection-safe). The single caller of
/// the query builtin — <fn query> delegates here.
let queryP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  : Stdlib.Result.Result<List<Dict<String, Value>>, String> =
  Builtin.sqliteQuery dbPath sql params

/// Run a SELECT against <param dbPath>; returns each row as a dict of column name
/// to a typed <type Value> (so ints/reals/blobs keep their types).
let query
  (dbPath: String)
  (sql: String)
  : Stdlib.Result.Result<List<Dict<String, Value>>, String> =
  queryP dbPath sql []


// ── convenience layer (pure Dark on top of exec/query) ──────────────────────────────────────────────
// So callers don't hand-roll the `query → match Ok [row] → Dict.get → asText` dance. Callers above this
// shouldn't have to think about rows and cells — they ask for a column, a scalar, or a field, and get a
// typed value back.

/// The text value of column <param col> in <param row>, or None if missing/non-text.
let textField (row: Dict<String, Value>) (col: String) : Stdlib.Option.Option<String> =
  match Stdlib.Dict.get row col with
  | Some v -> asText v
  | None -> Stdlib.Option.Option.None

/// The Int value of column <param col> in <param row>, or None if missing/non-int.
let intField (row: Dict<String, Value>) (col: String) : Stdlib.Option.Option<Int64> =
  match Stdlib.Dict.get row col with
  | Some v -> asInt v
  | None -> Stdlib.Option.Option.None

/// The Blob value of column <param col> in <param row>, or None if missing/non-blob.
let bytesField (row: Dict<String, Value>) (col: String) : Stdlib.Option.Option<Blob> =
  match Stdlib.Dict.get row col with
  | Some v -> asBytes v
  | None -> Stdlib.Option.Option.None

/// The first row of <param sql> (or None if it returned no rows / errored).
let queryOne (dbPath: String) (sql: String) : Stdlib.Option.Option<Dict<String, Value>> =
  match query dbPath sql with
  | Ok(row :: _) -> Stdlib.Option.Option.Some row
  | _ -> Stdlib.Option.Option.None

/// Like <fn queryOne> but with injection-safe params.
let queryOneP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  : Stdlib.Option.Option<Dict<String, Value>> =
  match queryP dbPath sql params with
  | Ok(row :: _) -> Stdlib.Option.Option.Some row
  | _ -> Stdlib.Option.Option.None

/// Column <param col> of every row of <param sql>, as a list of text (non-text/missing cells dropped).
let column (dbPath: String) (sql: String) (col: String) : List<String> =
  match query dbPath sql with
  | Ok rows -> Stdlib.List.filterMap rows (fun row -> textField row col)
  | Error _ -> []

/// The Int in column <param col> of the first row of <param sql> — e.g. a `count(*)`.
let scalarInt
  (dbPath: String)
  (sql: String)
  (col: String)
  : Stdlib.Option.Option<Int64> =
  match queryOne dbPath sql with
  | Some row -> intField row col
  | None -> Stdlib.Option.Option.None

/// Like <fn scalarInt> but with injection-safe params — e.g. a per-key lookup.
let scalarIntP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  (col: String)
  : Stdlib.Option.Option<Int64> =
  match queryOneP dbPath sql params with
  | Some row -> intField row col
  | None -> Stdlib.Option.Option.None


/// Every row of <param sql> (with <param params> bound), decoded by <param decode>;
/// rows the decoder declines are dropped, and a failed query gives []. The scaffolding
/// behind most read paths: the SQL, the params and the per-row decode stay at the
/// call site, the match around them lives here.
let rowsP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  (decode: Dict<String, Value> -> Stdlib.Option.Option<'a>)
  : List<'a> =
  match queryP dbPath sql params with
  | Ok rows -> Stdlib.List.filterMap rows decode
  | Error _ -> []

/// The raw rows of <param sql>, [] on a failed query -- for callers that hand whole
/// rows to a shared decoder rather than decoding per column at the call site.
let rowsOrEmptyP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  : List<Dict<String, Value>> =
  match queryP dbPath sql params with
  | Ok rows -> rows
  | Error _ -> []

/// <fn column> with injection-safe params.
let columnP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  (col: String)
  : List<String> =
  rowsP dbPath sql params (fun row -> textField row col)

/// <fn scalarIntP>'s text twin: the text in <param col> of the first row, or
/// <param dflt> when the query fails, returns no rows, or the cell isn't text.
let scalarTextP
  (dbPath: String)
  (sql: String)
  (params: List<String>)
  (col: String)
  (dflt: String)
  : String =
  match queryOneP dbPath sql params with
  | Some row -> textField row col |> Stdlib.Option.withDefault dflt
  | None -> dflt

/// <fn textField> with a "" default -- for decoders where a missing/non-text cell
/// reads as empty rather than as a skipped row.
let textOr (row: Dict<String, Value>) (col: String) : String =
  textField row col |> Stdlib.Option.withDefault ""

/// <fn textField> parsed as a Uuid: None on a missing/non-text cell or an id that
/// doesn't parse.
let uuidField (row: Dict<String, Value>) (col: String) : Stdlib.Option.Option<Uuid> =
  match textField row col with
  | Some s ->
    match Stdlib.Uuid.parse s with
    | Ok u -> Stdlib.Option.Option.Some u
    | Error _ -> Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None
