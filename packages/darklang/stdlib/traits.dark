module Darklang.Stdlib

// The traits the operators are. `a + b` is `Add.add a b`, and `<` and friends
// are `Compare`. Every builtin numeric type implements them (next to its own fns:
// `Stdlib.Int64.Add`), and a type of your own joins by writing an impl:
//
//   impl Add for Vec =
//     let add (a: Vec) (b: Vec) : Vec = Vec { x = a.x + b.x; y = a.y + b.y }
//
// The interpreter answers two operands of one builtin numeric type without
// looking the impl up.


/// `a + b`
trait Add<'a> =
  let add (a: 'a) (b: 'a) : 'a


/// `a - b`
trait Subtract<'a> =
  let subtract (a: 'a) (b: 'a) : 'a


/// `a * b`
trait Multiply<'a> =
  let multiply (a: 'a) (b: 'a) : 'a


/// `a / b`
trait Divide<'a> =
  let divide (a: 'a) (b: 'a) : 'a


/// `a % b`, wrapped so that `0 <= result < b`
trait Modulo<'a> =
  let modulo (a: 'a) (b: 'a) : 'a


/// `a ** b`
trait Power<'a> =
  let power (``base``: 'a) (exponent: 'a) : 'a


/// `-a`
trait Negate<'a> =
  let negate (a: 'a) : 'a


/// The identity for `+`: `Zero.zero<Int64> ()` is `0L`, and `Zero.zero<String> ()` is `""`.
/// Not only a number's zero, which is why String implements it; a List, a Dict and a Set
/// each have one too, and they are a follow-up rather than a decision against them.
/// Dispatched from an explicit type arg or the caller's bound, since there is no argument
/// to read the type from; `Stdlib.sum` takes a seed instead so an empty list never has to ask.
trait Zero<'a> =
  let zero () : 'a


/// The multiplicative identity, `One.one<Int64> ()`
trait One<'a> =
  let one () : 'a


/// A value rendered as text for a person: `p.toString`, or `ToString.toString p`.
/// Every builtin type implements it with the `toString` fn it already had;
/// `Stdlib.toRepr` stays the structural debug form.
trait ToString<'a> =
  let toString (v: 'a) : String


/// `a == b` (and `a != b`, which is its negation). Every value compares
/// structurally unless its type implements this: a record or enum that says
/// what equal means (compare ids, ignore a cache field) gets its own `==`.
/// A container asks its elements, so `[ p ] == [ q ]` uses `impl Equal for Point`
/// and agrees with `p == q`. The builtin types are never overridden, and
/// `List.member`, `List.unique`, `List.sort` and dict keys stay structural
/// whatever you implement.
trait Equal<'a> =
  let equals (a: 'a) (b: 'a) : Bool


/// `a & b`
trait BitwiseAnd<'a> =
  let bitwiseAnd (a: 'a) (b: 'a) : 'a


/// `a | b`
trait BitwiseOr<'a> =
  let bitwiseOr (a: 'a) (b: 'a) : 'a


/// `a ^ b`, exclusive or
trait BitwiseXor<'a> =
  let bitwiseXor (a: 'a) (b: 'a) : 'a


/// `~a`, every bit flipped
trait BitwiseNot<'a> =
  let bitwiseNot (a: 'a) : 'a


/// `a << b`. The shift count is the same type as the value.
trait ShiftLeft<'a> =
  let shiftLeft (a: 'a) (b: 'a) : 'a


/// `a >> b`
trait ShiftRight<'a> =
  let shiftRight (a: 'a) (b: 'a) : 'a


/// `<`, `<=`, `>`, `>=`
trait Compare<'a> =
  let lessThan (a: 'a) (b: 'a) : Bool
  let lessThanOrEqualTo (a: 'a) (b: 'a) : Bool
  let greaterThan (a: 'a) (b: 'a) : Bool
  let greaterThanOrEqualTo (a: 'a) (b: 'a) : Bool


// Written once over `Compare`, for any type with an implementation.

/// The larger of two values of any type with a `Compare` impl
let max<'a: Compare> (a: 'a) (b: 'a) : 'a = if a > b then a else b


/// The smaller of two values of any type with a `Compare` impl
let min<'a: Compare> (a: 'a) (b: 'a) : 'a = if a < b then a else b


/// The distance of <param value> from zero, for any type that can compare, negate and produce a
/// zero. `Stdlib.Float.absoluteValue` and the per-type integer ones remain, since a fixed-width
/// minimum has no positive counterpart and each type says so its own way.
let abs<'a: Compare + Negate + Zero> (value: 'a) : 'a =
  if value < Zero.zero () then -value else value


/// <param value> held between the two limits, whichever order they are given in.
///
/// On Floats, a NaN limit compares false against everything, so the value comes back
/// unclamped rather than pinned to a limit. <fn Float.clampRefusingNaN> refuses that case
/// with a Result instead; use it when a limit can be NaN and silently not clamping would be
/// the wrong answer.
let clamp<'a: Compare> (value: 'a) (limitA: 'a) (limitB: 'a) : 'a =
  let low = if limitA < limitB then limitA else limitB
  let high = if limitA > limitB then limitA else limitB
  if value < low then low
  else if value > high then high
  else value


/// <param xs> added up from <param seed>, for any type with an `Add`:
/// `Stdlib.sum 0L [ 1L, 2L ]` is `3L`, `Stdlib.sum 0L []` is `0L`. The seed
/// is what `[]` sums to, which is why it is an argument and not `Zero.zero`.
let sum<'a: Add> (seed: 'a) (xs: List<'a>) : 'a =
  Stdlib.List.fold xs seed (fun acc x -> acc + x)


/// <param xs> multiplied together from <param seed>, for any type with a `Multiply`
let product<'a: Multiply> (seed: 'a) (xs: List<'a>) : 'a =
  Stdlib.List.fold xs seed (fun acc x -> acc * x)


/// <param v> as text, for any type with a `ToString`
let toString<'a: ToString> (v: 'a) : String = ToString.toString v
