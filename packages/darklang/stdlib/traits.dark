module Darklang.Stdlib

// The traits the operators are. `a + b` is `Add.add a b`, `<` and friends are `Compare`.
// Every builtin numeric type implements them, next to its own fns (`Stdlib.Int64.Add`),
// and a type of your own joins by writing an impl:
//
//   impl Add for Vec =
//     let add (a: Vec) (b: Vec) : Vec = Vec { x = a.x + b.x; y = a.y + b.y }


/// `a + b`
trait Add<'a> =
  let add (a: 'a) (b: 'a) : 'a


/// `a - b`
trait Subtract<'a> =
  let subtract (a: 'a) (b: 'a) : 'a


/// `a * b`
trait Multiply<'a> =
  let multiply (a: 'a) (b: 'a) : 'a


/// `a / b`
trait Divide<'a> =
  let divide (a: 'a) (b: 'a) : 'a


/// `a % b`, wrapped so that `0 <= result < b`
trait Modulo<'a> =
  let modulo (a: 'a) (b: 'a) : 'a


/// `a ** b`
trait Power<'a> =
  let power (``base``: 'a) (exponent: 'a) : 'a


/// `-a`
trait Negate<'a> =
  let negate (a: 'a) : 'a


/// The identity for `+`, not only a number's: `Zero.zero<String> ()` is `""`. Dispatched from
/// a type arg or the caller's bound, there being no argument to read the type from.
trait Zero<'a> =
  let zero () : 'a


/// The multiplicative identity, `One.one<Int64> ()`
trait One<'a> =
  let one () : 'a


/// `a & b`
trait BitwiseAnd<'a> =
  let bitwiseAnd (a: 'a) (b: 'a) : 'a


/// `a | b`
trait BitwiseOr<'a> =
  let bitwiseOr (a: 'a) (b: 'a) : 'a


/// `a ^ b`, exclusive or
trait BitwiseXor<'a> =
  let bitwiseXor (a: 'a) (b: 'a) : 'a


/// `~a`, every bit flipped
trait BitwiseNot<'a> =
  let bitwiseNot (a: 'a) : 'a


/// `a << b`. The shift count is the same type as the value.
trait ShiftLeft<'a> =
  let shiftLeft (a: 'a) (b: 'a) : 'a


/// `a >> b`
trait ShiftRight<'a> =
  let shiftRight (a: 'a) (b: 'a) : 'a


/// `<`, `<=`, `>`, `>=`
trait Compare<'a> =
  let lessThan (a: 'a) (b: 'a) : Bool
  let lessThanOrEqualTo (a: 'a) (b: 'a) : Bool
  let greaterThan (a: 'a) (b: 'a) : Bool
  let greaterThanOrEqualTo (a: 'a) (b: 'a) : Bool


/// A value rendered as text for a person: `p.toString`, or `ToString.toString p`.
/// Every builtin type implements it, so `toString` works on any of them;
/// `Stdlib.toRepr` stays the structural debug form.
// CLEANUP if this splits, it splits into `ToString` for what a person reads and
// `ToDebugString` for the derived one. Nothing more elaborate.
trait ToString<'a> =
  let toString (v: 'a) : String


// Written once over the traits above, for any type that implements them.
//
// TODO: every type used to carry its own `max`, `min`, `clamp`, `sum`, `product` and
// `absoluteValue`, and those are all gone in favour of the generics below. We may want some of
// them back. The open question is discoverability rather than behaviour: somebody who knows the
// type before they know the trait reaches for `Int128.max`, does not find it, and has no obvious
// next move. Not for now; the generics are the point of the feature and seven copies of each was
// the thing worth deleting.

/// The larger of two values of any type with a `Compare` impl
let max<'a: Compare> (a: 'a) (b: 'a) : 'a = if a > b then a else b


/// The smaller of two values of any type with a `Compare` impl
let min<'a: Compare> (a: 'a) (b: 'a) : 'a = if a < b then a else b


/// The distance of <param value> from zero. A fixed-width minimum wraps back to itself, since it
/// has no positive counterpart: `abs -128y` is `-128y`.
let abs<'a: Compare + Negate + Zero> (value: 'a) : 'a =
  if value < Zero.zero () then -value else value


/// <param value> held between the two limits, whichever order they are given in. A NaN limit
/// compares false against everything, so the value comes back unclamped;
/// <fn Float.clampRefusingNaN> returns a Result instead when that is the wrong answer.
let clamp<'a: Compare> (value: 'a) (limitA: 'a) (limitB: 'a) : 'a =
  let low = if limitA < limitB then limitA else limitB
  let high = if limitA > limitB then limitA else limitB
  if value < low then low
  else if value > high then high
  else value


/// <param xs> added up from <param seed>: `Stdlib.sum 0L [ 1L, 2L ]` is `3L`. The seed is what
/// `[]` sums to, which is why it is an argument and not `Zero.zero`.
let sum<'a: Add> (seed: 'a) (xs: List<'a>) : 'a =
  Stdlib.List.fold xs seed (fun acc x -> acc + x)


/// <param xs> multiplied together from <param seed>, for any type with a `Multiply`
let product<'a: Multiply> (seed: 'a) (xs: List<'a>) : 'a =
  Stdlib.List.fold xs seed (fun acc x -> acc * x)


/// <param v> as text, for any type with a `ToString`
let toString<'a: ToString> (v: 'a) : String = ToString.toString v
