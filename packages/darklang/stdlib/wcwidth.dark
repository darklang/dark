    (129340u32, 2), (129350u32, 1), (129351u32, 2), (129536u32, 1), (129648u32, 2), (129661u32, 1),
    (129664u32, 2), (129675u32, 1), (129678u32, 2), (129735u32, 1), (129736u32, 2), (129737u32, 1),
