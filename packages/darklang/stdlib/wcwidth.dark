    (917536u32, 0), (917632u32, 1), (917760u32, 0), (918000u32, 1) ]


/// The cells one codepoint takes: 0, 1 or 2.
let codepointWidth(codepoint: UInt32): Int64 =
  __widthFrom(codepoint, 0, List.length(ranges) - 1, 0)


/// A binary search for the last range starting at or before <param codepoint>, among
/// `ranges[lo..hi]`. `ranges[lo]` always does, and <param width> is its width.
let __widthFrom(codepoint: UInt32, lo: Int64, hi: Int64, width: Int64): Int64 =
  if lo >= hi then
    width
  else
    let mid = (lo + hi + 1) / 2
    match List.getAt(ranges, mid) with
    | Some((start, midWidth)) ->
      if start <= codepoint then
        __widthFrom(codepoint, mid, hi, midWidth)
      else
        __widthFrom(codepoint, lo, mid - 1, width)
    | None -> width


/// The cells one grapheme cluster takes: its widest codepoint, except that a flag (a pair of
/// regional indicators) is wide, and so is a narrow character asking for emoji presentation with
/// U+FE0F.
let clusterWidth(cluster: String): Int64 =
  match String.toCodepoints(cluster) with
  | [ codepoint ] -> codepointWidth(codepoint)
  | codepoints ->
    let widest =
      codepoints |> List.fold(0, fun(acc, codepoint) -> max(acc, codepointWidth(codepoint)))

    let regionalIndicators =
      codepoints
      |> List.filter(fun codepoint -> codepoint >= 127462u32 && codepoint <= 127487u32)
      |> List.length

    if regionalIndicators >= 2 then 2
    else if widest == 1 && List.contains(codepoints, 65039u32) then 2
    else widest
