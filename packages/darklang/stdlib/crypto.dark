module Darklang.Stdlib.Crypto

/// A hash function for <fn Crypto.digest> and <fn Crypto.hmac>.
type DigestAlgorithm =
  | Md5
  | Sha1
  | Sha256
  | Sha384


/// Computes the <param algorithm> digest of the given <param data>
let digest(algorithm: DigestAlgorithm, data: Bytes): Bytes =
  Builtin.cryptoDigest(algorithm, data)


/// Computes the HMAC (hash-based message authentication code, RFC 2104) of <param data> under
/// <param key>, over the <param algorithm> digest.
let hmac(algorithm: DigestAlgorithm, key: Bytes, data: Bytes): Bytes =
  let size = __blockSize(algorithm)
  // A key longer than a block is hashed first; then it is zero-padded to a block.
  let short = if Bytes.length(key) > size then digest(algorithm, key) else key
  let padding = List.repeat(size - Bytes.length(short), 0u8)
  let block = Bytes.toList(Bytes.concat(short, Bytes.fromList(padding)))
  let inner = digest(algorithm, Bytes.concat(__xorEach(block, 54u8), data))
  digest(algorithm, Bytes.concat(__xorEach(block, 92u8), inner))


/// The block size of <param algorithm> in bytes, which HMAC pads its key to.
let __blockSize(algorithm: DigestAlgorithm): Int64 =
  match algorithm with
  | Md5 -> 64
  | Sha1 -> 64
  | Sha256 -> 64
  | Sha384 -> 128


/// Every byte of <param block> XORed with <param pad>.
let __xorEach(block: List<UInt8>, pad: UInt8): Bytes =
  block
  |> List.map(fun b -> b ^ pad)
  |> Bytes.fromList


/// Computes the SHA-256 digest of the given <param data>
let sha256(data: Bytes): Bytes =
  digest(DigestAlgorithm.Sha256, data)


/// Computes the SHA-384 digest of the given <param data>
let sha384(data: Bytes): Bytes =
  digest(DigestAlgorithm.Sha384, data)


/// Hashes <param text> to a cryptographically-secure digest string.
/// Do not rely on the digest's size, algorithm or encoding.
let digestText(text: String): String =
  text
  |> Utf8.encode
  |> sha384
  |> Base64.urlEncode


/// Computes the md5 digest of the given <param data>. NOTE: There are multiple security problems with md5, see https://en.wikipedia.org/wiki/MD5#Security
let md5(data: Bytes): Bytes =
  digest(DigestAlgorithm.Md5, data)


/// Computes the SHA-256 HMAC (hash-based message authentication code) digest of the given <param key> and <param data>.
let sha256hmac(key: Bytes, data: Bytes): Bytes =
  hmac(DigestAlgorithm.Sha256, key, data)


/// Computes the SHA1-HMAC (hash-based message authentication code) digest of the given <param key> and <param data>.
let sha1hmac(key: Bytes, data: Bytes): Bytes =
  hmac(DigestAlgorithm.Sha1, key, data)


/// Whether <param presented> equals <param expected>, in time that does not depend on where they first
/// differ. Use this, never `==`, to check a secret or token against what a request sent: `==` stops at
/// the first mismatch, so how long it took says how many leading characters were right.
let constantTimeEquals(presented: String, expected: String): Bool =
  Builtin.cryptoConstantTimeEquals(presented, expected)
