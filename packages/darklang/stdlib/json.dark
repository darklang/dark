module Darklang.Stdlib.Json

/// Serializes a Dark value to a JSON string.
let serialize<'a>(value: 'a): String =
  Builtin.jsonSerialize<'a>(value)

/// Parses a JSON string as a Dark value, matching the type <typeParam a>.
/// Show an error with `$"{e}"` or `Stdlib.display(e)`.
let parse<'a>(
  json: String)
  : Stdlib.Result.Result<'a, ParseError.ParseError> =
  Builtin.jsonParse<'a>(json)


module ParseError =
  module JsonPath =
    module Part =
      type Part =
        | Root
        | Index(Int64)
        | Field(String)

      let toString(part: Part): String =
        match part with
        | Root -> "root"
        | Field(name) -> "." + name
        | Index(index) -> "[" + Stdlib.display(index) + "]"

    type JsonPath = List<Part.Part>

    let toString(path: JsonPath): String =
      path |> List.reverse |> List.map(Part.toString) |> String.join("")


  type ParseError =
    /// The json string can't be parsed as the given type.
    | CantMatchWithType(
      LanguageTools.RuntimeTypes.TypeReference,
      String,
      JsonPath.JsonPath)
    | EnumExtraField(rawJson: String, JsonPath.JsonPath)
    | EnumMissingField(
      LanguageTools.RuntimeTypes.TypeReference,
      index: Int64,
      JsonPath.JsonPath)
    | EnumInvalidCasename(
      LanguageTools.RuntimeTypes.TypeReference,
      caseName: String,
      JsonPath.JsonPath)
    | EnumTooManyCases(
      LanguageTools.RuntimeTypes.TypeReference,
      cases: List<String>,
      JsonPath.JsonPath)
    | RecordDuplicateField(fieldName: String, JsonPath.JsonPath)
    | RecordMissingField(fieldName: String, JsonPath.JsonPath)
    /// A number outside the range of a type such as <type Stdlib.Net.Port>
    | OutOfRange(Stdlib.Math.OutOfRange, JsonPath.JsonPath)
    /// The text isn't JSON: the line and column where it broke, both counted
    /// from 1, the column in characters
    | NotJson(line: Int64, column: Int64)

  let toString(
    branchId: Uuid,
    e: ParseError)
    : String =
    match e with
    | CantMatchWithType(typ, json, path) ->
      "Can't parse JSON `"
      + json
      + "` as type `"
      + PrettyPrinter.RuntimeTypes.typeReference(branchId, typ)
      + "` at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON due to an extra argument `2.0` at path: `root.Enh[2]`
    | EnumExtraField(rawJson, path) ->
      "Can't parse JSON due to an extra argument `"
      + rawJson
      + "` at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON because argument 4 (`Int64`) is missing at path: `root.Enh`
    | EnumMissingField(typ, index, path) ->
      "Can't parse JSON because argument "
      + Stdlib.display(index)
      + " (`"
      + PrettyPrinter.RuntimeTypes.typeReference(branchId, typ)
      + "`) is missing at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON as `Wrong` is not a known case of type `PrettyLikely` at path: `root`
    | EnumInvalidCasename(typ, caseName, path) ->
      "Can't parse JSON as `"
      + caseName
      + "` is not a known case of type `"
      + PrettyPrinter.RuntimeTypes.typeReference(branchId, typ)
      + "` at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON with multiple fields (`Enh` and `Extra`) as type `PrettyLikely` at path: `root`
    | EnumTooManyCases(typ, cases, path) ->
      let cases = cases |> List.map(fun c -> $"`{c}`") |> String.join(", ")

      $"Can't parse JSON with multiple fields ({cases}) as type `"
      + PrettyPrinter.RuntimeTypes.typeReference(branchId, typ)
      + "` at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON because `Name` field is not provided at path: `root`
    | RecordMissingField(fieldName, path) ->
      "Can't parse JSON because `"
      + fieldName
      + "` field is not provided at path: `"
      + JsonPath.toString(path)
      + "`"


    // Can't parse JSON because `Age` is defined more than once at path: `root`
    | RecordDuplicateField(fieldName, path) ->
      "Can't parse JSON because `"
      + fieldName
      + "` is defined more than once at path: `"
      + JsonPath.toString(path)
      + "`"

    // Can't parse JSON: 70000 is not a valid port (0 to 65535) at path: `root.port`
    | OutOfRange(range, path) ->
      $"Can't parse JSON: {range} at path: `"
      + JsonPath.toString(path)
      + "`"

    // Not JSON at line 1, column 4
    | NotJson(line, column) ->
      "Not JSON at line "
      + Stdlib.display(line)
      + ", column "
      + Stdlib.display(column)


  impl Display for ParseError =
    /// What went wrong, with types named as the current branch sees them:
    /// {{Can't parse JSON `"x"` as type `Int64` at path: `root.age`}}
    let display(e: ParseError): String =
      Stdlib.Json.ParseError.toString(Darklang.SCM.Branches.current(), e)
