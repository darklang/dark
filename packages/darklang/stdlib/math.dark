module Darklang.Stdlib.Math


/// Returns an approximation for the mathematical constant {{π}},
/// the ratio of a circle's circumference to its diameter.
val pi = 3.141592653589793


/// Returns an approximation for the mathematical constant {{τ}}, the number of
/// radians in one turn. Equivalent to {{Stdlib.Math.pi * 2.0}}.
val tau = 6.283185307179586


/// An approximation of Euler's number, the base of the natural logarithm.
val e = 2.718281828459045


/// Returns the equivalent of <param angleInDegrees> in radians, the unit used
/// by all of Dark's trigonometry functions.
let degrees(angleInDegrees: Float): Float =
  (angleInDegrees * Stdlib.Math.pi)
  |> (fun v -> v / 180.0)


/// Returns the equivalent of <param angleInTurns> in radians, the unit used by all of
/// Dark's trigonometry functions.
let turns(angleInTurns: Float): Float =
  Stdlib.Math.tau * angleInTurns


/// Returns <param angleInRadians> in radians, the unit used by all of Dark's
/// trigonometry functions.
/// There are {{2.0 * Stdlib.Math.pi}} radians in a circle.
let radians(angleInRadians: Float): Float = angleInRadians


/// <fn Math.degrees>, or {{Error Overflow}} where the result is not finite
let checkedDegrees(angleInDegrees: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  Stdlib.Float.__noOverflow(degrees(angleInDegrees))


/// <fn Math.turns>, or {{Error Overflow}} where the result is not finite
let checkedTurns(angleInTurns: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  Stdlib.Float.__noOverflow(turns(angleInTurns))


/// Returns the cosine of the given <param angleInRadians>.
/// One interpretation of the result relates to a right triangle: the cosine is
/// the ratio of the lengths of the side adjacent to the angle and the hypotenuse.
let cos(angleInRadians: Float): Float = Builtin.mathCos(angleInRadians)


/// Returns the sine of the given <param angleInRadians>.
/// One interpretation of the result relates to a right triangle: the sine is
/// the ratio of the lengths of the side opposite the angle and the hypotenuse
let sin(angleInRadians: Float): Float = Builtin.mathSin(angleInRadians)


/// Returns the tangent of the given <param angleInRadians>.
/// One interpretation of the result relates to a right triangle: the tangent is
/// the ratio of the lengths of the side opposite the angle and the side
/// adjacent to the angle.
let tan(angleInRadians: Float): Float = Builtin.mathTan(angleInRadians)


/// Returns the arc cosine of <param ratio>, as an <type Option>.
/// If <param ratio> is in the inclusive range {{[-1.0, 1.0]}}, returns {{Some
/// result}} where <var result> is in radians and is between {{0.0}} and <fn
/// Math.pi>. Otherwise, returns {{None}}.
/// This function is the inverse of <fn Math.cos>.
let acos(ratio: Float): Stdlib.Option.Option<Float> = Builtin.mathAcos(ratio)


/// Returns the arc sine of <param ratio>, as an <type Option>.
/// If <param ratio> is in the inclusive range {{[-1.0, 1.0]}}, returns {{Some
/// result}} where <var result> is in radians and is between {{-Math.pi/2}} and
/// {{Math.pi/2}}. Otherwise, returns {{None}}.
/// This function is the inverse of <fn Math.sin>.
let asin(ratio: Float): Stdlib.Option.Option<Float> = Builtin.mathAsin(ratio)


/// Returns the arc tangent of <param ratio>. The result is in radians and is between
/// {{-Math.pi/2}} and {{Math.pi/2}}.
/// This function is the inverse of <fn Math.tan>. Use <fn Math.atan2> to expand the
/// output range, if you know the numerator and denominator of <param ratio>.
let atan(ratio: Float): Float = Builtin.mathAtan(ratio)


/// Returns the arc tangent of {{y / x}}, using the signs of <param y> and
/// <param x> to determine the quadrant of the result.
/// The result is in radians and is between {{-Math.pi}} and {{Math.pi}}.
/// Consider <fn Math.atan> if you know the value of {{y / x}} but not the
/// individual values <param x> and <param y>.
let atan2(y: Float, x: Float): Float = Builtin.mathAtan2(y, x)


/// Returns the hyperbolic cosine of <param angleInRadians>
let cosh(angleInRadians: Float): Float = Builtin.mathCosh(angleInRadians)


/// Returns the hyperbolic sine of <param angleInRadians>
let sinh(angleInRadians: Float): Float = Builtin.mathSinh(angleInRadians)


/// Returns the hyperbolic tangent of <param angleInRadians>
let tanh(angleInRadians: Float): Float = Builtin.mathTanh(angleInRadians)


/// <fn Math.cosh>, or {{Error Overflow}} where the result is not finite
let checkedCosh(angleInRadians: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  Stdlib.Float.__noOverflow(cosh(angleInRadians))


/// <fn Math.sinh>, or {{Error Overflow}} where the result is not finite
let checkedSinh(angleInRadians: Float): Stdlib.Result.Result<Float, Stdlib.Math.Overflow> =
  Stdlib.Float.__noOverflow(sinh(angleInRadians))


/// What a fixed-width `checked` function returns where the operator would wrap:
/// `Int8.checkedAdd(127s8, 1s8)` is {{Error Overflow}}. Going below 0 on an unsigned
/// type is an Overflow too. <type BigInt> itself never overflows.
type Overflow = | Overflow


/// What `checkedDivide` and `checkedRemainder` return, for every integer type and
/// <type Decimal>, where `/` raises. {{Overflow}} is a signed type's minimum divided
/// by -1, as in `Int8.checkedDivide(-128s8, -1s8)`, where `/` wraps.
type DivisionError =
  | DivisionByZero
  | Overflow


/// What `checkedMod` returns, for every integer type and <type Decimal>, where `%` raises:
/// the modulus must be greater than 0
type ModulusError =
  | ZeroModulus
  | NegativeModulus


/// What `checkedPower` returns, for every integer type, where `**` raises on a
/// negative exponent or wraps on overflow. <type BigInt> never overflows; it returns
/// {{ResultTooLarge}} instead of computing a result past 1 MB.
type PowerError =
  | NegativeExponent
  | Overflow
  | ResultTooLarge


/// What a <type Float> or <type Float32> `checked` function returns where its plain
/// version gives NaN or an infinity
type NonFinite =
  /// The result is too large for the type
  | Overflow
  /// The divisor, or the base of a negative power, is zero
  | DivisionByZero
  /// The result is NaN, as for the square root of a negative number
  | NotANumber


/// What a smart constructor such as `Net.Port.fromInt64` returns for a number outside its
/// range: <param value> was given, and a <param what> runs from <param min> to <param max>.
type OutOfRange =
  { what: String
    value: Int64
    min: Int64
    max: Int64 }


impl ToString for OutOfRange =
  /// {{65536 is not a valid port (0 to 65535)}}
  let toString(e: OutOfRange): String =
    $"{e.value} is not a valid {e.what} ({e.min} to {e.max})"


/// Returns {{Ok}} of <param make> applied to <param value> when it lies between <param min>
/// and <param max> inclusive, or {{Error}} an <type OutOfRange> naming <param what>. The body of
/// every `fromInt64` smart constructor.
let __inRange(
  what: String,
  min: Int64,
  max: Int64,
  value: Int64,
  make: Int64 -> 'a)
  : Stdlib.Result.Result<'a, OutOfRange> =
  if value < min || value > max then
    Stdlib.Result.Result.Error(
      OutOfRange { what = what, value = value, min = min, max = max })
  else
    Stdlib.Result.Result.Ok(make(value))
