module Darklang.Stdlib.Exec

/// The process table: what is running in this instance right now, as data. `dark ps` renders
/// it. Every process is a wrapped VM the scheduler steps (`docs/processes.md`); these are
/// copies taken on the scheduler thread, never references into a running VM.
///
/// `spawn`/`await`/`demand` for user code are not here yet: they are the implicit-reads
/// follow-up. Today the CLI's top level, each `eval` expression and each `apps` daemon are
/// the processes you will see.

/// What a process was started on.
type Entry =
  | Function of LanguageTools.RuntimeTypes.FQFnName.FQFnName
  | Expr


/// What a parked process is waiting for.
type ParkedOn =
  /// A builtin that had to wait: `sleep`, an HTTP call, the script an `eval` runs.
  | Builtin of LanguageTools.RuntimeTypes.FQFnName.Builtin
  /// A package function call that had to wait.
  | PackageFn of LanguageTools.RuntimeTypes.FQFnName.Package
  /// A lambda application that had to wait.
  | Lambda
  /// The interpreter waiting on the store for a type or value.
  | RareOpcode
  /// `Host.await`: one of these.
  | Events of List<Stdlib.Host.EventSpec>


type Status =
  | Runnable
  | Parked of ParkedOn
  | Done
  | Failed of LanguageTools.RuntimeTypes.RuntimeError.Error


type Summary =
  { id: Uuid
    entry: Entry
    status: Status
    /// The process that spawned this one, if any (an `eval` expression's is the CLI's).
    parent: Stdlib.Option.Option<Uuid>
    started: DateTime
    /// How many slices of the instruction budget it has used.
    slices: Int64 }


/// One activation on a process's stack.
type ExecutionPoint =
  | Source
  | Function of LanguageTools.RuntimeTypes.FQFnName.FQFnName
  | Lambda of parent: ExecutionPoint * exprId: Int64


type Detail =
  { summary: Summary
    /// The call stack at the moment of the snapshot, outermost first. A process parked
    /// inside a higher-order builtin (`List.map f` where `f` waits) shows the frame that
    /// called the builtin; the lambda's own frames are in a nested VM until the
    /// re-entry-removal follow-up.
    frames: List<ExecutionPoint> }


/// Every process this instance's scheduler knows, finished ones included.
let list () : List<Summary> =
  Builtin.execList ()


/// One process in detail, or `None` for an id nobody has.
let inspect (id: Uuid) : Stdlib.Option.Option<Detail> =
  Builtin.execInspect id


/// Ask a process to stop. It fails with "cancelled" at its next turn. False for an id nobody
/// has.
let kill (id: Uuid) : Bool =
  Builtin.execKill id
