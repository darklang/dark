module Darklang.Stdlib.Int32


type ParseError =
  | BadFormat
  | OutOfRange


impl Modulo for Int32 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0
  /// Use <fn Int32.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  let modulo(a: Int32, b: Int32): Int32 = Builtin.int32Mod(a, b)


/// Returns the integer remainder left over after dividing <param value> by
/// <param divisor>, as a <type Result>.
/// For example, {{Int32.remainder 15 6 == Ok 3}}. The remainder will be
/// negative only if {{<var value> < 0}}.
/// The sign of <param divisor> doesn't influence the outcome.
/// Returns an {{Error}} if <param divisor> is {{0}}.
let remainder(
  value: Int32,
  divisor: Int32)
  : Stdlib.Result.Result<Int32, String> =
  Builtin.int32Remainder(value, divisor)


impl Add for Int32 =
  /// Adds two integers together (wraps on overflow)
  let add(a: Int32, b: Int32): Int32 = Builtin.int32Add(a, b)


impl Subtract for Int32 =
  /// Subtracts two integers (wraps on overflow)
  let subtract(a: Int32, b: Int32): Int32 = Builtin.int32Subtract(a, b)


impl Multiply for Int32 =
  /// Multiplies two integers (wraps on overflow)
  let multiply(a: Int32, b: Int32): Int32 = Builtin.int32Multiply(a, b)


impl Divide for Int32 =
  /// Divides two integers
  let divide(a: Int32, b: Int32): Int32 = Builtin.int32Divide(a, b)


impl Power for Int32 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  /// Raises an error if <param exponent> is negative.
  let power(``base``: Int32, exponent: Int32): Int32 =
    Builtin.int32Power(``base``, exponent)


impl Negate for Int32 =
  /// Returns the negation of <param a>, {{-a}}. Negating the minimum value wraps back to itself.
  let negate(a: Int32): Int32 = Builtin.int32Negate(a)


impl Compare for Int32 =
  /// Returns {{true}} if <param a> is less than <param b>
  let lessThan(a: Int32, b: Int32): Bool = Builtin.int32LessThan(a, b)
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  let lessThanOrEqualTo(a: Int32, b: Int32): Bool =
    Builtin.int32LessThanOrEqualTo(a, b)
  /// Returns {{true}} if <param a> is greater than <param b>
  let greaterThan(a: Int32, b: Int32): Bool = Builtin.int32GreaterThan(a, b)
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  let greaterThanOrEqualTo(a: Int32, b: Int32): Bool =
    Builtin.int32GreaterThanOrEqualTo(a, b)


/// Returns a random integer between <param start> and <param end> (inclusive)
let random(start: Int32, ``end``: Int32): Int32 =
  Stdlib.Int.random(Stdlib.Int.fromInt32(start), Stdlib.Int.fromInt32(``end``))
  |> Stdlib.Int.toInt32
  |> Builtin.unwrap


/// Get the square root of an <type Int32>
let sqrt(a: Int32): Float = Builtin.int32Sqrt(a)


/// Converts an <type Int32> to a <type Float>
let toFloat(a: Int32): Float = Builtin.int32ToFloat(a)


/// Parses a <type String> into an <type Int32>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type Int32> range).
let parse(s: String): Stdlib.Result.Result<Int32, Stdlib.Int32.ParseError> =
  match Stdlib.Int.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.Int.toInt32(n), Stdlib.Int32.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.Int32.ParseError.BadFormat)


/// Converts an <type Int8> to a <type Int32>.
let fromInt8(i: Int8): Int32 =
  Stdlib.Int.toInt32(Stdlib.Int.fromInt8(i)) |> Builtin.unwrap


/// Converts a <type UInt8> to a <type Int32>.
let fromUInt8(i: UInt8): Int32 =
  Stdlib.Int.toInt32(Stdlib.Int.fromUInt8(i)) |> Builtin.unwrap


/// Converts an <type Int16> to a <type Int32>.
let fromInt16(i: Int16): Int32 =
  Stdlib.Int.toInt32(Stdlib.Int.fromInt16(i)) |> Builtin.unwrap


/// Converts a <type UInt16> to a <type Int32>.
let fromUInt16(i: UInt16): Int32 =
  Stdlib.Int.toInt32(Stdlib.Int.fromUInt16(i)) |> Builtin.unwrap


/// Converts a <type UInt32> to a <type Int32>. Returns {{None}} if the value is greater than 2147483647.
let fromUInt32(i: UInt32): Stdlib.Option.Option<Int32> =
  Stdlib.Int.toInt32(Stdlib.Int.fromUInt32(i))


/// Converts an <type Int64> to a <type Int32>. Returns {{None}} if the value is less than -2147483648 or greater than 2147483647.
let fromInt64(i: Int64): Stdlib.Option.Option<Int32> =
  Stdlib.Int.toInt32(Stdlib.Int.fromInt64(i))


/// Converts a <type UInt64> to a <type Int32>. Returns {{None}} if the value is greater than 2147483647.
let fromUInt64(i: UInt64): Stdlib.Option.Option<Int32> =
  Stdlib.Int.toInt32(Stdlib.Int.fromUInt64(i))


/// Converts an <type Int128> to a <type Int32>. Returns {{None}} if the value is less than -2147483648 or greater than 2147483647.
let fromInt128(i: Int128): Stdlib.Option.Option<Int32> =
  Stdlib.Int.toInt32(Stdlib.Int.fromInt128(i))


/// Converts a <type UInt128> to a <type Int32>. Returns {{None}} if the value is greater than 2147483647.
let fromUInt128(i: UInt128): Stdlib.Option.Option<Int32> =
  Stdlib.Int.toInt32(Stdlib.Int.fromUInt128(i))


impl BitwiseAnd for Int32 =
  /// Bitwise AND on two <type Int32> values
  let bitwiseAnd(a: Int32, b: Int32): Int32 = Builtin.int32BitwiseAnd(a, b)


impl BitwiseOr for Int32 =
  /// Bitwise OR on two <type Int32> values
  let bitwiseOr(a: Int32, b: Int32): Int32 = Builtin.int32BitwiseOr(a, b)


impl BitwiseXor for Int32 =
  /// Bitwise XOR on two <type Int32> values
  let bitwiseXor(a: Int32, b: Int32): Int32 = Builtin.int32BitwiseXor(a, b)


impl BitwiseNot for Int32 =
  /// Bitwise NOT on an <type Int32> value
  let bitwiseNot(a: Int32): Int32 = Builtin.int32BitwiseNot(a)


impl ShiftLeft for Int32 =
  /// Bitwise left shift of an <type Int32> value
  let shiftLeft(a: Int32, b: Int32): Int32 = Builtin.int32ShiftLeft(a, b)


impl ShiftRight for Int32 =
  /// Bitwise right shift of an <type Int32> value
  let shiftRight(a: Int32, b: Int32): Int32 = Builtin.int32ShiftRight(a, b)

impl ToString for Int32 =
  /// Stringify <param int>
  let toString(int: Int32): String = Builtin.int32ToString(int)

impl Zero for Int32 =
  let zero(): Int32 = 0l

impl One for Int32 =
  let one(): Int32 = 1l


// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: Int32,
  b: Int32)
  : Stdlib.Result.Result<Int32, Stdlib.Int.Overflow> =
  let sum = a + b
  let wrapped = if b < 0l then sum > a else sum < a
  if wrapped then Error(Stdlib.Int.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: Int32,
  b: Int32)
  : Stdlib.Result.Result<Int32, Stdlib.Int.Overflow> =
  let difference = a - b
  let wrapped = if b < 0l then difference < a else difference > a
  if wrapped then Error(Stdlib.Int.Overflow.Overflow) else Ok(difference)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: Int32,
  b: Int32)
  : Stdlib.Result.Result<Int32, Stdlib.Int.Overflow> =
  let product = Stdlib.Int.fromInt32(a) * Stdlib.Int.fromInt32(b)
  match Stdlib.Int.toInt32(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Int.Overflow.Overflow)


/// The negation of <param a>, or {{Error Overflow}} for the minimum value,
/// which `-` wraps back to itself
let checkedNegate(a: Int32): Stdlib.Result.Result<Int32, Stdlib.Int.Overflow> =
  if a == -2147483648l then Error(Stdlib.Int.Overflow.Overflow) else Ok(-a)


/// The distance of <param a> from zero, or {{Error Overflow}} for the minimum
/// value, which <fn Stdlib.abs> wraps back to itself
let checkedAbsoluteValue(a: Int32)
  : Stdlib.Result.Result<Int32, Stdlib.Int.Overflow> =
  if a == -2147483648l then
    Error(Stdlib.Int.Overflow.Overflow)
  else if a < 0l then
    Ok(-a)
  else
    Ok(a)
