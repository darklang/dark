module Darklang.Stdlib.UInt8


type ParseError =
  | BadFormat
  | OutOfRange


impl Modulo for UInt8 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  let modulo(a: UInt8, b: UInt8): UInt8 = Builtin.modulo(a, b)


impl Add for UInt8 =
  /// Adds two 8-bit unsigned integers together (wraps on overflow)
  let add(a: UInt8, b: UInt8): UInt8 = Builtin.add(a, b)


impl Subtract for UInt8 =
  /// Subtracts two 8-bit unsigned  integers (wraps on overflow)
  let subtract(a: UInt8, b: UInt8): UInt8 = Builtin.subtract(a, b)


impl Multiply for UInt8 =
  /// Multiplies two 8-bit unsigned  integers (wraps on overflow)
  let multiply(a: UInt8, b: UInt8): UInt8 = Builtin.multiply(a, b)


impl Power for UInt8 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  let power(``base``: UInt8, exponent: UInt8): UInt8 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0u8 && exponent == 0u8 then 1u8
    else if ``base`` == 0u8 then 0u8
    else if ``base`` == 1u8 then 1u8
    else Builtin.power(``base``, exponent)


impl Divide for UInt8 =
  /// Divides two 8-bit unsigned  integers
  let divide(a: UInt8, b: UInt8): UInt8 = Builtin.divide(a, b)


impl Compare for UInt8 =
  /// Returns {{true}} if <param a> is less than <param b>
  let lessThan(a: UInt8, b: UInt8): Bool = Builtin.lessThan(a, b)
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  let lessThanOrEqualTo(a: UInt8, b: UInt8): Bool =
    Builtin.lessThanOrEqualTo(a, b)
  /// Returns {{true}} if <param a> is greater than <param b>
  let greaterThan(a: UInt8, b: UInt8): Bool = Builtin.greaterThan(a, b)
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  let greaterThanOrEqualTo(a: UInt8, b: UInt8): Bool =
    Builtin.greaterThanOrEqualTo(a, b)


/// Returns a random 8 bit unsigned integer between <param start> and <param end> (inclusive)
let random(start: UInt8, ``end``: UInt8): UInt8 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromUInt8(start), Stdlib.BigInt.fromUInt8(``end``))
  |> Stdlib.BigInt.toUInt8
  |> Builtin.unwrap


/// Get the square root of an <type UInt8>
let sqrt(a: UInt8): Float = Stdlib.Float.sqrt(Stdlib.UInt8.toFloat(a))


/// Converts a <type UInt8> to a <type Float>
let toFloat(a: UInt8): Float = Builtin.uint8ToFloat(a)


/// Parses a <type String> into a <type UInt8>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt8> range).
let parse(s: String): Stdlib.Result.Result<UInt8, Stdlib.UInt8.ParseError> =
  match Stdlib.BigInt.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.BigInt.toUInt8(n), Stdlib.UInt8.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.UInt8.ParseError.BadFormat)


/// Converts an <type Int8> to a <type UInt8>. Returns {{None}} if the value is less than 0.
let fromInt8(i: Int8): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromInt8(i))


/// Converts an <type Int16> to a <type UInt8>. Returns {{None}} if the value is less than 0 or greater than 255.
let fromInt16(i: Int16): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromInt16(i))


/// Converts a <type UInt16> to a <type UInt8>. Returns {{None}} if the value is greater than 255.
let fromUInt16(i: UInt16): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromUInt16(i))


/// Converts an <type Int32> to a <type UInt8>. Returns {{None}} if the value is less than 0 or greater than 255.
let fromInt32(i: Int32): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromInt32(i))


/// Converts a <type UInt32> to a <type UInt8>. Returns {{None}} if the value is greater than 255.
let fromUInt32(i: UInt32): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromUInt32(i))


/// Converts an <type Int64> to a <type UInt8>. Returns {{None}} if the value is less than 0 or greater than 255.
let fromInt64(i: Int64): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromInt64(i))


/// Converts a <type UInt64> to a <type UInt8>. Returns {{None}} if the value is greater than 255.
let fromUInt64(i: UInt64): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromUInt64(i))


/// Converts an <type Int128> to a <type UInt8>. Returns {{None}} if the value is less than 0 or greater than 255.
let fromInt128(i: Int128): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromInt128(i))


/// Converts a <type UInt128> to a <type UInt8>. Returns {{None}} if the value is greater than 255.
let fromUInt128(i: UInt128): Stdlib.Option.Option<UInt8> =
  Stdlib.BigInt.toUInt8(Stdlib.BigInt.fromUInt128(i))


impl BitwiseAnd for UInt8 =
  /// Bitwise AND on two <type UInt8> values
  let bitwiseAnd(a: UInt8, b: UInt8): UInt8 = Builtin.bitwiseAnd(a, b)


impl BitwiseOr for UInt8 =
  /// Bitwise OR on two <type UInt8> values
  let bitwiseOr(a: UInt8, b: UInt8): UInt8 = Builtin.bitwiseOr(a, b)


impl BitwiseXor for UInt8 =
  /// Bitwise XOR on two <type UInt8> values
  let bitwiseXor(a: UInt8, b: UInt8): UInt8 = Builtin.bitwiseXor(a, b)


impl BitwiseNot for UInt8 =
  /// Bitwise NOT on a <type UInt8> value
  let bitwiseNot(a: UInt8): UInt8 = Builtin.bitwiseNot(a)


impl ShiftLeft for UInt8 =
  /// Bitwise left shift of a <type UInt8> value
  let shiftLeft(a: UInt8, b: UInt8): UInt8 = Builtin.shiftLeft(a, b)


impl ShiftRight for UInt8 =
  /// Bitwise right shift of a <type UInt8> value
  let shiftRight(a: UInt8, b: UInt8): UInt8 = Builtin.shiftRight(a, b)

impl Display for UInt8 =
  /// Stringify <param Uint8>
  let display(uint8: UInt8): String = Builtin.uint8ToString(uint8)

impl Zero for UInt8 =
  let zero(): UInt8 = 0u8

impl One for UInt8 =
  let one(): UInt8 = 1u8


// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: UInt8,
  b: UInt8)
  : Stdlib.Result.Result<UInt8, Stdlib.Math.Overflow> =
  let sum = a + b
  if sum < a then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: UInt8,
  b: UInt8)
  : Stdlib.Result.Result<UInt8, Stdlib.Math.Overflow> =
  if b > a then Error(Stdlib.Math.Overflow.Overflow) else Ok(a - b)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: UInt8,
  b: UInt8)
  : Stdlib.Result.Result<UInt8, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromUInt8(a) * Stdlib.BigInt.fromUInt8(b)
  match Stdlib.BigInt.toUInt8(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>: {{Ok 0}} for 0, and {{Error Overflow}} for
/// anything else, which has no unsigned negation
let checkedNegate(a: UInt8): Stdlib.Result.Result<UInt8, Stdlib.Math.Overflow> =
  if a == 0u8 then Ok(a) else Error(Stdlib.Math.Overflow.Overflow)


/// The distance of <param a> from zero, which for an unsigned value is always
/// <param a> itself. Here so every fixed-width type has the same checked set.
let checkedAbsoluteValue(a: UInt8)
  : Stdlib.Result.Result<UInt8, Stdlib.Math.Overflow> =
  Ok(a)


/// <param base> raised to the power of <param exponent>, or {{Error Overflow}}
/// where `**` would wrap
let checkedPower(
  ``base``: UInt8,
  exponent: UInt8)
  : Stdlib.Result.Result<UInt8, Stdlib.Math.PowerError> =
  if ``base`` == 0u8 || ``base`` == 1u8 then
    // 0 and 1 never grow, so `**` is exact whatever the exponent
    Ok(``base`` ** exponent)
  else if exponent >= 8u8 then
    // any other base is at least 2 from zero, and 2 ** 8 is past the UInt8 range
    Error(Stdlib.Math.PowerError.Overflow)
  else
    let result = Stdlib.BigInt.fromUInt8(``base``) ** Stdlib.BigInt.fromUInt8(exponent)

    match Stdlib.BigInt.toUInt8(result) with
    | Some(fits) -> Ok(fits)
    | None -> Error(Stdlib.Math.PowerError.Overflow)


// Division. `/` raises on a zero divisor and `%` on a modulus that is not positive;
// these return the reason instead.
// TODO: make `/` and `%` themselves checked by default; see the TODO on the `divide`
// builtin in NoModule.fs.

/// Divides <param a> by <param b>, rounding towards zero, or
/// {{Error DivisionByZero}} where `/` raises.
let checkedDivide(a: UInt8, b: UInt8): Stdlib.Result.Result<UInt8, Stdlib.Math.DivisionError> =
  if b == 0u8 then Error(Stdlib.Math.DivisionError.DivisionByZero) else Ok(a / b)


/// <param a> wrapped around so that {{0 <= res < b}}, or {{Error ZeroModulus}}
/// where `%` raises
let checkedMod(a: UInt8, b: UInt8): Stdlib.Result.Result<UInt8, Stdlib.Math.ModulusError> =
  if b == 0u8 then Error(Stdlib.Math.ModulusError.ZeroModulus) else Ok(a % b)
