module Darklang.Stdlib.Int128


type ParseError =
  | BadFormat
  | OutOfRange


impl Modulo for Int128 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn Int128.remainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  let modulo(a: Int128, b: Int128): Int128 = Builtin.int128Mod(a, b)


/// Returns the integer remainder left over after dividing <param value> by
/// <param divisor>, as a <type Result>.
/// For example, {{Int128.remainder 15 6 == Ok 3}}. The remainder will be
/// negative only if {{<var value> < 0}}.
/// The sign of <param divisor> doesn't influence the outcome.
/// Returns an {{Error}} if <param divisor> is {{0}}.
let remainder(
  value: Int128,
  divisor: Int128)
  : Stdlib.Result.Result<Int128, String> =
  Builtin.int128Remainder(value, divisor)


impl Add for Int128 =
  /// Adds two 128-bit signed integers together (wraps on overflow)
  let add(a: Int128, b: Int128): Int128 = Builtin.int128Add(a, b)


impl Subtract for Int128 =
  /// Subtracts two 128-bit signed integers (wraps on overflow)
  let subtract(a: Int128, b: Int128): Int128 = Builtin.int128Subtract(a, b)


impl Multiply for Int128 =
  /// Multiplies two 128-bit signed integers (wraps on overflow)
  let multiply(a: Int128, b: Int128): Int128 = Builtin.int128Multiply(a, b)


impl Divide for Int128 =
  /// Divides two 128-bit signed integers
  let divide(a: Int128, b: Int128): Int128 = Builtin.int128Divide(a, b)


impl Power for Int128 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  /// Raises an error if <param exponent> is negative.
  let power(``base``: Int128, exponent: Int128): Int128 =
    Builtin.int128Power(``base``, exponent)


impl Negate for Int128 =
  /// Returns the negation of <param a>, {{-a}}. Negating the minimum value wraps back to itself.
  let negate(a: Int128): Int128 = Builtin.int128Negate(a)


impl Compare for Int128 =
  /// Returns {{true}} if <param a> is less than <param b>
  let lessThan(a: Int128, b: Int128): Bool = Builtin.int128LessThan(a, b)
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  let lessThanOrEqualTo(a: Int128, b: Int128): Bool =
    Builtin.int128LessThanOrEqualTo(a, b)
  /// Returns {{true}} if <param a> is greater than <param b>
  let greaterThan(a: Int128, b: Int128): Bool = Builtin.int128GreaterThan(a, b)
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  let greaterThanOrEqualTo(a: Int128, b: Int128): Bool =
    Builtin.int128GreaterThanOrEqualTo(a, b)


/// Get the square root of an <type Int128>
let sqrt(a: Int128): Float = Builtin.int128Sqrt(a)


/// Converts an <type Int128> to a <type Float>
let toFloat(a: Int128): Float = Builtin.int128ToFloat(a)


/// Parses a <type String> into an <type Int128>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type Int128> range).
let parse(
  s: String)
  : Stdlib.Result.Result<Int128, Stdlib.Int128.ParseError> =
  match Stdlib.BigInt.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.BigInt.toInt128(n), Stdlib.Int128.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.Int128.ParseError.BadFormat)


/// Converts an <type Int8> to an <type Int128>.
let fromInt8(i: Int8): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromInt8(i)) |> Builtin.unwrap


/// Converts a <type UInt8> to an <type Int128>.
let fromUInt8(i: UInt8): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromUInt8(i)) |> Builtin.unwrap


/// Converts an <type Int16> to an <type Int128>.
let fromInt16(i: Int16): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromInt16(i)) |> Builtin.unwrap


/// Converts a <type UInt16> to an <type Int128>.
let fromUInt16(i: UInt16): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromUInt16(i)) |> Builtin.unwrap


/// Converts an <type Int32> to an <type Int128>.
let fromInt32(i: Int32): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromInt32(i)) |> Builtin.unwrap


/// Converts a <type UInt32> to an <type Int128>.
let fromUInt32(i: UInt32): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromUInt32(i)) |> Builtin.unwrap


/// Converts an <type Int64> to an <type Int128>.
let fromInt64(i: Int64): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromInt64(i)) |> Builtin.unwrap


/// Converts a <type UInt64> to an <type Int128>.
let fromUInt64(i: UInt64): Int128 =
  Stdlib.BigInt.toInt128(Stdlib.BigInt.fromUInt64(i)) |> Builtin.unwrap


impl BitwiseAnd for Int128 =
  /// Bitwise AND on two <type Int128> values
  let bitwiseAnd(a: Int128, b: Int128): Int128 = Builtin.int128BitwiseAnd(a, b)


impl BitwiseOr for Int128 =
  /// Bitwise OR on two <type Int128> values
  let bitwiseOr(a: Int128, b: Int128): Int128 = Builtin.int128BitwiseOr(a, b)


impl BitwiseXor for Int128 =
  /// Bitwise XOR on two <type Int128> values
  let bitwiseXor(a: Int128, b: Int128): Int128 = Builtin.int128BitwiseXor(a, b)


impl BitwiseNot for Int128 =
  /// Bitwise NOT on an <type Int128> value
  let bitwiseNot(a: Int128): Int128 = Builtin.int128BitwiseNot(a)


impl ShiftLeft for Int128 =
  /// Bitwise left shift of an <type Int128> value
  let shiftLeft(a: Int128, b: Int128): Int128 = Builtin.int128ShiftLeft(a, b)


impl ShiftRight for Int128 =
  /// Bitwise right shift of an <type Int128> value
  let shiftRight(a: Int128, b: Int128): Int128 = Builtin.int128ShiftRight(a, b)

impl ToString for Int128 =
  /// Stringify <param int128>
  let toString(int128: Int128): String = Builtin.int128ToString(int128)

impl Zero for Int128 =
  let zero(): Int128 = 0s128

impl One for Int128 =
  let one(): Int128 = 1s128


// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: Int128,
  b: Int128)
  : Stdlib.Result.Result<Int128, Stdlib.Math.Overflow> =
  let sum = a + b
  let wrapped = if b < 0s128 then sum > a else sum < a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: Int128,
  b: Int128)
  : Stdlib.Result.Result<Int128, Stdlib.Math.Overflow> =
  let difference = a - b
  let wrapped = if b < 0s128 then difference < a else difference > a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(difference)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: Int128,
  b: Int128)
  : Stdlib.Result.Result<Int128, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromInt128(a) * Stdlib.BigInt.fromInt128(b)
  match Stdlib.BigInt.toInt128(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>, or {{Error Overflow}} for the minimum value,
/// which `-` wraps back to itself
let checkedNegate(a: Int128): Stdlib.Result.Result<Int128, Stdlib.Math.Overflow> =
  if a == -170141183460469231731687303715884105728s128 then
    Error(Stdlib.Math.Overflow.Overflow)
  else
    Ok(-a)


/// The distance of <param a> from zero, or {{Error Overflow}} for the minimum
/// value, which <fn Stdlib.abs> wraps back to itself
let checkedAbsoluteValue(a: Int128)
  : Stdlib.Result.Result<Int128, Stdlib.Math.Overflow> =
  if a == -170141183460469231731687303715884105728s128 then
    Error(Stdlib.Math.Overflow.Overflow)
  else if a < 0s128 then
    Ok(-a)
  else
    Ok(a)
