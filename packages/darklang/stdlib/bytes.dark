module Darklang.Stdlib.Bytes

// Immutable binary data. Equal contents compare equal, whether in memory or saved.
// Saving values handles persistence automatically; there is only one Bytes type.
// TODO no Bytes literal syntax — embedding small binary data in source
// today requires `Base16.decode "..."` or `Utf8.encode "..."`. A
// `b"\x00\x01..."` form would be the natural fix, plus tokenizer +
// parser + runtime literal handling. Cross-cutting language change.

/// The empty Bytes.
val empty = Builtin.bytesEmpty


/// Returns the length of <param bytes> in bytes.
let length(bytes: Bytes): Int64 =
  Builtin.bytesLength(bytes)


/// Returns {{true}} if <param bytes> has no bytes in it.
let isEmpty(bytes: Bytes): Bool =
  length(bytes) == 0


/// Returns {{Some byte}} at <param index> in <param bytes> if <param index> is
/// less than the length, otherwise returns {{None}}.
let getAt(bytes: Bytes, index: Int64): Option<UInt8> =
  Builtin.bytesGetAt(bytes, index)


/// Returns {{Some index}} of the first <param byte> in <param bytes> at or
/// after <param start>, or {{None}} if there is none.
let indexOfFrom(bytes: Bytes, byte: UInt8, start: Int64): Option<Int64> =
  Builtin.bytesIndexOf(bytes, byte, start)


/// Returns {{Some index}} of the first <param byte> in <param bytes>, or
/// {{None}} if it isn't there.
let indexOf(bytes: Bytes, byte: UInt8): Option<Int64> =
  indexOfFrom(bytes, byte, 0)


/// Returns {{Some index}} of the last <param byte> in <param bytes> at or
/// before <param start>, or {{None}} if there is none or <param start> is
/// out of range.
let lastIndexOfFrom(bytes: Bytes, byte: UInt8, start: Int64): Option<Int64> =
  Builtin.bytesLastIndexOf(bytes, byte, start)


/// Returns {{Some index}} of the last <param byte> in <param bytes>, or
/// {{None}} if it isn't there.
let lastIndexOf(bytes: Bytes, byte: UInt8): Option<Int64> =
  lastIndexOfFrom(bytes, byte, length(bytes) - 1)


/// Concatenates a list of Bytes into a single Bytes.
let concatAll(values: List<Bytes>): Bytes =
  Builtin.bytesConcat(values)


/// Returns <param a> followed by <param b>.
let concat(a: Bytes, b: Bytes): Bytes =
  concatAll([ a, b ])


/// Returns <param bytes> with <param fn> applied to each byte.
let map(bytes: Bytes, fn: UInt8 -> UInt8): Bytes =
  fromList(List.map(toList(bytes), fn))


type IndexError =
  /// The range was outside the bounds of the Bytes.
  | IndexOutOfBounds


/// Returns {{Ok}} the bytes from <param start> up to, but not
/// including, <param end>. Returns {{Error IndexOutOfBounds}} unless
/// {{0 <= start <= end <= length}}.
let slice(bytes: Bytes, start: Int64, end: Int64): Result<Bytes, IndexError> =
  if start < 0 || start > end || end > length(bytes) then
    Result.Error(IndexError.IndexOutOfBounds)
  else
    Result.Ok(Builtin.bytesSlice(bytes, start, end - start))


/// Returns the first <param count> bytes of <param bytes>, or all of them if
/// there are fewer. A <param count> of zero or less gives the empty Bytes.
let take(bytes: Bytes, count: Int64): Bytes =
  let total = length(bytes)
  let end =
    if count < 0 then
      0
    else if count > total then
      total
    else
      count

  // Never out of range: `end` is within the Bytes.
  Result.withDefault(slice(bytes, 0, end), empty)


/// Returns <param bytes> without its first <param count> bytes, or the empty
/// Bytes if there are fewer. A <param count> of zero or less drops nothing.
let drop(bytes: Bytes, count: Int64): Bytes =
  let total = length(bytes)
  let start =
    if count < 0 then
      0
    else if count > total then
      total
    else
      count

  // Never out of range: `start` is within the Bytes.
  Result.withDefault(slice(bytes, start, total), empty)


/// Returns {{Ok}} <param bytes> with the byte at <param index> replaced by
/// <param byte>. Returns {{Error IndexOutOfBounds}} unless
/// {{0 <= index < length}}.
let setAt(bytes: Bytes, index: Int64, byte: UInt8): Result<Bytes, IndexError> =
  if index < 0 || index >= length(bytes) then
    Result.Error(IndexError.IndexOutOfBounds)
  else
    Result.Ok(concatAll([ take(bytes, index), fromList([ byte ]), drop(bytes, index + 1) ]))


/// Returns {{true}} if <param bytes> begins with <param prefix>. Every Bytes
/// starts with the empty Bytes.
let startsWith(bytes: Bytes, prefix: Bytes): Bool =
  take(bytes, length(prefix)) == prefix


/// Returns {{true}} if <param bytes> ends with <param suffix>. Every Bytes
/// ends with the empty Bytes.
let endsWith(bytes: Bytes, suffix: Bytes): Bool =
  length(suffix) <= length(bytes) && drop(bytes, length(bytes) - length(suffix)) == suffix


/// Returns <param bytes> without any <param byte> at its start or end:
/// trimming {{0u8}} from the bytes {{0 0 1 0 2 0}} gives {{1 0 2}}.
let trim(bytes: Bytes, byte: UInt8): Bytes =
  trimEnd(trimStart(bytes, byte), byte)


/// Returns <param bytes> without any <param byte> at its start.
let trimStart(bytes: Bytes, byte: UInt8): Bytes =
  drop(bytes, __skipFrom(bytes, byte, 0, 1))


/// Returns <param bytes> without any <param byte> at its end.
let trimEnd(bytes: Bytes, byte: UInt8): Bytes =
  take(bytes, __skipFrom(bytes, byte, length(bytes) - 1, -1) + 1)


/// The first index, starting at <param index> and moving by <param step>, that
/// does not hold <param byte>. Runs off either end to {{-1}} or the length.
let __skipFrom(bytes: Bytes, byte: UInt8, index: Int64, step: Int64): Int64 =
  match getAt(bytes, index) with
  | Some(found) when found == byte -> __skipFrom(bytes, byte, index + step, step)
  | _ -> index


/// Returns {{Some index}} of the first <param segment> in <param bytes> that
/// starts at or after <param start>, or {{None}} if there is none or
/// <param start> is out of range. An empty <param segment> is found at
/// <param start>.
let indexOfSegmentFrom(bytes: Bytes, segment: Bytes, start: Int64): Option<Int64> =
  Builtin.bytesIndexOfSegment(bytes, segment, start)


/// Returns {{Some index}} of the first <param segment> in <param bytes>, or
/// {{None}} if it isn't there. An empty <param segment> is found at 0.
let indexOfSegment(bytes: Bytes, segment: Bytes): Option<Int64> =
  indexOfSegmentFrom(bytes, segment, 0)


/// Returns {{true}} if <param segment> appears anywhere in <param bytes>. To
/// look for one byte, use <fn Stdlib.Bytes.indexOf>.
let contains(bytes: Bytes, segment: Bytes): Bool =
  Option.isSome(indexOfSegment(bytes, segment))


/// Returns <param bytes> with every <param segment> replaced by
/// <param replacement>. Matches are found from the start and never overlap, so
/// replacing {{aa}} in {{aaa}} replaces only the first two bytes. An empty
/// <param segment> matches between every two bytes and at both ends, as in
/// <fn Stdlib.String.replaceAll>.
let replaceAll(bytes: Bytes, segment: Bytes, replacement: Bytes): Bytes =
  if isEmpty(segment) then
    let singles = List.map(toList(bytes), fun b -> fromList([ b ]))
    concatAll(List.interpose([ empty, ...singles, empty ], replacement))
  else
    __replaceAllFrom(bytes, segment, replacement, 0, [])


/// The rest of <fn Stdlib.Bytes.replaceAll>: replaces each non-empty
/// <param segment> found at or after <param start>. <param pieces> holds the
/// output so far, last piece first.
let __replaceAllFrom(
  bytes: Bytes,
  segment: Bytes,
  replacement: Bytes,
  start: Int64,
  pieces: List<Bytes>)
  : Bytes =
  match indexOfSegmentFrom(bytes, segment, start) with
  | None -> concatAll(List.reverse([ drop(bytes, start), ...pieces ]))
  | Some(found) ->
    // Never out of range: `start <= found`, and both are within the Bytes.
    let before = Result.withDefault(slice(bytes, start, found), empty)
    __replaceAllFrom(
      bytes,
      segment,
      replacement,
      found + length(segment),
      [ replacement, before, ...pieces ])


/// Expands <param bytes> into a list of its bytes. Copies every byte, so for
/// one byte use <fn Stdlib.Bytes.getAt>, to find one use
/// <fn Stdlib.Bytes.indexOf>, and to join or cut Bytes use
/// <fn Stdlib.Bytes.concat> or <fn Stdlib.Bytes.slice>. Use it for parsing
/// that walks every byte.
let toList(bytes: Bytes): List<UInt8> =
  Builtin.bytesToList(bytes)


/// Collects a list of bytes into a Bytes. Copies every byte; to join Bytes
/// use <fn Stdlib.Bytes.concat> instead of going through a list.
let fromList(bytes: List<UInt8>): Bytes =
  Builtin.bytesFromList(bytes)


/// Returns <param bytes> with its bytes in the opposite order.
let reverse(bytes: Bytes): Bytes =
  fromList(List.reverse(toList(bytes)))


/// Stores <param bytes> in the package store, content-addressed, and returns the hash
/// they live under, which is what <fn load> takes. The same bytes persist to the same
/// hash, so this is safe to repeat. A generator's input file is stored this way once,
/// and the saved generator names it by hash.
let persist(bytes: Bytes): String =
  Builtin.bytesPersist(bytes)


/// The persistent bytes stored under <param hash>, or None when the store has no such row.
let load(hash: String): Option<Bytes> =
  Builtin.bytesLoad(hash)
