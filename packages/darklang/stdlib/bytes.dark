module Darklang.Stdlib.Bytes

// Immutable binary data. Equal contents compare equal, whether in memory or saved.
// Saving values handles persistence automatically; there is only one Bytes type.

// TODO no Bytes literal syntax — embedding small binary data in source
// today requires `Base16.decode "..."` or `Utf8.encode "..."`. A
// `b"\x00\x01..."` form would be the natural fix, plus tokenizer +
// parser + runtime literal handling. Cross-cutting language change.


/// The empty Bytes.
val empty = Builtin.bytesEmpty


/// Returns the length of <param bytes> in bytes.
let length(bytes: Bytes): Int64 = Builtin.bytesLength(bytes)


/// Returns {{true}} if <param bytes> has no bytes in it.
let isEmpty(bytes: Bytes): Bool = (length(bytes)) == 0


/// Returns {{Some byte}} at <param index> in <param bytes> if <param index> is
/// less than the length, otherwise returns {{None}}.
let getAt(bytes: Bytes, index: Int64): Stdlib.Option.Option<UInt8> =
  Builtin.bytesGetAt(bytes, index)


/// Returns {{Some index}} of the first <param byte> in <param bytes> at or
/// after <param start>, or {{None}} if there is none.
let indexOfFrom(
  bytes: Bytes,
  byte: UInt8,
  start: Int64)
  : Stdlib.Option.Option<Int64> =
  Builtin.bytesIndexOf(bytes, byte, start)


/// Returns {{Some index}} of the first <param byte> in <param bytes>, or
/// {{None}} if it isn't there.
let indexOf(bytes: Bytes, byte: UInt8): Stdlib.Option.Option<Int64> =
  indexOfFrom(bytes, byte, 0)


/// Concatenates a list of Bytes into a single Bytes.
let concatAll(values: List<Bytes>): Bytes = Builtin.bytesConcat(values)


/// Returns <param a> followed by <param b>.
let concat(a: Bytes, b: Bytes): Bytes = concatAll([ a, b ])


type IndexError =
  /// The range was outside the bounds of the Bytes.
  | IndexOutOfBounds


/// Returns {{Ok}} the bytes from <param start> up to, but not
/// including, <param end>. Returns {{Error IndexOutOfBounds}} unless
/// {{0 <= start <= end <= length}}.
let slice(
  bytes: Bytes,
  start: Int64,
  end: Int64)
  : Stdlib.Result.Result<Bytes, IndexError> =
  if start < 0 || start > end || end > length(bytes) then
    Stdlib.Result.Result.Error(IndexError.IndexOutOfBounds)
  else
    Stdlib.Result.Result.Ok(Builtin.bytesSlice(bytes, start, end - start))


/// Returns the first <param count> bytes of <param bytes>, or all of them if
/// there are fewer. A <param count> of zero or less gives the empty Bytes.
let take(bytes: Bytes, count: Int64): Bytes =
  let total = length(bytes)
  let end = if count < 0 then 0 else if count > total then total else count
  // Never out of range: `end` is within the Bytes.
  Stdlib.Result.withDefault(slice(bytes, 0, end), empty)


/// Returns <param bytes> without its first <param count> bytes, or the empty
/// Bytes if there are fewer. A <param count> of zero or less drops nothing.
let drop(bytes: Bytes, count: Int64): Bytes =
  let total = length(bytes)
  let start = if count < 0 then 0 else if count > total then total else count
  // Never out of range: `start` is within the Bytes.
  Stdlib.Result.withDefault(slice(bytes, start, total), empty)


/// Returns {{Ok}} <param bytes> with the byte at <param index> replaced by
/// <param byte>. Returns {{Error IndexOutOfBounds}} unless
/// {{0 <= index < length}}.
let setAt(
  bytes: Bytes,
  index: Int64,
  byte: UInt8)
  : Stdlib.Result.Result<Bytes, IndexError> =
  if index < 0 || index >= length(bytes) then
    Stdlib.Result.Result.Error(IndexError.IndexOutOfBounds)
  else
    Stdlib.Result.Result.Ok(
      concatAll([ take(bytes, index), fromList([ byte ]), drop(bytes, index + 1) ])
    )


/// Returns {{true}} if <param bytes> begins with <param prefix>. Every Bytes
/// starts with the empty Bytes.
let startsWith(bytes: Bytes, prefix: Bytes): Bool =
  take(bytes, length(prefix)) == prefix


/// Returns {{true}} if <param bytes> ends with <param suffix>. Every Bytes
/// ends with the empty Bytes.
let endsWith(bytes: Bytes, suffix: Bytes): Bool =
  length(suffix) <= length(bytes)
  && drop(bytes, length(bytes) - length(suffix)) == suffix


/// Returns {{Some index}} of the first <param segment> in <param bytes> that
/// starts at or after <param start>, or {{None}} if there is none or
/// <param start> is out of range. An empty <param segment> is found at
/// <param start>.
let indexOfSegmentFrom(
  bytes: Bytes,
  segment: Bytes,
  start: Int64)
  : Stdlib.Option.Option<Int64> =
  Builtin.bytesIndexOfSegment(bytes, segment, start)


/// Returns {{Some index}} of the first <param segment> in <param bytes>, or
/// {{None}} if it isn't there. An empty <param segment> is found at 0.
let indexOfSegment(bytes: Bytes, segment: Bytes): Stdlib.Option.Option<Int64> =
  indexOfSegmentFrom(bytes, segment, 0)


/// Returns {{true}} if <param segment> appears anywhere in <param bytes>. To
/// look for one byte, use <fn Stdlib.Bytes.indexOf>.
let contains(bytes: Bytes, segment: Bytes): Bool =
  Stdlib.Option.isSome(indexOfSegment(bytes, segment))


/// Expands <param bytes> into a list of its bytes. Copies every byte, so for
/// one byte use <fn Stdlib.Bytes.getAt>, to find one use
/// <fn Stdlib.Bytes.indexOf>, and to join or cut Bytes use
/// <fn Stdlib.Bytes.concat> or <fn Stdlib.Bytes.slice>. Use it for parsing
/// that walks every byte.
let toList(bytes: Bytes): List<UInt8> = Builtin.bytesToList(bytes)


/// Collects a list of bytes into a Bytes. Copies every byte; to join Bytes
/// use <fn Stdlib.Bytes.concat> instead of going through a list.
let fromList(bytes: List<UInt8>): Bytes = Builtin.bytesFromList(bytes)
