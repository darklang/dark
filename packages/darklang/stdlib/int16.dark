module Darklang.Stdlib.Int16


type ParseError =
  | BadFormat
  | OutOfRange


impl Modulo for Int16 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  /// Use <fn Int16.checkedRemainder> if you want the remainder after division, which has
  /// a different behavior for negative numbers.
  let modulo(a: Int16, b: Int16): Int16 = Builtin.modulo(a, b)


impl Add for Int16 =
  /// Adds two 16-bit signed integers together (wraps on overflow)
  let add(a: Int16, b: Int16): Int16 = Builtin.add(a, b)


impl Subtract for Int16 =
  /// Subtracts two 16-bit signed integers (wraps on overflow)
  let subtract(a: Int16, b: Int16): Int16 = Builtin.subtract(a, b)


impl Multiply for Int16 =
  /// Multiplies two 16-bit signed integers (wraps on overflow)
  let multiply(a: Int16, b: Int16): Int16 = Builtin.multiply(a, b)


impl Power for Int16 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  /// Raises an error if <param exponent> is negative.
  let power(``base``: Int16, exponent: Int16): Int16 =
    Builtin.power(``base``, exponent)


impl Divide for Int16 =
  /// Divides two 16-bit signed integers
  let divide(a: Int16, b: Int16): Int16 = Builtin.divide(a, b)


impl Negate for Int16 =
  /// Returns the negation of <param a>, {{-a}}. Negating the minimum value wraps back to itself.
  let negate(a: Int16): Int16 = Builtin.negate(a)


impl Compare for Int16 =
  /// Returns {{true}} if <param a> is less than <param b>
  let lessThan(a: Int16, b: Int16): Bool = Builtin.lessThan(a, b)
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  let lessThanOrEqualTo(a: Int16, b: Int16): Bool =
    Builtin.lessThanOrEqualTo(a, b)
  /// Returns {{true}} if <param a> is greater than <param b>
  let greaterThan(a: Int16, b: Int16): Bool = Builtin.greaterThan(a, b)
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  let greaterThanOrEqualTo(a: Int16, b: Int16): Bool =
    Builtin.greaterThanOrEqualTo(a, b)


/// Returns a random 16-bit signed integer between <param start> and <param end> (inclusive)
let random(start: Int16, ``end``: Int16): Int16 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromInt16(start), Stdlib.BigInt.fromInt16(``end``))
  |> Stdlib.BigInt.toInt16
  |> Builtin.unwrap


/// Get the square root of an <type Int16>
let sqrt(a: Int16): Float = Stdlib.Float.sqrt(Stdlib.Int16.toFloat(a))


/// The square root of <param a>, or {{Error NotANumber}} where <param a> is negative
let checkedSqrt(a: Int16): Stdlib.Result.Result<Float, Stdlib.Math.NonFinite> =
  Stdlib.Float.checkedSqrt(Stdlib.Int16.toFloat(a))


/// Converts an <type Int16> to a <type Float>
let toFloat(a: Int16): Float = Builtin.int16ToFloat(a)


/// Parses a <type String> into an <type Int16>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type Int16> range).
let parse(s: String): Stdlib.Result.Result<Int16, Stdlib.Int16.ParseError> =
  match Stdlib.BigInt.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.BigInt.toInt16(n), Stdlib.Int16.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.Int16.ParseError.BadFormat)


/// Converts an <type Int8> to an <type Int16>.
let fromInt8(i: Int8): Int16 =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromInt8(i)) |> Builtin.unwrap


/// Converts a <type UInt8> to an <type Int16>.
let fromUInt8(i: UInt8): Int16 =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromUInt8(i)) |> Builtin.unwrap


/// Converts a <type UInt16> to an <type Int16>. Returns {{None}} if the value is greater than 32767.
let fromUInt16(i: UInt16): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromUInt16(i))


/// Converts an <type Int32> to an <type Int16>. Returns {{None}} if the value is less than -32768 or greater than 32767.
let fromInt32(i: Int32): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromInt32(i))


/// Converts a <type UInt32> to an <type Int16>. Returns {{None}} if the value is greater than 32767.
let fromUInt32(i: UInt32): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromUInt32(i))


/// Converts an <type Int64> to an <type Int16>. Returns {{None}} if the value is less than -32768 or greater than 32767.
let fromInt64(i: Int64): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromInt64(i))


/// Converts a <type UInt64> to an <type Int16>. Returns {{None}} if the value is greater than 32767.
let fromUInt64(i: UInt64): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromUInt64(i))


/// Converts an <type Int128> to an <type Int16>. Returns {{None}} if the value is less than -32768 or greater than 32767.
let fromInt128(i: Int128): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromInt128(i))


/// Converts a <type UInt128> to an <type Int16>. Returns {{None}} if the value is greater than 32767.
let fromUInt128(i: UInt128): Stdlib.Option.Option<Int16> =
  Stdlib.BigInt.toInt16(Stdlib.BigInt.fromUInt128(i))


impl BitwiseAnd for Int16 =
  /// Bitwise AND on two <type Int16> values
  let bitwiseAnd(a: Int16, b: Int16): Int16 = Builtin.bitwiseAnd(a, b)


impl BitwiseOr for Int16 =
  /// Bitwise OR on two <type Int16> values
  let bitwiseOr(a: Int16, b: Int16): Int16 = Builtin.bitwiseOr(a, b)


impl BitwiseXor for Int16 =
  /// Bitwise XOR on two <type Int16> values
  let bitwiseXor(a: Int16, b: Int16): Int16 = Builtin.bitwiseXor(a, b)


impl BitwiseNot for Int16 =
  /// Bitwise NOT on an <type Int16> value
  let bitwiseNot(a: Int16): Int16 = Builtin.bitwiseNot(a)


impl ShiftLeft for Int16 =
  /// Bitwise left shift of an <type Int16> value
  let shiftLeft(a: Int16, b: Int16): Int16 = Builtin.shiftLeft(a, b)


impl ShiftRight for Int16 =
  /// Bitwise right shift of an <type Int16> value
  let shiftRight(a: Int16, b: Int16): Int16 = Builtin.shiftRight(a, b)

impl Display for Int16 =
  /// Stringify <param int16>
  let display(int16: Int16): String = Builtin.int16ToString(int16)

impl Zero for Int16 =
  let zero(): Int16 = 0s16

impl One for Int16 =
  let one(): Int16 = 1s16


// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let sum = a + b
  let wrapped = if b < 0s16 then sum > a else sum < a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let difference = a - b
  let wrapped = if b < 0s16 then difference < a else difference > a
  if wrapped then Error(Stdlib.Math.Overflow.Overflow) else Ok(difference)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: Int16,
  b: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromInt16(a) * Stdlib.BigInt.fromInt16(b)
  match Stdlib.BigInt.toInt16(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>, or {{Error Overflow}} for the minimum value,
/// which `-` wraps back to itself
let checkedNegate(a: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  if a == -32768s16 then Error(Stdlib.Math.Overflow.Overflow) else Ok(-a)


/// The distance of <param a> from zero, or {{Error Overflow}} for the minimum
/// value, which <fn Stdlib.abs> wraps back to itself
let checkedAbsoluteValue(a: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.Overflow> =
  if a == -32768s16 then
    Error(Stdlib.Math.Overflow.Overflow)
  else if a < 0s16 then
    Ok(-a)
  else
    Ok(a)


/// <param base> raised to the power of <param exponent>, or where `**` raises or wraps,
/// {{Error NegativeExponent}} or {{Error Overflow}}
let checkedPower(
  ``base``: Int16,
  exponent: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.PowerError> =
  if exponent < 0s16 then
    Error(Stdlib.Math.PowerError.NegativeExponent)
  else if ``base`` == 0s16 || ``base`` == 1s16 || ``base`` == -1s16 then
    // 0, 1 and -1 never grow, so `**` is exact whatever the exponent
    Ok(``base`` ** exponent)
  else if exponent >= 16s16 then
    // any other base is at least 2 from zero, and 2 ** 16 is past the Int16 range
    Error(Stdlib.Math.PowerError.Overflow)
  else
    let result = Stdlib.BigInt.fromInt16(``base``) ** Stdlib.BigInt.fromInt16(exponent)

    match Stdlib.BigInt.toInt16(result) with
    | Some(fits) -> Ok(fits)
    | None -> Error(Stdlib.Math.PowerError.Overflow)


// Division. `/` raises on a zero divisor and `%` on a modulus that is not positive;
// these return the reason instead.
// TODO: make `/` and `%` themselves checked by default; see the TODO on the `divide`
// builtin in NoModule.fs.

/// Divides <param a> by <param b>, rounding towards zero, or
/// {{Error DivisionByZero}} where `/` raises, or {{Error Overflow}} for the
/// minimum value divided by -1, where `/` wraps back to the minimum.
let checkedDivide(a: Int16, b: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.DivisionError> =
  if b == 0s16 then
    Error(Stdlib.Math.DivisionError.DivisionByZero)
  else if b == -1s16 && a == -32768s16 then
    Error(Stdlib.Math.DivisionError.Overflow)
  else
    Ok(a / b)


/// What is left after dividing <param value> by <param divisor>, rounding towards
/// zero: negative only if <param value> is, whatever the sign of <param divisor>.
/// {{Error DivisionByZero}} if <param divisor> is {{0}}.
/// Use <fn Int16.checkedMod> to wrap around into {{0 <= res < b}} instead.
let checkedRemainder(
  value: Int16,
  divisor: Int16)
  : Stdlib.Result.Result<Int16, Stdlib.Math.DivisionError> =
  if divisor == 0s16 then
    Error(Stdlib.Math.DivisionError.DivisionByZero)
  else
    Ok(value - (value / divisor) * divisor)


/// <param a> wrapped around so that {{0 <= res < b}}, or where `%` raises,
/// {{Error ZeroModulus}} or {{Error NegativeModulus}}
let checkedMod(a: Int16, b: Int16): Stdlib.Result.Result<Int16, Stdlib.Math.ModulusError> =
  if b == 0s16 then
    Error(Stdlib.Math.ModulusError.ZeroModulus)
  else if b < 0s16 then
    Error(Stdlib.Math.ModulusError.NegativeModulus)
  else
    Ok(a % b)
