module Darklang.Stdlib.UInt16


type ParseError =
  | BadFormat
  | OutOfRange


impl Modulo for UInt16 =
  /// Returns the result of wrapping <param a> around so that {{0 <= res < b}}.
  /// The modulus <param b> must be greater than 0.
  let modulo(a: UInt16, b: UInt16): UInt16 = Builtin.uint16Mod(a, b)


impl Add for UInt16 =
  /// Adds two 16-bit unsigned integers together (wraps on overflow)
  let add(a: UInt16, b: UInt16): UInt16 = Builtin.uint16Add(a, b)


impl Subtract for UInt16 =
  /// Subtracts two 16-bit unsigned  integers (wraps on overflow)
  let subtract(a: UInt16, b: UInt16): UInt16 = Builtin.uint16Subtract(a, b)


impl Multiply for UInt16 =
  /// Multiplies two 16-bit unsigned  integers (wraps on overflow)
  let multiply(a: UInt16, b: UInt16): UInt16 = Builtin.uint16Multiply(a, b)


impl Power for UInt16 =
  /// Raise <param base> to the power of <param exponent>.
  /// Overflow wraps around.
  let power(``base``: UInt16, exponent: UInt16): UInt16 =
    // The signed types push this into the builtin; here the ladder stays, because an
    // unsigned exponent is never negative, so there is no error case to push.
    if ``base`` == 0u16 && exponent == 0u16 then 1u16
    else if ``base`` == 0u16 then 0u16
    else if ``base`` == 1u16 then 1u16
    else Builtin.uint16Power(``base``, exponent)


impl Divide for UInt16 =
  /// Divides two 16-bit unsigned integers
  let divide(a: UInt16, b: UInt16): UInt16 = Builtin.uint16Divide(a, b)


impl Compare for UInt16 =
  /// Returns {{true}} if <param a> is less than <param b>
  let lessThan(a: UInt16, b: UInt16): Bool = Builtin.uint16LessThan(a, b)
  /// Returns {{true}} if <param a> is less than or equal to <param b>
  let lessThanOrEqualTo(a: UInt16, b: UInt16): Bool =
    Builtin.uint16LessThanOrEqualTo(a, b)
  /// Returns {{true}} if <param a> is greater than <param b>
  let greaterThan(a: UInt16, b: UInt16): Bool = Builtin.uint16GreaterThan(a, b)
  /// Returns {{true}} if <param a> is greater than or equal to <param b>
  let greaterThanOrEqualTo(a: UInt16, b: UInt16): Bool =
    Builtin.uint16GreaterThanOrEqualTo(a, b)


/// Returns a random 16-bit unsigned integer between <param start> and <param end> (inclusive)
let random(start: UInt16, ``end``: UInt16): UInt16 =
  Stdlib.BigInt.random(Stdlib.BigInt.fromUInt16(start), Stdlib.BigInt.fromUInt16(``end``))
  |> Stdlib.BigInt.toUInt16
  |> Builtin.unwrap


/// Get the square root of an <type UInt16>
let sqrt(a: UInt16): Float = Stdlib.Float.sqrt(Stdlib.UInt16.toFloat(a))


/// Converts an <type UInt16> to a <type Float>
let toFloat(a: UInt16): Float = Builtin.uint16ToFloat(a)


/// Parses a <type String> into a <type UInt16>, returning {{Ok}} with the
/// parsed value on success, or {{Error}} with a <type ParseError> ({{BadFormat}}
/// if the string isn't a valid integer, {{OutOfRange}} if it's outside the
/// <type UInt16> range).
let parse(
  s: String)
  : Stdlib.Result.Result<UInt16, Stdlib.UInt16.ParseError> =
  match Stdlib.BigInt.parse(s) with
  | Ok(n) -> Stdlib.Option.toResult(Stdlib.BigInt.toUInt16(n), Stdlib.UInt16.ParseError.OutOfRange)
  | Error(_) -> Error(Stdlib.UInt16.ParseError.BadFormat)


/// Converts an <type Int8> to a <type UInt16>. Returns {{None}} if the value is less than 0.
let fromInt8(i: Int8): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt8(i))


/// Converts a <type UInt8> to a <type UInt16>.
let fromUInt8(i: UInt8): UInt16 =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromUInt8(i)) |> Builtin.unwrap


/// Converts an <type Int16> to a <type UInt16>. Returns {{None}} if the value is less than 0.
let fromInt16(i: Int16): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt16(i))


/// Converts an <type Int32> to a <type UInt16>. Returns {{None}} if the value is less than 0 or greater than 65535.
let fromInt32(i: Int32): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt32(i))


/// Converts a <type UInt32> to a <type UInt16>. Returns {{None}} if the value is greater than 65535.
let fromUInt32(i: UInt32): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromUInt32(i))


/// Converts an <type Int64> to a <type UInt16>. Returns {{None}} if the value is less than 0 or greater than 65535.
let fromInt64(i: Int64): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt64(i))


/// Converts a <type UInt64> to a <type UInt16>. Returns {{None}} if the value is greater than 65535.
let fromUInt64(i: UInt64): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromUInt64(i))


/// Converts an <type Int128> to a <type UInt16>. Returns {{None}} if the value is less than 0 or greater than 65535.
let fromInt128(i: Int128): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromInt128(i))


/// Converts a <type UInt128> to a <type UInt16>. Returns {{None}} if the value is greater than 65535.
let fromUInt128(i: UInt128): Stdlib.Option.Option<UInt16> =
  Stdlib.BigInt.toUInt16(Stdlib.BigInt.fromUInt128(i))


impl BitwiseAnd for UInt16 =
  /// Bitwise AND on two <type UInt16> values
  let bitwiseAnd(a: UInt16, b: UInt16): UInt16 = Builtin.uint16BitwiseAnd(a, b)


impl BitwiseOr for UInt16 =
  /// Bitwise OR on two <type UInt16> values
  let bitwiseOr(a: UInt16, b: UInt16): UInt16 = Builtin.uint16BitwiseOr(a, b)


impl BitwiseXor for UInt16 =
  /// Bitwise XOR on two <type UInt16> values
  let bitwiseXor(a: UInt16, b: UInt16): UInt16 = Builtin.uint16BitwiseXor(a, b)


impl BitwiseNot for UInt16 =
  /// Bitwise NOT on a <type UInt16> value
  let bitwiseNot(a: UInt16): UInt16 = Builtin.uint16BitwiseNot(a)


impl ShiftLeft for UInt16 =
  /// Bitwise left shift of a <type UInt16> value
  let shiftLeft(a: UInt16, b: UInt16): UInt16 = Builtin.uint16ShiftLeft(a, b)


impl ShiftRight for UInt16 =
  /// Bitwise right shift of a <type UInt16> value
  let shiftRight(a: UInt16, b: UInt16): UInt16 = Builtin.uint16ShiftRight(a, b)

impl ToString for UInt16 =
  /// Stringify <param uint16>
  let toString(uint16: UInt16): String = Builtin.uint16ToString(uint16)

impl Zero for UInt16 =
  let zero(): UInt16 = 0u16

impl One for UInt16 =
  let one(): UInt16 = 1u16


// Checked arithmetic. The operators wrap on overflow; these return
// {{Error Overflow}} instead, going below 0 included.

/// Adds <param a> and <param b>, or {{Error Overflow}} where `+` would wrap
let checkedAdd(
  a: UInt16,
  b: UInt16)
  : Stdlib.Result.Result<UInt16, Stdlib.Math.Overflow> =
  let sum = a + b
  if sum < a then Error(Stdlib.Math.Overflow.Overflow) else Ok(sum)


/// Subtracts <param b> from <param a>, or {{Error Overflow}} where `-` would wrap
let checkedSubtract(
  a: UInt16,
  b: UInt16)
  : Stdlib.Result.Result<UInt16, Stdlib.Math.Overflow> =
  if b > a then Error(Stdlib.Math.Overflow.Overflow) else Ok(a - b)


/// Multiplies <param a> by <param b>, or {{Error Overflow}} where `*` would wrap
let checkedMultiply(
  a: UInt16,
  b: UInt16)
  : Stdlib.Result.Result<UInt16, Stdlib.Math.Overflow> =
  let product = Stdlib.BigInt.fromUInt16(a) * Stdlib.BigInt.fromUInt16(b)
  match Stdlib.BigInt.toUInt16(product) with
  | Some(fits) -> Ok(fits)
  | None -> Error(Stdlib.Math.Overflow.Overflow)


/// The negation of <param a>: {{Ok 0}} for 0, and {{Error Overflow}} for
/// anything else, which has no unsigned negation
let checkedNegate(a: UInt16): Stdlib.Result.Result<UInt16, Stdlib.Math.Overflow> =
  if a == 0u16 then Ok(a) else Error(Stdlib.Math.Overflow.Overflow)


/// The distance of <param a> from zero, which for an unsigned value is always
/// <param a> itself. Here so every fixed-width type has the same checked set.
let checkedAbsoluteValue(a: UInt16)
  : Stdlib.Result.Result<UInt16, Stdlib.Math.Overflow> =
  Ok(a)


/// <param base> raised to the power of <param exponent>, or {{Error Overflow}}
/// where `**` would wrap
let checkedPower(
  ``base``: UInt16,
  exponent: UInt16)
  : Stdlib.Result.Result<UInt16, Stdlib.Math.PowerError> =
  if ``base`` == 0u16 || ``base`` == 1u16 then
    // 0 and 1 never grow, so `**` is exact whatever the exponent
    Ok(``base`` ** exponent)
  else if exponent >= 16u16 then
    // any other base is at least 2 from zero, and 2 ** 16 is past the UInt16 range
    Error(Stdlib.Math.PowerError.Overflow)
  else
    let result = Stdlib.BigInt.fromUInt16(``base``) ** Stdlib.BigInt.fromUInt16(exponent)

    match Stdlib.BigInt.toUInt16(result) with
    | Some(fits) -> Ok(fits)
    | None -> Error(Stdlib.Math.PowerError.Overflow)


// Division. `/` raises on a zero divisor and `%` on a modulus that is not positive;
// these return the reason instead.
// TODO: make `/` and `%` themselves checked by default; see the TODO on the `divide`
// builtin in NoModule.fs.

/// Divides <param a> by <param b>, rounding towards zero, or
/// {{Error DivisionByZero}} where `/` raises.
let checkedDivide(a: UInt16, b: UInt16): Stdlib.Result.Result<UInt16, Stdlib.Math.DivisionError> =
  if b == 0u16 then Error(Stdlib.Math.DivisionError.DivisionByZero) else Ok(a / b)


/// <param a> wrapped around so that {{0 <= res < b}}, or {{Error ZeroModulus}}
/// where `%` raises
let checkedMod(a: UInt16, b: UInt16): Stdlib.Result.Result<UInt16, Stdlib.Math.ModulusError> =
  if b == 0u16 then Error(Stdlib.Math.ModulusError.ZeroModulus) else Ok(a % b)
