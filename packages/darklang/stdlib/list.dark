module Darklang.Stdlib.List


/// Returns an empty list
val empty = []

/// The empty list is what `+` starts from, as `0` is for a number
impl Stdlib.Zero for List<'a> =
  let zero(): List<'a> = []

/// Returns a one-element list containing the given <param val>
/// Takes O(1) time.
let singleton(value: 'a): List<'a> =
  [ value ]


/// Returns {{Some}} the head (first value) of a list.
/// Returns {{None}} if the list is empty.
/// Takes O(1) time.
let head(list: List<'a>): Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | [head, ...] -> Option.Option.Some(head)


/// If <param list> contains at least one value, returns {{Some}} with a list of
/// every value other than the first. Otherwise, returns {{None}}.
/// Takes O(1) time.
let tail(list: List<'a>): Option.Option<List<'a>> =
  match list with
  | [] -> Option.Option.None
  | [_, ...tail] -> Option.Option.Some(tail)


/// Returns a new list with all values in <param as> followed by all values in <param bs>,
/// preserving the order. `[...as_, ...bs]` lowers to this. To add one value, use
/// <fn prepend> or <fn append>.
/// Takes O(n) time (O(log n) in the interpreter).
let concat(as_: List<'a>, bs: List<'a>): List<'a> =
  Builtin.listConcat(as_, bs)


/// Adds <param value> to the front of <param list>.
/// Takes O(1) time.
let prepend(list: List<'a>, value: 'a): List<'a> =
  Builtin.listPrepend(list, value)


/// Adds <param value> to the back of <param list>. To join two lists, use <fn concat>.
/// Takes O(n) time (O(log n) in the interpreter).
let append(list: List<'a>, value: 'a): List<'a> =
  Builtin.listAppend(list, value)


/// Returns the last value in <param list>, wrapped in an option (<paramNone> if the list is empty)
/// Takes O(n) time (O(log n) in the interpreter).
let last(list: List<'a>): Option.Option<'a> =
  getAt(list, length(list) - 1)


/// Returns a reversed copy of <param list>
/// Takes O(n) time.
let reverse(list: List<'a>): List<'a> =
  Builtin.listReverse(list)


/// Returns {{Some firstMatch}} where <var firstMatch> is the first value of the
/// list for which <param fn> returns {{true}}. Returns {{None}} if no such
/// value exists
/// Takes O(n) time.
let findFirst(list: List<'a>, fn: 'a -> Bool): Option.Option<'a> =
  Builtin.listFindFirst(list, fn)


/// Returns the index of the first element in <param list> for which <param fn>
/// returns true. Returns {{None}} if no such element exists.
/// Takes O(n) time.
let findFirstIndex(list: List<'a>, fn: 'a -> Bool): Option.Option<Int64> =
  list
  |> indexedMap(fun(i, item) -> (i, item))
  |> findFirst(fun((_i, item)) -> fn(item))
  |> Stdlib.Option.map(fun((i, _item)) -> i)


/// Returns the zero-based index of the first element in <param list> equal to
/// <param x>, wrapped in {{Some}}. Returns {{None}} if no such element exists.
/// Takes O(n) time.
let indexOf(list: List<'a>, x: 'a): Option.Option<Int64> =
  findFirstIndex(list, fun item -> item == x)


/// Returns {{true}} if <param value> is in the list
/// Takes O(n) time.
let contains(list: List<'a>, value: 'a): Bool =
  Builtin.listContains(list, value)


/// Returns a list of <param value> repeated <param times> times, or {{[]}} if
/// <param times> is 0 or less. Use <fn List.checkedRepeat> to get an error for a
/// negative count.
/// Takes O(n) time, where n is <param times>.
let repeat(times: Int64, value: 'a): List<'a> =
  if times <= 0 then
    []
  else
    Stdlib.List.map(Stdlib.List.range(1, times), fun _ -> value)


/// What <fn List.checkedRepeat> returns for a count below 0, or past 2147483591
type RepeatError =
  | NegativeCount
  | TooLong

/// Returns {{Ok}} a list of <param value> repeated <param times> times, or
/// {{Error NegativeCount}} if <param times> is below 0, or {{Error TooLong}} if it
/// is past 2147483591, where <fn List.repeat> raises. A count of 0 gives {{Ok []}}.
/// Takes O(n) time, where n is <param times>.
let checkedRepeat(
  times: Int64,
  value: 'a)
  : Result.Result<List<'a>, RepeatError> =
  if times < 0 then
    Result.Result.Error(RepeatError.NegativeCount)
  else if times > 2147483591 then
    Result.Result.Error(RepeatError.TooLong)
  else
    Result.Result.Ok(repeat(times, value))


/// Returns the number of values in <param list>
/// Takes O(1) time.
let `length`(list: List<'a>): Int64 =
  Builtin.listLength(list)


/// Returns a list of numbers where each element is {{1}} larger than the
/// previous. You provide the <param lowest> and <param highest> numbers in the list.
/// Takes O(n) time, where n is the number of values returned.
let range(lowest: Int64, highest: Int64): List<Int64> =
  Builtin.listRange(lowest, highest)


/// What <fn List.checkedRange> returns for more numbers than a list can hold
type RangeError = | TooLong

/// Returns {{Ok}} the numbers from <param lowest> to <param highest>, as <fn List.range>
/// does, or {{Error TooLong}} for more than 2147483591 of them, where <fn List.range>
/// raises.
/// Takes O(n) time, where n is the number of values returned.
let checkedRange(
  lowest: Int64,
  highest: Int64)
  : Result.Result<List<Int64>, RangeError> =
  if highest < lowest then
    Result.Result.Ok([])
  else if highest - lowest < 0 || highest - lowest >= 2147483591 then
    Result.Result.Error(RangeError.TooLong)
  else
    Result.Result.Ok(range(lowest, highest))


/// Folds <param list> into a single value, by calling <param fn> on each element with the value
/// built so far.
///
/// Native, unlike most of this module, because it is the loop everything else here is written on:
/// `map`, `filter` and the rest fold. Written in Dark it cost a package call and a match per element
/// on top of the lambda; the builtin walks the list in F# and applies the lambda directly.
/// Takes O(n) time.
let fold(list: List<'a>, init: 'b, fn: ('b, 'a) -> 'b): 'b =
  Builtin.listFold(list, init, fn)


/// Returns the element of <param list> whose key from <param fn> is largest,
/// or {{None}} if the list is empty.
/// The key type must implement `Compare`. On ties, the first element wins.
/// Calls <param fn> once per element.
/// Takes O(n) time.
let maxBy<'a, 'key: Compare>(list: List<'a>, fn: 'a -> 'key): Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | [head, ...tail] ->
    let (best, _) =
      fold(tail, (head, fn(head)), fun((best, bestKey), value) ->
        let key = fn(value)
        if key > bestKey then (value, key) else (best, bestKey))
    Option.Option.Some(best)


/// Returns the element of <param list> whose key from <param fn> is smallest,
/// or {{None}} if the list is empty.
/// The key type must implement `Compare`. On ties, the first element wins.
/// Calls <param fn> once per element.
/// Takes O(n) time.
let minBy<'a, 'key: Compare>(list: List<'a>, fn: 'a -> 'key): Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | [head, ...tail] ->
    let (best, _) =
      fold(tail, (head, fn(head)), fun((best, bestKey), value) ->
        let key = fn(value)
        if key < bestKey then (value, key) else (best, bestKey))
    Option.Option.Some(best)


/// Returns the largest element of <param list>, or {{None}} if it is empty.
/// The element type must implement `Compare`. On ties, the first element wins.
/// Takes O(n) time.
let max<'a: Compare>(list: List<'a>): Option.Option<'a> =
  maxBy(list, fun value -> value)


/// Returns the smallest element of <param list>, or {{None}} if it is empty.
/// The element type must implement `Compare`. On ties, the first element wins.
/// Takes O(n) time.
let min<'a: Compare>(list: List<'a>): Option.Option<'a> =
  minBy(list, fun value -> value)


/// Returns a single list containing the values of every list directly in <paramlist>
/// (does not recursively flatten nested lists)
/// Takes O(n) time, where n is the number of values returned.
let flatten(list: List<List<'a>>): List<'a> =
  Builtin.listFlatten(list)


/// Returns a single list containing the values of <param list> separated by <param sep>
/// Takes O(n) time.
let interpose(list: List<'a>, sep: 'a): List<'a> =
  match list with
  | [] -> []
  | [ single ] -> [ single ]
  | [head, ...tail] ->
    (interpose(tail, sep))
    |> prepend(sep)
    |> prepend(head)


/// Returns a list with the first value from <param l1> then the first value
/// from <param l2>, then the second value from <param l1> then the second value
/// other list.
/// Takes O(n) time.
let interleave(lA: List<'a>, lB: List<'a>): List<'a> =
  match lA with
  | [] -> lB
  | [aHead, ...aTail] ->
    match lB with
    | [] -> lA
    | [bHead, ...bTail] ->
      (interleave(aTail, bTail))
      |> prepend(bHead)
      |> prepend(aHead)


/// Returns the passed list, with only unique values, where uniqueness is based
/// on the result of <param fn>. The first value for each {{fn value}} is kept,
/// in the order it appeared.
///
/// Keeps what it has seen in a <type Dict> keyed on {{fn value}}, so uniqueness
/// is decided by <type Dict> key comparison rather than by
/// {{==}}, and a {{fn value}} no <type Dict> can key (a lambda, a stream, a
/// {{NaN}}) raises.
/// Takes O(n²) time (O(n log n) in the interpreter).
let uniqueBy(list: List<'a>, fn: 'a -> 'b): List<'a> =
  list
  |> fold(([], Dict { }), fun((unique, seen), value) ->
    let uniqueValue = fn(value)

    if Stdlib.Dict.containsKey(seen, uniqueValue) then
      (unique, seen)
    else
      (prepend(unique, value),
       Stdlib.Dict.set(seen, uniqueValue, true)))
  |> fun((uniqueValues, _)) -> uniqueValues
  |> reverse


/// Returns the passed list, with only unique values. The first occurrence of
/// each value is kept, in the order it appeared; pipe into <fn sort> if you
/// want them ordered. Values are compared with {{==}}.
/// Takes O(n²) time (O(n) in the interpreter).
let unique(list: List<'a>): List<'a> = Builtin.listUnique(list)


/// Returns true if <param list> has no values
/// Takes O(1) time.
let isEmpty(list: List<'a>): Bool = Builtin.listIsEmpty(list)


/// Returns a copy of <param list> with every value sorted in ascending order.
/// A type with its own `Compare` implementation is ordered the way `<` orders it, and values
/// equal under it keep their order; every other value is sorted structurally.
/// `Bytes` values are sorted shortest first, then by their hash, not by their
/// contents. The order is the same every time, but `[0x01]` does not
/// necessarily come before `[0x02]`.
/// Consider <fn sortBy> or <fn sortWith> if you need more
/// control over the sorting process.
/// Takes O(n²) time (O(n log n) in the interpreter).
let sort(list: List<'a>): List<'a> = Builtin.listSort(list)


/// Returns a copy of <param list>, sorted in ascending order, as if each value
/// evaluated to {{fn(val)}}.
/// For example, {{sortBy(["x", "jkl", "ab"], fun v -> String.length(v))}}
/// returns {{["x", "ab", "jkl"]}}.
/// Consider <fn sort> if the list values can be directly compared, or <fn
/// sortWith> if you want more control over the sorting process.
/// Takes O(n²) time (O(n log n) in the interpreter).
let sortBy(list: List<'a>, fn: 'a -> 'b): List<'a> =
  Builtin.listSortBy(list, fn)


/// Returns a copy of <param list>, sorted using {{fn(a, b)}} to compare values
/// <var a> and <var b>.
/// <param fn> returns {{Less}} if <var a> should appear before <var b>,
/// {{Greater}} if it should appear after, and {{Equal}} if their order doesn't
/// matter. The sort is stable: values that compare {{Equal}} keep the order they
/// had in <param list>.
/// Consider <fn sort> or <fn sortBy> if you don't need this level of control.
/// Takes O(n log n) time.
let sortWith(list: List<'a>, fn: ('a, 'a) -> Ordering): List<'a> =
  // `acc` is what has been merged so far, newest first.
  let merge(left: List<'a>, right: List<'a>, acc: List<'a>): List<'a> =
    match (left, right) with
    | ([], _) -> concat(reverse(acc), right)
    | (_, []) -> concat(reverse(acc), left)
    | ([x, ...xs], [y, ...ys]) ->
      // Only a left value that is strictly greater gives way, which is what
      // keeps equal values in their original order.
      match fn(x, y) with
      | Greater -> merge(left, ys, prepend(acc, y))
      | _ -> merge(xs, right, prepend(acc, x))

  // Halves are contiguous runs, not alternating values, so every value in
  // `left` came before every value in `right`.
  let mergeSort(lst: List<'a>, len: Int64): List<'a> =
    if len <= 1 then
      lst
    else
      let half = len / 2
      let sortedLeft = mergeSort(take(lst, half), half)
      let sortedRight = mergeSort(drop(lst, half), len - half)
      merge(sortedLeft, sortedRight, [])

  mergeSort(list, length(list))




/// Return {{true}} if all elements in the list meet the function's criteria, else {{false}}
/// Takes O(n) time.
let all(list: List<'a>, fn: 'a -> Bool): Bool =
  // The first element `fn` fails is the first one `any` of its opposite stops at, so `fn` runs
  // on the same elements, in order, and `any` spreads it across cores when it is worth it.
  if any(list, fun item -> if fn(item) then false else true) then false else true


/// Return {{true}} if any elements in the list meet the function's criteria, else {{false}}
/// Takes O(n) time.
let any(list: List<'a>, fn: 'a -> Bool): Bool =
  Builtin.listAny(list, fn)


/// Calls <param f> on every <var val> in <param list>, returning a list of only
/// those values for which {{fn val}} returns {{true}}.
/// Preserves the order of values that were not dropped. Consider <fn
/// filterMap> if you also want to transform the values.
/// Takes O(n) time.
let filter(list: List<'a>, f: 'a -> Bool): List<'a> =
  Builtin.listFilter(list, f)


/// Calls <param fn> on every <var val> in <param list>, returning a list that
/// drops some values (filter) and transforms others (map).
/// If {{fn val}} returns {{None}}, drops <var val> from the list.
/// If {{fn val}} returns {{Some newValue}}, replaces <var val> with <var newValue>.
/// Preserves the order of values that were not dropped.
/// This function combines <fn filter> and <fn map>.
/// Takes O(n) time.
let filterMap(
  list: List<'a>,
  fn: 'a -> Option.Option<'b>)
  : List<'b> =
  Builtin.listFilterMap(list, fn)


/// Removes the first element equal to <param x> from <param list>.
/// Returns the list unchanged if no such element exists.
/// Takes O(n) time.
let remove(list: List<'a>, x: 'a): List<'a> =
  match list with
  | [] -> []
  | [head, ...tail] ->
    if head == x then tail else prepend(remove(tail, x), head)


/// Removes the element at zero-based index <param i> from <param list>.
/// Returns the list unchanged if <param i> is negative or out of range.
/// Takes O(n) time.
let removeAt(list: List<'a>, i: Int64): List<'a> =
  if i < 0 then
    list
  else
    match list with
    | [] -> []
    | [head, ...tail] ->
      if i == 0 then tail else prepend(removeAt(tail, i - 1), head)


/// Drops the first <param count> values from <param list>
/// Takes O(n) time (O(1) in the interpreter).
let drop(list: List<'a>, count: Int64): List<'a> = Builtin.listDrop(list, count)


/// Drops the longest prefix of <param list> which satisfies the predicate <param val>
/// Takes O(n) time.
let dropWhile(list: List<'a>, fn: 'a -> Bool): List<'a> =
  match list with
  | [] -> []
  | [head, ...tail] -> if (fn(head)) then dropWhile(tail, fn) else list


/// Drops the last value from <param list>
/// Takes O(n) time.
let dropLast(list: List<'a>): List<'a> =
  match list with
  | [] -> []
  | [head, ...tail] ->
    match tail with
    | [] -> []
    | _ -> prepend(dropLast(tail), head)


/// Drops all but the first <param count> values from <param list>
/// Takes O(n) time.
let take(list: List<'a>, count: Int64): List<'a> =
  Builtin.listTake(list, count)


/// Return the longest prefix of <param list> which satisfies the predicate <param fn>
/// Takes O(n) time.
let takeWhile(list: List<'a>, fn: 'a -> Bool): List<'a> =
  match list with
  | [] -> []
  | [head, ...tail] ->
    if (fn(head)) then
      prepend(takeWhile(tail, fn), head)
    else
      []


/// Calls <param fn> on every <var val> in <param list>, returning a list of the
/// results of those calls.
/// Consider <fn filterMap> if you also want to drop some of the values.
/// Takes O(n) time.
let map(list: List<'a>, fn: 'a -> 'b): List<'b> =
  Builtin.listMap(list, fn)


/// <fn map>, with every call of <param fn> as a process of its own, spread across the cores,
/// and the results in order. The way to overlap writes: plain <fn map> runs them one after
/// another. Computation and reads already overlap under plain <fn map>. Built on
/// <fn Stdlib.Exec.spawn>.
/// Takes O(n) time.
let parallelMap(list: List<'a>, fn: 'a -> 'b): List<'b> =
  list
  |> Stdlib.List.map(fun x -> Stdlib.Exec.spawn(fun () -> fn(x)))
  |> Stdlib.List.map(fun handle -> Stdlib.Exec.await(handle))


/// Calls <fn fn> on every <var val> and its <var index> in <param list>,
/// returning a list of the results of those calls.
/// Consider <fn map> if you don't need the index.
/// Takes O(n) time.
let indexedMap(list: List<'a>, fn: (Int64, 'a) -> 'b): List<'b> =
  Builtin.listIndexedMap(list, fn)


/// Maps <param fn> over <param as> and <param bs> in parallel, calling {{fn a
/// b}} on every pair of values from <param as> and <param bs>.
/// If the lists differ in length, values from the longer list are dropped.
/// For example, if <param as> is {{[1,2]}} and <param bs> is
/// {{["x", "y", "z"]}}, returns {{[fn 1 "x", fn 2 "y"]}}.
/// Use <fn map2> if you want to enforce equivalent lengths for <param as>
/// and <param bs>.
/// Takes O(n) time.
let map2Shortest(
  as_: List<'a>,
  bs: List<'b>,
  fn: ('a, 'b) -> 'c)
  : List<'c> =
  Builtin.listMap2shortest(as_, bs, fn)


/// What <fn zip> and <fn map2> return when their two lists differ in length: the
/// length of each.
type LengthMismatch =
  { left: Int64
    right: Int64 }


/// If the lists are the same length, returns {{Ok list}} formed by mapping
/// <param fn> over <param as> and <param bs> in parallel, calling {{fn a b}} on
/// every pair of values from <param as> and <param bs>.
/// For example, if <param as> is {{[1,2,3]}} and <param bs> is
/// {{["x", "y", "z"]}}, returns {{Ok [fn 1 "x", fn 2 "y", fn 3 "z"]}}.
/// If the lists differ in length, returns {{Error}} with both lengths (consider
/// <fn map2Shortest> if you want to drop values from the longer list instead).
/// Takes O(n) time.
let map2(
  as_: List<'a>,
  bs: List<'b>,
  fn: ('a, 'b) -> 'c)
  : Result.Result<List<'c>, LengthMismatch> =
  let left = length(as_)
  let right = length(bs)

  if left != right then
    Result.Result.Error(LengthMismatch { left = left, right = right })
  else
    Result.Result.Ok(map2Shortest(as_, bs, fn))


/// Returns a list of parallel pairs from <param as> and <param bs>.
/// If the lists differ in length, values from the longer list are dropped.
/// For example, if <param as> is {{[1,2]}} and <param bs> is
/// {{["x", "y", "z"]}}, returns {{[(1, "x"), (2, "y")]}}.
/// Use <fn zip> if you want to enforce equivalent lengths for <param as>
/// and <param bs>.
/// See <fn unzip> if you want to deconstruct the result into <param as>
/// and <param bs> again.
/// Takes O(n) time.
let zipShortest(as_: List<'a>, bs: List<'b>): List<('a * 'b)> =
  Builtin.listZipShortest(as_, bs)


/// If the lists have the same length, returns {{Ok list of tuples}} formed from
/// parallel pairs in <param l1> and <param l2>.
/// For example, if <param l1> is {{[1,2,3]}} and <param l2> is
/// {{["x", "y", "z"]}}, returns {{Ok [(1, "x"), (2, "y"), (3, "z")]}}.
/// See <fn unzip> if you want to deconstruct <var list> into <param l1>
/// and <param l2> again.
/// If the lists differ in length, returns {{Error}} with both lengths (consider
/// <fn zipShortest> if you want to drop values from the longer list instead).
/// Takes O(n) time.
let zip(
  l1: List<'a>,
  l2: List<'b>)
  : Result.Result<List<('a * 'b)>, LengthMismatch> =
  // The lengths once, then one native zip, rather than recursing and measuring both lengths
  // again at every level, which is quadratic in the length.
  let left = length(l1)
  let right = length(l2)

  if left != right then
    Result.Result.Error(LengthMismatch { left = left, right = right })
  else
    Result.Result.Ok(zipShortest(l1, l2))


/// Given a <param pairs> list where each value is a tuple of two values (such
/// lists are constructed by <fn zip> and <fn zipShortest>), returns
/// a tuple of two lists, one with every first value, and one with every second
/// value.
/// For example, if <param pairs> is {{[(1, "x"), (2, "y"), (3, "z")]}}, returns
/// {{([1, 2, 3], ["x", "y", "z"])}}.
/// Takes O(n) time.
let unzip(pairs: List<('a * 'b)>): (List<'a> * List<'b>) =
  match pairs with
  | [] -> ([], [])
  | [(a, b), ...tail] ->
    let (firsts, seconds) = unzip(tail)

    (prepend(firsts, a), prepend(seconds, b))


/// Returns {{Some value}} at <param index> in <param list> if <param index> is
/// less than the length of the list otherwise returns {{None}}.
/// Takes O(log n) time.
let getAt(list: List<'a>, index: Int64): Option.Option<'a> =
  Builtin.listGetAt(list, index)


type IndexError =
  /// The resolved index was outside the bounds of the list.
  | IndexOutOfBounds

/// Returns {{Ok}} <param list> with the value at <param index> replaced by
/// <param value>. Negative indexes count backward from the end of the list, so
/// {{-1}} replaces the last value and {{-2}} replaces the second-to-last value.
/// Returns {{Error IndexOutOfBounds}} if the resolved index is outside the list.
/// Takes O(n) time (O(log n) in the interpreter).
let setAt(
  list: List<'a>,
  index: Int64,
  value: 'a)
  : Result.Result<List<'a>, IndexError> =
  let listLength = length(list)
  let resolvedIndex = if index < 0 then listLength + index else index

  if resolvedIndex < 0 || resolvedIndex >= listLength then
    Result.Result.Error(IndexError.IndexOutOfBounds)
  else
    Result.Result.Ok(Builtin.listSetAt(list, resolvedIndex, value))


/// Returns {{Some <var randomValue>}}, where <var randomValue> is a randomly
/// selected value in <param list>. Returns {{None}} if <param list> is
/// empty.
/// Takes O(log n) time.
let randomElement(list: List<'a>): Option.Option<'a> =
  match list with
  | [] -> Option.Option.None
  | _ -> getAt(list, Stdlib.Int64.random(0, length(list) - 1))


/// Returns <param list> in a random order using Fisher–Yates.
/// Preserves every element, including duplicates.
/// Takes O(n log n) time.
let shuffle(list: List<'a>): List<'a> =
  let last = length(list) - 1
  let start = Stdlib.Dict.fromEntries(indexedMap(list, fun(i, v) -> (i, v)))
  // From the last position down to the second, swap each with a uniformly chosen position at or
  // before it.
  let shuffled =
    fold(reverse(range(1, last)), start, fun(items, i) ->
      let j = Stdlib.Int64.random(0, i)
      match (Stdlib.Dict.get(items, i), Stdlib.Dict.get(items, j)) with
      | (Some(atI), Some(atJ)) -> Stdlib.Dict.set(Stdlib.Dict.set(items, i, atJ), j, atI)
      | _ -> items)
  filterMap(range(0, last), fun(i) -> Stdlib.Dict.get(shuffled, i))


/// Groups <param list> into tuples (key, elements), where the key is computed by applying
/// <param fn> to each element in the list.
/// For example, if <param list> is {{[1, 2, 3, 4, 5]}} and <param fn>
/// is {{fn item -> item % 2}}, returns {{[(1, [1, 3, 5]), (0, [2, 4])]}}.
/// Preserves the order of values and of the keys.
/// Takes O(n²) time (O(n log n) in the interpreter).
let groupBy(list: List<'a>, fn: 'a -> 'b): List<('b * List<'a>)> =
  // Each group is looked up in a Dict rather than scanned for, and built back to front; the
  // keys are kept separately, in the order first seen, since a Dict lists its own sorted.
  let (groups, keys) =
    fold(list, (Dict { }, []), fun((groups, keys), element) ->
      let key = fn(element)

      match Stdlib.Dict.get(groups, key) with
      | Some(elements) ->
        (Stdlib.Dict.set(groups, key, prepend(elements, element)), keys)
      | None -> (Stdlib.Dict.set(groups, key, [ element ]), prepend(keys, key)))

  keys
  |> reverse
  |> map(fun key ->
    match Stdlib.Dict.get(groups, key) with
    | Some(elements) -> (key, reverse(elements))
    | None -> (key, []))


/// Calls <param f> on every <var val> in <param list>, splitting the list into
/// two - those values for which {{fn val}} returns {{true}}, and those that
/// return {{false}}
/// Takes O(n) time.
let partition(ls: List<'a>, f: 'a -> Bool): (List<'a> * List<'a>) =
  // `f` runs from the last value to the first, as it did when this recursed, and through `map`,
  // which spreads it across cores when it is worth it.
  let backwards = reverse(ls)

  fold(zipShortest(backwards, map(backwards, f)), ([], []), fun((trueList, falseList), (value, keep)) ->
    if keep then
      (prepend(trueList, value), falseList)
    else
      (trueList, prepend(falseList, value)))


/// Applies the given function <param fn> to each element of the <param list>.
/// Takes O(n) time.
let iter(list: List<'a>, f: 'a -> Unit): Unit =
  // fold reruns its lambda in one frame; recursing here was a call and a list split per value
  fold(list, (), fun (_, value) -> f(value))


type ChunkBySizeError = | SizeMustBeGreaterThanZero

/// Chunks <param list> into sublists of specified maximum <param size>.
/// If <param size> is less than or equal to zero, returns an error
/// Takes O(n) time.
let chunkBySize(
  list: List<'a>,
  size: Int64)
  : Result.Result<List<List<'a>>, ChunkBySizeError> =
  if size <= 0 then
    Result.Result.Error(
      ChunkBySizeError.SizeMustBeGreaterThanZero)
  else
    let chunk(remaining: List<'a>, chunks: List<List<'a>>): List<List<'a>> =
      match remaining with
      | [] -> reverse(chunks)
      | _ ->
        let taken = take(remaining, size)
        let rest = drop(remaining, size)
        chunk(rest, prepend(chunks, taken))

    Result.Result.Ok(chunk(list, []))


/// Returns {{Some}} of every value but the last, and the last value, or {{None}}
/// if <param l> is empty.
/// Takes O(n) time.
let splitLast(l: List<'a>): Option.Option<(List<'a> * 'a)> =
  match reverse(l) with
  | [] -> Option.Option.None
  | [head, ...tail] -> Option.Option.Some((reverse(tail), head))
