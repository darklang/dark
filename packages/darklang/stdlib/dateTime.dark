/// Work with dates and times in UTC. Values can be as little as 100 nanoseconds
/// (one tick) apart. Two values are equal only when they match exactly, down to
/// the tick, even if they look the same when printed.
/// For example, `Stdlib.DateTime.__fromTicks(0) == Stdlib.DateTime.__fromTicks(0)`
/// is `true`, but `Stdlib.DateTime.__fromTicks(0) == Stdlib.DateTime.__fromTicks(1)`
/// is `false`: a difference of just 100 nanoseconds makes them unequal.
module Darklang.Stdlib.DateTime

/// A day of the week. <fn Weekday.toNumber> numbers them as ISO 8601 does, from Monday = {{1}} to Sunday = {{7}}.
type Weekday =
  | Monday
  | Tuesday
  | Wednesday
  | Thursday
  | Friday
  | Saturday
  | Sunday


module Weekday =
  /// The ISO 8601 number of <param day>, from Monday = {{1}} to Sunday = {{7}}
  let toNumber(day: Weekday): UInt8 =
    match day with
    | Monday -> 1u8
    | Tuesday -> 2u8
    | Wednesday -> 3u8
    | Thursday -> 4u8
    | Friday -> 5u8
    | Saturday -> 6u8
    | Sunday -> 7u8


  /// The weekday numbered <param n> by ISO 8601 (Monday = {{1}} to Sunday = {{7}}), or {{None}} for any other number
  let fromNumber(n: UInt8): Option<Weekday> =
    match n with
    | 1u8 -> Option.Some(Weekday.Monday)
    | 2u8 -> Option.Some(Weekday.Tuesday)
    | 3u8 -> Option.Some(Weekday.Wednesday)
    | 4u8 -> Option.Some(Weekday.Thursday)
    | 5u8 -> Option.Some(Weekday.Friday)
    | 6u8 -> Option.Some(Weekday.Saturday)
    | 7u8 -> Option.Some(Weekday.Sunday)
    | _ -> Option.None


impl Display for Weekday =
  /// The day's name, {{Monday}}
  let display(day: Weekday): String =
    match day with
    | Monday -> "Monday"
    | Tuesday -> "Tuesday"
    | Wednesday -> "Wednesday"
    | Thursday -> "Thursday"
    | Friday -> "Friday"
    | Saturday -> "Saturday"
    | Sunday -> "Sunday"


/// A month of the year. <fn Month.toNumber> numbers them from January = {{1}} to December = {{12}}.
type Month =
  | January
  | February
  | March
  | April
  | May
  | June
  | July
  | August
  | September
  | October
  | November
  | December


module Month =
  /// The number of <param month>, from January = {{1}} to December = {{12}}
  let toNumber(month: Month): UInt8 =
    match month with
    | January -> 1u8
    | February -> 2u8
    | March -> 3u8
    | April -> 4u8
    | May -> 5u8
    | June -> 6u8
    | July -> 7u8
    | August -> 8u8
    | September -> 9u8
    | October -> 10u8
    | November -> 11u8
    | December -> 12u8


  /// The month numbered <param n> (January = {{1}} to December = {{12}}), or {{None}} for any other number
  let fromNumber(n: UInt8): Option<Month> =
    match n with
    | 1u8 -> Option.Some(Month.January)
    | 2u8 -> Option.Some(Month.February)
    | 3u8 -> Option.Some(Month.March)
    | 4u8 -> Option.Some(Month.April)
    | 5u8 -> Option.Some(Month.May)
    | 6u8 -> Option.Some(Month.June)
    | 7u8 -> Option.Some(Month.July)
    | 8u8 -> Option.Some(Month.August)
    | 9u8 -> Option.Some(Month.September)
    | 10u8 -> Option.Some(Month.October)
    | 11u8 -> Option.Some(Month.November)
    | 12u8 -> Option.Some(Month.December)
    | _ -> Option.None


impl Display for Month =
  /// The month's name, {{January}}
  let display(month: Month): String =
    match month with
    | January -> "January"
    | February -> "February"
    | March -> "March"
    | April -> "April"
    | May -> "May"
    | June -> "June"
    | July -> "July"
    | August -> "August"
    | September -> "September"
    | October -> "October"
    | November -> "November"
    | December -> "December"


// A DateTime is a count of 100ns ticks since the Unix epoch, read and built by the two
// builtins below. Apart from `toString`, which stays native because telemetry calls it on every
// keystroke, everything else is arithmetic on that count, over the proleptic Gregorian calendar.
// Follows Paul's compiler stdlib (`dateTime.dark`).

let __ticks(date: DateTime): Int64 =
  Builtin.dateTimeToUnixTicks(date)


/// Raises "out of DateTime range" outside -9998-01-01 to 9999-12-31.
let __fromTicks(ticks: Int64): DateTime =
  __fromOffset(0, ticks, 1)


let __ticksPerMillisecond(): Int64 = 10000

let __ticksPerSecond(): Int64 = 10000000

let __ticksPerMinute(): Int64 = 600000000

let __ticksPerHour(): Int64 = 36000000000

let __ticksPerDay(): Int64 = 864000000000


/// The DateTime <param count> units of <param unit> ticks each after <param ticks>. Raises with
/// <param count> outside -9998-01-01 to 9999-12-31.
let __fromOffset(ticks: Int64, count: Int64, unit: Int64): DateTime =
  Builtin.dateTimeFromUnixTicks(ticks, count, unit)


/// `/` and `%` by a positive divisor, which every caller here passes.
/// A plain match rather than `Result.withDefault`: these run a dozen times per calendar field, and
/// the generic call cost more than the division.
let __div(value: Int64, divisor: Int64): Int64 =
  match Int64.checkedDivide(value, divisor) with
  | Ok(q) -> q
  | Error(_) -> 0


let __mod(value: Int64, divisor: Int64): Int64 =
  match Int64.checkedMod(value, divisor) with
  | Ok(r) -> r
  | Error(_) -> 0


/// `/` on Int64s rounds toward zero; dates before 1970 need it to round down.
let __floorDiv(value: Int64, divisor: Int64): Int64 =
  __div(value - __mod(value, divisor), divisor)


let __daysSinceEpoch(date: DateTime): Int64 =
  __floorDiv(__ticks(date), __ticksPerDay())


let __ticksWithinDay(date: DateTime): Int64 =
  __mod(__ticks(date), __ticksPerDay())


/// A calendar or clock field, which the caller has already bounded.
let __field8(n: Int64): UInt8 =
  UInt8.fromInt64(n) |> Builtin.unwrap


/// Days since 1970-01-01 of a civil date.
let __daysFromCivil(year: Int64, month: Int64, day: Int64): Int64 =
  let y = if month <= 2 then year - 1 else year
  let era = __floorDiv(y, 400)
  let yearOfEra = y - era * 400
  let m = if month > 2 then month - 3 else month + 9
  let dayOfYear = __div(153 * m + 2, 5) + day - 1
  let dayOfEra = yearOfEra * 365 + __div(yearOfEra, 4) - __div(yearOfEra, 100) + dayOfYear
  era * 146097 + dayOfEra - 719468


/// (year, month, day) of a count of days since 1970-01-01.
let __civilFromDays(days: Int64): (Int64 * Int64 * Int64) =
  let shifted = days + 719468
  let era = __floorDiv(shifted, 146097)
  let dayOfEra = shifted - era * 146097
  let yearOfEra =
    __div(dayOfEra - __div(dayOfEra, 1460) + __div(dayOfEra, 36524) - __div(dayOfEra, 146096), 365)

  let dayOfYear = dayOfEra - (365 * yearOfEra + __div(yearOfEra, 4) - __div(yearOfEra, 100))
  let mp = __div(5 * dayOfYear + 2, 153)
  let day = dayOfYear - __div(153 * mp + 2, 5) + 1
  let month = if mp < 10 then mp + 3 else mp - 9
  let year = if month <= 2 then yearOfEra + era * 400 + 1 else yearOfEra + era * 400
  (year, month, day)


/// <param endDate> minus <param startDate> in whole units of <param ticksPerUnit> ticks,
/// rounded half to even.
let __roundedDifference(endDate: DateTime, startDate: DateTime, ticksPerUnit: Int64): Int64 =
  let ticks = __ticks(endDate) - __ticks(startDate)
  let whole = __floorDiv(ticks, ticksPerUnit)
  let twiceRest = (ticks - whole * ticksPerUnit) * 2
  if twiceRest > ticksPerUnit || twiceRest == ticksPerUnit && __mod(whole, 2) == 1 then
    whole + 1
  else
    whole


/// Why a string cannot be parsed as a date and time.
type ParseError =
  /// The input does not use a supported ISO 8601 format, time or UTC offset.
  | InvalidFormat
  /// The input uses a supported format, but its year, month or day is not a valid calendar date.
  | InvalidDate


impl Display for ParseError =
  /// A readable explanation of the parse failure.
  let display(error: ParseError): String =
    match error with
    | InvalidFormat -> "Invalid date format; expected YYYY-MM-DD or an ISO 8601 timestamp"
    | InvalidDate -> "Invalid calendar date"


/// Parses an ISO 8601 date and time: {{YYYY-MM-DDTHH:mm:ssZ}} or {{YYYY-MM-DDTHH:mm:ss.fffZ}},
/// where {{Z}} can also be an offset from UTC such as {{+02:00}} or {{-05:30}}, or a plain
/// {{YYYY-MM-DD}} date as midnight UTC. The result is in UTC. Returns {{Error InvalidDate}}
/// for an impossible calendar date, or {{Error InvalidFormat}} for other rejected input.
let parse(s: String): Result<DateTime, ParseError> =
  Builtin.dateTimeParse(s)


/// The date as {{YYYYMMDD}}. A year before 1 gets a leading {{-}}, as {{format}} writes it.
let __basicDate(date: DateTime): String =
  let (year, month, day) = __civilFromDays(__daysSinceEpoch(date))
  let yearText = if year < 0 then "-" + zeroPadded(0 - year, 4) else zeroPadded(year, 4)
  yearText + zeroPadded(month, 2) + zeroPadded(day, 2)


/// The time of day as {{hhmmss}}.
let __basicTime(date: DateTime): String =
  let ticks = __ticksWithinDay(date)
  zeroPadded(__div(ticks, __ticksPerHour()), 2)
  + zeroPadded(__mod(__div(ticks, __ticksPerMinute()), 60), 2)
  + zeroPadded(__mod(__div(ticks, __ticksPerSecond()), 60), 2)


impl Display for DateTime =
  /// Stringify <param date> to the ISO 8601 format {{YYYY-MM-DD'T'hh:mm:ss'Z'}}
  let display(date: DateTime): String =
    Builtin.dateTimeToString(date)


/// Stringify <param date> to the ISO 8601 basic format {{YYYYMMDD'T'hhmmss'Z'}}
let toStringISO8601BasicDateTime(date: DateTime): String =
  __basicDate(date) + "T" + __basicTime(date) + "Z"


/// Stringify <param date> to the ISO 8601 basic format YYYYMMDD
let toStringISO8601BasicDate(date: DateTime): String =
  __basicDate(date)


/// Returns the current time
let now(): DateTime =
  __now()


/// Returns the <type DateTime> with the time set to midnight
let today(): DateTime =
  __today()


/// Returns a <type DateTime> <param seconds> seconds after <param d>
let addSeconds(d: DateTime, seconds: Int64): DateTime =
  __fromOffset(__ticks(d), seconds, __ticksPerSecond())


/// Returns a <type DateTime> <param seconds> seconds before <param d>
let subtractSeconds(d: DateTime, seconds: Int64): DateTime =
  __fromOffset(__ticks(d), -seconds, __ticksPerSecond())


/// Returns whether {{<param d1> > <param d2>}}
let greaterThan(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) > __ticks(d2)


/// Returns whether {{<param d1> < <param d2>}}
let lessThan(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) < __ticks(d2)


/// Returns whether {{<param d1> >= <param d2>}}
let greaterThanOrEqualTo(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) >= __ticks(d2)


/// Returns whether {{<param d1> <= <param d2>}}
let lessThanOrEqualTo(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) <= __ticks(d2)


/// `d1 < d2` on DateTimes, by the four comparisons above.
impl Compare for DateTime =
  let lessThan = Stdlib.DateTime.lessThan

  let lessThanOrEqualTo = Stdlib.DateTime.lessThanOrEqualTo

  let greaterThan = Stdlib.DateTime.greaterThan

  let greaterThanOrEqualTo = Stdlib.DateTime.greaterThanOrEqualTo


/// Converts <param date> to an <type Int64> representing seconds since the Unix epoch: a Unix
/// timestamp
let toSeconds(date: DateTime): Int64 =
  __floorDiv(__ticks(date), __ticksPerSecond())


/// Converts an <type Int64> representing seconds since the Unix epoch (a Unix timestamp) into a
/// <type DateTime>
let fromSeconds(seconds: Int64): DateTime =
  __fromOffset(0, seconds, __ticksPerSecond())


/// Returns the year portion of <param date> as an <type Int64>
let year(date: DateTime): Int64 =
  (__civilFromDays(__daysSinceEpoch(date))).1


/// Returns the month of <param date>
let month(date: DateTime): Month =
  __field8((__civilFromDays(__daysSinceEpoch(date))).2)
  |> Month.fromNumber
  |> Builtin.unwrap


/// Returns the day portion of <param date> as a <type UInt8> between {{1}} and {{31}}
let day(date: DateTime): UInt8 =
  __field8((__civilFromDays(__daysSinceEpoch(date))).3)


/// Returns the weekday of <param date>
let weekday(date: DateTime): Weekday =
  __field8((__daysSinceEpoch(date) + 3) % 7 + 1)
  |> Weekday.fromNumber
  |> Builtin.unwrap


/// Returns the hour portion of <param date> as a <type UInt8> between {{0}} and {{23}}
let hour(date: DateTime): UInt8 =
  __field8(__ticksWithinDay(date) / __ticksPerHour())


/// Returns the minute portion of <param date> as a <type UInt8> between {{0}} and {{59}}
let minute(date: DateTime): UInt8 =
  __field8(__ticksWithinDay(date) / __ticksPerMinute() % 60)


/// Returns the second portion of <param date> as a <type UInt8> between {{0}} and {{59}}
let second(date: DateTime): UInt8 =
  __field8(__ticksWithinDay(date) / __ticksPerSecond() % 60)


/// Returns <type date> with the time set to midnight
let atStartOfDay(date: DateTime): DateTime =
  __fromTicks(__daysSinceEpoch(date) * __ticksPerDay())


/// Returns <param d1> minus <param d2> as a duration, rounded to whole seconds.
/// Half-second ties round to the nearest even second.
let subtract(d1: DateTime, d2: DateTime): Duration.Duration =
  __roundedDifference(d1, d2, __ticksPerSecond()) |> Duration.fromSeconds


/// The signed number of days from the UTC date of <param d2> to the UTC date of <param d1>.
/// Ignores time of day: two instants on the same UTC date return {{0}}, while crossing
/// midnight counts as one day even when less than 24 hours elapsed. Negative for earlier dates.
let daysBetween(d1: DateTime, d2: DateTime): Int64 =
  __daysSinceEpoch(d1) - __daysSinceEpoch(d2)


/// Converts <param date> to an <type Int64> representing milliseconds since the Unix epoch
let toMilliseconds(date: DateTime): Int64 =
  __floorDiv(__ticks(date), __ticksPerMillisecond())


/// Converts an <type Int64> representing milliseconds since the Unix epoch into a <type DateTime>
let fromMilliseconds(milliseconds: Int64): DateTime =
  __fromOffset(0, milliseconds, __ticksPerMillisecond())


/// Returns a <type DateTime> <param milliseconds> milliseconds after <param d>
let addMilliseconds(d: DateTime, milliseconds: Int64): DateTime =
  __fromOffset(__ticks(d), milliseconds, __ticksPerMillisecond())


/// Returns a <type DateTime> <param milliseconds> milliseconds before <param d>
let subtractMilliseconds(d: DateTime, milliseconds: Int64): DateTime =
  __fromOffset(__ticks(d), -milliseconds, __ticksPerMillisecond())


/// A part of a date and time, as <fn DateTime.fromParts> takes them.
type Part =
  | Year
  | Month
  | Day
  | Hour
  | Minute
  | Second


impl Display for Part =
  /// The part's name in lowercase, {{year}}
  let display(part: Part): String =
    match part with
    | Year -> "year"
    | Month -> "month"
    | Day -> "day"
    | Hour -> "hour"
    | Minute -> "minute"
    | Second -> "second"


/// Why <fn DateTime.fromParts> cannot build a date and time, or <fn DateTime.daysInMonth> has
/// no month to measure.
type FromPartsError =
  /// <param part> is <param value>, outside {{min}} to {{max}}. For a day, {{max}} is the
  /// last day of that month.
  | OutOfRange(part: Part, value: Int64, min: Int64, max: Int64)


impl Display for FromPartsError =
  /// {{day 30 is out of range; it must be 1 to 29}}
  let display(error: FromPartsError): String =
    match error with
    | OutOfRange(part, value, min, max) ->
      Stdlib.display(part)
      + " "
      + Stdlib.display(value)
      + " is out of range; it must be "
      + Stdlib.display(min)
      + " to "
      + Stdlib.display(max)


/// Whether <param year> has a February 29: {{true}} for 2000 and 2024, {{false}} for 1900 and 2023.
let isLeapYear(year: Int64): Bool =
  __mod(year, 4) == 0 && __mod(year, 100) != 0 || __mod(year, 400) == 0


/// The number of days in <param month> ({{1}} to {{12}}) of <param year>, such as {{29}} for
/// February in a leap year. {{Error OutOfRange}} for a month outside {{1}} to {{12}}.
let daysInMonth(year: Int64, month: Int64): Result<Int64, FromPartsError> =
  if month < 1 || month > 12 then
    Result.Error(FromPartsError.OutOfRange(Part.Month, month, 1, 12))
  else if month == 2 then
    Result.Ok(if isLeapYear(year) then 29 else 28)
  else if month == 4 || month == 6 || month == 9 || month == 11 then
    Result.Ok(30)
  else
    Result.Ok(31)


/// The UTC <type DateTime> for <param year>, <param month> ({{1}} to {{12}}), <param day>,
/// <param hour>, <param minute> and <param second>. {{Error OutOfRange}} names the first part
/// out of range, such as day {{29}} of February in a year that is not a leap year, or a year
/// outside {{-9998}} to {{9999}}.
let fromParts(
  year: Int64,
  month: Int64,
  day: Int64,
  hour: Int64,
  minute: Int64,
  second: Int64)
  : Result<DateTime, FromPartsError> =
  let lastDay =
    match daysInMonth(year, month) with
    | Ok(days) -> days
    | Error(_) -> 31

  let limits =
    [ (Part.Year, year, -9998, 9999)
      (Part.Month, month, 1, 12)
      (Part.Day, day, 1, lastDay)
      (Part.Hour, hour, 0, 23)
      (Part.Minute, minute, 0, 59)
      (Part.Second, second, 0, 59) ]

  let outOfRange = List.findFirst(limits, fun limit ->
    let (_, value, min, max) = limit
    value < min || value > max)

  match outOfRange with
  | Some((part, value, min, max)) -> Result.Error(FromPartsError.OutOfRange(part, value, min, max))
  | None ->
    let seconds = __daysFromCivil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
    Result.Ok(fromSeconds(seconds))


/// Returns a <type DateTime> <param days> days after <param d>, or before it for a negative
/// <param days>
let addDays(d: DateTime, days: Int64): DateTime =
  __fromOffset(__ticks(d), days, __ticksPerDay())


/// <param d> moved by <param months> calendar months, at the same time of day, or back for a
/// negative <param months>. A day past the end of the new month becomes its last day: one month
/// after January 31 is February 28, or 29 in a leap year.
let addMonths(d: DateTime, months: Int64): DateTime =
  let (year, month, day) = __civilFromDays(__daysSinceEpoch(d))
  let total = year * 12 + month - 1 + months
  let newYear = __floorDiv(total, 12)
  let newMonth = __mod(total, 12) + 1
  let lastDay =
    match daysInMonth(newYear, newMonth) with
    | Ok(days) -> days
    | Error(_) -> 28

  let newDay = if day > lastDay then lastDay else day
  __fromOffset(__ticksWithinDay(d), __daysFromCivil(newYear, newMonth, newDay), __ticksPerDay())


// Checked versions of the functions above that build a DateTime from a count. A DateTime runs
// from -9998-01-01 to 9999-12-31; past either end those raise, and these return {{Error Overflow}}.

/// The DateTime <param count> units of <param unit> ticks each after <param ticks>, or
/// {{Error Overflow}} outside the DateTime range.
let __checkedOffset(ticks: Int64, count: BigInt, unit: Int64): Result<DateTime, Math.Overflow> =
  let total = BigInt.fromInt64(ticks) + count * BigInt.fromInt64(unit)
  // -9998-01-01T00:00:00Z and 9999-12-31T23:59:59.9999999Z
  if total < -3776735808000000000z || total > 2534023007999999999z then
    Result.Error(Math.Overflow.Overflow)
  else
    match BigInt.toInt64(total) with
    | Some(t) -> Result.Ok(__fromTicks(t))
    | None -> Result.Error(Math.Overflow.Overflow)


/// A <type DateTime> <param seconds> seconds after <param d>, as <fn DateTime.addSeconds>
/// returns, or {{Error Overflow}} past the DateTime range
let checkedAddSeconds(d: DateTime, seconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(__ticks(d), BigInt.fromInt64(seconds), __ticksPerSecond())


/// A <type DateTime> <param seconds> seconds before <param d>, as <fn DateTime.subtractSeconds>
/// returns, or {{Error Overflow}} past the DateTime range
let checkedSubtractSeconds(d: DateTime, seconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(__ticks(d), 0z - BigInt.fromInt64(seconds), __ticksPerSecond())


/// The <type DateTime> <param seconds> seconds after the Unix epoch, as
/// <fn DateTime.fromSeconds> returns, or {{Error Overflow}} past the DateTime range
let checkedFromSeconds(seconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(0, BigInt.fromInt64(seconds), __ticksPerSecond())


/// A <type DateTime> <param milliseconds> milliseconds after <param d>, as
/// <fn DateTime.addMilliseconds> returns, or {{Error Overflow}} past the DateTime range
let checkedAddMilliseconds(d: DateTime, milliseconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(__ticks(d), BigInt.fromInt64(milliseconds), __ticksPerMillisecond())


/// A <type DateTime> <param milliseconds> milliseconds before <param d>, as
/// <fn DateTime.subtractMilliseconds> returns, or {{Error Overflow}} past the DateTime range
let checkedSubtractMilliseconds(d: DateTime, milliseconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(__ticks(d), 0z - BigInt.fromInt64(milliseconds), __ticksPerMillisecond())


/// The <type DateTime> <param milliseconds> milliseconds after the Unix epoch, as
/// <fn DateTime.fromMilliseconds> returns, or {{Error Overflow}} past the DateTime range
let checkedFromMilliseconds(milliseconds: Int64): Result<DateTime, Math.Overflow> =
  __checkedOffset(0, BigInt.fromInt64(milliseconds), __ticksPerMillisecond())


/// Returns the millisecond portion of <param date> as a <type UInt16> between {{0}} and {{999}}
let millisecond(date: DateTime): UInt16 =
  UInt16.fromInt64(__ticksWithinDay(date) / __ticksPerMillisecond() % 1000) |> Builtin.unwrap


/// Returns the difference of the two dates, in milliseconds
let subtractMs(d1: DateTime, d2: DateTime): Int64 =
  __roundedDifference(d1, d2, __ticksPerMillisecond())


/// Writes <param n> with leading zeros up to <param width> digits
let zeroPadded(n: Int64, width: Int64): String =
  String.padStart(display(n), '0', width)


/// The fields a {{format}} pattern can name, worked out once per call rather than once per
/// directive: the calendar date alone takes a dozen divisions.
type __Fields =
  { year: Int64
    month: Int64
    day: Int64
    ticksWithinDay: Int64 }


let __fieldsOf(date: DateTime, pattern: String): __Fields =
  // a pattern with only clock fields skips the calendar
  let (y, m, d) =
    if
      String.contains(pattern, "%Y")
      || String.contains(pattern, "%m")
      || String.contains(pattern, "%d")
    then
      __civilFromDays(__daysSinceEpoch(date))
    else
      (0, 0, 0)

  __Fields { year = y, month = m, day = d, ticksWithinDay = __ticksWithinDay(date) }


/// The text for one {{format}} directive (the character after {{%}}), or {{None}} if it is not a directive
let __formatDirective(f: __Fields, directive: Char): Option<String> =
  let t = f.ticksWithinDay
  match directive with
  | 'Y' ->
    Option.Some(if f.year < 0 then "-" + zeroPadded(0 - f.year, 4) else zeroPadded(f.year, 4))
  | 'm' -> Option.Some(zeroPadded(f.month, 2))
  | 'd' -> Option.Some(zeroPadded(f.day, 2))
  | 'H' -> Option.Some(zeroPadded(__div(t, __ticksPerHour()), 2))
  | 'M' -> Option.Some(zeroPadded(__mod(__div(t, __ticksPerMinute()), 60), 2))
  | 'S' -> Option.Some(zeroPadded(__mod(__div(t, __ticksPerSecond()), 60), 2))
  | 'f' -> Option.Some(zeroPadded(__mod(__div(t, __ticksPerMillisecond()), 1000), 3))
  | '%' -> Option.Some("%")
  | _ -> Option.None


/// Writes <param chars> of a {{format}} pattern after <param written> (kept in reverse order)
let __formatChars(
  date: __Fields,
  chars: List<Char>,
  written: List<String>)
  : Result<String, String> =
  match chars with
  | [] -> Result.Ok(String.join(List.reverse(written), ""))
  | ['%'] -> Result.Error("The pattern ends in a lone %; write %% for a literal %")
  | ['%', directive, ...rest] ->
    match __formatDirective(date, directive) with
    | Some(text) -> __formatChars(date, rest, List.prepend(written, text))
    | None ->
      Result.Error(
        "Unknown directive %"
        + String.fromChar(directive)
        + "; the directives are %Y %m %d %H %M %S %f %%")
  | [c, ...rest] -> __formatChars(date, rest, List.prepend(written, String.fromChar(c)))


/// Writes <param date> (always UTC) using <param pattern>, where each directive is
/// replaced by a zero-padded field and every other character is copied as is:
/// {{%Y}} year, four digits ({{0001}}; negative years get a leading {{-}}),
/// {{%m}} month {{01}}-{{12}}, {{%d}} day {{01}}-{{31}},
/// {{%H}} hour {{00}}-{{23}}, {{%M}} minute {{00}}-{{59}}, {{%S}} second {{00}}-{{59}},
/// {{%f}} milliseconds {{000}}-{{999}} (truncated, not rounded), {{%%}} a literal {{%}}.
/// Any other {{%}} sequence, or a lone {{%}} at the end, is an {{Error}}.
/// For example, {{format(d, "%Y-%m-%d %H:%M:%S.%f")}} gives {{Ok("2019-07-28 22:42:36.500")}}.
let format(date: DateTime, pattern: String): Result<String, String> =
  // `HH:mm:ss` has no directive, so it would come back unchanged: refuse it instead
  let foreign = [ "yyyy", "YYYY", "HH", "hh", "mm", "ss", "dd", "MM" ]
  if
    Bool.not(String.contains(pattern, "%"))
    && List.any(foreign, fun f -> String.contains(pattern, f))
  then
    Result.Error(
      $"`{pattern}` has no % directive, so it would print as written; the directives are %Y %m %d %H %M %S %f %%")
  else
    __formatChars(__fieldsOf(date, pattern), String.toList(pattern), [])


/// Why <fn DateTime.parseWith> could not read a date and time from its text
type PatternParseError =
  /// The pattern has a {{%}} sequence that is not a directive, or ends in a lone {{%}}.
  /// The {{String}} is the sequence as written, such as {{"%Q"}} or {{"%"}}.
  | UnknownDirective(String)
  /// The pattern names the same field twice, such as {{"%d/%d"}}, which could hide an
  /// impossible date behind a later value. The {{String}} is the directive, such as
  /// {{"%d"}}. {{%%}} may appear any number of times.
  | RepeatedDirective(String)
  /// The text stops matching the pattern at this character position, counting from 0: a
  /// literal character differs, a directive finds no digits there, or text is left over
  | Mismatch(Int64)
  /// Every field matched, but together they name no real moment: February 30th, hour 24,
  /// an offset of {{+25:00}}, or a time outside -9998-01-01 to 9999-12-31 in UTC
  | InvalidDate


impl Display for PatternParseError =
  /// A readable explanation of the parse failure.
  let display(error: PatternParseError): String =
    match error with
    | UnknownDirective(sequence) ->
      let known =
        __parseDirectives
        |> String.toList
        |> List.map(fun c -> "%" + String.fromChar(c))
        |> String.join(" ")

      $"Unknown directive {sequence}; the directives are {known}"
    | RepeatedDirective(directive) -> $"The pattern uses {directive} more than once"
    | Mismatch(position) -> $"The text does not match the pattern at character {position}"
    | InvalidDate -> "Invalid calendar date or time"


/// The characters that may follow {{%}} in a <fn DateTime.parseWith> pattern
val __parseDirectives: String = "YmdHMSfz%"


/// The fields <fn DateTime.parseWith> has read so far. The offset is kept as written (sign,
/// hours, minutes), so an impossible one like {{+25:00}} can be rejected at the end.
type __Parsed =
  { year: Int64
    month: Int64
    day: Int64
    hour: Int64
    minute: Int64
    second: Int64
    fractionTicks: Int64
    offsetSign: Int64
    offsetHours: Int64
    offsetMinutes: Int64 }


/// The value of an ASCII digit 0-9, or {{None}} for anything else, digits of other scripts
/// included
let __asciiDigit(c: Char): Option<Int64> =
  match Char.toAsciiCode(c) with
  | Some(code) when code >= 48u8 && code <= 57u8 -> Option.Some(UInt8.toInt64(code) - 48)
  | _ -> Option.None


/// Reads up to <param most> digits from the start of <param text>. Returns the number, how
/// many digits it has, and the rest of the text.
let __readDigits(text: List<Char>, most: Int64): (Int64 * Int64 * List<Char>) =
  __readMoreDigits(text, most, 0, 0)


/// <fn DateTime.__readDigits>, continuing a number <param value> that already has
/// <param count> digits
let __readMoreDigits(
  text: List<Char>,
  most: Int64,
  value: Int64,
  count: Int64)
  : (Int64 * Int64 * List<Char>) =
  match text with
  | [c, ...rest] when count < most ->
    match __asciiDigit(c) with
    | Some(digit) -> __readMoreDigits(rest, most, value * 10 + digit, count + 1)
    | None -> (value, count, text)
  | _ -> (value, count, text)


/// Reads 1 to <param most> digits and passes their value to <param set>. {{None}} if
/// <param text> does not start with a digit.
let __readField(
  text: List<Char>,
  most: Int64,
  set: Int64 -> __Parsed)
  : Option<(__Parsed * List<Char>)> =
  let (value, count, rest) = __readDigits(text, most)
  if count == 0 then Option.None else Option.Some((set(value), rest))


/// A fraction of a second, written as <param count> digits, in ticks. A <type DateTime>
/// keeps 7 digits; any after the seventh are dropped.
let __fractionTicks(digits: Int64, count: Int64): Int64 =
  if count <= 7 then
    digits * 10 ** (7 - count)
  else
    __div(digits, 10 ** (count - 7))


/// The {{%z}} offset at the front of <param text>: {{Z}}, or a sign and four digits with an
/// optional colon, {{+0530}} or {{-05:30}}
let __readOffset(text: List<Char>, p: __Parsed): Option<(__Parsed * List<Char>)> =
  match text with
  | ['Z', ...rest] ->
    Option.Some(({ p with offsetSign = 1, offsetHours = 0, offsetMinutes = 0 }, rest))
  | [sign, ...afterSign] when sign == '+' || sign == '-' ->
    let (hours, hourDigits, afterHours) = __readDigits(afterSign, 2)
    let afterColon =
      match afterHours with
      | [':', ...rest] -> rest
      | _ -> afterHours

    let (minutes, minuteDigits, rest) = __readDigits(afterColon, 2)
    if hourDigits == 2 && minuteDigits == 2 then
      let offsetSign = if sign == '-' then -1 else 1
      Option.Some(
        ({ p with offsetSign = offsetSign, offsetHours = hours, offsetMinutes = minutes }, rest))
    else
      Option.None
  | _ -> Option.None


/// Reads the text for one directive (the character after {{%}}). Returns the updated fields
/// and the rest of the text, or {{None}} if the text does not match.
let __parseDirective(
  directive: Char,
  text: List<Char>,
  p: __Parsed)
  : Option<(__Parsed * List<Char>)> =
  match directive with
  | 'Y' ->
    match text with
    | ['-', ...rest] -> __readField(rest, 4, fun n -> { p with year = -n })
    | _ -> __readField(text, 4, fun n -> { p with year = n })
  | 'm' -> __readField(text, 2, fun n -> { p with month = n })
  | 'd' -> __readField(text, 2, fun n -> { p with day = n })
  | 'H' -> __readField(text, 2, fun n -> { p with hour = n })
  | 'M' -> __readField(text, 2, fun n -> { p with minute = n })
  | 'S' -> __readField(text, 2, fun n -> { p with second = n })
  | 'f' ->
    let (digits, count, rest) = __readDigits(text, 9)
    if count == 0 then
      Option.None
    else
      Option.Some(({ p with fractionTicks = __fractionTicks(digits, count) }, rest))
  | 'z' -> __readOffset(text, p)
  | _ ->
    // %%, the only other directive __checkPattern allows
    match text with
    | ['%', ...rest] -> Option.Some((p, rest))
    | _ -> Option.None


/// {{Ok}} if every {{%}} in <param pattern> starts a directive <fn DateTime.parseWith>
/// supports, and none but {{%%}} appears twice. <param seen> holds the directives so far.
let __checkPattern(pattern: List<Char>, seen: List<Char>): Result<Unit, PatternParseError> =
  match pattern with
  | [] -> Result.Ok()
  | ['%'] -> Result.Error(PatternParseError.UnknownDirective("%"))
  | ['%', directive, ...rest] ->
    let written = "%" + String.fromChar(directive)
    if Bool.not(String.contains(__parseDirectives, String.fromChar(directive))) then
      Result.Error(PatternParseError.UnknownDirective(written))
    else if directive == '%' then
      __checkPattern(rest, seen)
    else if List.contains(seen, directive) then
      Result.Error(PatternParseError.RepeatedDirective(written))
    else
      __checkPattern(rest, [ directive, ...seen ])
  | [_, ...rest] -> __checkPattern(rest, seen)


/// Matches the rest of <param text> against the rest of <param pattern>. <param total> is
/// the length of the whole text, to say where a mismatch is.
let __parseChars(
  pattern: List<Char>,
  text: List<Char>,
  total: Int64,
  p: __Parsed)
  : Result<__Parsed, PatternParseError> =
  // where the text stops matching, counted only once it has
  let here = fun _ -> Result.Error(PatternParseError.Mismatch(total - List.length(text)))
  match pattern with
  | [] ->
    match text with
    | [] -> Result.Ok(p)
    | _ -> here()
  | ['%', directive, ...rest] ->
    match __parseDirective(directive, text, p) with
    | Some((parsed, remaining)) -> __parseChars(rest, remaining, total, parsed)
    | None -> here()
  | [c, ...rest] ->
    match text with
    | [t, ...remaining] when t == c -> __parseChars(rest, remaining, total, p)
    | _ -> here()


/// The moment the fields name, or {{Error InvalidDate}} where they name none
let __parsedToDateTime(p: __Parsed): Result<DateTime, PatternParseError> =
  let days = __daysFromCivil(p.year, p.month, p.day)
  let monthInRange = p.month >= 1 && p.month <= 12 && p.day >= 1
  let realDate = monthInRange && __civilFromDays(days) == (p.year, p.month, p.day)
  let realTime = p.hour <= 23 && p.minute <= 59 && p.second <= 59
  let realOffset = p.offsetHours <= 23 && p.offsetMinutes <= 59
  let offsetTicks =
    p.offsetSign * (p.offsetHours * __ticksPerHour() + p.offsetMinutes * __ticksPerMinute())

  let clockTicks =
    p.hour * __ticksPerHour() + p.minute * __ticksPerMinute() + p.second * __ticksPerSecond()

  let ticks = days * __ticksPerDay() + clockTicks + p.fractionTicks - offsetTicks
  let first = __daysFromCivil(-9998, 1, 1) * __ticksPerDay()
  let pastLast = __daysFromCivil(10000, 1, 1) * __ticksPerDay()
  if realDate && realTime && realOffset && ticks >= first && ticks < pastLast then
    Result.Ok(__fromTicks(ticks))
  else
    Result.Error(PatternParseError.InvalidDate)


/// What <fn DateTime.parseWith> starts from: 1970-01-01T00:00:00Z, for the fields a pattern
/// leaves out
val __epochFields: __Parsed =
  __Parsed
    { year = 1970
      month = 1
      day = 1
      hour = 0
      minute = 0
      second = 0
      fractionTicks = 0
      offsetSign = 1
      offsetHours = 0
      offsetMinutes = 0 }


/// Reads a date and time from <param text> laid out as <param pattern>, the reverse of
/// <fn DateTime.format>. Each directive reads a number, and every other character must
/// appear in the text as written:
/// {{%Y}} year, up to four digits, {{-}} before it for years before 1,
/// {{%m}} month, {{%d}} day, {{%H}} hour, {{%M}} minute, {{%S}} second, each one or two digits,
/// {{%f}} a fraction of a second, 1 to 9 digits (kept to the 7 a <type DateTime> holds),
/// {{%z}} {{Z}} or an offset from UTC such as {{+0530}} or {{-05:30}}, {{%%}} a literal {{%}}.
/// Each field reads as many digits as it can, up to its maximum count, whatever their value:
/// {{"%m%d"}} reads {{"0415"}} as April 15, {{"%d1"}} cannot read {{"21"}} as day 2, and
/// {{"%H%M"}} reads {{"915"}} as hour 91, an {{InvalidDate}}.
/// A pattern may use each directive once, except {{%%}}.
/// Fields the pattern leaves out default to 1970-01-01T00:00:00Z. The result is in UTC.
/// For example, {{parseWith("2019-07-28 22:42", "%Y-%m-%d %H:%M")}} is
/// {{Ok(2019-07-28T22:42:00Z)}}.
let parseWith(text: String, pattern: String): Result<DateTime, PatternParseError> =
  let patternChars = String.toList(pattern)
  match __checkPattern(patternChars, []) with
  | Error(e) -> Result.Error(e)
  | Ok(_) ->
    let textChars = String.toList(text)
    match __parseChars(patternChars, textChars, List.length(textChars), __epochFields) with
    | Error(e) -> Result.Error(e)
    | Ok(p) -> __parsedToDateTime(p)


// Shared clock implementation.
/// Clock record decoding, scaling and interrupted-sleep retries in shared Dark.
let __timespec(bytes: Bytes): Result<(Int64 * Int64), Cli.Posix.Error> =
  let width = if Cli.Posix.__abiArm32() then 4 else 8
  Cli.Posix.__kernelSignedField(bytes, 0, width)
  |> Result.andThen(fun seconds ->
    Cli.Posix.__kernelSignedField(bytes, width, width) |> Result.map(fun nanos -> (seconds, nanos)))


let __realtimeNanoseconds(): Result<(Int64 * Int64), Cli.Posix.Error> =
  if Builtin.runtimeTargetOS() == "browser" then
    let ticks = Builtin.runtimeRealtimeTicks()
    Result.Ok((ticks / 10000000, ticks % 10000000 * 100))
  else if Cli.Posix.__abiMac() then
    Builtin.syscallGettimeofday()
    |> Result.mapError(Cli.Posix.__fromErrno)
    |> Result.andThen(fun bytes ->
      Cli.Posix.__kernelSignedField(bytes, 0, 8)
      |> Result.andThen(fun seconds ->
        Cli.Posix.__kernelSignedField(bytes, 8, 4)
        |> Result.map(fun micros -> (seconds, micros * 1000))))
  else
    Builtin.syscallClockGettime(0)
    |> Result.mapError(Cli.Posix.__fromErrno)
    |> Result.andThen(__timespec)


let __monotonicNanoseconds(): Result<(Int64 * Int64), Cli.Posix.Error> =
  if Builtin.runtimeTargetOS() == "browser" then
    let (ticks, frequency) = Builtin.runtimeMonotonicCounter()
    if frequency <= 0 then
      Result.Error(Cli.Posix.Error.BadKernelReply)
    else
      Result.Ok((ticks / frequency, ticks % frequency * 1000000000 / frequency))
  else if Cli.Posix.__abiMac() then
    Builtin.syscallMachAbsoluteTime()
    |> Result.mapError(Cli.Posix.__fromErrno)
    |> Result.andThen(fun bytes ->
      Cli.Posix.__kernelField(bytes, 0, 8)
      |> Result.andThen(fun ticks ->
        Builtin.syscallMachTimebaseInfo()
        |> Result.mapError(Cli.Posix.__fromErrno)
        |> Result.andThen(fun base ->
          Cli.Posix.__kernelField(base, 0, 4)
          |> Result.andThen(fun numerator ->
            Cli.Posix.__kernelField(base, 4, 4)
            |> Result.andThen(fun denominator ->
              if denominator == 0 then
                Result.Error(Cli.Posix.Error.BadKernelReply)
              else
                let nanos =
                  ticks / denominator * numerator + ticks % denominator * numerator / denominator

                Result.Ok((nanos / 1000000000, nanos % 1000000000)))))))
  else
    Builtin.syscallClockGettime(1)
    |> Result.mapError(Cli.Posix.__fromErrno)
    |> Result.andThen(__timespec)


/// When the clock syscall fails, the runtime's own clock answers.
let __monotonicMilliseconds(): Int64 =
  match __monotonicNanoseconds() with
  | Ok((seconds, nanos)) -> seconds * 1000 + __div(nanos, 1000000)
  | Error(_) ->
    let (ticks, frequency) = Builtin.runtimeMonotonicCounter()
    __div(ticks, frequency) * 1000 + __div(__mod(ticks, frequency) * 1000, frequency)


/// When the clock syscall fails, the runtime's own clock answers.
let __now(): DateTime =
  match __realtimeNanoseconds() with
  | Ok((seconds, nanos)) -> __fromTicks(seconds * 10000000 + __div(nanos, 100))
  | Error(_) -> __fromTicks(Builtin.runtimeRealtimeTicks())


let __today(): DateTime =
  let seconds = toSeconds(__now())
  let remainder = seconds % 86400
  let start = if remainder < 0 then seconds - remainder - 86400 else seconds - remainder
  fromSeconds(start)


let __sleepWith(
  sleep: (Int64, Int64) -> (Int64 * Bytes),
  seconds: Int64,
  nanos: Int64)
  : Result<Unit, Cli.Posix.Error> =
  let (rc, remaining) = sleep(seconds, nanos)
  if rc == 0 then
    Result.Ok()
  else if rc == -4 then
    __timespec(remaining)
    |> Result.andThen(fun pair ->
      let (seconds, nanos) = pair
      __sleepWith(sleep, seconds, nanos))
  else
    Result.Error(Cli.Posix.__fromErrno(0 - rc))


let __sleepNanoseconds(seconds: Int64, nanos: Int64): Result<Unit, Cli.Posix.Error> =
  __sleepWith(Builtin.syscallNanosleep, seconds, nanos)


/// Zero, negative and NaN waits return at once; one past what an Int64 of nanoseconds holds waits
/// that long.
let __sleepMilliseconds(milliseconds: Float64): Unit =
  let nanos =
    if milliseconds > 0.0 then
      Int64.fromFloat64(milliseconds * 1000000.0) |> Result.withDefault(9223372036854775807)
    else
      0

  if Builtin.runtimeTargetOS() == "browser" then
    Builtin.runtimeDelayTicks(nanos / 100)
  else
    __sleepNanoseconds(nanos / 1000000000, nanos % 1000000000) |> Result.withDefault(())
