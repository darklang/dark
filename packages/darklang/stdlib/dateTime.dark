/// Work with dates and times in UTC. Values can be as little as 100 nanoseconds
/// (one tick) apart. Two values are equal only when they match exactly, down to
/// the tick, even if they look the same when printed.
/// For example, `Stdlib.DateTime.__fromTicks(0) == Stdlib.DateTime.__fromTicks(0)`
/// is `true`, but `Stdlib.DateTime.__fromTicks(0) == Stdlib.DateTime.__fromTicks(1)`
/// is `false`: a difference of just 100 nanoseconds makes them unequal.
module Darklang.Stdlib.DateTime


/// A day of the week. <fn Weekday.toNumber> numbers them as ISO 8601 does, from Monday = {{1}} to Sunday = {{7}}.
type Weekday =
  | Monday
  | Tuesday
  | Wednesday
  | Thursday
  | Friday
  | Saturday
  | Sunday


module Weekday =
  /// The ISO 8601 number of <param day>, from Monday = {{1}} to Sunday = {{7}}
  let toNumber(day: Weekday): UInt8 =
    match day with
    | Monday -> 1u8
    | Tuesday -> 2u8
    | Wednesday -> 3u8
    | Thursday -> 4u8
    | Friday -> 5u8
    | Saturday -> 6u8
    | Sunday -> 7u8

  /// The weekday numbered <param n> by ISO 8601 (Monday = {{1}} to Sunday = {{7}}), or {{None}} for any other number
  let fromNumber(n: UInt8): Stdlib.Option.Option<Weekday> =
    match n with
    | 1u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Monday)
    | 2u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Tuesday)
    | 3u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Wednesday)
    | 4u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Thursday)
    | 5u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Friday)
    | 6u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Saturday)
    | 7u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Weekday.Sunday)
    | _ -> Stdlib.Option.Option.None


/// A month of the year. <fn Month.toNumber> numbers them from January = {{1}} to December = {{12}}.
type Month =
  | January
  | February
  | March
  | April
  | May
  | June
  | July
  | August
  | September
  | October
  | November
  | December


module Month =
  /// The number of <param month>, from January = {{1}} to December = {{12}}
  let toNumber(month: Month): UInt8 =
    match month with
    | January -> 1u8
    | February -> 2u8
    | March -> 3u8
    | April -> 4u8
    | May -> 5u8
    | June -> 6u8
    | July -> 7u8
    | August -> 8u8
    | September -> 9u8
    | October -> 10u8
    | November -> 11u8
    | December -> 12u8

  /// The month numbered <param n> (January = {{1}} to December = {{12}}), or {{None}} for any other number
  let fromNumber(n: UInt8): Stdlib.Option.Option<Month> =
    match n with
    | 1u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.January)
    | 2u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.February)
    | 3u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.March)
    | 4u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.April)
    | 5u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.May)
    | 6u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.June)
    | 7u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.July)
    | 8u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.August)
    | 9u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.September)
    | 10u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.October)
    | 11u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.November)
    | 12u8 -> Stdlib.Option.Option.Some(Stdlib.DateTime.Month.December)
    | _ -> Stdlib.Option.Option.None


// A DateTime is a count of 100ns ticks since the Unix epoch, read and built by the two
// builtins below. Apart from `toString`, which stays native because telemetry calls it on every
// keystroke, everything else is arithmetic on that count, over the proleptic Gregorian calendar.
// Follows Paul's compiler stdlib (`dateTime.dark`).

let __ticks(date: DateTime): Int64 = Builtin.dateTimeToUnixTicks(date)

/// Raises "an out-of-range integer value" outside -9998-01-01 to 9999-12-31.
let __fromTicks(ticks: Int64): DateTime = Builtin.dateTimeFromUnixTicks(ticks)

let __ticksPerMillisecond(): Int64 = 10000
let __ticksPerSecond(): Int64 = 10000000
let __ticksPerMinute(): Int64 = 600000000
let __ticksPerHour(): Int64 = 36000000000
let __ticksPerDay(): Int64 = 864000000000

/// <param count> units of <param unit> ticks each, moved from <param ticks>.
/// Past Int64 it saturates rather than wraps: a saturated count is past every
/// DateTime too, so `__fromTicks` refuses it as out of range.
let __offset(ticks: Int64, count: Int64, unit: Int64): Int64 =
  let saturate(r: Stdlib.Result.Result<Int64, Stdlib.Math.Overflow>): Int64 =
    match r with
    | Ok(t) -> t
    | Error(_) -> if count < 0 then -9223372036854775808 else 9223372036854775807
  saturate(Stdlib.Int64.checkedAdd(ticks, saturate(Stdlib.Int64.checkedMultiply(count, unit))))

/// `/` on Int64s rounds toward zero; dates before 1970 need it to round down.
let __floorDiv(value: Int64, divisor: Int64): Int64 = (value - value % divisor) / divisor

let __daysSinceEpoch(date: DateTime): Int64 =
  __floorDiv(__ticks(date), __ticksPerDay())

let __ticksWithinDay(date: DateTime): Int64 = __ticks(date) % __ticksPerDay()

/// A calendar or clock field, which the caller has already bounded.
let __field8(n: Int64): UInt8 = Stdlib.UInt8.fromInt64(n) |> Builtin.unwrap

/// Days since 1970-01-01 of a civil date.
let __daysFromCivil(year: Int64, month: Int64, day: Int64): Int64 =
  let y = if month <= 2 then year - 1 else year
  let era = __floorDiv(y, 400)
  let yearOfEra = y - era * 400
  let m = if month > 2 then month - 3 else month + 9
  let dayOfYear = (153 * m + 2) / 5 + day - 1
  let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
  era * 146097 + dayOfEra - 719468

/// (year, month, day) of a count of days since 1970-01-01.
let __civilFromDays(days: Int64): (Int64 * Int64 * Int64) =
  let shifted = days + 719468
  let era = __floorDiv(shifted, 146097)
  let dayOfEra = shifted - era * 146097
  let yearOfEra =
    (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
  let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
  let mp = (5 * dayOfYear + 2) / 153
  let day = dayOfYear - (153 * mp + 2) / 5 + 1
  let month = if mp < 10 then mp + 3 else mp - 9
  let year = if month <= 2 then yearOfEra + era * 400 + 1 else yearOfEra + era * 400
  (year, month, day)

/// A difference in whole units, computed in floating point as the host's durations do
/// (days times units-per-day, plus the rest of the day) and rounded half to even.
let __roundedDifference(
  endDate: DateTime,
  startDate: DateTime,
  unitsPerDay: Int64,
  nanosPerUnit: Float)
  : Int64 =
  let nanosPerDay = 86400000000000
  let nanos = (__ticks(endDate) - __ticks(startDate)) * 100
  let days = __floorDiv(nanos, nanosPerDay)
  let nanoOfDay = nanos % nanosPerDay
  Stdlib.Float.round((
    Stdlib.Int64.toFloat(days * unitsPerDay)
    + Stdlib.Int64.toFloat(nanoOfDay) / nanosPerUnit
  ))

let __digit(c: Char): Stdlib.Option.Option<Int64> =
  match c with
  | '0' -> Stdlib.Option.Option.Some(0)
  | '1' -> Stdlib.Option.Option.Some(1)
  | '2' -> Stdlib.Option.Option.Some(2)
  | '3' -> Stdlib.Option.Option.Some(3)
  | '4' -> Stdlib.Option.Option.Some(4)
  | '5' -> Stdlib.Option.Option.Some(5)
  | '6' -> Stdlib.Option.Option.Some(6)
  | '7' -> Stdlib.Option.Option.Some(7)
  | '8' -> Stdlib.Option.Option.Some(8)
  | '9' -> Stdlib.Option.Option.Some(9)
  | _ -> Stdlib.Option.Option.None

let __number(digits: List<Char>): Stdlib.Option.Option<Int64> =
  Stdlib.List.fold(digits, Stdlib.Option.Option.Some(0), fun(acc, c) ->
    match (acc, __digit(c)) with
    | (Some(n), Some(d)) -> Stdlib.Option.Option.Some(n * 10 + d)
    | _ -> Stdlib.Option.Option.None)

let __isLeapYear(year: Int64): Bool =
  (year % 4 == 0 && year % 100 != 0) || year % 400 == 0

let __daysInMonth(year: Int64, month: Month): Int64 =
  match month with
  | February -> if __isLeapYear(year) then 29 else 28
  | April -> 30
  | June -> 30
  | September -> 30
  | November -> 30
  | _ -> 31

let __fromParts(
  year: List<Char>,
  month: List<Char>,
  day: List<Char>,
  hour: List<Char>,
  minute: List<Char>,
  second: List<Char>,
  millisecond: List<Char>)
  : Stdlib.Result.Result<DateTime, String> =
  match
    (__number(year),
     __number(month),
     __number(day),
     __number(hour),
     __number(minute),
     __number(second),
     __number(millisecond))
  with
  | (Some(y), Some(mo), Some(d), Some(h), Some(mi), Some(s), Some(ms)) ->
    let valid =
      match Stdlib.UInt8.fromInt64(mo) |> Stdlib.Option.andThen(Month.fromNumber) with
      | Some(month) ->
        y >= 1
        && d >= 1
        && d <= __daysInMonth(y, month)
        && h <= 23
        && mi <= 59
        && s <= 59
      | None -> false
    if valid then
      let ticks =
        __daysFromCivil(y, mo, d) * __ticksPerDay()
        + h * __ticksPerHour()
        + mi * __ticksPerMinute()
        + s * __ticksPerSecond()
        + ms * __ticksPerMillisecond()
      Stdlib.Result.Result.Ok(__fromTicks(ticks))
    else
      Stdlib.Result.Result.Error("Invalid date format")
  | _ -> Stdlib.Result.Result.Error("Invalid date format")


/// Parses a string representing a date and time in the ISO 8601 format exactly {{" + ISO8601Format+ "}}
/// (for example: 2019-09-07T22:44:25Z) and returns the {{Date}} wrapped in a {{Result}}.
let parse(s: String): Stdlib.Result.Result<DateTime, String> =
  match Stdlib.String.toList(s) with
  | [ y1, y2, y3, y4, '-', mo1, mo2, '-', d1, d2, 'T', h1, h2, ':', mi1, mi2, ':', s1, s2, 'Z' ] ->
    __fromParts([ y1, y2, y3, y4 ], [ mo1, mo2 ], [ d1, d2 ], [ h1, h2 ], [ mi1, mi2 ], [ s1, s2 ], [])
  | [ y1, y2, y3, y4, '-', mo1, mo2, '-', d1, d2, 'T', h1, h2, ':', mi1, mi2, ':', s1, s2, '.', f1, f2, f3, 'Z' ] ->
    __fromParts(
      [ y1, y2, y3, y4 ],
      [ mo1, mo2 ],
      [ d1, d2 ],
      [ h1, h2 ],
      [ mi1, mi2 ],
      [ s1, s2 ],
      [ f1, f2, f3 ])
  | _ -> Stdlib.Result.Result.Error("Invalid date format")


/// The date as {{YYYYMMDD}}. A year before 1 gets a leading {{-}}, as {{format}} writes it.
let __basicDate(date: DateTime): String =
  let (year, month, day) = __civilFromDays(__daysSinceEpoch(date))
  let yearText = if year < 0 then "-" + zeroPadded(0 - year, 4) else zeroPadded(year, 4)
  yearText + zeroPadded(month, 2) + zeroPadded(day, 2)

/// The time of day as {{hhmmss}}.
let __basicTime(date: DateTime): String =
  let ticks = __ticksWithinDay(date)
  zeroPadded(ticks / __ticksPerHour(), 2)
  + zeroPadded((ticks / __ticksPerMinute()) % 60, 2)
  + zeroPadded((ticks / __ticksPerSecond()) % 60, 2)


impl ToString for DateTime =
  /// Stringify <param date> to the ISO 8601 format {{YYYY-MM-DD'T'hh:mm:ss'Z'}}
  let toString(date: DateTime): String = Builtin.dateTimeToString(date)


/// Stringify <param date> to the ISO 8601 basic format {{YYYYMMDD'T'hhmmss'Z'}}
let toStringISO8601BasicDateTime(date: DateTime): String =
  __basicDate(date) + "T" + __basicTime(date) + "Z"


/// Stringify <param date> to the ISO 8601 basic format YYYYMMDD
let toStringISO8601BasicDate(date: DateTime): String = __basicDate(date)


/// Returns the current time
let now(): DateTime = Stdlib.DateTime.__now()


/// Returns the <type DateTime> with the time set to midnight
let today(): DateTime = Stdlib.DateTime.__today()


/// Returns a <type DateTime> <param seconds> seconds after <param d>
let addSeconds(d: DateTime, seconds: Int64): DateTime =
  __fromTicks(__offset(__ticks(d), seconds, __ticksPerSecond()))


/// Returns a <type DateTime> <param seconds> seconds before <param d>
let subtractSeconds(d: DateTime, seconds: Int64): DateTime =
  __fromTicks(__offset(__ticks(d), -seconds, __ticksPerSecond()))


/// Returns whether {{<param d1> > <param d2>}}
let greaterThan(d1: DateTime, d2: DateTime): Bool = __ticks(d1) > __ticks(d2)


/// Returns whether {{<param d1> < <param d2>}}
let lessThan(d1: DateTime, d2: DateTime): Bool = __ticks(d1) < __ticks(d2)


/// Returns whether {{<param d1> >= <param d2>}}
let greaterThanOrEqualTo(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) >= __ticks(d2)


/// Returns whether {{<param d1> <= <param d2>}}
let lessThanOrEqualTo(d1: DateTime, d2: DateTime): Bool =
  __ticks(d1) <= __ticks(d2)

/// `d1 < d2` on DateTimes, by the four comparisons above.
impl Compare for DateTime =
  let lessThan = Stdlib.DateTime.lessThan
  let lessThanOrEqualTo = Stdlib.DateTime.lessThanOrEqualTo
  let greaterThan = Stdlib.DateTime.greaterThan
  let greaterThanOrEqualTo = Stdlib.DateTime.greaterThanOrEqualTo


/// Converts <param date> to an <type Int64> representing seconds since the Unix epoch
let toSeconds(date: DateTime): Int64 = __floorDiv(__ticks(date), __ticksPerSecond())


/// Converts an <type Int64> representing seconds since the Unix epoch into a <type DateTime>
let fromSeconds(seconds: Int64): DateTime =
  __fromTicks(__offset(0, seconds, __ticksPerSecond()))


/// Returns the year portion of <param date> as an <type Int64>
let year(date: DateTime): Int64 = (__civilFromDays(__daysSinceEpoch(date))).1


/// Returns the month of <param date>
let month(date: DateTime): Month =
  __field8((__civilFromDays(__daysSinceEpoch(date))).2)
  |> Month.fromNumber
  |> Builtin.unwrap


/// Returns the day portion of <param date> as a <type UInt8> between {{1}} and {{31}}
let day(date: DateTime): UInt8 =
  __field8((__civilFromDays(__daysSinceEpoch(date))).3)


/// Returns the weekday of <param date>
let weekday(date: DateTime): Weekday =
  __field8((__daysSinceEpoch(date) + 3) % 7 + 1)
  |> Weekday.fromNumber
  |> Builtin.unwrap


/// Returns the hour portion of <param date> as a <type UInt8> between {{0}} and {{23}}
let hour(date: DateTime): UInt8 =
  __field8(__ticksWithinDay(date) / __ticksPerHour())


/// Returns the minute portion of <param date> as a <type UInt8> between {{0}} and {{59}}
let minute(date: DateTime): UInt8 =
  __field8((__ticksWithinDay(date) / __ticksPerMinute()) % 60)


/// Returns the second portion of <param date> as a <type UInt8> between {{0}} and {{59}}
let second(date: DateTime): UInt8 =
  __field8((__ticksWithinDay(date) / __ticksPerSecond()) % 60)


/// Returns <type date> with the time set to midnight
let atStartOfDay(date: DateTime): DateTime =
  __fromTicks(__daysSinceEpoch(date) * __ticksPerDay())


/// Returns <param d1> minus <param d2> as a duration, rounded to whole seconds.
/// Half-second ties round to the nearest even second.
let subtract(d1: DateTime, d2: DateTime): Stdlib.Duration.Duration =
  __roundedDifference(d1, d2, 86400, 1000000000.0)
  |> Stdlib.Duration.fromSeconds()


/// Converts <param date> to an <type Int64> representing milliseconds since the Unix epoch
let toMilliseconds(date: DateTime): Int64 =
  __floorDiv(__ticks(date), __ticksPerMillisecond())


/// Converts an <type Int64> representing milliseconds since the Unix epoch into a <type DateTime>
let fromMilliseconds(milliseconds: Int64): DateTime =
  __fromTicks(__offset(0, milliseconds, __ticksPerMillisecond()))


/// Returns a <type DateTime> <param milliseconds> milliseconds after <param d>
let addMilliseconds(d: DateTime, milliseconds: Int64): DateTime =
  __fromTicks(__offset(__ticks(d), milliseconds, __ticksPerMillisecond()))


/// Returns a <type DateTime> <param milliseconds> milliseconds before <param d>
let subtractMilliseconds(d: DateTime, milliseconds: Int64): DateTime =
  __fromTicks(__offset(__ticks(d), -milliseconds, __ticksPerMillisecond()))


/// Returns the millisecond portion of <param date> as a <type UInt16> between {{0}} and {{999}}
let millisecond(date: DateTime): UInt16 =
  Stdlib.UInt16.fromInt64((__ticksWithinDay(date) / __ticksPerMillisecond()) % 1000)
  |> Builtin.unwrap


/// Returns the difference of the two dates, in milliseconds
let subtractMs(d1: DateTime, d2: DateTime): Int64 =
  __roundedDifference(d1, d2, 86400000, 1000000.0)


/// Writes <param n> with leading zeros up to <param width> digits
let zeroPadded(n: Int64, width: Int64): String =
  Stdlib.String.padStart(Stdlib.toString(n), '0', width)

/// The text for one {{format}} directive (the character after {{%}}), or {{None}} if it is not a directive
let __formatDirective(date: DateTime, directive: Char): Stdlib.Option.Option<String> =
  match directive with
  | 'Y' ->
    let y = year(date)
    Stdlib.Option.Option.Some(if y < 0 then "-" + zeroPadded(0 - y, 4) else zeroPadded(y, 4))
  | 'm' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt8(Month.toNumber(month(date))), 2))
  | 'd' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt8(day(date)), 2))
  | 'H' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt8(hour(date)), 2))
  | 'M' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt8(minute(date)), 2))
  | 'S' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt8(second(date)), 2))
  | 'f' -> Stdlib.Option.Option.Some(zeroPadded(Stdlib.Int64.fromUInt16(millisecond(date)), 3))
  | '%' -> Stdlib.Option.Option.Some("%")
  | _ -> Stdlib.Option.Option.None

/// Writes <param chars> of a {{format}} pattern after <param written> (kept in reverse order)
let __formatChars(date: DateTime, chars: List<Char>, written: List<String>)
  : Stdlib.Result.Result<String, String> =
  match chars with
  | [] -> Stdlib.Result.Result.Ok(Stdlib.String.join(Stdlib.List.reverse(written), ""))
  | [ '%' ] ->
    Stdlib.Result.Result.Error("The pattern ends in a lone %; write %% for a literal %")
  | [ '%', directive, ...rest ] ->
    match __formatDirective(date, directive) with
    | Some(text) -> __formatChars(date, rest, Stdlib.List.prepend(written, text))
    | None ->
      Stdlib.Result.Result.Error(
        "Unknown directive %"
        + Stdlib.String.fromChar(directive)
        + "; the directives are %Y %m %d %H %M %S %f %%")
  | [ c, ...rest ] ->
    __formatChars(date, rest, Stdlib.List.prepend(written, Stdlib.String.fromChar(c)))


/// Writes <param date> (always UTC) using <param pattern>, where each directive is
/// replaced by a zero-padded field and every other character is copied as is:
/// {{%Y}} year, four digits ({{0001}}; negative years get a leading {{-}}),
/// {{%m}} month {{01}}-{{12}}, {{%d}} day {{01}}-{{31}},
/// {{%H}} hour {{00}}-{{23}}, {{%M}} minute {{00}}-{{59}}, {{%S}} second {{00}}-{{59}},
/// {{%f}} milliseconds {{000}}-{{999}} (truncated, not rounded), {{%%}} a literal {{%}}.
/// Any other {{%}} sequence, or a lone {{%}} at the end, is an {{Error}}.
/// For example, {{format(d, "%Y-%m-%d %H:%M:%S.%f")}} gives {{Ok("2019-07-28 22:42:36.500")}}.
let format(date: DateTime, pattern: String): Stdlib.Result.Result<String, String> =
  __formatChars(date, Stdlib.String.toList(pattern), [])


// Shared clock implementation.
/// Clock record decoding, scaling and interrupted-sleep retries in shared Dark.

let __timespec(bytes: Bytes): Result.Result<(Int64 * Int64), Int64> =
  let width = if Stdlib.Cli.Posix.__abiArm32() then 4 else 8
  Stdlib.Cli.Posix.__kernelSignedField(bytes, 0, width)
  |> Stdlib.Result.andThen(fun seconds ->
    Stdlib.Cli.Posix.__kernelSignedField(bytes, width, width)
    |> Stdlib.Result.map(fun nanos -> (seconds, nanos)))

let __realtimeNanoseconds(): Result.Result<(Int64 * Int64), Int64> =
  if Builtin.runtimeTargetOS() == "browser" then
    let ticks = Builtin.runtimeRealtimeTicks()
    Ok((ticks / 10000000, (ticks % 10000000) * 100))
  else if Stdlib.Cli.Posix.__abiMac() then
    Builtin.syscallGettimeofday()
    |> Stdlib.Result.andThen(fun bytes ->
      Stdlib.Cli.Posix.__kernelSignedField(bytes, 0, 8)
      |> Stdlib.Result.andThen(fun seconds ->
        Stdlib.Cli.Posix.__kernelSignedField(bytes, 8, 4)
        |> Stdlib.Result.map(fun micros -> (seconds, micros * 1000))))
  else Builtin.syscallClockGettime(0) |> Stdlib.Result.andThen(__timespec)

let __monotonicNanoseconds(): Result.Result<(Int64 * Int64), Int64> =
  if Builtin.runtimeTargetOS() == "browser" then
    let (ticks, frequency) = Builtin.runtimeMonotonicCounter()
    if frequency <= 0 then Error(5)
    else Ok((ticks / frequency, ((ticks % frequency) * 1000000000) / frequency))
  else if Stdlib.Cli.Posix.__abiMac() then
    Builtin.syscallMachAbsoluteTime()
    |> Stdlib.Result.andThen(fun bytes ->
      Stdlib.Cli.Posix.__kernelField(bytes, 0, 8)
      |> Stdlib.Result.andThen(fun ticks ->
        Builtin.syscallMachTimebaseInfo()
        |> Stdlib.Result.andThen(fun base ->
          Stdlib.Cli.Posix.__kernelField(base, 0, 4)
          |> Stdlib.Result.andThen(fun numerator ->
            Stdlib.Cli.Posix.__kernelField(base, 4, 4)
            |> Stdlib.Result.andThen(fun denominator ->
              if denominator == 0 then Error(5)
              else
                let nanos = (ticks / denominator) * numerator + ((ticks % denominator) * numerator) / denominator
                Ok((nanos / 1000000000, nanos % 1000000000)))))))
  else Builtin.syscallClockGettime(1) |> Stdlib.Result.andThen(__timespec)

let __monotonicMilliseconds(): Int64 =
  match __monotonicNanoseconds() with
  | Ok((seconds, nanos)) -> seconds * 1000 + nanos / 1000000
  | Error(e) -> Builtin.unwrap(Error(e))

let __now(): DateTime =
  match __realtimeNanoseconds() with
  | Ok((seconds, nanos)) -> __fromTicks(seconds * 10000000 + nanos / 100)
  | Error(e) -> Builtin.unwrap(Error(e))

let __today(): DateTime =
  let seconds = Stdlib.DateTime.toSeconds(__now())
  let remainder = seconds % 86400
  let start = if remainder < 0 then seconds - remainder - 86400 else seconds - remainder
  Stdlib.DateTime.fromSeconds(start)

let __sleepWith(sleep: (Int64, Int64) -> (Int64 * Bytes), seconds: Int64, nanos: Int64)
  : Result.Result<Unit, Int64> =
  let (rc, remaining) = sleep(seconds, nanos)
  if rc == 0 then Ok()
  else if rc == -4 then
    __timespec(remaining) |> Stdlib.Result.andThen(fun pair ->
      let (seconds, nanos) = pair
      __sleepWith(sleep, seconds, nanos))
  else Error(0 - rc)

let __sleepNanoseconds(seconds: Int64, nanos: Int64): Result.Result<Unit, Int64> =
  __sleepWith(Builtin.syscallNanosleep, seconds, nanos)

let __sleepMilliseconds(milliseconds: Float): Unit =
  let nanos = Stdlib.Float.toInt64(milliseconds * 1000000.0)
  if Builtin.runtimeTargetOS() == "browser" then Builtin.runtimeDelayTicks(nanos / 100)
  else __sleepNanoseconds(nanos / 1000000000, nanos % 1000000000) |> Builtin.unwrap
