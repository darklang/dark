module Darklang.Stdlib.HttpClient

type BadHeader =
  // Occurs whrn a header key is empty. eg. [ ("", "") ]
  | EmptyKey
  | InvalidContentType
  /// Occurs when a header name holds a character not allowed in an HTTP token, eg. [ ("X A", "") ]
  | InvalidName
  /// Occurs when a header value holds a CR, LF or NUL, eg. [ ("X-A", "a\r\nB: c") ]
  | InvalidValue


type BadUrlDetails =
  /// Occurs when the URI scheme is not allowed. eg. "ftp://darklang.com"
  | UnsupportedProtocol
  /// Occurs when the host is not allowed. eg. "http://0"
  | InvalidHost
  /// The host is this machine, eg. "http://127.0.0.1:8080", which `http.loopback` opens
  | Loopback
  /// The host is on a private network, eg. "http://192.168.1.5", which `http.private` opens
  | PrivateNetwork
  /// Occurs when the URI does not conform to the format specified by RFC 2396. eg. "{ ] nonsense ^#( :"
  | InvalidUri
  /// Occurs when the request contains invalid headers. eg.A request to "http://google.com" with [("Metadata-Flavor", "Google")] header
  | InvalidRequest


/// A request destination or proxy.
type NetworkTarget =
  | Destination(String)
  | Proxy(String)


/// A DNS, connection, or I/O failure.
type NetworkFailure =
  /// Hostname lookup failed.
  | DnsFailure(NetworkTarget)
  /// The target is a host and optional port. Guard refusals omit details.
  | ConnectionFailure(NetworkTarget, Option<String>)
  /// Request authority and I/O error.
  | IoFailure(String, String)


type RequestError =
  | BadUrl(BadUrlDetails)
  /// Occurs when the request is cancelled due to a timeout
  | Timeout
  | BadHeader(BadHeader)
  /// A DNS, connection, or I/O failure.
  | NetworkError(NetworkFailure)
  /// Occurs when the TLS handshake fails, eg. the server's certificate can't be verified. The message says why.
  | TlsError(String)
  /// Occurs when the request method is not invalid.
  | BadMethod
  /// Occurs when a request was redirected more times than <fn Middleware.followRedirects> allows
  | TooManyRedirects
  /// Occurs when a response's body is not what it was read as, eg. text that is not UTF-8 (<fn Response.text>). The message says why.
  | Decode(String)
  /// Occurs when a response's body is not JSON of the type it was read as (<fn Response.json>)
  | BadJson(Json.ParseError.ParseError)


// TODO: move this into a RequestError module, along with the type
let toString(e: RequestError): String =
  match e with
  | BadUrl(details) ->
    match details with
    | UnsupportedProtocol -> "Unsupported protocol"
    | InvalidHost -> "Invalid host"
    | Loopback ->
      "This machine (loopback) is blocked; `dark config set http.loopback on` lets code reach it"
    | PrivateNetwork ->
      "Private network addresses are blocked; `dark config set http.private on` lets code reach them"
    | InvalidUri -> "Invalid URI"
    | InvalidRequest -> "Invalid request"
  | Timeout -> "Timeout"
  | BadHeader(details) ->
    match details with
    | EmptyKey -> "Empty key"
    | InvalidContentType -> "Invalid content-type header"
    | InvalidName -> "Invalid header name"
    | InvalidValue -> "Header value contains CR, LF or NUL"
  | NetworkError(failure) ->
    let targetName(target: NetworkTarget): String =
      match target with
      | Destination(host) -> host
      | Proxy(host) -> "proxy " + host

    match failure with
    | DnsFailure(target) -> "Could not resolve host: " + targetName(target)
    | ConnectionFailure(target, detail) ->
      let message = "Could not connect to " + targetName(target)
      match detail with
      | Some(reason) -> message + ": " + reason
      | None -> message
    | IoFailure(authority, detail) -> "Request to " + authority + " failed: " + detail
  | TlsError(message) -> message
  | BadMethod -> "Bad Method"
  | TooManyRedirects -> "Too many redirects"
  | Decode(message) -> message
  | BadJson(e) -> display(e)


impl Display for RequestError =
  let display = Stdlib.HttpClient.toString


/// How a request is sent again after a failure worth retrying (<fn Middleware.retry>).
type RetryPolicy =
  { /// How many times it may be sent in all.
    attempts: Int64
    /// The wait before the first retry, doubled for each one after.
    delayMs: Int64 }


/// A request on its way out: what a <type Send> takes and a <type Middleware> may rewrite. The
/// same fields as a server's <type Stdlib.Http.Request>, and what the host does beyond one send.
/// A middleware sets the last three, and the one listed last wins; one you set yourself wins
/// over them all (<fn client>).
type Request =
  { method: String
    url: String
    headers: List<(String * String)>
    body: Bytes
    /// How long the exchange may take in milliseconds, redirects and retries included: all of
    /// it for a buffered response, and until the last response's headers arrive for a stream.
    /// {{None}} is 30 seconds, and 0 is no limit. Set by <fn Middleware.timeout>.
    timeoutMs: Option<Int64>
    /// How many redirects to follow; {{None}} follows none. Set by <fn Middleware.followRedirects>.
    redirects: Option<Int64>
    /// {{None}} sends it once. Set by <fn Middleware.retry>.
    retry: Option<RetryPolicy>
    /// Headers that go only to one origin, as {{(origin, name, value)}}: added when the request
    /// is sent, to the url it is sent to, unless it carries that header already. Set by
    /// <fn Middleware.headerFor> and <fn Middleware.bearer>.
    originHeaders: List<(String * String * String)>
    /// Whether the host undoes a gzip or brotli {{Content-Encoding}} on the body. Set by
    /// <fn Middleware.decompress>.
    decompress: Bool }


module Request =
  /// A request with nothing set beyond what it is: a {{None}} for each of the rest.
  let make(method: String, url: String, headers: List<(String * String)>, body: Bytes): Request =
    Request
      { method = method
        url = url
        headers = headers
        body = body
        timeoutMs = None
        redirects = None
        retry = None
        originHeaders = []
        decompress = false }


  /// <param req> as it goes to the host: its <type Request> {{originHeaders}} added for the url
  /// it is going to.
  let __final(req: Request): Request =
    match req.originHeaders with
    | [] -> req
    | _ -> __addOriginHeaders(req)


  let __addOriginHeaders(req: Request): Request =
    let origin = Middleware.__origin(req.url)
    let has = fun name ->
      List.any(req.headers, fun h ->
        String.toLowercase(Tuple2.first(h)) == String.toLowercase(name))

    let added =
      req.originHeaders
      |> List.filterMap(fun h ->
        let (o, name, value) = h
        if Option.isSome(origin) && Some(o) == origin && Bool.not(has(name)) then
          Some((name, value))
        else
          None)

    { req with headers = List.flatten([ req.headers, added ]) }


  /// <param req>, after the middleware, with what <param caller> set itself put back: a value
  /// the caller chose wins over any middleware's.
  let __callerWins(caller: Request, req: Request): Request =
    let timeoutMs =
      match caller.timeoutMs with
      | Some(_) -> caller.timeoutMs
      | None -> req.timeoutMs

    let redirects =
      match caller.redirects with
      | Some(_) -> caller.redirects
      | None -> req.redirects

    let retry =
      match caller.retry with
      | Some(_) -> caller.retry
      | None -> req.retry

    { req with timeoutMs = timeoutMs, redirects = redirects, retry = retry }


/// The response from an HTTP request. <param body> is {{Bytes}} when the whole response was
/// read (<fn request>, <fn get>, ...) and a lazy {{Stream<Bytes>}} when it is pulled as it
/// arrives (<fn stream>): chunks of up to 64 KB, as the server writes them, and the connection is
/// released when the stream is drained or `Stdlib.Stream.close`d.
///
/// Header names and values are as the server sent them, and a header sent twice is two pairs.
/// <fn Response.header> looks one up whatever its case.
type Response<'body> =
  { statusCode: Int64
    headers: List<(String * String)>
    body: 'body
    /// Where the response came from: the request's url, or where its redirects led.
    url: String }


module Response =
  /// Every value of the response header <param name>, matched case-insensitively, in the order
  /// the server sent them: each {{Set-Cookie}}, say.
  let headers(response: Response<'body>, name: String): List<String> =
    let wanted = String.toLowercase(name)
    response.headers
    |> List.filterMap(fun pair ->
      let (k, v) = pair
      if String.toLowercase(k) == wanted then Some(v) else None)


  /// The value of the response header <param name>, matched case-insensitively, so a lookup of
  /// {{"ETag"}} finds {{etag}} and {{ETAG}} alike. The first one wins when it was sent more than
  /// once; <fn headers> has them all. Twin of <fn Stdlib.Http.Request.header>.
  let header(response: Response<'body>, name: String): Option<String> =
    List.head(headers(response, name))


  /// The body as UTF-8 text, or {{Decode}} saying why it is not.
  let text(response: Response<Bytes>): Result<String, RequestError> =
    match Utf8.decode(response.body) with
    | Ok(s) -> Ok(s)
    | Error(e) -> Error(RequestError.Decode(e))


  let __json(body: Bytes): Result<'a, RequestError> =
    match Utf8.decode(body) with
    | Ok(s) -> Json.parse<'a>(s) |> Result.mapError(fun e -> RequestError.BadJson(e))
    | Error(e) -> Error(RequestError.Decode(e))


  /// The body as JSON of type <typeParam a>, or {{BadJson}} saying where it is not:
  /// `Response.json<User>(r)` is a {{Result<User, RequestError>}}.
  let json(response: Response<Bytes>): Result<'a, RequestError> =
    __json<'a>(response.body)


/// Sends a request and answers its response: the raw builtin (<fn sendRaw>), or one wrapped in
/// middleware (<fn client>).
type Send<'body> = Request -> Result<Response<'body>, RequestError>


/// A function wrapping a <type Send>: it may change the request before handing it on, change
/// the response on its way back, answer without sending (an error, a cached response), or send
/// more than once (a redirect, a retry). <fn Middleware.onRequest> and
/// <fn Middleware.onResponse> build the common two. Most keep the body as it is
/// ({{Middleware<Bytes, Bytes>}}); one that decodes it changes its type, as
/// <fn Middleware.decode> does, and goes outside a stack rather than in it.
type Middleware<'inner, 'outer> = Send<'inner> -> Send<'outer>


/// The builtins' retries and first delay for <param req>'s <type RetryPolicy>.
let __retryArgs(req: Request): (Int64 * Int64) =
  match req.retry with
  | Some(r) ->
    let retries = if r.attempts > 1 then r.attempts - 1 else 0
    (retries, r.delayMs)
  | None -> (0, 0)


/// Send <param req> and read the whole response, with nothing on top: the headers go out as
/// given and come back as the server sent them, and the host follows the redirects and makes
/// the retries the request asks for, under its one timeout. What makes a request safe to send
/// (a CR, LF or NUL in a header, the network guard, your grants) is checked below this, by the
/// host, on every send, every redirect and retry included, so no middleware can get around it.
///
/// A GET or HEAD with no body is a read: it runs concurrently with what follows, and your code
/// waits for the response where it first looks at it, so `List.map get urls` has every request
/// in flight at once, up to 50 connections to any one host. Any other request is a write and
/// runs in program order.
let sendRaw(req: Request): Result<Response<Bytes>, RequestError> =
  let req = Request.__final(req)
  let (retries, delayMs) = __retryArgs(req)
  Builtin.httpClientRequest(
    req.method,
    req.url,
    req.headers,
    req.body,
    req.timeoutMs,
    Option.withDefault(req.redirects, 0),
    retries,
    delayMs,
    req.decompress)


/// <fn sendRaw>, with the body as a lazy stream: in program order, and the timeout covers the
/// headers, not the body, so a long-lived stream is not cut off. A stream holds its connection
/// until it is drained or closed, and counts against the host's 50 until then.
let streamRaw(req: Request): Result<Response<Stream<Bytes>>, RequestError> =
  let req = Request.__final(req)
  let (retries, delayMs) = __retryArgs(req)
  Builtin.httpClientStream(
    req.method,
    req.url,
    req.headers,
    req.body,
    req.timeoutMs,
    Option.withDefault(req.redirects, 0),
    retries,
    delayMs,
    req.decompress)


module Middleware =
  /// <param send> wrapped in <param middlewares>. The first listed is the outermost: it sees
  /// the request first and the response last.
  let wrap(middlewares: List<Middleware<'body, 'body>>, send: Send<'body>): Send<'body> =
    List.fold(List.reverse(middlewares), send, fun(inner, m) -> m(inner))


  /// A middleware that rewrites every request with <param f> before sending it.
  let onRequest(f: Request -> Request): Middleware<'body, 'body> =
    (fun next -> (fun req -> next(f(req))))


  /// A middleware that rewrites every response with <param f>. It does not wait for the
  /// response: a GET is still in flight when this returns, and <param f> runs when it arrives,
  /// so `List.map(urls, get)` keeps every request in flight at once. <param f> may only
  /// compute, whatever the method: one that prints or writes fails the request. Take an effect
  /// where you use the response.
  let onResponse(f: Response<'body> -> Response<'body>): Middleware<'body, 'body> =
    (fun next -> (fun req -> __whenReady(next(req), fun result -> Result.map(result, f))))


  /// A middleware that runs <param f> on every request and its answer, then answers it as it
  /// came. <param f> may take effects, such as a log line: `tap(fun(req, r) -> printLine(req.url))`.
  /// It looks at the answer, so a GET through it is waited for where it is sent rather than
  /// kept in flight.
  let tap(f: (Request, Result<Response<'body>, RequestError>) -> Unit): Middleware<'body, 'body> =
    (fun next ->
       (fun req ->
          let result = next(req)
          f(req, result)
          result))


  let __mapBody(f: 'inner -> Result<'outer, RequestError>): Middleware<'inner, 'outer> =
    (fun next ->
       (fun req ->
          __whenReady(next(req), fun result ->
            match result with
            | Ok(r) ->
              match f(r.body) with
              | Ok(body) ->
                Ok(
                  Response
                    { statusCode = r.statusCode, headers = r.headers, body = body, url = r.url })
              | Error(e) -> Error(e)
            | Error(e) -> Error(e))))


  /// A middleware that turns every response's body into another type with <param f>, or
  /// answers {{Decode}} with what <param f> says is wrong. Like <fn onResponse>, it does not
  /// wait for the response, and <param f> may only compute.
  let decode(f: 'inner -> Result<'outer, String>): Middleware<'inner, 'outer> =
    __mapBody(fun body -> Result.mapError(f(body), fun e -> RequestError.Decode(e)))


  /// A middleware that reads every response's body as JSON of type <typeParam a>
  /// (<fn Response.json>): `(Middleware.json<User>())(send)` answers a {{Response<User>}}.
  let json(): Middleware<Bytes, 'a> =
    __mapBody(fun body -> Response.__json<'a>(body))


  let __trimmed(req: Request): Request =
    { req with
        headers =
          List.map(req.headers, fun h ->
            let (k, v) = h
            (String.trim(k), v)) }


  /// Header names with the spaces around them trimmed. In the default stack.
  let trimNames(): Middleware<'body, 'body> =
    onRequest(__trimmed)


  let __hasEmptyName(req: Request): Bool =
    List.any(req.headers, fun h ->
      let (k, _) = h
      k == "")


  /// A request with an empty header name is answered {{BadHeader(EmptyKey)}}, unsent. In the
  /// default stack, after <fn trimNames>, so a name of spaces is refused too.
  let refuseEmptyNames(): Middleware<'body, 'body> =
    (fun next ->
       (fun req ->
          if __hasEmptyName(req) then
            Error(RequestError.BadHeader(BadHeader.EmptyKey))
          else
            next(req)))


  /// Response header names in lowercase, so a plain comparison finds {{etag}} however the
  /// server spelled it. Values are left alone. Not in the default stack: <fn Response.header>
  /// finds a header whatever its case.
  let lowercaseNames(): Middleware<'body, 'body> =
    onResponse(fun response ->
      { response with
          headers =
            List.map(response.headers, fun h ->
              (String.toLowercase(Tuple2.first(h)), Tuple2.second(h))) })


  /// Every request may take at most <param ms> milliseconds, redirects and retries included,
  /// which the host enforces: past it the answer is {{Timeout}}. For a stream it covers the
  /// headers, not the body. 0 is no limit. Listed after another, it wins.
  let timeout(ms: Int64): Middleware<'body, 'body> =
    onRequest(fun req -> { req with timeoutMs = Some(ms) })


  /// Adds the header <param name>: <param value> to every request that does not already carry
  /// one of that name, whatever its case: a {{User-Agent}}, say. It follows a redirect to any
  /// host; for a credential, use <fn headerFor>.
  let header(name: String, value: String): Middleware<'body, 'body> =
    let wanted = String.toLowercase(name)
    onRequest(fun req ->
      let present = List.any(req.headers, fun h -> String.toLowercase(Tuple2.first(h)) == wanted)
      if present then
        req
      else
        { req with headers = List.append(req.headers, (name, value)) })


  /// A request url resolved against <param base>, so {{"/users"}} with a base of
  /// {{"https://api.example.com/v1/"}} goes to {{https://api.example.com/users}} and
  /// {{"users"}} to {{https://api.example.com/v1/users}} (RFC 3986). An absolute url is sent as
  /// it is, and so is anything that does not parse, for the host to refuse.
  let baseUrl(base: String): Middleware<'body, 'body> =
    onRequest(fun req ->
      match Url.parse(base), Url.parseReference(req.url) with
      | Ok(b), Ok(r) -> { req with url = Url.toString(Url.resolve(b, r)) }
      | _ -> req)


  /// {{scheme://host:port}} of <param url>, lowercased, with the default port filled in: what
  /// two urls must share for a credential sent to one to be sent to the other.
  let __origin(url: String): Option<String> =
    match Url.parse(url) with
    | Ok(u) ->
      match u.scheme, u.host with
      | Some(scheme), Some(host) ->
        let scheme = String.toLowercase(scheme)
        let port =
          match u.port with
          | Some(p) -> p
          | None -> if scheme == "https" then 443 else 80

        Some(scheme + "://" + String.toLowercase(host) + ":" + display(port))
      | _ -> None
    | Error(_) -> None


  /// The header <param name>: <param value> on every request to <param origin> (a url; only
  /// its scheme, host and port count), and on no other, so a key never goes to a host a
  /// redirect or a typo points at: an {{X-Api-Key}}, say, which <fn header> would send
  /// anywhere. Decided against the url the request is finally sent to, so it can be listed
  /// before or after <fn baseUrl>. One the request already carries is kept.
  let headerFor(origin: String, name: String, value: String): Middleware<'body, 'body> =
    match __origin(origin) with
    | Some(wanted) ->
      onRequest(fun req ->
        { req with originHeaders = List.append(req.originHeaders, (wanted, name, value)) })
    | None -> (fun next -> next)


  /// {{Authorization: Bearer <param token>}} on every request to <param origin>, and on no
  /// other (<fn headerFor>).
  let bearer(origin: String, token: String): Middleware<'body, 'body> =
    headerFor(origin, "Authorization", "Bearer " + token)


  /// Follows a 301, 302, 303, 307 or 308 with a {{Location}}, up to <param max> times; one more
  /// is {{TooManyRedirects}}, and 0 follows none. As fetch and curl -L do, a POST after a 301
  /// or 302, and anything but a GET or HEAD after a 303, becomes a GET with no body; otherwise
  /// the method and body are kept. {{Authorization}}, {{Cookie}} and {{Proxy-Authorization}} are
  /// dropped when a hop leaves the origin. The host follows them, checking your grants and the
  /// network guard again for each hop, so a GET through it is still in flight. In the default
  /// stack, with 10; listed after it, `followRedirects(0)` turns them off.
  let followRedirects(max: Int64): Middleware<'body, 'body> =
    onRequest(fun req -> { req with redirects = Some(max) })


  let __decompressed(req: Request): Request =
    let wanted = ("Accept-Encoding", "gzip, br")
    let headers =
      match req.headers with
      | [] -> [ wanted ]
      | headers ->
        let asked = List.any(headers, fun h ->
          let (k, _) = h
          String.toLowercase(k) == "accept-encoding")

        if asked then headers else List.append(headers, wanted)

    { req with headers = headers, decompress = true }


  /// Asks for a gzip or brotli body ({{Accept-Encoding: gzip, br}}, unless the request names
  /// its own) and has the host decode one, so the body is what the server meant and the
  /// {{Content-Encoding}} and {{Content-Length}} that described the encoded one are gone. Works
  /// for a stream too. In the default stack; `client([])` leaves the body as it came.
  let decompress(): Middleware<'body, 'body> =
    onRequest(__decompressed)


  /// How many redirects the default stack follows.
  val defaultRedirects = 10


  /// Sends a GET, HEAD, PUT, DELETE, OPTIONS or TRACE up to <param attempts> times in all, while
  /// it fails to connect or answers 429, 502, 503 or 504. Before each retry it waits what a
  /// {{Retry-After}} asks, or else <param delayMs> doubled for each retry before, with some
  /// jitter; it gives up when that wait would pass the request's timeout, which covers every
  /// attempt (<fn timeout>). Any other method is sent once: sending a POST twice can do its work
  /// twice. The host makes the retries, so a GET through it is still in flight. Listed after
  /// another, it wins.
  let retry(attempts: Int64, delayMs: Int64): Middleware<'body, 'body> =
    onRequest(fun req ->
      { req with retry = Some(RetryPolicy { attempts = attempts, delayMs = delayMs }) })


  /// The stack <fn request>, <fn get> and the rest send through: trim header names, refuse an
  /// empty one (<fn refuseEmptyNames>), follow up to 10 redirects, and decode a gzip or brotli
  /// body (<fn decompress>). All four keep a GET in flight. Build your own with <fn client>,
  /// starting from this list or from nothing.
  let defaults(): List<Middleware<'body, 'body>> =
    [ trimNames(), refuseEmptyNames(), followRedirects(defaultRedirects), decompress() ]


/// What <fn Middleware.defaults> does to a request, as one function: <fn request> and
/// <fn stream> call it rather than build the stack, which would cost a few closures on every
/// call.
let __defaults(req: Request): Result<Request, RequestError> =
  let req = Middleware.__trimmed(req)
  if Middleware.__hasEmptyName(req) then
    Error(RequestError.BadHeader(BadHeader.EmptyKey))
  else
    let req = Middleware.__decompressed(req)
    match req.redirects with
    | Some(_) -> Ok(req)
    | None -> Ok({ req with redirects = Some(Middleware.defaultRedirects) })


/// A <type Send> through <param middlewares>, over <fn sendRaw>:
/// `client(List.append(Middleware.defaults(), Middleware.retry(3, 200)))` retries too, and
/// `client([])` is the raw builtin, which follows no redirect. A timeout, redirect limit or
/// retry policy set on the request itself wins over the middleware's.
let client(middlewares: List<Middleware<Bytes, Bytes>>): Send<Bytes> =
  let send = Middleware.wrap(middlewares, sendRaw)
  (fun req ->
     match req.timeoutMs, req.redirects, req.retry with
     | None, None, None -> send(req)
     | _ ->
       let callerWins = Middleware.wrap(middlewares, fun r -> sendRaw(Request.__callerWins(req, r)))
       callerWins(req))


/// <fn client>, over <fn streamRaw>: the same middleware, with the body as a lazy stream.
let streamClient(middlewares: List<Middleware<Stream<Bytes>, Stream<Bytes>>>): Send<Stream<Bytes>> =
  let send = Middleware.wrap(middlewares, streamRaw)
  (fun req ->
     match req.timeoutMs, req.redirects, req.retry with
     | None, None, None -> send(req)
     | _ ->
       let callerWins =
         Middleware.wrap(middlewares, fun r -> streamRaw(Request.__callerWins(req, r)))

       callerWins(req))


/// Make an HTTP call to <param uri> through the default stack (<fn Middleware.defaults>) and read the
/// whole response. Returns a <type Result> where the response is wrapped in {{ Ok }} if a
/// response was successfully received and read, and is wrapped in {{ Error }} otherwise,
/// including when the body fails or times out partway.
///
/// A GET or HEAD is a read: it runs concurrently with what follows, and your code waits for
/// the response where it first looks at it, so `List.map get urls` has every request in
/// flight at once. Any other method is a write and runs in program order. <param body> is
/// sent whatever the method.
let request(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  match __defaults(Request.make(method, uri, headers, body)) with
  | Ok(req) -> sendRaw(req)
  | Error(e) -> Error(e)


let get(uri: String, headers: List<(String * String)>): Result<Response<Bytes>, RequestError> =
  request("GET", uri, headers, Bytes.empty)


let post(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  request("POST", uri, headers, body)


let put(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  request("PUT", uri, headers, body)


let options(uri: String): Result<Response<Bytes>, RequestError> =
  request("OPTIONS", uri, [], Bytes.empty)


let delete(uri: String): Result<Response<Bytes>, RequestError> =
  request("DELETE", uri, [], Bytes.empty)


let head(uri: String): Result<Response<Bytes>, RequestError> =
  request("HEAD", uri, [], Bytes.empty)


/// Make a streaming HTTP call to <param uri> through the default stack, in program order. The
/// response's body is a lazy `Stream<Bytes>`: chunks arrive as the server writes them. Drain
/// with `Stdlib.Stream.toList`, `Stdlib.Stream.toBytes`, or compose with `Stdlib.Stream.map` /
/// `Stdlib.Stream.filter` etc. The timeout covers the response's headers, not its body, so a
/// long-lived stream is not cut off.
///
/// The underlying socket is released when the body stream drains to
/// completion or is explicitly closed with `Stdlib.Stream.close`.
let stream(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Stream<Bytes>>, RequestError> =
  match __defaults(Request.make(method, uri, headers, body)) with
  | Ok(req) -> streamRaw(req)
  | Error(e) -> Error(e)


/// Returns a header <type (String*String))> with {{'authorization'}} created using HTTP basic auth
let basicAuth(username: String, password: String): Result<(String * String), String> =
  if String.contains(username, "-") then
    Error("Username cannot contain a hyphen")
  else
    let encoded = Base64.encodeText($"{username}:{password}")
    Ok(("authorization", $"basic {encoded}"))


/// Returns a header <type (String*String))> with {{'authorization'}} set to <param token>
let bearerToken(token: String): (String * String) =
  ("authorization", "bearer " + token)


module ContentType =
  /// A header <type (String*String))> with {{content-type}} set for HTML form requests or responses
  val form = ("content-type", "application/x-www-form-urlencoded")


  /// A header <type (String*String))> with {{content-type}} set for JSON requests or responses
  val json = ("content-type", "application/json")


  /// A header <type (String*String))> with {{'content-type'}} set for plain text requests or responses
  val plainText = ("content-type", "text/plain; charset=utf-8")


  /// A header <type (String*String))> with {{'content-type'}} set for html requests
  val html = ("content-type", "text/html; charset=utf-8")


module Sse =
  // Server-Sent Events parsing over a body's chunks. One `Event` is emitted as soon as its
  // terminating blank line arrives, rather than after the whole response:
  //
  //     HttpClient.stream("GET", url, headers, Stdlib.Bytes.empty)
  //     |> Stdlib.Result.map (fun r -> HttpClient.Sse.parse r.body)

  /// A parsed Server-Sent Event.
  type Event =
    { data: String
      eventType: String
      id: String }


  /// Intermediate state threaded through parsing. `lastId` persists across events per the SSE
  /// spec; `currentLines` holds the field lines of the block being assembled; `pending` is
  /// what has arrived after the last complete line.
  type ParseState =
    { lastId: String
      currentLines: List<String>
      pending: Bytes }


  /// Split a `field: value` line into its two parts. Per the SSE
  /// spec: if there's no colon, the whole line is the field with an
  /// empty value; the leading space after the colon (if any) is
  /// stripped.
  let __splitField(line: String): (String * String) =
    match String.indexOf(line, ":") with
    | None -> (line, "")
    | Some(idx) ->
      let field = String.first(line, idx)
      let afterColon = String.dropFirst(line, idx + 1)
      let value =
        if String.startsWith(afterColon, " ") then
          String.dropFirst(afterColon, 1)
        else
          afterColon

      (field, value)


  /// Fold one SSE line into an accumulating block. `data: value`
  /// appends (with newline between multiple), `event: …` sets the
  /// event type, `id: …` sets the id, `:` comment lines are skipped,
  /// unknown fields are ignored.
  let __applyLine(
    data: String,
    eventType: String,
    id: String,
    hasData: Bool,
    line: String)
    : (String * String * String * Bool) =
    if String.isEmpty(line) then
      (data, eventType, id, hasData)
    else if String.startsWith(line, ":") then
      (data, eventType, id, hasData)
    else
      let (field, value) = __splitField(line)
      if field == "data" then
        let newData = if hasData then data + "\n" + value else value
        (newData, eventType, id, true)
      else if field == "event" then
        (data, value, id, hasData)
      else if field == "id" then
        (data, eventType, value, hasData)
      else
        (data, eventType, id, hasData)


  /// Build an Event from the accumulated lines of one block, if any
  /// `data:` field was seen. `lastId` is the id the block inherits
  /// when no `id:` field appears.
  let __tryEmitBlock(lines: List<String>, lastId: String): Option<Event> =
    let (data, eventType, id, hasData) = List.fold(lines, ("", "", lastId, false), fun(acc, line) ->
      let (d, e, i, h) = acc
      __applyLine(d, e, i, h, line))

    if hasData then
      Some(Event { data = data, eventType = eventType, id = id })
    else
      None


  let __decodeLine(bytes: Bytes): String =
    match Utf8.decode(bytes) with
    | Ok(s) -> s
    | Error(_) -> ""


  /// Read chunks until a complete event terminator (blank line) arrives, then emit it with the
  /// chunks after it. Returns None once the chunks end and no buffered data remains.
  let __pullNextEvent(
    chunks: Stream<Bytes>,
    state: ParseState)
    : Option<(Event * (Stream<Bytes> * ParseState))> =
    // 10u8 = '\n'
    match Bytes.indexOf(state.pending, 10u8) with
    | Some(at) ->
      let line = __decodeLine(Bytes.take(state.pending, at))
      let pending = Bytes.drop(state.pending, at + 1)
      if String.isEmpty(line) then
        // Blank line terminates the block. Try to emit an Event.
        match __tryEmitBlock(state.currentLines, state.lastId) with
        | Some(event) ->
          let nextState = ParseState { lastId = event.id, currentLines = [], pending = pending }
          Some((event, (chunks, nextState)))
        | None ->
          // Block had no data; reset and keep reading.
          __pullNextEvent(
            chunks,
            ParseState { lastId = state.lastId, currentLines = [], pending = pending })
      else
        __pullNextEvent(
          chunks,
          ParseState
            { lastId = state.lastId
              currentLines = List.append(state.currentLines, line)
              pending = pending })
    | None ->
      match Stream.next<Bytes>(chunks) with
      | Some((chunk, rest)) ->
        __pullNextEvent(rest, { state with pending = Bytes.concat(state.pending, chunk) })
      | None ->
        // End of stream. Flush any buffered lines as a final event
        // (SSE spec: a trailing blank line is optional).
        let lines =
          if Bytes.isEmpty(state.pending) then
            state.currentLines
          else
            List.append(state.currentLines, __decodeLine(state.pending))

        if List.isEmpty(lines) then
          None
        else
          match __tryEmitBlock(lines, state.lastId) with
          | Some(event) ->
            let nextState =
              ParseState { lastId = event.id, currentLines = [], pending = Bytes.empty }

            Some((event, (chunks, nextState)))
          | None -> None


  /// Parse an SSE body into a stream of Events. Lazy: events
  /// flow to the consumer as their terminating blank lines arrive,
  /// so a slow LLM response surfaces tokens as they're produced.
  let parse(chunks: Stream<Bytes>): Stream<Event> =
    let initial = ParseState { lastId = "", currentLines = [], pending = Bytes.empty }
    Stream.unfold<(Stream<Bytes> * ParseState), Event>((chunks, initial), fun s ->
      let (rest, state) = s
      __pullNextEvent(rest, state))
