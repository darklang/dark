module Darklang.Stdlib.HttpClient

type BadHeader =
  // Occurs whrn a header key is empty. eg. [ ("", "") ]
  | EmptyKey
  | InvalidContentType
  /// Occurs when a header name holds a character not allowed in an HTTP token, eg. [ ("X A", "") ]
  | InvalidName
  /// Occurs when a header value holds a CR, LF or NUL, eg. [ ("X-A", "a\r\nB: c") ]
  | InvalidValue


type BadUrlDetails =
  /// Occurs when the URI scheme is not allowed. eg. "ftp://darklang.com"
  | UnsupportedProtocol
  /// Occurs when the host is not allowed. eg. "http://0"
  | InvalidHost
  /// Occurs when the URI does not conform to the format specified by RFC 2396. eg. "{ ] nonsense ^#( :"
  | InvalidUri
  /// Occurs when the request contains invalid headers. eg.A request to "http://google.com" with [("Metadata-Flavor", "Google")] header
  | InvalidRequest


/// A request destination or proxy.
type NetworkTarget =
  | Destination(String)
  | Proxy(String)


/// A DNS, connection, or I/O failure.
type NetworkFailure =
  /// Hostname lookup failed.
  | DnsFailure(NetworkTarget)
  /// The target is a host and optional port. Guard refusals omit details.
  | ConnectionFailure(NetworkTarget, Option<String>)
  /// Request authority and I/O error.
  | IoFailure(String, String)


type RequestError =
  | BadUrl(BadUrlDetails)
  /// Occurs when the request is cancelled due to a timeout
  | Timeout
  | BadHeader(BadHeader)
  /// A DNS, connection, or I/O failure.
  | NetworkError(NetworkFailure)
  /// Occurs when the TLS handshake fails, eg. the server's certificate can't be verified. The message says why.
  | TlsError(String)
  /// Occurs when the request method is not invalid.
  | BadMethod
  /// Occurs when <fn Middleware.followRedirects> was redirected more times than it allows
  | TooManyRedirects
  /// Occurs when a response's body is not what it was read as, eg. text that is not UTF-8 (<fn Response.text>). The message says why.
  | Decode(String)


// TODO: move this into a RequestError module, along with the type
let toString(e: RequestError): String =
  match e with
  | BadUrl(details) ->
    match details with
    | UnsupportedProtocol -> "Unsupported protocol"
    | InvalidHost -> "Invalid host"
    | InvalidUri -> "Invalid URI"
    | InvalidRequest -> "Invalid request"
  | Timeout -> "Timeout"
  | BadHeader(details) ->
    match details with
    | EmptyKey -> "Empty key"
    | InvalidContentType -> "Invalid content-type header"
    | InvalidName -> "Invalid header name"
    | InvalidValue -> "Header value contains CR, LF or NUL"
  | NetworkError(failure) ->
    let targetName(target: NetworkTarget): String =
      match target with
      | Destination(host) -> host
      | Proxy(host) -> "proxy " + host

    match failure with
    | DnsFailure(target) -> "Could not resolve host: " + targetName(target)
    | ConnectionFailure(target, detail) ->
      let message = "Could not connect to " + targetName(target)
      match detail with
      | Some(reason) -> message + ": " + reason
      | None -> message
    | IoFailure(authority, detail) -> "Request to " + authority + " failed: " + detail
  | TlsError(message) -> message
  | BadMethod -> "Bad Method"
  | TooManyRedirects -> "Too many redirects"
  | Decode(message) -> message


impl Display for RequestError =
  let display = Stdlib.HttpClient.toString


/// A request on its way out: what a <type Send> takes and a <type Middleware> may rewrite. The
/// same fields as a server's <type Stdlib.Http.Request>, and one more.
type Request =
  { method: String
    url: String
    headers: List<(String * String)>
    body: Bytes
    /// How long the exchange may take, in milliseconds: the whole of it for a buffered
    /// response, until the headers arrive for a stream. {{None}} is the host's default, 30
    /// seconds. <fn Middleware.timeout> sets it; the host enforces it.
    timeoutMs: Option<Int64> }


/// The response from an HTTP request. <param body> is {{Bytes}} when the whole response was
/// read (<fn request>, <fn get>, ...) and a lazy {{Stream<UInt8>}} when it is pulled as it
/// arrives (<fn stream>): the bytes arrive as the server writes them, and the connection is
/// released when the stream is drained or `Stdlib.Stream.close`d.
///
/// Through the default stack (<fn defaultMiddleware>) header names are lowercase. The values are as the
/// server sent them, and a header sent twice is two pairs. <fn Response.header> looks one up
/// whatever its case.
type Response<'body> =
  { statusCode: Int64
    headers: List<(String * String)>
    body: 'body }


module Response =
  /// Every value of the response header <param name>, matched case-insensitively, in the order
  /// the server sent them: each {{Set-Cookie}}, say.
  let headers(response: Response<'body>, name: String): List<String> =
    let wanted = String.toLowercase(name)
    response.headers
    |> List.filterMap(fun pair ->
      let (k, v) = pair
      if String.toLowercase(k) == wanted then Option.Some(v) else Option.None)


  /// The value of the response header <param name>, matched case-insensitively, so a lookup of
  /// {{"ETag"}} finds {{etag}} and {{ETAG}} alike. The first one wins when it was sent more than
  /// once; <fn headers> has them all. Twin of <fn Stdlib.Http.Request.header>.
  let header(response: Response<'body>, name: String): Option<String> =
    List.head(headers(response, name))


  /// The body as UTF-8 text, or {{Decode}} saying why it is not.
  let text(response: Response<Bytes>): Result<String, RequestError> =
    match Utf8.decode(response.body) with
    | Ok(s) -> Result.Ok(s)
    | Error(e) -> Result.Error(RequestError.Decode(e))


/// Sends a request and answers its response: the raw builtin (<fn sendRaw>), or one wrapped in
/// middleware (<fn client>).
type Send<'body> = Request -> Result<Response<'body>, RequestError>


/// A function wrapping a <type Send>: it may change the request before handing it on, change
/// the response on its way back, answer without sending (an error, a cached response), or send
/// more than once (a redirect, a retry). <fn Middleware.onRequest> and
/// <fn Middleware.onResponse> build the common two.
type Middleware<'body> = Send<'body> -> Send<'body>


/// Send <param req> and read the whole response, with nothing on top: the headers go out as
/// given and come back as the server sent them. What makes a request safe to send (a CR, LF or
/// NUL in a header, the network guard, your grants) is checked below this, by the host, on
/// every call, so no middleware can get around it.
///
/// A GET or HEAD with no body is a read: it runs concurrently with what follows, and your code
/// waits for the response where it first looks at it, so `List.map get urls` has every request
/// in flight at once. Any other request is a write and runs in program order.
let sendRaw(req: Request): Result<Response<Bytes>, RequestError> =
  Builtin.httpClientRequest(req.method, req.url, req.headers, req.body, req.timeoutMs)


/// <fn sendRaw>, with the body as a lazy stream: in program order, and the timeout covers the
/// headers, not the body, so a long-lived stream is not cut off.
let streamRaw(req: Request): Result<Response<Stream<UInt8>>, RequestError> =
  Builtin.httpClientStream(req.method, req.url, req.headers, req.body, req.timeoutMs)


module Middleware =
  /// <param send> wrapped in <param middlewares>. The first listed is the outermost: it sees
  /// the request first and the response last.
  let wrap(
    middlewares: List<Stdlib.HttpClient.Middleware<'body>>,
    send: Stdlib.HttpClient.Send<'body>)
    : Stdlib.HttpClient.Send<'body> =
    List.fold(List.reverse(middlewares), send, fun(inner, m) -> m(inner))


  /// A middleware that rewrites every request with <param f> before sending it.
  let onRequest(
    f: Stdlib.HttpClient.Request -> Stdlib.HttpClient.Request)
    : Stdlib.HttpClient.Middleware<'body> =
    (fun next -> (fun req -> next(f(req))))


  /// A middleware that rewrites every response with <param f>. It does not wait for the
  /// response: a GET is still in flight when this returns, and <param f> runs when it arrives
  /// (<fn Stdlib.whenReady>), so `List.map(urls, get)` keeps every request in flight at once.
  /// The price is that <param f> may only compute; one that prints or writes fails the request.
  /// For a middleware that takes effects, write the wrapping function yourself: it waits where
  /// it looks at the response.
  let onResponse(f: Response<'body> -> Response<'body>): Stdlib.HttpClient.Middleware<'body> =
    (fun next -> (fun req -> Stdlib.whenReady(next(req), fun result -> Result.map(result, f))))


  /// Header names with the spaces around them trimmed. In the default stack.
  let trimNames(): Stdlib.HttpClient.Middleware<'body> =
    onRequest(fun req ->
      { req with
          headers =
            List.map(req.headers, fun h -> (String.trim(Tuple2.first(h)), Tuple2.second(h))) })


  /// A request with an empty header name is answered {{BadHeader(EmptyKey)}}, unsent. In the
  /// default stack, after <fn trimNames>, so a name of spaces is refused too.
  let refuseEmptyNames(): Stdlib.HttpClient.Middleware<'body> =
    (fun next ->
       (fun req ->
          let empty = List.any(req.headers, fun h -> Tuple2.first(h) == "")
          if empty then
            Result.Error(RequestError.BadHeader(BadHeader.EmptyKey))
          else
            next(req)))


  /// Response header names in lowercase, so a plain comparison finds {{etag}} however the
  /// server spelled it. Values are left alone. In the default stack.
  let lowercaseNames(): Stdlib.HttpClient.Middleware<'body> =
    onResponse(fun response ->
      { response with
          headers =
            List.map(response.headers, fun h ->
              (String.toLowercase(Tuple2.first(h)), Tuple2.second(h))) })


  /// Every request may take at most <param ms> milliseconds, which the host enforces: past it
  /// the answer is {{Timeout}}. A timeout the request already carries is kept: the caller's,
  /// or one set by a middleware listed before this one.
  let timeout(ms: Int64): Stdlib.HttpClient.Middleware<'body> =
    onRequest(fun req ->
      match req.timeoutMs with
      | Some(_) -> req
      | None -> { req with timeoutMs = Option.Some(ms) })


  /// Adds the header <param name>: <param value> to every request that does not already carry
  /// one of that name, whatever its case: a {{User-Agent}}, say.
  let header(name: String, value: String): Stdlib.HttpClient.Middleware<'body> =
    let wanted = String.toLowercase(name)
    onRequest(fun req ->
      let present = List.any(req.headers, fun h -> String.toLowercase(Tuple2.first(h)) == wanted)
      if present then
        req
      else
        { req with headers = List.append(req.headers, (name, value)) })


  /// A request url resolved against <param base>, so {{"/users"}} with a base of
  /// {{"https://api.example.com/v1/"}} goes to {{https://api.example.com/users}} and
  /// {{"users"}} to {{https://api.example.com/v1/users}} (RFC 3986). An absolute url is sent as
  /// it is, and so is anything that does not parse, for the host to refuse.
  let baseUrl(base: String): Stdlib.HttpClient.Middleware<'body> =
    onRequest(fun req ->
      match Url.parse(base), Url.parseReference(req.url) with
      | Ok(b), Ok(r) -> { req with url = Url.toString(Url.resolve(b, r)) }
      | _ -> req)


  /// {{scheme://host:port}} of <param url>, lowercased, with the default port filled in: what
  /// two urls must share for a credential sent to one to be sent to the other.
  let __origin(url: String): Option<String> =
    match Url.parse(url) with
    | Ok(u) ->
      match u.scheme, u.host with
      | Some(scheme), Some(host) ->
        let scheme = String.toLowercase(scheme)
        let port =
          match u.port with
          | Some(p) -> p
          | None -> if scheme == "https" then 443 else 80

        Option.Some(scheme + "://" + String.toLowercase(host) + ":" + display(port))
      | _ -> Option.None
    | Error(_) -> Option.None


  /// {{Authorization: Bearer <param token>}} on every request to <param origin> (a url; only
  /// its scheme, host and port count), and on no other, so the token never goes to a host a
  /// redirect or a typo points at. One the request already carries is kept.
  let bearer(origin: String, token: String): Stdlib.HttpClient.Middleware<'body> =
    let wanted = __origin(origin)
    onRequest(fun req ->
      let mine = Option.isSome(wanted) && __origin(req.url) == wanted
      let already =
        List.any(req.headers, fun h -> String.toLowercase(Tuple2.first(h)) == "authorization")

      if mine && Bool.not(already) then
        { req with headers = List.append(req.headers, ("Authorization", "Bearer " + token)) }
      else
        req)


  /// The next request of a redirect: to <param location> resolved against the url it came
  /// from, as a GET with no body after a 303 (and after a 301 or 302 to a POST, as browsers
  /// do), as it was otherwise. Credentials and cookies are dropped when it leaves the origin.
  let __redirected(
    req: Stdlib.HttpClient.Request,
    status: Int64,
    location: String)
    : Stdlib.HttpClient.Request =
    let url =
      match Url.parse(req.url), Url.parseReference(location) with
      | Ok(b), Ok(r) -> Url.toString(Url.resolve(b, r))
      | _ -> location

    let asGet =
      status == 303 && req.method != "HEAD"
      || (status == 301 || status == 302) && String.toUppercase(req.method) == "POST"

    let (method, body, headers) =
      if asGet then
        (
          "GET",
          Bytes.empty,
          List.filter(req.headers, fun h ->
            let n = String.toLowercase(Tuple2.first(h))
            n != "content-type" && n != "content-length"))
      else
        (req.method, req.body, req.headers)

    let headers =
      if __origin(url) == __origin(req.url) then
        headers
      else
        List.filter(headers, fun h ->
          let n = String.toLowercase(Tuple2.first(h))
          n != "authorization" && n != "cookie" && n != "proxy-authorization")

    { req with method = method, url = url, body = body, headers = headers }


  let __follow(
    next: Stdlib.HttpClient.Send<'body>,
    req: Stdlib.HttpClient.Request,
    left: Int64)
    : Result<Response<'body>, RequestError> =
    match next(req) with
    | Ok(response) ->
      let status = response.statusCode
      let redirect =
        status == 301 || status == 302 || status == 303 || status == 307 || status == 308

      match redirect, Stdlib.HttpClient.Response.header(response, "location") with
      | true, Some(location) ->
        if left <= 0 then
          Result.Error(RequestError.TooManyRedirects)
        else
          __follow(next, __redirected(req, status, location), left - 1)
      | _ -> Result.Ok(response)
    | Error(e) -> Result.Error(e)


  /// Follows a 301, 302, 303, 307 or 308 with a {{Location}}, up to <param max> times; one more
  /// is {{TooManyRedirects}}. Each hop is a fresh send, so the host checks your grants and the
  /// network guard again for wherever it goes. {{Authorization}} and {{Cookie}} are dropped
  /// when a hop leaves the origin. Not in the default stack: it waits for every response,
  /// where it looks for a redirect, so a GET through it is no longer in flight.
  let followRedirects(max: Int64): Stdlib.HttpClient.Middleware<'body> =
    (fun next -> (fun req -> __follow(next, req, max)))


  let __isIdempotent(method: String): Bool =
    let m = String.toUppercase(method)
    m == "GET" || m == "HEAD" || m == "PUT" || m == "DELETE" || m == "OPTIONS"


  let __retryable(result: Result<Response<'body>, RequestError>): Bool =
    match result with
    | Ok(response) ->
      response.statusCode == 429
      || response.statusCode == 502
      || response.statusCode == 503
      || response.statusCode == 504
    | Error(Timeout) -> true
    | Error(NetworkError(_)) -> true
    | Error(_) -> false


  let __retry(
    next: Stdlib.HttpClient.Send<'body>,
    req: Stdlib.HttpClient.Request,
    attemptsLeft: Int64,
    delayMs: Int64)
    : Result<Response<'body>, RequestError> =
    let result = next(req)
    if attemptsLeft > 1 && __retryable(result) then
      let _ = Cli.Posix.sleep(Int64.toFloat(delayMs))
      __retry(next, req, attemptsLeft - 1, delayMs * 2)
    else
      result


  /// Sends a GET, HEAD, PUT, DELETE or OPTIONS up to <param attempts> times in all, while it
  /// times out, fails to connect, or answers 429, 502, 503 or 504, sleeping <param delayMs>
  /// before the first retry and twice as long before each one after. Any other method is sent
  /// once: sending a POST twice can do its work twice. Not in the default stack: it waits for
  /// every response, to see whether to try again.
  let retry(attempts: Int64, delayMs: Int64): Stdlib.HttpClient.Middleware<'body> =
    (fun next ->
       (fun req ->
          if __isIdempotent(req.method) then
            __retry(next, req, attempts, delayMs)
          else
            next(req)))


/// The stack <fn request>, <fn get> and the rest send through: trim header names, refuse an
/// empty one (<fn Middleware.refuseEmptyNames>), and lowercase the response's header names.
/// All three keep a GET in flight. Build your own with <fn client>, starting from this list or
/// from nothing.
let defaultMiddleware(): List<Stdlib.HttpClient.Middleware<'body>> =
  [ Middleware.trimNames(), Middleware.refuseEmptyNames(), Middleware.lowercaseNames() ]


/// A <type Send> through <param middlewares>, over <fn sendRaw>:
/// `client(List.append(defaultMiddleware(), Middleware.followRedirects(5)))` follows redirects, and
/// `client([])` is the raw builtin.
let client(middlewares: List<Stdlib.HttpClient.Middleware<Bytes>>): Stdlib.HttpClient.Send<Bytes> =
  Middleware.wrap(middlewares, sendRaw)


/// <fn client>, over <fn streamRaw>: the same middleware, with the body as a lazy stream.
let streamClient(
  middlewares: List<Stdlib.HttpClient.Middleware<Stream<UInt8>>>)
  : Stdlib.HttpClient.Send<Stream<UInt8>> =
  Middleware.wrap(middlewares, streamRaw)


/// Make an HTTP call to <param uri> through the default stack (<fn defaultMiddleware>) and read the
/// whole response. Returns a <type Result> where the response is wrapped in {{ Ok }} if a
/// response was successfully received and read, and is wrapped in {{ Error }} otherwise,
/// including when the body fails or times out partway.
///
/// A GET or HEAD is a read: it runs concurrently with what follows, and your code waits for
/// the response where it first looks at it, so `List.map get urls` has every request in
/// flight at once. Any other method is a write and runs in program order. <param body> is
/// sent whatever the method.
let request(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  let send = client(defaultMiddleware())
  send(
    Request { method = method, url = uri, headers = headers, body = body, timeoutMs = Option.None })


let get(uri: String, headers: List<(String * String)>): Result<Response<Bytes>, RequestError> =
  request("GET", uri, headers, Bytes.empty)


let post(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  request("POST", uri, headers, body)


let put(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Bytes>, RequestError> =
  request("PUT", uri, headers, body)


let options(uri: String): Result<Response<Bytes>, RequestError> =
  request("OPTIONS", uri, [], Bytes.empty)


let delete(uri: String): Result<Response<Bytes>, RequestError> =
  request("DELETE", uri, [], Bytes.empty)


let head(uri: String): Result<Response<Bytes>, RequestError> =
  request("HEAD", uri, [], Bytes.empty)


/// Make a streaming HTTP call to <param uri> through the default stack, in program order. The
/// response's body is a lazy `Stream<UInt8>`: bytes arrive as the server writes them. Drain
/// with `Stdlib.Stream.toList`, `Stdlib.Stream.toBytes`, or compose with `Stdlib.Stream.map` /
/// `Stdlib.Stream.filter` etc. The timeout covers the response's headers, not its body, so a
/// long-lived stream is not cut off.
///
/// The underlying socket is released when the body stream drains to
/// completion or is explicitly closed with `Stdlib.Stream.close`.
let stream(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response<Stream<UInt8>>, RequestError> =
  let send = streamClient(defaultMiddleware())
  send(
    Request { method = method, url = uri, headers = headers, body = body, timeoutMs = Option.None })


/// Returns a header <type (String*String))> with {{'authorization'}} created using HTTP basic auth
let basicAuth(username: String, password: String): Result<(String * String), String> =
  if String.contains(username, "-") then
    Result.Error("Username cannot contain a hyphen")
  else
    let encoded = Base64.encodeText($"{username}:{password}")
    Result.Ok(("authorization", $"basic {encoded}"))


/// Returns a header <type (String*String))> with {{'authorization'}} set to <param token>
let bearerToken(token: String): (String * String) =
  ("authorization", "bearer " + token)


module ContentType =
  /// A header <type (String*String))> with {{content-type}} set for HTML form requests or responses
  val form = ("content-type", "application/x-www-form-urlencoded")


  /// A header <type (String*String))> with {{content-type}} set for JSON requests or responses
  val json = ("content-type", "application/json")


  /// A header <type (String*String))> with {{'content-type'}} set for plain text requests or responses
  val plainText = ("content-type", "text/plain; charset=utf-8")


  /// A header <type (String*String))> with {{'content-type'}} set for html requests
  val html = ("content-type", "text/html; charset=utf-8")


module Sse =
  // Server-Sent Events parsing over a Stream<UInt8>. Consumers
  // compose with the standard Stream builtins:
  //
  //     HttpClient.stream("GET", url, headers, Stdlib.Bytes.empty)
  //     |> Stdlib.Result.map (fun r -> HttpClient.Sse.parse r.body)
  //
  // Implemented as a true streaming parser via `Stdlib.Stream.unfold`:
  // one `Event` is emitted as soon as its terminating blank line
  // arrives on the wire, rather than buffering the entire response.

  /// A parsed Server-Sent Event.
  type Event =
    { data: String
      eventType: String
      id: String }


  /// Intermediate state threaded through parsing. `lastId` persists
  /// across events per the SSE spec; `currentLines` holds the field
  /// lines for the block we're currently assembling; `currentLine`
  /// is the byte buffer for the line we're currently reading.
  ///
  /// TODO `currentLine` stays `List<UInt8>` (not `Bytes`) because it's
  /// accessed byte-by-byte during the parse — one append per byte and
  /// frequent fold-over-bytes for the line scan. Bytes.concat would
  /// reallocate the whole buffer on every append. Worth revisiting if
  /// anyone profiles the SSE parser; could become Bytes with an
  /// internal append-segments representation.
  type ParseState =
    { lastId: String
      currentLines: List<String>
      currentLine: List<UInt8> }


  /// Split a `field: value` line into its two parts. Per the SSE
  /// spec: if there's no colon, the whole line is the field with an
  /// empty value; the leading space after the colon (if any) is
  /// stripped.
  let __splitField(line: String): (String * String) =
    match String.indexOf(line, ":") with
    | None -> (line, "")
    | Some(idx) ->
      let field = String.slice(line, 0, idx)
      let afterColon = String.slice(line, idx + 1, String.length(line))
      let value =
        if String.startsWith(afterColon, " ") then
          String.dropFirst(afterColon, 1)
        else
          afterColon

      (field, value)


  /// Fold one SSE line into an accumulating block. `data: value`
  /// appends (with newline between multiple), `event: …` sets the
  /// event type, `id: …` sets the id, `:` comment lines are skipped,
  /// unknown fields are ignored.
  let __applyLine(
    data: String,
    eventType: String,
    id: String,
    hasData: Bool,
    line: String)
    : (String * String * String * Bool) =
    if String.isEmpty(line) then
      (data, eventType, id, hasData)
    else if String.startsWith(line, ":") then
      (data, eventType, id, hasData)
    else
      let (field, value) = __splitField(line)
      if field == "data" then
        let newData = if hasData then data + "\n" + value else value
        (newData, eventType, id, true)
      else if field == "event" then
        (data, value, id, hasData)
      else if field == "id" then
        (data, eventType, value, hasData)
      else
        (data, eventType, id, hasData)


  /// Build an Event from the accumulated lines of one block, if any
  /// `data:` field was seen. `lastId` is the id the block inherits
  /// when no `id:` field appears.
  let __tryEmitBlock(lines: List<String>, lastId: String): Option<Event> =
    let (data, eventType, id, hasData) = List.fold(lines, ("", "", lastId, false), fun(acc, line) ->
      let (d, e, i, h) = acc
      __applyLine(d, e, i, h, line))

    if hasData then
      Option.Some(Event { data = data, eventType = eventType, id = id })
    else
      Option.None


  /// Pull bytes from the underlying stream until a complete event
  /// terminator (blank line) arrives, then emit. Returns None once
  /// the stream is exhausted and no buffered data remains.
  let __pullNextEvent(bytes: Stream<UInt8>, state: ParseState): Option<(Event * ParseState)> =
    match Stream.next<UInt8>(bytes) with
    | None ->
      // End of stream. Flush any buffered lines as a final event
      // (SSE spec: a trailing blank line is optional).
      let pending =
        if List.isEmpty(state.currentLine) then
          state.currentLines
        else
          let tailLine =
            match Utf8.decode(Bytes.fromList(state.currentLine)) with
            | Ok(s) -> s
            | Error(_) -> ""

          List.append(state.currentLines, tailLine)

      if List.isEmpty(pending) then
        Option.None
      else
        match __tryEmitBlock(pending, state.lastId) with
        | Some(event) ->
          let nextState = ParseState { lastId = event.id, currentLines = [], currentLine = [] }
          Option.Some((event, nextState))
        | None -> Option.None
    | Some(b) ->
      // 10u8 = '\n'. End of a line.
      if b == 10u8 then
        let line =
          match Utf8.decode(Bytes.fromList(state.currentLine)) with
          | Ok(s) -> s
          | Error(_) -> ""

        if String.isEmpty(line) then
          // Blank line terminates the block. Try to emit an Event.
          match __tryEmitBlock(state.currentLines, state.lastId) with
          | Some(event) ->
            let nextState = ParseState { lastId = event.id, currentLines = [], currentLine = [] }
            Option.Some((event, nextState))
          | None ->
            // Block had no data; reset and keep reading.
            let nextState =
              ParseState { lastId = state.lastId, currentLines = [], currentLine = [] }

            __pullNextEvent(bytes, nextState)
        else
          // Regular line; append and keep reading.
          let nextState =
            ParseState
              { lastId = state.lastId
                currentLines = List.append(state.currentLines, line)
                currentLine = [] }

          __pullNextEvent(bytes, nextState)
      else
        let nextState =
          ParseState
            { lastId = state.lastId
              currentLines = state.currentLines
              currentLine = List.append(state.currentLine, b) }

        __pullNextEvent(bytes, nextState)


  /// Parse an SSE byte stream into a stream of Events. Lazy: events
  /// flow to the consumer as their terminating blank lines arrive,
  /// so a slow LLM response surfaces tokens as they're produced.
  let parse(bytes: Stream<UInt8>): Stream<Event> =
    let initial = ParseState { lastId = "", currentLines = [], currentLine = [] }
    Stream.unfold<ParseState, Event>(initial, fun state -> __pullNextEvent(bytes, state))
