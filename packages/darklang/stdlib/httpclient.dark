module Darklang.Stdlib.HttpClient

type BadHeader =
  // Occurs whrn a header key is empty. eg. [ ("", "") ]
  | EmptyKey
  | InvalidContentType
  /// Occurs when a header name holds a character not allowed in an HTTP token, eg. [ ("X A", "") ]
  | InvalidName
  /// Occurs when a header value holds a CR, LF or NUL, eg. [ ("X-A", "a\r\nB: c") ]
  | InvalidValue


type BadUrlDetails =
  /// Occurs when the URI scheme is not allowed. eg. "ftp://darklang.com"
  | UnsupportedProtocol
  /// Occurs when the host is not allowed. eg. "http://0"
  | InvalidHost
  /// Occurs when the URI does not conform to the format specified by RFC 2396. eg. "{ ] nonsense ^#( :"
  | InvalidUri
  /// Occurs when the request contains invalid headers. eg.A request to "http://google.com" with [("Metadata-Flavor", "Google")] header
  | InvalidRequest


/// A request destination or proxy.
type NetworkTarget =
  | Destination(String)
  | Proxy(String)


/// A DNS, connection, or I/O failure.
type NetworkFailure =
  /// Hostname lookup failed.
  | DnsFailure(NetworkTarget)
  /// The target is a host and optional port. Guard refusals omit details.
  | ConnectionFailure(NetworkTarget, Option<String>)
  /// Request authority and I/O error.
  | IoFailure(String, String)


type RequestError =
  | BadUrl(BadUrlDetails)
  /// Occurs when the request is cancelled due to a timeout
  | Timeout
  | BadHeader(BadHeader)
  /// A DNS, connection, or I/O failure.
  | NetworkError(NetworkFailure)
  /// Occurs when the TLS handshake fails, eg. the server's certificate can't be verified. The message says why.
  | TlsError(String)
  /// Occurs when the request method is not invalid.
  | BadMethod


// TODO: move this into a RequestError module, along with the type
let toString(e: RequestError): String =
  match e with
  | BadUrl(details) ->
    match details with
    | UnsupportedProtocol -> "Unsupported protocol"
    | InvalidHost -> "Invalid host"
    | InvalidUri -> "Invalid URI"
    | InvalidRequest -> "Invalid request"
  | Timeout -> "Timeout"
  | BadHeader(details) ->
    match details with
    | EmptyKey -> "Empty key"
    | InvalidContentType -> "Invalid content-type header"
    | InvalidName -> "Invalid header name"
    | InvalidValue -> "Header value contains CR, LF or NUL"
  | NetworkError(failure) ->
    let targetName(target: NetworkTarget): String =
      match target with
      | Destination(host) -> host
      | Proxy(host) -> "proxy " + host

    match failure with
    | DnsFailure(target) -> "Could not resolve host: " + targetName(target)
    | ConnectionFailure(target, detail) ->
      let message = "Could not connect to " + targetName(target)
      match detail with
      | Some(reason) -> message + ": " + reason
      | None -> message
    | IoFailure(authority, detail) -> "Request to " + authority + " failed: " + detail
  | TlsError(message) -> message
  | BadMethod -> "Bad Method"


impl Display for RequestError =
  let display = Stdlib.HttpClient.toString


/// The response from a HTTP request
type Response =
  { statusCode: Http.Status
    headers: List<(String * String)>
    body: Bytes }


/// A streaming HTTP response. Headers arrive immediately; `body` is a
/// lazy `Stream<UInt8>` that pulls bytes as they arrive on the wire.
/// The underlying HTTP response is released when the stream is
/// drained to completion or `Stdlib.Stream.close`d.
type StreamResponse =
  { statusCode: Http.Status
    headers: List<(String * String)>
    body: Stream<UInt8> }


/// The request headers as they go to the network: keys trimmed, and an empty key refused.
/// `request` and `stream` both pass through here, so this is where a request is shaped on
/// its way out. Whether it is safe to send (a CR, LF or NUL in a header, the network guard,
/// your grants) is decided below this, by the host.
let __outgoingHeaders(
  headers: List<(String * String)>)
  : Result<List<(String * String)>, RequestError> =
  match headers with
  | [] -> Result.Ok(headers)
  | _ ->
    let trimmed = List.map(headers, fun h -> (String.trim(Tuple2.first(h)), Tuple2.second(h)))
    if List.any(trimmed, fun h -> Tuple2.first(h) == "") then
      Result.Error(RequestError.BadHeader(BadHeader.EmptyKey))
    else
      Result.Ok(trimmed)


/// Make an HTTP call to <param uri> and read the whole response. Returns a <type Result>
/// where the response is wrapped in {{ Ok }} if a response was successfully received and
/// read, and is wrapped in {{ Error }} otherwise, including when the body fails or times
/// out partway.
///
/// A GET or HEAD is a read: it runs concurrently with what follows, and your code waits for
/// the response where it first looks at it, so `List.map get urls` has every request in
/// flight at once. Any other method is a write and runs in program order. <param body> is
/// sent whatever the method.
let request(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response, RequestError> =
  match __outgoingHeaders(headers) with
  | Ok(headers) -> Builtin.httpClientRequest(method, uri, headers, body)
  | Error(e) -> Result.Error(e)


let get(uri: String, headers: List<(String * String)>): Result<Response, RequestError> =
  request("GET", uri, headers, Bytes.empty)


let post(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response, RequestError> =
  request("POST", uri, headers, body)


let put(
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<Response, RequestError> =
  request("PUT", uri, headers, body)


let options(uri: String): Result<Response, RequestError> =
  request("OPTIONS", uri, [], Bytes.empty)


let delete(uri: String): Result<Response, RequestError> =
  request("DELETE", uri, [], Bytes.empty)


let head(uri: String): Result<Response, RequestError> =
  request("HEAD", uri, [], Bytes.empty)


/// Make a streaming HTTP call to <param uri>, in program order. The response's body is
/// a lazy `Stream<UInt8>`: bytes arrive as the server writes them. Drain with
/// `Stdlib.Stream.toList`, `Stdlib.Stream.toBytes`, or compose with `Stdlib.Stream.map` /
/// `Stdlib.Stream.filter` etc. The timeout covers the response's headers, not its body,
/// so a long-lived stream is not cut off.
///
/// The underlying socket is released when the body stream drains to
/// completion or is explicitly closed with `Stdlib.Stream.close`.
let stream(
  method: String,
  uri: String,
  headers: List<(String * String)>,
  body: Bytes)
  : Result<StreamResponse, RequestError> =
  match __outgoingHeaders(headers) with
  | Ok(headers) -> Builtin.httpClientStream(method, uri, headers, body)
  | Error(e) -> Result.Error(e)


/// Returns a header <type (String*String))> with {{'authorization'}} created using HTTP basic auth
let basicAuth(username: String, password: String): Result<(String * String), String> =
  if String.contains(username, "-") then
    Result.Error("Username cannot contain a hyphen")
  else
    let encoded = Base64.encodeText($"{username}:{password}")
    Result.Ok(("authorization", $"basic {encoded}"))


/// Returns a header <type (String*String))> with {{'authorization'}} set to <param token>
let bearerToken(token: String): (String * String) =
  ("authorization", "bearer " + token)


module ContentType =
  /// A header <type (String*String))> with {{content-type}} set for HTML form requests or responses
  val form = ("content-type", "application/x-www-form-urlencoded")


  /// A header <type (String*String))> with {{content-type}} set for JSON requests or responses
  val json = ("content-type", "application/json")


  /// A header <type (String*String))> with {{'content-type'}} set for plain text requests or responses
  val plainText = ("content-type", "text/plain; charset=utf-8")


  /// A header <type (String*String))> with {{'content-type'}} set for html requests
  val html = ("content-type", "text/html; charset=utf-8")


module Sse =
  // Server-Sent Events parsing over a Stream<UInt8>. Consumers
  // compose with the standard Stream builtins:
  //
  //     HttpClient.stream "GET" url headers Stdlib.Bytes.empty
  //     |> Stdlib.Result.map (fun r -> HttpClient.Sse.parse r.body)
  //
  // Implemented as a true streaming parser via `Stdlib.Stream.unfold`:
  // one `Event` is emitted as soon as its terminating blank line
  // arrives on the wire, rather than buffering the entire response.

  /// A parsed Server-Sent Event.
  type Event =
    { data: String
      eventType: String
      id: String }


  /// Intermediate state threaded through parsing. `lastId` persists
  /// across events per the SSE spec; `currentLines` holds the field
  /// lines for the block we're currently assembling; `currentLine`
  /// is the byte buffer for the line we're currently reading.
  ///
  /// TODO `currentLine` stays `List<UInt8>` (not `Bytes`) because it's
  /// accessed byte-by-byte during the parse — one append per byte and
  /// frequent fold-over-bytes for the line scan. Bytes.concat would
  /// reallocate the whole buffer on every append. Worth revisiting if
  /// anyone profiles the SSE parser; could become Bytes with an
  /// internal append-segments representation.
  type ParseState =
    { lastId: String
      currentLines: List<String>
      currentLine: List<UInt8> }


  /// Split a `field: value` line into its two parts. Per the SSE
  /// spec: if there's no colon, the whole line is the field with an
  /// empty value; the leading space after the colon (if any) is
  /// stripped.
  let __splitField(line: String): (String * String) =
    match String.indexOf(line, ":") with
    | None -> (line, "")
    | Some(idx) ->
      let field = String.slice(line, 0, idx)
      let afterColon = String.slice(line, idx + 1, String.length(line))
      let value =
        if String.startsWith(afterColon, " ") then
          String.dropFirst(afterColon, 1)
        else
          afterColon

      (field, value)


  /// Fold one SSE line into an accumulating block. `data: value`
  /// appends (with newline between multiple), `event: …` sets the
  /// event type, `id: …` sets the id, `:` comment lines are skipped,
  /// unknown fields are ignored.
  let __applyLine(
    data: String,
    eventType: String,
    id: String,
    hasData: Bool,
    line: String)
    : (String * String * String * Bool) =
    if String.isEmpty(line) then
      (data, eventType, id, hasData)
    else if String.startsWith(line, ":") then
      (data, eventType, id, hasData)
    else
      let (field, value) = __splitField(line)
      if field == "data" then
        let newData = if hasData then data + "\n" + value else value
        (newData, eventType, id, true)
      else if field == "event" then
        (data, value, id, hasData)
      else if field == "id" then
        (data, eventType, value, hasData)
      else
        (data, eventType, id, hasData)


  /// Build an Event from the accumulated lines of one block, if any
  /// `data:` field was seen. `lastId` is the id the block inherits
  /// when no `id:` field appears.
  let __tryEmitBlock(lines: List<String>, lastId: String): Option<Event> =
    let (data, eventType, id, hasData) = List.fold(lines, ("", "", lastId, false), fun(acc, line) ->
      let (d, e, i, h) = acc
      __applyLine(d, e, i, h, line))

    if hasData then
      Option.Some(Event { data = data, eventType = eventType, id = id })
    else
      Option.None


  /// Pull bytes from the underlying stream until a complete event
  /// terminator (blank line) arrives, then emit. Returns None once
  /// the stream is exhausted and no buffered data remains.
  let __pullNextEvent(bytes: Stream<UInt8>, state: ParseState): Option<(Event * ParseState)> =
    match Stream.next<UInt8>(bytes) with
    | None ->
      // End of stream. Flush any buffered lines as a final event
      // (SSE spec: a trailing blank line is optional).
      let pending =
        if List.isEmpty(state.currentLine) then
          state.currentLines
        else
          let tailLine =
            match Utf8.decode(Bytes.fromList(state.currentLine)) with
            | Ok(s) -> s
            | Error(_) -> ""

          List.append(state.currentLines, tailLine)

      if List.isEmpty(pending) then
        Option.None
      else
        match __tryEmitBlock(pending, state.lastId) with
        | Some(event) ->
          let nextState = ParseState { lastId = event.id, currentLines = [], currentLine = [] }
          Option.Some((event, nextState))
        | None -> Option.None
    | Some(b) ->
      // 10u8 = '\n'. End of a line.
      if b == 10u8 then
        let line =
          match Utf8.decode(Bytes.fromList(state.currentLine)) with
          | Ok(s) -> s
          | Error(_) -> ""

        if String.isEmpty(line) then
          // Blank line terminates the block. Try to emit an Event.
          match __tryEmitBlock(state.currentLines, state.lastId) with
          | Some(event) ->
            let nextState = ParseState { lastId = event.id, currentLines = [], currentLine = [] }
            Option.Some((event, nextState))
          | None ->
            // Block had no data; reset and keep reading.
            let nextState =
              ParseState { lastId = state.lastId, currentLines = [], currentLine = [] }

            __pullNextEvent(bytes, nextState)
        else
          // Regular line; append and keep reading.
          let nextState =
            ParseState
              { lastId = state.lastId
                currentLines = List.append(state.currentLines, line)
                currentLine = [] }

          __pullNextEvent(bytes, nextState)
      else
        let nextState =
          ParseState
            { lastId = state.lastId
              currentLines = state.currentLines
              currentLine = List.append(state.currentLine, b) }

        __pullNextEvent(bytes, nextState)


  /// Parse an SSE byte stream into a stream of Events. Lazy: events
  /// flow to the consumer as their terminating blank lines arrive,
  /// so a slow LLM response surfaces tokens as they're produced.
  let parse(bytes: Stream<UInt8>): Stream<Event> =
    let initial = ParseState { lastId = "", currentLines = [], currentLine = [] }
    Stream.unfold<ParseState, Event>(initial, fun state -> __pullNextEvent(bytes, state))
