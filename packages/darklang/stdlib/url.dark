module Darklang.Stdlib.Url

/// A URL split into the parts RFC 3986 names:
/// {{scheme://userinfo@host:port/path?query#fragment}}.
///
/// Every part is kept as it was WRITTEN, percent-escapes and all, so that
/// <fn toString> gives the URL back. Decode a part when you read it:
/// <fn percentDecode> for a path segment, <fn queryParams> for the query.
///
/// The scheme and the host are lowercased, since both are case-insensitive. An
/// IPv6 host is held without its brackets: {{http://[::1]/}} has host
/// {{Some "::1"}}.
///
/// {{scheme}} is {{None}} only in a relative reference (<fn parseReference>).
/// {{host}} is {{None}} when there is no {{//}} authority at all, as in
/// {{mailto:a@b.com}}, and {{Some ""}} when there is one but it is empty, as in
/// {{file:///etc/hosts}}. {{userinfo}} and {{port}} only mean anything when
/// {{host}} is {{Some}}.
type Url =
  { scheme: Option<String>
    userinfo: Option<String>
    host: Option<String>
    port: Option<Int64>
    path: String
    query: Option<String>
    fragment: Option<String> }


/// Why a parse refused a string. A {{part}} is one of "userinfo", "host",
/// "path", "query" or "fragment".
type ParseError =
  /// No {{scheme:}} at the front, as in {{example.com}} or {{/a/b}}. Use
  /// <fn parseReference> for a relative reference.
  | MissingScheme
  | InvalidScheme(scheme: String)
  /// An IP address that does not parse, an unclosed {{[}}, or an empty host with
  /// a user or port attached.
  | InvalidHost(host: String)
  /// Not digits, or over 65535.
  | InvalidPort(port: String)
  /// A character that may not appear unescaped in that part, such as a space.
  /// Percent-encode it first (<fn percentEncode>).
  | InvalidCharacter(part: String, character: String)
  /// A {{%}} that is not followed by two hex digits.
  | InvalidPercentEncoding(part: String)


impl Display for ParseError =
  let display(e: ParseError): String =
    match e with
    | MissingScheme -> "The URL has no scheme (such as https:) at the front"
    | InvalidScheme(scheme) -> $"'{scheme}' is not a valid URL scheme"
    | InvalidHost(host) -> $"'{host}' is not a valid host"
    | InvalidPort(port) -> $"'{port}' is not a valid port (0-65535)"
    | InvalidCharacter(part, character) ->
      $"'{character}' is not allowed in a URL's {part}; percent-encode it"
    | InvalidPercentEncoding(part) -> $"The {part} has a '%' that is not followed by two hex digits"


// Character classes, RFC 3986 section 2. The isASCII guard matters: a Char is a
// whole grapheme, and `e` plus a combining accent compares like an ASCII letter.
let isUnreserved(c: Char): Bool =
  Char.isASCII(c)
  && (Char.isASCIILetter(c) || Char.isDigit(c) || String.contains("-._~", String.fromChar(c)))


let isSubDelim(c: Char): Bool =
  String.contains("!$&'()*+,;=", String.fromChar(c))


let isHexDigit(c: Char): Bool =
  Char.isASCII(c) && (Char.isDigit(c) || String.contains("abcdefABCDEF", String.fromChar(c)))


/// Is every {{%}} in <param s> followed by two hex digits?
let __escapesOk(s: String): Bool =
  String.split(s, "%")
  |> List.drop(1)
  |> List.all(fun piece ->
    let hex = String.first(piece, 2)
    String.length(hex) == 2 && List.all(String.toList(hex), fun c -> isHexDigit(c)))


/// Checks that a part holds only unreserved characters, sub-delims, escapes and
/// <param extra>. A host may also hold non-ASCII letters ({{bücher.de}}), kept
/// as written. Does nothing unless <param strict>.
let __checkPart(
  strict: Bool,
  part: String,
  extra: String,
  s: Option<String>)
  : Result<Unit, ParseError> =
  match s with
  | Some(s) when strict ->
    let bad =
      s
      |> String.toList
      |> List.findFirst(fun c ->
        !(c == '%'
          || isUnreserved(c)
          || isSubDelim(c)
          || String.contains(extra, String.fromChar(c))
          || part == "host" && !Char.isASCII(c) && !Char.isWhitespace(c)))

    match bad with
    | Some(c) -> Result.Error(ParseError.InvalidCharacter(part, String.fromChar(c)))
    | None ->
      if __escapesOk(s) then
        Result.Ok()
      else
        Result.Error(ParseError.InvalidPercentEncoding(part))
  | _ -> Result.Ok()


let isDigits(s: String): Bool =
  s != "" && List.all(String.toList(s), fun c -> Char.isASCII(c) && Char.isDigit(c))


/// A dotted-quad: four decimal octets, each 0-255, with no leading zeros (RFC
/// 3986's dec-octet: {{010}} is not {{10}}, and some readers take it as octal).
let isIPv4(s: String): Bool =
  let octets = String.split(s, ".")
  List.length(octets) == 4
  && List.all(octets, fun o ->
    isDigits(o)
    && String.length(o) <= 3
    && (o == "0" || !String.startsWith(o, "0"))
    && (match Int64.parse(o) with
        | Ok(n) -> n <= 255
        | Error(_) -> false))


/// An IPv6 address: eight groups of up to four hex digits, one run of zero
/// groups shortened to {{::}}, and optionally an IPv4 address in place of the
/// last two groups ({{::ffff:1.2.3.4}}).
let isIPv6(s: String): Bool =
  let halves = String.split(s, "::")
  let halfCount = List.length(halves)
  let compressed = halfCount == 2
  if halfCount > 2 then
    false
  else
    let groups =
      halves
      |> List.map(fun half -> if half == "" then [] else String.split(half, ":"))
      |> List.flatten

    match List.last(groups) with
    | None -> compressed
    | Some(lastGroup) ->
      // Only the very last group may be an IPv4 address: in `1.2.3.4::` it is
      // the last group listed, but the `::` comes after it.
      let endsInIPv4 = String.contains(lastGroup, ".") && !String.endsWith(s, "::")
      let hexGroups = if endsInIPv4 then List.dropLast(groups) else groups
      let width = List.length(hexGroups) + (if endsInIPv4 then 2 else 0)
      List.all(hexGroups, fun g ->
        let n = String.length(g)
        n >= 1 && n <= 4 && List.all(String.toList(g), fun c -> isHexDigit(c)))
      && (if endsInIPv4 then isIPv4(lastGroup) else true)
      && (if compressed then width < 8 else width == 8)


/// What is between {{[}} and {{]}}: an IPv6 address, lowercased, optionally
/// with a zone id ({{fe80::1%25eth0}}, RFC 6874), which is kept as written.
let parseIPLiteral(inner: String): Option<String> =
  let (address, zone) =
    match String.splitFirst(inner, "%25") with
    | Some((a, z)) -> (a, "%25" + z)
    | None -> (inner, "")

  let zoneOk =
    zone == ""
    || zone != "%25"
       && __escapesOk(zone)
       && List.all(String.toList(zone), fun c -> c == '%' || isUnreserved(c))

  if isIPv6(address) && zoneOk then
    Option.Some(String.toLowercase(address) + zone)
  else
    Option.None


/// An empty port ({{http://x:/}}) is allowed by RFC 3986 and means no port.
let parsePort(s: String): Result<Option<Int64>, ParseError> =
  if s == "" then
    Result.Ok(Option.None)
  else
    match Int64.parse(s) with
    | Ok(n) when isDigits(s) && String.length(s) <= 5 && n <= 65535 -> Result.Ok(Option.Some(n))
    | _ -> Result.Error(ParseError.InvalidPort(s))


/// Splits an authority ({{user@host:port}}) into its three parts.
let parseAuthority(
  strict: Bool,
  authority: String)
  : Result<(Option<String> * Option<String> * Option<Int64>), ParseError> =
  // The LAST `@`, so a stray one in the userinfo is reported as a bad character
  // there instead of turning up in the host.
  let (userinfo, hostPort) =
    match String.splitLast(authority, "@") with
    | Some((u, hp)) -> (Option.Some(u), hp)
    | None -> (Option.None, authority)

  let _ = (__checkPart(strict, "userinfo", ":", userinfo))?
  let (host, portText) =
    (if String.startsWith(hostPort, "[") then
       match String.splitFirst(hostPort, "]") with
       | Some((bracketed, after)) when after == "" || String.startsWith(after, ":") ->
         match parseIPLiteral(String.dropFirst(bracketed, 1)) with
         | Some(host) -> Result.Ok((host, String.dropFirst(after, 1)))
         | None -> Result.Error(ParseError.InvalidHost(hostPort))
       | _ -> Result.Error(ParseError.InvalidHost(hostPort))
     else
       let (name, portText) =
         match String.splitLast(hostPort, ":") with
         | Some((h, p)) -> (h, p)
         | None -> (hostPort, "")

       // Four dot-separated runs of digits reads as an IPv4 address, so hold it
       // to being one: `999.1.1.1` is a typo, not a host name. Any other name
       // made of digits (`1234`, `1.2.3`) is a reg-name, as RFC 3986 says.
       let looksLikeIPv4 =
         List.length(String.split(name, ".")) == 4
         && List.all(String.split(name, "."), fun o -> isDigits(o))

       match __checkPart(strict, "host", "", Option.Some(name)) with
       | Error(e) -> Result.Error(e)
       | Ok(_) ->
         // A lenient parse skips the character check, but a `:` left in the
         // name would print back as an IPv6 literal, so it is refused here too.
         if looksLikeIPv4 && !isIPv4(name) || String.contains(name, ":") then
           Result.Error(ParseError.InvalidHost(name))
         else
           Result.Ok((String.toLowercase(name), portText)))?

  let port = (parsePort(portText))?
  if host == "" && (userinfo != Option.None || port != Option.None) then
    Result.Error(ParseError.InvalidHost(hostPort))
  else
    Result.Ok((userinfo, Option.Some(host), port))


/// The scheme at the front of <param s>, if it has one, and the rest. Text before
/// the first {{:}} that holds a {{/}}, {{?}} or {{#}} is not a scheme, so
/// {{a/b:c}} has none.
let splitScheme(s: String): Result<(Option<String> * String), ParseError> =
  match String.splitFirst(s, ":") with
  | Some((scheme, rest)) when !List.any([ "/", "?", "#" ], fun d -> String.contains(scheme, d)) ->
    let validScheme =
      match String.toList(scheme) with
      | [] -> false
      | [first, ...others] ->
        Char.isASCII(first)
        && Char.isASCIILetter(first)
        && List.all(others, fun c ->
          Char.isASCII(c)
          && (Char.isASCIILetter(c)
              || Char.isDigit(c)
              || String.contains("+-.", String.fromChar(c))))

    if validScheme then
      Result.Ok((Option.Some(String.toLowercase(scheme)), rest))
    else if scheme == "" then
      Result.Error(ParseError.MissingScheme)
    else
      Result.Error(ParseError.InvalidScheme(scheme))
  | _ -> Result.Ok((Option.None, s))


let __parseWith(strict: Bool, absolute: Bool, s: String): Result<Url, ParseError> =
  let (scheme, afterScheme) =
    (match splitScheme(s) with
     | Error(_) when !strict -> Result.Ok((Option.None, s))
     | Ok((None, _)) when absolute -> Result.Error(ParseError.MissingScheme)
     | result -> result)?

  let (beforeFragment, fragment) =
    match String.splitFirst(afterScheme, "#") with
    | Some((a, f)) -> (a, Option.Some(f))
    | None -> (afterScheme, Option.None)

  let (hierPart, query) =
    match String.splitFirst(beforeFragment, "?") with
    | Some((h, q)) -> (h, Option.Some(q))
    | None -> (beforeFragment, Option.None)

  let (authority, path) =
    match String.stripPrefix(hierPart, "//") with
    | Some(rest) ->
      match String.splitFirst(rest, "/") with
      | Some((a, p)) -> (Option.Some(a), "/" + p)
      | None -> (Option.Some(rest), "")
    | None -> (Option.None, hierPart)

  let (userinfo, host, port) =
    (match authority with
     | Some(a) -> parseAuthority(strict, a)
     | None -> Result.Ok((Option.None, Option.None, Option.None)))?

  let _ = (__checkPart(strict, "path", ":@/", Option.Some(path)))?
  let _ = (__checkPart(strict, "query", ":@/?", query))?
  let _ = (__checkPart(strict, "fragment", ":@/?", fragment))?
  Result.Ok(
    Url
      { scheme = scheme
        userinfo = userinfo
        host = host
        port = port
        path = path
        query = query
        fragment = fragment })


/// Parses an absolute URL, such as
/// {{https://user@example.com:8080/a/b?x=1#top}}, into a <type Url>.
///
/// Strict about what RFC 3986 allows: a space, or a non-ASCII character outside
/// the host, must be percent-encoded first. Note that {{localhost:8080}} parses,
/// as scheme {{localhost}} with path {{8080}}, which is what the RFC says it is.
let parse(s: String): Result<Url, ParseError> =
  __parseWith(true, true, s)


/// Like <fn parse>, but also takes a relative reference, as found in a link:
/// {{/a/b}}, {{../c}}, {{?q=1}}, {{#top}}, {{//host/p}} or {{""}}. Its
/// {{scheme}} is {{None}}. See <fn resolve> to follow one from a base URL.
let parseReference(s: String): Result<Url, ParseError> =
  __parseWith(true, false, s)


/// Like <fn parseReference>, but does not check characters: a space, a
/// non-ASCII character or a stray {{%}} is kept as written. For a URL you did
/// not write and want split rather than judged, such as a request's. The host
/// and port are still checked, so it can fail: {{http://x:port/}} is an
/// <type ParseError>.
let parseLenient(s: String): Result<Url, ParseError> =
  __parseWith(false, false, s)


/// Prints <param url> back as a string. For anything <fn parse> accepted,
/// {{parse(toString(u)) == Ok u}}; and for a URL already in lowercase with no
/// empty port, {{toString}} of its parse is the original string.
let toString(url: Url): String =
  let scheme =
    match url.scheme with
    | Some(s) -> s + ":"
    | None -> ""

  let authority =
    match url.host with
    | None -> ""
    | Some(host) ->
      let user =
        match url.userinfo with
        | Some(u) -> u + "@"
        | None -> ""

      let shownHost = if String.contains(host, ":") then "[" + host + "]" else host
      let port =
        match url.port with
        | Some(p) -> ":" + display(p)
        | None -> ""

      "//" + user + shownHost + port

  let query =
    match url.query with
    | Some(q) -> "?" + q
    | None -> ""

  let fragment =
    match url.fragment with
    | Some(f) -> "#" + f
    | None -> ""

  scheme + authority + url.path + query + fragment


impl Display for Url =
  let display = Stdlib.Url.toString


/// RFC 3986 section 5.2.4. <param out> holds the output's segments, each with
/// its leading {{/}}, newest first.
let __removeDots(input: String, out: List<String>): String =
  if input == "" || input == "." || input == ".." then
    out
    |> List.reverse
    |> String.join("")
  else if String.startsWith(input, "../") then
    __removeDots(String.dropFirst(input, 3), out)
  else if String.startsWith(input, "./") || String.startsWith(input, "/./") then
    __removeDots(String.dropFirst(input, 2), out)
  else if input == "/." then
    __removeDots("/", out)
  else if String.startsWith(input, "/../") then
    __removeDots(String.dropFirst(input, 3), List.drop(out, 1))
  else if input == "/.." then
    __removeDots("/", List.drop(out, 1))
  else
    let (lead, rest) =
      match String.stripPrefix(input, "/") with
      | Some(r) -> ("/", r)
      | None -> ("", input)

    match String.splitFirst(rest, "/") with
    | Some((segment, after)) -> __removeDots("/" + after, List.prepend(out, lead + segment))
    | None -> __removeDots("", List.prepend(out, lead + rest))


/// Removes {{.}} and {{..}} segments from a path: {{/a/b/../c/./d}} is
/// {{/a/c/d}}. The result can start with {{//}} ({{/..//x}} is {{//x}}); see
/// <fn resolve> for what that means in a URL with no host.
let removeDotSegments(path: String): String =
  __removeDots(path, [])


/// A path that cannot be misread when printed (RFC 3986 sections 4.2 and 5.3).
/// With no host, a path starting {{//}} would read back as one, so it gets a
/// {{/.}} in front; with no scheme either, a first segment holding a {{:}} would
/// read back as a scheme, so it gets a {{./}}.
let __guardPath(url: Url): Url =
  let firstSegment =
    match String.splitFirst(url.path, "/") with
    | Some((first, _)) -> first
    | None -> url.path

  if url.host != Option.None then
    url
  else if String.startsWith(url.path, "//") then
    { url with path = "/." + url.path }
  else if url.scheme == Option.None && String.contains(firstSegment, ":") then
    { url with path = "./" + url.path }
  else
    url


/// Where <param ref> points when followed from <param base>, the way a browser
/// follows a link (RFC 3986 section 5.2): {{../c}} from {{http://a/b/x}} is
/// {{http://a/c}}. Dot segments are removed from the result's path. With no
/// host, a path that would then start {{//}} keeps a {{/.}} in front
/// ({{non-spec:/.//p}}), so the result never prints as a different host.
let resolve(base: Url, ref: Url): Url =
  __guardPath(__resolveRaw(base, ref))


/// RFC 3986 section 5.2.2, before <fn __guardPath>.
let __resolveRaw(base: Url, ref: Url): Url =
  if ref.scheme != Option.None then
    { ref with path = removeDotSegments(ref.path) }
  else if ref.host != Option.None then
    { ref with scheme = base.scheme, path = removeDotSegments(ref.path) }
  else if ref.path == "" then
    { base with
        query = if ref.query == Option.None then base.query else ref.query
        fragment = ref.fragment }
  else
    let path =
      if String.startsWith(ref.path, "/") then
        ref.path
      else if base.host != Option.None && base.path == "" then
        "/" + ref.path
      else
        match String.splitLast(base.path, "/") with
        | Some((dir, _)) -> dir + "/" + ref.path
        | None -> ref.path

    { base with path = removeDotSegments(path), query = ref.query, fragment = ref.fragment }


/// The query string's fields, decoded, in order and with repeats kept. Splits
/// each field at its first {{=}}, reads {{+}} as a space (as an HTML form sends
/// it), and skips empty fields, so {{?a=1&&b}} is {{[("a", "1"), ("b", "")]}}.
/// <fn withQueryParams> goes the other way.
let queryParams(url: Url): List<(String * String)> =
  match url.query with
  | None -> []
  | Some(q) ->
    q
    |> String.split("&")
    |> List.filterMap(fun field ->
      if field == "" then
        Option.None
      else
        match String.splitFirst(field, "=") with
        | Some((k, v)) -> Option.Some((formDecode(k), formDecode(v)))
        | None -> Option.Some((formDecode(field), "")))


/// The path's segments, decoded: {{/blog/caf%C3%A9/}} is {{["blog", "café"]}}.
/// The empty segment before a leading {{/}} and after a trailing one is dropped,
/// so {{/}} and {{""}} are both {{[]}}; one in the middle ({{/a//b}}) is kept.
/// Decoding is <fn percentDecode>, so a {{+}} stays a {{+}}. Use it for routing,
/// and the raw {{path}} when an escaped {{/}} ({{%2F}}) must not split.
/// <fn withPathSegments> goes the other way.
let pathSegments(url: Url): List<String> =
  let segments =
    match String.split(url.path, "/") with
    | ["", ...rest] -> rest
    | all -> all

  let segments =
    match List.last(segments) with
    | Some("") -> List.dropLast(segments)
    | _ -> segments

  List.map(segments, fun s -> percentDecode(s))


/// The other way from <fn queryParams>: {{[("q", "a b"), ("n", "1")]}} is
/// {{q=a%20b&n=1}}, ready to go after a {{?}}.
let encodeQuery(params: List<(String * String)>): String =
  params
  |> List.map(fun pair ->
    let (k, v) = pair
    percentEncode(k) + "=" + percentEncode(v))
  |> String.join("&")


/// The other way from <fn pathSegments>: sets the path to <param segments>, each
/// one <fn percentEncode>d, so a {{/}}, {{?}} or {{#}} in it stays data:
/// {{["users", "a/b", "café"]}} is {{/users/a%2Fb/caf%C3%A9}}. A segment that is
/// just {{.}} or {{..}} is written {{%2E}} or {{%2E%2E}}, which <fn resolve> does
/// not follow (a browser still does).
///
/// The path starts with {{/}} when there is a host or the old path did, and is
/// relative otherwise: {{mailto:old}} with {{["new"]}} is {{mailto:new}}, and a
/// relative {{a/b}} stays relative. No segments is {{/}} or {{""}} by that rule.
///
/// {{pathSegments(withPathSegments(u, s)) == s}}, with two exceptions: a last
/// segment of {{""}} gives a trailing {{/}}, which <fn pathSegments> drops; and
/// with no host, a first segment of {{""}} gets a dot segment in front
/// ({{/.//x}} or {{.//x}}), so the path reads back as neither a host nor absolute.
let withPathSegments(url: Url, segments: List<String>): Url =
  let joined =
    segments
    |> List.map(fun s ->
      match s with
      | "." -> "%2E"
      | ".." -> "%2E%2E"
      | _ -> percentEncode(s))
    |> String.join("/")

  let path =
    if url.host != Option.None || String.startsWith(url.path, "/") then
      "/" + joined
    else if List.head(segments) == Option.Some("") then
      "./" + joined
    else
      joined

  __guardPath({ url with path = path })


/// The other way from <fn queryParams>: sets the query to <param params>, written
/// by <fn encodeQuery>, so {{[("q", "a&b")]}} is {{?q=a%26b}}, and
/// {{queryParams(withQueryParams(u, ps)) == ps}}. No params is no query at all,
/// rather than a bare {{?}}.
let withQueryParams(url: Url, params: List<(String * String)>): Url =
  { url with query = if params == [] then Option.None else Option.Some(encodeQuery(params)) }


/// Decodes {{%XX}} escapes, byte by byte, and reads the result as UTF-8:
/// {{caf%C3%A9}} is {{café}}. A {{+}} stays a {{+}}; use <fn formDecode> for
/// a query field, where it means a space.
///
/// A {{%}} that does not start two hex digits is kept as itself rather than
/// dropped, and bytes that are not valid UTF-8 become U+FFFD.
let percentDecode(s: String): String =
  match String.split(s, "%") with
  | [] -> ""
  | [first, ...rest] ->
    rest
    |> List.fold([ Utf8.encode(first) ], fun(reversed, piece) ->
      let hex = String.slice(piece, 0, 2)

      // The length check is not redundant: `Base16.decode ""` succeeds, so a `%`
      // at the very end of the string decodes to no bytes at all and vanishes.
      match if String.length(hex) == 2 then
              Base16.decode(hex)
            else
              Result.Error("not an escape") with
      | Ok(b) -> List.prepend(List.prepend(reversed, b), Utf8.encode(String.dropFirst(piece, 2)))
      | Error(_) -> List.prepend(reversed, Utf8.encode("%" + piece)))
    |> List.reverse
    |> Bytes.concatAll
    |> Utf8.decodeWithReplacement


/// Decodes one field of a query string or HTML form: <fn percentDecode>, with
/// {{+}} read as a space first, as a form sends it. A literal {{+}} travels as
/// {{%2B}} and survives: {{C%2B%2B+map}} is {{C++ map}}.
let formDecode(s: String): String =
  percentDecode(String.replaceAll(s, "+", " "))


/// Escapes everything in <param s> except the unreserved characters
/// ({{A-Z a-z 0-9 - . _ ~}}), as UTF-8 bytes in uppercase hex: {{a b/é}} is
/// {{a%20b%2F%C3%A9}}. Safe for any one part of a URL, a path segment or a query
/// key or value; it escapes {{/}}, so encode segments, not a whole path.
let percentEncode(s: String): String =
  s
  |> Utf8.encode
  |> Bytes.toList
  |> List.map(fun b ->
    match Char.fromCodepoint(UInt32.fromUInt8(b)) with
    | Some(c) when b < 128u8 && isUnreserved(c) -> String.fromChar(c)
    | _ -> "%" + Base16.encode(Bytes.fromList([ b ])))
  |> String.join("")
