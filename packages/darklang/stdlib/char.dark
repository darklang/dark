module Darklang.Stdlib.Char


/// Return the uppercase value of <param c>. If <param c> does not have an uppercase value, returns <param c>
let toUppercase(c: Char): Char =
  match Stdlib.String.head(Stdlib.String.toUppercase(Stdlib.toString(c))) with
  | Some(upper) -> upper
  | None -> c


/// Return the lowercase value of <param c>. If <param c> does not have a lowercase value, returns <param c>
let toLowercase(c: Char): Char =
  match Stdlib.String.head(Stdlib.String.toLowercase(Stdlib.toString(c))) with
  | Some(lower) -> lower
  | None -> c


/// Return whether <param c> is a lowercase character.
let isLowercase(c: Char): Bool =
  Stdlib.Char.toLowercase(c) == c && Stdlib.Char.toUppercase(c) != c


/// Return whether <param c> is an uppercase character.
let isUppercase(c: Char): Bool =
  Stdlib.Char.toLowercase(c) != c && Stdlib.Char.toUppercase(c) == c


/// Return whether <param c> is a digit (that is, the digits 0-9)
let isDigit(c: Char): Bool =
  (Stdlib.Char.isGreaterThanOrEqualTo(c, '0'))
  && (Stdlib.Char.isLessThanOrEqualTo(c, '9'))


/// Return whether the first scalar in <param c> is a Unicode letter.
let isLetter(c: Char): Bool =
  match Stdlib.String.toCodepoints(Stdlib.toString(c)) with
  | [first, ...rest] -> Stdlib.Codepoint.isLetter(first)
  | _ -> false


/// Return whether the first scalar in <param c> is Unicode whitespace.
let isWhitespace(c: Char): Bool =
  match Stdlib.String.toCodepoints(Stdlib.toString(c)) with
  | [first, ...rest] -> Stdlib.Codepoint.isWhitespace(first)
  | _ -> false


/// Return whether the first scalar in <param c> is a Unicode letter or digit.
let isAlphanumeric(c: Char): Bool =
  match Stdlib.String.toCodepoints(Stdlib.toString(c)) with
  | [first, ...rest] -> Stdlib.Codepoint.isAlphanumeric(first)
  | _ -> false


/// Return whether <param c> is an ASCII letter
let isASCIILetter(c: Char): Bool =
  (Stdlib.Char.isGreaterThanOrEqualTo(c, 'a'))
  && (Stdlib.Char.isLessThanOrEqualTo(c, 'z'))
  || (Stdlib.Char.isGreaterThanOrEqualTo(c, 'A'))
      && (Stdlib.Char.isLessThanOrEqualTo(c, 'Z'))


/// Return whether <param c> is a valid ASCII character
let isASCII(c: Char): Bool =
  let asciiCode = Stdlib.Char.toAsciiCode(c)

  match asciiCode with
  | Some(ascii) -> (ascii >= 0) && (ascii <= 127)
  | None -> false


/// Return {{Some <var code>}} if <param c> is a valid ASCII character, otherwise {{None}}"
let toAsciiCode(c: Char): Stdlib.Option.Option<Int> =
  match Stdlib.Char.toCodepoint(c) with
  | Some(code) -> if code < 128ul then Stdlib.Option.Option.Some(Stdlib.Int.fromUInt32(code)) else Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None


/// Return whether <param c1> sorts before <param c2>, by code point
let isLessThan(c1: Char, c2: Char): Bool = Builtin.charIsLessThan(c1, c2)


/// Return whether <param c1> sorts before or equal to <param c2>, by code point
let isLessThanOrEqualTo(c1: Char, c2: Char): Bool =
  Builtin.charIsLessThanOrEqualTo(c1, c2)


/// Return whether <param c1> sorts after <param c2>, by code point
let isGreaterThan(c1: Char, c2: Char): Bool =
  Builtin.charIsGreaterThan(c1, c2)


/// Return whether <param c1> sorts after or equal to <param c2>, by code point
let isGreaterThanOrEqualTo(c1: Char, c2: Char): Bool =
  Builtin.charIsGreaterThanOrEqualTo(c1, c2)

/// `a < b` on Chars: by code point, the rule the four comparisons above use.
impl Compare for Char =
  let lessThan = Stdlib.Char.isLessThan
  let lessThanOrEqualTo = Stdlib.Char.isLessThanOrEqualTo
  let greaterThan = Stdlib.Char.isGreaterThan
  let greaterThanOrEqualTo = Stdlib.Char.isGreaterThanOrEqualTo


impl ToString for Char =
  /// Stringify <param c>
  let toString(c: Char): String = Builtin.charToString(c)


/// Return {{Some <var c>}} for the Unicode codepoint <param codepoint>,
/// or {{None}} if the value is not a valid scalar (> 0x10FFFF or a surrogate).
let fromCodepoint(codepoint: UInt32): Stdlib.Option.Option<Char> =
  if Stdlib.Codepoint.isValidScalar(codepoint) then
    Builtin.charFromCodepoint(codepoint)
  else Stdlib.Option.Option.None


/// Return the codepoint when <param c> contains exactly one Unicode scalar.
/// This is the inverse of <fn Char.fromCodepoint>.
let toCodepoint(c: Char): Stdlib.Option.Option<UInt32> =
  match Stdlib.String.toCodepoints(Stdlib.toString(c)) with
  | [codepoint] -> Stdlib.Option.Option.Some(codepoint)
  | _ -> Stdlib.Option.Option.None
