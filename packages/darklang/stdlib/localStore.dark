/// This instance's own local state: where its store is, and the key-value settings beside it.
///
/// One module because these are the two primitives every layer needs and neither belongs to any of
/// them. `scm/` runs SQL against the store; the CLI's `config`, `backups` and `scripts` do too; the
/// relay and the package browser do. Without a shared home each of them carries its own
/// `let localDb () : String = Builtin.localDbPath ()`, which is the one-wrapper rule defeated by
/// copy-paste rather than a case where wrapping does not work.
module Darklang.Stdlib.LocalStore


/// The path of this instance's package store, for `Stdlib.Sqlite` calls against it.
///
/// A PATH rather than a handle: every reader opens its own connection, and the store moves per
/// instance (its HOME, a test's copy, a backup being restored), so nothing may cache it.
let path(): String = Builtin.localDbPath()


/// Read a setting. `""` when the key has never been set, which every caller treats as the default
/// rather than as an error: a fresh install has none of them.
///
/// Keys are namespaced by whoever owns them (`sync.*`, `current_branch`, `exec.*`), and the
/// namespace is the contract. `Seed.export` strips this table wholesale, so nothing here travels.
let configGet(key: String): String = Builtin.configGet(key)


/// Write a setting. Local to this instance, always: this is where "which relay" and "which branch"
/// live, and neither is anybody else's business.
let configSet(key: String, value: String): Unit = Builtin.configSet(key, value)


/// One copy of the store: a backup in the folder beside it, or a snapshot written elsewhere.
/// The path is for showing; an action names a backup by its name.
type Backup = { name: String, path: String, bytes: Int }


/// What `backups` does. Each answers with the backups it is about.
type BackupAction =
  /// Every backup, newest first. The upgrade path's are among them.
  | List
  /// Take one now (`data.db.manual-<time>`).
  | Create
  /// Put the named backup in place of the store. The store as it is now is copied aside first
  /// (`data.db.pre-restore-<time>`), and that copy is the answer. Anything this process has already
  /// read is still the old store, so the caller should say to restart.
  | Restore of String
  /// Delete the named backup.
  | Delete of String
  /// Write a copy of the store to a path outside the folder, such as a store to try a new
  /// release against. A database already there has its contents replaced.
  | SnapshotTo of String


/// Copies of this instance's store: list, take, restore and delete the backups beside it, or write
/// a snapshot elsewhere.
///
/// The runtime owns the folder, the names and the copying, including the upgrade path's own
/// backups, so this never builds a path. Every copy goes through SQLite's online-backup API rather
/// than a file copy: the store path is guarded (a guest must not read or replace the host's store),
/// and a copy of `data.db` alone would miss whatever is still in the WAL.
let backups(action: BackupAction): Stdlib.Result.Result<List<Backup>, String> =
  Builtin.storeBackup(action)


/// Write a copy of this instance's store to <param path>, WAL included.
let snapshotTo(path: String): Stdlib.Result.Result<Unit, String> =
  backups(BackupAction.SnapshotTo(path)) |> Stdlib.Result.map(fun _ -> ())
