/// A stream is a lazy sequence: its elements are produced as they are read. It is a value:
/// reading it does not change it, so every holder sees the same elements. Transforms give a
/// new stream and leave their source as it was.
module Darklang.Stdlib.Stream

/// Builds a Stream that yields the elements of <param items> in order.
let fromList(items: List<'a>): Stream<'a> =
  Builtin.streamFromList<'a>(items)


/// Builds a Stream by repeatedly applying <param step> to <param seed>.
/// Each call returns either {{Some (element, nextSeed)}} to yield an
/// element and continue, or {{None}} to terminate.
let unfold(seed: 's, step: 's -> Option<('a * 's)>): Stream<'a> =
  Builtin.streamUnfold<'s, 'a>(seed, step)


/// The first element of <param stream> and the rest of the stream, or
/// {{None}} when it is empty. Calling it again on <param stream> answers the same.
let next(stream: Stream<'a>): Option<('a * Stream<'a>)> =
  Builtin.streamNext<'a>(stream)


/// All the elements of <param stream>, as a List.
let toList(stream: Stream<'a>): List<'a> =
  Builtin.streamToList<'a>(stream)


/// All the bytes of a byte stream, as a Bytes. Reads whole chunks when
/// the stream comes straight from an IO source (e.g. HttpClient.stream).
let toBytes(stream: Stream<UInt8>): Bytes =
  Builtin.streamToBytes(stream)


/// Releases the IO source behind <param stream> now, rather than at its
/// end or when nothing holds it. What was already read stays; the rest
/// ends here. Does nothing to a stream with no IO source.
let close(stream: Stream<'a>): Unit =
  Builtin.streamClose<'a>(stream)


/// Returns a new Stream that yields {{fn x}} for each element {{x}}
/// of <param stream>. Lazy; <param fn> runs when an element is read.
let map(stream: Stream<'a>, fn: 'a -> 'b): Stream<'b> =
  Builtin.streamMap<'a, 'b>(stream, fn)


/// Returns a new Stream that yields only the elements of <param stream>
/// for which <param pred> is true. Lazy.
let filter(stream: Stream<'a>, pred: 'a -> Bool): Stream<'a> =
  Builtin.streamFilter<'a>(stream, pred)


/// Returns a new Stream yielding at most <param n> elements from the
/// front of <param stream>. Lazy; reads at most <param n> elements of
/// the source.
let take(stream: Stream<'a>, n: Int64): Stream<'a> =
  Builtin.streamTake<'a>(stream, n)


/// Returns a new Stream with the elements of each of <param streams>
/// in order. Lazy.
let concat(streams: List<Stream<'a>>): Stream<'a> =
  Builtin.streamConcat<'a>(streams)
