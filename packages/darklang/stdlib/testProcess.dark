/// Typed process isolation for integration tests. The host snapshots the store,
/// invokes a named function by hash, and reports any snapshot cleanup failures.
module Darklang.Stdlib.Test.Process

type Options =
  { branch: Option<Uuid>
    timeoutMs: Int64
    columns: Int64
    rows: Int64 }


type Output<'a> =
  { result: Result.Result<'a, String>
    stdout: String
    stderr: String
    exitCode: Int64
    cleanupErrors: List<String> }


let defaults(): Options =
  Options { branch = Option.None, timeoutMs = 120000, columns = 80, rows = 24 }


/// Run a named, unapplied package function with explicit arguments. The default
/// branch is the current test's branch. Stdin is EOF; stdout and stderr are
/// captured separately from the typed result. Requires Native and a running test.
/// The timeout covers worker execution and output collection, after the store copy.
let run(options: Options, callback: 'a -> 'b, argument: 'a): Result.Result<Output<'b>, String> =
  Builtin.testRunIsolated(
    options.branch,
    options.timeoutMs,
    options.columns,
    options.rows,
    callback,
    argument,
    LanguageTools.PackageManager.Test.Worker.main)
  |> Result.andThen(fun((result, stdout, stderr, exitCode, cleanupErrors)) ->
    match result with
    | None ->
      String.join(
        List.concat(
          [ $"Isolated test exited {display(exitCode)} without a result:", stdout, stderr ],
          cleanupErrors),
        "\n")
      |> Result.Result.Error
    | Some(result) ->
      Result.Result.Ok(
        Output
          { result = result
            stdout = stdout
            stderr = stderr
            exitCode = exitCode
            cleanupErrors = cleanupErrors }))
