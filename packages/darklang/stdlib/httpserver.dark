module Darklang.Stdlib.HttpServer

// HTTP Server functionality for Darklang

/// An HTTP handler definition
type Handler =
  { route: String
    method: String
    handler: Http.Request -> Http.Response }


/// A GET route, so a handler table reads as routes rather than record boilerplate.
let get(route: String, fn: Http.Request -> Http.Response): Handler =
  Handler { route = route, method = "GET", handler = fn }


/// A POST route. See <fn Stdlib.HttpServer.get>.
let post(route: String, fn: Http.Request -> Http.Response): Handler =
  Handler { route = route, method = "POST", handler = fn }


/// Result of matching a route pattern against a request path
type RouteMatch =
  { matched: Bool
    vars: List<(String * String)> }


/// Segment type for route parsing
type RouteSegment =
  | Literal(String)
  | Variable(String)
  | Wildcard(String)


/// Parse a route pattern into segments
let __parseRouteSegments(route: String): List<RouteSegment> =
  let segments = String.split(route, "/")
  segments
  |> List.filterMap(fun seg ->
    if String.isEmpty(seg) then
      Option.None
    else if String.startsWith(seg, ":") then
      Option.Some(RouteSegment.Variable(String.dropFirst(seg, 1)))
    else if String.startsWith(seg, "*") then
      Option.Some(RouteSegment.Wildcard(String.dropFirst(seg, 1)))
    else
      Option.Some(RouteSegment.Literal(seg)))


/// Match a single route segment against a path segment
let __matchSegment(
  routeSeg: RouteSegment,
  pathSeg: String,
  remainingPath: List<String>)
  : Option<List<(String * String)>> =
  match routeSeg with
  | Literal(expected) -> if expected == pathSeg then Option.Some([]) else Option.None
  | Variable(name) -> Option.Some([ (name, pathSeg) ])
  | Wildcard(name) ->
    let fullPath = String.join(List.prepend(remainingPath, pathSeg), "/")
    Option.Some([ (name, fullPath) ])


/// Match a request path against a route pattern
/// Split a request path into non-empty segments.
let splitPath(requestPath: String): List<String> =
  String.split(requestPath, "/") |> List.filter(fun s -> Bool.not(String.isEmpty(s)))


/// `matchRoute` against segments that have already been parsed and split.
///
/// Routing splits one path against every handler, so doing it here rather than inside `matchRoute`
/// lets the caller split once instead of once per handler.
let __matchRouteSegments(routeSegs: List<RouteSegment>, pathSegs: List<String>): RouteMatch =
  let routeLen = List.length(routeSegs)
  let pathLen = List.length(pathSegs)
  if routeLen == 0 && pathLen == 0 then
    RouteMatch { matched = true, vars = [] }
  else if routeLen != pathLen then
    RouteMatch { matched = false, vars = [] }
  else
    // Use zipShortest since we already checked lengths are equal
    let zipped = List.zipShortest(routeSegs, pathSegs)
    let result =
      zipped
      |> List.fold(Option.Some([]), fun(acc, pair) ->
        match acc with
        | None -> Option.None
        | Some(vars) ->
          let (routeSeg, pathSeg) = pair
          match __matchSegment(routeSeg, pathSeg, []) with
          | Some(newVars) -> Option.Some(List.concat(vars, newVars))
          | None -> Option.None)

    match result with
    | Some(vars) -> RouteMatch { matched = true, vars = vars }
    | None -> RouteMatch { matched = false, vars = [] }


let matchRoute(routePattern: String, requestPath: String): RouteMatch =
  __matchRouteSegments(__parseRouteSegments(routePattern), splitPath(requestPath))


/// Find the first handler that matches the request
let __findHandler(
  handlers: List<Handler>,
  method: String,
  path: String)
  : Option<(Handler * RouteMatch)> =
  // Split once here rather than inside `matchRoute`, which runs per handler: the result is the
  // same every time, so splitting there scales the work with handlers tested.
  let pathSegs = splitPath(path)
  let matchingHandler =
    handlers
    |> List.findFirst(fun h ->
      // Method first. The route match is the expensive half, and a handler whose method cannot
      // match never needs it -- the previous order computed it regardless.
      if h.method == method || h.method == "*" then
        let routeMatch = __matchRouteSegments(__parseRouteSegments(h.route), pathSegs)
        routeMatch.matched
      else
        false)

  match matchingHandler with
  | Some(h) ->
    let routeMatch = __matchRouteSegments(__parseRouteSegments(h.route), pathSegs)
    Option.Some((h, routeMatch))
  | None -> Option.None


/// The path of a request's url, as written (not decoded), always starting with
/// {{/}}. Read from the request-target alone (<fn Http.requestTarget>), so the
/// host, which a client supplies, cannot change it.
let getPath(req: Http.Request): String =
  let path = (Http.requestTarget(req.url)).path
  if String.startsWith(path, "/") then path else "/" + path


/// Route a request through a list of handlers
/// Returns the response from the first matching handler, or 404
let routeRequest(handlers: List<Handler>, req: Http.Request): Http.Response =
  let path = getPath(req)
  match __findHandler(handlers, req.method, path) with
  | Some((handler, _routeMatch)) -> handler.handler(req)
  | None -> Http.notFound()


/// Extract a path parameter from a request given a route pattern
/// Example: getPathParam req "/user/:id" "id" returns Some "123" for path "/user/123"
let getPathParam(req: Http.Request, routePattern: String, paramName: String): Option<String> =
  let path = getPath(req)
  let routeSegs = __parseRouteSegments(routePattern)
  let pathSegs = String.split(path, "/") |> List.filter(fun s -> Bool.not(String.isEmpty(s)))

  // Zip and find the matching variable
  let zipped = List.zipShortest(routeSegs, pathSegs)
  zipped
  |> List.findFirst(fun pair ->
    let (routeSeg, _) = pair
    match routeSeg with
    | Variable(name) -> name == paramName
    | _ -> false)
  |> (fun result ->
        match result with
        | Some((_, pathValue)) -> Option.Some(pathValue)
        | None -> Option.None)


/// A function wrapping a handler: it may change the request before handing it on, change the
/// response on its way back, or answer itself. The server's counterpart of
/// <type Stdlib.HttpClient.Middleware>.
type Middleware = (Http.Request -> Http.Response) -> (Http.Request -> Http.Response)


module Middleware =
  /// <param handler> wrapped in <param middlewares>. The first listed is the outermost: it sees
  /// the request first and the response last.
  let wrap(
    middlewares: List<Stdlib.HttpServer.Middleware>,
    handler: Http.Request -> Http.Response)
    : Http.Request -> Http.Response =
    List.fold(List.reverse(middlewares), handler, fun(inner, m) -> m(inner))


  /// What the server runs per request: <param handler> through <param middlewares>, on
  /// <param request>. The handler reaches the server bare, so its approvals and its trace are
  /// its own, and is wrapped here.
  let handle(
    middlewares: List<Stdlib.HttpServer.Middleware>,
    handler: Http.Request -> Http.Response,
    request: Http.Request)
    : Http.Response =
    let wrapped = wrap(middlewares, handler)
    wrapped(request)


  /// A middleware that rewrites every request with <param f> before the handler sees it.
  let onRequest(f: Http.Request -> Http.Request): Stdlib.HttpServer.Middleware =
    (fun next -> (fun req -> next(f(req))))


  /// A middleware that rewrites every response with <param f>.
  let onResponse(f: Http.Response -> Http.Response): Stdlib.HttpServer.Middleware =
    (fun next -> (fun req -> f(next(req))))


  /// {{Server: darklang}} and HSTS ({{Strict-Transport-Security}}) on every response that does
  /// not set them itself. In <fn Config.defaults>.
  let standardHeaders(): Stdlib.HttpServer.Middleware =
    onResponse(fun response ->
      let has = fun name ->
        List.any(response.headers, fun h -> String.toLowercase(Tuple2.first(h)) == name)

      let server = if has("server") then [] else [ ("Server", "darklang") ]

      let hsts =
        if has("strict-transport-security") then
          []
        else
          [ ("Strict-Transport-Security", "max-age=31536000; includeSubDomains; preload") ]

      { response with headers = List.flatten([ response.headers, server, hsts ]) })


  /// A request that came through a proxy speaking https ({{X-Forwarded-Proto: https}}) has its
  /// url rewritten to {{https://}} on port 443, so the handler sees the url the client used.
  /// In <fn Config.defaults>; leave it out when nothing in front of the server sets that header,
  /// since any client could.
  let trustForwardedProto(): Stdlib.HttpServer.Middleware =
    onRequest(fun req ->
      let https =
        List.any(req.headers, fun h ->
          String.toLowercase(Tuple2.first(h)) == "x-forwarded-proto"
          && String.toLowercase(String.trim(Tuple2.second(h))) == "https")

      if https then
        match Url.parse(req.url) with
        | Ok(u) ->
          { req with
              url = Url.toString({ u with scheme = Option.Some("https"), port = Option.None }) }
        | Error(_) -> req
      else
        req)


  /// A line on stderr per request the handler answers: method, path, status and how long it
  /// took, as {{[HttpServer] GET /a 200 3ms}}. In <fn Config.defaults>. A response the server
  /// writes itself (a body over the limit, a handler that failed or timed out) is logged by the
  /// server either way.
  let logRequests(): Stdlib.HttpServer.Middleware =
    (fun next ->
       (fun req ->
          let started = DateTime.now()
          let response = next(req)
          let ms = DateTime.subtractMs(DateTime.now(), started)
          let target = Http.requestTarget(req.url)
          let path =
            match target.query with
            | Some(q) -> target.path + "?" + q
            | None -> target.path

          let path = if String.startsWith(path, "/") then path else "/" + path
          printErrorLine(
            $"[HttpServer] {req.method} {path} {display(response.statusCode)} {display(ms)}ms")

          response))


/// Configuration for `serve`. Build defaults with `Config.defaults port`, then override any field with
/// record-update, e.g. `{ HttpServer.Config.defaults(Net.Port.httpAlt) with middleware = [] }`.
module Config =
  type Config =
    { address: String
      port: Net.Port
      /// Maximum request body size in bytes (over-limit → 413).
      maxBodyBytes: Int64
      /// Wraps every handler, first listed outermost (<type Stdlib.HttpServer.Middleware>).
      middleware: List<Stdlib.HttpServer.Middleware> }


  /// Default max request body size: 30 MB.
  val defaultMaxBodyBytes = 31457280


  /// What <fn defaults> wraps a handler in: a log line per request, the url as the client
  /// used it behind an https proxy, and the standard headers on the way out.
  let defaultMiddleware(): List<Stdlib.HttpServer.Middleware> =
    [ Stdlib.HttpServer.Middleware.logRequests()
      Stdlib.HttpServer.Middleware.trustForwardedProto()
      Stdlib.HttpServer.Middleware.standardHeaders() ]


  /// Sensible serve defaults for `port`: 30 MB max body, and <fn defaultMiddleware>.
  let defaults(port: Net.Port): Config =
    Config
      { address = "127.0.0.1"
        port = port
        maxBodyBytes = defaultMaxBodyBytes
        middleware = defaultMiddleware() }


/// Start an HTTP server: bind `handler` per `config`, run `onListening` once the port is bound (announce
/// there, so a banner is never a lie), and serve until SIGTERM (blocks). Returns Error with a plain message
/// if the port can't be bound. Every request runs through `config.middleware`.
let serve(
  config: Config.Config,
  handler: Http.Request -> Http.Response,
  onListening: Unit -> Unit)
  : Result<Unit, String> =
  if config.maxBodyBytes < 0 then
    Result.Error("maxBodyBytes must not be negative")
  else
    Builtin.httpServerServe(
      config.address,
      Net.Port.toInt64(config.port),
      handler,
      config.maxBodyBytes,
      config.middleware,
      onListening)


/// Whether an open page reloads itself when what served it is saved.
type Reload =
  /// An open page reloads when the router it came from, or anything it calls, is saved
  /// (`GET /__live` is an event stream; HTML responses carry the script that listens). For a
  /// dev site, not production.
  | OnSave
  /// Pages are served as they are, with no script and no `/__live`.
  | Off


/// `serve` for a server that follows edits: the handler is not fixed at start. Per request the server
/// runs <param step> over a state it keeps between requests, and <param step> answers with the handler
/// to use this time. <param first> is the handler as resolved at start, for the bind-time approval
/// root. `LanguageTools.Live.Router` is the step a router-by-name wants. <param reload> says whether an open
/// page reloads itself on a save.
let serveLive(
  config: Config.Config,
  init: 's,
  step: 's -> ('s * Result<Http.Request -> Http.Response, String>),
  first: Http.Request -> Http.Response,
  reload: Reload,
  onListening: Unit -> Unit)
  : Result<Unit, String> =
  let dev =
    match reload with
    | OnSave -> true
    | Off -> false

  if config.maxBodyBytes < 0 then
    Result.Error("maxBodyBytes must not be negative")
  else
    Builtin.httpServerServeLive(
      config.address,
      Net.Port.toInt64(config.port),
      init,
      step,
      first,
      dev,
      config.maxBodyBytes,
      config.middleware,
      onListening)
