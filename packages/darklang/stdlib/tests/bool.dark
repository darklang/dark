/// Tests for `Stdlib.Bool`. A test is any function that takes Unit and returns
/// `Stdlib.Test.T`; `dark test Darklang.Stdlib.Bool` finds and runs these.
module Darklang.Stdlib.Bool.Tests

let not () : Stdlib.Test.T =
  Stdlib.Test.table Stdlib.Bool.not [ (true, false), (false, true) ]

// xor takes two arguments, so each row's inputs are a tuple
let xor () : Stdlib.Test.T =
  Stdlib.Test.table
    Stdlib.Bool.xor
    [ ((true, false), true)
      ((false, true), true)
      ((true, true), false)
      ((false, false), false) ]

let ``and`` () : Stdlib.Test.T =
  Stdlib.Test.table
    Stdlib.Bool.``and``
    [ ((true, true), true), ((true, false), false), ((false, false), false) ]

let toStringSpellsItOut () : Stdlib.Test.T =
  Stdlib.Bool.toString true |> Stdlib.Test.eq "true"

// swapping the arguments does not change the answer
let xorCommutes () : Stdlib.Test.T =
  Stdlib.Bool.xor true false |> Stdlib.Test.eq (Stdlib.Bool.xor false true)
