/// Bounds-checked decoding of kernel byte records. No OS effects occur here.
module Darklang.Stdlib.Cli.KernelData

let unsigned (bytes: List<UInt8>) (width: Int) : Result.Result<Int, Int> =
  if width == 0 then Ok 0
  else
    match bytes with
    | [] -> Error 5
    | byte :: rest ->
      match unsigned rest (width - 1) with
      | Error e -> Error e
      | Ok high -> Ok (Stdlib.Int.fromUInt8 byte + 256 * high)

let field (bytes: List<UInt8>) (offset: Int) (width: Int)
  : Result.Result<Int, Int> =
  unsigned (Stdlib.List.drop bytes offset) width

let signedField (bytes: List<UInt8>) (offset: Int) (width: Int)
  : Result.Result<Int, Int> =
  match field bytes offset width with
  | Error e -> Error e
  | Ok n ->
    let modulus = 256 ** width
    Ok (if n >= modulus / 2 then n - modulus else n)

type Metadata =
  { mode: Int; size: Int; mtimeSec: Int; uid: Int; device: Int; inode: Int }

let metadata (buffer: Blob) : Result.Result<Metadata, Int> =
  let bytes = Stdlib.Blob.toList buffer
  field bytes (KernelABI.statModeOffset ()) (KernelABI.statModeWidth ())
  |> Stdlib.Result.andThen (fun mode ->
    signedField bytes (KernelABI.statSizeOffset ()) 8
    |> Stdlib.Result.andThen (fun size ->
      signedField bytes (KernelABI.statMtimeOffset ()) (KernelABI.statTimeWidth ())
      |> Stdlib.Result.andThen (fun mtime ->
        field bytes (KernelABI.statUidOffset ()) 4
        |> Stdlib.Result.andThen (fun uid ->
          field bytes 0 (KernelABI.statDeviceWidth ())
          |> Stdlib.Result.andThen (fun device ->
            field bytes (KernelABI.statInodeOffset ()) 8
            |> Stdlib.Result.map (fun inode ->
              Metadata { mode = mode; size = size; mtimeSec = mtime; uid = uid
                         device = device; inode = inode }))))))

/// Decode records within one read, consuming each record before the next.
let entriesWithLength (bytes: List<UInt8>) (remaining: Int)
  (reversed: List<String>)
  : Result.Result<List<String>, Int> =
  match bytes with
  | [] -> Ok reversed
  | _ ->
    field bytes 16 2
    |> Stdlib.Result.andThen (fun length ->
      let nameOffset = KernelABI.directoryNameOffset ()
      if length <= nameOffset || length > remaining then Error 5
      else
        let record = Stdlib.List.take bytes length
        let nameBytes = Stdlib.List.drop record nameOffset
        let name = Stdlib.List.takeWhile nameBytes (fun byte -> byte != 0uy)
        if Stdlib.List.length name == Stdlib.List.length nameBytes then Error 5
        else
          let name = Stdlib.String.fromBytesWithReplacement name
          let next =
            if name == "." || name == ".." then reversed
            else Stdlib.List.push reversed name
          entriesWithLength (Stdlib.List.drop bytes length) (remaining - length) next)

let entries (bytes: List<UInt8>) (reversed: List<String>)
  : Result.Result<List<String>, Int> =
  entriesWithLength bytes (Stdlib.List.length bytes) reversed
