/// User-facing file operations over shared Dark algorithms and kernel primitives.
module Darklang.Stdlib.Cli.FileSystem

/// Structured error from file I/O.
type FileError =
  /// File or directory at the given path doesn't exist.
  | NotFound
  /// The OS refused access to the path (EACCES). A policy denial never
  /// appears here: it raises before the operation runs.
  | OsAccessDenied
  /// Any other I/O failure — carries the original message.
  | Other(String)


module FileError =
  /// Render a FileError for display or for callers that haven't migrated to
  /// pattern-matching on the enum yet.
  let toString(err: FileError): String =
    match err with
    | NotFound -> "File not found"
    | OsAccessDenied -> "Permission denied"
    | Other(msg) -> msg


impl Display for FileError =
  let display = Stdlib.Cli.FileSystem.FileError.toString


/// The process's current working directory, or "." if the kernel cannot give its path,
/// as when it has been removed.
let currentDirectory(): String =
  match Posix.getCwd() with
  | Ok(cwd) -> cwd
  | Error(_) -> "."


/// Expand HOME only when requested; environment access remains policy checked.
let __expandPath(path: String): String =
  if String.contains(path, "$HOME") || String.contains(path, "${HOME}") then
    let home = Option.withDefault(Stdlib.Env.get("HOME"), "")
    path
    |> (fun p -> String.replaceAll(p, "${HOME}", home))
    |> (fun p -> String.replaceAll(p, "$HOME", home))
  else
    path


let __fromPosixError(error: Posix.Error): FileError =
  if error.errno == 2 || error.errno == 20 then
    FileError.NotFound
  else if error.errno == 13 || error.errno == 1 || error.errno == 21 then
    FileError.OsAccessDenied
  else
    FileError.Other(error.message)


/// Full paths of the entries in the directory at <param path>.
let listDirectory(path: String): Result<List<String>, FileError> =
  let expanded = __expandPath(path)
  let full =
    if Path.isAbsolute(expanded) then
      Path.normalize(expanded)
    else
      Path.join([ currentDirectory(), expanded ]) |> Path.normalize

  Posix.listDir(full)
  |> Result.map(fun names -> List.map(names, fun name -> Path.join([ full, name ])))
  |> Result.mapError(__fromPosixError)


/// Is there a file or directory at <param path>?
let pathExists(path: String): Bool =
  File.exists(__expandPath(path))


/// Is <param path> a directory?
let isDirectory(path: String): Bool =
  Posix.isDirectory(__expandPath(path))


/// Delete the file at <param path>.
let deleteFile(path: String): Result<Unit, FileError> =
  File.delete(__expandPath(path)) |> Result.mapError(__fromPosixError)


/// Append <param content> to the file at <param path>, creating the file if
/// it isn't there.
let appendToFile(path: String, content: String): Result<Unit, FileError> =
  File.appendText(__expandPath(path), content) |> Result.mapError(__fromPosixError)


// Get files in a directory - returns just filenames
let getDirectoryContents(path: String): List<String> =
  let currentDir = currentDirectory()
  let fullPath =
    if String.startsWith(path, "/") then
      path
    else
      // Normalize path by removing leading "./" if present
      let normalizedPath = if String.startsWith(path, "./") then String.dropFirst(path, 2) else path
      $"{currentDir}/{normalizedPath}"

  let files = listDirectory(fullPath) |> Result.withDefault([])
  files
  |> List.map(fun fullFilePath ->
    // Extract just the filename from the full path
    match String.split(fullFilePath, "/") with
    | [] -> fullFilePath
    | parts ->
      match List.last(parts) with
      | Some(filename) -> filename
      | None -> fullFilePath)


// Check if a path is a directory - expects full path
let isDirectoryAtPath(dirPath: String, fileName: String): Bool =
  let currentDir = currentDirectory()
  let normalizedDirPath =
    if String.startsWith(dirPath, "/") then
      dirPath
    else if String.startsWith(dirPath, "./") then
      let withoutDot = String.dropFirst(dirPath, 2)
      $"{currentDir}/{withoutDot}"
    else
      $"{currentDir}/{dirPath}"

  let fullPath = $"{normalizedDirPath}/{fileName}"
  Posix.isDirectory(fullPath)


/// Read an entire file as a Bytes.
let readFile(path: String): Result<Bytes, FileError> =
  File.readBytes(__expandPath(path)) |> Result.mapError(__fromPosixError)


/// Write <param content> to <param path>, replacing whatever's there. The
/// parent directory has to exist already; <fn writeFile> is this plus the
/// mkdir.
let overwriteFile(path: String, content: Bytes): Result<Unit, FileError> =
  File.__writeBytes(__expandPath(path), content) |> Result.mapError(__fromPosixError)


/// Read an entire file and decode it as UTF-8. Convenience over
/// <fn readFile> + <fn Stdlib.Utf8.decode> for text files. Returns
/// {{FileError.Other}} if the bytes aren't valid UTF-8.
let readFileAsString(path: String): Result<String, FileError> =
  match readFile(path) with
  | Ok(blob) ->
    match Utf8.decode(blob) with
    | Ok(s) -> Result.Ok(s)
    | Error(_) -> Result.Error(FileError.Other("File contents are not valid UTF-8"))
  | Error(e) -> Result.Error(e)


/// Write content to a file, creating any missing parent directories.
let writeFile(path: String, content: Bytes): Result<Unit, FileError> =
  let expanded = __expandPath(path)
  let parentDir = Path.parent(expanded)
  let mkdirResult =
    if parentDir != "" && parentDir != "/" then
      Dir.createRecursive(parentDir) |> Result.mapError(__fromPosixError)
    else
      Result.Ok()

  match mkdirResult with
  | Error(e) -> Result.Error(e)
  | Ok(_) -> overwriteFile(expanded, content)
