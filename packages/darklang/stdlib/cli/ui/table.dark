module Darklang.Stdlib.Cli.UI.Table

/// Print a formatted table with headers and rows.
/// columns: list of column header strings
/// rows: list of rows, each row is a list of cell strings
let print(columns: List<String>, rows: List<List<String>>): Unit =
  let colWidths =
    columns
    |> List.indexedMap(fun(i, header) ->
      let headerLen = String.displayWidth(header)
      let maxCellLen =
        rows
        |> List.fold(0, fun(mx, row) ->
          match List.getAt(row, i) with
          | Some(cell) -> max(mx, String.displayWidth(cell))
          | None -> mx)

      max(headerLen, maxCellLen))

  let headerLine =
    columns
    |> List.indexedMap(fun(i, header) ->
      match List.getAt(colWidths, i) with
      | Some(w) -> Text.padEndToWidth(header, w)
      | None -> header)
    |> String.join("  ")
    // Padding on the final column is trailing whitespace with nothing after it to line up against. It
    // shows up as a corridor of highlighted blanks once the header is bolded.
    |> String.trimEnd

  printLine(Colors.boldText(headerLine))
  let sepLine =
    colWidths
    |> List.map(fun w -> String.checkedRepeat("-", w) |> Result.withDefault(""))
    |> String.join("  ")

  printLine(sepLine)
  let _ =
    rows
    |> List.map(fun row ->
      let line =
        columns
        |> List.indexedMap(fun(i, _) ->
          let cell =
            match List.getAt(row, i) with
            | Some(c) -> c
            | None -> ""

          match List.getAt(colWidths, i) with
          | Some(w) -> Text.padEndToWidth(cell, w)
          | None -> cell)
        |> String.join("  ")
        |> String.trimEnd

      printLine(line))

  ()
