/// A minimal multiline text buffer: lines + a (row, col) cursor, with pure edit/motion ops. Rendering and
/// key handling live in the caller; this module is pure so it's eval-testable. Foundation for the Edit view.
module Darklang.Stdlib.Cli.UI.Editor

type Buf =
  { lines: List<String>
    row: Int64
    col: Int64 }


let emptyBuf(): Buf =
  Buf { lines = [ "" ], row = 0, col = 0 }


let fromText(text: String): Buf =
  let ls = String.split(text, "\n")
  let lines = if List.isEmpty(ls) then [ "" ] else ls
  Buf { lines = lines, row = 0, col = 0 }


let toText(buf: Buf): String =
  String.join(buf.lines, "\n")


let currentLine(buf: Buf): String =
  List.getAt(buf.lines, buf.row) |> Option.withDefault("")


let setLine(lines: List<String>, row: Int64, s: String): List<String> =
  lines |> List.indexedMap(fun(i, l) -> if i == row then s else l)


let insertChar(buf: Buf, ch: String): Buf =
  let line = currentLine(buf)
  let before = String.slice(line, 0, buf.col)
  let after = String.slice(line, buf.col, String.length(line))
  Buf
    { lines = setLine(buf.lines, buf.row, before + ch + after)
      row = buf.row
      col = buf.col + String.length(ch) }


let newline(buf: Buf): Buf =
  let line = currentLine(buf)
  let before = String.slice(line, 0, buf.col)
  let after = String.slice(line, buf.col, String.length(line))
  let newLines =
    buf.lines
    |> List.indexedMap(fun(i, l) -> if i == buf.row then [ before, after ] else [ l ])
    |> List.flatten

  Buf { lines = newLines, row = buf.row + 1, col = 0 }


/// Insert a string that may contain newlines: split on "\n" and stitch with `newline` between segments.
/// A string with no "\n" splits to one part -> identical to `insertChar`. This is what a paste routes through.
let insertText(buf: Buf, text: String): Buf =
  String.split(text, "\n")
  |> List.indexedMap(fun(i, s) -> (i, s))
  |> List.fold(buf, fun(b, pair) ->
    let (i, s) = pair
    if i == 0 then insertChar(b, s) else insertChar(newline(b), s))


let backspace(buf: Buf): Buf =
  if buf.col > 0 then
    let line = currentLine(buf)
    let before = String.slice(line, 0, buf.col - 1)
    let after = String.slice(line, buf.col, String.length(line))
    Buf { lines = setLine(buf.lines, buf.row, before + after), row = buf.row, col = buf.col - 1 }
  else if buf.row > 0 then
    let prev = List.getAt(buf.lines, buf.row - 1) |> Option.withDefault("")
    let cur = currentLine(buf)
    let newCol = String.length(prev)
    let newLines =
      buf.lines
      |> List.indexedMap(fun(i, l) -> if i == buf.row - 1 then prev + cur else l)
      |> List.indexedMap(fun(i, l) -> (i, l))
      |> List.filter(fun p ->
        let (i, _l) = p
        i != buf.row)
      |> List.map(fun p ->
        let (_i, l) = p
        l)

    Buf { lines = newLines, row = buf.row - 1, col = newCol }
  else
    buf


/// Delete the character to the RIGHT of the cursor; at the end of a line, pull the next line up. The mirror
/// of `backspace`, and the reason it exists: without it, fixing a line means arrowing to its end and
/// backspacing over everything you wanted to keep.
let deleteForward(buf: Buf): Buf =
  let line = currentLine(buf)
  let len = String.length(line)
  if buf.col < len then
    let before = String.slice(line, 0, buf.col)
    let after = String.slice(line, buf.col + 1, len)
    Buf { lines = setLine(buf.lines, buf.row, before + after), row = buf.row, col = buf.col }
  else if buf.row < List.length(buf.lines) - 1 then
    let next = List.getAt(buf.lines, buf.row + 1) |> Option.withDefault("")
    let newLines =
      buf.lines
      |> List.indexedMap(fun(i, l) -> (i, l))
      |> List.filter(fun p ->
        let (i, _l) = p
        i != buf.row + 1)
      |> List.map(fun p ->
        let (i, l) = p
        if i == buf.row then line + next else l)

    Buf { lines = newLines, row = buf.row, col = buf.col }
  else
    buf


/// Jump to the start / end of the current line.
let moveLineStart(buf: Buf): Buf =
  { buf with col = 0 }


let moveLineEnd(buf: Buf): Buf =
  { buf with col = String.length(currentLine(buf)) }


/// Drop everything from the cursor to the end of the line (readline's ^k), so replacing a line is two keys
/// rather than one per character.
let killToLineEnd(buf: Buf): Buf =
  let line = currentLine(buf)
  let kept = String.slice(line, 0, buf.col)
  Buf { lines = setLine(buf.lines, buf.row, kept), row = buf.row, col = buf.col }


let clampCol(buf: Buf): Buf =
  let len = String.length(currentLine(buf))
  { buf with col = min(buf.col, len) }


let moveLeft(buf: Buf): Buf =
  if buf.col > 0 then
    { buf with col = buf.col - 1 }
  else if buf.row > 0 then
    let prevLen =
      List.getAt(buf.lines, buf.row - 1)
      |> Option.map(fun s -> String.length(s))
      |> Option.withDefault(0)

    { buf with row = buf.row - 1, col = prevLen }
  else
    buf


let moveRight(buf: Buf): Buf =
  let len = String.length(currentLine(buf))
  if buf.col < len then
    { buf with col = buf.col + 1 }
  else if buf.row < List.length(buf.lines) - 1 then
    { buf with row = buf.row + 1, col = 0 }
  else
    buf


let moveUp(buf: Buf): Buf =
  if buf.row > 0 then clampCol({ buf with row = buf.row - 1 }) else buf


let moveDown(buf: Buf): Buf =
  if buf.row < List.length(buf.lines) - 1 then
    clampCol({ buf with row = buf.row + 1 })
  else
    buf
