module Darklang.Stdlib.Cli.UI.Layout

// --- Types ---

/// What a component wants.
type SizeRequest =
  { minRows: Int64
    minCols: Int64
    preferredRows: Int64
    preferredCols: Int64 }


/// What a component gets.
type Region =
  { top: Int64
    left: Int64
    rows: Int64
    cols: Int64 }


/// Text to place at a zero-based terminal position. `Canvas` paints these onto a grid of rows.
type Span =
  { row: Int64
    col: Int64
    text: String }


/// A renderable component that can negotiate its size.
///
/// `render` returns spans rather than printing. That's what lets a frame be compared against the previous
/// one and drawn as a handful of row rewrites instead of a clear plus a few hundred writes.
type Component =
  { sizeRequest: Unit -> SizeRequest
    render: Region -> List<Span> }


// --- Rendering primitives ---

/// Place text at `(row, col)` within a region, clipped to what the region can hold.
///
/// Clipping goes through `Tui.Text`, which counts terminal columns and leaves SGR sequences alone, so a
/// coloured or wide-glyph row is measured correctly: `界` and a ZWJ emoji each occupy 2 columns.
let at(region: Region, row: Int64, col: Int64, text: String): List<Span> =
  if row >= 0 && row < region.rows && col >= 0 && col < region.cols then
    [ Span
        { row = region.top + row - 1
          col = region.left + col - 1
          // Clipping is native but not free; most spans already fit, and measuring is one call.
          text =
            let room = max(0, region.cols - col)
            if Tui.Text.styledWidth(text) <= room then
              text
            else
              Tui.Text.clipToWidth(text, room) } ]
  else
    []


/// Fill a row with a repeated character, within the region.
let fillRow(region: Region, row: Int64, ch: String): List<Span> =
  at(region, row, 0, String.checkedRepeat(ch, region.cols) |> Result.withDefault(""))


/// Blank the whole region.
///
/// Still emits spaces rather than nothing: a composed frame starts blank, but a region drawn *over* other
/// content (an overlay) has to actually erase what's under it.
let clearRegion(region: Region): List<Span> =
  (List.checkedRange(0, region.rows - 1) |> Result.withDefault([]))
  |> List.map(fun row -> fillRow(region, row, " "))
  |> List.flatten


// --- Layout negotiation ---

/// Distribute `totalRows` among components based on their size requests.
/// Each gets at least min, then remaining space is split toward preferred.
let distributeRows(totalRows: Int64, requests: List<SizeRequest>): List<Int64> =
  let count = List.length(requests)
  if count == 0 then
    []
  else
    // First pass: give everyone their minimum
    let mins = List.map(requests, fun r -> r.minRows)
    let totalMin = List.fold(mins, 0, fun(acc, n) -> acc + n)
    let remaining = max(0, totalRows - totalMin)
    // Second pass: distribute remaining toward preferred, proportionally
    let wants = List.map(requests, fun r -> max(0, r.preferredRows - r.minRows))
    let totalWant = List.fold(wants, 0, fun(acc, n) -> acc + n)
    if totalWant == 0 then
      mins
    else
      // Give each component its min + share of remaining proportional to want
      List.map2(mins, wants, fun(minR, want) ->
        let share = Int64.checkedDivide(want * remaining, totalWant) |> Result.withDefault(0)
        minR + share)
      |> Result.withDefault(mins)


// --- Layout combinators ---

/// Stack components vertically within a region.
/// Negotiates row distribution based on size requests.
let vstack(region: Region, components: List<Component>): List<Span> =
  let requests = List.map(components, fun c -> c.sizeRequest())
  let rowAllocs = distributeRows(region.rows, requests)
  let pairs = List.map2(components, rowAllocs, fun(c, rows) -> (c, rows)) |> Result.withDefault([])
  // Collected as a list of lists and flattened once, rather than appended into an accumulator per
  // child. `List.concat` copies its left side, so appending each child's spans in turn copies every
  // span already placed, and stacks nest.
  let (_finalTop, chunks) =
    pairs
    |> List.fold((region.top, []), fun(acc, pair) ->
      let (currentTop, collected) = acc
      let (c, rows) = pair
      let childRegion =
        Region { top = currentTop, left = region.left, rows = rows, cols = region.cols }

      (currentTop + rows, List.prepend(collected, c.render(childRegion))))

  chunks
  |> List.reverse
  |> List.flatten


/// A fixed-height component: always requests exactly N rows.
let fixedSize(n: Int64, renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () -> SizeRequest { minRows = n, minCols = 0, preferredRows = n, preferredCols = 0 })
      render = renderFn }


/// A flexible component: needs at least `min` rows, prefers `preferred`.
let flex(min: Int64, preferred: Int64, renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () ->
           SizeRequest { minRows = min, minCols = 0, preferredRows = preferred, preferredCols = 0 })
      render = renderFn }


/// A greedy component: wants all available space, min 1 row.
let greedy(renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () -> SizeRequest { minRows = 1, minCols = 0, preferredRows = 999, preferredCols = 0 })
      render = renderFn }


// --- Horizontal layout (mirror of the vertical combinators above) ---

/// Distribute `totalCols` among components based on their size requests.
/// Each gets at least min, then remaining space is split toward preferred.
let distributeCols(totalCols: Int64, requests: List<SizeRequest>): List<Int64> =
  let count = List.length(requests)
  if count == 0 then
    []
  else
    let mins = List.map(requests, fun r -> r.minCols)
    let totalMin = List.fold(mins, 0, fun(acc, n) -> acc + n)
    let remaining = max(0, totalCols - totalMin)
    let wants = List.map(requests, fun r -> max(0, r.preferredCols - r.minCols))
    let totalWant = List.fold(wants, 0, fun(acc, n) -> acc + n)
    if totalWant == 0 then
      mins
    else
      List.map2(mins, wants, fun(minC, want) ->
        let share = Int64.checkedDivide(want * remaining, totalWant) |> Result.withDefault(0)
        minC + share)
      |> Result.withDefault(mins)


/// Place components side by side within a region.
/// Negotiates column distribution based on size requests.
let hstack(region: Region, components: List<Component>): List<Span> =
  let requests = List.map(components, fun c -> c.sizeRequest())
  let colAllocs = distributeCols(region.cols, requests)
  let pairs = List.map2(components, colAllocs, fun(c, cols) -> (c, cols)) |> Result.withDefault([])
  // Same as `vstack`: collect and flatten once rather than copying the accumulator per child.
  let (_finalLeft, chunks) =
    pairs
    |> List.fold((region.left, []), fun(acc, pair) ->
      let (currentLeft, collected) = acc
      let (c, cols) = pair
      let childRegion =
        Region { top = region.top, left = currentLeft, rows = region.rows, cols = cols }

      (currentLeft + cols, List.prepend(collected, c.render(childRegion))))

  chunks
  |> List.reverse
  |> List.flatten


/// A fixed-width component: always requests exactly N cols; fills the region's height.
let fixedWidth(n: Int64, renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () -> SizeRequest { minRows = 1, minCols = n, preferredRows = 999, preferredCols = n })
      render = renderFn }


/// A flexible-width component: needs at least `min` cols, prefers `preferred`.
let flexWidth(min: Int64, preferred: Int64, renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () ->
           SizeRequest
             { minRows = 1, minCols = min, preferredRows = 999, preferredCols = preferred })
      render = renderFn }


/// A greedy-width component: wants all available width, min 1 col.
let greedyWidth(renderFn: Region -> List<Span>): Component =
  Component
    { sizeRequest =
        (fun () ->
           SizeRequest { minRows = 1, minCols = 1, preferredRows = 999, preferredCols = 999 })
      render = renderFn }
