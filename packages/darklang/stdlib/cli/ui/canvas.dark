/// A span buffer: the bridge from "paint at a position" to "here are the rows".
///
/// Everything in the CLI builds a `Tui.View` (a list of rows) and lets the renderer diff it against the
/// previous frame, so an arrow key rewrites the rows that changed instead of clearing and repainting. But a
/// renderer is far easier to write as "put this text at that position" than as "produce these rows".
///
/// Rewriting every renderer to return rows directly would mean redoing all the layout math with it. This
/// module avoids that: a renderer keeps computing `(row, col, text)` exactly as it does now, but *returns*
/// the spans instead of printing them. `compose` paints them onto a blank grid and hands back rows.
///
/// The migration is then mechanical, one renderer at a time:
///   `Layout.printAt region r c text`      ->  `Layout.at region r c text`
///   `a` then `b` (sequenced prints)        ->  `Stdlib.List.flatten [ a; b ]`
///   `xs |> Stdlib.List.iter (...)`         ->  `xs |> Stdlib.List.map (...) |> Stdlib.List.flatten`
///   `Region -> Unit`                       ->  `Region -> List<Span>`
///
/// Widths are measured with `Tui.Text`, so a span carrying CJK, emoji, or SGR colour lands where it should.
/// `Layout.printAt` measured with `String.length`, which counts grapheme clusters rather than terminal
/// columns - right for "how many characters is this", wrong for "how far does this reach across the screen",
/// since `界` is one grapheme in two columns. That's why a wide glyph used to shove its row out of alignment.
module Darklang.Stdlib.Cli.UI.Canvas


/// A placed run of text, with its width measured once.
type Segment =
  { col: Int
    text: String
    width: Int }


/// Lay `next` over `existing`, trimming whatever it covers.
///
/// Spans within a row are painted in the order they were produced, so a later one wins: an overlay draws a
/// blank band and then its content on top. Where a later span lands inside an earlier one, the earlier one's
/// right-hand remainder is dropped rather than split. That's indistinguishable in practice, because the only
/// thing that ever gets covered this way is blank padding, and gaps render as spaces anyway.
let overlay (existing: List<Segment>) (next: Segment) : List<Segment> =
  let nextEnd = next.col + next.width

  let kept =
    existing
    |> Stdlib.List.map (fun seg ->
      let segEnd = seg.col + seg.width
      if segEnd <= next.col || seg.col >= nextEnd then
        [ seg ]
      else if seg.col < next.col then
        let keepWidth = next.col - seg.col
        [ Segment
            { col = seg.col
              text = Tui.Text.clipToWidth seg.text keepWidth
              width = keepWidth } ]
      else
        [])
    |> Stdlib.List.flatten

  Stdlib.List.append kept [ next ]


/// Render placed segments into one row, padding the gaps between them with spaces.
let renderSegments (width: Int) (segments: List<Segment>) : String =
  let (text, _endCol) =
    segments
    |> Stdlib.List.sortBy (fun seg -> seg.col)
    |> Stdlib.List.fold ("", 0) (fun acc seg ->
      let (out, col) = acc
      if seg.col >= width then
        acc
      else
        let start = Stdlib.Int.max col seg.col
        let gap = Stdlib.String.repeat " " (Stdlib.Int.max 0 (start - col))
        let room = width - start
        // The common case is a segment that already fits, so don't pay for a clip to find that out.
        let (clipped, used) =
          if seg.col >= col && seg.width <= room then
            (seg.text, seg.width)
          else
            let c = Tui.Text.clipToWidth seg.text room
            (c, Tui.Text.styledWidth c)
        (out ++ gap ++ clipped, start + used))

  // A reset at the end so a colour left open by the last segment can't bleed into whatever follows.
  text ++ "\u001b[0m"


/// Paint one row's spans, in order.
let composeRow (width: Int) (rowSpans: List<Layout.Span>) : String =
  let placed =
    rowSpans
    |> Stdlib.List.fold [] (fun acc span ->
      overlay
        acc
        (Segment
          { col = span.col
            text = span.text
            width = Tui.Text.styledWidth span.text }))
  renderSegments width placed


/// Paint spans onto a `height` x `width` grid and return the rows.
///
/// Spans are bucketed by row in one pass. Doing it the obvious way (filter the whole span list once per row)
/// is quadratic, and a full-screen frame has enough of both to make that hurt.
let compose (width: Int) (height: Int) (spans: List<Layout.Span>) : List<String> =
  let w = Stdlib.Int.max 1 width
  let h = Stdlib.Int.max 0 height

  if h == 0 then
    []
  else
    let byRow =
      spans
      |> Stdlib.List.fold Stdlib.Dict.empty (fun acc span ->
        if span.row < 0 || span.row >= h then
          acc
        else
          let key = Stdlib.Int.toString span.row
          let existing = Stdlib.Dict.get acc key |> Stdlib.Option.withDefault []
          Stdlib.Dict.setOverridingDuplicates acc key (Stdlib.List.append existing [ span ]))

    Stdlib.List.range 0 (h - 1)
    |> Stdlib.List.map (fun row ->
      match Stdlib.Dict.get byRow (Stdlib.Int.toString row) with
      // An untouched row is empty rather than `width` spaces: the renderer erases each row it writes, so
      // blanks cost nothing, and an empty string compares equal frame to frame.
      | None -> ""
      | Some rowSpans -> composeRow w rowSpans)


/// Compose spans into a full-screen `Tui.View`.
let toView (size: Tui.Size) (spans: List<Layout.Span>) : Tui.View =
  Tui.View
    { rows = compose size.width size.height spans
      cursor = Tui.Cursor.Hidden
      mode = Tui.ViewMode.Fullscreen }
