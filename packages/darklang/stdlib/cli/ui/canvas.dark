/// A span buffer: the bridge from "paint at a position" to "here are the rows".
///
/// Everything in the CLI builds a `Stdlib.Cli.Tui.View` (a list of rows) and lets the renderer diff it against the
/// previous frame, so an arrow key rewrites the rows that changed instead of clearing and repainting. But a
/// renderer is far easier to write as "put this text at that position" than as "produce these rows".
///
/// Rewriting every renderer to return rows directly would mean redoing all the layout math with it. This
/// module avoids that: a renderer keeps computing `(row, col, text)` exactly as it does now, but *returns*
/// the spans instead of printing them. `compose` paints them onto a blank grid and hands back rows.
///
/// The migration is then mechanical, one renderer at a time:
///   `Layout.printAt region r c text`      ->  `Layout.at region r c text`
///   `a` then `b` (sequenced prints)        ->  `Stdlib.List.flatten [ a; b ]`
///   `xs |> Stdlib.List.iter (...)`         ->  `xs |> Stdlib.List.map (...) |> Stdlib.List.flatten`
///   `Region -> Unit`                       ->  `Region -> List<Span>`
///
/// Widths are measured with `Stdlib.Cli.Tui.Text`, so a span carrying CJK, emoji, or SGR colour lands where it should.
/// `Layout.printAt` measured with `String.length`, which counts grapheme clusters rather than terminal
/// columns - right for "how many characters is this", wrong for "how far does this reach across the screen",
/// since `界` is one grapheme in two columns. That's why a wide glyph used to shove its row out of alignment.
module Darklang.Stdlib.Cli.UI.Canvas


/// A placed run of text, with its width measured once.
type Segment =
  { col: Int
    text: String
    width: Int }


/// Lay `next` over `existing`, trimming whatever it covers.
///
/// Spans within a row are painted in the order they were produced, so a later one wins: an overlay draws a
/// blank band and then its content on top. Where a later span lands inside an earlier one, the earlier one's
/// right-hand remainder is dropped rather than split. That's indistinguishable in practice, because the only
/// thing that ever gets covered this way is blank padding, and gaps render as spaces anyway.
let overlay (existing: List<Segment>) (next: Segment) : List<Segment> =
  let nextEnd = next.col + next.width

  // The common case by far is a span that lands clear of everything already placed: a row is
  // usually disjoint runs left to right, and only an overlay band covers anything. Answering that
  // costs one walk; trimming costs three and allocates a list per segment on the way.
  let overlaps =
    existing
    |> Stdlib.List.any (fun seg ->
      ((seg.col + seg.width) > next.col) && (seg.col < nextEnd))

  if Stdlib.Bool.not overlaps then
    Stdlib.List.append existing [ next ]
  else

  // `filterMap` rather than `map` into one-element lists and `flatten`: the branches here answer
  // "keep, trim, or drop", which is what an `Option` says, and building a list per segment only to
  // concatenate them all was the long way round. `filterMap` is native now, which it was not when
  // this was written.
  let kept =
    existing
    |> Stdlib.List.filterMap (fun seg ->
      let segEnd = seg.col + seg.width
      if segEnd <= next.col || seg.col >= nextEnd then
        Stdlib.Option.Option.Some seg
      else if seg.col < next.col then
        let keepWidth = next.col - seg.col
        Stdlib.Option.Option.Some(
          Segment
            { col = seg.col
              text = Tui.Text.clipToWidth seg.text keepWidth
              width = keepWidth }
        )
      else
        Stdlib.Option.Option.None)

  Stdlib.List.append kept [ next ]


/// Render placed segments into one row, padding the gaps between them with spaces.
let renderSegments (width: Int) (segments: List<Segment>) : String =
  let (text, _endCol) =
    segments
    |> Stdlib.List.fold ("", 0) (fun acc seg ->
      let (out, col) = acc
      if seg.col >= width then
        acc
      else
        // Inlined rather than `Int.max`, for the reason given in `composeRow` below: it is a call,
        // and this runs once per segment. Same for the gap -- segments usually butt up against the
        // one before, so the ordinary case is a `repeat` that returns "" and an append that adds
        // nothing. Both are skipped when there is no gap to fill.
        let start = if seg.col > col then seg.col else col
        let room = width - start
        // The common case is a segment that already fits, so don't pay for a clip to find that out.
        let (clipped, used) =
          if seg.col >= col && seg.width <= room then
            (seg.text, seg.width)
          else
            let c = Tui.Text.clipToWidth seg.text room
            (c, Tui.Text.styledWidth c)

        let next =
          if start > col then
            out ++ (Stdlib.String.repeat " " (start - col)) ++ clipped
          else
            out ++ clipped

        (next, start + used))

  // A reset at the end so a colour left open by the last segment can't bleed into whatever follows.
  text ++ "\u001b[0m"


/// Paint one row's spans, in order.
let composeRow (width: Int) (rowSpans: List<Layout.Span>) : String =
  // `renderSegments` walks the segments left to right, so they have to be in column order. Sorting
  // them there cost a `sortBy` per row, to reorder rows a renderer had already produced left to
  // right.
  //
  // So notice instead. `overlay` appends, and trimming an earlier segment leaves it where it was, so
  // the result is in column order exactly when the spans arrived that way. Tracking that is one
  // comparison against the highest column seen, and the sort only runs for a row that needs it.
  // `rightmost` is the far edge of everything placed. A span starting at or after it cannot overlap
  // anything, which is the ordinary case for a row a renderer produced left to right -- and that is
  // one comparison where `overlay` would run `List.any` over every segment already placed. The two
  // agree by construction: `overlay`'s no-overlap branch is this append.
  let (placed, ordered, _lastCol, _rightmost) =
    rowSpans
    |> Stdlib.List.fold ([], true, -1, 0) (fun acc span ->
      let (segs, orderedSoFar, lastCol, rightmost) = acc
      let w = Tui.Text.styledWidth span.text

      let seg = Segment { col = span.col; text = span.text; width = w }

      let nextPlaced =
        if span.col >= rightmost then
          Stdlib.List.append segs [ seg ]
        else
          overlay segs seg

      let nextRightmost =
        let e = span.col + w
        if e > rightmost then e else rightmost

      // While the row is still in order, the last column seen is the highest one, so this needs no
      // `max` -- and `Int.max` is a package call, which at one per span is not free.
      (nextPlaced, orderedSoFar && (span.col >= lastCol), span.col, nextRightmost))

  let sorted =
    if ordered then placed else placed |> Stdlib.List.sortBy (fun seg -> seg.col)

  renderSegments width sorted


/// Paint spans onto a `height` x `width` grid and return the rows.
///
/// Spans are bucketed by row in one pass. Doing it the obvious way (filter the whole span list once per row)
/// is quadratic, and a full-screen frame has enough of both to make that hurt.
let compose (width: Int) (height: Int) (spans: List<Layout.Span>) : List<String> =
  let w = Stdlib.Int.max 1 width
  let h = Stdlib.Int.max 0 height

  if h == 0 then
    []
  else
    let byRow =
      spans
      |> Stdlib.List.fold Stdlib.Dict.empty (fun acc span ->
        if span.row < 0 || span.row >= h then
          acc
        else
          let key = Stdlib.Int.toString span.row

          // Matched here rather than `|> Option.withDefault []`. `withDefault` is a real package
          // call, and this runs once per span. Worth the two extra lines only because of where it
          // sits; everywhere else `withDefault` reads better and costs nothing that matters.
          let existing =
            match Stdlib.Dict.get acc key with
            | Some existing -> existing
            | None -> []

          Stdlib.Dict.setOverridingDuplicates acc key (Stdlib.List.append existing [ span ]))

    Stdlib.List.range 0 (h - 1)
    |> Stdlib.List.map (fun row ->
      match Stdlib.Dict.get byRow (Stdlib.Int.toString row) with
      // An untouched row is empty rather than `width` spaces: the renderer erases each row it writes, so
      // blanks cost nothing, and an empty string compares equal frame to frame.
      | None -> ""
      | Some rowSpans -> composeRow w rowSpans)


/// Compose spans into a full-screen `Stdlib.Cli.Tui.View`.
let toView (size: Stdlib.Cli.Tui.Size) (spans: List<Layout.Span>) : Stdlib.Cli.Tui.View =
  Stdlib.Cli.Tui.View
    { rows = compose size.width size.height spans
      cursor = Stdlib.Cli.Tui.Cursor.Hidden
      mode = Stdlib.Cli.Tui.ViewMode.Fullscreen }
