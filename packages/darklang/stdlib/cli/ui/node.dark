/// One tree for every host. A view is `Model -> Node`, and the host decides what a node is on its
/// own surface: `Node.toSpans` paints it into a terminal region (over `Layout`, `Table`, `Text`),
/// `Html.render` writes it as markup. The view never knows which.
///
/// A node is data, not drawing. That is what makes a frame diffable, a view testable by asserting on
/// the tree, and a render replayable later. The one exception is `Input`, which carries the message
/// constructor its edits turn into, since a message has to carry the new text and a value cannot.
/// A tree is built by `render` and consumed by the host in the same frame; nothing retains one.
///
/// Sizing is the host's. A node has a NATURAL size (`measure`) and takes what the region gives it:
/// a `Column` stacks children by their natural rows and clips at the bottom; a `Row` lays children
/// side by side by natural width and hands the leftover to the last that wants it; `Region` fixes a
/// box. There is no constraint solver here, and there should not be until something needs one.
///
/// The structured editor's node vocabulary is designed so this could share it; it does not, yet.
module Darklang.Stdlib.Cli.UI.Node

/// What a `Styled` node does to the text under it. Semantic, not a colour: the terminal picks a
/// colour, the page picks a class.
type Style =
  | Bold
  | Dim
  | Italic
  | Underline
  | Success
  | Error
  | Warning
  | Info
  | Muted
  | Highlight


/// How loud a `Band` is.
type Severity =
  | Info
  | Warning
  | Error


/// A text field. `id` names it across frames (focus follows the id, not the position);
/// `edited` turns the new text into the app's message.
type InputSpec<'msg> =
  { id: String
    value: String
    placeholder: String
    edited: String -> 'msg }


type Node<'msg> =
  /// One line of text, clipped to the width it is given.
  | Text(String)
  | Styled(Style, Node<'msg>)
  /// Children side by side.
  | Row(List<Node<'msg>>)
  /// Children stacked.
  | Column(List<Node<'msg>>)
  /// A header row, a rule, then the rows; column widths from the content.
  | Table(columns: List<String>, rows: List<List<String>>)
  /// Children stacked, each marked as an item.
  | ListOf(List<Node<'msg>>)
  | Input(InputSpec<'msg>)
  /// A label that sends `'msg` when pressed.
  | Button(label: String, 'msg)
  | Link(label: String, href: String)
  /// `node` in a box of exactly this many rows and columns (clipped, or padded).
  | Region(rows: Int64, cols: Int64, Node<'msg>)
  /// A full-width message in the severity's colour. This is where a diagnostic goes when the host
  /// keeps the last good frame under it.
  | Band(Severity, String)
  /// Rows already rendered by something older. The escape hatch for views written as lines.
  | Rows(List<String>)
  /// Nothing. A branch of a view that has nothing to say this frame.
  | Empty


// --- building ---

let text(s: String): Node<'msg> =
  Node.Text(s)


let column(children: List<Node<'msg>>): Node<'msg> = Node.Column(children)

let row(children: List<Node<'msg>>): Node<'msg> = Node.Row(children)

let styled(style: Style, child: Node<'msg>): Node<'msg> = Node.Styled(style, child)

let bold(s: String): Node<'msg> = Node.Styled(Style.Bold, Node.Text(s))

let dim(s: String): Node<'msg> = Node.Styled(Style.Dim, Node.Text(s))

let band(severity: Severity, message: String): Node<'msg> = Node.Band(severity, message)


let table(columns: List<String>, rows: List<List<String>>): Node<'msg> =
  Node.Table(columns, rows)


// --- measuring ---

/// The width of the widest cell in each column of a table, headers included.
let tableWidths(columns: List<String>, rows: List<List<String>>): List<Int64> =
  columns
  |> List.indexedMap(fun(i, header) ->
    let headerWidth = String.displayWidth(header)
    rows
    |> List.fold(headerWidth, fun(widest, r) ->
      match List.getAt(r, i) with
      | Some(cell) -> max(widest, String.displayWidth(cell))
      | None -> widest))


/// The size a node would take if nothing constrained it: (rows, cols).
let measure(node: Node<'msg>): (Int64 * Int64) =
  match node with
  | Text(s) -> (1, String.displayWidth(s))
  | Styled(_, inner) -> measure(inner)
  | Row(children) ->
    children
    |> List.fold((0, 0), fun(acc, child) ->
      let (rows, cols) = acc
      let (r, c) = measure(child)
      (max(rows, r), cols + c))
  | Column(children) ->
    children
    |> List.fold((0, 0), fun(acc, child) ->
      let (rows, cols) = acc
      let (r, c) = measure(child)
      (rows + r, max(cols, c)))
  | Table(columns, rows) ->
    let widths = tableWidths(columns, rows)
    let gaps = 2 * max(0, List.length(widths) - 1)
    let width = List.fold(widths, 0, fun(acc, w) -> acc + w) + gaps
    // Header, rule, rows.
    (2 + List.length(rows), width)
  | ListOf(children) ->
    children
    |> List.fold((0, 0), fun(acc, child) ->
      let (rows, cols) = acc
      let (r, c) = measure(child)
      (rows + r, max(cols, c + 2)))
  | Input(spec) ->
    let shown = if spec.value == "" then spec.placeholder else spec.value
    (1, String.displayWidth(shown) + 4)
  | Button(label, _) -> (1, String.displayWidth(label) + 4)
  | Link(label, _) -> (1, String.displayWidth(label))
  | Region(rows, cols, _) -> (rows, cols)
  | Band(_, message) -> (1, String.displayWidth(message))
  | Rows(rows) ->
    (List.length(rows), rows |> List.fold(0, fun(w, r) -> max(w, String.displayWidth(r))))
  | Empty -> (0, 0)


// --- focus ---

/// The focusable nodes, in tree order, as their ids: an `Input` by its `id`, a `Button` by its
/// label. Focus is an index into this list, kept by the host, and it follows the id across frames
/// so a re-render that adds a row above does not move it.
let focusable(node: Node<'msg>): List<String> =
  match node with
  | Input(spec) -> [ spec.id ]
  | Button(label, _) -> [ label ]
  | Styled(_, inner) -> focusable(inner)
  | Region(_, _, inner) -> focusable(inner)
  | Row(children) ->
    children
    |> List.map(focusable)
    |> List.flatten
  | Column(children) ->
    children
    |> List.map(focusable)
    |> List.flatten
  | ListOf(children) ->
    children
    |> List.map(focusable)
    |> List.flatten
  | _ -> []


/// The `Button` message or `Input` spec under a focus id, if the tree still has it.
type Focused<'msg> =
  | OnButton('msg)
  | OnInput(InputSpec<'msg>)


let findFocused(node: Node<'msg>, id: String): Option<Focused<'msg>> =
  match node with
  | Input(spec) -> if spec.id == id then Option.Some(Focused.OnInput(spec)) else Option.None
  | Button(label, msg) -> if label == id then Option.Some(Focused.OnButton(msg)) else Option.None
  | Styled(_, inner) -> findFocused(inner, id)
  | Region(_, _, inner) -> findFocused(inner, id)
  | Row(children) ->
    children
    |> List.filterMap(fun c -> findFocused(c, id))
    |> List.head
  | Column(children) ->
    children
    |> List.filterMap(fun c -> findFocused(c, id))
    |> List.head
  | ListOf(children) ->
    children
    |> List.filterMap(fun c -> findFocused(c, id))
    |> List.head
  | _ -> Option.None


// --- the terminal ---

/// The SGR prefix a style paints with.
let styleCode(style: Style): String =
  match style with
  | Bold -> Colors.bold
  | Dim -> Colors.dim
  | Italic -> Colors.italic
  | Underline -> Colors.underline
  | Success -> Colors.successColor
  | Error -> Colors.errorColor
  | Warning -> Colors.warningColor
  | Info -> Colors.infoColor
  | Muted -> Colors.muted
  | Highlight -> Colors.grayBg + Colors.white


let severityCode(severity: Severity): String =
  match severity with
  | Info -> Colors.bgBlue + Colors.white
  | Warning -> Colors.bgYellow + Colors.black
  | Error -> Colors.bgRed + Colors.brightWhite


/// A sub-region: `rows` rows starting `top` rows down and `left` columns in, `cols` wide, never
/// reaching outside the parent.
let sub(region: Layout.Region, top: Int64, left: Int64, rows: Int64, cols: Int64): Layout.Region =
  Layout.Region
    { top = region.top + top
      left = region.left + left
      rows = max(0, min(rows, region.rows - top))
      cols = max(0, min(cols, region.cols - left)) }


/// Does every cell in column <param i> read as a number? Those columns right-align, the way a
/// person lines up figures; text stays left.
let isNumericColumn(rows: List<List<String>>, i: Int64): Bool =
  let cells = rows |> List.filterMap(fun r -> List.getAt(r, i))
  Bool.not(List.isEmpty(cells))
  && (cells |> List.all(fun c -> c == "" || Result.isOk(Int64.parse(c))))


/// The text rows of a table: header, rule, rows, each cell padded to its column; numeric columns
/// right-aligned.
let tableRows(columns: List<String>, rows: List<List<String>>): List<String> =
  let widths = tableWidths(columns, rows)
  let numeric = widths |> List.indexedMap(fun(i, _) -> isNumericColumn(rows, i))
  let line(cells: List<String>): String =
    widths
    |> List.indexedMap(fun(i, w) ->
      let cell = List.getAt(cells, i) |> Option.withDefault("")
      if List.getAt(numeric, i) == Option.Some(true) then
        Text.padStartToWidth(cell, w)
      else
        Text.padEndToWidth(cell, w))
    |> String.join("  ")
    |> String.trimEnd

  let rule =
    widths
    |> List.map(fun w -> String.checkedRepeat("-", w) |> Result.withDefault(""))
    |> String.join("  ")

  List.concat([ Colors.boldText(line(columns)), Colors.dimText(rule) ], rows |> List.map(line))


/// Paint <param node> into <param region>. <param focus> is the focused id, "" for none; <param
/// style> is the SGR prefix inherited from enclosing `Styled` nodes ("" at the top).
let paint(
  node: Node<'msg>,
  region: Layout.Region,
  focus: String,
  style: String)
  : List<Layout.Span> =
  let textAt(r: Int64, s: String): List<Layout.Span> =
    let shown = if style == "" then s else Colors.colorize(style, s)
    Layout.at(region, r, 0, shown)

  if region.rows <= 0 || region.cols <= 0 then
    []
  else
    let stack(children: List<Node<'msg>>, indent: Int64, marker: String): List<Layout.Span> =
      let (_top, chunks) =
        children
        |> List.fold((0, []), fun(acc, child) ->
          let (top, collected) = acc
          let (rows, _) = measure(child)
          if top >= region.rows then
            (top, collected)
          else
            let mark =
              if marker == "" then [] else Layout.at(region, top, 0, Colors.dimText(marker))

            let spans =
              paint(child, sub(region, top, indent, rows, region.cols - indent), focus, style)

            (top + rows, List.prepend(collected, List.concat(mark, spans))))

      chunks
      |> List.reverse
      |> List.flatten

    match node with
    | Empty -> []
    | Text(s) -> textAt(0, s)
    | Rows(rows) ->
      rows
      |> List.indexedMap(fun(i, r) -> textAt(i, r))
      |> List.flatten
    | Styled(inner, child) -> paint(child, region, focus, style + styleCode(inner))
    | Band(severity, message) ->
      let code = severityCode(severity)
      let lines = Tui.Text.wrapAtWords(message, max(1, region.cols - 2))
      // At most two rows: a band is a headline, not a page.
      List.take(lines, 2)
      |> List.indexedMap(fun(i, line) ->
        let padded = Text.padEndToWidth(" " + line, region.cols)
        Layout.at(region, i, 0, Colors.colorize(code, padded)))
      |> List.flatten
    | Table(columns, rows) ->
      tableRows(columns, rows)
      |> List.indexedMap(fun(i, r) -> textAt(i, r))
      |> List.flatten
    | Input(spec) ->
      let shown = if spec.value == "" then Colors.dimText(spec.placeholder) else spec.value

      let box =
        if focus == spec.id then
          Colors.colorize(Colors.grayBg + Colors.white, $"[ {shown} ]")
        else
          $"[ {shown} ]"

      Layout.at(region, 0, 0, box)
    | Button(label, _) ->
      let box =
        if focus == label then
          Colors.colorize(Colors.greenBg + Colors.black + Colors.bold, $"[ {label} ]")
        else
          Colors.colorize(Colors.bold, $"[ {label} ]")

      Layout.at(region, 0, 0, box)
    | Link(label, _) -> textAt(0, Colors.underlineText(label))
    | Region(rows, cols, inner) -> paint(inner, sub(region, 0, 0, rows, cols), focus, style)
    // A column stacks its children; a list is a column with a marker and a two-column indent.
    | Column(children) -> stack(children, 0, "")
    | ListOf(children) -> stack(children, 2, "-")
    | Row(children) ->
      // Natural widths, one column of gap between children; the last child that overflows takes
      // what is left and is clipped there.
      let (_left, chunks) =
        children
        |> List.fold((0, []), fun(acc, child) ->
          let (left, collected) = acc
          let (_, cols) = measure(child)
          if left >= region.cols then
            (left, collected)
          else
            let spans = paint(child, sub(region, 0, left, region.rows, cols), focus, style)
            (left + cols + 1, List.prepend(collected, spans)))

      chunks
      |> List.reverse
      |> List.flatten


/// Paint <param node> into <param region>. The terminal renderer.
let toSpans(node: Node<'msg>, region: Layout.Region, focus: String): List<Layout.Span> =
  paint(node, region, focus, "")


/// Paint <param node> as styled rows at <param width>, as tall as it measures, with <param focus>
/// marked: what a host windows when the tree is taller than its pane.
let toRows(node: Node<'msg>, width: Int64, focus: String): List<String> =
  let (rows, _) = measure(node)
  let w = max(1, width)
  let region = Layout.Region { top = 1, left = 1, rows = rows, cols = w }
  Canvas.compose(w, rows, toSpans(node, region, focus)) |> List.map(String.trimEnd)


/// Paint <param node> as plain rows at <param width>, as tall as it measures: for printing a tree
/// to stdout (a one-shot command) rather than into a frame.
let toLines(node: Node<'msg>, width: Int64): List<String> =
  toRows(node, width, "")


/// The row a focusable node with <param id> is painted on, so a host can scroll it into view.
let rowOf(node: Node<'msg>, id: String): Option<Int64> =
  let find(n: Node<'msg>, top: Int64): Option<Int64> =
    match n with
    | Input(spec) -> if spec.id == id then Option.Some(top) else Option.None
    | Button(label, _) -> if label == id then Option.Some(top) else Option.None
    | Styled(_, inner) -> find(inner, top)
    | Region(_, _, inner) -> find(inner, top)
    | Row(children) ->
      children
      |> List.filterMap(fun c -> find(c, top))
      |> List.head
    | Column(children) | ListOf(children) ->
      let (_, found) =
        children
        |> List.fold((top, Option.None), fun(acc, child) ->
          let (at, found) = acc
          match found with
          | Some(_) -> acc
          | None ->
            let (rows, _) = measure(child)
            (at + rows, find(child, at)))

      found
    | _ -> Option.None

  find(node, 0)
