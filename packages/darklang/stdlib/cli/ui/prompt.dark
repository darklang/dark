module Darklang.Stdlib.Cli.UI.Prompt

/// Whether anyone can answer a question here. A terminal alone isn't enough: CI gives every step a
/// pty nobody types into.
let canAsk(): Bool =
  Sys.isTerminal(0)
  && Sys.isTerminal(2)
  && Bool.not(Env.isOn("CI"))
  && Bool.not(Env.isOn("DARK_NO_INPUT"))


let nobodyCanAnswer(): String =
  "nobody can answer a question here (stdin or stderr isn't a terminal, or --no-input, DARK_NO_INPUT or CI is set)"


/// Ask the user for text input. None when nobody can answer, input ends, or the answer is not
/// UTF-8.
let ask(question: String): Option<String> =
  if Bool.not(canAsk()) then
    Option.None
  else
    printError($"{question} ")
    Stdin.checkedReadLine() |> Result.withDefault(Option.None)


/// Ask the user a yes/no question. Returns true for yes.
let confirm(question: String): Bool =
  match ask($"{question} [y/N]") with
  | Some(typed) ->
    let answer = String.toLowercase(String.trim(typed))
    answer == "y" || answer == "yes"
  | None -> false


/// Ask the user to select from a list of choices. None when nobody can answer, input ends, or the
/// answer is not UTF-8.
let select(question: String, choices: List<String>): Option<String> =
  if Bool.not(canAsk()) then
    Option.None
  else
    printErrorLine(question)
    let _ =
      choices
      |> List.indexedMap(fun(i, choice) ->
        printErrorLine($"  {Colors.boldText(display(i + 1))}. {choice}"))

    printError("Enter number: ")
    match Stdin.checkedReadLine() with
    | Error(_) -> Option.None
    | Ok(None) -> Option.None
    | Ok(Some(input)) ->
      match Int64.parse(String.trim(input)) with
      | Ok(n) ->
        match List.getAt(choices, n - 1) with
        | Some(choice) -> Option.Some(choice)
        | None ->
          printErrorLine(Colors.redText("Invalid selection"))
          select(question, choices)
      | Error(_e) ->
        printErrorLine(Colors.redText("Please enter a number"))
        select(question, choices)
