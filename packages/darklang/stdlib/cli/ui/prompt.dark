module Darklang.Stdlib.Cli.UI.Prompt


/// Whether anyone can answer a question here. A terminal alone isn't enough: CI gives every step a
/// pty nobody types into.
let canAsk(): Bool =
  Stdlib.Cli.Sys.isTerminal(0)
  && Stdlib.Cli.Sys.isTerminal(2)
  && Stdlib.Bool.not(Stdlib.Cli.Env.isOn("CI"))
  && Stdlib.Bool.not(Stdlib.Cli.Env.isOn("DARK_NO_INPUT"))

let nobodyCanAnswer(): String =
  "nobody can answer a question here (stdin or stderr isn't a terminal, or --no-input, DARK_NO_INPUT or CI is set)"

/// Ask the user for text input. None when nobody can answer, input ends, or the answer is not
/// UTF-8.
let ask(question: String): Stdlib.Option.Option<String> =
  if Stdlib.Bool.not(canAsk()) then
    Stdlib.Option.Option.None
  else
    Stdlib.printError($"{question} ")
    Stdlib.Cli.Stdin.checkedReadLine() |> Stdlib.Result.withDefault(Stdlib.Option.Option.None)


/// Ask the user a yes/no question. Returns true for yes.
let confirm(question: String): Bool =
  match ask($"{question} [y/N]") with
  | Some(typed) ->
    let answer = Stdlib.String.toLowercase(Stdlib.String.trim(typed))
    answer == "y" || answer == "yes"
  | None -> false


/// Ask the user to select from a list of choices. None when nobody can answer, input ends, or the
/// answer is not UTF-8.
let select(
  question: String,
  choices: List<String>)
  : Stdlib.Option.Option<String> =
  if Stdlib.Bool.not(canAsk()) then
    Stdlib.Option.Option.None
  else
    Stdlib.printErrorLine(question)
    let _ =
      choices
      |> Stdlib.List.indexedMap(fun(i, choice) ->
        Stdlib.printErrorLine($"  {Stdlib.Cli.UI.Colors.boldText(Stdlib.display(i + 1))}. {choice}"))
    Stdlib.printError("Enter number: ")
    match Stdlib.Cli.Stdin.checkedReadLine() with
    | Error(_) -> Stdlib.Option.Option.None
    | Ok(None) -> Stdlib.Option.Option.None
    | Ok(Some(input)) ->
      match Stdlib.Int64.parse(Stdlib.String.trim(input)) with
      | Ok(n) ->
        match Stdlib.List.getAt(choices, n - 1) with
        | Some(choice) -> Stdlib.Option.Option.Some(choice)
        | None ->
          Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.redText("Invalid selection"))
          select(question, choices)
      | Error(_e) ->
        Stdlib.printErrorLine(Stdlib.Cli.UI.Colors.redText("Please enter a number"))
        select(question, choices)
