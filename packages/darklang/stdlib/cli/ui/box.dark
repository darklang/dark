/// A focus-aware, rounded pane with an optional pill title.
module Darklang.Stdlib.Cli.UI.Box

/// The content region inside a box's border.
let inner(region: Layout.Region): Layout.Region =
  Layout.Region
    { top = region.top + 1
      left = region.left + 1
      rows = max(0, region.rows - 2)
      cols = max(0, region.cols - 2) }


/// Draw a focus-aware, rounded box around `region`: the border is Darklang
/// purple when focused, dim otherwise, and the title is a pill.
///
/// The title splits at its first ` · `: what's before is the pane's identity
/// and goes in the pill (purple with white text when focused, grey when not);
/// what's after - a count, a path, a filter, key hints - trails it dim. So
/// `Tree · 5` is a pill saying Tree and a dim `· 5`, and a plain title is
/// just the pill.
///
/// Returns spans; colour codes carry no width (clipping goes through `Tui.Text`).
let draw(region: Layout.Region, title: String, focus: Focus): List<Layout.Span> =
  let focused = focus == Focus.Focused
  let color = if focused then Colors.purple else Colors.brightBlack
  let paint = fun s -> Colors.colorize(color, s)
  let innerCols = max(0, region.cols - 2)
  let (pillText, rest) =
    match String.split(title, "  ·  ") with
    | [] -> ("", "")
    | [first] -> (first, "")
    | [first, ...more] -> (first, String.join(more, "  ·  "))

  let pillPlain = if pillText == "" then "" else " " + pillText + " "
  let pillStyle = if focused then Colors.purpleBg + Colors.white + Colors.bold else Colors.grayBg
  let pill = if pillPlain == "" then "" else Colors.colorize(pillStyle, pillPlain)
  let restPlain = if rest == "" then "" else " · " + rest + " "
  let restStyled = if restPlain == "" then "" else Colors.dimText(restPlain)
  // The pill and its trailer carry their own colours (and resets), so the
  // border is painted around them in pieces rather than as one string.
  let lead = if pillPlain == "" then "" else "─"

  // The trailer is clipped so a title near the pane's full width can't overrun the closing corner
  // into the neighbour's border: `─╮` always draws (the pill itself is short by construction).
  let leadW = String.displayWidth(lead)
  let budget = max(0, innerCols - leadW - String.displayWidth(pillPlain) - 1)
  let restPlain = Tui.Text.clipToWidth(restPlain, budget)
  let restStyled = if restPlain == "" then "" else Colors.dimText(restPlain)
  let used = leadW + String.displayWidth(pillPlain) + String.displayWidth(restPlain)
  let fillLen = max(0, innerCols - used)
  let top =
    paint("╭" + lead)
    + pill
    + restStyled
    + paint((String.checkedRepeat("─", fillLen) |> Result.withDefault("")) + "╮")

  let bottom = "╰" + (String.checkedRepeat("─", innerCols) |> Result.withDefault("")) + "╯"

  // One colorized bar, not one per row per side. Every row's border is the same string, and a panel
  // draws it once per row; the borders of a few panels are most of a frame's spans.
  let bar = paint("│")

  // Built directly rather than through `Layout.at`. That helper measures the text, clips it to the
  // region and bounds-checks the position -- right for arbitrary content, all wasted on a
  // one-character bar at a position this function just computed. Borders are most of a frame's
  // spans, so it adds up.
  let top1 = region.top - 1
  let left1 = region.left - 1
  let rightCol = left1 + region.cols - 1

  // `Layout.at` would drop an out-of-bounds span; checked once here for the whole panel instead of
  // once per row, since every row of a given panel is in bounds or none of them is.
  let sides =
    if region.cols < 2 then
      []
    else
      (List.checkedRange(1, region.rows - 2) |> Result.withDefault([]))
      |> List.map(fun row ->
        let r = top1 + row
        [ Layout.Span { row = r, col = left1, text = bar }
          Layout.Span { row = r, col = rightCol, text = bar } ])
      |> List.flatten

  List.flatten(
    [ Layout.at(region, 0, 0, top), sides, Layout.at(region, region.rows - 1, 0, paint(bottom)) ])


/// Draw a box and render content into its inner region in one call. <param focus> picks the
/// bright/dim border.
let panel(
  region: Layout.Region,
  title: String,
  focus: Focus,
  renderInner: Layout.Region -> List<Layout.Span>)
  : List<Layout.Span> =
  List.flatten([ draw(region, title, focus), renderInner(inner(region)) ])
