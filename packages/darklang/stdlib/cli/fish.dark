module Darklang.Stdlib.Cli.Fish

/// Read the content of config.fish file
let readFishConfig(): Result<String, String> =
  FileSystem.readFile("$HOME/.config/fish/config.fish")
  |> Result.map(Utf8.decodeWithReplacement)
  |> Result.mapError(FileSystem.FileError.toString)


/// Overwrite what's in the config.fish file
let overwriteFishConfig(content: String): Result<Unit, String> =
  // `writeFile`, which makes `~/.config/fish` if it isn't there yet.
  FileSystem.writeFile("$HOME/.config/fish/config.fish", Utf8.encode(content))
  |> Result.mapError(FileSystem.FileError.toString)


/// Delete an alias from config.fish
let deleteAlias(alias: String): Result<Unit, String> =
  readFishConfig()
  |> Result.andThen(fun content ->
    let updatedContent =
      content
      |> String.split("\n")
      |> List.filter(fun line -> Bool.not(String.contains(line, $"alias {alias} ")))
      |> String.join("\n")

    overwriteFishConfig(updatedContent))


/// Add an alias to config.fish
let addAlias(alias: String, command: String): Result<Unit, String> =
  let aliasDefinition = $"alias {alias} '{command}'"
  readFishConfig()
  |> Result.andThen(fun content ->
    let updatedContent = content + "\n" + aliasDefinition
    overwriteFishConfig(updatedContent))


/// Add a directory to PATH in config.fish
let addToPath(dir: String): Result<Unit, String> =
  let exportLine = $"fish_add_path {dir}"

  // A missing rc file is an empty one: a fresh account often has none, and refusing here used to
  // fail an install after the binary was already in place.
  let existing =
    if FileSystem.pathExists("$HOME/.config/fish/config.fish") then
      readFishConfig()
    else
      Result.Ok("")

  match existing with
  | Ok(content) ->
    // Check if PATH addition for this dir already exists (not just any reference to the dir)
    if String.contains(content, exportLine) then
      Result.Ok()
    else
      let updatedContent = content + "\n" + exportLine
      overwriteFishConfig(updatedContent)
  | Error(e) -> Result.Error(e)
