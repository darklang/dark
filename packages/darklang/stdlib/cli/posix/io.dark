/// Complete a descriptor write when the kernel accepts only part of a buffer.
module Darklang.Stdlib.Cli.Posix.IO

let writeAll
  (write: Blob -> Result.Result<Int, Stdlib.Cli.Posix.Error>)
  (bytes: Blob)
  (written: Int)
  : Result.Result<Int, Stdlib.Cli.Posix.Error> =
  let length = Stdlib.Blob.length bytes
  if length == 0 then Stdlib.Result.Result.Ok written
  else
    match write bytes with
    | Error error ->
      if error.errno == 4 then writeAll write bytes written
      else Stdlib.Result.Result.Error error
    | Ok count ->
      if count <= 0 || count > length then
        Stdlib.Result.Result.Error (Stdlib.Cli.Posix.Error {
          errno = 5; message = "write made invalid progress" })
      else if count == length then Stdlib.Result.Result.Ok (written + count)
      else
        let rest = Stdlib.Blob.slice bytes count (length - count)
        writeAll write rest (written + count)
