/// Error messages ported from the compiler's Cli.__Posix implementation.
/// Kernel errno is platform-specific; permission and host diagnostics stay intact.
module Darklang.Stdlib.Cli.Posix.Errors

let macMessage (errno: Int) : String =
    if errno == 1 then "Operation not permitted"
    else if errno == 2 then "No such file or directory"
    else if errno == 3 then "No such process"
    else if errno == 4 then "Interrupted system call"
    else if errno == 5 then "Input/output error"
    else if errno == 6 then "Device not configured"
    else if errno == 7 then "Argument list too long"
    else if errno == 8 then "Exec format error"
    else if errno == 9 then "Bad file descriptor"
    else if errno == 10 then "No child processes"
    else if errno == 11 then "Resource deadlock avoided"
    else if errno == 12 then "Cannot allocate memory"
    else if errno == 13 then "Permission denied"
    else if errno == 14 then "Bad address"
    else if errno == 15 then "Block device required"
    else if errno == 16 then "Device / Resource busy"
    else if errno == 17 then "File exists"
    else if errno == 18 then "Cross-device link"
    else if errno == 19 then "Operation not supported by device"
    else if errno == 20 then "Not a directory"
    else if errno == 21 then "Is a directory"
    else if errno == 22 then "Invalid argument"
    else if errno == 23 then "Too many open files in system"
    else if errno == 24 then "Too many open files"
    else if errno == 25 then "Inappropriate ioctl for device"
    else if errno == 26 then "Text file busy"
    else if errno == 27 then "File too large"
    else if errno == 28 then "No space left on device"
    else if errno == 29 then "Illegal seek"
    else if errno == 30 then "Read-only file system"
    else if errno == 31 then "Too many links"
    else if errno == 32 then "Broken pipe"
    else if errno == 33 then "Numerical argument out of domain"
    else if errno == 34 then "Result too large"
    else if errno == 35 then "Resource temporarily unavailable"
    else if errno == 36 then "Operation now in progress"
    else if errno == 37 then "Operation already in progress"
    else if errno == 38 then "Socket operation on non-socket"
    else if errno == 39 then "Destination address required"
    else if errno == 40 then "Message too long"
    else if errno == 41 then "Protocol wrong type for socket"
    else if errno == 42 then "Protocol not available"
    else if errno == 43 then "Protocol not supported"
    else if errno == 44 then "Socket type not supported"
    else if errno == 45 then "Operation not supported"
    else if errno == 46 then "Protocol family not supported"
    else if errno == 47 then "Address family not supported by protocol family"
    else if errno == 48 then "Address already in use"
    else if errno == 49 then "Can't assign requested address"
    else if errno == 50 then "Network is down"
    else if errno == 51 then "Network is unreachable"
    else if errno == 52 then "Network dropped connection on reset"
    else if errno == 53 then "Software caused connection abort"
    else if errno == 54 then "Connection reset by peer"
    else if errno == 55 then "No buffer space available"
    else if errno == 56 then "Socket is already connected"
    else if errno == 57 then "Socket is not connected"
    else if errno == 58 then "Can't send after socket shutdown"
    else if errno == 59 then "Too many references: can't splice"
    else if errno == 60 then "Operation timed out"
    else if errno == 61 then "Connection refused"
    else if errno == 62 then "Too many levels of symbolic links"
    else if errno == 63 then "File name too long"
    else if errno == 64 then "Host is down"
    else if errno == 65 then "No route to host"
    else if errno == 66 then "Directory not empty"
    else if errno == 67 then "Too many processes"
    else if errno == 68 then "Too many users"
    else if errno == 69 then "Disc quota exceeded"
    else if errno == 70 then "Stale NFS file handle"
    else if errno == 71 then "Too many levels of remote in path"
    else if errno == 72 then "RPC struct is bad"
    else if errno == 73 then "RPC version wrong"
    else if errno == 74 then "RPC prog. not avail"
    else if errno == 75 then "Program version wrong"
    else if errno == 76 then "Bad procedure for program"
    else if errno == 77 then "No locks available"
    else if errno == 78 then "Function not implemented"
    else if errno == 79 then "Inappropriate file type or format"
    else if errno == 80 then "Authentication error"
    else if errno == 81 then "Need authenticator"
    else if errno == 82 then "Device power is off"
    else if errno == 83 then "Device error, e.g. paper out"
    else if errno == 84 then "Value too large to be stored in data type"
    else if errno == 85 then "Bad executable"
    else if errno == 86 then "Bad CPU type in executable"
    else if errno == 87 then "Shared library version mismatch"
    else if errno == 88 then "Malformed Macho file"
    else if errno == 89 then "Operation canceled"
    else if errno == 90 then "Identifier removed"
    else if errno == 91 then "No message of desired type"
    else if errno == 92 then "Illegal byte sequence"
    else if errno == 93 then "Attribute not found"
    else if errno == 94 then "Bad message"
    else if errno == 95 then "Reserved"
    else if errno == 96 then "No message available on STREAM"
    else if errno == 97 then "Reserved"
    else if errno == 98 then "No STREAM resources"
    else if errno == 99 then "Not a STREAM"
    else if errno == 100 then "Protocol error"
    else if errno == 101 then "STREAM ioctl timeout"
    else if errno == 102 then "Operation not supported on socket"
    else if errno == 103 then "No such policy registered"
    else if errno == 104 then "State not recoverable"
    else if errno == 105 then "Previous owner died"
    else if errno == 106 then "Interface output queue is full"
    else if errno == 107 then "Capabilities insufficient"
    else "Unknown error: " + Stdlib.toString errno

let fromErrno (errno: Int) : Stdlib.Cli.Posix.Error =
    let message =
        if Stdlib.Cli.KernelABI.mac () then macMessage errno
        else if errno == 1 then "Operation not permitted"
        else if errno == 2 then "No such file or directory"
        else if errno == 3 then "No such process"
        else if errno == 4 then "Interrupted system call"
        else if errno == 5 then "Input/output error"
        else if errno == 6 then "No such device or address"
        else if errno == 7 then "Argument list too long"
        else if errno == 8 then "Exec format error"
        else if errno == 9 then "Bad file descriptor"
        else if errno == 10 then "No child processes"
        else if errno == 11 then "Resource temporarily unavailable"
        else if errno == 12 then "Cannot allocate memory"
        else if errno == 13 then "Permission denied"
        else if errno == 14 then "Bad address"
        else if errno == 15 then "Block device required"
        else if errno == 16 then "Device or resource busy"
        else if errno == 17 then "File exists"
        else if errno == 18 then "Invalid cross-device link"
        else if errno == 19 then "No such device"
        else if errno == 20 then "Not a directory"
        else if errno == 21 then "Is a directory"
        else if errno == 22 then "Invalid argument"
        else if errno == 23 then "Too many open files in system"
        else if errno == 24 then "Too many open files"
        else if errno == 25 then "Inappropriate ioctl for device"
        else if errno == 26 then "Text file busy"
        else if errno == 27 then "File too large"
        else if errno == 28 then "No space left on device"
        else if errno == 29 then "Illegal seek"
        else if errno == 30 then "Read-only file system"
        else if errno == 31 then "Too many links"
        else if errno == 32 then "Broken pipe"
        else if errno == 33 then "Numerical argument out of domain"
        else if errno == 34 then "Numerical result out of range"
        else if errno == 35 then "Resource deadlock avoided"
        else if errno == 36 then "File name too long"
        else if errno == 37 then "No locks available"
        else if errno == 38 then "Function not implemented"
        else if errno == 39 then "Directory not empty"
        else if errno == 40 then "Too many levels of symbolic links"
        else if errno == 42 then "No message of desired type"
        else if errno == 43 then "Identifier removed"
        else if errno == 44 then "Channel number out of range"
        else if errno == 45 then "Level 2 not synchronized"
        else if errno == 46 then "Level 3 halted"
        else if errno == 47 then "Level 3 reset"
        else if errno == 48 then "Link number out of range"
        else if errno == 49 then "Protocol driver not attached"
        else if errno == 50 then "No CSI structure available"
        else if errno == 51 then "Level 2 halted"
        else if errno == 52 then "Invalid exchange"
        else if errno == 53 then "Invalid request descriptor"
        else if errno == 54 then "Exchange full"
        else if errno == 55 then "No anode"
        else if errno == 56 then "Invalid request code"
        else if errno == 57 then "Invalid slot"
        else if errno == 59 then "Bad font file format"
        else if errno == 60 then "Device not a stream"
        else if errno == 61 then "No data available"
        else if errno == 62 then "Timer expired"
        else if errno == 63 then "Out of streams resources"
        else if errno == 64 then "Machine is not on the network"
        else if errno == 65 then "Package not installed"
        else if errno == 66 then "Object is remote"
        else if errno == 67 then "Link has been severed"
        else if errno == 68 then "Advertise error"
        else if errno == 69 then "Srmount error"
        else if errno == 70 then "Communication error on send"
        else if errno == 71 then "Protocol error"
        else if errno == 72 then "Multihop attempted"
        else if errno == 73 then "RFS specific error"
        else if errno == 74 then "Bad message"
        else if errno == 75 then "Value too large for defined data type"
        else if errno == 76 then "Name not unique on network"
        else if errno == 77 then "File descriptor in bad state"
        else if errno == 78 then "Remote address changed"
        else if errno == 79 then "Can not access a needed shared library"
        else if errno == 80 then "Accessing a corrupted shared library"
        else if errno == 81 then ".lib section in a.out corrupted"
        else if errno == 82 then "Attempting to link in too many shared libraries"
        else if errno == 83 then "Cannot exec a shared library directly"
        else if errno == 84 then "Invalid or incomplete multibyte or wide character"
        else if errno == 85 then "Interrupted system call should be restarted"
        else if errno == 86 then "Streams pipe error"
        else if errno == 87 then "Too many users"
        else if errno == 88 then "Socket operation on non-socket"
        else if errno == 89 then "Destination address required"
        else if errno == 90 then "Message too long"
        else if errno == 91 then "Protocol wrong type for socket"
        else if errno == 92 then "Protocol not available"
        else if errno == 93 then "Protocol not supported"
        else if errno == 94 then "Socket type not supported"
        else if errno == 95 then "Operation not supported"
        else if errno == 96 then "Protocol family not supported"
        else if errno == 97 then "Address family not supported by protocol"
        else if errno == 98 then "Address already in use"
        else if errno == 99 then "Cannot assign requested address"
        else if errno == 100 then "Network is down"
        else if errno == 101 then "Network is unreachable"
        else if errno == 102 then "Network dropped connection on reset"
        else if errno == 103 then "Software caused connection abort"
        else if errno == 104 then "Connection reset by peer"
        else if errno == 105 then "No buffer space available"
        else if errno == 106 then "Transport endpoint is already connected"
        else if errno == 107 then "Transport endpoint is not connected"
        else if errno == 108 then "Cannot send after transport endpoint shutdown"
        else if errno == 109 then "Too many references: cannot splice"
        else if errno == 110 then "Connection timed out"
        else if errno == 111 then "Connection refused"
        else if errno == 112 then "Host is down"
        else if errno == 113 then "No route to host"
        else if errno == 114 then "Operation already in progress"
        else if errno == 115 then "Operation now in progress"
        else if errno == 116 then "Stale file handle"
        else if errno == 117 then "Structure needs cleaning"
        else if errno == 118 then "Not a XENIX named type file"
        else if errno == 119 then "No XENIX semaphores available"
        else if errno == 120 then "Is a named type file"
        else if errno == 121 then "Remote I/O error"
        else if errno == 122 then "Disk quota exceeded"
        else if errno == 123 then "No medium found"
        else if errno == 124 then "Wrong medium type"
        else if errno == 125 then "Operation canceled"
        else if errno == 126 then "Required key not available"
        else if errno == 127 then "Key has expired"
        else if errno == 128 then "Key has been revoked"
        else if errno == 129 then "Key was rejected by service"
        else if errno == 130 then "Owner died"
        else if errno == 131 then "State not recoverable"
        else if errno == 132 then "Operation not possible due to RF-kill"
        else if errno == 133 then "Memory page has hardware error"
        else "Unknown error " + Stdlib.toString errno
    Stdlib.Cli.Posix.Error { errno = errno
                            message = message }

let render (error: Stdlib.Cli.Posix.Error) : Stdlib.Cli.Posix.Error =
  if Stdlib.String.startsWith error.message "OS error " then fromErrno error.errno
  else error

let normalize (result: Result.Result<'a, Stdlib.Cli.Posix.Error>) : Result.Result<'a, Stdlib.Cli.Posix.Error> =
  Stdlib.Result.mapError result render
