/// Path buffer growth and text decoding over one-call kernel primitives.
module Darklang.Stdlib.Cli.PathIO

let readlinkWith (read: Int -> Result.Result<Blob, Int>) (count: Int)
  : Result.Result<Blob, Int> =
  if count <= 0 then Error 22
  else
    match read count with
    | Error e ->
      if e == 4 then readlinkWith read count else Error e
    | Ok bytes ->
      if Stdlib.Blob.length bytes < count then Ok bytes
      else if count >= 1048576 then Error (if KernelABI.mac () then 63 else 36)
      else readlinkWith read (count * 2)

let readlink (path: String) : Result.Result<String, Posix.Error> =
  readlinkWith (fun count -> Syscall.readlinkAt path count) 256
  |> Stdlib.Result.map Stdlib.String.fromBlobWithReplacement
  |> Stdlib.Result.mapError Posix.Errors.fromErrno

let cwdWith (read: Int -> Result.Result<Blob, Int>) (count: Int)
  : Result.Result<Blob, Int> =
  if count <= 0 then Error 22
  else
    match read count with
    | Error 4 -> cwdWith read count
    | Error 34 ->
      if count >= 1048576 then Error 34 else cwdWith read (count * 2)
    | other -> other

let pathText (bytes: Blob) : String =
  bytes |> Stdlib.Blob.toList |> Stdlib.List.takeWhile (fun byte -> byte != 0uy)
  |> Stdlib.Blob.fromList |> Stdlib.String.fromBlobWithReplacement

let getCwd () : Result.Result<String, Posix.Error> =
  let bytes =
    if KernelABI.mac () then
      match Syscall.open "." (KernelABI.openDirectory ()) 0 with
      | Error e -> Error e
      | Ok fd ->
        let result = Syscall.fcntlGetPath fd
        let closed = Syscall.close fd
        match result with
        | Error e -> Error e
        | Ok bytes ->
          match closed with
          | Error e -> Error e
          | Ok _ -> Ok bytes
    else cwdWith Syscall.getcwd 256
  bytes |> Stdlib.Result.map pathText |> Stdlib.Result.mapError Posix.Errors.fromErrno
