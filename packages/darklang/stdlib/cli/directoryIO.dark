/// Directory iteration and record decoding over single-call kernel primitives.
module Darklang.Stdlib.Cli.DirectoryIO

let readAll (fd: Int) (reversed: List<String>)
  : Result.Result<List<String>, Int> =
  match Syscall.getdents fd 32768 with
  | Error e ->
    if e == 4 then readAll fd reversed else Error e
  | Ok bytes ->
    if Stdlib.Blob.length bytes == 0 then Ok (Stdlib.List.reverse reversed)
    else
      match KernelData.entries (Stdlib.Blob.toList bytes) reversed with
      | Error e -> Error e
      | Ok next -> readAll fd next

let list (path: String) : Result.Result<List<String>, Posix.Error> =
  match Posix.openFile path (KernelABI.openDirectory ()) 0 with
  | Error e -> Error e
  | Ok fd ->
    let result = readAll fd [] |> Stdlib.Result.mapError Posix.Errors.fromErrno
    let closed = Posix.fdClose fd
    match result with
    | Error e -> Error e
    | Ok entries -> closed |> Stdlib.Result.map (fun _ -> entries)
