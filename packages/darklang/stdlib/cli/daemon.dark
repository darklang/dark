/// Generic background-daemon process management.
/// 
/// A daemon is a DETACHED `dark` process tracked by a pidfile,
/// so the launching process can exit and the daemon keeps running.
/// 
/// Built on the POSIX stdlib: pidfile via `Cli.File`, signal-0 liveness via
/// `Posix.isProcessRunning`, detached launch + SIGTERM via `Process`/`Posix`.
/// 
/// The launcher is the running executable itself (`getCurrentExecutablePath`) -- no env var.
module Darklang.Stdlib.Cli.Daemon



// ── pidfile + log location ──  ~/.darklang/run/<name>.{pid,log}

/// Where pidfiles and logs may go, best first: `~/.darklang/run`, the instance's rundir, then
/// `/tmp`. A reader takes the first that is already there; a writer takes the first it can
/// write in, which is what puts one there.
let runDirCandidates () : List<String> =
  let home = Stdlib.Option.withDefault (Env.home ()) "/tmp"

  Stdlib.List.flatten
    [ [ home ++ "/.darklang/run" ]
      (match Env.get "DARK_CONFIG_RUNDIR" with
       | Some rundir -> [ rundir ++ "/run" ]
       | None -> [])
      [ "/tmp/darklang-run" ] ]

/// Can this process make <param dir> and write in it? Probed with a real write: a directory
/// another user owns (a `~/.darklang` a root process created first) exists and is not ours.
/// The probe file is removed again; only the writers ask (`claimPidfile`, `launchDetachedWith`).
let writableDir (dir: String) : Bool =
  match Posix.mkdirRecursive dir with
  | Error _ -> false
  | Ok _ ->
    match File.writeText (dir ++ "/.probe") "" with
    | Ok _ ->
      let _ = Stdlib.Cli.FileSystem.deleteFile (dir ++ "/.probe")
      true
    | Error _ -> false

/// Where a writer puts pidfiles and logs: the first candidate it can write in.
let runDirForWriting () : String =
  let candidates = runDirCandidates ()
  match Stdlib.List.findFirst candidates (fun d -> writableDir d) with
  | Some dir -> dir
  | None -> Stdlib.Option.withDefault (Stdlib.List.head candidates) "/tmp/darklang-run"

/// Where a reader looks: the first candidate that exists, so listing a daemon's state never
/// writes. Falls back to the first candidate, which is where a writer would have put it.
let runDir () : String =
  let candidates = runDirCandidates ()
  match Stdlib.List.findFirst candidates (fun d -> Stdlib.Cli.FileSystem.pathExists d) with
  | Some dir -> dir
  | None -> Stdlib.Option.withDefault (Stdlib.List.head candidates) "/tmp/darklang-run"

let pidfilePath (name: String) : String =
  (runDir ()) ++ "/" ++ name ++ ".pid"

// A detached daemon has no terminal, so its output + startup errors append here; `tailLog` reads it.
let logPath (name: String) : String =
  (runDir ()) ++ "/" ++ name ++ ".log"

// The daemon's last `n` log lines (newest at the bottom); empty if it never logged.
let tailLog (name: String) (n: Int) : List<String> =
  match File.readLastLines (logPath name) n with
  | Ok lines -> lines
  | Error _ -> []


// Record THIS process as the named daemon. The entrypoint calls this on startup, so the pidfile holds
// the real detached-worker pid, not a transient launcher.
let claimPidfile (name: String) : Stdlib.Result.Result<Unit, String> =
  match Posix.mkdirRecursive (runDirForWriting ()) with
  | Error e -> Stdlib.Result.Result.Error e.message
  | Ok _ ->
    let pid = Sys.currentPid ()

    match
      File.writeText
        (pidfilePath name)
        (Stdlib.Int.toString pid)
    with
    | Error e -> Stdlib.Result.Result.Error e.message
    | Ok _ -> Stdlib.Result.Result.Ok()


// The pid recorded for a daemon, if its pidfile exists and parses.
let recordedPid (name: String) : Stdlib.Option.Option<Int> =
  let path = pidfilePath name

  if File.exists path then
    match File.readText path with
    | Ok content ->
      Stdlib.Result.toOption (Stdlib.Int.parse (Stdlib.String.trim content))
    | Error _ -> Stdlib.Option.Option.None
  else
    Stdlib.Option.Option.None


// Alive? pidfile present AND that pid is a running process (signal-0) -- so a stale pidfile (daemon
// killed without cleanup) correctly reads as not running.
let isRunning (name: String) : Bool =
  match recordedPid name with
  | Some pid -> Posix.isProcessRunning pid
  | None -> false


// One status line: running / stopped / stale (pidfile present but its pid is dead).
let statusLine (name: String) : String =
  match recordedPid name with
  | Some pid ->
    if Posix.isProcessRunning pid then
      $"{name}: running (pid {Stdlib.Int.toString pid})"
    else
      $"{name}: stale (pid {Stdlib.Int.toString pid} not running -- `stop` clears it)"
  | None -> $"{name}: stopped"


// Stop the named daemon: SIGTERM the recorded pid (if alive), then remove the pidfile. Idempotent.
let stop (name: String) : Stdlib.Result.Result<String, String> =
  match recordedPid name with
  | None -> Stdlib.Result.Result.Ok $"{name}: not running"
  | Some pid ->
    let wasRunning = Posix.isProcessRunning pid

    let _killed =
      if wasRunning then
        Posix.kill pid Posix.sigterm
      else
        Stdlib.Result.Result.Ok()

    let _removed = File.delete (pidfilePath name)

    if wasRunning then
      Stdlib.Result.Result.Ok $"{name}: stopped (pid {Stdlib.Int.toString pid})"
    else
      Stdlib.Result.Result.Ok
        $"{name}: cleared stale pidfile (pid {Stdlib.Int.toString pid} was not running)"


// ── launch ──

// The executable to re-invoke for the detached child -- the `dark` binary currently running. No env var:
// `getCurrentExecutablePath` is what the installer already uses to find itself.
let launcher () : String =
  Stdlib.Cli.Sys.currentExecutablePath ()


// Spawn `dark <args...>` DETACHED so it survives this process exiting: `nohup … &` backgrounds it
// + shields it from hangups, the launching `sh -c` returns immediately, and the child reparents to
// init. Output appends to the daemon's logfile. The entrypoint must `claimPidfile name` first. A
// command rather than an expression: a command runs in the CLI's own host state, which an `eval`
// guest does not get, and a daemon needs the host's capabilities (the sync transport).
let launchDetachedWith (name: String) (args: List<String>) : Stdlib.Result.Result<Unit, String> =
  // Create the run dir up front: the shell redirect below (and the pidfile) need it to exist, and
  // `claimPidfile` only mkdirs it from inside the child -- too late for this redirect on a fresh machine.
  let _ = Posix.mkdirRecursive (runDirForWriting ())

  let quoted =
    args
    |> Stdlib.List.map (fun a -> "'" ++ (Stdlib.String.replaceAll a "'" "'\\''") ++ "'")
    |> Stdlib.String.join " "

  let cmd =
    $"nohup {launcher ()} {quoted} >> {logPath name} 2>&1 &"

  match Process.exec "/bin/sh" [ "-c", cmd ] with
  | Ok _ -> Stdlib.Result.Result.Ok()
  | Error e -> Stdlib.Result.Result.Error $"failed to launch {name}: {e}"


// Poll `isRunning` every 100ms up to `tries` times, returning the live pid once the daemon claims its
// pidfile, or an error (with the last log line) if it never comes up.
let waitUntilRunning
  (name: String)
  (tries: Int)
  : Stdlib.Result.Result<Int, String> =
  if tries <= 0 then
    let hint =
      match tailLog name 1 with
      | [ line ] -> $" (last log: {line})"
      | _ -> ""

    Stdlib.Result.Result.Error $"{name} did not come up{hint}"
  else
    match recordedPid name with
    | Some pid ->
      if Posix.isProcessRunning pid then
        Stdlib.Result.Result.Ok pid
      else
        let _ = Posix.sleep 100.0
        waitUntilRunning name (tries - 1)
    | None ->
      let _ = Posix.sleep 100.0
      waitUntilRunning name (tries - 1)


// Launch a named daemon detached, running `dark <args...>`, then VERIFY it actually came up:
// returns the live pid or an error if it never claimed its pidfile (instead of falsely reporting
// success the instant the shell forks). Refuses if it's already running.
let startWith (name: String) (args: List<String>) : Stdlib.Result.Result<Int, String> =
  if isRunning name then
    Stdlib.Result.Result.Error $"{name} is already running (see `status`)"
  else
    match launchDetachedWith name args with
    | Error e -> Stdlib.Result.Result.Error e
    | Ok _ -> waitUntilRunning name 20
