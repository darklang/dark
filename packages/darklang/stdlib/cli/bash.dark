module Darklang.Stdlib.Cli.Bash


/// Read the content of .bashrc file
let readBashrc(): Result.Result<String, String> =
  (Stdlib.Cli.FileSystem.readFile("$HOME/.bashrc"))
  |> Result.map(Stdlib.Utf8.decodeWithReplacement)
  |> Result.mapError(Stdlib.Cli.FileSystem.FileError.toString)

/// A program cannot change the shell that started it, so after editing .bashrc
/// the user has to source it themselves.
let printSourceHint(): Unit =
  Stdlib.printLine(
    "Changes have been made to your .bashrc file.\nTo apply them to your current terminal session, run:\n  source ~/.bashrc")


/// Write content to .bashrc file
let overwriteBashrc(content: String): Result.Result<Unit, String> =
  (FileSystem.overwriteFile("$HOME/.bashrc", Stdlib.Utf8.encode(content)))
  |> Result.mapError(FileSystem.FileError.toString)


/// Delete an alias from .bashrc
let deleteAlias(alias: String): Result.Result<Unit, String> =
  (readBashrc())
  |> Result.andThen(fun content ->
    let updatedContent =
      content
      |> String.split("\n")
      |> List.filter(fun line ->
        Bool.not(String.contains(line, $"alias {alias}=")))
      |> String.join("\n")

    overwriteBashrc(updatedContent))


/// Add an alias to .bashrc
let addAlias(
  alias: String,
  command: String)
  : Result.Result<Unit, String> =
  let aliasDefinition = $"alias {alias}='{command}'"

  match readBashrc() with
  | Ok(content) ->
    let updatedContent = content + "\n" + aliasDefinition

    match overwriteBashrc(updatedContent) with
    | Ok(()) ->
      printSourceHint()
      Result.Result.Ok()
    | Error(e) -> Result.Result.Error(e)
  | Error(e) -> Result.Result.Error(e)


/// Add a directory to PATH in .bashrc
let addToPath(dir: String): Result.Result<Unit, String> =
  let exportLine = $"export PATH=\"{dir}:$PATH\""

  // A missing rc file is an empty one: a fresh account often has none, and refusing here used to
  // fail an install after the binary was already in place.
  let existing =
    if Stdlib.Cli.FileSystem.pathExists("$HOME/.bashrc") then readBashrc()
    else Result.Result.Ok("")

  match existing with
  | Ok(content) ->
    // Check if PATH export for this dir already exists (not just any reference to the dir)
    if String.contains(content, exportLine) then
      Result.Result.Ok()
    else
      let updatedContent = content + "\n" + exportLine

      match overwriteBashrc(updatedContent) with
      | Ok(()) ->
        printSourceHint()
        Result.Result.Ok()
      | Error(e) -> Result.Result.Error(e)
  | Error(e) -> Result.Result.Error(e)