module Darklang.Stdlib.Cli.Sys

/// Get the current user's login name.
/// Checks $LOGNAME, then $USER, then falls back to the passwd database.
let currentUser(): Option<String> =
  match Env.get("LOGNAME") with
  | Some(u) -> Option.Some(u)
  | None ->
    match Env.get("USER") with
    | Some(u) -> Option.Some(u)
    | None -> Posix.__accountLookup(Posix.__decimal(Builtin.syscallGetuid()), 0)


/// Get the system hostname.
let hostname(): Result<String, Posix.Error> =
  Posix.uname() |> Result.map(fun result -> Tuple3.second(result))


/// Get the operating system name (e.g. "Linux", "Darwin").
let os(): Result<String, Posix.Error> =
  Posix.uname() |> Result.map(fun result -> Tuple3.first(result))


/// Get the CPU architecture (e.g. "x86_64", "aarch64").
let arch(): Result<String, Posix.Error> =
  Posix.uname() |> Result.map(fun result -> Tuple3.third(result))


/// The path of the running executable.
let currentExecutablePath(): String =
  Builtin.runtimeExecutablePath()


/// Get the number of available CPUs.
let cpuCount(): Int64 =
  __cpuCount() |> Builtin.unwrap


/// Get the current process ID.
let currentPid(): Int64 =
  Builtin.syscallGetpid()


/// isatty for 0 (stdin), 1 (stdout) or 2 (stderr).
let isTerminal(fd: Int64): Bool =
  Builtin.cliTerminalIsatty(fd)


/// Check if the current user is root (uid 0).
let isRoot(): Bool =
  Builtin.syscallGetuid() == 0


/// Host record selection, buffer growth and decoding shared by both engines.
let __text(buffer: Bytes, offset: Int64, length: Int64): String =
  let field = Bytes.take(Bytes.drop(buffer, offset), length)
  let text =
    match Bytes.indexOf(field, 0u8) with
    | Some(nul) -> Bytes.take(field, nul)
    | None -> field

  Utf8.decodeWithReplacement(text)


let __sysctlWith(mib: List<Int64>, count: Int64): Result<Bytes, Int64> =
  match Builtin.syscallSysctl(mib, count) with
  | Error(e) ->
    if e == 4 then
      __sysctlWith(mib, count)
    else if e == 12 && count < 1048576 then
      __sysctlWith(mib, count * 2)
    else
      Result.Error(e)
  | Ok(bytes) -> Result.Ok(bytes)


let __sysctlText(mib: List<Int64>): Result<String, Int64> =
  __sysctlWith(mib, 256) |> Result.map(fun bytes -> __text(bytes, 0, Bytes.length(bytes)))


let __countBits(value: Int64): Int64 =
  if value == 0 then
    0
  else
    (Int64.checkedMod(value, 2) |> Result.withDefault(0))
    + __countBits(Int64.checkedDivide(value, 2) |> Result.withDefault(0))


let __affinityWith(count: Int64): Result<Bytes, Int64> =
  match Builtin.syscallSchedGetaffinity(0, count) with
  | Error(e) ->
    if e == 4 then
      __affinityWith(count)
    else if e == 22 && count < 1048576 then
      __affinityWith(count * 2)
    else
      Result.Error(e)
  | Ok(mask) -> Result.Ok(mask)


/// Available CPUs means the calling process's affinity on Linux, hw.ncpu on
/// Darwin, and one on the interpreter's single-threaded browser runtime.
let __cpuCount(): Result<Int64, Int64> =
  let result =
    if Builtin.runtimeTargetOS() == "browser" then
      Result.Ok(1)
    else if Posix.__abiMac() then
      __sysctlWith([ 6, 3 ], 4) |> Result.andThen(fun bytes -> Posix.__kernelField(bytes, 0, 4))
    else
      __affinityWith(128)
      |> Result.map(fun bytes ->
        List.fold(Bytes.toList(bytes), 0, fun(total, byte) ->
          total + __countBits(Int64.fromUInt8(byte))))

  result |> Result.andThen(fun count -> if count > 0 then Result.Ok(count) else Result.Error(5))
