/// Kernel primitives shared by the interpreter and native compiler.
/// Each operation attempts one syscall, returning its result or numeric errno.
/// No retries, complete-I/O loops, text decoding, or error rendering occur here.
/// Descriptors are owned by the caller; close consumes that ownership even if
/// the kernel reports an error. Never retry close after EINTR.
module Darklang.Stdlib.Cli.Syscall

let inotifyInit1 (flags: Int) : Result.Result<Int, Int> = Builtin.syscallInotifyInit1 flags
let inotifyAddWatch (fd: Int) (path: String) (mask: Int) : Result.Result<Int, Int> =
  Builtin.syscallInotifyAddWatch fd path mask
let ppoll (descriptors: List<(Int * Int)>) (timeoutMs: Int) : Result.Result<Blob, Int> =
  Builtin.syscallPpoll descriptors timeoutMs
let pollDarwin (descriptors: List<(Int * Int)>) (timeoutMs: Int) : Result.Result<Blob, Int> =
  Builtin.syscallPollDarwin descriptors timeoutMs

let clockGettime (clock: Int) : Result.Result<Blob, Int> = Builtin.syscallClockGettime clock
let gettimeofday () : Result.Result<Blob, Int> = Builtin.syscallGettimeofday ()
let machAbsoluteTime () : Result.Result<Blob, Int> = Builtin.syscallMachAbsoluteTime ()
let machTimebaseInfo () : Result.Result<Blob, Int> = Builtin.syscallMachTimebaseInfo ()
let nanosleep (seconds: Int) (nanos: Int) : (Int * Blob) = Builtin.syscallNanosleep seconds nanos

let getcwd (count: Int) : Result.Result<Blob, Int> = Builtin.syscallGetcwd count
let fcntlGetPath (fd: Int) : Result.Result<Blob, Int> = Builtin.syscallFcntlGetPath fd

let utimensAt (path: String) (accessSeconds: Int) (accessNanos: Int)
  (modifySeconds: Int) (modifyNanos: Int) : Result.Result<Unit, Int> =
  Builtin.syscallUtimensAt path accessSeconds accessNanos modifySeconds modifyNanos

let setattrlistTimes (path: String) (accessSeconds: Int) (accessNanos: Int)
  (modifySeconds: Int) (modifyNanos: Int) : Result.Result<Unit, Int> =
  Builtin.syscallSetattrlistTimes path accessSeconds accessNanos modifySeconds modifyNanos

/// One entropy call, up to 256 bytes. May return fewer bytes or EINTR.
let getentropy (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallGetentropy count

let read (fd: Int) (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallRead fd count

let write (fd: Int) (bytes: Blob) : Result.Result<Int, Int> =
  Builtin.syscallWrite fd bytes

let close (fd: Int) : Result.Result<Unit, Int> =
  Builtin.syscallClose fd

let lseek (fd: Int) (offset: Int) (whence: Int) : Result.Result<Int, Int> =
  Builtin.syscallLseek fd offset whence

let flock (fd: Int) (operation: Int) : Result.Result<Unit, Int> =
  Builtin.syscallFlock fd operation

let kill (pid: Int) (signal: Int) : Result.Result<Unit, Int> =
  Builtin.syscallKill pid signal

let getpid () : Int = Builtin.syscallGetpid ()

let getuid () : Int = Builtin.syscallGetuid ()

let uname () : Result.Result<Blob, Int> = Builtin.syscallUname ()

/// Read-only sysctl query. Unknown keys require Native in the interpreter.
let sysctl (mib: List<Int>) (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallSysctl mib count

/// Kernel affinity mask, not a decoded CPU count. pid=0 names this process.
let schedGetaffinity (pid: Int) (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallSchedGetaffinity pid count

/// Entry-relative stat after the trusted boundary's no-follow path check.
/// The returned bytes use the target kernel ABI, not libc's struct stat.
let statAt (path: String) : Result.Result<Blob, Int> =
  Builtin.syscallStatAt path

let getdents (fd: Int) (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallGetdents fd count

let copyFileRange (source: Int) (destination: Int) (count: Int)
  : Result.Result<Int, Int> =
  Builtin.syscallCopyFileRange source destination count

let cloneFile (source: Int) (destination: Int) : Result.Result<Unit, Int> =
  Builtin.syscallCloneFile source destination

let ftruncate (fd: Int) (length: Int) : Result.Result<Unit, Int> =
  Builtin.syscallFtruncate fd length

let fchmod (fd: Int) (mode: Int) : Result.Result<Unit, Int> =
  Builtin.syscallFchmod fd mode

let fsync (fd: Int) : Result.Result<Unit, Int> = Builtin.syscallFsync fd

let fstat (fd: Int) : Result.Result<Blob, Int> = Builtin.syscallFstat fd

let pread (fd: Int) (count: Int) (offset: Int) : Result.Result<Blob, Int> =
  Builtin.syscallPread fd count offset

let pwrite (fd: Int) (bytes: Blob) (offset: Int) : Result.Result<Int, Int> =
  Builtin.syscallPwrite fd bytes offset

/// One operation after checked no-follow path resolution.
let open (path: String) (flags: Int) (mode: Int) : Result.Result<Int, Int> =
  Builtin.syscallOpen path flags mode

/// One operation after checked no-follow path resolution.
let mkdir (path: String) (mode: Int) : Result.Result<Unit, Int> =
  Builtin.syscallMkdir path mode

let unlinkAt (path: String) (flags: Int) : Result.Result<Unit, Int> =
  Builtin.syscallUnlinkAt path flags

/// One operation after checked no-follow path resolution.
let chdir (path: String) : Result.Result<Unit, Int> =
  Builtin.syscallChdir path

/// One operation after checked no-follow path resolution.
let rename (oldpath: String) (newpath: String) : Result.Result<Unit, Int> =
  Builtin.syscallRename oldpath newpath

/// One operation after checked no-follow path resolution.
let chmod (path: String) (mode: Int) : Result.Result<Unit, Int> =
  Builtin.syscallChmod path mode

/// One operation after checked no-follow path resolution.
let symlink (target: String) (linkpath: String) : Result.Result<Unit, Int> =
  Builtin.syscallSymlink target linkpath

/// Read raw symlink bytes once; a full buffer may mean truncation.
let readlinkAt (path: String) (count: Int) : Result.Result<Blob, Int> =
  Builtin.syscallReadlinkAt path count
