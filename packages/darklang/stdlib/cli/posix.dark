/// Posix wrappers for filesystem, process, and system operations.
/// Linux (x86_64, aarch64, armv7) and macOS only. Will not work on Windows.
module Darklang.Stdlib.Cli.Posix


/// Structured error from posix operations, carrying the errno code.
type Error =
  { errno: Int
    message: String }

/// Result of a stat() call.
type StatResult =
  { mode: Int
    size: Int
    mtimeSec: Int }

/// Standard permission modes
module Modes =
  /// 0755 — owner rwx, group rx, others rx
  val defaultDir = 493

  /// 0644 — owner rw, group r, others r
  val defaultFile = 420


// -- Open flags ---------------------------------------------------
module OpenFlags =
  let rdonly () : Int = 0
  let wronly () : Int = 1
  let rdwr () : Int = 2
  let creat () : Int = Stdlib.Cli.KernelABI.openCreate ()
  let trunc () : Int = Stdlib.Cli.KernelABI.openTruncate ()
  let append () : Int = Stdlib.Cli.KernelABI.openAppend ()


/// Open a file. Returns a file descriptor.
let openFile (path: String) (flags: Int) (mode: Int) : Result.Result<Int, Error> =
  Syscall.open path flags mode
  |> Stdlib.Result.mapError Errors.fromErrno


/// Read up to `count` bytes from an open file descriptor.
let fdRead (fd: Int) (count: Int) : Result.Result<Blob, Error> =
  Syscall.read fd count
  |> Stdlib.Result.mapError Errors.fromErrno


/// Write <param bytes> to an open file descriptor. Returns the number
/// of bytes written.
let fdWrite (fd: Int) (bytes: Blob) : Result.Result<Int, Error> =
  IO.writeAll (fun chunk -> Syscall.write fd chunk |> Stdlib.Result.mapError Errors.fromErrno) bytes 0


/// Close an open file descriptor.
let fdClose (fd: Int) : Result.Result<Unit, Error> =
  Syscall.close fd
  |> Stdlib.Result.mapError Errors.fromErrno


/// Read all bytes from a file descriptor until EOF.
/// Accumulates chunks (as Blobs) and concats once at EOF.
let fdReadAll
  (fd: Int)
  (acc: List<Blob>)
  : Result.Result<Blob, Error> =
  (fdRead fd 4096)
  |> Stdlib.Result.andThen (fun chunk ->
    if Stdlib.Blob.length chunk == 0 then
      Stdlib.Result.Result.Ok(Stdlib.Blob.concat acc)
    else
      fdReadAll fd (Stdlib.List.append acc [ chunk ]))


/// Seek to a byte offset from the start of an open file.
let fdSeekFromStart (fd: Int) (offset: Int) : Result.Result<Int, Error> =
  Syscall.lseek fd offset 0
  |> Stdlib.Result.mapError Errors.fromErrno


/// Stat a file. Returns mode, size, and modification time.
let stat (path: String) : Result.Result<StatResult, Error> =
  Syscall.statAt path
  |> Stdlib.Result.andThen KernelData.metadata
  |> Stdlib.Result.mapError Errors.fromErrno
  |> Stdlib.Result.map (fun metadata ->
    StatResult { mode = metadata.mode; size = metadata.size
                 mtimeSec = metadata.mtimeSec })

/// Get the current working directory
let getCwd () : Result.Result<String, Error> =
  Builtin.posixGetcwd ()
  |> Errors.normalize

/// Change the current working directory
let chdir (path: String) : Result.Result<Unit, Error> =
  Syscall.chdir path
  |> Stdlib.Result.mapError Errors.fromErrno

/// Create a directory
let mkdir (path: String) (mode: Int) : Result.Result<Unit, Error> =
  Syscall.mkdir path mode
  |> Stdlib.Result.mapError Errors.fromErrno

/// Remove an empty directory
let rmdir (path: String) : Result.Result<Unit, Error> =
  Syscall.unlinkAt path (KernelABI.removeDirectory ())
  |> Stdlib.Result.mapError Errors.fromErrno

/// Remove a file
let unlink (path: String) : Result.Result<Unit, Error> =
  Syscall.unlinkAt path 0
  |> Stdlib.Result.mapError Errors.fromErrno

/// Rename/move a file or directory
let rename (oldpath: String) (newpath: String) : Result.Result<Unit, Error> =
  Syscall.rename oldpath newpath
  |> Stdlib.Result.mapError Errors.fromErrno

/// Change file permissions
let chmod (path: String) (mode: Int) : Result.Result<Unit, Error> =
  Syscall.chmod path mode
  |> Stdlib.Result.mapError Errors.fromErrno

/// Update atime and mtime to now.
let utimesNow (path: String) : Result.Result<Unit, Error> =
  Builtin.posixUtimesNow path
  |> Errors.normalize

/// Create a symbolic link
let symlink (target: String) (linkpath: String) : Result.Result<Unit, Error> =
  Syscall.symlink target linkpath
  |> Stdlib.Result.mapError Errors.fromErrno

/// Read the target of a symbolic link
let readlink (path: String) : Result.Result<String, Error> =
  Builtin.posixReadlink path
  |> Errors.normalize

/// Check if a path is a symbolic link.
/// Uses readlink — returns Ok true/false, or Error on permission/other failures.
/// readlink returns EINVAL when the target is not a symlink.
let isSymlink (path: String) : Result.Result<Bool, Error> =
  match readlink path with
  | Ok _ -> Stdlib.Result.Result.Ok true
  | Error e ->
    if e.errno == Errno.einval then
      Stdlib.Result.Result.Ok false
    else
      Stdlib.Result.Result.Error e


/// Create a unique temporary file. Returns (fd, path).
let mkstemp (prefix: String) : Result.Result<(Int * String), Error> =
  Temp.file prefix

/// Create a unique temporary directory. Returns the path.
let mkdtemp (prefix: String) : Result.Result<String, Error> =
  Temp.directory prefix

/// Match a string against a glob pattern.
/// If pathMode is true, * does not match /
let flock (fd: Int) (exclusive: Bool) : Result.Result<Unit, Error> =
  Syscall.flock fd (if exclusive then 2 else 8)
  |> Stdlib.Result.mapError Errors.fromErrno

/// Get the owner username of a file.
let fileOwner (path: String) : Result.Result<String, Error> =
  Syscall.statAt path
  |> Stdlib.Result.andThen KernelData.metadata
  |> Stdlib.Result.mapError Errors.fromErrno
  |> Stdlib.Result.map (fun metadata ->
    let uid = Stdlib.Int.toString metadata.uid
    match Accounts.lookup uid 0 with
    | Some name -> name
    | None -> uid)

/// List entries in a directory (filenames only, no "." or "..")
let listDir (path: String) : Result.Result<List<String>, Error> =
  DirectoryIO.list path

/// Get an environment variable
let getenv (name: String) : Stdlib.Option.Option<String> =
  Stdlib.Env.get name


/// System name info: (sysname, nodename, machine).
let uname () : Result.Result<(String * String * String), Error> =
  Builtin.posixUname ()
  |> Errors.normalize


/// Send a signal to a process
let kill (pid: Int) (signal: Int) : Result.Result<Unit, Error> =
  Syscall.kill pid signal
  |> Stdlib.Result.mapError Errors.fromErrno

val sigterm = 15
val sigkill = 9
val sigint = 2

/// Common errno values (Linux/macOS)
module Errno =
  /// Invalid argument
  val einval = 22

  /// No such process
  val esrch = 3

  /// Operation not permitted
  val eperm = 1

  /// No such file or directory: a parent component is missing
  val enoent = 2

  /// File exists
  val eexist = 17


/// Stat file-type mask and constants
module StatMode =
  /// S_IFMT — bitmask for the file type fields
  val ifmt = 61440

  /// S_IFDIR — directory
  val ifdir = 16384


/// Sleep for the given number of milliseconds.
let sleep (delayMs: Float) : Unit =
  Builtin.timeSleep delayMs


/// Check if a path is a directory via stat().
/// Returns false if the path doesn't exist or is not a directory.
let isDirectory (path: String) : Bool =
  match stat path with
  | Ok result ->
    (result.mode & StatMode.ifmt) == StatMode.ifdir
  | Error _ -> false


/// Check if a process is running via kill(pid, 0).
/// Signal 0 checks process existence without sending a signal.
let isProcessRunning (pid: Int) : Bool =
  match kill pid 0 with
  | Ok _ -> true
  | Error e ->
    // EPERM means the process exists but we lack permission to signal it
    if e.errno == Errno.eperm then true
    else false


/// Create a directory and all missing parents (like mkdir -p).
///
/// Tries the target first and walks to its parent only on ENOENT. This avoids
/// issuing mutating mkdir operations for every existing ancestor, some of
/// which may protect host-owned state.
let mkdirRecursive (path: String) : Result.Result<Unit, Error> =
  let target = Path.stripTrailing path
  match mkdir target Modes.defaultDir with
  | Ok () -> Stdlib.Result.Result.Ok()
  | Error e ->
    if e.errno == Errno.eexist then
      // Something is there already; only a directory satisfies mkdir -p.
      if isDirectory target then Stdlib.Result.Result.Ok()
      else Stdlib.Result.Result.Error e
    else if e.errno == Errno.enoent then
      let parent = Path.parent target
      if parent == target || parent == "." || parent == "/" then
        Stdlib.Result.Result.Error e
      else
        match mkdirRecursive parent with
        | Error parentError -> Stdlib.Result.Result.Error parentError
        | Ok () ->
          match mkdir target Modes.defaultDir with
          | Ok () -> Stdlib.Result.Result.Ok()
          | Error again ->
            // Lost a race to something that created it meanwhile.
            if again.errno == Errno.eexist && isDirectory target then
              Stdlib.Result.Result.Ok()
            else
              Stdlib.Result.Result.Error again
    else
      Stdlib.Result.Result.Error e
