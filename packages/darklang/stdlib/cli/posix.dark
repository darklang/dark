let __fromErrno(errno: Int64): Error =
  let message =
    if __abiMac() then
      __macMessage(errno)
    else if errno == 1 then
      "Operation not permitted"
    else if errno == 2 then
      "No such file or directory"
    else if errno == 3 then
      "No such process"
    else if errno == 4 then
      "Interrupted system call"
    else if errno == 5 then
      "Input/output error"
    else if errno == 6 then
      "No such device or address"
    else if errno == 7 then
      "Argument list too long"
    else if errno == 8 then
