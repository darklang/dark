      "Memory page has hardware error"
    else
      String.append("Unknown error ", __decimal(errno))

  Error { errno = errno, message = message }


/// Complete a descriptor write when the kernel accepts only part of a buffer.
let __writeAll(
  write: Bytes -> Result<Int64, Error>,
  bytes: Bytes,
  written: Int64)
  : Result<Int64, Error> =
  let length = Bytes.length(bytes)
  if length == 0 then
    Result.Ok(written)
  else
    match write(bytes) with
    | Error(error) ->
      if error.errno == 4 then
        __writeAll(write, bytes, written)
      else
        Result.Error(error)
    | Ok(count) ->
      if count <= 0 || count > length then
        Result.Error(Error { errno = 5, message = "write made invalid progress" })
      else if count == length then
        Result.Ok(written + count)
      else
        let rest = Bytes.drop(bytes, count)
        __writeAll(write, rest, written + count)


/// Account-file parsing ported from the compiler's Cli.Env implementation.
let __accountFieldFromPasswd(lines: List<String>, uid: String, index: Int64): Option<String> =
  match lines with
  | [] -> Option.None
  | [line, ...rest] ->
    let fields = String.split(line, ":")
    match List.getAt(fields, 2), List.getAt(fields, index) with
    | Some(candidateUid), Some(value) ->
      if candidateUid == uid then
        Option.Some(value)
      else
        __accountFieldFromPasswd(rest, uid, index)
    | _ -> __accountFieldFromPasswd(rest, uid, index)


/// Reading the fixed account file uses the ordinary checked filesystem boundary.
let __accountLookup(uid: String, index: Int64): Option<String> =
  match FileSystem.readFileAsString("/etc/passwd") with
  | Ok(contents) -> __accountFieldFromPasswd(String.splitOnNewline(contents), uid, index)
  | Error(_) -> Option.None


/// Collision retries for exclusive temporary-entry creation.
let __tempEntropy(remaining: Int64, reversed: List<Bytes>): Result<Bytes, Int64> =
  if remaining == 0 then
    Result.Ok(Bytes.concatAll(List.reverse(reversed)))
  else
    match Builtin.syscallGetentropy(remaining) with
    | Error(e) -> if e == 4 then __tempEntropy(remaining, reversed) else Result.Error(e)
    | Ok(bytes) ->
      let count = Bytes.length(bytes)
      if count <= 0 || count > remaining then
        Result.Error(5)
      else
        __tempEntropy(remaining - count, List.prepend(reversed, bytes))


let __tempCandidate(prefix: String): Result<String, Error> =
  __tempEntropy(12, [])
  |> Result.mapError(__fromErrno)
  |> Result.map(fun bytes -> String.append(prefix, Base16.encode(bytes)))


let __tempRetry(create: Int64 -> Result<'a, Error>, remaining: Int64): Result<'a, Error> =
  match create(remaining) with
  | Error(error) ->
    if error.errno == 17 && remaining > 0 then
      __tempRetry(create, remaining - 1)
    else
      Result.Error(error)
  | Ok(value) -> Result.Ok(value)


/// Suffix creation and collision policy are shared Dark algorithms. O_EXCL is
/// what makes creation safe; randomness alone does not protect against races.
let __tempFile(prefix: String): Result<(BigInt * String), Error> =
  __tempRetry(
    (fun _ ->
       __tempCandidate(prefix)
       |> Result.andThen(fun path ->
         let flags = 2 | __abiOpenCreate() | __abiOpenExclusive()
         openFile(path, flags, 384) |> Result.map(fun fd -> (fd, path)))),
    100)


let __tempDirectory(prefix: String): Result<String, Error> =
  __tempRetry(
    (fun _ ->
       __tempCandidate(prefix)
       |> Result.andThen(fun path -> mkdir(path, 448) |> Result.map(fun _ -> path))),
    100)


let __uname(): Result<(String * String * String), Error> =
  let result =
    if Builtin.runtimeTargetOS() == "browser" then
      Result.Ok(("Browser", "browser", "wasm32"))
    else if __abiMac() then
      Sys.__sysctlText([ 1, 1 ])
      |> Result.andThen(fun os ->
        Sys.__sysctlText([ 1, 10 ])
        |> Result.andThen(fun host ->
          Sys.__sysctlText([ 6, 1 ]) |> Result.map(fun machine -> (os, host, machine))))
    else
      Builtin.syscallUname()
      |> Result.andThen(fun bytes ->
        if Bytes.length(bytes) < 390 then
          Result.Error(5)
        else
          Result.Ok(
            (Sys.__text(bytes, 0, 65), Sys.__text(bytes, 65, 65), Sys.__text(bytes, 260, 65))))

  result |> Result.mapError(__fromErrno)
