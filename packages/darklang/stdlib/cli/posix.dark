/// Posix wrappers for filesystem, process, and system operations.
/// Linux (x86_64, aarch64, armv7) and macOS only. Will not work on Windows.
module Darklang.Stdlib.Cli.Posix


/// Structured error from posix operations, carrying the errno code.
type Error =
  { errno: Int64
    message: String }

/// Result of a stat() call.
type StatResult =
  { mode: Int64
    size: Int64
    mtimeSec: Int64 }

/// A process ID, 1 to 2147483647. Build one with <fn Pid.fromInt64>; the field is not for
/// constructing directly. 0 and the negative numbers `kill(2)` reads as process groups are
/// not process IDs, so they are refused here.
type Pid = { __pid: Int64 }

module Pid =
  /// Returns {{Ok}} the process ID <param n>, or {{Error}} an
  /// <type Stdlib.Math.OutOfRange> if it is not between 1 and 2147483647.
  let fromInt64(n: Int64): Result.Result<Stdlib.Cli.Posix.Pid, Stdlib.Math.OutOfRange> =
    Stdlib.Math.__inRange("process ID", 1, 2147483647, n, fun v -> Stdlib.Cli.Posix.Pid { __pid = v })

  /// The number of <param pid>
  let toInt64(pid: Stdlib.Cli.Posix.Pid): Int64 = pid.__pid

impl Display for Pid =
  /// The process ID, {{4242}}
  let display(pid: Pid): String = Stdlib.display(pid.__pid)

impl Inspect for Pid =
  /// {{Pid(4242)}}: the field is private, so not the record
  let inspect(pid: Pid): String = $"Pid({pid.__pid})"


/// A process exit status, 0 to 255. Build one with <fn ExitCode.fromInt64>, or name one
/// (<val ExitCode.success>); the field is not for constructing directly.
type ExitCode = { __exitCode: Int64 }

module ExitCode =
  /// Returns {{Ok}} the exit status <param n>, or {{Error}} an
  /// <type Stdlib.Math.OutOfRange> if it is not between 0 and 255.
  let fromInt64(n: Int64): Result.Result<Stdlib.Cli.Posix.ExitCode, Stdlib.Math.OutOfRange> =
    Stdlib.Math.__inRange("exit code", 0, 255, n, fun v -> Stdlib.Cli.Posix.ExitCode { __exitCode = v })

  /// The number of <param code>
  let toInt64(code: Stdlib.Cli.Posix.ExitCode): Int64 = code.__exitCode

  /// 0
  val success = Stdlib.Cli.Posix.ExitCode { __exitCode = 0 }

  /// 1
  val failure = Stdlib.Cli.Posix.ExitCode { __exitCode = 1 }

  /// Returns {{true}} for 0
  let isSuccess(code: Stdlib.Cli.Posix.ExitCode): Bool = code.__exitCode == 0

impl Display for ExitCode =
  /// The exit status, {{1}}
  let display(code: ExitCode): String = Stdlib.display(code.__exitCode)

impl Inspect for ExitCode =
  /// {{ExitCode(1)}}: the field is private, so not the record
  let inspect(code: ExitCode): String = $"ExitCode({code.__exitCode})"


/// Standard permission modes
module Modes =
  /// 0755 — owner rwx, group rx, others rx
  val defaultDir = 493

  /// 0644 — owner rw, group r, others r
  val defaultFile = 420


// -- Open flags ---------------------------------------------------
module OpenFlags =
  let rdonly(): Int64 = 0
  let wronly(): Int64 = 1
  let rdwr(): Int64 = 2
  let creat(): Int64 = Stdlib.Cli.Posix.__abiOpenCreate()
  let trunc(): Int64 = Stdlib.Cli.Posix.__abiOpenTruncate()
  let append(): Int64 = Stdlib.Cli.Posix.__abiOpenAppend()


/// Open a file. Returns a file descriptor.
let openFile(path: String, flags: Int64, mode: Int64): Result.Result<BigInt, Error> =
  Builtin.syscallOpen(path, flags, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Read up to `count` bytes from an open file descriptor.
let fdRead(fd: BigInt, count: Int64): Result.Result<Bytes, Error> =
  Builtin.syscallRead(fd, count)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Write <param bytes> to an open file descriptor. Returns the number
/// of bytes written.
let fdWrite(fd: BigInt, bytes: Bytes): Result.Result<Int64, Error> =
  Stdlib.Cli.Posix.__writeAll((fun chunk -> Builtin.syscallWrite(fd, chunk) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)), bytes, 0)


/// Close an open file descriptor.
let fdClose(fd: BigInt): Result.Result<Unit, Error> =
  Builtin.syscallClose(fd)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Read all bytes from a file descriptor until EOF.
/// Accumulates chunks (as Bytes) and concats once at EOF.
let fdReadAll(
  fd: BigInt,
  acc: List<Bytes>)
  : Result.Result<Bytes, Error> =
  (fdRead(fd, 4096))
  |> Stdlib.Result.andThen(fun chunk ->
    if Stdlib.Bytes.length(chunk) == 0 then
      Stdlib.Result.Result.Ok(Stdlib.Bytes.concatAll(acc))
    else
      fdReadAll(fd, Stdlib.List.append(acc, chunk)))


/// Seek to a byte offset from the start of an open file.
let fdSeekFromStart(fd: BigInt, offset: Int64): Result.Result<Int64, Error> =
  Builtin.syscallLseek(fd, offset, 0)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Stat a file. Returns mode, size, and modification time.
let stat(path: String): Result.Result<StatResult, Error> =
  Builtin.syscallStatAt(path)
  |> Stdlib.Result.andThen(Stdlib.Cli.Posix.__kernelMetadata)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
  |> Stdlib.Result.map(fun metadata ->
    StatResult { mode = metadata.mode, size = metadata.size
                 mtimeSec = metadata.mtimeSec })

/// Get the current working directory
let getCwd(): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__pathGetCwd()

/// Change the current working directory
let chdir(path: String): Result.Result<Unit, Error> =
  Builtin.syscallChdir(path)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Create a directory
let mkdir(path: String, mode: Int64): Result.Result<Unit, Error> =
  Builtin.syscallMkdir(path, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Remove an empty directory
let rmdir(path: String): Result.Result<Unit, Error> =
  Builtin.syscallUnlinkAt(path, Stdlib.Cli.Posix.__abiRemoveDirectory())
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Remove a file
let unlink(path: String): Result.Result<Unit, Error> =
  Builtin.syscallUnlinkAt(path, 0)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Rename/move a file or directory
let rename(oldpath: String, newpath: String): Result.Result<Unit, Error> =
  Builtin.syscallRename(oldpath, newpath)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Change file permissions
let chmod(path: String, mode: Int64): Result.Result<Unit, Error> =
  Builtin.syscallChmod(path, mode)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Update atime and mtime to now.
let utimesNow(path: String): Result.Result<Unit, Error> =
  let result =
    if Stdlib.Cli.Posix.__abiMac() then
      let seconds = Stdlib.DateTime.toSeconds(Stdlib.DateTime.now())
      Builtin.syscallSetattrlistTimes(path, seconds, 0, seconds, 0)
    else Builtin.syscallUtimensAt(path, 0, 1073741823, 0, 1073741823)
  result |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Create a symbolic link
let symlink(target: String, linkpath: String): Result.Result<Unit, Error> =
  Builtin.syscallSymlink(target, linkpath)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Read the target of a symbolic link
let readlink(path: String): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__pathReadlink(path)

/// Check if a path is a symbolic link.
/// Uses readlink — returns Ok true/false, or Error on permission/other failures.
/// readlink returns EINVAL when the target is not a symlink.
let isSymlink(path: String): Result.Result<Bool, Error> =
  match readlink(path) with
  | Ok(_) -> Stdlib.Result.Result.Ok(true)
  | Error(e) ->
    if e.errno == Errno.einval then
      Stdlib.Result.Result.Ok(false)
    else
      Stdlib.Result.Result.Error(e)


/// Create a unique temporary file. Returns (fd, path).
let mkstemp(prefix: String): Result.Result<(BigInt * String), Error> =
  Stdlib.Cli.Posix.__tempFile(prefix)

/// Create a unique temporary directory. Returns the path.
let mkdtemp(prefix: String): Result.Result<String, Error> =
  Stdlib.Cli.Posix.__tempDirectory(prefix)

/// What <fn flock> does to a file's lock.
type Lock =
  /// Take the exclusive lock, waiting while another holder has it (LOCK_EX).
  | Exclusive
  /// Let go of the lock this fd holds (LOCK_UN).
  | Unlock

/// Take or release an advisory lock on the open file <param fd>.
let flock(fd: BigInt, lock: Lock): Result.Result<Unit, Error> =
  let operation =
    match lock with
    | Exclusive -> 2
    | Unlock -> 8

  Builtin.syscallFlock(fd, operation)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Get the owner username of a file.
let fileOwner(path: String): Result.Result<String, Error> =
  Builtin.syscallStatAt(path)
  |> Stdlib.Result.andThen(Stdlib.Cli.Posix.__kernelMetadata)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
  |> Stdlib.Result.map(fun metadata ->
    let uid = Stdlib.Cli.Posix.__decimal(metadata.uid)
    match Stdlib.Cli.Posix.__accountLookup(uid, 0) with
    | Some(name) -> name
    | None -> uid)

/// List entries in a directory (filenames only, no "." or "..")
let listDir(path: String): Result.Result<List<String>, Error> =
  Stdlib.Cli.Posix.__directoryList(path)

/// Get an environment variable
let getenv(name: String): Stdlib.Option.Option<String> =
  Stdlib.Env.get(name)


/// System name info: (sysname, nodename, machine).
let uname(): Result.Result<(String * String * String), Error> =
  Stdlib.Cli.Posix.__uname()


/// A signal <fn kill> sends. These are the ones with the same number on Linux and macOS.
type Signal =
  /// The terminal went away (1)
  | SIGHUP
  /// Ctrl-C (2)
  | SIGINT
  /// Quit, and dump core (3)
  | SIGQUIT
  /// Stop now; it cannot be caught or ignored (9)
  | SIGKILL
  /// Please stop; the polite one (15)
  | SIGTERM

module Signal =
  /// The number of <param signal>
  let toInt64(signal: Stdlib.Cli.Posix.Signal): Int64 =
    match signal with
    | SIGHUP -> 1
    | SIGINT -> 2
    | SIGQUIT -> 3
    | SIGKILL -> 9
    | SIGTERM -> 15

impl Display for Signal =
  /// The signal's name, {{SIGTERM}}
  let display(signal: Signal): String =
    match signal with
    | SIGHUP -> "SIGHUP"
    | SIGINT -> "SIGINT"
    | SIGQUIT -> "SIGQUIT"
    | SIGKILL -> "SIGKILL"
    | SIGTERM -> "SIGTERM"

/// Send <param signal> to the process <param pid>
let kill(pid: Pid, signal: Signal): Result.Result<Unit, Error> =
  Builtin.syscallKill(Stdlib.Cli.Posix.Pid.toInt64(pid), Stdlib.Cli.Posix.Signal.toInt64(signal))
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

/// Common errno values (Linux/macOS)
module Errno =
  /// Invalid argument
  val einval = 22

  /// No such process
  val esrch = 3

  /// Operation not permitted
  val eperm = 1

  /// No such file or directory: a parent component is missing
  val enoent = 2

  /// File exists
  val eexist = 17


/// Stat file-type mask and constants
module StatMode =
  /// S_IFMT — bitmask for the file type fields
  val ifmt = 61440

  /// S_IFDIR — directory
  val ifdir = 16384


/// Sleep for the given number of milliseconds.
let sleep(delayMs: Float): Unit =
  Stdlib.DateTime.__sleepMilliseconds(delayMs)


/// Check if a path is a directory via stat().
/// Returns false if the path doesn't exist, is not a directory, or is a symlink (the host refuses
/// to follow one).
let isDirectory(path: String): Bool =
  match isSymlink(path) with
  | Ok(true) -> false
  | _ ->
    match stat(path) with
    | Ok(result) -> (result.mode & StatMode.ifmt) == StatMode.ifdir
    | Error(_) -> false


/// Check if a process is running via kill(pid, 0).
/// Signal 0 checks process existence without sending a signal.
let isProcessRunning(pid: Pid): Bool =
  // EPERM means the process exists but we lack permission to signal it
  match Builtin.syscallKill(Stdlib.Cli.Posix.Pid.toInt64(pid), 0) with
  | Ok(_) -> true
  | Error(errno) -> errno == Errno.eperm


/// Create a directory and all missing parents (like mkdir -p).
///
/// Tries the target first and walks to its parent only on ENOENT. This avoids
/// issuing mutating mkdir operations for every existing ancestor, some of
/// which may protect host-owned state.
let mkdirRecursive(path: String): Result.Result<Unit, Error> =
  let target = Path.stripTrailing(path)
  match mkdir(target, Modes.defaultDir) with
  | Ok(()) -> Stdlib.Result.Result.Ok()
  | Error(e) ->
    if e.errno == Errno.eexist then
      // Something is there already; only a directory satisfies mkdir -p.
      if isDirectory(target) then Stdlib.Result.Result.Ok()
      else Stdlib.Result.Result.Error(e)
    else if e.errno == Errno.enoent then
      let parent = Path.parent(target)
      if parent == target || parent == "." || parent == "/" then
        Stdlib.Result.Result.Error(e)
      else
        match mkdirRecursive(parent) with
        | Error(parentError) -> Stdlib.Result.Result.Error(parentError)
        | Ok(()) ->
          match mkdir(target, Modes.defaultDir) with
          | Ok(()) -> Stdlib.Result.Result.Ok()
          | Error(again) ->
            // Lost a race to something that created it meanwhile.
            if again.errno == Errno.eexist && isDirectory(target) then
              Stdlib.Result.Result.Ok()
            else
              Stdlib.Result.Result.Error(again)
    else
      Stdlib.Result.Result.Error(e)


/// Target kernel constants and structure layouts. These are Dark data, shared
/// by both execution engines, not compiler-host or interpreter-host guesses.

let __abiMac(): Bool = Builtin.runtimeTargetOS() == "darwin"

let __abiX64(): Bool = Builtin.runtimeTargetArchitecture() == "x64"

let __abiArm32(): Bool = Builtin.runtimeTargetArchitecture() == "arm"

let __abiOpenCreate(): Int64 = if __abiMac() then 512 else 64

let __abiOpenTruncate(): Int64 = if __abiMac() then 1024 else 512

let __abiOpenAppend(): Int64 = if __abiMac() then 8 else 1024

let __abiOpenExclusive(): Int64 = if __abiMac() then 2048 else 128

let __abiRemoveDirectory(): Int64 = if __abiMac() then 128 else 512

let __abiOpenDirectory(): Int64 =
  if __abiMac() then 1048576 else if __abiX64() then 65536 else 16384

let __abiStatModeOffset(): Int64 =
  if __abiMac() then 4 else if __abiX64() then 24 else if __abiArm32() then 16 else 16

let __abiStatModeWidth(): Int64 = if __abiMac() then 2 else 4

let __abiStatUidOffset(): Int64 =
  if __abiMac() then 16 else if __abiX64() then 28 else if __abiArm32() then 24 else 24

let __abiStatSizeOffset(): Int64 =
  if __abiMac() then 96 else if __abiX64() then 48 else if __abiArm32() then 48 else 48

let __abiStatMtimeOffset(): Int64 =
  if __abiMac() then 48 else if __abiX64() then 88 else if __abiArm32() then 80 else 88

let __abiStatTimeWidth(): Int64 = if __abiArm32() then 4 else 8

let __abiStatDeviceWidth(): Int64 = if __abiMac() then 4 else 8

let __abiStatInodeOffset(): Int64 = if __abiArm32() then 96 else 8

let __abiDirectoryNameOffset(): Int64 = if __abiMac() then 21 else 19


/// Bounds-checked decoding of kernel byte records. No OS effects occur here.

/// <param width> bytes of <param bytes> from <param offset>, little-endian.
let __kernelField(bytes: Bytes, offset: Int64, width: Int64)
  : Result.Result<Int64, Int64> =
  if width == 0 then Ok(0)
  else
    match Stdlib.Bytes.getAt(bytes, offset) with
    | None -> Error(5)
    | Some(byte) ->
      match __kernelField(bytes, offset + 1, width - 1) with
      | Error(e) -> Error(e)
      | Ok(high) -> Ok(Stdlib.Int64.fromUInt8(byte) + 256 * high)

let __kernelSignedField(bytes: Bytes, offset: Int64, width: Int64)
  : Result.Result<Int64, Int64> =
  match __kernelField(bytes, offset, width) with
  | Error(e) -> Error(e)
  | Ok(n) ->
    let modulus = 256 ** width
    Ok(if n >= modulus / 2 then n - modulus else n)

type __KernelMetadata =
  { mode: Int64, size: Int64, mtimeSec: Int64, uid: Int64, device: Int64, inode: Int64 }

let __kernelMetadata(bytes: Bytes): Result.Result<__KernelMetadata, Int64> =
  __kernelField(bytes, Stdlib.Cli.Posix.__abiStatModeOffset(), Stdlib.Cli.Posix.__abiStatModeWidth())
  |> Stdlib.Result.andThen(fun mode ->
    __kernelSignedField(bytes, Stdlib.Cli.Posix.__abiStatSizeOffset(), 8)
    |> Stdlib.Result.andThen(fun size ->
      __kernelSignedField(bytes, Stdlib.Cli.Posix.__abiStatMtimeOffset(), Stdlib.Cli.Posix.__abiStatTimeWidth())
      |> Stdlib.Result.andThen(fun mtime ->
        __kernelField(bytes, Stdlib.Cli.Posix.__abiStatUidOffset(), 4)
        |> Stdlib.Result.andThen(fun uid ->
          __kernelField(bytes, 0, Stdlib.Cli.Posix.__abiStatDeviceWidth())
          |> Stdlib.Result.andThen(fun device ->
            __kernelField(bytes, Stdlib.Cli.Posix.__abiStatInodeOffset(), 8)
            |> Stdlib.Result.map(fun inode ->
              __KernelMetadata { mode = mode, size = size, mtimeSec = mtime, uid = uid
                         device = device, inode = inode }))))))

/// Decode records within one read, from <param at> to the end of it.
let __kernelEntriesFrom(bytes: Bytes, at: Int64, reversed: List<String>)
  : Result.Result<List<String>, Int64> =
  let remaining = Stdlib.Bytes.length(bytes) - at
  if remaining <= 0 then Ok(reversed)
  else
    __kernelField(bytes, at + 16, 2)
    |> Stdlib.Result.andThen(fun length ->
      let nameOffset = Stdlib.Cli.Posix.__abiDirectoryNameOffset()
      if length <= nameOffset || length > remaining then Error(5)
      else
        let nameStart = at + nameOffset
        let recordEnd = at + length
        match Stdlib.Bytes.indexOfFrom(bytes, 0u8, nameStart) with
        | Some(nul) when nul < recordEnd ->
          match Stdlib.Bytes.slice(bytes, nameStart, nul) with
          | Ok(nameBytes) ->
            let name = Stdlib.Utf8.decodeWithReplacement(nameBytes)
            let next =
              if name == "." || name == ".." then reversed
              else Stdlib.List.prepend(reversed, name)
            __kernelEntriesFrom(bytes, recordEnd, next)
          | Error(_) -> Error(5)
        | _ -> Error(5))

let __kernelEntries(bytes: Bytes, reversed: List<String>)
  : Result.Result<List<String>, Int64> =
  __kernelEntriesFrom(bytes, 0, reversed)


/// Directory iteration and record decoding over single-call kernel primitives.

let __directoryReadAll(fd: BigInt, reversed: List<String>)
  : Result.Result<List<String>, Int64> =
  match Builtin.syscallGetdents(fd, 32768) with
  | Error(e) ->
    if e == 4 then __directoryReadAll(fd, reversed) else Error(e)
  | Ok(bytes) ->
    if Stdlib.Bytes.length(bytes) == 0 then Ok(Stdlib.List.reverse(reversed))
    else
      match Stdlib.Cli.Posix.__kernelEntries(bytes, reversed) with
      | Error(e) -> Error(e)
      | Ok(next) -> __directoryReadAll(fd, next)

let __directoryList(path: String): Result.Result<List<String>, Posix.Error> =
  match Posix.openFile(path, Stdlib.Cli.Posix.__abiOpenDirectory(), 0) with
  | Error(e) -> Error(e)
  | Ok(fd) ->
    let result = __directoryReadAll(fd, []) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)
    let closed = Posix.fdClose(fd)
    match result with
    | Error(e) -> Error(e)
    | Ok(entries) -> closed |> Stdlib.Result.map(fun _ -> entries)


/// Path buffer growth and text decoding over one-call kernel primitives.

let __pathReadlinkWith(read: Int64 -> Result.Result<Bytes, Int64>, count: Int64)
  : Result.Result<Bytes, Int64> =
  if count <= 0 then Error(22)
  else
    match read(count) with
    | Error(e) ->
      if e == 4 then __pathReadlinkWith(read, count) else Error(e)
    | Ok(bytes) ->
      if Stdlib.Bytes.length(bytes) < count then Ok(bytes)
      else if count >= 1048576 then Error(if Stdlib.Cli.Posix.__abiMac() then 63 else 36)
      else __pathReadlinkWith(read, count * 2)

let __pathReadlink(path: String): Result.Result<String, Posix.Error> =
  __pathReadlinkWith((fun count -> Builtin.syscallReadlinkAt(path, count)), 256)
  |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
  |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)

let __pathCwdWith(read: Int64 -> Result.Result<Bytes, Int64>, count: Int64)
  : Result.Result<Bytes, Int64> =
  if count <= 0 then Error(22)
  else
    match read(count) with
    | Error(4) -> __pathCwdWith(read, count)
    | Error(34) ->
      if count >= 1048576 then Error(34) else __pathCwdWith(read, count * 2)
    | other -> other

let __pathPathText(bytes: Bytes): String =
  let text =
    match Stdlib.Bytes.indexOf(bytes, 0u8) with
    | Some(nul) -> Stdlib.Bytes.take(bytes, nul)
    | None -> bytes
  Stdlib.Utf8.decodeWithReplacement(text)

let __pathGetCwd(): Result.Result<String, Posix.Error> =
  let bytes =
    if Stdlib.Cli.Posix.__abiMac() then
      match Builtin.syscallOpen(".", Stdlib.Cli.Posix.__abiOpenDirectory(), 0) with
      | Error(e) -> Error(e)
      | Ok(fd) ->
        let result = Builtin.syscallFcntlGetPath(fd)
        let closed = Builtin.syscallClose(fd)
        match result with
        | Error(e) -> Error(e)
        | Ok(bytes) ->
          match closed with
          | Error(e) -> Error(e)
          | Ok(_) -> Ok(bytes)
    else __pathCwdWith(Builtin.syscallGetcwd, 256)
  bytes |> Stdlib.Result.map(__pathPathText) |> Stdlib.Result.mapError(Stdlib.Cli.Posix.__fromErrno)


/// Error messages ported from the compiler's Cli.__Posix implementation.
/// Kernel errno is platform-specific; permission and host diagnostics stay intact.

// Keep errno rendering shared while the engines have different Display APIs.
let __decimal(value: Int64): String =
    if value < 0 then Stdlib.String.append("-", __decimal(0 - value))
    else
        let quotient = value / 10
        let digit = value - quotient * 10
        let suffix =
            if digit == 0 then "0" else if digit == 1 then "1"
            else if digit == 2 then "2" else if digit == 3 then "3"
            else if digit == 4 then "4" else if digit == 5 then "5"
            else if digit == 6 then "6" else if digit == 7 then "7"
            else if digit == 8 then "8" else "9"
        if quotient == 0 then suffix
        else Stdlib.String.append(__decimal(quotient), suffix)

let __macMessage(errno: Int64): String =
    if errno == 1 then "Operation not permitted"
    else if errno == 2 then "No such file or directory"
    else if errno == 3 then "No such process"
    else if errno == 4 then "Interrupted system call"
    else if errno == 5 then "Input/output error"
    else if errno == 6 then "Device not configured"
    else if errno == 7 then "Argument list too long"
    else if errno == 8 then "Exec format error"
    else if errno == 9 then "Bad file descriptor"
    else if errno == 10 then "No child processes"
    else if errno == 11 then "Resource deadlock avoided"
    else if errno == 12 then "Cannot allocate memory"
    else if errno == 13 then "Permission denied"
    else if errno == 14 then "Bad address"
    else if errno == 15 then "Block device required"
    else if errno == 16 then "Device / Resource busy"
    else if errno == 17 then "File exists"
    else if errno == 18 then "Cross-device link"
    else if errno == 19 then "Operation not supported by device"
    else if errno == 20 then "Not a directory"
    else if errno == 21 then "Is a directory"
    else if errno == 22 then "Invalid argument"
    else if errno == 23 then "Too many open files in system"
    else if errno == 24 then "Too many open files"
    else if errno == 25 then "Inappropriate ioctl for device"
    else if errno == 26 then "Text file busy"
    else if errno == 27 then "File too large"
    else if errno == 28 then "No space left on device"
    else if errno == 29 then "Illegal seek"
    else if errno == 30 then "Read-only file system"
    else if errno == 31 then "Too many links"
    else if errno == 32 then "Broken pipe"
    else if errno == 33 then "Numerical argument out of domain"
    else if errno == 34 then "Result too large"
    else if errno == 35 then "Resource temporarily unavailable"
    else if errno == 36 then "Operation now in progress"
    else if errno == 37 then "Operation already in progress"
    else if errno == 38 then "Socket operation on non-socket"
    else if errno == 39 then "Destination address required"
    else if errno == 40 then "Message too long"
    else if errno == 41 then "Protocol wrong type for socket"
    else if errno == 42 then "Protocol not available"
    else if errno == 43 then "Protocol not supported"
    else if errno == 44 then "Socket type not supported"
    else if errno == 45 then "Operation not supported"
    else if errno == 46 then "Protocol family not supported"
    else if errno == 47 then "Address family not supported by protocol family"
    else if errno == 48 then "Address already in use"
    else if errno == 49 then "Can't assign requested address"
