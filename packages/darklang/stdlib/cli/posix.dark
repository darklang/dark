    else if errno == 81 then "Need authenticator"
    else if errno == 82 then "Device power is off"
    else if errno == 83 then "Device error, e.g. paper out"
    else if errno == 84 then "Value too large to be stored in data type"
    else if errno == 85 then "Bad executable"
    else if errno == 86 then "Bad CPU type in executable"
    else if errno == 87 then "Shared library version mismatch"
    else if errno == 88 then "Malformed Macho file"
    else if errno == 89 then "Operation canceled"
    else if errno == 90 then "Identifier removed"
    else if errno == 91 then "No message of desired type"
