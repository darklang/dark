module Darklang.Stdlib.Cli.Curl

let downloadFileToPath(
  url: String,
  downloadTo: String)
  : Stdlib.Result.Result<Unit, String> =
  // `-f`, so a 404 is an error rather than an HTML page saved under the name we asked for.
  let dest = Stdlib.Cli.Process.shellQuote(downloadTo)
  Stdlib.Cli.executeWithUnitOrStdErr($"curl -fsSL -o {dest} {Stdlib.Cli.Process.shellQuote(url)}")