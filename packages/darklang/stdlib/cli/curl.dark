module Darklang.Stdlib.Cli.Curl

let downloadFileToPath(url: String, downloadTo: String): Result<Unit, String> =
  // `-f`, so a 404 is an error rather than an HTML page saved under the name we asked for.
  let dest = Process.shellQuote(downloadTo)
  executeWithUnitOrStdErr($"curl -fsSL -o {dest} {Process.shellQuote(url)}")
