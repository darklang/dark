/// Clock record decoding, scaling and interrupted-sleep retries in shared Dark.
module Darklang.Stdlib.Cli.Clock

let timespec (bytes: Blob) : Result.Result<(Int * Int), Int> =
  let width = if KernelABI.arm32 () then 4 else 8
  let record = Stdlib.Blob.toList bytes
  KernelData.signedField record 0 width
  |> Stdlib.Result.andThen (fun seconds ->
    KernelData.signedField record width width
    |> Stdlib.Result.map (fun nanos -> (seconds, nanos)))

let realtimeNanoseconds () : Result.Result<(Int * Int), Int> =
  if Runtime.targetOS () == "browser" then
    let ticks = Runtime.realtimeTicks ()
    Ok ((ticks / 10000000, (ticks % 10000000) * 100))
  else if KernelABI.mac () then
    Syscall.gettimeofday ()
    |> Stdlib.Result.andThen (fun bytes ->
      let record = Stdlib.Blob.toList bytes
      KernelData.signedField record 0 8
      |> Stdlib.Result.andThen (fun seconds ->
        KernelData.signedField record 8 4
        |> Stdlib.Result.map (fun micros -> (seconds, micros * 1000))))
  else Syscall.clockGettime 0 |> Stdlib.Result.andThen timespec

let monotonicNanoseconds () : Result.Result<(Int * Int), Int> =
  if Runtime.targetOS () == "browser" then
    let (ticks, frequency) = Runtime.monotonicCounter ()
    if frequency <= 0 then Error 5
    else Ok ((ticks / frequency, ((ticks % frequency) * 1000000000) / frequency))
  else if KernelABI.mac () then
    Syscall.machAbsoluteTime ()
    |> Stdlib.Result.andThen (fun bytes ->
      KernelData.field (Stdlib.Blob.toList bytes) 0 8
      |> Stdlib.Result.andThen (fun ticks ->
        Syscall.machTimebaseInfo ()
        |> Stdlib.Result.andThen (fun base ->
          let record = Stdlib.Blob.toList base
          KernelData.field record 0 4
          |> Stdlib.Result.andThen (fun numerator ->
            KernelData.field record 4 4
            |> Stdlib.Result.andThen (fun denominator ->
              if denominator == 0 then Error 5
              else
                let nanos = (ticks / denominator) * numerator + ((ticks % denominator) * numerator) / denominator
                Ok ((nanos / 1000000000, nanos % 1000000000)))))))
  else Syscall.clockGettime 1 |> Stdlib.Result.andThen timespec

let monotonicMilliseconds () : Int =
  match monotonicNanoseconds () with
  | Ok ((seconds, nanos)) -> seconds * 1000 + nanos / 1000000
  | Error e -> Builtin.unwrap (Error e)

let now () : DateTime =
  match realtimeNanoseconds () with
  | Ok ((seconds, nanos)) -> Builtin.dateTimeFromUnixTicks (seconds * 10000000 + nanos / 100)
  | Error e -> Builtin.unwrap (Error e)

let today () : DateTime =
  let seconds = Stdlib.DateTime.toSeconds (now ())
  let remainder = seconds % 86400
  let start = if remainder < 0 then seconds - remainder - 86400 else seconds - remainder
  Stdlib.DateTime.fromSeconds start

let sleepWith (sleep: Int -> Int -> (Int * Blob)) (seconds: Int) (nanos: Int)
  : Result.Result<Unit, Int> =
  let (rc, remaining) = sleep seconds nanos
  if rc == 0 then Ok ()
  else if rc == -4 then
    timespec remaining |> Stdlib.Result.andThen (fun pair ->
      let (seconds, nanos) = pair
      sleepWith sleep seconds nanos)
  else Error (0 - rc)

let sleepNanoseconds (seconds: Int) (nanos: Int) : Result.Result<Unit, Int> =
  sleepWith Syscall.nanosleep seconds nanos

let sleepMilliseconds (milliseconds: Float) : Unit =
  let nanos = Stdlib.Float.toInt (milliseconds * 1000000.0)
  if Runtime.targetOS () == "browser" then Runtime.delayTicks (nanos / 100)
  else sleepNanoseconds (nanos / 1000000000) (nanos % 1000000000) |> Builtin.unwrap
