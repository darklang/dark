module Darklang.Stdlib.Cli

module OS =
  type OS =
    | Linux
    | MacOS


  let getOS(): Result<OS, String> =
    match Builtin.runtimeTargetOS() with
    | "linux" -> Result.Ok(OS.Linux)
    | "darwin" -> Result.Ok(OS.MacOS)
    | "windows" ->
      Result.Error("Dark does not support Windows. Linux and macOS only, including WSL.")
    | _ -> Result.Error("Unsupported operating system")


module Architecture =
  type Architecture =
    | X86_64
    | Aarch64
    | Arm
    | Arm64


  let getArchitecture(): Result<Architecture, String> =
    match Builtin.runtimeTargetArchitecture() with
    | "x64" -> Result.Ok(Architecture.X86_64)
    | "arm64" ->
      if Builtin.runtimeTargetOS() == "darwin" then
        Result.Ok(Architecture.Arm64)
      else
        Result.Ok(Architecture.Aarch64)
    | "arm" -> Result.Ok(Architecture.Arm)
    | _ -> Result.Error("Unsupported architecture")


module Shell =
  type Shell =
    | Bash
    | Zsh
    | Fish


  /// Determines the default shell used by the current user.
  /// Returns  {{Ok <Shell>}} if successful, or {{Error}} with a message if the shell is unsupported or an error occurs.
  let getDefaultShell(): Result<Shell, String> =
    match OS.getOS() with
    | Ok(Linux) ->
      Result.Ok(Option.withDefault(Env.get("SHELL"), "/bin/bash"))
      |> Result.andThen(fun shell ->
        match String.trim(shell) with
        | "/bin/bash" -> Result.Ok(Shell.Bash)
        | "/bin/zsh" -> Result.Ok(Shell.Zsh)
        | shell when shell |> String.contains("/fish") -> Result.Ok(Shell.Fish)
        | _ -> Result.Error("Unsupported shell, if you are on Linux please use Bash, Zsh, or Fish"))
    | Ok(MacOS) ->
      Result.Ok(Option.withDefault(Env.get("SHELL"), "/bin/bash"))
      |> Result.andThen(fun shell ->
        match String.trim(shell) with
        | "/bin/zsh" -> Result.Ok(Shell.Zsh)
        | shell when shell |> String.contains("/bin/bash") -> Result.Ok(Shell.Bash)
        | shell when shell |> String.contains("/fish") -> Result.Ok(Shell.Fish)
        | _ -> Result.Error("Unsupported shell, if you are on MacOS please use Bash, Zsh, or Fish"))
    | Error(_) -> Result.Error("Unsupported OS, couldn't determine default shell")


module Host =
  type Host =
    { os: OS.OS
      arch: Architecture.Architecture
      defaultShell: Shell.Shell }


  /// Identifies and returns the operating system and architecture of the runtime host.
  /// Returns {{Ok <Host>}} on success, or an {{Error}} with combined stderr if it fails
  let getRuntimeHost(): Result<Host, String> =
    let os = OS.getOS()
    let arch = Architecture.getArchitecture()
    let defaultShell = Shell.getDefaultShell()
    match os, arch, defaultShell with
    | Ok(os), Ok(arch), Ok(defaultShell) ->
      Result.Ok(Host { os = os, arch = arch, defaultShell = defaultShell })
    | Error(os), _, _ -> Result.Error($"Couldn't determine host OS: ${os}")
    | _, Error(arch), _ -> Result.Error($"Couldn't determine host architecture: ${arch}")
    | _, _, Error(defaultShell) ->
      Result.Error($"Couldn't determine host default shell ${defaultShell}")
