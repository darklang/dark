/// Fitting rows that may carry SGR styling to a terminal-column count.
///
/// Plain text that never carries styling wants `Stdlib.String.displayWidth` instead. Columns
/// throughout, never characters: `界` is one character in two columns, and so is a ZWJ emoji.
///
/// Also the CLI's escape-sanitizing boundary, so a package name or description can't move the cursor
/// or reset the terminal.
///
/// The fitters are native; they walk a row a character at a time, and a Dark loop pays a builtin call
/// per character. `wrapAtWords` below stays in Dark because it measures whole words.
module Darklang.Stdlib.Cli.Tui.Text

/// Terminal columns occupied by a row that may carry SGR styling.
let styledWidth(text: String): Int64 =
  Builtin.cliTerminalStyledWidth(text)


/// Drop SGR styling, other escapes and control characters, leaving the visible text.
let stripSgr(text: String): String =
  Builtin.cliTerminalStripSgr(text)


/// Clip a row to a column width, keeping SGR and dropping every other escape and control character.
let clipToWidth(text: String, maxWidth: Int64): String =
  Builtin.cliTerminalClipToWidth(text, maxWidth)


/// Clip to <param maxWidth>, marking the cut so a truncated line reads as truncated.
///
/// `clipToWidth` alone just stops, which is indistinguishable from a line that happened to be that long --
/// "Accept the parent's changes in" looks like the whole label to anyone who has not seen it wider. One
/// character of ellipsis is the difference between "there is more" and "that is all".
///
/// Below two columns there is no room to say anything, so it degrades to a plain clip.
let clipMarked(text: String, maxWidth: Int64): String =
  if styledWidth(text) <= maxWidth then
    text
  else if maxWidth <= 1 then
    clipToWidth(text, maxWidth)
  else
    clipToWidth(text, maxWidth - 1) + "…"


/// Break a row at the column, restating styling that spans the wrap. To break at spaces where it
/// can, use `wrapAtWords`.
let wrapAtColumn(text: String, maxWidth: Int64): List<String> =
  Builtin.cliTerminalWrapAtColumn(text, maxWidth)


/// `wrapAtColumn` over `before + after`, with the zero-based row and column of the cursor between
/// them. Both come from the one wrap, so the cursor stays on the text when a word moves down. Exactly
/// past a full last row reads as column zero of the next row, matching what the terminal does.
let wrapWithCursor(before: String, after: String, maxWidth: Int64): (List<String> * Int64 * Int64) =
  Builtin.cliTerminalWrapWithCursor(before, after, maxWidth)


/// Pad or clip text to exactly the requested terminal-column width.
let fitToWidth(text: String, targetWidth: Int64): String =
  let clipped = clipToWidth(text, targetWidth)
  let padding = max(0, targetWidth - styledWidth(clipped))
  clipped + (String.checkedRepeat(" ", padding) |> Result.withDefault(""))


// --- Word wrapping ---

/// Break one long word across lines, since it can't be fitted whole.
let __splitLongWord(word: String, width: Int64): List<String> =
  if String.displayWidth(word) <= width then
    [ word ]
  else
    let head = clipToWidth(word, width)
    let taken = String.length(head)
    // A wide glyph can make `clipToWidth` take fewer characters than columns; never take none.
    let step = max(1, taken)
    List.prepend(__splitLongWord(String.dropFirst(word, step), width), head)


/// Fold one word into the lines built so far.
let __addWord(
  lines: List<String>,
  current: String,
  word: String,
  width: Int64)
  : (List<String> * String) =
  let candidate = if current == "" then word else current + " " + word
  if String.displayWidth(candidate) <= width then
    (lines, candidate)
  else if current == "" then
    // The word alone doesn't fit: split it, keeping the tail as the line in progress.
    match List.reverse(__splitLongWord(word, width)) with
    | [] -> (lines, "")
    | [last, ...earlier] -> (List.concat(lines, List.reverse(earlier)), last)
  else
    let (wrapped, rest) = __addWord([], "", word, width)
    (List.concat(List.append(lines, current), wrapped), rest)


/// Break plain text at spaces where it can and inside a word where it must.
/// Styling isn't handled: wrap first, colour after.
let wrapAtWords(text: String, width: Int64): List<String> =
  let w = max(1, width)
  if text == "" then
    [ "" ]
  else if String.displayWidth(text) <= w then
    [ text ]
  else
    let words = String.split(text, " ") |> List.filter(fun word -> word != "")
    let (lines, current) =
      words
      |> List.fold(([], ""), fun(acc, word) ->
        let (soFar, inProgress) = acc
        __addWord(soFar, inProgress, word, w))

    if current == "" then lines else List.append(lines, current)
