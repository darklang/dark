/// Decide whether a terminal can run an interactive TUI.
module Darklang.Stdlib.Cli.Tui.TerminalSupport


/// The facts about this terminal session: which standard streams are terminals, and the environment
/// variables that govern how a terminal is used (`TERM`, `NO_COLOR`, `CLICOLOR_FORCE`, `CI`,
/// `DARK_NO_INPUT`, whichever are set). Gathered here from two primitives, isatty and getenv; the
/// host reads exactly those five names without an `env-read` grant, since these decisions are made
/// under deny-all. Whether to start a TUI, colour output or ask a question are policies over them.
type Facts =
  { inputIsTerminal: Bool
    outputIsTerminal: Bool
    errorIsTerminal: Bool
    terminalName: String
    environment: Dict<String, String> }


/// Whether an interactive TUI may start.
type Availability =
  | Available
  | Unavailable of reason: String


/// Evaluate terminal support from host facts.
///
/// Both input and output must be terminals: the UI reads keys from input and
/// writes terminal control sequences to output.
let evaluate (facts: Facts) : Availability =
  let terminalName =
    facts.terminalName
    |> Stdlib.String.trim
    |> Stdlib.String.toLowercase

  if Stdlib.Bool.not facts.inputIsTerminal then
    Availability.Unavailable "standard input is not a terminal"
  else if Stdlib.Bool.not facts.outputIsTerminal then
    Availability.Unavailable "standard output is not a terminal"
  else if terminalName == "" then
    Availability.Unavailable "TERM is not set"
  else if terminalName == "dumb" || terminalName == "unknown" then
    Availability.Unavailable
      $"TERM={facts.terminalName} does not support an interactive terminal UI"
  else
    Availability.Available


/// The variables `Facts.environment` carries. The host reads these and no others without a grant.
let governingVariables () : List<String> =
  [ "TERM", "NO_COLOR", "CLICOLOR_FORCE", "CI", "DARK_NO_INPUT" ]

/// Read the current terminal facts.
let currentFacts () : Facts =
  let environment =
    governingVariables ()
    |> Stdlib.List.filterMap (fun name ->
      match Stdlib.Cli.Env.get name with
      | Some value -> Stdlib.Option.Option.Some((name, value))
      | None -> Stdlib.Option.Option.None)
    |> Stdlib.Dict.fromListOverwritingDuplicates

  Facts {
    inputIsTerminal = Stdlib.Cli.Sys.isTerminal 0
    outputIsTerminal = Stdlib.Cli.Sys.isTerminal 1
    errorIsTerminal = Stdlib.Cli.Sys.isTerminal 2
    terminalName = Stdlib.Option.withDefault (Stdlib.Dict.get environment "TERM") ""
    environment = environment
  }

/// Whether a governing variable is switched on: set, non-empty, and not `0`, `false` or `no`.
/// `CI=0`, `CI=false` and `CI=` all mean "not CI".
let isOn (facts: Facts) (name: String) : Bool =
  match Stdlib.Dict.get facts.environment name with
  | Some value ->
    let v = Stdlib.String.toLowercase (Stdlib.String.trim value)
    v != "" && v != "0" && v != "false" && v != "no"
  | None -> false

/// Whether a stream should carry colour: it is a terminal, `TERM` isn't `dumb`, and `NO_COLOR`
/// isn't set (any non-empty value counts, per no-color.org). `CLICOLOR_FORCE` overrides.
let colorEnabledFor (facts: Facts) (isTerminal: Bool) : Bool =
  if isOn facts "CLICOLOR_FORCE" then
    true
  else
    let noColor =
      match Stdlib.Dict.get facts.environment "NO_COLOR" with
      | Some value -> value != ""
      | None -> false
    isTerminal && facts.terminalName != "dumb" && Stdlib.Bool.not noColor


/// Check whether an interactive TUI may start in the current terminal.
let current () : Availability =
  evaluate (currentFacts ())


/// Format an error without terminal control sequences.
let unavailableMessage (reason: String) : String =
  $"Interactive terminal UI unavailable: {reason}."
