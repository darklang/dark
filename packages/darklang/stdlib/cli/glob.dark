/// Pure UTF-8 glob matching. No kernel operation or Builtin is involved.
module Darklang.Stdlib.Cli.Glob

let knownClass (name: String) : Bool =
  name == "alnum" || name == "alpha" || name == "blank" || name == "cntrl"
  || name == "digit" || name == "graph" || name == "lower" || name == "print"
  || name == "punct" || name == "space" || name == "upper" || name == "xdigit"

let namedClass (name: String) (c: UInt8) : Bool =
  let upper = c >= 65uy && c <= 90uy
  let lower = c >= 97uy && c <= 122uy
  let digit = c >= 48uy && c <= 57uy
  let space = c == 32uy || (c >= 9uy && c <= 13uy)
  if name == "alnum" then upper || lower || digit
  else if name == "alpha" then upper || lower
  else if name == "blank" then c == 32uy || c == 9uy
  else if name == "cntrl" then c < 32uy || c == 127uy
  else if name == "digit" then digit
  else if name == "graph" then c >= 33uy && c <= 126uy
  else if name == "lower" then lower
  else if name == "print" then c >= 32uy && c <= 126uy
  else if name == "punct" then
    c >= 33uy && c <= 126uy && Stdlib.Bool.not (upper || lower || digit)
  else if name == "space" then space
  else if name == "upper" then upper
  else if name == "xdigit" then
    digit || (c >= 65uy && c <= 70uy) || (c >= 97uy && c <= 102uy)
  else false

/// Return a named character class and the bytes after its closing ':]'.
let classEnd
  (bytes: List<UInt8>)
  (reversedName: List<UInt8>)
  : Option.Option<(String * List<UInt8>)> =
  match bytes with
  | 58uy :: 93uy :: rest ->
    let name =
      Stdlib.String.fromBytesWithReplacement (Stdlib.List.reverse reversedName)
    Some ((name, rest))
  | c :: rest -> classEnd rest (Stdlib.List.push reversedName c)
  | [] -> None

/// Interpret an escaped byte or a single-byte collating/equivalence symbol.
let classChar
  (c: UInt8)
  (rest: List<UInt8>)
  : (UInt8 * List<UInt8>) =
  if c == 92uy then
    match rest with
    | escaped :: after -> (escaped, after)
    | [] -> (c, rest)
  else if c == 91uy then
    match rest with
    | marker :: symbol :: closing :: 93uy :: after ->
      if (marker == 46uy || marker == 61uy) && closing == marker then
        (symbol, after)
      else (c, rest)
    | _ -> (c, rest)
  else (c, rest)

let classItems
  (bytes: List<UInt8>)
  (c: UInt8)
  (first: Bool)
  (matched: Bool)
  (valid: Bool)
  : Option.Option<(List<UInt8> * Bool * Bool)> =
  match bytes with
  | [] -> None
  | 91uy :: 58uy :: name ->
    match classEnd name [] with
    | None -> None
    | Some ((name, after)) ->
      classItems after c false (matched || namedClass name c)
        (valid && knownClass name)
  | head :: rest ->
    if head == 93uy && Stdlib.Bool.not first then Some ((rest, matched, valid))
    else
      let (low, next) = classChar head rest
      match next with
      | 45uy :: highHead :: highTail when highHead != 93uy ->
        let (high, after) = classChar highHead highTail
        classItems after c false (matched || (c >= low && c <= high)) valid
      | _ -> classItems next c false (matched || c == low) valid

let bracket
  (bytes: List<UInt8>)
  (c: UInt8)
  : Option.Option<(List<UInt8> * Bool)> =
  let inverted =
    match bytes with
    | first :: _ -> first == 33uy || first == 94uy
    | [] -> false
  let items = if inverted then Stdlib.List.drop bytes 1 else bytes
  match classItems items c true false true with
  | None -> None
  | Some ((after, matched, valid)) ->
    Some ((after, valid && (if inverted then Stdlib.Bool.not matched else matched)))

let matchBytes
  (pattern: List<UInt8>)
  (text: List<UInt8>)
  (pathname: Bool)
  : Bool =
  match pattern with
  | [] -> text == []
  | 42uy :: rest ->
    // Adjacent stars are equivalent; collapse them before backtracking.
    let after = Stdlib.List.dropWhile rest (fun c -> c == 42uy)
    if matchBytes after text pathname then true
    else
      match text with
      | c :: tail ->
        (Stdlib.Bool.not pathname || c != 47uy)
        && matchBytes pattern tail pathname
      | [] -> false
  | p :: rest ->
    match text with
    | [] -> false
    | c :: tail ->
      if p == 63uy then
        (Stdlib.Bool.not pathname || c != 47uy) && matchBytes rest tail pathname
      else if p == 92uy then
        match rest with
        | escaped :: after -> escaped == c && matchBytes after tail pathname
        | [] -> false
      else if p == 91uy then
        match bracket rest c with
        | Some ((after, matched)) ->
          matched && (Stdlib.Bool.not pathname || c != 47uy)
          && matchBytes after tail pathname
        | None -> p == c && matchBytes rest tail pathname
      else p == c && matchBytes rest tail pathname

/// Match the full string, including NUL bytes; this is not a C-string API.
/// Wildcards retain the library's byte-based matching semantics.
let matches (pattern: String) (text: String) (pathname: Bool) : Bool =
  let patternBytes = Stdlib.String.toBytes pattern
  let textBytes = Stdlib.String.toBytes text
  matchBytes patternBytes textBytes pathname
