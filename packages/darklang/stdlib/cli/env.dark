module Darklang.Stdlib.Cli.Env

/// Get an environment variable, or None if not set.
let get(name: String): Option<String> =
  Posix.getenv(name)


/// Get an environment variable, or a default if not set.
let getOr(name: String, default_: String): String =
  match get(name) with
  | Some(v) -> v
  | None -> default_


/// Whether a switch like `CI` is on: set, and not empty, `0`, `false` or `no`.
let isOn(name: String): Bool =
  match get(name) with
  | Some(value) ->
    let v = String.toLowercase(String.trim(value))
    v != "" && v != "0" && v != "false" && v != "no"
  | None -> false


/// Get the HOME directory.
/// Checks $HOME first, then falls back to the passwd database (like Python/bash).
/// Returns None if neither source provides a value.
let home(): Option<String> =
  match Posix.getenv("HOME") with
  | Some(h) -> Option.Some(h)
  | None ->
    match Posix.__accountLookup(Posix.__decimal(Builtin.syscallGetuid()), 5) with
    | Some(home) -> Builtin.runtimeAuthorizeReadPath(home)
    | None -> Option.None
