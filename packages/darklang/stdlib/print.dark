module Darklang.Stdlib


let print(str: String): Unit =
  Builtin.print(str)


let printLine(str: String): Unit =
  Builtin.printLine(str)


/// Print <param str> to stderr, followed by a newline: for everything that is not the answer to what
/// was asked, so `dark cmd | next` carries only the answer.
let printErrorLine(str: String): Unit =
  Builtin.printErrorLine(str)


let printError(str: String): Unit =
  Builtin.printError(str)


let printLines(lines: List<String>): Unit =
  lines
  |> List.iter(fun l -> printLine(l))


/// `DEBUG: <label>: <value>` to stderr, the value as `toRepr` writes it: for looking at a value
/// while working on code, without it landing in the answer on stdout.
let debug(label: String, value: 'a): Unit =
  printErrorLine($"DEBUG: {label}: {toRepr(value)}")
