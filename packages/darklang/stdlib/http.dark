module Darklang.Stdlib.Http


type Request =
  { url: String
    headers: List<String * String>
    body: Bytes }


/// The path, query and fragment of <param url>, split the way a server splits a
/// request-target ({{/a/b?x=1}}), as a <type Stdlib.Url.Url> with no scheme or
/// host. A {{scheme://authority}} in front is dropped WITHOUT being checked: on
/// a server it is built from the client's Host header, so a bad one must not
/// cost the request its path. No character is refused either, so this never
/// fails, and the path is whatever followed the authority, {{//a}} included.
let requestTarget(url: String): Stdlib.Url.Url =
  let target =
    match Stdlib.String.splitFirst(url, "://") with
    | Some((scheme, rest)) when
      !(Stdlib.List.any([ "/", "?", "#" ], fun d -> Stdlib.String.contains(scheme, d)))
      ->
      // The authority runs to the first `/`, `?` or `#`.
      rest
      |> Stdlib.String.toList
      |> Stdlib.List.dropWhile(fun c ->
        !(Stdlib.String.contains("/?#", Stdlib.String.fromChar(c))))
      |> Stdlib.String.fromList
    | _ -> url

  let (beforeFragment, fragment) =
    match Stdlib.String.splitFirst(target, "#") with
    | Some((a, f)) -> (a, Stdlib.Option.Option.Some f)
    | None -> (target, Stdlib.Option.Option.None)

  let (path, query) =
    match Stdlib.String.splitFirst(beforeFragment, "?") with
    | Some((p, q)) -> (p, Stdlib.Option.Option.Some q)
    | None -> (beforeFragment, Stdlib.Option.Option.None)

  Stdlib.Url.Url
    { scheme = Stdlib.Option.Option.None
      userinfo = Stdlib.Option.Option.None
      host = Stdlib.Option.Option.None
      port = Stdlib.Option.Option.None
      path = path
      query = query
      fragment = fragment }


/// Parses a URL's query string into a dictionary, keeping the last value for
/// each key: <fn Stdlib.Url.queryParams> of <fn requestTarget>, through
/// {{Dict.fromEntries}}.
let parseQueryString(url: String): Dict<String, String> =
  url |> requestTarget |> Stdlib.Url.queryParams |> Stdlib.Dict.fromEntries


/// Parse a string of HTTP header lines (one `Name: value` per line, CR/LF or
/// LF separated) into a Dict. Duplicates resolve to the last-wins value.
/// Header names are kept verbatim — case-insensitive lookup is the caller's
/// responsibility (see `String.equalsCaseInsensitive`).
let parseHeaders(s: String): Dict<String, String> =
  s
  |> Stdlib.String.replaceAll("\r\n", "\n")
  |> Stdlib.String.split("\n")
  |> Stdlib.List.filterMap(fun line ->
    let trimmed = Stdlib.String.trim(line)
    if trimmed == "" then
      Stdlib.Option.Option.None
    else
      match Stdlib.String.split(trimmed, ":") with
      | [] -> Stdlib.Option.Option.None
      | [ _ ] -> Stdlib.Option.Option.None
      | [name, ...rest] ->
        let value = (Stdlib.String.join(rest, ":")) |> Stdlib.String.trim
        Stdlib.Option.Option.Some((Stdlib.String.trim(name), value)))
  |> Stdlib.Dict.fromEntries


/// Percent-decoding for one query-string field: <fn Stdlib.Url.formDecode>,
/// which is <fn Stdlib.Url.percentDecode> plus `+` read as a space.
///
/// `+` is a space. That is not decoration: an HTML form doing a GET encodes a
/// space that way, so a two-word search from a form field arrives as `a+b`. The
/// substitution runs over the raw text, before decoding, so a literal `+` sent as
/// `%2B` survives it.
///
/// A `%` that does not start two hex digits is passed through as itself rather
/// than dropped. A search box is allowed to contain a percent sign.
let urlDecode(s: String): String =
  Stdlib.Url.formDecode(s)


module Request =
  /// The query string, decoded: <fn Stdlib.Url.queryParams> of the request's
  /// target (<fn Stdlib.Http.requestTarget>), so a bad Host header cannot hide it.
  let queryParams(req: Stdlib.Http.Request): List<String * String> =
    req.url |> Stdlib.Http.requestTarget |> Stdlib.Url.queryParams

  /// The value of <param key>, matched case-INSENSITIVELY, as HTTP requires: a client
  /// may send `Authorization`, `authorization` or `AUTHORIZATION` and all three mean the
  /// same header. A case-sensitive lookup reads as "the client didn't send it", which for
  /// an auth check refuses a request that was perfectly well formed.
  ///
  /// The first match wins. A repeated header is legal and means a list, which no caller
  /// here wants yet; taking the first is the same choice <fn queryParam> makes.
  let header(
    req: Stdlib.Http.Request,
    key: String)
    : Stdlib.Option.Option<String> =
    let wanted = Stdlib.String.toLowercase(key)

    req.headers
    |> Stdlib.List.filterMap(fun pair ->
      let (k, v) = pair

      if (Stdlib.String.toLowercase(k)) == wanted then
        Stdlib.Option.Option.Some v
      else
        Stdlib.Option.Option.None)
    |> Stdlib.List.head

  let queryParam(
    req: Stdlib.Http.Request,
    key: String)
    : Stdlib.Option.Option<String> =
    let found =
      (Stdlib.Http.Request.queryParams(req))
      |> Stdlib.List.filterMap(fun pair ->
        match pair with
        | (k, v) ->
          if k == key then
            Stdlib.Option.Option.Some v
          else
            Stdlib.Option.Option.None
        | _ -> Stdlib.Option.Option.None)

    match found with
    | [] -> Stdlib.Option.Option.None
    | [ v ] -> Stdlib.Option.Option.Some v
    // TODO: something else?
    | items -> Stdlib.Option.Option.Some(Stdlib.String.join(items, ","))


type Response =
  { statusCode: Int
    headers: List<String * String>
    body: Bytes }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param code> and <param response> body.
let response(body: Bytes, statusCode: Int): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = statusCode
      headers = []
      body = body }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param code>, <param response> body and
/// <param headers>.
let responseWithHeaders(
  body: Bytes,
  headers: List<String * String>,
  statusCode: Int)
  : Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = statusCode
      headers = headers
      body = body }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status 200 and <param response> body.
let success(body: Bytes): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 200
      headers = []
      body = body }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status 200, <param response> body, with the
/// Content-Type header set to "text/html; charset=utf-8".
let responseWithHtml(
  body: String,
  statusCode: Int)
  : Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "text/html; charset=utf-8") ]
      body = body |> Stdlib.Utf8.encode }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status 200, <param response> body, with the
/// Content-Type header set to "text/plain; charset=utf-8".
let responseWithText(
  text: String,
  statusCode: Int)
  : Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "text/plain; charset=utf-8") ]
      body = Stdlib.Utf8.encode(text) }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status 200, <param response> body, with the
/// Content-Type header set to "application/json".
let responseWithJson(
  json: String,
  statusCode: Int)
  : Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "application/json") ]
      body = Stdlib.Utf8.encode(json) }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{302}} status code and redirect to <param url>.
let redirectTo(url: String): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 302
      headers = [ ("Location", url) ]
      body = Stdlib.Bytes.empty }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{400}} status code and <param response> body.
let badRequest(error: String): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 400
      headers = []
      body = Stdlib.Utf8.encode(error) }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{404}} status code.
let notFound(): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 404
      headers = []
      body = Stdlib.Bytes.empty }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{401}} status code.
let unauthorized(): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 401
      headers = []
      body = Stdlib.Bytes.empty }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{403}} status code.
let forbidden(): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 403
      headers = []
      body = Stdlib.Bytes.empty }

/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{500}} status code and <param error> body.
let serverError(error: String): Stdlib.Http.Response =
  Stdlib.Http.Response
    { statusCode = 500
      headers = []
      body = Stdlib.Utf8.encode(error) }

type Cookie =
  { expires: DateTime
    maxAge: Int
    domain: String
    path: String
    secure: Bool
    httpOnly: Bool
    sameSite: String }

