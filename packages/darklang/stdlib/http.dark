module Darklang.Stdlib.Http

type Request =
  { method: String
    url: String
    headers: List<(String * String)>
    body: Bytes }


/// The path, query and fragment of <param url>, split the way a server splits a
/// request-target ({{/a/b?x=1}}), as a <type Stdlib.Url.Url> with no scheme or
/// host. A {{scheme://authority}} in front is dropped WITHOUT being checked: on
/// a server it is built from the client's Host header, so a bad one must not
/// cost the request its path. No character is refused either, so this never
/// fails, and the path is whatever followed the authority, {{//a}} included.
let requestTarget(url: String): Url.Url =
  let target =
    match String.splitFirst(url, "://") with
    | Some((scheme, rest)) when !List.any([ "/", "?", "#" ], fun d -> String.contains(scheme, d)) ->
      // The authority runs to the first `/`, `?` or `#`.
      rest
      |> String.toList
      |> List.dropWhile(fun c -> !String.contains("/?#", String.fromChar(c)))
      |> String.fromList
    | _ -> url

  let (beforeFragment, fragment) =
    match String.splitFirst(target, "#") with
    | Some((a, f)) -> (a, Option.Some(f))
    | None -> (target, Option.None)

  let (path, query) =
    match String.splitFirst(beforeFragment, "?") with
    | Some((p, q)) -> (p, Option.Some(q))
    | None -> (beforeFragment, Option.None)

  Url.Url
    { scheme = Option.None
      userinfo = Option.None
      host = Option.None
      port = Option.None
      path = path
      query = query
      fragment = fragment }


/// Parses a URL's query string into a dictionary, keeping the last value for
/// each key: <fn Stdlib.Url.queryParams> of <fn requestTarget>, through
/// {{Dict.fromEntries}}.
let parseQueryString(url: String): Dict<String, String> =
  url
  |> requestTarget
  |> Url.queryParams
  |> Dict.fromEntries


/// Parse a string of HTTP header lines (one `Name: value` per line, CR/LF or
/// LF separated) into a Dict. Duplicates resolve to the last-wins value.
/// Header names are kept verbatim — case-insensitive lookup is the caller's
/// responsibility (see `String.equalsCaseInsensitive`).
let parseHeaders(s: String): Dict<String, String> =
  s
  |> String.replaceAll("\r\n", "\n")
  |> String.split("\n")
  |> List.filterMap(fun line ->
    let trimmed = String.trim(line)
    if trimmed == "" then
      Option.None
    else
      match String.split(trimmed, ":") with
      | [] -> Option.None
      | [_] -> Option.None
      | [name, ...rest] ->
        let value = String.join(rest, ":") |> String.trim
        Option.Some((String.trim(name), value)))
  |> Dict.fromEntries


/// Percent-decoding for one query-string field: <fn Stdlib.Url.formDecode>,
/// which is <fn Stdlib.Url.percentDecode> plus `+` read as a space.
///
/// `+` is a space. That is not decoration: an HTML form doing a GET encodes a
/// space that way, so a two-word search from a form field arrives as `a+b`. The
/// substitution runs over the raw text, before decoding, so a literal `+` sent as
/// `%2B` survives it.
///
/// A `%` that does not start two hex digits is passed through as itself rather
/// than dropped. A search box is allowed to contain a percent sign.
let urlDecode(s: String): String =
  Url.formDecode(s)


module Request =
  /// The query string, decoded: <fn Stdlib.Url.queryParams> of the request's
  /// target (<fn Stdlib.Http.requestTarget>), so a bad Host header cannot hide it.
  let queryParams(req: Request): List<(String * String)> =
    req.url
    |> requestTarget
    |> Url.queryParams


  /// The value of <param key>, matched case-INSENSITIVELY, as HTTP requires: a client
  /// may send `Authorization`, `authorization` or `AUTHORIZATION` and all three mean the
  /// same header. A case-sensitive lookup reads as "the client didn't send it", which for
  /// an auth check refuses a request that was perfectly well formed.
  ///
  /// The first match wins. A repeated header is legal and means a list, which no caller
  /// here wants yet; taking the first is the same choice <fn queryParam> makes.
  let header(req: Request, key: String): Option<String> =
    let wanted = String.toLowercase(key)
    req.headers
    |> List.filterMap(fun pair ->
      let (k, v) = pair
      if String.toLowercase(k) == wanted then Option.Some(v) else Option.None)
    |> List.head


  let queryParam(req: Request, key: String): Option<String> =
    let found =
      queryParams(req)
      |> List.filterMap(fun pair ->
        match pair with
        | k, v -> if k == key then Option.Some(v) else Option.None
        | _ -> Option.None)

    match found with
    | [] -> Option.None
    | [v] -> Option.Some(v)
    // TODO: something else?
    | items -> Option.Some(String.join(items, ","))


/// An HTTP response status, 100 to 599. Build one with <fn Status.fromInt64>, or name a
/// common one (<val Status.notFound>); the field is not for constructing directly.
type Status =
  { __status: Int64 }


module Status =
  /// Returns {{Ok}} the status numbered <param n>, or {{Error}} an
  /// <type Stdlib.Math.OutOfRange> if it is not between 100 and 599.
  let fromInt64(n: Int64): Result<Status, Math.OutOfRange> =
    Math.__inRange("HTTP status", 100, 599, n, fun v -> Status { __status = v })


  /// The number of <param status>, which is what <type Stdlib.Http.Response> carries
  let toInt64(status: Status): Int64 =
    status.__status


  /// 200 OK
  val ok = Status { __status = 200 }


  /// 201 Created
  val created = Status { __status = 201 }


  /// 204 No Content
  val noContent = Status { __status = 204 }


  /// 301 Moved Permanently
  val movedPermanently = Status { __status = 301 }


  /// 302 Found
  val found = Status { __status = 302 }


  /// 303 See Other
  val seeOther = Status { __status = 303 }


  /// 304 Not Modified
  val notModified = Status { __status = 304 }


  /// 400 Bad Request
  val badRequest = Status { __status = 400 }


  /// 401 Unauthorized
  val unauthorized = Status { __status = 401 }


  /// 403 Forbidden
  val forbidden = Status { __status = 403 }


  /// 404 Not Found
  val notFound = Status { __status = 404 }


  /// 405 Method Not Allowed
  val methodNotAllowed = Status { __status = 405 }


  /// 409 Conflict
  val conflict = Status { __status = 409 }


  /// 413 Content Too Large
  val contentTooLarge = Status { __status = 413 }


  /// 429 Too Many Requests
  val tooManyRequests = Status { __status = 429 }


  /// 500 Internal Server Error
  val internalServerError = Status { __status = 500 }


  /// 503 Service Unavailable
  val serviceUnavailable = Status { __status = 503 }


  /// 504 Gateway Timeout
  val gatewayTimeout = Status { __status = 504 }


  /// Returns {{true}} for a 2xx status
  let isSuccess(status: Status): Bool =
    status.__status >= 200 && status.__status <= 299


  /// Returns {{true}} for a 3xx status
  let isRedirect(status: Status): Bool =
    status.__status >= 300 && status.__status <= 399


  /// Returns {{true}} for a 4xx status
  let isClientError(status: Status): Bool =
    status.__status >= 400 && status.__status <= 499


  /// Returns {{true}} for a 5xx status
  let isServerError(status: Status): Bool =
    status.__status >= 500 && status.__status <= 599


  /// The reason phrase RFC 9110 gives <param status>, such as {{"Not Found"}} for 404, or
  /// {{""}} for a number it does not name. A phrase is optional on the wire.
  let reason(status: Status): String =
    match status.__status with
    | 100 -> "Continue"
    | 101 -> "Switching Protocols"
    | 200 -> "OK"
    | 201 -> "Created"
    | 202 -> "Accepted"
    | 203 -> "Non-Authoritative Information"
    | 204 -> "No Content"
    | 205 -> "Reset Content"
    | 206 -> "Partial Content"
    | 300 -> "Multiple Choices"
    | 301 -> "Moved Permanently"
    | 302 -> "Found"
    | 303 -> "See Other"
    | 304 -> "Not Modified"
    | 305 -> "Use Proxy"
    | 307 -> "Temporary Redirect"
    | 308 -> "Permanent Redirect"
    | 400 -> "Bad Request"
    | 401 -> "Unauthorized"
    | 402 -> "Payment Required"
    | 403 -> "Forbidden"
    | 404 -> "Not Found"
    | 405 -> "Method Not Allowed"
    | 406 -> "Not Acceptable"
    | 407 -> "Proxy Authentication Required"
    | 408 -> "Request Timeout"
    | 409 -> "Conflict"
    | 410 -> "Gone"
    | 411 -> "Length Required"
    | 412 -> "Precondition Failed"
    | 413 -> "Content Too Large"
    | 414 -> "URI Too Long"
    | 415 -> "Unsupported Media Type"
    | 416 -> "Range Not Satisfiable"
    | 417 -> "Expectation Failed"
    | 421 -> "Misdirected Request"
    | 422 -> "Unprocessable Content"
    | 426 -> "Upgrade Required"
    | 429 -> "Too Many Requests"
    | 500 -> "Internal Server Error"
    | 501 -> "Not Implemented"
    | 502 -> "Bad Gateway"
    | 503 -> "Service Unavailable"
    | 504 -> "Gateway Timeout"
    | 505 -> "HTTP Version Not Supported"
    | _ -> ""


impl Display for Status =
  /// The status number, {{404}}
  let display(status: Status): String =
    Stdlib.display(status.__status)


impl Inspect for Status =
  /// {{Status(404)}}: the field is private, so not the record
  let inspect(status: Status): String =
    $"Status({status.__status})"


/// What a handler answers. <param statusCode> is a plain number, so any helper below takes
/// one; <fn Status.toInt64> of a <type Status> gives it for a named status.
type Response =
  { statusCode: Int64
    headers: List<(String * String)>
    body: Bytes }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param statusCode> and <param body>.
let response(statusCode: Int64, body: Bytes): Response =
  Response { statusCode = statusCode, headers = [], body = body }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param statusCode>, <param headers> and <param body>.
let responseWithHeaders(
  statusCode: Int64,
  headers: List<(String * String)>,
  body: Bytes)
  : Response =
  Response { statusCode = statusCode, headers = headers, body = body }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status 200 and <param body>.
let success(body: Bytes): Response =
  Response { statusCode = Status.toInt64(Status.ok), headers = [], body = body }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param statusCode> and <param body>, with the
/// Content-Type header set to "text/html; charset=utf-8".
let responseWithHtml(statusCode: Int64, body: String): Response =
  Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "text/html; charset=utf-8") ]
      body = body |> Utf8.encode }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param statusCode> and <param text>, with the
/// Content-Type header set to "text/plain; charset=utf-8".
let responseWithText(statusCode: Int64, text: String): Response =
  Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "text/plain; charset=utf-8") ]
      body = Utf8.encode(text) }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with HTTP status <param statusCode> and <param json>, with the
/// Content-Type header set to "application/json".
let responseWithJson(statusCode: Int64, json: String): Response =
  Response
    { statusCode = statusCode
      headers = [ ("Content-Type", "application/json") ]
      body = Utf8.encode(json) }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{302}} status code and redirect to <param url>.
let redirectTo(url: String): Response =
  Response
    { statusCode = Status.toInt64(Status.found)
      headers = [ ("Location", url) ]
      body = Bytes.empty }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{400}} status code and <param error> body.
let badRequest(error: String): Response =
  Response
    { statusCode = Status.toInt64(Status.badRequest), headers = [], body = Utf8.encode(error) }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{404}} status code.
let notFound(): Response =
  Response { statusCode = Status.toInt64(Status.notFound), headers = [], body = Bytes.empty }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{401}} status code.
let unauthorized(): Response =
  Response { statusCode = Status.toInt64(Status.unauthorized), headers = [], body = Bytes.empty }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{403}} status code.
let forbidden(): Response =
  Response { statusCode = Status.toInt64(Status.forbidden), headers = [], body = Bytes.empty }


/// Returns a <type Response> that can be returned from an HTTP handler to
/// respond with {{500}} status code and <param error> body.
let serverError(error: String): Response =
  Response
    { statusCode = Status.toInt64(Status.internalServerError)
      headers = []
      body = Utf8.encode(error) }


type Cookie =
  { expires: DateTime
    maxAge: Int64
    domain: String
    path: String
    secure: Bool
    httpOnly: Bool
    sameSite: String }

