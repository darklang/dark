/// matter.darklang.com: a MINIMAL Dark-on-Dark op-sync relay + landing page.
///
/// Run with: `dark http serve --port 8080 Darklang.Matter.router`
///
/// A relay is a DUMB store-and-forward for the op log: it holds ops and hands them back
/// out; it never folds or resolves them, so it never runs anyone's code. Once ops are
/// signed that makes it trustless -- a relay can withhold an op but can't forge one. It
/// reuses the SCM.PackageOps wire codec, so the relay's own store IS an op log like any
/// instance's. This is the first bit of "all future web in Dark".
///
/// Routes:
///   GET  /            -> a small HTML landing page
///   GET  /ping        -> "pong" (health)
///   GET  /sync/pull   -> the op log as JSON SyncOp records {id, blobHex, ts}
///   POST /sync/push   -> ingest JSON SyncOp records (stored pending; origin_ts preserved)
module Darklang.Matter

type HttpResponse = Stdlib.Http.Response
type HttpRequest = Stdlib.Http.Request
type Handler = Stdlib.HttpServer.Handler

// tiny route helpers so the handler list reads as routes, not Handler-record boilerplate.
let get (route: String) (fn: HttpRequest -> HttpResponse) : Handler =
  Handler { route = route; method = "GET"; handler = fn }

let post (route: String) (fn: HttpRequest -> HttpResponse) : Handler =
  Handler { route = route; method = "POST"; handler = fn }


let db () : String = Builtin.localDbPath ()


/// The owners with packages here, biggest first.
let owners () : List<(String * Int64)> =
  match
    Stdlib.Sqlite.query
      (db ())
      "SELECT owner, COUNT(*) n FROM locations WHERE unlisted_at IS NULL
       GROUP BY owner ORDER BY n DESC LIMIT 12"
  with
  | Ok rows ->
    rows
    |> Stdlib.List.filterMap (fun r ->
      match (Stdlib.Sqlite.textField r "owner", Stdlib.Sqlite.intField r "n") with
      | (Some o, Some n) -> Stdlib.Option.Option.Some((o, n))
      | _ -> Stdlib.Option.Option.None)
  | Error _ -> []


/// The biggest modules, which is the closest thing to "what is here" that a stranger can skim.
let topModules (limit: String) : List<(String * Int64)> =
  match
    Stdlib.Sqlite.queryP
      (db ())
      "SELECT owner || '.' || modules AS m, COUNT(*) n FROM locations
       WHERE unlisted_at IS NULL AND modules <> ''
       GROUP BY m ORDER BY n DESC LIMIT @p0"
      [ limit ]
  with
  | Ok rows ->
    rows
    |> Stdlib.List.filterMap (fun r ->
      match (Stdlib.Sqlite.textField r "m", Stdlib.Sqlite.intField r "n") with
      | (Some m, Some n) -> Stdlib.Option.Option.Some((m, n))
      | _ -> Stdlib.Option.Option.None)
  | Error _ -> []


let totalItems () : Int64 =
  Stdlib.Sqlite.scalarInt
    (db ())
    "SELECT COUNT(*) AS n FROM locations WHERE unlisted_at IS NULL"
    "n"
  |> Stdlib.Option.withDefault 0L


let publisherCount () : Int64 =
  Stdlib.Sqlite.scalarInt
    (db ())
    "SELECT COUNT(DISTINCT owner) AS n FROM locations WHERE unlisted_at IS NULL"
    "n"
  |> Stdlib.Option.withDefault 0L


