  ++ "@media(prefers-color-scheme:dark){:root{--ink:#ececf0;--dim:#9a9aa6;--line:#2a2a32;--bg:#111114;--accent:#a5b4fc;--chip:#1c1c22}}"
  ++ "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);"
  ++ "font:16px/1.65 ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}"
  ++ ".wrap{max-width:52rem;margin:0 auto;padding:4rem 1.5rem 5rem}"
  ++ "header{margin-bottom:3rem}"
  ++ ".logo{display:inline-flex;align-items:baseline;gap:0;text-decoration:none;color:inherit;font-size:1.6rem;letter-spacing:-.03em}"
  ++ ".logo b{font-weight:700;color:var(--accent)}"
  ++ ".logo span{color:var(--dim);font-weight:400}"
  ++ "h1{font-size:2.1rem;line-height:1.15;letter-spacing:-.03em;font-weight:650;margin:1.75rem 0 .75rem;max-width:30ch}"
  ++ ".lede{color:var(--dim);font-size:1.05rem;margin:0;max-width:56ch}"
  ++ "h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--dim);"
  ++ "font-weight:600;margin:3rem 0 1rem;padding-bottom:.5rem;border-bottom:1px solid var(--line)}"
  ++ ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:.6rem}"
  ++ ".card{border:1px solid var(--line);border-radius:.6rem;padding:.75rem .9rem}"
  ++ ".card .n{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.9rem;word-break:break-word}"
