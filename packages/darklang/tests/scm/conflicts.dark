/// Cases from
/// `backend/testfiles/execution/scm/conflicts.dark`, in original assertion order.
module Darklang.SCM.Tests.Conflicts

// The conflict DETECTOR, as tests rather than as a shell script grepping for English.
//
// `Darklang.SCM.Conflicts.detect` is a pure function of (local, incoming, bases), which is exactly the
// shape that wants a table of cases. The four REJECTIONS matter more than the acceptance: each is a
// false alarm the detector must not raise, and a detector that flags everything is worse than none.

module Helpers =
  let binding (name: String) (hash: String) (ts: String) : Darklang.SCM.Conflicts.Binding =
    Darklang.SCM.Conflicts.Binding
      { owner = "Zz"
        modules = "W"
        name = name
        itemType = "fn"
        hash = hash
        originTs = ts
        author = ""
        previous = Stdlib.Option.Option.None }

  /// The same, but recording what this binding REPLACED -- an edit rather than a creation.

  let editOf
    (name: String)
    (hash: String)
    (ts: String)
    (replaced: String)
    : Darklang.SCM.Conflicts.Binding =
    Darklang.SCM.Conflicts.Binding
      { owner = "Zz"
        modules = "W"
        name = name
        itemType = "fn"
        hash = hash
        originTs = ts
        author = ""
        previous = Stdlib.Option.Option.Some replaced }

  let base' (name: String) (hash: String) : Darklang.SCM.Conflicts.NameBase =
    Darklang.SCM.Conflicts.NameBase
      { owner = "Zz"; modules = "W"; name = name; baseHash = hash }

  let detectCount
    (local: List<Darklang.SCM.Conflicts.Binding>)
    (incoming: List<Darklang.SCM.Conflicts.Binding>)
    (bases: List<Darklang.SCM.Conflicts.NameBase>)
    : Int =
    Stdlib.List.length (Darklang.SCM.Conflicts.detect "yours" "theirs" local incoming bases)

module Detect =
  // BOTH sides moved a name since a recorded base -- the one case that IS a conflict.
  test bothSidesMoved =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo" ]
    |> Stdlib.Test.equal 1

  // Same hash on both sides: not a divergence at all. A re-pull, or two machines that independently
  // authored identical bytes.
  test sameHashBothSides =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "aaa" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo" ]
    |> Stdlib.Test.equal 0

  // Only LOCAL moved: our own update, and the peer is simply behind.
  test onlyLocalMoved =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "ooo" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo" ]
    |> Stdlib.Test.equal 0

  // Only INCOMING moved: an ordinary peer update of a name we never touched. Take it, quietly.
  test onlyIncomingMoved =
    Helpers.detectCount
      [ Helpers.binding "f" "ooo" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo" ]
    |> Stdlib.Test.equal 0

  // No base, and neither side says what it replaced: two independent creations of the same name. This
  // case and the one below reach the detector as the same three inputs apart from `previous`, so that
  // field is the only thing separating them; guessing instead would false-alarm on every ordinary
  // peer update.
  test independentCreations =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      []
    |> Stdlib.Test.equal 1

  // The other side of that coin: no base either, but the incoming binding NAMES ours as what it replaced.
  // Their version descends from ours, so taking it is collaborating, not a conflict.
  test incomingDescendsFromOurs =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.editOf "f" "bbb" "2026-01-03T00:00:00.000Z" "aaa" ]
      []
    |> Stdlib.Test.equal 0

  // And when OURS is the edit: still no conflict. Only both-created-from-nothing qualifies.
  test oursIsTheEdit =
    Helpers.detectCount
      [ Helpers.editOf "f" "aaa" "2026-01-02T00:00:00.000Z" "ooo" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      []
    |> Stdlib.Test.equal 0

  // A base for a DIFFERENT name says nothing about this one, so this falls to the same
  // both-created-from-nothing rule as above rather than to the base comparison.
  test baseForOtherName =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "g" "ooo" ]
    |> Stdlib.Test.equal 1

  // An incoming name we hold nothing for is a creation, not a collision.
  test incomingCreation =
    Helpers.detectCount
      []
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo" ]
    |> Stdlib.Test.equal 0

  // Two diverged names, two conflicts. (Detection is per name, not per batch.)
  test perNameDetection =
    Helpers.detectCount
      [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z"
        Helpers.binding "g" "ccc" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z"
        Helpers.binding "g" "ddd" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "ooo", Helpers.base' "g" "ooo" ]
    |> Stdlib.Test.equal 2

module BothMovedTheSameParent =
  // Two bindings that REPLACED the same hash have diverged, whatever the recorded base says. Both ops
  // carry what they replaced, so this needs no base at all.
  //
  // The case it exists for: an instance that pushed but never pulled has no bases with that source
  // (`dark connect` pushes without pulling), so its first pull records bases from what it is holding
  // right now -- its own edit included -- and its own version then reads as the base. Only the incoming
  // side looks like it moved, and it is never told it diverged while the other side is.
  //
  // No base at all: both replaced `parent`, so both moved.
  test sameParentDiverged =
    Helpers.detectCount
      [ Helpers.editOf "f" "mine" "2026-01-02T00:00:00.000Z" "parent" ]
      [ Helpers.editOf "f" "theirs" "2026-01-03T00:00:00.000Z" "parent" ]
      []
    |> Stdlib.Test.equal 1

  // A base that says only ONE side moved. Without the parent test this reads as an ordinary update
  // and the divergence is never reported at all.
  test baseSaysOneSideMoved =
    Helpers.detectCount
      [ Helpers.editOf "f" "mine" "2026-01-02T00:00:00.000Z" "parent" ]
      [ Helpers.editOf "f" "theirs" "2026-01-03T00:00:00.000Z" "parent" ]
      [ Helpers.base' "f" "mine" ]
    |> Stdlib.Test.equal 1

  // AN ORDINARY UPDATE IS STILL SILENT. They edited the version you are holding, so their `previous` is
  // your CURRENT hash while yours is whatever came before it. The two cannot match, and this is the case
  // that would have made the whole rule too noisy to want.
  test ordinaryUpdateSilent =
    Helpers.detectCount
      [ Helpers.editOf "f" "mine" "2026-01-02T00:00:00.000Z" "grandparent" ]
      [ Helpers.editOf "f" "theirs" "2026-01-03T00:00:00.000Z" "mine" ]
      [ Helpers.base' "f" "mine" ]
    |> Stdlib.Test.equal 0

  // THE SAME ORDINARY UPDATE, WITH A BASE OLDER THAN BOTH. This is the shape two machines actually
  // produce: the base was recorded at the first sync, I edited since, they pulled my edit and edited
  // on top of it. Both hashes differ from the base, so the base test alone reads it as both sides
  // having moved; their `previous` being my current hash is what says otherwise, and it has to win.
  // Lose that precedence and a colleague's ordinary edit on top of mine arrives as a conflict per
  // name, every one of them resolving to the version I would have taken anyway.
  test ordinaryUpdateOlderBase =
    Helpers.detectCount
      [ Helpers.editOf "f" "mine" "2026-01-02T00:00:00.000Z" "grandparent" ]
      [ Helpers.editOf "f" "theirs" "2026-01-03T00:00:00.000Z" "mine" ]
      [ Helpers.base' "f" "grandparent" ]
    |> Stdlib.Test.equal 0

  // Same predecessor AND same hash is not a divergence, it is the same edit arriving twice.
  test sameEditTwice =
    Helpers.detectCount
      [ Helpers.editOf "f" "same" "2026-01-02T00:00:00.000Z" "parent" ]
      [ Helpers.editOf "f" "same" "2026-01-03T00:00:00.000Z" "parent" ]
      []
    |> Stdlib.Test.equal 0

  // `None` on both sides is NOT treated as a shared parent. It also means "no predecessor recorded", so
  // firing on it would manufacture conflicts between unrelated items. The independent-creation rule below
  // still covers the genuine case, and only where there is no base.
  test noneIsNotSharedParent =
    Helpers.detectCount
      [ Helpers.binding "f" "mine" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.binding "f" "theirs" "2026-01-03T00:00:00.000Z" ]
      [ Helpers.base' "f" "older" ]
    |> Stdlib.Test.equal 1

  // One side records a predecessor and the other does not: no shared parent to have moved from.
  test oneSidedPredecessor =
    Helpers.detectCount
      [ Helpers.binding "f" "mine" "2026-01-02T00:00:00.000Z" ]
      [ Helpers.editOf "f" "theirs" "2026-01-03T00:00:00.000Z" "parent" ]
      []
    |> Stdlib.Test.equal 0

module AutoResolution =
  // The recorded winner must be the one the FOLD picks, or a recorded conflict names a winner that
  // isn't live. Later origin_ts wins.
  test laterStampRecordedWinner =
    ((Darklang.SCM.Conflicts.detect
        "yours"
        "theirs"
        [ Helpers.binding "f" "aaa" "2026-01-02T00:00:00.000Z" ]
        [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
        [ Helpers.base' "f" "ooo" ])
     |> Stdlib.List.head
     |> Stdlib.Option.map (fun c -> c.autoResolvedTo))
    |> Stdlib.Test.equal (Stdlib.Option.Option.Some "bbb")

  // ... and the older incoming loses to the newer local.
  test olderIncomingLoses =
    ((Darklang.SCM.Conflicts.detect
        "yours"
        "theirs"
        [ Helpers.binding "f" "aaa" "2026-01-04T00:00:00.000Z" ]
        [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
        [ Helpers.base' "f" "ooo" ])
     |> Stdlib.List.head
     |> Stdlib.Option.map (fun c -> c.autoResolvedTo))
    |> Stdlib.Test.equal (Stdlib.Option.Option.Some "aaa")

  // An exact stamp tie breaks by the HIGHER hash, so every instance converges on the same winner.
  test tieBreaksByHash =
    ((Darklang.SCM.Conflicts.detect
        "yours"
        "theirs"
        [ Helpers.binding "f" "aaa" "2026-01-03T00:00:00.000Z" ]
        [ Helpers.binding "f" "bbb" "2026-01-03T00:00:00.000Z" ]
        [ Helpers.base' "f" "ooo" ])
     |> Stdlib.List.head
     |> Stdlib.Option.map (fun c -> c.reason))
    |> Stdlib.Test.equal (Stdlib.Option.Option.Some "tie-break-by-hash")

// `incomingWins` itself is pinned in `lww.dark` (the Dark side) and `Lww.Tests.fs` (the F# twin);
// a third copy of the table here only gave the two real ones a place to drift from.

module ConflictId =
  // SORTED before hashing, so the id doesn't depend on which side happened to be local. Without this,
  // the same divergence gets two ids on two machines and neither can ack the other's.
  test idSortedBeforeHashing =
    Darklang.SCM.Conflicts.conflictId "Zz" "W" "f" [ "aaa", "bbb" ]
    |> Stdlib.Test.equal
      (Darklang.SCM.Conflicts.conflictId "Zz" "W" "f" [ "bbb", "aaa" ])

  // Different location, different id.
  test locationChangesId =
    (Darklang.SCM.Conflicts.conflictId "Zz" "W" "f" [ "aaa", "bbb" ]) ==
     (Darklang.SCM.Conflicts.conflictId "Zz" "W" "g" [ "aaa", "bbb" ])
    |> Stdlib.Test.equal false

  // Short enough to type, long enough to not collide in practice.
  test idLength =
    Stdlib.String.length (Darklang.SCM.Conflicts.conflictId "Zz" "W" "f" [ "aaa", "bbb" ])
    |> Stdlib.Test.equal 8

module StringOrdering =
  test stringGt =
    Stdlib.Test.all
      [ Darklang.SCM.Conflicts.stringGt "b" "a" |> Stdlib.Test.equal true
        Darklang.SCM.Conflicts.stringGt "a" "b" |> Stdlib.Test.equal false
        Darklang.SCM.Conflicts.stringGt "a" "a" |> Stdlib.Test.equal false ]

  // ISO stamps compare lexically, which is the whole reason the fold can order by them as strings.
  test isoStampsLexical =
    Darklang.SCM.Conflicts.stringGt "2026-01-03T00:00:00.000Z" "2026-01-02T23:59:59.999Z"
    |> Stdlib.Test.equal true

module Chunking =
  // Nothing on the detection path may build an unbounded IN-list: an over-cap statement ERRORS, and
  // every caller turns an error into [], which reads downstream as "no conflict".
  test noUnboundedInList =
    Stdlib.Test.all
      [ Stdlib.List.length (Darklang.SCM.Conflicts.inChunks [])
        |> Stdlib.Test.equal 0
        Stdlib.List.length (Darklang.SCM.Conflicts.inChunks [ "a", "b", "c" ])
        |> Stdlib.Test.equal 1 ]

  // A list longer than the chunk size splits, and splits losslessly.
  test chunksSplitLosslessly =
    Stdlib.Test.all
      [ Stdlib.List.length
          (Stdlib.List.flatten
            (Darklang.SCM.Conflicts.inChunks
              (Stdlib.List.map (Stdlib.List.range 1 2500) (fun i -> Stdlib.toString i))))
        |> Stdlib.Test.equal 2500
        ((Stdlib.List.length
            (Darklang.SCM.Conflicts.inChunks
              (Stdlib.List.map (Stdlib.List.range 1 2500) (fun i -> Stdlib.toString i)))) > 1)
        |> Stdlib.Test.equal true ]

module Placeholders =
  test inPlaceholders =
    Stdlib.Test.all
      [ Darklang.SCM.Conflicts.inPlaceholders [] |> Stdlib.Test.equal ""
        Darklang.SCM.Conflicts.inPlaceholders [ "x" ] |> Stdlib.Test.equal "@p0"
        Darklang.SCM.Conflicts.inPlaceholders [ "x", "y", "z" ]
        |> Stdlib.Test.equal "@p0, @p1, @p2" ]

module Fqn =
  test fqn =
    Darklang.SCM.Conflicts.fqn "Zz" "W" "f" |> Stdlib.Test.equal "Zz.W.f"

  // A top-level item has no module segment, and joining an empty one would give "Zz..f".
  test topLevelFqn =
    Stdlib.Test.all
      [ Darklang.SCM.Conflicts.fqn "Zz" "" "f" |> Stdlib.Test.equal "Zz.f"
        Darklang.SCM.Conflicts.bindingKey "Zz" "W" "f" |> Stdlib.Test.equal "Zz/W/f" ]

module OrderPreservingDedup =
  // `Stdlib.List.unique` and `uniqueBy` both SORT (their own docs say the order is not maintained), so
  // neither can dedup a sequence whose order is the point. `PackageOps.branchHashHistoryFor` returns a
  // name's versions oldest-first and is what `dark undo` steps through; sorting it there swaps the
  // sequence for lexicographic hash order, which looks plausible and sends undo to the wrong version.
  //
  // Pinning the stdlib behaviour, so the day either of these starts preserving order the call sites that
  // worked around it get revisited rather than silently double-correcting.
  test uniqueSorts =
    Stdlib.Test.all
      [ Stdlib.List.unique [ "c", "a", "b" ] |> Stdlib.Test.equal [ "a", "b", "c" ]
        Stdlib.List.uniqueBy [ "c", "a", "b" ] (fun x -> x)
        |> Stdlib.Test.equal [ "a", "b", "c" ] ]

  // The order-preserving shape, which is what an authoring sequence needs.
  test orderPreservingDedup =
    Stdlib.List.fold
      [ "c", "a", "b", "a" ]
      []
      (fun acc h -> if Stdlib.List.member acc h then acc else Stdlib.List.pushBack acc h)
    |> Stdlib.Test.equal [ "c", "a", "b" ]
