module Darklang.SCM.Tests.BranchIdentity

// The main-branch constant must match the branch ID a process reports on main.
// A mismatch silently sends SCM operations down the branch path. Run the process
// with an explicit main branch so the caller cannot change the answer.
let currentIsMain () : Bool =
  Darklang.SCM.PackageOps.currentBranch () == Darklang.SCM.Branch.mainBranchId

test mainIdIsCurrentBranch =
  let defaults = Stdlib.Test.Process.defaults ()
  let options = { defaults with branch = Some Darklang.SCM.Branch.mainBranchId }
  match Stdlib.Test.Process.run options currentIsMain () with
  | Error message -> Stdlib.Test.fail message
  | Ok output -> output.result |> Stdlib.Test.equal (Ok true)

// An ID is not a NAME. That is the property the type carries: while an id spells the same as a name,
// passing one where the other belongs is correct by accident. With a uuid, anything printing the id
// where it means the name reads as a raw uuid, visibly.
test idIsNotName =
  (Stdlib.toString Darklang.SCM.Branch.mainBranchId == Darklang.SCM.Branch.mainBranchName)
  |> Stdlib.Test.equal false

// ...and it is a Uuid, which is a different TYPE from a name, not merely a differently-shaped string.
test idIsUuid =
  Stdlib.String.length (Stdlib.toString Darklang.SCM.Branch.mainBranchId)
  |> Stdlib.Test.equal 36

// Main is not a row in `branches`: it needs no registration, so `get` finds nothing for it.
test mainHasNoRow =
  Darklang.SCM.Branch.get Darklang.SCM.Branch.mainBranchId
  |> Stdlib.Test.equal Stdlib.Option.Option.None

// A branch id that isn't main has no overlay ops on main, and asking about main yields none either.
test mainHasNoOverlayOps =
  Darklang.SCM.PackageOps.visibleParams Darklang.SCM.Branch.mainBranchId
  |> Stdlib.Test.equal []

// Main still DISPLAYS as "main". It has no `branches` row, so the name lookup has to know about it
// specially or it falls back to showing the id.
test mainDisplaysAsMain =
  Darklang.SCM.PackageOps.branchName Darklang.SCM.Branch.mainBranchId
  |> Stdlib.Test.equal "main"

// And it resolves by name, from both boundaries, since neither the `branches` table nor an id-prefix
// search can find a branch that has no row.
test mainResolvesByName =
  Stdlib.Test.all
    [ Darklang.Cli.Branch.lookupRef "main"
      |> Stdlib.Test.equal
        (Stdlib.Option.Option.Some Darklang.SCM.Branch.mainBranchId)
      Darklang.Cli.Branch.lookupRef (Stdlib.toString Darklang.SCM.Branch.mainBranchId)
      |> Stdlib.Test.equal
        (Stdlib.Option.Option.Some Darklang.SCM.Branch.mainBranchId) ]
