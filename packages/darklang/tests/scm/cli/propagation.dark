/// Callers following an edit: when you save a new version of a function, everything that calls it
/// is repointed at the new version ("follows"), on main, on a branch, and through merges.
/// The helpers are in `helpers.dark`.
module Darklang.SCM.Tests.Cli


test savingAFunctionRepointsItsCallers =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.helper", "1")
      save(dark, "Tests.App.caller", "(): Int64 = Tests.App.helper() + 10")
      commit(dark, "base")

      says(
        dark,
        [ "fn", "Tests.App.helper", "(): Int64 = 2" ],
        "Tests.App.caller follows",
        "the save names the caller it repointed")
      same(draft(dark), [ "followed Tests.App.caller", "updated Tests.App.helper" ], "status marks the caller as following")
      evals(dark, "Tests.App.caller()", "12", "the caller runs the new helper")

      commit(dark, "edit")
      draftIsEmpty(dark, "both commit together") ])


test callersOfCallersFollowOnABranchAndThroughTheMerge =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() + 10")
      save(dark, "Tests.App.h", "(): Int64 = Tests.App.g() + 100")
      commit(dark, "base: h calls g, g calls f")

      switch(dark, "feat")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.h()", "112", "h, two calls away, runs the new f")
      same(
        draft(dark),
        [ "followed Tests.App.g", "followed Tests.App.h", "updated Tests.App.f" ],
        "both callers follow")
      commit(dark, "feat changes f")

      switch(dark, "main")
      evals(dark, "Tests.App.h()", "111", "main still runs the old f")
      merge(dark, "feat")
      evals(dark, "Tests.App.g()", "12", "after the merge g follows on main")
      evals(dark, "Tests.App.h()", "112", "and so does h") ])


test editsOnABranchOffABranchFollowAllTheWayToMain =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() + 10")
      commit(dark, "base: g calls f")

      switch(dark, "feat")
      save(dark, "Tests.App.x", "(): Int64 = Tests.App.g() + 100")
      commit(dark, "feat adds x calling g")

      switch(dark, "sub")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "12", "on sub, g follows the new f")
      evals(dark, "Tests.App.x()", "112", "and so does feat's x")
      same(
        draft(dark),
        [ "followed Tests.App.g", "followed Tests.App.x", "updated Tests.App.f" ],
        "both callers are in sub's draft")
      commit(dark, "sub changes f")

      switch(dark, "feat")
      merge(dark, "sub")
      evals(dark, "Tests.App.x()", "112", "merged into feat, x still follows")
      draftIsEmpty(dark, "with nothing left in feat's draft")

      switch(dark, "main")
      merge(dark, "feat")
      evals(dark, "Tests.App.f()", "2", "on main, f is the new version")
      evals(dark, "Tests.App.g()", "12", "g follows it")
      evals(dark, "Tests.App.x()", "112", "and so does x") ])


// Switching a function back to a version it had before must still move its callers each time.
test aCallerFollowsAFunctionChangedBackAndForthOnMain =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() * 10")
      commit(dark, "base: g calls f")

      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "f is 2")
      saveNumber(dark, "Tests.App.f", "1")
      evals(dark, "Tests.App.g()", "10", "f is back to 1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "f is 2 again")

      commit(dark, "f is 2")
      saveNumber(dark, "Tests.App.f", "1")
      commit(dark, "f is 1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "the same back and forth across commits")
      same(draft(dark), [ "followed Tests.App.g", "updated Tests.App.f" ], "g follows in the draft") ])


test aCallerFollowsAFunctionChangedBackAndForthOnABranch =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() * 10")
      commit(dark, "base: g calls f")

      switch(dark, "feat")
      saveNumber(dark, "Tests.App.f", "2")
      saveNumber(dark, "Tests.App.f", "1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "after 2, 1, 2, g runs f = 2")
      same(draft(dark), [ "updated Tests.App.f", "updated Tests.App.g" ], "both are in the branch's draft")
      commit(dark, "feat changes f")

      switch(dark, "main")
      merge(dark, "feat")
      evals(dark, "Tests.App.f()", "2", "the merge lands f = 2")
      evals(dark, "Tests.App.g()", "20", "and g follows it")
      draftIsEmpty(dark, "with main's draft empty") ])
