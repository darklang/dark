/// Callers following an edit: when you save a new version of a function, everything that calls it
/// is repointed at the new version ("follows"), on main, on a branch, across owners and through
/// merges, and what `status` and `constraints` say about callers left behind.
/// The helpers are in `helpers.dark`.
module Darklang.SCM.Tests.Cli

test savingAFunctionRepointsItsCallers =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.helper", "1")
      save(dark, "Tests.App.caller", "(): Int64 = Tests.App.helper() + 10")
      evals(dark, "Tests.App.caller()", "11", "new code runs before any commit")
      commit(dark, "base")
      draftIsEmpty(dark, "the commit empties the draft")
      says(
        dark,
        [ "fn", "Tests.App.helper", "(): Int64 = 2" ],
        "Tests.App.caller follows",
        "the save names the caller it repointed")

      same(
        draft(dark),
        [ "followed Tests.App.caller", "updated Tests.App.helper" ],
        "status marks the caller as following")

      evals(dark, "Tests.App.caller()", "12", "the caller runs the new helper")
      commit(dark, "edit")
      draftIsEmpty(dark, "both commit together")
      evals(dark, "Tests.App.caller()", "12", "and the new answer stays") ])


test callersOfCallersFollowOnABranchAndThroughTheMerge =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() + 10")
      save(dark, "Tests.App.h", "(): Int64 = Tests.App.g() + 100")
      commit(dark, "base: h calls g, g calls f")
      switch(dark, "feat")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.h()", "112", "h, two calls away, runs the new f")
      same(
        draft(dark),
        [ "followed Tests.App.g"
          "followed Tests.App.h"
          "updated Tests.App.f" ],
        "both callers follow")

      commit(dark, "feat changes f")
      switch(dark, "main")
      evals(dark, "Tests.App.h()", "111", "main still runs the old f")
      merge(dark, "feat")
      evals(dark, "Tests.App.g()", "12", "after the merge g follows on main")
      evals(dark, "Tests.App.h()", "112", "and so does h") ])


test editsOnABranchOffABranchFollowAllTheWayToMain =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() + 10")
      commit(dark, "base: g calls f")
      switch(dark, "feat")
      save(dark, "Tests.App.x", "(): Int64 = Tests.App.g() + 100")
      commit(dark, "feat adds x calling g")
      switch(dark, "sub")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "12", "on sub, g follows the new f")
      evals(dark, "Tests.App.x()", "112", "and so does feat's x")
      same(
        draft(dark),
        [ "followed Tests.App.g"
          "followed Tests.App.x"
          "updated Tests.App.f" ],
        "both callers are in sub's draft")

      commit(dark, "sub changes f")
      switch(dark, "feat")
      merge(dark, "sub")
      evals(dark, "Tests.App.x()", "112", "merged into feat, x still follows")
      draftIsEmpty(dark, "with nothing left in feat's draft")
      switch(dark, "main")
      merge(dark, "feat")
      evals(dark, "Tests.App.f()", "2", "on main, f is the new version")
      evals(dark, "Tests.App.g()", "12", "g follows it")
      evals(dark, "Tests.App.x()", "112", "and so does x") ])


// Switching a function back to a version it had before must still move its callers each time.
test aCallerFollowsAFunctionChangedBackAndForthOnMain =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() * 10")
      commit(dark, "base: g calls f")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "f is 2")
      saveNumber(dark, "Tests.App.f", "1")
      evals(dark, "Tests.App.g()", "10", "f is back to 1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "f is 2 again")
      commit(dark, "f is 2")
      saveNumber(dark, "Tests.App.f", "1")
      commit(dark, "f is 1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(
        dark,
        "Tests.App.g()",
        "20",
        "the same back and forth across commits")

      same(
        draft(dark),
        [ "followed Tests.App.g", "updated Tests.App.f" ],
        "g follows in the draft") ])


test aCallerFollowsAFunctionChangedBackAndForthOnABranch =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.f", "1")
      save(dark, "Tests.App.g", "(): Int64 = Tests.App.f() * 10")
      commit(dark, "base: g calls f")
      switch(dark, "feat")
      saveNumber(dark, "Tests.App.f", "2")
      saveNumber(dark, "Tests.App.f", "1")
      saveNumber(dark, "Tests.App.f", "2")
      evals(dark, "Tests.App.g()", "20", "after 2, 1, 2, g runs f = 2")
      same(
        draft(dark),
        [ "updated Tests.App.f", "updated Tests.App.g" ],
        "both are in the branch's draft")

      commit(dark, "feat changes f")
      switch(dark, "main")
      merge(dark, "feat")
      evals(dark, "Tests.App.f()", "2", "the merge lands f = 2")
      evals(dark, "Tests.App.g()", "20", "and g follows it")
      draftIsEmpty(dark, "with main's draft empty") ])


// One save that edits a function and its callee: the caller follows both, and is not left reading
// as still on the old version. It was, because each follow copied the caller's previous callee
// rows, and the first follow ran before the second had moved the caller. The package build's
// incremental path saves each changed file this way, so it left the dev store with callers a full
// reload does not have.
test savingAFunctionAndItsCalleeTogetherLeavesNoStaleCaller =
  scenario(fun dark ->
    let path = Cli.Tests.Instance.home(dark) + "/pair.dark"
    let write(source: String): Stdlib.Test.Result =
      match Stdlib.Cli.File.writeAtomic(path, source) with
      | Ok(_) -> Stdlib.Test.Result.Pass
      | Error(e) ->
        Stdlib.Test.fail($"could not write {path}: {Stdlib.display(e)}")

    [ write("let b(x: Int64): Int64 = x + 1\nlet a(x: Int64): Int64 = b(x) * 2")
      run(dark, [ "import", path, "/Tests.Pair" ])
      save(dark, "Tests.App.c", "(x: Int64): Int64 = Tests.Pair.a(x) + 100")
      commit(dark, "base")
      write(
        "let b(x: Int64): Int64 = x + 10\nlet a(x: Int64): Int64 = b(x) * 3")

      run(dark, [ "import", path, "/Tests.Pair" ])
      evals(dark, "Tests.App.c(1)", "133", "the caller runs both edits")
      same(staleCallers(dark), 0, "and nothing reads as on an old version") ])


/// A helper return-type change must expose an incompatible saved Display.
test savedDisplayMustMatchTheChangedReturnType = scenario(fun dark ->
  let caller = "(n: Int64): String = $\"<{Tests.ReturnChange.h(n)}>\""
  [ save(dark, "Tests.ReturnChange.h", "(n: Int64): String = $\"{n}\"")
    save(dark, "Tests.ReturnChange.a", caller)
    run(dark, [ "typecheck", "Tests.ReturnChange" ])
    save(
      dark,
      "Tests.ReturnChange.h",
      "(n: Int64): Result<String, String> = Ok($\"{n}\")")

    (let (code, _, audit) = exec(dark, [ "typecheck", "Tests.ReturnChange" ])
     Stdlib.Test.all(
       [ same(code, 1, "the stale implementation fails the audit")
         Cli.Tests.Instance.says(
           audit,
           "Tests.ReturnChange.a",
           "the audit names the caller")

         Cli.Tests.Instance.says(
           audit,
           "expected String",
           "the saved Display expects String")

         Cli.Tests.Instance.says(
           audit,
           "Result",
           "the helper now returns Result") ]))

    save(dark, "Tests.ReturnChange.a", caller)
    run(dark, [ "typecheck", "Tests.ReturnChange" ])
    evals(
      dark,
      "Tests.ReturnChange.a(1)",
      "<Ok(1)>",
      "the re-saved caller uses Result's Display") ])


/// A cascade on a branch finds callers through the branch's own version of a name, so it never
/// replaces what the branch rebound with main's version.
test aCascadeOnABranchLeavesWhatTheBranchReboundAlone =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.base", "20")
      save(dark, "Tests.App.caller", "(): Int64 = Tests.App.base()")
      commit(dark, "base")
      switch(dark, "feat")
      saveNumber(dark, "Tests.App.caller", "777")
      commit(dark, "branch caller")
      saveNumber(dark, "Tests.App.base", "30")
      evals(
        dark,
        "Tests.App.caller()",
        "777",
        "the branch keeps its own caller")

      evalsOn(
        dark,
        "main",
        "Tests.App.caller()",
        "20",
        "and main still calls its own base") ])


/// Callers in other owners follow an edit too, every name that holds the same code follows, and an
/// undo of the dependency takes them all back.
test callersInEveryOwnerFollowAnEditAndItsUndo =
  let body = "(): Int64 = Vendor.Auto.dep() + 100"
  scenario(fun dark ->
    [ saveNumber(dark, "Vendor.Auto.dep", "1")
      save(dark, "Tests.Auto.x", body)
      save(dark, "Tests.Auto.y", body)
      save(dark, "Other.Auto.top", "(): Int64 = Tests.Auto.x() + 1000")
      saveNumber(dark, "Vendor.Auto.dep", "2")
      evals(dark, "Tests.Auto.x()", "102", "the first caller follows")

      evals(
        dark,
        "Tests.Auto.y()",
        "102",
        "and so does a name holding the same code")

      evals(
        dark,
        "Other.Auto.top()",
        "1102",
        "and a caller of the caller, in another owner")

      says(
        dark,
        [ "undo", "Vendor.Auto.dep" ],
        "back on the version",
        "the dependency can be put back")

      evals(dark, "Tests.Auto.x()", "101", "the caller follows the undo")
      evals(dark, "Tests.Auto.y()", "101", "and so does the other name")
      evals(dark, "Other.Auto.top()", "1101", "and the caller of the caller")
      saveNumber(dark, "Vendor.Auto.dep", "2")
      evals(dark, "Tests.Auto.x()", "102", "saving it again follows again")
      evals(dark, "Other.Auto.top()", "1102", "all the way up") ])


/// A caller in another owner follows an edit made on a branch only on that branch.
test aCallerInAnotherOwnerFollowsABranchEditOnlyOnTheBranch =
  scenario(fun dark ->
    [ saveNumber(dark, "Vendor.App.dep", "41")
      save(dark, "Tests.App.caller", "(): Int64 = Vendor.App.dep() + 1")
      commit(dark, "base")
      switch(dark, "feat")
      saveNumber(dark, "Vendor.App.dep", "51")
      evals(
        dark,
        "Tests.App.caller()",
        "52",
        "on the branch the caller follows")

      evalsOn(
        dark,
        "main",
        "Tests.App.caller()",
        "42",
        "main's caller does not")

      evalsOn(
        dark,
        "main",
        "Vendor.App.dep()",
        "41",
        "nor main's dependency") ])


/// Going back to a version committed earlier is a change of its own: it takes effect, sits in the
/// draft, and survives the commit, even though the same code was bound before.
test goingBackToAnEarlierCommittedVersionTakesEffect =
  scenario(fun dark ->
    [ switch(dark, "feat")
      saveNumber(dark, "Tests.App.b", "611")
      commit(dark, "611")
      saveNumber(dark, "Tests.App.b", "622")
      commit(dark, "622")
      evals(dark, "Tests.App.b()", "622", "the second version runs")
      saveNumber(dark, "Tests.App.b", "611")
      evals(
        dark,
        "Tests.App.b()",
        "611",
        "going back to the first takes effect")

      same(
        draft(dark),
        [ "updated Tests.App.b" ],
        "the draft holds it as a change")

      commit(dark, "back to 611")
      evals(dark, "Tests.App.b()", "611", "and it survives the commit") ])


/// `status` counts the constraints this draft caused apart from the ones that stood already, so an
/// edit isn't blamed for what was there before it.
test statusSaysWhichConstraintsTheDraftCausedAndWhichStood =
  scenario(fun dark ->
    [ save(dark, "Tests.App.dep", "(x: Int64): Int64 = x + 1")
      save(dark, "Tests.App.use", "(x: Int64): Int64 = Tests.App.dep(x)")
      commit(dark, "base")
      run(dark, [ "val", "Tests.App.dep", "5" ])
      says(
        dark,
        [ "status" ],
        "1 from this draft",
        "a value can't be called, so the caller is left behind, by this draft")

      commit(dark, "dep is a value")
      says(
        dark,
        [ "status" ],
        "standing constraint",
        "on a clean tree it is a standing one")

      saveNumber(dark, "Tests.App.other", "1")
      says(
        dark,
        [ "status" ],
        "none from this draft",
        "an unrelated draft is not blamed for it")

      save(dark, "Tests.App.dep", "(x: Int64): Int64 = x + 3")
      commit(dark, "dep is a fn again")
      doesNotSay(
        dark,
        [ "constraints" ],
        "Tests.App.use",
        "making it a fn again repoints the caller and clears the constraint") ])


/// `--as` takes one value and `--why` takes the rest of the line; neither is read as an id.
test constraintFlagValuesAreNotReadAsIds =
  scenario(fun dark ->
    [ says(
        dark,
        [ "constraints", "resolve", "zzzzzzzz", "--as", "repoint" ],
        "zzzzzzzz",
        "the id is reported")

      doesNotSay(
        dark,
        [ "constraints", "resolve", "zzzzzzzz", "--as", "repoint" ],
        "matching \"repoint\"",
        "and the --as value is not")

      doesNotSay(
        dark,
        [ "ack", "zzzzzzzz", "--why", "not", "now" ],
        "matching \"not\"",
        "an unquoted --why reason is not read as an id")

      doesNotSay(
        dark,
        [ "ack", "zzzzzzzz", "--why", "not", "now" ],
        "matching \"now\"",
        "nor is the rest of it") ])
