/// `dark commit`: saving into the draft and committing it, on main and on a branch.
/// The helpers are in `helpers.dark`.
module Darklang.SCM.Tests.Cli

test aSaveIsADraftUntilItIsCommitted =
  scenario(fun dark ->
    [ draftIsEmpty(dark, "a fresh store has an empty draft")
      saveNumber(dark, "Tests.App.a", "1")
      says(
        dark,
        [ "status" ],
        "draft: 1 item changed",
        "status counts the save")

      same(draft(dark), [ "new Tests.App.a" ], "status --json names it as new")
      evals(dark, "Tests.App.a()", "1", "a saved function runs straight away")
      same(commits(dark), [], "but nothing is committed yet")
      says(
        dark,
        [ "commit", "save a", "-y" ],
        "commit ",
        "commit prints the commit it made")

      draftIsEmpty(dark, "the commit took the whole draft")
      says(dark, [ "status" ], "clean", "status says so")
      same(commits(dark), [ "save a" ], "the commit is in history")

      same(
        commitMessages(dark, [ "log", "--json" ]),
        [ "save a" ],
        "on main, log lists the commits")

      evals(dark, "Tests.App.a()", "1", "the committed version runs") ])


test aCommitOnABranchStaysOnTheBranch =
  scenario(fun dark ->
    [ switch(dark, "feat")
      onBranch(dark, "feat", "status names the branch")
      saveNumber(dark, "Tests.App.a", "1")
      same(
        draft(dark),
        [ "new Tests.App.a" ],
        "the save is in the branch's draft")

      same(draftOn(dark, "main"), [], "and not in main's")
      commit(dark, "on feat")
      draftIsEmpty(dark, "the commit took the branch's draft")
      says(
        dark,
        [ "log" ],
        "SetName Tests.App.a",
        "on a branch, log lists the branch's ops")

      same(commits(dark), [ "on feat" ], "the branch has the commit")
      same(commitsOnMain(dark), [], "main does not")
      notFoundOn(
        dark,
        "main",
        "Tests.App.a()",
        "main cannot run the branch's work") ])


test savingANameTwiceCommitsOnlyTheLastVersion =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.a", "1")
      commit(dark, "one")
      saveNumber(dark, "Tests.App.a", "2")
      saveNumber(dark, "Tests.App.a", "3")
      same(
        draft(dark),
        [ "updated Tests.App.a" ],
        "two saves of one name are one change")

      commit(dark, "two")
      evals(dark, "Tests.App.a()", "3", "the last save is what was committed")
      same(
        timesNewestCommitSets(dark, "Tests.App.a"),
        1,
        "the commit sets the name once")

      says(
        dark,
        [ "show", newestCommit(dark) ],
        "follows",
        "show names the commit it follows")

      run(dark, [ "undo", "Tests.App.a" ])
      evals(
        dark,
        "Tests.App.a()",
        "1",
        "undo skips the version that was never committed") ])


test commitIncludeTakesWhatTheNameNeedsAndJsonOnlyPreviews =
  scenario(fun dark ->
    [ saveNumber(dark, "Tests.App.helper", "1")
      save(dark, "Tests.App.caller", "(): Int64 = Tests.App.helper() + 1")
      saveNumber(dark, "Tests.App.other", "3")

      // `--json` without `-y` only previews.
      same(
        field(
          json(
            dark,
            [ "commit", "dry", "--include=Tests.App.caller", "--json" ]),
          "committed"),
        Stdlib.AltJson.Json.Bool(false),
        "commit --json without -y does not commit")

      same(
        draft(dark),
        [ "new Tests.App.caller"
          "new Tests.App.helper"
          "new Tests.App.other" ],
        "the draft is untouched")

      same(commits(dark), [], "and so is history")
      refuses(
        dark,
        [ "commit", "nope", "--include=Tests.App.absent", "-y" ],
        "--include names things not in your draft: Tests.App.absent",
        "a name the draft does not hold is refused")

      same(commits(dark), [], "and the refusal commits nothing")
      saysAll(
        dark,
        [ "commit", "caller", "--include=Tests.App.caller", "-y" ],
        [ "also committed (needed by what you named): Tests.App.helper"
          "still in the draft" ],
        "a partial commit names the dependency it took and says what it left behind")

      same(
        draft(dark),
        [ "new Tests.App.other" ],
        "the caller took its helper with it; the rest stayed")

      same(commits(dark), [ "caller" ], "one commit")
      evals(dark, "Tests.App.caller()", "2", "and the committed caller runs")

      // a name edited twice in one draft has two namings, and --include= takes both
      saveNumber(dark, "Tests.App.twice", "3001")
      saveNumber(dark, "Tests.App.twice", "3002")
      run(dark, [ "commit", "twice", "--include=Tests.App.twice", "-y" ])
      same(
        draft(dark),
        [ "new Tests.App.other" ],
        "only the unnamed item is still in the draft")

      evals(
        dark,
        "Tests.App.twice()",
        "3002",
        "and the later edit is committed") ])


test aTypeErrorIsSavedButRefusesToCommit =
  scenario(fun dark ->
    [ says(
        dark,
        [ "fn", "Tests.App.bad", "(): Int64 = \"text\"" ],
        "type error",
        "the save warns")

      same(draft(dark), [ "new Tests.App.bad" ], "but the function is saved")
      refuses(
        dark,
        [ "commit", "bad", "-y" ],
        "cannot commit",
        "commit refuses it")

      draftIsNotEmpty(dark, "the draft is still there")
      same(commits(dark), [], "and nothing was committed")
      run(dark, [ "commit", "bad", "-y", "--allow-type-errors" ])
      draftIsEmpty(dark, "--allow-type-errors commits it anyway")
      same(commits(dark), [ "bad" ], "as one commit") ])


/// Write <param text> to <param path>, as a step.
let writeSource(path: String, text: String): Stdlib.Test.Result =
  match Stdlib.Cli.File.writeText(path, text) with
  | Ok(_) -> Stdlib.Test.Result.Pass
  | Error(e) -> Stdlib.Test.fail($"could not write {path}: {Stdlib.inspect(e)}")


/// The first 8 characters of a commit id, which `show` prints as part of what a commit follows.
let shortId(id: String): String =
  Stdlib.String.first(id, 8)


test aCommitFollowsTheOneBeforeIt = scenario(fun dark ->
  let firstSteps =
    [ saveNumber(dark, "Tests.Chain.one", "1"), commit(dark, "chain one") ]

  let first = newestCommit(dark)
  let secondSteps =
    [ saveNumber(dark, "Tests.Chain.two", "2"), commit(dark, "chain two") ]

  let second = newestCommit(dark)
  Stdlib.List.flatten(
    [ firstSteps
      secondSteps
      [ if first != "" && first != second then
          Stdlib.Test.Result.Pass
        else
          Stdlib.Test.fail(
            $"two commits of different work get different ids: {first} {second}")

        says(
          dark,
          [ "show", second ],
          $"follows {shortId(first)}",
          "the second commit follows the first") ] ]))


/// Commits made out of order still chain: C follows A, the commit made just before it, though A
/// holds a name saved before B's.
test aCommitFollowsTheCommitMadeBeforeItWhateverItHolds = scenario(fun dark ->
  let setup =
    [ saveNumber(dark, "Tests.Chain.a", "1")
      saveNumber(dark, "Tests.Chain.b", "2")
      run(dark, [ "commit", "B", "--include=Tests.Chain.b", "-y" ])
      run(dark, [ "commit", "A", "--include=Tests.Chain.a", "-y" ]) ]

  let a = newestCommit(dark)
  let more = [ saveNumber(dark, "Tests.Chain.c", "3"), commit(dark, "C") ]
  let c = newestCommit(dark)
  Stdlib.List.flatten(
    [ setup
      more
      [ same(
          commits(dark),
          [ "C", "A", "B" ],
          "the commits are in the order they were made")

        says(dark, [ "show", c ], $"follows {shortId(a)}", "C follows A") ] ]))


test aCommitOnAPipeAsksAndNeedsAMessage = scenario(fun dark ->
  [ saveNumber(dark, "Tests.CommitGate.f", "11")
    // no -y, and stdin is a pipe: nobody can answer the prompt, so the answer is no
    refuses(
      dark,
      [ "commit", "gated" ],
      "Commit not done: no terminal to confirm at",
      "nothing commits without an answer")

    says(dark, [ "status" ], "1 item changed", "and the draft is still there")
    refuses(
      dark,
      [ "commit", "-y" ],
      "a commit needs a message",
      "an empty message is refused, -y or not")

    says(
      dark,
      [ "commit", "gated for real", "-y" ],
      "-- 2 ops",
      "with a message and -y it lands")

    same(commits(dark), [ "gated for real" ], "as one commit") ])


/// The refusal names the item and the error, and only live items are checked: once the broken
/// function is fixed, the draft commits without the override, though the broken version is still
/// in the draft's history.
test aTypeErrorRefusalNamesTheItemAndAFixUnblocksIt = scenario(fun dark ->
  let path = Cli.Tests.Instance.home(dark) + "/arity-gate.dark"
  let source =
    "type Wrapped = Wrap(Int64 * String)\n\nlet bad(value: Wrapped): Wrapped =\n  match value with\n  | Wrap((number, text)) -> Wrapped.Wrap(number, text)\n"

  [ writeSource(path, source)
    says(
      dark,
      [ "import", path, "Tests.ArityGate" ],
      "Type check failed",
      "saving reports the error rather than hiding it")

    saysAll(
      dark,
      [ "commit", "should not land", "-y" ],
      [ "cannot commit", "expects 1 field", "Tests.ArityGate.bad" ],
      "the refusal names the item and the error")

    says(
      dark,
      [ "commit", "taking it", "-y", "--allow-type-errors" ],
      "-- 4 ops",
      "--allow-type-errors takes it")

    says(
      dark,
      [ "fn"
        "Tests.ArityGate.bad2"
        "(x: Int64): Int64 = Stdlib.String.length(x)" ],
      "[TypeMismatch]",
      "a new type error is saved, with its error")

    refuses(
      dark,
      [ "commit", "nope", "-y" ],
      "cannot commit",
      "a new type error refuses")

    save(dark, "Tests.ArityGate.bad2", "(x: Int64): Int64 = x")
    commit(dark, "fixed, no override")
    same(
      commits(dark),
      [ "fixed, no override", "taking it" ],
      "the fixed draft committed without the override") ])


test aCommitRefusesAReferenceThatNeverResolvesButNotAForwardOne =
  scenario(fun dark ->
    let path = Cli.Tests.Instance.home(dark) + "/unres-fixed.dark"
    let source(body: String): String =
      $"let fixedLater(x: Int64): Int64 = {body}\nlet usesFixed(x: Int64): Int64 = fixedLater(x)\n"

    [ says(
        dark,
        [ "fn"
          "Tests.UnresT.bad"
          "(x: Int64): Int64 = Tests.UnresT.missing(x)" ],
        "will resolve when dependencies are added",
        "an unresolved name is saved, with a warning")

      saysAll(
        dark,
        [ "commit", "unresolved", "-y" ],
        [ "don't resolve", "Tests.UnresT.missing" ],
        "the commit is refused, naming what it could not find")

      // -y alone must not wave it through; the escape hatch is typed
      says(
        dark,
        [ "commit", "unresolved", "--allow-unresolved", "-y" ],
        "-- 2 ops",
        "--allow-unresolved records it as it is")

      // the caller is saved first and resolves once the callee is saved, before commit looks
      save(
        dark,
        "Tests.UnresT.caller",
        "(x: Int64): Int64 = Tests.UnresT.callee(x)")

      save(dark, "Tests.UnresT.callee", "(x: Int64): Int64 = x + 3")
      commit(dark, "forward ref")
      // saving a module again after fixing a name leaves the broken version in the draft's
      // history, reachable from nothing live
      writeSource(path, source("Tests.UnresFix.notThere(x)"))
      says(
        dark,
        [ "import", path, "/Tests.UnresFix" ],
        "saved anyway",
        "the broken module is saved")

      writeSource(path, source("x + 1"))
      run(dark, [ "import", path, "/Tests.UnresFix" ])
      commit(dark, "fixed")
      same(
        commits(dark),
        [ "fixed", "forward ref", "unresolved" ],
        "each commit that should land did") ])


test commitsHidesArchiveMarkersUnlessAskedForAll =
  scenario(fun dark ->
    [ switch(dark, "hkeep")
      saveNumber(dark, "Tests.HKeep.f", "1")
      switch(dark, "main")
      run(dark, [ "branch", "archive", "hkeep", "-y" ])
      doesNotSay(
        dark,
        [ "commits" ],
        "archived branch \"hkeep\"",
        "the archive marker is hidden")

      says(
        dark,
        [ "commits" ],
        "housekeeping",
        "and the listing says it hid something")

      says(
        dark,
        [ "commits", "--all" ],
        "archived branch \"hkeep\"",
        "--all shows the marker") ])


/// Main's draft is newer than the edits a merge brings in, so committing keeps the draft's body,
/// doc and deprecation.
test aCommitKeepsTheDraftOverAnOlderMergedEdit =
  let p = "Tests.CommitLww"
  scenario(fun dark ->
    [ saveNumber(dark, $"{p}.f", "1")
      saveNumber(dark, $"{p}.g", "1")
      commit(dark, "commit lww: base")
      switch(dark, "commit-lww")
      saveNumber(dark, $"{p}.f", "2")
      save(dark, $"{p}.g", "/// from the branch\nlet g(): Int64 =\n  1")
      run(dark, [ "deprecate", "fn", $"{p}.g", "-y" ])
      commit(dark, "commit lww: the older edits")
      switch(dark, "main")
      saveNumber(dark, $"{p}.f", "3")
      save(dark, $"{p}.g", "/// from main's draft\nlet g(): Int64 =\n  1")
      run(
        dark,
        [ "deprecate"
          "fn"
          $"{p}.g"
          "--block-execution"
          "-m"
          "main's draft"
          "-y" ])

      merge(dark, "commit-lww")
      evals(dark, $"{p}.f()", "3", "main's draft wins in its view")
      commit(dark, "commit lww: main's draft")
      evals(dark, $"{p}.f()", "3", "and still wins once committed")
      says(
        dark,
        [ "view", $"{p}.g" ],
        "from main's draft",
        "the draft's doc is the one that stands")

      says(
        dark,
        [ "eval", $"{p}.g()" ],
        "Harmful",
        "and so is the draft's deprecation") ])
