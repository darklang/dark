module Darklang.SCM.Tests.Draft

// The draft: what `dark discard` drops, and what it must not touch.
//
// A draft op is already folded and already running; "draft" means uncommitted, not
// inert. Dropping one has to undo a fold, and a fold has no inverse, so `SCM.Draft`
// rebuilds from the ops that survive. These check the rebuild is faithful: a committed
// binding comes back rather than merely being left alone, and a committed op keeps its
// commit.
//
// What stays in `Draft.Tests.fs`: the tests that inject a failure or open a race window
// through F# hooks (`rewriteOpsAtomically`, `refreshWith`, `rebuildWith`, a stale
// `rebuild` read), and the one that plants an undecodable op blob.

module Store =
  /// Direct reads, for the two facts nothing in the SCM reports: how many committed ops
  /// main's log holds, and where the oldest one sits.
  let committedOpCount(): Int64 =
    Stdlib.Sqlite.scalarIntP(
      Darklang.SCM.localDb(),
      "SELECT count(*) AS n FROM package_ops
       WHERE commit_hash IS NOT NULL AND id NOT IN (SELECT op_id FROM op_branches)",
      [],
      "n")
    |> Stdlib.Option.withDefault(-1L)

  /// A rebuild deletes and re-inserts every main op, which moves this; a surgical drop
  /// does not.
  let firstCommittedRowid(): Int64 =
    Stdlib.Sqlite.scalarIntP(
      Darklang.SCM.localDb(),
      "SELECT MIN(rowid) AS n FROM package_ops
       WHERE commit_hash IS NOT NULL AND id NOT IN (SELECT op_id FROM op_branches)",
      [],
      "n")
    |> Stdlib.Option.withDefault(-1L)

let draftCount(): Int64 = Darklang.SCM.PackageOps.draftOpCountFor(Authoring.main())

let commit(message: String): Stdlib.Result.Result<String, String> =
  Darklang.SCM.PackageOps.commitDraft(Authoring.main(), message)

let discardAll(): Stdlib.Result.Result<Int, String> = Darklang.SCM.Draft.discardAll()

let discardName(m: String, name: String): Stdlib.Result.Result<Int, String> =
  Darklang.SCM.Draft.discardName("Tests", [ m ], name)


test discardDropsTheDraftAndLeavesCommittedOpsAlone =
  let m = "DraftTestOnly"
  let setup = Authoring.author(m, "let keep(): Int64 = 4001L")
  let committed = commit("draft test: committed")
  let committedBefore = Store.committedOpCount()
  let keepBefore = Authoring.fnHash(m, "keep")
  let edit = Authoring.author(m, "let dropMe(): Int64 = 4002L")
  let draftBefore = draftCount()
  let dropped = discardAll()
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      Authoring.ok(committed)
      Authoring.ok(edit)
      (draftBefore > 0L) |> Stdlib.Test.equal(true)
      dropped |> Stdlib.Test.equal(Ok(Stdlib.Int.fromInt64(draftBefore)))
      draftCount() |> Stdlib.Test.equal(0L)
      Store.committedOpCount() |> Stdlib.Test.equal(committedBefore)
      Authoring.fnHash(m, "dropMe") |> Stdlib.Test.equal(Stdlib.Option.Option.None)
      Authoring.fnHash(m, "keep") |> Stdlib.Test.equal(keepBefore) ])


// The case a per-op undo cannot handle: the draft edit REPLACED a binding rather than
// adding one, so dropping it is only right if the committed binding comes back.
test discardRestoresTheBindingAnEditOverwrote =
  let m = "DraftTestRestore"
  let setup = Authoring.author(m, "let v(): Int64 = 5001L")
  let committed = commit("draft test: v1 committed")
  let committedHash = Authoring.fnHash(m, "v")
  let edit = Authoring.author(m, "let v(): Int64 = 5002L")
  let editedHash = Authoring.fnHash(m, "v")
  let dropped = discardAll()
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      Authoring.ok(committed)
      Authoring.ok(edit)
      editedHash |> Stdlib.Test.notEqual(committedHash)
      Authoring.ok(dropped)
      Authoring.fnHash(m, "v") |> Stdlib.Test.equal(committedHash) ])


// The no-op path must not delete and re-insert: a rebuild with nothing to remove is pure
// risk, and re-stamping ops poisons last-writer-wins.
test discardingAnEmptyDraftChangesNothing =
  let m = "DraftTestEmpty"
  let setup = Authoring.author(m, "let e(): Int64 = 6001L")
  let committed = commit("draft test: empty")
  let committedBefore = Store.committedOpCount()
  let rowidBefore = Store.firstCommittedRowid()
  let before = Authoring.fnHash(m, "e")
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      Authoring.ok(committed)
      discardAll() |> Stdlib.Test.equal(Ok(0))
      Store.committedOpCount() |> Stdlib.Test.equal(committedBefore)
      Store.firstCommittedRowid() |> Stdlib.Test.equal(rowidBefore)
      Authoring.fnHash(m, "e") |> Stdlib.Test.equal(before) ])


// Rebuilding main to drop a draft op leaves every other reader a half-empty store while
// it runs. A surgical drop touches only the rows the draft wrote, and an unmoved
// committed rowid is the evidence.
test discardingADraftLeavesTheCommittedLogInPlace =
  let m = "DraftTestScoped"
  let setup = Authoring.author(m, "let s(): Int64 = 7001L")
  let committed = commit("draft test: scoped")
  let rowidBefore = Store.firstCommittedRowid()
  let edit = Authoring.author(m, "let d(): Int64 = 7002L")
  let dropped = discardAll()
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      Authoring.ok(committed)
      Authoring.ok(edit)
      (dropped |> Stdlib.Result.map(fun n -> n > 0)) |> Stdlib.Test.equal(Ok(true))
      Store.firstCommittedRowid() |> Stdlib.Test.equal(rowidBefore) ])


// Collapsing drops namings of versions that stopped being what the name meant before
// anyone saw them. What the name means now must not change, and only its last version
// is left to step back from.
test collapsingKeepsOneNamingPerName =
  let m = "DraftTestCollapse"
  let setup =
    Authoring.authorAll(
      m,
      [ "let c(): Int64 = 9001L"
        "let c(): Int64 = 9002L"
        "let c(): Int64 = 9003L" ])
  let before = Authoring.fnHash(m, "c")
  let draftBefore = draftCount()
  let collapsed = Darklang.SCM.Draft.collapse()
  let history = Darklang.SCM.Propagation.authoringOrder(Authoring.loc(m, "c"))
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      (collapsed |> Stdlib.Result.map(fun n -> n > 0)) |> Stdlib.Test.equal(Ok(true))
      Authoring.fnHash(m, "c") |> Stdlib.Test.equal(before)
      (history |> Stdlib.List.map(fun h -> Darklang.LanguageTools.ProgramTypes.Hash.Hash(h)))
      |> Stdlib.Test.equal(before |> Stdlib.Option.toList)
      (draftCount() < draftBefore) |> Stdlib.Test.equal(true) ])


test discardingOneNameLeavesTheRestOfTheDraft =
  let m = "DraftTestOneName"
  let setup = Authoring.author(m, "let keepMe(): Int64 = 5001L\n\nlet dropMe(): Int64 = 5002L")
  let keepBefore = Authoring.fnHash(m, "keepMe")
  let dropped = discardName(m, "dropMe")
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      (Stdlib.Option.isSome(keepBefore)) |> Stdlib.Test.equal(true)
      (dropped |> Stdlib.Result.map(fun n -> n > 0)) |> Stdlib.Test.equal(Ok(true))
      Authoring.fnHash(m, "dropMe") |> Stdlib.Test.equal(Stdlib.Option.Option.None)
      Authoring.fnHash(m, "keepMe") |> Stdlib.Test.equal(keepBefore)
      (draftCount() > 0L) |> Stdlib.Test.equal(true) ])


// Discarding a name drops its NAMING only. A dependent references content by hash, so
// content may be live with nothing naming it, and dropping the Add as well would leave a
// projection no re-fold reproduces. Counted, because the content row survives either way:
// 1 op is right, 2 is the bug.
test discardingANameDropsTheNamingNotTheContent =
  let m = "DraftTestNeededContent"
  let setup = Authoring.author(m, "let basis(): Int64 = 6001L\n\nlet uses(): Int64 = basis()")
  let before = Authoring.fnHash(m, "basis")
  let dropped = discardName(m, "basis")
  Stdlib.Test.all(
    [ Authoring.ok(setup)
      (Stdlib.Option.isSome(before)) |> Stdlib.Test.equal(true)
      dropped |> Stdlib.Test.equal(Ok(1))
      Authoring.fnHash(m, "basis") |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])
