module Darklang.SCM.Tests.ConstraintKinds

// The two constraint kinds, and the thing that separates them: what you can be offered to do about one.
//
// A stale usage is a version behind, and repointing fixes it. A kind change cannot be repointed at all --
// the usage references a value, and swapping that reference's hash to a function's produces code that
// claims one thing and points at another. Offering "repoint" there would hand someone a fix that breaks
// their code, so the kind has to carry that difference rather than the caller remembering it.
//
// The DETECTION half (a name whose current binding differs from the one a usage recorded, split on whether
// the kind moved too) needs a real store, so it lives with the F# tests. What is pure, and what actually
// gets asked at the point of doing something irreversible, is this.

module Resolutions =
  // A stale usage has an automatic answer.
  test staleUsageHasAnswer =
    SCM.Constraints.resolutionsFor(SCM.Constraints.Kind.StaleUsage)
    |> Stdlib.Test.equal([ "repoint" ])


  // A kind change has none. Following it means rewriting the usage to call a function where it read a
  // value, which is a change to what the code MEANS, not to which version it points at.
  test kindChangeHasNone =
    SCM.Constraints.resolutionsFor(SCM.Constraints.Kind.KindChanged)
    |> Stdlib.Test.equal([])


  // So `resolve --as repoint` must refuse a kind change rather than doing it.
  test repointRefusesKindChange =
    Stdlib.Test.all(
      [ SCM.Constraints.offersResolution(
          SCM.Constraints.Kind.KindChanged,
          "repoint")
        |> Stdlib.Test.equal(false)

        SCM.Constraints.offersResolution(
          SCM.Constraints.Kind.StaleUsage,
          "repoint")
        |> Stdlib.Test.equal(true) ])


module Naming =
  // The wire name round-trips both ways. Acks are stored by kind string, so a kind that serialises to
  // something `kindFromString` can't read back would lose every ack given against it.
  test wireNameRoundTrips =
    Stdlib.Test.all(
      [ SCM.Constraints.kindToString(SCM.Constraints.Kind.KindChanged)
        |> Stdlib.Test.equal("kind-changed")

        SCM.Constraints.kindFromString("kind-changed")
        |> Stdlib.Test.equal(
          Stdlib.Option.Option.Some(SCM.Constraints.Kind.KindChanged))

        SCM.Constraints.kindFromString("stale-usage")
        |> Stdlib.Test.equal(
          Stdlib.Option.Option.Some(SCM.Constraints.Kind.StaleUsage))

        SCM.Constraints.kindFromString("not-a-kind")
        |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


module RivalPairs =
  test noCandidates =
    SCM.Constraints.rivalPairs<String>([]) |> Stdlib.Test.equal([])


  test distinctSelfTypesAreNotRivals =
    SCM.Constraints.rivalPairs(
      [ ("Point", "a"), ("String", "b"), ("List<Int64>", "c") ])
    |> Stdlib.Test.equal([])


  // Interleaving two rival groups must not reorder findings or reverse a pair:
  // both affect which implementation is the usage and the finding ID we ack.
  test interleavedGroupsKeepEveryPairInOrder =
    SCM.Constraints.rivalPairs(
      [ ("Point", "a")
        ("String", "b")
        ("Point", "c")
        ("String", "d")
        ("Point", "e") ])
    |> Stdlib.Test.equal([ ("a", "c"), ("a", "e"), ("b", "d"), ("c", "e") ])


  test genericAndSpecificSelfTypesStaySeparate =
    SCM.Constraints.rivalPairs(
      [ ("List<'a>", "generic"), ("List<Int64>", "specific") ])
    |> Stdlib.Test.equal([])
