// What `dark compile` asks the compiler to build. Needs no compiler.
module Darklang.Cli.Compile.Tests

module Fixtures =
  let echo(args: List<String>): Int64 =
    Stdlib.List.iter(args, fun a -> Stdlib.printLine(a))
    0


  let exitWith(args: List<String>): Int64 =
    match args with
    | [code] -> Stdlib.Int64.parse(code) |> Stdlib.Result.withDefault(2)
    | _ -> 2


  let hello(): Unit =
    Stdlib.printLine("hello")


val fixtures = "Darklang.Cli.Compile.Tests.Fixtures"


let entryOf(name: String): Result<Cli.Run.EntryParameters, Cli.Run.EntryError> =
  Cli.Run.entry(SCM.Branch.mainBranchId, name)
  |> Stdlib.Result.map(fun e -> e.parameters)


test entryTakesWordsOrNothing =
  [ entryOf($"{fixtures}.echo"), entryOf($"{fixtures}.hello") ]
  |> Stdlib.Test.equal(
    [ Stdlib.Result.Result.Ok(Cli.Run.EntryParameters.Words)
      Stdlib.Result.Result.Ok(Cli.Run.EntryParameters.Nothing) ])


test entryRefusesOtherParameters =
  entryOf("Stdlib.String.padStart")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error(
      Cli.Run.EntryError.OtherParameters(
        "string: String, padWith: Char, goalLength: Int64")))


test entryOfNoFn =
  entryOf("Stdlib.NoSuch.fn")
  |> Stdlib.Test.equal(Stdlib.Result.Result.Error(Cli.Run.EntryError.NoFn))


test executablesTakeWhatRunTakes =
  Cli.Compile.entry("Stdlib.String.padStart")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error(
      "Stdlib.String.padStart takes (string: String, padWith: Char, goalLength: Int64); an executable's fn takes List<String> or nothing, as for `dark run`."))


test executablesReturnAnExitCode =
  Cli.Compile.entry("Stdlib.Cli.Path.join")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error(
      "Stdlib.Cli.Path.join returns String; an executable's fn returns Int64, the exit code, or Unit, as for `dark run`."))


test unknownFn =
  Cli.Compile.entry("Stdlib.NoSuch.fn")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error("No package fn named Stdlib.NoSuch.fn."))


let argumentsFor(job: Compiler.Darkc.Job, verbosity: Int64): List<String> =
  Compiler.Darkc.arguments(
    Compiler.Darkc.Invocation
      { job = job, verbosity = verbosity, packageServer = "http://s" })


test anExecutableIsNamedByItsHash =
  let hash = LanguageTools.ProgramTypes.Hash.Hash("abc123")
  argumentsFor(Compiler.Darkc.Job.Executable(hash, "./echo"), 1)
  |> Stdlib.List.drop(4)
  |> Stdlib.Test.equal([ "-v", "--entry", "abc123", "-o", "./echo" ])


test theCacheAndServerAreSaidEveryTime =
  argumentsFor(Compiler.Darkc.Job.Run("1 + 2"), -1)
  |> Stdlib.Test.equal(
    [ "--cache-dir"
      Compiler.Darkc.cacheDir()
      "--package-server"
      "http://s"
      "-q"
      "-r"
      "-e"
      "--"
      "1 + 2" ])


test checkAsksForJson =
  argumentsFor(Compiler.Darkc.Job.Check([ "A.b", "A.c" ]), 2)
  |> Stdlib.List.drop(4)
  |> Stdlib.Test.equal([ "--check", "--json", "A.b", "A.c" ])


test checkReportsAreRead =
  "{\"name\":\"A.b\",\"status\":\"compiles\",\"reason\":\"\",\"error\":\"\"}\n\n{\"name\":\"A.c\",\"status\":\"failed\",\"reason\":\"missing-builtin\",\"error\":\"no Builtin.x\"}\n"
  |> Compiler.Darkc.parseCheckReports
  |> Stdlib.List.map(fun r -> (r.name, r.status))
  |> Stdlib.Test.equal([ ("A.b", "compiles"), ("A.c", "failed") ])


test noOutputIsNamedAfterTheFn =
  Cli.Compile.parse([ "Me.Tools.wc" ])
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Ok(
      Cli.Compile.Request.Executable("Me.Tools.wc", "./wc")))


test runTakesAnExpression =
  Cli.Compile.verbosityOf([ "--run", "-1 + 2", "-v" ])
  |> Stdlib.Test.equal(([ "--run", "-1 + 2" ], 1))


test verbosityLevels =
  [ [ "Me.Tools.wc" ], [ "-q", "Me.Tools.wc" ], [ "Me.Tools.wc", "-vvv" ] ]
  |> Stdlib.List.map(fun args ->
    Stdlib.Tuple2.second(Cli.Compile.verbosityOf(args)))
  |> Stdlib.Test.equal([ 0, -1, 3 ])


test bareExpressionIsRefused =
  Cli.Compile.parse([ "-1 + 2" ])
  |> Stdlib.Test.equal(Stdlib.Result.Result.Error(Cli.Compile.usage))


test seconds =
  [ 400, 2449, 81234 ]
  |> Stdlib.List.map(fun ms -> Cli.Compile.seconds(ms))
  |> Stdlib.Test.equal([ "0.4 s", "2.4 s", "81 s" ])
