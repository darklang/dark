// What `dark compile` asks the compiler to build, and how it reads its arguments. Needs no compiler.
module Darklang.Cli.Compile.Tests

test listOfStringsGetsTheArgs =
  match Darklang.Cli.Compile.entryExpression("Stdlib.Cli.Path.join") with
  | Ok(expr) ->
    Stdlib.String.endsWith(
      expr,
      "\nDarklang.Stdlib.Cli.Path.join(commandLineArgs(0, []))")
    |> Stdlib.Test.equal(true)
  | Error(e) -> Stdlib.Test.fail(e)


test noParametersIsJustCalled =
  Darklang.Cli.Compile.entryExpression("Darklang.Cli.Http.Serve.usageLines")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Ok("Darklang.Cli.Http.Serve.usageLines()"))


test otherSignaturesAreRefused =
  Darklang.Cli.Compile.entryExpression("Stdlib.String.padStart")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error(
      "Stdlib.String.padStart(string: String, padWith: Char, goalLength: Int64): String can't be an executable yet: it needs to take List<String>, or nothing."))


test unknownFn =
  Darklang.Cli.Compile.entryExpression("Stdlib.NoSuch.fn")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error("No package fn named Stdlib.NoSuch.fn."))


test noOutputIsNamedAfterTheFn =
  Darklang.Cli.Compile.parse([ "Stdlib.Cli.Path.join" ])
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Ok(
      Darklang.Cli.Compile.Request.Executable("Stdlib.Cli.Path.join", "./join")))


test runTakesAnExpression =
  Darklang.Cli.Compile.verbosityOf([ "--run", "-1 + 2", "-v" ])
  |> Stdlib.Test.equal(([ "--run", "-1 + 2" ], 1))


test verbosityLevels =
  [ [ "Stdlib.Cli.Path.join" ]
    [ "-q", "Stdlib.Cli.Path.join" ]
    [ "Stdlib.Cli.Path.join", "-vvv" ] ]
  |> Stdlib.List.map(fun args -> Stdlib.Tuple2.second(Darklang.Cli.Compile.verbosityOf(args)))
  |> Stdlib.Test.equal([ 0, -1, 3 ])


test bareExpressionIsRefused =
  Darklang.Cli.Compile.parse([ "-1 + 2" ])
  |> Stdlib.Test.equal(Stdlib.Result.Result.Error(Darklang.Cli.Compile.usage))


test seconds =
  [ 400, 2449, 81234 ]
  |> Stdlib.List.map(fun ms -> Darklang.Cli.Compile.seconds(ms))
  |> Stdlib.Test.equal([ "0.4 s", "2.4 s", "81 s" ])
