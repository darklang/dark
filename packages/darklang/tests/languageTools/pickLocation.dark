/// Package-location selection cases from
/// `backend/testfiles/execution/stdlib/language-tools/pickLocation.dark`.
module Darklang.LanguageTools.PackageManager.Tests

// Tests for PackageManager.pickLocation and countMatchingPrefix

// --- helpers ---
let loc
  (owner: String)
  (modules: List<String>)
  (name: String)
  : Darklang.LanguageTools.ProgramTypes.PackageLocation =
  Darklang.LanguageTools.ProgramTypes.PackageLocation
    { owner = owner; modules = modules; name = name }

let ctx
  (currentModule: List<String>)
  : Darklang.LanguageTools.PackageManager.PickContext =
  Darklang.LanguageTools.PackageManager.PickContext
    { currentModule = currentModule; preferredLocation = None }

let preferCtx
  (currentModule: List<String>)
  (preferredLocation: Darklang.LanguageTools.ProgramTypes.PackageLocation)
  : Darklang.LanguageTools.PackageManager.PickContext =
  Darklang.LanguageTools.PackageManager.PickContext
    { currentModule = currentModule
      preferredLocation = Some preferredLocation }

let pick
  (context: Darklang.LanguageTools.PackageManager.PickContext)
  (locations: List<Darklang.LanguageTools.ProgramTypes.PackageLocation>)
  : Stdlib.Option.Option<Darklang.LanguageTools.ProgramTypes.PackageLocation> =
  Darklang.LanguageTools.PackageManager.pickLocation context locations

let emptyCtx () : Darklang.LanguageTools.PackageManager.PickContext =
  Darklang.LanguageTools.PackageManager.PickContext.empty

test countMatchingPrefix =
  Stdlib.Test.all
    [ Darklang.LanguageTools.PackageManager.countMatchingPrefix [] []
      |> Stdlib.Test.equal 0
      Darklang.LanguageTools.PackageManager.countMatchingPrefix [ "A" ] []
      |> Stdlib.Test.equal 0
      Darklang.LanguageTools.PackageManager.countMatchingPrefix [] [ "A" ]
      |> Stdlib.Test.equal 0
      Darklang.LanguageTools.PackageManager.countMatchingPrefix [ "A" ] [ "A" ]
      |> Stdlib.Test.equal 1
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "A", "B" ]
        [ "A", "B" ]
      |> Stdlib.Test.equal 2
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "A", "B", "C" ]
        [ "A", "B", "C" ]
      |> Stdlib.Test.equal 3
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "A", "B" ]
        [ "A", "X" ]
      |> Stdlib.Test.equal 1
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "X", "B" ]
        [ "A", "B" ]
      |> Stdlib.Test.equal 0
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "A", "B", "C" ]
        [ "A", "B" ]
      |> Stdlib.Test.equal 2
      Darklang.LanguageTools.PackageManager.countMatchingPrefix
        [ "A", "B" ]
        [ "A", "B", "C" ]
      |> Stdlib.Test.equal 2 ]

// pickLocation: empty list → None
test emptyListPicksNothing =
  pick (emptyCtx ()) [] |> Stdlib.Test.equal None

// pickLocation: single location → always returns it
test singleLocationIsPicked =
  pick (emptyCtx ()) [ loc "Darklang" [ "Stdlib", "List" ] "map" ]
  |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map"))

// pickLocation: no context → prefer shorter path
test shorterPathWinsWithoutContext =
  Stdlib.Test.all
    [ // Person (owner=Darklang, modules=[]) vs Person2
      // (modules=[UserDefinedAliases])
      // Person is shorter, wins with empty context.
      pick (emptyCtx ())
        [ loc "Darklang" [] "Person"
          loc "Darklang" [ "UserDefinedAliases" ] "Person2" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [] "Person"))
      // Reversed input order — shorter still wins
      pick (emptyCtx ())
        [ loc "Darklang" [ "UserDefinedAliases" ] "Person2"
          loc "Darklang" [] "Person" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [] "Person")) ]

// pickLocation: context matches one location → prefer it
test contextMatchWins =
  Stdlib.Test.all
    [ // We're in Darklang.Stdlib.List — Stdlib.List.map has better prefix match
      // than SomeOther.map
      pick (ctx [ "Darklang", "Stdlib", "List" ])
        [ loc "Darklang" [ "Stdlib", "List" ] "map"
          loc "Darklang" [ "SomeOther" ] "map" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map"))
      // Reversed — context match still wins
      pick (ctx [ "Darklang", "Stdlib", "List" ])
        [ loc "Darklang" [ "SomeOther" ] "map"
          loc "Darklang" [ "Stdlib", "List" ] "map" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map")) ]

// pickLocation: partial prefix match beats no match
//
// We're in Darklang.Stdlib.Json. Stdlib.List.map shares 2-segment prefix
// (Darklang.Stdlib). SomeOther.map shares only 1 (Darklang). Stdlib.List.map wins.
test partialPrefixBeatsNoMatch =
  pick (ctx [ "Darklang", "Stdlib", "Json" ])
    [ loc "Darklang" [ "SomeOther" ] "map"
      loc "Darklang" [ "Stdlib", "List" ] "map" ]
  |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map"))

// pickLocation: equal prefix match → shorter path wins
//
// Both share "Darklang.Stdlib" prefix (2 segments). Shorter one wins.
test equalPrefixShorterPathWins =
  pick (ctx [ "Darklang", "Stdlib" ])
    [ loc "Darklang" [ "Stdlib", "List", "Internal" ] "helper"
      loc "Darklang" [ "Stdlib", "List" ] "helper" ]
  |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "helper"))

// pickLocation: equal prefix and equal length → first one wins (stable
// ordering)
test fullTieKeepsFirst =
  Stdlib.Test.all
    [ pick (emptyCtx ())
        [ loc "Darklang" [ "Stdlib" ] "foo"
          loc "Darklang" [ "AltLib" ] "foo" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib" ] "foo"))
      pick (emptyCtx ())
        [ loc "Darklang" [ "AltLib" ] "foo"
          loc "Darklang" [ "Stdlib" ] "foo" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "AltLib" ] "foo")) ]

// pickLocation: context wins over shorter path
//
// We're in Darklang.UserDefinedAliases. Person2 matches 2 segments.
// Person matches only 1 (Darklang). Context wins despite Person being shorter.
test contextBeatsShorterPath =
  pick (ctx [ "Darklang", "UserDefinedAliases" ])
    [ loc "Darklang" [] "Person"
      loc "Darklang" [ "UserDefinedAliases" ] "Person2" ]
  |> Stdlib.Test.equal (Some(loc "Darklang" [ "UserDefinedAliases" ] "Person2"))

// pickLocation: deeper context match beats shallow match
//
// We're in Darklang.Stdlib.List. Stdlib.List.map matches 3 segments.
// Stdlib.map matches only 2. Deeper match wins.
test deeperContextMatchWins =
  pick (ctx [ "Darklang", "Stdlib", "List" ])
    [ loc "Darklang" [ "Stdlib" ] "map"
      loc "Darklang" [ "Stdlib", "List" ] "map" ]
  |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map"))

// pickLocation: different owners
test differentOwners =
  Stdlib.Test.all
    [ // We're in Stachu.MyLib — Stachu.MyLib.helper matches 2 segments.
      // Darklang.Stdlib.helper matches 0. Context wins.
      pick (ctx [ "Stachu", "MyLib" ])
        [ loc "Darklang" [ "Stdlib" ] "helper"
          loc "Stachu" [ "MyLib" ] "helper" ]
      |> Stdlib.Test.equal (Some(loc "Stachu" [ "MyLib" ] "helper"))
      // No context, both paths length 2 — first one wins (stable)
      pick (emptyCtx ())
        [ loc "Darklang" [ "Stdlib" ] "helper"
          loc "Stachu" [ "MyLib" ] "helper" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib" ] "helper")) ]

// pickLocation: three candidates with context
test threeCandidates =
  Stdlib.Test.all
    [ // Three locations, context matches the deepest one best
      pick (ctx [ "Darklang", "Stdlib", "List" ])
        [ loc "Darklang" [] "flatten"
          loc "Darklang" [ "Stdlib" ] "flatten"
          loc "Darklang" [ "Stdlib", "List" ] "flatten" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "flatten"))
      // Same three, empty context — shortest path wins
      pick (emptyCtx ())
        [ loc "Darklang" [] "flatten"
          loc "Darklang" [ "Stdlib" ] "flatten"
          loc "Darklang" [ "Stdlib", "List" ] "flatten" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [] "flatten")) ]

// pickLocation: an asked-for name beats scoring
test askedForNameBeatsScoring =
  Stdlib.Test.all
    [ // Two names sharing a body share a hash, so both come back as candidates.
      // The one the caller asked about wins, whatever the context would have
      // scored higher.
      pick
        (preferCtx
          [ "Darklang", "Stdlib", "List" ]
          (loc "Darklang" [ "SomeOther" ] "map"))
        [ loc "Darklang" [ "Stdlib", "List" ] "map"
          loc "Darklang" [ "SomeOther" ] "map" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "SomeOther" ] "map"))
      // The order it comes back in does not matter either.
      pick
        (preferCtx
          [ "Darklang", "Stdlib", "List" ]
          (loc "Darklang" [ "SomeOther" ] "map"))
        [ loc "Darklang" [ "SomeOther" ] "map"
          loc "Darklang" [ "Stdlib", "List" ] "map" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "SomeOther" ] "map"))
      // A preference for a name this hash is NOT bound to is ignored rather than
      // honoured: scoring is right for every case except the one the caller named.
      pick
        (preferCtx
          [ "Darklang", "Stdlib", "List" ]
          (loc "Darklang" [ "Absent" ] "map"))
        [ loc "Darklang" [ "Stdlib", "List" ] "map"
          loc "Darklang" [ "SomeOther" ] "map" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib", "List" ] "map"))
      // A preference that differs only by name is a different location, so it
      // does not match.
      pick (preferCtx [] (loc "Darklang" [ "Stdlib" ] "second"))
        [ loc "Darklang" [ "Stdlib" ] "first" ]
      |> Stdlib.Test.equal (Some(loc "Darklang" [ "Stdlib" ] "first")) ]
