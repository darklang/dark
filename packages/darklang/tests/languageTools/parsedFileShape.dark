module Darklang.LanguageTools.Parser.Parse.Tests

// `Builtin.parserParseToWrittenTypes` has to survive anything a person can type,
// because it runs on every keystroke-adjacent save in the authoring editor and
// its failure mode is an uncaught internal exception that takes the whole CLI
// down with it.
//
// The Dark-side `SourceFileDeclaration` covers functions, values, types and
// modules. Three WT.Declaration cases fall outside it and used to raise: DExpr,
// DTest, and DTypeDB. DTest is the one that bites, because a test assertion is
// spelled `actual = expected` and is indistinguishable from an assignment until
// post-parse validation decides whether this is Test source — so an ordinary
// typo like `valoops = 1` (a missing space after `val`) parses as one.

let shape (source: String) : (Int * Int) =
  match Darklang.LanguageTools.Parser.Parse.toWrittenTypes source with
  | Some(SourceFile file) ->
    (Stdlib.List.length file.declarations, Stdlib.List.length file.exprsToEval)
  | None -> (-1, -1)

// The ordinary cases are untouched: one declaration, no trailing expressions.
test realDeclarations =
  Stdlib.Test.all
    [ shape "val v = 1" |> Stdlib.Test.equal (1, 0)
      shape "let f (x: Int): Int = x" |> Stdlib.Test.equal (1, 0)
      shape "type T = Unit" |> Stdlib.Test.equal (1, 0)
      shape "module M =\n  val v = 1" |> Stdlib.Test.equal (1, 0) ]

test notDeclarations =
  Stdlib.Test.all
    [ // A bare expression belongs in exprsToEval, not declarations.
      shape "1 + 1" |> Stdlib.Test.equal (0, 1)
      // `actual = expected` parses as a test assertion. Both sides come back as
      // expressions rather than raising.
      shape "valoops = 1" |> Stdlib.Test.equal (0, 2)
      shape "x = 1" |> Stdlib.Test.equal (0, 2)
      // A plain string on the right is just an expression, so both sides lift -
      // despite reading like an error.
      shape "someCall () = \"Error: nope\"" |> Stdlib.Test.equal (0, 2)
      // An expected-ERROR assertion has only the actual side to lift; `error` is
      // the literal keyword that makes it one (a plain string on the right is
      // just an expression, as above).
      shape "someCall () = error \"nope\"" |> Stdlib.Test.equal (0, 1) ]

// The path that actually matters, and the one the top-level fix missed. A
// `module` header wraps the rest of the file into a DModule, which is the shape
// of every package file on disk, and the serializer for a module's declarations
// raised on the same cases. The authoring editor strips the module line before
// parsing, so only the highlighter hits this.
test moduleHeadedFiles =
  Stdlib.Test.all
    [ shape "module Darklang.Foo\n\nvaloops = 1" |> Stdlib.Test.equal (1, 0)
      shape "module Darklang.Foo\n\nlet f (x: Int): Int = x"
      |> Stdlib.Test.equal (1, 0)
      // `[<DB>] type X = ...` still parses and still lowers to a `TDB` type reference, which
      // is what this asserts. The runtime behind user DBs is in `later/`, so nothing executes
      // against one; the form stays in the grammar because `TDB` is in the serialization
      // format, and therefore in the content hash.
      shape "module Darklang.Foo\n\n[<DB>] type Counter = Int"
      |> Stdlib.Test.equal (1, 0) ]

// A real declaration alongside an assignment-shaped line: the declaration
// survives, the assertion's two sides join exprsToEval.
test mixedDeclarationsAndExpressions =
  shape "val v = 1\noops = 2" |> Stdlib.Test.equal (1, 2)
