module Darklang.LanguageTools.AtRestTypeChecker.Tests

// Test the at-rest type checker through its public API and individual checking
// rules. `check source name` parses source and returns the named declaration's
// verdict and issue codes. `checkFunctionAst types fn` accepts a manually
// constructed syntax tree, allowing tests of invalid input that the parser would
// reject. Checked means the check succeeded; Failed means a definite type error was
// found; Incomplete means the checker could not finish proving the declaration's
// types. The CLI's `typecheck` command separately checks all declarations on a
// branch.
// ----------------------------------------------------------------------------------
// Test helpers
// ----------------------------------------------------------------------------------

let verdictWord(v: LanguageTools.AtRestTypeChecker.Verdict): String =
  match v with
  | Checked -> "checked"
  | Failed -> "failed"
  | Incomplete -> "incomplete"


let codesOf(issues: List<LanguageTools.AtRestTypeChecker.Issue>): String =
  issues
  |> Stdlib.List.map(fun i ->
    LanguageTools.AtRestTypeChecker.issueCodeToString(i.code))
  |> Stdlib.List.unique
  |> Stdlib.List.sort
  |> Stdlib.String.join(",")


let summary(report: LanguageTools.AtRestTypeChecker.Report): String =
  verdictWord(report.verdict)
  + ":"
  + codesOf(Stdlib.List.concat(report.diagnostics, report.warnings))


let src(lines: List<String>): String =
  Stdlib.String.join(lines, "\n")


let parsePackageOps(
  source: String)
  : Stdlib.Result.Result<List<LanguageTools.ProgramTypes.PackageOp>, String> =
  LanguageTools.Parser.Parse.packageSourceToOps(
    SCM.Branch.mainBranchId,
    "Tests",
    [ "AtRest" ],
    source)


let itemNamed(
  ops: List<LanguageTools.ProgramTypes.PackageOp>,
  name: String)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.Reference> =
  ops
  |> Stdlib.List.filterMap(fun op ->
    match op with
    | SetName(location, target, _) ->
      if location.name == name then
        Stdlib.Option.Option.Some(target)
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None)
  |> Stdlib.List.head


let itemSummary(
  report: LanguageTools.AtRestTypeChecker.Report,
  item: Stdlib.Option.Option<LanguageTools.ProgramTypes.Reference>)
  : String =
  match item with
  | None -> "no such declaration"
  | Some(target) ->
    match Stdlib.List.findFirst(report.items, fun i -> i.item == target) with
    | Some(i) ->
      verdictWord(i.verdict)
      + ":"
      + codesOf(Stdlib.List.concat(i.diagnostics, i.warnings))
    | None -> "no report for the declaration"


/// Parse and check the source, then return the verdict and issue codes for `name`.
let check(source: String, name: String): String =
  match parsePackageOps(source) with
  | Error(e) -> e
  | Ok(ops) ->
    itemSummary(
      LanguageTools.AtRestTypeChecker.checkPackageOps(ops),
      itemNamed(ops, name))


/// Return the named declaration's errors and warnings as `Code: message` strings.
let issues(source: String, name: String): List<String> =
  match parsePackageOps(source) with
  | Error(e) -> [ e ]
  | Ok(ops) ->
    let report = LanguageTools.AtRestTypeChecker.checkPackageOps(ops)
    match itemNamed(ops, name) with
    | None -> [ "no such declaration" ]
    | Some(target) ->
      match Stdlib.List.findFirst(report.items, fun i -> i.item == target) with
      | Some(i) ->
        Stdlib.List.concat(i.diagnostics, i.warnings)
        |> Stdlib.List.map(fun issue ->
          LanguageTools.AtRestTypeChecker.issueCodeToString(issue.code)
          + ": "
          + LanguageTools.AtRestTypeChecker.issueToString(issue))
      | None -> [ "no report for the declaration" ]


// ---- Helpers for constructing syntax trees directly ------------------------------

let hash(text: String): LanguageTools.ProgramTypes.Hash =
  LanguageTools.ProgramTypes.Hash.Hash(text)


let resolved(name: 'a): LanguageTools.ProgramTypes.NameResolution<'a> =
  LanguageTools.ProgramTypes.NameResolution
    { originalName = []
      resolved =
        Stdlib.Result.Result.Ok(
          LanguageTools.ProgramTypes.ResolvedName
            { name = name, location = Stdlib.Option.Option.None }) }


let unresolved(
  parts: List<String>)
  : LanguageTools.ProgramTypes.NameResolution<'a> =
  LanguageTools.ProgramTypes.NameResolution
    { originalName = parts
      resolved =
        Stdlib.Result.Result.Error(
          LanguageTools.ProgramTypes.NameResolutionError.NotFound) }


let custom(
  name: String,
  args: List<LanguageTools.ProgramTypes.TypeReference>)
  : LanguageTools.ProgramTypes.TypeReference =
  LanguageTools.ProgramTypes.TypeReference.TCustomType(
    resolved(
      LanguageTools.ProgramTypes.FQTypeName.FQTypeName.Package(hash(name))),
    args)


let fnNamed(
  name: String,
  typeParams: List<String>,
  parameters: List<(String * LanguageTools.ProgramTypes.TypeReference)>,
  returnType: LanguageTools.ProgramTypes.TypeReference,
  body: LanguageTools.ProgramTypes.Expr)
  : LanguageTools.ProgramTypes.PackageFn.PackageFn =
  LanguageTools.ProgramTypes.PackageFn.PackageFn
    { hash = hash(name)
      body = body
      typeParams = typeParams
      parameters =
        Stdlib.List.map(parameters, fun((n, t)) ->
          LanguageTools.ProgramTypes.PackageFn.Parameter
            { name = n, typ = t, description = "" })
      returnType = returnType
      description = ""
      // This branch gives a fn BOUNDS (`'a: Compare`). The helper predates that
      // and built a record without the field, so every test through it raised
      // `Record (CreationMissingField "bounds")`, which the runner then reported
      // as an empty message. Nothing here declares one, so the empty list is the
      // honest value.
      bounds = [] }


let oneArg(
  parameterType: LanguageTools.ProgramTypes.TypeReference,
  returnType: LanguageTools.ProgramTypes.TypeReference,
  body: LanguageTools.ProgramTypes.Expr)
  : LanguageTools.ProgramTypes.PackageFn.PackageFn =
  fnNamed(
    "function-under-test",
    [],
    [ ("value", parameterType) ],
    returnType,
    body)


let declared(
  name: String,
  typeParams: List<String>,
  definition: LanguageTools.ProgramTypes.TypeDeclaration.Definition)
  : LanguageTools.ProgramTypes.PackageType.PackageType =
  LanguageTools.ProgramTypes.PackageType.PackageType
    { hash = hash(name)
      id = Option.None
      declaration =
        LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
          { // A type takes bounds on this branch too (`type Set<'a: Compare>`), and
            // this helper predates that. Same omission as `fnNamed` above.
            typeParams = typeParams
            bounds = []
            definition = definition }
      description = "" }


let recordOf(
  fields: List<(String * LanguageTools.ProgramTypes.TypeReference)>)
  : LanguageTools.ProgramTypes.TypeDeclaration.Definition =
  LanguageTools.ProgramTypes.TypeDeclaration.Definition.Record(
    Stdlib.List.map(fields, fun((n, t)) ->
      LanguageTools.ProgramTypes.TypeDeclaration.RecordField
        { name = n, typ = t, description = "" }))


let environmentWith(
  types: List<LanguageTools.ProgramTypes.PackageType.PackageType>)
  : LanguageTools.AtRestTypeChecker.Model.Environment =
  let env =
    Stdlib.List.fold(
      types,
      LanguageTools.AtRestTypeChecker.Environment.builtins(
        SCM.Branch.mainBranchId),
      fun(env, t) -> LanguageTools.AtRestTypeChecker.Items.addType(env, t))

  LanguageTools.AtRestTypeChecker.Declarations.prepareDeclarations(env)


let outcomeSummary(
  outcome: LanguageTools.AtRestTypeChecker.Items.Outcome)
  : String =
  verdictWord(outcome.verdict)
  + ":"
  + codesOf(Stdlib.List.concat(outcome.diagnostics, outcome.warnings))


/// Check `fn` with the supplied type declarations available as dependencies.
/// Return only the function's verdict and issue codes.
let checkFunctionAst(
  types: List<LanguageTools.ProgramTypes.PackageType.PackageType>,
  fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : String =
  let (outcome, _) =
    LanguageTools.AtRestTypeChecker.Items.checkFunction(
      environmentWith(types),
      fn)

  outcomeSummary(outcome)


let checkFunctionAstOutcome(
  types: List<LanguageTools.ProgramTypes.PackageType.PackageType>,
  fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : LanguageTools.AtRestTypeChecker.Items.Outcome =
  let (outcome, _) =
    LanguageTools.AtRestTypeChecker.Items.checkFunction(
      environmentWith(types),
      fn)

  outcome


/// Check the supplied types and functions through the public API used by saves
/// and commits. That API converts checker failures into Incomplete reports.
let checkPackageOpsSummary(
  types: List<LanguageTools.ProgramTypes.PackageType.PackageType>,
  fns: List<LanguageTools.ProgramTypes.PackageFn.PackageFn>)
  : String =
  let ops =
    Stdlib.List.concat(
      Stdlib.List.map(types, fun t ->
        LanguageTools.ProgramTypes.PackageOp.AddType(t)),
      Stdlib.List.map(fns, fun f ->
        LanguageTools.ProgramTypes.PackageOp.AddFn(f)))

  summary(LanguageTools.AtRestTypeChecker.checkPackageOps(ops))


/// Check values together so they can refer to each other. Return their summaries
/// in input order, even if dependency checking requires a different order.
let checkValueAsts(
  values: List<LanguageTools.ProgramTypes.PackageValue.PackageValue>)
  : List<String> =
  LanguageTools.AtRestTypeChecker.Items.checkBatch(
    environmentWith([]),
    [],
    values,
    [])
  |> Stdlib.List.map(fun((_, outcome)) -> outcomeSummary(outcome))


let valueNamed(
  name: String,
  body: LanguageTools.ProgramTypes.Expr)
  : LanguageTools.ProgramTypes.PackageValue.PackageValue =
  LanguageTools.ProgramTypes.PackageValue.PackageValue
    { hash = hash(name), body = body, description = "", typ = Option.None }


let useValue(id: Int64, name: String): LanguageTools.ProgramTypes.Expr =
  LanguageTools.ProgramTypes.Expr.EValue(
    id,
    resolved(
      LanguageTools.ProgramTypes.FQValueName.FQValueName.Package(hash(name))))


let arg(id: Int64): LanguageTools.ProgramTypes.Expr =
  LanguageTools.ProgramTypes.Expr.EArg(id, 0)


let unitExpr(id: Int64): LanguageTools.ProgramTypes.Expr =
  LanguageTools.ProgramTypes.Expr.EUnit(id)


let intExpr(id: Int64, n: Int64): LanguageTools.ProgramTypes.Expr =
  LanguageTools.ProgramTypes.Expr.EInt64(id, n)


let tInt(): LanguageTools.ProgramTypes.TypeReference =
  LanguageTools.ProgramTypes.TypeReference.TInt64


let tUnit(): LanguageTools.ProgramTypes.TypeReference =
  LanguageTools.ProgramTypes.TypeReference.TUnit


let tList(
  inner: LanguageTools.ProgramTypes.TypeReference)
  : LanguageTools.ProgramTypes.TypeReference =
  LanguageTools.ProgramTypes.TypeReference.TList(inner)


let nestedListType(depth: Int64): LanguageTools.ProgramTypes.TypeReference =
  Stdlib.List.fold(Stdlib.List.range(1, depth), tInt(), fun(t, _) -> tList(t))


/// Build a tuple type with `depth` nested tuples. Checking its elements calls
/// back through List.map at each level, exercising the native stack limit.
let nestedTupleType(depth: Int64): LanguageTools.ProgramTypes.TypeReference =
  Stdlib.List.fold(Stdlib.List.range(1, depth), tInt(), fun(t, _) ->
    LanguageTools.ProgramTypes.TypeReference.TTuple(tInt(), t, []))


let nestedListExpr(depth: Int64): LanguageTools.ProgramTypes.Expr =
  Stdlib.List.fold(Stdlib.List.range(1, depth), intExpr(1, 0), fun(e, i) ->
    LanguageTools.ProgramTypes.Expr.EList(i + 1, [ e ]))
