module Darklang.LanguageTools.Tests.BuiltinIntrospection

// Smoke checks for the builtin registry through Darklang.LanguageTools.allBuiltinFns.

module Documentation =
  // Rough sanity check on builtin count — guards against the registry
  // shipping empty (the actual count is well over 100; the threshold
  // is intentionally loose so adding/removing one fn doesn't churn this
  // test).
  test registryIsNotEmpty =
    ((Darklang.LanguageTools.allBuiltinFns()) |> Stdlib.List.length) > 100
    |> Stdlib.Test.equal(true)

  // Builtin metadata round-trips: the registry exposes `int64ToFloat` with
  // the parameter shape the type-checker uses at call sites.
  test int64ToFloatParameters =
    ((Darklang.LanguageTools.allBuiltinFns())
     |> Stdlib.List.findFirst(fun f -> f.name.name == "int64ToFloat")
     |> Builtin.unwrap
     |> (fun f -> f.parameters))
    |> Stdlib.Test.equal(
      [ Darklang.LanguageTools.BuiltinFunctionParameter
          { name = "a"
            ``type`` = Darklang.LanguageTools.RuntimeTypes.TypeReference.TInt64 } ])

module Lookup =
  // Named lookups preserve the metadata exposed by the full registry.
  test namedLookups =
    Stdlib.Test.all(
      [ (Darklang.LanguageTools.findBuiltinFn("listMap", 0s32))
        |> Stdlib.Test.equal(
          ((Darklang.LanguageTools.allBuiltinFns())
           |> Stdlib.List.findFirst(fun f ->
             f.name.name == "listMap" && f.name.version == 0s32)))
        (Darklang.LanguageTools.findBuiltinFn("int64ToFloat", 999s32))
        |> Stdlib.Test.equal(None)
        (Darklang.LanguageTools.findBuiltinFn("notARegisteredBuiltin", 0s32))
        |> Stdlib.Test.equal(None)
        (Stdlib.List.all(Darklang.LanguageTools.allBuiltinValues(), fun value ->
          Darklang.LanguageTools.findBuiltinValue(value.name.name, value.name.version)
          == Some(value)))
        |> Stdlib.Test.equal(true)
        (Darklang.LanguageTools.findBuiltinValue("notARegisteredBuiltin", 0s32))
        |> Stdlib.Test.equal(None) ])
