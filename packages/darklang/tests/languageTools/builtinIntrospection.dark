module Darklang.LanguageTools.Tests.BuiltinIntrospection

// Smoke checks for the builtin registry through Darklang.LanguageTools.allBuiltinFns.

module Documentation =
  // Rough sanity check on builtin count — guards against the registry
  // shipping empty (the actual count is well over 100; the threshold
  // is intentionally loose so adding/removing one fn doesn't churn this
  // test).
  test registryIsNotEmpty =
    (LanguageTools.allBuiltinFns() |> Stdlib.List.length) > 100
    |> Stdlib.Test.equal(true)


  // Builtin metadata round-trips: the registry exposes `int64ToFloat` with
  // the parameter shape the type-checker uses at call sites.
  test int64ToFloatParameters =
    (LanguageTools.allBuiltinFns()
     |> Stdlib.List.findFirst(fun f -> f.name.name == "int64ToFloat")
     |> Builtin.unwrap
     |> (fun f -> f.parameters))
    |> Stdlib.Test.equal(
      [ LanguageTools.BuiltinFunctionParameter
          { name = "a"
            type = LanguageTools.RuntimeTypes.TypeReference.TInt64 } ])


module Lookup =
  // Named lookups preserve the metadata exposed by the full registry.
  test namedLookups =
    Stdlib.Test.all(
      [ LanguageTools.findBuiltinFn("listMap", 0s32)
        |> Stdlib.Test.equal(
          LanguageTools.allBuiltinFns()
          |> Stdlib.List.findFirst(fun f ->
            f.name.name == "listMap" && f.name.version == 0s32))

        LanguageTools.findBuiltinFn("int64ToFloat", 999s32)
        |> Stdlib.Test.equal(Stdlib.Option.Option.None)

        LanguageTools.findBuiltinFn("notARegisteredBuiltin", 0s32)
        |> Stdlib.Test.equal(Stdlib.Option.Option.None)

        Stdlib.List.all(LanguageTools.allBuiltinValues(), fun value ->
          LanguageTools.findBuiltinValue(value.name.name, value.name.version)
          == Stdlib.Option.Option.Some(value))
        |> Stdlib.Test.equal(true)

        LanguageTools.findBuiltinValue("notARegisteredBuiltin", 0s32)
        |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])
