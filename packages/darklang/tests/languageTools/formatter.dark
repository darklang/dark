module Darklang.LanguageTools.Formatter.Tests

// `dark format` keeps every comment, in order: a hash can't say so, since comments aren't in one.

val commented =
  """module Darklang.Tests.FormatSample

// before a type
type Shape =
  | Dot // a point
  | Box(Int64, Int64)

// before a fn
/// what it does
let area(s: Shape): Int64 =
  // at the top of the body
  match s with
  | Dot -> 0 // nothing
  // before an arm
  | Box(w, h) ->
    let a = w * h // the product
    [ // inside a list
      a
      0 ]
    |> Stdlib.List.fold(0, fun(x, y) -> x + y) // summed

// at the end
"""


let formattedComments(
  source: String)
  : Stdlib.Result.Result<List<String>, String> =
  LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, source)
  |> Stdlib.Result.map(fun f -> LanguageTools.Formatter.commentTexts(f.text))


test keepsEveryCommentInOrder =
  formattedComments(commented)
  |> Stdlib.Test.equal(Ok(LanguageTools.Formatter.commentTexts(commented)))


test findsTheComments =
  LanguageTools.Formatter.commentTexts(commented)
  |> Stdlib.List.length
  |> Stdlib.Test.equal(10)


// A `///` where nothing stores it: on an enum case's field, and on a local fn.
val unstoredDocs =
  """module Darklang.Tests.FormatSample

type Shape =
  | Box(
    /// the width
    w: Int64,
    h: Int64)

let area(s: Shape): Int64 =
  /// the area of a box
  let boxArea(w: Int64, h: Int64): Int64 = w * h
  match s with
  | Box(w, h) -> boxArea(w, h)
"""


test keepsDocCommentsNothingStores =
  LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, unstoredDocs)
  |> Stdlib.Result.map(fun f -> LanguageTools.Formatter.docLines(f.text))
  |> Stdlib.Test.equal(Ok([ "/// the width", "/// the area of a box" ]))


// What lowering doesn't keep comes back as written: a spread, an escape, a float's exponent.
val keptAsWritten =
  """module Darklang.Tests.FormatSample

let f(xs: List<Int64>): List<Int64> =
  [ 0, ...xs, 1 ]


val esc = "\u001b[0m"

val big = 6.02e22

val small = 5e-324

val smallWithZero = -1.50e-7

val notSmall = 0.000001
"""


test keepsSpreadsEscapesAndFloats =
  LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, keptAsWritten)
  |> Stdlib.Result.map(fun f -> f.text)
  |> Stdlib.Test.equal(Ok(keptAsWritten))


// A `let` inside a list keeps its parentheses, or the items after it would be lines of its block.
val letInList =
  """module Darklang.Tests.FormatSample

let f(): List<Int64> =
  [ 1
    (let x = 2
     x + 1)

    3 ]
"""


test keepsParenthesesOnALetInAList =
  LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, letInList)
  |> Stdlib.Result.map(fun f -> f.text)
  |> Stdlib.Test.equal(Ok(letInList))


test formattingTwiceChangesNothing =
  let once =
    LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, commented)
    |> Stdlib.Result.map(fun f -> f.text)

  let twice =
    once
    |> Stdlib.Result.andThen(fun t ->
      LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 100, t)
      |> Stdlib.Result.map(fun f -> f.text))

  twice |> Stdlib.Test.equal(once)


// A chain of one infix operator broken across lines, in each place a line break could end it.
val infixOperators =
  [ "+"
    "-"
    "*"
    "/"
    "%"
    "**"
    "&"
    "|"
    "^"
    "<<"
    ">>"
    "=="
    "!="
    "<"
    ">"
    "<="
    ">="
    "&&"
    "||" ]


/// For each operator, <param context> with a long chain of it in place of `{}`, and what went
/// wrong formatting it: an error, the chain not broken, or a second format changing the first.
let brokenChainProblems(context: String): List<String> =
  infixOperators
  |> Stdlib.List.filterMap(fun op ->
    let chain =
      [ "alphaOperand", "bravoOperand", "charlieOperand", "deltaOperand" ]
      |> Stdlib.String.join($" {op} ")

    let source =
      "module Darklang.Tests.FormatSample\n\nlet f(): Int64 =\n  "
      + Stdlib.String.replaceAll(context, "{}", chain)
      + "\n"

    let format(text: String): Stdlib.Result.Result<String, String> =
      LanguageTools.Formatter.source(SCM.Branch.mainBranchId, 40, text)
      |> Stdlib.Result.map(fun f -> f.text)

    match format(source) with
    | Error(e) -> Some($"{op}: {e}")
    | Ok(once) ->
      let broken =
        once
        |> Stdlib.String.split("\n")
        |> Stdlib.List.any(fun l ->
          Stdlib.String.startsWith(Stdlib.String.trim(l), $"{op} "))

      if Stdlib.Bool.not(broken) then
        Some($"{op}: not broken before the operator")
      else if format(once) != Ok(once) then
        Some($"{op}: formatting again changes it")
      else
        None)


test keepsABrokenChainInAnArgumentList =
  brokenChainProblems("g(1, {}, 2)") |> Stdlib.Test.equal([])


test keepsABrokenChainInAList =
  brokenChainProblems("[ 1, {}, 2 ]") |> Stdlib.Test.equal([])


test keepsABrokenChainInATuple =
  brokenChainProblems("(1, {}, 2)") |> Stdlib.Test.equal([])


test keepsABrokenChainInARecord =
  brokenChainProblems("R { a = 1, b = {}, c = 2 }") |> Stdlib.Test.equal([])


test keepsABrokenChainInAPipe =
  brokenChainProblems("xs |> Stdlib.List.map(fun x -> {})")
  |> Stdlib.Test.equal([])


test keepsABrokenChainInABody =
  brokenChainProblems("{}") |> Stdlib.Test.equal([])


val subtraction =
  "module Darklang.Tests.FormatSample\n\nlet f(a: Int64, b: Int64): List<Int64> =\n  [ a - b ]\n"


test refusesToChangeWhatCodeMeans =
  LanguageTools.Formatter.parse(subtraction)
  |> Stdlib.Result.map(fun file ->
    // `-` at the start of a line in a list starts a new item: `[ a, -b ]`.
    LanguageTools.Formatter.meaningChange(
      file,
      "module Darklang.Tests.FormatSample\n\nlet f(a: Int64, b: Int64): List<Int64> =\n  [ a\n    - b ]\n"))
  |> Stdlib.Test.equal(
    Ok(
      Some("formatting would change what Darklang.Tests.FormatSample.f means")))


test acceptsTheSameMeaningLaidOutAnotherWay =
  LanguageTools.Formatter.parse(subtraction)
  |> Stdlib.Result.map(fun file ->
    LanguageTools.Formatter.meaningChange(
      file,
      "module Darklang.Tests.FormatSample\n\nlet f(a: Int64, b: Int64): List<Int64> =\n  [ a\n      - b ]\n"))
  |> Stdlib.Test.equal(Ok(None))


test refusesWhatDoesNotParse =
  LanguageTools.Formatter.parse(subtraction)
  |> Stdlib.Result.map(fun file ->
    LanguageTools.Formatter.meaningChange(
      file,
      "module Darklang.Tests.FormatSample\n\nlet f(a: Int64, b: Int64): List<Int64> =\n  [ a -\n")
    |> Stdlib.Option.map(fun e ->
      Stdlib.String.startsWith(e, "formatting would leave it not parsing")))
  |> Stdlib.Test.equal(Ok(Some(true)))


// `Some`, `None`, `Ok` and `Error` read back as Stdlib's Option and Result from any module, a test
// module too, so they print bare. Another type's `Error` keeps its type.
val bareCases =
  """module Darklang.Tests.FormatSample

val a = Stdlib.Option.Option.Some(1)

val b = Stdlib.Result.Result.Error("no")

val c = Option.None

val d = Stdlib.Cli.UI.Node.Severity.Error
"""


test printsStdlibCasesBare =
  match LanguageTools.Formatter.source(
          SCM.Branch.mainBranchId,
          100,
          bareCases) with
  | Ok(f) ->
    [ "val a = Some(1)"
      "val b = Error(\"no\")"
      "val c = None"
      "val d = Stdlib.Cli.UI.Node.Severity.Error" ]
    |> Stdlib.List.filter(fun line ->
      Stdlib.Bool.not(Stdlib.String.contains(f.text, line)))
    |> Stdlib.Test.equal([])
  | Error(e) -> Stdlib.Test.fail(e)
