module Darklang.LanguageTools.Parser.RoundTrip.Tests

// Parse-then-print round trips: exprs. Moved from
// backend/tests/Tests/LibParser.RoundTrip.Tests.fs; helpers are in roundTrip.dark.

test exprsUnwrapOfVariable =
  Stdlib.Test.all(
    [ roundTrip("unwrap of variable", "fun x -> Ok(x?)", "(fun x -> Result.Ok(x?))")
      roundTrip("unwrap of application", "fun x -> Ok((f(x))?)", "(fun x -> Result.Ok((f(x))?))")
      roundTrip("unwrap chain", "fun x -> Some(x?.field?)", "(fun x -> Option.Some(x?.field?))")
      roundTrip("nested unwrap", "fun x -> Ok(x??)", "(fun x -> Result.Ok(x??))")
      // units
      roundTrip("unit literal", "()", "()")
      // bools
      roundTrip("true literal", "true", "true")
      roundTrip("false literal", "false", "false")
      // parens (disappear)
      roundTrip("parens, basic", "(true)", "true") ])

test exprsIntLiterals =
  Stdlib.Test.all(
    [ // int literals
      roundTrip("int literal 1s8", "1s8", "1s8")
      roundTrip("int literal -1s8", "-1s8", "-1s8")
      roundTrip("int literal 1u8", "1u8", "1u8")
      roundTrip("int literal 1s16", "1s16", "1s16")
      roundTrip("int literal 1u16", "1u16", "1u16")
      roundTrip("int literal 1s32", "1s32", "1s32")
      roundTrip("int literal -1s32", "-1s32", "-1s32")
      roundTrip("int literal 1u32", "1u32", "1u32")
      roundTrip("int literal 0", "0", "0")
      roundTrip("int literal 1900", "1900", "1900")
      roundTrip("int literal -1900", "-1900", "-1900")
      roundTrip("int literal 1u64", "1u64", "1u64")
      roundTrip("int literal 1s128", "1s128", "1s128")
      roundTrip("int literal -1s128", "-1s128", "-1s128")
      roundTrip("int literal 1u128", "1u128", "1u128")
      // the 64-bit spellings print as the default they mean
      roundTrip("int literal 1s", "1s", "1")
      roundTrip("int literal 1s64", "1s64", "1")
      roundTrip("int literal 1u", "1u", "1u64")
      roundTrip("int literal 1z", "1z", "1z")
      roundTrip("int literal -1z", "-1z", "-1z")
      roundTrip(
        "int literal past Int64",
        "18446744073709551616z",
        "18446744073709551616z")
      roundTrip("int literal min Int64", "-9223372036854775808", "-9223372036854775808") ])

test exprsFloat32AndDecimalLiterals =
  Stdlib.Test.all(
    [ roundTrip("float literal 1.5f64", "1.5f64", "1.5")
      roundTrip("float literal 1e5", "1e5", "100000.0")
      roundTrip("float32 literal 1.5f32", "1.5f32", "1.5f32")
      roundTrip("float32 literal -0.25f32", "-0.25f32", "-0.25f32")
      roundTrip("float32 literal 1e5f32", "1e5f32", "100000.0f32")
      roundTrip("float32 literal 1f32", "1f32", "1.0f32")
      roundTrip("decimal literal 19.99dec", "19.99dec", "19.99dec")
      roundTrip("decimal literal keeps its scale", "1.10dec", "1.10dec")
      roundTrip("decimal literal -0.05dec", "-0.05dec", "-0.05dec")
      roundTrip("decimal literal 1dec", "1dec", "1dec")
      roundTrip("match, int 1z", "match 1z with\n| 1z -> true", "match 1z with\n| 1z -> true")
      roundTrip(
        "match, float32",
        "match 1.5f32 with\n| 1.5f32 -> true",
        "match 1.5f32 with\n| 1.5f32 -> true")
      roundTrip(
        "match, decimal",
        "match 19.99dec with\n| 19.99dec -> true",
        "match 19.99dec with\n| 19.99dec -> true") ])

test exprsFloatLiterals =
  Stdlib.Test.all(
    [ // float literals
      roundTrip("float literal -1.0", "-1.0", "-1.0")
      roundTrip("float literal -1.5", "-1.5", "-1.5")
      roundTrip("float literal 1.5", "1.5", "1.5")
      roundTrip("float literal 0.0", "0.0", "0.0")
      roundTrip("float literal 0.775", "0.775", "0.775")
      // string literals
      roundTrip("empty string", "\"\"", "\"\"")
      roundTrip("hello", "\"hello\"", "\"hello\"")
      roundTrip("hello tab world", "\"hello\\tworld\"", "\"hello\\tworld\"") ])

test exprsStringEscapeRound =
  Stdlib.Test.all(
    [ // string-escape round-trips: parser decodes, pretty-printer re-encodes.
      roundTrip("string newline escape", "\"a\\nb\"", "\"a\\nb\"")
      roundTrip("string quote escape", "\"a\\\"b\"", "\"a\\\"b\"")
      roundTrip("string backslash escape", "\"a\\\\b\"", "\"a\\\\b\"")
      roundTrip("string bell escape", "\"\\a\"", "\"\\a\"")
      roundTrip("string backspace escape", "\"\\b\"", "\"\\b\"")
      roundTrip("string form-feed escape", "\"\\f\"", "\"\\f\"")
      roundTrip("string vertical-tab escape", "\"\\v\"", "\"\\v\"")
      roundTrip("string carriage-return escape", "\"\\r\"", "\"\\r\"")
      roundTrip("string hex escape \\xHH", "\"\\x41\"", "\"A\"")
      roundTrip("string hex escape \\XHHHH", "\"\\X0041\"", "\"A\"")
      roundTrip("string unicode escape \\uHHHH", "\"\\u00E9\"", "\"é\"")
      roundTrip("string unicode escape \\UHHHHHHHH", "\"\\U00000041\"", "\"A\"")
      roundTrip("string forward-slash escape", "\"\\/\"", "\"/\"")
      roundTrip("string single-quote escape in double quotes", "\"\\'\"", "\"'\"") ])

test exprsDecodedValueAssertions =
  Stdlib.Test.all(
    [ // Decoded-value assertions: prove the byte/char actually decoded, not
      // just that it survived a symmetric round-trip through the pretty-printer.
      decodesToString("decoded \\r is CR", "\"\\r\"", "\r")
      decodesToString("decoded \\x41 is A", "\"\\x41\"", "A")
      decodesToString("decoded \\X0041 is A", "\"\\X0041\"", "A")
      decodesToString("decoded \\u00E9 is é", "\"\\u00E9\"", "é")
      decodesToString("decoded \\U00000041 is A", "\"\\U00000041\"", "A")
      decodesToString("decoded \\/ is /", "\"\\/\"", "/")
      decodesToString("decoded \\' in string is '", "\"\\'\"", "'")
      decodesToString("decoded \\n is LF", "\"a\\nb\"", "a\nb")
      decodesToString("decoded \\t is HT", "\"a\\tb\"", "a\tb")
      decodesToString("decoded \\\\ is backslash", "\"a\\\\b\"", "a\\b")
      decodesToString("decoded \\u00E9 above-BMP \\U0001F600", "\"\\U0001F600\"", "😀") ])

test exprsInterpolationTextSegments =
  Stdlib.Test.all(
    [ // Interpolation text segments decode escapes too.
      decodesToString("decoded interpolation with escape", "$\"a\\nb {\"x\"}\"", "a\nb x")
      // Char literals: decode covers all the same shapes the string side does.
      decodesToChar("decoded '\\n' is LF", "'\\n'", "\n")
      decodesToChar("decoded '\\r' is CR", "'\\r'", "\r")
      decodesToChar("decoded '\\\\' is backslash", "'\\\\'", "\\")
      decodesToChar("decoded '\\'' is single-quote", "'\\''", "'")
      decodesToChar("decoded '\\x41' is A", "'\\x41'", "A")
      decodesToChar("decoded '\\X0041' is A", "'\\X0041'", "A")
      decodesToChar("decoded '\\u00E9' is é", "'\\u00E9'", "é")
      decodesToChar("decoded '\\U00000041' is A", "'\\U00000041'", "A")
      decodesToChar("decoded '\\/' is /", "'\\/'", "/")
      roundTrip(
        "string match pattern with escape",
        "match s with\n| \"a\\nb\" -> 1\n| _ -> 0",
        "match s with\n| \"a\\nb\" -> 1\n| _ -> 0")
      roundTrip("egc", "\"👩‍👩‍👧‍👦\"", "\"👩‍👩‍👧‍👦\"")
      roundTrip("unicode", "\"żółw\"", "\"żółw\"")
      roundTrip("string interpolation", "$\"hello {name}\"", "$\"hello {name}\"")
      roundTrip("interpolation with escape", "$\"a\\nb {name}\"", "$\"a\\nb {name}\"") ])

test exprsInvalidEscapeSequences =
  Stdlib.Test.all(
    [ // Invalid escape sequences are rejected instead of dropped.
      rejected("invalid escape in string literal", "\"\\d+\"")
      rejected("invalid escape in interpolation", "$\"a\\d+b\"")
      rejected("invalid escape in char literal", "'\\d'")
      rejected(
        "invalid escape in string match pattern",
        "match s with\n| \"\\d+\" -> 1\n| _ -> 0")
      rejected("invalid escape in char match pattern", "match c with\n| '\\d' -> 1\n| _ -> 0")
      // A constructor pattern's fields go in parentheses, qualified or not.
      rejected(
        "enum-case match pattern with a spaced field",
        "match x with\n| Ok n -> 1\n| _ -> 0")
      rejected(
        "qualified enum-case match pattern with a spaced field",
        "match x with\n| Result.Ok n -> 1\n| _ -> 0")
      rejectedWithNote(
        "a spaced constructor-pattern field says to use parentheses",
        "match x with\n| Stdlib.Result.Result.Ok n -> 1\n| _ -> 0",
        "a constructor pattern's fields go in parentheses, separated by commas") ])

test exprEntryPointsRejectSyntaxErrors =
  Stdlib.Test.all(
    [ exprRejected("garbage tokens", "@@@")
      exprRejected(
        "a spaced constructor-pattern field",
        "match x with\n| Ok n -> 1\n| _ -> 0")
      sourceFileRejected(
        "a fn whose body has a syntax error",
        "let f(x: Int64): Int64 =\n  match x with\n  | Ok n -> 1\n  | _ -> 0")
      sourceFileRejected("garbage after a declaration", "let f(): Int64 = 1\n@@@") ])

// The line and column in the message count from 1, as the position in the parser message does.
test parseErrorMessageCountsFromOne =
  match LanguageTools.Parser.Parse.parsePTExpr("Stdlib.Int64.add(1, 2") with
  | Error(e) ->
    Stdlib.Test.equal(
      LanguageTools.Parser.Parse.ParseError.toString(e),
      "Parse error at line 1, column 22: expected ')' to close the '(' at line 1:17, found end of file")
  | Ok(_) -> Stdlib.Test.fail("parsed, but should have been rejected")

test exprsWellFormedEscapes =
  Stdlib.Test.all(
    [ // Well-formed escapes that are not valid Unicode scalars are rejected:
      // - surrogate range (D800..DFFF)
      // - above the Unicode max (>0x10FFFF)
      rejected("surrogate codepoint \\uD800", "\"\\uD800\"")
      rejected("surrogate codepoint \\U0000D800", "\"\\U0000D800\"")
      rejected("codepoint above max \\U00110000", "\"\\U00110000\"")
      rejected("surrogate codepoint in char", "'\\uD800'")
      rejected("codepoint above max in char", "'\\U00110000'")
      // Pure syntax-rejection cases (no escape involvement).
      rejected("garbage tokens produce a parse error", "@@@")
      roundTrip(
        "string interpolation - multiple expr to eval",
        "$\"Name: {name}, Age: {age}\"",
        "$\"Name: {name}, Age: {age}\"")
      roundTrip(
        "multiline string ",
        "\"\"\"int64Multiply's 2nd argument (`b`) should be an Int64. However, a Float (1.0) was passed instead.\n\n\n\n    Expected: (b: Int64)\n\n    Actual: a Float: 1.0\"\"\"",
        "\"int64Multiply's 2nd argument (`b`) should be an Int64. However, a Float (1.0) was passed instead.\\n\\n\\n\\n    Expected: (b: Int64)\\n\\n    Actual: a Float: 1.0\"")
      roundTrip(
        "multiline string - interpolated",
        "$\"\"\"test {\"1\"}\"\"\" == \"test 1\"",
        "$\"test {\"1\"}\" == \"test 1\"") ])

test exprsCharLiterals =
  Stdlib.Test.all(
    [ // char literals
      roundTrip("the letter a", "'a'", "'a'")
      roundTrip("a newline char", "'\\n'", "'\\n'")
      roundTrip("a tab char", "'\t'", "'\\t'")
      // list literal
      roundTrip("empty list", "[]", "[]")
      roundTrip("string list", "[\"hello\"]", "[\"hello\"]")
      roundTrip("int list 2", "[1, 2]", "[1, 2]")
      roundTrip("int list 3", "[1, 2, 3,]", "[1, 2, 3]")
      roundTrip("bool list", "[true, false, true, false]", "[true, false, true, false]")
      roundTrip("int list list", "[[1, 2], [3, 4]]", "[[1, 2], [3, 4]]")
      roundTrip(
        "list with newline as a separator",
        "[ true\n false\n true ]",
        "[true, false, true]")
      roundTrip(
        "list of function calls",
        "[\n  Stdlib.Tuple2.second((4, 5))\n  Stdlib.Int64.remainder(1, 2)\n  Stdlib.List.head([1, 2])\n]",
        "[\n  Stdlib.Tuple2.second((4, 5)),\n  Stdlib.Int64.remainder(1, 2),\n  Stdlib.List.head([1, 2])\n]")
      roundTrip(
        "list of function calls -indented",
        "[\n  Stdlib.Tuple2.second((4, 5))\n  (Stdlib.Int64.remainder(\n    1,\n    2))\n  Stdlib.List.head([1, 2])\n]",
        "[\n  Stdlib.Tuple2.second((4, 5)),\n  Stdlib.Int64.remainder(1, 2),\n  Stdlib.List.head([1, 2])\n]") ])

test exprsDictLiteral =
  Stdlib.Test.all(
    [ // dict literal
      roundTrip("empty dict", "Dict { }", "Dict {}")
      roundTrip("simple string-keyed dict", "Dict { \"a\": 1 }", "Dict { \"a\": 1 }")
      roundTrip(
        "string dict",
        "Dict { \"a\": \"hello\", \"b\": \"test\" }",
        "Dict { \"a\": \"hello\", \"b\": \"test\" }")
      roundTrip(
        "longer dict",
        "Dict { \"a\": 1, \"b\": 2, \"c\": 3 }",
        "Dict { \"a\": 1, \"b\": 2, \"c\": 3 }")
      // Dict keys are expressions, not field names. String keys use ordinary string syntax.
      roundTrip(
        "dict key that isn't a bare identifier",
        "Dict { \"Content-Length\": 1 }",
        "Dict { \"Content-Length\": 1 }")
      roundTrip(
        "dict keyed by Int64",
        "Dict { 1: \"one\", 2: \"two\" }",
        "Dict { 1: \"one\", 2: \"two\" }")
      roundTrip("dict keyed by tuple", "Dict { (1, \"a\"): true }", "Dict { (1, \"a\"): true }")
      roundTrip(
        "dict with a computed key",
        "Dict { Stdlib.toString(1): 1 }",
        "Dict { Stdlib.toString(1): 1 }") ])

test exprsTupleLiterals =
  Stdlib.Test.all(
    [ // tuple literals
      roundTrip("tuple 2", "(1, \"hello\")", "(1, \"hello\")")
      roundTrip("tuple 3", "(1, \"hello\", 2)", "(1, \"hello\", 2)")
      roundTrip("tuple 4", "(1, \"hello\", 2, true)", "(1, \"hello\", 2, true)")
      roundTrip("tuple with expr", "(1, 2 + 3, 4)", "(1, 2 + 3, 4)")
      // record literals
      roundTrip("record, 1 field", "Person1 {name =\"John\"} ", "Person1 { name = \"John\" }")
      roundTrip(
        "record field name with hyphen",
        "Headers { ``Content-Length`` = \"text/html\" }",
        "Headers { ``Content-Length`` = \"text/html\" }")
      roundTrip(
        "record field name that is a keyword",
        "Metadata { ``type`` = \"json\" }",
        "Metadata { ``type`` = \"json\" }")
      roundTrip(
        "record, 2 fields",
        "Person2 {name =\"John\", age = 30} ",
        "Person2 { name = \"John\", age = 30 }") ])

test exprsRecordWithType =
  Stdlib.Test.all(
    [ // record with type args
      // record update
      roundTripWith(
        person,
        "record update 2",
        "{ person with age = 31 }",
        "{ person with age = 31 }")
      roundTrip(
        "record update field name that is a keyword",
        "{ metadata with ``type`` = \"json\" }",
        "{ metadata with ``type`` = \"json\" }")
      roundTripWith(
        person,
        "record update 3",
        "{ person with age = 31, hasPet = false }",
        "{ person with age = 31, hasPet = false }")
      // enum literal
      roundTrip("enum with type args", "Generic<Int64>.A(1)", "Generic<Int64>.A(1)")
      // Literal braces in an interpolated string are written doubled; printed back, they must be
      // doubled again, or `{{x}}` (the text `{x}`) comes back as an interpolation of `x`.
      roundTrip("interpolated string, literal braces", "$\"{{x}} = {x}\"", "$\"{{x}} = {x}\"")
      roundTrip("option none, short", "Stdlib.Option.Option.None", "Option.None")
      roundTrip("option none, long", "Stdlib.Option.Option.None", "Option.None")
      roundTrip("option some", "Stdlib.Option.Option.Some(1)", "Option.Some(1)")
      roundTrip("custom enum fn params", "MyEnum.D(1, 2)", "MyEnum.D(1, 2)")
      roundTrip(
        "enum with indented field",
        "Stdlib.Result.Result.Error(\n  Stdlib.List.ChunkBySizeError.SizeMustBeGreaterThanZero)",
        "Result.Error(Stdlib.List.ChunkBySizeError.SizeMustBeGreaterThanZero)") ])

test exprsQualifiedValue =
  Stdlib.Test.all(
    [ // qualified value
      roundTrip("qualified value", "Stdlib.List.empty", "Stdlib.List.empty")
      // variables and let bindings
      roundTrip("assumed var name", "assumedlyAVariableName", "assumedlyAVariableName")
      // Pretty-printing normalizes the let body indentation.
      roundTrip("simple let expr", "let x = 1\n  x", "let x = 1\nx")
      // A nested function definition desugars to a lambda bound by a let, so the
      // roundtrip is intentionally lossy: the param/return types are dropped and the
      // `let f (x) = ...` sugar prints as `let f = (fun x -> ...)`. (Top-level
      // `let f (x): R = ...` is a fn_decl and keeps its types - this only applies to
      // a `let` nested inside an expression.)
      roundTrip(
        "nested function definition (desugars to lambda)",
        "let result =\n  let double(x: Int64): Int64 = x * 2\n  double(5)\nresult",
        "let result =\n  let double = (fun x -> x * 2)\n  double(5)\nresult")
      roundTrip("let expr with indent", "let x =\n  1\nx", "let x = 1\nx")
      roundTrip(
        "tuple destructuring",
        "let (var1, var2) = var3\n(var1, var2)",
        "let (var1, var2) = var3\n(var1, var2)")
      roundTrip(
        "tuple destructuring 2",
        "let (var1, var2) = (var3, var4)\n(var1, var2)",
        "let (var1, var2) = (var3, var4)\n(var1, var2)")
      // field access
      roundTrip("field access 1", "person.name", "person.name")
      roundTrip("tuple element access", "pair.2", "pair.2") ])

// A fn named with type args and not called keeps them, and stays uncalled.
test exprsTypedFnValue =
  Stdlib.Test.all(
    [ roundTrip(
        "typed fn value",
        "Stdlib.List.map<Int64, Int64>",
        "Stdlib.List.map<Int64, Int64>")
      roundTrip(
        "typed fn value, bound",
        "let h = Stdlib.List.map<Int64, String>\nh",
        "let h = Stdlib.List.map<Int64, String>\nh")
      roundTrip(
        "typed fn value, passed",
        "Stdlib.List.map([1], Stdlib.Option.map<Int64, Int64>)",
        "Stdlib.List.map([1], Stdlib.Option.map<Int64, Int64>)")
      roundTrip(
        "typed fn call, unchanged",
        "Stdlib.List.map<Int64, Int64>([1], fun x -> x)",
        "Stdlib.List.map<Int64, Int64>([1], fun x -> x)") ])

test exprsPreserveBothAccesses =
  Stdlib.Test.all(
    [ // Preserve both accesses despite the lexer reading `1.2` as a float.
      roundTrip("nested tuple element access", "pair.1.2", "pair.1.2")
      roundTrip(
        "field access with hyphenated field name",
        "headers.``Content-Length``",
        "headers.``Content-Length``")
      roundTrip("field access with keyword field name", "metadata.``type``", "metadata.``type``")
      roundTrip(
        "nested field access",
        "record.someField.anotherFieldInsideThat",
        "record.someField.anotherFieldInsideThat")
      roundTrip("field access in context", "person.age + 1", "person.age + 1")
      // lambda
      roundTrip("simple lambda", "fun x -> x + 1", "(fun x -> x + 1)")
      roundTrip("lambda wrapped with parens", "(fun x -> x + 1)", "(fun x -> x + 1)")
      roundTrip("lambda, 2 args", "fun(x, y) -> x * y", "(fun(x, y) -> x * y)")
      roundTrip("lambda, unit arg", "fun () -> 1", "(fun () -> 1)")
      roundTrip(
        "lambda with notable body",
        "fun var -> (Stdlib.String.toUppercase(Stdlib.String.fromChar(var)))",
        "(fun var -> Stdlib.String.toUppercase(Stdlib.String.fromChar(var)))")
      roundTrip(
        "lambda with notable body 2",
        "fun((str1, str2)) -> str1 + str2",
        "(fun((str1, str2)) -> str1 + str2)") ])

test exprsIfExpressions =
  Stdlib.Test.all(
    [ // if expressions
      roundTrip("if, 1", "if true then 1", "if true then 1")
      roundTrip("if, 2", "if true then 1 else 2", "if true then 1 else 2")
      roundTrip(
        "if, 3",
        "if a < b then 1 else if c > d then 2",
        "if a < b then 1 else if c > d then 2")
      roundTrip(
        "if, 4",
        "if a < b then 1 else if c > d then 2 else 3",
        "if a < b then 1 else if c > d then 2 else 3")
      roundTrip("if, 5", "if true then\n 1", "if true then 1")
      roundTrip("if, 6", "if true then\n 1\nelse\n 2", "if true then 1 else 2")
      roundTrip(
        "if, 7",
        "if true then\n a\nelse if false then\n c",
        "if true then a else if false then c")
      roundTrip(
        "if, 8",
        "if a > b then\n a\nelse if c > d then\n c\nelse d",
        "if a > b then a else if c > d then c else d")
      roundTrip("if, 9", "if true then\n\ta\nelse\n\tb", "if true then a else b")
      roundTrip(
        "if, many branches",
        "if true then\n  a\nelse if false then\n  c\nelse if true then\n  d",
        "if true then a else if false then c else if true then d")
      roundTrip(
        "else for inner if",
        "\nif a > b then\n  if c > d then\n    c\n  else\n    b",
        "if a > b then\n  if c > d then c else b")
      roundTrip(
        "else for outer if",
        "\nif a > b then\n  if c > d then\n    c\nelse\n  b",
        "if a > b then\n  if c > d then c\nelse\n  b")
      roundTrip(
        "nested if",
        "if a > b then\n  a\nelse\n  if c > d then\n    c\n  else\n    if e > f then\n      e\n    else\n      if g > h then\n        g\n      else\n        h",
        "if a > b then\n  a\nelse if c > d then c else if e > f then e else if g > h then g else h") ])

test exprsMatchExpressions =
  Stdlib.Test.all(
    [ // match expressions
      roundTrip("match, unit", "match () with\n| () -> true", "match () with\n| () -> true")
      roundTrip("match, bool", "match true with\n| true -> true", "match true with\n| true -> true")
      roundTrip("match, int 1s8", "match 1s8 with\n| 1s8 -> true", "match 1s8 with\n| 1s8 -> true")
      roundTrip("match, int -1s8", "match -1s8 with\n| -1s8 -> true", "match -1s8 with\n| -1s8 -> true")
      roundTrip("match, int 0u8", "match 0u8 with\n| 0u8 -> true", "match 0u8 with\n| 0u8 -> true")
      roundTrip("match, int 1s16", "match 1s16 with\n| 1s16 -> true", "match 1s16 with\n| 1s16 -> true")
      roundTrip("match, int 2u16", "match 2u16 with\n| 2u16 -> true", "match 2u16 with\n| 2u16 -> true")
      roundTrip("match, int 3s32", "match 3s32 with\n| 3s32 -> true", "match 3s32 with\n| 3s32 -> true")
      roundTrip("match, int 5u32", "match 5u32 with\n| 5u32 -> true", "match 5u32 with\n| 5u32 -> true")
      roundTrip("match, int 7", "match 7 with\n| 7 -> true", "match 7 with\n| 7 -> true")
      roundTrip("match, int 8u64", "match 8u64 with\n| 8u64 -> true", "match 8u64 with\n| 8u64 -> true")
      roundTrip("match, int 9s128", "match 9s128 with\n| 9s128 -> true", "match 9s128 with\n| 9s128 -> true")
      roundTrip("match, int 10u128", "match 10u128 with\n| 10u128 -> true", "match 10u128 with\n| 10u128 -> true")
      roundTrip(
        "match, float 0.9",
        "match 0.9 with\n| 0.9 -> true",
        "match 0.9 with\n| 0.9 -> true")
      roundTrip(
        "match, string",
        "match \"str\" with\n| \"str\" -> true",
        "match \"str\" with\n| \"str\" -> true")
      roundTrip("match, char", "match 'c' with\n| 'c' -> true", "match 'c' with\n| 'c' -> true")
      roundTrip("match, var", "match var with\n| var -> true", "match var with\n| var -> true")
      roundTrip(
        "match, str 2",
        "match \"str\" with\n| \"str\" -> true\n| \"other\" -> false",
        "match \"str\" with\n| \"str\" -> true\n| \"other\" -> false")
      roundTrip(
        "match, int list 1",
        "match [1, 2] with\n| [1, 2] -> true",
        "match [1, 2] with\n| [1, 2] -> true")
      roundTrip(
        "match, int list 2",
        "match [1, 2, 3] with\n| [head, ...tail] ->\n \"pass\"",
        "match [1, 2, 3] with\n| [head, ...tail] -> \"pass\"") ])

test exprsMatchAsAndOr =
  Stdlib.Test.all(
    [ roundTrip(
        "match, as names an or-pattern",
        "match 2 with\n| 1 | 2 as n -> n\n| _ -> 0",
        "match 2 with\n| 1 | 2 as n -> n\n| _ -> 0")
      roundTrip(
        "match, as and or inside a tuple",
        "match (2, 3) with\n| ((1 | 2), y) -> y\n| ((x as z), _) -> z",
        "match (2, 3) with\n| ((1 | 2), y) -> y\n| ((x as z), _) -> z")
      roundTrip(
        "match, as and or in list elements",
        "match [2] with\n| [1 | 2] -> true\n| [a as b, ...] -> false\n| _ -> false",
        "match [2] with\n| [1 | 2] -> true\n| [a as b, ...] -> false\n| _ -> false")
      roundTrip(
        "match, as in or alternatives",
        "match x with\n| (Ok(y) as r) | (Error(y) as r) -> y",
        "match x with\n| (Ok(y) as r) | (Error(y) as r) -> y")
      roundTrip(
        "match, as after a nullary case",
        "match x with\n| None as n -> n\n| _ -> x",
        "match x with\n| None as n -> n\n| _ -> x")
      roundTrip(
        "match, as in an enum field",
        "match x with\n| Ok((a, _) as pair) -> pair\n| _ -> (0, 0)",
        "match x with\n| Ok((a, _) as pair) -> pair\n| _ -> (0, 0)") ])

test exprsMatchRecord =
  Stdlib.Test.all(
    [ roundTrip(
        "match, record shorthand",
        "match p with\n| { name } -> name",
        "match p with\n| { name } -> name")
      roundTrip(
        "match, record fields and shorthand",
        "match p with\n| { name = \"Jo\", age } -> age\n| { age = 30 } -> 0\n| _ -> 1",
        "match p with\n| { name = \"Jo\", age } -> age\n| { age = 30 } -> 0\n| _ -> 1")
      // `name = name` is the shorthand spelled out
      roundTrip(
        "match, record field bound to its own name",
        "match p with\n| { name = name, age = a } -> a",
        "match p with\n| { name, age = a } -> a")
      roundTrip(
        "match, record nested, tuple, or and as",
        "match a with\n| { owner = { name }, pos = (x, _), status = Active | Inactive as s } -> x",
        "match a with\n| { owner = { name }, pos = (x, _), status = Active | Inactive as s } -> x")
      roundTrip(
        "match, record inside enum and tuple",
        "match x with\n| (Some({ name }), { age = 3 }) -> name",
        "match x with\n| (Some({ name }), { age = 3 }) -> name") ])

test exprsMatchIntTuple =
  Stdlib.Test.all(
    [ roundTrip(
        "match, int tuple",
        "match (1, 2) with\n| (1, 2) -> true",
        "match (1, 2) with\n| (1, 2) -> true")
      roundTrip(
        "match, enum",
        "match Stdlib.Result.Result.Ok(5) with\n| Ok(5) -> true\n| Error(e) -> false",
        "match Result.Ok(5) with\n| Ok(5) -> true\n| Error(e) -> false")
      roundTrip(
        "match, qualified enum patterns",
        "match Stdlib.Result.Result.Ok(5) with\n| Result.Ok(5) -> true\n| Stdlib.Result.Result.Error(e) -> false",
        "match Result.Ok(5) with\n| Ok(5) -> true\n| Error(e) -> false")
      roundTrip(
        "match, enum with 2 args",
        "match MyEnum.D(5, 3) with\n| D(5, 3) -> true\n| _  -> false",
        "match MyEnum.D(5, 3) with\n| D(5, 3) -> true\n| _ -> false")
      roundTrip(
        "match, enum with 1 tuple arg",
        "match Stdlib.Result.Result.Ok((5, 3)) with\n| Ok((5, 3)) -> true\n| Error(e)  -> false",
        "match Result.Ok((5, 3)) with\n| Ok((5, 3)) -> true\n| Error(e) -> false")
      roundTrip(
        "match, string 3",
        "match \"str\" with\n| \"str\" when true -> true",
        "match \"str\" with\n| \"str\" when true -> true")
      roundTrip(
        "match, when simple",
        "match x with\n| y when y > 1 -> true\n| z when z < 1 -> false\n| w -> w",
        "match x with\n| y when y > 1 -> true\n| z when z < 1 -> false\n| w -> w")
      roundTrip("match, ignored 1", "match true with\n| _ -> true", "match true with\n| _ -> true")
      roundTrip(
        "match, ignored 2",
        "match true with\n| _var -> true",
        "match true with\n| _var -> true")
      roundTrip(
        "match, multiple patterns",
        "match (1, 2) with\n| (1, 2) | (2, 1) -> true\n| _ -> false",
        "match (1, 2) with\n| (1, 2) | (2, 1) -> true\n| _ -> false") ])

test exprsPipeExpression =
  Stdlib.Test.all(
    [ // pipe expression
      roundTrip("pipe, infix", "1 |> (fun v -> v + 2)", "1 |> (fun v -> v + 2)")
      // Bitwise operators. `**` is exponentiation and nests right; the bitwise
      // levels bind tighter than the comparisons, so a `==` operand keeps no parens.
      roundTrip("bitwise and", "1 & 2", "1 & 2")
      roundTrip("bitwise or", "1 | 2", "1 | 2")
      roundTrip("bitwise xor", "1 ^ 2", "1 ^ 2")
      roundTrip("shift left", "1 << 2", "1 << 2")
      roundTrip("shift right", "1 >> 2", "1 >> 2")
      roundTrip("power is right-assoc", "2 ** 3 ** 2", "2 ** 3 ** 2")
      roundTrip("power needs parens on the left", "(2 ** 3) ** 2", "(2 ** 3) ** 2")
      roundTrip("bitwise binds tighter than ==", "1 & 2 == 0", "1 & 2 == 0")
      roundTrip("or is loosest of the bitwise ops", "1 | 2 ^ 3 & 4", "1 | 2 ^ 3 & 4")
      roundTrip("an or operand of xor keeps parens", "(1 | 2) ^ 3", "(1 | 2) ^ 3")
      roundTrip("shifts bind tighter than +", "1 << 2 + 3", "1 << 2 + 3") ])

test exprsThePrefixOperators =
  Stdlib.Test.all(
    [ // The prefix operators desugar to the call they are, so the NORMAL FORM prints
      // that call rather than the operator.
      roundTrip("prefix bang", "!true", "Builtin.boolNot(true)")
      roundTrip("prefix tilde", "~1", "Stdlib.BitwiseNot.bitwiseNot(1)")
      roundTrip("unary minus on a non-literal", "-x", "Stdlib.Negate.negate(x)")
      roundTrip("prefix bang takes a whole application", "!f(x)", "Builtin.boolNot(f(x))")
      // `|` is the match-arm separator inside a match, so a bitwise-or in an arm
      // body has to come back parenthesised or it re-parses as the next arm.
      roundTrip(
        "bitwise or in a match arm is parenthesised",
        "match x with\n| 0 -> (1 | 2)\n| n -> n",
        "match x with\n| 0 -> (1 | 2)\n| n -> n")
      roundTrip(
        "a match arm comparison over a bitwise or is parenthesised",
        "match x with\n| 0 -> (1 | 2) == 3\n| n -> n",
        "match x with\n| 0 -> (1 | 2 == 3)\n| n -> n")
      roundTrip(
        "a bracketed bitwise or in a match arm needs no extra parens",
        "match x with\n| 0 -> [1 | 2]\n| n -> n",
        "match x with\n| 0 -> [1 | 2]\n| n -> n")
      roundTrip(
        "pipe, computed arg",
        "[1, 2] |> Stdlib.List.take(2 - 1)",
        "[1, 2] |> Stdlib.List.take(2 - 1)")
      roundTrip(
        "pipe, if head",
        "(if true then 1 else 2) |> (fun v -> v + 1)",
        "(if true then 1 else 2) |> (fun v -> v + 1)")
      roundTrip("pipe, into var", "1 |> x", "1 |> x")
      roundTrip("pipe, into lambda", "1 |> (fun x -> x + 1)", "1 |> (fun x -> x + 1)")
      roundTrip("pipe, into lambda, 2", "1 |> fun x -> x + 1", "1 |> (fun x -> x + 1)")
      roundTrip("pipe, into enum", "3 |> Stdlib.Result.Result.Ok", "3 |> Result.Ok")
      roundTrip(
        "pipe, lambda then another stage",
        "1 |> (fun x -> x + 1) |> (fun v -> v + 2)",
        "1 |> (fun x -> x + 1) |> (fun v -> v + 2)")
      roundTrip("pipe, into fn call", "1 |> (fun v -> v + 2)", "1 |> (fun v -> v + 2)")
      roundTrip("pipe, into fn call 2", "1 |> Stdlib.toString", "1 |> Stdlib.toString")
      roundTrip(
        "pipe, into fn call 3",
        "\"true\" |> Builtin.jsonParse<Bool>",
        "\"true\" |> Builtin.jsonParse<Bool>")
      roundTrip(
        "pipe, into fn call 4",
        "1 + 2 |> (fun v -> v + 1)",
        "1 + 2 |> (fun v -> v + 1)")
      roundTrip(
        "pipe, into fn call 5",
        "[1, 2] |> Stdlib.List.last |> Builtin.unwrap",
        "[1, 2] |> Stdlib.List.last |> Builtin.unwrap") ])

test exprsInfixCallsPretty =
  Stdlib.Test.all(
    [ // Infix calls pretty-print with explicit operand parentheses.
      roundTrip("fn call, add once", "1 + 2", "1 + 2")
      roundTrip("fn call, add twice", "1 + b + 3", "1 + b + 3")
      roundTrip("fn call, add thrice", "1 + 2 * 3 - 4", "1 + 2 * 3 - 4")
      roundTrip("fn call, >", "1 > 2", "1 > 2")
      roundTrip("fn call, >=", "1 >= 2", "1 >= 2")
      roundTrip("fn call, <", "1 < 2", "1 < 2")
      roundTrip("fn call, <=", "1 <= 2", "1 <= 2")
      roundTrip("fn call, ==", "1 == 2", "1 == 2")
      roundTrip("fn call, !=", "1 != 2", "1 != 2")
      roundTrip("fn call, ^", "1 ^ 2", "1 ^ 2")
      roundTrip("fn call, +", "strVar + \"str\"", "strVar + \"str\"")
      roundTrip("fn call, &&", "true && false", "true && false")
      roundTrip("fn call, ||", "true || false", "true || false")
      roundTrip("fn call, and short", "and(true, false)", "and(true, false)")
      roundTrip(
        "fn call, and longer",
        "Stdlib.Bool.and(true, false)",
        "Stdlib.Bool.and(true, false)")
      roundTrip(
        "fn call, and longest",
        "Darklang.Stdlib.Bool.and(true, false)",
        "Stdlib.Bool.and(true, false)")
      roundTrip(
        "fn call, and stdlib shortcut",
        "Stdlib.Bool.and(true, false)",
        "Stdlib.Bool.and(true, false)")
      roundTrip("fn call, builtin simple", "Builtin.int64Add(1, 2)", "Builtin.int64Add(1, 2)")
      roundTrip(
        "fn call, builtin with type arg",
        "Builtin.jsonParse<Bool>(\"true\")",
        "Builtin.jsonParse<Bool>(\"true\")")
      roundTrip(
        "fn call with indentation",
        "Stdlib.Tuple3.mapAllThree(\n  (\"one\", 2, \"pi\"),\n  (fun x -> Stdlib.String.toUppercase(x)),\n  (fun x -> x - 2),\n  fun x -> Stdlib.String.toUppercase(x))\n",
        "Stdlib.Tuple3.mapAllThree(\n  (\"one\", 2, \"pi\"),\n  (fun x -> Stdlib.String.toUppercase(x)),\n  (fun x -> x - 2),\n  fun x -> Stdlib.String.toUppercase(x)\n)") ])

test exprsKeywordNames =
  Stdlib.Test.all(
    [ roundTrip(
        "keyword-named let binding",
        "let ``match`` = \"x\"\n``match``",
        "let ``match`` = \"x\"\n``match``")
      roundTrip("keyword-named lambda parameter", "fun ``type`` -> ``type``", "(fun ``type`` -> ``type``)")
      roundTrip(
        "keyword-named match binder",
        "match \"x\" with\n| ``then`` -> ``then``",
        "match \"x\" with\n| ``then`` -> ``then``")
      roundTrip(
        "keyword-named as binder",
        "match \"x\" with\n| y as ``with`` -> ``with``",
        "match \"x\" with\n| y as ``with`` -> ``with``")
      roundTrip("non-ASCII letters stay bare", "let zażółć = \"x\"\nzażółć", "let zażółć = \"x\"\nzażółć")
      roundTrip("the blank name prints as ___", "let ___ = \"x\"\n___", "let ___ = \"x\"\n___") ])

// Every word the lexer reserves prints back escaped. `_` is left out: it is the
// wildcard, printed bare on purpose.
test exprsEveryKeywordAsName =
  LanguageTools.Parser.keywords
  |> Stdlib.List.filter(fun word -> word != "_")
  |> Stdlib.List.map(fun word ->
    let source = $"let ``{word}`` = \"x\"\n``{word}``"
    roundTrip($"keyword {word} as a name", source, source))
  |> Stdlib.Test.all
