module Darklang.LanguageTools.Parser.RoundTrip.Tests

// Parse-then-print round trips: testDeclarations. Moved from
// backend/tests/Tests/LibParser.RoundTrip.Tests.fs; helpers are in roundTrip.dark.

test testDeclarations =
  Stdlib.Test.all(
    [ roundTripPackage("keyword-named test", "test `type` = true", "test `type` = true")
      roundTripPackage(
        "named package test",
        "/// Checks the simplest assertion\ntest passes = true",
        "/// Checks the simplest assertion\ntest passes = true")
      roundTripPackage(
        "named package test expecting a runtime error",
        "test divisionByZero =\n  1 / 0\n  => raises \"Cannot divide by 0\"",
        "test divisionByZero =\n  1 / 0\n  => raises \"Cannot divide by 0\"") ])
