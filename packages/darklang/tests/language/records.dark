module Darklang.Language.Tests.Records

type Cols1 = { col1: Int64 }
type Cols2 = { col1: Int64, col2: Int64 }

// Distinct case names keep this type separate from other enums with the same shape,
// so the runtime error has a stable type name.
type AnEnum = | RecordTestA | RecordTestB | RecordTestC

test construction =
  Cols2 { col1 = 1, col2 = 3 }
  |> Stdlib.Test.equal(Cols2 { col1 = 1, col2 = 3 })

test fieldErrorRaises =
  Cols2 { col1 = 2, col2 = Stdlib.Test.raiseRuntimeError("test") }
  => raises "Uncaught exception: test"

module WithTypeArgs =
  type Owner<'a> = { item: 'a }
  type CoOwner<'a> = Owner<'a>

  test aliasWithTypeArg =
    Owner { item = 5 } |> Stdlib.Test.equal(CoOwner { item = 5 })

  type C<'c> = { v: 'c }
  type B<'b> = { c: C<'b> }
  type A<'a> = { b: B<'a> }

  let getC(a: A<Int64>): Int64 = a.b.c.v

  test nestedTypeArgs =
    getC(A { b = B { c = C { v = 5 } } }) |> Stdlib.Test.equal(5)

module InvalidCols =
  test duplicateFieldRaises =
    Cols1 { col1 = 1, col1 = 2 } => raises "Duplicate field `col1`"

  // Fields are checked as written, so the first bad one in the source is the one named, whatever
  // order the record keeps them in.
  test duplicateOfALaterNameRaises =
    Cols2 { col2 = 1, col1 = 2, col2 = 3 } => raises "Duplicate field `col2`"

  test unknownBeforeADuplicateRaises =
    Cols2 { zzz = 1, col1 = 2, col1 = 3 } => raises "No field named `zzz`"

  test firstWrongTypeAsWrittenRaises =
    Cols2 { col2 = "", col1 = "" }
    => raises
      "Failed to create record. Expected Int64 for field `col2`, but got \"\" (a String)"

  test emptyKeyRaises =
    Cols2 { col1 = 2, ___ = 3 } => raises "Empty key in record creation"

  test missingFieldRaises =
    Cols2 { col1 = 2 } => raises "Missing field `col2`"

  test unknownFieldRaises =
    Cols2 { col1 = 2, other = 3 } => raises "No field named `other`"

  test extraFieldRaises =
    Cols2 { col1 = 2, col2 = 3, col3 = 4 } => raises "No field named `col3`"

  test wrongFieldTypeRaises =
    Cols1 { col1 = "" }
    => raises
      "Failed to create record. Expected Int64 for field `col1`, but got \"\" (a String)"

  test wrongFieldTypeLongStringRaises =
    Cols1 { col1 = "abcdefghijklmnopqrstuvwxyz" }
    => raises
      "Failed to create record. Expected Int64 for field `col1`, but got \"abcdefgh...\" (a String)"

  test wrongFieldTypeEscapeAtCutRaises =
    Cols1 { col1 = "abcdefg\"hij\nklmnop" }
    => raises
      "Failed to create record. Expected Int64 for field `col1`, but got \"abcdefg...\" (a String)"

  test wrongFieldTypeEscapeBeforeCutRaises =
    Cols1 { col1 = "abc\ndefghijklmnop" }
    => raises
      "Failed to create record. Expected Int64 for field `col1`, but got \"abc\\ndef...\" (a String)"

module InvalidType =
  // Evaluate the unresolved name from source at run time so it does not prevent
  // the package from loading. Check both the error branch and its message.
  test unknownTypeRaises =
    let branch = Darklang.SCM.PackageOps.currentBranch()
    let source = "MyNonExistantType { col1 = 2 }"
    match Darklang.Cli.Eval.evaluateRaw(None, branch, source, [], false) with
    | Error(Runtime(error, _)) ->
      Darklang.PrettyPrinter.RuntimeTypes.RuntimeError.toString(branch, error)
      |> Stdlib.Test.equal("MyNonExistantType not found")
    | _ -> Stdlib.Test.fail("expected a runtime error for an unknown record type")

  // `Int` is not a type; the error names the two it could mean.
  test intIsNotAType =
    let branch = Darklang.SCM.PackageOps.currentBranch()
    let source = "let f(x: Int): Int64 = 1\nf(1)"
    match Darklang.Cli.Eval.evaluateRaw(None, branch, source, [], false) with
    | Error(Runtime(error, _)) ->
      Darklang.PrettyPrinter.RuntimeTypes.RuntimeError.toString(branch, error)
      |> Stdlib.Test.equal("Int not found (an integer is an Int64, like `1`, or a BigInt, like `1z`)")
    | _ -> Stdlib.Test.fail("expected a runtime error for the type `Int`")

  test enumIsNotRecordRaises =
    AnEnum { col1 = 2 }
    => raises
      "Expected a record, but Darklang.Language.Tests.Records.AnEnum is not one"

module Polymorphism =
  type MyRecord<'a> = { col1: 'a, col2: Int64 }

  test typeArgFields =
    Stdlib.Test.all(
      [ (MyRecord { col1 = (), col2 = 1 }).col2 |> Stdlib.Test.equal(1)
        (MyRecord
          { col1 = Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok(1))
            col2 = 1 })
          .col1
        |> Stdlib.Test.equal(
          Stdlib.Option.Option.Some(Stdlib.Result.Result.Ok(1))) ])

module Nested =
  type NestedRecordA = { col1: Int64 }
  type NestedRecordB = { col1: NestedRecordA }

  test nestedFieldAccess =
    (NestedRecordB { col1 = NestedRecordA { col1 = 1 } }).col1.col1
    |> Stdlib.Test.equal(1)

module Update =
  type RecordForUpdate = { x: Int64, y: Int64 }
  type RecordForUpdateMultiple = { x: Int64, y: Int64, z: Int64 }

  test updates =
    Stdlib.Test.all(
      [ ({ RecordForUpdate { x = 4, y = 1 } with y = 2 })
        |> Stdlib.Test.equal(RecordForUpdate { x = 4, y = 2 })
        (let myRec = RecordForUpdate { x = 4, y = 1 }
         { myRec with y = 2 })
        |> Stdlib.Test.equal(RecordForUpdate { x = 4, y = 2 })
        (let myRec = RecordForUpdateMultiple { x = 4, y = 1, z = 0 }
         { myRec with y = 2, z = 42 })
        |> Stdlib.Test.equal(RecordForUpdateMultiple { x = 4, y = 2, z = 42 })
        (let myRec = RecordForUpdateMultiple { x = 4, y = 1, z = 0 }
         { myRec with z = 3, x = 42 })
        |> Stdlib.Test.equal(RecordForUpdateMultiple { x = 42, y = 1, z = 3 })
        (let myRec = RecordForUpdateMultiple { x = 4, y = 1, z = 0 }
         { myRec with z = 3, x = 42, y = 11 })
        |> Stdlib.Test.equal(RecordForUpdateMultiple { x = 42, y = 11, z = 3 }) ])

  // An update of a record whose type argument is still unknown, inside a fn with
  // no type parameters, called from a fn whose type parameter has the record's
  // parameter's name. The caller's `'a` must not fill the record's.
  module UnderAGenericCaller =
    type UpdBox<'a> = { updItems: List<'a> }

    let emptyUpdBox(): UpdBox<String> =
      let b = UpdBox { updItems = [] }
      { b with updItems = [] }

    let viaGeneric<'a>(xs: List<'a>): UpdBox<String> = emptyUpdBox()

    test genericCallerKeepsOwnTypeArg =
      Stdlib.List.length((viaGeneric([ 1 ])).updItems) |> Stdlib.Test.equal(0)

  module Invalid =
    test updateOfNonRecordRaises =
      (let r = 1
       { r with key = false })
      => raises "Cannot apply a record-update to a Int64"

    test unknownFieldRaises =
      (let myRec = RecordForUpdateMultiple { x = 4, y = 1, z = 0 }
       { myRec with z = 3, x = 42, y = 11, p = 10 })
      => raises "No field named `p`"

    test otherFieldRaises =
      (let myRec = RecordForUpdate { x = 4, y = 1 }
       { myRec with other = 2 })
      => raises "No field named `other`"

    test duplicateFieldRaises =
      (let myRec = RecordForUpdate { x = 4, y = 1 }
       { myRec with x = 2, x = 3 })
      => raises "Duplicate field `x`"

    // As in construction, the first bad field as written is the one named.
    test unknownBeforeADuplicateRaises =
      (let myRec = RecordForUpdate { x = 4, y = 1 }
       { myRec with x = 2, zzz = 1, x = 3 })
      => raises "No field named `zzz`"

    test wrongFieldTypeRaises =
      (let myRec = RecordForUpdate { x = 4, y = 1 }
       { myRec with y = "2" })
      => raises
        "Failed to create updated record. Expected Int64 for field `y`, but got \"2\" (a String)"

module FieldAccess =
  type MyRecord = { col1: Int64 }

  test fieldAccess =
    (let x = MyRecord { col1 = 1 } in x.col1) |> Stdlib.Test.equal(1)

  module Errors =
    test emptyFieldNameRaises =
      (let x = MyRecord { col1 = 1 } in x.___) => raises "Field name is empty"

    test missingFieldRaises =
      (let x = MyRecord { col1 = 1 } in x.fieldName)
      => raises "Tried to access field `fieldName`, but it doesn't exist"

    // `(Stdlib.Test.raiseRuntimeError("error")).fieldName` is in errorPropagation.dark.

    test accessOnInt64Raises =
      (let x = 6 in x.fieldName)
      => raises
        "Attempting to perform field access of an Int64, but this only works with records and tuples"
