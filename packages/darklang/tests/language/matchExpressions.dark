module Darklang.Language.Tests.MatchExpressions

// One module for each type of pattern.
// In each module, there should be at least 2 error tests, one checking the
// incorrect dval for that pattern, and one checking the incorrect pattern for that
// dval. (The error checking in the interpreter tests is at the pattern side, not
// the dval side)

test int64Patterns =
  Stdlib.Test.all(
    [ (match 6 with
       | 5 -> "fail"
       | -6 -> "fail"
       | 6 -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6 with
       | 6 -> "pass"
       | 5 -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6 with
       | var -> "pass"
       | 6 -> "fail"
       | 5 -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 999999999999999 with
       | 0 -> "fail"
       | 999999999999999 -> "pass")
      |> Stdlib.Test.equal("pass") ])

test uint64Patterns =
  Stdlib.Test.all(
    [ (match 6u64 with
       | 5u64 -> "fail"
       | 6u64 -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6u64 with
       | 6u64 -> "pass"
       | 5u64 -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6u64 with
       | var -> "pass"
       | 6u64 -> "fail"
       | 5u64 -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 18446744073709551615u64 with
       | 0u64 -> "fail"
       | 18446744073709551615u64 -> "pass")
      |> Stdlib.Test.equal("pass") ])

