module Darklang.Language.Tests.MatchExpressions

// One module for each type of pattern.
// In each module, there should be at least 2 error tests, one checking the
// incorrect dval for that pattern, and one checking the incorrect pattern for that
// dval. (The error checking in the interpreter tests is at the pattern side, not
// the dval side)

test int64Patterns =
  Stdlib.Test.all
    [ (match 6L with
       | 5L -> "fail"
       | -6L -> "fail"
       | 6L -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 6L with
       | 6L -> "pass"
       | 5L -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 6L with
       | var -> "pass"
       | 6L -> "fail"
       | 5L -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 999999999999999L with
       | 0L -> "fail"
       | 999999999999999L -> "pass")
      |> Stdlib.Test.equal "pass" ]

test uint64Patterns =
  Stdlib.Test.all
    [ (match 6UL with
       | 5UL -> "fail"
       | 6UL -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 6UL with
       | 6UL -> "pass"
       | 5UL -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 6UL with
       | var -> "pass"
       | 6UL -> "fail"
       | 5UL -> "fail")
      |> Stdlib.Test.equal "pass"
      (match 18446744073709551615UL with
       | 0UL -> "fail"
       | 18446744073709551615UL -> "pass")
      |> Stdlib.Test.equal "pass" ]

