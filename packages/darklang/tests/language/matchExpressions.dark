test stringPatterns =
  Stdlib.Test.all(
    [ (match "x" with
       | "y" -> "fail"
       | "" -> "pass"
       | "xx" -> "pass"
       | "x" -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match "x" with
       | "x" -> "pass"
       | "y" -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match "x" with
       | var -> $"pass: {var}"
       | "x" -> "fail"
       | "y" -> "fail")
      |> Stdlib.Test.equal("pass: x") ])

test boolPatterns =
  Stdlib.Test.all(
    [ (match true with
       | false -> "fail"
       | true -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match true with
       | true -> "pass"
       | false -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match true with
       | var -> if var then "pass" else "fail"
       | true -> "fail"
       | false -> "fail")
      |> Stdlib.Test.equal("pass")
      (match false with
       | true -> "fail"
       | false -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match false with
       | var -> if var then "fail" else "pass"
       | false -> "fail"
       | true -> "fail")
      |> Stdlib.Test.equal("pass") ])

test floatPatterns =
  Stdlib.Test.all(
    [ (match 6.5 with
       | 5.5 -> "fail"
       | -6.5 -> "fail"
       | 6.5 -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6.5 with
       | 6.5 -> "pass"
       | 5.5 -> "fail"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match 6.5 with
       | var -> $"pass: {Stdlib.toString(var)}"
       | 6.5 -> "fail"
       | 5.5 -> "fail")
      |> Stdlib.Test.equal("pass: 6.5")
      // CLEANUP negative -0.0 different from 0.0?
      // (match 0.0 with
      //  | -0.0 -> "fail1"
      //  | 0.0 -> "pass"
      //  | var -> "fail2")
      // |> Stdlib.Test.equal "pass"
      (match -4.7 with
       | 4.7 -> "fail"
       | -4.7 -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match -4.7 with
       | var -> $"pass: {Stdlib.toString(var)}"
       | -4.7 -> "fail"
       | 4.7 -> "fail")
      |> Stdlib.Test.equal("pass: -4.7") ])

// Float patterns use numeric equality, so either signed zero matches the first zero pattern.
test signedZeroPatterns =
  Stdlib.Test.all(
    [ (match 0.0 with
       | -0.0 -> "negative pattern first"
       | 0.0 -> "positive pattern second"
       | _ -> "neither")
      |> Stdlib.Test.equal("negative pattern first")
      (match -0.0 with
       | 0.0 -> "positive pattern first"
       | -0.0 -> "negative pattern second"
       | _ -> "neither")
      |> Stdlib.Test.equal("positive pattern first") ])

test unitPatterns =
  Stdlib.Test.all(
    [ (match () with
       | () -> "pass"
       | var -> "fail")
      |> Stdlib.Test.equal("pass")
      (match () with
       | var -> "pass"
       | () -> "fail")
      |> Stdlib.Test.equal("pass") ])

