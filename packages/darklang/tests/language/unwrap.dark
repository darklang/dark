module Darklang.Language.Tests.Unwrap

// `?` extracts Ok or returns Error from the current function.
let next(
  value: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<Int64, String> =
  let number = value?
  Stdlib.Result.Result.Ok(number + 1)


test resultUnwrap =
  Stdlib.Test.all(
    [ next(Stdlib.Result.Result.Ok(4))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(5))

      next(Stdlib.Result.Result.Error("missing"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("missing")) ])


// Returning Error or None must allow the function to use a different success
// type.
let stringify(
  value: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<String, String> =
  let number = value?
  Stdlib.Result.Result.Ok(Stdlib.display(number))


let optionString(
  value: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<String> =
  let number = value?
  Stdlib.Option.Option.Some(Stdlib.display(number))


let fromCall(
  input: String)
  : Stdlib.Result.Result<Int64, Stdlib.Int64.ParseError> =
  let number = (Stdlib.Int64.parse(input))?
  Stdlib.Result.Result.Ok(number + 1)


let bomb(): Int64 =
  Builtin.unwrap(Stdlib.Result.Result.Error("should not execute"))


let argumentOrder(
  first: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<Int64, String> =
  Stdlib.Result.Result.Ok((fun(a, b) -> a + b)(first?, bomb()))


let listOrder(
  first: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<List<Int64>> =
  Stdlib.Option.Option.Some([ first?, bomb() ])


let inBranch(
  choose: Bool,
  value: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<Int64> =
  let number = if choose then value? else 12
  Stdlib.Option.Option.Some(number)


let inGuard(value: Stdlib.Option.Option<Bool>): Stdlib.Option.Option<Int64> =
  match 1 with
  | 1 when value? -> Stdlib.Option.Option.Some(1)
  | _ -> Stdlib.Option.Option.Some(2)


test differentSuccessType =
  Stdlib.Test.all(
    [ stringify(Stdlib.Result.Result.Ok(4))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("4"))

      stringify(Stdlib.Result.Result.Error("missing"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("missing"))

      optionString(Stdlib.Option.Option.Some(4))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some("4"))

      optionString(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      fromCall("4") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(5))

      fromCall("invalid")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int64.ParseError.BadFormat)) ])


test skipsLaterArguments =
  Stdlib.Test.all(
    [ argumentOrder(Stdlib.Result.Result.Error("first"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("first"))

      listOrder(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test branchesAndGuards =
  Stdlib.Test.all(
    [ inBranch(false, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(12))

      inBranch(true, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      inBranch(true, Stdlib.Option.Option.Some(3))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(3))

      inGuard(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      inGuard(Stdlib.Option.Option.Some(false))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(2))

      inGuard(Stdlib.Option.Option.Some(true))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1)) ])


// `?` returns None from the lambda; its caller can handle None and continue.
let lambdaBoundary(value: Stdlib.Option.Option<Int64>): Int64 =
  let inner = fun () -> Stdlib.Option.Option.Some(value? + 1)
  match inner() with
  | None -> 99
  | Some(number) -> number


let nestedBoundary(value: Stdlib.Result.Result<Int64, String>): Int64 =
  let inner(): Stdlib.Result.Result<Int64, String> =
    Stdlib.Result.Result.Ok(value? + 1)

  match inner() with
  | Error(_) -> 99
  | Ok(number) -> number


let pipelineBoundary(value: Stdlib.Option.Option<Int64>): Int64 =
  let outcome = value |> (fun x -> Stdlib.Option.Option.Some(x? + 1))
  match outcome with
  | None -> 99
  | Some(number) -> number


let nested(
  value: Stdlib.Result.Result<Stdlib.Result.Result<Int64, String>, String>)
  : Stdlib.Result.Result<Int64, String> =
  Stdlib.Result.Result.Ok(value?? + 1)


type Container =
  { item: Stdlib.Option.Option<Int64> }


let fields(
  value: Stdlib.Option.Option<Container>)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(value?.item?)


test lambdaBoundaries =
  Stdlib.Test.all(
    [ lambdaBoundary(Stdlib.Option.Option.None) |> Stdlib.Test.equal(99)

      lambdaBoundary(Stdlib.Option.Option.Some(3)) |> Stdlib.Test.equal(4)

      nestedBoundary(Stdlib.Result.Result.Error("inner"))
      |> Stdlib.Test.equal(99)

      nestedBoundary(Stdlib.Result.Result.Ok(3)) |> Stdlib.Test.equal(4)

      pipelineBoundary(Stdlib.Option.Option.None) |> Stdlib.Test.equal(99)

      pipelineBoundary(Stdlib.Option.Option.Some(3)) |> Stdlib.Test.equal(4) ])


test nestedAndFields =
  Stdlib.Test.all(
    [ nested(Stdlib.Result.Result.Ok(Stdlib.Result.Result.Ok(4)))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(5))

      nested(Stdlib.Result.Result.Ok(Stdlib.Result.Result.Error("inside")))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("inside"))

      nested(Stdlib.Result.Result.Error("outside"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("outside"))

      fields(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      fields(
        Stdlib.Option.Option.Some(
          Container { item = Stdlib.Option.Option.None }))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      fields(
        Stdlib.Option.Option.Some(
          Container { item = Stdlib.Option.Option.Some(4) }))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4)) ])


// The caller uses its own `?` to return an Error received from next.
let chain(
  value: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<Int64, String> =
  Stdlib.Result.Result.Ok((next(value))? + 1)


test chained =
  Stdlib.Test.all(
    [ chain(Stdlib.Result.Result.Ok(4))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(6))

      chain(Stdlib.Result.Result.Error("missing"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("missing")) ])


// Evaluate the operand once. An error skips later effects without undoing earlier ones.
module EvaluationCounts =
  let counted(
    value: Stdlib.Result.Result<Int64, String>)
    : Stdlib.Result.Result<Int64, String> =
    let number = (Stdlib.Test.incrementCounter(value))?
    let _ = Stdlib.Test.incrementCounter()
    Stdlib.Result.Result.Ok(number)


  test okRunsBothEffects =
    (let outcome = counted(Stdlib.Result.Result.Ok(7))
     (outcome, Stdlib.Test.counterValue()))
    |> Stdlib.Test.equal((Stdlib.Result.Result.Ok(7), 2))


  test errorSkipsLaterEffect =
    (let outcome = counted(Stdlib.Result.Result.Error("stop"))
     (outcome, Stdlib.Test.counterValue()))
    |> Stdlib.Test.equal((Stdlib.Result.Result.Error("stop"), 1))


// Error skips the rest of the body, so bomb () never runs.
let skipContinuation(
  value: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<Int64, String> =
  let number = value?
  let _ = bomb()
  Stdlib.Result.Result.Ok(number)


test errorSkipsRestOfBody =
  skipContinuation(Stdlib.Result.Result.Error("stop"))
  |> Stdlib.Test.equal(Stdlib.Result.Result.Error("stop"))


// A function extracted by `?` can be called immediately.
let increment(x: Int64): Int64 =
  x + 1


let callable(
  value: Stdlib.Option.Option<Int64 -> Int64>)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(value?(4))


test extractedFunction =
  Stdlib.Test.all(
    [ callable(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      callable(Stdlib.Option.Option.Some(increment))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(5))

      // The extracted function can also be a lambda.
      callable(Stdlib.Option.Option.Some(fun x -> x + 1))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(5)) ])


// None in the first tuple element skips the second element and returns None.
let tupleOrder(
  value: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<(Int64 * Int64)> =
  Stdlib.Option.Option.Some((value?, bomb()))


let interpolation(
  value: Stdlib.Option.Option<String>)
  : Stdlib.Option.Option<String> =
  Stdlib.Option.Option.Some($"value: {value?}")


test tuplesAndInterpolation =
  Stdlib.Test.all(
    [ tupleOrder(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      interpolation(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      interpolation(Stdlib.Option.Option.Some("hello"))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some("value: hello")) ])


// Recursive calls propagate None and extract Some, including when calls are
// cached.
let recursive(
  count: Int64,
  value: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<Int64> =
  if count == 0 then
    Stdlib.Option.Option.Some(value?)
  else
    Stdlib.Option.Option.Some((recursive(count - 1, value))? + 1)


test recursion =
  Stdlib.Test.all(
    [ recursive(5, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      recursive(5, Stdlib.Option.Option.Some(0))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(5)) ])


// After a successful `?`, a library call and its callback still run normally.
let firstTwo(
  value: Stdlib.Option.Option<List<Int64>>)
  : Stdlib.Option.Option<Int64> =
  let items = value?
  Stdlib.List.findFirstIndex(items, fun x -> x == 2)


test libraryCallAfterUnwrap =
  Stdlib.Test.all(
    [ firstTwo(Stdlib.Option.Option.Some([ 1, 2, 3 ]))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      firstTwo(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


// This function declares an Option return but unwraps a Result.
// If run without static checking, `?` rejects both Ok and Error at runtime.
let wrongKind(
  value: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(value?)


test wrongKindOkRaises =
  wrongKind(Stdlib.Result.Result.Ok(1))
  => raises "`?` got a Result (Ok(1)), but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption"


test wrongKindErrorRaises =
  wrongKind(Stdlib.Result.Result.Error("x"))
  => raises "`?` got a Result (Error(\"x\")), but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption"


// `?` returns from each callback invocation, allowing the list operation to
// continue.
test listCallbacks =
  Stdlib.Test.all(
    [ Stdlib.List.map(
        [ Stdlib.Option.Option.Some(1)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(3) ],
        fun x -> Stdlib.Option.Option.Some(x? + 1))
      |> Stdlib.Test.equal(
        [ Stdlib.Option.Option.Some(2)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(4) ])

      Stdlib.List.filterMap(
        [ Stdlib.Option.Option.Some(1)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(3) ],
        fun x -> Stdlib.Option.Option.Some(x? * 10))
      |> Stdlib.Test.equal([ 10, 30 ])

      Stdlib.List.fold(
        [ Stdlib.Option.Option.Some(1), Stdlib.Option.Option.Some(2) ],
        Stdlib.Option.Option.Some(0),
        fun(acc, x) -> Stdlib.Option.Option.Some(acc? + x?))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(3))

      Stdlib.List.fold(
        [ Stdlib.Option.Option.Some(1)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(2) ],
        Stdlib.Option.Option.Some(0),
        fun(acc, x) -> Stdlib.Option.Option.Some(acc? + x?))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      // Error in a match arm returns from the callback.
      Stdlib.List.map(
        [ Stdlib.Result.Result.Ok(1), Stdlib.Result.Result.Error("e") ],
        fun r ->
          match 1 with
          | 1 -> Stdlib.Result.Result.Ok(r? + 1)
          | _ -> Stdlib.Result.Result.Ok(0))
      |> Stdlib.Test.equal(
        [ Stdlib.Result.Result.Ok(2), Stdlib.Result.Result.Error("e") ]) ])


let inRecord(
  v: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<Dict<String, Int64>> =
  Stdlib.Option.Option.Some(Dict { "a": v? })


type R =
  { a: Int64
    b: Int64 }


let inUpdate(r: R, v: Stdlib.Option.Option<Int64>): Stdlib.Option.Option<R> =
  Stdlib.Option.Option.Some({ r with b = v? })


let neg(v: Stdlib.Option.Option<Int64>): Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(-v?)


let notted(v: Stdlib.Option.Option<Bool>): Stdlib.Option.Option<Bool> =
  Stdlib.Option.Option.Some(!v?)


let literals(v: Stdlib.Option.Option<String>): Stdlib.Option.Option<String> =
  Stdlib.Option.Option.Some(v? + "what?" + Stdlib.display('?'))


type AliasR = Stdlib.Result.Result<Int64, String>


let viaAlias(v: AliasR): Stdlib.Result.Result<Int64, String> =
  Stdlib.Result.Result.Ok(v? + 1)


test inExpressions =
  Stdlib.Test.all(
    [ inRecord(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      inRecord(Stdlib.Option.Option.Some(1))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(Dict { "a": 1 }))

      inUpdate(R { a = 1, b = 2 }, Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(R { a = 1, b = 5 }))

      inUpdate(R { a = 1, b = 2 }, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      neg(Stdlib.Option.Option.Some(3))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-3))

      neg(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      notted(Stdlib.Option.Option.Some(true))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(false))

      literals(Stdlib.Option.Option.Some("a"))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some("awhat??"))

      viaAlias(Stdlib.Result.Result.Ok(1))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(2))

      viaAlias(Stdlib.Result.Result.Error("x"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("x")) ])


// A returned Error works alongside other Results with the function's success
// type.
let str(
  v: Stdlib.Result.Result<Int64, String>)
  : Stdlib.Result.Result<String, String> =
  Stdlib.Result.Result.Ok(Stdlib.display(v?))


test returnedErrorWithOtherResults =
  Stdlib.Test.all(
    [ [ str(Stdlib.Result.Result.Error("a")), Stdlib.Result.Result.Ok("b") ]
      |> Stdlib.Test.equal(
        [ Stdlib.Result.Result.Error("a"), Stdlib.Result.Result.Ok("b") ])

      Stdlib.Result.map(str(Stdlib.Result.Result.Error("a")), fun s -> s + "!")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("a"))

      Stdlib.Result.withDefault(str(Stdlib.Result.Result.Error("a")), "d")
      |> Stdlib.Test.equal("d") ])


// `?` still works when a lambda supplies the second argument later.
let two(
  a: Stdlib.Option.Option<Int64>,
  b: Stdlib.Option.Option<Int64>)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(a? + b?)


test laterArgument =
  (let p = fun b -> two(Stdlib.Option.Option.Some(1), b)
   (p(Stdlib.Option.Option.Some(2)), p(Stdlib.Option.Option.None)))
  |> Stdlib.Test.equal(
    (Stdlib.Option.Option.Some(3), Stdlib.Option.Option.None))


// Parentheses around `v?` also allow the extracted function to be called.
let getFn(
  v: Stdlib.Option.Option<Int64 -> Int64>)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(v?(4))


test parenthesizedCall =
  getFn(Stdlib.Option.Option.Some(fun x -> x * 2))
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some(8))


// None returns before the match or if can choose a branch.
let scrut(v: Stdlib.Option.Option<Int64>): Stdlib.Option.Option<String> =
  match v? with
  | 1 -> Stdlib.Option.Option.Some("one")
  | _ -> Stdlib.Option.Option.Some("other")


let cond(v: Stdlib.Option.Option<Bool>): Stdlib.Option.Option<Int64> =
  if v? then Stdlib.Option.Option.Some(1) else Stdlib.Option.Option.Some(0)


test beforeBranch =
  Stdlib.Test.all(
    [ scrut(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      scrut(Stdlib.Option.Option.Some(1))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some("one"))

      cond(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


// Some () allows the next statement to run; None returns immediately.
let stmt(v: Stdlib.Option.Option<Unit>): Stdlib.Option.Option<Int64> =
  v?
  Stdlib.Option.Option.Some(1)


let pipeParen(s: String): Stdlib.Result.Result<Int64, Stdlib.Int64.ParseError> =
  Stdlib.Result.Result.Ok((s |> Stdlib.Int64.parse)? * 2)


test statements =
  Stdlib.Test.all(
    [ stmt(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      stmt(Stdlib.Option.Option.Some())
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      pipeParen("4") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(8)) ])


// The outer function can discard the lambda's None result and return Some 7.
let innerOnly(v: Stdlib.Option.Option<Int64>): Stdlib.Option.Option<Int64> =
  let f = fun () -> Stdlib.Option.Option.Some(v? + 1)
  let _ = f()
  Stdlib.Option.Option.Some(7)


test discardedLambdaResult =
  innerOnly(Stdlib.Option.Option.None)
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some(7))


// None from the base case propagates through every recursive call.
let countdown(n: Int64): Stdlib.Option.Option<Int64> =
  if n == 0 then
    Stdlib.Option.Option.None
  else
    Stdlib.Option.Option.Some((countdown(n - 1))? + 1)


test recursiveNone =
  countdown(3) |> Stdlib.Test.equal(Stdlib.Option.Option.None)


// `?` rejects an Int64 operand at runtime.
test intOperandRaises =
  (fun v -> Stdlib.Option.Option.Some(v? + 1))(4)
  => raises "`?` needs an Option or Result, but got 4 (an Int64)"


// Final Some/None or Ok/Error expressions identify the lambda's return type.
// `?` then rejects Result operands for Option returns, and vice versa.
test resultInOptionLambdaRaises =
  (fun v -> Stdlib.Option.Option.Some(v? + 1))(Stdlib.Result.Result.Error("x"))
  => raises "`?` got a Result (Error(\"x\")), but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption"


test okInOptionLambdaRaises =
  (fun v -> Stdlib.Option.Option.Some(v? + 1))(Stdlib.Result.Result.Ok(1))
  => raises "`?` got a Result (Ok(1)), but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption"


test optionInResultLambdaRaises =
  (fun v -> Stdlib.Result.Result.Ok(v? + 1))(Stdlib.Option.Option.None)
  => raises "`?` got an Option (None), but the enclosing function or lambda returns a Result; convert it first with Stdlib.Option.toResult"


test resultInIfOptionLambdaRaises =
  (fun v ->
     if true then Stdlib.Option.Option.Some(v?) else Stdlib.Option.Option.None)(
    Stdlib.Result.Result.Ok(1))
  => raises "`?` got a Result (Ok(1)), but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption"


test optionInMatchResultLambdaRaises =
  (fun v ->
     match v with
     | _ -> Stdlib.Result.Result.Ok(v?))(Stdlib.Option.Option.Some(1))
  => raises "`?` got an Option (Some(1)), but the enclosing function or lambda returns a Result; convert it first with Stdlib.Option.toResult"


// The inner lambda returns Result, even though the outer lambda returns Option.
test innerLambdaResult =
  (fun r ->
     let f = fun w -> Stdlib.Result.Result.Ok(w? + 1)
     Stdlib.Option.Option.Some(f(r)))(Stdlib.Result.Result.Error("e"))
  |> Stdlib.Test.equal(
    Stdlib.Option.Option.Some(Stdlib.Result.Result.Error("e")))


// The compiler does not follow wrap to discover its Option return type.
// Without static checking, the lambda can therefore return Error from `?`.
let wrap(x: Int64): Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(x)


test errorThroughUnknownReturn =
  (fun v -> wrap(v?))(Stdlib.Result.Result.Error("x"))
  |> Stdlib.Test.equal(Stdlib.Result.Result.Error("x"))
