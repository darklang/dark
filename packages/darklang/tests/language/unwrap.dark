module Darklang.Language.Tests.Unwrap

// `?` extracts Ok or returns Error from the current function.
let next
  (value: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<Int, String> =
  let number = value?
  Ok (number + 1)

test resultUnwrap =
  Stdlib.Test.all
    [ next (Ok 4) |> Stdlib.Test.equal (Ok 5)
      next (Error "missing") |> Stdlib.Test.equal (Error "missing") ]

// Returning Error or None must allow the function to use a different success
// type.
let stringify
  (value: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<String, String> =
  let number = value?
  Ok (Stdlib.toString number)

let optionString (value: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<String> =
  let number = value?
  Some (Stdlib.toString number)

let fromCall (input: String) : Stdlib.Result.Result<Int, Stdlib.Int.ParseError> =
  let number = (Stdlib.Int.parse input)?
  Ok (number + 1)

let bomb () : Int = Builtin.unwrap (Error "should not execute")

let argumentOrder
  (first: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<Int, String> =
  Ok ((+) first? (bomb ()))

let listOrder (first: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<List<Int>> =
  Some [ first?, bomb () ]

let inBranch
  (choose: Bool)
  (value: Stdlib.Option.Option<Int>)
  : Stdlib.Option.Option<Int> =
  let number = if choose then value? else 12
  Some number

let inGuard (value: Stdlib.Option.Option<Bool>) : Stdlib.Option.Option<Int> =
  match 1 with
  | 1 when value? -> Some 1
  | _ -> Some 2

test differentSuccessType =
  Stdlib.Test.all
    [ stringify (Ok 4) |> Stdlib.Test.equal (Ok "4")
      stringify (Error "missing") |> Stdlib.Test.equal (Error "missing")
      optionString (Some 4) |> Stdlib.Test.equal (Some "4")
      optionString None |> Stdlib.Test.equal None
      fromCall "4" |> Stdlib.Test.equal (Ok 5)
      fromCall "invalid"
      |> Stdlib.Test.equal (Error Stdlib.Int.ParseError.BadFormat) ]

test skipsLaterArguments =
  Stdlib.Test.all
    [ argumentOrder (Error "first") |> Stdlib.Test.equal (Error "first")
      listOrder None |> Stdlib.Test.equal None ]

test branchesAndGuards =
  Stdlib.Test.all
    [ inBranch false None |> Stdlib.Test.equal (Some 12)
      inBranch true None |> Stdlib.Test.equal None
      inBranch true (Some 3) |> Stdlib.Test.equal (Some 3)
      inGuard None |> Stdlib.Test.equal None
      inGuard (Some false) |> Stdlib.Test.equal (Some 2)
      inGuard (Some true) |> Stdlib.Test.equal (Some 1) ]

// `?` returns None from the lambda; its caller can handle None and continue.
let lambdaBoundary (value: Stdlib.Option.Option<Int>) : Int =
  let inner = fun () -> Some (value? + 1)
  match inner () with
  | None -> 99
  | Some number -> number

let nestedBoundary (value: Stdlib.Result.Result<Int, String>) : Int =
  let inner () : Stdlib.Result.Result<Int, String> =
    Ok (value? + 1)
  match inner () with
  | Error _ -> 99
  | Ok number -> number

let pipelineBoundary (value: Stdlib.Option.Option<Int>) : Int =
  let outcome = value |> fun x -> Some (x? + 1)
  match outcome with
  | None -> 99
  | Some number -> number

let nested
  (value: Stdlib.Result.Result<Stdlib.Result.Result<Int, String>, String>)
  : Stdlib.Result.Result<Int, String> =
  Ok (value?? + 1)

type Container = { item: Stdlib.Option.Option<Int> }
let fields (value: Stdlib.Option.Option<Container>) : Stdlib.Option.Option<Int> =
  Some value?.item?

test lambdaBoundaries =
  Stdlib.Test.all
    [ lambdaBoundary None |> Stdlib.Test.equal 99
      lambdaBoundary (Some 3) |> Stdlib.Test.equal 4
      nestedBoundary (Error "inner") |> Stdlib.Test.equal 99
      nestedBoundary (Ok 3) |> Stdlib.Test.equal 4
      pipelineBoundary None |> Stdlib.Test.equal 99
      pipelineBoundary (Some 3) |> Stdlib.Test.equal 4 ]

test nestedAndFields =
  Stdlib.Test.all
    [ nested (Ok (Ok 4)) |> Stdlib.Test.equal (Ok 5)
      nested (Ok (Error "inside")) |> Stdlib.Test.equal (Error "inside")
      nested (Error "outside") |> Stdlib.Test.equal (Error "outside")
      fields None |> Stdlib.Test.equal None
      fields (Some (Container { item = None })) |> Stdlib.Test.equal None
      fields (Some (Container { item = Some 4 })) |> Stdlib.Test.equal (Some 4) ]

// The caller uses its own `?` to return an Error received from next.
let chain
  (value: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<Int, String> =
  Ok ((next value)? + 1)

test chained =
  Stdlib.Test.all
    [ chain (Ok 4) |> Stdlib.Test.equal (Ok 6)
      chain (Error "missing") |> Stdlib.Test.equal (Error "missing") ]

// Evaluate the operand once. An error skips later effects without undoing earlier ones.
module EvaluationCounts =
  let counted
    (value: Stdlib.Result.Result<Int, String>)
    : Stdlib.Result.Result<Int, String> =
    let number = (Stdlib.Test.incrementCounter value)?
    let _ = Stdlib.Test.incrementCounter ()
    Ok number

  test okRunsBothEffects =
    (let outcome = counted (Ok 7)
     (outcome, Stdlib.Test.counterValue ()))
    |> Stdlib.Test.equal (Ok 7, 2L)

  test errorSkipsLaterEffect =
    (let outcome = counted (Error "stop")
     (outcome, Stdlib.Test.counterValue ()))
    |> Stdlib.Test.equal (Error "stop", 1L)

// Error skips the rest of the body, so bomb () never runs.
let skipContinuation
  (value: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<Int, String> =
  let number = value?
  let _ = bomb ()
  Ok number

test errorSkipsRestOfBody =
  skipContinuation (Error "stop") |> Stdlib.Test.equal (Error "stop")

// A function extracted by `?` can be called immediately.
let increment (x: Int) : Int = x + 1

let callable (value: Stdlib.Option.Option<Int -> Int>) : Stdlib.Option.Option<Int> =
  Some (value? 4)

test extractedFunction =
  Stdlib.Test.all
    [ callable None |> Stdlib.Test.equal None
      callable (Some increment) |> Stdlib.Test.equal (Some 5)
      // The extracted function can also be a lambda.
      callable (Some (fun x -> x + 1)) |> Stdlib.Test.equal (Some 5) ]

// None in the first tuple element skips the second element and returns None.
let tupleOrder
  (value: Stdlib.Option.Option<Int>)
  : Stdlib.Option.Option<(Int * Int)> =
  Some ((value?, bomb ()))

let interpolation
  (value: Stdlib.Option.Option<String>)
  : Stdlib.Option.Option<String> =
  Some $"value: {value?}"

test tuplesAndInterpolation =
  Stdlib.Test.all
    [ tupleOrder None |> Stdlib.Test.equal None
      interpolation None |> Stdlib.Test.equal None
      interpolation (Some "hello") |> Stdlib.Test.equal (Some "value: hello") ]

// Recursive calls propagate None and extract Some, including when calls are
// cached.
let recursive
  (count: Int)
  (value: Stdlib.Option.Option<Int>)
  : Stdlib.Option.Option<Int> =
  if count == 0 then
    Some value?
  else
    Some ((recursive (count - 1) value)? + 1)

test recursion =
  Stdlib.Test.all
    [ recursive 5 None |> Stdlib.Test.equal None
      recursive 5 (Some 0) |> Stdlib.Test.equal (Some 5) ]

// After a successful `?`, a library call and its callback still run normally.
let firstTwo (value: Stdlib.Option.Option<List<Int>>) : Stdlib.Option.Option<Int> =
  let items = value?
  Stdlib.List.findFirstIndex items (fun x -> x == 2)

test libraryCallAfterUnwrap =
  Stdlib.Test.all
    [ firstTwo (Some [ 1, 2, 3 ]) |> Stdlib.Test.equal (Some 1)
      firstTwo None |> Stdlib.Test.equal None ]

// This function declares an Option return but unwraps a Result.
// If run without static checking, `?` rejects both Ok and Error at runtime.
let wrongKind
  (value: Stdlib.Result.Result<Int, String>)
  : Stdlib.Option.Option<Int> =
  Some value?

test wrongKindOkRaises =
  wrongKind (Ok 1)
  => raises
    "`?` got a Result, but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption: Ok(1)"

test wrongKindErrorRaises =
  wrongKind (Error "x")
  => raises
    "`?` got a Result, but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption: Error(\"x\")"

// `?` returns from each callback invocation, allowing the list operation to
// continue.
test listCallbacks =
  Stdlib.Test.all
    [ (Stdlib.List.map [ Some 1, None, Some 3 ] (fun x -> Some (x? + 1)))
      |> Stdlib.Test.equal [ Some 2, None, Some 4 ]
      Stdlib.List.filterMap [ Some 1, None, Some 3 ] (fun x -> Some (x? * 10))
      |> Stdlib.Test.equal [ 10, 30 ]
      Stdlib.List.fold [ Some 1, Some 2 ] (Some 0) (fun acc x -> Some (acc? + x?))
      |> Stdlib.Test.equal (Some 3)
      (Stdlib.List.fold [ Some 1, None, Some 2 ] (Some 0) (fun acc x ->
        Some (acc? + x?)))
      |> Stdlib.Test.equal None
      // Error in a match arm returns from the callback.
      Stdlib.List.map [ Ok 1, Error "e" ] (fun r ->
        match 1 with
        | 1 -> Ok (r? + 1)
        | _ -> Ok 0)
      |> Stdlib.Test.equal [ Ok 2, Error "e" ] ]

let inRecord
  (v: Stdlib.Option.Option<Int>)
  : Stdlib.Option.Option<Dict<String, Int>> =
  Some (Dict { "a": v? })

type R = { a: Int; b: Int }
let inUpdate (r: R) (v: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<R> =
  Some { r with b = v? }

let neg (v: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<Int> = Some (-v?)

let notted (v: Stdlib.Option.Option<Bool>) : Stdlib.Option.Option<Bool> =
  Some (!v?)

let literals (v: Stdlib.Option.Option<String>) : Stdlib.Option.Option<String> =
  Some (v? + "what?" + (Stdlib.toString '?'))

type AliasR = Stdlib.Result.Result<Int, String>
let viaAlias (v: AliasR) : Stdlib.Result.Result<Int, String> = Ok (v? + 1)

test inExpressions =
  Stdlib.Test.all
    [ inRecord None |> Stdlib.Test.equal None
      inRecord (Some 1) |> Stdlib.Test.equal (Some (Dict { "a": 1 }))
      inUpdate (R { a = 1; b = 2 }) (Some 5)
      |> Stdlib.Test.equal (Some (R { a = 1; b = 5 }))
      inUpdate (R { a = 1; b = 2 }) None |> Stdlib.Test.equal None
      neg (Some 3) |> Stdlib.Test.equal (Some -3)
      neg None |> Stdlib.Test.equal None
      notted (Some true) |> Stdlib.Test.equal (Some false)
      literals (Some "a") |> Stdlib.Test.equal (Some "awhat??")
      viaAlias (Ok 1) |> Stdlib.Test.equal (Ok 2)
      viaAlias (Error "x") |> Stdlib.Test.equal (Error "x") ]

// A returned Error works alongside other Results with the function's success
// type.
let str
  (v: Stdlib.Result.Result<Int, String>)
  : Stdlib.Result.Result<String, String> =
  Ok (Stdlib.toString v?)

test returnedErrorWithOtherResults =
  Stdlib.Test.all
    [ [ str (Error "a"), Ok "b" ] |> Stdlib.Test.equal [ Error "a", Ok "b" ]
      Stdlib.Result.map (str (Error "a")) (fun s -> s + "!")
      |> Stdlib.Test.equal (Error "a")
      Stdlib.Result.withDefault (str (Error "a")) "d" |> Stdlib.Test.equal "d" ]

// `?` still works when the function receives its arguments in separate calls.
let two
  (a: Stdlib.Option.Option<Int>)
  (b: Stdlib.Option.Option<Int>)
  : Stdlib.Option.Option<Int> =
  Some (a? + b?)

test partialApplication =
  (let p = two (Some 1)
   (p (Some 2), p None))
  |> Stdlib.Test.equal (Some 3, None)

// Parentheses around `v?` also allow the extracted function to be called.
let getFn
  (v: Stdlib.Option.Option<Int -> Int>)
  : Stdlib.Option.Option<Int> =
  Some ((v?) 4)

test parenthesizedCall =
  getFn (Some (fun x -> x * 2)) |> Stdlib.Test.equal (Some 8)

// None returns before the match or if can choose a branch.
let scrut (v: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<String> =
  match v? with
  | 1 -> Some "one"
  | _ -> Some "other"

let cond (v: Stdlib.Option.Option<Bool>) : Stdlib.Option.Option<Int> =
  if v? then Some 1 else Some 0

test beforeBranch =
  Stdlib.Test.all
    [ scrut None |> Stdlib.Test.equal None
      scrut (Some 1) |> Stdlib.Test.equal (Some "one")
      cond None |> Stdlib.Test.equal None ]

// Some () allows the next statement to run; None returns immediately.
let stmt (v: Stdlib.Option.Option<Unit>) : Stdlib.Option.Option<Int> =
  v?
  Some 1

let pipeParen (s: String) : Stdlib.Result.Result<Int, Stdlib.Int.ParseError> =
  Ok ((s |> Stdlib.Int.parse)? * 2)

test statements =
  Stdlib.Test.all
    [ stmt None |> Stdlib.Test.equal None
      stmt (Some ()) |> Stdlib.Test.equal (Some 1)
      pipeParen "4" |> Stdlib.Test.equal (Ok 8) ]

// The outer function can discard the lambda's None result and return Some 7.
let innerOnly (v: Stdlib.Option.Option<Int>) : Stdlib.Option.Option<Int> =
  let f = fun () -> Some (v? + 1)
  let _ = f ()
  Some 7

test discardedLambdaResult =
  innerOnly None |> Stdlib.Test.equal (Some 7)

// None from the base case propagates through every recursive call.
let countdown (n: Int) : Stdlib.Option.Option<Int> =
  if n == 0 then None else Some ((countdown (n - 1))? + 1)

test recursiveNone =
  countdown 3 |> Stdlib.Test.equal None

// `?` rejects an Int operand at runtime.
test intOperandRaises =
  (fun v -> Some (v? + 1)) 4
  => raises "`?` needs an Option or Result, but got 4 (an Int)"

// Final Some/None or Ok/Error expressions identify the lambda's return type.
// `?` then rejects Result operands for Option returns, and vice versa.
test resultInOptionLambdaRaises =
  (fun v -> Some (v? + 1)) (Error "x")
  => raises
    "`?` got a Result, but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption: Error(\"x\")"

test okInOptionLambdaRaises =
  (fun v -> Some (v? + 1)) (Ok 1)
  => raises
    "`?` got a Result, but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption: Ok(1)"

test optionInResultLambdaRaises =
  (fun v -> Ok (v? + 1)) None
  => raises
    "`?` got an Option, but the enclosing function or lambda returns a Result; convert it first with Stdlib.Option.toResult: None"

test resultInIfOptionLambdaRaises =
  (fun v -> if true then Some v? else None) (Ok 1)
  => raises
    "`?` got a Result, but the enclosing function or lambda returns an Option; convert it first with Stdlib.Result.toOption: Ok(1)"

test optionInMatchResultLambdaRaises =
  (fun v ->
    match v with
    | _ -> Ok v?) (Some 1)
  => raises
    "`?` got an Option, but the enclosing function or lambda returns a Result; convert it first with Stdlib.Option.toResult: Some(1)"

// The inner lambda returns Result, even though the outer lambda returns Option.
test innerLambdaResult =
  (fun r ->
    let f = fun w -> Ok (w? + 1)
    Some (f r)) (Error "e")
  |> Stdlib.Test.equal (Some (Error "e"))

// The compiler does not follow wrap to discover its Option return type.
// Without static checking, the lambda can therefore return Error from `?`.
let wrap (x: Int) : Stdlib.Option.Option<Int> = Some x

test errorThroughUnknownReturn =
  (fun v -> wrap v?) (Error "x") |> Stdlib.Test.equal (Error "x")
