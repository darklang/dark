module Darklang.Language.Tests.ArchivedSelf

module Test =
  let factorial (n: Int): Int =
    if (n <= 1) then
      1
    else
    (n * (Test.factorial (n - 1)))


  let fibonacci (n: Int): Int =
    if (n <= 1) then
      n
    else
      ((Test.fibonacci (n - 1)) + (Test.fibonacci (n - 2)))


  let sumUpTo (n: Int): Int =
    if (n <= 0) then
      0
    else
      (n + (Test.sumUpTo (n - 1)))


module ShadowingTest =
  let incrementWithShadowing (y: Int) (z: Int): Int =
    if (z <= 0) then
      y
    else
      let result =
        incrementWithShadowing y (z - 1)

      let incrementWithShadowing =
        (fun x -> (x + 2))

      (result + (incrementWithShadowing z))


  let factorialWithShadowing (n: Int): (String * Int) =
    if (n <= 1) then
      ("base_case", 1)
    else
      let factorialWithShadowing = "shadowed"
      let result = (n * ((Darklang.Language.Tests.ArchivedSelf.ShadowingTest.factorialWithShadowing (n - 1)) |> Stdlib.Tuple2.second))
      (factorialWithShadowing , result)


  let matchWithShadowing (x: Int) : Int =
    match x with
    | 0 -> 0
    | 1 -> matchWithShadowing 0
    | 2 ->
      let matchWithShadowing = (fun v -> v * 4)
      matchWithShadowing 2
    | matchWithShadowing -> matchWithShadowing + 1


  let tupleMatchWithShadowing (x: (Int * Int)) : Int =
    match x with
    | (0, _) -> 0
    | (1, n) -> tupleMatchWithShadowing ((0, n))
    | (2, v) ->
        let tupleMatchWithShadowing = (fun x -> x * 10)
        tupleMatchWithShadowing v
    | (a, tupleMatchWithShadowing) -> a + tupleMatchWithShadowing


  let letBindingShadowing (x: Int) : List<Int> =
    let letBindingShadowing = (fun v -> v * 3)
    let letBindingShadowing = [ 10, letBindingShadowing x ]
    let letBindingShadowing = Stdlib.List.reverse letBindingShadowing
    letBindingShadowing


  let conditionalShadowing (x: Int) : Int =
    if x <= 0 then
      0
    else if x < 3 then
      let conditionalShadowing = (fun v w -> v * 5 + w)
      conditionalShadowing x 2
    else if x < 5 then
      let conditionalShadowing = (fun v -> v * 3)
      conditionalShadowing x
    else
      x + (conditionalShadowing (x - 1))


  let pipeWithShadowing (x: Int) : Int =
    match x with
    | 0 -> 0
    | 1 -> 0 |> pipeWithShadowing
    | 2 ->
      let pipeWithShadowing = (fun v -> v * 6)
      x |> pipeWithShadowing
    | pipeWithShadowing -> x |> (+) pipeWithShadowing


  // The value and function need different names because a package location holds one item.
  val valueShadowingBase = 120
  let valueShadowing (x: Int) : Int =
    if x <= 0 then
      10
    else if x == 1 then
      (valueShadowing 0) + 1
    else
      let result = valueShadowingBase + 1
      (valueShadowing (x - 1)) + result

test factorial =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.Test.factorial 0 |> Stdlib.Test.equal 1
      Darklang.Language.Tests.ArchivedSelf.Test.factorial 1 |> Stdlib.Test.equal 1
      Darklang.Language.Tests.ArchivedSelf.Test.factorial 5 |> Stdlib.Test.equal 120
      Darklang.Language.Tests.ArchivedSelf.Test.factorial 10 |> Stdlib.Test.equal 3628800 ]

test fibonacci =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.Test.fibonacci 0 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.Test.fibonacci 1 |> Stdlib.Test.equal 1
      Darklang.Language.Tests.ArchivedSelf.Test.fibonacci 5 |> Stdlib.Test.equal 5
      Darklang.Language.Tests.ArchivedSelf.Test.fibonacci 10 |> Stdlib.Test.equal 55 ]

test sumUpTo =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.Test.sumUpTo 0 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.Test.sumUpTo 1 |> Stdlib.Test.equal 1
      Darklang.Language.Tests.ArchivedSelf.Test.sumUpTo 5 |> Stdlib.Test.equal 15
      Darklang.Language.Tests.ArchivedSelf.Test.sumUpTo 10 |> Stdlib.Test.equal 55 ]

test incrementWithShadowing =
  Darklang.Language.Tests.ArchivedSelf.ShadowingTest.incrementWithShadowing 3 5 |> Stdlib.Test.equal 28

test factorialWithShadowing =
  Darklang.Language.Tests.ArchivedSelf.ShadowingTest.factorialWithShadowing 5 |> Stdlib.Test.equal ("shadowed", 120)

test matchWithShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.matchWithShadowing 0 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.matchWithShadowing 1 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.matchWithShadowing 2 |> Stdlib.Test.equal 8
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.matchWithShadowing 5 |> Stdlib.Test.equal 6 ]

test tupleMatchWithShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.tupleMatchWithShadowing (0, 10) |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.tupleMatchWithShadowing (1, 20) |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.tupleMatchWithShadowing (2, 3) |> Stdlib.Test.equal 30
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.tupleMatchWithShadowing (4, 5) |> Stdlib.Test.equal 9 ]

test letBindingShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.letBindingShadowing 4 |> Stdlib.Test.equal [12, 10]
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.letBindingShadowing 5 |> Stdlib.Test.equal [15, 10] ]

test conditionalShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 0 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 1 |> Stdlib.Test.equal 7
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 2 |> Stdlib.Test.equal 12
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 3 |> Stdlib.Test.equal 9
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 4 |> Stdlib.Test.equal 12
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 5 |> Stdlib.Test.equal 17
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.conditionalShadowing 6 |> Stdlib.Test.equal 23 ]

test pipeWithShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.pipeWithShadowing 0 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.pipeWithShadowing 1 |> Stdlib.Test.equal 0
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.pipeWithShadowing 2 |> Stdlib.Test.equal 12
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.pipeWithShadowing 5 |> Stdlib.Test.equal 10 ]

test valueShadowing =
  Stdlib.Test.all
    [ Darklang.Language.Tests.ArchivedSelf.ShadowingTest.valueShadowing 0 |> Stdlib.Test.equal 10
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.valueShadowing 1 |> Stdlib.Test.equal 11
      Darklang.Language.Tests.ArchivedSelf.ShadowingTest.valueShadowing 5 |> Stdlib.Test.equal 495 ]
