/// Combined runtime cases from scripts/perf/workloads/checks/semantics.dark.
module Darklang.Language.Tests.Semantics

type Shape =
  | Circle of Float
  | Rect of Float * Float
  | Named of name: String * inner: Shape

type Acct = { id: Int64; name: String; tags: List<String> }

let area (s: Shape) : Float =
  match s with
  | Circle r -> 3.14159 * r * r
  | Rect (w, h) -> w * h
  | Named (_, inner) -> area inner

let fib (n: Int64) : Int64 =
  if n < 2L then n else (fib (n - 1L)) + (fib (n - 2L))

let shapes () : List<Shape> =
  [ Shape.Circle 2.0
    Shape.Rect (3.0, 4.0)
    Shape.Named ("boxed", Shape.Rect (1.5, 2.0)) ]

test areasAndFiltering =
  let areas = shapes () |> Stdlib.List.map area
  Stdlib.Test.all
    [ areas |> Stdlib.Test.equal [ 12.56636, 12.0, 3.0 ]
      areas
      |> Stdlib.List.fold 0.0 (fun acc a -> acc + a)
      |> Stdlib.Test.equal 27.56636
      areas
      |> Stdlib.List.filter (fun a -> a > 5.0)
      |> Stdlib.Test.equal [ 12.56636, 12.0 ] ]

test recursion = fib 18L |> Stdlib.Test.equal 2584L

// Differs from legacy: the check printed the JSON and compared only `name` and
// `tags` after the round trip; this asserts the JSON text and the whole record.
test recordJsonRoundtrip =
  let acct = Acct { id = 7L; name = "ada"; tags = [ "x", "y" ] }
  let json = Stdlib.Json.serialize<Acct> acct
  Stdlib.Test.all
    [ json
      |> Stdlib.Test.equal "{\"id\":7,\"name\":\"ada\",\"tags\":[\"x\",\"y\"]}"
      Stdlib.Json.parse<Acct> json |> Stdlib.Test.equal (Ok acct) ]

// Differs from legacy: the check printed the JSON and compared only the length of
// the parsed list; this compares the whole list.
test recursiveEnumJsonRoundtrip =
  let original = shapes ()
  let json = Stdlib.Json.serialize<List<Shape>> original
  Stdlib.Json.parse<List<Shape>> json |> Stdlib.Test.equal (Ok original)
