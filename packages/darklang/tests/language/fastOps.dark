/// Operator fast-path checks. Ported from a by-hand perf check, which this replaced.
/// Run without tracing, as in the original check.
module Darklang.Language.Tests.FastOps

val d = Stdlib.Dict.fromEntries([ ("a", 1), ("b", 2) ])

let check(label: String, actual: String, expected: String): Stdlib.Test.Result =
  Stdlib.Test.expect(actual == expected, $"{label}: expected {expected}, got {actual}")

test dictGet =
  Stdlib.Test.all(
    [ check("dict get hit", Stdlib.display(Stdlib.Option.withDefault(Stdlib.Dict.get(d, "a"), 0)), "1")
      check("dict get miss", Stdlib.display(Stdlib.Option.withDefault(Stdlib.Dict.get(d, "zz"), -1)), "-1") ])

test dictSet =
  Stdlib.Test.all(
    [ check("dict set new key", Stdlib.display(Stdlib.List.length(Stdlib.Dict.keys(Stdlib.Dict.set(d, "c", 3)))), "3")
      check("dict set new value", Stdlib.display(Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.set(d, "c", 3), "c"), 0)), "3")
      check("dict set overwrite", Stdlib.display(Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.set(d, "a", 9), "a"), 0)), "9")
      check("dict set overwrite keeps size", Stdlib.display(Stdlib.List.length(Stdlib.Dict.keys(Stdlib.Dict.set(d, "a", 9)))), "2")
      check("dict set does not mutate", Stdlib.display(Stdlib.List.length(Stdlib.Dict.keys(d))), "2") ])

test int64ToString =
  Stdlib.Test.all(
    [ check("int64 toString", Stdlib.display(42), "42")
      check("int64 toString negative", Stdlib.display(-7), "-7") ])

test bigIntToString =
  Stdlib.Test.all(
    [ check("bigint toString", Stdlib.display(42z), "42")
      check("bigint toString negative", Stdlib.display(-7z), "-7")
      check("bigint toString past Int64", Stdlib.display(2z ** 70z), "1180591620717411303424") ])

test boolNot =
  check("bool not", (if Stdlib.Bool.not(true) then "y" else "n"), "n")

test listLength =
  check("list length", Stdlib.display(Stdlib.List.length([ 1, 2, 3 ])), "3")

test listConcat =
  check("list concat", Stdlib.display(Stdlib.List.length(Stdlib.List.concat([ 1, 2 ], [ 3 ]))), "3")

test stringAppend =
  check("string append", "a" + "b", "ab")

test stringEquals =
  check("string equals", (if "x" == "x" then "y" else "n"), "y")

test stringRepeat =
  Stdlib.Test.all(
    [ check("repeat one char", Stdlib.String.repeat("-", 3), "---")
      check("repeat multi char", Stdlib.String.repeat("ab", 2), "abab")
      check("repeat zero", Stdlib.String.repeat("x", 0), "")
      check("repeat negative", Stdlib.String.repeat("x", -2), "")
      check("repeat empty", Stdlib.String.repeat("", 5), "") ])

test stringIsEmpty =
  Stdlib.Test.all(
    [ check("string isEmpty yes", (if Stdlib.String.isEmpty("") then "y" else "n"), "y")
      check("string isEmpty no", (if Stdlib.String.isEmpty("a") then "y" else "n"), "n") ])

test listIsEmpty =
  Stdlib.Test.all(
    [ check("list isEmpty yes", (if Stdlib.List.isEmpty([]) then "y" else "n"), "y")
      check("list isEmpty no", (if Stdlib.List.isEmpty([ 1 ]) then "y" else "n"), "n") ])

test stringContains =
  let yn(b: Bool): String = if b then "y" else "n"

  Stdlib.Test.all(
    [ check("contains yes", yn(Stdlib.String.contains("abc def", "c d")), "y")
      check("contains no", yn(Stdlib.String.contains("abc def", "\n")), "n")
      check("contains empty", yn(Stdlib.String.contains("abc", "")), "y")
      check("contains half a cluster", yn(Stdlib.String.contains("éx", "e")), "n")
      check("contains whole cluster", yn(Stdlib.String.contains("aéx", "é")), "y") ])

test stringDisplayWidth =
  Stdlib.Test.all(
    [ check("width ascii", Stdlib.display(Stdlib.String.displayWidth("abc")), "3")
      check("width empty", Stdlib.display(Stdlib.String.displayWidth("")), "0")
      check("width wide", Stdlib.display(Stdlib.String.displayWidth("世界")), "4")
      check("width combining", Stdlib.display(Stdlib.String.displayWidth("é")), "1") ])
