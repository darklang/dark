module Darklang.Language.Tests.RuntimeToProgramTypes

// `RuntimeTypesToProgramTypes.dvalToExpr` promotes a runtime value (RT.Dval)
// back into a ProgramTypes expression - the "value -> source" primitive behind
// live values. IDs are freshly generated, so we pattern-match the result
// structurally instead of comparing whole expressions.

// Every case promotes against main, and most of them build a Dval, so both are
// factored out here - spelled in full these assertions ran to 500 columns.
let promote(
  d: Darklang.LanguageTools.RuntimeTypes.Dval)
  : Stdlib.Result.Result<Darklang.LanguageTools.ProgramTypes.Expr, String> =
  Darklang.LanguageTools.RuntimeTypesToProgramTypes.dvalToExpr(
    Darklang.SCM.Branch.mainBranchId,
    d)

let intValue(i: Int64): Darklang.LanguageTools.RuntimeTypes.Dval =
  Darklang.LanguageTools.RuntimeTypes.Dval.DInt64(i)

let unknownType(): Darklang.LanguageTools.RuntimeTypes.ValueType =
  Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown

// Doesn't name a real type, which is the point: the mapping is structural, and
// an unresolvable location just means the pretty-printer falls back to printing
// the hash.
let fakeType(): Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName =
  Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName.Package(
    Darklang.LanguageTools.RuntimeTypes.Hash.Hash("deadbeef"))

// --- literals ---
test literals =
  Stdlib.Test.all(
    [ (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DUnit) with
       | Ok(EUnit(_)) -> true
       | _ -> false)
      |> Stdlib.Test.equal(true)
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DBool(true)) with
       | Ok(EBool(_, b)) -> b
       | _ -> false)
      |> Stdlib.Test.equal(true)
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DBigInt(42z)) with
       | Ok(EBigInt(_, i)) -> i
       | _ -> -1z)
      |> Stdlib.Test.equal(42z)
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DInt64(7)) with
       | Ok(EInt64(_, i)) -> i
       | _ -> -1)
      |> Stdlib.Test.equal(7)
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat64(3.14)) with
       | Ok(EFloat64(_, _sign, w, f)) -> w + "." + f
       | _ -> "FAIL")
      |> Stdlib.Test.equal("3.14")
      // Every digit, not twelve of them: the REPL stores a captured value as a
      // binding's source, and a `let x = 0.1 + 0.2` that came back as `0.3` was
      // a different number from the one computed.
      (match
        promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat64(0.1 + 0.2))
       with
       | Ok(EFloat64(_, _sign, w, f)) -> w + "." + f
       | _ -> "FAIL")
      |> Stdlib.Test.equal("0.30000000000000004")
      // A Float32's own shortest digits, not the widened Float64's
      // 0.10000000149011612
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat32(0.1f32)) with
       | Ok(EFloat32(_, _sign, w, f)) -> w + "." + f
       | _ -> "FAIL")
      |> Stdlib.Test.equal("0.1")
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DChar('a')) with
       | Ok(EChar(_, c)) -> c
       | _ -> "FAIL")
      |> Stdlib.Test.equal("a")
      (match promote(Darklang.LanguageTools.RuntimeTypes.Dval.DString("hi")) with
       | Ok(EString(_, [ StringText(s) ])) -> s
       | _ -> "FAIL")
      |> Stdlib.Test.equal("hi") ])

// A float with no plain-decimal form has no literal syntax. This matters beyond
// looking wrong: the REPL stores a captured value as a binding's source, so
// `NaN.0` / `Infinity.0` / `1e+30.0` would wedge a session.
test floatsWithoutLiteralSyntax =
  Stdlib.Test.all(
    [ Stdlib.Result.isError(promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat64(0.0 / 0.0)))
      |> Stdlib.Test.equal(true)
      Stdlib.Result.isError(promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat64(1.0 / 0.0)))
      |> Stdlib.Test.equal(true)
      Stdlib.Result.isError(promote(Darklang.LanguageTools.RuntimeTypes.Dval.DFloat64(1e30)))
      |> Stdlib.Test.equal(true) ])

// --- collections ---
test collections =
  Stdlib.Test.all(
    [ (match
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DList(
            unknownType(),
            [ intValue(1), intValue(2) ])))
       with
       | Ok(EList(_, xs)) -> Stdlib.List.length(xs)
       | _ -> -1)
      |> Stdlib.Test.equal(2)
      (match
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DTuple(
            intValue(1),
            Darklang.LanguageTools.RuntimeTypes.Dval.DBool(true),
            [ Darklang.LanguageTools.RuntimeTypes.Dval.DString("x") ])))
       with
       | Ok(ETuple(_, _, _, rest)) -> Stdlib.List.length(rest)
       | _ -> -1)
      |> Stdlib.Test.equal(1)
      // nested list preserves inner literals
      (match
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DList(
            unknownType(),
            [ Darklang.LanguageTools.RuntimeTypes.Dval.DList(
                unknownType(),
                [ intValue(5) ]) ])))
       with
       | Ok(EList(_, [ EList(_, [ EInt64(_, i) ]) ])) -> i
       | _ -> -1)
      |> Stdlib.Test.equal(5) ])

// --- records and enums carry their type name across (RT -> PT) ---
test recordsAndEnums =
  Stdlib.Test.all(
    [ (match
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
            fakeType(),
            fakeType(),
            [],
            "Some",
            [ intValue(1) ])))
       with
       | Ok(EEnum(_, _, _, caseName, fields)) ->
         caseName + "/" + (Stdlib.display(Stdlib.List.length(fields)))
       | _ -> "FAIL")
      |> Stdlib.Test.equal("Some/1")
      (match
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DRecord(
            fakeType(),
            fakeType(),
            [],
            Stdlib.Dict.fromEntries(
              [ ("a", intValue(1))
                ("b", Darklang.LanguageTools.RuntimeTypes.Dval.DBool(true)) ]))))
       with
       | Ok(ERecord(_, _, _, fields)) -> Stdlib.List.length(fields)
       | _ -> -1)
      |> Stdlib.Test.equal(2)
      // a field that can't be promoted fails the whole enum, rather than
      // dropping it
      Stdlib.Result.isError((
        promote((
          Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
            fakeType(),
            fakeType(),
            [],
            "Some",
            [ Darklang.LanguageTools.RuntimeTypes.Dval.DUuid(Stdlib.Uuid.generate()) ])))
      ))
      |> Stdlib.Test.equal(true) ])

// The expression names the source type (the alias, if one was used), not the
// runtime one it resolved to.
let sourceHashOf(
  e: Stdlib.Result.Result<Darklang.LanguageTools.ProgramTypes.Expr, String>)
  : String =
  let nameHash(
    n: Darklang.LanguageTools.ProgramTypes.NameResolution<Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName>)
    : String =
    match n.resolved with
    | Ok(resolved) ->
      match resolved.name with
      | Package(Hash(h)) -> h
    | Error(_) -> "unresolved"
  match e with
  | Ok(ERecord(_, typeName, _, _)) -> nameHash(typeName)
  | Ok(EEnum(_, typeName, _, _, _)) -> nameHash(typeName)
  | _ -> "FAIL"

test recordsAndEnumsUseTheSourceTypeName =
  let source =
    Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName.Package(
      Darklang.LanguageTools.RuntimeTypes.Hash.Hash("cafef00d"))
  Stdlib.Test.all(
    [ sourceHashOf(
        promote(
          Darklang.LanguageTools.RuntimeTypes.Dval.DRecord(
            source,
            fakeType(),
            [],
            Stdlib.Dict.fromEntries([ ("a", intValue(1)) ]))))
      |> Stdlib.Test.equal("cafef00d")
      sourceHashOf(
        promote(
          Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
            source,
            fakeType(),
            [],
            "Some",
            [ intValue(1) ])))
      |> Stdlib.Test.equal("cafef00d") ])

// --- values with no literal syntax fail (Error), so the caller can fall back ---
test valuesWithoutLiteralSyntax =
  Stdlib.Test.all(
    [ Stdlib.Result.isError((
        promote(Darklang.LanguageTools.RuntimeTypes.Dval.DUuid(Stdlib.Uuid.generate()))
      ))
      |> Stdlib.Test.equal(true) ])
