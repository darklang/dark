// Separately written lambdas are unequal. Comparing them does not execute their bodies.
test lambdas =
  Stdlib.Test.all(
    [ ((fun x -> y) == (fun x -> y)) |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1s128 in y) == (fun x -> let y = 1s128 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1s128 in y) != (fun x -> let y = 2s128 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1u128 in y) == (fun x -> let y = 1u128 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1u128 in y) != (fun x -> let y = 2u128 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1 in y) == (fun x -> let y = 1 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1 in y) != (fun x -> let y = 2 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1s32 in y) == (fun x -> let y = 1s32 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1s32 in y) != (fun x -> let y = 2s32 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1u32 in y) == (fun x -> let y = 1u32 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1u32 in y) != (fun x -> let y = 2u32 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1s16 in y) == (fun x -> let y = 1s16 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1s16 in y) != (fun x -> let y = 2s16 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1u16 in y) == (fun x -> let y = 1u16 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1u16 in y) != (fun x -> let y = 2u16 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1s8 in y) == (fun x -> let y = 1s8 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1s8 in y) != (fun x -> let y = 2s8 in x))
      |> Stdlib.Test.equal(true)
      ((fun x -> let y = 1u8 in y) == (fun x -> let y = 1u8 in y))
      |> Stdlib.Test.equal(false)
      ((fun x -> let y = 1u8 in y) != (fun x -> let y = 2u8 in x))
      |> Stdlib.Test.equal(true) ])

test records =
  Stdlib.Test.all(
    [ (ERecInt128 { x = 6s128, y = 7s128 } == ERecInt128 { x = 6s128, y = 7s128 })
      |> Stdlib.Test.equal(true)
      (ERecInt128 { x = 6s128, y = 7s128 } == ERecInt128 { y = 7s128, x = 6s128 })
      |> Stdlib.Test.equal(true)
      (ERecInt128 { x = 6s128, y = 7s128 } != ERecInt128 { x = 7s128, y = 6s128 })
      |> Stdlib.Test.equal(true)
      (ERecInt128 { x = 6s128, y = 7s128 } == ERec2Int128 { y = 7s128, x = 6s128 })
      |> Stdlib.Test.equal(true)
      (ERecUInt128 { x = 6u128, y = 7u128 } == ERecUInt128 { x = 6u128, y = 7u128 })
      |> Stdlib.Test.equal(true)
      (ERecUInt128 { x = 6u128, y = 7u128 } == ERecUInt128 { y = 7u128, x = 6u128 })
      |> Stdlib.Test.equal(true)
      (ERecUInt128 { x = 6u128, y = 7u128 } != ERecUInt128 { x = 7u128, y = 6u128 })
      |> Stdlib.Test.equal(true)
      (ERecUInt128 { x = 6u128, y = 7u128 } == ERec2UInt128 { y = 7u128, x = 6u128 })
      |> Stdlib.Test.equal(true)
      (ERec { x = 6, y = 7 } == ERec { x = 6, y = 7 })
      |> Stdlib.Test.equal(true)
      (ERec { x = 6, y = 7 } == ERec { y = 7, x = 6 })
      |> Stdlib.Test.equal(true)
      (ERec { x = 6, y = 7 } != ERec { x = 7, y = 6 })
      |> Stdlib.Test.equal(true)
      (ERec { x = 6, y = 7 } == ERec2 { y = 7, x = 6 })
      |> Stdlib.Test.equal(true)
      (ERecUInt64 { x = 6u64, y = 7u64 } == ERecUInt64 { x = 6u64, y = 7u64 })
      |> Stdlib.Test.equal(true)
      (ERecUInt64 { x = 6u64, y = 7u64 } == ERecUInt64 { y = 7u64, x = 6u64 })
      |> Stdlib.Test.equal(true)
      (ERecUInt64 { x = 6u64, y = 7u64 } != ERecUInt64 { x = 7u64, y = 6u64 })
      |> Stdlib.Test.equal(true)
      (ERecUInt64 { x = 6u64, y = 7u64 } == ERec2UInt64 { y = 7u64, x = 6u64 })
      |> Stdlib.Test.equal(true)
      (ERecInt32 { x = 6s32, y = 7s32 } == ERecInt32 { x = 6s32, y = 7s32 })
      |> Stdlib.Test.equal(true)
      (ERecInt32 { x = 6s32, y = 7s32 } == ERecInt32 { y = 7s32, x = 6s32 })
      |> Stdlib.Test.equal(true)
      (ERecInt32 { x = 6s32, y = 7s32 } != ERecInt32 { x = 7s32, y = 6s32 })
      |> Stdlib.Test.equal(true)
      (ERecInt32 { x = 6s32, y = 7s32 } == ERec2Int32 { y = 7s32, x = 6s32 })
      |> Stdlib.Test.equal(true)
      (ERecUInt32 { x = 6u32, y = 7u32 } == ERecUInt32 { x = 6u32, y = 7u32 })
      |> Stdlib.Test.equal(true)
      (ERecUInt32 { x = 6u32, y = 7u32 } == ERecUInt32 { y = 7u32, x = 6u32 })
      |> Stdlib.Test.equal(true)
      (ERecUInt32 { x = 6u32, y = 7u32 } != ERecUInt32 { x = 7u32, y = 6u32 })
      |> Stdlib.Test.equal(true)
      (ERecUInt32 { x = 6u32, y = 7u32 } == ERec2UInt32 { y = 7u32, x = 6u32 })
      |> Stdlib.Test.equal(true)
      (ERecInt16 { x = 6s16, y = 7s16 } == ERecInt16 { x = 6s16, y = 7s16 })
      |> Stdlib.Test.equal(true)
      (ERecInt16 { x = 6s16, y = 7s16 } == ERecInt16 { y = 7s16, x = 6s16 })
      |> Stdlib.Test.equal(true)
      (ERecInt16 { x = 6s16, y = 7s16 } != ERecInt16 { x = 7s16, y = 6s16 })
      |> Stdlib.Test.equal(true)
      (ERecInt16 { x = 6s16, y = 7s16 } == ERec2Int16 { y = 7s16, x = 6s16 })
      |> Stdlib.Test.equal(true)
      (ERecUInt16 { x = 6u16, y = 7u16 } == ERecUInt16 { x = 6u16, y = 7u16 })
      |> Stdlib.Test.equal(true)
      (ERecUInt16 { x = 6u16, y = 7u16 } == ERecUInt16 { y = 7u16, x = 6u16 })
      |> Stdlib.Test.equal(true)
      (ERecUInt16 { x = 6u16, y = 7u16 } != ERecUInt16 { x = 7u16, y = 6u16 })
      |> Stdlib.Test.equal(true)
      (ERecUInt16 { x = 6u16, y = 7u16 } == ERec2UInt16 { y = 7u16, x = 6u16 })
      |> Stdlib.Test.equal(true)
      (ERecInt8 { x = 6s8, y = 7s8 } == ERecInt8 { x = 6s8, y = 7s8 })
      |> Stdlib.Test.equal(true)
      (ERecInt8 { x = 6s8, y = 7s8 } == ERecInt8 { y = 7s8, x = 6s8 })
      |> Stdlib.Test.equal(true)
      (ERecInt8 { x = 6s8, y = 7s8 } != ERecInt8 { x = 7s8, y = 6s8 })
      |> Stdlib.Test.equal(true)
      (ERecInt8 { x = 6s8, y = 7s8 } == ERec2Int8 { y = 7s8, x = 6s8 })
      |> Stdlib.Test.equal(true)
      (ERecUInt8 { x = 6u8, y = 7u8 } == ERecUInt8 { x = 6u8, y = 7u8 })
      |> Stdlib.Test.equal(true)
      (ERecUInt8 { x = 6u8, y = 7u8 } == ERecUInt8 { y = 7u8, x = 6u8 })
      |> Stdlib.Test.equal(true)
      (ERecUInt8 { x = 6u8, y = 7u8 } != ERecUInt8 { x = 7u8, y = 6u8 })
      |> Stdlib.Test.equal(true) ])

test enums =
  Stdlib.Test.all(
    [ (EEnumInt128.E1 == EEnumInt128.E1) |> Stdlib.Test.equal(true)
      (EEnumInt128.E1 != EEnumInt128.E2) |> Stdlib.Test.equal(true)
      (EEnumUInt128.E1 == EEnumUInt128.E1) |> Stdlib.Test.equal(true)
      (EEnumUInt128.E1 != EEnumUInt128.E2) |> Stdlib.Test.equal(true)
      (EEnumInt128.E3(5s128) == EEnumInt128.E3(5s128)) |> Stdlib.Test.equal(true)
      (EEnumInt128.E3(5s128) != EEnumInt128.E3(6s128)) |> Stdlib.Test.equal(true)
      (EEnum.E1 == EEnum.E1) |> Stdlib.Test.equal(true)
      (EEnum.E1 != EEnum.E2) |> Stdlib.Test.equal(true)
      (EEnum.E3(5) == EEnum.E3(5)) |> Stdlib.Test.equal(true)
      (EEnum.E3(5) != EEnum.E3(6)) |> Stdlib.Test.equal(true)
      (EEnumUIn64.E1 == EEnumUIn64.E1) |> Stdlib.Test.equal(true)
      (EEnumUIn64.E1 != EEnumUIn64.E2) |> Stdlib.Test.equal(true)
      (EEnumUIn64.E3(5u64) == EEnumUIn64.E3(5u64)) |> Stdlib.Test.equal(true)
      (EEnumUIn64.E3(5u64) != EEnumUIn64.E3(6u64)) |> Stdlib.Test.equal(true)
      (EEnumInt32.E1 == EEnumInt32.E1) |> Stdlib.Test.equal(true)
      (EEnumInt32.E1 != EEnumInt32.E2) |> Stdlib.Test.equal(true)
      (EEnumInt32.E3(5s32) == EEnumInt32.E3(5s32)) |> Stdlib.Test.equal(true)
      (EEnumInt32.E3(5s32) != EEnumInt32.E3(6s32)) |> Stdlib.Test.equal(true)
      (EEnumUInt32.E1 == EEnumUInt32.E1) |> Stdlib.Test.equal(true)
      (EEnumUInt32.E1 != EEnumUInt32.E2) |> Stdlib.Test.equal(true)
      (EEnumUInt32.E3(5u32) == EEnumUInt32.E3(5u32)) |> Stdlib.Test.equal(true)
      (EEnumUInt32.E3(5u32) != EEnumUInt32.E3(6u32)) |> Stdlib.Test.equal(true)
      (EEnumInt16.E1 == EEnumInt16.E1) |> Stdlib.Test.equal(true)
      (EEnumInt16.E1 != EEnumInt16.E2) |> Stdlib.Test.equal(true)
      (EEnumInt16.E3(5s16) == EEnumInt16.E3(5s16)) |> Stdlib.Test.equal(true)
      (EEnumInt16.E3(5s16) != EEnumInt16.E3(6s16)) |> Stdlib.Test.equal(true)
      (EEnumUInt16.E1 == EEnumUInt16.E1) |> Stdlib.Test.equal(true)
      (EEnumUInt16.E1 != EEnumUInt16.E2) |> Stdlib.Test.equal(true)
      (EEnumUInt16.E3(5u16) == EEnumUInt16.E3(5u16)) |> Stdlib.Test.equal(true)
      (EEnumUInt16.E3(5u16) != EEnumUInt16.E3(6u16)) |> Stdlib.Test.equal(true)
      (EEnumInt8.E1 == EEnumInt8.E1) |> Stdlib.Test.equal(true)
      (EEnumInt8.E1 != EEnumInt8.E2) |> Stdlib.Test.equal(true)
      (EEnumInt8.E3(5s8) == EEnumInt8.E3(5s8)) |> Stdlib.Test.equal(true)
      (EEnumInt8.E3(5s8) != EEnumInt8.E3(6s8)) |> Stdlib.Test.equal(true) ])

// aliases
