// Twitter.urlencode "https://google.com?q=left shark&l=en" = "https%3A%2F%2Fgoogle.com%3Fq%3Dleft%20shark%26l%3Den" // URL percent encoding

test unwrap =
  Stdlib.Test.all
    [ Stdlib.Option.Option.Some 5L |> Builtin.unwrap |> Stdlib.Test.equal 5L
      Stdlib.Result.Result.Ok true |> Builtin.unwrap |> Stdlib.Test.equal true ]

test unwrapNoneRaises =
  Stdlib.Option.Option.None |> Builtin.unwrap => raises "Cannot unwrap None"

test unwrapErrorRaises =
  Stdlib.Result.Result.Error 5L |> Builtin.unwrap
  => raises "Cannot unwrap Error: 5"

test unwrapNonOptionRaises =
  true |> Builtin.unwrap
  => raises "Can only unwrap Options and Results, yet got true"

test unwrapWrongArgCountRaises =
  Builtin.unwrap 1 2
  => raises "Builtin.unwrap expects 1 argument, but got 2 arguments"
