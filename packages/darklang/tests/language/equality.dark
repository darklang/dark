      (EEnum2.E1 == EEnum.E1) |> Stdlib.Test.equal(true)
      (EEnum2.E1 != EEnum.E2) |> Stdlib.Test.equal(true)
      (EEnum2UIn64.E1 == EEnumUIn64.E1) |> Stdlib.Test.equal(true)
      (EEnum2UIn64.E1 != EEnumUIn64.E2) |> Stdlib.Test.equal(true)
      (EEnum2Int32.E1 == EEnumInt32.E1) |> Stdlib.Test.equal(true)
      (EEnum2Int32.E1 != EEnumInt32.E2) |> Stdlib.Test.equal(true)
      (EEnum2UInt32.E1 == EEnumUInt32.E1) |> Stdlib.Test.equal(true)
      (EEnum2UInt32.E1 != EEnumUInt32.E2) |> Stdlib.Test.equal(true)
      (EEnum2Int16.E1 == EEnumInt16.E1) |> Stdlib.Test.equal(true)
      (EEnum2Int16.E1 != EEnumInt16.E2) |> Stdlib.Test.equal(true)
      (EEnum2UInt16.E1 == EEnumUInt16.E1) |> Stdlib.Test.equal(true)
      (EEnum2UInt16.E1 != EEnumUInt16.E2) |> Stdlib.Test.equal(true)
      (EEnum2Int8.E1 == EEnumInt8.E1) |> Stdlib.Test.equal(true)
      (EEnum2Int8.E1 != EEnumInt8.E2) |> Stdlib.Test.equal(true)
      (EEnum2UInt8.E1 == EEnumUInt8.E1) |> Stdlib.Test.equal(true)
      (EEnum2UInt8.E1 != EEnumUInt8.E2) |> Stdlib.Test.equal(true) ])

test optionsAndResults =
  Stdlib.Test.all(
    [ (Stdlib.Option.Option.None == Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(true)
      (Stdlib.Option.Option.None
       != Stdlib.Option.Option.Some(Stdlib.Option.Option.None))
      |> Stdlib.Test.equal(true)
      (Stdlib.Option.Option.Some(5) == Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(true)
      (Stdlib.Option.Option.Some(5) != Stdlib.Option.Option.Some(6))
      |> Stdlib.Test.equal(true)
      (Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(0))
       != Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(1)))
      |> Stdlib.Test.equal(true)
      (Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(0))
       == Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(0)))
      |> Stdlib.Test.equal(true)
      (Stdlib.Result.Result.Error(0) == Stdlib.Result.Result.Error(0))
      |> Stdlib.Test.equal(true)
      (Stdlib.Result.Result.Ok(0) == Stdlib.Result.Result.Ok(0))
      |> Stdlib.Test.equal(true)
      (Stdlib.Result.Result.Ok(0) != Stdlib.Result.Result.Error(0))
      |> Stdlib.Test.equal(true) ])

test floatEqualsInt64Raises =
  (5.7 != 6) => raises "Cannot perform equality check on Float and Int64. Both sides must be the same type. Write the number with a decimal point, as `5.0`, or convert with `Stdlib.Int64.toFloat(n)`."

test floatEqualsSameValueInt64Raises =
  (5.7 != 5) => raises "Cannot perform equality check on Float and Int64. Both sides must be the same type. Write the number with a decimal point, as `5.0`, or convert with `Stdlib.Int64.toFloat(n)`."

test uint16EqualsInt16Raises =
  (5u16 == 5s16) => raises "Cannot perform equality check on UInt16 and Int16"

test int8EqualsInt32Raises =
  (5s8 == 5s32) => raises "Cannot perform equality check on Int8 and Int32"

test int64EqualsInt32Raises =
  (5 == 5s32) => raises "Cannot perform equality check on Int64 and Int32"

test uint16NotEqualsInt16Raises =
  (5u16 != 6s16) => raises "Cannot perform equality check on UInt16 and Int16"

test leftOperandErrorRaisesFirst =
  (Stdlib.Test.raiseRuntimeError("test")
   != Stdlib.Test.raiseRuntimeError("different msg"))
  => raises "Uncaught exception: test"

test unitEqualsOptionRaises =
  (() != Stdlib.Option.Option.None)
  => raises
    "Cannot perform equality check on Unit and Darklang.Stdlib.Option.Option<_>"

test unitEqualsBoolRaises =
  (() != false) => raises "Cannot perform equality check on Unit and Bool"

test unitEqualsInt32Raises =
  (() != 0s32) => raises "Cannot perform equality check on Unit and Int32"

test unitEqualsFloatRaises =
  (() != 0.0) => raises "Cannot perform equality check on Unit and Float"

// The left operand's error is raised before the right operand is evaluated.
test leftOperandErrorRaisesBeforeRight =
  (1 / 0) != (Builtin.unwrap(None)) => raises "Cannot divide by 0"

// Other ways to call it
test equalsForms =
  Stdlib.Test.all(
    [ 1s128 == 1s128 |> Stdlib.Test.equal(true)
      (==)(1s128, 1s128) |> Stdlib.Test.equal(true)
      1u128 == 1u128 |> Stdlib.Test.equal(true)
      (==)(1u128, 1u128) |> Stdlib.Test.equal(true)
      1 == 1 |> Stdlib.Test.equal(true)
      (==)(1, 1) |> Stdlib.Test.equal(true)
      1s32 == 1s32 |> Stdlib.Test.equal(true)
      (==)(1s32, 1s32) |> Stdlib.Test.equal(true)
      1u32 == 1u32 |> Stdlib.Test.equal(true)
      (==)(1u32, 1u32) |> Stdlib.Test.equal(true)
      1s16 == 1s16 |> Stdlib.Test.equal(true)
      (==)(1s16, 1s16) |> Stdlib.Test.equal(true)
      1u16 == 1u16 |> Stdlib.Test.equal(true)
      (==)(1u16, 1u16) |> Stdlib.Test.equal(true)
      1s8 == 1s8 |> Stdlib.Test.equal(true)
      (==)(1s8, 1s8) |> Stdlib.Test.equal(true)
      1u8 == 1u8 |> Stdlib.Test.equal(true)
      (==)(1u8, 1u8) |> Stdlib.Test.equal(true) ])

test stdlibEquals =
  Stdlib.Test.all(
    [ Stdlib.equals(1s128, 1s128) |> Stdlib.Test.equal(true)
      Stdlib.equals(1u128, 1u128) |> Stdlib.Test.equal(true)
      Stdlib.equals(1, 1) |> Stdlib.Test.equal(true)
      Stdlib.equals(1s32, 1s32) |> Stdlib.Test.equal(true)
      Stdlib.equals(1u32, 1u32) |> Stdlib.Test.equal(true)
      Stdlib.equals(1s16, 1s16) |> Stdlib.Test.equal(true)
      Stdlib.equals(1u16, 1u16) |> Stdlib.Test.equal(true)
      Stdlib.equals(1s8, 1s8) |> Stdlib.Test.equal(true)
      Stdlib.equals(1u8, 1u8) |> Stdlib.Test.equal(true) ])

test notEquals =
  Stdlib.Test.all(
    [ 1s128 != 1s128 |> Stdlib.Test.equal(false)
      1u128 != 1u128 |> Stdlib.Test.equal(false)
      1 != 1 |> Stdlib.Test.equal(false)
      1s32 != 1s32 |> Stdlib.Test.equal(false)
      1u32 != 1u32 |> Stdlib.Test.equal(false)
      1s16 != 1s16 |> Stdlib.Test.equal(false)
      1u16 != 1u16 |> Stdlib.Test.equal(false)
      1s8 != 1s8 |> Stdlib.Test.equal(false)
      1u8 != 1u8 |> Stdlib.Test.equal(false)
      "abc" != "abc" |> Stdlib.Test.equal(false)
      "abd" != "abc" |> Stdlib.Test.equal(true)
      ((Stdlib.DateTime.parse("2021-07-28T22:42:36Z"))
       != (Stdlib.DateTime.parse("2019-07-28T22:42:36Z")))
      |> Stdlib.Test.equal(true)
      (!=)(1s128, 1s128) |> Stdlib.Test.equal(false)
      (!=)(1u128, 1u128) |> Stdlib.Test.equal(false)
      (!=)(1, 1) |> Stdlib.Test.equal(false)
      (!=)(1s32, 1s32) |> Stdlib.Test.equal(false)
      (!=)(1u32, 1u32) |> Stdlib.Test.equal(false)
      (!=)(1s16, 1s16) |> Stdlib.Test.equal(false)
      (!=)(1u16, 1u16) |> Stdlib.Test.equal(false)
      (!=)(1s8, 1s8) |> Stdlib.Test.equal(false)
      (!=)(1u8, 1u8) |> Stdlib.Test.equal(false)
      (!=)("abc", "abc") |> Stdlib.Test.equal(false)
      (!=)("abd", "abc") |> Stdlib.Test.equal(true)
      ((!=)(
        Stdlib.DateTime.parse("2021-07-28T22:42:36Z"),
        Stdlib.DateTime.parse("2019-07-28T22:42:36Z")))
      |> Stdlib.Test.equal(true) ])

test stdlibNotEquals =
  Stdlib.Test.all(
    [ Stdlib.notEquals(1s128, 1s128) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1u128, 1u128) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1, 1) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1s32, 1s32) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1u32, 1u32) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1s16, 1s16) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1u16, 1u16) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1s8, 1s8) |> Stdlib.Test.equal(false)
      Stdlib.notEquals(1u8, 1u8) |> Stdlib.Test.equal(false)
      Stdlib.notEquals("abc", "abc") |> Stdlib.Test.equal(false)
      Stdlib.notEquals("abd", "abc") |> Stdlib.Test.equal(true)
      (Stdlib.notEquals(
        Stdlib.DateTime.parse("2021-07-28T22:42:36Z"),
        Stdlib.DateTime.parse("2019-07-28T22:42:36Z")))
      |> Stdlib.Test.equal(true) ])

