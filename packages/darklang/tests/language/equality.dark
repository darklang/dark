module Darklang.Language.Tests.Equality

type ERec = { x: Int64; y: Int64 }
type ERec2 = ERec
type ERecUInt64 = { x: UInt64; y: UInt64 }
type ERec2UInt64 = ERecUInt64
type ERecInt8 = { x: Int8; y: Int8 }
type ERec2Int8 = ERecInt8
type ERecUInt8 = { x: UInt8; y: UInt8 }
type ERec2UInt8 = ERecUInt8
type ERecInt16 = { x: Int16; y: Int16 }
type ERec2Int16 = ERecInt16
type ERecUInt16 = { x: UInt16; y: UInt16 }
type ERec2UInt16 = ERecUInt16
type ERecInt32 = { x: Int32; y: Int32 }
type ERec2Int32 = ERecInt32
type ERecUInt32 = { x: UInt32; y: UInt32 }
type ERec2UInt32 = ERecUInt32
type ERecInt128 = { x: Int128; y: Int128 }
type ERec2Int128 = ERecInt128
type ERecUInt128 = { x: UInt128; y: UInt128 }
type ERec2UInt128 = ERecUInt128
type EEnumInt8 = | E1 | E2 | E3 of Int8
type EEnum2Int8 = EEnumInt8
type EEnumUInt8 = | E1 | E2 | E3 of UInt8
type EEnum2UInt8 = EEnumUInt8
type EEnumInt16 = | E1 | E2 | E3 of Int16
type EEnum2Int16 = EEnumInt16
type EEnumUInt16 = | E1 | E2 | E3 of UInt16
type EEnum2UInt16 = EEnumUInt16
type EEnumInt32 = | E1 | E2 | E3 of Int32
type EEnum2Int32 = EEnumInt32
type EEnumUInt32 = | E1 | E2 | E3 of UInt32
type EEnum2UInt32 = EEnumUInt32
type EEnum = | E1 | E2 | E3 of Int64
type EEnum2 = EEnum
type EEnumUIn64 = | E1 | E2 | E3 of UInt64
type EEnum2UIn64 = EEnumUIn64
type EEnumInt128 = | E1 | E2 | E3 of Int128
type EEnum2Int128 = EEnumInt128
type EEnumUInt128 = | E1 | E2 | E3 of UInt128
type EEnum2UInt128 = EEnumUInt128

test scalars =
  Stdlib.Test.all
    [ (5Q == 5Q) |> Stdlib.Test.equal true
      (5Q != 6Q) |> Stdlib.Test.equal true
      (5Z == 5Z) |> Stdlib.Test.equal true
      (5Z != 6Z) |> Stdlib.Test.equal true
      (5L == 5L) |> Stdlib.Test.equal true
      (5L != 6L) |> Stdlib.Test.equal true
      (5l == 5l) |> Stdlib.Test.equal true
      (5l != 6l) |> Stdlib.Test.equal true
      (5ul == 5ul) |> Stdlib.Test.equal true
      (5ul != 6ul) |> Stdlib.Test.equal true
      (5y == 5y) |> Stdlib.Test.equal true
      (5y != 6y) |> Stdlib.Test.equal true
      (5uy == 5uy) |> Stdlib.Test.equal true
      (5uy != 6uy) |> Stdlib.Test.equal true
      (5s == 5s) |> Stdlib.Test.equal true
      (5s != 6s) |> Stdlib.Test.equal true
      (5us == 5us) |> Stdlib.Test.equal true
      (5us != 6us) |> Stdlib.Test.equal true
      (5.6 == 5.6) |> Stdlib.Test.equal true
      (-55555555555555555555555555555.5 == -55555555555555555555555555555.5)
      |> Stdlib.Test.equal true
      (5.6 != 5.7) |> Stdlib.Test.equal true
      ("asd" == "asd") |> Stdlib.Test.equal true
      ("asd" != "sad") |> Stdlib.Test.equal true
      (true == true) |> Stdlib.Test.equal true
      (false == false) |> Stdlib.Test.equal true
      (true != false) |> Stdlib.Test.equal true
      (() == ()) |> Stdlib.Test.equal true ]

test lists =
  Stdlib.Test.all
    [ ([ 1L, 2L, 3L ] == [ 1L, 2L, 3L ]) |> Stdlib.Test.equal true
      ([ 1L, 2L, 3L ] != [ 3L, 2L, 1L ]) |> Stdlib.Test.equal true
      ([ 1l, 2l, 3l ] == [ 1l, 2l, 3l ]) |> Stdlib.Test.equal true
      ([ 1l, 2l, 3l ] != [ 3l, 2l, 1l ]) |> Stdlib.Test.equal true
      ([ 1ul, 2ul, 3ul ] == [ 1ul, 2ul, 3ul ]) |> Stdlib.Test.equal true
      ([ 1ul, 2ul, 3ul ] != [ 3ul, 2ul, 1ul ]) |> Stdlib.Test.equal true
      ([ 1s, 2s, 3s ] == [ 1s, 2s, 3s ]) |> Stdlib.Test.equal true
      ([ 1s, 2s, 3s ] != [ 3s, 2s, 1s ]) |> Stdlib.Test.equal true
      ([ 1us, 2us, 3us ] == [ 1us, 2us, 3us ]) |> Stdlib.Test.equal true
      ([ 1us, 2us, 3us ] != [ 3us, 2us, 1us ]) |> Stdlib.Test.equal true
      ([ 1y, 2y, 3y ] == [ 1y, 2y, 3y ]) |> Stdlib.Test.equal true
      ([ 1y, 2y, 3y ] != [ 3y, 2y, 1y ]) |> Stdlib.Test.equal true
      ([ 1uy, 2uy, 3uy ] == [ 1uy, 2uy, 3uy ]) |> Stdlib.Test.equal true
      ([ 1uy, 2uy, 3uy ] != [ 3uy, 2uy, 1uy ]) |> Stdlib.Test.equal true ]

test bytesDatesAndUuids =
  Stdlib.Test.all
    [ ((Stdlib.String.toBytes "🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼")
       == (Stdlib.String.toBytes "🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼"))
      |> Stdlib.Test.equal true
      ((Stdlib.DateTime.parse "2019-07-28T22:42:36Z")
       == (Stdlib.DateTime.parse "2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal true
      ((Stdlib.DateTime.parse "2019-07-28T22:42:37Z")
       != (Stdlib.DateTime.parse "2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal true
      (Stdlib.Uuid.parse "3700adbc-7a46-4ff4-81d3-45afb03f6e2d"
       == Stdlib.Uuid.parse "3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
      |> Stdlib.Test.equal true
      (Stdlib.Uuid.parse "3700adbc-7a46-4ff4-81d3-45afb03f6e2e"
       != Stdlib.Uuid.parse "3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
      |> Stdlib.Test.equal true ]

