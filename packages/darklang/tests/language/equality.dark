module Darklang.Language.Tests.Equality

type ERec = { x: Int64, y: Int64 }
type ERec2 = ERec
type ERecUInt64 = { x: UInt64, y: UInt64 }
type ERec2UInt64 = ERecUInt64
type ERecInt8 = { x: Int8, y: Int8 }
type ERec2Int8 = ERecInt8
type ERecUInt8 = { x: UInt8, y: UInt8 }
type ERec2UInt8 = ERecUInt8
type ERecInt16 = { x: Int16, y: Int16 }
type ERec2Int16 = ERecInt16
type ERecUInt16 = { x: UInt16, y: UInt16 }
type ERec2UInt16 = ERecUInt16
type ERecInt32 = { x: Int32, y: Int32 }
type ERec2Int32 = ERecInt32
type ERecUInt32 = { x: UInt32, y: UInt32 }
type ERec2UInt32 = ERecUInt32
type ERecInt128 = { x: Int128, y: Int128 }
type ERec2Int128 = ERecInt128
type ERecUInt128 = { x: UInt128, y: UInt128 }
type ERec2UInt128 = ERecUInt128
type EEnumInt8 = | E1 | E2 | E3(Int8)
type EEnum2Int8 = EEnumInt8
type EEnumUInt8 = | E1 | E2 | E3(UInt8)
type EEnum2UInt8 = EEnumUInt8
type EEnumInt16 = | E1 | E2 | E3(Int16)
type EEnum2Int16 = EEnumInt16
type EEnumUInt16 = | E1 | E2 | E3(UInt16)
type EEnum2UInt16 = EEnumUInt16
type EEnumInt32 = | E1 | E2 | E3(Int32)
type EEnum2Int32 = EEnumInt32
type EEnumUInt32 = | E1 | E2 | E3(UInt32)
type EEnum2UInt32 = EEnumUInt32
type EEnum = | E1 | E2 | E3(Int64)
type EEnum2 = EEnum
type EEnumUIn64 = | E1 | E2 | E3(UInt64)
type EEnum2UIn64 = EEnumUIn64
type EEnumInt128 = | E1 | E2 | E3(Int128)
type EEnum2Int128 = EEnumInt128
type EEnumUInt128 = | E1 | E2 | E3(UInt128)
type EEnum2UInt128 = EEnumUInt128

test scalars =
  Stdlib.Test.all(
    [ (5s128 == 5s128) |> Stdlib.Test.equal(true)
      (5s128 != 6s128) |> Stdlib.Test.equal(true)
      (5u128 == 5u128) |> Stdlib.Test.equal(true)
      (5u128 != 6u128) |> Stdlib.Test.equal(true)
      (5 == 5) |> Stdlib.Test.equal(true)
      (5 != 6) |> Stdlib.Test.equal(true)
      (5s32 == 5s32) |> Stdlib.Test.equal(true)
      (5s32 != 6s32) |> Stdlib.Test.equal(true)
      (5u32 == 5u32) |> Stdlib.Test.equal(true)
      (5u32 != 6u32) |> Stdlib.Test.equal(true)
      (5s8 == 5s8) |> Stdlib.Test.equal(true)
      (5s8 != 6s8) |> Stdlib.Test.equal(true)
      (5u8 == 5u8) |> Stdlib.Test.equal(true)
      (5u8 != 6u8) |> Stdlib.Test.equal(true)
      (5s16 == 5s16) |> Stdlib.Test.equal(true)
      (5s16 != 6s16) |> Stdlib.Test.equal(true)
      (5u16 == 5u16) |> Stdlib.Test.equal(true)
      (5u16 != 6u16) |> Stdlib.Test.equal(true)
      (5.6 == 5.6) |> Stdlib.Test.equal(true)
      (-5.555555555555555e28 == -5.555555555555555e28)
      |> Stdlib.Test.equal(true)
      (5.6 != 5.7) |> Stdlib.Test.equal(true)
      ("asd" == "asd") |> Stdlib.Test.equal(true)
      ("asd" != "sad") |> Stdlib.Test.equal(true)
      (true == true) |> Stdlib.Test.equal(true)
      (false == false) |> Stdlib.Test.equal(true)
      (true != false) |> Stdlib.Test.equal(true)
      (() == ()) |> Stdlib.Test.equal(true) ])

test lists =
  Stdlib.Test.all(
    [ ([ 1, 2, 3 ] == [ 1, 2, 3 ]) |> Stdlib.Test.equal(true)
      ([ 1, 2, 3 ] != [ 3, 2, 1 ]) |> Stdlib.Test.equal(true)
      ([ 1s32, 2s32, 3s32 ] == [ 1s32, 2s32, 3s32 ]) |> Stdlib.Test.equal(true)
      ([ 1s32, 2s32, 3s32 ] != [ 3s32, 2s32, 1s32 ]) |> Stdlib.Test.equal(true)
      ([ 1u32, 2u32, 3u32 ] == [ 1u32, 2u32, 3u32 ]) |> Stdlib.Test.equal(true)
      ([ 1u32, 2u32, 3u32 ] != [ 3u32, 2u32, 1u32 ]) |> Stdlib.Test.equal(true)
      ([ 1s16, 2s16, 3s16 ] == [ 1s16, 2s16, 3s16 ]) |> Stdlib.Test.equal(true)
      ([ 1s16, 2s16, 3s16 ] != [ 3s16, 2s16, 1s16 ]) |> Stdlib.Test.equal(true)
      ([ 1u16, 2u16, 3u16 ] == [ 1u16, 2u16, 3u16 ]) |> Stdlib.Test.equal(true)
      ([ 1u16, 2u16, 3u16 ] != [ 3u16, 2u16, 1u16 ]) |> Stdlib.Test.equal(true)
      ([ 1s8, 2s8, 3s8 ] == [ 1s8, 2s8, 3s8 ]) |> Stdlib.Test.equal(true)
      ([ 1s8, 2s8, 3s8 ] != [ 3s8, 2s8, 1s8 ]) |> Stdlib.Test.equal(true)
      ([ 1u8, 2u8, 3u8 ] == [ 1u8, 2u8, 3u8 ]) |> Stdlib.Test.equal(true)
      ([ 1u8, 2u8, 3u8 ] != [ 3u8, 2u8, 1u8 ]) |> Stdlib.Test.equal(true) ])

test bytesDatesAndUuids =
  Stdlib.Test.all(
    [ ((Stdlib.Utf8.encode("🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼"))
       == (Stdlib.Utf8.encode("🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼")))
      |> Stdlib.Test.equal(true)
      ((Stdlib.DateTime.parse("2019-07-28T22:42:36Z"))
       == (Stdlib.DateTime.parse("2019-07-28T22:42:36Z")))
      |> Stdlib.Test.equal(true)
      ((Stdlib.DateTime.parse("2019-07-28T22:42:37Z"))
       != (Stdlib.DateTime.parse("2019-07-28T22:42:36Z")))
      |> Stdlib.Test.equal(true)
      (Stdlib.Uuid.parse("3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
       == Stdlib.Uuid.parse("3700adbc-7a46-4ff4-81d3-45afb03f6e2d"))
      |> Stdlib.Test.equal(true)
      (Stdlib.Uuid.parse("3700adbc-7a46-4ff4-81d3-45afb03f6e2e")
       != Stdlib.Uuid.parse("3700adbc-7a46-4ff4-81d3-45afb03f6e2d"))
      |> Stdlib.Test.equal(true) ])

