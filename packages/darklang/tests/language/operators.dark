module Darklang.Language.Tests.Operators

test addition =
  Stdlib.Test.all(
    [ 5 + 3 |> Stdlib.Test.equal(8)
      "xx" + "yy" |> Stdlib.Test.equal("xxyy")
      (5 + (3)) |> Stdlib.Test.equal(8)
      (5 + 3) |> Stdlib.Test.equal(8) ])

// Numeric operators are polymorphic over numeric types at runtime
test numericTypes =
  Stdlib.Test.all(
    [ 1.0 + 2.0 |> Stdlib.Test.equal(3.0)
      3.5 * 2.0 |> Stdlib.Test.equal(7.0)
      10.0 - 4.0 |> Stdlib.Test.equal(6.0)
      1s8 + 2s8 |> Stdlib.Test.equal(3s8)
      100u64 - 1u64 |> Stdlib.Test.equal(99u64)
      10 / 3 |> Stdlib.Test.equal(3)
      10.0 / 4.0 |> Stdlib.Test.equal(2.5)
      7 % 3 |> Stdlib.Test.equal(1)
      -8 % 3 |> Stdlib.Test.equal(1)
      2.0 ** 3.0 |> Stdlib.Test.equal(8.0)
      2 ** 3 |> Stdlib.Test.equal(8)
      2.5 < 3.5 |> Stdlib.Test.equal(true)
      5 >= 5 |> Stdlib.Test.equal(true)
      2s8 > 1s8 |> Stdlib.Test.equal(true) ])

// Float64 has no Modulo implementation, deliberately; Decimal and the integers do
test floatModuloRaises =
  7.5 % 2.0
  => raises
    "Float64 has no implementation of Darklang.Stdlib.Modulo. Write `impl Modulo for Float64 = ...`, or run `dark impls Modulo` to see which types do"

// Mixed operand types are a type error (no implicit coercion), said before
// dispatch so the message is the operator's, not the impl fn's
test int64PlusBoolRaises =
  5 + true => raises "Cannot perform numeric operation on Int64 and Bool"

test int64PlusFloatRaises =
  1 + 2.0
  => raises "Cannot perform numeric operation on Int64 and Float64. Both sides must be the same type. Write the number with a decimal point, as `5.0`, or convert with `Stdlib.Int64.toFloat64(n)`."

// `/`, `%` and `**` say so as well, rather than failing inside the left side's implementation
test int64DividedByFloatRaises =
  5 / 2.0
  => raises "Cannot perform numeric operation on Int64 and Float64. Both sides must be the same type. Write the number with a decimal point, as `5.0`, or convert with `Stdlib.Int64.toFloat64(n)`."

test floatToThePowerOfInt64Raises =
  2.0 ** 3
  => raises "Cannot perform numeric operation on Float64 and Int64. Both sides must be the same type. Write the number with a decimal point, as `5.0`, or convert with `Stdlib.Int64.toFloat64(n)`."

test int32ModuloInt64Raises =
  7s32 % 2 => raises "Cannot perform numeric operation on Int32 and Int64"

// #6024: joining a String and an Int is how a newcomer meets this, so it says how to convert
test stringPlusInt64SaysHowToJoin =
  "total: " + 5
  => raises "Cannot perform numeric operation on String and Int64. To join them, make the Int64 a String with `Stdlib.display`, or interpolate it: `$\"total: {n}\"`."

// String implements Add but no other arithmetic trait
test stringAdd =
  "a" + "b" |> Stdlib.Test.equal("ab")

test stringSubtractRaises =
  "a" - "b"
  => raises
    "String has no implementation of Darklang.Stdlib.Subtract. Write `impl Subtract for String = ...`, or run `dark impls Subtract` to see which types do"

test overflow =
  Stdlib.Test.all(
    [ // Integer +,-,* overflow wraps around (two's complement)
      127s8 + 1s8 |> Stdlib.Test.equal(-128s8)
      0u8 - 1u8 |> Stdlib.Test.equal(255u8)
      9223372036854775807 + 1 |> Stdlib.Test.equal(-9223372036854775808)
      2 * 9223372036854775807 |> Stdlib.Test.equal(-2)
      170141183460469231731687303715884105727s128 + 1s128
      |> Stdlib.Test.equal(-170141183460469231731687303715884105728s128)
      340282366920938463463374607431768211455u128 + 1u128 |> Stdlib.Test.equal(0u128)
      // Signed integer division overflow (MinValue / -1) wraps back to MinValue
      -9223372036854775808 / -1 |> Stdlib.Test.equal(-9223372036854775808)
      -128s8 / -1s8 |> Stdlib.Test.equal(-128s8)
      // Power overflow wraps around (two's complement)
      2 ** 64 |> Stdlib.Test.equal(0)
      (-9223372036854775808) ** 64 |> Stdlib.Test.equal(0) ])

// Integer division by zero raises a clean RTE
test divideByZeroRaises =
  10 / 0 => raises "Cannot divide by 0"

// Float64 overflow produces infinity, following IEEE arithmetic.
test floatOverflowIsInfinity =
  2.0 ** 100000.0 |> Stdlib.Test.equal(1.0 / 0.0)

// `**` (power) works on every numeric type, the 128-bit ints included
test power =
  Stdlib.Test.all(
    [ 2s8 ** 3s8 |> Stdlib.Test.equal(8s8)
      3u8 ** 3u8 |> Stdlib.Test.equal(27u8)
      2s32 ** 10s32 |> Stdlib.Test.equal(1024s32)
      2s128 ** 3s128 |> Stdlib.Test.equal(8s128)
      2u128 ** 3u128 |> Stdlib.Test.equal(8u128)
      // and wraps on overflow, as the narrower widths do
      2u128 ** 128u128 |> Stdlib.Test.equal(0u128) ])

// unary `-` works on every signed integer type and Float64
test unaryMinus =
  Stdlib.Test.all(
    [ -(2s8 + 3s8) |> Stdlib.Test.equal(-5s8)
      -(1.0 + 1.5) |> Stdlib.Test.equal(-2.5) ])

test rightOperandErrorRaises =
  5 + (Stdlib.Test.raiseRuntimeError("error"))
  => raises "Uncaught exception: error"

test leftOperandErrorRaises =
  (Stdlib.Test.raiseRuntimeError("error")) + 5
  => raises "Uncaught exception: error"

test leftOperandErrorRaisesFirst =
  (Stdlib.Test.raiseRuntimeError("one")) + (Stdlib.Test.raiseRuntimeError("two"))
  => raises "Uncaught exception: one"

// ---------------------------------------------------------------------------
// Bitwise operators: `&` `|` `^` `<<` `>>`, and unary `~`
// ---------------------------------------------------------------------------

// polymorphic over every integer type; both operands must be the same type
test bitwise =
  Stdlib.Test.all(
    [ 12 & 10 |> Stdlib.Test.equal(8)
      12 | 10 |> Stdlib.Test.equal(14)
      12 ^ 10 |> Stdlib.Test.equal(6)
      12s8 & 10s8 |> Stdlib.Test.equal(8s8)
      12u8 | 10u8 |> Stdlib.Test.equal(14u8)
      12s16 ^ 10s16 |> Stdlib.Test.equal(6s16)
      12u16 & 10u16 |> Stdlib.Test.equal(8u16)
      12s32 | 10s32 |> Stdlib.Test.equal(14s32)
      12u32 ^ 10u32 |> Stdlib.Test.equal(6u32)
      12u64 & 10u64 |> Stdlib.Test.equal(8u64)
      12s128 | 10s128 |> Stdlib.Test.equal(14s128)
      12u128 ^ 10u128 |> Stdlib.Test.equal(6u128)
      12 & 10 |> Stdlib.Test.equal(8)
      12 | 10 |> Stdlib.Test.equal(14)
      12 ^ 10 |> Stdlib.Test.equal(6) ])

test shifts =
  Stdlib.Test.all(
    [ // the shift COUNT is the same type as the value
      1 << 4 |> Stdlib.Test.equal(16)
      64 >> 3 |> Stdlib.Test.equal(8)
      1s8 << 2s8 |> Stdlib.Test.equal(4s8)
      128u8 >> 7u8 |> Stdlib.Test.equal(1u8)
      1z << 100z |> Stdlib.Test.equal(1267650600228229401496703205376z)
      (1z << 100z) >> 99z |> Stdlib.Test.equal(2z)
      // fixed-width shifts wrap; `BigInt` grows instead
      1 << 64 |> Stdlib.Test.equal(1)
      1u8 << 8u8 |> Stdlib.Test.equal(1u8) ])

// `BigInt` has no width to mask a count against, so an unusable one raises
test negativeLeftShiftRaises =
  1z << -1z => raises "Shift count out of range (0 to 2147483647): -1z"

test negativeRightShiftRaises =
  1z >> -1z => raises "Shift count out of range (0 to 2147483647): -1z"

// unary `~` is two's complement on every integer type
test bitwiseNot =
  Stdlib.Test.all(
    [ ~0 |> Stdlib.Test.equal(-1)
      ~5 |> Stdlib.Test.equal(-6)
      ~0u8 |> Stdlib.Test.equal(255u8)
      ~0 |> Stdlib.Test.equal(-1)
      ~(-1) |> Stdlib.Test.equal(0)
      ~(2 + 3) |> Stdlib.Test.equal(-6) ])

// bitwise operators are traits like every other operator, so a Float64 says what
// is missing
test floatBitwiseAndRaises =
  1.0 & 2.0
  => raises
    "Float64 has no implementation of Darklang.Stdlib.BitwiseAnd. Write `impl BitwiseAnd for Float64 = ...`, or run `dark impls BitwiseAnd` to see which types do"

test floatShiftLeftRaises =
  1.0 << 2.0
  => raises
    "Float64 has no implementation of Darklang.Stdlib.ShiftLeft. Write `impl ShiftLeft for Float64 = ...`, or run `dark impls ShiftLeft` to see which types do"

test floatBitwiseNotRaises =
  ~1.0
  => raises
    "Float64 has no implementation of Darklang.Stdlib.BitwiseNot. Write `impl BitwiseNot for Float64 = ...`, or run `dark impls BitwiseNot` to see which types do"

// mixed widths are a type error, exactly as for the arithmetic operators
test mixedBitwiseWidthsRaises =
  1 & 2s8 => raises "Cannot perform numeric operation on Int64 and Int8"

test mixedShiftWidthsRaises =
  1 << 2z => raises "Cannot perform numeric operation on Int64 and BigInt"

// precedence: bitwise binds TIGHTER than the comparisons (Python's order, not
// C's), and looser than the arithmetic operators
test bitwisePrecedence =
  Stdlib.Test.all(
    [ (12 & 10) == 8 |> Stdlib.Test.equal(true)
      12 & 10 == 8 |> Stdlib.Test.equal(true)
      (1 | 6) ^ (1 & 6) |> Stdlib.Test.equal(7)
      1 | 6 ^ 1 & 6 |> Stdlib.Test.equal(7)
      1 << 1 + 1 |> Stdlib.Test.equal(4)
      12 | 4 & 5 |> Stdlib.Test.equal(12)
      ~0 & 255 |> Stdlib.Test.equal(255) ])

// left-associative, unlike `**`
test associativity =
  Stdlib.Test.all(
    [ 8 >> 1 >> 1 |> Stdlib.Test.equal(2)
      2 ** 3 ** 2 |> Stdlib.Test.equal(512) ])

// operator sections
test sections =
  Stdlib.Test.all(
    [ 12 |> (fun v -> v & 10) |> Stdlib.Test.equal(8)
      12 |> (fun v -> v | 10) |> Stdlib.Test.equal(14)
      2 |> (fun v -> v ** 10) |> Stdlib.Test.equal(1024) ])

// ---------------------------------------------------------------------------
// unary `!` is boolean not
// ---------------------------------------------------------------------------
test booleanNot =
  Stdlib.Test.all(
    [ !true |> Stdlib.Test.equal(false)
      !false |> Stdlib.Test.equal(true)
      !(Stdlib.Bool.and(true, false)) |> Stdlib.Test.equal(true)
      // binds tighter than any infix operator, looser than application
      !true && true |> Stdlib.Test.equal(false)
      !true == false |> Stdlib.Test.equal(true)
      1 & 2 |> Stdlib.Test.equal(0) ])

// ---------------------------------------------------------------------------
// `|` vs the match-arm separator: inside a match, the ARM wins
// ---------------------------------------------------------------------------
test barInMatch =
  Stdlib.Test.all(
    [ (match 14 with
       | 14 -> "matched"
       | _ -> "no")
      |> Stdlib.Test.equal("matched")
      // single-line arms still parse
      (match 2 with | 1 -> "a" | 2 -> "b" | _ -> "c") |> Stdlib.Test.equal("b")
      // or-patterns still parse
      (match 3 with | 1 | 3 -> "a" | _ -> "b") |> Stdlib.Test.equal("a")
      // the SUBJECT is outside the arms, so `|` there is the operator
      (match 12 | 10 with | 14 -> "or-ed" | _ -> "no")
      |> Stdlib.Test.equal("or-ed")
      // in an arm body, parens (or any bracket) make it the operator again
      (match 1 with | 1 -> (12 | 3) | _ -> 0) |> Stdlib.Test.equal(15)
      (match 1 with | 1 -> [ 12 | 3 ] | _ -> []) |> Stdlib.Test.equal([ 15 ])
      // an arm body on its own row, indented past the arm column, needs no
      // parens
      (match 1 with
       | 1 ->
         let z = 12 | 3
         z
       | _ -> 0)
      |> Stdlib.Test.equal(15) ])
