module Darklang.Language.Tests.ErrorPropagation

module Error =
  test map2WrongArgRaises =
    (Stdlib.Option.map2
      (Stdlib.Option.Option.Some 10L)
      "not an option"
      (fun (a, b) -> "1"))
    => raises
      "Darklang.Stdlib.Option.map2's 2nd parameter `option2` expects Darklang.Stdlib.Option.Option<_>, but got String (\"not an option\")"


// Check we get previous errors before later ones
test earlierErrorFirst =
  (Stdlib.List.map [ 1L, 2L, 3L, 4L, 5L ] (fun x ->
    Stdlib.Test.raiseRuntimeError "X"))
  |> Stdlib.List.fakeFunction
  => raises "Uncaught exception: X"

module ErrorPropagation =
  test fnArg =
    Stdlib.List.head (Stdlib.Test.raiseRuntimeError "test")
    => raises "Uncaught exception: test"

  test ifCondition =
    (if Stdlib.Test.raiseRuntimeError "test" then 5L else 6L)
    => raises "Uncaught exception: test"

  test fieldAccessTarget =
    (Stdlib.List.head (Stdlib.Test.raiseRuntimeError "test")).field
    => raises "Uncaught exception: test"

  test listElementCall =
    [ 5L, 6L, Stdlib.List.head (Stdlib.Test.raiseRuntimeError "test") ]
    => raises "Uncaught exception: test"

  test listElement =
    [ 5L, 6L, Stdlib.Test.raiseRuntimeError "test" ]
    => raises "Uncaught exception: test"

  test pipeStageThenMore =
    5L |> (+) (Stdlib.Test.raiseRuntimeError "test") |> (+) 3564L
    => raises "Uncaught exception: test"

  test pipeStage =
    5L |> (+) (Stdlib.Test.raiseRuntimeError "test")
    => raises "Uncaught exception: test"

  test pipeIntoRaise =
    ("test" |> Stdlib.Test.raiseRuntimeError)
    => raises "Uncaught exception: test"

  test someArg =
    Stdlib.Option.Option.Some(Stdlib.Test.raiseRuntimeError "test")
    => raises "Uncaught exception: test"

  test errorArg =
    Stdlib.Result.Result.Error(Stdlib.Test.raiseRuntimeError "test")
    => raises "Uncaught exception: test"

  test okArg =
    Stdlib.Result.Result.Ok(Stdlib.Test.raiseRuntimeError "test")
    => raises "Uncaught exception: test"

  // pipe into error
  test pipeIntoRaiseThenMore =
    ("test" |> Stdlib.Test.raiseRuntimeError |> (+) "3")
    => raises "Uncaught exception: test"

  type EPRec =
    { i: Int64
      m: Int64
      j: Int64
      n: Int64 }

  test recordFirstFieldErrorFirst =
    EPRec
      { i = Stdlib.Test.raiseRuntimeError "1"
        m = 5L
        j = Stdlib.List.head (Stdlib.Test.raiseRuntimeError "2")
        n = 6L }
    => raises "Uncaught exception: 1"

  // An operand's error propagates through +.
  test stringAddOperand =
    "msg" + (1L / 0L) => raises "Cannot divide by 0"

test fieldAccessOnRaise =
  (Stdlib.Test.raiseRuntimeError "error").fieldName
  => raises "Uncaught exception: error"
