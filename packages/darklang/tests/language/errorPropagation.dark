module Darklang.Language.Tests.ErrorPropagation

module Error =
  test map2WrongArgRaises =
    Stdlib.Option.map2(Some(10), "not an option", fun((a, b)) -> "1")
    => raises "Darklang.Stdlib.Option.map2's 2nd parameter `option2` expects Darklang.Stdlib.Option.Option<_>, but got String (\"not an option\")"


// Check we get previous errors before later ones
test earlierErrorFirst =
  Stdlib.List.map([ 1, 2, 3, 4, 5 ], fun x ->
    Language.Tests.raiseRuntimeError("X"))
  |> Stdlib.List.fakeFunction
  => raises "Uncaught exception: X"


module ErrorPropagation =
  test fnArg =
    Stdlib.List.head(Language.Tests.raiseRuntimeError("test"))
    => raises "Uncaught exception: test"


  test ifCondition =
    if Language.Tests.raiseRuntimeError("test") then 5 else 6
    => raises "Uncaught exception: test"


  test fieldAccessTarget =
    (Stdlib.List.head(Language.Tests.raiseRuntimeError("test"))).field
    => raises "Uncaught exception: test"


  test listElementCall =
    [ 5, 6, Stdlib.List.head(Language.Tests.raiseRuntimeError("test")) ]
    => raises "Uncaught exception: test"


  test listElement =
    [ 5, 6, Language.Tests.raiseRuntimeError("test") ]
    => raises "Uncaught exception: test"


  test pipeStageThenMore =
    5
    |> (fun v -> v + Language.Tests.raiseRuntimeError("test"))
    |> (fun v -> v + 3564)
    => raises "Uncaught exception: test"


  test pipeStage =
    5 |> (fun v -> v + Language.Tests.raiseRuntimeError("test"))
    => raises "Uncaught exception: test"


  test pipeIntoRaise =
    "test" |> Language.Tests.raiseRuntimeError
    => raises "Uncaught exception: test"


  test someArg =
    Some(Language.Tests.raiseRuntimeError("test"))
    => raises "Uncaught exception: test"


  test errorArg =
    Error(Language.Tests.raiseRuntimeError("test"))
    => raises "Uncaught exception: test"


  test okArg =
    Ok(Language.Tests.raiseRuntimeError("test"))
    => raises "Uncaught exception: test"


  // pipe into error
  test pipeIntoRaiseThenMore =
    "test"
    |> Language.Tests.raiseRuntimeError
    |> (fun v -> v + "3")
    => raises "Uncaught exception: test"


  type EPRec =
    { i: Int64
      m: Int64
      j: Int64
      n: Int64 }


  test recordFirstFieldErrorFirst =
    EPRec
      { i = Language.Tests.raiseRuntimeError("1")
        m = 5
        j = Stdlib.List.head(Language.Tests.raiseRuntimeError("2"))
        n = 6 }
    => raises "Uncaught exception: 1"


  // An operand's error propagates through +.
  test stringAddOperand =
    "msg" + 1 / 0
    => raises "Cannot divide by 0"


test fieldAccessOnRaise =
  (Language.Tests.raiseRuntimeError("error")).fieldName
  => raises "Uncaught exception: error"
