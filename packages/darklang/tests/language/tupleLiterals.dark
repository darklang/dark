module Darklang.Language.Tests.TupleLiterals

test construction =
  Stdlib.Test.all(
    [ (1, 2) |> Stdlib.Test.equal((1, 2))
      (1, 2, 3) |> Stdlib.Test.equal((1, 2, 3))
      (1, 2 + 3, 4) |> Stdlib.Test.equal((1, 5, 4))
      // note: there is no upper limit set on Tuple size
      (1, 2, 3, 4, 5, 6, 7, 8, 9)
      |> Stdlib.Test.equal((1, 2, 3, 4, 5, 6, 7, 8, 9)) ])

test elementErrorRaises =
  (1, Stdlib.Test.raiseRuntimeError("test"), 3)
  => raises "Uncaught exception: test"

test firstElementErrorRaises =
  (1,
   Stdlib.Test.raiseRuntimeError("error1"),
   Stdlib.Test.raiseRuntimeError("error2"))
  => raises "Uncaught exception: error1"

// Tuple indices start at 1.
test elementAccess =
  Stdlib.Test.all(
    [ (1, "two").1 |> Stdlib.Test.equal(1)
      (1, "two").2 |> Stdlib.Test.equal("two")
      (1, 2, 3, 4).4 |> Stdlib.Test.equal(4)
      (let t = (true, 'c', 3) in t.3) |> Stdlib.Test.equal(3)
      (let t = ((1, 2), 3) in t.1.2) |> Stdlib.Test.equal(2)
      (let t = ((1, (2, 3)), 4) in t.1.2.1) |> Stdlib.Test.equal(2)
      (let t = (1, 2) in t.1 + t.2) |> Stdlib.Test.equal(3)
      (let t = (1, 2) in (t.1 + t.2)) |> Stdlib.Test.equal(3)
      (1, 2) .1 |> Stdlib.Test.equal(1)
      (let t = (1, (2, 3)) in t.2.2 |> (fun v -> v + 10)) |> Stdlib.Test.equal(13)
      (let t = (1, 2) in $"{Stdlib.toString(t.1)}-{Stdlib.toString(t.2)}")
      |> Stdlib.Test.equal("1-2")
      (Stdlib.List.map([ (1, "a"), (2, "b") ], fun p -> p.2))
      |> Stdlib.Test.equal([ "a", "b" ])
      (let first = fun t -> t.1 in (first((1, "a")), first(("b", 2, true))))
      |> Stdlib.Test.equal((1, "b")) ])

test indexPastEndRaises =
  (let t = (1, 2) in t.3)
  => raises
    "Tried to access element .3 of a tuple with 2 elements; tuple elements are numbered from .1"

test indexZeroRaises =
  (let t = (1, 2) in t.0)
  => raises
    "Tried to access element .0 of a tuple with 2 elements; tuple elements are numbered from .1"

test namedFieldRaises =
  (let t = (1, 2) in t.name)
  => raises
    "Tried to access element .name of a tuple with 2 elements; tuple elements are numbered from .1"

test accessOnInt64Raises =
  (let x = 6 in x.1)
  => raises
    "Attempting to perform field access of an Int64, but this only works with records and tuples"

test leadingZeroIndexRaises =
  (let t = (1, 2) in t.01)
  => raises
    "Tried to access element .01 of a tuple with 2 elements; tuple elements are numbered from .1"

test hugeIndexRaises =
  (let t = (1, 2) in t.9223372036854775807)
  => raises
    "Tried to access element .9223372036854775807 of a tuple with 2 elements; tuple elements are numbered from .1"

test emptyFieldNameRaises =
  (let t = (1, 2) in t.___) => raises "Field name is empty"

// Resolve the package value before accessing its elements.
module TupleVal =
  val pair = (1, ("a", true))

  test packageValueElements =
    Stdlib.Test.all(
      [ pair.1 |> Stdlib.Test.equal(1)
        pair.2.1 |> Stdlib.Test.equal("a")
        TupleVal.pair.2.2 |> Stdlib.Test.equal(true)
        (let pair = (9, 8) in pair.1) |> Stdlib.Test.equal(9) ])
