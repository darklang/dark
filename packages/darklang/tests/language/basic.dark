module Darklang.Language.Tests.Basic

test floats =
  Stdlib.Test.all(
    [ (-0.0 * -1.0) |> Stdlib.Test.equal(0.0)
      (6.02e22 * -10.0) |> Stdlib.Test.equal(-6.02e23) ])

test letBoundVariable =
  (let x = 5
   x)
  |> Stdlib.Test.equal(5)

test missingVariableRaises =
  myvar => raises "There is no variable named: myvar"

// Every expression but the last in a sequence must be Unit.
test unitStatementsRunInSequence =
  (()
   ()
   true)
  |> Stdlib.Test.equal(true)

test nonUnitStatementRaises =
  (1
   true)
  => raises "A statement before the last must return Unit, but this one returned Int64 (1). Discard a value with `let _ = ...`"

test and =
  Stdlib.Test.all(
    [ (true && true) |> Stdlib.Test.equal(true)
      (true && false) |> Stdlib.Test.equal(false)
      (false && true) |> Stdlib.Test.equal(false)
      (false && false) |> Stdlib.Test.equal(false)
      (false && 5) |> Stdlib.Test.equal(false)
      (true |> (fun v -> v && true)) |> Stdlib.Test.equal(true)
      (true |> (fun v -> v && false)) |> Stdlib.Test.equal(false)
      (false |> (fun v -> v && true)) |> Stdlib.Test.equal(false)
      (false |> (fun v -> v && false)) |> Stdlib.Test.equal(false) ])

test andShortCircuits =
  (false && Stdlib.Test.raiseRuntimeError("msg")) |> Stdlib.Test.equal(false)

test andSkipsDivideByZero =
  (false && ((1 / 0) == 1)) |> Stdlib.Test.equal(false)

test andShortCircuitsNested =
  (false && (true && Stdlib.Test.raiseRuntimeError("msg")))
  |> Stdlib.Test.equal(false)

test andEvaluatesRightOperand =
  (true && Stdlib.Test.raiseRuntimeError("msg"))
  => raises "Uncaught exception: msg"

test andRejectsNonBooleanRight =
  (true && 5) => raises "&& only supports Booleans"

test andRaisesLeftOperandErrorFirst =
  (Stdlib.Test.raiseRuntimeError("msg1") && Stdlib.Test.raiseRuntimeError("msg2"))
  => raises "Uncaught exception: msg1"

test andRejectsNonBooleanLeft =
  (5 && true) => raises "&& only supports Booleans"

test or =
  Stdlib.Test.all(
    [ (true || true) |> Stdlib.Test.equal(true)
      (true || false) |> Stdlib.Test.equal(true)
      (false || true) |> Stdlib.Test.equal(true)
      (false || false) |> Stdlib.Test.equal(false)
      (true || 5) |> Stdlib.Test.equal(true)
      (true |> (fun v -> v || true)) |> Stdlib.Test.equal(true)
      (true |> (fun v -> v || false)) |> Stdlib.Test.equal(true)
      (false |> (fun v -> v || true)) |> Stdlib.Test.equal(true)
      (false |> (fun v -> v || false)) |> Stdlib.Test.equal(false) ])

test orRejectsNonBooleanRight =
  (false || 5) => raises "|| only supports Booleans"

test orRejectsNonBooleanLeft =
  (5 || true) => raises "|| only supports Booleans"

test orShortCircuits =
  (true || Stdlib.Test.raiseRuntimeError("msg")) |> Stdlib.Test.equal(true)

test orSkipsDivideByZero =
  (true || ((1 / 0) == 1)) |> Stdlib.Test.equal(true)

test orShortCircuitsNested =
  (true || (false || Stdlib.Test.raiseRuntimeError("msg")))
  |> Stdlib.Test.equal(true)

test orEvaluatesRightOperand =
  (false || Stdlib.Test.raiseRuntimeError("msg"))
  => raises "Uncaught exception: msg"

test orRaisesLeftOperandErrorFirst =
  (Stdlib.Test.raiseRuntimeError("msg1") || Stdlib.Test.raiseRuntimeError("msg2"))
  => raises "Uncaught exception: msg1"

test runtimeErrorRaises =
  Stdlib.Test.raiseRuntimeError("runtime from syntax")
  => raises "Uncaught exception: runtime from syntax"

test mixedNumericEqualityRaises =
  (5.7 != 6) => raises "Cannot perform equality check on Float and Int64"
