// ---- moved from backend/testfiles/execution/language/basic/eand.dark ----
(true && true) = true
(true && false) = false
(false && true) = false
(false && false) = false
(true && Builtin.testRuntimeError "msg") = error="Uncaught exception: msg"
(true && 5L) = error="&& only supports Booleans"
(false && 5L) = false
//TODO bring back short-circuiting
//(false && Builtin.testRuntimeError "msg") = false

(Builtin.testRuntimeError "msg1" && Builtin.testRuntimeError "msg2") = error="Uncaught exception: msg1"
(5 && true) = error="&& only supports Booleans"
(true |> (&&) true) = true
(true |> (&&) false) = false
(false |> (&&) true) = false
(false |> (&&) false) = false
// ---- moved from backend/testfiles/execution/language/basic/eor.dark ----
(true || true) = true
(true || false) = true
(false || true) = true
(false || false) = false

(true || 5L) = true
(false || 5L) = error="|| only supports Booleans"
(5L || true) = error="|| only supports Booleans"
(true |> (||) true) = true
(true |> (||) false) = true
(false |> (||) true) = true
(false |> (||) false) = false

// TODO bring back short-circuiting
//(true || Builtin.testRuntimeError "msg") = true
(false || Builtin.testRuntimeError "msg") = error="Uncaught exception: msg"
(Builtin.testRuntimeError "msg1" || Builtin.testRuntimeError "msg2") = error="Uncaught exception: msg1"