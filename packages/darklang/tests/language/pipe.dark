/// Pipe cases from `backend/testfiles/execution/language/flow-control/epipe.dark`.
module Darklang.Language.Tests.Pipe

// function
let userFn () : Int64 = 6L

test functions =
  Stdlib.Test.all
    [ (() |> userFn) |> Stdlib.Test.equal 6L
      ([] |> Stdlib.List.push 2L) |> Stdlib.Test.equal [ 2L ]
      // nested function
      ([] |> Stdlib.List.push (1L + (1L + 3L))) |> Stdlib.Test.equal [ 5L ]
      ([] |> Stdlib.List.push (1L + ((+) 1L 3L))) |> Stdlib.Test.equal [ 5L ] ]

// Differs from legacy: this raises with `Stdlib.Test.raiseRuntimeError`; legacy
// used the backend-only `Builtin.testRuntimeError`.
test argErrorRaises =
  ([] |> Stdlib.List.push (Stdlib.Test.raiseRuntimeError "err"))
  => raises "Uncaught exception: err"

// general
test general =
  Stdlib.Test.all
    [ (4L |> (-) 3L) |> Stdlib.Test.equal 1L
      ([ 5L ]
       |> Stdlib.List.head
       |> Builtin.unwrap
       |> (+) 1L
       |> (+) 3L
       |> (fun x -> if (x + 4L) > 1L then x else (1L + x)))
      |> Stdlib.Test.equal 9L
      // lambda in variable
      (let x = fun a -> a + 1L in (5L |> x |> x |> (+) 3L))
      |> Stdlib.Test.equal 10L
      // CLEANUP this is OK now.
      (let partial = (let x = fun a b -> a + 1L in (7L |> x))
       (partial 999L))
      |> Stdlib.Test.equal 8L ]

// only lambda might be placed into the variable used in the middle of the pipe
test nonFunctionStageRaises =
  (let x = 1L in (5L |> x |> (+) 3L))
  => raises
    "Expected something we could apply to, such as a lambda or function, but got an Int64 (1)"

// dict
type Z = { a: List<Int64> }
type Y = { z: Z }
type X = { y: Y }

test recordFields =
  (let x = X { y = Y { z = Z { a = [ 1L, 2L, 3L, 4L, 5L ] } } }
   (x.y.z.a |> Stdlib.List.length))
  |> Stdlib.Test.equal 5

type MyEnum = A of Int64 * Int64 * Int64

test constructorsAndOptions =
  Stdlib.Test.all
    [ (33L |> MyEnum.A 21L 42L) |> Stdlib.Test.equal (MyEnum.A 33L 21L 42L)
      (33L |> MyEnum.A(21L, 42L)) |> Stdlib.Test.equal (MyEnum.A(33L, 21L, 42L))
      (3L |> Stdlib.Result.Result.Ok)
      |> Stdlib.Test.equal (Stdlib.Result.Result.Ok 3L)
      (4L |> (+) 3L |> Stdlib.Option.Option.Some)
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some 7L)
      (Stdlib.Option.Option.None |> Stdlib.Option.Option.Some)
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some Stdlib.Option.Option.None)
      (let x = Stdlib.Option.Option.Some 3L

       x |> Stdlib.Option.map (fun a -> a) |> Stdlib.Option.map (fun a -> a + 1L))
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some 4L)
      (let x = fun x -> Stdlib.Option.map x (fun a -> a)
       (Stdlib.Option.Option.Some 3L) |> x |> Stdlib.Option.map (fun a -> a + 1L))
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some 4L)
      ((Stdlib.Option.Option.Some 3L)
       |> Stdlib.Option.withDefault 0L
       |> (+) 3L)
      |> Stdlib.Test.equal 6L
      ((Stdlib.Result.Result.Ok 3L) |> Stdlib.Result.withDefault 0L |> (+) 3L)
      |> Stdlib.Test.equal 6L
      ((Stdlib.Result.Result.Error "err")
       |> Stdlib.Result.withDefault 0L
       |> (+) 3L)
      |> Stdlib.Test.equal 3L
      (let x = fun a -> Stdlib.Result.withDefault a 1L
       (Stdlib.Result.Result.Error "err") |> x |> (+) 3L)
      |> Stdlib.Test.equal 4L
      (let x =
        fun x ->
          Stdlib.Option.andThen (Stdlib.Option.Option.Some x) (fun x ->
            Stdlib.Option.Option.Some(1L + x))

       3L |> x)
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some 4L)
      (let x =
        fun x -> Stdlib.Option.andThen x (fun x -> Stdlib.Option.Option.Some(1L + x))

       3L |> Stdlib.Option.Option.Some |> x)
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some 4L)
      (3L |> Stdlib.Option.Option.Some |> Stdlib.Result.fromOption "test")
      |> Stdlib.Test.equal (Stdlib.Result.Result.Ok 3L)
      (Stdlib.Option.Option.None |> Stdlib.Result.fromOption "test")
      |> Stdlib.Test.equal (Stdlib.Result.Result.Error "test") ]

module FnName =
  test pipeIntoBoundFn =
    Stdlib.Test.all
      [ (let fn = (fun x -> x + 1L)
         6L |> fn)
        |> Stdlib.Test.equal 7L
        (let fn = (+)
         3L |> fn 4L)
        |> Stdlib.Test.equal 7L
        (let fn = (-)
         11L |> fn 4L)
        |> Stdlib.Test.equal 7L
        (let fn = (fun a b -> Stdlib.max a b)
         3L |> fn 7L)
        |> Stdlib.Test.equal 7L ]
