module Darklang.Language.Tests.Pipe

// function
let userFn(): Int64 = 6

test functions =
  Stdlib.Test.all(
    [ (() |> userFn) |> Stdlib.Test.equal(6)
      ([] |> Stdlib.List.prepend(2)) |> Stdlib.Test.equal([ 2 ])
      // nested function
      ([] |> Stdlib.List.prepend(1 + (1 + 3))) |> Stdlib.Test.equal([ 5 ])
      ([] |> Stdlib.List.prepend(1 + ((+)(1, 3)))) |> Stdlib.Test.equal([ 5 ]) ])

test argErrorRaises =
  ([] |> Stdlib.List.prepend(Stdlib.Test.raiseRuntimeError("err")))
  => raises "Uncaught exception: err"

// general
test general =
  Stdlib.Test.all(
    [ (4 |> (fun v -> v - 3)) |> Stdlib.Test.equal(1)
      ([ 5 ]
       |> Stdlib.List.head
       |> Builtin.unwrap
       |> (fun v -> v + 1)
       |> (fun v -> v + 3)
       |> (fun x -> if (x + 4) > 1 then x else (1 + x)))
      |> Stdlib.Test.equal(9)
      // lambda in variable
      (let x = fun a -> a + 1 in (5 |> x |> x |> (fun v -> v + 3)))
      |> Stdlib.Test.equal(10) ])

// A pipe gives a lambda one argument, so a two-parameter lambda stops short.
test pipeIntoTwoParameterLambdaRaises =
  (let x = fun(a, b) -> a + 1 in (7 |> x))
  => raises "Lambda expects 2 arguments, but got 1 argument"

// only lambda might be placed into the variable used in the middle of the pipe
test nonFunctionStageRaises =
  (let x = 1 in (5 |> x |> (fun v -> v + 3)))
  => raises
    "Expected something we could apply to, such as a lambda or function, but got an Int64 (1)"

// dict
type Z = { a: List<Int64> }
type Y = { z: Z }
type X = { y: Y }

test recordFields =
  (let x = X { y = Y { z = Z { a = [ 1, 2, 3, 4, 5 ] } } }
   (x.y.z.a |> Stdlib.List.length))
  |> Stdlib.Test.equal(5)

type MyEnum = A(Int64, Int64, Int64)

test constructorsAndOptions =
  Stdlib.Test.all(
    [ (33 |> MyEnum.A(21, 42)) |> Stdlib.Test.equal(MyEnum.A(33, 21, 42))
      (33 |> MyEnum.A(21, 42)) |> Stdlib.Test.equal(MyEnum.A(33, 21, 42))
      (3 |> Stdlib.Result.Result.Ok)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))
      (4 |> (fun v -> v + 3) |> Stdlib.Option.Option.Some)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(7))
      (Stdlib.Option.Option.None |> Stdlib.Option.Option.Some)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(Stdlib.Option.Option.None))
      (let x = Stdlib.Option.Option.Some(3)

       x |> Stdlib.Option.map(fun a -> a) |> Stdlib.Option.map(fun a -> a + 1))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4))
      (let x = fun x -> Stdlib.Option.map(x, fun a -> a)
       (Stdlib.Option.Option.Some(3)) |> x |> Stdlib.Option.map(fun a -> a + 1))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4))
      ((Stdlib.Option.Option.Some(3))
       |> Stdlib.Option.withDefault(0)
       |> (fun v -> v + 3))
      |> Stdlib.Test.equal(6)
      ((Stdlib.Result.Result.Ok(3)) |> Stdlib.Result.withDefault(0) |> (fun v -> v + 3))
      |> Stdlib.Test.equal(6)
      ((Stdlib.Result.Result.Error("err"))
       |> Stdlib.Result.withDefault(0)
       |> (fun v -> v + 3))
      |> Stdlib.Test.equal(3)
      (let x = fun a -> Stdlib.Result.withDefault(a, 1)
       (Stdlib.Result.Result.Error("err")) |> x |> (fun v -> v + 3))
      |> Stdlib.Test.equal(4)
      (let x =
        fun x ->
          Stdlib.Option.andThen(Stdlib.Option.Option.Some(x), fun x ->
            Stdlib.Option.Option.Some(1 + x))

       3 |> x)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4))
      (let x =
        fun x -> Stdlib.Option.andThen(x, fun x -> Stdlib.Option.Option.Some(1 + x))

       3 |> Stdlib.Option.Option.Some |> x)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4))
      (3 |> Stdlib.Option.Option.Some |> Stdlib.Result.fromOption("test"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))
      (Stdlib.Option.Option.None |> Stdlib.Result.fromOption("test"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test")) ])

module FnName =
  test pipeIntoBoundFn =
    Stdlib.Test.all(
      [ (let fn = (fun x -> x + 1)
         6 |> fn)
        |> Stdlib.Test.equal(7)
        (let fn = (+)
         3 |> fn(4))
        |> Stdlib.Test.equal(7)
        (let fn = (-)
         11 |> fn(4))
        |> Stdlib.Test.equal(7)
        (let fn = (fun(a, b) -> Stdlib.max(a, b))
         3 |> fn(7))
        |> Stdlib.Test.equal(7) ])
