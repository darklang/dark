// Definition list tags
test definitionListTags =
  Stdlib.Test.all
    [ (Stdlib.Html.dl [] []) |> nodeToString |> Stdlib.Test.equal "<dl></dl>"
      (Stdlib.Html.dt [] []) |> nodeToString |> Stdlib.Test.equal "<dt></dt>"
      (Stdlib.Html.dd [] []) |> nodeToString |> Stdlib.Test.equal "<dd></dd>" ]

