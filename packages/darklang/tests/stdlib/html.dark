/// Cases ported from `backend/testfiles/execution/stdlib/html.dark`.
module Darklang.Stdlib.Html.Tests

// aliases and helpers
type HtmlTag = Stdlib.Html.HtmlTag
type Node = Stdlib.Html.Node

let nodeToString (node: Node) : String = Stdlib.Html.nodeToString node

let stringNode (str: String) : Node = Stdlib.Html.stringNode str

let htmlTag
  (n: String)
  (a: List<String * Stdlib.Option.Option<String>>)
  (c: List<Node>)
  : Node =
  Stdlib.Html.htmlTagNode n a c


let tidyHtml (html: String) : String =
  html
  |> Stdlib.String.split "\n"
  |> Stdlib.List.map (fun line -> Stdlib.String.trim line)
  |> Stdlib.String.join ""

// -- basic testing of low-level fns
test htmlTagNode =
  Stdlib.Test.all
    [ (htmlTag "div" [] []) |> nodeToString |> Stdlib.Test.equal "<div></div>"
      (htmlTag "div" [] [ stringNode "yolo" ]) |> nodeToString
      |> Stdlib.Test.equal "<div>yolo</div>"
      (htmlTag "div" [ ("id", (Some "my-div")) ] [ stringNode "yolo" ])
      |> nodeToString
      |> Stdlib.Test.equal "<div id=\"my-div\">yolo</div>"
      (htmlTag "div" [] [ htmlTag "button" [] [ stringNode "click me" ] ])
      |> nodeToString
      |> Stdlib.Test.equal "<div><button>click me</button></div>" ]

// -- testing of simple html node helpers
test comment =
  Stdlib.Test.all
    [ (Stdlib.Html.comment "hello") |> nodeToString
      |> Stdlib.Test.equal "<!-- hello -->"
      // `--` is the only sequence that can end a comment, and the grammar gives no
      // way to escape it, so content carrying one is rewritten. Without this,
      // everything after `-->` lands on the page as markup rather than staying
      // inside the comment.
      (Stdlib.Html.comment "a --> b") |> nodeToString
      |> Stdlib.Test.equal "<!-- a - -> b -->"
      (Stdlib.Html.comment "<script>alert(1)</script> -- and more")
      |> nodeToString
      |> Stdlib.Test.equal "<!-- <script>alert(1)</script> - - and more -->" ]

// -- testing HTML escaping
test escapeHtml =
  Stdlib.Test.all
    [ Stdlib.Html.escapeHtml "<script>alert('xss')</script>"
      |> Stdlib.Test.equal "&lt;script&gt;alert(&#x27;xss&#x27;)&lt;/script&gt;"
      Stdlib.Html.escapeHtml "a & b" |> Stdlib.Test.equal "a &amp; b"
      Stdlib.Html.escapeHtml "\"quoted\"" |> Stdlib.Test.equal "&quot;quoted&quot;" ]

// text() should escape HTML
test textEscapes =
  (Stdlib.Html.text "<script>bad</script>")
  |> nodeToString |> Stdlib.Test.equal "&lt;script&gt;bad&lt;/script&gt;"

// stringNode() should NOT escape HTML (for trusted content)
test stringNodeDoesNotEscape =
  (Stdlib.Html.stringNode "<script>trusted</script>")
  |> nodeToString |> Stdlib.Test.equal "<script>trusted</script>"

// -- attribute values are escaped, like text is
//
// The quote is the one that matters: an unescaped `"` closes the attribute, and
// everything after it is parsed as markup rather than as part of the value.
test attributeValuesAreEscaped =
  Stdlib.Test.all
    [ (htmlTag "a" [ ("href", Some "\" onmouseover=\"alert(1)") ] [])
      |> nodeToString
      |> Stdlib.Test.equal "<a href=\"&quot; onmouseover=&quot;alert(1)\"></a>"
      (htmlTag "div" [ ("title", Some "a & b") ] []) |> nodeToString
      |> Stdlib.Test.equal "<div title=\"a &amp; b\"></div>"
      (htmlTag "div" [ ("title", Some "<script>") ] []) |> nodeToString
      |> Stdlib.Test.equal "<div title=\"&lt;script&gt;\"></div>"
      (htmlTag "div" [ ("title", Some "it's") ] []) |> nodeToString
      |> Stdlib.Test.equal "<div title=\"it&#x27;s\"></div>"
      // A boolean attribute has no value to escape. `input` is a void element, so no
      // closing tag.
      (htmlTag "input" [ ("disabled", None) ] []) |> nodeToString
      |> Stdlib.Test.equal "<input disabled>"
      // The attribute helpers feed the same path, so they are covered too.
      (Stdlib.Html.div [ Stdlib.Html.dataAttr "note" "a \"quoted\" one" ] [])
      |> nodeToString
      |> Stdlib.Test.equal "<div data-note=\"a &quot;quoted&quot; one\"></div>" ]

// Using text() with div to prevent XSS
test textInsideElementIsEscaped =
  (Stdlib.Html.div
    []
    [ Stdlib.Html.text "User said: <script>alert('xss')</script>" ])
  |> nodeToString
  |> Stdlib.Test.equal "<div>User said: &lt;script&gt;alert(&#x27;xss&#x27;)&lt;/script&gt;</div>"

// -- testing attribute helpers
test attributeHelpers =
  Stdlib.Test.all
    [ Stdlib.Html.classes [ "btn", "btn-primary" ]
      |> Stdlib.Test.equal ("class", Some "btn btn-primary")
      Stdlib.Html.style [ ("color", "red"), ("font-size", "14px") ]
      |> Stdlib.Test.equal ("style", Some "color: red; font-size: 14px")
      Stdlib.Html.dataAttr "user-id" "123"
      |> Stdlib.Test.equal ("data-user-id", Some "123") ]

// Using attribute helpers with tags
test attributeHelpersOnTags =
  Stdlib.Test.all
    [ (Stdlib.Html.div
        [ Stdlib.Html.classes [ "container", "mx-auto" ]
          Stdlib.Html.dataAttr "testid" "main-container" ]
        [ stringNode "content" ])
      |> nodeToString
      |> Stdlib.Test.equal "<div class=\"container mx-auto\" data-testid=\"main-container\">content</div>"
      (Stdlib.Html.span
        [ Stdlib.Html.style [ ("color", "blue"), ("font-weight", "bold") ] ]
        [ stringNode "styled text" ])
      |> nodeToString
      |> Stdlib.Test.equal "<span style=\"color: blue; font-weight: bold\">styled text</span>" ]

test basicTags =
  Stdlib.Test.all
    [ (Stdlib.Html.br ()) |> nodeToString |> Stdlib.Test.equal "<br>"
      (Stdlib.Html.div [] []) |> nodeToString |> Stdlib.Test.equal "<div></div>"
      (Stdlib.Html.span [] []) |> nodeToString |> Stdlib.Test.equal "<span></span>"
      (Stdlib.Html.h1 [] []) |> nodeToString |> Stdlib.Test.equal "<h1></h1>"
      (Stdlib.Html.h2 [] []) |> nodeToString |> Stdlib.Test.equal "<h2></h2>"
      (Stdlib.Html.h3 [] []) |> nodeToString |> Stdlib.Test.equal "<h3></h3>"
      (Stdlib.Html.h4 [] []) |> nodeToString |> Stdlib.Test.equal "<h4></h4>"
      (Stdlib.Html.h5 [] []) |> nodeToString |> Stdlib.Test.equal "<h5></h5>"
      (Stdlib.Html.h6 [] []) |> nodeToString |> Stdlib.Test.equal "<h6></h6>"
      (Stdlib.Html.p [] []) |> nodeToString |> Stdlib.Test.equal "<p></p>"
      (Stdlib.Html.ul [] []) |> nodeToString |> Stdlib.Test.equal "<ul></ul>"
      (Stdlib.Html.ol [] []) |> nodeToString |> Stdlib.Test.equal "<ol></ol>"
      (Stdlib.Html.li [] []) |> nodeToString |> Stdlib.Test.equal "<li></li>"
      (Stdlib.Html.table [] []) |> nodeToString
      |> Stdlib.Test.equal "<table></table>"
      (Stdlib.Html.tr [] []) |> nodeToString |> Stdlib.Test.equal "<tr></tr>"
      (Stdlib.Html.td [] []) |> nodeToString |> Stdlib.Test.equal "<td></td>"
      (Stdlib.Html.th [] []) |> nodeToString |> Stdlib.Test.equal "<th></th>"
      (Stdlib.Html.tbody [] []) |> nodeToString
      |> Stdlib.Test.equal "<tbody></tbody>"
      (Stdlib.Html.thead [] []) |> nodeToString
      |> Stdlib.Test.equal "<thead></thead>"
      (Stdlib.Html.tfoot [] []) |> nodeToString
      |> Stdlib.Test.equal "<tfoot></tfoot>"
      (Stdlib.Html.caption [] []) |> nodeToString
      |> Stdlib.Test.equal "<caption></caption>"
      (Stdlib.Html.colgroup [] []) |> nodeToString
      |> Stdlib.Test.equal "<colgroup></colgroup>"
      (Stdlib.Html.col [] []) |> nodeToString |> Stdlib.Test.equal "<col>"
      (Stdlib.Html.img []) |> nodeToString |> Stdlib.Test.equal "<img>"
      (Stdlib.Html.img [ ("src", Some "foo.png") ]) |> nodeToString
      |> Stdlib.Test.equal "<img src=\"foo.png\">"
      (Stdlib.Html.svg [] []) |> nodeToString |> Stdlib.Test.equal "<svg></svg>"
      (Stdlib.Html.path []) |> nodeToString |> Stdlib.Test.equal "<path></path>"
      (Stdlib.Html.i [] []) |> nodeToString |> Stdlib.Test.equal "<i></i>"
      (Stdlib.Html.meta [ ("charset", Some "UTF-8") ])
      |> nodeToString |> Stdlib.Test.equal "<meta charset=\"UTF-8\">"
      (Stdlib.Html.link
        [ ("rel", Some "stylesheet")
          ("href", Some "./style.css") ])
      |> nodeToString
      |> Stdlib.Test.equal "<link rel=\"stylesheet\" href=\"./style.css\">"
      (Stdlib.Html.script
        [ ("src", Some "https://cdn.tailwindcss.com") ]
        [])
      |> nodeToString
      |> Stdlib.Test.equal "<script src=\"https://cdn.tailwindcss.com\"></script>"
      (Stdlib.Html.form [ ("id", Some "my-form") ] [])
      |> nodeToString |> Stdlib.Test.equal "<form id=\"my-form\"></form>"
      (Stdlib.Html.input
        [ ("type", Some "text")
          ("name", Some "name")
          ("id", Some "name") ])
      |> nodeToString
      |> Stdlib.Test.equal "<input type=\"text\" name=\"name\" id=\"name\">"
      (Stdlib.Html.label
        [ ("for", Some "name") ]
        [ stringNode "Name" ])
      |> nodeToString |> Stdlib.Test.equal "<label for=\"name\">Name</label>"
      (Stdlib.Html.section [] []) |> nodeToString
      |> Stdlib.Test.equal "<section></section>" ]

