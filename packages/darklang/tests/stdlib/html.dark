    [ (Stdlib.Html.code [] []) |> nodeToString |> Stdlib.Test.equal "<code></code>"
      (Stdlib.Html.pre [] []) |> nodeToString |> Stdlib.Test.equal "<pre></pre>"
      (Stdlib.Html.nav [] []) |> nodeToString |> Stdlib.Test.equal "<nav></nav>"
      (Stdlib.Html.footer [] []) |> nodeToString
      |> Stdlib.Test.equal "<footer></footer>" ]

