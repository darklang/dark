module Darklang.Stdlib.Int16.Tests

test abs =
  Stdlib.Test.all(
    [ Stdlib.abs(-5s16) |> Stdlib.Test.equal(5s16)
      Stdlib.abs(5s16) |> Stdlib.Test.equal(5s16)
      Stdlib.abs(-32768s16) |> Stdlib.Test.equal(-32768s16) ])

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max =
  Stdlib.max(32767s16, -32768s16) |> Stdlib.Test.equal(32767s16)

test min =
  Stdlib.min(32767s16, -32768s16) |> Stdlib.Test.equal(-32768s16)

test clamp =
  Stdlib.clamp(-100s16, 0s16, -1s16) |> Stdlib.Test.equal(-1s16)

/// Wraps on overflow.
test add =
  Stdlib.Test.all(
    [ (10s16 + 9s16) |> Stdlib.Test.equal(19s16)
      (88s16 + 9s16) |> Stdlib.Test.equal(97s16)
      (-1s16 + 2s16) |> Stdlib.Test.equal(1s16)
      (1s16 + 0s16) |> Stdlib.Test.equal(1s16)
      (-55s16 + 55s16) |> Stdlib.Test.equal(0s16)
      (30000s16 + 2767s16) |> Stdlib.Test.equal(32767s16)
      (-30000s16 + -2768s16) |> Stdlib.Test.equal(-32768s16)
      (-30000s16 + -2769s16) |> Stdlib.Test.equal(32767s16)
      (30000s16 + 2768s16) |> Stdlib.Test.equal(-32768s16) ])

/// Wraps on overflow.
test subtract =
  Stdlib.Test.all(
    [ (10s16 - 9s16) |> Stdlib.Test.equal(1s16)
      (88s16 - 9s16) |> Stdlib.Test.equal(79s16)
      (0s16 - 1s16) |> Stdlib.Test.equal(-1s16)
      (1s16 - 0s16) |> Stdlib.Test.equal(1s16)
      (-55s16 - -55s16) |> Stdlib.Test.equal(0s16)
      (-2769s16 - 30000s16) |> Stdlib.Test.equal(32767s16) ])

/// Wraps on overflow.
test multiply =
  Stdlib.Test.all(
    [ (8s16 * 8s16) |> Stdlib.Test.equal(64s16)
      (1s16 * 0s16) |> Stdlib.Test.equal(0s16)
      (5145s16 * 5145s16) |> Stdlib.Test.equal(-5519s16) ])

/// Wraps on overflow.
test power =
  Stdlib.Test.all(
    [ (2s16 ** 3s16) |> Stdlib.Test.equal(8s16)
      (0s16 ** 1s16) |> Stdlib.Test.equal(0s16)
      (1s16 ** 0s16) |> Stdlib.Test.equal(1s16)
      (0s16 ** 0s16) |> Stdlib.Test.equal(1s16)
      (-2s16 ** 5s16) |> Stdlib.Test.equal(-32s16)
      (-1s16 ** 5s16) |> Stdlib.Test.equal(-1s16)
      (-1s16 ** 6s16) |> Stdlib.Test.equal(1s16)
      (1s16 ** 32767s16) |> Stdlib.Test.equal(1s16)
      (2s16 ** 15s16) |> Stdlib.Test.equal(-32768s16)
      (120s16 ** 20s16) |> Stdlib.Test.equal(0s16) ])

test powerRejectsNegativeExponent =
  (2s16 ** -3s16)
  => raises "Cannot raise integer to a negative exponent"

test powerOfZeroRejectsNegativeExponent =
  (0s16 ** -1s16)
  => raises "Cannot raise integer to a negative exponent"

test powerOfOneRejectsNegativeExponent =
  (1s16 ** -5s16)
  => raises "Cannot raise integer to a negative exponent"

test powerOfMinusOneRejectsNegativeExponent =
  (-1s16 ** -3s16)
  => raises "Cannot raise integer to a negative exponent"

test divide =
  Stdlib.Test.all(
    [ (10s16 / 5s16) |> Stdlib.Test.equal(2s16)
      (17s16 / 3s16) |> Stdlib.Test.equal(5s16)
      (-8s16 / 5s16) |> Stdlib.Test.equal(-1s16)
      (0s16 / 1s16) |> Stdlib.Test.equal(0s16)
      (-32768s16 / -1s16) |> Stdlib.Test.equal(-32768s16)
      (-32768s16 / 1s16) |> Stdlib.Test.equal(-32768s16) ])

test divideOfOneRejectsZero =
  (1s16 / 0s16)
  => raises "Cannot divide by 0"

test negate =
  Stdlib.Test.all(
    [ (--5s16) |> Stdlib.Test.equal(5s16)
      (-(5s16)) |> Stdlib.Test.equal(-5s16)
      (-0s16) |> Stdlib.Test.equal(0s16)
      (--0s16) |> Stdlib.Test.equal(0s16)
      (--32768s16) |> Stdlib.Test.equal(-32768s16) ])

/// A Result: the sign follows the dividend, and it is an Error only when the
/// divisor is 0.
test remainder =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedRemainder(15s16, 6s16) |> Stdlib.Test.equal(Ok(3s16))
      Stdlib.Int16.checkedRemainder(-20s16, 8s16) |> Stdlib.Test.equal(Ok(-4s16))
      Stdlib.Int16.checkedRemainder(-20s16, -8s16) |> Stdlib.Test.equal(Ok(-4s16))
      Stdlib.Int16.checkedRemainder(-32768s16, -1s16) |> Stdlib.Test.equal(Ok(0s16))
      Stdlib.Int16.checkedRemainder(5s16, 0s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero)) ])

test greaterThan =
  Stdlib.Test.all(
    [ (20s16 > 1s16) |> Stdlib.Test.equal(true)
      (20s16 > 130s16) |> Stdlib.Test.equal(false) ])

test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ (0s16 >= 1s16) |> Stdlib.Test.equal(false)
      (1s16 >= 0s16) |> Stdlib.Test.equal(true)
      (6s16 >= 1s16) |> Stdlib.Test.equal(true)
      (6s16 >= 8s16) |> Stdlib.Test.equal(false)
      (-5s16 >= -20s16) |> Stdlib.Test.equal(true)
      (-20s16 >= -1s16) |> Stdlib.Test.equal(false)
      (-20s16 >= -20s16) |> Stdlib.Test.equal(true)
      (-130s16 >= -20s16) |> Stdlib.Test.equal(false) ])

test lessThan =
  Stdlib.Test.all(
    [ (6s16 < 8s16) |> Stdlib.Test.equal(true)
      (10s16 < 1s16) |> Stdlib.Test.equal(false)
      (0s16 < 1s16) |> Stdlib.Test.equal(true)
      (1s16 < 0s16) |> Stdlib.Test.equal(false)
      (-100s16 < 22544s16) |> Stdlib.Test.equal(true)
      (-999s16 < -9999s16) |> Stdlib.Test.equal(false)
      (-8888s16 < -8888s16) |> Stdlib.Test.equal(false) ])

test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ (6s16 <= 8s16) |> Stdlib.Test.equal(true)
      (10s16 <= 1s16) |> Stdlib.Test.equal(false)
      (0s16 <= 1s16) |> Stdlib.Test.equal(true)
      (1s16 <= 0s16) |> Stdlib.Test.equal(false)
      (-100s16 <= 22544s16) |> Stdlib.Test.equal(true)
      (-999s16 <= -9999s16) |> Stdlib.Test.equal(false)
      (-8888s16 <= -8888s16) |> Stdlib.Test.equal(true) ])

test toString =
  Stdlib.Test.all(
    [ Stdlib.display(0s16) |> Stdlib.Test.equal("0")
      Stdlib.display(1s16) |> Stdlib.Test.equal("1")
      Stdlib.display(-1s16) |> Stdlib.Test.equal("-1")
      // Int16 lower limit
      Stdlib.display(-32768s16) |> Stdlib.Test.equal("-32768")
      // Int16 upper limit
      Stdlib.display(32767s16) |> Stdlib.Test.equal("32767") ])

test toFloat =
  Stdlib.Test.all(
    [ Stdlib.Int16.toFloat(2s16) |> Stdlib.Test.equal(2.0)
      Stdlib.Int16.toFloat(-10s16) |> Stdlib.Test.equal(-10.0) ])

test parse =
  Stdlib.Test.all(
    [ Stdlib.Int16.parse("0") |> Stdlib.Test.equal(Ok(0s16))
      Stdlib.Int16.parse("1") |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.parse(" 1") |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.parse("1 ") |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.parse("+1") |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.parse(" +1 ") |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.parse("-1") |> Stdlib.Test.equal(Ok(-1s16))
      // "octal" format ignored
      Stdlib.Int16.parse("078") |> Stdlib.Test.equal(Ok(78s16))
      Stdlib.Int16.parse("-00001") |> Stdlib.Test.equal(Ok(-1s16))
      Stdlib.Int16.parse("32767") |> Stdlib.Test.equal(Ok(32767s16))
      Stdlib.Int16.parse("-32768") |> Stdlib.Test.equal(Ok(-32768s16)) ])

test parseOutOfRange =
  Stdlib.Test.all(
    [ // out of range
      Stdlib.Int16.parse("32768")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.OutOfRange))
      Stdlib.Int16.parse("-32769")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.OutOfRange)) ])

test parseBadFormat =
  Stdlib.Test.all(
    [ Stdlib.Int16.parse("1 2 3")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("+ 1")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("- 1")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("0xA")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("0x123")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("0b0100")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("pi")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("Darklang.Stdlib.Math.pi")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("1.23E+04")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("1I")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("one")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat))
      Stdlib.Int16.parse("XIV")
      |> Stdlib.Test.equal(Error(Stdlib.Int16.ParseError.BadFormat)) ])

test fromInt8 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromInt8(0s8) |> Stdlib.Test.equal(0s16)
      Stdlib.Int16.fromInt8(1s8) |> Stdlib.Test.equal(1s16)
      Stdlib.Int16.fromInt8(127s8) |> Stdlib.Test.equal(127s16)
      Stdlib.Int16.fromInt8(-1s8) |> Stdlib.Test.equal(-1s16)
      Stdlib.Int16.fromInt8(-128s8) |> Stdlib.Test.equal(-128s16) ])

test fromUInt8 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromUInt8(0u8) |> Stdlib.Test.equal(0s16)
      Stdlib.Int16.fromUInt8(1u8) |> Stdlib.Test.equal(1s16)
      Stdlib.Int16.fromUInt8(255u8) |> Stdlib.Test.equal(255s16) ])

test fromUInt16 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromUInt16(0u16) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromUInt16(1u16) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromUInt16(32767u16) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromUInt16(32768u16) |> Stdlib.Test.equal(None) ])

test fromInt32 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromInt32(0s32) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromInt32(1s32) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromInt32(32767s32) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromInt32(32768s32) |> Stdlib.Test.equal(None)
      Stdlib.Int16.fromInt32(-1s32) |> Stdlib.Test.equal(Some(-1s16))
      Stdlib.Int16.fromInt32(-32768s32) |> Stdlib.Test.equal(Some(-32768s16))
      Stdlib.Int16.fromInt32(-32769s32) |> Stdlib.Test.equal(None) ])

test fromUInt32 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromUInt32(0u32) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromUInt32(1u32) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromUInt32(32767u32) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromUInt32(32768u32) |> Stdlib.Test.equal(None) ])

test fromInt64 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromInt64(0) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromInt64(1) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromInt64(32767) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromInt64(32768) |> Stdlib.Test.equal(None)
      Stdlib.Int16.fromInt64(-1) |> Stdlib.Test.equal(Some(-1s16))
      Stdlib.Int16.fromInt64(-32768) |> Stdlib.Test.equal(Some(-32768s16))
      Stdlib.Int16.fromInt64(-32769) |> Stdlib.Test.equal(None) ])

test fromUInt64 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromUInt64(0u64) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromUInt64(1u64) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromUInt64(32767u64) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromUInt64(32768u64) |> Stdlib.Test.equal(None) ])

test fromInt128 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromInt128(0s128) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromInt128(1s128) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromInt128(32767s128) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromInt128(32768s128) |> Stdlib.Test.equal(None)
      Stdlib.Int16.fromInt128(-1s128) |> Stdlib.Test.equal(Some(-1s16))
      Stdlib.Int16.fromInt128(-32768s128) |> Stdlib.Test.equal(Some(-32768s16))
      Stdlib.Int16.fromInt128(-32769s128) |> Stdlib.Test.equal(None) ])

test fromUInt128 =
  Stdlib.Test.all(
    [ Stdlib.Int16.fromUInt128(0u128) |> Stdlib.Test.equal(Some(0s16))
      Stdlib.Int16.fromUInt128(1u128) |> Stdlib.Test.equal(Some(1s16))
      Stdlib.Int16.fromUInt128(32767u128) |> Stdlib.Test.equal(Some(32767s16))
      Stdlib.Int16.fromUInt128(32768u128) |> Stdlib.Test.equal(None) ])

test bitwiseAnd =
  Stdlib.Test.all(
    [ (12s16 & 10s16) |> Stdlib.Test.equal(8s16)
      (0s16 & 0s16) |> Stdlib.Test.equal(0s16)
      ((-1s16) & 0s16) |> Stdlib.Test.equal(0s16)
      (32767s16 & 32767s16) |> Stdlib.Test.equal(32767s16)
      ((-32768s16) & (-1s16)) |> Stdlib.Test.equal(-32768s16)
      (32767s16 & (-32768s16)) |> Stdlib.Test.equal(0s16)
      ((-1s16) & (-1s16)) |> Stdlib.Test.equal(-1s16) ])

test bitwiseOr =
  Stdlib.Test.all(
    [ (12s16 | 10s16) |> Stdlib.Test.equal(14s16)
      (0s16 | 0s16) |> Stdlib.Test.equal(0s16)
      ((-1s16) | 0s16) |> Stdlib.Test.equal(-1s16)
      (32767s16 | 0s16) |> Stdlib.Test.equal(32767s16)
      ((-32768s16) | 0s16) |> Stdlib.Test.equal(-32768s16)
      (32767s16 | (-32768s16)) |> Stdlib.Test.equal(-1s16) ])

test bitwiseXor =
  Stdlib.Test.all(
    [ (12s16 ^ 10s16) |> Stdlib.Test.equal(6s16)
      (0s16 ^ 0s16) |> Stdlib.Test.equal(0s16)
      ((-1s16) ^ (-1s16)) |> Stdlib.Test.equal(0s16)
      (32767s16 ^ (-1s16)) |> Stdlib.Test.equal(-32768s16)
      ((-32768s16) ^ (-1s16)) |> Stdlib.Test.equal(32767s16)
      (32767s16 ^ 32767s16) |> Stdlib.Test.equal(0s16) ])

test bitwiseNot =
  Stdlib.Test.all(
    [ (~0s16) |> Stdlib.Test.equal(-1s16)
      (~(-1s16)) |> Stdlib.Test.equal(0s16)
      (~32767s16) |> Stdlib.Test.equal(-32768s16)
      (~(-32768s16)) |> Stdlib.Test.equal(32767s16)
      (~1s16) |> Stdlib.Test.equal(-2s16) ])

test shiftLeft =
  Stdlib.Test.all(
    [ (1s16 << 2s16) |> Stdlib.Test.equal(4s16)
      (0s16 << 5s16) |> Stdlib.Test.equal(0s16)
      (1s16 << 0s16) |> Stdlib.Test.equal(1s16)
      (1s16 << 14s16) |> Stdlib.Test.equal(16384s16)
      (5s16 << 3s16) |> Stdlib.Test.equal(40s16) ])

test shiftRight =
  Stdlib.Test.all(
    [ (8s16 >> 2s16) |> Stdlib.Test.equal(2s16)
      (0s16 >> 5s16) |> Stdlib.Test.equal(0s16)
      (1s16 >> 0s16) |> Stdlib.Test.equal(1s16)
      (16384s16 >> 14s16) |> Stdlib.Test.equal(1s16)
      ((-1s16) >> 1s16) |> Stdlib.Test.equal(-1s16)
      (40s16 >> 3s16) |> Stdlib.Test.equal(5s16) ])

/// The shift count is taken modulo 16, as in Rust and C#: shifting by 17
/// shifts by 1, and a count of -1 shifts by 15.
test shiftCountWraps =
  Stdlib.Test.all(
    [ (1s16 << 16s16) |> Stdlib.Test.equal(1s16)
      (1s16 << 17s16) |> Stdlib.Test.equal(2s16)
      (64s16 >> 17s16) |> Stdlib.Test.equal(32s16)
      (1s16 << -1s16) |> Stdlib.Test.equal(-32768s16) ])

test checkedAdd =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedAdd(32767s16, 1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedAdd(-32768s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedAdd(32767s16, -1s16) |> Stdlib.Test.equal(Ok(32766s16))
      Stdlib.Int16.checkedAdd(-32768s16, 1s16) |> Stdlib.Test.equal(Ok(-32767s16))
      Stdlib.Int16.checkedAdd(32767s16, -32768s16) |> Stdlib.Test.equal(Ok(-1s16))
      Stdlib.Int16.checkedAdd(-32768s16, 0s16) |> Stdlib.Test.equal(Ok(-32768s16)) ])

test checkedSubtract =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedSubtract(-32768s16, 1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedSubtract(32767s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedSubtract(0s16, -32768s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedSubtract(-1s16, -32768s16) |> Stdlib.Test.equal(Ok(32767s16))
      Stdlib.Int16.checkedSubtract(32767s16, 32767s16) |> Stdlib.Test.equal(Ok(0s16))
      Stdlib.Int16.checkedSubtract(-32768s16, -1s16) |> Stdlib.Test.equal(Ok(-32767s16)) ])

test checkedMultiply =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedMultiply(32767s16, 2s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedMultiply(-32768s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedMultiply(-1s16, -32768s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedMultiply(-32768s16, 2s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedMultiply(32767s16, -1s16) |> Stdlib.Test.equal(Ok(-32767s16))
      Stdlib.Int16.checkedMultiply(-32768s16, 1s16) |> Stdlib.Test.equal(Ok(-32768s16))
      Stdlib.Int16.checkedMultiply(-32768s16, 0s16) |> Stdlib.Test.equal(Ok(0s16))
      Stdlib.Int16.checkedMultiply(-2s16, 16383s16) |> Stdlib.Test.equal(Ok(-32766s16)) ])

test checkedNegate =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedNegate(-32768s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedNegate(32767s16) |> Stdlib.Test.equal(Ok(-32767s16))
      Stdlib.Int16.checkedNegate(0s16) |> Stdlib.Test.equal(Ok(0s16)) ])

test checkedAbsoluteValue =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedAbsoluteValue(-32768s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.Int16.checkedAbsoluteValue(-32767s16) |> Stdlib.Test.equal(Ok(32767s16))
      Stdlib.Int16.checkedAbsoluteValue(32767s16) |> Stdlib.Test.equal(Ok(32767s16))
      Stdlib.Int16.checkedAbsoluteValue(0s16) |> Stdlib.Test.equal(Ok(0s16)) ])

/// `checkedPower` returns what `**` computes, and the reason where it raises or wraps.
test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedPower(2s16, 14s16) |> Stdlib.Test.equal(Ok(16384s16))
      Stdlib.Int16.checkedPower(2s16, 15s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.Overflow))
      Stdlib.Int16.checkedPower(-2s16, 15s16) |> Stdlib.Test.equal(Ok(-32768s16))
      Stdlib.Int16.checkedPower(-2s16, 14s16) |> Stdlib.Test.equal(Ok(16384s16))
      Stdlib.Int16.checkedPower(3s16, 0s16) |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.checkedPower(0s16, 0s16) |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.checkedPower(0s16, 32767s16) |> Stdlib.Test.equal(Ok(0s16))
      Stdlib.Int16.checkedPower(1s16, 32767s16) |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.checkedPower(2s16, 32767s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.Overflow))
      Stdlib.Int16.checkedPower(-1s16, 32767s16) |> Stdlib.Test.equal(Ok(-1s16))
      Stdlib.Int16.checkedPower(-1s16, 32766s16) |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.checkedPower(2s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.NegativeExponent))
      Stdlib.Int16.checkedPower(0s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.NegativeExponent))
      Stdlib.Int16.checkedPower(1s16, -32768s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.NegativeExponent)) ])

/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedDivide(17s16, 3s16) |> Stdlib.Test.equal(Ok(5s16))
      Stdlib.Int16.checkedDivide(-8s16, 5s16) |> Stdlib.Test.equal(Ok(-1s16))
      Stdlib.Int16.checkedDivide(-32768s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.Overflow))
      Stdlib.Int16.checkedDivide(-32768s16, 1s16) |> Stdlib.Test.equal(Ok(-32768s16))
      Stdlib.Int16.checkedDivide(-32767s16, -1s16) |> Stdlib.Test.equal(Ok(32767s16))
      Stdlib.Int16.checkedDivide(32767s16, -1s16) |> Stdlib.Test.equal(Ok(-32767s16))
      Stdlib.Int16.checkedDivide(-32768s16, -2s16) |> Stdlib.Test.equal(Ok(16384s16))
      Stdlib.Int16.checkedDivide(5s16, 0s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero))
      Stdlib.Int16.checkedMod(15s16, 6s16) |> Stdlib.Test.equal(Ok(3s16))
      Stdlib.Int16.checkedMod(-1s16, 2s16) |> Stdlib.Test.equal(Ok(1s16))
      Stdlib.Int16.checkedMod(5s16, 0s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.ZeroModulus))
      Stdlib.Int16.checkedMod(5s16, -1s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.NegativeModulus)) ])

test moduloRejectsZero =
  (5s16 % 0s16)
  => raises "Cannot evaluate modulus against 0"

test moduloRejectsNegativeDivisor =
  (5s16 % -5s16)
  => raises "Cannot evaluate modulus against a negative number"

test moduloRejectsMinusOne =
  (5s16 % -1s16)
  => raises "Cannot evaluate modulus against a negative number"

test checkedSqrt =
  Stdlib.Test.all(
    [ Stdlib.Int16.checkedSqrt(4s16) |> Stdlib.Test.equal(Ok(2.0))
      Stdlib.Int16.checkedSqrt(-4s16)
      |> Stdlib.Test.equal(Error(Stdlib.Math.NonFinite.NotANumber)) ])
