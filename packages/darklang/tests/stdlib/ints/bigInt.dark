module Darklang.Stdlib.BigInt.Tests

// Arbitrary-precision `BigInt` — the small/big representation split.
//
// `BigInt` is stored as a small (Int64-backed) value when it fits, and only
// promotes to a big representation on overflow. Values are NORMALIZED: any
// result that fits Int64 always uses the small representation. These tests
// exercise the boundary, promotion, demotion, normalization, and finite/infinite
// ordering — the properties that break if normalization is wrong. Every literal
// here carries the `z` suffix, since a bare one is an Int64.
//
// The representation itself is not visible from Dark, so these check the VALUES
// on both sides of the Int64 range, where a representation bug would show.

// --- boundary: largest small value vs first big value ---
test int64Boundary =
  Stdlib.Test.all(
    [ // Int64.MAX stays small
      (9223372036854775807z + 0z) |> Stdlib.Test.equal(9223372036854775807z)
      // promotes past Int64.MAX
      (9223372036854775807z + 1z) |> Stdlib.Test.equal(9223372036854775808z)
      // promotes past Int64.MIN
      (-9223372036854775808z - 1z) |> Stdlib.Test.equal(-9223372036854775809z)
      // computed up to Int64.MAX, it equals the literal
      (9223372036854775807z == (9223372036854775806z + 1z))
      |> Stdlib.Test.equal(true) ])

// --- demotion: a big-arithmetic result that fits Int64 collapses to small ---
test bigResultsBackInInt64Range =
  Stdlib.Test.all(
    [ (9223372036854775808z - 1z) |> Stdlib.Test.equal(9223372036854775807z)
      ((2z ** 100z) - (2z ** 100z)) |> Stdlib.Test.equal(0z)
      ((2z ** 100z) / (2z ** 100z)) |> Stdlib.Test.equal(1z)
      // --- normalization: a promoted-then-demoted result equals the small
      // literal ---
      // (this is the property that fails if a small value is left as the big rep)
      ((9223372036854775808z - 9223372036854775808z) == 0z)
      |> Stdlib.Test.equal(true) ])

// --- equality and ordering across representations ---
test equalityAndOrdering =
  Stdlib.Test.all(
    [ ((2z ** 64z) == (2z ** 64z)) |> Stdlib.Test.equal(true)
      (9223372036854775808z > 5z) |> Stdlib.Test.equal(true)
      (5z < 9223372036854775808z) |> Stdlib.Test.equal(true)
      (9223372036854775808z == 5z) |> Stdlib.Test.equal(false) ])

// --- arithmetic correctness at scale ---
test largePowers =
  Stdlib.Test.all(
    [ (2z ** 64z) |> Stdlib.Test.equal(18446744073709551616z)
      (2z ** 200z)
      |> Stdlib.Test.equal(1606938044258990275541962092341162602522202993782792835301376z) ])

// --- round-trips (stringify / parse / Int64 conversions) ---
test toStringAndParse =
  Stdlib.Test.all(
    [ Stdlib.display(5z) |> Stdlib.Test.equal("5")
      Stdlib.display(-5z) |> Stdlib.Test.equal("-5")
      Stdlib.display(-9223372036854775809z)
      |> Stdlib.Test.equal("-9223372036854775809")
      Stdlib.display(9223372036854775808z)
      |> Stdlib.Test.equal("9223372036854775808")
      Stdlib.BigInt.parse("9223372036854775808")
      |> Stdlib.Test.equal(Ok(9223372036854775808z))
      Stdlib.BigInt.parse("5") |> Stdlib.Test.equal(Ok(5z))
      Stdlib.BigInt.parse("not a number")
      |> Stdlib.Test.equal(Error(Stdlib.BigInt.ParseError.BadFormat))
      Stdlib.BigInt.parse("")
      |> Stdlib.Test.equal(Error(Stdlib.BigInt.ParseError.BadFormat))
      Stdlib.BigInt.parse("5.0")
      |> Stdlib.Test.equal(Error(Stdlib.BigInt.ParseError.BadFormat))
      Stdlib.BigInt.parse("5_000")
      |> Stdlib.Test.equal(Error(Stdlib.BigInt.ParseError.BadFormat))
      // arbitrary precision: a value past Int64.MinValue still parses
      Stdlib.BigInt.parse("-9223372036854775809")
      |> Stdlib.Test.equal(Ok(-9223372036854775809z)) ])

// toInt64 relies on the invariant: a small BigInt always fits, a big BigInt never does
test int64Conversions =
  Stdlib.Test.all(
    [ Stdlib.BigInt.fromInt64(5) |> Stdlib.Test.equal(5z)
      Stdlib.BigInt.toInt64(5z) |> Stdlib.Test.equal(Some(5))
      Stdlib.BigInt.toInt64(9223372036854775808z) |> Stdlib.Test.equal(None) ])

// --- conversions from the fixed-width types (always succeed) ---
test fromFixedWidth =
  Stdlib.Test.all(
    [ Stdlib.BigInt.fromInt8(127s8) |> Stdlib.Test.equal(127z)
      Stdlib.BigInt.fromUInt8(255u8) |> Stdlib.Test.equal(255z)
      Stdlib.BigInt.fromInt16(32767s16) |> Stdlib.Test.equal(32767z)
      Stdlib.BigInt.fromUInt32(4294967295u32) |> Stdlib.Test.equal(4294967295z)
      // values past Int64 still convert exactly
      Stdlib.BigInt.fromUInt64(18446744073709551615u64)
      |> Stdlib.Test.equal(18446744073709551615z)
      Stdlib.BigInt.fromUInt128(340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(340282366920938463463374607431768211455z) ])

// --- conversions into the fixed-width types (Some if it fits, else None) ---
test toFixedWidth =
  Stdlib.Test.all(
    [ Stdlib.BigInt.toInt8(100z) |> Stdlib.Test.equal(Some(100s8))
      Stdlib.BigInt.toInt8(200z) |> Stdlib.Test.equal(None)
      Stdlib.BigInt.toUInt8(-1z) |> Stdlib.Test.equal(None)
      Stdlib.BigInt.toInt32(2z ** 40z) |> Stdlib.Test.equal(None)
      Stdlib.BigInt.toInt128(2z ** 100z)
      |> Stdlib.Test.equal(Some(1267650600228229401496703205376s128))
      Stdlib.BigInt.toInt128(2z ** 200z) |> Stdlib.Test.equal(None)
      Stdlib.BigInt.toUInt128(2z ** 200z) |> Stdlib.Test.equal(None) ])

// --- fromFloat: truncates toward zero; NaN/Infinity have no BigInt, so OutOfRange ---
test fromFloatTruncatesTowardZero =
  Stdlib.Test.all(
    [ Stdlib.BigInt.fromFloat(3.9) |> Stdlib.Test.equal(3z)
      Stdlib.BigInt.fromFloat(-3.9) |> Stdlib.Test.equal(-3z) ])

// NaN and the infinities have no BigInt, so they are out of range.

test fromFloatRejectsNaN =
  Stdlib.BigInt.fromFloat(0.0 / 0.0)
  => raises "Float has no integer value: NaN"

test fromFloatRejectsInfinity =
  Stdlib.BigInt.fromFloat(1.0 / 0.0)
  => raises "Float has no integer value: Infinity"

test fromFloatRejectsNegativeInfinity =
  Stdlib.BigInt.fromFloat(-1.0 / 0.0)
  => raises "Float has no integer value: -Infinity"

// --- remainder: Result<BigInt>; sign follows the dividend; Error only if divisor
// is 0 ---
test remainder =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedRemainder(15z, 6z) |> Stdlib.Test.equal(Ok(3z))
      Stdlib.BigInt.checkedRemainder(20z, 8z) |> Stdlib.Test.equal(Ok(4z))
      Stdlib.BigInt.checkedRemainder(-20z, 8z) |> Stdlib.Test.equal(Ok(-4z))
      Stdlib.BigInt.checkedRemainder(-20z, -8z) |> Stdlib.Test.equal(Ok(-4z))
      Stdlib.BigInt.checkedRemainder(-15z, 6z) |> Stdlib.Test.equal(Ok(-3z))
      Stdlib.BigInt.checkedRemainder(5z, 0z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero))
      // arbitrary precision: 2^100 mod 7 == 2, with a dividend well past Int64
      Stdlib.BigInt.checkedRemainder(2z ** 100z, 7z) |> Stdlib.Test.equal(Ok(2z)) ])

// The % operator dispatches to mod, which wraps into [0, b) and rejects b <= 0.
test modulo =
  Stdlib.Test.all(
    [ (15z % 5z) |> Stdlib.Test.equal(0z)
      (15z % 6z) |> Stdlib.Test.equal(3z)
      (0z % 15z) |> Stdlib.Test.equal(0z)
      (-1z % 2z) |> Stdlib.Test.equal(1z)
      (-754z % 53z) |> Stdlib.Test.equal(41z)
      ((2z ** 100z) % 7z) |> Stdlib.Test.equal(2z) ])

test moduloRejectsZero =
  (5z % 0z)
  => raises "Cannot evaluate modulus against 0"

test moduloRejectsNegativeDivisor =
  (5z % -5z)
  => raises "Cannot evaluate modulus against a negative number"

test moduloRejectsMinusOne =
  (5z % -1z)
  => raises "Cannot evaluate modulus against a negative number"

// --- shiftLeft / shiftRight: count must fit Int32, else OutOfRange ---
test shifts =
  Stdlib.Test.all(
    [ (1z << 4z) |> Stdlib.Test.equal(16z)
      (1z << 64z) |> Stdlib.Test.equal(18446744073709551616z)
      (256z >> 4z) |> Stdlib.Test.equal(16z) ])

test shiftLeftRejectsHugeCount =
  (1z << (2z ** 40z))
  => raises "Shift count out of range (0 to 2147483647): 1099511627776z"

test shiftRightRejectsHugeCount =
  (1z >> (2z ** 40z))
  => raises "Shift count out of range (0 to 2147483647): 1099511627776z"

test checkedShiftLeft =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedShiftLeft(1z, 4z) |> Stdlib.Test.equal(Ok(16z))
      Stdlib.BigInt.checkedShiftLeft(-3z, 2z) |> Stdlib.Test.equal(Ok(-12z))
      Stdlib.BigInt.checkedShiftLeft(5z, 0z) |> Stdlib.Test.equal(Ok(5z))
      Stdlib.BigInt.checkedShiftLeft(0z, 2z ** 40z) |> Stdlib.Test.equal(Ok(0z))
      Stdlib.BigInt.checkedShiftLeft(1z, -1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ShiftError.NegativeCount))
      Stdlib.BigInt.checkedShiftLeft(1z, 8388607z)
      |> Stdlib.Test.equal(Ok(1z << 8388607z))
      Stdlib.BigInt.checkedShiftLeft(1z, 8388608z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ShiftError.ResultTooLarge))
      Stdlib.BigInt.checkedShiftLeft(-2z, 8388607z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ShiftError.ResultTooLarge))
      Stdlib.BigInt.checkedShiftLeft(1z, 2z ** 40z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ShiftError.ResultTooLarge)) ])

test checkedShiftRight =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedShiftRight(256z, 4z) |> Stdlib.Test.equal(Ok(16z))
      Stdlib.BigInt.checkedShiftRight(-5z, 1z) |> Stdlib.Test.equal(Ok(-3z))
      Stdlib.BigInt.checkedShiftRight(1z, 2z ** 40z) |> Stdlib.Test.equal(Ok(0z))
      Stdlib.BigInt.checkedShiftRight(-1z, 2z ** 40z) |> Stdlib.Test.equal(Ok(-1z))
      Stdlib.BigInt.checkedShiftRight(1z, -1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ShiftError.NegativeCount)) ])

// --- random ---
/// Every result lands inside the bounds, whichever order they are given in,
/// and every value in a small range is reached.
test randomSmallRange =
  (Stdlib.List.range(1, 100)
   |> Stdlib.List.map(fun _ -> Stdlib.BigInt.random(2z, 0z))
   |> Stdlib.List.unique
   |> Stdlib.List.sort)
  |> Stdlib.Test.equal([ 0z, 1z, 2z ])

/// Each fixed-width `random` draws across its whole range. Lists the widths
/// whose draws leave the range or all come out the same.
test randomFullRangeEveryWidth =
  [ ("Int8", -128z, 127z, fun _ ->
      Stdlib.BigInt.fromInt8(Stdlib.Int8.random(-128s8, 127s8)))
    ("UInt8", 0z, 255z, fun _ -> Stdlib.BigInt.fromUInt8(Stdlib.UInt8.random(0u8, 255u8)))
    ("Int16", -32768z, 32767z, fun _ ->
      Stdlib.BigInt.fromInt16(Stdlib.Int16.random(-32768s16, 32767s16)))
    ("UInt16", 0z, 65535z, fun _ ->
      Stdlib.BigInt.fromUInt16(Stdlib.UInt16.random(0u16, 65535u16)))
    ("Int32", -2147483648z, 2147483647z, fun _ ->
      Stdlib.BigInt.fromInt32(Stdlib.Int32.random(-2147483648s32, 2147483647s32)))
    ("UInt32", 0z, 4294967295z, fun _ ->
      Stdlib.BigInt.fromUInt32(Stdlib.UInt32.random(0u32, 4294967295u32)))
    ("Int64", -9223372036854775808z, 9223372036854775807z, fun _ ->
      Stdlib.Int64.random(-9223372036854775808, 9223372036854775807)
      |> Stdlib.BigInt.fromInt64)
    ("UInt64", 0z, 18446744073709551615z, fun _ ->
      Stdlib.UInt64.random(0u64, 18446744073709551615u64) |> Stdlib.BigInt.fromUInt64) ]
  |> Stdlib.List.filter(fun((_, lo, hi, draw)) ->
    let draws = Stdlib.List.range(1, 20) |> Stdlib.List.map(fun _ -> draw())
    let inRange = Stdlib.List.all(draws, fun x -> (x >= lo) && (x <= hi))
    Stdlib.Bool.not(inRange && (Stdlib.List.length(Stdlib.List.unique(draws)) > 1)))
  |> Stdlib.List.map(fun((name, _, _, _)) -> name)
  |> Stdlib.Test.equal([])

/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedDivide(17z, 3z) |> Stdlib.Test.equal(Ok(5z))
      Stdlib.BigInt.checkedDivide(-8z, 5z) |> Stdlib.Test.equal(Ok(-1z))
      Stdlib.BigInt.checkedDivide(5z, 0z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero))
      Stdlib.BigInt.checkedMod(15z, 6z) |> Stdlib.Test.equal(Ok(3z))
      Stdlib.BigInt.checkedMod(-1z, 2z) |> Stdlib.Test.equal(Ok(1z))
      Stdlib.BigInt.checkedMod(5z, 0z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.ZeroModulus))
      Stdlib.BigInt.checkedMod(5z, -1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.NegativeModulus)) ])

test divideRejectsZero =
  (7z / 0z)
  => raises "Cannot divide by 0"

test checkedSqrt =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedSqrt(Stdlib.BigInt.fromInt64(4)) |> Stdlib.Test.equal(Ok(2.0))
      Stdlib.BigInt.checkedSqrt(Stdlib.BigInt.fromInt64(-4))
      |> Stdlib.Test.equal(Error(Stdlib.Math.NonFinite.NotANumber))
      Stdlib.BigInt.checkedSqrt(Stdlib.BigInt.fromInt64(10) ** Stdlib.BigInt.fromInt64(400))
      |> Stdlib.Test.equal(Error(Stdlib.Math.NonFinite.Overflow)) ])

test checkedToFloat =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedToFloat(Stdlib.BigInt.fromInt64(-3)) |> Stdlib.Test.equal(Ok(-3.0))
      Stdlib.BigInt.checkedToFloat(Stdlib.BigInt.fromInt64(10) ** Stdlib.BigInt.fromInt64(400))
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow)) ])

/// `checkedPower` estimates the result as the exponent times the bits in the base,
/// and refuses past `maxPowerBits` (1 MB) before computing anything.
test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedPower(2z, 10z) |> Stdlib.Test.equal(Ok(1024z))
      Stdlib.BigInt.checkedPower(-3z, 3z) |> Stdlib.Test.equal(Ok(-27z))
      Stdlib.BigInt.checkedPower(10z, 30z)
      |> Stdlib.Test.equal(Ok(1000000000000000000000000000000z))
      Stdlib.BigInt.checkedPower(7z, 0z) |> Stdlib.Test.equal(Ok(1z))
      Stdlib.BigInt.checkedPower(2z, -1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.NegativeExponent))
      Stdlib.BigInt.checkedPower(0z, -1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.NegativeExponent)) ])

test checkedPowerTrivialBases =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedPower(0z, 100000000000000000000z)
      |> Stdlib.Test.equal(Ok(0z))
      Stdlib.BigInt.checkedPower(1z, 100000000000000000000z)
      |> Stdlib.Test.equal(Ok(1z))
      Stdlib.BigInt.checkedPower(-1z, 100000000000000000001z)
      |> Stdlib.Test.equal(Ok(-1z))
      Stdlib.BigInt.checkedPower(1z << 10000000z, 0z) |> Stdlib.Test.equal(Ok(1z)) ])

/// 2 has 2 bits, so 2 ** 4194304 is estimated at exactly 8388608 bits.
test checkedPowerAtTheLimit =
  Stdlib.Test.all(
    [ Stdlib.BigInt.checkedPower(2z, 4194304z)
      |> Stdlib.Test.equal(Ok(1z << 4194304z))
      Stdlib.BigInt.checkedPower(2z, 4194305z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.ResultTooLarge))
      Stdlib.BigInt.checkedPower(-2z, 4194305z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.ResultTooLarge))
      Stdlib.BigInt.checkedPower((1z << 8388607z), 1z)
      |> Stdlib.Test.equal(Ok(1z << 8388607z))
      Stdlib.BigInt.checkedPower((1z << 8388608z), 1z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.ResultTooLarge))
      Stdlib.BigInt.checkedPower(2z, 100000000000000000000z)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.ResultTooLarge)) ])
