module Darklang.Stdlib.UInt32.Tests

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max =
  Stdlib.max 4294967295ul 0ul |> Stdlib.Test.equal 4294967295ul

test min =
  Stdlib.min 4294967295ul 0ul |> Stdlib.Test.equal 0ul

test clamp =
  Stdlib.clamp 100ul 0ul 0ul |> Stdlib.Test.equal 0ul

/// Wraps on overflow.
test add =
  Stdlib.Test.all
    [ (10ul + 9ul) |> Stdlib.Test.equal 19ul
      (88ul + 9ul) |> Stdlib.Test.equal 97ul
      (1ul + 0ul) |> Stdlib.Test.equal 1ul
      (4294967294ul + 1ul) |> Stdlib.Test.equal 4294967295ul
      (4294967295ul + 1ul) |> Stdlib.Test.equal 0ul ]

/// Wraps on overflow.
test subtract =
  Stdlib.Test.all
    [ (10ul - 9ul) |> Stdlib.Test.equal 1ul
      (88ul - 9ul) |> Stdlib.Test.equal 79ul
      (0ul - 1ul) |> Stdlib.Test.equal 4294967295ul
      (1ul - 0ul) |> Stdlib.Test.equal 1ul
      (4294967295ul - 1ul) |> Stdlib.Test.equal 4294967294ul ]

/// Wraps on overflow.
test multiply =
  Stdlib.Test.all
    [ (8ul * 8ul) |> Stdlib.Test.equal 64ul
      (8ul * 0ul) |> Stdlib.Test.equal 0ul
      (2147483647ul * 2ul) |> Stdlib.Test.equal 4294967294ul
      (2147483648ul * 2ul) |> Stdlib.Test.equal 0ul ]

/// Wraps on overflow.
test power =
  Stdlib.Test.all
    [ (2ul ** 3ul) |> Stdlib.Test.equal 8ul
      (0ul ** 1ul) |> Stdlib.Test.equal 0ul
      (1ul ** 0ul) |> Stdlib.Test.equal 1ul
      (0ul ** 0ul) |> Stdlib.Test.equal 1ul
      (1ul ** 255ul) |> Stdlib.Test.equal 1ul
      (65536ul ** 2ul) |> Stdlib.Test.equal 0ul ]

test divide =
  Stdlib.Test.all
    [ (10ul / 5ul) |> Stdlib.Test.equal 2ul
      (17ul / 3ul) |> Stdlib.Test.equal 5ul
      (8ul / 5ul) |> Stdlib.Test.equal 1ul
      (0ul / 1ul) |> Stdlib.Test.equal 0ul
      (4294967295ul / 2ul) |> Stdlib.Test.equal 2147483647ul ]

test divideOfOneRejectsZero =
  (1ul / 0ul)
  => raises "Cannot divide by 0"

test greaterThan =
  (20ul > 1ul) |> Stdlib.Test.equal true

test greaterThanOrEqualTo =
  Stdlib.Test.all
    [ (0ul >= 1ul) |> Stdlib.Test.equal false
      (1ul >= 0ul) |> Stdlib.Test.equal true
      (6ul >= 1ul) |> Stdlib.Test.equal true
      (6ul >= 8ul) |> Stdlib.Test.equal false
      (4294967295ul >= 0ul) |> Stdlib.Test.equal true
      (0ul >= 4294967295ul) |> Stdlib.Test.equal false ]

test lessThanOrEqualTo =
  Stdlib.Test.all
    [ (6ul <= 8ul) |> Stdlib.Test.equal true
      (10ul <= 1ul) |> Stdlib.Test.equal false
      (0ul <= 1ul) |> Stdlib.Test.equal true
      (1ul <= 0ul) |> Stdlib.Test.equal false
      (4294967295ul <= 0ul) |> Stdlib.Test.equal false
      (0ul <= 4294967295ul) |> Stdlib.Test.equal true
      (4294967295ul <= 4294967295ul) |> Stdlib.Test.equal true ]

test lessThan =
  Stdlib.Test.all
    [ (6ul < 8ul) |> Stdlib.Test.equal true
      (10ul < 1ul) |> Stdlib.Test.equal false
      (0ul < 1ul) |> Stdlib.Test.equal true
      (1ul < 0ul) |> Stdlib.Test.equal false
      (0ul < 4294967295ul) |> Stdlib.Test.equal true
      (4294967295ul < 4294967295ul) |> Stdlib.Test.equal false ]

test toString =
  Stdlib.Test.all
    [ Stdlib.toString 120ul |> Stdlib.Test.equal "120"
      Stdlib.toString 1ul |> Stdlib.Test.equal "1"
      // UInt32 lower limit
      Stdlib.toString 0ul |> Stdlib.Test.equal "0"
      // UInt32 upper limit
      Stdlib.toString 4294967295ul |> Stdlib.Test.equal "4294967295" ]

test toFloat =
  Stdlib.Test.all
    [ Stdlib.UInt32.toFloat 2ul |> Stdlib.Test.equal 2.0
      Stdlib.UInt32.toFloat 0ul |> Stdlib.Test.equal 0.0 ]

test sqrt =
  Stdlib.Test.all
    [ Stdlib.UInt32.sqrt 4ul |> Stdlib.Test.equal 2.0
      Stdlib.UInt32.sqrt 100ul |> Stdlib.Test.equal 10.0
      Stdlib.UInt32.sqrt 86ul |> Stdlib.Test.equal 9.273618495495704 ]

/// `%` wraps into [0, b), and raises when b <= 0.
test modulo =
  Stdlib.Test.all
    [ (15ul % 5ul) |> Stdlib.Test.equal 0ul
      (15ul % 6ul) |> Stdlib.Test.equal 3ul
      (0ul % 15ul) |> Stdlib.Test.equal 0ul
      (1ul % 2ul) |> Stdlib.Test.equal 1ul
      (32768ul % 53ul) |> Stdlib.Test.equal 14ul
      (4294967295ul % 3ul) |> Stdlib.Test.equal 0ul ]

test moduloRejectsZero =
  (5ul % 0ul)
  => raises "Cannot evaluate modulus against 0"

/// Every result lands inside the bounds, whichever order they are given in.
test randomStaysWithinBounds =
  Stdlib.Test.all
    [ ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 1ul 2ul)
       |> Stdlib.List.map (fun x -> (x >= 1ul) && (x <= 2ul)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 10ul 20ul)
       |> Stdlib.List.map (fun x -> (x >= 10ul) && (x <= 20ul)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 2ul 1ul)
       |> Stdlib.List.map (fun x -> (x >= 1ul) && (x <= 2ul)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ])
      ((Stdlib.List.range 1 5)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 20ul 10ul)
       |> Stdlib.List.map (fun x -> (x >= 10ul) && (x <= 20ul)))
      |> Stdlib.Test.equal ([ true, true, true, true, true ]) ]

/// Both ends of the range are reachable.
test randomReachesEveryValue =
  Stdlib.Test.all
    [ (((Stdlib.List.range 1 100)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 0ul 1ul)
       |> Stdlib.List.unique))
      |> Stdlib.Test.equal ([ 0ul, 1ul ])
      (((Stdlib.List.range 1 100)
       |> Stdlib.List.map (fun x -> Stdlib.UInt32.random 0ul 2ul)
       |> Stdlib.List.unique))
      |> Stdlib.Test.equal ([ 0ul, 1ul, 2ul ]) ]

test sum =
  Stdlib.Test.all
    [ Stdlib.sum 0ul [ 1ul, 2ul ] |> Stdlib.Test.equal 3ul
      // wraps on overflow
      Stdlib.sum 0ul [ 1ul, 4294967295ul ] |> Stdlib.Test.equal 0ul ]

test parseOutOfRange =
  Stdlib.Test.all
    [ Stdlib.UInt32.parse "-129"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.OutOfRange)
      Stdlib.UInt32.parse "4294967296"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.OutOfRange) ]

test parseBadFormat =
  Stdlib.Test.all
    [ // bad format
      Stdlib.UInt32.parse "4294967296ul"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "1 2 3"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "+ 1"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "- 1"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "0xA"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "0x123"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "0b0100"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "pi"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "Darklang.Stdlib.Math.pi"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "1.23E+04"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse ""
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "1I"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "one"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat)
      Stdlib.UInt32.parse "XIV"
      |> Stdlib.Test.equal (Error Stdlib.UInt32.ParseError.BadFormat) ]

test fromInt8 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromInt8 0y |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromInt8 1y |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromInt8 127y |> Stdlib.Test.equal (Some 127ul)
      Stdlib.UInt32.fromInt8 (-128y) |> Stdlib.Test.equal None ]

test fromUInt8 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromUInt8 0uy |> Stdlib.Test.equal 0ul
      Stdlib.UInt32.fromUInt8 1uy |> Stdlib.Test.equal 1ul
      Stdlib.UInt32.fromUInt8 255uy |> Stdlib.Test.equal 255ul ]

test fromInt16 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromInt16 0s |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromInt16 1s |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromInt16 32767s |> Stdlib.Test.equal (Some 32767ul)
      Stdlib.UInt32.fromInt16 (-32768s) |> Stdlib.Test.equal None ]

test fromUInt16 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromUInt16 0us |> Stdlib.Test.equal 0ul
      Stdlib.UInt32.fromUInt16 1us |> Stdlib.Test.equal 1ul
      Stdlib.UInt32.fromUInt16 65535us |> Stdlib.Test.equal 65535ul ]

test fromInt32 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromInt32 0l |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromInt32 1l |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromInt32 2147483647l |> Stdlib.Test.equal (Some 2147483647ul)
      Stdlib.UInt32.fromInt32 (-2147483648l) |> Stdlib.Test.equal None ]

test fromInt64 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromInt64 0L |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromInt64 1L |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromInt64 4294967295L |> Stdlib.Test.equal (Some 4294967295ul)
      Stdlib.UInt32.fromInt64 4294967296L |> Stdlib.Test.equal None
      Stdlib.UInt32.fromInt64 (-1L) |> Stdlib.Test.equal None ]

test fromUInt64 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromUInt64 0UL |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromUInt64 1UL |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromUInt64 4294967295UL |> Stdlib.Test.equal (Some 4294967295ul)
      Stdlib.UInt32.fromUInt64 4294967296UL |> Stdlib.Test.equal None ]

test fromInt128 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromInt128 0Q |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromInt128 1Q |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromInt128 4294967295Q |> Stdlib.Test.equal (Some 4294967295ul)
      Stdlib.UInt32.fromInt128 4294967296Q |> Stdlib.Test.equal None
      Stdlib.UInt32.fromInt128 (-1Q) |> Stdlib.Test.equal None ]

test fromUInt128 =
  Stdlib.Test.all
    [ Stdlib.UInt32.fromUInt128 0Z |> Stdlib.Test.equal (Some 0ul)
      Stdlib.UInt32.fromUInt128 1Z |> Stdlib.Test.equal (Some 1ul)
      Stdlib.UInt32.fromUInt128 4294967295Z |> Stdlib.Test.equal (Some 4294967295ul)
      Stdlib.UInt32.fromUInt128 4294967296Z |> Stdlib.Test.equal None ]

test bitwiseAnd =
  Stdlib.Test.all
    [ (12ul & 10ul) |> Stdlib.Test.equal 8ul
      (0ul & 0ul) |> Stdlib.Test.equal 0ul
      (4294967295ul & 0ul) |> Stdlib.Test.equal 0ul
      (4294967295ul & 4294967295ul) |> Stdlib.Test.equal 4294967295ul ]

test bitwiseOr =
  Stdlib.Test.all
    [ (12ul | 10ul) |> Stdlib.Test.equal 14ul
      (0ul | 0ul) |> Stdlib.Test.equal 0ul
      (4294967295ul | 0ul) |> Stdlib.Test.equal 4294967295ul ]

test bitwiseXor =
  Stdlib.Test.all
    [ (12ul ^ 10ul) |> Stdlib.Test.equal 6ul
      (0ul ^ 0ul) |> Stdlib.Test.equal 0ul
      (4294967295ul ^ 4294967295ul) |> Stdlib.Test.equal 0ul ]

test bitwiseNot =
  Stdlib.Test.all
    [ (~0ul) |> Stdlib.Test.equal 4294967295ul
      (~4294967295ul) |> Stdlib.Test.equal 0ul
      (~1ul) |> Stdlib.Test.equal 4294967294ul ]

test shiftLeft =
  Stdlib.Test.all
    [ (1ul << 2ul) |> Stdlib.Test.equal 4ul
      (0ul << 5ul) |> Stdlib.Test.equal 0ul
      (1ul << 0ul) |> Stdlib.Test.equal 1ul
      (1ul << 31ul) |> Stdlib.Test.equal 2147483648ul
      (5ul << 3ul) |> Stdlib.Test.equal 40ul ]

test shiftRight =
  Stdlib.Test.all
    [ (8ul >> 2ul) |> Stdlib.Test.equal 2ul
      (0ul >> 5ul) |> Stdlib.Test.equal 0ul
      (1ul >> 0ul) |> Stdlib.Test.equal 1ul
      (2147483648ul >> 31ul) |> Stdlib.Test.equal 1ul
      (40ul >> 3ul) |> Stdlib.Test.equal 5ul ]
