module Darklang.Stdlib.UInt32.Tests

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max =
  Stdlib.max(4294967295u32, 0u32) |> Stdlib.Test.equal(4294967295u32)

test min =
  Stdlib.min(4294967295u32, 0u32) |> Stdlib.Test.equal(0u32)

test clamp =
  Stdlib.clamp(100u32, 0u32, 0u32) |> Stdlib.Test.equal(0u32)

/// Wraps on overflow.
test add =
  Stdlib.Test.all(
    [ (10u32 + 9u32) |> Stdlib.Test.equal(19u32)
      (88u32 + 9u32) |> Stdlib.Test.equal(97u32)
      (1u32 + 0u32) |> Stdlib.Test.equal(1u32)
      (4294967294u32 + 1u32) |> Stdlib.Test.equal(4294967295u32)
      (4294967295u32 + 1u32) |> Stdlib.Test.equal(0u32) ])

/// Wraps on overflow.
test subtract =
  Stdlib.Test.all(
    [ (10u32 - 9u32) |> Stdlib.Test.equal(1u32)
      (88u32 - 9u32) |> Stdlib.Test.equal(79u32)
      (0u32 - 1u32) |> Stdlib.Test.equal(4294967295u32)
      (1u32 - 0u32) |> Stdlib.Test.equal(1u32)
      (4294967295u32 - 1u32) |> Stdlib.Test.equal(4294967294u32) ])

/// Wraps on overflow.
test multiply =
  Stdlib.Test.all(
    [ (8u32 * 8u32) |> Stdlib.Test.equal(64u32)
      (8u32 * 0u32) |> Stdlib.Test.equal(0u32)
      (2147483647u32 * 2u32) |> Stdlib.Test.equal(4294967294u32)
      (2147483648u32 * 2u32) |> Stdlib.Test.equal(0u32) ])

/// Wraps on overflow.
test power =
  Stdlib.Test.all(
    [ (2u32 ** 3u32) |> Stdlib.Test.equal(8u32)
      (0u32 ** 1u32) |> Stdlib.Test.equal(0u32)
      (1u32 ** 0u32) |> Stdlib.Test.equal(1u32)
      (0u32 ** 0u32) |> Stdlib.Test.equal(1u32)
      (1u32 ** 255u32) |> Stdlib.Test.equal(1u32)
      (65536u32 ** 2u32) |> Stdlib.Test.equal(0u32) ])

test divide =
  Stdlib.Test.all(
    [ (10u32 / 5u32) |> Stdlib.Test.equal(2u32)
      (17u32 / 3u32) |> Stdlib.Test.equal(5u32)
      (8u32 / 5u32) |> Stdlib.Test.equal(1u32)
      (0u32 / 1u32) |> Stdlib.Test.equal(0u32)
      (4294967295u32 / 2u32) |> Stdlib.Test.equal(2147483647u32) ])

test divideOfOneRejectsZero =
  (1u32 / 0u32)
  => raises "Cannot divide by 0"

test greaterThan =
  (20u32 > 1u32) |> Stdlib.Test.equal(true)

test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ (0u32 >= 1u32) |> Stdlib.Test.equal(false)
      (1u32 >= 0u32) |> Stdlib.Test.equal(true)
      (6u32 >= 1u32) |> Stdlib.Test.equal(true)
      (6u32 >= 8u32) |> Stdlib.Test.equal(false)
      (4294967295u32 >= 0u32) |> Stdlib.Test.equal(true)
      (0u32 >= 4294967295u32) |> Stdlib.Test.equal(false) ])

test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ (6u32 <= 8u32) |> Stdlib.Test.equal(true)
      (10u32 <= 1u32) |> Stdlib.Test.equal(false)
      (0u32 <= 1u32) |> Stdlib.Test.equal(true)
      (1u32 <= 0u32) |> Stdlib.Test.equal(false)
      (4294967295u32 <= 0u32) |> Stdlib.Test.equal(false)
      (0u32 <= 4294967295u32) |> Stdlib.Test.equal(true)
      (4294967295u32 <= 4294967295u32) |> Stdlib.Test.equal(true) ])

test lessThan =
  Stdlib.Test.all(
    [ (6u32 < 8u32) |> Stdlib.Test.equal(true)
      (10u32 < 1u32) |> Stdlib.Test.equal(false)
      (0u32 < 1u32) |> Stdlib.Test.equal(true)
      (1u32 < 0u32) |> Stdlib.Test.equal(false)
      (0u32 < 4294967295u32) |> Stdlib.Test.equal(true)
      (4294967295u32 < 4294967295u32) |> Stdlib.Test.equal(false) ])

test toString =
  Stdlib.Test.all(
    [ Stdlib.toString(120u32) |> Stdlib.Test.equal("120")
      Stdlib.toString(1u32) |> Stdlib.Test.equal("1")
      // UInt32 lower limit
      Stdlib.toString(0u32) |> Stdlib.Test.equal("0")
      // UInt32 upper limit
      Stdlib.toString(4294967295u32) |> Stdlib.Test.equal("4294967295") ])

test toFloat =
  Stdlib.Test.all(
    [ Stdlib.UInt32.toFloat(2u32) |> Stdlib.Test.equal(2.0)
      Stdlib.UInt32.toFloat(0u32) |> Stdlib.Test.equal(0.0) ])

test sqrt =
  Stdlib.Test.all(
    [ Stdlib.UInt32.sqrt(4u32) |> Stdlib.Test.equal(2.0)
      Stdlib.UInt32.sqrt(100u32) |> Stdlib.Test.equal(10.0)
      Stdlib.UInt32.sqrt(86u32) |> Stdlib.Test.equal(9.273618495495704) ])

/// `%` wraps into [0, b), and raises when b <= 0.
test modulo =
  Stdlib.Test.all(
    [ (15u32 % 5u32) |> Stdlib.Test.equal(0u32)
      (15u32 % 6u32) |> Stdlib.Test.equal(3u32)
      (0u32 % 15u32) |> Stdlib.Test.equal(0u32)
      (1u32 % 2u32) |> Stdlib.Test.equal(1u32)
      (32768u32 % 53u32) |> Stdlib.Test.equal(14u32)
      (4294967295u32 % 3u32) |> Stdlib.Test.equal(0u32) ])

test moduloRejectsZero =
  (5u32 % 0u32)
  => raises "Cannot evaluate modulus against 0"

test sum =
  Stdlib.Test.all(
    [ Stdlib.sum(0u32, [ 1u32, 2u32 ]) |> Stdlib.Test.equal(3u32)
      // wraps on overflow
      Stdlib.sum(0u32, [ 1u32, 4294967295u32 ]) |> Stdlib.Test.equal(0u32) ])

test parseOutOfRange =
  Stdlib.Test.all(
    [ Stdlib.UInt32.parse("-129")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.OutOfRange))
      Stdlib.UInt32.parse("4294967296")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.OutOfRange)) ])

test parseBadFormat =
  Stdlib.Test.all(
    [ // bad format
      Stdlib.UInt32.parse("4294967296u32")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("1 2 3")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("+ 1")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("- 1")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("0xA")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("0x123")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("0b0100")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("pi")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("Darklang.Stdlib.Math.pi")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("1.23E+04")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("1I")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("one")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat))
      Stdlib.UInt32.parse("XIV")
      |> Stdlib.Test.equal(Error(Stdlib.UInt32.ParseError.BadFormat)) ])

test fromInt8 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromInt8(0s8) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromInt8(1s8) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromInt8(127s8) |> Stdlib.Test.equal(Some(127u32))
      Stdlib.UInt32.fromInt8(-128s8) |> Stdlib.Test.equal(None)
      Stdlib.UInt32.fromInt8(-1s8) |> Stdlib.Test.equal(None) ])

test fromUInt8 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromUInt8(0u8) |> Stdlib.Test.equal(0u32)
      Stdlib.UInt32.fromUInt8(1u8) |> Stdlib.Test.equal(1u32)
      Stdlib.UInt32.fromUInt8(255u8) |> Stdlib.Test.equal(255u32) ])

test fromInt16 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromInt16(0s16) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromInt16(1s16) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromInt16(32767s16) |> Stdlib.Test.equal(Some(32767u32))
      Stdlib.UInt32.fromInt16(-32768s16) |> Stdlib.Test.equal(None)
      Stdlib.UInt32.fromInt16(-1s16) |> Stdlib.Test.equal(None) ])

test fromUInt16 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromUInt16(0u16) |> Stdlib.Test.equal(0u32)
      Stdlib.UInt32.fromUInt16(1u16) |> Stdlib.Test.equal(1u32)
      Stdlib.UInt32.fromUInt16(65535u16) |> Stdlib.Test.equal(65535u32) ])

test fromInt32 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromInt32(0s32) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromInt32(1s32) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromInt32(2147483647s32) |> Stdlib.Test.equal(Some(2147483647u32))
      Stdlib.UInt32.fromInt32(-2147483648s32) |> Stdlib.Test.equal(None)
      Stdlib.UInt32.fromInt32(-1s32) |> Stdlib.Test.equal(None) ])

test fromInt64 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromInt64(0) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromInt64(1) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromInt64(4294967295) |> Stdlib.Test.equal(Some(4294967295u32))
      Stdlib.UInt32.fromInt64(4294967296) |> Stdlib.Test.equal(None)
      Stdlib.UInt32.fromInt64(-1) |> Stdlib.Test.equal(None) ])

test fromUInt64 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromUInt64(0u64) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromUInt64(1u64) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromUInt64(4294967295u64) |> Stdlib.Test.equal(Some(4294967295u32))
      Stdlib.UInt32.fromUInt64(4294967296u64) |> Stdlib.Test.equal(None) ])

test fromInt128 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromInt128(0s128) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromInt128(1s128) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromInt128(4294967295s128) |> Stdlib.Test.equal(Some(4294967295u32))
      Stdlib.UInt32.fromInt128(4294967296s128) |> Stdlib.Test.equal(None)
      Stdlib.UInt32.fromInt128(-1s128) |> Stdlib.Test.equal(None) ])

test fromUInt128 =
  Stdlib.Test.all(
    [ Stdlib.UInt32.fromUInt128(0u128) |> Stdlib.Test.equal(Some(0u32))
      Stdlib.UInt32.fromUInt128(1u128) |> Stdlib.Test.equal(Some(1u32))
      Stdlib.UInt32.fromUInt128(4294967295u128) |> Stdlib.Test.equal(Some(4294967295u32))
      Stdlib.UInt32.fromUInt128(4294967296u128) |> Stdlib.Test.equal(None) ])

test bitwiseAnd =
  Stdlib.Test.all(
    [ (12u32 & 10u32) |> Stdlib.Test.equal(8u32)
      (0u32 & 0u32) |> Stdlib.Test.equal(0u32)
      (4294967295u32 & 0u32) |> Stdlib.Test.equal(0u32)
      (4294967295u32 & 4294967295u32) |> Stdlib.Test.equal(4294967295u32) ])

test bitwiseOr =
  Stdlib.Test.all(
    [ (12u32 | 10u32) |> Stdlib.Test.equal(14u32)
      (0u32 | 0u32) |> Stdlib.Test.equal(0u32)
      (4294967295u32 | 0u32) |> Stdlib.Test.equal(4294967295u32) ])

test bitwiseXor =
  Stdlib.Test.all(
    [ (12u32 ^ 10u32) |> Stdlib.Test.equal(6u32)
      (0u32 ^ 0u32) |> Stdlib.Test.equal(0u32)
      (4294967295u32 ^ 4294967295u32) |> Stdlib.Test.equal(0u32) ])

test bitwiseNot =
  Stdlib.Test.all(
    [ (~0u32) |> Stdlib.Test.equal(4294967295u32)
      (~4294967295u32) |> Stdlib.Test.equal(0u32)
      (~1u32) |> Stdlib.Test.equal(4294967294u32) ])

test shiftLeft =
  Stdlib.Test.all(
    [ (1u32 << 2u32) |> Stdlib.Test.equal(4u32)
      (0u32 << 5u32) |> Stdlib.Test.equal(0u32)
      (1u32 << 0u32) |> Stdlib.Test.equal(1u32)
      (1u32 << 31u32) |> Stdlib.Test.equal(2147483648u32)
      (5u32 << 3u32) |> Stdlib.Test.equal(40u32) ])

test shiftRight =
  Stdlib.Test.all(
    [ (8u32 >> 2u32) |> Stdlib.Test.equal(2u32)
      (0u32 >> 5u32) |> Stdlib.Test.equal(0u32)
      (1u32 >> 0u32) |> Stdlib.Test.equal(1u32)
      (2147483648u32 >> 31u32) |> Stdlib.Test.equal(1u32)
      (40u32 >> 3u32) |> Stdlib.Test.equal(5u32) ])

test checkedAdd =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedAdd(4294967295u32, 1u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedAdd(4294967295u32, 4294967295u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedAdd(4294967295u32, 0u32)
      |> Stdlib.Test.equal(Ok(4294967295u32))
      Stdlib.UInt32.checkedAdd(4294967294u32, 1u32)
      |> Stdlib.Test.equal(Ok(4294967295u32)) ])

test checkedSubtract =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedSubtract(0u32, 1u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedSubtract(1u32, 4294967295u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedSubtract(4294967295u32, 4294967295u32)
      |> Stdlib.Test.equal(Ok(0u32))
      Stdlib.UInt32.checkedSubtract(4294967295u32, 0u32)
      |> Stdlib.Test.equal(Ok(4294967295u32)) ])

test checkedMultiply =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedMultiply(4294967295u32, 2u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedMultiply(4294967295u32, 4294967295u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedMultiply(4294967295u32, 1u32)
      |> Stdlib.Test.equal(Ok(4294967295u32))
      Stdlib.UInt32.checkedMultiply(4294967295u32, 0u32)
      |> Stdlib.Test.equal(Ok(0u32))
      Stdlib.UInt32.checkedMultiply(2147483647u32, 2u32)
      |> Stdlib.Test.equal(Ok(4294967294u32)) ])

test checkedNegate =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedNegate(1u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedNegate(4294967295u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt32.checkedNegate(0u32) |> Stdlib.Test.equal(Ok(0u32)) ])

test checkedAbsoluteValue =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedAbsoluteValue(4294967295u32)
      |> Stdlib.Test.equal(Ok(4294967295u32))
      Stdlib.UInt32.checkedAbsoluteValue(0u32) |> Stdlib.Test.equal(Ok(0u32)) ])

/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.UInt32.checkedDivide(17u32, 3u32) |> Stdlib.Test.equal(Ok(5u32))
      Stdlib.UInt32.checkedDivide(5u32, 0u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero))
      Stdlib.UInt32.checkedMod(15u32, 6u32) |> Stdlib.Test.equal(Ok(3u32))
      Stdlib.UInt32.checkedMod(5u32, 0u32)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.ZeroModulus)) ])
