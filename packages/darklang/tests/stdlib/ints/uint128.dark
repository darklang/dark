module Darklang.Stdlib.UInt128.Tests

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max = Stdlib.max(10u128, 1u128) |> Stdlib.Test.equal(10u128)


test min =
  Stdlib.min(340282366920938463463374607431768211455u128, 0u128)
  |> Stdlib.Test.equal(0u128)


test clamp = Stdlib.clamp(100u128, 0u128, 0u128) |> Stdlib.Test.equal(0u128)


/// Wraps on overflow.
test add =
  Stdlib.Test.all(
    [ 10u128 + 9u128 |> Stdlib.Test.equal(19u128)

      88u128 + 9u128 |> Stdlib.Test.equal(97u128)

      1u128 + 0u128 |> Stdlib.Test.equal(1u128)

      55u128 + 55u128 |> Stdlib.Test.equal(110u128)

      9223372036854775807u128 + 2u128
      |> Stdlib.Test.equal(9223372036854775809u128)

      170141183460469231731687303715884105726u128 + 4u128
      |> Stdlib.Test.equal(170141183460469231731687303715884105730u128)

      340282366920938463463374607431768211455u128 + 1u128
      |> Stdlib.Test.equal(0u128) ])


/// Wraps on overflow.
test subtract =
  Stdlib.Test.all(
    [ 10u128 - 9u128 |> Stdlib.Test.equal(1u128)
      88u128 - 9u128 |> Stdlib.Test.equal(79u128)
      1u128 - 0u128 |> Stdlib.Test.equal(1u128) ])


/// Wraps on overflow.
test multiply =
  Stdlib.Test.all(
    [ 8u128 * 8u128 |> Stdlib.Test.equal(64u128)

      1u128 * 0u128 |> Stdlib.Test.equal(0u128)

      340282366920938463463374607431768211455u128 * 2u128
      |> Stdlib.Test.equal(340282366920938463463374607431768211454u128) ])


test divide =
  Stdlib.Test.all(
    [ 10u128 / 5u128 |> Stdlib.Test.equal(2u128)
      17u128 / 3u128 |> Stdlib.Test.equal(5u128)
      0u128 / 1u128 |> Stdlib.Test.equal(0u128) ])


test divideOfOneRejectsZero =
  1u128 / 0u128
  => raises "Cannot divide by 0"


test greaterThan =
  Stdlib.Test.all(
    [ 20u128 > 1u128 |> Stdlib.Test.equal(true)

      20u128 > 170141183460469231731687303715884105727u128
      |> Stdlib.Test.equal(false) ])


test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ 0u128 >= 1u128 |> Stdlib.Test.equal(false)
      1u128 >= 0u128 |> Stdlib.Test.equal(true)
      6u128 >= 1u128 |> Stdlib.Test.equal(true)
      6u128 >= 8u128 |> Stdlib.Test.equal(false) ])


test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ 6u128 <= 8u128 |> Stdlib.Test.equal(true)
      10u128 <= 1u128 |> Stdlib.Test.equal(false)
      0u128 <= 1u128 |> Stdlib.Test.equal(true)
      1u128 <= 0u128 |> Stdlib.Test.equal(false) ])


test lessThan =
  Stdlib.Test.all(
    [ 6u128 < 8u128 |> Stdlib.Test.equal(true)
      10u128 < 1u128 |> Stdlib.Test.equal(false)
      0u128 < 1u128 |> Stdlib.Test.equal(true)
      1u128 < 0u128 |> Stdlib.Test.equal(false) ])


test toString =
  Stdlib.Test.all(
    [ Stdlib.display(0u128) |> Stdlib.Test.equal("0")

      Stdlib.display(1u128) |> Stdlib.Test.equal("1")

      Stdlib.display(340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal("340282366920938463463374607431768211455") ])


test toFloat64 =
  Stdlib.Test.all(
    [ Stdlib.UInt128.toFloat64(2u128) |> Stdlib.Test.equal(2.0)

      Stdlib.UInt128.toFloat64(340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(3.402823669209385e38) ])


test sqrt =
  Stdlib.Test.all(
    [ Stdlib.UInt128.sqrt(4u128) |> Stdlib.Test.equal(2.0)
      Stdlib.UInt128.sqrt(100u128) |> Stdlib.Test.equal(10.0)
      Stdlib.UInt128.sqrt(86u128) |> Stdlib.Test.equal(9.273618495495704) ])


/// `%` wraps into [0, b), and raises when b <= 0.
test modulo =
  Stdlib.Test.all(
    [ 15u128 % 5u128 |> Stdlib.Test.equal(0u128)
      15u128 % 6u128 |> Stdlib.Test.equal(3u128)
      0u128 % 15u128 |> Stdlib.Test.equal(0u128)
      127u128 % 3u128 |> Stdlib.Test.equal(1u128) ])


test moduloRejectsZero =
  5u128 % 0u128
  => raises "Cannot evaluate modulus against 0"


test parse =
  Stdlib.Test.all(
    [ // parses OK
      Stdlib.UInt128.parse("0")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128))

      Stdlib.UInt128.parse("1")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.parse(" 1")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.parse("1 ")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.parse("+1")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.parse(" +1 ")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      // "octal" format ignored
      Stdlib.UInt128.parse("078")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(78u128))

      Stdlib.UInt128.parse("170141183460469231731687303715884105727")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(170141183460469231731687303715884105727u128))

      Stdlib.UInt128.parse("170141183460469231731687303715884105729")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(170141183460469231731687303715884105729u128)) ])


test parseBadFormat =
  Stdlib.Test.all(
    [ // bad format
      Stdlib.UInt128.parse("1 2 3")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("+ 1")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("0xA")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("0x123")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("0b0100")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("pi")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("Stdlib.Math.pi")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("1.23E+04")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("1I")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("one")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat))

      Stdlib.UInt128.parse("XIV")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.UInt128.ParseError.BadFormat)) ])


test fromUInt8 =
  Stdlib.Test.all(
    [ Stdlib.UInt128.fromUInt8(0u8) |> Stdlib.Test.equal(0u128)
      Stdlib.UInt128.fromUInt8(1u8) |> Stdlib.Test.equal(1u128)
      Stdlib.UInt128.fromUInt8(255u8) |> Stdlib.Test.equal(255u128) ])


test fromUInt16 =
  Stdlib.Test.all(
    [ Stdlib.UInt128.fromUInt16(0u16) |> Stdlib.Test.equal(0u128)
      Stdlib.UInt128.fromUInt16(1u16) |> Stdlib.Test.equal(1u128)
      Stdlib.UInt128.fromUInt16(65535u16) |> Stdlib.Test.equal(65535u128) ])


test fromUInt32 =
  Stdlib.Test.all(
    [ Stdlib.UInt128.fromUInt32(0u32) |> Stdlib.Test.equal(0u128)

      Stdlib.UInt128.fromUInt32(1u32) |> Stdlib.Test.equal(1u128)

      Stdlib.UInt128.fromUInt32(4294967295u32)
      |> Stdlib.Test.equal(4294967295u128) ])


test fromUInt64 =
  Stdlib.Test.all(
    [ Stdlib.UInt128.fromUInt64(0u64) |> Stdlib.Test.equal(0u128)

      Stdlib.UInt128.fromUInt64(1u64) |> Stdlib.Test.equal(1u128)

      Stdlib.UInt128.fromUInt64(18446744073709551615u64)
      |> Stdlib.Test.equal(18446744073709551615u128) ])


test bitwiseAnd =
  Stdlib.Test.all(
    [ 12u128 & 10u128 |> Stdlib.Test.equal(8u128)
      0u128 & 0u128 |> Stdlib.Test.equal(0u128)
      255u128 & 0u128 |> Stdlib.Test.equal(0u128)
      255u128 & 255u128 |> Stdlib.Test.equal(255u128) ])


test bitwiseOr =
  Stdlib.Test.all(
    [ 12u128 | 10u128 |> Stdlib.Test.equal(14u128)
      0u128 | 0u128 |> Stdlib.Test.equal(0u128)
      255u128 | 0u128 |> Stdlib.Test.equal(255u128) ])


test bitwiseXor =
  Stdlib.Test.all(
    [ 12u128 ^ 10u128 |> Stdlib.Test.equal(6u128)
      0u128 ^ 0u128 |> Stdlib.Test.equal(0u128)
      255u128 ^ 255u128 |> Stdlib.Test.equal(0u128) ])


test bitwiseNot =
  Stdlib.Test.all(
    [ ~0u128 |> Stdlib.Test.equal(340282366920938463463374607431768211455u128)
      ~340282366920938463463374607431768211455u128 |> Stdlib.Test.equal(0u128)
      ~1u128
      |> Stdlib.Test.equal(340282366920938463463374607431768211454u128) ])


test shiftLeft =
  Stdlib.Test.all(
    [ 1u128 << 2u128 |> Stdlib.Test.equal(4u128)
      0u128 << 5u128 |> Stdlib.Test.equal(0u128)
      1u128 << 0u128 |> Stdlib.Test.equal(1u128)
      5u128 << 3u128 |> Stdlib.Test.equal(40u128) ])


test shiftRight =
  Stdlib.Test.all(
    [ 8u128 >> 2u128 |> Stdlib.Test.equal(2u128)
      0u128 >> 5u128 |> Stdlib.Test.equal(0u128)
      1u128 >> 0u128 |> Stdlib.Test.equal(1u128)
      40u128 >> 3u128 |> Stdlib.Test.equal(5u128) ])


/// The shift count is taken modulo 128, as in Rust and C#: shifting by 129
/// shifts by 1, and the largest count shifts by 127.
test shiftCountWraps =
  Stdlib.Test.all(
    [ 1u128 << 128u128 |> Stdlib.Test.equal(1u128)

      1u128 << 129u128 |> Stdlib.Test.equal(2u128)

      64u128 >> 129u128 |> Stdlib.Test.equal(32u128)

      1u128 << 340282366920938463463374607431768211455u128
      |> Stdlib.Test.equal(170141183460469231731687303715884105728u128) ])


test checkedAdd =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedAdd(
        340282366920938463463374607431768211455u128,
        1u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedAdd(
        340282366920938463463374607431768211455u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedAdd(
        340282366920938463463374607431768211455u128,
        0u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211455u128))

      Stdlib.UInt128.checkedAdd(
        340282366920938463463374607431768211454u128,
        1u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211455u128)) ])


test checkedSubtract =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedSubtract(0u128, 1u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedSubtract(
        1u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedSubtract(
        340282366920938463463374607431768211455u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128))

      Stdlib.UInt128.checkedSubtract(
        340282366920938463463374607431768211455u128,
        0u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211455u128)) ])


test checkedMultiply =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedMultiply(
        340282366920938463463374607431768211455u128,
        2u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedMultiply(
        340282366920938463463374607431768211455u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedMultiply(
        340282366920938463463374607431768211455u128,
        1u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211455u128))

      Stdlib.UInt128.checkedMultiply(
        340282366920938463463374607431768211455u128,
        0u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128))

      Stdlib.UInt128.checkedMultiply(
        170141183460469231731687303715884105727u128,
        2u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211454u128)) ])


test checkedNegate =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedNegate(1u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedNegate(340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.UInt128.checkedNegate(0u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128)) ])


test checkedAbsoluteValue =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedAbsoluteValue(
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463463374607431768211455u128))

      Stdlib.UInt128.checkedAbsoluteValue(0u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128)) ])


/// `checkedPower` returns what `**` computes, and the reason where it raises or wraps.
test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedPower(2u128, 127u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(170141183460469231731687303715884105728u128))

      Stdlib.UInt128.checkedPower(2u128, 128u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.Overflow))

      Stdlib.UInt128.checkedPower(18446744073709551615u128, 2u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(340282366920938463426481119284349108225u128))

      Stdlib.UInt128.checkedPower(18446744073709551616u128, 2u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.Overflow))

      Stdlib.UInt128.checkedPower(3u128, 0u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.checkedPower(0u128, 0u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.checkedPower(
        0u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0u128))

      Stdlib.UInt128.checkedPower(
        1u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1u128))

      Stdlib.UInt128.checkedPower(
        2u128,
        340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.Overflow)) ])


/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.UInt128.checkedDivide(17u128, 3u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(5u128))

      Stdlib.UInt128.checkedDivide(5u128, 0u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.DivisionError.DivisionByZero))

      Stdlib.UInt128.checkedMod(15u128, 6u128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3u128))

      Stdlib.UInt128.checkedMod(5u128, 0u128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.ModulusError.ZeroModulus)) ])
