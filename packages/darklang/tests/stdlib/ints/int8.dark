module Darklang.Stdlib.Int8.Tests

test abs =
  Stdlib.Test.all(
    [ Stdlib.abs(-5s8) |> Stdlib.Test.equal(5s8)
      Stdlib.abs(5s8) |> Stdlib.Test.equal(5s8)
      Stdlib.abs(-128s8) |> Stdlib.Test.equal(-128s8) ])


// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max = Stdlib.max(127s8, -128s8) |> Stdlib.Test.equal(127s8)


test min = Stdlib.min(127s8, -128s8) |> Stdlib.Test.equal(-128s8)


test clamp = Stdlib.clamp(-100s8, 0s8, -1s8) |> Stdlib.Test.equal(-1s8)


test negate =
  Stdlib.Test.all(
    [ -(-5s8) |> Stdlib.Test.equal(5s8)
      -(5s8) |> Stdlib.Test.equal(-5s8)
      0s8 |> Stdlib.Test.equal(0s8)
      -(0s8) |> Stdlib.Test.equal(0s8)
      -(-128s8) |> Stdlib.Test.equal(-128s8) ])


/// A Result: the sign follows the dividend, and it is an Error only when the
/// divisor is 0.
test remainder =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedRemainder(15, 6)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))

      Stdlib.Int8.checkedRemainder(20, 8)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(4))

      Stdlib.Int8.checkedRemainder(-20, 8)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-4))

      Stdlib.Int8.checkedRemainder(-20, -8)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-4))

      Stdlib.Int8.checkedRemainder(-15, 6)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-3))

      Stdlib.Int8.checkedRemainder(-128, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Stdlib.Int8.checkedRemainder(5, 0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.DivisionError.DivisionByZero)) ])


/// Wraps on overflow.
test add =
  Stdlib.Test.all(
    [ 10s8 + 9s8 |> Stdlib.Test.equal(19s8)
      10s8 + 0s8 |> Stdlib.Test.equal(10s8)
      88s8 + 9s8 |> Stdlib.Test.equal(97s8)
      -1s8 + 2s8 |> Stdlib.Test.equal(1s8)
      1s8 + 0s8 |> Stdlib.Test.equal(1s8)
      -55s8 + 55s8 |> Stdlib.Test.equal(0s8)
      55s8 + 55s8 |> Stdlib.Test.equal(110s8)
      Test.Values.int8Value + 5 |> Stdlib.Test.equal(10)
      127s8 + 1s8 |> Stdlib.Test.equal(-128s8)
      -128s8 + -1s8 |> Stdlib.Test.equal(127s8)
      -100s8 + -30s8 |> Stdlib.Test.equal(126s8)
      100s8 + 30s8 |> Stdlib.Test.equal(-126s8) ])


/// Wraps on overflow.
test subtract =
  Stdlib.Test.all(
    [ 10s8 - 9s8 |> Stdlib.Test.equal(1s8)
      88s8 - 9s8 |> Stdlib.Test.equal(79s8)
      0s8 - 1s8 |> Stdlib.Test.equal(-1s8)
      1s8 - 0s8 |> Stdlib.Test.equal(1s8)
      -55s8 - -55s8 |> Stdlib.Test.equal(0s8)
      -2s8 - 127s8 |> Stdlib.Test.equal(127s8)
      -55s8 - 100s8 |> Stdlib.Test.equal(101s8) ])


/// Wraps on overflow.
test multiply =
  Stdlib.Test.all(
    [ 8s8 * 8s8 |> Stdlib.Test.equal(64s8)
      1s8 * 0s8 |> Stdlib.Test.equal(0s8)
      64s8 * 2s8 |> Stdlib.Test.equal(-128s8)
      -128s8 * -1s8 |> Stdlib.Test.equal(-128s8) ])


/// Wraps on overflow.
test power =
  Stdlib.Test.all(
    [ 2s8 ** 3s8 |> Stdlib.Test.equal(8s8)
      0s8 ** 1s8 |> Stdlib.Test.equal(0s8)
      1s8 ** 0s8 |> Stdlib.Test.equal(1s8)
      0s8 ** 0s8 |> Stdlib.Test.equal(1s8)
      -2s8 ** 5s8 |> Stdlib.Test.equal(-32s8)
      -1s8 ** 5s8 |> Stdlib.Test.equal(-1s8)
      -1s8 ** 6s8 |> Stdlib.Test.equal(1s8)
      1s8 ** 127s8 |> Stdlib.Test.equal(1s8)
      3s8 ** 5s8 |> Stdlib.Test.equal(-13s8)
      120s8 ** 20s8 |> Stdlib.Test.equal(0s8) ])


test powerRejectsNegativeExponent =
  2s8 ** -3s8
  => raises "Cannot raise integer to a negative exponent"


test powerOfZeroRejectsNegativeExponent =
  0s8 ** -1s8
  => raises "Cannot raise integer to a negative exponent"


test powerOfOneRejectsNegativeExponent =
  1s8 ** -5s8
  => raises "Cannot raise integer to a negative exponent"


test powerOfMinusOneRejectsNegativeExponent =
  -1s8 ** -3s8
  => raises "Cannot raise integer to a negative exponent"


test divide =
  Stdlib.Test.all(
    [ 10s8 / 5s8 |> Stdlib.Test.equal(2s8)
      17s8 / 3s8 |> Stdlib.Test.equal(5s8)
      -8s8 / 5s8 |> Stdlib.Test.equal(-1s8)
      0s8 / 1s8 |> Stdlib.Test.equal(0s8)
      -128s8 / -1s8 |> Stdlib.Test.equal(-128s8) ])


test divideOfOneRejectsZero =
  1s8 / 0s8
  => raises "Cannot divide by 0"


test greaterThan =
  Stdlib.Test.all(
    [ 20s8 > 1s8 |> Stdlib.Test.equal(true)
      20s8 > 127s8 |> Stdlib.Test.equal(false) ])


test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ 0s8 >= 1s8 |> Stdlib.Test.equal(false)
      1s8 >= 0s8 |> Stdlib.Test.equal(true)
      6s8 >= 1s8 |> Stdlib.Test.equal(true)
      6s8 >= 8s8 |> Stdlib.Test.equal(false)
      -5s8 >= -20s8 |> Stdlib.Test.equal(true)
      -20s8 >= -1s8 |> Stdlib.Test.equal(false)
      -20s8 >= -20s8 |> Stdlib.Test.equal(true)
      -128s8 >= -20s8 |> Stdlib.Test.equal(false) ])


test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ 6s8 <= 8s8 |> Stdlib.Test.equal(true)
      10s8 <= 1s8 |> Stdlib.Test.equal(false)
      0s8 <= 1s8 |> Stdlib.Test.equal(true)
      1s8 <= 0s8 |> Stdlib.Test.equal(false) ])


test lessThan =
  Stdlib.Test.all(
    [ -128s8 < 127s8 |> Stdlib.Test.equal(true)
      6s8 < 8s8 |> Stdlib.Test.equal(true)
      10s8 < 1s8 |> Stdlib.Test.equal(false)
      0s8 < 1s8 |> Stdlib.Test.equal(true)
      1s8 < 0s8 |> Stdlib.Test.equal(false) ])


test toString =
  Stdlib.Test.all(
    [ Stdlib.display(0s8) |> Stdlib.Test.equal("0")
      Stdlib.display(1s8) |> Stdlib.Test.equal("1")
      Stdlib.display(-1s8) |> Stdlib.Test.equal("-1")
      // Int8 lower limit
      Stdlib.display(-128s8) |> Stdlib.Test.equal("-128")
      // Int8 upper limit
      Stdlib.display(127s8) |> Stdlib.Test.equal("127") ])


test toFloat64 =
  Stdlib.Test.all(
    [ Stdlib.Int8.toFloat64(2) |> Stdlib.Test.equal(2.0)
      Stdlib.Int8.toFloat64(127) |> Stdlib.Test.equal(127.0)
      Stdlib.Int8.toFloat64(-128) |> Stdlib.Test.equal(-128.0)
      Stdlib.Int8.toFloat64(-10) |> Stdlib.Test.equal(-10.0) ])


test sqrt =
  Stdlib.Test.all(
    [ Stdlib.Int8.sqrt(4) |> Stdlib.Test.equal(2.0)
      Stdlib.Int8.sqrt(100) |> Stdlib.Test.equal(10.0)
      Stdlib.Int8.sqrt(86) |> Stdlib.Test.equal(9.273618495495704) ])


/// `%` wraps into [0, b), and raises when b <= 0.
test modulo =
  Stdlib.Test.all(
    [ 15s8 % 5s8 |> Stdlib.Test.equal(0s8)
      15s8 % 6s8 |> Stdlib.Test.equal(3s8)
      0s8 % 15s8 |> Stdlib.Test.equal(0s8)
      -1s8 % 2s8 |> Stdlib.Test.equal(1s8)
      -128s8 % 53s8 |> Stdlib.Test.equal(31s8)
      127s8 % 3s8 |> Stdlib.Test.equal(1s8) ])


test moduloRejectsZero =
  5s8 % 0s8
  => raises "Cannot evaluate modulus against 0"


test moduloRejectsNegativeDivisor =
  5s8 % -5s8
  => raises "Cannot evaluate modulus against a negative number"


test parse =
  Stdlib.Test.all(
    [ // ok
      Stdlib.Int8.parse("0") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Stdlib.Int8.parse("1") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.parse(" 1") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.parse("1 ") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.parse("+1") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.parse(" +1 ") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.parse("-1") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1))

      // "octal" format ignored
      Stdlib.Int8.parse("078") |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(78))

      Stdlib.Int8.parse("-00001")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1))

      Stdlib.Int8.parse("127")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(127))

      Stdlib.Int8.parse("-128")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-128)) ])


test parseOutOfRange =
  Stdlib.Test.all(
    [ Stdlib.Int8.parse("-10001")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.OutOfRange))

      // out of range
      Stdlib.Int8.parse("128")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.OutOfRange))

      Stdlib.Int8.parse("-129")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.OutOfRange)) ])


test parseBadFormat =
  Stdlib.Test.all(
    [ // bad format
      Stdlib.Int8.parse("1 2 3")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("+ 1")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("- 1")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("0xA")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("0x123")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("0b0100")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("pi")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("Darklang.Stdlib.Math.pi")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("1.23E+04")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("1I")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("one")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat))

      Stdlib.Int8.parse("XIV")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Int8.ParseError.BadFormat)) ])


test fromUInt8 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromUInt8(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromUInt8(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromUInt8(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromUInt8(128) |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromUInt8(255)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromInt16 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromInt16(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromInt16(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromInt16(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromInt16(128) |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromInt16(-1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-1))

      Stdlib.Int8.fromInt16(-128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-128))

      Stdlib.Int8.fromInt16(-129)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromUInt16 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromUInt16(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromUInt16(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromUInt16(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromUInt16(128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromUInt16(255)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromInt32 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromInt32(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromInt32(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromInt32(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromInt32(128) |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromInt32(-1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-1))

      Stdlib.Int8.fromInt32(-128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-128))

      Stdlib.Int8.fromInt32(-129)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromInt32(2147483647)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromUInt32 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromUInt32(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromUInt32(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromUInt32(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromUInt32(128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromUInt32(4294967295)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromInt64 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromInt64(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromInt64(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromInt64(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromInt64(128) |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromInt64(-1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-1))

      Stdlib.Int8.fromInt64(-128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-128))

      Stdlib.Int8.fromInt64(-129)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromUInt64 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromUInt64(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromUInt64(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromUInt64(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromUInt64(128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromUInt64(255)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromInt128 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromInt128(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromInt128(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromInt128(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromInt128(128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromInt128(-1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-1))

      Stdlib.Int8.fromInt128(-128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(-128))

      Stdlib.Int8.fromInt128(-129)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test fromUInt128 =
  Stdlib.Test.all(
    [ Stdlib.Int8.fromUInt128(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Int8.fromUInt128(1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1))

      Stdlib.Int8.fromUInt128(127)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(127))

      Stdlib.Int8.fromUInt128(128)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Int8.fromUInt128(255)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test bitwiseAnd =
  Stdlib.Test.all(
    [ 12s8 & 10s8 |> Stdlib.Test.equal(8s8)
      0s8 & 0s8 |> Stdlib.Test.equal(0s8)
      -1s8 & 0s8 |> Stdlib.Test.equal(0s8)
      127s8 & 127s8 |> Stdlib.Test.equal(127s8)
      -128s8 & -1s8 |> Stdlib.Test.equal(-128s8)
      127s8 & -128s8 |> Stdlib.Test.equal(0s8)
      -1s8 & -1s8 |> Stdlib.Test.equal(-1s8) ])


test bitwiseOr =
  Stdlib.Test.all(
    [ 12s8 | 10s8 |> Stdlib.Test.equal(14s8)
      0s8 | 0s8 |> Stdlib.Test.equal(0s8)
      -1s8 | 0s8 |> Stdlib.Test.equal(-1s8)
      127s8 | 0s8 |> Stdlib.Test.equal(127s8)
      -128s8 | 0s8 |> Stdlib.Test.equal(-128s8)
      127s8 | -128s8 |> Stdlib.Test.equal(-1s8) ])


test bitwiseXor =
  Stdlib.Test.all(
    [ 12s8 ^ 10s8 |> Stdlib.Test.equal(6s8)
      0s8 ^ 0s8 |> Stdlib.Test.equal(0s8)
      -1s8 ^ -1s8 |> Stdlib.Test.equal(0s8)
      127s8 ^ -1s8 |> Stdlib.Test.equal(-128s8)
      -128s8 ^ -1s8 |> Stdlib.Test.equal(127s8)
      127s8 ^ 127s8 |> Stdlib.Test.equal(0s8) ])


test bitwiseNot =
  Stdlib.Test.all(
    [ ~0s8 |> Stdlib.Test.equal(-1s8)
      ~-1s8 |> Stdlib.Test.equal(0s8)
      ~127s8 |> Stdlib.Test.equal(-128s8)
      ~-128s8 |> Stdlib.Test.equal(127s8)
      ~1s8 |> Stdlib.Test.equal(-2s8) ])


test shiftLeft =
  Stdlib.Test.all(
    [ 1s8 << 2s8 |> Stdlib.Test.equal(4s8)
      0s8 << 5s8 |> Stdlib.Test.equal(0s8)
      1s8 << 0s8 |> Stdlib.Test.equal(1s8)
      1s8 << 6s8 |> Stdlib.Test.equal(64s8)
      5s8 << 3s8 |> Stdlib.Test.equal(40s8) ])


test shiftRight =
  Stdlib.Test.all(
    [ 8s8 >> 2s8 |> Stdlib.Test.equal(2s8)
      0s8 >> 5s8 |> Stdlib.Test.equal(0s8)
      1s8 >> 0s8 |> Stdlib.Test.equal(1s8)
      64s8 >> 6s8 |> Stdlib.Test.equal(1s8)
      -1s8 >> 1s8 |> Stdlib.Test.equal(-1s8)
      40s8 >> 3s8 |> Stdlib.Test.equal(5s8) ])


/// The shift count is taken modulo 8, as in Rust and C#: shifting by 9
/// shifts by 1, and a count of -1 shifts by 7.
test shiftCountWraps =
  Stdlib.Test.all(
    [ 1s8 << 8s8 |> Stdlib.Test.equal(1s8)
      1s8 << 9s8 |> Stdlib.Test.equal(2s8)
      64s8 >> 9s8 |> Stdlib.Test.equal(32s8)
      1s8 << -1s8 |> Stdlib.Test.equal(-128s8) ])


test checkedAdd =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedAdd(127, 1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedAdd(-128, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedAdd(127, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(126))

      Stdlib.Int8.checkedAdd(-128, 1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-127))

      Stdlib.Int8.checkedAdd(127, -128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1))

      Stdlib.Int8.checkedAdd(-128, 0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-128)) ])


test checkedSubtract =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedSubtract(-128, 1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedSubtract(127, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedSubtract(0, -128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedSubtract(-1, -128)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(127))

      Stdlib.Int8.checkedSubtract(127, 127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Stdlib.Int8.checkedSubtract(-128, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-127)) ])


test checkedMultiply =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedMultiply(127, 2)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedMultiply(-128, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedMultiply(-1, -128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedMultiply(-128, 2)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedMultiply(127, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-127))

      Stdlib.Int8.checkedMultiply(-128, 1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-128))

      Stdlib.Int8.checkedMultiply(-128, 0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Stdlib.Int8.checkedMultiply(-2, 63)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-126)) ])


test checkedNegate =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedNegate(-128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedNegate(127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-127))

      Stdlib.Int8.checkedNegate(0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0)) ])


test checkedAbsoluteValue =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedAbsoluteValue(-128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Int8.checkedAbsoluteValue(-127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(127))

      Stdlib.Int8.checkedAbsoluteValue(127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(127))

      Stdlib.Int8.checkedAbsoluteValue(0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0)) ])


/// `checkedPower` returns what `**` computes, and the reason where it raises or wraps.
test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedPower(2, 6)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(64))

      Stdlib.Int8.checkedPower(2, 7)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.Overflow))

      Stdlib.Int8.checkedPower(-2, 7)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-128))

      Stdlib.Int8.checkedPower(-2, 6)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(64))

      Stdlib.Int8.checkedPower(3, 0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.checkedPower(0, 0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.checkedPower(0, 127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Stdlib.Int8.checkedPower(1, 127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.checkedPower(2, 127)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.Overflow))

      Stdlib.Int8.checkedPower(-1, 127)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1))

      Stdlib.Int8.checkedPower(-1, 126)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.checkedPower(2, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.NegativeExponent))

      Stdlib.Int8.checkedPower(0, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.NegativeExponent))

      Stdlib.Int8.checkedPower(1, -128)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.PowerError.NegativeExponent)) ])


/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedDivide(17, 3)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(5))

      Stdlib.Int8.checkedDivide(-8, 5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1))

      Stdlib.Int8.checkedDivide(-128, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.DivisionError.Overflow))

      Stdlib.Int8.checkedDivide(-128, 1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-128))

      Stdlib.Int8.checkedDivide(-127, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(127))

      Stdlib.Int8.checkedDivide(127, -1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-127))

      Stdlib.Int8.checkedDivide(-128, -2)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(64))

      Stdlib.Int8.checkedDivide(5, 0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.DivisionError.DivisionByZero))

      Stdlib.Int8.checkedMod(15, 6)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))

      Stdlib.Int8.checkedMod(-1, 2)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Stdlib.Int8.checkedMod(5, 0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.ModulusError.ZeroModulus))

      Stdlib.Int8.checkedMod(5, -1)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.ModulusError.NegativeModulus)) ])


test checkedSqrt =
  Stdlib.Test.all(
    [ Stdlib.Int8.checkedSqrt(4)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(2.0))

      Stdlib.Int8.checkedSqrt(-4)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.NotANumber)) ])
