module Darklang.Stdlib.UInt64.Tests

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check
// that it reaches this type and that the type's own comparison holds at its
// extremes.

test max =
  Stdlib.max(10u64, 1u64) |> Stdlib.Test.equal(10u64)

test min =
  Stdlib.min(18446744073709551615u64, 0u64) |> Stdlib.Test.equal(0u64)

test clamp =
  Stdlib.clamp(100u64, 0u64, 0u64) |> Stdlib.Test.equal(0u64)

/// `%` wraps into [0, b), and raises when b <= 0.
test modulo =
  Stdlib.Test.all(
    [ (15u64 % 5u64) |> Stdlib.Test.equal(0u64)
      (15u64 % 6u64) |> Stdlib.Test.equal(3u64)
      (0u64 % 15u64) |> Stdlib.Test.equal(0u64)
      (9999999999998u64 % 3u64) |> Stdlib.Test.equal(2u64) ])

test moduloRejectsZero =
  (5u64 % 0u64)
  => raises "Cannot evaluate modulus against 0"

/// Wraps on overflow.
test power =
  Stdlib.Test.all(
    [ (8u64 ** 5u64) |> Stdlib.Test.equal(32768u64)
      (0u64 ** 1u64) |> Stdlib.Test.equal(0u64)
      (0u64 ** 0u64) |> Stdlib.Test.equal(1u64)
      (1u64 ** 0u64) |> Stdlib.Test.equal(1u64)
      (1000u64 ** 0u64) |> Stdlib.Test.equal(1u64)
      (200u64 ** 20u64) |> Stdlib.Test.equal(1152921504606846976u64)
      (200u64 ** 7u64) |> Stdlib.Test.equal(12800000000000000u64)
      (1u64 ** 2147483649u64) |> Stdlib.Test.equal(1u64)
      // Non-trivial base with a huge (out-of-Int32-range) exponent wraps via modular
      // exponentiation, which stays cheap instead of building an enormous bigint.
      (2u64 ** 2147483649u64) |> Stdlib.Test.equal(0u64)
      (2u64 ** 64u64) |> Stdlib.Test.equal(0u64) ])

test greaterThan =
  (20u64 > 1u64) |> Stdlib.Test.equal(true)

test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ (0u64 >= 1u64) |> Stdlib.Test.equal(false)
      (1u64 >= 0u64) |> Stdlib.Test.equal(true)
      (6u64 >= 1u64) |> Stdlib.Test.equal(true)
      (6u64 >= 8u64) |> Stdlib.Test.equal(false) ])

test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ (6u64 <= 8u64) |> Stdlib.Test.equal(true)
      (10u64 <= 1u64) |> Stdlib.Test.equal(false)
      (0u64 <= 1u64) |> Stdlib.Test.equal(true)
      (1u64 <= 0u64) |> Stdlib.Test.equal(false) ])

test lessThan =
  Stdlib.Test.all(
    [ (6u64 < 8u64) |> Stdlib.Test.equal(true)
      (10u64 < 1u64) |> Stdlib.Test.equal(false)
      (0u64 < 1u64) |> Stdlib.Test.equal(true)
      (1u64 < 0u64) |> Stdlib.Test.equal(false) ])

test sqrt =
  Stdlib.Test.all(
    [ Stdlib.UInt64.sqrt(4u64) |> Stdlib.Test.equal(2.0)
      Stdlib.UInt64.sqrt(100u64) |> Stdlib.Test.equal(10.0)
      Stdlib.UInt64.sqrt(86u64) |> Stdlib.Test.equal(9.273618495495704) ])

test toFloat =
  Stdlib.Test.all(
    [ Stdlib.UInt64.toFloat(2u64) |> Stdlib.Test.equal(2.0)
      Stdlib.UInt64.toFloat(955656u64) |> Stdlib.Test.equal(955656.0) ])

test fromFloat =
  Stdlib.Test.all(
    [ // fromFloat truncates toward zero, like BigInt.fromFloat; fromFloatRounded rounds
      Stdlib.UInt64.fromFloat(3.9) |> Stdlib.Test.equal(Some(3u64))
      Stdlib.UInt64.fromFloat(-0.9) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromFloat(-1.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloat(0.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloat(1.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloat(-1.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloat(18446744073709551616.0) |> Stdlib.Test.equal(None) ])

test fromFloatRounded =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromFloatRounded(3.9) |> Stdlib.Test.equal(Some(4u64))
      Stdlib.UInt64.fromFloatRounded(-1.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloatRounded(0.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloatRounded(1.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloatRounded(-1.0 / 0.0) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromFloatRounded(2.5) |> Stdlib.Test.equal(Some(2u64))
      Stdlib.UInt64.fromFloatRounded(3.5) |> Stdlib.Test.equal(Some(4u64)) ])

/// Wraps on overflow.
test add =
  Stdlib.Test.all(
    [ (10u64 + 9u64) |> Stdlib.Test.equal(19u64)
      (88u64 + 9u64) |> Stdlib.Test.equal(97u64)
      (1u64 + 0u64) |> Stdlib.Test.equal(1u64)
      (18446744073709551614u64 + 1u64) |> Stdlib.Test.equal(18446744073709551615u64)
      // Overflow tests
      (18446744073709551615u64 + 1u64) |> Stdlib.Test.equal(0u64)
      (55u64 + 18446744073709551615u64) |> Stdlib.Test.equal(54u64) ])

/// Wraps on overflow.
test subtract =
  Stdlib.Test.all(
    [ (10u64 - 9u64) |> Stdlib.Test.equal(1u64)
      (88u64 - 9u64) |> Stdlib.Test.equal(79u64)
      (1u64 - 0u64) |> Stdlib.Test.equal(1u64) ])

/// Wraps on overflow.
test multiply =
  Stdlib.Test.all(
    [ (8u64 * 8u64) |> Stdlib.Test.equal(64u64)
      (5145u64 * 5145u64) |> Stdlib.Test.equal(26471025u64)
      (9223372036854775808u64 * 2u64) |> Stdlib.Test.equal(0u64) ])

test divide =
  Stdlib.Test.all(
    [ (10u64 / 5u64) |> Stdlib.Test.equal(2u64)
      (17u64 / 3u64) |> Stdlib.Test.equal(5u64)
      (0u64 / 1u64) |> Stdlib.Test.equal(0u64) ])

test divideOfOneRejectsZero =
  (1u64 / 0u64)
  => raises "Cannot divide by 0"

test sum =
  Stdlib.sum(0u64, [ 1u64, 2u64 ]) |> Stdlib.Test.equal(3u64)

test parse =
  Stdlib.Test.all(
    [ // parses OK
      Stdlib.UInt64.parse("0") |> Stdlib.Test.equal(Ok(0u64))
      Stdlib.UInt64.parse("1") |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.parse(" 1") |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.parse("1 ") |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.parse("+1") |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.parse(" +1 ") |> Stdlib.Test.equal(Ok(1u64))
      // "octal" format ignored
      Stdlib.UInt64.parse("078") |> Stdlib.Test.equal(Ok(78u64))
      Stdlib.UInt64.parse("18446744073709551615")
      |> Stdlib.Test.equal(Ok(18446744073709551615u64)) ])

test parseOutOfRange =
  Stdlib.Test.all(
    [ Stdlib.UInt64.parse("-1")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.OutOfRange))
      Stdlib.UInt64.parse("-00001")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.OutOfRange))
      Stdlib.UInt64.parse("-10001")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.OutOfRange))
      Stdlib.UInt64.parse("18446744073709551616")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.OutOfRange)) ])

test parseBadFormat =
  Stdlib.Test.all(
    [ // bad format
      Stdlib.UInt64.parse("1 2 3")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("+ 1")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("- 1")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("0xA")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("0x123")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("0b0100")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("pi")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("Darklang.Stdlib.Math.pi")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("1.23E+04")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("1I")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("one")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat))
      Stdlib.UInt64.parse("XIV")
      |> Stdlib.Test.equal(Error(Stdlib.UInt64.ParseError.BadFormat)) ])

test toString =
  Stdlib.Test.all(
    [ Stdlib.toString(0u64) |> Stdlib.Test.equal("0")
      Stdlib.toString(1u64) |> Stdlib.Test.equal("1")
      Stdlib.toString(18446744073709551615u64)
      |> Stdlib.Test.equal("18446744073709551615") ])

test fromInt8 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromInt8(0s8) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromInt8(1s8) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromInt8(127s8) |> Stdlib.Test.equal(Some(127u64))
      Stdlib.UInt64.fromInt8(-128s8) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromInt8(-1s8) |> Stdlib.Test.equal(None) ])

test fromUInt8 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromUInt8(0u8) |> Stdlib.Test.equal(0u64)
      Stdlib.UInt64.fromUInt8(1u8) |> Stdlib.Test.equal(1u64)
      Stdlib.UInt64.fromUInt8(255u8) |> Stdlib.Test.equal(255u64) ])

test fromInt16 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromInt16(0s16) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromInt16(1s16) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromInt16(32767s16) |> Stdlib.Test.equal(Some(32767u64))
      Stdlib.UInt64.fromInt16(-32768s16) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromInt16(-1s16) |> Stdlib.Test.equal(None) ])

test fromUInt16 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromUInt16(0u16) |> Stdlib.Test.equal(0u64)
      Stdlib.UInt64.fromUInt16(1u16) |> Stdlib.Test.equal(1u64)
      Stdlib.UInt64.fromUInt16(65535u16) |> Stdlib.Test.equal(65535u64) ])

test fromInt32 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromInt32(0s32) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromInt32(1s32) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromInt32(2147483647s32) |> Stdlib.Test.equal(Some(2147483647u64))
      Stdlib.UInt64.fromInt32(-1s32) |> Stdlib.Test.equal(None) ])

test fromUInt32 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromUInt32(0u32) |> Stdlib.Test.equal(0u64)
      Stdlib.UInt64.fromUInt32(1u32) |> Stdlib.Test.equal(1u64)
      Stdlib.UInt64.fromUInt32(4294967295u32) |> Stdlib.Test.equal(4294967295u64) ])

test fromInt64 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromInt64(0) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromInt64(1) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromInt64(9223372036854775807)
      |> Stdlib.Test.equal(Some(9223372036854775807u64))
      Stdlib.UInt64.fromInt64(-1) |> Stdlib.Test.equal(None) ])

test fromInt128 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromInt128(0s128) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromInt128(1s128) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromInt128(-1s128) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromInt128(18446744073709551616s128) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromInt128(170141183460469231731687303715884105727s128)
      |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromInt128(18446744073709551615s128)
      |> Stdlib.Test.equal(Some(18446744073709551615u64)) ])

test fromUInt128 =
  Stdlib.Test.all(
    [ Stdlib.UInt64.fromUInt128(0u128) |> Stdlib.Test.equal(Some(0u64))
      Stdlib.UInt64.fromUInt128(1u128) |> Stdlib.Test.equal(Some(1u64))
      Stdlib.UInt64.fromUInt128(18446744073709551615u128)
      |> Stdlib.Test.equal(Some(18446744073709551615u64))
      Stdlib.UInt64.fromUInt128(18446744073709551616u128) |> Stdlib.Test.equal(None)
      Stdlib.UInt64.fromUInt128(340282366920938463463374607431768211455u128)
      |> Stdlib.Test.equal(None) ])

test bitwiseAnd =
  Stdlib.Test.all(
    [ (12u64 & 10u64) |> Stdlib.Test.equal(8u64)
      (0u64 & 0u64) |> Stdlib.Test.equal(0u64)
      (18446744073709551615u64 & 0u64) |> Stdlib.Test.equal(0u64)
      (18446744073709551615u64 & 18446744073709551615u64)
      |> Stdlib.Test.equal(18446744073709551615u64) ])

test bitwiseOr =
  Stdlib.Test.all(
    [ (12u64 | 10u64) |> Stdlib.Test.equal(14u64)
      (0u64 | 0u64) |> Stdlib.Test.equal(0u64)
      (18446744073709551615u64 | 0u64) |> Stdlib.Test.equal(18446744073709551615u64) ])

test bitwiseXor =
  Stdlib.Test.all(
    [ (12u64 ^ 10u64) |> Stdlib.Test.equal(6u64)
      (0u64 ^ 0u64) |> Stdlib.Test.equal(0u64)
      (18446744073709551615u64 ^ 18446744073709551615u64) |> Stdlib.Test.equal(0u64) ])

test bitwiseNot =
  Stdlib.Test.all(
    [ (~0u64) |> Stdlib.Test.equal(18446744073709551615u64)
      (~18446744073709551615u64) |> Stdlib.Test.equal(0u64)
      (~1u64) |> Stdlib.Test.equal(18446744073709551614u64) ])

test shiftLeft =
  Stdlib.Test.all(
    [ (1u64 << 2u64) |> Stdlib.Test.equal(4u64)
      (0u64 << 5u64) |> Stdlib.Test.equal(0u64)
      (1u64 << 0u64) |> Stdlib.Test.equal(1u64)
      (1u64 << 63u64) |> Stdlib.Test.equal(9223372036854775808u64)
      (5u64 << 3u64) |> Stdlib.Test.equal(40u64) ])

test shiftRight =
  Stdlib.Test.all(
    [ (8u64 >> 2u64) |> Stdlib.Test.equal(2u64)
      (0u64 >> 5u64) |> Stdlib.Test.equal(0u64)
      (1u64 >> 0u64) |> Stdlib.Test.equal(1u64)
      (9223372036854775808u64 >> 63u64) |> Stdlib.Test.equal(1u64)
      (40u64 >> 3u64) |> Stdlib.Test.equal(5u64) ])

/// The shift count is taken modulo 64, as in Rust and C#: shifting by 65
/// shifts by 1, and the largest count shifts by 63.
test shiftCountWraps =
  Stdlib.Test.all(
    [ (1u64 << 64u64) |> Stdlib.Test.equal(1u64)
      (1u64 << 65u64) |> Stdlib.Test.equal(2u64)
      (64u64 >> 65u64) |> Stdlib.Test.equal(32u64)
      (1u64 << 18446744073709551615u64) |> Stdlib.Test.equal(9223372036854775808u64) ])

test checkedAdd =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedAdd(18446744073709551615u64, 1u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedAdd(18446744073709551615u64, 18446744073709551615u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedAdd(18446744073709551615u64, 0u64)
      |> Stdlib.Test.equal(Ok(18446744073709551615u64))
      Stdlib.UInt64.checkedAdd(18446744073709551614u64, 1u64)
      |> Stdlib.Test.equal(Ok(18446744073709551615u64)) ])

test checkedSubtract =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedSubtract(0u64, 1u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedSubtract(1u64, 18446744073709551615u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedSubtract(18446744073709551615u64, 18446744073709551615u64)
      |> Stdlib.Test.equal(Ok(0u64))
      Stdlib.UInt64.checkedSubtract(18446744073709551615u64, 0u64)
      |> Stdlib.Test.equal(Ok(18446744073709551615u64)) ])

test checkedMultiply =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedMultiply(18446744073709551615u64, 2u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedMultiply(18446744073709551615u64, 18446744073709551615u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedMultiply(18446744073709551615u64, 1u64)
      |> Stdlib.Test.equal(Ok(18446744073709551615u64))
      Stdlib.UInt64.checkedMultiply(18446744073709551615u64, 0u64)
      |> Stdlib.Test.equal(Ok(0u64))
      Stdlib.UInt64.checkedMultiply(9223372036854775807u64, 2u64)
      |> Stdlib.Test.equal(Ok(18446744073709551614u64)) ])

test checkedNegate =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedNegate(1u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedNegate(18446744073709551615u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.Overflow.Overflow))
      Stdlib.UInt64.checkedNegate(0u64) |> Stdlib.Test.equal(Ok(0u64)) ])

test checkedAbsoluteValue =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedAbsoluteValue(18446744073709551615u64)
      |> Stdlib.Test.equal(Ok(18446744073709551615u64))
      Stdlib.UInt64.checkedAbsoluteValue(0u64) |> Stdlib.Test.equal(Ok(0u64)) ])

/// `checkedPower` returns what `**` computes, and the reason where it raises or wraps.
test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedPower(2u64, 63u64) |> Stdlib.Test.equal(Ok(9223372036854775808u64))
      Stdlib.UInt64.checkedPower(2u64, 64u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.Overflow))
      Stdlib.UInt64.checkedPower(4294967295u64, 2u64)
      |> Stdlib.Test.equal(Ok(18446744065119617025u64))
      Stdlib.UInt64.checkedPower(4294967296u64, 2u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.Overflow))
      Stdlib.UInt64.checkedPower(3u64, 0u64) |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.checkedPower(0u64, 0u64) |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.checkedPower(0u64, 18446744073709551615u64) |> Stdlib.Test.equal(Ok(0u64))
      Stdlib.UInt64.checkedPower(1u64, 18446744073709551615u64) |> Stdlib.Test.equal(Ok(1u64))
      Stdlib.UInt64.checkedPower(2u64, 18446744073709551615u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.PowerError.Overflow)) ])

/// `checkedDivide` and `checkedMod` return what `/` and `%` compute, and the reason where they raise.
test divisionResults =
  Stdlib.Test.all(
    [ Stdlib.UInt64.checkedDivide(17u64, 3u64) |> Stdlib.Test.equal(Ok(5u64))
      Stdlib.UInt64.checkedDivide(5u64, 0u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.DivisionError.DivisionByZero))
      Stdlib.UInt64.checkedMod(15u64, 6u64) |> Stdlib.Test.equal(Ok(3u64))
      Stdlib.UInt64.checkedMod(5u64, 0u64)
      |> Stdlib.Test.equal(Error(Stdlib.Math.ModulusError.ZeroModulus)) ])
