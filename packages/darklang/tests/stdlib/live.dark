module Darklang.Stdlib.Live.Tests

// `Live.dedupeTouched` and `Live.dependents`: the two places a live host decides
// WHAT to reload.
//
// What already covers them, so this file does not claim to be first: the F# test
// `poll reports an edit and affects reaches its dependents`
// (tests/CliWorkspace/live) authors a leaf, a caller and a bystander, polls a real
// watch, and checks that `affects` reaches the caller and not the bystander,
// including the transitive walk on its own. The happy path is not the gap.
//
// The gap is that a single authored edit touches ONE name, so the dedup in that test
// never meets a duplicate and never meets the case it exists for. That test would
// pass with the dedup keyed on location alone, and it would pass with no dedup at
// all. These are the cases it cannot fail on.
//
// Both dedups key on a record (`t.location`) or a tuple containing one
// (`(t.location, t.kind)`), and `Stdlib.List.uniqueBy` decides equality by Dict key
// rather than by `==`. Two ways that goes wrong and neither raises: a key the Dict
// cannot take, and a key too coarse for what it separates. The second is the
// dangerous one, because a touched name collapsed away is a host that quietly does
// not reload.

test dedupeTouched =
  Stdlib.Test.all
    [ // Same location, same kind, twice: one thing to reload.
      (Stdlib.List.length
        (Stdlib.Live.dedupeTouched
          [ Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "a" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn }
            Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "a" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn } ]))
      |> Stdlib.Test.equal 1

      // THE case a coarser key would silently eat: one name bound as a fn and as a
      // type. Two things to reload, and a dedup on location alone reports one.
      (Stdlib.List.length
        (Stdlib.Live.dedupeTouched
          [ Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "a" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn }
            Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "a" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Type } ]))
      |> Stdlib.Test.equal 2

      // Different names under the same module are different, so the key reads the
      // whole location and not just its head.
      (Stdlib.List.length
        (Stdlib.Live.dedupeTouched
          [ Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "a" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn }
            Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Demo"; modules = [ "M" ]; name = "b" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn } ]))
      |> Stdlib.Test.equal 2

      // Nothing touched is nothing to reload, rather than a raise on an empty Dict.
      Stdlib.Live.dedupeTouched [] |> Stdlib.Test.equal [] ]

test dependents =
  Stdlib.Test.all
    [ // An unknown location: not a raise, not empty, but the seed itself, because
      // the walk starts with its own frontier in `seen`. Nothing else pins what
      // this answers for a name that resolves to nothing.
      (Stdlib.List.length
        (Stdlib.Live.dependents
          [ Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Nobody"; modules = [ "Nothing" ]; name = "here" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn } ]))
      |> Stdlib.Test.equal 1

      // At real scale, where the dependency graph actually has diamonds in it. The
      // count is not asserted, since it moves with every call site anyone adds;
      // more than the seed alone is the property, and it is the precondition for
      // the assertion below meaning anything.
      (Stdlib.List.length
        (Stdlib.Live.dependents
          [ Stdlib.Live.Touched
              { location =
                  Darklang.LanguageTools.ProgramTypes.PackageLocation
                    { owner = "Darklang"
                      modules = [ "Stdlib", "List" ]
                      name = "map" }
                kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn } ]) > 1)
      |> Stdlib.Test.equal true
      // Each location ONCE. This is the `uniqueBy` inside the walk, and the one
      // thing here the F# test above does not assert: without it a diamond reports
      // the same caller once per path to it, and a host reloads it that many times.
      (let reached =
         Stdlib.Live.dependents
           [ Stdlib.Live.Touched
               { location =
                   Darklang.LanguageTools.ProgramTypes.PackageLocation
                     { owner = "Darklang"
                       modules = [ "Stdlib", "List" ]
                       name = "map" }
                 kind = Darklang.LanguageTools.ProgramTypes.ItemKind.Fn } ]
       (Stdlib.List.length reached)
       == (Stdlib.List.length (Stdlib.List.unique reached)))
      |> Stdlib.Test.equal true ]
