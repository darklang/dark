module Darklang.Stdlib.Exec.Tests

/// `select` still answers for a handle whose process finished long ago. The
/// scheduler's display table keeps the last 64 finished processes; the answer is
/// kept past that, and `select` has to find it there. The package test runner
/// selects over tests that themselves spawn work, and used to fail with "no
/// process has this handle" once enough of that work finished.
test selectAfterManyOthersFinish =
  let early = Stdlib.Exec.spawn(fun () -> 41 + 1)
  let others =
    Stdlib.List.map(Stdlib.List.range(1, 100), fun n -> Stdlib.Exec.spawn(fun () -> n))
  let _ = Stdlib.List.map(others, fun h -> Stdlib.Exec.await(h))
  let (_, value) = Stdlib.Exec.select([ early ])
  value |> Stdlib.Test.equal(42)


/// `stop` finds a process that is still running, either way of asking: `kill` does not wait
/// for the host sleep to finish, and `cancel` finds the one it is told about.
test stopARunningProcess =
  let killed = Stdlib.Exec.spawn(fun () -> Stdlib.Cli.Posix.sleep(1000.0))
  let cancelled = Stdlib.Exec.spawn(fun () -> Stdlib.Cli.Posix.sleep(1000.0))
  (Stdlib.Exec.stop(killed, Stdlib.Exec.Stop.Kill),
   Stdlib.Exec.stop(cancelled, Stdlib.Exec.Stop.Cancel))
  |> Stdlib.Test.equal((true, true))


/// A handle no process has is not there to stop, however it is asked.
test stopAnUnknownHandle =
  let h = Stdlib.Exec.Handle { id = Stdlib.Uuid.generate() }
  (Stdlib.Exec.stop(h, Stdlib.Exec.Stop.Cancel),
   Stdlib.Exec.stop(h, Stdlib.Exec.Stop.Kill),
   Stdlib.Exec.cancel(h),
   Stdlib.Exec.kill(h))
  |> Stdlib.Test.equal((false, false, false, false))
