module Darklang.Stdlib.Result.Tests

test toString =
  Stdlib.Test.all(
    [ Stdlib.toString<Result<Int64, String>>(Ok(3)) |> Stdlib.Test.equal("Ok(3)")
      Stdlib.toString<Result<Int64, String>>(Error("no"))
      |> Stdlib.Test.equal("Error(no)")
      Stdlib.toString<Result<Option<Int64>, String>>(Ok(Some(1)))
      |> Stdlib.Test.equal("Ok(Some(1))")
      Error("bad") |> (fun r -> $"got {r}")
      |> Stdlib.Test.equal("got Error(bad)") ])

test andThen =
  Stdlib.Test.all(
    [ Stdlib.Result.andThen(Error("test"), fun _ -> Error("test"))
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.andThen(Error("test"), fun _ -> Ok(5))
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.andThen(Ok(5), fun _ -> Error("test"))
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.andThen(Ok(5), fun x -> Ok(1 + x))
      |> Stdlib.Test.equal(Ok(6)) ])

test collect =
  Stdlib.Test.all(
    [ Stdlib.Result.collect([ Ok(5), Ok(6), Ok(7) ])
      |> Stdlib.Test.equal(Ok([ 5, 6, 7 ]))
      Stdlib.Result.collect([ Ok(5), Error("test"), Ok(7) ])
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.collect([ Ok(5), Error("test"), Error("test2") ])
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.collect([ Error("test"), Error("test2") ])
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.collect([])
      |> Stdlib.Test.equal(Ok([])) ])

test fromOption =
  Stdlib.Test.all(
    [ Stdlib.Result.fromOption(Some(6), "test")
      |> Stdlib.Test.equal(Ok(6))
      Stdlib.Result.fromOption(None, "test")
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.fromOption(Some(Error("test")), "test")
      |> Stdlib.Test.equal(Ok(Error("test")))
      Stdlib.Result.fromOption(None, (1, 2, 3))
      |> Stdlib.Test.equal(Error((1, 2, 3)))
      Stdlib.Result.fromOption(None, None)
      |> Stdlib.Test.equal(Error(None)) ])

test map2 =
  Stdlib.Test.all(
    [ Stdlib.Result.map2(Error("error1"), Error("error2"), fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map2(Error("error1"), Ok(1), fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map2(Ok(10), Error("error2"), fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Error("error2"))
      Stdlib.Result.map2(Ok(10), Ok(1), fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Ok(9)) ])

test map3 =
  Stdlib.Test.all(
    [ Stdlib.Result.map3(
        Error("error1"),
        Error("error2"),
        Error("error3"),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map3(
        Error("error1"),
        Error("error2"),
        Ok(1),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map3(
        Ok(10),
        Error("error2"),
        Error("error3"),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Error("error2"))
      Stdlib.Result.map3(Ok(10), Ok(1), Error("error3"), fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Error("error3"))
      Stdlib.Result.map3(Ok(10), Ok(1), Ok(1), fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Ok(8)) ])

test map4 =
  Stdlib.Test.all(
    [ Stdlib.Result.map4(
        Error("error1"),
        Error("error2"),
        Error("error3"),
        Error("error4"),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map4(
        Error("error1"),
        Error("error2"),
        Error("error3"),
        Ok(1),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map4(
        Ok(10),
        Ok(1),
        Ok(1),
        Error("error4"),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Error("error4"))
      Stdlib.Result.map4(
        Ok(10),
        Ok(1),
        Ok(1),
        Ok(2),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Ok(6)) ])

test map5 =
  Stdlib.Test.all(
    [ Stdlib.Result.map5(
        Error("error1"),
        Error("error2"),
        Error("error3"),
        Error("error4"),
        Error("error5"),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map5(
        Error("error1"),
        Error("error2"),
        Error("error3"),
        Error("error4"),
        Ok(1),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Error("error1"))
      Stdlib.Result.map5(
        Ok(10),
        Ok(1),
        Ok(1),
        Ok(2),
        Error("error5"),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Error("error5"))
      Stdlib.Result.map5(
        Ok(10),
        Ok(1),
        Ok(1),
        Ok(2),
        Ok(3),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Ok(3)) ])

test mapWithDefault =
  Stdlib.Test.all(
    [ Stdlib.Result.mapWithDefault(Error("test"), 5, fun x -> x + 1)
      |> Stdlib.Test.equal(5)
      Stdlib.Result.mapWithDefault(Ok(6), 5, fun x -> x + 1)
      |> Stdlib.Test.equal(7)
      Stdlib.Result.mapWithDefault(
        Error("test1"),
        Error("test2"),
        fun x -> x + 1)
      |> Stdlib.Test.equal(Error("test2")) ])

test mapError =
  Stdlib.Test.all(
    [ Stdlib.Result.mapError(
        Error("test"),
        fun x -> Stdlib.String.append(x, "-appended"))
      |> Stdlib.Test.equal(Error("test-appended"))
      Stdlib.Result.mapError(Ok(4), fun x -> (x / 2))
      |> Stdlib.Test.equal(Ok(4)) ])

test map =
  Stdlib.Test.all(
    [ Stdlib.Result.map(Error("test"), fun x -> (x / 2))
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.map(Ok(4), fun x -> (x / 2))
      |> Stdlib.Test.equal(Ok(2)) ])

test withDefault =
  Stdlib.Test.all(
    [ Stdlib.Result.withDefault(Error("test"), 5)
      |> Stdlib.Test.equal(5)
      Stdlib.Result.withDefault(Ok(6), 5)
      |> Stdlib.Test.equal(6) ])

test toOption =
  Stdlib.Test.all(
    [ Stdlib.Result.toOption(Ok("test")) |> Stdlib.Test.equal(Some("test"))
      Stdlib.Result.toOption(Error("test")) |> Stdlib.Test.equal(None) ])

test isOk =
  Stdlib.Test.all(
    [ Stdlib.Result.isOk(Ok("test")) |> Stdlib.Test.equal(true)
      Stdlib.Result.isOk(Error("test")) |> Stdlib.Test.equal(false) ])

test isError =
  Stdlib.Test.all(
    [ Stdlib.Result.isError(Ok("test")) |> Stdlib.Test.equal(false)
      Stdlib.Result.isError(Error("test")) |> Stdlib.Test.equal(true) ])

test toList =
  Stdlib.Test.all(
    [ Stdlib.Result.toList(Ok("test")) |> Stdlib.Test.equal([ "test" ])
      Stdlib.Result.toList(Error("test")) |> Stdlib.Test.equal([]) ])

test and =
  Stdlib.Test.all(
    [ Stdlib.Result.and(Ok("test1"), Ok("test2"))
      |> Stdlib.Test.equal(Ok("test2"))
      Stdlib.Result.and(Ok("test1"), Error("test2"))
      |> Stdlib.Test.equal(Error("test2"))
      Stdlib.Result.and(Error("test1"), Ok("test2"))
      |> Stdlib.Test.equal(Error("test1"))
      Stdlib.Result.and(Error("test1"), Error("test2"))
      |> Stdlib.Test.equal(Error("test1")) ])

test or =
  Stdlib.Test.all(
    [ Stdlib.Result.or(Ok("test1"), Ok("test2"))
      |> Stdlib.Test.equal(Ok("test1"))
      Stdlib.Result.or(Ok("test1"), Error("test2"))
      |> Stdlib.Test.equal(Ok("test1"))
      Stdlib.Result.or(Error("test1"), Ok("test2"))
      |> Stdlib.Test.equal(Ok("test2"))
      Stdlib.Result.or(Error("test1"), Error("test2"))
      |> Stdlib.Test.equal(Error("test2")) ])

test join =
  Stdlib.Test.all(
    [ Stdlib.Result.join(Ok(Ok("test")))
      |> Stdlib.Test.equal(Ok("test"))
      Stdlib.Result.join(Ok(Error("test")))
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.join(Error("test"))
      |> Stdlib.Test.equal(Error("test")) ])

test combine =
  Stdlib.Test.all(
    [ Stdlib.Result.combine([ Ok(1), Ok(2), Ok(3) ])
      |> Stdlib.Test.equal(Ok([ 1, 2, 3 ]))
      Stdlib.Result.combine([ Ok(1), Error("test"), Ok(3) ])
      |> Stdlib.Test.equal(Error("test"))
      Stdlib.Result.combine([ Error("test1"), Error("test2") ])
      |> Stdlib.Test.equal(Error("test1"))
      Stdlib.Result.combine([])
      |> Stdlib.Test.equal(Ok([])) ])

test values =
  Stdlib.Test.all(
    [ Stdlib.Result.values([ Ok(1), Ok(2), Ok(3) ])
      |> Stdlib.Test.equal(Ok([ 1, 2, 3 ]))
      Stdlib.Result.values([ Ok(1), Error("test"), Ok(3) ])
      |> Stdlib.Test.equal(Ok([ 1, 3 ]))
      Stdlib.Result.values([ Error("test1"), Error("test2") ])
      |> Stdlib.Test.equal(Ok([]))
      Stdlib.Result.values([])
      |> Stdlib.Test.equal(Ok([])) ])
