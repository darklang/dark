module Darklang.Stdlib.Result.Tests

test display =
  Stdlib.Test.all(
    [ Stdlib.display<Result<Int64, String>>(Stdlib.Result.Result.Ok(3))
      |> Stdlib.Test.equal("Ok(3)")

      Stdlib.display<Result<Int64, String>>(Stdlib.Result.Result.Error("no"))
      |> Stdlib.Test.equal("Error(no)")

      Stdlib.display<Result<Option<Int64>, String>>(
        Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some(1)))
      |> Stdlib.Test.equal("Ok(Some(1))")

      Stdlib.Result.Result.Error("bad")
      |> (fun r -> $"got {r}")
      |> Stdlib.Test.equal("got Error(bad)")

      // A value with no Display of its own shows as inspect does.
      Stdlib.display<Result<List<Int64>, String>>(
        Stdlib.Result.Result.Ok([ 1, 2 ]))
      |> Stdlib.Test.equal("Ok([1, 2])")

      Stdlib.inspect<Result<Int64, String>>(Stdlib.Result.Result.Error("nope"))
      |> Stdlib.Test.equal("Error(\"nope\")") ])


test andThen =
  Stdlib.Test.all(
    [ Stdlib.Result.andThen(Stdlib.Result.Result.Error("test"), fun _ ->
        Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.andThen(Stdlib.Result.Result.Error("test"), fun _ ->
        Stdlib.Result.Result.Ok(5))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.andThen(Stdlib.Result.Result.Ok(5), fun _ ->
        Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.andThen(Stdlib.Result.Result.Ok(5), fun x ->
        Stdlib.Result.Result.Ok(1 + x))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(6)) ])


test collect =
  Stdlib.Test.all(
    [ Stdlib.Result.collect(
        [ Stdlib.Result.Result.Ok(5)
          Stdlib.Result.Result.Ok(6)
          Stdlib.Result.Result.Ok(7) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([ 5, 6, 7 ]))

      Stdlib.Result.collect(
        [ Stdlib.Result.Result.Ok(5)
          Stdlib.Result.Result.Error("test")
          Stdlib.Result.Result.Ok(7) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.collect(
        [ Stdlib.Result.Result.Ok(5)
          Stdlib.Result.Result.Error("test")
          Stdlib.Result.Result.Error("test2") ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.collect(
        [ Stdlib.Result.Result.Error("test")
          Stdlib.Result.Result.Error("test2") ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.collect([])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([])) ])


test fromOption =
  Stdlib.Test.all(
    [ Stdlib.Result.fromOption(Stdlib.Option.Option.Some(6), "test")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(6))

      Stdlib.Result.fromOption(Stdlib.Option.Option.None, "test")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.fromOption(
        Stdlib.Option.Option.Some(Stdlib.Result.Result.Error("test")),
        "test")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(Stdlib.Result.Result.Error("test")))

      Stdlib.Result.fromOption(Stdlib.Option.Option.None, (1, 2, 3))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error((1, 2, 3)))

      Stdlib.Result.fromOption(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Option.Option.None)) ])


test map2 =
  Stdlib.Test.all(
    [ Stdlib.Result.map2(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map2(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Ok(1),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map2(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Error("error2"),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error2"))

      Stdlib.Result.map2(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(9)) ])


test map3 =
  Stdlib.Test.all(
    [ Stdlib.Result.map3(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map3(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Ok(1),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map3(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error2"))

      Stdlib.Result.map3(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Error("error3"),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error3"))

      Stdlib.Result.map3(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(1),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(8)) ])


test map4 =
  Stdlib.Test.all(
    [ Stdlib.Result.map4(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        Stdlib.Result.Result.Error("error4"),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map4(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        Stdlib.Result.Result.Ok(1),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map4(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Error("error4"),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error4"))

      Stdlib.Result.map4(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(2),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(6)) ])


test map5 =
  Stdlib.Test.all(
    [ Stdlib.Result.map5(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        Stdlib.Result.Result.Error("error4"),
        Stdlib.Result.Result.Error("error5"),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map5(
        Stdlib.Result.Result.Error("error1"),
        Stdlib.Result.Result.Error("error2"),
        Stdlib.Result.Result.Error("error3"),
        Stdlib.Result.Result.Error("error4"),
        Stdlib.Result.Result.Ok(1),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error1"))

      Stdlib.Result.map5(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(2),
        Stdlib.Result.Result.Error("error5"),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error5"))

      Stdlib.Result.map5(
        Stdlib.Result.Result.Ok(10),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(1),
        Stdlib.Result.Result.Ok(2),
        Stdlib.Result.Result.Ok(3),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3)) ])


test mapWithDefault =
  Stdlib.Test.all(
    [ Stdlib.Result.mapWithDefault(
        Stdlib.Result.Result.Error("test"),
        5,
        fun x -> x + 1)
      |> Stdlib.Test.equal(5)

      Stdlib.Result.mapWithDefault(Stdlib.Result.Result.Ok(6), 5, fun x ->
        x + 1)
      |> Stdlib.Test.equal(7)

      Stdlib.Result.mapWithDefault(
        Stdlib.Result.Result.Error("test1"),
        Stdlib.Result.Result.Error("test2"),
        fun x -> x + 1)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test2")) ])


test mapError =
  Stdlib.Test.all(
    [ Stdlib.Result.mapError(Stdlib.Result.Result.Error("test"), fun x ->
        Stdlib.String.append(x, "-appended"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test-appended"))

      Stdlib.Result.mapError(Stdlib.Result.Result.Ok(4), fun x -> x / 2)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(4)) ])


test map =
  Stdlib.Test.all(
    [ Stdlib.Result.map(Stdlib.Result.Result.Error("test"), fun x -> x / 2)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.map(Stdlib.Result.Result.Ok(4), fun x -> x / 2)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(2)) ])


test withDefault =
  Stdlib.Test.all(
    [ Stdlib.Result.withDefault(Stdlib.Result.Result.Error("test"), 5)
      |> Stdlib.Test.equal(5)

      Stdlib.Result.withDefault(Stdlib.Result.Result.Ok(6), 5)
      |> Stdlib.Test.equal(6) ])


test toOption =
  Stdlib.Test.all(
    [ Stdlib.Result.toOption(Stdlib.Result.Result.Ok("test"))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some("test"))

      Stdlib.Result.toOption(Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test isOk =
  Stdlib.Test.all(
    [ Stdlib.Result.isOk(Stdlib.Result.Result.Ok("test"))
      |> Stdlib.Test.equal(true)

      Stdlib.Result.isOk(Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(false) ])


test isError =
  Stdlib.Test.all(
    [ Stdlib.Result.isError(Stdlib.Result.Result.Ok("test"))
      |> Stdlib.Test.equal(false)

      Stdlib.Result.isError(Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(true) ])


test toList =
  Stdlib.Test.all(
    [ Stdlib.Result.toList(Stdlib.Result.Result.Ok("test"))
      |> Stdlib.Test.equal([ "test" ])

      Stdlib.Result.toList(Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal([]) ])


test and =
  Stdlib.Test.all(
    [ Stdlib.Result.and(
        Stdlib.Result.Result.Ok("test1"),
        Stdlib.Result.Result.Ok("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("test2"))

      Stdlib.Result.and(
        Stdlib.Result.Result.Ok("test1"),
        Stdlib.Result.Result.Error("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test2"))

      Stdlib.Result.and(
        Stdlib.Result.Result.Error("test1"),
        Stdlib.Result.Result.Ok("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test1"))

      Stdlib.Result.and(
        Stdlib.Result.Result.Error("test1"),
        Stdlib.Result.Result.Error("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test1")) ])


test or =
  Stdlib.Test.all(
    [ Stdlib.Result.or(
        Stdlib.Result.Result.Ok("test1"),
        Stdlib.Result.Result.Ok("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("test1"))

      Stdlib.Result.or(
        Stdlib.Result.Result.Ok("test1"),
        Stdlib.Result.Result.Error("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("test1"))

      Stdlib.Result.or(
        Stdlib.Result.Result.Error("test1"),
        Stdlib.Result.Result.Ok("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("test2"))

      Stdlib.Result.or(
        Stdlib.Result.Result.Error("test1"),
        Stdlib.Result.Result.Error("test2"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test2")) ])


test join =
  Stdlib.Test.all(
    [ Stdlib.Result.join(
        Stdlib.Result.Result.Ok(Stdlib.Result.Result.Ok("test")))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("test"))

      Stdlib.Result.join(
        Stdlib.Result.Result.Ok(Stdlib.Result.Result.Error("test")))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.join(Stdlib.Result.Result.Error("test"))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test")) ])


test combine =
  Stdlib.Test.all(
    [ Stdlib.Result.combine(
        [ Stdlib.Result.Result.Ok(1)
          Stdlib.Result.Result.Ok(2)
          Stdlib.Result.Result.Ok(3) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([ 1, 2, 3 ]))

      Stdlib.Result.combine(
        [ Stdlib.Result.Result.Ok(1)
          Stdlib.Result.Result.Error("test")
          Stdlib.Result.Result.Ok(3) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test"))

      Stdlib.Result.combine(
        [ Stdlib.Result.Result.Error("test1")
          Stdlib.Result.Result.Error("test2") ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("test1"))

      Stdlib.Result.combine([])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([])) ])


test values =
  Stdlib.Test.all(
    [ Stdlib.Result.values(
        [ Stdlib.Result.Result.Ok(1)
          Stdlib.Result.Result.Ok(2)
          Stdlib.Result.Result.Ok(3) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([ 1, 2, 3 ]))

      Stdlib.Result.values(
        [ Stdlib.Result.Result.Ok(1)
          Stdlib.Result.Result.Error("test")
          Stdlib.Result.Result.Ok(3) ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([ 1, 3 ]))

      Stdlib.Result.values(
        [ Stdlib.Result.Result.Error("test1")
          Stdlib.Result.Result.Error("test2") ])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([]))

      Stdlib.Result.values([])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([])) ])
