module Darklang.Stdlib.Float64.Tests

let nan(): Float64 = 0.0 / 0.0

let infinity(): Float64 = 1.0 / 0.0

let negativeInfinity(): Float64 = -1.0 / 0.0

test add = 1.2 + 1.3 |> Stdlib.Test.equal(2.5)


test ceiling =
  Stdlib.Test.all(
    [ Stdlib.Float64.ceiling(1.3) |> Stdlib.Test.equal(2)
      Stdlib.Float64.ceiling(1.0000001) |> Stdlib.Test.equal(2)
      Stdlib.Float64.ceiling(-2147483647.8) |> Stdlib.Test.equal(-2147483647)
      Stdlib.Float64.ceiling(2147483647.0) |> Stdlib.Test.equal(2147483647)
      Stdlib.Float64.ceiling(0.1) |> Stdlib.Test.equal(1)
      Stdlib.Float64.ceiling(0.0) |> Stdlib.Test.equal(0)
      Stdlib.Float64.ceiling(17.55042081) |> Stdlib.Test.equal(18) ])


test roundUp =
  Stdlib.Test.all(
    [ Stdlib.Float64.roundUp(1.3) |> Stdlib.Test.equal(2)
      Stdlib.Float64.roundUp(1.0000001) |> Stdlib.Test.equal(2)
      Stdlib.Float64.roundUp(-2147483647.8) |> Stdlib.Test.equal(-2147483647)
      Stdlib.Float64.roundUp(2147483647.0) |> Stdlib.Test.equal(2147483647)
      Stdlib.Float64.roundUp(0.1) |> Stdlib.Test.equal(1)
      Stdlib.Float64.roundUp(0.0) |> Stdlib.Test.equal(0) ])


test floor =
  Stdlib.Test.all(
    [ Stdlib.Float64.floor(1.8) |> Stdlib.Test.equal(1)
      Stdlib.Float64.floor(-1.0000001) |> Stdlib.Test.equal(-2)
      Stdlib.Float64.floor(-2147483647.8) |> Stdlib.Test.equal(-2147483648)
      Stdlib.Float64.floor(2147483647.0) |> Stdlib.Test.equal(2147483647)
      Stdlib.Float64.floor(0.1) |> Stdlib.Test.equal(0)
      Stdlib.Float64.floor(0.0) |> Stdlib.Test.equal(0) ])


test roundDown =
  Stdlib.Test.all(
    [ Stdlib.Float64.roundDown(1.8) |> Stdlib.Test.equal(1)
      Stdlib.Float64.roundDown(-1.0000001) |> Stdlib.Test.equal(-2)
      Stdlib.Float64.roundDown(-2147483647.8) |> Stdlib.Test.equal(-2147483648)
      Stdlib.Float64.roundDown(2147483647.0) |> Stdlib.Test.equal(2147483647)
      Stdlib.Float64.roundDown(0.1) |> Stdlib.Test.equal(0)
      Stdlib.Float64.roundDown(0.0) |> Stdlib.Test.equal(0) ])


test round =
  Stdlib.Test.all(
    [ Stdlib.Float64.round(-2147483647.8) |> Stdlib.Test.equal(-2147483648)
      Stdlib.Float64.round(0.1) |> Stdlib.Test.equal(0)
      Stdlib.Float64.round(2147483647.000009)
      |> Stdlib.Test.equal(2147483647) ])


test truncate =
  Stdlib.Test.all(
    [ Stdlib.Float64.truncate(-2367.9267) |> Stdlib.Test.equal(-2367)

      Stdlib.Float64.truncate(0.9) |> Stdlib.Test.equal(0)

      Stdlib.Float64.truncate(-0.9) |> Stdlib.Test.equal(0)

      Stdlib.Float64.truncate(0.0) |> Stdlib.Test.equal(0)

      Stdlib.Float64.truncate(2147483647.000009)
      |> Stdlib.Test.equal(2147483647) ])


// NaN / Infinity have no Int64 representation -> Dark error, not a host crash
test ceilingRejectsNan =
  Stdlib.Float64.ceiling(nan())
  => raises "Float64 has no integer value: NaN"


test roundUpRejectsInfinity =
  Stdlib.Float64.roundUp(infinity())
  => raises "Float64 has no integer value: Infinity"


test floorRejectsNegativeInfinity =
  Stdlib.Float64.floor(negativeInfinity())
  => raises "Float64 has no integer value: -Infinity"


test roundDownRejectsNan =
  Stdlib.Float64.roundDown(nan())
  => raises "Float64 has no integer value: NaN"


test roundRejectsInfinity =
  Stdlib.Float64.round(infinity())
  => raises "Float64 has no integer value: Infinity"


test truncateRejectsNan =
  Stdlib.Float64.truncate(nan())
  => raises "Float64 has no integer value: NaN"


test roundTowardsZeroRejectsNegativeInfinity =
  Stdlib.Float64.roundTowardsZero(negativeInfinity())
  => raises "Float64 has no integer value: -Infinity"


test isFinite =
  Stdlib.Test.all(
    [ Stdlib.Float64.isFinite(0.0) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isFinite(-3.9) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isFinite(nan()) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isFinite(infinity()) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isFinite(negativeInfinity()) |> Stdlib.Test.equal(false) ])


test absoluteValue =
  Stdlib.Test.all(
    [ Stdlib.abs(negativeInfinity()) |> Stdlib.Test.equal(infinity())

      // NaN never equals itself; check it with isNaN.
      Stdlib.abs(nan())
      |> Stdlib.Float64.isNaN
      |> Stdlib.Test.equal(true)

      Stdlib.abs(-5.6) |> Stdlib.Test.equal(5.6)

      Stdlib.abs(-0.0) |> Stdlib.Test.equal(0.0) ])


test negate =
  Stdlib.Test.all(
    [ // NaN never equals itself; check it with isNaN.
      -nan()
      |> Stdlib.Float64.isNaN
      |> Stdlib.Test.equal(true)

      -infinity() |> Stdlib.Test.equal(negativeInfinity())

      -(-5.6) |> Stdlib.Test.equal(5.6)

      -(5.6) |> Stdlib.Test.equal(-5.6)

      -0.0 |> Stdlib.Test.equal(-0.0)

      -(-0.0) |> Stdlib.Test.equal(0.0) ])


test clamp =
  Stdlib.Test.all(
    [ Stdlib.Float64.clampRefusingNaN(infinity(), -1.0, 0.5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.clampRefusingNaN(negativeInfinity(), -1.0, 0.5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1.0))

      // NaN never equals itself; check it with isNaN.
      Stdlib.Float64.clampRefusingNaN(nan(), -1.0, 1.0)
      |> Stdlib.Result.map(Stdlib.Float64.isNaN)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(true))

      Stdlib.Float64.clampRefusingNaN(0.5, infinity(), 1.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.0))

      Stdlib.Float64.clampRefusingNaN(0.5, negativeInfinity(), 1.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.clampRefusingNaN(0.5, nan(), 1.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(
          "clampRefusingNaN requires limits that are numbers"))

      Stdlib.Float64.clampRefusingNaN(-1.0, 0.5, infinity())
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.clampRefusingNaN(-1.0, 0.5, negativeInfinity())
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1.0))

      Stdlib.Float64.clampRefusingNaN(0.5, 1.0, nan())
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(
          "clampRefusingNaN requires limits that are numbers"))

      Stdlib.Float64.clampRefusingNaN(-2.0, -5.0, 5.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-2.0))

      Stdlib.Float64.clampRefusingNaN(-3.0, -2.0, 1.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-2.0))

      Stdlib.Float64.clampRefusingNaN(-5.0, 1.0, 1.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.0))

      Stdlib.Float64.clampRefusingNaN(1.0, 2.0, 1.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.0))

      Stdlib.Float64.clampRefusingNaN(3.0, 0.0, 2.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(2.0)) ])


test divide =
  Stdlib.Test.all(
    [ 9.0 / 2.0 |> Stdlib.Test.equal(4.5)
      9.0 / 0.0 |> Stdlib.Test.equal(infinity())
      9.0 / -0.0 |> Stdlib.Test.equal(negativeInfinity()) ])


// Compare the exact floating-point results.
test divisionOperator =
  Stdlib.Test.all(
    [ 9.0 / 2.0 |> Stdlib.Test.equal(4.5)
      17.0 / 3.3 |> Stdlib.Test.equal(5.151515151515151)
      -8.74 / 5.351 |> Stdlib.Test.equal(-1.633339562698561)
      0.0 / 1.0 |> Stdlib.Test.equal(0.0)
      1.0 / 0.0 |> Stdlib.Test.equal(infinity()) ])


test comparisons =
  Stdlib.Test.all(
    [ 0.1 >= 0.1 |> Stdlib.Test.equal(true)
      0.2 > 0.1 |> Stdlib.Test.equal(true)
      0.1 <= 0.1 |> Stdlib.Test.equal(true)
      0.2 < 0.1 |> Stdlib.Test.equal(false) ])


test max =
  Stdlib.Test.all(
    [ Stdlib.max(infinity(), 1.0) |> Stdlib.Test.equal(infinity())

      Stdlib.max(negativeInfinity(), 1.0) |> Stdlib.Test.equal(1.0)

      Stdlib.max(-10.0, 1.0) |> Stdlib.Test.equal(1.0)

      // NaN never equals itself; check it with isNaN.
      Stdlib.max(10.0, nan())
      |> Stdlib.Float64.isNaN
      |> Stdlib.Test.equal(true)

      Stdlib.max(10.0, 1.0) |> Stdlib.Test.equal(10.0)

      Stdlib.max(0.0, 0.0) |> Stdlib.Test.equal(0.0)

      Stdlib.max(-2147483647.8, -0.0) |> Stdlib.Test.equal(0.0)

      Stdlib.max(2147483647.0, 0.0) |> Stdlib.Test.equal(2147483647.0) ])


test min =
  Stdlib.Test.all(
    [ Stdlib.min(infinity(), 1.0) |> Stdlib.Test.equal(1.0)

      Stdlib.min(negativeInfinity(), 1.0)
      |> Stdlib.Test.equal(negativeInfinity())

      Stdlib.min(-10.0, 1.0) |> Stdlib.Test.equal(-10.0)

      // NaN never equals itself; check it with isNaN.
      Stdlib.min(10.0, nan())
      |> Stdlib.Float64.isNaN
      |> Stdlib.Test.equal(true)

      Stdlib.min(10.0, 1.0) |> Stdlib.Test.equal(1.0)

      Stdlib.min(0.0, 0.0) |> Stdlib.Test.equal(0.0)

      Stdlib.min(-2147483647.8, -0.0) |> Stdlib.Test.equal(-2147483647.8)

      Stdlib.min(2147483647.0, 0.0) |> Stdlib.Test.equal(0.0) ])


test multiply = 26.0 * 0.5 |> Stdlib.Test.equal(13.0)


test parse =
  Stdlib.Test.all(
    [ Stdlib.Float64.parse("1.5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.5))

      Stdlib.Float64.parse("0.0")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.0))

      Stdlib.Float64.parse("-0.5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-0.5))

      Stdlib.Float64.parse("+0.5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.parse(".5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.parse(
        "0.6999999999999999555910790149937383830547332763671875")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.7))

      Stdlib.Float64.parse(
        "-0.6999999999999999555910790149937383830547332763671875")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-0.7))

      Stdlib.Float64.parse("0.7999999999")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.7999999999))

      Stdlib.Float64.parse("0.79999")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.79999))

      Stdlib.Float64.parse("-55555555555555555555555555555.5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-5.555555555555555e28))

      Stdlib.Float64.parse("-141s")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.parse("")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.parse("-5.55555555556e+28")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-5.55555555556e28))

      Stdlib.Float64.parse("-1.8E+308")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(negativeInfinity()))

      Stdlib.Float64.parse("1.8E+308")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(infinity())) ])


test power =
  Stdlib.Test.all(
    [ 4.0 ** -0.5 |> Stdlib.Test.equal(0.5)
      4.0 ** 0.5 |> Stdlib.Test.equal(2.0) ])


test roundTowardsZero =
  Stdlib.Test.all(
    [ Stdlib.Float64.roundTowardsZero(-2367.9267) |> Stdlib.Test.equal(-2367)

      Stdlib.Float64.roundTowardsZero(0.9) |> Stdlib.Test.equal(0)

      Stdlib.Float64.roundTowardsZero(-0.9) |> Stdlib.Test.equal(0)

      Stdlib.Float64.roundTowardsZero(0.0) |> Stdlib.Test.equal(0)

      Stdlib.Float64.roundTowardsZero(2147483647.000009)
      |> Stdlib.Test.equal(2147483647) ])


test sqrt =
  Stdlib.Test.all(
    [ Stdlib.Float64.sqrt(25.0) |> Stdlib.Test.equal(5.0)
      Stdlib.Float64.sqrt(0.0) |> Stdlib.Test.equal(0.0) ])


test subtract = 1.0 - 0.2 |> Stdlib.Test.equal(0.8)


test sum = Stdlib.sum(0.0, [ 1.0, 0.2 ]) |> Stdlib.Test.equal(1.2)


test nanEqualityIsFalse = nan() == nan() |> Stdlib.Test.equal(false)


test nanInequalityIsTrue = nan() != nan() |> Stdlib.Test.equal(true)


test toString =
  Stdlib.Test.all(
    [ Stdlib.display(1.5) |> Stdlib.Test.equal("1.5")

      Stdlib.display(0.0) |> Stdlib.Test.equal("0.0")

      Stdlib.display(-0.5) |> Stdlib.Test.equal("-0.5")

      Stdlib.display(0.5) |> Stdlib.Test.equal("0.5")

      Stdlib.display(-5.555555555555555e28)
      |> Stdlib.Test.equal("-5.555555555555555e+28")

      // Shortest round-trip: what prints is the number, not a twelve-digit
      // rounding of it.
      Stdlib.display(0.1 + 0.2) |> Stdlib.Test.equal("0.30000000000000004")

      Stdlib.display(1.0 / 3.0) |> Stdlib.Test.equal("0.3333333333333333")

      Stdlib.display(1.0000000000000002)
      |> Stdlib.Test.equal("1.0000000000000002")

      // Fixed notation from 1e-4 up to 1e16, scientific outside, no zero
      // padding, and no `.0` on scientific (it used to print `1e+17.0`, which
      // Float64.parse refuses). Same layout as the compiler's Float64.toString.
      Stdlib.display(0.0001) |> Stdlib.Test.equal("0.0001")

      Stdlib.display(0.00001) |> Stdlib.Test.equal("1e-5")

      Stdlib.display(-0.00001) |> Stdlib.Test.equal("-1e-5")

      Stdlib.display(123456789012345.0)
      |> Stdlib.Test.equal("123456789012345.0")

      Stdlib.display(9007199254740992.0)
      |> Stdlib.Test.equal("9007199254740992.0")

      Stdlib.display(1e16) |> Stdlib.Test.equal("1e+16")

      Stdlib.display(1.2345678901234568e17)
      |> Stdlib.Test.equal("1.2345678901234568e+17") ])


test toStringRoundTrips =
  Stdlib.Test.all(
    [ Stdlib.Float64.parse(Stdlib.display(1.0 / 3.0))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.0 / 3.0))

      Stdlib.Float64.parse(Stdlib.display(1.2345678901234568e17))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.2345678901234568e17))

      Stdlib.Float64.parse(Stdlib.display(-0.00001))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-0.00001))

      Stdlib.Float64.parse("5e-324")
      |> Stdlib.Result.map(fun f -> Stdlib.display(f))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("5e-324")) ])


// toInt64 truncates toward zero.
test toInt64 =
  Stdlib.Test.all(
    [ Stdlib.Float64.toInt64(3.0) |> Stdlib.Test.equal(3)

      Stdlib.Float64.toInt64(0.0) |> Stdlib.Test.equal(0)

      Stdlib.Float64.toInt64(-0.0) |> Stdlib.Test.equal(0)

      Stdlib.Float64.toInt64(1.5) |> Stdlib.Test.equal(1)

      Stdlib.Float64.toInt64(1.9) |> Stdlib.Test.equal(1)

      Stdlib.Float64.toInt64(-1.9) |> Stdlib.Test.equal(-1)

      Stdlib.Float64.toInt64(-3.0) |> Stdlib.Test.equal(-3)

      Stdlib.Float64.toInt64(0.1) |> Stdlib.Test.equal(0)

      Stdlib.Float64.toInt64(2147483648.7) |> Stdlib.Test.equal(2147483648)

      Stdlib.Float64.toInt64(2.5)
      |> Stdlib.Test.equal(Stdlib.Float64.roundTowardsZero(2.5))

      Stdlib.Float64.toInt64(-2.5)
      |> Stdlib.Test.equal(Stdlib.Float64.roundTowardsZero(-2.5)) ])


// NaN and infinities cannot become Int64s.
test toInt64RejectsNan =
  Stdlib.Float64.toInt64(nan())
  => raises "Float64 has no integer value: NaN"


test toInt64RejectsInfinity =
  Stdlib.Float64.toInt64(infinity())
  => raises "Float64 has no integer value: Infinity"


test toInt64RejectsNegativeInfinity =
  Stdlib.Float64.toInt64(negativeInfinity())
  => raises "Float64 has no integer value: -Infinity"


// Truncation and floor differ for negative values.
test toInt64TruncatesWhereFloorRoundsDown =
  Stdlib.Test.all(
    [ Stdlib.Float64.toInt64(-1.5) |> Stdlib.Test.equal(-1)
      Stdlib.Float64.floor(-1.5) |> Stdlib.Test.equal(-2) ])


// IEEE 754 binary64 representations.
test toBits =
  Stdlib.Test.all(
    [ Stdlib.Float64.toBits(0.0) |> Stdlib.Test.equal(0u64)

      Stdlib.Float64.toBits(0.5) |> Stdlib.Test.equal(4602678819172646912u64)

      Stdlib.Float64.toBits(1.0) |> Stdlib.Test.equal(4607182418800017408u64)

      Stdlib.Float64.toBits(2.0) |> Stdlib.Test.equal(4611686018427387904u64)

      Stdlib.Float64.toBits(infinity())
      |> Stdlib.Test.equal(9218868437227405312u64)

      Stdlib.Float64.toBits(-0.0) |> Stdlib.Test.equal(9223372036854775808u64)

      Stdlib.Float64.toBits(-1.0)
      |> Stdlib.Test.equal(13830554455654793216u64) ])


// Bit equality distinguishes signed zero and is reflexive for a fixed NaN.
test toBitsDistinguishesSignedZero =
  Stdlib.Test.all(
    [ Stdlib.Float64.toBits(-0.0) == Stdlib.Float64.toBits(0.0)
      |> Stdlib.Test.equal(false)

      -0.0 == 0.0 |> Stdlib.Test.equal(true)

      Stdlib.Float64.toBits(nan()) == Stdlib.Float64.toBits(nan())
      |> Stdlib.Test.equal(true) ])


// Check parsing a hexadecimal float.
test parseRejectsHexadecimalNotation =
  Stdlib.Float64.parse("0xffffffffffffffff")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))


test isNaN =
  Stdlib.Test.all(
    [ Stdlib.Float64.isNaN(nan()) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isNaN(-nan()) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isNaN(infinity() - infinity()) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isNaN(0.0 * infinity()) |> Stdlib.Test.equal(true)
      Stdlib.Float64.isNaN(infinity()) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isNaN(negativeInfinity()) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isNaN(0.0) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isNaN(-0.0) |> Stdlib.Test.equal(false)
      Stdlib.Float64.isNaN(1.5) |> Stdlib.Test.equal(false) ])


// The round* names are the same operations as ceiling, floor and truncate, negative halves included.
test roundAliasesMatch =
  Stdlib.Test.all(
    [ Stdlib.Float64.roundUp(-1.5)
      |> Stdlib.Test.equal(Stdlib.Float64.ceiling(-1.5))

      Stdlib.Float64.roundUp(-0.5) |> Stdlib.Test.equal(0)

      Stdlib.Float64.roundDown(-1.5)
      |> Stdlib.Test.equal(Stdlib.Float64.floor(-1.5))

      Stdlib.Float64.roundDown(-0.5) |> Stdlib.Test.equal(-1)

      Stdlib.Float64.roundTowardsZero(-1.5)
      |> Stdlib.Test.equal(Stdlib.Float64.truncate(-1.5))

      Stdlib.Float64.roundTowardsZero(1.5) |> Stdlib.Test.equal(1) ])


test roundTowardsZeroRejectsNan =
  Stdlib.Float64.roundTowardsZero(nan())
  => raises "Float64 has no integer value: NaN"


// checked arithmetic: Error wherever the operator gives NaN or an infinity
test checkedArithmetic =
  Stdlib.Test.all(
    [ Stdlib.Float64.checkedAdd(1.5, 2.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3.5))

      Stdlib.Float64.checkedAdd(1.7e308, 1.7e308)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Float64.checkedSubtract(1.0, 2.5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-1.5))

      Stdlib.Float64.checkedSubtract(-1.7e308, 1.7e308)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Float64.checkedMultiply(3.0, -2.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-6.0))

      Stdlib.Float64.checkedMultiply(1e200, 1e200)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow))

      Stdlib.Float64.checkedMultiply(nan(), 1.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.Overflow.Overflow)) ])


test checkedDivide =
  Stdlib.Test.all(
    [ Stdlib.Float64.checkedDivide(1.0, 4.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.25))

      Stdlib.Float64.checkedDivide(0.0, 5.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.0))

      Stdlib.Float64.checkedDivide(1.0, 0.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.DivisionByZero))

      Stdlib.Float64.checkedDivide(1.0, -0.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.DivisionByZero))

      Stdlib.Float64.checkedDivide(0.0, 0.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.DivisionByZero))

      Stdlib.Float64.checkedDivide(1e200, 1.0 / 1e200)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.Overflow))

      Stdlib.Float64.checkedDivide(nan(), 2.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.NotANumber))

      // The plain operator is unchanged
      Stdlib.Float64.isFinite(1.0 / 0.0) |> Stdlib.Test.equal(false) ])


test checkedPower =
  Stdlib.Test.all(
    [ Stdlib.Float64.checkedPower(2.0, 3.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(8.0))

      Stdlib.Float64.checkedPower(4.0, -0.5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.5))

      Stdlib.Float64.checkedPower(0.0, 0.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.0))

      Stdlib.Float64.checkedPower(-8.0, 2.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(64.0))

      Stdlib.Float64.checkedPower(0.0, -1.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.DivisionByZero))

      Stdlib.Float64.checkedPower(-8.0, 0.5)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.NotANumber))

      Stdlib.Float64.checkedPower(10.0, 400.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.Overflow))

      Stdlib.Float64.checkedPower(0.5, -2000.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.Overflow)) ])


test checkedSqrt =
  Stdlib.Test.all(
    [ Stdlib.Float64.checkedSqrt(9.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3.0))

      Stdlib.Float64.checkedSqrt(0.0)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0.0))

      Stdlib.Float64.checkedSqrt(-1.0)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Math.NonFinite.NotANumber)) ])


test checkedParse =
  Stdlib.Test.all(
    [ Stdlib.Float64.checkedParse("1.5")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1.5))

      Stdlib.Float64.checkedParse("-2e3")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(-2000.0))

      Stdlib.Float64.checkedParse("NaN")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.checkedParse("Infinity")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.checkedParse("-Infinity")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.checkedParse("1e400")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat))

      Stdlib.Float64.checkedParse("abc")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Float64.ParseError.BadFormat)) ])
