/// Cases ported from `backend/testfiles/execution/stdlib/tuple.dark`.
module Darklang.Stdlib.Tuple.Tests

test tuple2 =
  Stdlib.Test.all
    [ Stdlib.Tuple2.create "one" 2L
      |> Stdlib.Test.equal ("one", 2L)
      Stdlib.Tuple2.create 1L "two"
      |> Stdlib.Test.equal (1L, "two")
      Stdlib.Tuple2.first ("one", 2L)
      |> Stdlib.Test.equal "one"
      Stdlib.Tuple2.first (1L, "two")
      |> Stdlib.Test.equal 1L
      Stdlib.Tuple2.second ("one", 2L)
      |> Stdlib.Test.equal 2L
      Stdlib.Tuple2.second (1L, "two")
      |> Stdlib.Test.equal "two"
      Stdlib.Tuple2.swap ("one", 2L)
      |> Stdlib.Test.equal (2L, "one")
      Stdlib.Tuple2.swap (1L, "two")
      |> Stdlib.Test.equal ("two", 1L)
      Stdlib.Tuple2.swap (Stdlib.Tuple2.swap ("two swaps", "back to original"))
      |> Stdlib.Test.equal ("two swaps", "back to original")
      Stdlib.Tuple2.mapFirst ("one", 2L) (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal ("ONE", 2L)
      Stdlib.Tuple2.mapFirst (1L, "two") (fun x -> x - 2L)
      |> Stdlib.Test.equal (-1L, "two")
      Stdlib.Tuple2.mapSecond ("one", 2L) (fun x -> x - 2L)
      |> Stdlib.Test.equal ("one", 0L)
      Stdlib.Tuple2.mapSecond (1L, "two") (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal (1L, "TWO")
      Stdlib.Tuple2.mapBoth
        ("one", 2L)
        (fun x -> Stdlib.String.toUppercase x)
        (fun x -> x - 2L)
      |> Stdlib.Test.equal ("ONE", 0L)
      Stdlib.Tuple2.mapBoth
        (1L, "two")
        (fun x -> x - 2L)
        (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal (-1L, "TWO") ]

test tuple3 =
  Stdlib.Test.all
    [ Stdlib.Tuple3.create "one" 2L "pi"
      |> Stdlib.Test.equal ("one", 2L, "pi")
      Stdlib.Tuple3.create 1L "two" 3.14
      |> Stdlib.Test.equal (1L, "two", 3.14)
      Stdlib.Tuple3.first (1L, "two", 3.14)
      |> Stdlib.Test.equal 1L
      Stdlib.Tuple3.first ("one", 2L, "pi")
      |> Stdlib.Test.equal "one"
      Stdlib.Tuple3.second (1L, "two", 3.14)
      |> Stdlib.Test.equal "two"
      Stdlib.Tuple3.second ("one", 2L, "pi")
      |> Stdlib.Test.equal 2L
      Stdlib.Tuple3.third (1L, "two", 3.14)
      |> Stdlib.Test.equal 3.14
      Stdlib.Tuple3.third ("one", 2L, "pi")
      |> Stdlib.Test.equal "pi"
      Stdlib.Tuple3.mapFirst ("one", 2L, "pi") (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal ("ONE", 2L, "pi")
      Stdlib.Tuple3.mapFirst (1L, "two", 3.14) (fun x -> x - 2L)
      |> Stdlib.Test.equal (-1L, "two", 3.14)
      Stdlib.Tuple3.mapSecond ("one", 2L, "pi") (fun x -> x - 2L)
      |> Stdlib.Test.equal ("one", 0L, "pi")
      Stdlib.Tuple3.mapSecond
        (1L, "two", 3.14)
        (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal (1L, "TWO", 3.14)
      Stdlib.Tuple3.mapThird ("one", 2L, "pi") (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal ("one", 2L, "PI")
      Stdlib.Tuple3.mapThird (1L, "two", 3.14) (fun x -> Stdlib.Float.roundDown x)
      |> Stdlib.Test.equal (1L, "two", 3) ]

test tuple3MapsAllThree =
  Stdlib.Test.all
    [ Stdlib.Tuple3.mapAllThree
        ("one", 2L, "pi")
        (fun x -> Stdlib.String.toUppercase x)
        (fun x -> x - 2L)
        (fun x -> Stdlib.String.toUppercase x)
      |> Stdlib.Test.equal ("ONE", 0L, "PI")
      Stdlib.Tuple3.mapAllThree
        (1L, "two", 3.14)
        (fun x -> x - 2L)
        (fun x -> Stdlib.String.toUppercase x)
        (fun x -> Stdlib.Float.roundDown x)
      |> Stdlib.Test.equal (-1L, "TWO", 3) ]
