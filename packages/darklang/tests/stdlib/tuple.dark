module Darklang.Stdlib.Tuple.Tests

test tuple2 =
  Stdlib.Test.all(
    [ Stdlib.Tuple2.create("one", 2) |> Stdlib.Test.equal(("one", 2))

      Stdlib.Tuple2.create(1, "two") |> Stdlib.Test.equal((1, "two"))

      Stdlib.Tuple2.first(("one", 2)) |> Stdlib.Test.equal("one")

      Stdlib.Tuple2.first((1, "two")) |> Stdlib.Test.equal(1)

      Stdlib.Tuple2.second(("one", 2)) |> Stdlib.Test.equal(2)

      Stdlib.Tuple2.second((1, "two")) |> Stdlib.Test.equal("two")

      Stdlib.Tuple2.swap(("one", 2)) |> Stdlib.Test.equal((2, "one"))

      Stdlib.Tuple2.swap((1, "two")) |> Stdlib.Test.equal(("two", 1))

      Stdlib.Tuple2.swap(Stdlib.Tuple2.swap(("two swaps", "back to original")))
      |> Stdlib.Test.equal(("two swaps", "back to original"))

      Stdlib.Tuple2.mapFirst(("one", 2), fun x -> Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal(("ONE", 2))

      Stdlib.Tuple2.mapFirst((1, "two"), fun x -> x - 2)
      |> Stdlib.Test.equal((-1, "two"))

      Stdlib.Tuple2.mapSecond(("one", 2), fun x -> x - 2)
      |> Stdlib.Test.equal(("one", 0))

      Stdlib.Tuple2.mapSecond((1, "two"), fun x -> Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal((1, "TWO"))

      Stdlib.Tuple2.mapBoth(
        ("one", 2),
        (fun x -> Stdlib.String.toUppercase(x)),
        fun x -> x - 2)
      |> Stdlib.Test.equal(("ONE", 0))

      Stdlib.Tuple2.mapBoth((1, "two"), (fun x -> x - 2), fun x ->
        Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal((-1, "TWO")) ])


test tuple3 =
  Stdlib.Test.all(
    [ Stdlib.Tuple3.create("one", 2, "pi")
      |> Stdlib.Test.equal(("one", 2, "pi"))

      Stdlib.Tuple3.create(1, "two", 3.14)
      |> Stdlib.Test.equal((1, "two", 3.14))

      Stdlib.Tuple3.first((1, "two", 3.14)) |> Stdlib.Test.equal(1)

      Stdlib.Tuple3.first(("one", 2, "pi")) |> Stdlib.Test.equal("one")

      Stdlib.Tuple3.second((1, "two", 3.14)) |> Stdlib.Test.equal("two")

      Stdlib.Tuple3.second(("one", 2, "pi")) |> Stdlib.Test.equal(2)

      Stdlib.Tuple3.third((1, "two", 3.14)) |> Stdlib.Test.equal(3.14)

      Stdlib.Tuple3.third(("one", 2, "pi")) |> Stdlib.Test.equal("pi")

      Stdlib.Tuple3.mapFirst(("one", 2, "pi"), fun x ->
        Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal(("ONE", 2, "pi"))

      Stdlib.Tuple3.mapFirst((1, "two", 3.14), fun x -> x - 2)
      |> Stdlib.Test.equal((-1, "two", 3.14))

      Stdlib.Tuple3.mapSecond(("one", 2, "pi"), fun x -> x - 2)
      |> Stdlib.Test.equal(("one", 0, "pi"))

      Stdlib.Tuple3.mapSecond((1, "two", 3.14), fun x ->
        Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal((1, "TWO", 3.14))

      Stdlib.Tuple3.mapThird(("one", 2, "pi"), fun x ->
        Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal(("one", 2, "PI"))

      Stdlib.Tuple3.mapThird((1, "two", 3.14), fun x ->
        Stdlib.Float.roundDown(x))
      |> Stdlib.Test.equal((1, "two", 3)) ])


test tuple3MapsAllThree =
  Stdlib.Test.all(
    [ Stdlib.Tuple3.mapAllThree(
        ("one", 2, "pi"),
        (fun x -> Stdlib.String.toUppercase(x)),
        (fun x -> x - 2),
        fun x -> Stdlib.String.toUppercase(x))
      |> Stdlib.Test.equal(("ONE", 0, "PI"))

      Stdlib.Tuple3.mapAllThree(
        (1, "two", 3.14),
        (fun x -> x - 2),
        (fun x -> Stdlib.String.toUppercase(x)),
        fun x -> Stdlib.Float.roundDown(x))
      |> Stdlib.Test.equal((-1, "TWO", 3)) ])
