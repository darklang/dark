module Darklang.Stdlib.Cli.Posix.Tests

/// An errno that differs by platform: macOS has no such syscall (ENOSYS, 78).
let errnoOr(linux: Int64): Int64 =
  if Stdlib.Cli.Posix.__abiMac() then 78 else linux


let posixError(code: Int64): Stdlib.Cli.Posix.Error =
  Stdlib.Cli.Posix.__fromErrno(code)


let linux(code: Int64): Stdlib.Cli.Posix.Errno =
  Stdlib.Cli.Posix.Errno { os = Stdlib.Cli.Posix.Os.Linux, code = code }


let darwin(code: Int64): Stdlib.Cli.Posix.Errno =
  Stdlib.Cli.Posix.Errno { os = Stdlib.Cli.Posix.Os.Darwin, code = code }


// Raw syscalls refuse bad descriptors and arguments with their errno
test syscallErrnos =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.read(-1z, 1) |> Stdlib.Test.equal(Error(9))
      Stdlib.Cli.Posix.read(-1z, -1) |> Stdlib.Test.equal(Error(22))
      Stdlib.Cli.Posix.close(-1z) |> Stdlib.Test.equal(Error(9))
      Stdlib.Cli.Posix.lseek(-1z, 0, 0) |> Stdlib.Test.equal(Error(9))
      Stdlib.Cli.Posix.kernelFlock(-1z, 2) |> Stdlib.Test.equal(Error(9))
      Stdlib.Test.expect(Stdlib.Cli.Posix.getpid() > 0, "getpid is positive")

      Stdlib.Test.expect(
        Stdlib.Cli.Posix.getuid() >= 0,
        "getuid is not negative")

      Stdlib.Cli.Posix.unlinkAt("/dark-syscall-missing-entry", 0)
      |> Stdlib.Test.equal(Error(2))

      Stdlib.Cli.Posix.unlinkAt("/dark-syscall-missing-entry", 64)
      |> Stdlib.Test.equal(Error(22))

      Stdlib.Cli.Posix.readlinkAt("/definitely/missing/dark-link", 2)
      |> Stdlib.Test.equal(Error(2))

      match Stdlib.Cli.Posix.getcwd(1) with
      | Error(e) -> e |> Stdlib.Test.equal(errnoOr(34))
      | Ok(_) -> Stdlib.Test.fail("getcwd into one byte should fail") ])


// unlinkat with the remove-directory flag removes a directory
test unlinkAtRemovesDirectory =
  Stdlib.Cli.Dir.withTemp(fun dir ->
    let path = Stdlib.String.append(dir, "/child")
    let created =
      Stdlib.Cli.Posix.mkdir(path, Stdlib.Cli.Posix.Modes.ownerOnlyDir)

    let removed =
      Stdlib.Cli.Posix.unlinkAt(path, Stdlib.Cli.Posix.__abiRemoveDirectory())

    (created, removed, Stdlib.Cli.File.exists(path)))
  |> Stdlib.Test.equal(Ok((Ok(), Ok(), false)))


// flock takes the exclusive lock and lets it go; withLock runs its fn holding it
test flockLocksAndUnlocks =
  Stdlib.Cli.Dir.withTemp(fun dir ->
    let path = Stdlib.Cli.Path.join([ dir, "lock" ])
    let flags =
      Stdlib.Cli.Posix.OpenFlags.wronly() | Stdlib.Cli.Posix.OpenFlags.creat()

    match Stdlib.Cli.Posix.openFile(
            path,
            flags,
            Stdlib.Cli.Posix.Modes.defaultFile) with
    | Ok(fd) ->
      let locked = Stdlib.Cli.Posix.flock(fd, Stdlib.Cli.Posix.Lock.Exclusive)
      let unlocked = Stdlib.Cli.Posix.flock(fd, Stdlib.Cli.Posix.Lock.Unlock)
      let _ = Stdlib.Cli.Posix.fdClose(fd)
      (locked, unlocked, Stdlib.Cli.File.withLock(path, fun _ -> 42))
    | Error(e) -> (Error(e), Error(e), Error(e)))
  |> Stdlib.Test.equal(Ok((Ok(), Ok(), Ok(42))))


// readlinkat truncates to the buffer it is given
test readlinkAtTruncates =
  Stdlib.Cli.Dir.withTemp(fun dir ->
    let link = Stdlib.Cli.Path.join([ dir, "link" ])
    let _ = Stdlib.Cli.Posix.symlink("abcdef", link)
    Stdlib.Cli.Posix.readlinkAt(link, 2)
    |> Stdlib.Result.map(Stdlib.Bytes.toList))
  |> Stdlib.Test.equal(Ok(Ok([ 97u8, 98u8 ])))


// The cwd and readlink wrappers grow their buffer until the result fits
test bufferGrowth =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.__pathCwdWith(
        (fun count ->
           if count == 2 then Error(34) else Ok(Stdlib.Utf8.encode("/x\0"))),
        2)
      |> Stdlib.Result.map(Stdlib.Bytes.toList)
      |> Stdlib.Test.equal(Ok([ 47u8, 120u8, 0u8 ]))

      Stdlib.Cli.Posix.__pathReadlinkWith(
        (fun count ->
           if count == 2 then
             Ok(Stdlib.Utf8.encode("ab"))
           else if count == 4 then
             Ok(Stdlib.Utf8.encode("abc"))
           else
             Error(22)),
        2)
      |> Stdlib.Result.map(Stdlib.Bytes.toList)
      |> Stdlib.Test.equal(Ok([ 97u8, 98u8, 99u8 ]))

      Stdlib.Cli.Posix.__pathReadlinkWith((fun _ -> Ok(Stdlib.Bytes.empty)), 0)
      |> Stdlib.Test.equal(Error(posixError(22))) ])


// Account parsing handles missing users and malformed rows
// Kernel records are little-endian; an 8-byte field covers all of Int64.
test kernelSignedField =
  let field(
    bytes: List<UInt8>,
    width: Int64)
    : Stdlib.Result.Result<Int64, Stdlib.Cli.Posix.Error> =
    Stdlib.Cli.Posix.__kernelSignedField(Stdlib.Bytes.fromList(bytes), 0, width)

  Stdlib.Test.all(
    [ field([ 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8 ], 8)
      |> Stdlib.Test.equal(Ok(-1))

      field([ 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 128u8 ], 8)
      |> Stdlib.Test.equal(Ok(-9223372036854775808))

      field([ 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 255u8, 127u8 ], 8)
      |> Stdlib.Test.equal(Ok(9223372036854775807))

      field([ 255u8, 255u8, 255u8, 255u8 ], 4) |> Stdlib.Test.equal(Ok(-1))

      field([ 1u8, 2u8, 3u8 ], 8)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply)) ])


test accountFieldFromPasswd =
  let alice = "alice:x:1000:1000::/home/alice:/bin/sh"
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.__accountFieldFromPasswd([], "1000", 5)
      |> Stdlib.Test.equal(None)

      Stdlib.Cli.Posix.__accountFieldFromPasswd([ "bad", alice ], "1000", 5)
      |> Stdlib.Test.equal(Some("/home/alice"))

      Stdlib.Cli.Posix.__accountFieldFromPasswd([ alice ], "1000", 0)
      |> Stdlib.Test.equal(Some("alice"))

      Stdlib.Cli.Posix.__accountFieldFromPasswd([ alice ], "100", 5)
      |> Stdlib.Test.equal(None)

      Stdlib.Cli.Posix.__accountFieldFromPasswd(
        [ "short:x:1000", alice ],
        "1000",
        5)
      |> Stdlib.Test.equal(Some("/home/alice")) ])


// One table per OS gives each number its kind, name and text
test errnoTables =
  let kind = Stdlib.Cli.Posix.Errno.kind
  Stdlib.Test.all(
    [ kind(linux(2)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.NotFound)

      kind(darwin(2)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.NotFound)

      kind(linux(13))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.PermissionDenied)

      kind(darwin(1))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.PermissionDenied)

      kind(linux(39))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.DirectoryNotEmpty)

      kind(darwin(66))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.DirectoryNotEmpty)

      kind(linux(40))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.FilesystemLoop)

      kind(darwin(62))
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.FilesystemLoop)

      kind(linux(999)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.Other)

      Stdlib.Cli.Posix.Errno.name(linux(2)) |> Stdlib.Test.equal(Some("ENOENT"))

      Stdlib.Cli.Posix.Errno.name(darwin(102))
      |> Stdlib.Test.equal(Some("EOPNOTSUPP"))

      Stdlib.Cli.Posix.Errno.name(linux(41)) |> Stdlib.Test.equal(None) ])


// EAGAIN and the not-supported numbers differ by OS; each OS reads only its own
test wouldBlockAndUnsupportedPerOs =
  let kind = Stdlib.Cli.Posix.Errno.kind
  let wouldBlock = Stdlib.Cli.Posix.ErrorKind.WouldBlock
  let unsupported = Stdlib.Cli.Posix.ErrorKind.Unsupported
  Stdlib.Test.all(
    [ kind(linux(11)) |> Stdlib.Test.equal(wouldBlock)
      kind(darwin(35)) |> Stdlib.Test.equal(wouldBlock)
      // EDEADLK on Linux, EAGAIN on Darwin
      kind(linux(35)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.Other)
      kind(darwin(11)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.Other)

      // ENOSYS and EOPNOTSUPP on Linux, ENOSYS and ENOTSUP on Darwin
      kind(linux(38)) |> Stdlib.Test.equal(unsupported)
      kind(linux(95)) |> Stdlib.Test.equal(unsupported)
      kind(darwin(78)) |> Stdlib.Test.equal(unsupported)
      kind(darwin(45)) |> Stdlib.Test.equal(unsupported)
      // the other OS's numbers mean something else
      kind(darwin(38)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.Other)
      kind(linux(78)) |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.Other) ])


// Display gives the OS's own text, or says what went wrong outside the kernel
test errorDisplay =
  let os = fun errno -> Stdlib.display(Stdlib.Cli.Posix.Error.Os(errno))
  Stdlib.Test.all(
    [ os(linux(2)) |> Stdlib.Test.equal("No such file or directory")

      os(darwin(2)) |> Stdlib.Test.equal("No such file or directory")

      os(linux(11)) |> Stdlib.Test.equal("Resource temporarily unavailable")

      os(darwin(35)) |> Stdlib.Test.equal("Resource temporarily unavailable")

      os(linux(35)) |> Stdlib.Test.equal("Resource deadlock avoided")

      os(darwin(62)) |> Stdlib.Test.equal("Too many levels of symbolic links")

      os(linux(999)) |> Stdlib.Test.equal("Unknown error 999")

      os(darwin(999)) |> Stdlib.Test.equal("Unknown error: 999")

      Stdlib.display(Stdlib.Cli.Posix.Error.InvalidUtf8)
      |> Stdlib.Test.equal("File contents are not valid UTF-8")

      Stdlib.display(Stdlib.Cli.Posix.Error.ProcessTimedOut)
      |> Stdlib.Test.equal("Process timed out")

      Stdlib.Cli.Posix.Error.kind(Stdlib.Cli.Posix.Error.InvalidUtf8)
      |> Stdlib.Test.equal(Stdlib.Cli.Posix.ErrorKind.InvalidData)

      Stdlib.Cli.Posix.__decimal(0) |> Stdlib.Test.equal("0")

      Stdlib.Cli.Posix.__decimal(-1) |> Stdlib.Test.equal("-1") ])


// A name collision retries until it succeeds; any other error stops at once
test tempRetry =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.__tempRetry(
        (fun remaining ->
           if remaining > 0 then Error(posixError(17)) else Ok("created")),
        2)
      |> Stdlib.Test.equal(Ok("created"))

      // EINVAL on the first try (2 left) stops at once
      Stdlib.Cli.Posix.__tempRetry(
        (fun remaining -> Error(posixError(20 + remaining))),
        2)
      |> Stdlib.Test.equal(Error(posixError(22)))

      // EEXIST every time: the last try, with none left, is the answer
      Stdlib.Cli.Posix.__tempRetry(
        (fun remaining -> Error(posixError(if remaining == 0 then 28 else 17))),
        2)
      |> Stdlib.Test.equal(Error(posixError(28))) ])


// Partial writes complete, zero-progress writes fail, and errors propagate
test writeAll =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.__writeAll(
        (fun bytes ->
           Ok(
             if Stdlib.Bytes.length(bytes) > 1 then
               1
             else
               Stdlib.Bytes.length(bytes))),
        Stdlib.Utf8.encode("abcd"),
        0)
      |> Stdlib.Test.equal(Ok(4))

      Stdlib.Cli.Posix.__writeAll(
        (fun _ -> Ok(0)),
        Stdlib.Utf8.encode("abc"),
        0)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply))

      Stdlib.Cli.Posix.__writeAll((fun _ -> Ok(0)), Stdlib.Utf8.encode(""), 0)
      |> Stdlib.Test.equal(Ok(0))

      Stdlib.Cli.Posix.__writeAll(
        (fun _ -> Error(posixError(9))),
        Stdlib.Utf8.encode("abc"),
        0)
      |> Stdlib.Test.equal(Error(posixError(9))) ])


// The public wrappers reach the host and format their results
test publicWrappers =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.uname()
      |> Stdlib.Result.map(fun((sysname, nodename, machine)) ->
        sysname != "" && nodename != "" && machine != "")
      |> Stdlib.Test.equal(Ok(true))

      Stdlib.Cli.Posix.getCwd()
      |> Stdlib.Result.map(fun path -> Stdlib.String.startsWith(path, "/"))
      |> Stdlib.Test.equal(Ok(true))

      Stdlib.Cli.Posix.fdRead(Stdlib.Cli.Posix.Fd { __fd = -1z }, 1)
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("Bad file descriptor")) ])


// Setting a file's times through the platform syscall shows up in stat
test setFileTimes =
  let missing = "/definitely/missing/dark-time"
  let setTimes = fun(path, atime, mtime) ->
    if Stdlib.Cli.Posix.__abiMac() then
      Stdlib.Cli.Posix.setattrlistTimes(path, atime, 0, mtime, 0)
    else
      Stdlib.Cli.Posix.utimensAt(path, atime, 0, mtime, 0)

  let stamped = Stdlib.Cli.Dir.withTemp(fun dir ->
    let path = Stdlib.Cli.Path.join([ dir, "stamp" ])
    let _ = Stdlib.Cli.File.writeText(path, "x")
    let _ = setTimes(path, 1234, 5678)
    Stdlib.Cli.Posix.stat(path)
    |> Stdlib.Result.map(fun record -> record.mtimeSec))

  Stdlib.Test.all(
    [ setTimes(missing, 0, 0) |> Stdlib.Test.equal(Error(2))
      stamped |> Stdlib.Test.equal(Ok(Ok(5678))) ])


test pidFromInt64 =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.Pid.fromInt64(1)
      |> Stdlib.Result.map(Stdlib.Cli.Posix.Pid.toInt64)
      |> Stdlib.Test.equal(Ok(1))

      Stdlib.Cli.Posix.Pid.fromInt64(2147483647)
      |> Stdlib.Result.map(Stdlib.Cli.Posix.Pid.toInt64)
      |> Stdlib.Test.equal(Ok(2147483647))

      // 0 and negatives name process groups to kill(2), not a process.
      Stdlib.Cli.Posix.Pid.fromInt64(0)
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(
        Error("0 is not a valid process ID (1 to 2147483647)"))

      Stdlib.Cli.Posix.Pid.fromInt64(-1)
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(
        Error("-1 is not a valid process ID (1 to 2147483647)"))

      Stdlib.Cli.Posix.Pid.fromInt64(2147483648)
      |> Stdlib.Test.equal(
        Error(
          Stdlib.Math.OutOfRange
            { what = "process ID"
              value = 2147483648
              min = 1
              max = 2147483647 })) ])


test pidAndExitCodeInspect =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.Pid.fromInt64(4242)
      |> Stdlib.Result.map(Stdlib.inspect)
      |> Stdlib.Test.equal(Ok("Pid(4242)"))

      Stdlib.inspect(Stdlib.Cli.Posix.ExitCode.failure)
      |> Stdlib.Test.equal("ExitCode(1)")

      Stdlib.inspect([ Stdlib.Cli.Posix.ExitCode.success ])
      |> Stdlib.Test.equal("[ExitCode(0)]")

      $"{Some(Stdlib.Cli.Posix.ExitCode.failure)}"
      |> Stdlib.Test.equal("Some(ExitCode(1))") ])


test exitCodeFromInt64 =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.ExitCode.fromInt64(0)
      |> Stdlib.Test.equal(Ok(Stdlib.Cli.Posix.ExitCode.success))

      Stdlib.Cli.Posix.ExitCode.fromInt64(1)
      |> Stdlib.Test.equal(Ok(Stdlib.Cli.Posix.ExitCode.failure))

      Stdlib.Cli.Posix.ExitCode.fromInt64(255)
      |> Stdlib.Result.map(Stdlib.Cli.Posix.ExitCode.toInt64)
      |> Stdlib.Test.equal(Ok(255))

      Stdlib.Cli.Posix.ExitCode.fromInt64(256)
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("256 is not a valid exit code (0 to 255)"))

      Stdlib.Cli.Posix.ExitCode.isSuccess(Stdlib.Cli.Posix.ExitCode.success)
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.Posix.ExitCode.isSuccess(Stdlib.Cli.Posix.ExitCode.failure)
      |> Stdlib.Test.equal(false)

      Stdlib.display(Stdlib.Cli.Posix.ExitCode.failure)
      |> Stdlib.Test.equal("1") ])


test fileModes =
  Stdlib.Test.all(
    [ Stdlib.Cli.Posix.FileMode.fromInt64(420)
      |> Stdlib.Test.equal(Ok(Stdlib.Cli.Posix.Modes.defaultFile))

      Stdlib.Cli.Posix.FileMode.fromInt64(65536)
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("65536 is not a valid file mode (0 to 65535)"))

      Stdlib.display(Stdlib.Cli.Posix.Modes.defaultDir)
      |> Stdlib.Test.equal("0755")

      Stdlib.inspect(Stdlib.Cli.Posix.Modes.defaultFile)
      |> Stdlib.Test.equal("FileMode(0644)")

      // a directory's st_mode: the type bits and 0755
      Stdlib.Cli.Posix.FileMode.fromInt64(16877)
      |> Stdlib.Result.map(fun mode ->
        (
          Stdlib.Cli.Posix.FileMode.fileType(mode)
          == Stdlib.Cli.Posix.StatMode.ifdir,
          Stdlib.Cli.Posix.FileMode.permissions(mode)
          == Stdlib.Cli.Posix.Modes.defaultDir))
      |> Stdlib.Test.equal(Ok((true, true))) ])


// A signal is sent as its number, the same on Linux and macOS
test signalNumbers =
  [ Stdlib.Cli.Posix.Signal.SIGHUP
    Stdlib.Cli.Posix.Signal.SIGINT
    Stdlib.Cli.Posix.Signal.SIGQUIT
    Stdlib.Cli.Posix.Signal.SIGKILL
    Stdlib.Cli.Posix.Signal.SIGTERM ]
  |> Stdlib.List.map(Stdlib.Cli.Posix.Signal.toInt64)
  |> Stdlib.Test.equal([ 1, 2, 3, 9, 15 ])


// Signal 0 checks existence; the current process is always running.
test isProcessRunningSelf =
  match Stdlib.Cli.Posix.Pid.fromInt64(Stdlib.Cli.Sys.currentPid()) with
  | Ok(me) -> Stdlib.Cli.Posix.isProcessRunning(me) |> Stdlib.Test.equal(true)
  | Error(e) -> Stdlib.Test.expect(false, Stdlib.display(e))


test signalDisplay =
  Stdlib.Test.all(
    [ Stdlib.display(Stdlib.Cli.Posix.Signal.SIGTERM)
      |> Stdlib.Test.equal("SIGTERM")

      $"sent {Stdlib.Cli.Posix.Signal.SIGKILL}"
      |> Stdlib.Test.equal("sent SIGKILL") ])
