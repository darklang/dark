module Darklang.Stdlib.Cli.File.Tests

// File.globMatchSegments — basic matching
test basicMatching =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments([ "*.ts" ], [ "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "*.ts" ], [ "foo.js" ])
      |> Stdlib.Test.equal(false)

      Stdlib.Cli.File.globMatchSegments([ "src", "*.ts" ], [ "src", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "src", "*.ts" ], [ "lib", "foo.ts" ])
      |> Stdlib.Test.equal(false) ])


// File.globMatchSegments — single ** segment
test singleDoubleStar =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments([ "**", "*.ts" ], [ "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "**", "*.ts" ], [ "src", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "**", "*.ts" ],
        [ "a", "b", "c", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "**", "*.ts" ], [ "foo.js" ])
      |> Stdlib.Test.equal(false)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "*.ts" ],
        [ "src", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "*.ts" ],
        [ "src", "a", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "*.ts" ],
        [ "src", "a", "b", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "*.ts" ],
        [ "lib", "foo.ts" ])
      |> Stdlib.Test.equal(false) ])


// File.globMatchSegments — multiple ** segments
test multipleDoubleStars =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "src", "test", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "src", "a", "test", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "src", "a", "test", "b", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "src", "a", "b", "test", "c", "d", "foo.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "src", "a", "test", "b", "foo.js" ])
      |> Stdlib.Test.equal(false)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**", "test", "**", "*.ts" ],
        [ "lib", "test", "foo.ts" ])
      |> Stdlib.Test.equal(false) ])


// File.globMatchSegments — trailing **
test trailingDoubleStar =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments([ "src", "**" ], [ "src" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "src", "**" ], [ "src", "a" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments(
        [ "src", "**" ],
        [ "src", "a", "b", "c" ])
      |> Stdlib.Test.equal(true) ])


// File.globMatchSegments — ** matches zero segments
test doubleStarMatchesZeroSegments =
  Stdlib.Cli.File.globMatchSegments(
    [ "**", "test", "**", "*.ts" ],
    [ "test", "foo.ts" ])
  |> Stdlib.Test.equal(true)


// File.globMatchSegments — empty pattern/path
test emptyPatternOrPath =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments([], []) |> Stdlib.Test.equal(true)
      Stdlib.Cli.File.globMatchSegments([ "a" ], []) |> Stdlib.Test.equal(false)
      Stdlib.Cli.File.globMatchSegments([], [ "a" ])
      |> Stdlib.Test.equal(false) ])


// File.globMatchSegments — ? wildcard
test questionMarkWildcard =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.globMatchSegments([ "?.ts" ], [ "a.ts" ])
      |> Stdlib.Test.equal(true)

      Stdlib.Cli.File.globMatchSegments([ "?.ts" ], [ "ab.ts" ])
      |> Stdlib.Test.equal(false) ])


/// One `__globMatches` case, labelled so a failure names its pattern and text.
let globCase(
  pattern: String,
  text: String,
  pathname: Bool,
  expected: Bool)
  : Stdlib.Test.Result =
  let actual = Stdlib.Cli.File.__globMatches(pattern, text, pathname)
  Stdlib.Test.expect(
    actual == expected,
    $"__globMatches({Stdlib.inspect(pattern)}, {Stdlib.inspect(text)}, pathname={Stdlib.display(pathname)}): expected {Stdlib.display(expected)}")


// __globMatches: POSIX glob semantics, independent of libc availability.
test globSemantics =
  Stdlib.Test.all(
    [ globCase("", "", false, true)
      globCase("*", "", false, true)
      globCase("*", ".hidden", true, true)
      globCase("*", "a/b", false, true)
      globCase("*", "a/b", true, false)
      globCase("?", "/", true, false)
      globCase("[/]", "/", true, false)
      globCase("[/]", "/", false, true)
      globCase("a/**/x", "a/b/c/x", true, false)
      globCase("a/**/x", "a/b/c/x", false, true)
      globCase("a/**/x", "a/b/x", true, true)
      globCase("\\*", "*", false, true)
      globCase("\\?", "?", false, true)
      globCase("a\\", "a", false, false)
      globCase("[abc", "[abc", false, true)
      globCase("[]a]", "]", false, true)
      globCase("[a-]", "-", false, true)
      globCase("[-a]", "-", false, true)
      globCase("[a-c]", "b", false, true)
      globCase("[!a-c]", "b", false, false)
      globCase("[^a-c]", "z", false, true)
      globCase("[[:digit:]]", "5", false, true)
      globCase("[[:alpha:]]", "F", false, true)
      globCase("[[:xdigit:]]", "g", false, false)
      globCase("[[:space:]]", "\t", false, true)
      globCase("[![:bogus:]]", "a", false, false)
      globCase("[[.a.]]", "a", false, true)
      globCase("[[=a=]]", "a", false, true)
      globCase("[a-[.c.]]", "b", false, true)
      globCase("a\0b", "a", false, false)
      globCase("a", "a\0b", false, false)
      globCase("?", "\0", false, true)
      globCase("a\0b", "a\0b", false, true)
      globCase("?", "\0a", false, false) ])


// __globMatches: like libc's default C locale, matching consumes UTF-8 bytes, not graphemes.
test globMatchesUtf8Bytes =
  Stdlib.Test.all(
    [ globCase("é", "é", false, true)
      globCase("?", "é", false, false)
      globCase("??", "é", false, true)
      globCase("***a***b***", "aaabbb", false, true) ])


// __globMatches: outcomes checked against host libc's fnmatch in its default C locale.
test globLibcCorpus =
  Stdlib.Test.all(
    [ globCase("**/x", "a", true, false)
      globCase("?", "z", true, true)
      globCase("[a-c]*", "F", true, false)
      globCase("[[:space:]]", "b", false, false)
      globCase("[a-c]", "F", true, false)
      globCase("", "b", false, false)
      globCase("\\?", " ", false, false)
      globCase("a?c", "b", true, false)
      globCase("[a-c]", "z", true, false)
      globCase("[\\]]", "x", false, false)
      globCase("[[:alpha:]]", "5", true, false)
      globCase("\\?", "z", true, false)
      globCase("[[:xdigit:]]", "?", true, false)
      globCase("[a-]", "/", false, false)
      globCase("[[:alpha:]]", "-", false, false)
      globCase("[[:space:]]", "abc", false, false)
      globCase("[a-]", "abc", false, false)
      globCase("[a-]", "x", false, false)
      globCase("[a-c]", "x", true, false)
      globCase("a\\", "F", false, false)
      globCase("\\?", "-", true, false)
      globCase("", " ", true, false)
      globCase("a?c", "?", true, false)
      globCase("[a-]", "5", true, false)
      globCase("[abc", "-", false, false)
      globCase("a?c", " ", false, false)
      globCase("[\\]]", "a/b", false, false)
      globCase("*/*", "/", false, true)
      globCase("**/x", "abc", false, false)
      globCase("[[:alpha:]]", "", false, false)
      globCase("[[:xdigit:]]", "", true, false)
      globCase("[a-c]", "-", true, false)
      globCase("[", "-", true, false)
      globCase("**/x", "a", false, false)
      globCase("[abc", "z", false, false)
      globCase("a?c", "*", false, false)
      globCase("[a-]", "/", true, false)
      globCase("*", "abc", true, true)
      globCase("?", "", false, false)
      globCase("\\*", "F", false, false)
      globCase("\\*", "a/b", true, false)
      globCase("[a-c]", "a", false, true)
      globCase("[]a]", "a/x", false, false)
      globCase("[-a]", "a", false, true)
      globCase("[[:alpha:]]", " ", false, false)
      globCase("[", "*", true, false)
      globCase("*", "?", true, true)
      globCase("[abc", "", true, false)
      globCase("a\\", "*", true, false)
      globCase("[abc", " ", false, false)
      globCase("[a-c]*", "F", false, false)
      globCase("[!a-c]", "?", true, true)
      globCase("[abc", "a", false, false)
      globCase("[a-]", "*", true, false)
      globCase("[[:bogus:]]", "5", false, false)
      globCase("?", "abc", true, false)
      globCase("[", "/", false, false)
      globCase("[a-c]*", "-", true, false)
      globCase("[[:bogus:]]", "x", true, false)
      globCase("[[:digit:]]", "a/b", true, false)
      globCase("[^a-c]", "]", false, true)
      globCase("[", "5", false, false)
      globCase("[\\]]", "*", true, false)
      globCase("[", "z", true, false)
      globCase("[^a-c]", "5", false, true)
      globCase("[!a-c]", "-", true, true)
      globCase("[\\]]", "b", true, false)
      globCase("[abc", "b", false, false)
      globCase("*/*", "b", false, false)
      globCase("[\\]]", "]", true, true)
      globCase("[-a]", "a/b", false, false)
      globCase("a?c", "z", true, false)
      globCase("[[:space:]]", "?", false, false)
      globCase("[a-c]*", "b", true, true)
      globCase("a?c", "b", false, false)
      globCase("?", "", true, false)
      globCase("[\\]]", "abc", true, false)
      globCase("a\\", "]", true, false)
      globCase("[abc", "?", true, false)
      globCase("[[:xdigit:]]", "*", false, false)
      globCase("[[:space:]]", "?", true, false)
      globCase("[abc", "F", false, false)
      globCase("[a-]", "*", false, false)
      globCase("a\\", "abc", false, false)
      globCase("**/x", " ", false, false)
      globCase("[a-]", "5", false, false)
      globCase("[\\]]", "?", false, false)
      globCase("**/x", "x", true, false)
      globCase("*/*", "b", true, false)
      globCase("[\\]]", "-", true, false)
      globCase("[[:space:]]", "a", true, false)
      globCase("a\\", " ", false, false)
      globCase("a\\", "b", true, false)
      globCase("[[:digit:]]", "*", true, false)
      globCase("a\\", "a/b", true, false)
      globCase("[[:bogus:]]", "z", false, false)
      globCase("[[:digit:]]", "F", false, false)
      globCase("[[:xdigit:]]", "a/x", true, false)
      globCase("[", "", false, false)
      globCase("[a-c]", "", false, false)
      globCase("[a-c]", "F", false, false)
      globCase("a\\", "x", false, false)
      globCase("**/x", "/", true, false)
      globCase("[", "?", true, false)
      globCase("[abc", "x", false, false)
      globCase("?", "a/b", true, false)
      globCase("a?c", " ", true, false)
      globCase("a?c", "-", false, false)
      globCase("[[:space:]]", "*", true, false)
      globCase("?", "/", false, true)
      globCase("[-a]", "a", true, true)
      globCase("[[:bogus:]]", "?", true, false)
      globCase("[[:xdigit:]]", "a/x", false, false)
      globCase("[-a]", "abc", false, false)
      globCase("[-a]", "x", true, false)
      globCase("\\?", "]", false, false)
      globCase("[[:bogus:]]", "[[:bogus:]]", false, false) ])
