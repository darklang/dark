module Darklang.Stdlib.Cli.File.Bytes.Tests

let events(bytes: List<UInt8>): Stdlib.Result.Result<(Bool * Bool), Int> =
  Stdlib.Cli.File.__watchEvents(Stdlib.Bytes.fromList(bytes), 0, false, false)

let vnodeEvents(bytes: List<UInt8>): Stdlib.Result.Result<(Bool * Bool), Int> =
  Stdlib.Cli.File.__watchVnodeEvents(Stdlib.Bytes.fromList(bytes), 0, false, false)

/// <param n> zero bytes.
let zeros(n: Int): List<UInt8> =
  Stdlib.Result.withDefault(Stdlib.List.repeat(n, 0uy), [])

/// A 16-byte inotify header with <param mask> and no name.
let inotify(mask: List<UInt8>): List<UInt8> =
  Stdlib.List.flatten(
    [ [ 1uy, 0uy, 0uy, 0uy ], mask, zeros(8) ])

/// A 32-byte kevent with <param flags> (2 bytes) and <param fflags> (4 bytes).
let kevent(flags: List<UInt8>, fflags: List<UInt8>, data: List<UInt8>): List<UInt8> =
  Stdlib.List.flatten(
    [ [ 1uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 252uy, 255uy ]
      flags
      fflags
      data
      zeros(8) ])

// __watchEvents (inotify)
test watchEvents =
  Stdlib.Test.all(
    [ events([]) |> Stdlib.Test.equal(Ok((false, false)))
      events([ 0uy ]) |> Stdlib.Test.equal(Error(5))
      events(inotify([ 2uy, 0uy, 0uy, 0uy ])) |> Stdlib.Test.equal(Ok((true, false)))
      events(inotify([ 0uy, 8uy, 0uy, 0uy ])) |> Stdlib.Test.equal(Ok((true, true)))
      // A name length that runs past the buffer.
      events(
        Stdlib.List.flatten(
          [ [ 1uy, 0uy, 0uy, 0uy, 2uy, 0uy, 0uy, 0uy ]
            zeros(4)
            [ 8uy, 0uy, 0uy, 0uy ] ]))
      |> Stdlib.Test.equal(Error(5)) ])

// Each event is read from where the previous one ended, including its name.
test watchEventsWalksSeveralEvents =
  let named =
    Stdlib.List.flatten(
      [ [ 1uy, 0uy, 0uy, 0uy, 0uy, 128uy, 0uy, 0uy ]
        zeros(4)
        [ 4uy, 0uy, 0uy, 0uy, 97uy, 98uy, 0uy, 0uy ] ])
  Stdlib.Test.all(
    [ events(Stdlib.List.concat(inotify([ 2uy, 0uy, 0uy, 0uy ]), named))
      |> Stdlib.Test.equal(Ok((true, true)))
      events(Stdlib.List.concat(named, inotify([ 0uy, 0uy, 0uy, 0uy ])))
      |> Stdlib.Test.equal(Ok((false, true)))
      events(Stdlib.List.concat(inotify([ 2uy, 0uy, 0uy, 0uy ]), [ 1uy, 2uy, 3uy ]))
      |> Stdlib.Test.equal(Error(5)) ])

// __watchVnodeEvents (kqueue)
test watchVnodeEvents =
  let noData = zeros(8)
  Stdlib.Test.all(
    [ vnodeEvents([]) |> Stdlib.Test.equal(Ok((false, false)))
      vnodeEvents([ 0uy ]) |> Stdlib.Test.equal(Error(5))
      vnodeEvents(kevent([ 0uy, 0uy ], [ 2uy, 0uy, 0uy, 0uy ], noData))
      |> Stdlib.Test.equal(Ok((true, false)))
      vnodeEvents(kevent([ 0uy, 0uy ], [ 32uy, 0uy, 0uy, 0uy ], noData))
      |> Stdlib.Test.equal(Ok((true, true))) ])

test watchVnodeEventsWalksSeveralEvents =
  let noData = zeros(8)
  let changed = kevent([ 0uy, 0uy ], [ 2uy, 0uy, 0uy, 0uy ], noData)
  let deleted = kevent([ 0uy, 0uy ], [ 1uy, 0uy, 0uy, 0uy ], noData)
  let failed = kevent([ 0uy, 64uy ], [ 0uy, 0uy, 0uy, 0uy ], [ 2uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy ])
  let failedNoErrno = kevent([ 0uy, 64uy ], [ 0uy, 0uy, 0uy, 0uy ], noData)
  Stdlib.Test.all(
    [ vnodeEvents(Stdlib.List.concat(changed, deleted))
      |> Stdlib.Test.equal(Ok((true, true)))
      vnodeEvents(Stdlib.List.concat(changed, failed)) |> Stdlib.Test.equal(Error(2))
      vnodeEvents(Stdlib.List.concat(failedNoErrno, changed))
      |> Stdlib.Test.equal(Ok((true, false)))
      vnodeEvents(Stdlib.List.concat(changed, [ 1uy ])) |> Stdlib.Test.equal(Error(5)) ])

// countNewlines
test countNewlines =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.countNewlines(Stdlib.Bytes.empty) |> Stdlib.Test.equal(0)
      Stdlib.Cli.File.countNewlines(Stdlib.Utf8.encode("a")) |> Stdlib.Test.equal(0)
      Stdlib.Cli.File.countNewlines(Stdlib.Utf8.encode("a\nb\n"))
      |> Stdlib.Test.equal(2)
      Stdlib.Cli.File.countNewlines(Stdlib.Utf8.encode("\n\n\n"))
      |> Stdlib.Test.equal(3)
      Stdlib.Cli.File.countNewlines(
        Stdlib.Utf8.encode(Stdlib.String.repeat("x\n", 1000)))
      |> Stdlib.Test.equal(1000) ])

// dropThroughFirstNewline
test dropThroughFirstNewline =
  let drop(text: String): Stdlib.Result.Result<String, String> =
    Stdlib.Utf8.decode(
      Stdlib.Cli.File.dropThroughFirstNewline(Stdlib.Utf8.encode(text)))
  Stdlib.Test.all(
    [ drop("") |> Stdlib.Test.equal(Ok(""))
      drop("abc") |> Stdlib.Test.equal(Ok(""))
      drop("a\nbc") |> Stdlib.Test.equal(Ok("bc"))
      drop("\nx") |> Stdlib.Test.equal(Ok("x"))
      drop("x\n") |> Stdlib.Test.equal(Ok(""))
      drop("a\nb\nc") |> Stdlib.Test.equal(Ok("b\nc")) ])

// __copyWriteAt: a write must make exact progress; errors pass through
test copyWriteAt =
  let abc = Stdlib.Utf8.encode("abc")
  Stdlib.Test.all(
    [ Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(1)), abc, 0)
      |> Stdlib.Test.equal(Ok())
      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(0)), abc, 0)
      |> Stdlib.Test.equal(Error(5))
      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(4)), abc, 0)
      |> Stdlib.Test.equal(Error(5))
      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Error(28)), abc, 0)
      |> Stdlib.Test.equal(Error(28)) ])

// __copyBuffered reads 64 KiB chunks from the offset until an empty read
test copyBuffered =
  Stdlib.Cli.File.__copyBuffered(
    (fun(count, offset) ->
      if count != 65536 then Error(22)
      else if offset == 2 then Ok(Stdlib.Utf8.encode("abc"))
      else if offset == 5 then Ok(Stdlib.Bytes.empty)
      else Error(22)),
    (fun(_, offset) -> if offset >= 2 && offset < 5 then Ok(1) else Error(22)),
    2)
  |> Stdlib.Test.equal(Ok())

// Which errnos fall back to a buffered copy, and which error wins on close
test copyFallbackAndFinish =
  let posixError = fun(errno, message) ->
    Stdlib.Cli.Posix.Error { errno = errno, message = message }
  Stdlib.Test.all(
    [ Stdlib.Cli.File.__copyUnsupported(18) |> Stdlib.Test.equal(true)
      Stdlib.Cli.File.__copyUnsupported(28) |> Stdlib.Test.equal(false)
      Stdlib.Cli.File.__copyFinish(
        Error(posixError(28, "full")),
        Error(posixError(5, "close")))
      |> Stdlib.Test.equal(Error(posixError(28, "full"))) ])

// Copying a directory fails with EISDIR and leaves no destination behind
test copyDirectoryRefused =
  Stdlib.Cli.Dir.withTemp(fun dir ->
    let destination = Stdlib.String.append(dir, "/not-a-file")
    let copied = Stdlib.Cli.File.copy(dir, destination)
    let errno =
      match copied with
      | Error(e) -> Stdlib.Option.Option.Some(e.errno)
      | Ok(_) -> Stdlib.Option.Option.None
    (errno, Stdlib.Cli.File.exists(destination)))
  |> Stdlib.Test.equal(Ok((Stdlib.Option.Option.Some(21), false)))

// Watching a missing path returns at once; a zero interval is still valid
test watchEdges =
  let immediate =
    Stdlib.Cli.Dir.withTemp(fun dir ->
      let path = $"{dir}/watch"
      let wrote = Stdlib.Cli.File.writeText(path, "x")
      let watched = Stdlib.Cli.File.watch(path, 0.0, (fun _ -> true), fun _ -> ())
      (wrote, watched))
  Stdlib.Test.all(
    [ Stdlib.Cli.File.__watchLinux("/does-not-exist", 10, (fun _ -> true), fun _ -> ())
      |> Stdlib.Test.equal(Ok())
      immediate |> Stdlib.Test.equal(Ok((Ok(), Ok()))) ])
