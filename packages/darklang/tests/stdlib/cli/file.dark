module Darklang.Stdlib.Cli.File.Bytes.Tests

let events(
  bytes: List<UInt8>)
  : Stdlib.Result.Result<(Bool * Bool), Stdlib.Cli.Posix.Error> =
  Stdlib.Cli.File.__watchEvents(Stdlib.Bytes.fromList(bytes), 0, false, false)


let vnodeEvents(
  bytes: List<UInt8>)
  : Stdlib.Result.Result<(Bool * Bool), Stdlib.Cli.Posix.Error> =
  Stdlib.Cli.File.__watchVnodeEvents(
    Stdlib.Bytes.fromList(bytes),
    0,
    false,
    false)


/// <param n> zero bytes.
let zeros(n: Int64): List<UInt8> =
  Stdlib.List.repeat(n, 0u8)


/// A 16-byte inotify header with <param mask> and no name.
let inotify(mask: List<UInt8>): List<UInt8> =
  Stdlib.List.flatten([ [ 1u8, 0u8, 0u8, 0u8 ], mask, zeros(8) ])


/// A 32-byte kevent with <param flags> (2 bytes) and <param fflags> (4 bytes).
let kevent(
  flags: List<UInt8>,
  fflags: List<UInt8>,
  data: List<UInt8>)
  : List<UInt8> =
  Stdlib.List.flatten(
    [ [ 1u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 252u8, 255u8 ]
      flags
      fflags
      data
      zeros(8) ])


// __watchEvents (inotify)
test watchEvents =
  Stdlib.Test.all(
    [ events([]) |> Stdlib.Test.equal(Ok((false, false)))

      events([ 0u8 ])
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply))

      events(inotify([ 2u8, 0u8, 0u8, 0u8 ]))
      |> Stdlib.Test.equal(Ok((true, false)))

      events(inotify([ 0u8, 8u8, 0u8, 0u8 ]))
      |> Stdlib.Test.equal(Ok((true, true)))

      // A name length that runs past the buffer.
      events(
        Stdlib.List.flatten(
          [ [ 1u8, 0u8, 0u8, 0u8, 2u8, 0u8, 0u8, 0u8 ]
            zeros(4)
            [ 8u8, 0u8, 0u8, 0u8 ] ]))
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply)) ])


// Each event is read from where the previous one ended, including its name.
test watchEventsWalksSeveralEvents =
  let named =
    Stdlib.List.flatten(
      [ [ 1u8, 0u8, 0u8, 0u8, 0u8, 128u8, 0u8, 0u8 ]
        zeros(4)
        [ 4u8, 0u8, 0u8, 0u8, 97u8, 98u8, 0u8, 0u8 ] ])

  Stdlib.Test.all(
    [ events(Stdlib.List.concat(inotify([ 2u8, 0u8, 0u8, 0u8 ]), named))
      |> Stdlib.Test.equal(Ok((true, true)))

      events(Stdlib.List.concat(named, inotify([ 0u8, 0u8, 0u8, 0u8 ])))
      |> Stdlib.Test.equal(Ok((false, true)))

      events(
        Stdlib.List.concat(inotify([ 2u8, 0u8, 0u8, 0u8 ]), [ 1u8, 2u8, 3u8 ]))
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply)) ])


// __watchVnodeEvents (kqueue)
test watchVnodeEvents =
  let noData = zeros(8)
  Stdlib.Test.all(
    [ vnodeEvents([]) |> Stdlib.Test.equal(Ok((false, false)))

      vnodeEvents([ 0u8 ])
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply))

      vnodeEvents(kevent([ 0u8, 0u8 ], [ 2u8, 0u8, 0u8, 0u8 ], noData))
      |> Stdlib.Test.equal(Ok((true, false)))

      vnodeEvents(kevent([ 0u8, 0u8 ], [ 32u8, 0u8, 0u8, 0u8 ], noData))
      |> Stdlib.Test.equal(Ok((true, true))) ])


test watchVnodeEventsWalksSeveralEvents =
  let noData = zeros(8)
  let changed = kevent([ 0u8, 0u8 ], [ 2u8, 0u8, 0u8, 0u8 ], noData)

  let deleted = kevent([ 0u8, 0u8 ], [ 1u8, 0u8, 0u8, 0u8 ], noData)

  let failed =
    kevent(
      [ 0u8, 64u8 ],
      [ 0u8, 0u8, 0u8, 0u8 ],
      [ 2u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8 ])

  let failedNoErrno = kevent([ 0u8, 64u8 ], [ 0u8, 0u8, 0u8, 0u8 ], noData)
  Stdlib.Test.all(
    [ vnodeEvents(Stdlib.List.concat(changed, deleted))
      |> Stdlib.Test.equal(Ok((true, true)))

      vnodeEvents(Stdlib.List.concat(changed, failed))
      |> Stdlib.Test.equal(
        Error(
          Stdlib.Cli.Posix.Error.Os(
            Stdlib.Cli.Posix.Errno
              { os = Stdlib.Cli.Posix.Os.Darwin, code = 2 })))

      vnodeEvents(Stdlib.List.concat(failedNoErrno, changed))
      |> Stdlib.Test.equal(Ok((true, false)))

      vnodeEvents(Stdlib.List.concat(changed, [ 1u8 ]))
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply)) ])


// countNewlines
test countNewlines =
  Stdlib.Test.all(
    [ Stdlib.Cli.File.__countNewlines(Stdlib.Bytes.empty)
      |> Stdlib.Test.equal(0)

      Stdlib.Cli.File.__countNewlines(Stdlib.Utf8.encode("a"))
      |> Stdlib.Test.equal(0)

      Stdlib.Cli.File.__countNewlines(Stdlib.Utf8.encode("a\nb\n"))
      |> Stdlib.Test.equal(2)

      Stdlib.Cli.File.__countNewlines(Stdlib.Utf8.encode("\n\n\n"))
      |> Stdlib.Test.equal(3)

      Stdlib.Cli.File.__countNewlines(
        Stdlib.Utf8.encode(Stdlib.String.repeat("x\n", 1000)))
      |> Stdlib.Test.equal(1000) ])


// dropThroughFirstNewline
test dropThroughFirstNewline =
  let drop(text: String): Stdlib.Result.Result<String, String> =
    Stdlib.Utf8.decode(
      Stdlib.Cli.File.__dropThroughFirstNewline(Stdlib.Utf8.encode(text)))

  Stdlib.Test.all(
    [ drop("") |> Stdlib.Test.equal(Ok(""))
      drop("abc") |> Stdlib.Test.equal(Ok(""))
      drop("a\nbc") |> Stdlib.Test.equal(Ok("bc"))
      drop("\nx") |> Stdlib.Test.equal(Ok("x"))
      drop("x\n") |> Stdlib.Test.equal(Ok(""))
      drop("a\nb\nc") |> Stdlib.Test.equal(Ok("b\nc")) ])


// __copyWriteAt: a write must make exact progress; errors pass through
test copyWriteAt =
  let abc = Stdlib.Utf8.encode("abc")
  Stdlib.Test.all(
    [ Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(1)), abc, 0)
      |> Stdlib.Test.equal(Ok())

      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(0)), abc, 0)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply))

      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Ok(4)), abc, 0)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.Error.BadKernelReply))

      Stdlib.Cli.File.__copyWriteAt((fun(_, _) -> Error(28)), abc, 0)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.__fromErrno(28))) ])


// __copyBuffered reads 64 KiB chunks from the offset until an empty read
test copyBuffered =
  Stdlib.Cli.File.__copyBuffered(
    (fun(count, offset) ->
       if count != 65536 then
         Error(22)
       else if offset == 2 then
         Ok(Stdlib.Utf8.encode("abc"))
       else if offset == 5 then
         Ok(Stdlib.Bytes.empty)
       else
         Error(22)),
    (fun(_, offset) -> if offset >= 2 && offset < 5 then Ok(1) else Error(22)),
    2)
  |> Stdlib.Test.equal(Ok())


// Which errors fall back to a buffered copy, and which error wins on close
test copyFallbackAndFinish =
  let unsupported = fun(os, code) ->
    Stdlib.Cli.File.__copyUnsupported(
      Stdlib.Cli.Posix.Error.Os(
        Stdlib.Cli.Posix.Errno { os = os, code = code }))

  let linux = Stdlib.Cli.Posix.Os.Linux
  let darwin = Stdlib.Cli.Posix.Os.Darwin
  Stdlib.Test.all(
    [ unsupported(linux, 18) |> Stdlib.Test.equal(true)

      unsupported(linux, 28) |> Stdlib.Test.equal(false)

      // ENOSYS and EOPNOTSUPP
      unsupported(linux, 38) |> Stdlib.Test.equal(true)

      unsupported(linux, 95) |> Stdlib.Test.equal(true)

      unsupported(darwin, 78) |> Stdlib.Test.equal(true)

      unsupported(darwin, 45) |> Stdlib.Test.equal(true)

      // the other OS's ENOSYS and ENOTSUP mean something else
      unsupported(linux, 78) |> Stdlib.Test.equal(false)

      unsupported(linux, 45) |> Stdlib.Test.equal(false)

      unsupported(darwin, 38) |> Stdlib.Test.equal(false)

      unsupported(darwin, 95) |> Stdlib.Test.equal(false)

      Stdlib.Cli.File.__copyFinish(
        Error(Stdlib.Cli.Posix.__fromErrno(28)),
        Error(Stdlib.Cli.Posix.__fromErrno(5)))
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.__fromErrno(28))) ])


// Copying a directory fails with EISDIR and leaves no destination behind
test copyDirectoryRefused =
  Stdlib.Cli.Dir.withTemp(fun dir ->
    let destination = Stdlib.String.append(dir, "/not-a-file")
    let copied = Stdlib.Cli.File.copy(dir, destination)
    let kind =
      match copied with
      | Error(e) -> Some(Stdlib.Cli.Posix.Error.kind(e))
      | Ok(_) -> None

    (kind, Stdlib.Cli.File.exists(destination)))
  |> Stdlib.Test.equal(
    Ok((Some(Stdlib.Cli.Posix.ErrorKind.IsADirectory), false)))


// Watching a missing path returns at once; a zero interval is still valid
test watchEdges =
  let immediate = Stdlib.Cli.Dir.withTemp(fun dir ->
    let path = $"{dir}/watch"
    let wrote = Stdlib.Cli.File.writeText(path, "x")
    let watched = Stdlib.Cli.File.watch(path, 0.0, (fun _ -> true), fun _ -> ())
    (wrote, watched))

  Stdlib.Test.all(
    [ Stdlib.Cli.File.__watchLinux(
        "/does-not-exist",
        10,
        (fun _ -> true),
        fun _ -> ())
      |> Stdlib.Test.equal(Ok())

      immediate |> Stdlib.Test.equal(Ok((Ok(), Ok()))) ])
