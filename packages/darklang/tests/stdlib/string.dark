// Not a legacy assertion: legacy has these commented out (see `head` above), and
// expected '🧟' for the second; `head` returns the whole cluster.
test headUsesWholeGraphemes =
  Stdlib.Test.all
    [ Stdlib.String.head "👱👱🏻👱🏼👱🏽👱🏾👱🏿" |> Stdlib.Test.equal (Some '👱')
      Stdlib.String.head "🧟‍♀️🧟‍♂️" |> Stdlib.Test.equal (Some '🧟‍♀️')
      Stdlib.String.head "👨‍❤️‍💋‍👨" |> Stdlib.Test.equal (Some '👨‍❤️‍💋‍👨') ]

// Not a legacy assertion: legacy has this case commented out (see
// `mapReplacesEveryCharacter` above), expecting the older wording of the same
// `fromList` error.
test mapRejectsNonCharResult =
  Stdlib.String.map "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷" (fun _ -> 5L)
  => raises "Darklang.Stdlib.String.fromList's 1st parameter `lst` expects List<Char>, but got List<Int64> ([5, 5, 5, 5])"
