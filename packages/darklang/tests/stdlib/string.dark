// head returns the whole grapheme cluster.
test headUsesWholeGraphemes =
  Stdlib.Test.all(
    [ Stdlib.String.head("👱👱🏻👱🏼👱🏽👱🏾👱🏿") |> Stdlib.Test.equal(Some('👱'))
      Stdlib.String.head("🧟‍♀️🧟‍♂️") |> Stdlib.Test.equal(Some('🧟‍♀️'))
      Stdlib.String.head("👨‍❤️‍💋‍👨") |> Stdlib.Test.equal(Some('👨‍❤️‍💋‍👨')) ])

test mapRejectsNonCharResult =
  Stdlib.String.map("👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷", fun _ -> 5)
  => raises "Darklang.Stdlib.String.map's 2nd parameter `fn` returned Int64 (5), but should return Char"
