/// String cases ported from `backend/testfiles/execution/stdlib/string.dark`.
module Darklang.Stdlib.String.Tests

test stringEquality =
  Stdlib.Test.all
    [ "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇" == "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇"
      |> Stdlib.Test.equal true
      "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽" == "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽" |> Stdlib.Test.equal true
      "Είναι προικισμένοι με λογική" == "Είναι προικισμένοι με λογική"
      |> Stdlib.Test.equal true
      "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷" == "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷"
      |> Stdlib.Test.equal true ]

// Differs from legacy: legacy built chars with its `c` helper, which used the
// backend-only Builtin.testToChar. Here they are char literals or taken from the
// string itself (`String.head`, `String.toList`).
test fromChar =
  Stdlib.Test.all
    [ Stdlib.String.fromChar 'a' |> Stdlib.Test.equal "a"
      Stdlib.String.toList "1" |> Stdlib.List.head
      |> Stdlib.Option.map Stdlib.String.fromChar |> Stdlib.Test.equal (Some "1")
      Stdlib.String.toList "👩‍👩‍👧‍👦" |> Stdlib.List.head
      |> Stdlib.Option.map Stdlib.String.fromChar
      |> Stdlib.Test.equal (Some "👩‍👩‍👧‍👦")
      Stdlib.String.toList "🏳️‍⚧️‍️" |> Stdlib.List.head
      |> Stdlib.Option.map Stdlib.String.fromChar
      |> Stdlib.Test.equal (Some "🏳️‍⚧️‍️")
      Stdlib.String.toList "👱🏾" |> Stdlib.List.head
      |> Stdlib.Option.map Stdlib.String.fromChar |> Stdlib.Test.equal (Some "👱🏾")
      Stdlib.String.toList "Z̤͔ͧ̑̓" |> Stdlib.List.head
      |> Stdlib.Option.map Stdlib.String.fromChar
      |> Stdlib.Test.equal (Some "Z̤͔ͧ̑̓") ]

// Differs from legacy: chars as in `fromChar` above.
test fromList =
  Stdlib.Test.all
    [ Stdlib.String.fromList [] |> Stdlib.Test.equal ""
      Stdlib.String.fromList [ 'a' ] |> Stdlib.Test.equal "a"
      [ "👩‍👩‍👧‍👦", "🏳️‍⚧️‍️", "👱🏾", "Z̤͔ͧ̑̓" ]
      |> Stdlib.List.map (fun grapheme ->
        Stdlib.String.head grapheme |> Builtin.unwrap)
      |> Stdlib.String.fromList |> Stdlib.Test.equal "👩‍👩‍👧‍👦🏳️‍⚧️‍️👱🏾Z̤͔ͧ̑̓" ]

test fromListRejectsStrings =
  Stdlib.String.fromList [ "a" ]
  => raises "Darklang.Stdlib.String.fromList's 1st parameter `lst` expects List<Char>, but got List<String> ([\"a\"])"

// Differs from legacy: chars as in `fromChar` above.
test toList =
  Stdlib.Test.all
    [ Stdlib.String.toList "" |> Stdlib.Test.equal []
      Stdlib.String.toList "ab" |> Stdlib.Test.equal [ 'a', 'b' ]
      Stdlib.String.toList "👨‍👩‍👧‍👦" |> Stdlib.List.map Stdlib.toString
      |> Stdlib.Test.equal [ "👨‍👩‍👧‍👦" ]
      Stdlib.String.toList "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇" |> Stdlib.List.map Stdlib.toString
      |> Stdlib.Test.equal [ "Z̤͔ͧ̑̓", "ä͖̭̈̇", "lͮ̒ͫ", "ǧ̗͚̚", "o̙̔ͮ̇͐̇" ]
      Stdlib.String.toList "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽" |> Stdlib.List.map Stdlib.toString

     |> Stdlib.Test.equal [ "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽", "﷽" ]
      Stdlib.String.toList "🧟‍♀️🧟‍♂️" |> Stdlib.List.map Stdlib.toString
      |> Stdlib.Test.equal [ "🧟‍♀️", "🧟‍♂️" ]
      Stdlib.String.toList "👱👱🏻👱🏼👱🏽👱🏾👱🏿" |> Stdlib.List.map Stdlib.toString
      |> Stdlib.Test.equal [ "👱", "👱🏻", "👱🏼", "👱🏽", "👱🏾", "👱🏿" ]
      Stdlib.String.toList "żółw🧑🏽‍🦰🧑🏻‍🍼✋✋🏻✋🏿" |> Stdlib.List.map Stdlib.toString

     |> Stdlib.Test.equal [ "ż", "ó", "ł", "w", "🧑🏽‍🦰", "🧑🏻‍🍼", "✋", "✋🏻", "✋🏿" ]
      (Stdlib.String.toList "ab1") |> Stdlib.String.fromList
      |> Stdlib.Test.equal "ab1"
      (Stdlib.String.toList "@Ǣá1") |> Stdlib.String.fromList
      |> Stdlib.Test.equal "@Ǣá1"
      (Stdlib.String.toList "👩‍👩‍👧‍👦🏳️‍⚧️‍️👱🏾Z̤͔ͧ̑̓") |> Stdlib.String.fromList
      |> Stdlib.Test.equal "👩‍👩‍👧‍👦🏳️‍⚧️‍️👱🏾Z̤͔ͧ̑̓" ]

test mapPreservesCharacters =
  Stdlib.Test.all
    [ Stdlib.String.map "a string" (fun x -> x) |> Stdlib.Test.equal "a string"
      Stdlib.String.map "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇" (fun x -> x)
      |> Stdlib.Test.equal "Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇"
      Stdlib.String.map "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽" (fun x -> x)
      |> Stdlib.Test.equal "﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽"
      Stdlib.String.map "👱👱🏻👱🏼👱🏽👱🏾👱🏿" (fun x -> x)
      |> Stdlib.Test.equal "👱👱🏻👱🏼👱🏽👱🏾👱🏿"
      Stdlib.String.map "🧟‍♀️🧟‍♂️" (fun x -> x) |> Stdlib.Test.equal "🧟‍♀️🧟‍♂️"
      Stdlib.String.map "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷" (fun x -> x)
      |> Stdlib.Test.equal "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷" ]

test mapReplacesEveryCharacter =
  Stdlib.Test.all
    [ Stdlib.String.map "a string" (fun _ -> 'c') |> Stdlib.Test.equal "cccccccc"
      Stdlib.String.map "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷" (fun _ -> 'c')
      |> Stdlib.Test.equal "cccc" ]

