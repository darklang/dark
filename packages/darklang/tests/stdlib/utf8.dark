module Darklang.Stdlib.Utf8.Tests

// encoded length in bytes, not characters
test encodeLength =
  Stdlib.Test.all(
    [ Stdlib.Bytes.length(Stdlib.Utf8.encode("🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼✋✋🏻✋🏿"))
      |> Stdlib.Test.equal(62)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("😄APPLE🍏"))
      |> Stdlib.Test.equal(13)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("Είναι προικισμένοι με λογική"))
      |> Stdlib.Test.equal(53)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("")) |> Stdlib.Test.equal(0)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽"))
      |> Stdlib.Test.equal(48)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("👱👱🏻👱🏼👱🏽👱🏾👱🏿"))
      |> Stdlib.Test.equal(44)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("🧟‍♀️🧟‍♂️")) |> Stdlib.Test.equal(26)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷"))
      |> Stdlib.Test.equal(82)

      Stdlib.Bytes.length(Stdlib.Utf8.encode("Z̤͔ͧ̑̓ä͖̭̈̇lͮ̒ͫǧ̗͚̚o̙̔ͮ̇͐̇"))
      |> Stdlib.Test.equal(49) ])


// Decoded text is normalized, as every String is: {{e}} + a combining acute decodes to {{é}}.
test decodeNormalizes =
  Stdlib.Test.all(
    [ Stdlib.Base16.decode("63616665cc81")
      |> Stdlib.Result.andThen(Stdlib.Utf8.decode)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("café"))

      Stdlib.Base16.decode("63616665cc81")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("café"))

      Stdlib.Base16.decode("65cc81616263")
      |> Stdlib.Result.andThen(Stdlib.Utf8.decode)
      |> Stdlib.Result.map(fun s -> s + "x")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("éabcx")) ])


test roundTrip =
  Stdlib.Utf8.encode("hello")
  |> Stdlib.Utf8.decode
  |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("hello"))


// Keep the Base64 Result so a bad fixture fails the assertion.
test decode =
  Stdlib.Test.all(
    [ Stdlib.Base64.decode("w6I")
      |> Stdlib.Result.andThen(Stdlib.Utf8.decode)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("â"))

      Stdlib.Base64.decode("aGVsbG8g8J+YgA==")
      |> Stdlib.Result.andThen(Stdlib.Utf8.decode)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("hello 😀"))

      Stdlib.Base64.decode("ww==")
      |> Stdlib.Result.map(fun b ->
        Stdlib.Result.isError(Stdlib.Utf8.decode(b)))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(true))

      Stdlib.Base64.decode("7aCA")
      |> Stdlib.Result.map(fun b ->
        Stdlib.Result.isError(Stdlib.Utf8.decode(b)))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(true))

      Stdlib.Base64.decode("aMM=")
      |> Stdlib.Result.map(fun b ->
        Stdlib.Result.isError(Stdlib.Utf8.decode(b)))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(true)) ])


// The Error says where the first bad bytes are, and what they are.
test decodeErrorMessage =
  Stdlib.Test.all(
    [ Stdlib.Bytes.fromList([ 104u8, 226u8, 130u8 ])
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error("Invalid UTF-8 at byte 1: E2 82"))

      Stdlib.Bytes.fromList([ 255u8 ])
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error("Invalid UTF-8 at byte 0: FF"))

      Stdlib.Bytes.concat(
        Stdlib.Utf8.encode(Stdlib.String.repeat("abcdefgh", 10000)),
        Stdlib.Bytes.fromList([ 192u8 ]))
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error("Invalid UTF-8 at byte 80000: C0")) ])


test decodeWithReplacement =
  Stdlib.Test.all(
    [ Stdlib.Base64.decode("w6I")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("â"))

      Stdlib.Base64.decode("aGVsbG8g8J+YgA==")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("hello 😀"))

      Stdlib.Base64.decode("ww==")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("�"))

      Stdlib.Base64.decode("7aCA")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("���"))

      Stdlib.Base64.decode("aMM=")
      |> Stdlib.Result.map(Stdlib.Utf8.decodeWithReplacement)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("h�")) ])
