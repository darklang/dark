/// Native cases ported from `backend/testfiles/execution/stdlib/json.dark`.
module Darklang.Stdlib.Json.Tests

// Unsupported stuff:
// - TDB
// - TFn
// None of these are supported as <> type args in the parser,
// so do we really have to do anything here?
// It feels like a "no" to me - ignoring for now.
type Person = { Name: String; Age: Int64 }

type Result<'ok, 'err> = Stdlib.Result.Result<'ok, 'err>
type Option<'t> = Stdlib.Option.Option<'t>

let err
  (v: Stdlib.Result.Result<'a, Stdlib.Json.ParseError.ParseError>)
  : Result<'a, String> =
  v |> Stdlib.Result.mapError (Stdlib.Json.ParseError.toString Darklang.SCM.Branch.mainBranchId)


module Unit =
  test serialize =
    Stdlib.Json.serialize<Unit> () |> Stdlib.Test.equal "null"

  test parse =
    Stdlib.Json.parse<Unit> "null" |> Stdlib.Test.equal (Result.Ok())

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Int64> "()") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Unit> "0") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `0` as type `Unit` at path: `root`")
          (Stdlib.Json.parse<Unit> "\"\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"\"` as type `Unit` at path: `root`")
          (Stdlib.Json.parse<Unit> "\"null\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"null\"` as type `Unit` at path: `root`") ]

module Bool =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Bool> true |> Stdlib.Test.equal "true"
        Stdlib.Json.serialize<Bool> false |> Stdlib.Test.equal "false" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Bool> "true" |> Stdlib.Test.equal (Result.Ok true)
        Stdlib.Json.parse<Bool> "false" |> Stdlib.Test.equal (Result.Ok false)
        Stdlib.Json.parse<Bool> " true " |> Stdlib.Test.equal (Result.Ok true)
        Stdlib.Json.parse<Bool> " false " |> Stdlib.Test.equal (Result.Ok false)
        Stdlib.Json.parse<List<Bool>> "[true, true, false, true  ] "
        |> Stdlib.Test.equal (Result.Ok [ true, true, false, true ]) ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Bool> "tru") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Bool> "null") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Bool` at path: `root`")
          (Stdlib.Json.parse<Bool> "") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Bool> "\"true\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"true\"` as type `Bool` at path: `root`")
          (Stdlib.Json.parse<Bool> "0") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `0` as type `Bool` at path: `root`")
          (Stdlib.Json.parse<Bool> "1") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `1` as type `Bool` at path: `root`")
          (Stdlib.Json.parse<Bool> "False") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Bool> "tRUE") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON") ]

module Int =
  module Basic =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<Int> 0 |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<Int> 12345 |> Stdlib.Test.equal "12345"
          Stdlib.Json.serialize<Int> -12345 |> Stdlib.Test.equal "-12345" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int> "0" |> Stdlib.Test.equal (Result.Ok 0)
          Stdlib.Json.parse<Int> "12345" |> Stdlib.Test.equal (Result.Ok 12345)
          Stdlib.Json.parse<Int> "-12345" |> Stdlib.Test.equal (Result.Ok(-12345)) ]

  module Huge =
    test serialize =
      Stdlib.Test.all
        [ // arbitrary precision: well past Int64, exact round-trip
          Stdlib.Json.serialize<Int> 123456789012345678901234567890
          |> Stdlib.Test.equal "123456789012345678901234567890"
          Stdlib.Json.parse<Int> (Stdlib.Json.serialize<Int> 99999999999999999999999999999999)
          |> Stdlib.Test.equal (Result.Ok 99999999999999999999999999999999) ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int> "123456789012345678901234567890"
          |> Stdlib.Test.equal (Result.Ok 123456789012345678901234567890)
          Stdlib.Json.parse<Int> "-123456789012345678901234567890"
          |> Stdlib.Test.equal (Result.Ok(-123456789012345678901234567890)) ]

  module PastInt64 =
    test serialize =
      // Int is unbounded: it serializes/parses values that overflow Int64.
      // Compare the Int64Limits module above, which *errors* on these exact values.
      Stdlib.Json.serialize<Int> 9223372036854775808
      |> Stdlib.Test.equal "9223372036854775808"

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int> "9223372036854775808"
          |> Stdlib.Test.equal (Result.Ok 9223372036854775808)
          Stdlib.Json.parse<Int> "-9223372036854775809"
          |> Stdlib.Test.equal (Result.Ok(-9223372036854775809))
          // a float-form just above the Int64 max (Int64 rejects "9.3E18")
          Stdlib.Json.parse<Int> "9.3E18"
          |> Stdlib.Test.equal (Result.Ok 9300000000000000000) ]

  module IntegerValuedFloatForms =
    test parse =
      Stdlib.Test.all
        [ // integer-valued decimal/exponent forms are accepted, parsed EXACTLY
          // (the same forms the fixed-width int parsers accept)
          Stdlib.Json.parse<Int> "0.0" |> Stdlib.Test.equal (Result.Ok 0)
          Stdlib.Json.parse<Int> "-1.0" |> Stdlib.Test.equal (Result.Ok(-1))
          Stdlib.Json.parse<Int> "1.2E2" |> Stdlib.Test.equal (Result.Ok 120)
          Stdlib.Json.parse<Int> "1.2E+2" |> Stdlib.Test.equal (Result.Ok 120)
          Stdlib.Json.parse<Int> "1200E-1" |> Stdlib.Test.equal (Result.Ok 120)
          // exact even past 2^53 — guards the precision-loss regression
          Stdlib.Json.parse<Int> "9007199254740993.0"
          |> Stdlib.Test.equal (Result.Ok 9007199254740993) ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ // genuinely fractional values are rejected, never rounded
          (Stdlib.Json.parse<Int> "1.5") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `1.5` as type `Int` at path: `root`")
          (Stdlib.Json.parse<Int> "9007199254740993.5") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `9007199254740993.5` as type `Int` at path: `root`")
          (Stdlib.Json.parse<Int> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"42\"` as type `Int` at path: `root`")
          (Stdlib.Json.parse<Int> "null") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Int` at path: `root`")
          // extreme exponents are rejected cleanly, never crash or hang the parser
          (Stdlib.Json.parse<Int> "1e2147483647") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `1e2147483647` as type `Int` at path: `root`")
          (Stdlib.Json.parse<Int> "1e-2147483647") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `1e-2147483647` as type `Int` at path: `root`")
          (Stdlib.Json.parse<Int> "1e-2147483648") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `1e-2147483648` as type `Int` at path: `root`") ]

    test parse =
      // ...but zero with an extreme negative exponent is still exactly zero
      Stdlib.Json.parse<Int> "0e-2147483648" |> Stdlib.Test.equal (Result.Ok 0)

module Int64 =
  module Basic =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<Int64> 0L |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<Int64> 12345L |> Stdlib.Test.equal "12345"
          Stdlib.Json.serialize<Int64> -12345L |> Stdlib.Test.equal "-12345" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int64> "0" |> Stdlib.Test.equal (Result.Ok 0L)
          Stdlib.Json.parse<Int64> "0.0" |> Stdlib.Test.equal (Result.Ok 0L)
          Stdlib.Json.parse<Int64> "-0.0" |> Stdlib.Test.equal (Result.Ok 0L)
          Stdlib.Json.parse<Int64> "-1.0" |> Stdlib.Test.equal (Result.Ok(-1L))
          Stdlib.Json.parse<Int64> "1.2E2" |> Stdlib.Test.equal (Result.Ok 120L)
          Stdlib.Json.parse<Int64> "1.2E+2" |> Stdlib.Test.equal (Result.Ok 120L)
          Stdlib.Json.parse<Int64> "1200E-1" |> Stdlib.Test.equal (Result.Ok 120L) ]

  module Int32Limits =
    test serialize =
      Stdlib.Test.all
        [ // test the limits of int32 (-2147483648 to 2147483647)
          Stdlib.Json.serialize<Int64> -2147483648L
          |> Stdlib.Test.equal "-2147483648"
          Stdlib.Json.serialize<Int64> 2147483647L |> Stdlib.Test.equal "2147483647"
          Stdlib.Json.serialize<Int64> -2147483649L
          |> Stdlib.Test.equal "-2147483649"
          Stdlib.Json.serialize<Int64> 2147483648L
          |> Stdlib.Test.equal "2147483648" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int64> "-2147483648"
          |> Stdlib.Test.equal (Result.Ok -2147483648L)
          Stdlib.Json.parse<Int64> "2147483647"
          |> Stdlib.Test.equal (Result.Ok 2147483647L)
          Stdlib.Json.parse<Int64> "-2147483649"
          |> Stdlib.Test.equal (Result.Ok -2147483649L)
          Stdlib.Json.parse<Int64> "2147483648"
          |> Stdlib.Test.equal (Result.Ok 2147483648L) ]

  module Int64Limits =
    // test the limits of int64 (-9223372036854775808 to 9223372036854775807)

    // TODO: consider putting ints that won't fit exactly in a float into strings to
    // be certain
    //
    // Integer serialization is exact; no float intermediary or string coercion.
    test parseErrors =
      Stdlib.Test.all
        [ // First number that doesn't fit in an int64
          (Stdlib.Json.parse<Int64> "9223372036854775808") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `9223372036854775808` as type `Int64` at path: `root`")
          // This is a float that is slightly above the int64 max
          (Stdlib.Json.parse<Int64> "9.3E18") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `9.3E18` as type `Int64` at path: `root`") ]

    test parse =
      Stdlib.Test.all
        [ // This is a float that is a valid int64
          Stdlib.Json.parse<Int64> "9.2E18"
          |> Stdlib.Test.equal (Result.Ok 9200000000000000000L)
          Stdlib.Json.parse<Int64> "9223372036854775807"
          |> Stdlib.Test.equal (Result.Ok 9223372036854775807L)
          Stdlib.Json.parse<Int64> "-9223372036854775808"
          |> Stdlib.Test.equal (Result.Ok(-9223372036854775808L)) ]

    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<Int64> 9223372036854775807L
          |> Stdlib.Test.equal "9223372036854775807"
          Stdlib.Json.serialize<Int64> -9223372036854775808L
          |> Stdlib.Test.equal "-9223372036854775808" ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ // not ints
          (Stdlib.Json.parse<Int64> " ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int64> "4a") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int64> "- 42") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int64> "null") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "true") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `true` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "false") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `false` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"42\"` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "[42]") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `[42]` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `{ \"key\": 42 }` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "42.5") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `42.5` as type `Int64` at path: `root`")
          (Stdlib.Json.parse<Int64> "\"42\n\"") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON") ]

module UInt64 =
  module Basic =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<UInt64> 0UL |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<UInt64> 12345UL |> Stdlib.Test.equal "12345" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<UInt64> "0" |> Stdlib.Test.equal (Result.Ok 0UL)
          Stdlib.Json.parse<UInt64> "0.0" |> Stdlib.Test.equal (Result.Ok 0UL)
          Stdlib.Json.parse<UInt64> "1.2E2" |> Stdlib.Test.equal (Result.Ok 120UL)
          Stdlib.Json.parse<UInt64> "1.2E+2" |> Stdlib.Test.equal (Result.Ok 120UL)
          Stdlib.Json.parse<UInt64> "1200E-1"
          |> Stdlib.Test.equal (Result.Ok 120UL) ]

  module UInt64Limits =
    // test the limits of uint64 (0 to 18446744073709551615)
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<UInt64> 0UL |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<UInt64> 18446744073709551615UL
          |> Stdlib.Test.equal "18446744073709551615" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<UInt64> "0" |> Stdlib.Test.equal (Result.Ok 0UL)
          Stdlib.Json.parse<UInt64> "18446744073709551615"
          |> Stdlib.Test.equal (Result.Ok 18446744073709551615UL) ]

    // First number that doesn't fit in an int64
    // TODO : The two commented tests below are failing due to a bug in the
    // conversion from a double to a uint64 in dotnet runtime.
    // The tests pass inside the container, but fail in CI
    // (Stdlib.Json.parse<UInt64> "18446744073709551616") |> err
    // |> Stdlib.Test.equal
    //   (Result.Error "Can't parse JSON `18446744073709551616` as type `UInt64` at path: `root`")

    // This is a float that is a valid uint64
    // Stdlib.Json.parse<UInt64> "1.8446744073709551615E19"
    // |> Stdlib.Test.equal (Result.Ok 18446744073709551615UL)
    //
    // Not a legacy assertion: both pass now, so they run (this test and the next).
    test rejectsFirstOverflow =
      Stdlib.Json.parse<UInt64> "18446744073709551616"
      |> err
      |> Stdlib.Test.equal
        (Result.Error "Can't parse JSON `18446744073709551616` as type `UInt64` at path: `root`")

    test parsesScientificMaximum =
      Stdlib.Json.parse<UInt64> "1.8446744073709551615E19"
      |> Stdlib.Test.equal (Result.Ok 18446744073709551615UL)

    test parseErrors =
      // This is a float that is slightly above the uint64 max
      (Stdlib.Json.parse<UInt64> "1.9E19") |> err
      |> Stdlib.Test.equal (Result.Error
          "Can't parse JSON `1.9E19` as type `UInt64` at path: `root`")

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<UInt64> " ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt64> "4a") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt64> "- 42") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt64> "null") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `null` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "true") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `true` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "false") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `false` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"42\"` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "[42]") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[42]` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "42.5") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `42.5` as type `UInt64` at path: `root`")
          (Stdlib.Json.parse<UInt64> "\"42\n\"") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON") ]

module Int8 =
  module Basic =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<Int8> 0y |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<Int8> 123y |> Stdlib.Test.equal "123"
          Stdlib.Json.serialize<Int8> -123y |> Stdlib.Test.equal "-123" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int8> "0" |> Stdlib.Test.equal (Result.Ok 0y)
          Stdlib.Json.parse<Int8> "0.0" |> Stdlib.Test.equal (Result.Ok 0y)
          Stdlib.Json.parse<Int8> "-0.0" |> Stdlib.Test.equal (Result.Ok 0y)
          Stdlib.Json.parse<Int8> "-1.0" |> Stdlib.Test.equal (Result.Ok -1y)
          Stdlib.Json.parse<Int8> "1.2E2" |> Stdlib.Test.equal (Result.Ok 120y)
          Stdlib.Json.parse<Int8> "1.2E+2" |> Stdlib.Test.equal (Result.Ok 120y)
          Stdlib.Json.parse<Int8> "1200E-1" |> Stdlib.Test.equal (Result.Ok 120y) ]

  module Int8Limits =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<Int8> -128y |> Stdlib.Test.equal "-128"
          Stdlib.Json.serialize<Int8> 127y |> Stdlib.Test.equal "127" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Int8> "-128" |> Stdlib.Test.equal (Result.Ok -128y)
          Stdlib.Json.parse<Int8> "127" |> Stdlib.Test.equal (Result.Ok 127y) ]

    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Int8> "-129") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `-129` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "128") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `128` as type `Int8` at path: `root`") ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Int8> " ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int8> "4a") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int8> "- 42") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Int8> "null") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "true") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `true` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "false") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `false` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"42\"` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "[42]") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `[42]` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `{ \"key\": 42 }` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "42.5") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `42.5` as type `Int8` at path: `root`")
          (Stdlib.Json.parse<Int8> "\"42\n\"") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON") ]

module UInt8 =
  module Basic =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<UInt8> 1uy |> Stdlib.Test.equal "1"
          Stdlib.Json.serialize<UInt8> 123uy |> Stdlib.Test.equal "123"
          Stdlib.Json.serialize<UInt8> 254uy |> Stdlib.Test.equal "254" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<UInt8> "0" |> Stdlib.Test.equal (Result.Ok 0uy)
          Stdlib.Json.parse<UInt8> "0.0" |> Stdlib.Test.equal (Result.Ok 0uy)
          // CLEANUP is this OK?
          Stdlib.Json.parse<UInt8> "-0.0" |> Stdlib.Test.equal (Result.Ok 0uy)
          Stdlib.Json.parse<UInt8> "1.2E2" |> Stdlib.Test.equal (Result.Ok 120uy)
          Stdlib.Json.parse<UInt8> "1.2E+2" |> Stdlib.Test.equal (Result.Ok 120uy)
          Stdlib.Json.parse<UInt8> "1200E-1" |> Stdlib.Test.equal (Result.Ok 120uy) ]

  module UInt8Limits =
    test serialize =
      Stdlib.Test.all
        [ Stdlib.Json.serialize<UInt8> 0uy |> Stdlib.Test.equal "0"
          Stdlib.Json.serialize<UInt8> 255uy |> Stdlib.Test.equal "255" ]

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<UInt8> "0" |> Stdlib.Test.equal (Result.Ok 0uy)
          Stdlib.Json.parse<UInt8> "255" |> Stdlib.Test.equal (Result.Ok 255uy) ]

    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<UInt8> "-1") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `-1` as type `UInt8` at path: `root`")
          (Stdlib.Json.parse<UInt8> "256") |> err
