          (Stdlib.Json.parse<UInt8> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `{ \"key\": 42 }` as type `UInt8` at path: `root`")
          (Stdlib.Json.parse<UInt8> "42.5") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `42.5` as type `UInt8` at path: `root`")
          (Stdlib.Json.parse<UInt8> "\"42\n\"") |> err
