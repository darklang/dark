// ## Nested types (lists, tuples, records, etc.)
//
// Not a legacy assertion: RestoredArchive below runs these cases, against a
// local enum and record in place of the old types, with today's errors.
module RestoredArchive =
  type Counter = { v: Int64 }
  type NamedError =
    | InvalidPackageName of List<String>
    | MissingEnumModuleName of String
    | NotFound of List<String>

  test enumWithListPayload =
    let value = NamedError.InvalidPackageName ["NamePart"]
    Stdlib.Test.all
      [ Stdlib.Json.serialize<NamedError> value
        |> Stdlib.Test.equal "{\"InvalidPackageName\":[[\"NamePart\"]]}"
        Stdlib.Json.parse<NamedError> "{\"NotFound\":[[\"NamePart\"]]}"
        |> Stdlib.Test.equal (Ok (NamedError.NotFound ["NamePart"])) ]

  test listOfEnums =
    let value =
      [ NamedError.InvalidPackageName ["NamePart"]
        NamedError.MissingEnumModuleName "Ok"
        NamedError.NotFound ["NamePart"] ]
    let encoded = "[{\"InvalidPackageName\":[[\"NamePart\"]]},{\"MissingEnumModuleName\":[\"Ok\"]},{\"NotFound\":[[\"NamePart\"]]}]"
    Stdlib.Test.all
      [ Stdlib.Json.serialize<List<NamedError>> value |> Stdlib.Test.equal encoded
        Stdlib.Json.parse<List<NamedError>> encoded |> Stdlib.Test.equal (Ok value) ]

  test rejectsMalformedJson =
    [ "{Id : 1.0}", "{Id : 1.}", "{\"Id\" : 1.}", ""
      "[ {date : \"2013-11-05\", locations : {Japan: 3, Germany: 1}} ]"
      "({id : 555, edition : \"First\", author : \"Dennis Ritchie\"})"
      "{id : 555, edition : \"First\", author : \"Dennis Ritchie\"}"
      "1,0/0,0", "''", "{3: false}"
      "{\"Id\" : Infinity }", "{\"Id\" : -Infinity }", "{\"Id\" : NaN }"
      "[ {\"date\" : \"2013-11-05\", locations : {Japan: 3, Germany: 1}} ]"
      "{\"id\" : 555, edition : \"First\", author : \"Dennis Ritchie\"}"
      "{\"id\" : 555, \"edition\" : 'First' }"
      "({\"id\" : 555, \"edition\" : \"First\", \"author\" : \"Dennis Ritchie\"})" ]
    |> Stdlib.List.map (fun text ->
      Stdlib.Json.parse<Int64> text |> err
      |> Stdlib.Test.equal (Error "Not JSON"))
    |> Stdlib.Test.all

  test scalarAndLargeRecordValues =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Int64> "1" |> Stdlib.Test.equal (Ok 1L)
        Stdlib.Json.parse<String> "\"\"" |> Stdlib.Test.equal (Ok "")
        Stdlib.Json.parse<Counter> "{ \"v\": 4611686018427387903 }"
        |> Stdlib.Test.equal (Ok (Counter { v = 4611686018427387903L }))
        Stdlib.Json.parse<Counter> "{ \"v\": 4611686018427387904 }"
        |> Stdlib.Test.equal (Ok (Counter { v = 4611686018427387904L })) ]

  test uint64ExactDecimalAndExponentForms =
    Stdlib.Test.all
      [ Stdlib.Json.parse<UInt64> "18446744073709551615.0"
        |> Stdlib.Test.equal (Ok 18446744073709551615UL)
        Stdlib.Json.parse<UInt64> "18446744073709551614.0"
        |> Stdlib.Test.equal (Ok 18446744073709551614UL)
        Stdlib.Json.parse<UInt64> "9007199254740993e0"
        |> Stdlib.Test.equal (Ok 9007199254740993UL) ]

  test uint64RejectsOverflowAndRoundedFractions =
    [ "18446744073709551616.0", "1.8446744073709551616e19"
      "18446744073709551615.1", "-0.00000000000000000000001"
      "1e2000000000", "1e-2000000000" ]
    |> Stdlib.List.map (fun text ->
      Stdlib.Json.parse<UInt64> text |> Stdlib.Result.isError
      |> Stdlib.Test.equal true)
    |> Stdlib.Test.all

  test floatBoundariesAndPrecisionRoundTrip =
    [ 1.7976931348623157e308, -1.7976931348623157e308
      2.2250738585072014e-308, 5e-324, -5e-324
      0.12345678901234568, 9007199254740992.0 ]
    |> Stdlib.List.map (fun value ->
      Stdlib.Json.serialize<Float> value |> Stdlib.Json.parse<Float>
      |> Stdlib.Test.equal (Ok value))
    |> Stdlib.Test.all

  test deeplyNestedOptionsAndEnums =
    let value = Some (Some [NamedError.NotFound ["a", "b"]])
    Stdlib.Json.serialize<Stdlib.Option.Option<Stdlib.Option.Option<List<NamedError>>>> value
    |> Stdlib.Json.parse<Stdlib.Option.Option<Stdlib.Option.Option<List<NamedError>>>>
    |> Stdlib.Test.equal (Ok value)
