              340282366920938463463374607431768211455Z)
          // This is a large number that is a valid UInt128
          Stdlib.Json.parse<UInt128> "3.4E38"
          |> Stdlib.Test.equal (Result.Ok
              339999999999999996123846586046231871488Z) ]

    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<UInt128> "340282366920938463463374607431768211456") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `340282366920938463463374607431768211456` as type `UInt128` at path: `root`")
          // This is a number that is slightly above the UInt128 max
          (Stdlib.Json.parse<UInt128> "3.5E38") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `3.5E38` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "-1") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `-1` as type `UInt128` at path: `root`") ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<UInt128> " ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt128> "4a") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt128> "- 42") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt128> "null") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `null` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "true") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `true` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "false") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `false` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"42\"` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "[42]") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[42]` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "42.5") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `42.5` as type `UInt128` at path: `root`")
          (Stdlib.Json.parse<UInt128> "\"42\n\"") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<UInt128> "340282366920938463463374607431768211456") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `340282366920938463463374607431768211456` as type `UInt128` at path: `root`") ]

module Float =
  // TODO: test the upper/lower bounds
  // TODO: test highly-precise numbers
  // TODO: review Float.tests for more values to test against

  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Float> 0.0 |> Stdlib.Test.equal "0.0"
        Stdlib.Json.serialize<Float> 1.0 |> Stdlib.Test.equal "1.0"
        Stdlib.Json.serialize<Float> 0.1 |> Stdlib.Test.equal "0.1"
        Stdlib.Json.serialize<Float> (2.0 / 3.0)
        |> Stdlib.Test.equal "0.6666666666666666"
        Stdlib.Json.serialize<Float> 12345.67890 |> Stdlib.Test.equal "12345.6789"
        Stdlib.Json.serialize<Float> -12345.67890 |> Stdlib.Test.equal "-12345.6789"
        Stdlib.Json.serialize<Float> 3.14159265358979323846
        |> Stdlib.Test.equal "3.141592653589793"
        Stdlib.Json.serialize<Float> 1.618033988749895
        |> Stdlib.Test.equal "1.618033988749895"
        // Needs all seventeen digits; "G16" used to write this as 0.3.
        Stdlib.Json.serialize<Float> (0.1 + 0.2)
        |> Stdlib.Test.equal "0.30000000000000004"
        // Exponent form is valid JSON as long as nothing appends `.0` to it.
        Stdlib.Json.serialize<Float> 10000000000000000.0 |> Stdlib.Test.equal "1e+16"
        Stdlib.Json.serialize<Float> 0.00001 |> Stdlib.Test.equal "1e-5" ]

  test parse =
    Stdlib.Test.all
      [ // ints as floats
        Stdlib.Json.parse<Float> "0.0" |> Stdlib.Test.equal (Result.Ok 0.0)
        Stdlib.Json.parse<Float> "0" |> Stdlib.Test.equal (Result.Ok 0.0)
        Stdlib.Json.parse<Float> "123" |> Stdlib.Test.equal (Result.Ok 123.0)
        Stdlib.Json.parse<Float> "12345.67890"
        |> Stdlib.Test.equal (Result.Ok 12345.67890)
        Stdlib.Json.parse<Float> "-12345.67890"
        |> Stdlib.Test.equal (Result.Ok -12345.67890)
        Stdlib.Json.parse<Float> " 42.0 " |> Stdlib.Test.equal (Result.Ok 42.0)
        Stdlib.Json.parse<Float> " -42.0 " |> Stdlib.Test.equal (Result.Ok -42.0)
        Stdlib.Json.parse<Float> "1e3" |> Stdlib.Test.equal (Result.Ok 1000.0)
        Stdlib.Json.parse<Float> "-1e3" |> Stdlib.Test.equal (Result.Ok -1000.0)
        Stdlib.Json.parse<Float> "0.30000000000000004"
        |> Stdlib.Test.equal (Result.Ok (0.1 + 0.2))
        Stdlib.Json.parse<Float> "1e+16"
        |> Stdlib.Test.equal (Result.Ok 10000000000000000.0)
        Stdlib.Json.parse<Float> "1e-5" |> Stdlib.Test.equal (Result.Ok 0.00001)
        Stdlib.Json.parse<Float> "1.0000001"
        |> Stdlib.Test.equal (Result.Ok 1.0000001)
        Stdlib.Json.parse<Float> "-1.00000001"
        |> Stdlib.Test.equal (Result.Ok -1.00000001)
        Stdlib.Json.parse<Float> "-2147483647.8"
        |> Stdlib.Test.equal (Result.Ok -2147483647.8)
        Stdlib.Json.parse<Float> "17.55042081"
        |> Stdlib.Test.equal (Result.Ok 17.55042081)
        Stdlib.Json.parse<Float> "2147483647.000009"
        |> Stdlib.Test.equal (Result.Ok 2147483647.000009)
        Stdlib.Json.parse<Float> "-2367.9267"
        |> Stdlib.Test.equal (Result.Ok -2367.9267)
        Stdlib.Json.parse<Float> "0.6999999999999999555910790149937383830547332763671875"
        |> Stdlib.Test.equal (Result.Ok
            0.6999999999999999555910790149937383830547332763671875)
        Stdlib.Json.parse<Float> "0.7999999999"
        |> Stdlib.Test.equal (Result.Ok 0.7999999999) ]

  module Values =
    test serialize =
      Stdlib.Test.all
        [ // Differs from legacy: NaN and the infinities are computed here; legacy
          // used Builtin.testNan/testInfinity/testNegativeInfinity, which only the
          // backend has.
          Stdlib.Json.serialize<Float> (-1.0 / 0.0)
          |> Stdlib.Test.equal "\"-Infinity\""
          Stdlib.Json.serialize<Float> (1.0 / 0.0)
          |> Stdlib.Test.equal "\"Infinity\""
          Stdlib.Json.serialize<Float> (Stdlib.Float.sqrt -1.0)
          |> Stdlib.Test.equal "\"NaN\"" ]

    test parse =
      Stdlib.Test.all
        [ // Differs from legacy: the infinities are computed (legacy used
          // backend-only builtins), and NaN is checked with isNaN, since NaN never
          // equals itself here.
          Stdlib.Json.parse<Float> "\"-Infinity\""
          |> Stdlib.Test.equal (Result.Ok(-1.0 / 0.0))
          Stdlib.Json.parse<Float> "\"Infinity\""
          |> Stdlib.Test.equal (Result.Ok(1.0 / 0.0))
          (Stdlib.Json.parse<Float> "\"NaN\"") |> Stdlib.Result.map Stdlib.Float.isNaN
          |> Stdlib.Test.equal (Result.Ok true) ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Float> "e") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "pi") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> " -42 . 0 ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "0") |> err |> Stdlib.Test.equal (Result.Ok 0.0)
          (Stdlib.Json.parse<Float> " ") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "4a") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "- 42.0") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "-141s") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "null") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `null` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "true") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `true` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "false") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `false` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "\"42\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"42\"` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "[42]") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `[42]` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "{ \"key\": 42 }") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `{ \"key\": 42 }` as type `Float` at path: `root`")
          (Stdlib.Json.parse<Float> "\"42\n\"") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "000000.9") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "-000000.9") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "-00000000.000") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "00000000.000") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<Float> "\"65.0\"") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"65.0\"` as type `Float` at path: `root`") ]

module Char =
  let charFromString (s: String) : Char =
    (Stdlib.String.head s) |> Builtin.unwrap

  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Char> 'a' |> Stdlib.Test.equal "\"a\""
        Stdlib.Json.serialize<Char> (charFromString "Ł")
        |> Stdlib.Test.equal "\"Ł\"" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Char> "\"a\"" |> Stdlib.Test.equal (Result.Ok 'a')
        Stdlib.Json.parse<Char> "\"Ł\"" |> Stdlib.Test.equal (Result.Ok 'Ł') ]

  module SimpleEmoji =
    test serialize =
      Stdlib.Json.serialize<Char> ("😂" |> charFromString)
      |> Stdlib.Test.equal "\"\\uD83D\\uDE02\""

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Char> "\"😂\""
          |> Stdlib.Test.equal (Result.Ok(charFromString "😂"))
          Stdlib.Json.parse<Char> "\"\\uD83D\\uDE02\""
          |> Stdlib.Test.equal (Result.Ok(charFromString "😂")) ]

  module ComplexEmoji =
    test serialize =
      Stdlib.Json.serialize<Char> (charFromString "👩‍👩‍👧‍👦")
      |> Stdlib.Test.equal "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\""

    test parse =
      Stdlib.Test.all
        [ Stdlib.Json.parse<Char>
            "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\""
          |> Stdlib.Test.equal (Result.Ok(
              charFromString "👩‍👩‍👧‍👦"
            ))
          Stdlib.Json.parse<Char> "\"👩‍👩‍👧‍👦\""
          |> Stdlib.Test.equal (Result.Ok(
              "👩‍👩‍👧‍👦" |> charFromString
            )) ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<Char> "\"test\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"test\"` as type `Char` at path: `root`")
          (Stdlib.Json.parse<Char> "\"\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"\"` as type `Char` at path: `root`")
          (Stdlib.Json.parse<Char> "62") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `62` as type `Char` at path: `root`") ]

module String =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<String> "abc" |> Stdlib.Test.equal "\"abc\""
        Stdlib.Json.serialize<String> "" |> Stdlib.Test.equal "\"\""
        Stdlib.Json.serialize<String> "żółw" |> Stdlib.Test.equal "\"żółw\""
        Stdlib.Json.serialize<String> "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷"
        |> Stdlib.Test.equal "\"\\uD83D\\uDC68‍❤️‍\\uD83D\\uDC8B‍\\uD83D\\uDC68\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\\uD83C\\uDFF3️‍⚧️‍️\\uD83C\\uDDF5\\uD83C\\uDDF7\""
        Stdlib.Json.serialize<String> "👩‍👩‍👧‍👦"
        |> Stdlib.Test.equal "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\""
        Stdlib.Json.serialize<String>
          "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor."
        |> Stdlib.Test.equal "\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.\""
        Stdlib.Json.serialize<String> (Stdlib.String.repeat "a" 100)
        |> Stdlib.Test.equal "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<String> "\"abc\"" |> Stdlib.Test.equal (Result.Ok "abc")
        Stdlib.Json.parse<String> "\"\"" |> Stdlib.Test.equal (Result.Ok "")
        Stdlib.Json.parse<String> "\"żółw\"" |> Stdlib.Test.equal (Result.Ok "żółw")
        Stdlib.Json.parse<String> "\"👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷\""
        |> Stdlib.Test.equal (Result.Ok "👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷")
        Stdlib.Json.parse<String> "\"👩‍👩‍👧‍👦\""
        |> Stdlib.Test.equal (Result.Ok "👩‍👩‍👧‍👦")
        Stdlib.Json.parse<String>
          "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\""
        |> Stdlib.Test.equal (Result.Ok
            "👩‍👩‍👧‍👦")
        Stdlib.Json.parse<String>
          "\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.\""
        |> Stdlib.Test.equal (Result.Ok
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.")
        Stdlib.Json.parse<String>
          "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\""
        |> Stdlib.Test.equal (Result
            .Ok(Stdlib.String.repeat "a" 100)) ]

module DateTime =
  let d (datestr: String) : DateTime =
    (Stdlib.DateTime.parse datestr) |> Builtin.unwrap

  test serialize =
    Stdlib.Test.all
      [ // now-ish
        Stdlib.Json.serialize<DateTime> (d "2023-07-28T22:42:36Z")
        |> Stdlib.Test.equal "\"2023-07-28T22:42:36Z\""
        // epoch
        Stdlib.Json.serialize<DateTime> (d "1969-07-28T22:42:36Z")
        |> Stdlib.Test.equal "\"1969-07-28T22:42:36Z\""
        // before epoch
        Stdlib.Json.serialize<DateTime> (d "1402-07-28T22:42:36Z")
        |> Stdlib.Test.equal "\"1402-07-28T22:42:36Z\""
        // far in future
        Stdlib.Json.serialize<DateTime> (d "3023-07-28T22:42:36Z")
        |> Stdlib.Test.equal "\"3023-07-28T22:42:36Z\"" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<DateTime> "\"2023-07-28T22:42:36Z\""
        |> Stdlib.Test.equal (Result.Ok(
            d "2023-07-28T22:42:36Z"
          ))
        Stdlib.Json.parse<DateTime> "\"1969-07-28T22:42:36Z\""
        |> Stdlib.Test.equal (Result.Ok(
            d "1969-07-28T22:42:36Z"
          ))
        Stdlib.Json.parse<DateTime> "\"1402-07-28T22:42:36Z\""
        |> Stdlib.Test.equal (Result.Ok(
            d "1402-07-28T22:42:36Z"
          ))
        Stdlib.Json.parse<DateTime> "\"3023-07-28T22:42:36Z\""
        |> Stdlib.Test.equal (Result.Ok(
            d "3023-07-28T22:42:36Z"
          )) ]

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<DateTime> "\"3023-07-28T22:42:36\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"3023-07-28T22:42:36\"` as type `DateTime` at path: `root`")
          (Stdlib.Json.parse<DateTime> "\"2023-07-28\"") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"2023-07-28\"` as type `DateTime` at path: `root`")
          (Stdlib.Json.parse<DateTime> "1") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `1` as type `DateTime` at path: `root`") ]

module Uuid =
  let uuid (s: String) : Uuid =
    (Stdlib.Uuid.parse s) |> Builtin.unwrap

  test serialize =
    Stdlib.Test.all
      [ // empty
        Stdlib.Json.serialize<Uuid> (uuid "00000000-0000-0000-0000-000000000000")
        |> Stdlib.Test.equal "\"00000000-0000-0000-0000-000000000000\""
        // normal
        Stdlib.Json.serialize<Uuid> (uuid "3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
        |> Stdlib.Test.equal "\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\""
        Stdlib.Json.serialize<Uuid> (uuid "11111111-2222-3333-4444-555555555555")
        |> Stdlib.Test.equal "\"11111111-2222-3333-4444-555555555555\"" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Uuid> "\"00000000-0000-0000-0000-000000000000\""
        |> Stdlib.Test.equal (Result.Ok(
            uuid "00000000-0000-0000-0000-000000000000"
          ))
        Stdlib.Json.parse<Uuid> "\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\""
        |> Stdlib.Test.equal (Result.Ok(
            uuid "3700adbc-7a46-4ff4-81d3-45afb03f6e2d"
          ))
        Stdlib.Json.parse<Uuid> "\"11111111-2222-3333-4444-555555555555\""
        |> Stdlib.Test.equal (Result.Ok(
            uuid "11111111-2222-3333-4444-555555555555"
          )) ]

  module Errors =
    test parseErrors =
      // needs one more 0 at the end
      (Stdlib.Json.parse<Uuid> "\"00000000-0000-0000-0000-00000000000\"") |> err
      |> Stdlib.Test.equal (Result.Error
          "Can't parse JSON `\"00000000-0000-0000-0000-00000000000\"` as type `Uuid` at path: `root`")

module BadTypes =
  test rejects1 =
    (Stdlib.Json.parse<Int64 -> Int64> "{}")
    => raises "Unsupported type in JSON: (Int64) -> Int64. Some types are not supported in Json serialization, and cannot be used as arguments to Builtin.jsonParse or Builtin.jsonSerialize"

  test rejects2 =
    (Stdlib.Json.serialize<Int64 -> Int64> (fun i -> 5))
    => raises "Cannot serialize (lambda) into JSON"

module List =
  type MyString = String

  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<List<Int64>> [] |> Stdlib.Test.equal "[]"
        Stdlib.Json.serialize<List<Int64>> [ 1L, 2L, 3L ]
        |> Stdlib.Test.equal "[1,2,3]"
        Stdlib.Json.serialize<List<List<List<Int64>>>>
          [ [ [ 1L, 2L, 3L ], [ 4L, 5L, 6L ] ], [ [ 7L, 8L ], [ 9L, 0L ] ] ]
        |> Stdlib.Test.equal "[[[1,2,3],[4,5,6]],[[7,8],[9,0]]]"
        Stdlib.Json.serialize<List<Dict<String, String>>>
          [ Dict { "name": "Alice"; "role": "admin" }
            Dict { "name": "Bob"; "role": "user" }
            Dict { "name": "Charlie"; "role": "user" } ]
        |> Stdlib.Test.equal ("""[{"name":"Alice","role":"admin"},{"name":"Bob","role":"user"},{"name":"Charlie","role":"user"}]""")
        Stdlib.Json.serialize<List<Person>>
          [ Person { Name = "Alice"; Age = 42L }
            Person { Name = "Bob"; Age = 27L }
            Person { Name = "Charlie"; Age = 99L } ]
        |> Stdlib.Test.equal ("""[{"Age":42,"Name":"Alice"},{"Age":27,"Name":"Bob"},{"Age":99,"Name":"Charlie"}]""") ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<List<Int64>> "[]" |> Stdlib.Test.equal (Result.Ok [])
        Stdlib.Json.parse<List<Int64>> "[1,2,3]"
        |> Stdlib.Test.equal (Result.Ok [ 1L, 2L, 3L ])
        Stdlib.Json.parse<List<List<List<Int64>>>> "[[[1,2,3],[4,5,6]],[[7,8],[9,0]]]"
        |> Stdlib.Test.equal (Result.Ok
            [ [ [ 1L, 2L, 3L ], [ 4L, 5L, 6L ] ], [ [ 7L, 8L ], [ 9L, 0L ] ] ])
        Stdlib.Json.parse<List<Dict<String, String>>>
          """[{"name": "Alice", "role": "admin"}, {"name": "Bob", "role": "user"}, {"name": "Charlie", "role": "user"}]"""
        |> Stdlib.Test.equal (Result.Ok
            [ Dict { "name": "Alice"; "role": "admin" }
              Dict { "name": "Bob"; "role": "user" }
              Dict { "name": "Charlie"; "role": "user" } ])
        Stdlib.Json.parse<List<Person>>
          """[{"Name": "Alice", "Age": 42}, {"Name": "Bob", "Age": 27}, {"Name": "Charlie", "Age": 99}]"""
        |> Stdlib.Test.equal (Result.Ok
            [ Person { Name = "Alice"; Age = 42L }
              Person { Name = "Bob"; Age = 27L }
              Person { Name = "Charlie"; Age = 99L } ])
        Stdlib.Json.parse<List<Dict<String, MyString>>>
          """[{"name": "Alice", "role": "admin"}, {"name": "Bob", "role": "user"}, {"name": "Charlie", "role": "user"}]"""
        |> Stdlib.Test.equal (Result.Ok
            [ Dict { "name": "Alice"; "role": "admin" }
              Dict { "name": "Bob"; "role": "user" }
              Dict { "name": "Charlie"; "role": "user" } ]) ]

  test parseErrors =
    (Stdlib.Json.parse<List<Int64>> "[1,2,3,]") |> err
    |> Stdlib.Test.equal (Result.Error "Not JSON")

  module Errors =
    test rejects1 =
      (Stdlib.Json.serialize<List<Int64>> (1L, 2L, "three"))
      => raises "Darklang.Stdlib.Json.serialize's 1st parameter `value` expects List<Int64>, but got (Int64 * Int64 * String) ((1, 2, \"three\"))"

    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<List<Int64>> "[1, 2, \"three\"]") |> err
          |> Stdlib.Test.equal (Result.Error "Can't parse JSON `\"three\"` as type `Int64` at path: `root[2]`")
          (Stdlib.Json.parse<List<Int64>> "[1, 2, ]") |> err
          |> Stdlib.Test.equal (Result.Error "Not JSON")
          (Stdlib.Json.parse<List<List<List<Int64>>>> "[[[1,2,3],[4,5.5,6]],[[7,8],[9,0]]]")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `5.5` as type `Int64` at path: `root[0][1][1]`")
          (Stdlib.Json.parse<List<Dict<String, Int64>>>
            """[{"name": "Alice", "role": "admin"}, {"name": "Bob", "role": "user"}, {"name": "Charlie", "role": "user"}]""")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"Alice\"` as type `Int64` at path: `root[0].name`") ]

module Tuples =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Int64 * String * Int64> (1L, "two", 3L)
        |> Stdlib.Test.equal "[1,\"two\",3]"
        Stdlib.Json.serialize<List<Int64> * List<Person>> (
            [ 1L, 2L, 3L ],
            [ Person { Name = "Alice"; Age = 42L } ]
          )
        |> Stdlib.Test.equal "[[1,2,3],[{\"Age\":42,\"Name\":\"Alice\"}]]"
        Stdlib.Json.serialize<(Int64 * String) * (Person * Dict<String, String>)> (
            (1L, "two"),
            (Person { Name = "Alice"; Age = 42L }, Stdlib.Dict.singleton "a" "b")
          )
        |> Stdlib.Test.equal "[[1,\"two\"],[{\"Age\":42,\"Name\":\"Alice\"},{\"a\":\"b\"}]]"
        Stdlib.Json.serialize<(List<Int64 * String> * List<UInt8>) *
          (Person * Dict<String, String>)> (
            ([ (1L, "two"), (3L, "four") ], []),
            (Person { Name = "Alice"; Age = 42L }, Stdlib.Dict.singleton "a" "b")
          )
        |> Stdlib.Test.equal "[[[[1,\"two\"],[3,\"four\"]],[]],[{\"Age\":42,\"Name\":\"Alice\"},{\"a\":\"b\"}]]"
        Stdlib.Json.serialize<Person * Option<Int64>> (
            Person { Name = "Alice"; Age = 42L },
            Option.Some 1L
          )
        |> Stdlib.Test.equal "[{\"Age\":42,\"Name\":\"Alice\"},{\"Some\":[1]}]"
        Stdlib.Json.serialize<Option<Int64> * Result<Int64, String>> (
            Option.Some 1L,
            Result.Ok 2L
          )
        |> Stdlib.Test.equal "[{\"Some\":[1]},{\"Ok\":[2]}]"
        Stdlib.Json.serialize<Char * Bool> ('a', true)
        |> Stdlib.Test.equal "[\"a\",true]"
        Stdlib.Json.serialize<DateTime * Uuid> (
            DateTime.d "2023-07-28T22:42:36Z",
            Uuid.uuid "3700adbc-7a46-4ff4-81d3-45afb03f6e2d"
          )
        |> Stdlib.Test.equal "[\"2023-07-28T22:42:36Z\",\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\"]" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Int64 * String * Int64> "[1,\"two\",3]"
        |> Stdlib.Test.equal (Result.Ok(
            (1L, "two", 3L)
          ))
        Stdlib.Json.parse<List<Int64> * List<Person>>
          "[[1,2,3],[{\"Age\":42,\"Name\":\"Alice\"}]]"
        |> Stdlib.Test.equal (Result.Ok(
            ([ 1L, 2L, 3L ], [ Person { Name = "Alice"; Age = 42L } ])
          ))
        Stdlib.Json.parse<(Int64 * String) * (Person * Dict<String, String>)>
          "[[1,\"two\"],[{\"Age\":42,\"Name\":\"Alice\"},{\"a\":\"b\"}]]"
        |> Stdlib.Test.equal (Result.Ok(
            ((1L, "two"),
             (Person { Name = "Alice"; Age = 42L }, Stdlib.Dict.singleton "a" "b"))
          ))
        Stdlib.Json.parse<(List<Int64 * String> * List<UInt8>) * (Person * Dict<String, String>)>
          "[[[[1,\"two\"],[3,\"four\"]],[]],[{\"Age\":42,\"Name\":\"Alice\"},{\"a\":\"b\"}]]"
        |> Stdlib.Test.equal (Result
            .Ok(
              (([ (1L, "two"), (3L, "four") ], []),
               (Person { Name = "Alice"; Age = 42L }, Stdlib.Dict.singleton "a" "b"))
            ))
        Stdlib.Json.parse<Person * Option<Int64>>
          "[{\"Age\":42,\"Name\":\"Alice\"},{\"Some\":[1]}]"
        |> Stdlib.Test.equal (Result.Ok(
            (Person { Name = "Alice"; Age = 42L }, Option.Some 1L)
          ))
        Stdlib.Json.parse<Option<Int64> * Result<Int64, String>>
          "[{\"Some\":[1]},{\"Ok\":[2]}]"
        |> Stdlib.Test.equal (Result.Ok((Option.Some 1L, Result.Ok 2L)))
        Stdlib.Json.parse<Char * Bool> "[\"a\",true]"
        |> Stdlib.Test.equal (Result.Ok(('a', true)))
        Stdlib.Json.parse<DateTime * Uuid>
          "[\"2023-07-28T22:42:36Z\",\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\"]"
        |> Stdlib.Test.equal (Result.Ok(
            (DateTime.d "2023-07-28T22:42:36Z",
             Uuid.uuid "3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
          )) ]

  test parseErrors =
    (Stdlib.Json.parse<Int64 * String * Int64> "[1,3]") |> err
    |> Stdlib.Test.equal (Result.Error
        "Can't parse JSON `[1,3]` as type `(Int64 * String * Int64)` at path: `root`")

  module Errors =
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<String * String * Int64> """[1, "two", 3]""") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `1` as type `String` at path: `root[0]`")
          (Stdlib.Json.parse<String> """[1, "two", 3]""") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[1, \"two\", 3]` as type `String` at path: `root`")
          (Stdlib.Json.parse<Int64 * String> """[1, "two", 3]""") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[1, \"two\", 3]` as type `(Int64 * String)` at path: `root`")
          (Stdlib.Json.parse<List<String * String> * (Person * Dict<String, String>)>
            "[[[2,\"two\"],[3,\"four\"]],[{\"Age\":42,\"Name\":\"Alice\"},{\"a\":1}]]")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `2` as type `String` at path: `root[0][0][0]`")
          (Stdlib.Json.parse<(List<Int64 * List<String>>) * String>
            "[[[1,\"two\"],[3,\"four\"]],\"\"]")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"two\"` as type `List<String>` at path: `root[0][0][1]`")
          (Stdlib.Json.parse<Person * Option<Int64>>
            "[{\"Age\":42,\"Name\":\"Alice\"},{\"Some\":[\"one\"]}]")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"one\"` as type `Int64` at path: `root[1].Some[0]`") ]

module Option =
  // TODO: more...
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Option<Int64>> Option.None
        |> Stdlib.Test.equal "{\"None\":[]}"
        Stdlib.Json.serialize<Option<Int64>> (Option.Some 1L)
        |> Stdlib.Test.equal "{\"Some\":[1]}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Option<Int64>> "{\"None\":[]}"
        |> Stdlib.Test.equal (Result.Ok Option.None)
        Stdlib.Json.parse<Option<Int64>> "{\"Some\":[1]}"
        |> Stdlib.Test.equal (Result.Ok(Option.Some 1L)) ]

  module Errors =
    // Option parsing intentionally requires the explicit enum representation.
    test parseErrors =
      Stdlib.Test.all
        [ // TODO: these might make good candidates for more ergonmic parsing
          (Stdlib.Json.parse<Option<Int64>> "null") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `null` as type `Darklang.Stdlib.Option.Option<Int64>` at path: `root`")
          (Stdlib.Json.parse<Option<Int64>> "1") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `1` as type `Darklang.Stdlib.Option.Option<Int64>` at path: `root`")
          (Stdlib.Json.parse<Option<List<String>>> "[1,2,3]") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[1,2,3]` as type `Darklang.Stdlib.Option.Option<List<String>>` at path: `root`") ]

module Result =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Result<Int64, String>> (Result.Ok 1L)
        |> Stdlib.Test.equal "{\"Ok\":[1]}"
        Stdlib.Json.serialize<Result<Int64, String>> (Result.Error "err message")
        |> Stdlib.Test.equal "{\"Error\":[\"err message\"]}"
        Stdlib.Json.serialize<Result<List<Dict<String, String> * Option<Int64>>, String>> (
            Result.Ok
              [ (Stdlib.Dict.singleton "a" "b", Option.Some 1L)
                (Stdlib.Dict.singleton "c" "d", Option.None) ]
          )
        |> Stdlib.Test.equal "{\"Ok\":[[[{\"a\":\"b\"},{\"Some\":[1]}],[{\"c\":\"d\"},{\"None\":[]}]]]}"
        Stdlib.Json.serialize<Result<Result<Int64, String>, String>> (
            Result.Ok(Result.Ok 1L)
          )
        |> Stdlib.Test.equal "{\"Ok\":[{\"Ok\":[1]}]}"
        Stdlib.Json.serialize<Result<Result<Int64, String>, String>> (
            Result.Ok(Result.Error "err message")
          )
        |> Stdlib.Test.equal "{\"Ok\":[{\"Error\":[\"err message\"]}]}"
        Stdlib.Json.serialize<Result<Result<Option<Result<Int64, String>>, String>, String>> (
            Result.Ok(Result.Ok(Option.Some(Result.Ok 1L)))
          )
        |> Stdlib.Test.equal "{\"Ok\":[{\"Ok\":[{\"Some\":[{\"Ok\":[1]}]}]}]}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Result<Int64, String>> "{\"Ok\":[1]}"
        |> Stdlib.Test.equal (Result.Ok(Result.Ok 1L))
        Stdlib.Json.parse<Result<Int64, String>> "{\"Error\":[\"err message\"]}"
        |> Stdlib.Test.equal (Result
            .Ok(Result.Error "err message"))
        Stdlib.Json.parse<Result<List<Dict<String, String> * Option<Int64>>, String>>"{\"Ok\":[[[{\"a\":\"b\"},{\"Some\":[1]}],[{\"c\":\"d\"},{\"None\":[]}]]]}"
        |> Stdlib.Test.equal (Result.Ok(Result.Ok [ (Stdlib.Dict.singleton "a" "b", Option.Some 1L), (Stdlib.Dict.singleton "c" "d", Option.None) ]))
        Stdlib.Json.parse<Result<Result<Int64, String>, String>> "{\"Ok\":[{\"Ok\":[1]}]}"
        |> Stdlib.Test.equal (Result.Ok(Result.Ok(Result.Ok 1L)))
        Stdlib.Json.parse<Result<Result<Int64, String>, String>> "{\"Ok\":[{\"Error\":[\"err message\"]}]}"
        |> Stdlib.Test.equal (Result.Ok(Result.Ok(Result.Error "err message")))
        Stdlib.Json.parse<Result<Result<Option<Result<Int64, String>>, String>, String>>
          "{\"Ok\":[{\"Ok\":[{\"Some\":[{\"Ok\":[1]}]}]}]}"
        |> Stdlib.Test.equal (Result.Ok(
            Result.Ok(Result.Ok(Option.Some(Result.Ok 1L)))
          )) ]

module Dict =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Dict<String, String>> (Stdlib.Dict.singleton "a" "b")
        |> Stdlib.Test.equal ("""{"a":"b"}""")
        Stdlib.Json.serialize<Dict<String, String>> (Dict { "a": "b"; "c": "d" })
        |> Stdlib.Test.equal ("""{"a":"b","c":"d"}""")
        Stdlib.Json.serialize<Dict<Int64, String>> (Dict { })
        |> Stdlib.Test.equal "{}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Dict<String, String>> """{"a":"b"}"""
        |> Stdlib.Test.equal (Result.Ok(Stdlib.Dict.singleton "a" "b"))
        Stdlib.Json.parse<Dict<String, String>> """{"a":"b","c":"d"}"""
        |> Stdlib.Test.equal (Result.Ok(Dict { "a": "b"; "c": "d" })) ]

  test rejects1 =
    (Stdlib.Json.serialize<Dict<Int64, String>> (Dict { 1L: "a" }))
    => raises "Cannot serialize { 1: \"a\" } into JSON"

  module Errors =
    test parseErrors =
      (Stdlib.Json.parse<Dict<String, Int64>> """{1:"b",2:"d"}""") |> err
      |> Stdlib.Test.equal (Result.Error "Not JSON")

module UserDefinedEnums =
  // TODO: more nesting...
  type PrettyLikely =
    | Yeah
    | Enh of reason: String * Int64

  type PrettyLikely2 =
    | PrettyLikely of PrettyLikely
    | Yes
    | No

  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<PrettyLikely> PrettyLikely.Yeah
        |> Stdlib.Test.equal "{\"Yeah\":[]}"
        Stdlib.Json.serialize<PrettyLikely> (PrettyLikely.Enh("printer broke", 7L))
        |> Stdlib.Test.equal "{\"Enh\":[\"printer broke\",7]}"
        Stdlib.Json.serialize<PrettyLikely2> (PrettyLikely2.PrettyLikely PrettyLikely.Yeah)
        |> Stdlib.Test.equal "{\"PrettyLikely\":[{\"Yeah\":[]}]}"
        Stdlib.Json.serialize<PrettyLikely2> (
            PrettyLikely2.PrettyLikely(PrettyLikely.Enh("printer broke", 7L))
          )
        |> Stdlib.Test.equal "{\"PrettyLikely\":[{\"Enh\":[\"printer broke\",7]}]}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<PrettyLikely> "{\"Yeah\":[]}"
        |> Stdlib.Test.equal (Result.Ok PrettyLikely.Yeah)
        Stdlib.Json.parse<PrettyLikely> "{\"Enh\":[\"printer broke\",7]}"
        |> Stdlib.Test.equal (Result.Ok(
            PrettyLikely.Enh("printer broke", 7L)
          ))
        Stdlib.Json.parse<PrettyLikely2> "{\"PrettyLikely\":[{\"Yeah\":[]}]}"
        |> Stdlib.Test.equal (Result.Ok(
            PrettyLikely2.PrettyLikely PrettyLikely.Yeah
          ))
        Stdlib.Json.parse<PrettyLikely2>
          "{\"PrettyLikely\":[{\"Enh\":[\"printer broke\",7]}]}"
        |> Stdlib.Test.equal (Result.Ok(
            PrettyLikely2.PrettyLikely(PrettyLikely.Enh("printer broke", 7L))
          )) ]

  module Errors =
    // Differs from legacy: type names in these errors are qualified with this test
    // module (`Darklang.Stdlib.Json.Tests.…`); legacy's were bare.
    test parseErrors =
      Stdlib.Test.all
        [ (Stdlib.Json.parse<PrettyLikely> "{\"Enh\":[\"printer broke\",\"not int\"]}")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `\"not int\"` as type `Int64` at path: `root.Enh[1]`")
          // EnumMissingField
          (Stdlib.Json.parse<PrettyLikely> "{\"Enh\":[\"printer broke\"]}") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON because argument 1 (`Int64`) is missing at path: `root.Enh`")
          // EnumExtraField
          (Stdlib.Json.parse<PrettyLikely> "{\"Enh\":[\"printer broke\", 1, 2.0]}") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON due to an extra argument `2.0` at path: `root.Enh[2]`")
          // CantMatchWithType
          (Stdlib.Json.parse<PrettyLikely> "{}") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `{}` as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`")
          (Stdlib.Json.parse<PrettyLikely> "[]") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[]` as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`")
          // EnumInvalidCasename
          (Stdlib.Json.parse<PrettyLikely> "{\"Wrong\":[\"printer broke\", 1, 2.0]}")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON as `Wrong` is not a known case of type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`")
          // EnumTooManyCases
          (Stdlib.Json.parse<PrettyLikely>
            "{\"Enh\":[\"printer broke\", 1], \"Extra\": \"field\"}")
          |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON with multiple fields (`Enh`, `Extra`) as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`") ]


module UserDefinedRecords =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Person> (Person { Name = "Bob"; Age = 42L })
        |> Stdlib.Test.equal ("""{"Age":42,"Name":"Bob"}""")
        Stdlib.Json.serialize<People> (
            People
              { GroupName = "Two Georges"
                People =
                  [ Person { Name = "George A"; Age = 27L }
                    Person { Name = "George B"; Age = 42L } ] }
          )
        |> Stdlib.Test.equal ("""{"GroupName":"Two Georges","People":[{"Age":27,"Name":"George A"},{"Age":42,"Name":"George B"}]}""")
        Stdlib.Json.serialize<Combo<Person, Combo<People, Int64>>> (
            Combo
              { e1 = Person { Name = "Bob"; Age = 42L }
                e2 =
                  Combo
                    { e1 =
                        People
                          { GroupName = "Two Georges"
                            People =
                              [ Person { Name = "George A"; Age = 27L }
                                Person { Name = "George B"; Age = 42L } ] }
                      e2 = 5L } }
          )
        |> Stdlib.Test.equal ("""{"e1":{"Age":42,"Name":"Bob"},"e2":{"e1":{"GroupName":"Two Georges","People":[{"Age":27,"Name":"George A"},{"Age":42,"Name":"George B"}]},"e2":5}}""")
        (Combo
          { e1 = Person { Name = "Bob"; Age = 42L }
            e2 =
              Combo
                { e1 =
                    People
                      { GroupName = "Two Georges"
                        People =
                          [ Person { Name = "George A"; Age = 27L }
                            Person { Name = "George B"; Age = 42L } ] }
                  e2 = 5L } })
        |> Stdlib.Json.serialize<Combo<Person, Combo<People, Int64>>>
        |> Stdlib.Json.parse<Combo<Person, Combo<People, Int64>>>
        |> Builtin.unwrap
        |> Stdlib.Test.equal ((Combo
            { e1 = Person { Name = "Bob"; Age = 42L }
              e2 =
                Combo
                  { e1 =
                      People
                        { GroupName = "Two Georges"
                          People =
                            [ Person { Name = "George A"; Age = 27L }
                              Person { Name = "George B"; Age = 42L } ] }
                    e2 = 5L } })) ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Person> """{ "Name": "Bob", "Age": 42 }"""
        |> Stdlib.Test.equal (Result.Ok(
            Person { Name = "Bob"; Age = 42L }
          ))
        // can parse even if the JSON has _extra_ fields
        Stdlib.Json.parse<Person> """{ "Name": "Bob", "Age": 42, "Height": "6 ft" }"""
        |> Stdlib.Test.equal (Result
            .Ok(Person { Name = "Bob"; Age = 42L }))
        (let personMaybe = Stdlib.Json.parse<Person> """{ "Name": "Bob", "Age": 42 }"""
         match personMaybe with
         | Ok person -> person.Age
         | Error _ -> 0)
        |> Stdlib.Test.equal 42L
        Stdlib.Json.parse<People>
          """{"GroupName":"Two Georges","People":[{"Age":27,"Name":"George A"},{"Age":42,"Name":"George B"}]}"""
        |> Stdlib.Test.equal (Result
            .Ok(
              People
                { GroupName = "Two Georges"
                  People =
                    [ Person { Name = "George A"; Age = 27L }
                      Person { Name = "George B"; Age = 42L } ] }
            ))
        Stdlib.Json.parse<Combo<Person, Combo<People, Int64>>>
          """{"e1":{"Age":42,"Name":"Bob"},"e2":{"e1":{"GroupName":"Two Georges","People":[{"Age":27,"Name":"George A"},{"Age":42,"Name":"George B"}]},"e2":5}}"""
        |> Stdlib.Test.equal (Result
            .Ok(
              Combo
                { e1 = Person { Name = "Bob"; Age = 42L }
                  e2 =
                    Combo
                      { e1 =
                          People
                            { GroupName = "Two Georges"
                              People =
                                [ Person { Name = "George A"; Age = 27L }
                                  Person { Name = "George B"; Age = 42L } ] }
                        e2 = 5L } }
            )) ]

  type People =
    { GroupName: String
      People: List<Person> }

  type Combo<'e1, 'e2> = { e1: 'e1; e2: 'e2 }

  module Errors =
    // Differs from legacy: type names in these errors are qualified with this test
    // module (`Darklang.Stdlib.Json.Tests.…`); legacy's were bare.
    test parseErrors =
      Stdlib.Test.all
        [ // Person shares its content hash with UserDefinedAliases.Person2 (identical structure),
          // but pickLocation now prefers the shorter path.
          (Stdlib.Json.parse<Person> "[]") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON `[]` as type `Darklang.Stdlib.Json.Tests.Person` at path: `root`")
          // Extra fields are allowed, but missing fields are not
          (Stdlib.Json.parse<Person> "{\"notAField\": 5}") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON because `Name` field is not provided at path: `root`")
          (Stdlib.Json.parse<Person> "{\"Age\": 5, \"Age\": 6, \"Name\": \"\"}") |> err
          |> Stdlib.Test.equal (Result.Error
              "Can't parse JSON because `Age` is defined more than once at path: `root`") ]


module UserDefinedAliases =
  type MyInt = Int64

  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<MyInt> 42L |> Stdlib.Test.equal "42"
        Stdlib.Json.serialize<MyPerson> (Person { Name = "Bob"; Age = 42L })
        |> Stdlib.Test.equal ("""{"Age":42,"Name":"Bob"}""")
        Stdlib.Json.serialize<MyPrettyLikely> (
            UserDefinedEnums.PrettyLikely.Enh("printer broke", 7L)
          )
        |> Stdlib.Test.equal "{\"Enh\":[\"printer broke\",7]}"
        // With content-addressed hashing, Person1 and Person2 are structurally
        // identical and share the same Hash, so they're the same type.
        Stdlib.Json.serialize<Person2> (Person1 { Name = "Bob"; Age = 42L })
        |> Stdlib.Test.equal ("""{"Age":42,"Name":"Bob"}""")
        Stdlib.Json.serialize<StringResult<Int64>> (Result.Ok 1L)
        |> Stdlib.Test.equal "{\"Ok\":[1]}"
        Stdlib.Json.serialize<StringResult<Int64>> (Result.Error "err")
        |> Stdlib.Test.equal "{\"Error\":[\"err\"]}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<MyInt> "42" |> Stdlib.Test.equal (Result.Ok 42L)
        Stdlib.Json.parse<MyPerson> """{ "Name": "Bob", "Age": 42 }"""
        |> Stdlib.Test.equal (Result.Ok(
            Person { Name = "Bob"; Age = 42L }
          ))
        Stdlib.Json.parse<MyPrettyLikely> "{\"Enh\":[\"printer broke\",7]}"
        |> Stdlib.Test.equal (Result.Ok(
            UserDefinedEnums.PrettyLikely.Enh("printer broke", 7L)
          )) ]

  type MyPerson = Person

  type MyPrettyLikely = UserDefinedEnums.PrettyLikely

  type Person1 = { Name: String; Age: Int64 }
  type Person2 = { Name: String; Age: Int64 }

  type StringResult<'a> = Result<'a, String>

  // This test currently slips by the typechecker, and so we get an internal
  // exception
  test rejects1 =
    (Stdlib.Json.serialize<StringResult<Int64>> (Result.Error 1L))
    => raises "Darklang.Stdlib.Json.serialize's 1st parameter `value` expects Darklang.Stdlib.Result.Result<Int64, String>, but got Darklang.Stdlib.Result.Result<_, Int64> (Error(1))"

module Package =
  test serialize =
    Stdlib.Test.all
      [ Stdlib.Json.serialize<Option<Int64>> Option.None
        |> Stdlib.Test.equal "{\"None\":[]}"
        Stdlib.Json.serialize<Result<Int64, String>> (Result.Ok 1L)
        |> Stdlib.Test.equal "{\"Ok\":[1]}"
        Stdlib.Json.serialize<Result<Int64, String>> (Result.Error "err message")
        |> Stdlib.Test.equal "{\"Error\":[\"err message\"]}"
        Stdlib.Json.serialize<Darklang.LanguageTools.ID> 42L
        |> Stdlib.Test.equal "42"
        Stdlib.Json.serialize<Darklang.LanguageTools.Sign>
          Darklang.LanguageTools.Sign.Positive
        |> Stdlib.Test.equal "{\"Positive\":[]}" ]

  test parse =
    Stdlib.Test.all
      [ Stdlib.Json.parse<Option<Int64>> "{\"None\":[]}"
        |> Stdlib.Test.equal (Result.Ok Option.None)
        Stdlib.Json.parse<Result<Int64, String>> "{\"Ok\":[1]}"
        |> Stdlib.Test.equal (Result.Ok(Result.Ok 1L))
        Stdlib.Json.parse<Result<Int64, String>> "{\"Error\":[\"err message\"]}"
        |> Stdlib.Test.equal (Result
            .Ok(Result.Error "err message"))
        Stdlib.Json.parse<Darklang.LanguageTools.ID> "42"
        |> Stdlib.Test.equal (Result.Ok 42L)
        Stdlib.Json.parse<Darklang.LanguageTools.Sign> "{\"Positive\":[]}"
        |> Stdlib.Test.equal (Result.Ok
            Darklang.LanguageTools.Sign.Positive) ]

