module Darklang.Stdlib.Json.Tests

// Unsupported stuff:
// - TFn
// None of these are supported as <> type args in the parser,
// so do we really have to do anything here?
// It feels like a "no" to me - ignoring for now.
type Person =
  { Name: String
    Age: Int64 }


type Result<'ok, 'err> = Stdlib.Result.Result<'ok, 'err>

type Option<'t> = Stdlib.Option.Option<'t>


let err(
  v: Stdlib.Result.Result<'a, Stdlib.Json.ParseError.ParseError>)
  : Result<'a, String> =
  v
  |> Stdlib.Result.mapError(fun e ->
    Stdlib.Json.ParseError.toString(SCM.Branch.mainBranchId, e))


module Unit =
  test serialize = Stdlib.Json.serialize<Unit>() |> Stdlib.Test.equal("null")

  test parse = Stdlib.Json.parse<Unit>("null") |> Stdlib.Test.equal(Result.Ok())


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Int64>("()")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 1"))

          Stdlib.Json.parse<Unit>("0")
          |> err
          |> Stdlib.Test.equal(
            Result.Error("Can't parse JSON `0` as type `Unit` at path: `root`"))

          Stdlib.Json.parse<Unit>("\"\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"\"` as type `Unit` at path: `root`"))

          Stdlib.Json.parse<Unit>("\"null\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"null\"` as type `Unit` at path: `root`")) ])


module Bool =
  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Bool>(true) |> Stdlib.Test.equal("true")
        Stdlib.Json.serialize<Bool>(false) |> Stdlib.Test.equal("false") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Bool>("true") |> Stdlib.Test.equal(Result.Ok(true))

        Stdlib.Json.parse<Bool>("false") |> Stdlib.Test.equal(Result.Ok(false))

        Stdlib.Json.parse<Bool>(" true ") |> Stdlib.Test.equal(Result.Ok(true))

        Stdlib.Json.parse<Bool>(" false ")
        |> Stdlib.Test.equal(Result.Ok(false))

        Stdlib.Json.parse<List<Bool>>("[true, true, false, true  ] ")
        |> Stdlib.Test.equal(Result.Ok([ true, true, false, true ])) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Bool>("tru")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4"))

          Stdlib.Json.parse<Bool>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `Bool` at path: `root`"))

          Stdlib.Json.parse<Bool>("")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 1"))

          Stdlib.Json.parse<Bool>("\"true\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"true\"` as type `Bool` at path: `root`"))

          Stdlib.Json.parse<Bool>("0")
          |> err
          |> Stdlib.Test.equal(
            Result.Error("Can't parse JSON `0` as type `Bool` at path: `root`"))

          Stdlib.Json.parse<Bool>("1")
          |> err
          |> Stdlib.Test.equal(
            Result.Error("Can't parse JSON `1` as type `Bool` at path: `root`"))

          Stdlib.Json.parse<Bool>("False")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 1"))

          Stdlib.Json.parse<Bool>("tRUE")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2")) ])


module Float64 =
  // TODO: review Float64.tests for more values to test against

  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Float64>(0.0) |> Stdlib.Test.equal("0.0")

        Stdlib.Json.serialize<Float64>(1.0) |> Stdlib.Test.equal("1.0")

        Stdlib.Json.serialize<Float64>(0.1) |> Stdlib.Test.equal("0.1")

        Stdlib.Json.serialize<Float64>(2.0 / 3.0)
        |> Stdlib.Test.equal("0.6666666666666666")

        Stdlib.Json.serialize<Float64>(12345.67890)
        |> Stdlib.Test.equal("12345.6789")

        Stdlib.Json.serialize<Float64>(-12345.67890)
        |> Stdlib.Test.equal("-12345.6789")

        Stdlib.Json.serialize<Float64>(3.141592653589793)
        |> Stdlib.Test.equal("3.141592653589793")

        Stdlib.Json.serialize<Float64>(1.618033988749895)
        |> Stdlib.Test.equal("1.618033988749895")

        // needs all seventeen digits; "G16" would write 0.3
        Stdlib.Json.serialize<Float64>(0.1 + 0.2)
        |> Stdlib.Test.equal("0.30000000000000004")

        // Exponent form is valid JSON as long as nothing appends `.0` to it.
        Stdlib.Json.serialize<Float64>(1e16) |> Stdlib.Test.equal("1e+16")

        Stdlib.Json.serialize<Float64>(0.00001) |> Stdlib.Test.equal("1e-5") ])


  test parse =
    Stdlib.Test.all(
      [ // ints as floats
        Stdlib.Json.parse<Float64>("0.0") |> Stdlib.Test.equal(Result.Ok(0.0))

        Stdlib.Json.parse<Float64>("0") |> Stdlib.Test.equal(Result.Ok(0.0))

        Stdlib.Json.parse<Float64>("123") |> Stdlib.Test.equal(Result.Ok(123.0))

        Stdlib.Json.parse<Float64>("12345.67890")
        |> Stdlib.Test.equal(Result.Ok(12345.67890))

        Stdlib.Json.parse<Float64>("-12345.67890")
        |> Stdlib.Test.equal(Result.Ok(-12345.67890))

        Stdlib.Json.parse<Float64>(" 42.0 ")
        |> Stdlib.Test.equal(Result.Ok(42.0))

        Stdlib.Json.parse<Float64>(" -42.0 ")
        |> Stdlib.Test.equal(Result.Ok(-42.0))

        Stdlib.Json.parse<Float64>("1e3")
        |> Stdlib.Test.equal(Result.Ok(1000.0))

        Stdlib.Json.parse<Float64>("-1e3")
        |> Stdlib.Test.equal(Result.Ok(-1000.0))

        Stdlib.Json.parse<Float64>("0.30000000000000004")
        |> Stdlib.Test.equal(Result.Ok(0.1 + 0.2))

        Stdlib.Json.parse<Float64>("1e+16")
        |> Stdlib.Test.equal(Result.Ok(1e16))

        Stdlib.Json.parse<Float64>("1e-5")
        |> Stdlib.Test.equal(Result.Ok(0.00001))

        Stdlib.Json.parse<Float64>("1.0000001")
        |> Stdlib.Test.equal(Result.Ok(1.0000001))

        Stdlib.Json.parse<Float64>("-1.00000001")
        |> Stdlib.Test.equal(Result.Ok(-1.00000001))

        Stdlib.Json.parse<Float64>("-2147483647.8")
        |> Stdlib.Test.equal(Result.Ok(-2147483647.8))

        Stdlib.Json.parse<Float64>("17.55042081")
        |> Stdlib.Test.equal(Result.Ok(17.55042081))

        Stdlib.Json.parse<Float64>("2147483647.000009")
        |> Stdlib.Test.equal(Result.Ok(2147483647.000009))

        Stdlib.Json.parse<Float64>("-2367.9267")
        |> Stdlib.Test.equal(Result.Ok(-2367.9267))

        Stdlib.Json.parse<Float64>(
          "0.6999999999999999555910790149937383830547332763671875")
        |> Stdlib.Test.equal(
          Result.Ok(0.6999999999999999555910790149937383830547332763671875))

        Stdlib.Json.parse<Float64>("0.7999999999")
        |> Stdlib.Test.equal(Result.Ok(0.7999999999)) ])


  module Values =
    test serialize =
      Stdlib.Test.all(
        [ // JSON represents infinities and NaN as strings.
          Stdlib.Json.serialize<Float64>(-1.0 / 0.0)
          |> Stdlib.Test.equal("\"-Infinity\"")

          Stdlib.Json.serialize<Float64>(1.0 / 0.0)
          |> Stdlib.Test.equal("\"Infinity\"")

          Stdlib.Json.serialize<Float64>(Stdlib.Float64.sqrt(-1.0))
          |> Stdlib.Test.equal("\"NaN\"") ])


    test parse =
      Stdlib.Test.all(
        [ // NaN never equals itself; check it with isNaN.
          Stdlib.Json.parse<Float64>("\"-Infinity\"")
          |> Stdlib.Test.equal(Result.Ok(-1.0 / 0.0))

          Stdlib.Json.parse<Float64>("\"Infinity\"")
          |> Stdlib.Test.equal(Result.Ok(1.0 / 0.0))

          Stdlib.Json.parse<Float64>("\"NaN\"")
          |> Stdlib.Result.map(Stdlib.Float64.isNaN)
          |> Stdlib.Test.equal(Result.Ok(true)) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Float64>("e")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 1"))

          Stdlib.Json.parse<Float64>("pi")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 1"))

          Stdlib.Json.parse<Float64>(" -42 . 0 ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 6"))

          Stdlib.Json.parse<Float64>("0")
          |> err
          |> Stdlib.Test.equal(Result.Ok(0.0))

          Stdlib.Json.parse<Float64>(" ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<Float64>("4a")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<Float64>("- 42.0")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<Float64>("-141s")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 5"))

          Stdlib.Json.parse<Float64>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("true")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `true` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("false")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `false` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("\"42\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"42\"` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("[42]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[42]` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("{ \"key\": 42 }")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{ \"key\": 42 }` as type `Float64` at path: `root`"))

          Stdlib.Json.parse<Float64>("\"42\n\"")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4"))

          Stdlib.Json.parse<Float64>("000000.9")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<Float64>("-000000.9")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 3"))

          Stdlib.Json.parse<Float64>("-00000000.000")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 3"))

          Stdlib.Json.parse<Float64>("00000000.000")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<Float64>("\"65.0\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"65.0\"` as type `Float64` at path: `root`")) ])


module Char =
  let charFromString(s: String): Char =
    Stdlib.String.head(s) |> Builtin.unwrap


  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Char>('a') |> Stdlib.Test.equal("\"a\"")

        Stdlib.Json.serialize<Char>(charFromString("Ł"))
        |> Stdlib.Test.equal("\"Ł\"") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Char>("\"a\"") |> Stdlib.Test.equal(Result.Ok('a'))
        Stdlib.Json.parse<Char>("\"Ł\"") |> Stdlib.Test.equal(Result.Ok('Ł')) ])


  module SimpleEmoji =
    test serialize =
      Stdlib.Json.serialize<Char>("😂" |> charFromString)
      |> Stdlib.Test.equal("\"\\uD83D\\uDE02\"")


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Char>("\"😂\"")
          |> Stdlib.Test.equal(Result.Ok(charFromString("😂")))

          Stdlib.Json.parse<Char>("\"\\uD83D\\uDE02\"")
          |> Stdlib.Test.equal(Result.Ok(charFromString("😂"))) ])


  module ComplexEmoji =
    test serialize =
      Stdlib.Json.serialize<Char>(charFromString("👩‍👩‍👧‍👦"))
      |> Stdlib.Test.equal(
        "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\"")


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Char>(
            "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\"")
          |> Stdlib.Test.equal(Result.Ok(charFromString("👩‍👩‍👧‍👦")))

          Stdlib.Json.parse<Char>("\"👩‍👩‍👧‍👦\"")
          |> Stdlib.Test.equal(Result.Ok("👩‍👩‍👧‍👦" |> charFromString)) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Char>("\"test\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"test\"` as type `Char` at path: `root`"))

          Stdlib.Json.parse<Char>("\"\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"\"` as type `Char` at path: `root`"))

          Stdlib.Json.parse<Char>("62")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `62` as type `Char` at path: `root`")) ])


module String =
  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<String>("abc") |> Stdlib.Test.equal("\"abc\"")

        Stdlib.Json.serialize<String>("") |> Stdlib.Test.equal("\"\"")

        Stdlib.Json.serialize<String>("żółw") |> Stdlib.Test.equal("\"żółw\"")

        Stdlib.Json.serialize<String>("👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷")
        |> Stdlib.Test.equal(
          "\"\\uD83D\\uDC68‍❤️‍\\uD83D\\uDC8B‍\\uD83D\\uDC68\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\\uD83C\\uDFF3️‍⚧️‍️\\uD83C\\uDDF5\\uD83C\\uDDF7\"")

        Stdlib.Json.serialize<String>("👩‍👩‍👧‍👦")
        |> Stdlib.Test.equal(
          "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\"")

        Stdlib.Json.serialize<String>(
          "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.")
        |> Stdlib.Test.equal(
          "\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.\"")

        Stdlib.Json.serialize<String>(Stdlib.String.repeat("a", 100))
        |> Stdlib.Test.equal(
          "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<String>("\"abc\"")
        |> Stdlib.Test.equal(Result.Ok("abc"))

        Stdlib.Json.parse<String>("\"\"") |> Stdlib.Test.equal(Result.Ok(""))

        Stdlib.Json.parse<String>("\"żółw\"")
        |> Stdlib.Test.equal(Result.Ok("żółw"))

        Stdlib.Json.parse<String>("\"👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷\"")
        |> Stdlib.Test.equal(Result.Ok("👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷"))

        Stdlib.Json.parse<String>("\"👩‍👩‍👧‍👦\"")
        |> Stdlib.Test.equal(Result.Ok("👩‍👩‍👧‍👦"))

        Stdlib.Json.parse<String>(
          "\"\\uD83D\\uDC69‍\\uD83D\\uDC69‍\\uD83D\\uDC67‍\\uD83D\\uDC66\"")
        |> Stdlib.Test.equal(Result.Ok("👩‍👩‍👧‍👦"))

        Stdlib.Json.parse<String>(
          "\"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor.\"")
        |> Stdlib.Test.equal(
          Result.Ok(
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus. Suspendisse lectus tortor, dignissim sit amet, adipiscing nec, ultricies sed, dolor."))

        Stdlib.Json.parse<String>(
          "\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"")
        |> Stdlib.Test.equal(Result.Ok(Stdlib.String.repeat("a", 100))) ])


module DateTime =
  let d(datestr: String): DateTime =
    Stdlib.DateTime.parse(datestr) |> Builtin.unwrap


  test serialize =
    Stdlib.Test.all(
      [ // now-ish
        Stdlib.Json.serialize<DateTime>(d("2023-07-28T22:42:36Z"))
        |> Stdlib.Test.equal("\"2023-07-28T22:42:36Z\"")

        // epoch
        Stdlib.Json.serialize<DateTime>(d("1969-07-28T22:42:36Z"))
        |> Stdlib.Test.equal("\"1969-07-28T22:42:36Z\"")

        // before epoch
        Stdlib.Json.serialize<DateTime>(d("1402-07-28T22:42:36Z"))
        |> Stdlib.Test.equal("\"1402-07-28T22:42:36Z\"")

        // far in future
        Stdlib.Json.serialize<DateTime>(d("3023-07-28T22:42:36Z"))
        |> Stdlib.Test.equal("\"3023-07-28T22:42:36Z\"") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<DateTime>("\"2023-07-28T22:42:36Z\"")
        |> Stdlib.Test.equal(Result.Ok(d("2023-07-28T22:42:36Z")))

        Stdlib.Json.parse<DateTime>("\"1969-07-28T22:42:36Z\"")
        |> Stdlib.Test.equal(Result.Ok(d("1969-07-28T22:42:36Z")))

        Stdlib.Json.parse<DateTime>("\"1402-07-28T22:42:36Z\"")
        |> Stdlib.Test.equal(Result.Ok(d("1402-07-28T22:42:36Z")))

        Stdlib.Json.parse<DateTime>("\"3023-07-28T22:42:36Z\"")
        |> Stdlib.Test.equal(Result.Ok(d("3023-07-28T22:42:36Z"))) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<DateTime>("\"3023-07-28T22:42:36\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"3023-07-28T22:42:36\"` as type `DateTime` at path: `root`"))

          Stdlib.Json.parse<DateTime>("\"2023-07-28\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"2023-07-28\"` as type `DateTime` at path: `root`"))

          Stdlib.Json.parse<DateTime>("1")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `1` as type `DateTime` at path: `root`")) ])


module Uuid =
  let uuid(s: String): Uuid =
    Stdlib.Uuid.parse(s) |> Builtin.unwrap


  test serialize =
    Stdlib.Test.all(
      [ // empty
        Stdlib.Json.serialize<Uuid>(
          uuid("00000000-0000-0000-0000-000000000000"))
        |> Stdlib.Test.equal("\"00000000-0000-0000-0000-000000000000\"")

        // normal
        Stdlib.Json.serialize<Uuid>(
          uuid("3700adbc-7a46-4ff4-81d3-45afb03f6e2d"))
        |> Stdlib.Test.equal("\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\"")

        Stdlib.Json.serialize<Uuid>(
          uuid("11111111-2222-3333-4444-555555555555"))
        |> Stdlib.Test.equal("\"11111111-2222-3333-4444-555555555555\"") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Uuid>("\"00000000-0000-0000-0000-000000000000\"")
        |> Stdlib.Test.equal(
          Result.Ok(uuid("00000000-0000-0000-0000-000000000000")))

        Stdlib.Json.parse<Uuid>("\"3700adbc-7a46-4ff4-81d3-45afb03f6e2d\"")
        |> Stdlib.Test.equal(
          Result.Ok(uuid("3700adbc-7a46-4ff4-81d3-45afb03f6e2d")))

        Stdlib.Json.parse<Uuid>("\"11111111-2222-3333-4444-555555555555\"")
        |> Stdlib.Test.equal(
          Result.Ok(uuid("11111111-2222-3333-4444-555555555555"))) ])


  module Errors =
    test parseErrors =
      // needs one more 0 at the end
      Stdlib.Json.parse<Uuid>("\"00000000-0000-0000-0000-00000000000\"")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON `\"00000000-0000-0000-0000-00000000000\"` as type `Uuid` at path: `root`"))


module BadTypes =
  test rejects1 =
    Stdlib.Json.parse<Int64 -> Int64>("{}")
    |> err
    |> Stdlib.Test.equal(
      Result.Error(
        "Can't parse JSON as type `Int64 -> Int64`, which has no JSON form"))


  test rejects2 =
    Stdlib.Json.serialize<Int64 -> Int64>(fun i -> 5)
    => raises "Cannot serialize (lambda) into JSON"


  test checkedRejects =
    Stdlib.Json.checkedSerialize<Int64 -> Int64>(fun i -> 5)
    |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))
    |> Stdlib.Test.equal(Result.Error("Cannot serialize a function into JSON"))


  test checkedRejectsIntKeys =
    Stdlib.Json.checkedSerialize<Dict<Int64, String>>(Dict { 1: "a" })
    |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))
    |> Stdlib.Test.equal(
      Result.Error(
        "Cannot serialize a dict into JSON: JSON object keys must be Strings, but this dict's keys are Int64"))


  test checkedSerializes =
    Stdlib.Json.checkedSerialize<List<Int64>>([ 1, 2 ])
    |> Stdlib.Test.equal(Result.Ok("[1,2]"))


module ParseErrorToString =
  test interpolates =
    Stdlib.Json.parse<Person>("{\"Name\":\"Bob\",\"Age\":\"x\"}")
    |> Stdlib.Result.mapError(fun e -> $"{e}")
    |> Stdlib.Test.equal(
      Result.Error(
        "Can't parse JSON `\"x\"` as type `Int64` at path: `root.Age`"))


  test toStringNeedsNoBranch =
    Stdlib.Json.parse<Int64>("1 2")
    |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))
    |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 3"))
