module Darklang.Stdlib.Uuid.Tests

// Map over the parse Result so a parse error fails the assertion.
test parse =
  Stdlib.Test.all(
    [ Stdlib.Uuid.parse("3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
      |> Stdlib.Result.map(Stdlib.display)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok("3700adbc-7a46-4ff4-81d3-45afb03f6e2d"))

      Stdlib.Uuid.parse("11111111-2222-3333-4444-555555555555")
      |> Stdlib.Result.map(Stdlib.display)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok("11111111-2222-3333-4444-555555555555")) ])


test toStringUsesLowercaseHyphenatedFormat =
  Stdlib.Uuid.parse("3700ADBC-7A46-4FF4-81D3-45AFB03F6E2D")
  |> Stdlib.Result.map(Stdlib.display)
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Ok("3700adbc-7a46-4ff4-81d3-45afb03f6e2d"))


// bad format
test parseRejectsBadFormat =
  Stdlib.Test.all(
    [ Stdlib.Uuid.parse("👱🏼")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat))

      Stdlib.Uuid.parse("1111111🍇-2222-3333-4444-555555555555")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat))

      Stdlib.Uuid.parse("psp-soslsls==")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat))

      Stdlib.Uuid.parse("123456")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat))

      Stdlib.Uuid.parse("d388ff30-667f-11eb-ae93")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat))

      Stdlib.Uuid.parse("d388ff30-667f-11eb-ae93-0242ac13000")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Uuid.ParseError.BadFormat)) ])


// A v7 has version digit 7 and variant digit 8, 9, a or b.
test generateV7SetsVersionAndVariant =
  let text = Stdlib.display(Stdlib.Uuid.generateV7())
  Stdlib.Test.all(
    [ Stdlib.String.slice(text, 14, 15) |> Stdlib.Test.equal("7")

      Stdlib.List.contains(
        [ "8", "9", "a", "b" ],
        Stdlib.String.slice(text, 19, 20))
      |> Stdlib.Test.equal(true) ])
