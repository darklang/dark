/// Cases ported from `backend/testfiles/execution/stdlib/uuid.dark`.
module Darklang.Stdlib.Uuid.Tests

// parse OK
// Differs from legacy: legacy unwrapped the parse result before `toString`; this
// maps over the Result, so a parse error fails the assertion instead of raising.
test parse =
  Stdlib.Test.all
    [ Stdlib.Uuid.parse "3700adbc-7a46-4ff4-81d3-45afb03f6e2d"
      |> Stdlib.Result.map Stdlib.toString
      |> Stdlib.Test.equal (Ok "3700adbc-7a46-4ff4-81d3-45afb03f6e2d")
      Stdlib.Uuid.parse "11111111-2222-3333-4444-555555555555"
      |> Stdlib.Result.map Stdlib.toString
      |> Stdlib.Test.equal (Ok "11111111-2222-3333-4444-555555555555") ]

// bad format
test parseRejectsBadFormat =
  Stdlib.Test.all
    [ Stdlib.Uuid.parse "👱🏼"
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat)
      Stdlib.Uuid.parse "1111111🍇-2222-3333-4444-555555555555"
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat)
      Stdlib.Uuid.parse "psp-soslsls=="
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat)
      Stdlib.Uuid.parse "123456"
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat)
      Stdlib.Uuid.parse "d388ff30-667f-11eb-ae93"
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat)
      Stdlib.Uuid.parse "d388ff30-667f-11eb-ae93-0242ac13000"
      |> Stdlib.Test.equal (Error Stdlib.Uuid.ParseError.BadFormat) ]
