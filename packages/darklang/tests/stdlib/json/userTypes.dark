module Darklang.Stdlib.Json.Tests

module UserDefinedEnums =
  // TODO: more nesting...
  type PrettyLikely =
    | Yeah
    | Enh(reason: String, Int64)


  type PrettyLikely2 =
    | PrettyLikely(PrettyLikely)
    | Yes
    | No


  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<PrettyLikely>(PrettyLikely.Yeah)
        |> Stdlib.Test.equal("{\"Yeah\":[]}")

        Stdlib.Json.serialize<PrettyLikely>(
          PrettyLikely.Enh("printer broke", 7))
        |> Stdlib.Test.equal("{\"Enh\":[\"printer broke\",7]}")

        Stdlib.Json.serialize<PrettyLikely2>(
          PrettyLikely2.PrettyLikely(PrettyLikely.Yeah))
        |> Stdlib.Test.equal("{\"PrettyLikely\":[{\"Yeah\":[]}]}")

        Stdlib.Json.serialize<PrettyLikely2>(
          PrettyLikely2.PrettyLikely(PrettyLikely.Enh("printer broke", 7)))
        |> Stdlib.Test.equal(
          "{\"PrettyLikely\":[{\"Enh\":[\"printer broke\",7]}]}") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<PrettyLikely>("{\"Yeah\":[]}")
        |> Stdlib.Test.equal(Result.Ok(PrettyLikely.Yeah))

        Stdlib.Json.parse<PrettyLikely>("{\"Enh\":[\"printer broke\",7]}")
        |> Stdlib.Test.equal(Result.Ok(PrettyLikely.Enh("printer broke", 7)))

        Stdlib.Json.parse<PrettyLikely2>("{\"PrettyLikely\":[{\"Yeah\":[]}]}")
        |> Stdlib.Test.equal(
          Result.Ok(PrettyLikely2.PrettyLikely(PrettyLikely.Yeah)))

        Stdlib.Json.parse<PrettyLikely2>(
          "{\"PrettyLikely\":[{\"Enh\":[\"printer broke\",7]}]}")
        |> Stdlib.Test.equal(
          Result.Ok(
            PrettyLikely2.PrettyLikely(
              PrettyLikely.Enh("printer broke", 7)))) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<PrettyLikely>(
            "{\"Enh\":[\"printer broke\",\"not int\"]}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"not int\"` as type `Int64` at path: `root.Enh[1]`"))

          // EnumMissingField
          Stdlib.Json.parse<PrettyLikely>("{\"Enh\":[\"printer broke\"]}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON because argument 1 (`Int64`) is missing at path: `root.Enh`"))

          // EnumExtraField
          Stdlib.Json.parse<PrettyLikely>(
            "{\"Enh\":[\"printer broke\", 1, 2.0]}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON due to an extra argument `2.0` at path: `root.Enh[2]`"))

          // CantMatchWithType
          Stdlib.Json.parse<PrettyLikely>("{}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{}` as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`"))

          Stdlib.Json.parse<PrettyLikely>("[]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[]` as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`"))

          // EnumInvalidCasename
          Stdlib.Json.parse<PrettyLikely>(
            "{\"Wrong\":[\"printer broke\", 1, 2.0]}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON as `Wrong` is not a known case of type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`"))

          // EnumTooManyCases
          Stdlib.Json.parse<PrettyLikely>(
            "{\"Enh\":[\"printer broke\", 1], \"Extra\": \"field\"}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON with multiple fields (`Enh`, `Extra`) as type `Darklang.Stdlib.Json.Tests.UserDefinedEnums.PrettyLikely` at path: `root`")) ])


module UserDefinedRecords =
  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Person>(Person { Name = "Bob", Age = 42 })
        |> Stdlib.Test.equal("""{"Name":"Bob","Age":42}""")

        Stdlib.Json.serialize<People>(
          People
            { GroupName = "Two Georges"
              People =
                [ Person { Name = "George A", Age = 27 }
                  Person { Name = "George B", Age = 42 } ] })
        |> Stdlib.Test.equal(
          """{"GroupName":"Two Georges","People":[{"Name":"George A","Age":27},{"Name":"George B","Age":42}]}""")

        Stdlib.Json.serialize<Combo<Person, Combo<People, Int64>>>(
          Combo
            { e1 = Person { Name = "Bob", Age = 42 }
              e2 =
                Combo
                  { e1 =
                      People
                        { GroupName = "Two Georges"
                          People =
                            [ Person { Name = "George A", Age = 27 }
                              Person { Name = "George B", Age = 42 } ] }
                    e2 = 5 } })
        |> Stdlib.Test.equal(
          """{"e1":{"Name":"Bob","Age":42},"e2":{"e1":{"GroupName":"Two Georges","People":[{"Name":"George A","Age":27},{"Name":"George B","Age":42}]},"e2":5}}""")

        Combo
          { e1 = Person { Name = "Bob", Age = 42 }
            e2 =
              Combo
                { e1 =
                    People
                      { GroupName = "Two Georges"
                        People =
                          [ Person { Name = "George A", Age = 27 }
                            Person { Name = "George B", Age = 42 } ] }
                  e2 = 5 } }
        |> Stdlib.Json.serialize<Combo<Person, Combo<People, Int64>>>
        |> Stdlib.Json.parse<Combo<Person, Combo<People, Int64>>>
        |> Builtin.unwrap
        |> Stdlib.Test.equal(
          Combo
            { e1 = Person { Name = "Bob", Age = 42 }
              e2 =
                Combo
                  { e1 =
                      People
                        { GroupName = "Two Georges"
                          People =
                            [ Person { Name = "George A", Age = 27 }
                              Person { Name = "George B", Age = 42 } ] }
                    e2 = 5 } }) ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Person>("""{ "Name": "Bob", "Age": 42 }""")
        |> Stdlib.Test.equal(Result.Ok(Person { Name = "Bob", Age = 42 }))

        // can parse even if the JSON has _extra_ fields
        Stdlib.Json.parse<Person>(
          """{ "Name": "Bob", "Age": 42, "Height": "6 ft" }""")
        |> Stdlib.Test.equal(Result.Ok(Person { Name = "Bob", Age = 42 }))

        (let personMaybe =
           Stdlib.Json.parse<Person>("""{ "Name": "Bob", "Age": 42 }""")
         match personMaybe with
         | Ok(person) -> person.Age
         | Error(_) -> 0)
        |> Stdlib.Test.equal(42)

        Stdlib.Json.parse<People>(
          """{"GroupName":"Two Georges","People":[{"Name":"George A","Age":27},{"Name":"George B","Age":42}]}""")
        |> Stdlib.Test.equal(
          Result.Ok(
            People
              { GroupName = "Two Georges"
                People =
                  [ Person { Name = "George A", Age = 27 }
                    Person { Name = "George B", Age = 42 } ] }))

        Stdlib.Json.parse<Combo<Person, Combo<People, Int64>>>(
          """{"e1":{"Name":"Bob","Age":42},"e2":{"e1":{"GroupName":"Two Georges","People":[{"Name":"George A","Age":27},{"Name":"George B","Age":42}]},"e2":5}}""")
        |> Stdlib.Test.equal(
          Result.Ok(
            Combo
              { e1 = Person { Name = "Bob", Age = 42 }
                e2 =
                  Combo
                    { e1 =
                        People
                          { GroupName = "Two Georges"
                            People =
                              [ Person { Name = "George A", Age = 27 }
                                Person { Name = "George B", Age = 42 } ] }
                      e2 = 5 } })) ])


  type People =
    { GroupName: String
      People: List<Person> }


  /// `Nickname` goes through this file's `Option` alias, `Age` names the stdlib type.
  type Profile =
    { Name: String
      Nickname: Option<String>
      Age: Stdlib.Option.Option<Int64> }


  module OptionalFields =
    test missingOptionFieldsAreNone =
      Stdlib.Json.parse<Profile>("""{ "Name": "Bob" }""")
      |> Stdlib.Test.equal(
        Result.Ok(
          Profile { Name = "Bob", Nickname = Option.None, Age = Option.None }))


    test presentOptionFieldsStillParse =
      Stdlib.Json.parse<Profile>(
        """{ "Name": "Bob", "Nickname": { "Some": ["B"] }, "Age": { "None": [] } }""")
      |> Stdlib.Test.equal(
        Result.Ok(
          Profile
            { Name = "Bob", Nickname = Option.Some("B"), Age = Option.None }))


    test plainValuesAreSome =
      Stdlib.Json.parse<Profile>(
        """{ "Name": "Bob", "Nickname": "B", "Age": 42 }""")
      |> Stdlib.Test.equal(
        Result.Ok(
          Profile
            { Name = "Bob"
              Nickname = Option.Some("B")
              Age = Option.Some(42) }))


    test nullIsNone =
      Stdlib.Json.parse<Profile>(
        """{ "Name": "Bob", "Nickname": null, "Age": null }""")
      |> Stdlib.Test.equal(
        Result.Ok(
          Profile { Name = "Bob", Nickname = Option.None, Age = Option.None }))


    test serializedProfileParses =
      let p =
        Profile { Name = "Bob", Nickname = Option.Some("B"), Age = Option.None }

      Stdlib.Json.parse<Profile>(Stdlib.Json.serialize<Profile>(p))
      |> Stdlib.Test.equal(Result.Ok(p))


    test plainValueOfWrongTypeIsAnError =
      Stdlib.Json.parse<Profile>("""{ "Name": "Bob", "Age": "old" }""")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON `\"old\"` as type `Int64` at path: `root.Age`"))


    test missingTypeArgOptionIsNone =
      Stdlib.Json.parse<Combo<Int64, Option<Int64>>>("""{ "e1": 1 }""")
      |> Stdlib.Test.equal(Result.Ok(Combo { e1 = 1, e2 = Option.None }))


    test someWithoutArrayIsAnError =
      Stdlib.Json.parse<Profile>(
        """{ "Name": "Bob", "Nickname": { "Some": "B" } }""")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON `\"B\"` as type `Darklang.Stdlib.Option.Option<String>` at path: `root.Nickname.Some`"))


    test otherMissingFieldsStillFail =
      Stdlib.Json.parse<Profile>("""{ "Nickname": { "None": [] } }""")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON because `Name` field is not provided at path: `root`"))


  type Combo<'e1, 'e2> =
    { e1: 'e1
      e2: 'e2 }


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Person>("[]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[]` as type `Darklang.Stdlib.Json.Tests.Person` at path: `root`"))

          // Extra fields are allowed, but missing fields are not
          Stdlib.Json.parse<Person>("{\"notAField\": 5}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON because `Name` field is not provided at path: `root`"))

          Stdlib.Json.parse<Person>("{\"Age\": 5, \"Age\": 6, \"Name\": \"\"}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON because `Age` is defined more than once at path: `root`")) ])


module UserDefinedAliases =
  type MyInt = Int64


  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<MyInt>(42) |> Stdlib.Test.equal("42")

        Stdlib.Json.serialize<MyPerson>(Person { Name = "Bob", Age = 42 })
        |> Stdlib.Test.equal("""{"Name":"Bob","Age":42}""")

        Stdlib.Json.serialize<MyPrettyLikely>(
          UserDefinedEnums.PrettyLikely.Enh("printer broke", 7))
        |> Stdlib.Test.equal("{\"Enh\":[\"printer broke\",7]}")

        Stdlib.Json.serialize<StringResult<Int64>>(Result.Ok(1))
        |> Stdlib.Test.equal("{\"Ok\":[1]}")

        Stdlib.Json.serialize<StringResult<Int64>>(Result.Error("err"))
        |> Stdlib.Test.equal("{\"Error\":[\"err\"]}") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<MyInt>("42") |> Stdlib.Test.equal(Result.Ok(42))

        Stdlib.Json.parse<MyPerson>("""{ "Name": "Bob", "Age": 42 }""")
        |> Stdlib.Test.equal(Result.Ok(Person { Name = "Bob", Age = 42 }))

        Stdlib.Json.parse<MyPrettyLikely>("{\"Enh\":[\"printer broke\",7]}")
        |> Stdlib.Test.equal(
          Result.Ok(UserDefinedEnums.PrettyLikely.Enh("printer broke", 7))) ])


  type MyPerson = Person

  type MyPrettyLikely = UserDefinedEnums.PrettyLikely


  type Person1 =
    { Name: String
      Age: Int64 }


  type Person2 =
    { Name: String
      Age: Int64 }


  type StringResult<'a> = Result<'a, String>


  // This test currently slips by the typechecker, and so we get an internal
  // exception
  test rejects1 =
    Stdlib.Json.serialize<StringResult<Int64>>(Result.Error(1))
    => raises "Darklang.Stdlib.Json.serialize's 1st parameter `value` expects Darklang.Stdlib.Result.Result<Int64, String>, but got Darklang.Stdlib.Result.Result<_, Int64> (Error(1))"


module Package =
  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<LanguageTools.ID>(42) |> Stdlib.Test.equal("42")

        Stdlib.Json.serialize<LanguageTools.Sign>(LanguageTools.Sign.Positive)
        |> Stdlib.Test.equal("{\"Positive\":[]}") ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<LanguageTools.ID>("42")
        |> Stdlib.Test.equal(Result.Ok(42))

        Stdlib.Json.parse<LanguageTools.Sign>("{\"Positive\":[]}")
        |> Stdlib.Test.equal(Result.Ok(LanguageTools.Sign.Positive)) ])


// Nested lists, tuples, records and enums.
module RestoredArchive =
  type Counter =
    { v: Int64 }


  type NamedError =
    | InvalidPackageName(List<String>)
    | MissingEnumModuleName(String)
    | NotFound(List<String>)


  test enumWithListPayload =
    let value = NamedError.InvalidPackageName([ "NamePart" ])
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<NamedError>(value)
        |> Stdlib.Test.equal("{\"InvalidPackageName\":[[\"NamePart\"]]}")

        Stdlib.Json.parse<NamedError>("{\"NotFound\":[[\"NamePart\"]]}")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(NamedError.NotFound([ "NamePart" ]))) ])


  test listOfEnums =
    let value =
      [ NamedError.InvalidPackageName([ "NamePart" ])
        NamedError.MissingEnumModuleName("Ok")
        NamedError.NotFound([ "NamePart" ]) ]

    let encoded =
      "[{\"InvalidPackageName\":[[\"NamePart\"]]},{\"MissingEnumModuleName\":[\"Ok\"]},{\"NotFound\":[[\"NamePart\"]]}]"

    Stdlib.Test.all(
      [ Stdlib.Json.serialize<List<NamedError>>(value)
        |> Stdlib.Test.equal(encoded)

        Stdlib.Json.parse<List<NamedError>>(encoded)
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(value)) ])


  test rejectsMalformedJson =
    [ "{Id : 1.0}"
      "{Id : 1.}"
      "{\"Id\" : 1.}"
      ""
      "[ {date : \"2013-11-05\", locations : {Japan: 3, Germany: 1}} ]"
      "({id : 555, edition : \"First\", author : \"Dennis Ritchie\"})"
      "{id : 555, edition : \"First\", author : \"Dennis Ritchie\"}"
      "1,0/0,0"
      "''"
      "{3: false}"
      "{\"Id\" : Infinity }"
      "{\"Id\" : -Infinity }"
      "{\"Id\" : NaN }"
      "[ {\"date\" : \"2013-11-05\", locations : {Japan: 3, Germany: 1}} ]"
      "{\"id\" : 555, edition : \"First\", author : \"Dennis Ritchie\"}"
      "{\"id\" : 555, \"edition\" : 'First' }"
      "({\"id\" : 555, \"edition\" : \"First\", \"author\" : \"Dennis Ritchie\"})" ]
    |> Stdlib.List.map(fun text ->
      Stdlib.Json.parse<Int64>(text)
      |> err
      |> Stdlib.Result.mapError(fun m ->
        Stdlib.String.startsWith(m, "Not JSON at line "))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error(true)))
    |> Stdlib.Test.all


  // Where the text broke: the line and column of the first character that
  // isn't JSON, both counted from 1, the column in characters, not bytes
  test notJsonSaysWhere =
    let at = fun text ->
      match Stdlib.Json.parse<List<String>>(text) with
      | Error(NotJson(line, column)) ->
        Stdlib.Option.Option.Some((line, column))
      | _ -> Stdlib.Option.Option.None

    Stdlib.Test.all(
      [ at("x") |> Stdlib.Test.equal(Stdlib.Option.Option.Some((1, 1)))

        at("") |> Stdlib.Test.equal(Stdlib.Option.Option.Some((1, 1)))

        at("[\"a\", x]") |> Stdlib.Test.equal(Stdlib.Option.Option.Some((1, 7)))

        at("[\n  \"a\",\n  \"b\" \"c\"\n]")
        |> Stdlib.Test.equal(Stdlib.Option.Option.Some((3, 7)))

        at("[\r\n\"a\",\r\n x]")
        |> Stdlib.Test.equal(Stdlib.Option.Option.Some((3, 2)))

        at("[\"é🎉\", x]")
        |> Stdlib.Test.equal(Stdlib.Option.Option.Some((1, 8)))

        at("[\"a\"") |> Stdlib.Test.equal(Stdlib.Option.Option.Some((1, 5)))

        Stdlib.Json.parse<List<String>>("[\n1 2]")
        |> err
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Error("Not JSON at line 2, column 3")) ])


  test scalarAndLargeRecordValues =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Int64>("1")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

        Stdlib.Json.parse<String>("\"\"")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(""))

        Stdlib.Json.parse<Counter>("{ \"v\": 4611686018427387903 }")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(Counter { v = 4611686018427387903 }))

        Stdlib.Json.parse<Counter>("{ \"v\": 4611686018427387904 }")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(Counter { v = 4611686018427387904 })) ])


  test uint64ExactDecimalAndExponentForms =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<UInt64>("18446744073709551615.0")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(18446744073709551615u64))

        Stdlib.Json.parse<UInt64>("18446744073709551614.0")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(18446744073709551614u64))

        Stdlib.Json.parse<UInt64>("9007199254740993e0")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(9007199254740993u64)) ])


  test uint64RejectsOverflowAndRoundedFractions =
    [ "18446744073709551616.0"
      "1.8446744073709551616e19"
      "18446744073709551615.1"
      "-0.00000000000000000000001"
      "1e2000000000"
      "1e-2000000000" ]
    |> Stdlib.List.map(fun text ->
      Stdlib.Json.parse<UInt64>(text)
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          $"Can't parse JSON `{text}` as type `UInt64` at path: `root`")))
    |> Stdlib.Test.all


  test floatBoundariesAndPrecisionRoundTrip =
    [ 1.7976931348623157e308
      -1.7976931348623157e308
      0.
      0.
      -0.
      0.12345678901234568
      9007199254740992.0 ]
    |> Stdlib.List.map(fun value ->
      Stdlib.Json.serialize<Float64>(value)
      |> Stdlib.Json.parse<Float64>
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(value)))
    |> Stdlib.Test.all


  test deeplyNestedOptionsAndEnums =
    let value =
      Stdlib.Option.Option.Some(
        Stdlib.Option.Option.Some([ NamedError.NotFound([ "a", "b" ]) ]))

    Stdlib.Json.serialize<
      Stdlib.Option.Option<Stdlib.Option.Option<List<NamedError>>>>(value)
    |> Stdlib.Json.parse<
      Stdlib.Option.Option<Stdlib.Option.Option<List<NamedError>>>>
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(value))


/// `Net.Port`, `Http.Status`, `Cli.Posix.Pid` and `Cli.Posix.ExitCode` are bare numbers in
/// JSON, and parsing runs the same range check as their `fromInt64`.
module RangedInts =
  type Server =
    { port: Stdlib.Net.Port
      status: Stdlib.Http.Status }


  test serializeAsNumbers =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Stdlib.Net.Port>(Stdlib.Net.Port.httpAlt)
        |> Stdlib.Test.equal("8080")

        Stdlib.Json.serialize<Stdlib.Http.Status>(Stdlib.Http.Status.notFound)
        |> Stdlib.Test.equal("404")

        Stdlib.Json.serialize<Stdlib.Cli.Posix.ExitCode>(
          Stdlib.Cli.Posix.ExitCode.failure)
        |> Stdlib.Test.equal("1")

        Stdlib.Cli.Posix.Pid.fromInt64(4242)
        |> Stdlib.Result.map(fun p ->
          Stdlib.Json.serialize<Stdlib.Cli.Posix.Pid>(p))
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok("4242"))

        Stdlib.Json.serialize<Server>(
          Server
            { port = Stdlib.Net.Port.https, status = Stdlib.Http.Status.ok })
        |> Stdlib.Test.equal("{\"port\":443,\"status\":200}") ])


  test parseNumbers =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Stdlib.Net.Port>("8080")
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(Stdlib.Net.Port.httpAlt))

        Stdlib.Json.parse<Stdlib.Http.Status>("404.0")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(Stdlib.Http.Status.notFound))

        Stdlib.Json.parse<Stdlib.Cli.Posix.ExitCode>("0")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(Stdlib.Cli.Posix.ExitCode.success))

        Stdlib.Json.parse<Stdlib.Cli.Posix.Pid>("4242")
        |> Stdlib.Result.map(Stdlib.Cli.Posix.Pid.toInt64)
        |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(4242))

        Stdlib.Json.parse<Server>("{\"port\":443,\"status\":200}")
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(
            Server
              { port = Stdlib.Net.Port.https
                status = Stdlib.Http.Status.ok })) ])


  test roundTrip =
    let value =
      Server
        { port = Stdlib.Net.Port.http, status = Stdlib.Http.Status.created }

    Stdlib.Json.serialize<Server>(value)
    |> Stdlib.Json.parse<Server>
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(value))


  // Each type's ends and one past them, against its `fromInt64`: the F# range table has to
  // agree with the Dark one.
  test rangesMatchFromInt64 =
    Stdlib.Test.all(
      [ [ -1, 0, 65535, 65536 ]
        |> Stdlib.List.map(fun n ->
          Stdlib.Json.parse<Stdlib.Net.Port>(Stdlib.display(n))
          |> Stdlib.Result.isOk
          |> Stdlib.Test.equal(
            Stdlib.Net.Port.fromInt64(n) |> Stdlib.Result.isOk))

        [ 99, 100, 599, 600 ]
        |> Stdlib.List.map(fun n ->
          Stdlib.Json.parse<Stdlib.Http.Status>(Stdlib.display(n))
          |> Stdlib.Result.isOk
          |> Stdlib.Test.equal(
            Stdlib.Http.Status.fromInt64(n) |> Stdlib.Result.isOk))

        [ 0, 1, 2147483647, 2147483648 ]
        |> Stdlib.List.map(fun n ->
          Stdlib.Json.parse<Stdlib.Cli.Posix.Pid>(Stdlib.display(n))
          |> Stdlib.Result.isOk
          |> Stdlib.Test.equal(
            Stdlib.Cli.Posix.Pid.fromInt64(n) |> Stdlib.Result.isOk))

        [ -1, 0, 255, 256 ]
        |> Stdlib.List.map(fun n ->
          Stdlib.Json.parse<Stdlib.Cli.Posix.ExitCode>(Stdlib.display(n))
          |> Stdlib.Result.isOk
          |> Stdlib.Test.equal(
            Stdlib.Cli.Posix.ExitCode.fromInt64(n) |> Stdlib.Result.isOk)) ]
      |> Stdlib.List.flatten)


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<Server>("{\"port\":70000,\"status\":200}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON: 70000 is not a valid port (0 to 65535) at path: `root.port`"))

          Stdlib.Json.parse<Stdlib.Http.Status>("42")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON: 42 is not a valid HTTP status (100 to 599) at path: `root`"))

          Stdlib.Json.parse<Stdlib.Cli.Posix.ExitCode>("256")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON: 256 is not a valid exit code (0 to 255) at path: `root`"))

          Stdlib.Json.parse<Stdlib.Net.Port>("{\"__value\":80}")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{\"__value\":80}` as type `Darklang.Stdlib.Net.Port` at path: `root`"))

          Stdlib.Json.parse<Stdlib.Net.Port>("80.5")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `80.5` as type `Darklang.Stdlib.Net.Port` at path: `root`"))

          Stdlib.Json.parse<Stdlib.Net.Port>("\"80\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"80\"` as type `Darklang.Stdlib.Net.Port` at path: `root`")) ])


module Tree =
  type Reading =
    { host: String
      cpu: Stdlib.Option.Option<Float64>
      tags: List<String> }


  val reading =
    Reading
      { host = "a1", cpu = Stdlib.Option.Option.Some(38.5), tags = [ "x" ] }


  test toTree =
    Stdlib.Test.all(
      [ Stdlib.Json.toTree<Reading>(reading)
        |> Stdlib.Test.equal(
          Stdlib.AltJson.Json.Object(
            [ ("host", Stdlib.AltJson.Json.String("a1"))
              ("cpu", Stdlib.AltJson.Json.Float(38.5))
              (
                "tags",
                Stdlib.AltJson.Json.Array(
                  [ Stdlib.AltJson.Json.String("x") ])) ]))

        Stdlib.Json.toTreeWith<Reading>(
          Stdlib.Json.Options.Options
            { noneFields = Stdlib.Json.Options.NoneFields.Null },
          { reading with cpu = Stdlib.Option.Option.None })
        |> Stdlib.Test.equal(
          Stdlib.AltJson.Json.Object(
            [ ("host", Stdlib.AltJson.Json.String("a1"))
              ("cpu", Stdlib.AltJson.Json.Null)
              (
                "tags",
                Stdlib.AltJson.Json.Array(
                  [ Stdlib.AltJson.Json.String("x") ])) ]))

        Stdlib.Json.toTree<List<Option<Int64>>>([ Option.Some(1), Option.None ])
        |> Stdlib.Test.equal(
          Stdlib.AltJson.Json.Array(
            [ Stdlib.AltJson.Json.Integer(1), Stdlib.AltJson.Json.Null ]))

        Stdlib.Json.checkedToTree<Int64 -> Int64>(fun x -> x)
        |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))
        |> Stdlib.Test.equal(
          Result.Error("Cannot serialize a function into JSON")) ])


  test fromTree =
    Stdlib.Test.all(
      [ Stdlib.Json.fromTree<Reading>(Stdlib.Json.toTree<Reading>(reading))
        |> Stdlib.Test.equal(Result.Ok(reading))

        Stdlib.Json.fromTree<Reading>(
          Stdlib.AltJson.Json.Object(
            [ ("host", Stdlib.AltJson.Json.String("b2"))
              ("tags", Stdlib.AltJson.Json.Array([])) ]))
        |> Stdlib.Test.equal(
          Result.Ok(Reading { host = "b2", cpu = Option.None, tags = [] }))

        Stdlib.Json.fromTree<Reading>(Stdlib.AltJson.Json.Integer(1))
        |> err
        |> Stdlib.Test.equal(
          Result.Error(
            "Can't parse JSON `1` as type `Darklang.Stdlib.Json.Tests.Tree.Reading` at path: `root`")) ])


  /// Derive the default, then change what you need.
  test editTheTree =
    let renamed =
      match Stdlib.Json.toTree<Reading>(reading) with
      | Object(fields) ->
        Stdlib.AltJson.Json.Object(
          Stdlib.List.map(fields, fun((k, v)) ->
            if k == "host" then ("hostname", v) else (k, v)))
      | other -> other

    Stdlib.Json.serialize<Stdlib.AltJson.Json>(renamed)
    |> Stdlib.Test.equal("{\"hostname\":\"a1\",\"cpu\":38.5,\"tags\":[\"x\"]}")


module Traits =
  /// Written as `"21.5C"`, by its impls.
  type Celsius =
    { degreesC: Float64 }


  impl Stdlib.Json.ToJson for Celsius =
    let toJson(c: Celsius): Stdlib.AltJson.Json =
      Stdlib.AltJson.Json.String(Stdlib.display(c.degreesC) + "C")


  impl Stdlib.Json.FromJson for Celsius =
    let fromJson(
      json: Stdlib.AltJson.Json)
      : Stdlib.Result.Result<Celsius, String> =
      let refused =
        Stdlib.Result.Result.Error("expected a temperature like \"21.5C\"")

      match json with
      | String(s) when Stdlib.String.endsWith(s, "C") ->
        match Stdlib.Float64.parse(Stdlib.String.dropLast(s, 1)) with
        | Ok(degreesC) ->
          Stdlib.Result.Result.Ok(Celsius { degreesC = degreesC })
        | Error(_) -> refused
      | _ -> refused


  type Room =
    { name: String
      temp: Celsius
      history: List<Celsius>
      target: Stdlib.Option.Option<Celsius> }


  val room =
    Room
      { name = "lab"
        temp = Celsius { degreesC = 21.5 }
        history = [ Celsius { degreesC = 20.0 }, Celsius { degreesC = 19.5 } ]
        target = Stdlib.Option.Option.Some(Celsius { degreesC = 22.0 }) }


  val roomJson =
    "{\"name\":\"lab\",\"temp\":\"21.5C\",\"history\":[\"20.0C\",\"19.5C\"],\"target\":\"22.0C\"}"


  test serialize =
    Stdlib.Test.all(
      [ Stdlib.Json.serialize<Celsius>(Celsius { degreesC = 21.5 })
        |> Stdlib.Test.equal("\"21.5C\"")

        Stdlib.Json.serialize<Room>(room) |> Stdlib.Test.equal(roomJson)

        Stdlib.Json.checkedSerialize<Room>(room)
        |> Stdlib.Test.equal(Result.Ok(roomJson))

        Stdlib.Json.toTree<List<Celsius>>([ Celsius { degreesC = 1.0 } ])
        |> Stdlib.Test.equal(
          Stdlib.AltJson.Json.Array([ Stdlib.AltJson.Json.String("1.0C") ])) ])


  test parse =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Celsius>("\"21.5C\"")
        |> Stdlib.Test.equal(Result.Ok(Celsius { degreesC = 21.5 }))

        Stdlib.Json.parse<Room>(roomJson) |> Stdlib.Test.equal(Result.Ok(room))

        Stdlib.Json.parse<Room>(Stdlib.Json.serialize<Room>(room))
        |> Stdlib.Test.equal(Result.Ok(room))

        Stdlib.Json.parse<List<Celsius>>("[\"1C\",\"2C\",\"1C\"]")
        |> Stdlib.Test.equal(
          Result.Ok(
            [ Celsius { degreesC = 1.0 }
              Celsius { degreesC = 2.0 }
              Celsius { degreesC = 1.0 } ])) ])


  test parseErrors =
    Stdlib.Test.all(
      [ Stdlib.Json.parse<Room>(
          "{\"history\":[],\"name\":\"lab\",\"temp\":{\"degreesC\":21.5}}")
        |> err
        |> Stdlib.Test.equal(
          Result.Error(
            "Can't parse JSON: expected a temperature like \"21.5C\" at path: `root.temp`"))

        Stdlib.Json.parse<Room>(
          "{\"history\":[\"1C\",5],\"name\":\"lab\",\"temp\":\"1C\"}")
        |> err
        |> Stdlib.Test.equal(
          Result.Error(
            "Can't parse JSON: expected a temperature like \"21.5C\" at path: `root.history[1]`")) ])


// `Stdlib.AltJson.Json` as a parse target takes any JSON value, so mixed data needs no
// hand-written decoder; serialize writes it back as the same JSON.
module AnyJson =
  type Row =
    { name: String
      extra: Stdlib.AltJson.Json }


  test parseMixedValues =
    Stdlib.Json.parse<Dict<String, Stdlib.AltJson.Json>>(
      "{\"a\":1,\"b\":\"x\",\"c\":[true,null],\"d\":{\"e\":1.5}}")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(
        Dict { "a": Stdlib.AltJson.Json.Integer(1)
               "b": Stdlib.AltJson.Json.String("x")
               "c": Stdlib.AltJson.Json.Array(
                 [ Stdlib.AltJson.Json.Bool(true), Stdlib.AltJson.Json.Null ])
               "d": Stdlib.AltJson.Json.Object(
                 [ ("e", Stdlib.AltJson.Json.Float(1.5)) ]) }))


  test aRecordFieldOfAnyShape =
    Stdlib.Json.parse<List<Row>>(
      "[{\"name\":\"a\",\"extra\":7},{\"name\":\"b\",\"extra\":[\"x\"]}]")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(
        [ Row { name = "a", extra = Stdlib.AltJson.Json.Integer(7) }
          Row
            { name = "b"
              extra =
                Stdlib.AltJson.Json.Array(
                  [ Stdlib.AltJson.Json.String("x") ]) } ]))


  test serializeWritesTheJsonItHolds =
    let text = "[{\"n\":1,\"s\":\"x\",\"o\":{\"z\":null,\"a\":[1.5,false]}}]"
    Stdlib.Json.parse<List<Stdlib.AltJson.Json>>(text)
    |> Stdlib.Result.map(fun v ->
      Stdlib.Json.serialize<List<Stdlib.AltJson.Json>>(v))
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(text))
