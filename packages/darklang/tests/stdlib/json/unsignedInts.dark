module Darklang.Stdlib.Json.Tests

module UInt64 =
  module Basic =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt64>(12345u64)
          |> Stdlib.Test.equal("12345") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt64>("0.0") |> Stdlib.Test.equal(Result.Ok(0u64))

          Stdlib.Json.parse<UInt64>("1.2E2")
          |> Stdlib.Test.equal(Result.Ok(120u64))

          Stdlib.Json.parse<UInt64>("1.2E+2")
          |> Stdlib.Test.equal(Result.Ok(120u64))

          Stdlib.Json.parse<UInt64>("1200E-1")
          |> Stdlib.Test.equal(Result.Ok(120u64)) ])


  module UInt64Limits =
    // test the limits of uint64 (0 to 18446744073709551615)
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt64>(0u64) |> Stdlib.Test.equal("0")

          Stdlib.Json.serialize<UInt64>(18446744073709551615u64)
          |> Stdlib.Test.equal("18446744073709551615") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt64>("0") |> Stdlib.Test.equal(Result.Ok(0u64))

          Stdlib.Json.parse<UInt64>("18446744073709551615")
          |> Stdlib.Test.equal(Result.Ok(18446744073709551615u64)) ])


    // First number that doesn't fit in an int64
    // A floating-point number in the UInt64 range can parse as UInt64.
    test rejectsFirstOverflow =
      Stdlib.Json.parse<UInt64>("18446744073709551616")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON `18446744073709551616` as type `UInt64` at path: `root`"))


    test parsesScientificMaximum =
      Stdlib.Json.parse<UInt64>("1.8446744073709551615E19")
      |> Stdlib.Test.equal(Result.Ok(18446744073709551615u64))


    test parseErrors =
      // This is a float that is slightly above the uint64 max
      Stdlib.Json.parse<UInt64>("1.9E19")
      |> err
      |> Stdlib.Test.equal(
        Result.Error(
          "Can't parse JSON `1.9E19` as type `UInt64` at path: `root`"))


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt64>(" ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt64>("4a")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt64>("- 42")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt64>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("true")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `true` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("false")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `false` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("\"42\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"42\"` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("[42]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[42]` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("{ \"key\": 42 }")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("42.5")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `42.5` as type `UInt64` at path: `root`"))

          Stdlib.Json.parse<UInt64>("\"42\n\"")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4")) ])


module UInt8 =
  module Basic =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt8>(1u8) |> Stdlib.Test.equal("1")
          Stdlib.Json.serialize<UInt8>(123u8) |> Stdlib.Test.equal("123")
          Stdlib.Json.serialize<UInt8>(254u8) |> Stdlib.Test.equal("254") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt8>("0.0") |> Stdlib.Test.equal(Result.Ok(0u8))

          Stdlib.Json.parse<UInt8>("-0.0") |> Stdlib.Test.equal(Result.Ok(0u8))

          Stdlib.Json.parse<UInt8>("1.2E2")
          |> Stdlib.Test.equal(Result.Ok(120u8))

          Stdlib.Json.parse<UInt8>("1.2E+2")
          |> Stdlib.Test.equal(Result.Ok(120u8))

          Stdlib.Json.parse<UInt8>("1200E-1")
          |> Stdlib.Test.equal(Result.Ok(120u8)) ])


  module UInt8Limits =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt8>(0u8) |> Stdlib.Test.equal("0")
          Stdlib.Json.serialize<UInt8>(255u8) |> Stdlib.Test.equal("255") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt8>("0") |> Stdlib.Test.equal(Result.Ok(0u8))
          Stdlib.Json.parse<UInt8>("255")
          |> Stdlib.Test.equal(Result.Ok(255u8)) ])


    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt8>("-1")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `-1` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("256")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `256` as type `UInt8` at path: `root`")) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt8>(" ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt8>("4a")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt8>("- 42")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt8>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("true")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `true` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("false")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `false` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("\"42\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"42\"` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("[42]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[42]` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("{ \"key\": 42 }")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("42.5")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `42.5` as type `UInt8` at path: `root`"))

          Stdlib.Json.parse<UInt8>("\"42\n\"")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4")) ])


module UInt16 =
  module Basic =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt16>(123u16) |> Stdlib.Test.equal("123") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt16>("0.0") |> Stdlib.Test.equal(Result.Ok(0u16))

          Stdlib.Json.parse<UInt16>("1.2E2")
          |> Stdlib.Test.equal(Result.Ok(120u16))

          Stdlib.Json.parse<UInt16>("1.2E+2")
          |> Stdlib.Test.equal(Result.Ok(120u16))

          Stdlib.Json.parse<UInt16>("1200E-1")
          |> Stdlib.Test.equal(Result.Ok(120u16)) ])


  module UInt16Limits =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt16>(0u16) |> Stdlib.Test.equal("0")
          Stdlib.Json.serialize<UInt16>(65535u16)
          |> Stdlib.Test.equal("65535") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt16>("0") |> Stdlib.Test.equal(Result.Ok(0u16))

          Stdlib.Json.parse<UInt16>("65535")
          |> Stdlib.Test.equal(Result.Ok(65535u16)) ])


    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt16>("-1")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `-1` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("65536")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `65536` as type `UInt16` at path: `root`")) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt16>(" ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt16>("4a")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt16>("- 42")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt16>("\"42\n\"")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4"))

          Stdlib.Json.parse<UInt16>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("true")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `true` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("false")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `false` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("\"42\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"42\"` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("[42]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[42]` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("{ \"key\": 42 }")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt16` at path: `root`"))

          Stdlib.Json.parse<UInt16>("42.5")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `42.5` as type `UInt16` at path: `root`")) ])


