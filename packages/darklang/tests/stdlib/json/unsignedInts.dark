module UInt128 =
  module Basic =
    test serialize =
      Stdlib.Test.all(
        [ Stdlib.Json.serialize<UInt128>(12345u128)
          |> Stdlib.Test.equal("12345") ])


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt128>("0") |> Stdlib.Test.equal(Result.Ok(0u128))

          Stdlib.Json.parse<UInt128>("0.0")
          |> Stdlib.Test.equal(Result.Ok(0u128))

          Stdlib.Json.parse<UInt128>("-0.0")
          |> Stdlib.Test.equal(Result.Ok(0u128))

          Stdlib.Json.parse<UInt128>("1.2E2")
          |> Stdlib.Test.equal(Result.Ok(120u128))

          Stdlib.Json.parse<UInt128>("1.2E+2")
          |> Stdlib.Test.equal(Result.Ok(120u128))

          Stdlib.Json.parse<UInt128>("1200E-1")
          |> Stdlib.Test.equal(Result.Ok(120u128)) ])


  module UInt128Limits =
    // First number that doesn't fit in a UInt128
    test serialize =
      Stdlib.Json.serialize<UInt128>(0u128) |> Stdlib.Test.equal("0")


    test parse =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt128>("340282366920938463463374607431768211455")
          |> Stdlib.Test.equal(
            Result.Ok(340282366920938463463374607431768211455u128))

          // This is a large number that is a valid UInt128
          Stdlib.Json.parse<UInt128>("3.4E38")
          |> Stdlib.Test.equal(
            Result.Ok(340000000000000000000000000000000000000u128)) ])


    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt128>("340282366920938463463374607431768211456")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `340282366920938463463374607431768211456` as type `UInt128` at path: `root`"))

          // This is a number that is slightly above the UInt128 max
          Stdlib.Json.parse<UInt128>("3.5E38")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `3.5E38` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("-1")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `-1` as type `UInt128` at path: `root`")) ])


  module Errors =
    test parseErrors =
      Stdlib.Test.all(
        [ Stdlib.Json.parse<UInt128>(" ")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt128>("4a")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt128>("- 42")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 2"))

          Stdlib.Json.parse<UInt128>("null")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `null` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("true")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `true` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("false")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `false` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("\"42\"")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `\"42\"` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("[42]")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `[42]` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("{ \"key\": 42 }")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `{ \"key\": 42 }` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("42.5")
          |> err
          |> Stdlib.Test.equal(
            Result.Error(
              "Can't parse JSON `42.5` as type `UInt128` at path: `root`"))

          Stdlib.Json.parse<UInt128>("\"42\n\"")
          |> err
          |> Stdlib.Test.equal(Result.Error("Not JSON at line 1, column 4")) ])
