module Darklang.Stdlib.Codepoint.Tests

test scalarBoundaries =
  Stdlib.Test.all(
    [ Stdlib.Codepoint.isValidScalar(0) |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(255) |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(55295) |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(55296) |> Stdlib.Test.equal(false)

      Stdlib.Codepoint.isValidScalar(57343) |> Stdlib.Test.equal(false)

      Stdlib.Codepoint.isValidScalar(57344) |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(1114111) |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(Stdlib.Codepoint.max())
      |> Stdlib.Test.equal(true)

      Stdlib.Codepoint.isValidScalar(1114112) |> Stdlib.Test.equal(false)

      Stdlib.Codepoint.isValidScalar(4294967295) |> Stdlib.Test.equal(false)

      // U+0378 is unassigned, but a valid scalar and constructor input.
      Stdlib.Codepoint.isValidScalar(888) |> Stdlib.Test.equal(true)

      Stdlib.Char.fromCodepoint(888)
      |> Stdlib.Option.andThen(Stdlib.Char.toCodepoint)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(888)) ])


test fromInt64 =
  Stdlib.Test.all(
    [ Stdlib.Codepoint.fromInt64(0)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Codepoint.fromInt64(255)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(255))

      Stdlib.Codepoint.fromInt64(1114111)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(1114111))

      Stdlib.Codepoint.fromInt64(55296)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Codepoint.fromInt64(1114112)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Codepoint.fromInt64(-1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Codepoint.fromInt64(4294967296)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test properties =
  Stdlib.Test.all(
    [ Stdlib.Codepoint.isLetter(233) |> Stdlib.Test.equal(true)
      Stdlib.Codepoint.isAlphanumeric(1639) |> Stdlib.Test.equal(true)
      Stdlib.Codepoint.isWhitespace(8195) |> Stdlib.Test.equal(true)
      Stdlib.Codepoint.isLetter(888) |> Stdlib.Test.equal(false)
      Stdlib.Codepoint.isLetter(55296) |> Stdlib.Test.equal(false)
      Stdlib.Codepoint.isWhitespace(1114112) |> Stdlib.Test.equal(false)
      Stdlib.Codepoint.isAlphanumeric(4294967295) |> Stdlib.Test.equal(false) ])
