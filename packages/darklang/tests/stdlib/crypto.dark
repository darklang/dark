// Stdlib.Crypto — all hashes take and return Bytes. Use
// `Stdlib.Utf8.encode` to build an input from a string and
// `Stdlib.Hex.encode` to render the digest.
module Darklang.Stdlib.Crypto.Tests

test digests =
  let empty = Stdlib.Utf8.encode("")
  let longer = Stdlib.Utf8.encode("a longer string that's more interesting")
  Stdlib.Test.all(
    [ empty |> Stdlib.Crypto.md5 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("D41D8CD98F00B204E9800998ECF8427E")
      empty |> Stdlib.Crypto.sha256 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855")
      empty |> Stdlib.Crypto.sha384 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("38B060A751AC96384CD9327EB1B1E36A21FDB71114BE07434C0CC7BF63F6E1DA274EDEBFE76F65FBD51AD2F14898B95B")
      longer |> Stdlib.Crypto.md5 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("D95E619F023B430CAAAEB6778A0B9BD1")
      longer |> Stdlib.Crypto.sha256 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("1316F78627BC453D44D27E3133902CF798859572E814EED4B5FB56BB1447F05F")
      longer |> Stdlib.Crypto.sha384 |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("AD7273EF514770D80B516D067354CB300FE458C042CE084EC97125718678C3C21415FE224658839963F0B2D90137AA7B") ])

// sha256hmac
test sha256hmac =
  let secret = Stdlib.Utf8.encode("AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
  let data = Stdlib.Utf8.encode("20150830")
  Stdlib.Crypto.sha256hmac(secret, data)
  |> Stdlib.Hex.encode
  |> Stdlib.Test.equal("0138C7A6CBD60AA727B2F653A522567439DFB9F3E72B21F9B25941A42F04A7CD")

// sha1hmac
test sha1hmac =
  let secret = Stdlib.Utf8.encode("AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
  let data = Stdlib.Utf8.encode("20150830")
  Stdlib.Crypto.sha1hmac(secret, data)
  |> Stdlib.Hex.encode
  |> Stdlib.Test.equal("0932CB57FE685FEBC66657AA30C7568A4AB05CAF")

// aws
test awsSigningChain =
  let scope = "20150830/us-east-1/iam/aws4_request"
  let content = "f536975d06c0309214f805bb90ccff089219ecd68b2577efef23edd43b7e1a59"
  let strs = [ "AWS4-HMAC-SHA256", "20150830T123600Z", scope, content ]
  let strToSign = Stdlib.String.join(strs, Stdlib.String.newline)
  let secret = Stdlib.Utf8.encode("AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
  let date = Stdlib.Crypto.sha256hmac(secret, Stdlib.Utf8.encode("20150830"))
  let region = Stdlib.Crypto.sha256hmac(date, Stdlib.Utf8.encode("us-east-1"))
  let service = Stdlib.Crypto.sha256hmac(region, Stdlib.Utf8.encode("iam"))
  let signing = Stdlib.Crypto.sha256hmac(service, Stdlib.Utf8.encode("aws4_request"))
  Stdlib.Crypto.sha256hmac(signing, Stdlib.Utf8.encode(strToSign))
  |> Stdlib.Hex.encode
  |> Stdlib.String.toLowercase
  |> Stdlib.Test.equal("5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7")

test digestText =
  Stdlib.Test.all(
    [ Stdlib.Crypto.digestText("")

     |> Stdlib.Test.equal("OLBgp1GsljhM2TJ-sbHjaiH9txEUvgdDTAzHv2P24donTt6_529l-9Ua0vFImLlb")
      Stdlib.Crypto.digestText("😄")

     |> Stdlib.Test.equal("Z2Y7YuyYHR9miKrg6mLtxSTaHRpGZuaenmGQl3QFY58pwhPCK2bIYxJQ728ChJwA")
      Stdlib.Crypto.digestText("ελπίδα")

     |> Stdlib.Test.equal("j4uJEeBe6g8QrzbuxoI2roUgapGQiExE8CWEQqZao61eZVN1iSZ8cV39IM1nGqsa")
      Stdlib.Crypto.digestText("/*-+(&@98521")

     |> Stdlib.Test.equal("wSGXFkLMpPufNoF2mUBAjT4YlUEb9cl0Iliy4qohwt1XFpg51PRJVTWndn5PewSr")
      Stdlib.Crypto.digestText("👩🏻‍🚀🍇")

     |> Stdlib.Test.equal("hVrNUSbFOfYXwZe6zQRUFFfGPe90qr-aROG2n-hMk8kAC-xodOyHOqecLWb9HIKJ")
      Stdlib.Crypto.digestText("🧑🏽‍🦰🧑🏼‍💻🧑🏻‍🍼✋✋🏻✋🏿")

     |> Stdlib.Test.equal("7Fo0ImavUzoUM_9kdjucgh6pYAHk5VovpTOUObvxacS31QoCTkcE4rpcQbJJpshE")
      Stdlib.Crypto.digestText("﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽")

     |> Stdlib.Test.equal("U2v72uGbUR_UIiD5qF6L21pKzYi4B6OB76HGtbpM0o-2_4YB3ytPjJ7w9png3L9k")
      Stdlib.Crypto.digestText("👱👱🏻👱🏼👱🏽👱🏾👱🏿")

     |> Stdlib.Test.equal("c1Wm67axXlBaejcJZxct80MvexdTtyyrTK9J9-_4RqgP1pf4Bk9SoMZpsnXpvLIx")
      Stdlib.Crypto.digestText("🧟‍♀️🧟‍♂️")

     |> Stdlib.Test.equal("FBnrDureCzgPeGP9qOuW1BIiF2Wz5WejO5XtJWa81qCxcD6cZ4A_WAB0ZJzhOErc")
      Stdlib.Crypto.digestText("👨‍❤️‍💋‍👨👩‍👩‍👧‍👦🏳️‍⚧️‍️🇵🇷")

     |> Stdlib.Test.equal("3QFqrhTPpxeje6XUNObFt2eJZZ1t0pAcX42AFdFVv42hco0bTOopQK3py4KMBT0m") ])

// Preserve the original two-call comparison independently of the sample test.

let hex(s: String): Bytes = s |> Stdlib.Hex.decode |> Builtin.unwrap

// Published vectors (FIPS 180, RFC 1321) for every algorithm, through the shared builtin and through
// each named wrapper.
test digestKnownVectors =
  let abc = Stdlib.Utf8.encode("abc")
  let empty = Stdlib.Utf8.encode("")
  Stdlib.Test.all(
    [ Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Md5, abc) |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("900150983CD24FB0D6963F7D28E17F72")
      Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha1, abc) |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("A9993E364706816ABA3E25717850C26C9CD0D89D")
      Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha1, empty) |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("DA39A3EE5E6B4B0D3255BFEF95601890AFD80709")
      Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha256, abc) |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD")
      Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha384, abc) |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("CB00753F45A35E8BB5A03D699AC65007272C32AB0EDED1631A8B605A43FF5BED8086072BA1E7CC2358BAECA134C825A7")
      Stdlib.Crypto.md5(abc) |> Stdlib.Test.equal(Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Md5, abc))
      Stdlib.Crypto.sha256(abc) |> Stdlib.Test.equal(Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha256, abc))
      Stdlib.Crypto.sha384(abc) |> Stdlib.Test.equal(Stdlib.Crypto.digest(Stdlib.Crypto.DigestAlgorithm.Sha384, abc)) ])

// Every HMAC-SHA1 test case in RFC 2202 (case 5 compares the full digest the RFC also publishes).
test sha1hmacRfc2202 =
  Stdlib.Test.all(
    [ Stdlib.Crypto.sha1hmac(hex("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B"), hex("4869205468657265"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("B617318655057264E28BC0B6FB378C8EF146BE00")
      Stdlib.Crypto.sha1hmac(hex("4A656665"), hex("7768617420646F2079612077616E7420666F72206E6F7468696E673F"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("EFFCDF6AE5EB2FA2D27416D5F184DF9C259A7C79")
      Stdlib.Crypto.sha1hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("125D7342B9AC11CD91A39AF48AA17B4F63F175D3")
      Stdlib.Crypto.sha1hmac(hex("0102030405060708090A0B0C0D0E0F10111213141516171819"), hex("CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("4C9007F4026250C6BC8414F9BF50C86C2D7235DA")
      Stdlib.Crypto.sha1hmac(hex("0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C"), hex("546573742057697468205472756E636174696F6E"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("4C1A03424B55E07FE7F27BE1D58BB9324A9A5A04")
      Stdlib.Crypto.sha1hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("AA4AE5E15272D00E95705637CE8A3B55ED402112")
      Stdlib.Crypto.sha1hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B657920616E64204C6172676572205468616E204F6E6520426C6F636B2D53697A652044617461"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("E8E99D0F45237D786D6BBAA7965C7808BBFF1A91") ])

// Every HMAC-SHA256 test case in RFC 4231 (case 5 compares the full digest; the RFC prints its first 16 bytes).
test sha256hmacRfc4231 =
  Stdlib.Test.all(
    [ Stdlib.Crypto.sha256hmac(hex("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B"), hex("4869205468657265"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("B0344C61D8DB38535CA8AFCEAF0BF12B881DC200C9833DA726E9376C2E32CFF7")
      Stdlib.Crypto.sha256hmac(hex("4A656665"), hex("7768617420646F2079612077616E7420666F72206E6F7468696E673F"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("5BDCC146BF60754E6A042426089575C75A003F089D2739839DEC58B964EC3843")
      Stdlib.Crypto.sha256hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("773EA91E36800E46854DB8EBD09181A72959098B3EF8C122D9635514CED565FE")
      Stdlib.Crypto.sha256hmac(hex("0102030405060708090A0B0C0D0E0F10111213141516171819"), hex("CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("82558A389A443C0EA4CC819899F2083A85F0FAA3E578F8077A2E3FF46729665B")
      Stdlib.Crypto.sha256hmac(hex("0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C"), hex("546573742057697468205472756E636174696F6E"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("A3B6167473100EE06E0C796C2955552BFA6F7C0A6A8AEF8B93F860AAB0CD20C5")
      Stdlib.Crypto.sha256hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("60E431591EE0B67F0D8A26AACBF5B77F8E0BC6213728C5140546040F0EE37F54")
      Stdlib.Crypto.sha256hmac(hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex(""))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("9B09FFA71B942FCB27635FBCD5B0E944BFDC63644F0713938A7F51535C3A35E2") ])

// Every HMAC-MD5 test case in RFC 2202, through the shared builtin.
test hmacMd5Rfc2202 =
  Stdlib.Test.all(
    [ Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B"), hex("4869205468657265"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("9294727A3638BB1C13F48EF8158BFC9D")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("4A656665"), hex("7768617420646F2079612077616E7420666F72206E6F7468696E673F"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("750C783E6AB0B503EAA86E310A5DB738")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("56BE34521D144C88DBB8C733F0E8B3F6")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("0102030405060708090A0B0C0D0E0F10111213141516171819"), hex("CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("697EAF0ACA3A3AEA3A75164746FFAA79")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C"), hex("546573742057697468205472756E636174696F6E"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("56461EF2342EDC00F9BAB995690EFD4C")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("6B1AB7FE4BD7BF8F0B62E6CE61B9D0CD")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Md5, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B657920616E64204C6172676572205468616E204F6E6520426C6F636B2D53697A652044617461"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("6F630FAD67CDA0EE1FB1F562DB3AA53E") ])

// Every HMAC-SHA384 test case in RFC 4231 (case 5 in full), through the shared builtin.
test hmacSha384Rfc4231 =
  Stdlib.Test.all(
    [ Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B0B"), hex("4869205468657265"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("AFD03944D84895626B0825F4AB46907F15F9DADBE4101EC682AA034C7CEBC59CFAEA9EA9076EDE7F4AF152E8B2FA9CB6")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("4A656665"), hex("7768617420646F2079612077616E7420666F72206E6F7468696E673F"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("AF45D2E376484031617F78D2B58A6B1B9C7EF464F5A01B47E42EC3736322445E8E2240CA5E69E2C78B3239ECFAB21649")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("88062608D3E6AD8A0AA2ACE014C8A86F0AA635D947AC9FEBE83EF4E55966144B2A5AB39DC13814B94E3AB6E101A34F27")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("0102030405060708090A0B0C0D0E0F10111213141516171819"), hex("CDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCDCD"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("3E8A69B7783C25851933AB6290AF6CA77A9981480850009CC5577C6E1F573B4E6801DD23C4A7D679CCF8A386C674CFFB")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C0C"), hex("546573742057697468205472756E636174696F6E"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("3ABF34C3503B2A23A46EFC619BAEF897F4C8E42C934CE55CCBAE9740FCBC1AF4CA62269E2A37CD88BA926341EFE4AEEA")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex("54657374205573696E67204C6172676572205468616E20426C6F636B2D53697A65204B6579202D2048617368204B6579204669727374"))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("4ECE084485813E9088D2C63A041BC5B44F9EF1012A2B588F3CD11F05033AC4C60C2EF6AB4030FE8296248DF163F44952")
      Stdlib.Crypto.hmac(Stdlib.Crypto.DigestAlgorithm.Sha384, hex("AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), hex(""))
      |> Stdlib.Hex.encode
      |> Stdlib.Test.equal("6617178E941F020D351E2F254E8FD32C602420FEB0B8FB9ADCCEBB82461E99C5A678CC31E799176D3860E6110C46523E") ])
