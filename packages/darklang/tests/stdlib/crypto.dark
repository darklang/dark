/// Digest cases from `backend/testfiles/execution/stdlib/crypto.dark`.
// Stdlib.Crypto — all hashes take and return Blob. Use
// `Stdlib.Blob.fromString` to build an input from a string and
// `Stdlib.Blob.toHex` to render the digest.
module Darklang.Stdlib.Crypto.Tests

// Differs from legacy: the two inputs are bound once; legacy built each inline.
test digests =
  let empty = Stdlib.Blob.fromString ""
  let longer = Stdlib.Blob.fromString "a longer string that's more interesting"
  Stdlib.Test.all
    [ empty |> Stdlib.Crypto.md5 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "D41D8CD98F00B204E9800998ECF8427E"
      empty |> Stdlib.Crypto.sha256 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855"
      empty |> Stdlib.Crypto.sha384 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "38B060A751AC96384CD9327EB1B1E36A21FDB71114BE07434C0CC7BF63F6E1DA274EDEBFE76F65FBD51AD2F14898B95B"
      longer |> Stdlib.Crypto.md5 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "D95E619F023B430CAAAEB6778A0B9BD1"
      longer |> Stdlib.Crypto.sha256 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "1316F78627BC453D44D27E3133902CF798859572E814EED4B5FB56BB1447F05F"
      longer |> Stdlib.Crypto.sha384 |> Stdlib.Blob.toHex
      |> Stdlib.Test.equal "AD7273EF514770D80B516D067354CB300FE458C042CE084EC97125718678C3C21415FE224658839963F0B2D90137AA7B" ]

// sha256hmac
test sha256hmac =
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let data = Stdlib.Blob.fromString "20150830"
  Stdlib.Crypto.sha256hmac secret data
  |> Stdlib.Blob.toHex
  |> Stdlib.Test.equal "0138C7A6CBD60AA727B2F653A522567439DFB9F3E72B21F9B25941A42F04A7CD"

// sha1hmac
test sha1hmac =
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let data = Stdlib.Blob.fromString "20150830"
  Stdlib.Crypto.sha1hmac secret data
  |> Stdlib.Blob.toHex
  |> Stdlib.Test.equal "0932CB57FE685FEBC66657AA30C7568A4AB05CAF"

// aws
// Differs from legacy: `data` is inlined into the first HMAC; same chain and output.
test awsSigningChain =
  let scope = "20150830/us-east-1/iam/aws4_request"
  let content = "f536975d06c0309214f805bb90ccff089219ecd68b2577efef23edd43b7e1a59"
  let strs = [ "AWS4-HMAC-SHA256", "20150830T123600Z", scope, content ]
  let strToSign = Stdlib.String.join strs Stdlib.String.newline
  let secret = Stdlib.Blob.fromString "AWS4wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"
  let date = Stdlib.Crypto.sha256hmac secret (Stdlib.Blob.fromString "20150830")
  let region = Stdlib.Crypto.sha256hmac date (Stdlib.Blob.fromString "us-east-1")
  let service = Stdlib.Crypto.sha256hmac region (Stdlib.Blob.fromString "iam")
  let signing = Stdlib.Crypto.sha256hmac service (Stdlib.Blob.fromString "aws4_request")
  Stdlib.Crypto.sha256hmac signing (Stdlib.Blob.fromString strToSign)
  |> Stdlib.Blob.toHex
  |> Stdlib.String.toLowercase
  |> Stdlib.Test.equal "5d672d79c15b13162d9279b0855cfba6789a8edb4c82c400e06b5924a6f2b5d7"
