module Darklang.Stdlib.Option.Tests

test display =
  Stdlib.Test.all(
    [ Stdlib.display(Stdlib.Option.Option.Some(3))
      |> Stdlib.Test.equal("Some(3)")

      Stdlib.display<Option<Int64>>(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal("None")

      Stdlib.Option.Option.Some("Bob")
      |> (fun maybeName -> $"name: {maybeName}")
      |> Stdlib.Test.equal("name: Some(\"Bob\")")

      (Stdlib.Option.Option.Some(3)).display |> Stdlib.Test.equal("Some(3)")

      Stdlib.display(Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(true)))
      |> Stdlib.Test.equal("Some(Some(true))")

      Stdlib.display(Stdlib.Option.Option.Some([ 1 ]))
      |> Stdlib.Test.equal(Stdlib.inspect(Stdlib.Option.Option.Some([ 1 ]))) ])


test andThen =
  Stdlib.Test.all(
    [ Stdlib.Option.andThen(Stdlib.Option.Option.Some(5), fun x ->
        Stdlib.Option.Option.Some(1 + x))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(6))

      Stdlib.Option.andThen(Stdlib.Option.Option.Some(5), fun _ ->
        Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen(Stdlib.Option.Option.None, fun _ ->
        Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen(Stdlib.Option.Option.None, fun _ ->
        Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen(Stdlib.Option.Option.Some(8), fun x ->
        Stdlib.Option.Option.Some(x / 2))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4)) ])


test andThenPropagatesRuntimeErrors =
  Stdlib.Option.andThen(Stdlib.Option.Option.Some(8), fun x ->
    Stdlib.Option.Option.Some(x / 0))
  => raises "Cannot divide by 0"


test andThen2 =
  Stdlib.Test.all(
    [ Stdlib.Option.andThen2(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        fun(x, y) -> Stdlib.Option.Option.Some(x + y))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(11))

      Stdlib.Option.andThen2(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.None,
        fun(x, y) -> Stdlib.Option.Option.Some(x + y))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen2(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(6),
        fun(x, y) -> Stdlib.Option.Option.Some(x + y))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen2(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(x, y) -> Stdlib.Option.Option.Some(x + y))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test andThen3 =
  Stdlib.Test.all(
    [ Stdlib.Option.andThen3(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(7),
        fun(x, y, z) -> Stdlib.Option.Option.Some(x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(18))

      Stdlib.Option.andThen3(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(7),
        fun(x, y, z) -> Stdlib.Option.Option.Some(x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen3(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(7),
        fun(x, y, z) -> Stdlib.Option.Option.Some(x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen3(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.None,
        fun(x, y, z) -> Stdlib.Option.Option.Some(x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen3(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(x, y, z) -> Stdlib.Option.Option.Some(x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test andThen4 =
  Stdlib.Test.all(
    [ Stdlib.Option.andThen4(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(7),
        Stdlib.Option.Option.Some(8),
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(26))

      Stdlib.Option.andThen4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(7),
        Stdlib.Option.Option.Some(8),
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen4(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(7),
        Stdlib.Option.Option.Some(8),
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen4(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(8),
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen4(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(7),
        Stdlib.Option.Option.None,
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.andThen4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(w, x, y, z) -> Stdlib.Option.Option.Some(w + x + y + z))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test map =
  Stdlib.Test.all(
    [ Stdlib.Option.map(Stdlib.Option.Option.Some(4), fun x -> x / 2)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(2))

      Stdlib.Option.map(Stdlib.Option.Option.None, fun x -> x / 2)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test map2 =
  Stdlib.Test.all(
    [ Stdlib.Option.map2(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.Some(1),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(9))

      Stdlib.Option.map2(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.None,
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map2(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(1),
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map2(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(x, y) -> x - y)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test map3 =
  Stdlib.Test.all(
    [ Stdlib.Option.map3(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.Some(1),
        Stdlib.Option.Option.Some(2),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(7))

      Stdlib.Option.map3(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(2),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map3(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(1),
        Stdlib.Option.Option.Some(2),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map3(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(2),
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map3(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(x, y, z) -> x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test map4 =
  Stdlib.Test.all(
    [ Stdlib.Option.map4(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.Some(1),
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(4))

      Stdlib.Option.map4(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(1),
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(3),
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map4(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(w, x, y, z) -> w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test map5 =
  Stdlib.Test.all(
    [ Stdlib.Option.map5(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.Some(1),
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        Stdlib.Option.Option.Some(4),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(0))

      Stdlib.Option.map5(
        Stdlib.Option.Option.Some(10),
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.Some(2),
        Stdlib.Option.Option.Some(3),
        Stdlib.Option.Option.Some(4),
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.map5(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun(v, w, x, y, z) -> v - w - x - y - z)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test mapWithDefault =
  Stdlib.Test.all(
    [ Stdlib.Option.mapWithDefault(Stdlib.Option.Option.Some(5), 6, fun x ->
        x + 1)
      |> Stdlib.Test.equal(6)

      Stdlib.Option.mapWithDefault(Stdlib.Option.Option.None, 6, fun x -> x + 1)
      |> Stdlib.Test.equal(6)

      Stdlib.Option.mapWithDefault(
        Stdlib.Option.Option.Some(5),
        Stdlib.Option.Option.None,
        fun x -> x + 1)
      |> Stdlib.Test.equal(6)

      Stdlib.Option.mapWithDefault(
        Stdlib.Option.Option.None,
        Stdlib.Option.Option.None,
        fun x -> x + 1)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test withDefault =
  Stdlib.Test.all(
    [ Stdlib.Option.withDefault(Stdlib.Option.Option.Some(6), 5)
      |> Stdlib.Test.equal(6)

      Stdlib.Option.withDefault(Stdlib.Option.Option.None, 5)
      |> Stdlib.Test.equal(5) ])


test isSome =
  Stdlib.Test.all(
    [ Stdlib.Option.isSome(Stdlib.Option.Option.Some(6))
      |> Stdlib.Test.equal(true)

      Stdlib.Option.isSome(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(false) ])


test isNone =
  Stdlib.Test.all(
    [ Stdlib.Option.isNone(Stdlib.Option.Option.Some(6))
      |> Stdlib.Test.equal(false)

      Stdlib.Option.isNone(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(true) ])


test toResult =
  Stdlib.Test.all(
    [ Stdlib.Option.toResult(Stdlib.Option.Option.Some(6), 5)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(6))

      Stdlib.Option.toResult(Stdlib.Option.Option.None, "error")
      |> Stdlib.Test.equal(Stdlib.Result.Result.Error("error")) ])


test toList =
  Stdlib.Test.all(
    [ Stdlib.Option.toList(Stdlib.Option.Option.Some(6))
      |> Stdlib.Test.equal([ 6 ])

      Stdlib.Option.toList(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal([]) ])


test and =
  Stdlib.Test.all(
    [ Stdlib.Option.and(
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(5))

      Stdlib.Option.and(Stdlib.Option.Option.Some(6), Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.and(Stdlib.Option.Option.None, Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.and(Stdlib.Option.Option.None, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test or =
  Stdlib.Test.all(
    [ Stdlib.Option.or(
        Stdlib.Option.Option.Some(6),
        Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(6))

      Stdlib.Option.or(Stdlib.Option.Option.Some(6), Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(6))

      Stdlib.Option.or(Stdlib.Option.Option.None, Stdlib.Option.Option.Some(5))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(5))

      Stdlib.Option.or(Stdlib.Option.Option.None, Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test join =
  Stdlib.Test.all(
    [ Stdlib.Option.join(
        Stdlib.Option.Option.Some(Stdlib.Option.Option.Some(6)))
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(6))

      Stdlib.Option.join(Stdlib.Option.Option.Some(Stdlib.Option.Option.None))
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.join(Stdlib.Option.Option.None)
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test combine =
  Stdlib.Test.all(
    [ Stdlib.Option.combine(
        [ Stdlib.Option.Option.Some(6)
          Stdlib.Option.Option.Some(5)
          Stdlib.Option.Option.Some(4)
          Stdlib.Option.Option.Some(3) ])
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some([ 6, 5, 4, 3 ]))

      Stdlib.Option.combine(
        [ Stdlib.Option.Option.Some(6)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(4)
          Stdlib.Option.Option.Some(3) ])
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Stdlib.Option.combine(
        [ Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None ])
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


test values =
  Stdlib.Test.all(
    [ Stdlib.Option.values(
        [ Stdlib.Option.Option.Some(6)
          Stdlib.Option.Option.Some(5)
          Stdlib.Option.Option.Some(4)
          Stdlib.Option.Option.Some(3) ])
      |> Stdlib.Test.equal([ 6, 5, 4, 3 ])

      Stdlib.Option.values(
        [ Stdlib.Option.Option.Some(6)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.Some(4)
          Stdlib.Option.Option.Some(3) ])
      |> Stdlib.Test.equal([ 6, 4, 3 ])

      Stdlib.Option.values(
        [ Stdlib.Option.Option.Some(6)
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None ])
      |> Stdlib.Test.equal([ 6 ])

      Stdlib.Option.values(
        [ Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None ])
      |> Stdlib.Test.equal([]) ])
