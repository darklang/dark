module Darklang.Stdlib.Option.Tests

test andThen =
  Stdlib.Test.all
    [ Stdlib.Option.andThen (Some 5L) (fun x -> Some (1L + x))
      |> Stdlib.Test.equal (Some 6L)
      Stdlib.Option.andThen (Some 5L) (fun _ -> None)
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen None (fun _ -> Some 5L)
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen None (fun _ -> None)
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen (Some 8L) (fun x -> Some (x / 2L))
      |> Stdlib.Test.equal (Some 4L) ]

test andThenPropagatesRuntimeErrors =
  Stdlib.Option.andThen
    (Some 8L)
    (fun x -> Some (x / 0L))
  => raises "Cannot divide by 0"

test andThen2 =
  Stdlib.Test.all
    [ Stdlib.Option.andThen2 (Some 5L) (Some 6L) (fun x y -> Some (x + y))
      |> Stdlib.Test.equal (Some 11L)
      Stdlib.Option.andThen2 (Some 5L) None (fun x y -> Some (x + y))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen2 None (Some 6L) (fun x y -> Some (x + y))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen2 None None (fun x y -> Some (x + y))
      |> Stdlib.Test.equal None ]

test andThen3 =
  Stdlib.Test.all
    [ Stdlib.Option.andThen3
        (Some 5L)
        (Some 6L)
        (Some 7L)
        (fun x y z -> Some (x + y + z))
      |> Stdlib.Test.equal (Some 18L)
      Stdlib.Option.andThen3 None (Some 6L) (Some 7L) (fun x y z -> Some (x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen3 (Some 5L) None (Some 7L) (fun x y z -> Some (x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen3 (Some 5L) (Some 6L) None (fun x y z -> Some (x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen3 None None None (fun x y z -> Some (x + y + z))
      |> Stdlib.Test.equal None ]

test andThen4 =
  Stdlib.Test.all
    [ Stdlib.Option.andThen4
        (Some 5L)
        (Some 6L)
        (Some 7L)
        (Some 8L)
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal (Some 26L)
      Stdlib.Option.andThen4
        None
        (Some 6L)
        (Some 7L)
        (Some 8L)
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen4
        (Some 5L)
        None
        (Some 7L)
        (Some 8L)
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen4
        (Some 5L)
        (Some 6L)
        None
        (Some 8L)
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen4
        (Some 5L)
        (Some 6L)
        (Some 7L)
        None
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal None
      Stdlib.Option.andThen4
        None
        None
        None
        None
        (fun w x y z -> Some (w + x + y + z))
      |> Stdlib.Test.equal None ]

test map =
  Stdlib.Test.all
    [ Stdlib.Option.map (Some 4L) (fun x -> (x / 2L))
      |> Stdlib.Test.equal (Some 2L)
      Stdlib.Option.map None (fun x -> (x / 2L))
      |> Stdlib.Test.equal None ]

test map2 =
  Stdlib.Test.all
    [ Stdlib.Option.map2 (Some 10L) (Some 1L) (fun x y -> x - y)
      |> Stdlib.Test.equal (Some 9L)
      Stdlib.Option.map2 (Some 10L) None (fun x y -> x - y) |> Stdlib.Test.equal None
      Stdlib.Option.map2 None (Some 1L) (fun x y -> x - y) |> Stdlib.Test.equal None
      Stdlib.Option.map2 None None (fun x y -> x - y) |> Stdlib.Test.equal None ]

test map3 =
  Stdlib.Test.all
    [ Stdlib.Option.map3 (Some 10L) (Some 1L) (Some 2L) (fun x y z -> x - y - z)
      |> Stdlib.Test.equal (Some 7L)
      Stdlib.Option.map3 (Some 10L) None (Some 2L) (fun x y z -> x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map3 None (Some 1L) (Some 2L) (fun x y z -> x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map3 None None (Some 2L) (fun x y z -> x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map3 None None None (fun x y z -> x - y - z)
      |> Stdlib.Test.equal None ]

test map4 =
  Stdlib.Test.all
    [ Stdlib.Option.map4
        (Some 10L)
        (Some 1L)
        (Some 2L)
        (Some 3L)
        (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal (Some 4L)
      Stdlib.Option.map4
        (Some 10L)
        None
        (Some 2L)
        (Some 3L)
        (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map4
        None
        (Some 1L)
        (Some 2L)
        (Some 3L)
        (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map4 None None (Some 2L) (Some 3L) (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map4 None None None (Some 3L) (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map4 None None None None (fun w x y z -> w - x - y - z)
      |> Stdlib.Test.equal None ]

test map5 =
  Stdlib.Test.all
    [ Stdlib.Option.map5
        (Some 10L)
        (Some 1L)
        (Some 2L)
        (Some 3L)
        (Some 4L)
        (fun v w x y z -> v - w - x - y - z)
      |> Stdlib.Test.equal (Some 0L)
      Stdlib.Option.map5
        (Some 10L)
        None
        (Some 2L)
        (Some 3L)
        (Some 4L)
        (fun v w x y z -> v - w - x - y - z)
      |> Stdlib.Test.equal None
      Stdlib.Option.map5
        None
        None
        None
        None
        None
        (fun v w x y z -> v - w - x - y - z)
      |> Stdlib.Test.equal None ]

test mapWithDefault =
  Stdlib.Test.all
    [ Stdlib.Option.mapWithDefault (Some 5L) 6L (fun x -> x + 1L)
      |> Stdlib.Test.equal 6L
      Stdlib.Option.mapWithDefault None 6L (fun x -> x + 1L)
      |> Stdlib.Test.equal 6L
      Stdlib.Option.mapWithDefault (Some 5L) None (fun x -> x + 1L)
      |> Stdlib.Test.equal 6L
      Stdlib.Option.mapWithDefault None None (fun x -> x + 1L)
      |> Stdlib.Test.equal None ]

test withDefault =
  Stdlib.Test.all
    [ Stdlib.Option.withDefault (Some 6L) 5L
      |> Stdlib.Test.equal 6L
      Stdlib.Option.withDefault None 5L
      |> Stdlib.Test.equal 5L ]

test isSome =
  Stdlib.Test.all
    [ Stdlib.Option.isSome (Some 6L) |> Stdlib.Test.equal true
      Stdlib.Option.isSome None |> Stdlib.Test.equal false ]

test isNone =
  Stdlib.Test.all
    [ Stdlib.Option.isNone (Some 6L) |> Stdlib.Test.equal false
      Stdlib.Option.isNone None |> Stdlib.Test.equal true ]

test toResult =
  Stdlib.Test.all
    [ Stdlib.Option.toResult (Some 6L) 5L |> Stdlib.Test.equal (Ok 6L)
      Stdlib.Option.toResult None "error" |> Stdlib.Test.equal (Error "error") ]

test toList =
  Stdlib.Test.all
    [ Stdlib.Option.toList (Some 6L) |> Stdlib.Test.equal [ 6L ]
      Stdlib.Option.toList None |> Stdlib.Test.equal [] ]

test and =
  Stdlib.Test.all
    [ Stdlib.Option.and (Some 6L) (Some 5L) |> Stdlib.Test.equal (Some 5L)
      Stdlib.Option.and (Some 6L) None |> Stdlib.Test.equal None
      Stdlib.Option.and None (Some 5L) |> Stdlib.Test.equal None
      Stdlib.Option.and None None |> Stdlib.Test.equal None ]

test or =
  Stdlib.Test.all
    [ Stdlib.Option.or (Some 6L) (Some 5L) |> Stdlib.Test.equal (Some 6L)
      Stdlib.Option.or (Some 6L) None |> Stdlib.Test.equal (Some 6L)
      Stdlib.Option.or None (Some 5L) |> Stdlib.Test.equal (Some 5L)
      Stdlib.Option.or None None |> Stdlib.Test.equal None ]

test join =
  Stdlib.Test.all
    [ Stdlib.Option.join (Some (Some 6L)) |> Stdlib.Test.equal (Some 6L)
      Stdlib.Option.join (Some None) |> Stdlib.Test.equal None
      Stdlib.Option.join None |> Stdlib.Test.equal None ]

test combine =
  Stdlib.Test.all
    [ Stdlib.Option.combine [ Some 6L, Some 5L, Some 4L, Some 3L ]
      |> Stdlib.Test.equal (Some [ 6L, 5L, 4L, 3L ])
      Stdlib.Option.combine [ Some 6L, None, Some 4L, Some 3L ]
      |> Stdlib.Test.equal None
      Stdlib.Option.combine [ None, None, None, None ]
      |> Stdlib.Test.equal None ]

test values =
  Stdlib.Test.all
    [ Stdlib.Option.values [ Some 6L, Some 5L, Some 4L, Some 3L ]
      |> Stdlib.Test.equal [ 6L, 5L, 4L, 3L ]
      Stdlib.Option.values [ Some 6L, None, Some 4L, Some 3L ]
      |> Stdlib.Test.equal [ 6L, 4L, 3L ]
      Stdlib.Option.values [ Some 6L, None, None, None ]
      |> Stdlib.Test.equal [ 6L ]
      Stdlib.Option.values [ None, None, None, None ]
      |> Stdlib.Test.equal [] ]
