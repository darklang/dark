// Stdlib.HttpServer's pure helpers. The byte-exact tests in
// backend/testfiles/http-server exercise serve end to end.
module Darklang.Stdlib.HttpServer.Tests

// Route a request to /notes through a GET and a POST handler, returning the
// status and body text.
let routeNotes(
  method: String,
  headers: List<(String * String)>)
  : (Int64 * String) =
  let handlers =
    [ Stdlib.HttpServer.get("/notes", fun req ->
        Stdlib.Http.responseWithText(200, "list"))

      Stdlib.HttpServer.post("/notes", fun req ->
        Stdlib.Http.responseWithText(200, "created")) ]

  let response =
    Stdlib.HttpServer.routeRequest(
      handlers,
      Stdlib.Http.Request
        { method = method
          url = "/notes"
          headers = headers
          body = Stdlib.Bytes.empty })

  (response.statusCode, Stdlib.Utf8.decodeWithReplacement(response.body))


// The request's `method` picks the handler, and a header that looks like a
// method does not.
test routeRequestByMethod =
  Stdlib.Test.all(
    [ routeNotes("GET", []) |> Stdlib.Test.equal((200, "list"))

      routeNotes("POST", []) |> Stdlib.Test.equal((200, "created"))

      routeNotes("GET", [ ("x-http-method", "POST") ])
      |> Stdlib.Test.equal((200, "list"))

      Stdlib.Tuple2.first(routeNotes("DELETE", [])) |> Stdlib.Test.equal(404) ])


// `get`/`post` build the Handler a record literal would, so a route table reads as
// routes.
test routes =
  Stdlib.Test.all(
    [ (Stdlib.HttpServer.get("/ping", fun req ->
         Stdlib.Http.Response
           { statusCode = 200, headers = [], body = Stdlib.Bytes.empty })).route
      |> Stdlib.Test.equal("/ping")

      (Stdlib.HttpServer.get("/ping", fun req ->
         Stdlib.Http.Response
           { statusCode = 200
             headers = []
             body = Stdlib.Bytes.empty })).method
      |> Stdlib.Test.equal("GET")

      (Stdlib.HttpServer.post("/ops", fun req ->
         Stdlib.Http.Response
           { statusCode = 200
             headers = []
             body = Stdlib.Bytes.empty })).method
      |> Stdlib.Test.equal("POST") ])


test getPath =
  [ ("/users/42?x=1", "/users/42")
    ("http://localhost:9000/a/b?x=1", "/a/b")
    ("http://localhost:9000", "/")
    ("http://localhost:9000//a", "//a")
    ("/", "/")
    // Kept as written: not decoded, and characters a client may send raw survive.
    ("/a%20b/c|d[e]", "/a%20b/c|d[e]")
    ("users/42", "/users/42")
    // The host is the client's; a bad one does not route to "/".
    ("http://123:8000/x?y=1", "/x")
    ("http://999.1.1.1:8000/x", "/x")
    ("http://[nope]/a/b#f", "/a/b")
    ("http://h?x=/y", "/")
    // What the server hands over for an absolute-form target (`GET http://x/y`).
    ("http://x/y?z=2", "/y")
    // Asterisk form never reaches a handler (the listener answers 400), but
    // does not crash here either.
    ("*", "/*") ]
  |> Stdlib.List.map(fun pair ->
    let (url, expected) = pair
    Stdlib.HttpServer.getPath(
      Stdlib.Http.Request
        { method = "GET", url = url, headers = [], body = Stdlib.Bytes.empty })
    |> Stdlib.Test.equal(expected))
  |> Stdlib.Test.all


// ---------------------------
// Middleware: Handler -> Handler
// ---------------------------

let __req(url: String, headers: List<(String * String)>): Stdlib.Http.Request =
  Stdlib.Http.Request
    { method = "GET", url = url, headers = headers, body = Stdlib.Bytes.empty }


/// Answers with the url it saw as the body, and its request headers as its own.
let __echoHandler(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.Http.responseWithHeaders(200, req.headers, Stdlib.Utf8.encode(req.url))


let __run(
  middlewares: List<Stdlib.HttpServer.Middleware>,
  req: Stdlib.Http.Request)
  : Stdlib.Http.Response =
  Stdlib.HttpServer.Middleware.handle(middlewares, __echoHandler, req)


test serverStackRunsFirstListedOutermost =
  let tag = fun name ->
    Stdlib.HttpServer.Middleware.onResponse(fun r ->
      { r with headers = Stdlib.List.append(r.headers, ("x-seen", name)) })

  (__run([ tag("outer"), tag("inner") ], __req("http://a.test/", []))).headers
  |> Stdlib.Test.equal([ ("x-seen", "inner"), ("x-seen", "outer") ])


test serverEmptyStackIsTheHandler =
  (__run([], __req("http://a.test/x", []))).body
  |> Stdlib.Test.equal(Stdlib.Utf8.encode("http://a.test/x"))


test standardHeadersUnlessSet =
  Stdlib.Test.all(
    [ (__run(
         [ Stdlib.HttpServer.Middleware.standardHeaders() ],
         __req("http://a.test/", []))).headers
      |> Stdlib.Test.equal(
        [ ("Server", "darklang")
          (
            "Strict-Transport-Security",
            "max-age=31536000; includeSubDomains; preload") ])

      (__run(
         [ Stdlib.HttpServer.Middleware.standardHeaders() ],
         __req("http://a.test/", [ ("server", "mine") ]))).headers
      |> Stdlib.Test.equal(
        [ ("server", "mine")
          (
            "Strict-Transport-Security",
            "max-age=31536000; includeSubDomains; preload") ]) ])


test forwardedProtoRewritesTheUrl =
  let urlFor = fun headers ->
    Stdlib.Utf8.decodeWithReplacement(
      (__run(
         [ Stdlib.HttpServer.Middleware.trustForwardedProto() ],
         __req("http://a.test:8080/p?q=1", headers))).body)

  Stdlib.Test.all(
    [ urlFor([ ("X-Forwarded-Proto", "https") ])
      |> Stdlib.Test.equal("https://a.test/p?q=1")

      urlFor([ ("x-forwarded-proto", " HTTPS ") ])
      |> Stdlib.Test.equal("https://a.test/p?q=1")

      urlFor([ ("X-Forwarded-Proto", "http") ])
      |> Stdlib.Test.equal("http://a.test:8080/p?q=1")

      urlFor([]) |> Stdlib.Test.equal("http://a.test:8080/p?q=1") ])


test logRequestsPassesTheResponseThrough =
  let r =
    __run(
      [ Stdlib.HttpServer.Middleware.logRequests() ],
      __req("http://a.test/x", [ ("A", "1") ]))

  (r.statusCode, r.headers) |> Stdlib.Test.equal((200, [ ("A", "1") ]))


test onRequestRewritesForTheHandler =
  (__run(
     [ Stdlib.HttpServer.Middleware.onRequest(fun req ->
         { req with url = req.url + "#seen" }) ],
     __req("http://a.test/", []))).body
  |> Stdlib.Test.equal(Stdlib.Utf8.encode("http://a.test/#seen"))


test configDefaultsCarryTheStack =
  Stdlib.List.length(
    (Stdlib.HttpServer.Config.defaults(Stdlib.Net.Port.httpAlt)).middleware)
  |> Stdlib.Test.equal(3)
