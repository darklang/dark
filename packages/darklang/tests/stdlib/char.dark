/// Character cases from backend/testfiles/execution/stdlib/char.dark.
module Darklang.Stdlib.Char.Tests

let smiley () : Char =
  "😂" |> Stdlib.String.head |> Builtin.unwrap

let hand () : Char =
  "✋🏿" |> Stdlib.String.head |> Builtin.unwrap

// `e` followed by a combining acute accent: one grapheme, two code units
let eCombiningAcute () : Char =
  "e\u0301" |> Stdlib.String.head |> Builtin.unwrap

let family () : Char =
  "👩‍👩‍👧‍👦" |> Stdlib.String.head |> Builtin.unwrap

test toLowercase =
  Stdlib.Test.all
    [ Stdlib.Char.toLowercase 'A' |> Stdlib.Test.equal 'a'
      Stdlib.Char.toLowercase 'a' |> Stdlib.Test.equal 'a'
      Stdlib.Char.toLowercase 'Á' |> Stdlib.Test.equal 'á'
      Stdlib.Char.toLowercase '3' |> Stdlib.Test.equal '3'
      Stdlib.Char.toLowercase (smiley ()) |> Stdlib.Test.equal (smiley ())
      Stdlib.Char.toLowercase 'Ż' |> Stdlib.Test.equal 'ż'
      Stdlib.Char.toLowercase 'Ó' |> Stdlib.Test.equal 'ó'
      Stdlib.Char.toLowercase 'Ł' |> Stdlib.Test.equal 'ł'
      Stdlib.Char.toLowercase (hand ()) |> Stdlib.Test.equal (hand ())
      Stdlib.Char.toLowercase 'Ჾ' |> Stdlib.Test.equal 'ჾ'
      Stdlib.Char.toLowercase 'ჾ' |> Stdlib.Test.equal 'ჾ' ]

test toUppercase =
  Stdlib.Test.all
    [ Stdlib.Char.toUppercase 'a' |> Stdlib.Test.equal 'A'
      Stdlib.Char.toUppercase 'A' |> Stdlib.Test.equal 'A'
      Stdlib.Char.toUppercase 'á' |> Stdlib.Test.equal 'Á'
      Stdlib.Char.toUppercase '3' |> Stdlib.Test.equal '3'
      Stdlib.Char.toUppercase (smiley ()) |> Stdlib.Test.equal (smiley ())
      Stdlib.Char.toUppercase 'ż' |> Stdlib.Test.equal 'Ż'
      Stdlib.Char.toUppercase 'ó' |> Stdlib.Test.equal 'Ó'
      Stdlib.Char.toUppercase 'ł' |> Stdlib.Test.equal 'Ł'
      Stdlib.Char.toUppercase (hand ()) |> Stdlib.Test.equal (hand ())
      Stdlib.Char.toUppercase 'ჾ' |> Stdlib.Test.equal 'Ჾ'
      Stdlib.Char.toUppercase 'Ჾ' |> Stdlib.Test.equal 'Ჾ' ]

test isLowercase =
  Stdlib.Test.all
    [ Stdlib.Char.isLowercase 'a' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'A' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase 'á' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'Á' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase '3' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase (smiley ()) |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase 'ż' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'Ż' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase 'ó' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'Ó' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase 'ł' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'Ł' |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase (hand ()) |> Stdlib.Test.equal false
      Stdlib.Char.isLowercase 'ჾ' |> Stdlib.Test.equal true
      Stdlib.Char.isLowercase 'Ჾ' |> Stdlib.Test.equal false ]

test isUppercase =
  Stdlib.Test.all
    [ Stdlib.Char.isUppercase 'a' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'A' |> Stdlib.Test.equal true
      Stdlib.Char.isUppercase 'á' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'Á' |> Stdlib.Test.equal true
      Stdlib.Char.isUppercase '3' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase (smiley ()) |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'ż' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'Ż' |> Stdlib.Test.equal true
      Stdlib.Char.isUppercase 'ó' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'Ó' |> Stdlib.Test.equal true
      Stdlib.Char.isUppercase 'ł' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'Ł' |> Stdlib.Test.equal true
      Stdlib.Char.isUppercase (hand ()) |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'ჾ' |> Stdlib.Test.equal false
      Stdlib.Char.isUppercase 'Ჾ' |> Stdlib.Test.equal true ]

