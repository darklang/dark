    [ Stdlib.Char.isDigit 'a' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'A' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'á' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'Á' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit '0' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '1' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '2' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '3' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '4' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '5' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '6' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '7' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '8' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit '9' |> Stdlib.Test.equal true
      Stdlib.Char.isDigit (smiley ()) |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'ż' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'Ż' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'ó' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'Ó' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'ł' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'Ł' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit (hand ()) |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'ჾ' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit 'Ჾ' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit ' ' |> Stdlib.Test.equal false
      Stdlib.Char.isDigit '\t' |> Stdlib.Test.equal false ]

