module Darklang.Stdlib.Bytes.Tests

// hex round of various UTF-8 strings (Arabic / emoji / long mixed).
test toHexOfUtf8 =
  Stdlib.Test.all
    [ Stdlib.Bytes.fromString "اختبار النص" |> Stdlib.Bytes.toHex
      |> Stdlib.Test.equal "D8A7D8AED8AAD8A8D8A7D8B120D8A7D984D986D8B5"
      Stdlib.Bytes.fromString "👱👱🏻👱🏼👱🏽👱🏾👱🏿" |> Stdlib.Bytes.toHex
      |> Stdlib.Test.equal
        "F09F91B1F09F91B1F09F8FBBF09F91B1F09F8FBCF09F91B1F09F8FBDF09F91B1F09F8FBEF09F91B1F09F8FBF"
      Stdlib.Bytes.fromString
        "dlkjkd329823333333333fjfidjsfudsdhs}{||!|!|!|!!$%^&^&﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽﷽"
      |> Stdlib.Bytes.toHex
      |> Stdlib.Test.equal
        "646C6B6A6B64333239383233333333333333333333666A6669646A73667564736468737D7B7C7C217C217C217C212124255E265E26EFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BDEFB7BD" ]

// length
test length =
  Stdlib.Test.all
    [ Stdlib.Bytes.fromString "hi" |> Stdlib.Bytes.length |> Stdlib.Test.equal 2
      Stdlib.Bytes.fromString "" |> Stdlib.Bytes.length |> Stdlib.Test.equal 0
      Stdlib.Bytes.empty |> Stdlib.Bytes.length |> Stdlib.Test.equal 0 ]

// fromString / toString roundtrip
test stringRoundTrip =
  Stdlib.Bytes.fromString "hello" |> Stdlib.Bytes.toString
  |> Stdlib.Test.equal (Ok "hello")

// fromHex returns Result<Bytes,String>; length of decoded deadbeef = 4 bytes
test fromHex =
  Stdlib.Bytes.fromHex "deadbeef" |> Stdlib.Result.map Stdlib.Bytes.length
  |> Stdlib.Test.equal (Ok 4)

// hex roundtrip via wrapper
test hexRoundTrip =
  Stdlib.Bytes.fromHex "48656c6c6f"
  |> Stdlib.Result.andThen Stdlib.Bytes.toString
  |> Stdlib.Test.equal (Ok "Hello")

// toHex roundtrip (uppercase output)
test toHex =
  Stdlib.Test.all
    [ Stdlib.Bytes.fromString "ok" |> Stdlib.Bytes.toHex |> Stdlib.Test.equal "6F6B"
      Stdlib.Bytes.fromString "Hi" |> Stdlib.Bytes.toHex |> Stdlib.Test.equal "4869" ]

// base64 roundtrip
test base64RoundTrip =
  Stdlib.Test.all
    [ Stdlib.Bytes.fromBase64 "aGVsbG8="
      |> Stdlib.Result.andThen Stdlib.Bytes.toString
      |> Stdlib.Test.equal (Ok "hello")
      Stdlib.Bytes.fromString "hello" |> Stdlib.Bytes.toBase64
      |> Stdlib.Test.equal "aGVsbG8=" ]

// concat
test concat =
  [ Stdlib.Bytes.fromString "foo"
    Stdlib.Bytes.fromString "-"
    Stdlib.Bytes.fromString "bar" ]
  |> Stdlib.Bytes.concat
  |> Stdlib.Bytes.toString
  |> Stdlib.Test.equal (Ok "foo-bar")

// slice (middle three bytes of "abcdef" = "cde")
test slice =
  Stdlib.Bytes.slice (Stdlib.Bytes.fromString "abcdef") 2 3
  |> Stdlib.Bytes.toString
  |> Stdlib.Test.equal (Ok "cde")

// toList/fromList escape hatches
test listConversions =
  Stdlib.Test.all
    [ Stdlib.Bytes.fromString "abc" |> Stdlib.Bytes.toList
      |> Stdlib.Test.equal [ 97uy, 98uy, 99uy ]
      Stdlib.Bytes.fromList [ 97uy, 98uy, 99uy ] |> Stdlib.Bytes.length
      |> Stdlib.Test.equal 3 ]

// Equality depends on contents, including for independently created values.
test differentBytesAreNotEqual =
  (Stdlib.Bytes.fromString "hi" == Stdlib.Bytes.fromString "bye")
  |> Stdlib.Test.equal false

test equalityUsesContents =
  let bytes = Stdlib.Bytes.fromString "hi"
  Stdlib.Test.all
    [ (bytes == bytes) |> Stdlib.Test.equal true
      (bytes == Stdlib.Bytes.fromString "hi") |> Stdlib.Test.equal true
      (Stdlib.Bytes.fromString "" == Stdlib.Bytes.empty) |> Stdlib.Test.equal true
      ([bytes] == [Stdlib.Bytes.fromList [104uy, 105uy]])
      |> Stdlib.Test.equal true ]

test collectionsUseContentEquality =
  let a = Stdlib.Bytes.fromString "hi"
  let b = Stdlib.Bytes.fromList [104uy, 105uy]
  Stdlib.Test.all
    [ Stdlib.List.contains [a] b |> Stdlib.Test.equal true
      Stdlib.List.unique [a, b] |> Stdlib.List.length |> Stdlib.Test.equal 1
      Stdlib.List.unique [Stdlib.Bytes.empty, Stdlib.Bytes.fromString ""]
      |> Stdlib.List.length |> Stdlib.Test.equal 1
      // Sorting must use the same equality as ==.
      Stdlib.List.sort [a, b] |> Stdlib.Test.equal [b, a] ]

// Reflection carries an opaque Bytes value, never a storage-specific tag.
test reflectionUsesContents =
  let reflect = Darklang.LanguageTools.RuntimeTypes.reflect
  Stdlib.Test.all
    [ (reflect Stdlib.Bytes.empty == reflect (Stdlib.Bytes.fromString ""))
      |> Stdlib.Test.equal true
      (reflect (Stdlib.Bytes.fromString "hi")
       == reflect (Stdlib.Bytes.fromList [104uy, 105uy]))
      |> Stdlib.Test.equal true ]

test dictionaryKeysUseContents =
  let first = Stdlib.Bytes.fromString "hi"
  let same = Stdlib.Bytes.fromList [104uy, 105uy]
  let different = Stdlib.Bytes.fromString "ho"
  let dict = Dict { first: "found" }
  Stdlib.Test.all
    [ Stdlib.Dict.get dict same |> Stdlib.Test.equal (Some "found")
      Stdlib.Dict.get dict different |> Stdlib.Test.equal None
      Stdlib.Dict.get (Dict { Stdlib.Bytes.empty: "empty" }) (Stdlib.Bytes.fromString "")
      |> Stdlib.Test.equal (Some "empty")
      Stdlib.Dict.fromList [(first, 1), (same, 2)] |> Stdlib.Test.equal None
      Stdlib.Dict.get (Stdlib.Dict.fromListOverwritingDuplicates [(first, 1), (same, 2)]) first
      |> Stdlib.Test.equal (Some 2)
      Stdlib.Dict.get (Dict { (first, 1): "nested" }) (same, 1)
      |> Stdlib.Test.equal (Some "nested") ]
