module Darklang.Stdlib.Bytes.Tests

// length
test length =
  Stdlib.Test.all(
    [ Stdlib.Utf8.encode("hi") |> Stdlib.Bytes.length |> Stdlib.Test.equal(2)
      Stdlib.Utf8.encode("") |> Stdlib.Bytes.length |> Stdlib.Test.equal(0)
      Stdlib.Bytes.empty |> Stdlib.Bytes.length |> Stdlib.Test.equal(0) ])

// isEmpty
test isEmpty =
  Stdlib.Test.all(
    [ Stdlib.Bytes.isEmpty(Stdlib.Bytes.empty) |> Stdlib.Test.equal(true)
      Stdlib.Bytes.isEmpty(Stdlib.Utf8.encode("")) |> Stdlib.Test.equal(true)
      Stdlib.Bytes.isEmpty(Stdlib.Utf8.encode("a")) |> Stdlib.Test.equal(false) ])

// getAt
test getAt =
  let bytes = Stdlib.Bytes.fromList([ 10uy, 20uy, 30uy ])
  Stdlib.Test.all(
    [ Stdlib.Bytes.getAt(bytes, 0) |> Stdlib.Test.equal(Some 10uy)
      Stdlib.Bytes.getAt(bytes, 2) |> Stdlib.Test.equal(Some 30uy)
      Stdlib.Bytes.getAt(bytes, 3) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.getAt(bytes, -1) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.getAt(Stdlib.Bytes.empty, 0)
      |> Stdlib.Test.equal(None) ])

// indexOf / indexOfFrom
test indexOf =
  let bytes = Stdlib.Utf8.encode("ab\nc\n")
  Stdlib.Test.all(
    [ Stdlib.Bytes.indexOf(bytes, 10uy) |> Stdlib.Test.equal(Some 2)
      Stdlib.Bytes.indexOf(bytes, 0uy) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.indexOf(Stdlib.Bytes.empty, 10uy) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.indexOfFrom(bytes, 10uy, 2) |> Stdlib.Test.equal(Some 2)
      Stdlib.Bytes.indexOfFrom(bytes, 10uy, 3) |> Stdlib.Test.equal(Some 4)
      Stdlib.Bytes.indexOfFrom(bytes, 10uy, 5) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.indexOfFrom(bytes, 10uy, -1) |> Stdlib.Test.equal(None)
      Stdlib.Bytes.indexOfFrom(bytes, 10uy, 99) |> Stdlib.Test.equal(None) ])

// concat
test concat =
  Stdlib.Test.all(
    [ Stdlib.Bytes.concat(Stdlib.Utf8.encode("foo"), Stdlib.Utf8.encode("bar"))
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(Ok "foobar")
      Stdlib.Bytes.concat(Stdlib.Bytes.empty, Stdlib.Utf8.encode("a"))
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(Ok "a") ])

// concatAll
test concatAll =
  Stdlib.Test.all(
    [ [ Stdlib.Utf8.encode("foo")
        Stdlib.Utf8.encode("-")
        Stdlib.Utf8.encode("bar") ]
      |> Stdlib.Bytes.concatAll
      |> Stdlib.Utf8.decode
      |> Stdlib.Test.equal(Ok "foo-bar")
      Stdlib.Bytes.concatAll([]) |> Stdlib.Bytes.length |> Stdlib.Test.equal(0) ])

// slice: start inclusive, end exclusive, strict
test slice =
  let bytes = Stdlib.Utf8.encode("abcdef")
  let text(r: Stdlib.Result.Result<Bytes, Stdlib.Bytes.IndexError>)
    : Stdlib.Result.Result<String, String> =
    match r with
    | Ok b -> Stdlib.Utf8.decode(b)
    | Error _ -> Error "out of bounds"
  Stdlib.Test.all(
    [ text(Stdlib.Bytes.slice(bytes, 2, 5)) |> Stdlib.Test.equal(Ok "cde")
      text(Stdlib.Bytes.slice(bytes, 0, 6)) |> Stdlib.Test.equal(Ok "abcdef")
      text(Stdlib.Bytes.slice(bytes, 3, 3)) |> Stdlib.Test.equal(Ok "")
      text(Stdlib.Bytes.slice(bytes, 6, 6)) |> Stdlib.Test.equal(Ok "")
      text(Stdlib.Bytes.slice(Stdlib.Bytes.empty, 0, 0)) |> Stdlib.Test.equal(Ok "")
      Stdlib.Bytes.slice(bytes, 2, 7)
      |> Stdlib.Test.equal(Error Stdlib.Bytes.IndexError.IndexOutOfBounds)
      Stdlib.Bytes.slice(bytes, -1, 2)
      |> Stdlib.Test.equal(Error Stdlib.Bytes.IndexError.IndexOutOfBounds)
      Stdlib.Bytes.slice(bytes, 4, 2)
      |> Stdlib.Test.equal(Error Stdlib.Bytes.IndexError.IndexOutOfBounds)
      Stdlib.Bytes.slice(bytes, 7, 7)
      |> Stdlib.Test.equal(Error Stdlib.Bytes.IndexError.IndexOutOfBounds) ])

// take: the first bytes; never errors, clamps to the Bytes
test take =
  let bytes = Stdlib.Utf8.encode("abcdef")
  let text(b: Bytes): Stdlib.Result.Result<String, String> = Stdlib.Utf8.decode(b)
  Stdlib.Test.all(
    [ text(Stdlib.Bytes.take(bytes, 2)) |> Stdlib.Test.equal(Ok "ab")
      text(Stdlib.Bytes.take(bytes, 0)) |> Stdlib.Test.equal(Ok "")
      text(Stdlib.Bytes.take(bytes, -3)) |> Stdlib.Test.equal(Ok "")
      text(Stdlib.Bytes.take(bytes, 99)) |> Stdlib.Test.equal(Ok "abcdef")
      text(Stdlib.Bytes.take(Stdlib.Bytes.empty, 3)) |> Stdlib.Test.equal(Ok "") ])

// drop: all but the first bytes; never errors, clamps to the Bytes
test drop =
  let bytes = Stdlib.Utf8.encode("abcdef")
  let text(b: Bytes): Stdlib.Result.Result<String, String> = Stdlib.Utf8.decode(b)
  Stdlib.Test.all(
    [ text(Stdlib.Bytes.drop(bytes, 2)) |> Stdlib.Test.equal(Ok "cdef")
      text(Stdlib.Bytes.drop(bytes, 0)) |> Stdlib.Test.equal(Ok "abcdef")
      text(Stdlib.Bytes.drop(bytes, -3)) |> Stdlib.Test.equal(Ok "abcdef")
      text(Stdlib.Bytes.drop(bytes, 99)) |> Stdlib.Test.equal(Ok "")
      text(Stdlib.Bytes.drop(Stdlib.Bytes.empty, 3)) |> Stdlib.Test.equal(Ok "") ])

// toList / fromList
test listConversions =
  Stdlib.Test.all(
    [ Stdlib.Utf8.encode("abc") |> Stdlib.Bytes.toList
      |> Stdlib.Test.equal([ 97uy, 98uy, 99uy ])
      Stdlib.Bytes.fromList([ 97uy, 98uy, 99uy ])
      |> Stdlib.Test.equal(Stdlib.Utf8.encode("abc")) ])

// Equality depends on contents, including for independently created values.
test differentBytesAreNotEqual =
  (Stdlib.Utf8.encode("hi") == Stdlib.Utf8.encode("bye"))
  |> Stdlib.Test.equal(false)

test equalityUsesContents =
  let bytes = Stdlib.Utf8.encode("hi")
  Stdlib.Test.all(
    [ (bytes == bytes) |> Stdlib.Test.equal(true)
      (bytes == Stdlib.Utf8.encode("hi")) |> Stdlib.Test.equal(true)
      (Stdlib.Utf8.encode("") == Stdlib.Bytes.empty) |> Stdlib.Test.equal(true)
      ([bytes] == [Stdlib.Bytes.fromList([104uy, 105uy])])
      |> Stdlib.Test.equal(true) ])

test collectionsUseContentEquality =
  let a = Stdlib.Utf8.encode("hi")
  let b = Stdlib.Bytes.fromList([104uy, 105uy])
  let x = Stdlib.Utf8.encode("x")
  Stdlib.Test.all(
    [ Stdlib.List.contains([a], b) |> Stdlib.Test.equal(true)
      Stdlib.List.unique([a, b]) |> Stdlib.List.length |> Stdlib.Test.equal(1)
      Stdlib.List.unique([Stdlib.Bytes.empty, Stdlib.Utf8.encode("")])
      |> Stdlib.List.length |> Stdlib.Test.equal(1)
      // `unique` keeps the first of equal Bytes where it was.
      Stdlib.List.unique([a, x, b]) |> Stdlib.Test.equal([a, x]) ])

// Bytes have no order, so sorting them refuses rather than inventing one.
test sortRefusesBytes =
  Stdlib.List.sort([Stdlib.Utf8.encode("b"), Stdlib.Utf8.encode("a")])
  => raises "Cannot sort <Bytes: 1 byte 62>. Bytes, functions and streams have no order; use List.sortBy with a key that has one."

test sortByRefusesBytesKeys =
  Stdlib.List.sortBy([ "b", "a" ], fun s -> Stdlib.Utf8.encode(s))
  => raises "Cannot sort <Bytes: 1 byte 62>. Bytes, functions and streams have no order; use List.sortBy with a key that has one."

// A sort reaches Bytes inside a value only when everything before them ties.
test sortOfValuesHoldingBytesComparesEarlierFieldsFirst =
  Stdlib.List.sort([ (2L, Stdlib.Utf8.encode("x")), (1L, Stdlib.Utf8.encode("y")) ])
  |> Stdlib.List.map(Stdlib.Tuple2.first)
  |> Stdlib.Test.equal([ 1L, 2L ])

test sortOfValuesHoldingBytesRefusesOnATie =
  Stdlib.List.sort([ (1L, Stdlib.Utf8.encode("x")), (1L, Stdlib.Utf8.encode("y")) ])
  => raises "Cannot sort <Bytes: 1 byte 78>. Bytes, functions and streams have no order; use List.sortBy with a key that has one."

// Reflection carries an opaque Bytes value, never a storage-specific tag.
test reflectionUsesContents =
  let reflect = Darklang.LanguageTools.RuntimeTypes.reflect
  Stdlib.Test.all(
    [ (reflect(Stdlib.Bytes.empty) == reflect(Stdlib.Utf8.encode("")))
      |> Stdlib.Test.equal(true)
      (reflect(Stdlib.Utf8.encode("hi"))
       == reflect(Stdlib.Bytes.fromList([104uy, 105uy])))
      |> Stdlib.Test.equal(true) ])

test dictionaryKeysUseContents =
  let first = Stdlib.Utf8.encode("hi")
  let same = Stdlib.Bytes.fromList([104uy, 105uy])
  let different = Stdlib.Utf8.encode("ho")
  let dict = Dict { first: "found" }
  let byEmpty = Dict { Stdlib.Bytes.empty: "empty" }
  let overwritten = Stdlib.Dict.fromEntries([(first, 1), (same, 2)])
  Stdlib.Test.all(
    [ Stdlib.Dict.get(dict, same) |> Stdlib.Test.equal(Some "found")
      Stdlib.Dict.get(dict, different) |> Stdlib.Test.equal(None)
      Stdlib.Dict.get(byEmpty, Stdlib.Utf8.encode(""))
      |> Stdlib.Test.equal(Some "empty")
      Stdlib.Dict.size(overwritten) |> Stdlib.Test.equal(1)
      Stdlib.Dict.get(overwritten, first) |> Stdlib.Test.equal(Some 2)
      Stdlib.Dict.get(Dict { (first, 1): "nested" }, (same, 1))
      |> Stdlib.Test.equal(Some "nested") ])

// A test whose error holds unsaved Bytes still reports that error.
// Equal Bytes are one key: a literal keeps the last value, `fromEntriesUnique`
// refuses.
test duplicateBytesKeysAreOneKey =
  let a = Stdlib.Utf8.encode("a")
  let alsoA = Stdlib.Bytes.fromList([97uy])
  Stdlib.Test.all(
    [ Dict { (a): 1, (alsoA): 2 } |> Stdlib.Test.equal(Dict { (a): 2 })
      Stdlib.Dict.fromEntriesUnique([ (a, 1), (alsoA, 2) ])
      |> Stdlib.Test.equal(Error(Stdlib.Dict.DuplicateKey.DuplicateKey a)) ])

let reversed(bytes: Bytes): Bytes =
  Stdlib.Bytes.fromList(Stdlib.List.reverse(Stdlib.Bytes.toList(bytes)))

// Unsaved Bytes reach a test worker and come back with their contents readable.
test workerCarriesUnsavedBytes =
  let input = Stdlib.Utf8.encode("abc")
  match Stdlib.Test.Process.run(Stdlib.Test.Process.defaults(), reversed, input) with
  | Error message -> Stdlib.Test.fail(message)
  | Ok output ->
    match output.result with
    | Error message -> Stdlib.Test.fail(message)
    | Ok bytes ->
      Stdlib.Test.all(
        [ output.exitCode |> Stdlib.Test.equal(0)
          Stdlib.Utf8.decode(bytes) |> Stdlib.Test.equal(Ok "cba") ])
