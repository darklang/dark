module Darklang.Stdlib.DateTime.Tests

let d(datestr: String): DateTime =
  Stdlib.DateTime.parse(datestr) |> Builtin.unwrap


let p(
  datestr: String)
  : Stdlib.Result.Result<String, Stdlib.DateTime.ParseError> =
  Stdlib.DateTime.parse(datestr)
  |> Stdlib.Result.map(fun value -> Stdlib.display(value))


let a(datestr: String, seconds: Int64): DateTime =
  Stdlib.DateTime.addSeconds(d(datestr), seconds)


let sub(datestr: String, seconds: Int64): DateTime =
  Stdlib.DateTime.subtractSeconds(d(datestr), seconds)


let s(first: String, second: String): Stdlib.Duration.Duration =
  Stdlib.DateTime.subtract(d(first), d(second))


let dMs(datestr: String): DateTime =
  d(datestr)


let ams(datestr: String, milliseconds: Int64): DateTime =
  Stdlib.DateTime.addMilliseconds(d(datestr), milliseconds)


let sms(datestr: String, milliseconds: Int64): DateTime =
  Stdlib.DateTime.subtractMilliseconds(d(datestr), milliseconds)


let sMs(first: String, second: String): Int64 =
  Stdlib.DateTime.subtractMs(d(first), d(second))


test parse =
  Stdlib.Test.all(
    [ p("2019-07-28T22:42:36Z") |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36Z"))

      p("asd")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


test parseDistinguishesInvalidDatesFromFormats =
  let invalidDate = Error(Stdlib.DateTime.ParseError.InvalidDate)
  let invalidFormat = Error(Stdlib.DateTime.ParseError.InvalidFormat)
  Stdlib.Test.all(
    [ p("2027-02-29") |> Stdlib.Test.equal(invalidDate)
      p("2027-02-29T12:00:00Z") |> Stdlib.Test.equal(invalidDate)
      p("2027-04-31T12:00:00.123+02:00") |> Stdlib.Test.equal(invalidDate)
      p("25/12/2026") |> Stdlib.Test.equal(invalidFormat)
      p("2027-02-29garbage") |> Stdlib.Test.equal(invalidFormat)
      p("2027-02-29T12:00:00") |> Stdlib.Test.equal(invalidFormat)
      p("2028-02-29") |> Stdlib.Test.equal(Ok("2028-02-29T00:00:00Z")) ])


test parseErrorDisplay =
  Stdlib.Test.all(
    [ Stdlib.display(Stdlib.DateTime.ParseError.InvalidFormat)
      |> Stdlib.Test.equal(
        "Invalid date format; expected YYYY-MM-DD or an ISO 8601 timestamp")

      Stdlib.display(Stdlib.DateTime.ParseError.InvalidDate)
      |> Stdlib.Test.equal("Invalid calendar date") ])


// Parse in both
test parseInBoth =
  p("2018-09-24T18:01:24Z") |> Stdlib.Test.equal(Ok("2018-09-24T18:01:24Z"))


// Lowercase `z` aren't allowed
test parseRejectsLowercaseZ =
  p("2023-09-23T18:01:24z")
  |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))


// An offset from UTC is taken off, so the result is the same instant in UTC
test parseOffsets =
  let ok = fun s -> Ok(s)
  let bad = Error(Stdlib.DateTime.ParseError.InvalidFormat)
  Stdlib.Test.all(
    [ p("2026-03-10T13:55:36+02:00")
      |> Stdlib.Test.equal(ok("2026-03-10T11:55:36Z"))

      p("2026-03-10T13:55:36-05:30")
      |> Stdlib.Test.equal(ok("2026-03-10T19:25:36Z"))

      p("2026-03-10T13:55:36+00:00")
      |> Stdlib.Test.equal(ok("2026-03-10T13:55:36Z"))

      p("2026-03-10T13:55:36-00:00")
      |> Stdlib.Test.equal(ok("2026-03-10T13:55:36Z"))

      p("2026-03-10T13:55:36.250+02:00")
      |> Stdlib.Test.equal(ok("2026-03-10T11:55:36.250Z"))

      p("2026-03-10T23:59:00+23:59")
      |> Stdlib.Test.equal(ok("2026-03-10T00:00:00Z"))

      p("2026-03-10T00:00:00-23:59")
      |> Stdlib.Test.equal(ok("2026-03-10T23:59:00Z"))

      // across a day, a leap day and a year
      p("2026-03-01T01:00:00+02:00")
      |> Stdlib.Test.equal(ok("2026-02-28T23:00:00Z"))

      p("2024-03-01T00:30:00+01:00")
      |> Stdlib.Test.equal(ok("2024-02-29T23:30:00Z"))

      p("2025-12-31T23:30:00-01:00")
      |> Stdlib.Test.equal(ok("2026-01-01T00:30:00Z"))

      p("0001-01-01T00:30:00+01:00")
      |> Stdlib.Test.equal(ok("0000-12-31T23:30:00Z"))

      // the same instant written two ways is equal
      Stdlib.Test.equal(
        d("2026-03-10T13:55:36+02:00"),
        d("2026-03-10T11:55:36Z"))

      // the offset must be +hh:mm or -hh:mm, in range, and end the text
      p("2026-03-10T13:55:36+24:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+02:60") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+0200") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+02") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+2:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+02:00Z") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+02:00:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36 +02:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36") |> Stdlib.Test.equal(bad)

      // the local time is checked before the offset is taken off
      p("2026-02-29T01:00:00+02:00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("2026-03-10T24:00:00-01:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:60:00+01:00") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:60+01:00") |> Stdlib.Test.equal(bad)

      // only ASCII digits
      p("2026-03-1١T13:55:36Z") |> Stdlib.Test.equal(bad)

      p("2026-03-10T13:55:36+0١:00") |> Stdlib.Test.equal(bad) ])


// Time zones aren't allowed
test parseRejectsTimeZones =
  Stdlib.Test.all(
    [ // special cased in F#
      p("2000-11-22 09:10:15z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      // special cased in F#
      p("2008-09-15T09:30:41GMT")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41UTC")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41EST")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


// Fail in both
test parseFailInBoth =
  Stdlib.Test.all(
    [ p("2000-11-22 09:10:15")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2000-11-22 09:10:15Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2012-01-31 23:59:59.999")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2012-01-31 23:59:59.999+0100")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2012-01-31 23:59:59.999-0100")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2018-09-09 10:43:54+0100")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2018-09-09 11:43:54+0200")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2018-09-24T17:48:00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2018-09-24T18:09:24+0200")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("1999-03-22T05:06:07+01:00")
      |> Stdlib.Test.equal(Ok("1999-03-22T04:06:07Z"))

      p("1999-03-22T05:06:07.000Z")
      |> Stdlib.Test.equal(Ok("1999-03-22T05:06:07Z"))

      p("2006-06-09T10:20:30.040")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2006-06-09T10:20:30.040+02:00")
      |> Stdlib.Test.equal(Ok("2006-06-09T08:20:30.040Z"))

      p("20061204T1020Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T1020")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.1")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.12")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.123")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.1234")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.12345")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.123456")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.1234567")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.1234567Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.7752486-07:00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2008-09-15T09:30:41.7752486-04:00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T10:20:54.67am")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T1020am")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T1020AM")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T1020PM")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("20061204T1020pm")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("15/06/2008 08:30")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("18/08/2015 06:30:15.006542")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("Mon, 15 Sep 2008 09:30:41 GMT")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2/16/2008 12:15:12 PM")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

