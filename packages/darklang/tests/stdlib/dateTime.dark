      p("2008-09-15T09:30.456")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


// a plain date is midnight UTC
test parseDateOnly =
  Stdlib.Test.all(
    [ p("2026-12-25") |> Stdlib.Test.equal(Ok("2026-12-25T00:00:00Z"))

      p("2024-02-29") |> Stdlib.Test.equal(Ok("2024-02-29T00:00:00Z"))

      p("2026-12-25") |> Stdlib.Test.equal(p("2026-12-25T00:00:00Z"))

      p("2026-13-01")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("2026-02-30")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("2025-02-29")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("2026-00-10")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("2026-12-00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("0000-01-01")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidDate))

      p("26-12-25")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2026-12-5")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2026-12-25Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2026-12-25T")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2026/12/25")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p(" 2026-12-25")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


// while space isn't allowed
test parseRejectsSurroundingWhitespace =
  Stdlib.Test.all(
    [ p(" 2006-06-09T10:20:30.040+02:00")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2006-06-09T10:20:30.040+02:00 ")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p(" 2006-06-09T10:20:30.040+02:00 ")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


test lessThan =
  Stdlib.Test.all(
    [ Stdlib.DateTime.lessThan(
        d("2019-07-28T22:42:36Z"),
        d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(false)

      Stdlib.DateTime.lessThan(
        d("2019-07-28T22:42:36Z"),
        d("2020-11-26T04:37:46Z"))
      |> Stdlib.Test.equal(true) ])


test lessThanOrEqualTo =
  Stdlib.Test.all(
    [ Stdlib.DateTime.lessThanOrEqualTo(
        d("2021-07-28T22:42:36Z"),
        d("2020-11-26T04:37:46Z"))
      |> Stdlib.Test.equal(false)

      Stdlib.DateTime.lessThanOrEqualTo(
        d("2019-07-28T22:42:36Z"),
        d("2020-11-26T04:37:46Z"))
      |> Stdlib.Test.equal(true) ])


test greaterThan =
  Stdlib.Test.all(
    [ Stdlib.DateTime.greaterThan(
        d("2019-07-28T22:42:36Z"),
        d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(false)

      Stdlib.DateTime.greaterThan(
        d("2020-11-26T04:37:46Z"),
        d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(true) ])


test greaterThanOrEqualTo =
  Stdlib.Test.all(
    [ Stdlib.DateTime.greaterThanOrEqualTo(
        d("2019-11-26T04:37:46Z"),
        d("2020-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(false)

      Stdlib.DateTime.greaterThanOrEqualTo(
        d("2020-11-26T04:37:46Z"),
        d("2020-11-26T04:37:46Z"))
      |> Stdlib.Test.equal(true) ])


test fields =
  Stdlib.Test.all(
    [ Stdlib.DateTime.year(d("2019-07-28T22:42:36Z")) |> Stdlib.Test.equal(2019)

      Stdlib.DateTime.month(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(Stdlib.DateTime.Month.July)

      Stdlib.DateTime.day(d("2019-07-28T22:42:36Z")) |> Stdlib.Test.equal(28u8)

      // Leif's test case
      Stdlib.DateTime.hour(d("2019-12-27T03:27:36Z")) |> Stdlib.Test.equal(3u8)

      Stdlib.DateTime.minute(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(42u8) ])


