// A month read from a date, its number both ways, and how `%m` prints it
let monthCase(
  mm: String,
  n: UInt8,
  month: Stdlib.DateTime.Month)
  : Stdlib.Test.Result =
  let date = d("2019-" + mm + "-15T12:00:00Z")
  Stdlib.Test.all(
    [ Stdlib.DateTime.month(date) |> Stdlib.Test.equal(month)
      Stdlib.DateTime.Month.toNumber(month) |> Stdlib.Test.equal(n)
      Stdlib.DateTime.Month.fromNumber(n) |> Stdlib.Test.equal(Some(month))
      Stdlib.DateTime.format(date, "%m") |> Stdlib.Test.equal(Ok(mm)) ])


test everyMonth =
  Stdlib.Test.all(
    [ monthCase("01", 1u8, Stdlib.DateTime.Month.January)
      monthCase("02", 2u8, Stdlib.DateTime.Month.February)
      monthCase("03", 3u8, Stdlib.DateTime.Month.March)
      monthCase("04", 4u8, Stdlib.DateTime.Month.April)
      monthCase("05", 5u8, Stdlib.DateTime.Month.May)
      monthCase("06", 6u8, Stdlib.DateTime.Month.June)
      monthCase("07", 7u8, Stdlib.DateTime.Month.July)
      monthCase("08", 8u8, Stdlib.DateTime.Month.August)
      monthCase("09", 9u8, Stdlib.DateTime.Month.September)
      monthCase("10", 10u8, Stdlib.DateTime.Month.October)
      monthCase("11", 11u8, Stdlib.DateTime.Month.November)
      monthCase("12", 12u8, Stdlib.DateTime.Month.December) ])


test monthFromNumberOutOfRange =
  Stdlib.Test.all(
    [ Stdlib.DateTime.Month.fromNumber(0u8) |> Stdlib.Test.equal(None)
      Stdlib.DateTime.Month.fromNumber(13u8) |> Stdlib.Test.equal(None)
      Stdlib.DateTime.Month.fromNumber(255u8) |> Stdlib.Test.equal(None) ])


let weekdayCase(
  date: String,
  n: UInt8,
  weekday: Stdlib.DateTime.Weekday)
  : Stdlib.Test.Result =
  Stdlib.Test.all(
    [ Stdlib.DateTime.weekday(d(date + "T12:00:00Z"))
      |> Stdlib.Test.equal(weekday)

      Stdlib.DateTime.Weekday.toNumber(weekday) |> Stdlib.Test.equal(n)

      Stdlib.DateTime.Weekday.fromNumber(n)
      |> Stdlib.Test.equal(Some(weekday)) ])


test everyWeekday =
  Stdlib.Test.all(
    [ weekdayCase("2019-07-22", 1u8, Stdlib.DateTime.Weekday.Monday)
      weekdayCase("2019-07-23", 2u8, Stdlib.DateTime.Weekday.Tuesday)
      weekdayCase("2019-07-24", 3u8, Stdlib.DateTime.Weekday.Wednesday)
      weekdayCase("2019-07-25", 4u8, Stdlib.DateTime.Weekday.Thursday)
      weekdayCase("2019-07-26", 5u8, Stdlib.DateTime.Weekday.Friday)
      weekdayCase("2019-07-27", 6u8, Stdlib.DateTime.Weekday.Saturday)
      weekdayCase("2019-07-28", 7u8, Stdlib.DateTime.Weekday.Sunday) ])


test weekdayFromNumberOutOfRange =
  Stdlib.Test.all(
    [ Stdlib.DateTime.Weekday.fromNumber(0u8) |> Stdlib.Test.equal(None)
      Stdlib.DateTime.Weekday.fromNumber(8u8) |> Stdlib.Test.equal(None)
      Stdlib.DateTime.Weekday.fromNumber(255u8) |> Stdlib.Test.equal(None) ])


test toString =
  Stdlib.display(d("2019-07-28T22:42:36Z"))
  |> Stdlib.Test.equal("2019-07-28T22:42:36Z")


test atStartOfDay =
  Stdlib.DateTime.atStartOfDay(d("2019-07-28T22:42:36Z"))
  |> Stdlib.Test.equal(d("2019-07-28T00:00:00Z"))


test toSeconds =
  Stdlib.Test.all(
    [ Stdlib.DateTime.toSeconds(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(1564353756)

      Stdlib.DateTime.toSeconds(d("2075-11-14T11:01:35Z"))
      |> Stdlib.Test.equal(3340954895) ])


// Every field padded, milliseconds only when there are some and truncated, never rounded, and the
// ends of the range.
test toStringEdges =
  let t(ticks: Int64): DateTime = Stdlib.DateTime.__fromTicks(ticks)
  Stdlib.Test.all(
    [ Stdlib.display(t(0)) |> Stdlib.Test.equal("1970-01-01T00:00:00Z")

      Stdlib.display(t(9999)) |> Stdlib.Test.equal("1970-01-01T00:00:00Z")

      Stdlib.display(t(10000)) |> Stdlib.Test.equal("1970-01-01T00:00:00.001Z")

      Stdlib.display(t(9999999))
      |> Stdlib.Test.equal("1970-01-01T00:00:00.999Z")

      Stdlib.display(t(-1)) |> Stdlib.Test.equal("1969-12-31T23:59:59.999Z")

      Stdlib.display(t(-10000000)) |> Stdlib.Test.equal("1969-12-31T23:59:59Z")

      Stdlib.display(t(2534023007999999999))
      |> Stdlib.Test.equal("9999-12-31T23:59:59.999Z")

      Stdlib.display(t(-621355968000000000))
      |> Stdlib.Test.equal("0001-01-01T00:00:00Z")

      Stdlib.display(d("2000-02-29T05:06:07.080Z"))
      |> Stdlib.Test.equal("2000-02-29T05:06:07.080Z")

      Stdlib.DateTime.toStringISO8601BasicDateTime(t(-1))
      |> Stdlib.Test.equal("19691231T235959Z")

      Stdlib.DateTime.toStringISO8601BasicDateTime(t(-621355968000000000))
      |> Stdlib.Test.equal("00010101T000000Z")

      Stdlib.DateTime.toStringISO8601BasicDateTime(t(2534023007999999999))
      |> Stdlib.Test.equal("99991231T235959Z")

      Stdlib.DateTime.toStringISO8601BasicDate(t(-1))
      |> Stdlib.Test.equal("19691231")

      Stdlib.DateTime.toStringISO8601BasicDate(t(-621355968000000000))
      |> Stdlib.Test.equal("00010101") ])


// Before year 1 the year is signed, as `format` writes it.
test basicFormatsBeforeYearOne =
  Stdlib.Test.all(
    [ Stdlib.DateTime.toStringISO8601BasicDateTime(civil(0, 1, 1))
      |> Stdlib.Test.equal("00000101T000000Z")

      Stdlib.DateTime.toStringISO8601BasicDate(civil(-1, 6, 15))
      |> Stdlib.Test.equal("-00010615") ])


test toStringISO8601BasicDateTime =
  Stdlib.Test.all(
    [ Stdlib.DateTime.toStringISO8601BasicDateTime(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal("20190728T224236Z")

      Stdlib.DateTime.toStringISO8601BasicDateTime(d("1919-07-28T22:42:36Z"))
      |> Stdlib.Test.equal("19190728T224236Z") ])


test toStringISO8601BasicDate =
  Stdlib.Test.all(
    [ Stdlib.DateTime.toStringISO8601BasicDate(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal("20190728")

      Stdlib.DateTime.toStringISO8601BasicDate(d("1069-07-28T22:42:36Z"))
      |> Stdlib.Test.equal("10690728") ])


test secondsRoundTrip =
  Stdlib.Test.all(
    [ 1095379198
      |> Stdlib.DateTime.fromSeconds
      |> Stdlib.DateTime.toSeconds
      |> Stdlib.Test.equal(1095379198)

      d("2019-07-28T22:42:36Z")
      |> Stdlib.DateTime.toSeconds
      |> Stdlib.DateTime.fromSeconds
      |> Stdlib.display
      |> Stdlib.Test.equal("2019-07-28T22:42:36Z") ])


// seconds whose ticks are past Int64 can't be represented; surface a Dark error
test fromSecondsPastInt64Raises =
  2 ** 62 |> Stdlib.DateTime.fromSeconds
  => raises "Seconds out of DateTime range (-9998-01-01 to 9999-12-31): 4611686018427387904"


// Int64.MaxValue fits int64 but is past NodaTime's instant range; the host
// exception is turned into a Dark error rather than escaping
test fromSecondsPastInstantRangeRaises =
  9223372036854775807 |> Stdlib.DateTime.fromSeconds
  => raises "Seconds out of DateTime range (-9998-01-01 to 9999-12-31): 9223372036854775807"


test addSecondsPastInstantRangeRaises =
  Stdlib.DateTime.addSeconds(Stdlib.DateTime.fromSeconds(0), 9223372036854775807)
  => raises "Seconds out of DateTime range (-9998-01-01 to 9999-12-31): 9223372036854775807"


test fromMillisecondsPastInstantRangeRaises =
  Stdlib.DateTime.fromMilliseconds(-9223372036854775807)
  => raises "Milliseconds out of DateTime range (-9998-01-01 to 9999-12-31): -9223372036854775807"


test fromTicksPastInstantRangeRaises =
  Stdlib.DateTime.__fromTicks(9223372036854775807)
  => raises "Ticks out of DateTime range (-9998-01-01 to 9999-12-31): 9223372036854775807"


// The first and last DateTimes: -9998-01-01T00:00:00Z and 9999-12-31T23:59:59.9999999Z
let first(): DateTime =
  Stdlib.DateTime.__fromTicks(-3776735808000000000)


let last(): DateTime =
  Stdlib.DateTime.__fromTicks(2534023007999999999)


let ok(date: DateTime): Stdlib.Result.Result<DateTime, Stdlib.Math.Overflow> =
  Ok(date)


/// The checked fns return what the unchecked ones do, inside the DateTime range
test checkedInRange =
  let date = d("2020-11-26T04:37:46Z")
  Stdlib.Test.all(
    [ Stdlib.DateTime.checkedAddSeconds(date, 1000000)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.addSeconds(date, 1000000)))

      Stdlib.DateTime.checkedAddSeconds(date, -10)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.addSeconds(date, -10)))

      Stdlib.DateTime.checkedSubtractSeconds(date, 1000000)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.subtractSeconds(date, 1000000)))

      Stdlib.DateTime.checkedFromSeconds(1095379198)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.fromSeconds(1095379198)))

      Stdlib.DateTime.checkedFromSeconds(-1)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.fromSeconds(-1)))

      Stdlib.DateTime.checkedAddMilliseconds(date, 1500)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.addMilliseconds(date, 1500)))

      Stdlib.DateTime.checkedSubtractMilliseconds(date, 1500)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.subtractMilliseconds(date, 1500)))

      Stdlib.DateTime.checkedFromMilliseconds(1095379198123)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.fromMilliseconds(1095379198123)))

      // the edges themselves
      Stdlib.DateTime.checkedFromSeconds(-377673580800)
      |> Stdlib.Test.equal(ok(first()))

      Stdlib.DateTime.checkedFromSeconds(253402300799)
      |> Stdlib.Test.equal(ok(Stdlib.DateTime.fromSeconds(253402300799)))

      Stdlib.DateTime.checkedFromMilliseconds(-377673580800000)
      |> Stdlib.Test.equal(ok(first()))

      Stdlib.DateTime.checkedFromMilliseconds(253402300799999)
      |> Stdlib.Test.equal(
        ok(Stdlib.DateTime.fromMilliseconds(253402300799999)))

      Stdlib.DateTime.checkedAddSeconds(first(), 0)
      |> Stdlib.Test.equal(ok(first()))

      Stdlib.DateTime.checkedSubtractMilliseconds(last(), 0)
      |> Stdlib.Test.equal(ok(last())) ])


/// ... and {{Error Overflow}} past either end, where the unchecked ones raise
test checkedPastTheRange =
  let overflow = Error(Stdlib.Math.Overflow.Overflow)
  let biggest = 9223372036854775807
  let smallest = -9223372036854775808
  Stdlib.Test.all(
    [ Stdlib.DateTime.checkedFromSeconds(-377673580801)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromSeconds(253402300800)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromSeconds(2 ** 62) |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromSeconds(biggest) |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromSeconds(smallest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromMilliseconds(-377673580800001)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromMilliseconds(253402300800000)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromMilliseconds(biggest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedFromMilliseconds(smallest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddSeconds(last(), 1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddSeconds(first(), -1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddSeconds(Stdlib.DateTime.fromSeconds(0), biggest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddSeconds(last(), smallest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedSubtractSeconds(first(), 1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedSubtractSeconds(last(), -1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedSubtractSeconds(first(), smallest)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddMilliseconds(last(), 1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedAddMilliseconds(first(), -1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedSubtractMilliseconds(first(), 1)
      |> Stdlib.Test.equal(overflow)

      Stdlib.DateTime.checkedSubtractMilliseconds(last(), smallest)
      |> Stdlib.Test.equal(overflow) ])


test todayIsCurrentUtcMidnight =
  let before = Stdlib.DateTime.atStartOfDay(Stdlib.DateTime.now())
  let today = Stdlib.DateTime.today()
  let after = Stdlib.DateTime.atStartOfDay(Stdlib.DateTime.now())
  Stdlib.Test.all(
    [ today == before || today == after |> Stdlib.Test.equal(true)
      Stdlib.DateTime.atStartOfDay(today) |> Stdlib.Test.equal(today) ])


test addSeconds =
  Stdlib.Test.all(
    [ a("2020-11-26T04:37:46Z", 0)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:46Z"))

      a("2020-11-26T04:37:46Z", 1)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:47Z"))

      a("2020-11-26T04:37:46Z", 10)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:56Z"))

      a("2020-11-26T04:37:46Z", 1000000)
      |> Stdlib.Test.equal(d("2020-12-07T18:24:26Z"))

      a("2020-11-26T04:37:46Z", -10)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:36Z")) ])


test subtractSeconds =
  Stdlib.Test.all(
    [ sub("2020-11-26T04:37:46Z", 0)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:46Z"))

      sub("2020-11-26T04:37:46Z", 1)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:45Z"))

      sub("2020-11-26T04:37:46Z", 10)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:36Z"))

      sub("2020-11-26T04:37:46Z", 1000000)
      |> Stdlib.Test.equal(d("2020-11-14T14:51:06Z"))

      sub("2020-11-26T04:37:46Z", -10)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:56Z")) ])


test sleepMillisecondsReturnsAtOnceForNoWait =
  Stdlib.Test.all(
    [ Stdlib.DateTime.__sleepMilliseconds(-5.0) |> Stdlib.Test.equal(())
      Stdlib.DateTime.__sleepMilliseconds(0.0 / 0.0) |> Stdlib.Test.equal(())
      Stdlib.DateTime.__sleepMilliseconds(0.5) |> Stdlib.Test.equal(()) ])


test subtract =
  Stdlib.Test.all(
    [ s("2020-11-26T04:37:46Z", "2020-11-26T04:37:46Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = 0 })

      s("2020-11-26T04:37:46Z", "2020-11-26T04:37:45Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = 1 })

      s("2020-11-26T04:37:46Z", "2020-11-26T04:37:36Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = 10 })

      s("2020-11-26T04:37:46Z", "2020-11-26T04:37:56Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = -10 })

      s("2020-11-26T04:37:46Z", "2020-11-14T14:51:06Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = 1000000 })

      s("2020-11-14T14:51:06Z", "2020-11-26T04:37:46Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = -1000000 })

      s("1921-01-01T12:00:00Z", "2021-01-01T12:00:00Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = -3155760000 })

      s("2021-01-01T12:00:00Z", "1921-01-01T12:00:00Z")
      |> Stdlib.Test.equal(Stdlib.Duration.Duration { seconds = 3155760000 }) ])


test daysBetween =
  let days(first: String, second: String): Int64 =
    Stdlib.DateTime.daysBetween(d(first), d(second))

  Stdlib.Test.all(
    [ days("2026-11-17T12:00:00Z", "2026-11-17T12:00:00Z")
      |> Stdlib.Test.equal(0)

      days("2026-11-18T12:00:00Z", "2026-11-17T12:00:00Z")
      |> Stdlib.Test.equal(1)

      days("2026-11-17T12:00:00Z", "2026-11-18T12:00:00Z")
      |> Stdlib.Test.equal(-1)

      days("2026-11-18T11:00:00Z", "2026-11-17T12:00:00Z")
      |> Stdlib.Test.equal(1)

      days("2026-11-17T12:00:00Z", "2026-11-18T11:00:00Z")
      |> Stdlib.Test.equal(-1)

      days("2026-11-17T23:59:59Z", "2026-11-17T00:00:00Z")
      |> Stdlib.Test.equal(0)

      days("2026-11-18T00:00:00Z", "2026-11-17T23:59:59Z")
      |> Stdlib.Test.equal(1)

      days("2026-11-18T13:00:00Z", "2026-11-17T12:00:00Z")
      |> Stdlib.Test.equal(1)

      days("2026-11-17T12:00:00Z", "2026-11-18T13:00:00Z")
      |> Stdlib.Test.equal(-1)

      days("1970-01-01T12:00:00Z", "1969-12-31T12:00:00Z")
      |> Stdlib.Test.equal(1)

      days("2026-11-17", "2026-11-20") |> Stdlib.Test.equal(-3)

      days("2024-03-01", "2024-02-28") |> Stdlib.Test.equal(2)

      days("2027-01-01", "2026-12-31") |> Stdlib.Test.equal(1)

      days("2026-11-18T01:00:00+02:00", "2026-11-17T23:00:00Z")
      |> Stdlib.Test.equal(0) ])


test daysBetweenAtMidnight =
  // Ticks are 100ns since 1970-01-01: check both sides of UTC midnight, including before 1970.
  let day = 864000000000
  let at(ticks: Int64): DateTime = Stdlib.DateTime.__fromTicks(ticks)
  let days(first: Int64, second: Int64): Int64 =
    Stdlib.DateTime.daysBetween(at(first), at(second))

  Stdlib.Test.all(
    [ days(day, 1) |> Stdlib.Test.equal(1)
      days(1, day) |> Stdlib.Test.equal(-1)
      days(day + 1, 1) |> Stdlib.Test.equal(1)
      days(1, day + 1) |> Stdlib.Test.equal(-1)
      days(0, -1) |> Stdlib.Test.equal(1)
      days(-1, 0) |> Stdlib.Test.equal(-1)
      days(-1, -day) |> Stdlib.Test.equal(0)
      days(-day, -1) |> Stdlib.Test.equal(0) ])


// Fractional seconds are now accepted
test parseMilliseconds =
  Stdlib.Test.all(
    [ p("2019-07-28T22:42:36.123Z")
      |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36.123Z"))

      p("2019-07-28T22:42:36.000Z")
      |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36Z"))

      p("2019-07-28T22:42:36.001Z")
      |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36.001Z"))

      p("2019-07-28T22:42:36.999Z")
      |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36.999Z"))

      // Fractional seconds with wrong digit count still rejected
      p("2019-07-28T22:42:36.1Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2019-07-28T22:42:36.12Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat))

      p("2019-07-28T22:42:36.1234Z")
      |> Stdlib.Test.equal(Error(Stdlib.DateTime.ParseError.InvalidFormat)) ])


test toMilliseconds =
  Stdlib.Test.all(
    [ Stdlib.DateTime.toMilliseconds(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(1564353756000)

      Stdlib.DateTime.toMilliseconds(d("1970-01-01T00:00:00Z"))
      |> Stdlib.Test.equal(0) ])


test fromMilliseconds =
  Stdlib.Test.all(
    [ 1564353756000
      |> Stdlib.DateTime.fromMilliseconds
      |> Stdlib.DateTime.toMilliseconds
      |> Stdlib.Test.equal(1564353756000)

      1564353756123
      |> Stdlib.DateTime.fromMilliseconds
      |> Stdlib.DateTime.toMilliseconds
      |> Stdlib.Test.equal(1564353756123)

      1564353756123
      |> Stdlib.DateTime.fromMilliseconds
      |> Stdlib.display
      |> Stdlib.Test.equal("2019-07-28T22:42:36.123Z")

      // Round-trip: ms -> DateTime -> ms
      0
      |> Stdlib.DateTime.fromMilliseconds
      |> Stdlib.DateTime.toMilliseconds
      |> Stdlib.Test.equal(0)

      -1000
      |> Stdlib.DateTime.fromMilliseconds
      |> Stdlib.DateTime.toMilliseconds
      |> Stdlib.Test.equal(-1000) ])


test millisecond =
  Stdlib.Test.all(
    [ Stdlib.DateTime.millisecond(dMs("2019-07-28T22:42:36.456Z"))
      |> Stdlib.Test.equal(456u16)

      Stdlib.DateTime.millisecond(dMs("2019-07-28T22:42:36.000Z"))
      |> Stdlib.Test.equal(0u16)

      Stdlib.DateTime.millisecond(d("2019-07-28T22:42:36Z"))
      |> Stdlib.Test.equal(0u16)

      Stdlib.DateTime.millisecond(dMs("2019-07-28T22:42:36.001Z"))
      |> Stdlib.Test.equal(1u16)

      Stdlib.DateTime.millisecond(dMs("2019-07-28T22:42:36.999Z"))
      |> Stdlib.Test.equal(999u16) ])


test addMilliseconds =
  Stdlib.Test.all(
    [ ams("2020-11-26T04:37:46Z", 0)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:46Z"))

      ams("2020-11-26T04:37:46Z", 500)
      |> Stdlib.DateTime.millisecond
      |> Stdlib.Test.equal(500u16)

      ams("2020-11-26T04:37:46Z", 1000)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:47Z"))

      ams("2020-11-26T04:37:46Z", 1500)
      |> Stdlib.display
      |> Stdlib.Test.equal("2020-11-26T04:37:47.500Z")

      ams("2020-11-26T04:37:46Z", -500)
      |> Stdlib.display
      |> Stdlib.Test.equal("2020-11-26T04:37:45.500Z") ])


test subtractMilliseconds =
  Stdlib.Test.all(
    [ sms("2020-11-26T04:37:46Z", 0)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:46Z"))

      sms("2020-11-26T04:37:46Z", 500)
      |> Stdlib.DateTime.millisecond
      |> Stdlib.Test.equal(500u16)

      sms("2020-11-26T04:37:46Z", 1000)
      |> Stdlib.Test.equal(d("2020-11-26T04:37:45Z"))

      sms("2020-11-26T04:37:46Z", -500)
      |> Stdlib.display
      |> Stdlib.Test.equal("2020-11-26T04:37:46.500Z") ])


test subtractMs =
  Stdlib.Test.all(
    [ sMs("2020-11-26T04:37:46Z", "2020-11-26T04:37:46Z")
      |> Stdlib.Test.equal(0)

      sMs("2020-11-26T04:37:46Z", "2020-11-26T04:37:45Z")
      |> Stdlib.Test.equal(1000)

      sMs("2020-11-26T04:37:46Z", "2020-11-26T04:37:56Z")
      |> Stdlib.Test.equal(-10000)

      sMs("2021-01-01T00:00:00Z", "2020-01-01T00:00:00Z")
      |> Stdlib.Test.equal(31622400000)

      Stdlib.DateTime.subtractMs(
        Stdlib.DateTime.__fromTicks(25000),
        Stdlib.DateTime.__fromTicks(0))
      |> Stdlib.Test.equal(2)

      Stdlib.DateTime.subtractMs(
        Stdlib.DateTime.__fromTicks(35000),
        Stdlib.DateTime.__fromTicks(0))
      |> Stdlib.Test.equal(4)

      Stdlib.DateTime.subtractMs(
        Stdlib.DateTime.__fromTicks(-25000),
        Stdlib.DateTime.__fromTicks(0))
      |> Stdlib.Test.equal(-2) ])


let f(date: DateTime): String =
  Stdlib.DateTime.format(date, "%Y-%m-%d %H:%M:%S.%f") |> Builtin.unwrap


let civil(year: Int64, month: Int64, day: Int64): DateTime =
  Stdlib.DateTime.__fromTicks(
    Stdlib.DateTime.__daysFromCivil(year, month, day)
    * Stdlib.DateTime.__ticksPerDay())


test format =
  Stdlib.Test.all(
    [ f(d("2019-07-28T22:42:36.500Z"))
      |> Stdlib.Test.equal("2019-07-28 22:42:36.500")

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "%d/%m/%Y at %H%M")
      |> Stdlib.Test.equal(Ok("28/07/2019 at 2242"))

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "")
      |> Stdlib.Test.equal(Ok(""))

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "%%Y is %Y, 100%%")
      |> Stdlib.Test.equal(Ok("%Y is 2019, 100%"))

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "at noon")
      |> Stdlib.Test.equal(Ok("at noon"))

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "HH:mm:ss")
      |> Stdlib.Test.equal(
        Error(
          "`HH:mm:ss` has no % directive, so it would print as written; the directives are %Y %m %d %H %M %S %f %%")) ])


test formatPadsEveryField =
  Stdlib.Test.all(
    [ f(d("0001-02-03T04:05:06.007Z"))
      |> Stdlib.Test.equal("0001-02-03 04:05:06.007")

      f(d("0099-01-01T00:00:00Z"))
      |> Stdlib.Test.equal("0099-01-01 00:00:00.000")

      f(d("9999-12-31T23:59:59.999Z"))
      |> Stdlib.Test.equal("9999-12-31 23:59:59.999")

      f(civil(0, 1, 1)) |> Stdlib.Test.equal("0000-01-01 00:00:00.000")

      f(civil(-1, 6, 15)) |> Stdlib.Test.equal("-0001-06-15 00:00:00.000")

      Stdlib.display(civil(-1, 6, 15))
      |> Stdlib.Test.equal("-0001-06-15T00:00:00Z")

      // the fraction is truncated to milliseconds, never rounded up into the next second
      f(Stdlib.DateTime.__fromTicks(9999999))
      |> Stdlib.Test.equal("1970-01-01 00:00:00.999") ])


test formatAcrossMonthAndYearEdges =
  Stdlib.Test.all(
    [ f(a("2019-01-31T23:59:59Z", 1))
      |> Stdlib.Test.equal("2019-02-01 00:00:00.000")

      f(a("2019-04-30T23:59:59Z", 1))
      |> Stdlib.Test.equal("2019-05-01 00:00:00.000")

      f(a("2019-12-31T23:59:59Z", 1))
      |> Stdlib.Test.equal("2020-01-01 00:00:00.000")

      f(a("1970-01-01T00:00:00Z", -1))
      |> Stdlib.Test.equal("1969-12-31 23:59:59.000")

      f(ams("1970-01-01T00:00:00Z", -1))
      |> Stdlib.Test.equal("1969-12-31 23:59:59.999") ])


test formatLeapYears =
  Stdlib.Test.all(
    [ f(a("2020-02-28T23:59:59Z", 1))
      |> Stdlib.Test.equal("2020-02-29 00:00:00.000")

      f(a("2020-02-29T23:59:59Z", 1))
      |> Stdlib.Test.equal("2020-03-01 00:00:00.000")

      f(a("2019-02-28T23:59:59Z", 1))
      |> Stdlib.Test.equal("2019-03-01 00:00:00.000")

      f(a("2000-02-28T23:59:59Z", 1))
      |> Stdlib.Test.equal("2000-02-29 00:00:00.000")

      f(a("1900-02-28T23:59:59Z", 1))
      |> Stdlib.Test.equal("1900-03-01 00:00:00.000") ])


test formatRejectsUnknownDirectives =
  Stdlib.Test.all(
    [ Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "%Y-%q")
      |> Stdlib.Test.equal(
        Error(
          "Unknown directive %q; the directives are %Y %m %d %H %M %S %f %%"))

      Stdlib.DateTime.format(d("2019-07-28T22:42:36Z"), "100%")
      |> Stdlib.Test.equal(
        Error("The pattern ends in a lone %; write %% for a literal %")) ])


// The clock and sleep syscalls behind now, monotonic time and sleep
test clockSyscalls =
  let interruptedOnce = fun(seconds, _) ->
    if seconds == 1 then
      (-4, Stdlib.Bytes.fromList(Stdlib.List.repeat(16, 0u8)))
    else
      (0, Stdlib.Bytes.empty)

  Stdlib.Test.all(
    [ match Builtin.syscallClockGettime(-1) with
      | Error(e) ->
        e |> Stdlib.Test.equal(if Stdlib.Cli.Posix.__abiMac() then 78 else 22)
      | Ok(_) -> Stdlib.Test.fail("clock_gettime(-1) should fail")

      Stdlib.Test.expect(
        Stdlib.DateTime.__monotonicMilliseconds() > 0,
        "monotonic clock is positive")

      Stdlib.DateTime.__sleepNanoseconds(0, 0) |> Stdlib.Test.equal(Ok())

      Stdlib.DateTime.__sleepNanoseconds(0, -1)
      |> Stdlib.Test.equal(Error(Stdlib.Cli.Posix.__fromErrno(22)))

      Stdlib.DateTime.__realtimeNanoseconds()
      |> Stdlib.Result.map(fun pair ->
        let (seconds, nanos) = pair
        seconds > 1700000000 && nanos >= 0 && nanos < 1000000000)
      |> Stdlib.Test.equal(Ok(true))

      // EINTR (-4) on the first call resumes with the remaining time
      Stdlib.DateTime.__sleepWith(interruptedOnce, 1, 0)
      |> Stdlib.Test.equal(Ok()) ])


// a delay of zero or less on the real clock returns at once
test realDelayNotPositive =
  Stdlib.Test.onRealClock(fun () ->
    [ Builtin.runtimeDelayTicks(0)
      Builtin.runtimeDelayTicks(-10000000)
      Builtin.runtimeDelayTicks(-9223372036854775808) ])
  |> Stdlib.Test.equal([ (), (), () ])


test weekdayAndMonthDisplay =
  Stdlib.Test.all(
    [ Stdlib.display(Stdlib.DateTime.Weekday.Monday)
      |> Stdlib.Test.equal("Monday")

      Stdlib.display(Stdlib.DateTime.Weekday.Sunday)
      |> Stdlib.Test.equal("Sunday")

      Stdlib.display(Stdlib.DateTime.Month.January)
      |> Stdlib.Test.equal("January")

      Stdlib.display(Stdlib.DateTime.Month.September)
      |> Stdlib.Test.equal("September")

      $"{Stdlib.DateTime.Weekday.Friday}, {Stdlib.DateTime.Month.March}"
      |> Stdlib.Test.equal("Friday, March") ])


let parts(
  year: Int64,
  month: Int64,
  day: Int64,
  hour: Int64,
  minute: Int64,
  second: Int64)
  : Stdlib.Result.Result<String, Stdlib.DateTime.FromPartsError> =
  Stdlib.DateTime.fromParts(year, month, day, hour, minute, second)
  |> Stdlib.Result.map(fun value -> Stdlib.display(value))


let outOfRange(
  part: Stdlib.DateTime.Part,
  value: Int64,
  min: Int64,
  max: Int64)
  : Stdlib.Result.Result<String, Stdlib.DateTime.FromPartsError> =
  Error(Stdlib.DateTime.FromPartsError.OutOfRange(part, value, min, max))


test fromParts =
  Stdlib.Test.all(
    [ parts(2019, 7, 28, 22, 42, 36)
      |> Stdlib.Test.equal(Ok("2019-07-28T22:42:36Z"))

      parts(1969, 12, 31, 23, 59, 59)
      |> Stdlib.Test.equal(Ok("1969-12-31T23:59:59Z"))

      parts(2024, 2, 29, 0, 0, 0)
      |> Stdlib.Test.equal(Ok("2024-02-29T00:00:00Z"))

      parts(2000, 2, 29, 0, 0, 0)
      |> Stdlib.Test.equal(Ok("2000-02-29T00:00:00Z"))

      parts(2023, 2, 29, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Day, 29, 1, 28))

      parts(1900, 2, 29, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Day, 29, 1, 28))

      parts(2024, 4, 31, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Day, 31, 1, 30))

      parts(2024, 13, 1, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Month, 13, 1, 12))

      parts(2024, 0, 1, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Month, 0, 1, 12))

      parts(2024, 1, 0, 0, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Day, 0, 1, 31))

      parts(2024, 1, 1, 24, 0, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Hour, 24, 0, 23))

      parts(2024, 1, 1, 0, 60, 0)
      |> Stdlib.Test.equal(outOfRange(Stdlib.DateTime.Part.Minute, 60, 0, 59))

      parts(2024, 1, 1, 0, 0, -1)
      |> Stdlib.Test.equal(
        outOfRange(Stdlib.DateTime.Part.Second, -1, 0, 59)) ])


test fromPartsAtTheEndsOfTheRange =
  Stdlib.Test.all(
    [ Stdlib.DateTime.fromParts(-9998, 1, 1, 0, 0, 0)
      |> Stdlib.Test.equal(ok(first()))

      parts(9999, 12, 31, 23, 59, 59)
      |> Stdlib.Test.equal(Ok("9999-12-31T23:59:59Z"))

      parts(-9999, 12, 31, 23, 59, 59)
      |> Stdlib.Test.equal(
        outOfRange(Stdlib.DateTime.Part.Year, -9999, -9998, 9999))

      parts(10000, 1, 1, 0, 0, 0)
      |> Stdlib.Test.equal(
        outOfRange(Stdlib.DateTime.Part.Year, 10000, -9998, 9999)) ])


test fromPartsErrorDisplay =
  Stdlib.DateTime.fromParts(2023, 2, 29, 0, 0, 0)
  |> Stdlib.Result.mapError(fun e -> Stdlib.display(e))
  |> Stdlib.Test.equal(Error("day 29 is out of range; it must be 1 to 28"))


test isLeapYear =
  Stdlib.Test.all(
    [ Stdlib.DateTime.isLeapYear(1900) |> Stdlib.Test.equal(false)
      Stdlib.DateTime.isLeapYear(2000) |> Stdlib.Test.equal(true)
      Stdlib.DateTime.isLeapYear(2023) |> Stdlib.Test.equal(false)
      Stdlib.DateTime.isLeapYear(2024) |> Stdlib.Test.equal(true) ])


test daysInMonth =
  Stdlib.Test.all(
    [ Stdlib.List.range(1, 12)
      |> Stdlib.List.map(fun month ->
        Stdlib.DateTime.daysInMonth(2023, month) |> Builtin.unwrap)
      |> Stdlib.Test.equal([ 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 ])

      Stdlib.DateTime.daysInMonth(2024, 2) |> Stdlib.Test.equal(Ok(29))

      Stdlib.DateTime.daysInMonth(1900, 2) |> Stdlib.Test.equal(Ok(28))

      Stdlib.DateTime.daysInMonth(2024, 13)
      |> Stdlib.Test.equal(
        Error(
          Stdlib.DateTime.FromPartsError.OutOfRange(
            Stdlib.DateTime.Part.Month,
            13,
            1,
            12)))

      Stdlib.DateTime.daysInMonth(2024, 0)
      |> Stdlib.Test.equal(
        Error(
          Stdlib.DateTime.FromPartsError.OutOfRange(
            Stdlib.DateTime.Part.Month,
            0,
            1,
            12))) ])


test addDays =
  Stdlib.Test.all(
    [ Stdlib.DateTime.addDays(d("2024-02-28T10:30:00Z"), 1)
      |> Stdlib.Test.equal(d("2024-02-29T10:30:00Z"))

      Stdlib.DateTime.addDays(d("2023-12-25T00:00:00Z"), 14)
      |> Stdlib.Test.equal(d("2024-01-08T00:00:00Z"))

      Stdlib.DateTime.addDays(d("1970-01-01T00:00:00Z"), -1)
      |> Stdlib.Test.equal(d("1969-12-31T00:00:00Z")) ])


test addMonths =
  Stdlib.Test.all(
    [ Stdlib.DateTime.addMonths(d("2024-01-31T09:15:00Z"), 1)
      |> Stdlib.Test.equal(d("2024-02-29T09:15:00Z"))

      Stdlib.DateTime.addMonths(d("2023-01-31T00:00:00Z"), 1)
      |> Stdlib.Test.equal(d("2023-02-28T00:00:00Z"))

      Stdlib.DateTime.addMonths(d("2024-11-15T00:00:00Z"), 3)
      |> Stdlib.Test.equal(d("2025-02-15T00:00:00Z"))

      Stdlib.DateTime.addMonths(d("2024-03-31T00:00:00Z"), -1)
      |> Stdlib.Test.equal(d("2024-02-29T00:00:00Z"))

      Stdlib.DateTime.addMonths(d("1970-01-15T00:00:00Z"), -13)
      |> Stdlib.Test.equal(d("1968-12-15T00:00:00Z"))

      Stdlib.DateTime.addMonths(d("2024-05-10T00:00:00Z"), 0)
      |> Stdlib.Test.equal(d("2024-05-10T00:00:00Z")) ])


let pw(
  text: String,
  pattern: String)
  : Stdlib.Result.Result<DateTime, Stdlib.DateTime.PatternParseError> =
  Stdlib.DateTime.parseWith(text, pattern)


let parsedAs(
  datestr: String)
  : Stdlib.Result.Result<DateTime, Stdlib.DateTime.PatternParseError> =
  Ok(d(datestr))


let mismatchAt(
  position: Int64,
  mismatch: Stdlib.DateTime.PatternMismatch)
  : Stdlib.Result.Result<DateTime, Stdlib.DateTime.PatternParseError> =
  Error(Stdlib.DateTime.PatternParseError.Mismatch(position, mismatch))


let invalidDate()
  : Stdlib.Result.Result<DateTime, Stdlib.DateTime.PatternParseError> =
  Error(Stdlib.DateTime.PatternParseError.InvalidDate)


test parseWith =
  Stdlib.Test.all(
    [ pw("2019-07-28T22:42:36Z", "%Y-%m-%dT%H:%M:%SZ")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T22:42:36Z"))

      pw("28/07/2019 at 2242", "%d/%m/%Y at %H%M")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T22:42:00Z"))

      pw("2019-7-8", "%Y-%m-%d") |> Stdlib.Test.equal(parsedAs("2019-07-08"))

      pw("100% 2019", "100%% %Y") |> Stdlib.Test.equal(parsedAs("2019-01-01"))

      // fields the pattern does not name come from the epoch
      pw("22:42", "%H:%M")
      |> Stdlib.Test.equal(parsedAs("1970-01-01T22:42:00Z"))

      pw("", "") |> Stdlib.Test.equal(parsedAs("1970-01-01T00:00:00Z")) ])


test parseWithOffset =
  Stdlib.Test.all(
    [ pw("2019-07-28T22:42:36+0200", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T20:42:36Z"))

      pw("2019-07-28T22:42:36-05:30", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(parsedAs("2019-07-29T04:12:36Z"))

      pw("2019-07-28T22:42:36Z", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T22:42:36Z"))

      // an offset can move the date across midnight and a year end
      pw("2020-01-01T01:00:00+0200", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(parsedAs("2019-12-31T23:00:00Z"))

      pw("2019-07-28T22:42:36+2", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(
        mismatchAt(19, Stdlib.DateTime.PatternMismatch.Field('z')))

      pw("2019-07-28T22:42:36+2500", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(invalidDate()) ])


test parseWithFraction =
  Stdlib.Test.all(
    [ pw("2019-07-28T22:42:36.5Z", "%Y-%m-%dT%H:%M:%S.%fZ")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T22:42:36.500Z"))

      pw("22:42:36.123456789", "%H:%M:%S.%f")
      |> Stdlib.Result.map(fun date ->
        Stdlib.DateTime.__mod(
          Stdlib.DateTime.__ticks(date),
          Stdlib.DateTime.__ticksPerSecond()))
      |> Stdlib.Test.equal(Ok(1234567)) ])


test parseWithRoundTripsFormat =
  Stdlib.Test.all(
    [ pw(f(d("2019-07-28T22:42:36.250Z")), "%Y-%m-%d %H:%M:%S.%f")
      |> Stdlib.Test.equal(parsedAs("2019-07-28T22:42:36.250Z"))

      // format writes years before 1 with a leading -
      pw(
        Stdlib.DateTime.format(civil(-5, 3, 1), "%Y-%m-%d") |> Builtin.unwrap,
        "%Y-%m-%d")
      |> Stdlib.Test.equal(Ok(civil(-5, 3, 1))) ])


test parseWithErrors =
  Stdlib.Test.all(
    [ pw("2019", "%Y-%q")
      |> Stdlib.Test.equal(
        Error(Stdlib.DateTime.PatternParseError.UnknownDirective("%q")))

      pw("2019", "%Y%")
      |> Stdlib.Test.equal(
        Error(Stdlib.DateTime.PatternParseError.UnknownDirective("%")))

      // the pattern is checked before the text, so its error wins
      pw("nope", "%Y-%q")
      |> Stdlib.Test.equal(
        Error(Stdlib.DateTime.PatternParseError.UnknownDirective("%q")))

      // a second %d could hide an impossible first one
      pw("2024-02-30/28", "%Y-%m-%d/%d")
      |> Stdlib.Test.equal(
        Error(Stdlib.DateTime.PatternParseError.RepeatedDirective("%d")))

      pw("2024-02-28/28", "%Y-%m-%d/%d")
      |> Stdlib.Test.equal(
        Error(Stdlib.DateTime.PatternParseError.RepeatedDirective("%d")))

      // %% is a literal, not a field, so it may repeat
      pw("%2019%", "%%%Y%%") |> Stdlib.Test.equal(Ok(civil(2019, 1, 1)))

      // fields read as many digits as they can: %d takes "21", leaving nothing for the 1
      pw("04-21", "%m-%d1")
      |> Stdlib.Test.equal(
        mismatchAt(5, Stdlib.DateTime.PatternMismatch.Literal('1', None)))

      pw("0415", "%m%d") |> Stdlib.Test.equal(Ok(civil(1970, 4, 15)))

      // but stop before a digit that would make the field too large: 91 is no hour
      pw("915", "%H%M") |> Stdlib.Test.equal(Ok(d("1970-01-01T09:15:00Z")))

      pw("45", "%m%d") |> Stdlib.Test.equal(Ok(civil(1970, 4, 5)))

      // At the boundary: 2 could start an hour from 20 to 23, so %H reads the next digit
      // whatever it is, as C's strptime does. 23 is an hour; 24 is not, and is not 02.
      pw("235", "%H%M") |> Stdlib.Test.equal(Ok(d("1970-01-01T23:05:00Z")))

      pw("245", "%H%M") |> Stdlib.Test.equal(invalidDate())

      pw("2019/07/28", "%Y-%m-%d")
      |> Stdlib.Test.equal(
        mismatchAt(4, Stdlib.DateTime.PatternMismatch.Literal('-', Some('/'))))

      pw("2019--28", "%Y-%m-%d")
      |> Stdlib.Test.equal(
        mismatchAt(5, Stdlib.DateTime.PatternMismatch.Field('m')))

      pw("2019-07-28x", "%Y-%m-%d")
      |> Stdlib.Test.equal(
        mismatchAt(10, Stdlib.DateTime.PatternMismatch.TrailingText('x')))

      pw("2019-07", "%Y-%m-%d")
      |> Stdlib.Test.equal(
        mismatchAt(7, Stdlib.DateTime.PatternMismatch.Literal('-', None)))

      pw("2019-02-30", "%Y-%m-%d") |> Stdlib.Test.equal(invalidDate())

      pw("2019-13-01", "%Y-%m-%d") |> Stdlib.Test.equal(invalidDate())

      pw("2019-07-28 24:00", "%Y-%m-%d %H:%M")
      |> Stdlib.Test.equal(invalidDate())

      // %M stops at 6, since 60 is no minute, leaving the 0 unmatched
      pw("2019-07-28 23:60", "%Y-%m-%d %H:%M")
      |> Stdlib.Test.equal(
        mismatchAt(15, Stdlib.DateTime.PatternMismatch.TrailingText('0')))

      // in range as written, past 9999-12-31 once the offset is applied
      pw("9999-12-31T23:00:00-0200", "%Y-%m-%dT%H:%M:%S%z")
      |> Stdlib.Test.equal(invalidDate())

      pw("-9999-12-31", "%Y-%m-%d") |> Stdlib.Test.equal(invalidDate())

      Stdlib.display(Stdlib.DateTime.PatternParseError.RepeatedDirective("%d"))
      |> Stdlib.Test.equal("The pattern uses %d more than once") ])


test parseWithMismatchMessages =
  Stdlib.Test.all(
    [ pw("2019/07/28", "%Y-%m-%d")
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("Expected '-' at character 5, found '/'"))

      pw("2019-07", "%Y-%m-%d")
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(
        Error("Expected '-' at character 8, found end of text"))

      pw("2019-07-28x", "%Y-%m-%d")
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(
        Error("Expected end of text at character 11, found 'x'"))

      pw("2019--28", "%Y-%m-%d")
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("Could not read %m starting at character 6"))

      pw("100\n", "100%%")
      |> Stdlib.Result.mapError(Stdlib.display)
      |> Stdlib.Test.equal(Error("Expected '%' at character 4, found '\\n'")) ])
