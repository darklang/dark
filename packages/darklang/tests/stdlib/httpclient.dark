// Additional HTTP client cases. Raw protocol tests live in backend/testfiles/httpclient.
module Darklang.Stdlib.HttpClient.Tests

// Tests that don't use the internet
test requestErrorHasToString =
  let network(failure: Stdlib.HttpClient.NetworkFailure): String =
    Stdlib.display(Stdlib.HttpClient.RequestError.NetworkError(failure))

  Stdlib.Test.all(
    [ Stdlib.display(Stdlib.HttpClient.RequestError.Timeout)
      |> Stdlib.Test.equal("Timeout")

      Stdlib.display(Stdlib.HttpClient.RequestError.TlsError("bad certificate"))
      |> Stdlib.Test.equal("bad certificate")

      network(
        Stdlib.HttpClient.NetworkFailure.DnsFailure(
          Stdlib.HttpClient.NetworkTarget.Destination("example.invalid")))
      |> Stdlib.Test.equal("Could not resolve host: example.invalid")

      network(
        Stdlib.HttpClient.NetworkFailure.DnsFailure(
          Stdlib.HttpClient.NetworkTarget.Proxy("proxy.invalid")))
      |> Stdlib.Test.equal("Could not resolve host: proxy proxy.invalid")

      network(
        Stdlib.HttpClient.NetworkFailure.ConnectionFailure(
          Stdlib.HttpClient.NetworkTarget.Destination("example.com:8080"),
          Stdlib.Option.Option.Some("Connection refused")))
      |> Stdlib.Test.equal(
        "Could not connect to example.com:8080: Connection refused")

      network(
        Stdlib.HttpClient.NetworkFailure.ConnectionFailure(
          Stdlib.HttpClient.NetworkTarget.Proxy("localhost:8080"),
          Stdlib.Option.Option.None))
      |> Stdlib.Test.equal("Could not connect to proxy localhost:8080")

      network(
        Stdlib.HttpClient.NetworkFailure.IoFailure(
          "example.com",
          "connection reset"))
      |> Stdlib.Test.equal("Request to example.com failed: connection reset") ])


test contentTypes =
  Stdlib.Test.all(
    [ Stdlib.HttpClient.ContentType.form
      |> Stdlib.Test.equal(
        ("content-type", "application/x-www-form-urlencoded"))

      Stdlib.HttpClient.ContentType.json
      |> Stdlib.Test.equal(("content-type", "application/json"))

      Stdlib.HttpClient.ContentType.plainText
      |> Stdlib.Test.equal(("content-type", "text/plain; charset=utf-8"))

      Stdlib.HttpClient.ContentType.html
      |> Stdlib.Test.equal(("content-type", "text/html; charset=utf-8")) ])


test bearerToken =
  Stdlib.HttpClient.bearerToken("YWxhZGRpbjpvcGVuc2VzYW1l")
  |> Stdlib.Test.equal(("authorization", "bearer YWxhZGRpbjpvcGVuc2VzYW1l"))


test basicAuth =
  Stdlib.Test.all(
    [ Stdlib.HttpClient.basicAuth("username", "password")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(
          ("authorization", "basic dXNlcm5hbWU6cGFzc3dvcmQ=")))

      Stdlib.HttpClient.basicAuth("", "")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic Og==")))

      Stdlib.HttpClient.basicAuth("", "-")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic Oi0=")))

      Stdlib.HttpClient.basicAuth(":", "")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic Ojo=")))

      Stdlib.HttpClient.basicAuth("", ":")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic Ojo=")))

      Stdlib.HttpClient.basicAuth("hello>", "world")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic aGVsbG8+Ondvcmxk")))

      Stdlib.HttpClient.basicAuth("hello", "world?")
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(("authorization", "basic aGVsbG86d29ybGQ/"))) ])


test basicAuthRejectsHyphenInUsername =
  Stdlib.HttpClient.basicAuth("-", "")
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Error("Username cannot contain a hyphen"))


// Tests that try to make requests to the internet
// ... but first, some helpers
type GetResult =
  Stdlib.Result.Result<
    Stdlib.HttpClient.Response<Bytes>,
    Stdlib.HttpClient.RequestError>


let get(url: String, headers: List<(String * String)>): GetResult =
  Stdlib.HttpClient.get(url, headers)


// Build custom values in functions so their types stay current across package reloads.
let errInvalidHost(): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.InvalidHost))


let errInvalidUri(): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.InvalidUri))


let errInvalidRequest(): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.InvalidRequest))


let errNetworkError(host: String): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.NetworkError(
      Stdlib.HttpClient.NetworkFailure.ConnectionFailure(
        Stdlib.HttpClient.NetworkTarget.Destination(host),
        Stdlib.Option.Option.None)))


let errBadHeaderEmptyKey(): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.BadHeader(
      Stdlib.HttpClient.BadHeader.EmptyKey))


let errBadHeader(e: Stdlib.HttpClient.BadHeader): GetResult =
  Stdlib.Result.Result.Error(Stdlib.HttpClient.RequestError.BadHeader(e))


let errBadMethod(): GetResult =
  Stdlib.Result.Result.Error(Stdlib.HttpClient.RequestError.BadMethod)


let errUnsupportedProtocol(): GetResult =
  Stdlib.Result.Result.Error(
    Stdlib.HttpClient.RequestError.BadUrl(
      Stdlib.HttpClient.BadUrlDetails.UnsupportedProtocol))


