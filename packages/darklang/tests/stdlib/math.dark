/// Cases ported from `backend/testfiles/execution/stdlib/math.dark`.
module Darklang.Stdlib.Math.Tests

// Differs from legacy: legacy's runner compared floats approximately (absolute
// tolerance 1e-12, relative 1e-9), and these expected values are rounded, so they
// are checked with `near`. Its tolerances are at least as strict: 1e-12 for zero,
// and 1e-10 otherwise, where every expected magnitude here is at least 0.5.
let near (actual: Float) (expected: Float) : Stdlib.Test.Result =
  let tolerance = if expected == 0.0 then 0.000000000001 else 0.0000000001
  (Stdlib.abs (actual - expected) < tolerance) |> Stdlib.Test.equal true

let nearSome
  (actual: Stdlib.Option.Option<Float>)
  (expected: Float)
  : Stdlib.Test.Result =
  match actual with
  | Some value -> near value expected
  | None -> Stdlib.Test.fail "expected Some Float, got None"

test constants =
  Stdlib.Test.all
    [ Stdlib.Math.pi |> near 3.14159265359
      Stdlib.Math.e |> near 2.71828182846
      Stdlib.Math.tau |> near (2.0 * Stdlib.Math.pi) ]

test degreesAndRadians =
  Stdlib.Test.all
    [ Stdlib.Math.degrees -180.0 |> near (-Stdlib.Math.pi)
      Stdlib.Math.degrees 360.0 |> near (2.0 * Stdlib.Math.pi)
      Stdlib.Math.radians (-3.141592653589793) |> near (-Stdlib.Math.pi)
      Stdlib.Math.radians 6.283185307179586 |> near (2.0 * Stdlib.Math.pi) ]

test trigonometry =
  Stdlib.Test.all
    [ Stdlib.Math.sin (Stdlib.Math.pi / 2.0) |> near 1.0
      Stdlib.Math.sin 0.0 |> near 0.0
      Stdlib.Math.cos 0.0 |> near 1.0
      Stdlib.Math.cos Stdlib.Math.pi |> near (-1.0)
      Stdlib.Math.tan (Stdlib.Math.pi / 4.0) |> near 1.0
      Stdlib.Math.tan 0.0 |> near 0.0
      Stdlib.Math.atan 0.0 |> near 0.0
      Stdlib.Math.atan 1.0 |> near 0.785398163397 ]

test inverseTrigonometry =
  Stdlib.Test.all
    [ Stdlib.Math.asin 0.0 |> nearSome 0.0
      Stdlib.Math.asin 1.0 |> nearSome 1.57079632679
      Stdlib.Math.asin 5.0 |> Stdlib.Test.equal None
      Stdlib.Math.acos -1.0 |> nearSome 3.14159265359
      Stdlib.Math.acos 1.0 |> nearSome 0.0
      Stdlib.Math.acos 5.0 |> Stdlib.Test.equal None ]

test atan2 =
  Stdlib.Test.all
    [ Stdlib.Math.atan2 -1.0 -1.0 |> near (-2.35619449019)
      Stdlib.Math.atan2 -1.0 1.0 |> near (-0.785398163397)
      Stdlib.Math.atan2 0.0 1.0 |> near 0.0
      Stdlib.Math.atan2 1.0 -1.0 |> near 2.35619449019
      Stdlib.Math.atan2 1.0 1.0 |> near 0.785398163397 ]

test hyperbolic =
  Stdlib.Test.all
    [ Stdlib.Math.cosh 0.0 |> near 1.0
      Stdlib.Math.sinh 0.0 |> near 0.0
      Stdlib.Math.sinh 1.0 |> near 1.17520119364
      Stdlib.Math.tanh 0.0 |> near 0.0 ]

test turns =
  Stdlib.Test.all
    [ Stdlib.Math.turns (-0.5) |> near (-Stdlib.Math.pi)
      Stdlib.Math.turns 1.0 |> near (2.0 * Stdlib.Math.pi) ]
