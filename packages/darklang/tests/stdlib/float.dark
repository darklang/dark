module Darklang.Stdlib.Float.Tests

let nan () : Float = 0.0 / 0.0
let infinity () : Float = 1.0 / 0.0
let negativeInfinity () : Float = -1.0 / 0.0

test add =
  (1.2 + 1.3) |> Stdlib.Test.equal 2.5

test ceiling =
  Stdlib.Test.all
    [ Stdlib.Float.ceiling 1.3 |> Stdlib.Test.equal 2
      Stdlib.Float.ceiling 1.0000001 |> Stdlib.Test.equal 2
      Stdlib.Float.ceiling -2147483647.8 |> Stdlib.Test.equal -2147483647
      Stdlib.Float.ceiling 2147483647.0 |> Stdlib.Test.equal 2147483647
      Stdlib.Float.ceiling 0000000.1 |> Stdlib.Test.equal 1
      Stdlib.Float.ceiling 0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.ceiling 17.55042081 |> Stdlib.Test.equal 18 ]

test roundUp =
  Stdlib.Test.all
    [ Stdlib.Float.roundUp 1.3 |> Stdlib.Test.equal 2
      Stdlib.Float.roundUp 1.0000001 |> Stdlib.Test.equal 2
      Stdlib.Float.roundUp -2147483647.8 |> Stdlib.Test.equal -2147483647
      Stdlib.Float.roundUp 2147483647.0 |> Stdlib.Test.equal 2147483647
      Stdlib.Float.roundUp 0000000.1 |> Stdlib.Test.equal 1
      Stdlib.Float.roundUp 0.0 |> Stdlib.Test.equal 0 ]

test floor =
  Stdlib.Test.all
    [ Stdlib.Float.floor 1.8 |> Stdlib.Test.equal 1
      Stdlib.Float.floor -1.0000001 |> Stdlib.Test.equal -2
      Stdlib.Float.floor -2147483647.8 |> Stdlib.Test.equal -2147483648
      Stdlib.Float.floor 2147483647.0 |> Stdlib.Test.equal 2147483647
      Stdlib.Float.floor 0000000.1 |> Stdlib.Test.equal 0
      Stdlib.Float.floor 0.0 |> Stdlib.Test.equal 0 ]

test roundDown =
  Stdlib.Test.all
    [ Stdlib.Float.roundDown 1.8 |> Stdlib.Test.equal 1
      Stdlib.Float.roundDown -1.0000001 |> Stdlib.Test.equal -2
      Stdlib.Float.roundDown -2147483647.8 |> Stdlib.Test.equal -2147483648
      Stdlib.Float.roundDown 2147483647.0 |> Stdlib.Test.equal 2147483647
      Stdlib.Float.roundDown 0000000.1 |> Stdlib.Test.equal 0
      Stdlib.Float.roundDown 0.0 |> Stdlib.Test.equal 0 ]

test round =
  Stdlib.Test.all
    [ Stdlib.Float.round -2147483647.8 |> Stdlib.Test.equal -2147483648
      Stdlib.Float.round 0000000.1 |> Stdlib.Test.equal 0
      Stdlib.Float.round 2147483647.000009 |> Stdlib.Test.equal 2147483647 ]

test truncate =
  Stdlib.Test.all
    [ Stdlib.Float.truncate -2367.9267 |> Stdlib.Test.equal -2367
      Stdlib.Float.truncate 000000.9 |> Stdlib.Test.equal 0
      Stdlib.Float.truncate -000000.9 |> Stdlib.Test.equal 0
      Stdlib.Float.truncate 0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.truncate 2147483647.000009 |> Stdlib.Test.equal 2147483647 ]

// NaN / Infinity have no Int representation -> Dark error, not a host crash
test ceilingRejectsNan =
  Stdlib.Float.ceiling (nan ())
  => raises "Encountered out-of-range value for type of Int"

test roundUpRejectsInfinity =
  Stdlib.Float.roundUp (infinity ())
  => raises "Encountered out-of-range value for type of Int"

test floorRejectsNegativeInfinity =
  Stdlib.Float.floor (negativeInfinity ())
  => raises "Encountered out-of-range value for type of Int"

test roundDownRejectsNan =
  Stdlib.Float.roundDown (nan ())
  => raises "Encountered out-of-range value for type of Int"

test roundRejectsInfinity =
  Stdlib.Float.round (infinity ())
  => raises "Encountered out-of-range value for type of Int"

test truncateRejectsNan =
  Stdlib.Float.truncate (nan ())
  => raises "Encountered out-of-range value for type of Int"

test roundTowardsZeroRejectsNegativeInfinity =
  Stdlib.Float.roundTowardsZero (negativeInfinity ())
  => raises "Encountered out-of-range value for type of Int"

test isFinite =
  Stdlib.Test.all
    [ Stdlib.Float.isFinite 0.0 |> Stdlib.Test.equal true
      Stdlib.Float.isFinite -3.9 |> Stdlib.Test.equal true
      Stdlib.Float.isFinite (nan ()) |> Stdlib.Test.equal false
      Stdlib.Float.isFinite (infinity ()) |> Stdlib.Test.equal false
      Stdlib.Float.isFinite (negativeInfinity ()) |> Stdlib.Test.equal false ]

test absoluteValue =
  Stdlib.Test.all
    [ Stdlib.abs (negativeInfinity ())
      |> Stdlib.Test.equal (infinity ())
      // NaN never equals itself; check it with isNaN.
      Stdlib.abs (nan ()) |> Stdlib.Float.isNaN
      |> Stdlib.Test.equal true
      Stdlib.abs -5.6 |> Stdlib.Test.equal 5.6
      Stdlib.abs -0.0 |> Stdlib.Test.equal 0.0 ]

test negate =
  Stdlib.Test.all
    [ // NaN never equals itself; check it with isNaN.
      (-(nan ())) |> Stdlib.Float.isNaN |> Stdlib.Test.equal true
      (-(infinity ())) |> Stdlib.Test.equal (negativeInfinity ())
      (--5.6) |> Stdlib.Test.equal 5.6
      (-5.6) |> Stdlib.Test.equal -5.6
      (-0.0) |> Stdlib.Test.equal -0.0
      (--0.0) |> Stdlib.Test.equal 0.0 ]

test clamp =
  Stdlib.Test.all
    [ Stdlib.Float.clampRefusingNaN (infinity ()) -1.0 0.5
      |> Stdlib.Test.equal (Ok 0.5)
      Stdlib.Float.clampRefusingNaN (negativeInfinity ()) -1.0 0.5
      |> Stdlib.Test.equal (Ok -1.0)
      // NaN never equals itself; check it with isNaN.
      Stdlib.Float.clampRefusingNaN (nan ()) -1.0 1.0
      |> Stdlib.Result.map Stdlib.Float.isNaN
      |> Stdlib.Test.equal (Ok true)
      Stdlib.Float.clampRefusingNaN 0.5 (infinity ()) 1.0
      |> Stdlib.Test.equal (Ok 1.0)
      Stdlib.Float.clampRefusingNaN 0.5 (negativeInfinity ()) 1.0
      |> Stdlib.Test.equal (Ok 0.5)
      Stdlib.Float.clampRefusingNaN 0.5 (nan ()) 1.0
      |> Stdlib.Test.equal
        (Error "clampRefusingNaN requires limits that are numbers")
      Stdlib.Float.clampRefusingNaN -1.0 0.5 (infinity ())
      |> Stdlib.Test.equal (Ok 0.5)
      Stdlib.Float.clampRefusingNaN -1.0 0.5 (negativeInfinity ())
      |> Stdlib.Test.equal (Ok -1.0)
      Stdlib.Float.clampRefusingNaN 0.5 1.0 (nan ())
      |> Stdlib.Test.equal
        (Error "clampRefusingNaN requires limits that are numbers")
      Stdlib.Float.clampRefusingNaN -2.0 -5.0 5.0
      |> Stdlib.Test.equal (Ok -2.0)
      Stdlib.Float.clampRefusingNaN -3.0 -2.0 1.0
      |> Stdlib.Test.equal (Ok -2.0)
      Stdlib.Float.clampRefusingNaN -5.0 1.0 1.0
      |> Stdlib.Test.equal (Ok 1.0)
      Stdlib.Float.clampRefusingNaN 1.0 2.0 1.0
      |> Stdlib.Test.equal (Ok 1.0)
      Stdlib.Float.clampRefusingNaN 3.0 0.0 2.0
      |> Stdlib.Test.equal (Ok 2.0) ]

test divide =
  Stdlib.Test.all
    [ (9.0 / 2.0) |> Stdlib.Test.equal 4.5
      (9.0 / 0.0) |> Stdlib.Test.equal (infinity ())
      (9.0 / (-0.0)) |> Stdlib.Test.equal (negativeInfinity ()) ]

// Compare the exact floating-point results.
test divisionOperator =
  Stdlib.Test.all
    [ 9.0 / 2.0 |> Stdlib.Test.equal 4.5
      17.0 / 3.3 |> Stdlib.Test.equal 5.151515151515151
      -8.74 / 5.351 |> Stdlib.Test.equal -1.633339562698561
      0.0 / 1.0 |> Stdlib.Test.equal 0.0
      1.0 / 0.0 |> Stdlib.Test.equal (infinity ()) ]

test comparisons =
  Stdlib.Test.all
    [ (0.1 >= 0.1) |> Stdlib.Test.equal true
      (0.2 > 0.1) |> Stdlib.Test.equal true
      (0.1 <= 0.1) |> Stdlib.Test.equal true
      (0.2 < 0.1) |> Stdlib.Test.equal false ]

test max =
  Stdlib.Test.all
    [ Stdlib.max (infinity ()) 1.0 |> Stdlib.Test.equal (infinity ())
      Stdlib.max (negativeInfinity ()) 1.0 |> Stdlib.Test.equal 1.0
      Stdlib.max -10.0 1.0 |> Stdlib.Test.equal 1.0
      // NaN never equals itself; check it with isNaN.
      Stdlib.max 10.0 (nan ()) |> Stdlib.Float.isNaN |> Stdlib.Test.equal true
      Stdlib.max 10.0 1.0 |> Stdlib.Test.equal 10.0
      Stdlib.max 0.0 0.00 |> Stdlib.Test.equal 0.0
      Stdlib.max -2147483647.8 -00000000.000 |> Stdlib.Test.equal 0.0
      Stdlib.max 2147483647.0 00000000.000
      |> Stdlib.Test.equal 2147483647.0 ]

test min =
  Stdlib.Test.all
    [ Stdlib.min (infinity ()) 1.0 |> Stdlib.Test.equal 1.0
      Stdlib.min (negativeInfinity ()) 1.0
      |> Stdlib.Test.equal (negativeInfinity ())
      Stdlib.min -10.0 1.0 |> Stdlib.Test.equal -10.0
      // NaN never equals itself; check it with isNaN.
      Stdlib.min 10.0 (nan ()) |> Stdlib.Float.isNaN |> Stdlib.Test.equal true
      Stdlib.min 10.0 1.0 |> Stdlib.Test.equal 1.0
      Stdlib.min 0.0 0.00 |> Stdlib.Test.equal 0.0
      Stdlib.min -2147483647.8 -00000000.000
      |> Stdlib.Test.equal -2147483647.8
      Stdlib.min 2147483647.0 00000000.000 |> Stdlib.Test.equal 0.0 ]

test multiply =
  (26.0 * 0.5) |> Stdlib.Test.equal 13.0

test parse =
  Stdlib.Test.all
    [ Stdlib.Float.parse "1.5" |> Stdlib.Test.equal (Ok 1.5)
      Stdlib.Float.parse "0.0" |> Stdlib.Test.equal (Ok 0.0)
      Stdlib.Float.parse "-0.5" |> Stdlib.Test.equal (Ok -0.5)
      Stdlib.Float.parse "+0.5" |> Stdlib.Test.equal (Ok 0.5)
      Stdlib.Float.parse ".5" |> Stdlib.Test.equal (Ok 0.5)
      Stdlib.Float.parse "0.6999999999999999555910790149937383830547332763671875"
      |> Stdlib.Test.equal (Ok 0.7)
      Stdlib.Float.parse "-0.6999999999999999555910790149937383830547332763671875"
      |> Stdlib.Test.equal (Ok -0.7)
      Stdlib.Float.parse "0.7999999999"
      |> Stdlib.Test.equal (Ok 0.7999999999)
      Stdlib.Float.parse "0.79999"
      |> Stdlib.Test.equal (Ok 0.79999)
      Stdlib.Float.parse "-55555555555555555555555555555.5"
      |> Stdlib.Test.equal (Ok -55555555555555555555555555555.5)
      Stdlib.Float.parse "-141s"
      |> Stdlib.Test.equal (Error Stdlib.Float.ParseError.BadFormat)
      Stdlib.Float.parse ""
      |> Stdlib.Test.equal (Error Stdlib.Float.ParseError.BadFormat)
      Stdlib.Float.parse "-5.55555555556e+28"
      |> Stdlib.Test.equal (Ok -55555555555600000000000000000.0)
      Stdlib.Float.parse "-1.8E+308"
      |> Stdlib.Test.equal (Ok (negativeInfinity ()))
      Stdlib.Float.parse "1.8E+308"
      |> Stdlib.Test.equal (Ok (infinity ())) ]

test power =
  Stdlib.Test.all
    [ (4.0 ** (-0.5)) |> Stdlib.Test.equal 0.5
      (4.0 ** 0.5) |> Stdlib.Test.equal 2.0 ]

test roundTowardsZero =
  Stdlib.Test.all
    [ Stdlib.Float.roundTowardsZero -2367.9267 |> Stdlib.Test.equal -2367
      Stdlib.Float.roundTowardsZero 000000.9 |> Stdlib.Test.equal 0
      Stdlib.Float.roundTowardsZero -000000.9 |> Stdlib.Test.equal 0
      Stdlib.Float.roundTowardsZero 0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.roundTowardsZero 2147483647.000009
      |> Stdlib.Test.equal 2147483647 ]

test sqrt =
  Stdlib.Test.all
    [ Stdlib.Float.sqrt 25.0 |> Stdlib.Test.equal 5.0
      Stdlib.Float.sqrt 0.0 |> Stdlib.Test.equal 0.0 ]

test subtract =
  (1.0 - 0.2) |> Stdlib.Test.equal 0.8

test sum =
  Stdlib.sum 0.0 [ 1.0, 0.2 ] |> Stdlib.Test.equal 1.2

test nanEqualityIsFalse =
  ((nan ()) == (nan ())) |> Stdlib.Test.equal false

test nanInequalityIsTrue =
  ((nan ()) != (nan ())) |> Stdlib.Test.equal true

test toString =
  Stdlib.Test.all
    [ Stdlib.toString 1.5 |> Stdlib.Test.equal "1.5"
      Stdlib.toString 0.0 |> Stdlib.Test.equal "0.0"
      Stdlib.toString -0.5 |> Stdlib.Test.equal "-0.5"
      Stdlib.toString 0.5 |> Stdlib.Test.equal "0.5"
      Stdlib.toString -55555555555555555555555555555.5
      |> Stdlib.Test.equal "-5.555555555555555e+28"
      // Shortest round-trip: what prints is the number, not a twelve-digit
      // rounding of it.
      Stdlib.toString (0.1 + 0.2) |> Stdlib.Test.equal "0.30000000000000004"
      Stdlib.toString (1.0 / 3.0) |> Stdlib.Test.equal "0.3333333333333333"
      Stdlib.toString 1.0000000000000002
      |> Stdlib.Test.equal "1.0000000000000002"
      // Fixed notation from 1e-4 up to 1e16, scientific outside, no zero
      // padding, and no `.0` on scientific (it used to print `1e+17.0`, which
      // Float.parse refuses). Same layout as the compiler's Float.toString.
      Stdlib.toString 0.0001 |> Stdlib.Test.equal "0.0001"
      Stdlib.toString 0.00001 |> Stdlib.Test.equal "1e-5"
      Stdlib.toString -0.00001 |> Stdlib.Test.equal "-1e-5"
      Stdlib.toString 123456789012345.0
      |> Stdlib.Test.equal "123456789012345.0"
      Stdlib.toString 9007199254740992.0
      |> Stdlib.Test.equal "9007199254740992.0"
      Stdlib.toString 10000000000000000.0 |> Stdlib.Test.equal "1e+16"
      Stdlib.toString 123456789012345678.0
      |> Stdlib.Test.equal "1.2345678901234568e+17" ]

test toStringRoundTrips =
  Stdlib.Test.all
    [ Stdlib.Float.parse (Stdlib.toString (1.0 / 3.0))
      |> Stdlib.Test.equal (Ok (1.0 / 3.0))
      Stdlib.Float.parse (Stdlib.toString 123456789012345678.0)
      |> Stdlib.Test.equal (Ok 123456789012345678.0)
      Stdlib.Float.parse (Stdlib.toString -0.00001)
      |> Stdlib.Test.equal (Ok -0.00001)
      Stdlib.Float.parse "5e-324"
      |> Stdlib.Result.map (fun f -> Stdlib.toString f)
      |> Stdlib.Test.equal (Ok "5e-324") ]

// toInt truncates toward zero.
test toInt =
  Stdlib.Test.all
    [ Stdlib.Float.toInt 3.0 |> Stdlib.Test.equal 3
      Stdlib.Float.toInt 0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.toInt -0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.toInt 1.5 |> Stdlib.Test.equal 1
      Stdlib.Float.toInt 1.9 |> Stdlib.Test.equal 1
      Stdlib.Float.toInt -1.9 |> Stdlib.Test.equal -1
      Stdlib.Float.toInt -3.0 |> Stdlib.Test.equal -3
      Stdlib.Float.toInt 0.1 |> Stdlib.Test.equal 0
      Stdlib.Float.toInt 2147483648.7 |> Stdlib.Test.equal 2147483648
      Stdlib.Float.toInt 2.5
      |> Stdlib.Test.equal (Stdlib.Float.roundTowardsZero 2.5)
      Stdlib.Float.toInt -2.5
      |> Stdlib.Test.equal (Stdlib.Float.roundTowardsZero -2.5) ]

// NaN and infinities cannot become Ints.
test toIntRejectsNan =
  Stdlib.Float.toInt (nan ())
  => raises "Encountered out-of-range value for type of Int"

test toIntRejectsInfinity =
  Stdlib.Float.toInt (infinity ())
  => raises "Encountered out-of-range value for type of Int"

test toIntRejectsNegativeInfinity =
  Stdlib.Float.toInt (negativeInfinity ())
  => raises "Encountered out-of-range value for type of Int"

// Truncation and floor differ for negative values.
test toIntTruncatesWhereFloorRoundsDown =
  Stdlib.Test.all
    [ Stdlib.Float.toInt -1.5 |> Stdlib.Test.equal -1
      Stdlib.Float.floor -1.5 |> Stdlib.Test.equal -2 ]

// IEEE 754 binary64 representations.
test toBits =
  Stdlib.Test.all
    [ Stdlib.Float.toBits 0.0 |> Stdlib.Test.equal 0
      Stdlib.Float.toBits 0.5 |> Stdlib.Test.equal 4602678819172646912
      Stdlib.Float.toBits 1.0 |> Stdlib.Test.equal 4607182418800017408
      Stdlib.Float.toBits 2.0 |> Stdlib.Test.equal 4611686018427387904
      Stdlib.Float.toBits (infinity ()) |> Stdlib.Test.equal 9218868437227405312
      Stdlib.Float.toBits -0.0 |> Stdlib.Test.equal -9223372036854775808 ]

// Bit equality distinguishes signed zero and is reflexive for a fixed NaN.
test toBitsDistinguishesSignedZero =
  Stdlib.Test.all
    [ (Stdlib.Float.toBits -0.0 == Stdlib.Float.toBits 0.0)
      |> Stdlib.Test.equal false
      (-0.0 == 0.0) |> Stdlib.Test.equal true
      (Stdlib.Float.toBits (nan ()) == Stdlib.Float.toBits (nan ()))
      |> Stdlib.Test.equal true ]

// Check parsing a hexadecimal float.
test parseRejectsHexadecimalNotation =
  Stdlib.Float.parse "0xffffffffffffffff"
  |> Stdlib.Test.equal (Error Stdlib.Float.ParseError.BadFormat)
