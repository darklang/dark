/// Cases ported from `backend/testfiles/execution/stdlib/sse.dark`.
// Server-Sent Events parser. Exercises Stdlib.HttpClient.Sse.parse over
// in-memory Stream<UInt8> bodies; no HTTP needed.
//
// Helper tests build byte streams from strings via blobFromString +
// bytesToList + streamFromList; the parse result is drained back to
// List<Event> for structural comparison.
module Darklang.Stdlib.HttpClient.Sse.Tests

// Differs from legacy: legacy built the byte stream inline in every case; this
// helper does the same steps.
let parse (source: String) : List<Stdlib.HttpClient.Sse.Event> =
  source
  |> Stdlib.Blob.fromString
  |> Stdlib.Blob.toList
  |> Stdlib.Stream.fromList
  |> Stdlib.HttpClient.Sse.parse
  |> Stdlib.Stream.toList

// single event with just a data field
test singleDataEvent =
  parse "data: hello\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event { data = "hello"; eventType = ""; id = "" } ]

// empty body yields no events
test emptyBody =
  parse "" |> Stdlib.Test.equal []

// multiple events separated by blank lines
test multipleEvents =
  parse "data: first\n\ndata: second\n\ndata: third\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event { data = "first"; eventType = ""; id = "" }
      Stdlib.HttpClient.Sse.Event { data = "second"; eventType = ""; id = "" }
      Stdlib.HttpClient.Sse.Event { data = "third"; eventType = ""; id = "" } ]

// event type and id are parsed
test eventTypeAndId =
  parse "event: update\nid: 42\ndata: payload\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event
        { data = "payload"; eventType = "update"; id = "42" } ]

// id persists across events per the SSE spec
test idPersists =
  parse "id: 42\ndata: one\n\ndata: two\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event { data = "one"; eventType = ""; id = "42" }
      Stdlib.HttpClient.Sse.Event { data = "two"; eventType = ""; id = "42" } ]

// comment lines (starting with `:`) are ignored
test commentLinesIgnored =
  parse ": this is a comment\ndata: hello\n\n: another comment\ndata: world\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event { data = "hello"; eventType = ""; id = "" }
      Stdlib.HttpClient.Sse.Event { data = "world"; eventType = ""; id = "" } ]

// multi-line `data:` fields are joined with a newline
test multiLineData =
  parse "data: line one\ndata: line two\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event
        { data = "line one\nline two"; eventType = ""; id = "" } ]

// blocks without a data field are not dispatched (spec: empty data = skip)
test blocksWithoutDataSkipped =
  parse "event: ping\n\ndata: real\n\n"
  |> Stdlib.Test.equal
    [ Stdlib.HttpClient.Sse.Event { data = "real"; eventType = ""; id = "" } ]
