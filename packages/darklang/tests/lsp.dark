module Darklang.Lsp.Tests

type Json = Stdlib.AltJson.Json

type Parsed = Lsp.Examples.Toy.Parsed


let session(text: String): Lsp.Session<Unit, Parsed> =
  let doc =
    Lsp.Document
      { uri = "file:///a.toy"
        version = 1
        text = text
        analysis = Lsp.Analysed.Ready(Lsp.Examples.Toy.parse(text))
        previous = Option.None }

  Lsp.Session
    { state = ()
      documents = Stdlib.Dict.fromList([ (doc.uri, doc) ])
      client = Json.Null }


let ask(
  server: Lsp.Server<Unit, Parsed>,
  session: Lsp.Session<Unit, Parsed>,
  method: String,
  params: String)
  : String =
  match Stdlib.List.findFirst(Lsp.Loop.methods(server), fun m ->
          m.name == method) with
  | None -> "not supported"
  | Some(m) ->
    match m.answer(
            session,
            Stdlib.Json.parse<Json>(params) |> Builtin.unwrap) with
    | Ok(json) -> Stdlib.AltJson.format(json)
    | Error(e) -> $"error {e.code}"


val at =
  "{\"textDocument\":{\"uri\":\"file:///a.toy\"},\"position\":{\"line\":1,\"character\":4}}"


test capabilitiesFollowTheHandlers =
  let caps = Lsp.Loop.capabilities(Lsp.Loop.methods(Lsp.Examples.Toy.server()))
  let has(key: String): Bool = Stdlib.Option.isSome(Lsp.Read.at(caps, [ key ]))
  Stdlib.Test.all(
    [ has("hoverProvider") |> Stdlib.Test.equal(true)

      has("completionProvider") |> Stdlib.Test.equal(true)

      has("textDocumentSync") |> Stdlib.Test.equal(true)

      has("definitionProvider") |> Stdlib.Test.equal(false)

      Lsp.Read.bool(caps, [ "completionProvider", "resolveProvider" ])
      |> Stdlib.Test.equal(Option.Some(false)) ])


test handlersAnswerTheirMethods =
  let s = session("a = 1\nb = a\noops\n")
  let toy = Lsp.Examples.Toy.server()
  Stdlib.Test.all(
    [ ask(toy, s, "textDocument/hover", at)
      |> Stdlib.Test.equal(
        "{\"contents\":{\"kind\":\"markdown\",\"value\":\"`a` is 1\"}}")

      ask(toy, s, "textDocument/completion", at)
      |> Stdlib.Test.equal(
        "{\"isIncomplete\":false,\"items\":[{\"label\":\"a\",\"kind\":6,\"data\":null},{\"label\":\"b\",\"kind\":6,\"data\":null}]}")

      // a document that is not open has nothing to hover
      ask(
        toy,
        s,
        "textDocument/hover",
        "{\"textDocument\":{\"uri\":\"file:///b.toy\"},\"position\":{\"line\":0,\"character\":0}}")
      |> Stdlib.Test.equal("null")

      ask(toy, s, "textDocument/definition", at)
      |> Stdlib.Test.equal("not supported")

      (Lsp.Examples.Toy.parse("a = 1\noops\n")).bad
      |> Stdlib.Test.equal([ 1 ]) ])


test methodsAndMiddlewareCompose =
  let toy = Lsp.Examples.Toy.server()
  let shout(m: Lsp.Method<Unit, Parsed>): Lsp.Method<Unit, Parsed> =
    { m with
        answer =
          (fun(s, p) ->
             m.answer(s, p)
             |> Stdlib.Result.map(fun j ->
               Json.String(
                 Stdlib.String.toUppercase(Stdlib.AltJson.format(j))))) }

  let mine =
    Lsp.Method
      { name = "textDocument/hover"
        capability = Option.Some(("hoverProvider", Json.Bool(true)))
        answer = (fun(_, _) -> Result.Ok(Json.String("mine")))
        writes = false }

  let s = session("a = 1\nb = a\n")
  Stdlib.Test.all(
    [ ask({ toy with methods = [ mine ] }, s, "textDocument/hover", at)
      |> Stdlib.Test.equal("\"mine\"")

      ask({ toy with middleware = [ shout ] }, s, "textDocument/hover", at)
      |> Stdlib.Test.equal(
        "\"{\\\"CONTENTS\\\":{\\\"KIND\\\":\\\"MARKDOWN\\\",\\\"VALUE\\\":\\\"`A` IS 1\\\"}}\"") ])


test utf16Columns =
  let r(sl: Int64, sc: Int64, el: Int64, ec: Int64): Lsp.Range =
    Lsp.Range
      { start = Lsp.Position { line = sl, character = sc }
        end = Lsp.Position { line = el, character = ec } }

  Stdlib.Test.all(
    [ Lsp.Text.width("a😀é") |> Stdlib.Test.equal(4)

      Lsp.Text.splitAt("a😀b", 3) |> Stdlib.Test.equal(("a😀", "b"))

      Lsp.Text.replace("let a = 1\nlet 😀 = 2\n", r(1, 6, 1, 7), "x")
      |> Stdlib.Test.equal("let a = 1\nlet 😀x= 2\n")

      Lsp.Text.replace("one\ntwo\nthree", r(0, 1, 2, 2), "")
      |> Stdlib.Test.equal("oree")

      Lsp.Text.before("ab\ncd\nef", Lsp.Position { line = 2, character = 1 }, 1)
      |> Stdlib.Test.equal("cd\ne")

      Lsp.Text.wordAt("x = abc_1 + y", Lsp.Position { line = 0, character = 6 })
      |> Stdlib.Test.equal(Option.Some("abc_1")) ])


test tokenEncoding =
  let t(line: Int64, start: Int64, length: Int64, tokenType: Int64): Lsp.Token =
    Lsp.Token
      { line = line, start = start, length = length, tokenType = tokenType }

  Lsp.Write.tokens([ t(0, 0, 3, 0), t(0, 4, 1, 8), t(2, 2, 5, 1) ])
  |> Stdlib.AltJson.format
  |> Stdlib.Test.equal("{\"data\":[0,0,3,0,0,0,4,1,8,0,2,2,5,1,0]}")
