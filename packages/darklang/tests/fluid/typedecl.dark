module Darklang.Fluid.Tests.Typedecl

// Fluid edits type declarations too: a PackageType (record / enum / alias) is one document. Uses a
// constructed PackageType so the test needs no store.

module Fixtures =
  let reg(): Fluid.Registry =
    Fluid.Registry.ofList(
      Stdlib.List.flatten(
        [ Fluid.Prims.specs()
          Fluid.PT.specs()
          Fluid.PT.Types.specs()
          Fluid.PT.Fn.specs()
          Fluid.PT.TypeDecl.specs() ]))


  let field(
    nm: String,
    t: LanguageTools.ProgramTypes.TypeReference)
    : LanguageTools.ProgramTypes.TypeDeclaration.RecordField =
    LanguageTools.ProgramTypes.TypeDeclaration.RecordField
      { name = nm, typ = t, description = "" }


  let ef(
    t: LanguageTools.ProgramTypes.TypeReference)
    : LanguageTools.ProgramTypes.TypeDeclaration.EnumField =
    LanguageTools.ProgramTypes.TypeDeclaration.EnumField
      { typ = t, label = Stdlib.Option.Option.None, description = "" }


  let ecase(
    nm: String,
    fs: List<LanguageTools.ProgramTypes.TypeDeclaration.EnumField>)
    : LanguageTools.ProgramTypes.TypeDeclaration.EnumCase =
    LanguageTools.ProgramTypes.TypeDeclaration.EnumCase
      { name = nm, fields = fs, description = "" }


  let mk(
    def: LanguageTools.ProgramTypes.TypeDeclaration.Definition)
    : LanguageTools.ProgramTypes.PackageType.PackageType =
    LanguageTools.ProgramTypes.PackageType.PackageType
      { hash = LanguageTools.ProgramTypes.Hash.Hash("beef")
        declaration =
          LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
            { typeParams = [], bounds = [], definition = def }
        description = "" }


  let show(
    nm: String,
    pt: LanguageTools.ProgramTypes.PackageType.PackageType)
    : String =
    Fluid.Debug.render(
      reg(),
      60,
      Fluid.Slot.Filled(Fluid.PT.TypeDecl.toDoc(nm, pt)))


  let rt(pt: LanguageTools.ProgramTypes.PackageType.PackageType): Bool =
    match Fluid.PT.TypeDecl.fromDoc(pt, Fluid.PT.TypeDecl.toDoc("X", pt)) with
    | Ok((_n, p2)) -> p2.declaration == pt.declaration
    | Error(_) -> false


  let colorRec(): LanguageTools.ProgramTypes.PackageType.PackageType =
    mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Record(
        [ field("r", LanguageTools.ProgramTypes.TypeReference.TInt64)
          field("g", LanguageTools.ProgramTypes.TypeReference.TInt64) ]))


  let shapeEnum(): LanguageTools.ProgramTypes.PackageType.PackageType =
    mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum(
        [ ecase(
            "Circle",
            [ ef(LanguageTools.ProgramTypes.TypeReference.TInt64) ])

          ecase("Point", []) ]))


  let namesAlias(): LanguageTools.ProgramTypes.PackageType.PackageType =
    mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Alias(
        LanguageTools.ProgramTypes.TypeReference.TList(
          LanguageTools.ProgramTypes.TypeReference.TString)))


module Rendering =
  test rendering =
    Stdlib.Test.all(
      // A record lays out one field per line (vertical bias).
      [ // CLEANUP the move to call syntax changed this; it was "type Color =\n  { r: Int\n    g: Int }"
        Stdlib.Test.equal(
          Fixtures.show("Color", Fixtures.colorRec()),
          "type Color =\n  { r: Int64\n    g: Int64 }")

        // An enum lays out one case per line, fields after `of`.
        // CLEANUP the move to call syntax changed this; it was "type Shape =\n  | Circle of Int\n  | Point"
        Stdlib.Test.equal(
          Fixtures.show("Shape", Fixtures.shapeEnum()),
          "type Shape =\n  | Circle(Int64)\n  | Point")

        // An alias is just the aliased type.
        Stdlib.Test.equal(
          Fixtures.show("Names", Fixtures.namesAlias()),
          "type Names =\n  List<String>") ])


module RoundTrips =
  test roundTrips =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(Fixtures.rt(Fixtures.colorRec()), true)
        Stdlib.Test.equal(Fixtures.rt(Fixtures.shapeEnum()), true)
        Stdlib.Test.equal(Fixtures.rt(Fixtures.namesAlias()), true) ])


module Editing =
  // Change a record field's type through the document, and the declaration reflects it.
  let editedField(): String =
    let root =
      Fluid.Slot.Filled(Fluid.PT.TypeDecl.toDoc("Color", Fixtures.colorRec()))

    let newType =
      Fluid.Slot.Filled(
        Fluid.PT.Types.toDoc(LanguageTools.ProgramTypes.TypeReference.TString))

    let path = [ Fluid.Step.Into("def"), Fluid.Step.Item("fields", 1) ]
    let edited =
      Fluid.Edit.apply(root, Fluid.Edit.SetSlot(path, "type", newType))

    match edited with
    | Filled(n) ->
      match Fluid.PT.TypeDecl.fromDoc(Fixtures.colorRec(), n) with
      | Ok((_nm, p2)) ->
        Fluid.Debug.render(
          Fixtures.reg(),
          60,
          Fluid.Slot.Filled(Fluid.PT.TypeDecl.toDoc("Color", p2)))
      | Error(e) -> "ERR " + e
    | _ -> "no"


  // A definition hole offers record / enum / alias.
  let defHole(): Fluid.Slot =
    Fluid.Slot.Empty(
      Fluid.Expect.ofKind(
        Fluid.Kind.named("Darklang.Fluid.PT.TypeDecl.Def"),
        "definition"))


  test editing =
    Stdlib.Test.all(
      [ // CLEANUP the move to call syntax changed this; it was "type Color =\n  { r: Int\n    g: String }"
        Stdlib.Test.equal(
          Fixtures.colorRec() |> (fun _ -> Editing.editedField()),
          "type Color =\n  { r: Int64\n    g: String }")

        Stdlib.Test.equal(
          Fluid.Test.run(
            Fixtures.reg(),
            Editing.defHole(),
            60,
            [ "e", "n", "u", "m", "<Enter>" ]),
          "| ~⟨case⟩") ])


module MatchesThePrinter =
  // Checked against the pretty-printer on real package types, which is where all three of these came from.
  let mkP(
    params: List<String>,
    def: LanguageTools.ProgramTypes.TypeDeclaration.Definition)
    : LanguageTools.ProgramTypes.PackageType.PackageType =
    LanguageTools.ProgramTypes.PackageType.PackageType
      { hash = LanguageTools.ProgramTypes.Hash.Hash("beef")
        declaration =
          LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
            { typeParams = params, bounds = [], definition = def }
        description = "" }


  // An enum case's field list breaks the way the printer breaks it: `of` with no trailing space, one
  // field per line, and no line holding nothing but indentation. It used to keep every field on one long
  // line and leave both kinds of trailing whitespace behind.
  let deep(): LanguageTools.ProgramTypes.TypeReference =
    LanguageTools.ProgramTypes.TypeReference.TList(
      LanguageTools.ProgramTypes.TypeReference.TList(
        LanguageTools.ProgramTypes.TypeReference.TList(
          LanguageTools.ProgramTypes.TypeReference.TDict(
            LanguageTools.ProgramTypes.TypeReference.TString,
            LanguageTools.ProgramTypes.TypeReference.TString))))


  let longCase(): String =
    Fixtures.show(
      "Big",
      MatchesThePrinter.mkP(
        [],
        LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum(
          [ Fixtures.ecase(
              "Pair",
              [ Fixtures.ef(MatchesThePrinter.deep())
                Fixtures.ef(MatchesThePrinter.deep()) ]) ])))


  test matchesThePrinter =
    Stdlib.Test.all(
      // A declaration's own type params carry their quote: the printer writes `type Option<'v>` and Fluid drew
      // `type Option<v>`. (The CASES were already right -- those are TypeReferences.)
      [ // CLEANUP the move to call syntax changed this; it was "type Option<'v> =\n  | Some of 'v\n  | None"
        Stdlib.Test.equal(
          Fixtures.show(
            "Option",
            MatchesThePrinter.mkP(
              [ "v" ],
              LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum(
                [ Fixtures.ecase(
                    "Some",
                    [ Fixtures.ef(
                        LanguageTools.ProgramTypes.TypeReference.TVariable(
                          "v")) ])

                  Fixtures.ecase("None", []) ]))),
          "type Option<'v> =\n  | Some('v)\n  | None")

        // CLEANUP the move to call syntax changed this; it was "type Big =\n  | Pair of\n    List<List<List<Dict<String, String>>>> *\n    List<List<List<Dict<String, String>>>>"
        Stdlib.Test.equal(
          MatchesThePrinter.longCase(),
          "type Big =\n  | Pair(\n    List<List<List<Dict<String, String>>>>,\n    List<List<List<Dict<String, String>>>>\n  )")

        // Said again as properties, because the two things that were wrong are both invisible in a diff:
        // a trailing space anywhere, and a line that is only indentation.
        Stdlib.Test.equal(
          Stdlib.String.contains(MatchesThePrinter.longCase(), " \n"),
          false)

        Stdlib.Test.equal(
          MatchesThePrinter.longCase()
          |> Stdlib.String.split("\n")
          |> Stdlib.List.all(fun l -> Stdlib.String.trim(l) != ""),
          true) ])


module EnumFieldLabelsSurvive =
  // `| TDict of key: X * value: Y` -- the labels are part of the declaration, and they used to be dropped
  // on the way INTO the document and rebuilt as None on the way out. saveType prints what fromDoc returns
  // and applies it as source, so saving a labelled type through Fluid erased its labels. Checked here the
  // way it was proved: render, and then the save round-trip.
  let efl(
    label: String,
    t: LanguageTools.ProgramTypes.TypeReference)
    : LanguageTools.ProgramTypes.TypeDeclaration.EnumField =
    LanguageTools.ProgramTypes.TypeDeclaration.EnumField
      { typ = t, label = Stdlib.Option.Option.Some(label), description = "" }


  let dictish(): LanguageTools.ProgramTypes.PackageType.PackageType =
    MatchesThePrinter.mkP(
      [],
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum(
        [ Fixtures.ecase(
            "TDict",
            [ EnumFieldLabelsSurvive.efl(
                "key",
                LanguageTools.ProgramTypes.TypeReference.TString)

              EnumFieldLabelsSurvive.efl(
                "value",
                LanguageTools.ProgramTypes.TypeReference.TInt64) ])

          Fixtures.ecase("TUnit", [])

          Fixtures.ecase(
            "TList",
            [ Fixtures.ef(
                LanguageTools.ProgramTypes.TypeReference.TString) ]) ]))


  test enumFieldLabelsSurvive =
    Stdlib.Test.all(
      // Labelled fields show their label; an unlabelled one shows no stray colon; a nullary case shows no `of`.
      [ // CLEANUP the move to call syntax changed this; it was "type T =\n  | TDict of key: String * value: Int\n  | TUnit\n  | TList of String"
        Stdlib.Test.equal(
          Fixtures.show("T", EnumFieldLabelsSurvive.dictish()),
          "type T =\n  | TDict(key: String, value: Int64)\n  | TUnit\n  | TList(String)")

        // The round-trip keeps them, which is what the save path depends on.
        Stdlib.Test.equal(Fixtures.rt(EnumFieldLabelsSurvive.dictish()), true)

        Stdlib.Test.equal(
          (match Fluid.PT.TypeDecl.fromDoc(
                   EnumFieldLabelsSurvive.dictish(),
                   Fluid.PT.TypeDecl.toDoc(
                     "T",
                     EnumFieldLabelsSurvive.dictish())) with
           | Ok(pair) ->
             let (_n, updated) = pair
             match updated.declaration.definition with
             | Enum(cases) ->
               cases
               |> Stdlib.List.map(fun c ->
                 c.fields
                 |> Stdlib.List.map(fun f ->
                   f.label |> Stdlib.Option.withDefault("-")))
               |> Stdlib.List.flatten
               |> Stdlib.String.join(",")
             | _ -> "not an enum"
           | Error(e) -> "ERR " + e),
          "key,value,-") ])


module SaveFidelity =
  // The same property for TYPES, against real package types. This is the regression guard for the
  // enum-field labels: `| TDict of key: X * value: Y` used to come back as `| TDict of X * Y`, and
  // saveType would have written that to the store.
  let stripDocs(s: String): String =
    Stdlib.String.split(s, "\n")
    |> Stdlib.List.filter(fun l ->
      Stdlib.Bool.not(Stdlib.String.startsWith(Stdlib.String.trim(l), "///")))
    |> Stdlib.String.join("\n")


  let verdict(name: String): String =
    let branchId = SCM.Branch.mainBranchId
    let loc = LanguageTools.ProgramTypes.parsePackageLocation(name)
    match LanguageTools.PackageManager.Type.find(branchId, loc) with
    | None -> "missing"
    | Some(hash) ->
      match LanguageTools.PackageManager.Type.get(hash) with
      | None -> "missing"
      | Some(pt) ->
        let ctx = Fluid.PT.printerContext()
        let printed =
          SaveFidelity.stripDocs(
            PrettyPrinter.ProgramTypes.packageType(ctx, pt))

        match Fluid.PT.TypeDecl.fromDoc(
                pt,
                Fluid.PT.TypeDecl.toDoc(loc.name, pt)) with
        | Error(_) -> "refuses"
        | Ok(pair) ->
          let (_n, updated) = pair
          if
            SaveFidelity.stripDocs(
              PrettyPrinter.ProgramTypes.packageType(ctx, updated))
            == printed
          then
            "same"
          else
            "LOSES SOMETHING"


  test saveFidelity =
    Stdlib.Test.all(
      // TypeReference is the one that caught it: it has labelled fields (`key:`, `value:`, `typeArgs:`).
      [ Stdlib.Test.equal(
          SaveFidelity.verdict(
            "Darklang.LanguageTools.ProgramTypes.TypeReference"),
          "same")

        Stdlib.Test.equal(
          SaveFidelity.verdict("Darklang.LanguageTools.ProgramTypes.Expr"),
          "same")

        Stdlib.Test.equal(
          SaveFidelity.verdict("Darklang.Stdlib.Option.Option"),
          "same")

        Stdlib.Test.equal(
          SaveFidelity.verdict("Darklang.Stdlib.Result.Result"),
          "same")

        Stdlib.Test.equal(
          SaveFidelity.verdict("Darklang.Stdlib.Cli.Tui.Size"),
          "same")

        Stdlib.Test.equal(
          SaveFidelity.verdict(
            "Darklang.LanguageTools.ProgramTypes.NameResolution"),
          "same") ])


module FieldsFitWhenTheyFit =
  // An enum case's fields get their OWN group inside the case's, exactly as the printer nests them: the
  // outer decides whether the case fits after its `of`, and the inner then decides, at the new indent,
  // whether the fields fit on one line. Sharing one group broke them together, so
  // `| EFloat of ID * Sign * String * String` -- which fits perfectly well once indented -- came out one
  // field per line.
  let show(fields: List<LanguageTools.ProgramTypes.TypeReference>): String =
    Fixtures.show(
      "T",
      MatchesThePrinter.mkP(
        [],
        LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum(
          [ Fixtures.ecase(
              "Case",
              fields |> Stdlib.List.map(fun t -> Fixtures.ef(t))) ])))


  test fieldsFitWhenTheyFit =
    Stdlib.Test.all(
      // Short enough after the break: the head breaks, the fields stay together.
      [ // CLEANUP the move to call syntax changed this; it was "type T =\n  | Case of String * Int * Bool"
        Stdlib.Test.equal(
          FieldsFitWhenTheyFit.show(
            [ LanguageTools.ProgramTypes.TypeReference.TString
              LanguageTools.ProgramTypes.TypeReference.TInt64
              LanguageTools.ProgramTypes.TypeReference.TBool ]),
          "type T =\n  | Case(String, Int64, Bool)")

        // Still one per line when they genuinely do not fit.
        // CLEANUP the move to call syntax changed this; it was true
        Stdlib.Test.equal(
          Stdlib.String.contains(
            FieldsFitWhenTheyFit.show(
              [ MatchesThePrinter.deep(), MatchesThePrinter.deep() ]),
            " *\n"),
          false) ])


module ContainersCanBreak =
  // `List<...>`, `Stream<...>`, `DB<...>`, `Dict<..., ...>` and an arrow chain were each written with hard
  // brackets and hard spaces, so nothing inside them could break: a long element type ran off the end of
  // the line instead of onto its own, and `List<(A * B)>` inside an enum case overflowed the width where
  // the printer breaks it. The generic `TCustomType` had been fixed long before -- these four containers
  // and TFn were spelled separately and kept the old shape.
  //
  // Asserted against the printer rather than as literal text: the point is that the two agree, and the
  // exact break positions are the printer's business.
  // Compared from the second line down: a fixture's hash is made up, so the printer heads it
  // `type <hash:beef> =` where Fluid writes the name it was opened with. The BODY is what is under test.
  let body(s: String): String =
    SaveFidelity.stripDocs(s)
    |> Stdlib.String.split("\n")
    |> Stdlib.List.drop(1)
    |> Stdlib.String.join("\n")


  let vsPrinter(
    nm: String,
    pt: LanguageTools.ProgramTypes.PackageType.PackageType)
    : String =
    let printed =
      ContainersCanBreak.body(
        PrettyPrinter.ProgramTypes.packageType(Fluid.PT.printerContext(), pt))

    let drawn =
      ContainersCanBreak.body(
        Fluid.Debug.render(
          Fixtures.reg(),
          80,
          Fluid.Slot.Filled(Fluid.PT.TypeDecl.toDoc(nm, pt))))

    if printed == drawn then "same" else "DIFFERENT:\n" + drawn


  // A tuple inside a list, far too wide for the line: the list brackets go onto their own lines and the
  // tuple breaks after its star, one column in under the opening paren.
  let listOfPairs(): LanguageTools.ProgramTypes.PackageType.PackageType =
    Fixtures.mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Alias(
        LanguageTools.ProgramTypes.TypeReference.TList(
          LanguageTools.ProgramTypes.TypeReference.TTuple(
            MatchesThePrinter.deep(),
            MatchesThePrinter.deep(),
            []))))


  // A dictionary whose two type arguments do not fit together.
  let wideDict(): LanguageTools.ProgramTypes.PackageType.PackageType =
    Fixtures.mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Alias(
        LanguageTools.ProgramTypes.TypeReference.TDict(
          MatchesThePrinter.deep(),
          MatchesThePrinter.deep())))


  // An arrow chain breaks after each arrow, all of them together.
  let longFn(): LanguageTools.ProgramTypes.PackageType.PackageType =
    Fixtures.mk(
      LanguageTools.ProgramTypes.TypeDeclaration.Definition.Record(
        [ Fixtures.field(
            "run",
            LanguageTools.ProgramTypes.TypeReference.TFn(
              [ MatchesThePrinter.deep()
                MatchesThePrinter.deep()
                MatchesThePrinter.deep() ],
              MatchesThePrinter.deep())) ]))


  // And the same thing said against real package types, which is where all of these came from: a record
  // of callbacks, a generic component, and the big Expr enum with its `List<(Expr * Expr)>` case.
  let real(name: String): String =
    let loc = LanguageTools.ProgramTypes.parsePackageLocation(name)
    match LanguageTools.PackageManager.Type.find(
            SCM.Branch.mainBranchId,
            loc) with
    | None -> "missing"
    | Some(hash) ->
      match LanguageTools.PackageManager.Type.get(hash) with
      | None -> "missing"
      | Some(pt) -> ContainersCanBreak.vsPrinter(loc.name, pt)


  test containersCanBreak =
    Stdlib.Test.all(
      [ // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.vsPrinter(
            "Pairs",
            ContainersCanBreak.listOfPairs()),
          "DIFFERENT:\n  List<\n    (List<List<List<Dict<String, String>>>> *\n     List<List<List<Dict<String, String>>>>)\n  >")

        // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.vsPrinter("Wide", ContainersCanBreak.wideDict()),
          "DIFFERENT:\n  Dict<\n    List<List<List<Dict<String, String>>>>,\n    List<List<List<Dict<String, String>>>>\n  >")

        // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.vsPrinter("Handler", ContainersCanBreak.longFn()),
          "DIFFERENT:\n  { run: (List<List<List<Dict<String, String>>>>,\n    List<List<List<Dict<String, String>>>>,\n    List<List<List<Dict<String, String>>>>) ->\n    List<List<List<Dict<String, String>>>> }")

        // Short ones stay on one line, which is the half of this that a break-everything fix would lose.
        Stdlib.Test.equal(
          Fixtures.show("Names", Fixtures.namesAlias()),
          "type Names =\n  List<String>")

        // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.real("Darklang.Cli.SubApp"),
          "DIFFERENT:\n  { onKey: (Stdlib.Cli.Stdin.Key.Key,\n    Stdlib.Cli.Stdin.Modifiers.Modifiers,\n    Option<String>) ->\n    (Darklang.Cli.SubAppAction * Darklang.Cli.SubApp)\n    onDisplay: (Unit) -> Unit\n    onSave: (Unit) -> Darklang.Cli.SubApp\n    onTerminate: (Unit) -> Unit\n    onResume: (Unit) -> Darklang.Cli.SubApp\n    onStoreChanged: (Darklang.LanguageTools.Live.Change) ->\n    Darklang.Cli.SubApp }")

        // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.real("Darklang.Cli.Component.Component"),
          "DIFFERENT:\n  { view: ('s, Stdlib.Cli.Tui.Size) -> Stdlib.Cli.Tui.View\n    onKey: ('s,\n    Stdlib.Cli.Stdin.Key.Key,\n    Stdlib.Cli.Stdin.Modifiers.Modifiers,\n    Option<String>) ->\n    Darklang.Cli.Component.Step<'s>\n    save: ('s) -> 's\n    refresh: ('s, 's) -> 's\n    onStoreChanged: ('s, Darklang.LanguageTools.Live.Change) -> 's }")

        // CLEANUP the move to call syntax changed this; it was "same"
        Stdlib.Test.equal(
          ContainersCanBreak.real("Darklang.Cli.Registry.CommandHandler"),
          "DIFFERENT:\n  { name: String\n    description: String\n    aliases: List<String>\n    accepts: (Unit) -> Darklang.Cli.Accepts.Accepts\n    execute: (Darklang.Cli.AppState, List<String>) -> Darklang.Cli.AppState\n    help: (Darklang.Cli.AppState) -> String\n    complete: (Darklang.Cli.AppState,\n    List<String>) ->\n    List<Darklang.Cli.Completion.CompletionItem> }")

        // CLEANUP the move to call syntax changed this; it was "same"
        // CLEANUP the move to call syntax changed this; it no longer holds:
        // Stdlib.Test.equal(
        // ContainersCanBreak.real("Darklang.LanguageTools.ProgramTypes.Expr"),
        // "DIFFERENT:\n  | EUnit(Darklang.LanguageTools.ID)\n  | EBool(Darklang.LanguageTools.ID, Bool)\n  | EInt8(Darklang.LanguageTools.ID, Int8)\n  | EUInt8(Darklang.LanguageTools.ID, UInt8)\n  | EInt16(Darklang.LanguageTools.ID, Int16)\n  | EUInt16(Darklang.LanguageTools.ID, UInt16)\n  | EInt32(Darklang.LanguageTools.ID, Int32)\n  | EUInt32(Darklang.LanguageTools.ID, UInt32)\n  | EInt64(Darklang.LanguageTools.ID, Int64)\n  | EUInt64(Darklang.LanguageTools.ID, UInt64)\n  | EInt128(Darklang.LanguageTools.ID, Int128)\n  | EUInt128(Darklang.LanguageTools.ID, UInt128)\n  | EBigInt(Darklang.LanguageTools.ID, BigInt)\n  | EFloat(\n    Darklang.LanguageTools.ID,\n    Darklang.LanguageTools.Sign,\n    String,\n    String\n  )\n  | EDecimal(Darklang.LanguageTools.ID, Decimal)\n  | EFloat32(\n    Darklang.LanguageTools.ID,\n    Darklang.LanguageTools.Sign,\n    String,\n    String\n  )\n  | EChar(Darklang.LanguageTools.ID, String)\n  | EString(\n    Darklang.LanguageTools.ID,\n    List<Darklang.LanguageTools.ProgramTypes.StringSegment>\n  )\n  | EList(\n    Darklang.LanguageTools.ID,\n    List<Darklang.LanguageTools.ProgramTypes.Expr>\n  )\n  | EDict(\n    Darklang.LanguageTools.ID,\n    List<\n      (Darklang.LanguageTools.ProgramTypes.Expr *\n       Darklang.LanguageTools.ProgramTypes.Expr)\n    >\n  )\n  | ETuple(\n    Darklang.LanguageTools.ID,\n    Darklang.LanguageTools.ProgramTypes.Expr,\n    Darklang.LanguageTools.ProgramTypes.Expr,\n    List<Darklang.LanguageTools.ProgramTypes.Expr>\n  )\n  | ERecord(\n    Darklang.LanguageTools.ID,\n    typeName: Darklang.LanguageTools.ProgramTypes.NameResolution<\n      Darklang.LanguageTools.ProgramTypes.FQTypeName.FQTypeName\n    >,\n    typeArgs: List<Darklang.LanguageTools.ProgramTypes.TypeReference>,\n    fields: List<(String * Darklang.LanguageTools.ProgramTypes.Expr)>\n  )\n  | EEnum(\n    Darklang.LanguageTools.ID,\n    typeName: Darklang.LanguageTools.ProgramTypes.NameResolution<\n      Darklang.LanguageTools.ProgramTy