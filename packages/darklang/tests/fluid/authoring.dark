          "7s16")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("7u16"), [ "<Esc>", "<Esc>" ])),
          "7u16")

        Stdlib.Test.equal(
          Fixtures.program(
