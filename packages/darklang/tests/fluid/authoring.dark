module Darklang.Fluid.Tests.Authoring

// How it feels to WRITE code in Fluid, pinned down. Each case is a key sequence a person would actually
// press, checked against what ends up on screen and, where it completes, the program it lowers to. This
// is the "does authoring feel right" coverage -- the flows a person tries first.

module Fixtures =
  let reg(): Fluid.Registry =
    Fluid.Registry.ofList(
      Stdlib.List.flatten(
        [ Fluid.Prims.specs(), Fluid.PT.specs(), Fluid.PT.Types.specs() ]))


  let hole(): Fluid.Slot =
    Fluid.Slot.Empty(Fluid.PT.exprExpect("expression"))


  // The menu's labels after driving `keys`.
  let candidateLabels(keys: List<String>): List<String> =
    Fluid.Editor.candidates(
      Fluid.Test.drive(Fluid.Editor.init(reg(), hole(), 80), keys))
    |> Stdlib.List.map(fun c -> c.label)


  // What's on screen (with the caret) after the keys.
  let screen(keys: List<String>): String =
    Fluid.Test.run(reg(), hole(), 60, keys)


  // The program the keys build, printed; or the first thing missing.
  let program(keys: List<String>): String =
    Fluid.PT.Test.program(reg(), hole(), keys)


  // A key list from a plain string, for the cases where spelling out every character buries what the
  // test is about.
  let chars(s: String): List<String> =
    Stdlib.String.toList(s) |> Stdlib.List.map(fun c -> Stdlib.display(c))


module KeywordsCommitOnSpace =
  test keywordsCommitOnSpace =
    Stdlib.Test.all(
      // Typing a keyword and a space builds the CONSTRUCT, not a variable named after the keyword. This is the
      // fix for "why did typing `let` make a variable".
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " " ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "i", "f", " " ]),
          "if ~⟨cond⟩ then ⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "t", "c", "h", " " ]),
          "match ~⟨arg⟩ with\n| ⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " " ]),
          "(fun(~⟨param⟩) -> ⟨body⟩)")

        Stdlib.Test.equal(Fixtures.screen([ "t", "r", "u", "e", " " ]), "true~")

        // A prefix commits too: `le<space>` is `let`.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", " " ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩") ])


module WriteALetNaturally =
  test writeALetNaturally =
    Stdlib.Test.all(
      // Typed almost like text: `let x <space> 1 <space> x`. Space in a name/number field means "done, next
      // hole"; so you land on the value, then the body, without pressing Tab.
      // Space after the VALUE leaves the caret on it, not at the body. That is what makes `let x = 1 + 2`
      // typable at all: before this, only a variable could take an operator after a space, and a literal
      // could not -- `let n = 1 + 2` came out as the unresolved name `+2n`, and `if 1 > 2` did not parse.
      // Tab is how you say "done, next hole" when the value really is finished.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", " ", "1", " " ]),
          "let x = 1~\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", " ", "1", " ", "<Tab>" ]),
          "let x = 1\n~⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let n = 1 + 2 n"),
              [ "<Esc>", "<Esc>" ])),
          "let n = 1 + 2\nn")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if 1 > 2 1 "),
              [ "<Tab>", "0", "<Esc>", "<Esc>" ])),
          "if 1 > 2 then 1 else 0")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l", "e", "t", " ", "x", " ", "1", " ", "x", "<Esc>" ]),
          "let x = 1\nx") ])


module WriteALetStructurally =
  test writeALetStructurally =
    Stdlib.Test.all(
      // The other way: pick `let` from the menu, then Tab between the holes.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "l", "e", "<Enter>", "x", "<Tab>", "1", "<Tab>", "x", "<Esc>" ]),
          "let x = 1\nx") ])


module TypeThenTab =
  test typeThenTab =
    Stdlib.Test.all(
      // The mental model of "type the keyword, Tab to accept, then Tab through the holes". Tab on a partial
      // commits the highlighted candidate; a prefix works too.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", "<Tab>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "<Tab>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              "<Tab>"
              "x"
              "<Tab>"
              "1"
              "<Tab>"
              "x"
              "<Esc>" ]),
          "let x = 1\nx") ])


module StringsKeepSpaces =
  test stringsKeepSpaces =
    Stdlib.Test.all(
      // A string body is text: spaces are literal, not "next hole".
      [ Stdlib.Test.equal(
          Fixtures.screen([ "\"", "h", "i", " ", "t", "h", "e", "r", "e" ]),
          "\"hi there~\"")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "\"", "h", "i", " ", "t", "h", "e", "r", "e", "<Esc>" ]),
          "\"hi there\"") ])


module IfAndMatch =
  test ifAndMatch =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.program([ "i", "f", " ", "b", " ", "1", " ", "2", "<Esc>" ]),
          "if b then 1 else 2")

        // The space HOLDS on the settled pattern rather than stepping to the rhs, because `::` or `|` could
        // follow it. What reaches the rhs is the next thing you type, or the `->` you would write anyway.
        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "<Enter>", "n", " ", "0", " " ]),
          "match n with\n| 0~ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "<Enter>", "n", " ", "0", " ", "1" ]),
          "match n with\n| 0 -> 1~") ])


module Operators =
  test operators =
    Stdlib.Test.all(
      // An operator ends a name and wraps it: `x + 1`.
      [ Stdlib.Test.equal(Fixtures.program([ "x", "+", "1", "<Esc>" ]), "x + 1")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "*", "3", "<Esc>" ]),
          "1 + 2 * 3") ])


module BuildConstructs =
  test buildConstructs =
    Stdlib.Test.all(
      // The trigger chars build literals and constructs directly (adapted from classic Fluid).
      [ Stdlib.Test.equal(Fixtures.screen([ "[" ]), "[ ~⟨item⟩ ]")

        Stdlib.Test.equal(Fixtures.screen([ "(" ]), "(~⟨item⟩, ⟨item⟩)")

        Stdlib.Test.equal(Fixtures.screen([ "\\", "x" ]), "(fun(x~) -> ⟨body⟩)")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "\\", "x", " ", "-", ">", "x", "+", "1", "<Esc>" ]),
          "(fun x -> x + 1)") ])


module BackspaceRemovesItem =
  test backspaceRemovesItem =
    Stdlib.Test.all(
      // Backspace on an empty element removes it (one comma too many, undone), down to the last one.
      [ Stdlib.Test.equal(Fixtures.screen([ "[", "1", ",", "<BS>" ]), "[ 1~ ]")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", ",", "2", ",", "<BS>" ]),
          "[ 1, 2~ ]")

        // At the LAST element there is no element to remove, and this used to stop there -- which meant
        // Backspace on `[` did nothing at all, since `[` gives you a list of exactly one hole. The bracket is
        // what you are undoing at that point, so the list goes with it, the way an untouched `let` or `if`
        // already did.
        Stdlib.Test.equal(Fixtures.screen([ "[", "<BS>" ]), "~⟨expression⟩") ])


module CommaAddsItem =
  test commaAddsItem =
    Stdlib.Test.all(
      // Comma adds/advances the next list or tuple element -- the natural key inside `[1, 2]` and `(1, 2)`.
      [ Stdlib.Test.equal(
          Fixtures.program([ "[", "1", ",", "2", ",", "3", "<Esc>" ]),
          "[ 1, 2, 3 ]")

        Stdlib.Test.equal(
          Fixtures.program([ "(", "1", ",", "2", "<Esc>" ]),
          "(1, 2)")

        // A tuple's second slot already exists, so comma jumps to it rather than inserting a third.
        Stdlib.Test.equal(Fixtures.screen([ "(", "1", ",", "2" ]), "(1, 2~)")

        // Inside a string a comma is literal.
        Stdlib.Test.equal(
          Fixtures.screen([ "\"", "a", ",", "b" ]),
          "\"a,b~\"") ])


module EnterAddsItem =
  test enterAddsItem =
    Stdlib.Test.all(
      // Enter inside a list adds a sibling and moves to it: a list grows, a match gains arms.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", "<Enter>", "2", "<Enter>" ]),
          "[ 1, 2, ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", "<Enter>", "2", "<Esc>" ]),
          "[ 1, 2 ]")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "x"
              "<Tab>"
              "0"
              "<Tab>"
              "\""
              "z"
              "<Enter>"
              "1"
              "<Tab>"
              "\""
              "o"
              "<Esc>" ]),
          "match x with\n| 0 -> \"z\"\n| 1 -> \"o\"") ])


module MenuQuality =
  // The obvious choice tops the menu, and a short query does NOT dump the package store: `le` is just the
  // `let` keyword, `ma` just `match`. A dotted qualifier still searches.
  let menu(keys: List<String>): List<String> =
    let s =
      Fluid.Test.drive(
        Fluid.Editor.init(Fixtures.reg(), Fixtures.hole(), 60),
        keys)

    Fluid.Editor.candidates(s) |> Stdlib.List.map(fun c -> c.label)


  test menuQuality =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(MenuQuality.menu([ "l", "e" ]), [ "let" ])

        Stdlib.Test.equal(MenuQuality.menu([ "m", "a" ]), [ "match" ])

        // The first candidate for a dotted function query is the exact name.
        Stdlib.Test.equal(
          MenuQuality.menu([ "L", "i", "s", "t", ".", "m", "a", "p" ])
          |> Stdlib.List.head,
          Stdlib.Option.Option.Some("Stdlib.List.map")) ])


module MenuKeys =
  test menuKeys =
    Stdlib.Test.all(
      // Escape dismisses a live menu (you stay in INSERT with the partial), a second Escape leaves to NAV.
      [ Stdlib.Test.equal(Fixtures.screen([ "l", "e", "<Esc>" ]), "le~")

        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "<Esc>", "<Esc>" ]),
          "~le")

        // Right-arrow off an exact-match partial accepts it (commit-on-move-off): `let` then Right builds let.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", "<Right>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        // Escape on a fresh empty hole (a preview menu, nothing typed) goes straight to NAV.
        Stdlib.Test.equal(
          Fluid.Test.modeAfter(
            Fixtures.reg(),
            Fixtures.hole(),
            60,
            [ "<Esc>" ]),
          "nav") ])


module Lambda =
  test lambda =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "f", "u", "n", " ", "a", " ", "-", ">", "a", "+", "1", "<Esc>" ]),
          "(fun a -> a + 1)") ])


module FieldAccess =
  test fieldAccess =
    Stdlib.Test.all(
      // A `.` after a bare name is a field access, not part of the name: `r.x` lowers to a field access, and
      // the caret lands in the field blank so you keep typing the name.
      [ Stdlib.Test.equal(Fixtures.program([ "r", ".", "x", "<Esc>" ]), "r.x")

        Stdlib.Test.equal(Fixtures.screen([ "r", "." ]), "r.~⟨field⟩")

        // Chaining: another `.` while sitting in a field name wraps again, so it nests as `(r.a).b` and prints
        // `r.a.b` -- not a single field named `a.b`.
        Stdlib.Test.equal(
          Fixtures.program([ "r", ".", "a", ".", "b", "<Esc>" ]),
          "r.a.b")

        // A qualified name keeps building as one word: the `.` only splits off a field after a bare lowercase
        // name, so `List.map` stays a single reference being typed, not `List` with a field `map`.
        Stdlib.Test.equal(
          Fixtures.screen([ "L", "i", "s", "t", ".", "m", "a", "p" ]),
          "List.map~") ])


module ClosingDelimiter =
  test closingDelimiter =
    Stdlib.Test.all(
      // Re-typing a closing delimiter that's already on screen doesn't drop a stray literal: with the list
      // closed as `[1]`, another `]` is a no-op rather than `[1]]`. The list still lowers cleanly.
      [ Stdlib.Test.equal(Fixtures.screen([ "[", "1", "]" ]), "[ 1 ]~")

        Stdlib.Test.equal(Fixtures.program([ "[", "1", "]" ]), "[ 1 ]")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", "2", "3", "]" ]),
          "[ 123 ]~")

        // Same for a string's closing quote: typing `"` at the end of the body doesn't add a second quote.
        Stdlib.Test.equal(Fixtures.screen([ "\"", "a", "b", "\"" ]), "\"ab\"~")

        Stdlib.Test.equal(
          Fixtures.program([ "\"", "a", "b", "\"" ]),
          "\"ab\"") ])


module DeleteOperator =
  test deleteOperator =
    Stdlib.Test.all(
      // Deleting an infix operator (backspace over it) merges compatible operands into one leaf: two ints
      // join into one number, the caret at the seam; two names concatenate.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "1"
              "2"
              "+"
              "3"
              "4"
              "<Left>"
              "<Left>"
              "<Left>"
              "<BS>"
              "<Esc>" ]),
          "1234")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "1", "2", "+", "3", "4", "<Left>", "<Left>", "<Left>", "<BS>" ]),
          "12~34")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "a", "+", "b", "<Left>", "<Left>", "<BS>", "<Esc>" ]),
          "ab")

        // Incompatible operands don't merge into a bogus literal: `1` with a half-typed name stays `1` (the
        // right is dropped), not the invalid int `1t`.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "1", "+", "t", "<Left>", "<Left>", "<BS>", "<Esc>" ]),
          "1") ])


module DeleteKeyword =
  test deleteKeyword =
    Stdlib.Test.all(
      // Backspace at the start of an untouched construct deletes it: a keyword typed by mistake is one
      // keystroke to undo. let/lambda collapse to their body, if to its then-branch, match to its scrutinee --
      // each a clean blank expression hole.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "<BS>" ]),
          "~⟨body⟩")

        Stdlib.Test.equal(Fixtures.screen([ "i", "f", " ", "<BS>" ]), "~⟨then⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "t", "c", "h", " ", "<BS>" ]),
          "~⟨arg⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " ", "<BS>" ]),
          "~⟨body⟩")

        // Backspacing the name doesn't nuke the let -- the value and body stand; the emptied name just returns
        // to a hole (like any single-value leaf), so you can retype it.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", "<BS>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        // Collapse nests: an empty `if` in a let body collapses to a hole, and you keep typing the body.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "x"
              " "
              "1"
              " "
              "i"
              "f"
              " "
              "<BS>"
              "x"
              "<Esc>" ]),
          "let x = 1\nx") ])


module DeleteSeparator =
  test deleteSeparator =
    Stdlib.Test.all(
      // Backspace at the start of a list element deletes the separator, merging it with the one before when
      // they're compatible -- the same rule as deleting an infix operator. Two ints join, the caret at the seam.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "["
              "1"
              "2"
              ","
              "3"
              "4"
              "<Left>"
              "<Left>"
              "<BS>"
              "<Esc>" ]),
          "[ 1234 ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "[", "1", "2", ",", "3", "4", "<Left>", "<Left>", "<BS>" ]),
          "[ 12~34 ]")

        // Only the two neighbours merge; the rest of the list is untouched.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "[", "1", ",", "2", ",", "3", "<Left>", "<BS>", "<Esc>" ]),
          "[ 1, 23 ]")

        // A tuple can't drop below two elements, so its separator doesn't merge: `(12, 34)` stays put.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "("
              "1"
              "2"
              ","
              "3"
              "4"
              "<Left>"
              "<Left>"
              "<BS>"
              "<Esc>" ]),
          "(12, 34)") ])


module NestedLists =
  test nestedLists =
    Stdlib.Test.all(
      // Stepping past a closing delimiter now lands the caret AFTER the whole construct, in the enclosing
      // scope, so a nested list types naturally: `[` `[` `1` `]` `,` `2` -> `[[1], 2]`. The comma after the
      // inner `]` adds to the OUTER list, not the one just closed.
      [ Stdlib.Test.equal(
          Fixtures.program([ "[", "[", "1", "]", ",", "2", "<Esc>" ]),
          "[ [ 1 ], 2 ]")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "[", "1", "]", "," ]),
          "[ [ 1 ], ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "[", "1", "]", ",", "[", "2", "]", "<Esc>" ]),
          "[ [ 1 ], [ 2 ] ]")

        // Left from just-after the inner list steps back into its end (undoing the step-past).
        Stdlib.Test.equal(
          Fixtures.screen([ "[", "[", "1", "]", ",", "2", "<Left>" ]),
          "[ [ 1 ], ~2 ]") ])


module AfterNodeMotion =
  test afterNodeMotion =
    Stdlib.Test.all(
      // Typing a new element right after a closed construct grows the enclosing list without an explicit
      // comma: `[` `[` `1` `]` `2` -> `[[1], 2]`, and a fresh `[` starts another sub-list.
      [ Stdlib.Test.equal(
          Fixtures.program([ "[", "[", "1", "]", "2", "<Esc>" ]),
          "[ [ 1 ], 2 ]")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "[", "1", "]", "2" ]),
          "[ [ 1 ], 2~ ]")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "[", "1", "]", "[", "2", "]", "<Esc>" ]),
          "[ [ 1 ], [ 2 ] ]")

        // Right and Left move across the boundary: Left re-enters the element just typed.
        Stdlib.Test.equal(
          Fixtures.screen([ "[", "[", "1", "]", "2", "<Left>" ]),
          "[ [ 1 ], ~2 ]") ])


module AfterNodeWrap =
  test afterNodeWrap =
    Stdlib.Test.all(
      // An operator or `.` right after a closed construct wraps the WHOLE construct, not a piece of it:
      // `[1]` then `+` `2` is `[1] + 2` (infix on the list), and `[1]` then `.` `x` a field access on it.
      [ Stdlib.Test.equal(
          Fixtures.program([ "[", "1", "]", "+", "2", "<Esc>" ]),
          "[ 1 ] + 2")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", "]", "+" ]),
          "[ 1 ] +~ ⟨right⟩")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", "]", ".", "x", "<Esc>" ]),
          "([ 1 ]).x")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", "]", "." ]),
          "([ 1 ]).~⟨field⟩")

        // A tuple wraps the same way once closed: `(1, 2)` then `+` `3` -> `(1, 2) + 3`.
        Stdlib.Test.equal(
          Fixtures.program([ "(", "1", ",", "2", ")", "+", "3", "<Esc>" ]),
          "(1, 2) + 3") ])


module CaretMotion =
  test caretMotion =
    Stdlib.Test.all(
      // Home and End jump to the start and end of the current line.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "+", "3", "<Home>" ]),
          "~1 + 2 + 3")

        Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "+", "3", "<Home>", "<End>" ]),
          "1 + 2 + 3~")

        // On a multiline construct they act per visual line: Home from the body goes to the body's start, not
        // the let's.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "l", "e", "t", " ", "x", " ", "1", " ", "x", "<Home>" ]),
          "let x = 1\n~x")

        // Up and Down move between the lines of a let: down from the value lands on the body.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", " ", "1", "<Down>" ]),
          "let x = 1\n~⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "l", "e", "t", " ", "x", " ", "1", " ", "y", "<Up>" ]),
          "let ~x = 1\ny") ])


module FieldTargetParens =
  test fieldTargetParens =
    Stdlib.Test.all(
      // On screen, a field-access target is parenthesised exactly when the pretty-printer would: a plain
      // variable or a field-access chain reads bare, anything else (a list, a call) is wrapped -- so the
      // display and the lowered form agree.
      [ Stdlib.Test.equal(Fixtures.screen([ "r", ".", "x" ]), "r.x~")

        Stdlib.Test.equal(
          Fixtures.screen([ "r", ".", "a", ".", "b" ]),
          "r.a.b~")

        Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", "]", ".", "x" ]),
          "([ 1 ]).x~")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", "]", ".", "x", "<Esc>" ]),
          "([ 1 ]).x") ])


module MultiCharOperators =
  test multiCharOperators =
    Stdlib.Test.all(
      // Two-character operators build by typing both characters: the second appends in the operator slot.
      [ Stdlib.Test.equal(
          Fixtures.program([ "1", "<", "=", "2", "<Esc>" ]),
          "1 <= 2")

        Stdlib.Test.equal(
          Fixtures.program([ "1", ">", "=", "2", "<Esc>" ]),
          "1 >= 2")

        Stdlib.Test.equal(
          Fixtures.program([ "a", "!", "=", "b", "<Esc>" ]),
          "a != b")

        // CLEANUP the move to call syntax changed this; it was "ab ++ cd"
        Stdlib.Test.equal(
          Fixtures.program([ "a", "b", "+", "+", "c", "d", "<Esc>" ]),
          "ab + cd")

        Stdlib.Test.equal(
          Fixtures.program([ "x", "&", "&", "y", "<Esc>" ]),
          "x && y")

        // A one-letter operand that prefixes a keyword (t/true) keeps a live menu, so the first Esc dismisses
        // the menu and the second settles it as a variable -- `s + t` is two variables, not `s + true`.
        Stdlib.Test.equal(
          Fixtures.program([ "s", "+", "t", "<Esc>", "<Esc>" ]),
          "s + t") ])


module Precedence =
  test precedence =
    Stdlib.Test.all(
      // Typing operators associates the way the expression reads: a looser operator typed after a tighter one
      // takes the whole tighter subtree as its left, so the structure (and the parens the printer keeps)
      // match natural precedence. These print WITHOUT parens only because the tree is actually right.
      [ Stdlib.Test.equal(
          Fixtures.program([ "1", "*", "2", "+", "3", "<Esc>" ]),
          "1 * 2 + 3")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "*", "3", "<Esc>" ]),
          "1 + 2 * 3")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "*", "2", "*", "3", "+", "4", "<Esc>" ]),
          "1 * 2 * 3 + 4")

        // Same-precedence operators chain left-associatively.
        Stdlib.Test.equal(
          Fixtures.program([ "1", "-", "2", "+", "3", "<Esc>" ]),
          "1 - 2 + 3")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "+", "3", "<Esc>" ]),
          "1 + 2 + 3")

        // `^` is right-associative, so it stays right-nested.
        // CLEANUP the move to call syntax changed this; it was "2 ^ 3 ^ 2"
        Stdlib.Test.equal(
          Fixtures.program([ "2", "^", "3", "^", "2", "<Esc>" ]),
          "ERR not an operator: ^")

        // A comparison is looser than arithmetic, so it takes the whole sum.
        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "=", "=", "3", "<Esc>" ]),
          "1 + 2 == 3")

        // Mid-type, the caret lands in the new outer operator after reassociation.
        Stdlib.Test.equal(
          Fixtures.screen([ "1", "*", "2", "+" ]),
          "1 * 2 +~ ⟨right⟩") ])


module MatchPatterns =
  test matchPatterns =
    Stdlib.Test.all(
      // Patterns edit like expressions. A lowercase name binds a variable; a Capitalised one is a constructor
      // (matching the case, not shadowing everything with a binding named after it).
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "m", "a", "<Enter>", "n", "<Tab>", "x", "<Tab>", "1", "<Esc>" ]),
          "match n with\n| x -> 1")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "N"
              "o"
              "n"
              "e"
              "<Tab>"
              "0"
              "<Esc>" ]),
          "match n with\n| None -> 0")

        // `(` after a constructor opens its fields and drops into the first; comma adds more; the close draws
        // itself. A bound field is usable in the arm's body.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m", "a", "<Enter>", "n", "<Tab>", "O", "k", "(", "x" ]),
          "match n with\n| Ok(x~) -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "O"
              "k"
              "("
              "x"
              "<Tab>"
              "x"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| Ok(x) -> x")

        // ...but not past the arity. `Some` takes one field, so the comma is not a second one, and the
        // pattern side now refuses it exactly the way the expression side always has -- the character joins
        // the name it is standing in. Neither is graceful; they are at least the same.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "S"
              "o"
              "m"
              "e"
              "("
              "a"
              ","
              "b" ]),
          "match n with\n| Some(ab~) -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("Stdlib.Option.Some(a,b")),
          "Option.Some(ab~)")

        // Constructor fields nest, like any other pattern.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "O"
              "k"
              "("
              "S"
              "o"
              "m"
              "e"
              "("
              "y"
              "<Tab>"
              "1"
              "<Esc>" ]),
          "match n with\n| Ok(Some(y)) -> 1")

        // Literal patterns: int, string, bool, tuple.
        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "<Enter>", "n", "<Tab>", "0" ]),
          "match n with\n| 0~ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m", "a", "<Enter>", "n", "<Tab>", "(", "a", ",", "b" ]),
          "match n with\n| (a, b~) -> ⟨rhs⟩") ])


module FloatLiterals =
  test floatLiterals =
    Stdlib.Test.all(
      // A `.` after an integer's digits makes a float and drops into the fraction -- it does NOT wrap the
      // number in a field access. (This is the counterpart to `.` after a NAME, which is a field access.)
      //
      // A spec wrap rule on EInt and MPInt, not a kernel branch. It had been the last of the number
      // promotions still named in the kernel: the width suffixes beside it (`1L`, `1y`) were spec data
      // already, through the same mechanism, and `wrapRuleFor` asks a KIND's own rules before the type's
      // for exactly this reason -- a character that means one thing after digits and something else
      // everywhere else. `EInt`, `MPInt`, `EFloat` and `MPFloat` all left the kernel with it.
      [ Stdlib.Test.equal(Fixtures.program([ "1", ".", "5", "<Esc>" ]), "1.5")

        Stdlib.Test.equal(
          Fixtures.program([ "3", ".", "1", "4", "<Esc>" ]),
          "3.14")

        Stdlib.Test.equal(Fixtures.screen([ "1", "." ]), "1.~⟨fraction⟩")

        // Same in a pattern.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "1"
              "."
              "5"
              "<Tab>"
              "0"
              "<Esc>" ]),
          "match n with\n| 1.5 -> 0")

        // A `.` after a name is still a field access, unaffected.
        Stdlib.Test.equal(
          Fixtures.program([ "r", ".", "x", "<Esc>" ]),
          "r.x") ])


module OrPatterns =
  test orPatterns =
    Stdlib.Test.all(
      // `|` between patterns builds an or-pattern: the current pattern becomes the first alternative, `|` adds
      // the next, and it chains -- `0 | 1 | 2`. The caret lands in each new alternative.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "<Enter>", "n", "<Tab>", "0", "|" ]),
          "match n with\n| 0 | ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "0"
              "|"
              "1"
              "<Tab>"
              "9"
              "<Esc>" ]),
          "match n with\n| 0 | 1 -> 9")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "0"
              "|"
              "1"
              "|"
              "2"
              "<Tab>"
              "9"
              "<Esc>" ]),
          "match n with\n| 0 | 1 | 2 -> 9") ])


module SeparatorAdvance =
  test separatorAdvance =
    Stdlib.Test.all(
      // Typing a separator that's already drawn ahead skips to the next hole rather than into the name: `=`
      // after a let's binding jumps to the value, so `let x=1` types like text.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", "=" ]),
          "let x = ~⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l", "e", "t", " ", "x", "=", "1", " ", "x", "<Esc>" ]),
          "let x = 1\nx")

        // In an expression hole there's no `=` drawn ahead, so `=` still starts an operator: `1 == 2`.
        Stdlib.Test.equal(
          Fixtures.program([ "1", "=", "=", "2", "<Esc>" ]),
          "1 == 2") ])


module NegativeLiterals =
  test negativeLiterals =
    Stdlib.Test.all(
      // `-` on an empty hole starts a negative number literal (not an unresolvable partial): the digits
      // accumulate and `.` still turns it into a float. Works in expressions and in patterns.
      [ Stdlib.Test.equal(Fixtures.program([ "-", "5", "<Esc>" ]), "-5")

        Stdlib.Test.equal(
          Fixtures.program([ "-", "5", ".", "5", "<Esc>" ]),
          "-5.5")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "-"
              "1"
              "<Tab>"
              "0"
              "<Esc>" ]),
          "match n with\n| -1 -> 0")

        // Minus between two operands is still subtraction, not a negative literal.
        Stdlib.Test.equal(
          Fixtures.program([ "5", "-", "3", "<Esc>" ]),
          "5 - 3") ])


module Pipes =
  test pipes =
    Stdlib.Test.all(
      // `|>` builds a pipe: `|` wraps into the pipe (drawing `|>`) and the `>` completing the arrow is
      // swallowed, so the stage is `f`, not `>f`. Another `|` starts the next stage, chaining flat and
      // stacking one stage per line.
      [ Stdlib.Test.equal(Fixtures.screen([ "x", "|", ">", "f" ]), "x |> f~")

        Stdlib.Test.equal(
          Fixtures.screen([ "x", "|", ">", "f", "|", ">", "g" ]),
          "x |> f |> g~")

        // `>` between operands is still greater-than, unaffected by the pipe's arrow-swallow.
        Stdlib.Test.equal(Fixtures.program([ "1", ">", "2", "<Esc>" ]), "1 > 2")

        Stdlib.Test.equal(
          Fixtures.program([ "1", ">", "=", "2", "<Esc>" ]),
          "1 >= 2") ])


module SpaceCommitDisambiguation =
  test spaceCommitDisambiguation =
    Stdlib.Test.all(
      // Space commits the menu only when it's unambiguous. A loose prefix that matches several candidates
      // finalises what you typed, so `f ` stays the variable `f` -- it does NOT jump to `fun` (or `false`).
      [ Stdlib.Test.equal(Fixtures.screen([ "f", " " ]), "f~")

        // A single-candidate keyword prefix still commits (`le` -> let), and an exact match always does.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", " " ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " " ]),
          "(fun(~⟨param⟩) -> ⟨body⟩)")

        // ...and a name actually IN SCOPE outranks a keyword it is merely a prefix of. `l` uniquely prefixes
        // `let`, so with nothing bound it commits the construct; bind something called `l` and the same key
        // is that variable, and a space after it takes an argument the way a settled name does.
        //
        // Keyed on an EXACT match against a bound name, not on any competing candidate, so an ordinary
        // keyword prefix is untouched: `l ` is still `let` with `list` in scope, because nothing is named `l`.
        //
        // Decided rather than discovered, and the rule was already there -- this pins it so it stays.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", " ", "2" ]),
          "let 2~ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("let l = 1")
                [ "<Tab>" ]
                Fixtures.chars("l ") ])),
          "let l = 1\nl~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("let l = 1")
                [ "<Tab>" ]
                Fixtures.chars("l 2") ])),
          "let l = 1\nl(2~)") ])


module CharLiterals =
  test charLiterals =
    Stdlib.Test.all(
      // `'` builds a character literal and drops into it; the closing quote is drawn and stepping past it is
      // a no-op. Works in expressions and patterns.
      [ Stdlib.Test.equal(Fixtures.screen([ "'" ]), "'~'")

        Stdlib.Test.equal(Fixtures.screen([ "'", "a" ]), "'a~'")

        Stdlib.Test.equal(Fixtures.program([ "'", "a", "<Esc>" ]), "'a'")

        Stdlib.Test.equal(Fixtures.program([ "'", "a", "'", "<Esc>" ]), "'a'")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "'"
              "x"
              "<Tab>"
              "0"
              "<Esc>" ]),
          "match n with\n| 'x' -> 0") ])


module UnitLiteral =
  test unitLiteral =
    Stdlib.Test.all(
      // `(` opens a tuple, but an immediate `)` is the unit literal `()`, not a one-element tuple. A tuple
      // with content still closes as a tuple.
      [ Stdlib.Test.equal(Fixtures.screen([ "(", ")" ]), "()~")

        Stdlib.Test.equal(Fixtures.program([ "(", ")", "<Esc>" ]), "()")

        Stdlib.Test.equal(
          Fixtures.program([ "(", "1", ",", "2", ")", "<Esc>" ]),
          "(1, 2)")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "("
              ")"
              "<Tab>"
              "0"
              "<Esc>" ]),
          "match n with\n| () -> 0")

        // Unit as a let value, then space advances to the body.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "l", "e", "t", " ", "x", " ", "(", ")", " ", "x", "<Esc>" ]),
          "let x = ()\nx") ])


module OrOperator =
  test orOperator =
    Stdlib.Test.all(
      // `||` is the boolean OR, not a pipe: `|` opens a pipe (drawing `|>`), but a second `|` on that fresh
      // pipe converts it to `||`. (A `>` after the first `|` is the pipe; `|` is or.)
      [ Stdlib.Test.equal(Fixtures.screen([ "x", "|", "|", "y" ]), "x || y~")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "t", "r", "u", "e", "|", "|", "f", "a", "l", "s", "e", "<Esc>" ]),
          "true || false")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "|", "|", "2", "<Esc>" ]),
          "1 || 2")

        // The pipe still works: `|` then `>` chains stages.
        Stdlib.Test.equal(
          Fixtures.screen([ "a", "|", ">", "b", "|", ">", "c" ]),
          "a |> b |> c~") ])


module ConsPatterns =
  test consPatterns =
    Stdlib.Test.all(
      // `::` makes a cons pattern: the first `:` wraps the head and draws `::`, the second `:` is swallowed,
      // and the caret lands in the tail. `::` is right-associative, so `a :: b :: c` nests right and prints
      // without parens.
      [ // CLEANUP the move to call syntax changed this; it was "match n with\n| h :: t~ -> ⟨rhs⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m", "a", "<Enter>", "n", "<Tab>", "h", ":", ":", "t" ]),
          "match n with\n| [h, ...:t~] -> ⟨rhs⟩")

        // CLEANUP the move to call syntax changed this; it was "match n with\n| h :: t -> 0"
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "h"
              ":"
              ":"
              "t"
              "<Tab>"
              "0"
              "<Esc>"
              "<Esc>" ]),
          "ERR hole: list pattern")

        // CLEANUP the move to call syntax changed this; it was "match n with\n| a :: b :: c -> 0"
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "a"
              ":"
              ":"
              "b"
              ":"
              ":"
              "c"
              "<Tab>"
              "0"
              "<Esc>"
              "<Esc>" ]),
          "ERR hole: list pattern") ])


module EmptyList =
  test emptyList =
    Stdlib.Test.all(
      // `[` opens a list, an immediate `]` closes it empty. An empty collection carries a caret anchor, so
      // the caret sits between the brackets (no "caret not found"). A list with content still closes normally.
      [ Stdlib.Test.equal(Fixtures.screen([ "[", "]" ]), "[]~")

        Stdlib.Test.equal(Fixtures.program([ "[", "]", "<Esc>" ]), "[]")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", ",", "2", "]", "<Esc>" ]),
          "[ 1, 2 ]")

        // Empty list as a cons tail: `1 :: []`.
        // CLEANUP the move to call syntax changed this; it was "match n with\n| 1 :: [] -> 0"
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "1"
              ":"
              ":"
              "["
              "]"
              "<Tab>"
              "0"
              "<Esc>"
              "<Esc>" ]),
          "ERR hole: list pattern") ])


module LeafBackspaceRevertsToHole =
  test leafBackspaceRevertsToHole =
    Stdlib.Test.all(
      // Deleting the last character of a single-value leaf (int, string, char) returns it to a hole, not a
      // zombie empty node -- so you can immediately type something else. (Variables already did this.)
      [ Stdlib.Test.equal(Fixtures.screen([ "2", "<BS>" ]), "~⟨expression⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "\"", "a", "<BS>" ]),
          "~⟨expression⟩")

        Stdlib.Test.equal(Fixtures.screen([ "2", "<BS>", "5" ]), "5~")

        // A multi-character leaf just loses one character; a float keeps its other part.
        Stdlib.Test.equal(Fixtures.screen([ "1", "2", "<BS>" ]), "1~")

        Stdlib.Test.equal(
          Fixtures.screen([ "1", ".", "5", "<BS>" ]),
          "1.~⟨fraction⟩")

        // An operand emptied inside an infix becomes a clean hole, not a zombie.
        Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "<BS>" ]),
          "1 + ~⟨right⟩") ])


module OrChainAssociates =
  test orChainAssociates =
    Stdlib.Test.all(
      // Chained `||` associates left, like the arithmetic operators, so it prints without parens.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "x", "|", "|", "y", "|", "|", "z", "<Esc>", "<Esc>" ]),
          "x || y || z")

        Stdlib.Test.equal(Fixtures.screen([ "x", "|", "|", "y" ]), "x || y~") ])


module BinaryCollapse =
  test binaryCollapse =
    Stdlib.Test.all(
      // Deleting the right operand (back to a hole), then backspacing again, undoes the operator: an infix
      // collapses to its left, a fresh pipe to what was piped, a cons to its head.
      [ Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "<BS>", "<BS>", "<Esc>" ]),
          "1")

        Stdlib.Test.equal(
          Fixtures.screen([ "a", "|", ">", "b", "<BS>", "<BS>" ]),
          "a~")

        // CLEANUP the move to call syntax changed this; it was "match n with\n| h~ -> ⟨rhs⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "h"
              ":"
              ":"
              "t"
              "<BS>"
              "<BS>" ]),
          "match n with\n| [h, ...~⟨tail⟩] -> ⟨rhs⟩")

        // A filled operand is edited, not collapsed.
        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "3", "<BS>", "<Esc>" ]),
          "1 + 2") ])


module NavAndHistory =
  test navAndHistory =
    Stdlib.Test.all(
      // NAV: Escape settles on the node you were editing; h goes to the parent, x clears the current node to
      // a hole. So you can select the whole expression and blank it, or just one operand.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "<Esc>", "x" ]),
          "1 + ~⟨right⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "<Esc>", "h" ]),
          "~1 + 2")

        Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "<Esc>", "h", "x" ]),
          "~⟨expression⟩")

        // Undo and redo: a typed value, an edit, and a structural merge all step back and forward cleanly.
        Stdlib.Test.equal(Fixtures.screen([ "5", "<C-z>" ]), "~⟨expression⟩")

        Stdlib.Test.equal(Fixtures.screen([ "5", "<C-z>", "<C-y>" ]), "5~")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "["
              "1"
              "2"
              ","
              "3"
              "4"
              "<Left>"
              "<Left>"
              "<BS>"
              "<C-z>" ]),
          "[ 12, ~34 ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "["
              "1"
              "2"
              ","
              "3"
              "4"
              "<Left>"
              "<Left>"
              "<BS>"
              "<C-z>"
              "<C-y>" ]),
          "[ 12~34 ]") ])


module StringInterpolation =
  test stringInterpolation =
    Stdlib.Test.all(
      // `$` starts an interpolated string; text fills a segment (spaces literal); `{` splits the text and
      // drops in an interpolation, `}` steps to the text after it, `"` ends the whole string.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "$", "h", "i", " ", "t", "h", "e", "r", "e" ]),
          "$\"hi there~\"")

        Stdlib.Test.equal(Fixtures.screen([ "$", "a", "{" ]), "$\"a{~⟨expr⟩}\"")

        Stdlib.Test.equal(
          Fixtures.screen([ "$", "a", "{", "x", "}", "b" ]),
          "$\"a{x}b~\"")

        Stdlib.Test.equal(
          Fixtures.program([ "$", "a", "{", "1", "}", "b", "<Esc>" ]),
          "$\"a{1}b\"")

        // An interpolation is a full expression: operators and all.
        Stdlib.Test.equal(
          Fixtures.program([ "$", "n", "=", "{", "1", "+", "2", "}", "<Esc>" ]),
          "$\"n={1 + 2}\"")

        // An all-text interpolated string is just a string.
        Stdlib.Test.equal(
          Fixtures.program([ "$", "h", "i", "<Esc>" ]),
          "\"hi\"") ])


module StringInterpNesting =
  test stringInterpNesting =
    Stdlib.Test.all(
      // An interpolated string nests like any expression: inside a list, and with a filled trailing text.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "[", "$", "a", "{", "1", "}", "b", "<Esc>", "<Esc>" ]),
          "[ $\"a{1}b\" ]")

        Stdlib.Test.equal(
          Fixtures.program([ "$", "a", "{", "1", "+", "2", "}", "!", "<Esc>" ]),
          "$\"a{1 + 2}!\"") ])


module StringInterpCollapse =
  test stringInterpCollapse =
    Stdlib.Test.all(
      // Backspacing an empty interpolation folds it back into the surrounding text, so an interpolation opened
      // by mistake undoes cleanly.
      [ Stdlib.Test.equal(Fixtures.screen([ "$", "a", "{", "<BS>" ]), "$\"a~\"")

        Stdlib.Test.equal(
          Fixtures.program([ "$", "a", "{", "<BS>", "b", "<Esc>" ]),
          "\"ab\"")

        // Delete the interpolated value, then backspace again, and the interpolation folds away too.
        Stdlib.Test.equal(
          Fixtures.screen([ "$", "a", "{", "x", "<BS>", "<BS>" ]),
          "$\"a~\"") ])


module EnterAddsArmAfterBoundVar =
  test enterAddsArmAfterBoundVar =
    Stdlib.Test.all(
      // Enter after an arm whose rhs is a bound variable adds the next arm, rather than just re-accepting the
      // variable from the menu -- so a match over a constructor with a bound field types straight through.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "O"
              "k"
              "("
              "v"
              "<Tab>"
              "v"
              "<Enter>" ]),
          "match n with\n| Ok(v) -> v\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "O"
              "k"
              "("
              "v"
              "<Tab>"
              "v"
              "<Enter>"
              "E"
              "r"
              "r"
              "o"
              "r"
              "("
              "e"
              "<Tab>"
              "0"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| Ok(v) -> v\n| Error(e) -> 0") ])


module TabAdvancesAfterBoundVar =
  test tabAdvancesAfterBoundVar =
    Stdlib.Test.all(
      // Tab after an in-scope variable finalises it and moves to the next hole, rather than committing it in
      // place (which used to swallow the next keystrokes). So a match whose scrutinee is a bound variable
      // types straight through, even nested in a let.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "r"
              " "
              "1"
              " "
              "m"
              "a"
              "<Enter>"
              "r"
              "<Tab>"
              "0"
              "<Tab>"
              "\""
              "z"
              "<Enter>"
              "1"
              "<Tab>"
              "\""
              "o"
              "<Esc>"
              "<Esc>" ]),
          "let r = 1\nmatch r with\n| 0 -> \"z\"\n| 1 -> \"o\"")

        // Tab on a construct/fn still lands in its first hole to fill (not skipped past).
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", "<Tab>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩") ])


module SpaceAdvancesAfterBoundVar =
  test spaceAdvancesAfterBoundVar =
    Stdlib.Test.all(
      // Space after committing an in-scope variable advances to the next hole (it's "done here"), so a nested
      // let that references an earlier binding types straight through: `let a = 1  let b = a  b`.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "a"
              " "
              "1"
              " "
              "l"
              "e"
              "t"
              " "
              "b"
              " "
              "a"
              " "
              "b"
              "<Esc>"
              "<Esc>" ]),
          "let a = 1\nlet b = a\nb")

        // A construct committed on space still lands in its own first hole (a keyword sits at its name).
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", " " ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩") ])


module TypingFast =
  // Fast typing (and a paste) arrives as ONE key press: the terminal reader coalesces the run and reports
  // the whole text at once. The completion menu is a cache refreshed per key press, so folding a run
  // without refreshing left every character after the first deciding on the menu computed BEFORE the run.
  // Typing `Stdlib.List.filter ` quickly used to commit the empty hole's only candidate -- a lambda --
  // and throw the name away, while typing it slowly worked. A run must behave exactly like typing it.
  let chars(s: String): List<String> =
    Stdlib.String.toList(s) |> Stdlib.List.map(fun g -> Stdlib.display(g))


  test typingFast =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.screen([ "nums |Stdlib.List.filter " ]),
          "nums |> Stdlib.List.filter(~⟨f⟩)")

        Stdlib.Test.equal(
          Fixtures.screen(TypingFast.chars("nums |Stdlib.List.filter ")),
          "nums |> Stdlib.List.filter(~⟨f⟩)")

        // The general property, on a couple of shapes: a run and its characters land in the same place.
        Stdlib.Test.equal(
          Fixtures.screen([ "let nums [1, 2, 3]" ]),
          Fixtures.screen(TypingFast.chars("let nums [1, 2, 3]")))

        Stdlib.Test.equal(
          Fixtures.screen([ "abc " ]),
          Fixtures.screen(TypingFast.chars("abc "))) ])


module SpaceInAnEmptyHole =
  test spaceInAnEmptyHole =
    Stdlib.Test.all(
      // A space in an empty hole is leading whitespace: nothing typed to commit, nothing to advance past. It
      // used to become the hole's text, so a list typed the way people write one came out as `[1,  2]` -- the
      // comma made the hole and the space landed in it.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "[", "1", ",", " ", "2" ]),
          "[ 1, 2~ ]")

        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", ",", " ", "2", "<Esc>", "<Esc>" ]),
          "[ 1, 2 ]")

        Stdlib.Test.equal(Fixtures.screen([ " ", "1" ]), "1~") ])


module TypingAfterAClosedValue =
  test typingAfterAClosedValue =
    Stdlib.Test.all(
      // Just after a closed value that isn't in a sequence there is nothing to grow, so a name means "on to
      // the next thing": step to the next hole and type it there. Dropping the keys is what must not happen --
      // `let xs = [1] xs` used to eat the whole name with the screen never changing.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            [ "l", "e", "t", " ", "x", "s", " ", "[", "1", "]", "x", "s" ]),
          "let xs = [ 1 ]\nxs~")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "x"
              "s"
              " "
              "["
              "1"
              "]"
              "x"
              "s"
              "<Esc>"
              "<Esc>" ]),
          "let xs = [ 1 ]\nxs") ])


module QuotedLiteralsReadAsThemselves =
  test quotedLiteralsReadAsThemselves =
    Stdlib.Test.all(
      // An empty text slot normally shows its NAME, dimmed, as a hint -- right for a `⟨name⟩` hole, wrong
      // inside quotes, where a dim word reads as the content: an empty string showed `"body"`, an empty char
      // `'char'`, and a string's trailing segment put a `text` inside the quotes. Delimiters already say
      // where you are, so an empty one draws nothing.
      [ Stdlib.Test.equal(Fixtures.screen([ "\"" ]), "\"~\"")
        Stdlib.Test.equal(Fixtures.screen([ "'" ]), "'~'")
        Stdlib.Test.equal(Fixtures.screen([ "$", "\"" ]), "$\"~\"")
        Stdlib.Test.equal(
          Fixtures.screen([ "$", "\"", "{" ]),
          "$\"{~⟨expr⟩}\"") ])


module StringInterpCloses =
  test stringInterpCloses =
    Stdlib.Test.all(
      // Stepping out of an interpolation with `}` settles what you typed inside it. It used to leave the name
      // an unresolved partial that the caret had already left behind, so `$"hi {name}"` refused to lower --
      // while the same string WITHOUT the closing `}` lowered fine.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            [ "$", "\"", "h", "i", " ", "{", "n", "a", "m", "e", "}" ]),
          "$\"hi {name}~\"")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "$"
              "\""
              "h"
              "i"
              " "
              "{"
              "n"
              "a"
              "m"
              "e"
              "}"
              "<Esc>"
              "<Esc>" ]),
          "$\"hi {name}\"")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "$"
              "\""
              "h"
              "i"
              " "
              "{"
              "n"
              "a"
              "m"
              "e"
              "}"
              "!"
              "<Esc>"
              "<Esc>" ]),
          "$\"hi {name}!\"") ])


module EnterNeedsSomethingTyped =
  test enterNeedsSomethingTyped =
    Stdlib.Test.all(
      // Enter accepts the menu only when you OPENED it by typing. On an untouched hole the menu is just the
      // list of everything that could go there, and accepting its first entry meant a bare Enter built a
      // `let`, and Enter on a fresh match arm gave it the pattern `true`.
      [ Stdlib.Test.equal(Fixtures.screen([ "<Enter>" ]), "~⟨expression⟩")

        // After `match s <space>` the caret sits just after the scrutinee, and Enter there means "on to the
        // next hole" -- it lands in the first arm's pattern rather than accepting `true` from the menu.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "m", "a", "t", "c", "h", " ", "s", " ", "<Enter>" ]),
          "match s with\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        // Typed-then-Enter still commits, which is the whole point of the menu.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "<Enter>" ]),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen([ "m", "a", "<Enter>" ]),
          "match ~⟨arg⟩ with\n| ⟨pattern⟩ -> ⟨rhs⟩") ])


module NumbersStayNumbers =
  test numbersStayNumbers =
    Stdlib.Test.all(
      // A number's text slot took any character you typed, so `1 + 2x` made an int whose digits read "2x",
      // and `1 :: rest` -- cons is a PATTERN in this language, never an expression -- made one reading
      // "1::rest". Both are documents that can never lower, and nothing said so at the time. A non-digit is
      // refused now, with a message. Operators and `.` never reach this path; they wrap the node.
      [ Stdlib.Test.equal(Fixtures.screen([ "1", "+", "2", "x" ]), "1 + 2~")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "x", "<Esc>", "<Esc>" ]),
          "1 + 2")

        Stdlib.Test.equal(Fixtures.screen([ "1", " ", ":", ":", "r" ]), "1~")

        // What a number legitimately holds still works: a fraction, a sign, and operators after it.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "1", ".", "5", "+", "2", ".", "2", "5", "<Esc>", "<Esc>" ]),
          "1.5 + 2.25")

        Stdlib.Test.equal(
          Fixtures.program([ "-", "5", "+", "3", "<Esc>", "<Esc>" ]),
          "-5 + 3")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "2", "*", "3", "<Esc>", "<Esc>" ]),
          "12 * 3")

        // Pattern-side numbers are the same slots, and a match over one still types through.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "0"
              " "
              "1"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| 0 -> 1") ])


module LambdaParams =
  test lambdaParams =
    Stdlib.Test.all(
      // A lambda takes many params, and Enter or a comma adds the next one.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " ", "a", "<Enter>" ]),
          "(fun(a, ~⟨param⟩) -> ⟨body⟩)")

        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " ", "a", "," ]),
          "(fun(a, ~⟨param⟩) -> ⟨body⟩)")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "f"
              "u"
              "n"
              " "
              "a"
              "<Enter>"
              "b"
              "<Tab>"
              "a"
              "+"
              "b"
              "<Esc>"
              "<Esc>" ]),
          "(fun(a, b) -> a + b)")

        // ...and so does a SPACE, because that is what the printer writes between them. `fun a b -> a + b` is
        // printed by the printer and could not be typed at all: the space walked out of the params and into the
        // body, so it came out as `(fun a -> b -> a + b)`.
        //
        // A call's arguments are written the same way and already grew on a space; this is the params list
        // taking the same route rather than a second one. The cost is the arrow-less shorthand that used to
        // work -- `fun a <space> a + 1` now reads the second `a` as another param, and you type the `->` you
        // can already see (or Tab) to get to the body.
        // CLEANUP the move to call syntax changed this; it was "(fun a~ -> ⟨body⟩)"
        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " ", "a", " " ]),
          "(fun(a) -> ~⟨body⟩)")

        // CLEANUP the move to call syntax changed this; it was "(fun a b~ -> ⟨body⟩)"
        Stdlib.Test.equal(
          Fixtures.screen([ "f", "u", "n", " ", "a", " ", "b" ]),
          "(fun(a) -> b~)")

        // CLEANUP the move to call syntax changed this; it was "(fun(a, b) -> a + b)"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("fun(a, b) -> a + b"),
              [ "<Esc>", "<Esc>" ])),
          "ERR hole: body")

        // CLEANUP the move to call syntax changed this; it was "(fun(a, b, c) -> c)"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("fun(a, b, c) -> c"),
              [ "<Esc>", "<Esc>" ])),
          "ERR hole: body") ])


module NamesStayNames =
  test namesStayNames =
    Stdlib.Test.all(
      // A name slot took any character too. Typing `Ok(1` in an expression -- reaching for an enum
      // constructor, which expressions don't support yet -- grew a variable literally named "Ok(1", which
      // lowers to something no parser would take. Two paths insert into a slot (a field name after `.` goes
      // through the wrap path, not the plain one), and both refuse now.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "u", "s", "e", "r", ".", "n", "a", "m", "e", "(" ]),
          "user.name~")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "u"
              "s"
              "e"
              "r"
              "."
              "n"
              "a"
              "m"
              "e"
              "("
              "<Esc>"
              "<Esc>" ]),
          "user.name")

        // `Ok(1` now opens an argument list, because `(` after a name is how this language spells a call.
        // Still not the enum constructor someone reaching for `Ok(` means: the candidate's label is the
        // qualified `Stdlib.Result.Ok`, so the bare `Ok` matches nothing exactly and settles as a variable.
        // A ranking question, written up separately. `Ok 1` is at least a program; `Ok1` was a variable whose
        // name no parser would take.
        Stdlib.Test.equal(Fixtures.screen([ "O", "k", "(", "1" ]), "Ok(1~)")

        // Digits and underscores are part of a name, so they still go in.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "u"
              "s"
              "e"
              "r"
              "."
              "n"
              "a"
              "m"
              "e"
              "2"
              "<Esc>"
              "<Esc>" ]),
          "user.name2")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m", "y", "_", "v", "a", "r", " ", "<Esc>", "<Esc>" ]),
          "my_var")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "m"
              "y"
              "_"
              "x"
              " "
              "1"
              " "
              "m"
              "y"
              "_"
              "x"
              "<Esc>"
              "<Esc>" ]),
          "let my_x = 1\nmy_x") ])


module SpaceLandsAfterTheValue =
  test spaceLandsAfterTheValue =
    Stdlib.Test.all(
      // Space used to settle what you typed and JUMP to the next hole, which made the spacing everyone
      // actually uses unusable inside a construct: `if total > 0` put the `>` in the THEN branch, and
      // `let total = items |> f` put the pipe in the let's BODY. Space now leaves the caret just after the
      // value it settled, and the next key says what you meant -- an operator wraps it, a name moves on.
      // The caret stays on the `0` rather than jumping to the THEN hole, and that is the point rather than an
      // accident of it. Space after a committed VARIABLE already landed after the node; space after a typed
      // NUMBER jumped to the next hole, because one settles through the menu and the other settles as text.
      // Two answers to the same question. They agree now, which is also what makes `if total > 0 && flag`
      // typable -- the `&&` has something to wrap instead of landing in the branch.
      [ // CLEANUP the move to call syntax changed this; it was "if total > 0~ then ⟨then⟩ else ⟨else⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "i"
              "f"
              " "
              "t"
              "o"
              "t"
              "a"
              "l"
              " "
              ">"
              " "
              "0"
              " " ]),
          "if Darklang.Cli.Tracing.printTotalsJson(>, 0~) then\n  ⟨then⟩\nelse\n  ⟨else⟩")

        // CLEANUP the move to call syntax changed this; it was "if total > 0 then 1 else 2"
        Stdlib.Test.equal(
          Fixtures.program(
            [ "i"
              "f"
              " "
              "t"
              "o"
              "t"
              "a"
              "l"
              " "
              ">"
              " "
              "0"
              " "
              "1"
              "<Tab>"
              "2"
              "<Esc>"
              "<Esc>" ]),
          "ERR unresolved: >")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "n"
              " "
              "a"
              " "
              "+"
              " "
              "b"
              " "
              "n"
              "<Esc>"
              "<Esc>" ]),
          "let n = a + b\nn")

        // The `=` in `let x = 1` is drawn by the editor, and space moves you PAST it into the value. Typing it
        // anyway -- which is what anyone writes -- used to make it the value: `let x = =`. It's swallowed now.
        Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "t", " ", "x", " ", "=", " ", "1" ]),
          "let x = 1~\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "x"
              " "
              "="
              " "
              "1"
              " "
              "x"
              "<Esc>"
              "<Esc>" ]),
          "let x = 1\nx")

        // Guarded on an empty hole, so an operator that really is being typed still builds.
        Stdlib.Test.equal(
          Fixtures.program([ "a", " ", "=", "=", " ", "b", "<Esc>", "<Esc>" ]),
          "a == b")

        // And a name after a settled value still moves on, which is what the earlier bound-variable fix wanted.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "t"
              " "
              "a"
              " "
              "1"
              " "
              "l"
              "e"
              "t"
              " "
              "b"
              " "
              "a"
              " "
              "b"
              "<Esc>"
              "<Esc>" ]),
          "let a = 1\nlet b = a\nb") ])


module KeywordsTheEditorAlreadyDrew =
  test keywordsTheEditorAlreadyDrew =
    Stdlib.Test.all(
      // `if`, `then`, `else`, `with` are drawn FOR you, and anyone with muscle memory types them anyway --
      // the same reflex that made `let x = 1` come out as `let x = =`. They were landing in the branch holes
      // as variables named `then` and `else`, and in a match arm as the pattern `with`. Typing the keyword
      // that is already there now throws it away and leaves you in the hole, where the branch itself goes.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "i"
              "f"
              " "
              "r"
              " "
              ">"
              " "
              "0"
              " "
              "t"
              "h"
              "e"
              "n"
              " "
              "1"
              " "
              "e"
              "l"
              "s"
              "e"
              " "
              "2"
              "<Esc>"
              "<Esc>" ]),
          "if r > 0 then 1 else 2")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "0"
              " "
              "1"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| 0 -> 1")

        // Two arms, still typed straight through, no Tab anywhere.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "0"
              " "
              "\""
              "z"
              "\""
              " "
              "1"
              " "
              "\""
              "o"
              "\""
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| 0 -> \"z\"\n| 1 -> \"o\"")

        // The check asks the LAYOUT whether the thing before the caret was drawn as a keyword, so an ordinary
        // name never matches: a second argument that repeats the function's name still goes in.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "S"
              "t"
              "d"
              "l"
              "i"
              "b"
              "."
              "L"
              "i"
              "s"
              "t"
              "."
              "m"
              "a"
              "p"
              " "
              "f"
              " "
              "f"
              "<Esc>"
              "<Esc>" ]),
          "Stdlib.List.map(f, f)")

        // And a pattern variable that isn't a keyword is untouched.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "x"
              " "
              "x"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| x -> x") ])


module PunctuationTheEditorAlreadyDrew =
  test punctuationTheEditorAlreadyDrew =
    Stdlib.Test.all(
      // The same reflex as the keywords, one level down: `->` and `|` are drawn for you too.
      // `fun x -> x + 1` came out as `ERR not an Int: -`, because the `-` started a NEGATIVE NUMBER on the
      // body hole and the `>` then wrapped it in an operator.
      [ Stdlib.Test.equal(
          Fixtures.program(
            [ "f"
              "u"
              "n"
              " "
              "x"
              " "
              "-"
              ">"
              " "
              "x"
              " "
              "+"
              " "
              "1"
              "<Esc>"
              "<Esc>" ]),
          "(fun x -> x + 1)")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "0"
              " "
              "-"
              ">"
              " "
              "1"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| 0 -> 1")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "O"
              "k"
              "("
              "v"
              ")"
              " "
              "-"
              ">"
              " "
              "v"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| Ok(v) -> v")

        // An arm's leading `|`, typed although it is already there.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "t"
              "c"
              "h"
              " "
              "n"
              " "
              "w"
              "i"
              "t"
              "h"
              " "
              "|"
              " "
              "0"
              " "
              "1"
              "<Esc>"
              "<Esc>" ]),
          "match n with\n| 0 -> 1")

        // What a `-` and a `>` legitimately mean is untouched: a negative literal, a subtraction, a comparison,
        // and a negative number as a lambda's whole body.
        Stdlib.Test.equal(
          Fixtures.program([ "[", "1", ",", " ", "-", "2", "<Esc>", "<Esc>" ]),
          "[ 1, -2 ]")

        Stdlib.Test.equal(
          Fixtures.program([ "a", " ", "-", " ", "b", "<Esc>", "<Esc>" ]),
          "a - b")

        Stdlib.Test.equal(
          Fixtures.program([ "a", " ", ">", " ", "b", "<Esc>", "<Esc>" ]),
          "a > b")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "f"
              "u"
              "n"
              " "
              "x"
              " "
              "-"
              ">"
              " "
              "-"
              "1"
              "<Esc>"
              "<Esc>" ]),
          "(fun x -> -1)")

        // A comma on an empty item still MEANS something -- another item -- so it is not swallowed.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "[", "1", ",", " ", "2", ",", " ", "3", "<Esc>", "<Esc>" ]),
          "[ 1, 2, 3 ]") ])


module NavKeyRuns =
  // The terminal reader coalesces fast typing and KEY REPEAT into one press carrying the whole run, and
  // NAV compared `char` against a single character -- so holding `j` to move down the document, or
  // pressing it three times quickly, did nothing at all. Found by driving the type editor live, where
  // `jjj` left the caret on the root; in-process, one key at a time, it had always worked.
  // INSERT already decomposed a run in typeChar; this is the same thing for navigation.
  let breadcrumbAfter(keys: List<String>): String =
    let root =
      match LanguageTools.Parser.Parse.parsePTExpr("let x = 1\nx") with
      | Ok(e) -> Fluid.Slot.Filled(Fluid.PT.toDoc(e))
      | Error(_) -> Fluid.Slot.Empty(Fluid.PT.exprExpect("e"))

    Fluid.Editor.breadcrumb(
      Fluid.Test.drive(Fluid.Editor.init(Fixtures.reg(), root, 70), keys))


  test navKeyRuns =
    Stdlib.Test.all(
      // A run and its keys pressed one at a time land in the same place -- the same property the fast-typing
      // fix pinned for INSERT.
      [ Stdlib.Test.equal(
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "jj" ]),
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "j", "j" ]))

        Stdlib.Test.equal(
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "jjj" ]),
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "j", "j", "j" ]))

        Stdlib.Test.equal(
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "jl" ]),
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "j", "l" ]))

        // And it actually moves, rather than both being the root.
        Stdlib.Test.equal(
          NavKeyRuns.breadcrumbAfter([ "<Esc>", "jjj" ]),
          "ELet > EVariable") ])


module EnterStartsTheNextStatement =
  test enterStartsTheNextStatement =
    Stdlib.Test.all(
      // Enter at the end of a finished expression starts the next one. It used to do NOTHING there -- no hole
      // to go to, no list to grow -- so the most ordinary thing you do after writing a line had no key.
      //
      // It is a WRAP RULE on the expression spec, keyed on `<newline>`, not kernel behaviour: "a newline
      // sequences two things" is a fact about Darklang, and a language whose newline means something else says
      // so in its own spec. `<newline>` sits alongside `<digit>`, `<letter>` and `<operator>` as a class the
      // kernel resolves for a rule that asked for it.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "1", "+", "2", "<Enter>" ]),
          "1 + 2\n~⟨next⟩")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "<Enter>", "2", "<Esc>" ]),
          "1\n2")

        Stdlib.Test.equal(
          Fixtures.program([ "1", "<Enter>", "2", "<Enter>", "3", "<Esc>" ]),
          "1\n2\n3")

        // The WHOLE expression that ends there, not the last thing in it: `1 + 2` then Enter is one statement
        // and a hole, never `1 + (2; ...)`.
        Stdlib.Test.equal(
          Fixtures.program([ "1", "+", "2", "<Enter>", "3", "<Esc>" ]),
          "1 + 2\n3")

        // While anything is still unfinished, Enter's job is to take you to it. A key that quietly did two
        // different things depending on the document would be worse than one that does nothing.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "S"
              "t"
              "d"
              "l"
              "i"
              "b"
              "."
              "p"
              "r"
              "i"
              "n"
              "t"
              "L"
              "i"
              "n"
              "e"
              "<Enter>" ]),
          "Stdlib.printLine(~⟨str⟩)")

        // At the end of a `let`'s BODY the statement goes inside the let, because that is where the language
        // puts it too. The climb stops at a construct that swallows what follows it.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "l"
              "e"
              "<Enter>"
              "x"
              "<Tab>"
              "1"
              "<Tab>"
              "x"
              "<Enter>"
              "<Enter>"
              "2"
              "<Esc>" ]),
          "let x = 1\nx\n2") ])


module AnOperatorAfterAFieldNameWraps =
  test anOperatorAfterAFieldNameWraps =
    Stdlib.Test.all(
      // Typing `+` at the end of `s.width` inserted it INTO the name, and `formatFieldName` then drew the
      // result honestly as ``s.`width+```. The `.` wrap rule's op-slot IS its destination -- the field name --
      // and the branch that extends an operator being typed (`<` then `=` giving `<=`) claimed the character
      // first. An op-slot that holds a NAME is a different thing from one that holds an operator.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "s", ".", "w", "i", "d", "t", "h", "+", "1" ]),
          "s.width + 1~")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "s", ".", "w", "i", "d", "t", "h", "+", "1", "<Esc>" ]),
          "s.width + 1")

        // The two things that branch is actually for still work: another `.` chains, and an operator being
        // typed in a real op slot still extends.
        Stdlib.Test.equal(
          Fixtures.screen([ "s", ".", "a", ".", "b" ]),
          "s.a.b~")

        Stdlib.Test.equal(Fixtures.screen([ "1", "<", "=", "2" ]), "1 <= 2~")

        // With no name yet there is nothing to wrap and nothing it could be part of, so it is refused rather
        // than typed.
        Stdlib.Test.equal(Fixtures.screen([ "s", ".", "+" ]), "s.~⟨field⟩") ])


module EndStopsAtAHolesEdge =
  test endStopsAtAHolesEdge =
    Stdlib.Test.all(
      // End goes to the last editable place on the LINE, and when that is a hole it lands at its start: a
      // hole's text is its LABEL, not something you are editing, so there is no "end of it" to be at. This is
      // the half of `caretForCell` that had to survive dropping its dim case.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "l", "e", "<Enter>", "<End>" ]),
          "let ⟨name⟩ = ~⟨value⟩\n⟨body⟩") ])


module ARecordLiteralCanBeTyped =
  test aRecordLiteralCanBeTyped =
    Stdlib.Test.all(
      // CORRECTION to the tick that added this. I wrote that there was no way to build a record literal.
      // There was: `recordCandidates` offers a record type in completion, and picking one arrives with the
      // declared field NAMES already in it. Its own comment says the choice was deliberate -- "makes
      // completion the natural build path rather than a `{` trigger" -- and I added the `{` trigger without
      // having read it.
      //
      // What `{` is actually for is the type that does NOT exist yet, which is the ordinary case while you
      // are sketching: you cannot complete a name the store has never heard of. So it stays, and it now looks
      // the name up through the same search completion uses, so both entrances give the same thing when the
      // type is known.
      [ Stdlib.Test.equal(
          Fixtures.screen([ "S", "i", "z", "e", "{" ]),
          "Stdlib.Cli.Tui.Size { width = ~⟨width⟩, height = ⟨height⟩ }")

        Stdlib.Test.equal(
          Fixtures.screen([ "S", "i", "z", "e", "<Enter>" ]),
          "Stdlib.Cli.Tui.Size { width = ~⟨width⟩, height = ⟨height⟩ }")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "S", "i", "z", "e", "{", "1", "<Tab>", "2", "<Esc>", "<Esc>" ]),
          "Stdlib.Cli.Tui.Size { width = 1, height = 2 }")

        // The case completion cannot serve: a name the store does not know. One empty field to type into.
        Stdlib.Test.equal(
          Fixtures.screen([ "Z", "o", "r", "k", "{" ]),
          "Zork { ~⟨name⟩ = ⟨value⟩ }")

        // Everything after that first keystroke already existed: `,` adds a sibling field, Tab moves name to
        // value, and the caret lands on the name because it is the first BLANK in the drawing.
        Stdlib.Test.equal(
          Fixtures.screen([ "Z", "o", "r", "k", "{", "x", "<Tab>", "1" ]),
          "Zork { x = 1~ }")

        Stdlib.Test.equal(
          Fixtures.screen(
            [ "Z"
              "o"
              "r"
              "k"
              "{"
              "x"
              "<Tab>"
              "1"
              ","
              "y"
              "<Tab>"
              "2" ]),
          "Zork { x = 1, y = 2~ }")

        // And it lowers. A name that resolves to nothing is kept as an UNRESOLVED name rather than refusing the
        // node: the document holds what you typed, and the save puts the source back through the real parser,
        // which is the thing that actually resolves names.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "Z", "o", "r", "k", "{", "x", "<Tab>", "1", "<Esc>", "<Esc>" ]),
          "Zork { x = 1 }")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "Z"
              "o"
              "r"
              "k"
              "{"
              "x"
              "<Tab>"
              "1"
              ","
              "y"
              "<Tab>"
              "2"
              "<Esc>"
              "<Esc>" ]),
          "Zork { x = 1, y = 2 }")

        // A name on its own is still a variable. The `{` is what changes what it is.
        Stdlib.Test.equal(
          Fixtures.program([ "Z", "o", "r", "k", "<Esc>", "<Esc>" ]),
          "Zork")

        // ...and now the PRINTED form types back, which is the thing neither entrance gave. Three separate
        // pieces of the drawing were being retyped and each was taken as content: the field NAME the literal
        // arrives already carrying, the `=` after it, and the `}` the printer puts on its own line.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Zork { x = 1 }"),
              [ "<Esc>", "<Esc>" ])),
          "Zork { x = 1 }")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Size { width = 1; height = 2 }"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.Cli.Tui.Size { width = 1, height = 2 }")

        // The reading the label rule must NOT take. A local called `width` is a perfectly good value for the
        // field of the same name, and it reads identically up to the space. So the space settles nothing there
        // -- neither commits the menu nor resolves the partial -- and the NEXT key decides: `=` means the label
        // you already have, anything else means the variable. Before this, the space committed the menu's best
        // guess and `height` became `Darklang.Cli.CompletionPicker.minimumHeight`.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars(
                "let width = 1 Size { width = width; height = 2 }"),
              [ "<Esc>", "<Esc>" ])),
          "let width = 1\nStdlib.Cli.Tui.Size { width = width, height = 2 }")

        // A field name is a NAME. `FieldText` draws one just as `NameText` does -- they differ in how a name is
        // QUOTED, not in what one is -- and the class derived from the piece was keyed on only one of them, so
        // the five slots drawn with `FieldText` accepted any character at all. The space and the `}` above went
        // straight into the field name, and the drawing then honestly showed them back as `` ` x` `` and `` `}` ``.
        Stdlib.Test.equal(
          Fixtures.screen([ "Z", "o", "r", "k", "{", " " ]),
          "Zork { ~⟨name⟩ = ⟨value⟩ }")

        Stdlib.Test.equal(
          Fixtures.screen([ "Z", "o", "r", "k", "{", "}" ]),
          "Zork { ⟨name⟩ = ⟨value⟩ }~") ])


module ALetCarriesItsValuesType =
  // Found by building an ordinary thing in a terminal: a record, bound to a name, then a field of it.
  //
  //     let cfg = Size { width = 80; height = 24 }
  //     cfg.        <- offered nothing
  //
  // A let-bound name had no type at all. `Spec.bound` sets `typ = None`, so the field offers -- which ask
  // what the target is DECLARED to be -- had nothing to ask about. The document knew: the value is a
  // record literal and a record literal stores the hash of the type it is. The binder was dropping
  // something already written down.
  //
  // Only when the pattern binds exactly one name. A tuple pattern binds several and the value's type does
  // not say which is which.
  let menu(keys: List<String>): String =
    let st =
      Fluid.Test.drive(
        Fluid.Editor.init(Fixtures.reg(), Fixtures.hole(), 60),
        keys)

    Fluid.Editor.candidates(st)
    |> Stdlib.List.map(fun c -> c.label)
    |> Stdlib.String.join(", ")


  let built(extra: List<String>): List<String> =
    Stdlib.List.concat(
      [ "let"
        "<Enter>"
        "cfg"
        "<Tab>"
        "Size"
        "<Enter>"
        "80"
        "<Tab>"
        "24"
        "<Tab>" ],
      extra)


  test aLetCarriesItsValuesType =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          ALetCarriesItsValuesType.menu(
            ALetCarriesItsValuesType.built([ "cfg", "." ])),
          "width, height")

        Stdlib.Test.equal(
          Fixtures.screen(
            ALetCarriesItsValuesType.built([ "cfg", ".", "w", "<Enter>" ])),
          "let cfg = Stdlib.Cli.Tui.Size { width = 80, height = 24 }\ncfg.width~")

        // It stops where the document stops knowing. A let bound to an int has no fields to offer, and nothing
        // here infers one.
        Stdlib.Test.equal(
          ALetCarriesItsValuesType.menu(
            [ "let", "<Enter>", "a", "<Tab>", "1", "<Tab>", "a", "." ]),
          "") ])


module SpaceCommitsOnlyWhatIsUnambiguous =
  test spaceCommitsOnlyWhatIsUnambiguous =
    Stdlib.Test.all(
      // `recordCandidates` claimed in a comment that typing `Size` and pressing SPACE builds the record. It
      // does not and never has, and the comment is fixed. Pinned here because a comment can say anything and
      // this cannot.
      //
      // Space commits the menu only when it is unambiguous: one candidate, or an exact match on the label.
      // `Size` is a loose prefix over three types whose labels are all longer, so space finalises what was
      // typed and moves on. Enter and Tab commit the top candidate, which is what actually builds the record.
      //
      // The QUALIFIED name used to differ, and only by accident: it is unique, so the space committed the
      // whole record with its `{` already drawn, and the `{` you typed next opened a record UPDATE in
      // whichever hole the caret had landed in. `keyword` was answering two questions -- "may a space take
      // this" and "may Tab take this" -- which agree everywhere except here. They are two fields now, and
      // both spellings take the same path.
      [ Stdlib.Test.equal(Fixtures.screen([ "S", "i", "z", "e", " " ]), "Size~")

        Stdlib.Test.equal(
          Fixtures.screen([ "S", "i", "z", "e", "<Tab>" ]),
          "Stdlib.Cli.Tui.Size { width = ~⟨width⟩, height = ⟨height⟩ }") ])


module APipeTakesTheWholeExpression =
  // `x * 2` then `|>` piped the `2` and left `x * (2 |> _)`. A pipe binds looser than every operator
  // there is, so it takes the whole product, the same way the parser reads `x * 2 |> f`.
  //
  // Found by typing a realistic pipeline into the TUI, which is where it shows: the drawing was
  // `x * (2 |> ⟨step⟩)`, and the parenthesised `2` is the only thing on screen that says so.
  //
  // The infix climb was already there and already right (`+` after `1 * 2` takes the product, `*` after
  // `1 + 2` takes just the `2`). `applyWrap` reached for it only when the rule had an `op` slot, and the
  // pipe rule has none, so the pipe never asked. It now asks what the rule BUILDS: a construct that
  // swallows what follows it takes the whole expression that ends at the caret. Same answer Enter gets,
  // from the same function, and a DSL that adds its own swallowing construct gets it without the kernel
  // being told about that construct.
  let pipeTo(): List<String> =
    [ "|"
      ">"
      "S"
      "t"
      "d"
      "l"
      "i"
      "b"
      "."
      "p"
      "r"
      "i"
      "n"
      "t"
      "L"
      "i"
      "n"
      "e"
      "<Esc>" ]


  test aPipeTakesTheWholeExpression =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              [ "x", "*", "2" ],
              APipeTakesTheWholeExpression.pipeTo())),
          "x * 2 |> Stdlib.printLine")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              [ "1", "+", "2", "*", "3" ],
              APipeTakesTheWholeExpression.pipeTo())),
          "1 + 2 * 3 |> Stdlib.printLine")

        // The climb stops at the first construct that swallows what follows it, so a pipe written inside a
        // lambda body stays inside the lambda rather than reaching out to whatever encloses it.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              [ "f", "u", "n", " ", "x", " ", "-", ">", "x", "*", "2" ],
              APipeTakesTheWholeExpression.pipeTo())),
          "(fun x -> x * 2 |> Stdlib.printLine)") ])


module AnOperatorIsNotPartOfAName =
  // `x |> Stdlib.printLine` then `+` gave the single NAME `Stdlib.printLine+1`, which no lookup will ever
  // resolve and nothing said so at the time. Same shape as AnOperatorAfterAFieldNameWraps, in the four
  // other places a name is drawn: a pipe step's function, a pipe enum's type, an enum's type, a custom
  // type's name.
  //
  // Fixed by DERIVING the rule rather than repeating it. `Piece.NameText` already means "this slot holds
  // a fully-qualified name" -- that is why the piece exists, and why it shortens for display -- so a slot
  // drawn with it gets a name-shaped text class unless the spec declares its own, which still wins. A DSL
  // that draws a name gets this without saying anything, which is the point.
  //
  // Refused rather than wrapped, because a pipe STEP is not an expression: there is no infix for `+` to
  // build there. So it reports itself instead of quietly doing something else.
  let pl(): List<String> =
    [ "S"
      "t"
      "d"
      "l"
      "i"
      "b"
      "."
      "p"
      "r"
      "i"
      "n"
      "t"
      "L"
      "i"
      "n"
      "e" ]


  test anOperatorIsNotPartOfAName =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.flatten(
              [ [ "x", "|", ">" ]
                AnOperatorIsNotPartOfAName.pl()
                [ "+", "<Esc>" ] ])),
          "x |> Stdlib.printLine")

        // The dots are part of the name, so a qualified name still types straight through.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              AnOperatorIsNotPartOfAName.pl(),
              [ " ", "1", "<Esc>" ])),
          "Stdlib.printLine(1)")

        // The two places an operator after a name SHOULD wrap still do. These are the regression guards: the
        // new class must not reach a variable or a field, whose slots are drawn differently.
        Stdlib.Test.equal(
          Fixtures.program([ "a", "b", "c", "+", "1", "<Esc>" ]),
          "abc + 1")

        Stdlib.Test.equal(
          Fixtures.program(
            [ "s", ".", "w", "i", "d", "t", "h", "+", "1", "<Esc>" ]),
          "s.width + 1") ])


module AnEnumCaseIsNamedTheWayItIsWritten =
  // `Stdlib.Result.Result.Ok` offered NOTHING, so the space that should have committed the case went into
  // the name and `Ok x` came out as the single name `Stdlib.Result.Result.Okx`. Only the bare `Ok`
  // completed: the filter compared the CASE name against the whole typed string, so any qualifier killed
  // it.
  //
  // Which means the pretty-printer's own output could not be typed back in. That is the same faithfulness
  // question EveryDrawingIsTheProgram asks of rendering, from the authoring side, and it is how this was
  // found -- writing `Stdlib.Result.Result.Ok head` into the TUI, which is what you write after reading a
  // printed function.
  //
  // A constructor is now named by any tail of its type's path, at segment boundaries, the way names work
  // everywhere else here.
  let ok(): List<String> =
    [ "S"
      "t"
      "d"
      "l"
      "i"
      "b"
      "."
      "R"
      "e"
      "s"
      "u"
      "l"
      "t"
      "."
      "R"
      "e"
      "s"
      "u"
      "l"
      "t"
      "."
      "O"
      "k" ]


  test anEnumCaseIsNamedTheWayItIsWritten =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              AnEnumCaseIsNamedTheWayItIsWritten.ok(),
              [ " ", "x" ])),
          "Result.Ok(x~)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              AnEnumCaseIsNamedTheWayItIsWritten.ok(),
              [ " ", "x", "<Esc>" ])),
          "Result.Ok(x)")

        // Every tail names it, including the bare case that always worked.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "R", "e", "s", "u", "l", "t", ".", "O", "k", " ", "x" ]),
          "Result.Ok(x~)")

        Stdlib.Test.equal(
          Fixtures.screen([ "O", "k", " ", "x" ]),
          "Result.Ok(x~)")

        // A qualifier that names a different type offers nothing, which is the guard that says the qualifier is
        // actually being READ rather than ignored. With no candidate there is nothing for the space to commit,
        // so it is refused and the name is left as typed -- no trailing space in the drawing.
        Stdlib.Test.equal(
          Fixtures.screen(
            [ "S"
              "t"
              "d"
              "l"
              "i"
              "b"
              "."
              "O"
              "p"
              "t"
              "i"
              "o"
              "n"
              "."
              "O"
              "k"
              " " ]),
          "Stdlib.Option.Ok~") ])


module AnEnumPatternTakesItsFields =
  test anEnumPatternTakesItsFields =
    Stdlib.Test.all(
      // `match r with | Ok v ->` -- the form the stdlib writes most -- came out as `| Ok -> v`. A DIFFERENT
      // program, silently: the field never existed and the binding became the right-hand side.
      //
      // The pattern side had no store-backed completion at all. Its hole rule turned the first LETTER into an
      // `MPVariable`, so the slot was Filled, and `computeCandidates` only pools candidates for a Partial or
      // an Empty. The expression side never had this bug because its candidate carries the field holes, and
      // its spec has no `<letter>` rule so a letter falls through to a partial.
      //
      // Now the pattern splits on case the way the LANGUAGE does: `ok` binds and goes straight to a variable,
      // `Ok` names a constructor and stays a partial long enough for completion to offer it with one hole per
      // field. A capitalised name that matches no constructor still resolves to a pattern variable, so
      // nothing dead-ends.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match input Ok v 1"),
              [ "<Esc>", "<Esc>" ])),
          "match input with\n| Ok(v) -> 1")

        // Both spellings are real Darklang and the stdlib writes both, so `(` after a fully-typed constructor
        // commits it the same way space does. Only on an EXACT match: `(` after a half-typed name is someone
        // opening a group, not accepting a completion they cannot see the end of.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match input Ok(v 1"),
              [ "<Esc>", "<Esc>" ])),
          "match input with\n| Ok(v) -> 1")

        // A constructor with no fields, and a capitalised name that is not one. Both regressed while this was
        // being written -- the caret sat after the settled node and the next character went missing -- which is
        // why `landSettled` asks the spec whether an operator could follow instead of naming patterns.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match input None 1"),
              [ "<Esc>", "<Esc>" ])),
          "match input with\n| None -> 1")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match input Xy 1"),
              [ "<Esc>", "<Esc>" ])),
          "match input with\n| Xy -> 1")

        // Nine types declare an `Error` and they do not all have the same arity, so the tie-break is load
        // bearing: picking a ZERO-field `Error` leaves no hole, the caret moves to the right-hand side, and the
        // binding is typed there. `| Error -> e` instead of `| Error(e) ->`, silently. This is the pin that
        // caught it, via the two arms below.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match n Error(e 0"),
              [ "<Esc>", "<Esc>" ])),
          "match n with\n| Error(e) -> 0")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match n Error e 0"),
              [ "<Esc>", "<Esc>" ])),
          "match n with\n| Error(e) -> 0")

        // The lowercase half, and the other pattern shapes that go through the same hole rules.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("match input x 1"),
              [ "<Esc>", "<Esc>" ])),
          "match input with\n| x -> 1")

        // CLEANUP the move to call syntax changed this; it was "match input with\n| h :: t~ -> ⟨rhs⟩"
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match input h::t")),
          "match input with\n| [h, ...:t~] -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match input (a,b")),
          "match input with\n| (a, b~) -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match input _")),
          "match input with\n| _~ -> ⟨rhs⟩") ])


module AFieldAccessCanBeComparedWithSpaces =
  test aFieldAccessCanBeComparedWithSpaces =
    Stdlib.Test.all(
      // `if cfg.height > 20` came out as `if cfg.height then > else 20`. The space after a field access left
      // it entirely, so the `>` landed in the THEN branch and the `20` in the ELSE -- a program that says
      // something else, silently, from the spacing everyone writes.
      //
      // Found by typing a config record and branching on one of its fields in the TUI, which is ordinary
      // code. A plain variable never had this bug: it settles through the MENU, which already lands after the
      // node. A field access settles as TEXT and took the "space means next hole" path instead.
      //
      // Fixed with the same `landSettled` rule the pattern work needed: where an operator could follow, space
      // leaves the caret on what it settled; where one could not, it moves on.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if s.width > 20 ")),
          "if s.width > 20~ then ⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if s.width + 1 ")),
          "if s.width + 1~ then ⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let n = s.width + 1 n"),
              [ "<Esc>", "<Esc>" ])),
          "let n = s.width + 1\nn")

        // The no-space spelling, already pinned by AnOperatorAfterAFieldNameWraps, still works. Both spacings
        // have to, because both are what people write.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("s.width+1"),
              [ "<Esc>", "<Esc>" ])),
          "s.width + 1")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("s.width + 1"),
              [ "<Esc>", "<Esc>" ])),
          "s.width + 1") ])


module AnOperatorWaitsForItsOperand =
  test anOperatorWaitsForItsOperand =
    Stdlib.Test.all(
      // `(a + b` put the `b` in the TUPLE's second item: `(a + ⟨right⟩, b)`. Space after an operator was
      // landing the caret after the whole infix, so the next thing typed went past the operand that was
      // still waiting inside it.
      //
      // I introduced this in the commit that let a literal take an operator, and every pin missed it because
      // they all write `a + b` at the TOP LEVEL -- where the caret after the infix has no competing hole, so
      // "next hole" and "the right operand" are the same place. Put the same expression inside anything with
      // a later hole and they stop being the same place. Found by typing
      // `Stdlib.List.filter (fun x -> x % 2 == 0)` into the TUI.
      //
      // An operator is not a settled value: what it waits for is its operand, and that is inside the node.
      // Keyed on the wrap rule's own trigger rather than "is this an op slot", because the `.` rule's op-slot
      // holds a field NAME -- the coarser test brought `if s.width > 20` straight back.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(a + b")),
          "(a + b~, ⟨item⟩)")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(a+b")),
          "(a + b~, ⟨item⟩)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("(a + b"),
              [ "<Tab>", "c", "<Esc>", "<Esc>" ])),
          "(a + b, c)")

        // The three the operand rule has to keep working, one per settling route: a name through the menu, a
        // literal as text, a field access as text.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let n = a + b n"),
              [ "<Esc>", "<Esc>" ])),
          "let n = a + b\nn")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let n = 1 + 2 n"),
              [ "<Esc>", "<Esc>" ])),
          "let n = 1 + 2\nn")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if s.width > 20 1 "),
              [ "<Tab>", "0", "<Esc>", "<Esc>" ])),
          "if s.width > 20 then 1 else 0") ])


module ALineBreakIsLayoutNotStructure =
  test aLineBreakIsLayoutNotStructure =
    Stdlib.Test.all(
      // The printer breaks a list across lines when it does not fit, and typing those breaks back added
      // structure the text does not carry: `[a,` already put the caret in an empty item, so the line break
      // after it added a SECOND and `[a, / b]` came out `[a, ⟨item⟩, b]`.
      //
      // Two things were wrong and each is a rule this file already had, asked from a key that had not been
      // asked.
      //
      // Enter grew the list past an untouched BLANK. It has to be a blank and not merely "an item with holes
      // in it": a fresh match ARM is a filled node whose slots are holes, and Enter adding one of those is
      // pinned behaviour a few modules down. A list's items are bare holes, and that is the difference.
      //
      // Enter then went to the NEXT hole from a hole it was already in. "On to the next blank" makes sense
      // from something finished, not from a blank you have not filled.
      //
      // And the closer arrived to find a trailing item nothing had been typed into, because the printer puts
      // its `]` on a line of its own and that last break started one. It drops it now -- only the last, only
      // when entirely holes, never the only one.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[a,"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("b]"),
                  [ "<Esc>", "<Esc>" ])))),
          "[ a, b ]")

        // What the trailing-item drop must not take: a list you are still filling in is not one to empty, and
        // a closer on a finished list leaves it alone.
        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("[")), "[ ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("[1, 2]"), [ "<Esc>", "<Esc>" ])),
          "[ 1, 2 ]")

        // And what Enter must still do: grow a list from a FINISHED item, and reach a waiting hole from
        // something settled.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[1"), [ "<Enter>" ])),
          "[ 1, ~⟨item⟩ ]")

        // CLEANUP the move to call syntax changed this; it was "Stdlib.List.map xs ~⟨fn⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map(xs)"),
              [ "<Enter>" ])),
          "Stdlib.List.map(xs)\n~⟨next⟩") ])


module ALetCanDestructureATuple =
  test aLetCanDestructureATuple =
    Stdlib.Test.all(
      // `let (a, b) = t` is ordinary Darklang and came out as `let (a, = b = t`: the `(` had no rule on a
      // let-pattern hole, so it became a PARTIAL and everything after it appended to it.
      //
      //     expression hole    `(` builds a tuple
      //     match pattern      `(` builds an MPTuple
      //     type hole          `(` builds a TTuple
      //     LET pattern        nothing
      //
      // Three of the four kinds had it. The LPTuple spec was already written and already drawn -- its own
      // comment records that a destructuring "could not be seen or edited" before it was registered under the
      // right kind, and it still could not be TYPED.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("let (")),
          "let (~⟨a⟩, ⟨b⟩) = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let (a, b) = p b"),
              [ "<Esc>", "<Esc>" ])),
          "let (a, b) = p\nb")

        // The rules it sits beside must still fire.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("let x")),
          "let x~ = ⟨value⟩\n⟨body⟩")

        // The wildcard is SELECTED here rather than passed, which is what `OnNode` is for: a `let _` is a whole
        // pattern with nothing to type into, and `c` to change it is the next thing anyone does.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("let _")),
          "let ~_ = ⟨value⟩\n⟨body⟩") ])


module APipeStepTakesArguments =
  test aPipeStepTakesArguments =
    Stdlib.Test.all(
      // `xs |> zork 1` came out `xs |> zork1` -- the space lost, the digit joining the name.
      //
      // Two things, and both are questions this file already asks somewhere else.
      //
      // `landSettled` waits AFTER a node when an operator could follow, because leaving would abandon what
      // the next key is about to attach to. An ARGUMENT could follow for the same reason, and it never asked
      // that. `EVariable` carries an `<operator>` rule so the caret landed after it and the apply rule could
      // reach it; `EPipeVariable` carries none, so the caret stayed in the name and the digit appended.
      //
      // Then the apply itself. On the expression side `<apply>` WRAPS a variable into a call; here there is
      // nothing to build, because `EPipeVariable` already has the `args` slot and is already drawn with
      // `ArgSlots`. It only needed extending.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("xs |> zork(1)"),
              [ "<Esc>", "<Esc>" ])),
          "xs |> zork(1)")

        // But the caret waiting after the name is also where a list grows, so the `1` first grew the PIPE:
        // `xs |> zork |> 1`. Two readings of one position, and the node itself settles it. Growing a sibling is
        // what a caret after a FINISHED item means, and a node that still offers `<apply>` is not finished: it
        // has said it can take another argument. So the argument wins where the node asks for one, and the
        // sibling wins everywhere else. `[[1] 2]` is still `[[1], 2]` because a list is not applied to anything.
        //
        // Only for a caret on an item's own path. Inside an `ArgSlots` list the caret sits on the last ARGUMENT,
        // which may well be appliable itself, and there the next value is a further argument to the outer call.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[[1] 2]"),
              [ "<Esc>", "<Esc>" ])),
          "[ [ 1 ], 2 ]")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map(xs, f)"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.map(xs, f)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("xs |> zork |> Stdlib.List.length"),
              [ "<Esc>", "<Esc>" ])),
          "xs\n|> zork\n|> Stdlib.List.length") ])


module APipeContinuationLine =
  test aPipeContinuationLine =
    Stdlib.Test.all(
      // The printer writes a pipe that does not fit one stage to a line, and typing that back put the `|>` in
      // as TEXT:
      //
      //     xs                       xs
      //     |> Stdlib.List.length    |>Stdlib.List.length     -- a second statement, spaces gone
      //
      // Enter after a finished expression starts a statement, which is right on its own. `|` at the start of
      // that statement's empty half is not: nothing in Darklang begins with `|>`, so it can only be a stage of
      // the pipe above.
      //
      // `leadPunctRevision` already says this sentence for a list ITEM -- the lead punctuation typed again, in
      // the fresh empty thing the last key just made, means the operator was meant. This is the same sentence
      // with SLOT for item.
      //
      // Unambiguous, which is what separates it from the `|` in a fresh match arm, where `||` is a real second
      // reading and the pins choose it deliberately.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("xs"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("|> Stdlib.List.length"),
                  [ "<Esc>", "<Esc>" ])))),
          "xs |> Stdlib.List.length")

        // CLEANUP the move to call syntax changed this; it was "1 |> Stdlib.Int.toString"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("|> Stdlib.Int.toString"),
                  [ "<Esc>", "<Esc>" ])))),
          "1 |> `Stdlib.Int.toString`")

        // A bare name as a STEP settles too, which it never has. The pipe spec answered `Spec.noResolve` while
        // the expression spec built an EVariable, so `1 |> g` drew correctly and then refused to lower --
        // "unresolved: g" -- though `zzz a` has settled at expression level since record literals landed.
        // `EPipeVariable` was already here and already drawn; nothing could build one by typing.
        //
        // Found by writing this pin badly: I picked `g` as a step name, it failed, and the inline form failed
        // the same way, so it was never about continuation lines at all.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("1 |> g"), [ "<Esc>", "<Esc>" ])),
          "1 |> g")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("|> g"),
                  [ "<Esc>", "<Esc>" ])))),
          "1 |> g")

        // A statement that is NOT a pipe stage still sequences.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("2"),
                  [ "<Esc>", "<Esc>" ])))),
          "1\n2") ])


module AStringHoldsWhateverYouType =
  test aStringHoldsWhateverYouType =
    Stdlib.Test.all(
      // Every operator character broke OUT of a string body and wrapped the string in an infix:
      //
      //     "a/b"   ->  "a" / b
      //     "a=b"   ->  "a" = b
      //     "a.b"   ->  ("a").b
      //
      // so no path, no URL and no message with punctuation in it could be typed. `+ - * / % ^ > < = ! &` all
      // did it, and `.` made a field access. Only the non-operator punctuation stayed in.
      //
      // The plainest construct in the language, and every string pinned in this file is operator-free, which
      // is exactly why nothing caught it. The store-wide typed sweep found it on a real body,
      // `Stdlib.Cli.FileSystem.readFile "$HOME/.bashrc"`.
      //
      // Its neighbours in the chain all ask: `typeOne` guards eight branches on `inStringBody`, and the space
      // rule two lines above asks `slot != "body"`. The operator branch did not, so `isOperatorChar` won.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a/b\""),
              [ "<Esc>", "<Esc>" ])),
          "\"a/b\"")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a = b\""),
              [ "<Esc>", "<Esc>" ])),
          "\"a = b\"")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a.b\""),
              [ "<Esc>", "<Esc>" ])),
          "\"a.b\"")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"2 > 1\""),
              [ "<Esc>", "<Esc>" ])),
          "\"2 > 1\"")

        // The closing quote is what ends a string, and from after it an operator wraps exactly as before.
        // CLEANUP the move to call syntax changed this; it was "\"a\" ++ \"b\""
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a\" ++ \"b\""),
              [ "<Esc>", "<Esc>" ])),
          "\"a\" + \"b\"")

        // ...and so does Right, which never did. `moveRight` asks for the next cell a caret can occupy, and the
        // cell after a string's body is its closing QUOTE -- punctuation the node draws, which takes none -- so
        // it found nothing and stayed put. `"a` then Right sat exactly where it started.
        //
        // Nobody noticed because typing an operator got you out, by breaking the string. A pin was using that
        // as its way out, and it stopped working the moment an operator inside a string became content. Two
        // bugs, and the second was only visible once the first was fixed.
        Stdlib.Test.equal(Fixtures.screen([ "\"", "a", "<Right>" ]), "\"a\"~")

        Stdlib.Test.equal(
          Fixtures.screen([ "\"", "a", "<Right>", "+" ]),
          "\"a\" +~ ⟨right⟩") ])


module AWildcardParamDoesNotSwallowTheBody =
  test aWildcardParamDoesNotSwallowTheBody =
    Stdlib.Test.all(
      // `fun _ ->` is how you ignore an argument, and it ate everything after itself:
      //
      //     Stdlib.List.map (fun _ -> true) "a"   ->  (fun _ -> "a") ⟨fn⟩
      //
      // The `->`, the body, and everything up to the next argument were dropped in silence, and the next
      // argument then landed in the body, leaving the call a hole short.
      //
      // `_` is a whole pattern drawn as a LABEL, so it has no text and no hole. `firstEditable` and
      // `lastEditable` both answer `OnNode` when they find neither, which is how they tell their own
      // recursion "nothing here" -- and `typeOneRaw` answers `OnNode` with `st`, so it is a position where
      // typing does nothing at all. Landing a caret there is the "key that does nothing" this file keeps
      // saying to avoid.
      //
      // After the node instead, wherever something was just BUILT: the next key then acts on what follows,
      // and the arrow rule takes `->` to the body exactly as it does after a named parameter. The nav-side
      // callers are untouched -- `OnNode` is a real position for `j`/`k` and for the change action.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("fun _ -> true"),
              [ "<Esc>", "<Esc>" ])),
          "(fun _ -> true)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map((fun _ -> true), \"a\")"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.map((fun _ -> true), \"a\")")

        // A named param must still land IN its name, not after it.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("fun x")),
          "(fun(x~) -> ⟨body⟩)") ])


module AQualifiedNameTheStoreDoesNotKnowStillSettles =
  test aQualifiedNameTheStoreDoesNotKnowStillSettles =
    Stdlib.Test.all(
      // A name that resolves to nothing is kept as WHAT WAS TYPED -- the document holds it, and the save puts
      // the source back through the real parser, which is the thing that resolves names. `Zork` has worked
      // that way since record literals landed.
      //
      // A QUALIFIED one did not, and not on purpose. `resolveExprPartial` asks `isIdentifier`, which requires
      // every character to be alphanumeric or `_`, so a dot turned it away and the partial never settled at
      // all: the space after it did nothing, the next hole was nowhere, and the next letter appended to the
      // name.
      //
      //     Builtin.charToAsciiCode earg0   ->  one long word
      //
      // Every builtin wrapper body in the store is written that way, which is how the store-wide typed sweep
      // found it.
      [ // CLEANUP the move to call syntax changed this; it was "Zork.zzz a"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Zork.zzz a"),
              [ "<Esc>", "<Esc>" ])),
          "`Zork.zzz`(a)")

        // CLEANUP the move to call syntax changed this; it was "A.B.c d"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("A.B.c d"),
              [ "<Esc>", "<Esc>" ])),
          "`A.B.c`(d)")

        // A bare unresolved name was always fine, and a resolved one goes through the menu. Both stay.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("zzz a"), [ "<Esc>", "<Esc>" ])),
          "zzz(a)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.length(a)"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.length(a)")

        // The half that keeps a CONSTRUCTOR a constructor. An enum case is spelled exactly like a qualified
        // name, so once `resolve` accepted one, `Stdlib.Option.None` began settling as a VARIABLE with that
        // name -- before the menu, which holds the real thing, was ever asked. The menu goes first now: a
        // candidate is the more specific answer wherever both have one, and `resolve` is the fallback for what
        // no menu lists.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.Option.None"),
              [ "<Esc>", "<Esc>" ])),
          "Option.None")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[Stdlib.Option.None, 1]"),
              [ "<Esc>", "<Esc>" ])),
          "[ Option.None, 1 ]") ])


module ADrawnKeywordIsNotAValueEither =
  test aDrawnKeywordIsNotAValueEither =
    Stdlib.Test.all(
      // `if a then` and Enter built a function call nobody asked for:
      //
      //     if a then Stdlib.Result.andThen ⟨result⟩ ⟨fn⟩ else ⟨else⟩
      //
      // The `if` draws its own `then`. Typing the one you can see leaves a PARTIAL holding `then` in the
      // branch, and Enter hands a partial to the menu -- whose best fuzzy match for `then` is `andThen`.
      //
      // The other half of a question this file already answers. A PATTERN hole becomes a node the moment you
      // press a letter, and that half was fixed when `match n with` then Enter was giving the first arm the
      // pattern `with`. An EXPRESSION hole stays a partial, and that half was answered only for SPACE, in a
      // different place. So: same question, two kinds of hole, two keys, three implementations, and the one
      // combination nobody had written down was the one that broke.
      //
      // One helper now, and both keys and both holes ask it.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("if a then"), [ "<Enter>" ])),
          "if a then ~⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if a then"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("1 else 2"),
                  [ "<Esc>", "<Esc>" ])))),
          "if a then 1 else 2")

        // Space kept its answer, which is where the partial half was written originally.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then ")),
          "if a then ~⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if x > 1 then 2 else 3"),
              [ "<Esc>", "<Esc>" ])),
          "if x > 1 then 2 else 3")

        // And the node half, which must not have moved.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n with"),
              Stdlib.List.concat([ "<Enter>" ], Fixtures.chars("0 -> 1")))),
          "match n with\n| 0 -> 1~") ])


module ASecondPipeStartsTheNextStage =
  test aSecondPipeStartsTheNextStage =
    Stdlib.Test.all(
      // A second `|>` went INSIDE the stage before it:
      //
      //     xs |> Stdlib.List.map f |> Stdlib.List.length
      //     ->  xs |> Stdlib.List.map (f |> Stdlib.List.length)
      //
      // No parentheses and no lambda needed -- any second `|>` typed after a call's ARGUMENT. The rule that
      // starts the next stage exists and is right, and is keyed on the caret being `InItem("steps", i)` on
      // the pipe node itself. After an argument the caret is several steps down, so it never fired, and the
      // `|>` fell through to wrapping whatever was under it. The precedence climb then did exactly what it
      // was asked: it stops below a construct that swallows what follows, and a pipe is one.
      //
      // `leadPunctSibling` already walks the enclosing list items inside-out and already reaches this
      // position -- it just did not recognise the key. A pipe leads its stages with `|>` and you press `|`,
      // and `leadsItemsWith` compared the two exactly. The first character of a MULTI-character lead is now
      // enough to mean it, the same way the first character of multi-character punctuation drawn ahead is.
      //
      // Stays spec-read: no kind named, and a DSL leading its stages with `>>` gets this too.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("xs |> Stdlib.List.map(f) |> Stdlib.List.length"),
              [ "<Esc>", "<Esc>" ])),
          "xs\n|> Stdlib.List.map(f)\n|> Stdlib.List.length")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars(
                "xs |> Stdlib.List.map(fun x -> x + 1) |> Stdlib.List.length"),
              [ "<Esc>", "<Esc>" ])),
          "xs\n|> Stdlib.List.map(fun x -> x + 1)\n|> Stdlib.List.length")

        // What the widening must NOT take. A `|` on a FRESH pipe is the second half of `||`, and the conversion
        // back to the operator still wins -- a fresh stage is an empty hole, and `atEndOfItem` answers false
        // there, which is what keeps the sibling path out of it.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("a || b"), [ "<Esc>", "<Esc>" ])),
          "a || b")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("a || b || c"),
              [ "<Esc>", "<Esc>" ])),
          "a || b || c")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("a && b"), [ "<Esc>", "<Esc>" ])),
          "a && b")

        // And the single-stage pipes, which were always right.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("xs |> Stdlib.List.length"),
              [ "<Esc>", "<Esc>" ])),
          "xs |> Stdlib.List.length")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[1] |> Stdlib.List.length"),
              [ "<Esc>", "<Esc>" ])),
          "[ 1 ] |> Stdlib.List.length") ])


module LeavingAnItemSettlesWhatWasTypedInIt =
  test leavingAnItemSettlesWhatWasTypedInIt =
    Stdlib.Test.all(
      // `[zork]` drew exactly right and then refused to lower: "unresolved: zork". So did every constructor
      // written inside a collection, which is how it was found -- but it was never about constructors.
      //
      // A name is a PARTIAL until something settles it. Three keys leave an item, and each moved the caret
      // somewhere else without settling first: the `]` and `)` that step past a drawn closer, and the `,`
      // that starts the next item. Escape afterwards settles what the caret is ON, and by then that is the
      // next item or the whole construct, so nothing ever resolved it.
      //
      // Enter had this right already, and the `)` that collapses a one-item tuple to a group learned it two
      // ticks ago -- the note then said the other ways out wanted the same audit. This is that audit.
      //
      // No trailing Escape in these on purpose: the point is that leaving the item is what settles it.
      [ Stdlib.Test.equal(
          Fixtures.program(Fixtures.chars("[zork]")),
          "[ zork ]")

        Stdlib.Test.equal(
          Fixtures.program(Fixtures.chars("[a, b]")),
          "[ a, b ]")

        Stdlib.Test.equal(
          Fixtures.program(Fixtures.chars("[Stdlib.Option.None]")),
          "[ Option.None ]")

        Stdlib.Test.equal(
          Fixtures.program(Fixtures.chars("(Stdlib.Option.None, 1)")),
          "(Option.None, 1)")

        Stdlib.Test.equal(
          Fixtures.program(Fixtures.chars("[Stdlib.Option.None, 1]")),
          "[ Option.None, 1 ]")

        // A `)` around one thing is still a group, and it still settles what is inside it.
        Stdlib.Test.equal(Fixtures.program(Fixtures.chars("(zork)")), "zork") ])


module EnterReachesTheNextHoleWhereverYouAre =
  test enterReachesTheNextHoleWhereverYouAre =
    Stdlib.Test.all(
      // Enter's answer depended on the SHAPE of the thing you had just finished:
      //
      //     let x = "a" <Enter> x    let x = "a"      a closing quote leaves the caret AfterNode
      //                              x
      //     let x = 1   <Enter> x    let x = 1        a number leaves it in the digits
      //                              ⟨body⟩           -- and the `x` is then refused by the number
      //
      // Worst of them, because it is silent: `if a then 1` then Enter then `2` gave `if a then 12`. Enter did
      // nothing, so the digit joined the number it was sitting in.
      //
      // Enter dispatches on whether the caret is in a list, and the two halves had different fallbacks. The
      // in-a-list one grew a sibling, then sequenced, then went to the next hole -- that last step added when
      // a capped argument list showed `Stdlib.List.map xs` then Enter doing nothing with a `⟨fn⟩` blank
      // waiting. The not-in-a-list one stopped at sequencing. Same key, same missing step, one branch over,
      // and the AfterNode branch already carries this sentence in its own comment.
      //
      // `sequenceHere` is what makes the next hole the right answer rather than a guess: it declines while
      // the document still holds a blank, which is already "fill the holes before starting a new statement".
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let x = 1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("x"),
                  [ "<Esc>", "<Esc>" ])))),
          "let x = 1\nx")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if a then 1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("2"),
                  [ "<Esc>", "<Esc>" ])))),
          "if a then 1 else 2")

        // The shapes that already worked and must keep their answers: a string settles AfterNode, a document
        // with no blanks left sequences, and a capped argument list goes to the hole it left.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let x = \"a\""),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("x"),
                  [ "<Esc>", "<Esc>" ])))),
          "let x = \"a\"\nx")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("1"),
              Stdlib.List.concat(
                [ "<Enter>" ],
                Stdlib.List.concat(
                  Fixtures.chars("2"),
                  [ "<Esc>", "<Esc>" ])))),
          "1\n2")

        // CLEANUP the move to call syntax changed this; it was "Stdlib.List.map xs ~⟨fn⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map(xs)"),
              [ "<Enter>" ])),
          "Stdlib.List.map(xs)\n~⟨next⟩") ])


module AnEnumConstructorCanBeTypedAsPrinted =
  test anEnumConstructorCanBeTypedAsPrinted =
    Stdlib.Test.all(
      // The printer writes these, and the parser reads them back:
      //
      //     Stdlib.Option.Some 1     prints as `Stdlib.Option.Some(1)`
      //     Stdlib.Option.None       prints as itself
      //
      // Typed into Fluid, every one was `ERR unresolved`. Constructors are built through COMPLETION -- pick
      // `Some` from the menu and it arrives with its field holes -- which is how every test here has ever
      // made one, so nothing noticed that the printed form was not an entrance.
      //
      // `enumCaseHits` splits the text into a case name and a qualifier naming the type. `Ok` and
      // `Stdlib.Result.Result.Ok` both matched: the second spells the type out, module path plus type name,
      // and the location ends with exactly that. `Stdlib.Option.None` did not. The printer ELIDES the
      // repeated segment, so the qualifier is the module path `Stdlib.Option` while the type is
      // `Darklang.Stdlib.Option.Option` -- which ends with `.Option.Option` and never with `.Stdlib.Option`.
      // The one qualifier shape every printed enum carries was the one shape the matcher could not see.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.Option.None"),
              [ "<Esc>", "<Esc>" ])),
          "Option.None")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.Option.Some 1"),
              [ "<Esc>", "<Esc>" ])),
          "Option.Some(1)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.Option.Some(1)"),
              [ "<Esc>", "<Esc>" ])),
          "Option.Some(1)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.Result.Ok 1"),
              [ "<Esc>", "<Esc>" ])),
          "Result.Ok(1)")

        // Finding the candidate was only half of it. The menu labels one the way the printer would write it
        // from HERE, so someone typing the printed form of something declared further away types MORE segments
        // than the label carries -- `Stdlib.Option.None` against a label of `Option.None` -- and the exact
        // match that lets space, `(` and Escape commit compared the two as strings. A zero-field case has
        // nothing following it to commit on, so `None` alone stayed a partial however it was settled.
        //
        // One-way on purpose: typing MORE qualification than the label says exactly which thing you mean,
        // typing less does not. `Size` is still a loose prefix over three types and space still finalises what
        // was typed rather than picking one.
        Stdlib.Test.equal(
          Fixtures.screen([ "S", "i", "z", "e", " " ]),
          "Size~") ])


module ADrawnKeywordIsNotAPattern =
  test aDrawnKeywordIsNotAPattern =
    Stdlib.Test.all(
      // `match n with` draws the `with` for you and lands the caret in the first arm's PATTERN. Typing it
      // back is the reflex that re-types a drawn `=` or a drawn `then`, and space had always put the hole
      // back. Enter had not:
      //
      //     match n with <Enter> 0 -> 1   ->  match n with
      //                                       | with -> ⟨rhs⟩
      //                                       | 0 -> 1
      //
      // Enter settled the keyword into a node and then added a sibling AROUND it, so the arm got built and
      // the real one had to be typed in a second. Same question, two keys, two answers -- the rule now lives
      // in one place and both ask it.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match n with 0 -> 1")),
          "match n with\n| 0 -> 1~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n with"),
              Stdlib.List.concat([ "<Enter>" ], Fixtures.chars("0 -> 1")))),
          "match n with\n| 0 -> 1~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n with"),
              Stdlib.List.concat([ "<Enter>" ], Fixtures.chars("| 0 -> 1")))),
          "match n with\n| 0 -> 1~")

        // Enter still starts the next arm once there is one to follow, by both routes.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match n with 0 -> 1 | 1 -> 2")),
          "match n with\n| 0 -> 1\n| 1 -> 2~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n with 0 -> 1"),
              Stdlib.List.concat([ "<Enter>" ], Fixtures.chars("1 -> 2")))),
          "match n with\n| 0 -> 1\n| 1 -> 2~") ])


module AVariableCanBeApplied =
  test aVariableCanBeApplied =
    Stdlib.Test.all(
      // `f xs` drew `f`. `f 1 2` drew `f`. The arguments were dropped with nothing said, so a local function
      // could be written and then never used -- and the whole second line here was untypeable:
      //
      //     let add = fun a b -> a + b
      //     add 1 2
      //
      // A QUALIFIED name always applied, because picking one from completion arrives as a call with its
      // argument slots already in it. A bare name resolves to an EVariable, which has no `args` slot at all,
      // so there was nothing for the next thing typed to go into.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("f xs"), [ "<Esc>", "<Esc>" ])),
          "f(xs)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("f 1 2"), [ "<Esc>", "<Esc>" ])),
          "f(1, 2)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("f(xs, fun x -> x)"),
              [ "<Esc>", "<Esc>" ])),
          "f(xs, fun x -> x)")

        // CLEANUP the move to call syntax changed this; it was "let add = (fun(a, b) -> a + b)\nadd(1, 2)"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let add = fun a b -> a + b add 1 2"),
              [ "<Esc>", "<Esc>" ])),
          "let add = fun a -> b - a + b\nadd(1, 2)")

        // Reached by NAME rather than by a character: the trigger is "a name follows a finished value", which
        // is a position and not a keystroke. `charClassMatches` ends in `else false`, so `<apply>` matches
        // nothing anyone types and the rule is invisible to the typing path; the kernel asks for it the way
        // `landSettled` asks whether a spec carries `<operator>`.
        //
        // It fires LAST, after the sibling and after the next hole, because both of those are the editor asking
        // for something specific and this is only what is left. Ahead of the next hole it took one that was
        // already waiting: an arity-capped arg list declines `addSibling`, so
        // `Stdlib.List.map xs (fun x -> x)` came out as `Stdlib.List.map (xs (fun x -> x)) ⟨fn⟩`.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map(xs, fun x -> x)"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.map(xs, fun x -> x)")

        // And the two readings it must not take. Only EVariable carries the rule, so a list is still not a
        // function and neither is an int: a name after either means the let's BODY.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let xs = [1] xs"),
              [ "<Esc>", "<Esc>" ])),
          "let xs = [ 1 ]\nxs")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let x = 1 x"),
              [ "<Esc>", "<Esc>" ])),
          "let x = 1\nx") ])


module GrowingAListDoesNotSkipAHole =
  test growingAListDoesNotSkipAHole =
    Stdlib.Test.all(
      // `(if x > 0 then 1 else 2)` came out as
      // `(if x > 0 then ⟨then⟩ else ⟨else⟩, then, 1, else, 2)`: the space after the `0` left the caret just
      // after it, inside the tuple's first item, and the `then` that came next grew the TUPLE instead of
      // filling the `if`'s own hole. Its keywords and branches became items.
      //
      // The same `if` with no list around it was always right, which is the tell: one question, and the
      // answer depended on what happened to enclose the caret. Growing the enclosing list is for a value
      // that is FINISHED -- `[[1] 2]` is `[[1], 2]` -- so it now asks whether the item the caret stands in
      // still has anything unfilled, and goes there first if it does.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("(if x > 0 then 1 else 2)"),
              [ "<Esc>", "<Esc>" ])),
          "if x > 0 then 1 else 2")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map((if x > 0 then 1 else 2), f)"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.map((if x > 0 then 1 else 2), f)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[if x > 0 then 1 else 2, 3]"),
              [ "<Esc>", "<Esc>" ])),
          "[ if x > 0 then 1 else 2, 3 ]")

        // The three growths it must NOT stop. Each item is finished, so a name after it is the next element.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[[1] 2]"),
              [ "<Esc>", "<Esc>" ])),
          "[ [ 1 ], 2 ]")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("[1 2]"), [ "<Esc>", "<Esc>" ])),
          "[ 1, 2 ]")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("(1, 2)"), [ "<Esc>", "<Esc>" ])),
          "(1, 2)") ])


module AParenAroundOneThingIsAGroup =
  test aParenAroundOneThingIsAGroup =
    Stdlib.Test.all(
      // `(` opens a TUPLE, so `(1 + 2)` came out as `(1 + 2, ⟨item⟩)` and `(fun x -> x)` could not be typed
      // at all -- the closing paren did nothing and the lambda sat in a two-tuple.
      //
      // Both are how the PRINTER writes things: a precedence group, and the parenthesised lambda in
      // `Stdlib.List.filter (fun x -> ...)`. Someone reading printed code and typing it back got a different
      // program, which is the same faithfulness question the enum constructors had. Darklang has no
      // one-tuples, so a `)` closing a tuple that holds one thing can only mean a group.
      //
      // Sits beside the two collapses already here: `()` is unit, `[]` is nil, `(x)` is x.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("(1 + 2)"),
              [ "<Esc>", "<Esc>" ])),
          "1 + 2")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(fun x -> x)")),
          "(fun(x) -> x)~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Fixtures.chars(
              "let items = [1] items |> Stdlib.List.filter(fun x -> x)")),
          "let items = [ 1 ]\nitems |> Stdlib.List.filter((fun(x) -> x))~")

        // ...and the `)` settles what you were typing on the way out. The collapse lands the caret AFTER the
        // whole group, so a name still half-typed under it was resolved by nothing afterwards -- not even
        // Escape, which settles what the caret is ON, and by then that is somewhere else. Each of these drew
        // exactly right and then refused to lower, "unresolved: x".
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("(fun x -> x * x)"),
              [ "<Esc>", "<Esc>" ])),
          "(fun x -> x * x)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map([1, 2, 3], fun x -> x * x)"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.List.map([ 1, 2, 3 ], fun x -> x * x)")

        // CLEANUP the move to call syntax changed this; it was "Stdlib.List.fold(xs, 0, fun(acc, x) -> acc + x)"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.fold(xs, 0, fun(acc, x) -> acc + x)"),
              [ "<Esc>", "<Esc>" ])),
          "ERR hole: body")

        // The two it must NOT collapse. A comma means a tuple was meant, and an immediate `)` is still unit.
        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("(1, 2)")), "(1, 2)~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("()")), "()~")

        // The caret has to be in the FILLED item, which is what tells `(1 + 2` + `)` from `(1, ` + `)`: in the
        // second the comma was deliberate and the caret sits in the hole, so it stays a tuple.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(1, ")),
          "(1, ~⟨item⟩)") ])


module SpacingDoesNotChangeAssociation =
  test spacingDoesNotChangeAssociation =
    Stdlib.Test.all(
      // `x * 2 + 3` typed WITH spaces gave `x * (2 + 3)`; typed without them it was right. Two spellings of
      // the same expression, two different programs, and the wrong one is the way people actually write.
      //
      // I introduced it. Space started leaving the caret just after the value it settled (which is what makes
      // `let n = 1 + 2` typable at all), and the AfterNode branch wrapped `caret.node` itself -- the node you
      // are standing after, not the one precedence says the operator takes. It went through `applyWrap` in
      // every other path and hand-rolled a worse copy here.
      //
      // Nothing caught it because the pins that test association type without spaces, and the pins that test
      // spacing use one operator. It needs both at once.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("x * 2 + 3")),
          "x * 2 + 3~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("x*2+3")),
          "x * 2 + 3~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("x % 2 == 0")),
          "x % 2 == 0~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("x%2==0")),
          "x % 2 == 0~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a + b == c")),
          "a + b == c~")

        // The tighter operator still does NOT climb, spaced or not: `*` after `1 + 2` takes just the `2`.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("1 + 2 * 3")),
          "1 + 2 * 3~") ])


module AnOperatorReassociatesWhenItIsFinished =
  test anOperatorReassociatesWhenItIsFinished =
    Stdlib.Test.all(
      // `a == b && c` parsed as `a == (b && c)`. An operator is typed one character at a time, and the wrap
      // that places it happens on the FIRST one: `&&` starts life as `&`, which `infixPowerOfText` scores as
      // the default 5 rather than the 2 that `&&` actually has. So it never climbed past the `==`.
      //
      // The second character is the first moment the real power is known, so that is when it decides again.
      // The tree already exists by then, so it ROTATES rather than re-wraps: `a == (b && r)` becomes
      // `(a == b) && r`, repeated while the parent still binds at least as tightly -- the same test
      // `reassocTarget` makes on the way in.
      //
      // These render without parentheses, which is the proof: the printer parenthesises by precedence, so a
      // wrongly-nested tree would show them.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a==b&&c")),
          "a == b && c~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a == b && c")),
          "a == b && c~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a&&b||c")),
          "a && b || c~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a+b<=c")),
          "a + b <= c~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("a<b==c")),
          "a < b == c~")

        // Single-character operators were never affected, and right-associativity still holds: `^` groups to
        // the right, so the rotation must NOT fire there.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("1 + 2 * 3")),
          "1 + 2 * 3~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("2^3^2")),
          "2 ^ 3 ^ 2~") ])


module ASpaceDoesNotAbandonAGroup =
  test aSpaceDoesNotAbandonAGroup =
    Stdlib.Test.all(
      // `(1 + 2) * 3` typed inside anything with a later hole lost the group: the space after the closing
      // paren stepped to the next item and the `*` built `(1 + 2, *3)`. Typed WITHOUT the spaces it was
      // already right, which is the tell -- the operator and the paren were both fine, the space was not.
      //
      // Space from just-after a node was advancing to the next hole unconditionally. Everywhere else that
      // question goes to `landSettled`, which asks the spec whether an operator could follow; leaving is
      // wrong when one could, because it abandons the thing the operator is about to wrap.
      //
      // I diagnosed this as the operator, then as the paren, before tracing it keystroke by keystroke and
      // finding it was neither.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("((1 + 2) * 3)")),
          "(1 + 2) * 3~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("((1 + 2)*3)")),
          "(1 + 2) * 3~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(1 + 2) * 3")),
          "(1 + 2) * 3~")

        // Advancing is still what a space does where no operator can follow, and the next key still reaches the
        // next hole from just-after a node.
        Stdlib.Test.equal(
          Fixtures.program(
            [ "l", "e", "t", " ", "x", " ", "(", ")", " ", "x", "<Esc>" ]),
          "let x = ()\nx")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("let xs = [1] xs"),
              [ "<Esc>", "<Esc>" ])),
          "let xs = [ 1 ]\nxs") ])


module AnIfHasAtMostOneElse =
  test anIfHasAtMostOneElse =
    Stdlib.Test.all(
      // `if a then 1 else zzz "x"` drew `if a then 1 else zzz else "x"` -- a SECOND `else` -- and lowered to
      // `if a then 1 else zzz`. The document showed a program nobody had, which is the one thing this editor
      // is not allowed to do.
      //
      // An `if`'s `else` is a `Field.Many` holding zero or one, used as an option: zero draws no branch, one
      // draws `else <expr>`. The spec has said that in a comment since it was written, and nothing enforced
      // it, so `addSibling` grew the list like any other sequence.
      //
      // Specs can now say `maxItems`, and the `if` says `("else", 1)`. A DSL with a slot that takes one
      // thing, or three, says so the same way instead of hoping. The refused keystroke reports itself rather
      // than vanishing.
      // UPDATED once a variable could be applied. `zzz "x"` is now the application it reads as, which is a
      // better answer than the refusal that used to be the best available one -- and the invariant this
      // module is about is untouched: no second `else` is drawn, and the drawing is still the program.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then 1 else zzz \"x\"")),
          "if a then 1 else zzz(\"x\"~)")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if a then 1 else zzz \"x\""),
              [ "<Esc>", "<Esc>" ])),
          "if a then 1 else zzz(\"x\")")

        // So the cap is pinned on values that cannot be applied instead, where the keystroke is still refused
        // and still says so. An int is not a function and neither is a list.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then 1 else 2 3")),
          "if a then 1 else 2~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then 1 else [1] 2")),
          "if a then 1 else [ 1 ]~")

        // The sequences that SHOULD still grow, so the cap is read per slot and not applied to every Many.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("[1, 2, 3")),
          "[ 1, 2, 3~ ]")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("(1, 2)")), "(1, 2)~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then 1 else 2")),
          "if a then 1 else 2~") ])


module ABareNameInDoubleParensCollapses =
  test aBareNameInDoubleParensCollapses =
    Stdlib.Test.all(
      // `((a))` stopped at `(a, ⟨item⟩)` while `((1 + 2))` collapsed all the way. Same shape, different
      // answer, which is what said the group rule was reading the wrong thing.
      //
      // It was: how deep `caret.node` sits depends on WHAT is in the item. A filled node pushes the caret
      // down into itself, so the tuple is its parent. A PARTIAL leaves the caret on the tuple as `InItem`.
      // Looking only upwards from `caret.node` meant `((a)` skipped the inner tuple and matched the OUTER
      // one, so the wrong tuple collapsed and the next `)` had nothing left to do.
      //
      // Now it checks the caret's own node first, then climbs. Took three attempts across three ticks; the
      // two before this were edits made before I knew which tuple was being collapsed.
      [ Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("((a))")), "a~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("(a)")), "a~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("((1 + 2))")),
          "1 + 2~")

        // The ones that must not move: a real tuple, unit, a tuple mid-typing, and a list.
        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("(1, 2)")), "(1, 2)~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("()")), "()~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(1, ")),
          "(1, ~⟨item⟩)")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("[1, 2, 3")),
          "[ 1, 2, 3~ ]") ])


module EnterStartsTheNextArmWhateverTheRhsIs =
  test enterStartsTheNextArmWhateverTheRhsIs =
    Stdlib.Test.all(
      // Enter after a match arm depended on the SHAPE of the rhs. After `1` or `v` the caret sits in a text
      // slot and Enter added the next arm; after `"zero"` the closing quote leaves it AfterNode and Enter
      // opened a statement INSIDE the arm instead. Same key, same place, two answers -- and the string one is
      // what you hit writing `| 0 -> "zero"` and reaching for the next case.
      //
      // The AfterNode branch went straight to `sequenceHere`. Everywhere else Enter tries the next ITEM first
      // and falls back to a statement, which is the order that makes the answer about WHERE you are rather
      // than what you happened to type.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n 0 \"zero\""),
              [ "<Enter>" ])),
          "match n with\n| 0 -> \"zero\"\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("match n 0 1"), [ "<Enter>" ])),
          "match n with\n| 0 -> 1\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("match n 0 v"), [ "<Enter>" ])),
          "match n with\n| 0 -> v\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        // A list element is the same question, and a string element used to answer it differently too.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[1"), [ "<Enter>" ])),
          "[ 1, ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[\"a\""), [ "<Enter>" ])),
          "[ \"a\", ~⟨item⟩ ]")

        // Outside any sequence Enter still starts the next STATEMENT, which is the fallback it always was.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("1 + 2"), [ "<Enter>" ])),
          "1 + 2\n~⟨next⟩")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("1"),
              [ "<Enter>", "2", "<Esc>", "<Esc>" ])),
          "1\n2") ])


module AConstructorHasTheArityItsCaseDeclares =
  test aConstructorHasTheArityItsCaseDeclares =
    Stdlib.Test.all(
      // `Ok 1` then Enter grew `Result.Ok(1, 2)` -- a two-field `Ok` -- and it LOWERED without complaint. A
      // program that cannot typecheck, from one keystroke, silently.
      //
      // Found by sweeping the same key in the same position across value shapes rather than waiting to trip
      // over it. Five of six shapes started the next arm; the constructor grew its own fields instead,
      // because `addSibling` takes the NEAREST list and inside `Ok(1)` that is the fields.
      //
      // Two halves. `maxItems` became a question about the NODE, since an enum's arity is declared by the
      // case and only the node knows it, where an `if`'s one `else` is a constant. And `addSibling` walks
      // enclosing lists from the inside OUT past any that is capped, which is how `leadPunctSibling` already
      // worked -- a node sits inside several lists at once and the nearest is not always the one that grows.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("Ok 1"), [ "<Enter>", "2" ])),
          "Result.Ok(1)\n2~")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Ok 1"),
              [ "<Enter>", "2", "<Esc>", "<Esc>" ])),
          "Result.Ok(1)\n2")

        // The same key, the same position, every shape: this is the pin the earlier ones could not be, because
        // one example cannot show that another disagrees.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("match n 0 1"), [ "<Enter>" ])),
          "match n with\n| 0 -> 1\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n 0 \"s\""),
              [ "<Enter>" ])),
          "match n with\n| 0 -> \"s\"\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("match n 0 r.f"), [ "<Enter>" ])),
          "match n with\n| 0 -> r.f\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("match n 0 Ok 1"),
              [ "<Enter>" ])),
          "match n with\n| 0 -> Result.Ok(1)\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[Ok 1"), [ "<Enter>" ])),
          "[ Result.Ok(1), ~⟨item⟩ ]") ])


module TheCaretDrawsPastAClosingBracket =
  test theCaretDrawsPastAClosingBracket =
    Stdlib.Test.all(
      // `AfterNode` used to draw INSIDE the node's own closing delimiter -- `[1~]` for a caret that is after
      // the list, `"abc~"` for one after the string. Nine pins across this file recorded that position, so
      // the wrong answer was written down nine times and passing.
      //
      // Worse than cosmetic: it made AfterNode and end-of-content look IDENTICAL. Pressing Left after closing
      // a string appeared to do nothing, because the caret moved from AfterNode to the end of the body and
      // both drew the same. Four Lefts looked like three.
      //
      // `Layout.locate` finds a node's extent by walking to the end of the cells belonging to it, and
      // `Piece.Punct` was drawn untagged, so a node's extent stopped before its own bracket. Puncts now carry
      // `Part.Decoration`: `locate` counts them, and `taggedCells` filters them out so caret motion, the hole
      // list and `prevDrawn` see exactly what they saw before.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("\"abc\"")),
          "\"abc\"~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("\"abc\""), [ "<Left>" ])),
          "\"abc~\"")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("\"abc\""),
              [ "<Left>", "<Left>" ])),
          "\"ab~c\"")

        // The two positions are distinguishable now, which is the whole point: the pin above and the pin below
        // it could not have been told apart before.
        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("[1]")), "[ 1 ]~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("[1, 2")), "[ 1, 2~ ]")

        // A caret genuinely INSIDE a construct still draws inside it. Decoration only extends a node's reach
        // for `AfterNode`, and only over punctuation the node itself draws.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("(1, ")),
          "(1, ~⟨item⟩)")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("1")), "1~") ])


module AKeywordAfterACallIsNotAnArgument =
  test aKeywordAfterACallIsNotAnArgument =
    Stdlib.Test.all(
      // `match Stdlib.List.length xs with` drew `... xs with with`, and `if Stdlib.List.isEmpty xs then` drew
      // `... then then`, while `match n with` and `if c then` were fine. Ordinary code both ways.
      //
      // Typing the keyword the editor has ALREADY DRAWN is swallowed when the caret can see it BEHIND --
      // a simple scrutinee settles, the space lands you in the pattern hole, and `prevKeyword` catches it.
      // After a CALL the caret never gets there: an apply keeps taking arguments, so the keyword became a
      // third one, sitting as `Partial('with')` at `args/1`.
      //
      // `nextKeyword` is the mirror of `prevKeyword`, asked from the other side, and the argument is dropped
      // rather than committed. Sixth bug this session of one shape: two settling routes, two answers to the
      // same question, and an example that works sitting next to one that does not.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match Stdlib.List.length xs with ")),
          "match Stdlib.List.length(xs) with\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if Stdlib.List.isEmpty xs then ")),
          "if Stdlib.List.isEmpty(xs) then ~⟨then⟩ else ⟨else⟩")

        // The simple scrutinee, which always worked and goes through the BACKWARD rule. Both paths now agree,
        // which is the point.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match n with ")),
          "match n with\n| ~⟨pattern⟩ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if c then ")),
          "if c then ~⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if c then 1 else ")),
          "if c then 1 else ~⟨else⟩")

        // A real argument after a call is still a real argument -- the swallow only fires when what you typed
        // IS the keyword drawn next, so nothing that merely follows a call is at risk.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("Stdlib.List.map(xs, f) ")),
          "Stdlib.List.map(xs, f)~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("Stdlib.String.split(line, \",\") ")),
          "Stdlib.String.split(line, \",\")~") ])


module ACallTakesTheArgumentsItsFunctionDeclares =
  test aCallTakesTheArgumentsItsFunctionDeclares =
    Stdlib.Test.all(
      // `Stdlib.List.length xs` then Enter offered ANOTHER argument, where the same key after a plain value
      // starts the next statement. `Stdlib.List.length` takes one parameter, so the call was already as long
      // as it can be.
      //
      // Same shape as the enum arity cap, and the same mechanism: the completion builds an apply with one
      // hole per parameter and the name resolved, so what it already holds IS the arity. Capped only once
      // the function is resolved -- a half-typed name has no arity, and capping it would stop the call ever
      // being filled.
      //
      // Found by sweeping keys after a CALL against the same keys after a VALUE, which is the route
      // difference the previous bug turned up.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.length(xs)"),
              [ "<Enter>" ])),
          "Stdlib.List.length(xs)\n~⟨next⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.String.split(line, \",\")"),
              [ "<Enter>" ])),
          "Stdlib.String.split(line, \",\")\n~⟨next⟩")

        // A call with a hole left goes TO the hole. Enter did nothing at all here: the sibling was refused
        // because the call is saturated, and the waiting `⟨fn⟩` blank stopped the statement, so the two Enter
        // branches disagreed on their fallback -- AfterNode went to the next hole and this one gave up.
        // CLEANUP the move to call syntax changed this; it was "Stdlib.List.map xs ~⟨fn⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("Stdlib.List.map(xs)"),
              [ "<Enter>" ])),
          "Stdlib.List.map(xs)\n~⟨next⟩")

        // An unresolved name has no arity to cap, so nothing stops Enter growing its arguments -- and once a
        // bare name could be applied at all, `zzz a` then Enter gave `zzz a ⟨arg⟩` with no way to say "done".
        // A resolved call had hidden that: its args are capped at its arity, so the sibling was refused anyway
        // and Enter sequenced.
        //
        // Enter grows a SEQUENCE -- a list's items, a record's fields, a match's arms, a lambda's params --
        // and arguments are not one: you write those by typing them one after another. `ArgSlots` is already
        // its own piece, so the spec says which is which and Enter can ask.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("zzz a"), [ "<Enter>" ])),
          "zzz(a)\n~⟨next⟩")

        // Typing still grows them, which is the whole point of the apply rule.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("f 1 2 3"),
              [ "<Esc>", "<Esc>" ])),
          "f(1, 2, 3)") ])


module BackspaceAfterAClosingBracketStepsInside =
  test backspaceAfterAClosingBracketStepsInside =
    Stdlib.Test.all(
      // Just AFTER a node there is no text behind the caret to delete, and Backspace did NOTHING at all --
      // silently, for `[1]`, `(1, 2)`, `"abc"`, `()` and `[]` alike. A key that does nothing is what this
      // file keeps saying to avoid, and here it was, on the single most-pressed corrective key.
      //
      // It steps back INSIDE now, to the last place there is something to delete, which is where `moveLeft`
      // already goes from this position. Non-destructive, and it puts the NEXT Backspace somewhere it can
      // work: hold the key and it deletes, which is what holding it is for. Deleting the whole node instead
      // is a lot to do for one keystroke on a construct whose inside you can no longer see.
      //
      // Found by re-sweeping right after the arity cap landed, on the theory that a cap changes what the
      // fallbacks see. It did -- but this one had been there all along, and only showed once the neighbouring
      // rows agreed and it stood out as the odd one.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[1]"), [ "<BS>" ])),
          "[ 1~ ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("(1, 2)"), [ "<BS>" ])),
          "(1, 2~)")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("\"abc\""), [ "<BS>" ])),
          "\"abc~\"")

        // And then it deletes, so holding the key does the obvious thing.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[1]"), [ "<BS>", "<BS>" ])),
          "[ ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("\"ab\""),
              [ "<BS>", "<BS>", "<BS>" ])),
          "~⟨expression⟩")

        // Backspace where there IS text behind the caret is untouched.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("s.width"), [ "<BS>" ])),
          "s.widt~")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("1+2"), [ "<BS>" ])),
          "1 + ~⟨right⟩") ])


module AnEmptyCollectionBackspacesAway =
  test anEmptyCollectionBackspacesAway =
    Stdlib.Test.all(
      // `[]` and `()` could not be deleted. Backspace on them did nothing and undo was the only way back --
      // the last of the "key that does nothing" family the sweeps kept turning up.
      //
      // `tryCollapseConstruct` asks `constructTargetSlot` what a construct BECOMES: a let becomes its body,
      // an if its then. An empty collection has no survivor to become, so it had no rule at all. It becomes
      // the hole it came from.
      //
      // Asked of the SHAPE rather than by naming kinds -- a list whose items are all holes, or a node with no
      // fields at all, which is what `()` is -- so a DSL collection gets the same key without saying
      // anything. `allHolesEmpty` still guards it, so nothing filled is ever at risk.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[]"), [ "<BS>", "<BS>" ])),
          "~⟨expression⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("()"), [ "<BS>", "<BS>" ])),
          "~⟨expression⟩")

        // `[]` and `[⟨item⟩]` are the same list to anyone looking at it, so backspacing out of `[1]` reaches a
        // hole rather than stopping one step short.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(
              Fixtures.chars("[1]"),
              [ "<BS>", "<BS>", "<BS>" ])),
          "~⟨expression⟩")

        // Anything with real content in it is untouched: this only fires on an untouched node.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("[1, 2]"), [ "<BS>" ])),
          "[ 1, 2~ ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("(1, 2)"), [ "<BS>" ])),
          "(1, 2~)")

        // And the four constructs that DO have a survivor still collapse to it.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("le"), [ "<Enter>", "<BS>" ])),
          "~⟨body⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("if "), [ "<BS>" ])),
          "~⟨then⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("ma"), [ "<Enter>", "<BS>" ])),
          "~⟨arg⟩") ])


module ABackslashInAStringIsAnEscape =
  test aBackslashInAStringIsAnEscape =
    Stdlib.Test.all(
      // A string's slot holds SOURCE text now, which settles what a backslash means while you TYPE one:
      // exactly what it means in a file. `\` then `n` is a newline, `\\` is one backslash. The alternative
      // -- storing the decoded string and escaping only when drawing -- would have made the drawn text and
      // the stored text different lengths, so every caret offset into a string would need translating.
      //
      // Nothing in the editor had to learn any of this. The string body is an ordinary text slot and these
      // are ordinary characters going into it; the meaning is applied once, at the edge, by `fromDoc`.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a\\nb"),
              [ "<Esc>", "<Esc>" ])),
          "\"a\\nb\"")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("\"a\\\\b"),
              [ "<Esc>", "<Esc>" ])),
          "\"a\\\\b\"") ])


module ARecordFieldIsNotAStatementPosition =
  test aRecordFieldIsNotAStatementPosition =
    Stdlib.Test.all(
      // The last Enter of a record, the one that ends the final field's line before you type the `}`, left a
      // stray hole behind:
      //
      //     Size { / width = 1; / height = 2 / }     wanted
      //     height = 2 / ⟨next⟩                      what it drew, between the braces
      //
      // Cause, and it took three passes to find. `recordMaxItems` caps a RESOLVED record's fields at the
      // count the type declares, so the field list is permanently full and `addSibling` can never succeed
      // inside it. Enter is sibling-then-sequence in all three of its branches, so with the sibling refused
      // it fell through to `sequenceHere`, which climbed to the RecordField and wrapped the field's VALUE.
      //
      // The cap is right. The fallback is the part that is wrong, and neither "the list is capped" nor "the
      // node is an EInt" separates the cases: a match arm's rhs IS a statement position, and ITS list is
      // capped exactly the same way. It is the SLOT. So specs name the slots a newline must not sequence,
      // `Spec.withNoSequence`, and a DSL with its own bracketed construct can say it about its own.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.flatten(
              [ Fixtures.chars("Size {")
                [ "<Enter>" ]
                Fixtures.chars("width = 1")
                [ "<Enter>" ]
                Fixtures.chars("height = 2")
                [ "<Enter>" ]
                Fixtures.chars("}")
                [ "<Esc>", "<Esc>" ] ])),
          "Stdlib.Cli.Tui.Size { width = 1, height = 2 }")

        // Enter in the MIDDLE of a record still moves on to the next field. It never grew the list (the cap
        // saw to that); it moves to the hole already waiting.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("Size {")
                [ "<Enter>" ]
                Fixtures.chars("width = 1")
                [ "<Enter>" ] ])),
          "Stdlib.Cli.Tui.Size { width = 1, height = ~⟨height⟩ }")

        // The two controls that say the rule is about the slot. A match arm's rhs sequences nothing here
        // because Enter starts the next ARM, and a bare value at the top level still opens a statement.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("xs"), [ "<Enter>" ])),
          "xs\n~⟨next⟩")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("a")
                [ "<Enter>" ]
                Fixtures.chars("b")
                [ "<Enter>" ] ])),
          "a\nb\n~⟨next⟩") ])


module ARecordUpdateTypesBackToo =
  test aRecordUpdateTypesBackToo =
    Stdlib.Test.all(
      // `{ r with x = 1 }` lowered as `unresolved: x=1`. The literal form had worked for weeks, so the two
      // record forms were answering the same question differently.
      //
      // One missing sibling. TypeDecl's RecordField spec has carried a `resolve` since type declarations were
      // written; the EXPRESSION RecordField spec never had one. So a partial typed into a field slot never
      // became a field: `{ r with x` left `x` sitting where the field goes, the `= ⟨value⟩` disappeared from
      // the drawing, and every key after it appended to that one text.
      //
      // Nothing under it was wrong, which is the part I nearly missed. `{ r` Tab `x` Tab `1` always built the
      // right update. Asking whether the same goal was reachable another way split "broken" into "structure
      // works, keys do not", and only the second needed fixing.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("{ r with x = 1 }"),
              [ "<Esc>", "<Esc>" ])),
          "{ r with x = 1 }")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("{ r with x = 1; y = 2 }"),
              [ "<Esc>", "<Esc>" ])),
          "{ r with x = 1, y = 2 }")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("[{ r with x = 1 }]"),
              [ "<Esc>", "<Esc>" ])),
          "[ { r with x = 1 } ]")

        // The structure, driven by Tab instead. This passed before the fix and is here as the control that says
        // which half was broken.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.flatten(
              [ Fixtures.chars("{ r")
                [ "<Tab>" ]
                Fixtures.chars("x")
                [ "<Tab>" ]
                Fixtures.chars("1")
                [ "<Esc>", "<Esc>" ] ])),
          "{ r with x = 1 }")

        // The literal still types back, which is the form the printer writes.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Size { width = 1; height = 2 }"),
              [ "<Esc>", "<Esc>" ])),
          "Stdlib.Cli.Tui.Size { width = 1, height = 2 }") ])


module ASettleThatLandsInAHoleHasAlreadyMoved =
  test aSettleThatLandsInAHoleHasAlreadyMoved =
    Stdlib.Test.all(
      // `Size { width = { r with x = 1 }; height = 2 }` put the `1` in the OUTER record's `height`.
      //
      // Four keys settle a partial and then move on: Tab, space, `=` and any punctuation that ends a name.
      // `resolvePartial` already puts the caret at the node's last editable slot, which for a fresh record
      // field is the `⟨value⟩` it just made. Then the key moved AGAIN, past it.
      //
      // Invisible at the top level, and `landSettled`'s own comment says why: a freshly resolved node has no
      // hole after it to overshoot into. Nesting it inside a record supplies one.
      //
      // `commitCandidate` has had the rule in both its branches for a while -- "Committing a construct or a
      // function lands in its own first hole to fill, so it stays there" -- and the `resolve` branch three
      // lines below never got it. `stayIfOnHole` is the one copy now.
      [ // CLEANUP the move to call syntax changed this; it was "Stdlib.Cli.Tui.Size { width = { r with x = 1 }; height = 2 }"
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("Size { width = { r with x = 1 }; height = 2 }"),
              [ "<Esc>", "<Esc>" ])),
          "ERR unresolved: ;height=2")

        // All four keys, at both levels, land in the value the settle just made. Esc was the control that
        // pointed at the double move: it settles WITHOUT moving on, and it was right all along.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("{ r with x =")),
          "{ r with x = ~⟨value⟩ }")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("{ r with x ")),
          "{ r with x = ~⟨value⟩ }")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("{ r with x"), [ "<Tab>" ])),
          "{ r with x = ~⟨value⟩ }")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("{ r with x"), [ "<Esc>" ])),
          "{ r with x = ~⟨value⟩ }") ])


module AnyCharacterCanEndADrawnKeyword =
  test anyCharacterCanEndADrawnKeyword =
    Stdlib.Test.all(
      // Found by driving the TUI, not by the harness: I typed `match args with` with no space after it and
      // the `[]` vanished, leaving a pattern called `with`.
      //
      //     match args with[]      | with -> ⟨rhs⟩     the `[]` thrown away
      //     match args with []     | [] -> ⟨rhs⟩       fine
      //
      // `clearsDrawnKeyword` was asked only when the next key was a SPACE (or Enter). Any character that
      // cannot CONTINUE the keyword ends it just as much -- that is what "you have finished typing the word"
      // means -- and the character then has to be typed at the restored caret rather than swallowed.
      //
      // The one thing that must NOT clear is an identifier character. `with0` is a name somebody may mean,
      // and nothing in the document can tell you otherwise.
      [ Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match args with[] options")),
          "match args with\n| [] -> options~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match args with []")),
          "match args with\n| []~ -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match args with[")),
          "match args with\n| [~⟨pattern⟩] -> ⟨rhs⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("match args with0")),
          "match args with\n| with0~ -> ⟨rhs⟩")

        // The same question one construct over: `if` draws its own `then`, and a `(` right after the typed-back
        // `then` has to build a group in the branch rather than a variable called `then`.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then(")),
          "if a then (~⟨item⟩, ⟨item⟩) else ⟨else⟩")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("if a then[")),
          "if a then [ ~⟨item⟩ ] else ⟨else⟩") ])


module TheMenuNamesEverythingAHoleCanHold =
  // The completions and the hole rules were DISJOINT lists. Every construct the menu named was one no
  // character built (let, if, match, fun, true, false, unit); every construct a character built was one
  // the menu never named (a number, a string, a char, an interpolated string, a list, a tuple, a record
  // update). So half the language was reachable only if you already knew the punctuation, and typing
  // `in` offered nothing at all.
  //
  // Same shape as most of this month's bugs -- one question answered in two places -- except these two
  // were complementary rather than contradictory, so nothing ever looked wrong.
  //
  // Each new entry is built by the SAME function the hole rule calls, so the menu and the keystroke make
  // the same node and cannot drift apart again. The detail column carries the shortcut, so the menu
  // teaches its own way out: use it once, see the character, stop needing the menu.
  //
  // The record LITERAL is deliberately absent. `ERecord` needs a resolved type hash, so it is built by
  // completing on the type's NAME; only the update form can be offered from a bare hole, and calling it
  // "record update" says so.
  let labels(): List<String> =
    Fluid.Editor.candidates(
      Fluid.Editor.init(Fixtures.reg(), Fixtures.hole(), 80))
    |> Stdlib.List.map(fun c -> c.label)


  test theMenuNamesEverythingAHoleCanHold =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          labels(),
          [ "let"
            "if"
            "match"
            "fun"
            "int"
            "string"
            "list"
            "tuple"
            "update"
            "char"
            "interpolation"
            "Dict"
            "true"
            "false"
            "()" ])

        // The example that started this: `in` used to match nothing.
        // One word each, because a label is reached by TYPING it and a space settles the partial.
        // "record update" gave a variable called `record` applied to `update`, so it could only ever be
        // arrowed to. The detail column carries the longer name.
        Stdlib.Test.equal(
          Fixtures.candidateLabels(Fixtures.chars("in")),
          [ "int", "interpolation" ])

        // Picking from the menu builds what the character builds.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("list"),
              [ "<Enter>", "1", "<Esc>", "<Esc>" ])),
          "[ 1 ]")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("["), [ "1", "<Esc>", "<Esc>" ])),
          "[ 1 ]")

        // What a SPACE commits is unchanged by any of this, and that took two goes to get right.
        //
        // Space commits an unambiguous candidate, and that rule was written for KEYWORDS: `le` can only be
        // `let`, and no variable is named `let`. The new entries are ordinary words, so the moment they joined
        // the menu a lone `c` was an unambiguous `char` and `if c then` came out `if '' then`. `r` became a
        // record update and `s` an empty string -- three of the commonest one-letter names in the codebase.
        //
        // So a candidate says whether a space may take it. `Spec.suggestion` is offered and never taken by a
        // space; Enter and Tab still take it, which is what those keys mean.
        //
        // Then the second half: the DECISION was filtered and the CHOICE was not, so `t ` built the `tuple`
        // sitting at index 0 rather than the `true` that made the decision. A space picks by rule rather than
        // by selection, so it commits the candidate it named.
        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("c ")), "c~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("r ")), "r~")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("s ")), "s~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("i ")),
          "if ~⟨cond⟩ then ⟨then⟩ else ⟨else⟩")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("t ")), "true~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("l ")),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("tr ")), "true~")

        // And the variable names that were being eaten.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if c then 1 else 2"),
              [ "<Esc>", "<Esc>" ])),
          "if c then 1 else 2")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(
              Fixtures.chars("if r > 0 then 1 else 2"),
              [ "<Esc>", "<Esc>" ])),
          "if r > 0 then 1 else 2") ])


module SettlingIsNotChoosing =
  test settlingIsNotChoosing =
    Stdlib.Test.all(
      // Widening the menu produced the same collision at THREE call sites, because a suggestion's label is an
      // ordinary word and a variable can be named it. Space, Tab and settle-a-partial all took the menu entry
      // where the person was writing a name.
      //
      // The rule that came out of it: ENTER means "take what the menu is showing". Space, Tab and typing on
      // mean "I have finished writing this name". Tab's own comment already said so -- "`r<Tab>` (an in-scope
      // variable) finalises and moves to the next hole" -- so this is the code catching up with what was
      // written down, which is where most of this month's bugs have lived.
      //
      // A reserved word is exempt at every one of those sites, because no variable can be named `let`. That
      // is also what keeps `Stdlib.Option.None` settling as the constructor rather than a variable.
      [ Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("list"), [ "<Esc>", "<Esc>" ])),
          "list")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("string"), [ "<Esc>", "<Esc>" ])),
          "string")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("char"), [ "<Esc>", "<Esc>" ])),
          "char")

        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.concat(Fixtures.chars("tuple"), [ "<Esc>", "<Esc>" ])),
          "tuple")

        // Enter still picks them, which is the whole point of putting them in the menu.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("list"), [ "<Enter>" ])),
          "[ ~⟨item⟩ ]")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("string"), [ "<Enter>" ])),
          "\"~\"")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("tuple"), [ "<Enter>" ])),
          "(~⟨item⟩, ⟨item⟩)")

        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.concat(Fixtures.chars("le"), [ "<Enter>" ])),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        // Tab settles and advances. `{ r <Tab>` took the `record update` suggestion for one run of the suite.
        Stdlib.Test.equal(
          Fixtures.program(
            Stdlib.List.flatten(
              [ Fixtures.chars("{ r")
                [ "<Tab>" ]
                Fixtures.chars("x")
                [ "<Tab>" ]
                Fixtures.chars("1")
                [ "<Esc>", "<Esc>" ] ])),
          "{ r with x = 1 }") ])


module AnEmptyTextIsSomethingLeftToFill =
  test anEmptyTextIsSomethingLeftToFill =
    Stdlib.Test.all(
      // Enter after committing a candidate ALSO starts the next item, but only when the thing it committed
      // has nothing left to fill. That check asked `holes`, which counts empty SLOTS, and an `EInt`'s only
      // blank is its digits TEXT. So picking `int` inside a list committed the number and immediately began
      // the next element, leaving an empty one behind and the caret past the digits you were about to type.
      //
      //     [int<Enter>     ->  [⟨digits⟩, ⟨item⟩]     wanted [⟨digits⟩] with the caret in it
      //
      // `landAfterCommit` has known this for months and says so where it lands: "`blanks`, not `holes`: an
      // empty TEXT field is the next thing to type too, and landing off `holes` walked past a parameter with
      // no name straight into its type". Three other places asked the narrower question.
      //
      // `holes` stays. One caller genuinely wants it -- moving into the NEXT list item skips a record field's
      // name to reach a real hole -- and its comment says so. Two of the three did not.
      [ Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("["), Fixtures.chars("int"), [ "<Enter>" ] ])),
          "[ ~⟨digits⟩ ]")

        // The suggestion rules, in a list, where a hijack would be easy to miss: neither Tab nor space takes
        // `int`, because it is an ordinary word somebody may be naming a variable.
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("["), Fixtures.chars("int"), [ "<Tab>" ] ])),
          "[ int~ ]")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("[int ")), "[ int~ ]")

        // And an argument position, where the commit lands INSIDE the new node rather than after it.
        // CLEANUP the move to call syntax changed this; it was "Stdlib.List.map xs ~⟨digits⟩"
        Stdlib.Test.equal(
          Fixtures.screen(
            Stdlib.List.flatten(
              [ Fixtures.chars("Stdlib.List.map(xs) ")
                Fixtures.chars("int")
                [ "<Enter>" ] ])),
          "Stdlib.List.map(xs)\n~⟨next⟩") ])


module APrefixDoesNotCommitWhereANameIsBorn =
  test aPrefixDoesNotCommitWhereANameIsBorn =
    Stdlib.Test.all(
      // Space and Tab commit an unambiguous keyword PREFIX, which is how `le` becomes `let`. That was written
      // for keywords and stayed safe by accident: wherever you REFERENCE a name it is already bound, and an
      // in-scope variable is an EXACT candidate that outranks the prefix.
      //
      //     t + space, unbound   ->  true
      //     t + space, bound     ->  t
      //
      // A pattern is where a name is BORN. Nothing is in scope, so the prefix wins and `| h :: t ->` came out
      // `| h :: true ->`. So a prefix does not commit in a binding position. An exact match still does,
      // because no variable can be named `true`.
      //
      // Declared, not detected. `binders` says where a name is VISIBLE, not where it is born, and "has no
      // scopeCandidate" would catch type holes too and stop `In ` becoming `Int`.
      [ // CLEANUP the move to call syntax changed this; it was "match n with\n| h :: t -> 0"
        Stdlib.Test.equal(
          Fixtures.program(
            [ "m"
              "a"
              "<Enter>"
              "n"
              "<Tab>"
              "h"
              ":"
              ":"
              "t"
              "<Tab>"
              "0"
              "<Esc>"
              "<Esc>" ]),
          "ERR hole: list pattern")

        // Expressions are reference positions and are untouched.
        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("l ")),
          "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩")

        Stdlib.Test.equal(Fixtures.screen(Fixtures.chars("t ")), "true~")

        Stdlib.Test.equal(
          Fixtures.screen(Fixtures.chars("i ")),
          "if ~⟨cond⟩ then ⟨then⟩ else ⟨else⟩") ])


