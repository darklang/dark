module Darklang.Fluid.Tests.Kernel

// The Fluid kernel, driven by key scripts and checked against the `~` rendering.
//
// `⟨label⟩` is a hole. `~` is the caret. Names are fully qualified: testfiles parse with owner "Tests".

module Fixtures =
  let reg(): Fluid.Registry =
    Fluid.Registry.ofList(Fluid.Prims.specs())


  let intE(): Fluid.Expect =
    Fluid.Expect.ofKind(Fluid.Prims.intKind(), "Int")


  let strE(): Fluid.Expect =
    Fluid.Expect.ofKind(Fluid.Prims.stringKind(), "String")


  /// Acme.Color { r = 255; g = ⟨Int⟩; name = ⟨String⟩; tags = ["warm", ⟨tag⟩] }
  let color(): Fluid.Slot =
    Fluid.Slot.Filled(
      Fluid.Node.make(
        Fluid.Kind.named("Acme.Color"),
        [ ("r", Fluid.Field.One(Fluid.Slot.Filled(Fluid.Prims.intNode("255"))))
          ("g", Fluid.Field.One(Fluid.Slot.Empty(intE())))
          ("name", Fluid.Field.One(Fluid.Slot.Empty(strE())))
          (
            "tags",
            Fluid.Field.Many(
              [ Fluid.Slot.Filled(Fluid.Prims.stringNode("warm"))
                Fluid.Slot.Empty(Fluid.Expect.any("tag")) ],
              Fluid.Expect.any("tag"))) ]))


  let run(keys: List<String>): String =
    Fluid.Test.run(reg(), color(), 80, keys)


  let runNarrow(keys: List<String>): String =
    Fluid.Test.run(reg(), color(), 24, keys)


module Layout =
  test layout =
    Stdlib.Test.all(
      [ Stdlib.Test.equal(
          Fluid.Debug.render(Fixtures.reg(), 80, Fixtures.color()),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // A width it cannot fit breaks the outer group, one field per line.
        Stdlib.Test.equal(
          Fluid.Debug.render(Fixtures.reg(), 24, Fixtures.color()),
          "Acme.Color {\n  r = 255,\n  g = ⟨Int⟩,\n  name = ⟨String⟩,\n  tags = [\"warm\",\n  ⟨tag⟩]\n}") ])


module RootHole =
  test rootHole =
    Stdlib.Test.all(
      // Typing a digit into a hole that expects an Int makes an Int and puts the caret after the digit.
      [ Stdlib.Test.equal(
          Fluid.Test.run(
            Fixtures.reg(),
            Fluid.Slot.Empty(Fixtures.intE()),
            80,
            [ "4", "2" ]),
          "42~")

        Stdlib.Test.equal(
          Fluid.Test.run(
            Fixtures.reg(),
            Fluid.Slot.Empty(Fixtures.intE()),
            80,
            [ "4", "2", "<BS>" ]),
          "4~")

        // A letter is not a digit: it starts a partial instead of an Int.
        Stdlib.Test.equal(
          Fluid.Test.run(
            Fixtures.reg(),
            Fluid.Slot.Empty(Fixtures.intE()),
            80,
            [ "x" ]),
          "x~") ])


module Holes =
  test holes =
    Stdlib.Test.all(
      // Tab from NAV goes to the first hole and enters INSERT there.
      [ Stdlib.Test.equal(
          Fixtures.run([ "<Tab>" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // The typed digit fills the hole and the caret sits after it, so the next digit continues the number.
        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "7" ]),
          "Acme.Color { r = 255, g = 7~, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "7", "8" ]),
          "Acme.Color { r = 255, g = 78~, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // A quote into a String hole makes an empty string with the caret inside the quotes.
        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "7", "<Tab>", "\"", "h", "i" ]),
          "Acme.Color { r = 255, g = 7, name = \"hi~\", tags = [\"warm\", ⟨tag⟩] }")

        // Tab wraps around.
        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Tab>", "<Tab>", "<Tab>" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<S-Tab>" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ~⟨tag⟩] }") ])


module Partials =
  test partials =
    Stdlib.Test.all(
      // A hole that expects anything has no rules, so typing starts a partial.
      [ Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Tab>", "<Tab>", "a", "b" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ab~] }")

        // Backspacing a partial to nothing restores the hole it replaced.
        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Tab>", "<Tab>", "a", "b", "<BS>", "<BS>" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ~⟨tag⟩] }") ])


module Motion =
  test motion =
    Stdlib.Test.all(
      // Left from a hole lands at the end of the previous run; Right lands at the start of the next.
      [ Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Left>" ]),
          "Acme.Color { r = 255~, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Left>", "<Left>" ]),
          "Acme.Color { r = 25~5, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Right>" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ~⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "<Tab>", "<Right>", "<Right>", "<Right>" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"w~arm\", ⟨tag⟩] }") ])


module Nav =
  test nav =
    Stdlib.Test.all(
      // j walks nodes in pre-order: root, r, g, ...
      [ Stdlib.Test.equal(
          Fixtures.run([ "j", "j" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // x clears a node back to a hole labelled by its slot; u brings it back.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "x" ]),
          "Acme.Color { r = ~⟨r⟩, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "j", "x", "u" ]),
          "Acme.Color { r = ~255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fluid.Test.modeAfter(
            Fixtures.reg(),
            Fixtures.color(),
            80,
            [ "<Tab>", "<Esc>" ]),
          "nav")

        Stdlib.Test.equal(
          Fluid.Test.modeAfter(
            Fixtures.reg(),
            Fixtures.color(),
            80,
            [ "<Tab>" ]),
          "insert")

        // J and K walk SIBLINGS -- the other children of the same parent -- where j and k walk reading order and
        // go into everything. Found by opening a real store function in a terminal: reaching the body of a
        // twenty-line function meant one press per node in between, dozens of them, and the editor had no
        // coarser motion at all.
        //
        // From the first field, J is the next field. Reading order would have gone INTO the 255 first.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "J" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "j", "J", "J" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ~⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // ...and K comes back.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "J", "J", "K" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // At either end it stays put rather than climbing. `h` is the key for going out, and a sibling walk that
        // silently climbed would do something different every few presses when held down.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "K", "K" ]),
          "Acme.Color { r = ~255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // On the root there is no parent and nothing to walk.
        Stdlib.Test.equal(
          Fixtures.run([ "J" ]),
          "~Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // A list's ITEMS are siblings of the slots beside them, because siblings are read off the same walk `j`
        // uses rather than from a second notion of what a child is. So J out of `name` lands in the tags list
        // and keeps going along it, and a DSL's own Many gets this for nothing.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "J", "J", "J" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"~warm\", ⟨tag⟩] }")

        Stdlib.Test.equal(
          Fixtures.run([ "j", "J", "J", "J", "J" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ~⟨tag⟩] }") ])


module YankAndPut =
  let msg(keys: List<String>): String =
    (Fluid.Test.drive(
       Fluid.Editor.init(Fixtures.reg(), Fixtures.color(), 80),
       keys)).message


  test yankAndPut =
    Stdlib.Test.all(
      // `y` copies the node under the caret, `p` puts it over whatever the caret is on -- a hole, a partial, or
      // another node. This had NO coverage at all until now, which is worth saying plainly: a whole editing
      // feature was reachable only by driving the thing by hand, and what it printed was the fully qualified
      // type name (`yanked Darklang.LanguageTools.ProgramTypes.Expr.EInt` for copying a `1`).
      [ Stdlib.Test.equal(
          Fixtures.run([ "j", "y", "j", "p" ]),
          "Acme.Color { r = 255, g = ~255, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // A put is one edit, so undo takes the hole back.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "y", "j", "p", "u" ]),
          "Acme.Color { r = 255, g = ~⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // Yanking again replaces what's held: copy the `255`, walk to the tag, copy THAT instead, and the put
        // is the tag.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "y", "j", "j", "j", "y", "j", "p" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", \"~warm\"] }")

        // The message names the kind the SHORT way, the way the breadcrumb does.
        Stdlib.Test.equal(YankAndPut.msg([ "j", "y" ]), "yanked Int")

        Stdlib.Test.equal(YankAndPut.msg([ "j", "y", "j", "p" ]), "put Int")

        // And it says so when there is nothing to put.
        Stdlib.Test.equal(YankAndPut.msg([ "p" ]), "clipboard is empty") ])


module UnknownTestKeysAreLoud =
  test unknownTestKeysAreLoud =
    Stdlib.Test.all(
      // `keyOf` falls through to `printable` for anything it does not recognise, so a mistyped key token gets
      // TYPED. `<Backspace>` -- the token is `<BS>` -- went in as fourteen characters, one of which is `<` and
      // starts an operator. The script still ran, still produced output, and an expectation written from that
      // output would still pass, so a pin could look like it exercised Backspace while exercising nothing of
      // the sort. Found by writing exactly that probe and believing it for a minute.
      // The known token does what Backspace does, which in NAV is NOTHING -- it is an INSERT key, and the
      // caret is on a node here. (I wrote this pin expecting it to clear the 255, twice, before probing.)
      [ Stdlib.Test.equal(
          Fixtures.run([ "j", "<BS>" ]),
          "Acme.Color { r = ~255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm\", ⟨tag⟩] }")

        // ...and where it does delete, it deletes. `<End>` is end of the caret's LINE, and this fixture renders
        // on one, so it lands at the end of the whole thing and takes out the tags list's empty item.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "i", "<End>", "<BS>" ]),
          "Acme.Color { r = 255, g = ⟨Int⟩, name = ⟨String⟩, tags = [\"warm~\"] }")

        // The mistyped one refuses instead of typing fourteen characters into the document.
        Stdlib.Test.equal(
          Fixtures.run([ "j", "<Backspace>" ]),
          "UNKNOWN TEST KEY: <Backspace>")

        // Only ANGLE-BRACKETED things are treated as key tokens, so ordinary text still types.
        Stdlib.Test.equal(Fluid.Test.unknownKeys([ "a", "<Tab>", "1" ]), [])

        Stdlib.Test.equal(
          Fluid.Test.unknownKeys([ "<Nope>", "<Tab>", "<Alsonope>" ]),
          [ "<Nope>", "<Alsonope>" ]) ])
