module Darklang.Cli.Tests.Propagate

module DictionarySignatures =
  let same(
    key: LanguageTools.ProgramTypes.TypeReference,
    value: LanguageTools.ProgramTypes.TypeReference)
    : Bool =
    Cli.Packages.Propagate.typeReferenceEqual(
      SCM.Branch.mainBranchId,
      LanguageTools.ProgramTypes.TypeReference.TDict(
        LanguageTools.ProgramTypes.TypeReference.TString,
        LanguageTools.ProgramTypes.TypeReference.TBigInt),
      LanguageTools.ProgramTypes.TypeReference.TDict(key, value))


test dictionarySignatures =
  Stdlib.Test.all(
    [ DictionarySignatures.same(
        LanguageTools.ProgramTypes.TypeReference.TString,
        LanguageTools.ProgramTypes.TypeReference.TBigInt)
      |> Stdlib.Test.equal(true)

      DictionarySignatures.same(
        LanguageTools.ProgramTypes.TypeReference.TBigInt,
        LanguageTools.ProgramTypes.TypeReference.TBigInt)
      |> Stdlib.Test.equal(false)

      DictionarySignatures.same(
        LanguageTools.ProgramTypes.TypeReference.TString,
        LanguageTools.ProgramTypes.TypeReference.TBool)
      |> Stdlib.Test.equal(false) ])
