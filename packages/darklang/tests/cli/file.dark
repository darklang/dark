module Darklang.Cli.Tests.File

// withTemp removes each temporary file after the check.
module WriteReadRoundtrip =
  let testContents(): String = "Test conrents"

  // Check the write result as well as the bytes read back.
  test roundtrip =
    Stdlib.Cli.File.withTemp(fun filename ->
      let blob = Stdlib.Utf8.encode(testContents())
      let written = Stdlib.Cli.FileSystem.writeFile(filename, blob)
      let readBack = Stdlib.Cli.FileSystem.readFile(filename) |> Builtin.unwrap
      Stdlib.Test.all(
        [ written |> Stdlib.Test.equal(Stdlib.Result.Result.Ok())
          Stdlib.Utf8.decode(readBack)
          |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(testContents())) ]))
    |> Builtin.unwrap

module MissingFile =
  // A missing file is `NotFound`, not `Other`: on Linux the open fails inside
  // libc, and the errno has to survive the trip through the host boundary.
  test missingFileIsNotFound =
    Stdlib.Cli.File.withTemp(fun filename ->
      let missing = filename + "-does-not-exist"
      Stdlib.Cli.FileSystem.readFile(missing)
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Cli.FileSystem.FileError.NotFound)))
    |> Builtin.unwrap

  // `Stdlib.display` takes the error as it comes out of a failed read.
  test fileErrorHasToString =
    Stdlib.Test.all(
      [ Stdlib.display(Stdlib.Cli.FileSystem.FileError.NotFound)
        |> Stdlib.Test.equal("File not found")
        Stdlib.display(Stdlib.Cli.FileSystem.FileError.Other("disk full"))
        |> Stdlib.Test.equal("disk full") ])

module AreIdentical =
  // Each file is read separately, so the two Bytes are separate values and
  // only their contents can make them equal.
  let compareWith(first: String, second: String): Bool =
    Stdlib.Cli.File.withTemp(fun path1 ->
      Stdlib.Cli.File.withTemp(fun path2 ->
        let _ = Stdlib.Cli.File.writeText(path1, first) |> Builtin.unwrap
        let _ = Stdlib.Cli.File.writeText(path2, second) |> Builtin.unwrap
        Stdlib.Cli.File.areIdentical(path1, path2) |> Builtin.unwrap)
      |> Builtin.unwrap)
    |> Builtin.unwrap

  test sameContents =
    compareWith("same contents", "same contents") |> Stdlib.Test.equal(true)

  test differentContents =
    compareWith("same contents", "same contentz") |> Stdlib.Test.equal(false)


module WriteErrors =
  // An existing file cannot be a parent directory. Keep mkdir's structured error.
  test parentIsFile =
    Stdlib.Cli.File.withTemp(fun filename ->
      Stdlib.Cli.FileSystem.writeFile(filename + "/child/file", Stdlib.Utf8.encode("x"))
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Cli.FileSystem.FileError.NotFound)))
    |> Builtin.unwrap

  // Parent creation succeeds, but opening a directory as a file fails.
  test targetIsDirectory =
    Stdlib.Cli.File.withTemp(fun filename ->
      let directory = filename + "-dir"
      let _ = Stdlib.Cli.Dir.create(directory) |> Builtin.unwrap
      let result = Stdlib.Cli.FileSystem.writeFile(directory, Stdlib.Utf8.encode("x"))
      let _ = Stdlib.Cli.Dir.delete(directory) |> Builtin.unwrap
      result |> Stdlib.Test.equal(
        Stdlib.Result.Result.Error(Stdlib.Cli.FileSystem.FileError.OsAccessDenied)))
    |> Builtin.unwrap


module ListErrors =
  test missingDirectory =
    Stdlib.Cli.FileSystem.listDirectory("/nonexistent-dark-test-dir")
    |> Stdlib.Test.equal(Stdlib.Result.Result.Error(Stdlib.Cli.FileSystem.FileError.NotFound))

  test existingDirectory =
    Stdlib.Cli.Dir.withTemp(fun dir ->
      let _ = Stdlib.Cli.File.writeText(dir + "/a.txt", "x") |> Builtin.unwrap
      Stdlib.Cli.FileSystem.listDirectory(dir)
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([ dir + "/a.txt" ])))
    |> Builtin.unwrap
