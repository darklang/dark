/// CLI tests: `dark edit` round trips and refusals.
module Darklang.Cli.Tests.EditCommand

/// Reading an item and writing it straight back changes nothing.
///
/// This is the property that makes `view --raw` usable as a pipe: if the printer and
/// the parser disagree anywhere, a round trip authors a second version of the item
/// and the op log grows every time someone looks at it.
test editRoundTripsThroughRaw = Instance.withInstance(fun i ->
  let branchName = "cli-edit-test"
  let name = "Tests.CliEdit.tripled"
  let sourcePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let changedPath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Instance.output(i, [ "branch", "create", branchName ])

  let _ =
    Instance.output(
      i,
      [ "--branch"
        branchName
        "fn"
        "/" + name
        "let tripled(n: Int64): Int64 = (n * 3)" ])

  let before =
    Instance.output(i, [ "--branch", branchName, "view", name, "--raw" ])

  // The hash, not the op count: an apply that changes nothing still records that the
  // name was set, so the log grows either way. What must not change is the item.
  let hashBefore = Instance.output(i, [ "--branch", branchName, "hash", name ])
  let _ = Stdlib.Cli.File.writeAtomic(sourcePath, before) |> Builtin.unwrap
  let _ =
    Instance.output(i, [ "--branch", branchName, "edit", name, sourcePath ])

  let after =
    Instance.output(i, [ "--branch", branchName, "view", name, "--raw" ])

  let hashAfter = Instance.output(i, [ "--branch", branchName, "hash", name ])

  // And a real change still lands, so the assertion above is not passing because
  // `edit` quietly does nothing.
  let _ =
    Stdlib.Cli.File.writeAtomic(
      changedPath,
      "let tripled(n: Int64): Int64 = (n * 30)")
    |> Builtin.unwrap

  let _ =
    Instance.output(i, [ "--branch", branchName, "edit", name, changedPath ])

  let evaluated =
    Instance.output(i, [ "--branch", branchName, "eval", name + "(2)" ])

  if
    before == after
    && hashBefore == hashAfter
    && Stdlib.String.contains(evaluated, "60")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected a no-op round trip then a landed change; before: {before}, "
      + $"after: {after}, eval: {evaluated}"))


/// Every kind `--raw` prints round-trips, not just functions.
///
/// The printer and the parser have to agree per kind, and a type's record and enum
/// layout is where they are likeliest to drift apart. A round trip that changes the
/// item is worse than one that fails: nothing says so, and the store quietly holds
/// something you did not write.
test editRoundTripsTypesAndValues = Instance.withInstance(fun i ->
  let branchName = "cli-edit-kinds"
  let typeName = "Tests.CliEditKinds.Pair"
  let valueName = "Tests.CliEditKinds.answer"
  let typePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let valuePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Instance.output(i, [ "branch", "create", branchName ])

  let _ =
    Instance.output(
      i,
      [ "--branch"
        branchName
        "type"
        "/" + typeName
        "{ a: Int64, b: String }" ])

  let _ =
    Instance.output(i, [ "--branch", branchName, "val", "/" + valueName, "42" ])

  let typeBefore =
    Instance.output(i, [ "--branch", branchName, "view", typeName, "--raw" ])

  let typeHashBefore =
    Instance.output(i, [ "--branch", branchName, "hash", typeName ])

  let valueBefore =
    Instance.output(i, [ "--branch", branchName, "view", valueName, "--raw" ])

  let valueHashBefore =
    Instance.output(i, [ "--branch", branchName, "hash", valueName ])

  let _ = Stdlib.Cli.File.writeAtomic(typePath, typeBefore) |> Builtin.unwrap
  let _ = Stdlib.Cli.File.writeAtomic(valuePath, valueBefore) |> Builtin.unwrap
  let _ =
    Instance.output(i, [ "--branch", branchName, "edit", typeName, typePath ])

  let _ =
    Instance.output(i, [ "--branch", branchName, "edit", valueName, valuePath ])

  let typeAfter =
    Instance.output(i, [ "--branch", branchName, "view", typeName, "--raw" ])

  let typeHashAfter =
    Instance.output(i, [ "--branch", branchName, "hash", typeName ])

  let valueAfter =
    Instance.output(i, [ "--branch", branchName, "view", valueName, "--raw" ])

  let valueHashAfter =
    Instance.output(i, [ "--branch", branchName, "hash", valueName ])

  if
    typeBefore == typeAfter
    && typeHashBefore == typeHashAfter
    && valueBefore == valueAfter
    && valueHashBefore == valueHashAfter
    && Stdlib.String.contains(typeBefore, "type Pair")
    && Stdlib.String.contains(valueBefore, "val answer")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected types and values to round-trip; type: {typeBefore} -> {typeAfter}, "
      + $"value: {valueBefore} -> {valueAfter}"))


/// A malformed or missing replacement file leaves the original item intact.
test editLeavesTheItemAloneOnABadFile = Instance.withInstance(fun i ->
  let branchName = "cli-edit-bad"
  let name = "Tests.CliEditBad.kept"
  let badPath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Instance.output(i, [ "branch", "create", branchName ])

  let _ =
    Instance.output(
      i,
      [ "--branch"
        branchName
        "fn"
        "/" + name
        "let kept(n: Int64): Int64 = n" ])

  let hashBefore = Instance.output(i, [ "--branch", branchName, "hash", name ])
  let _ =
    Stdlib.Cli.File.writeAtomic(
      badPath,
      "let kept(n: Int64): Int64 = n + 1\nlet bad(): Int64 = (fun (n: Int64) -> n)(1)\n")
    |> Builtin.unwrap

  let refused =
    Instance.output(i, [ "--branch", branchName, "edit", name, badPath ])

  let hashAfterBad =
    Instance.output(i, [ "--branch", branchName, "hash", name ])

  // A path that is not there at all takes the same route, and must also change
  // nothing.
  let missing =
    Instance.output(
      i,
      [ "--branch"
        branchName
        "edit"
        name
        "/tmp/cli-edit-no-such-file.dark" ])

  let hashAfterMissing =
    Instance.output(i, [ "--branch", branchName, "hash", name ])

  if
    hashBefore == hashAfterBad
    && hashBefore == hashAfterMissing
    && Stdlib.String.contains(refused, "Parse error")
    && Stdlib.String.contains(missing, "Could not read")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected a rejected file to change nothing; hashes {hashBefore} / "
      + $"{hashAfterBad} / {hashAfterMissing}, said: {refused} | {missing}"))


/// `edit` takes exactly one declaration, and says so.
///
/// A module is the near miss worth naming: `dark edit Stdlib.List` is a reasonable
/// thing to type, and the answer has to point at the command that does take one
/// rather than leaving you to guess.
test editRefusesWhatItCannotEdit = Instance.withInstance(fun i ->
  let bare = Instance.output(i, [ "edit" ])
  let tooMany = Instance.output(i, [ "edit", "a", "b", "c" ])
  let aModule = Instance.output(i, [ "edit", "Stdlib.List" ])
  let unknown = Instance.output(i, [ "edit", "Zz.NoSuch.thing" ])

  // An instance's commands run with no terminal on stdin, which is exactly the case
  // `edit` with no file has to refuse. An editor started here would paint into nothing.
  let noTerminal = Instance.output(i, [ "edit", "Stdlib.List.head" ])
  if
    Stdlib.String.contains(noTerminal, "Cannot open an editor")
    && Stdlib.String.contains(noTerminal, "not a terminal")
    && Stdlib.String.contains(noTerminal, "--raw")
    && Stdlib.String.contains(bare, "needs an argument")
    && Stdlib.String.contains(bare, "dark edit --help")
    && Stdlib.String.contains(tooMany, "does not take `c`")
    && Stdlib.String.contains(tooMany, "dark edit --help")
    && Stdlib.String.contains(aModule, "is a module")
    && Stdlib.String.contains(aModule, "dark import")
    && Stdlib.String.contains(unknown, "Cannot edit Zz.NoSuch.thing")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected each refusal to name what to do instead; bare: {bare}, "
      + $"module: {aModule}, unknown: {unknown}, "
      + $"no terminal: {noTerminal}"))
