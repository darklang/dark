/// Exit codes a script can branch on: a command that did not do what was asked exits 1.
module Darklang.Cli.Tests.ExitCodes

let draftWithTypeError(i: Instance.T): Stdlib.Cli.Process.Output =
  Instance.call(
    i,
    Instance.command([ "fn", "Me.ExitCodes.bad", "(x: Int64): String = x" ]))


test fnWithATypeErrorSavesTheDraftAndExitsOne = Instance.withInstance(fun i ->
  let out = draftWithTypeError(i)
  let view = Instance.call(i, Instance.command([ "view", "Me.ExitCodes.bad" ]))
  Stdlib.Test.all(
    [ Instance.exitedWith(out.exitCode, 1, "a save with a type error")
      Instance.stdoutSays(
        out,
        "Created function",
        "the answer is what it saved")

      Instance.stderrSays(
        out,
        "saved as a draft",
        "the type error says the draft was kept")

      Instance.exitedWith(view.exitCode, 0, "and the draft is there") ]))


test commitJsonWithoutYesExitsOne = Instance.withInstance(fun i ->
  let _ = Instance.ran(i, [ "fn", "Me.ExitCodes.ok", "(x: Int64): Int64 = x" ])
  let out = Instance.call(i, Instance.command([ "commit", "probe", "--json" ]))
  Stdlib.Test.all(
    [ Instance.exitedWith(out.exitCode, 1, "a dry review commits nothing")
      Instance.stdoutIsJson(out, "the answer is JSON")
      Instance.stdoutSays(out, "\"committed\":false", "and says so in it") ]))


let scriptExit(i: Instance.T, last: String): Stdlib.Cli.Process.Output =
  let path = Instance.home(i) + "/exit.dark"
  let _ = Stdlib.Cli.File.writeText(path, last + "\n")
  Instance.call(i, Instance.command([ "run", path ]))


test scriptExitCodeOutsideTheByteFails = Instance.withInstance(fun i ->
  let big = scriptExit(i, "256")
  let negative = scriptExit(i, "-1")
  let top = scriptExit(i, "255")
  Stdlib.Test.all(
    [ Instance.exitedWith(big.exitCode, 1, "256 would wrap to 0")
      Instance.stderrSays(big, "must be 0-255", "and it says why")
      Instance.stdoutIsEmpty(big, "with no answer")
      Instance.exitedWith(negative.exitCode, 1, "-1 would wrap to 255")
      Instance.exitedWith(top.exitCode, 255, "255 is a real exit code") ]))
