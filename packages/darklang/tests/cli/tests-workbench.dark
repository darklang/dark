/// Navigation regressions that need real key dispatch and populated views.
module Darklang.Cli.Tests.TestSuite

// A move with History.Record leaves a way back and one with History.Skip (back's own) does
// not; the reader highlights what it is given only for Reader.Code.
test workbenchNavigationEnums =
  let base = workbenchState()
  let point =
    { Cli.Workbench.returnPointOf(base) with view = Cli.Workbench.vMatter }

  let recorded =
    Cli.Workbench.moveToPoint(base, point, Cli.Workbench.History.Record)

  let skipped =
    Cli.Workbench.moveToPoint(base, point, Cli.Workbench.History.Skip)

  let code =
    match Cli.Workbench.openReader(base, "x", Cli.Workbench.Reader.Code) with
    | Continue(s) -> Stdlib.Option.Option.Some(s.readingIsCode)
    | _ -> Stdlib.Option.Option.None

  let prose =
    match Cli.Workbench.openReader(base, "x", Cli.Workbench.Reader.Prose) with
    | Continue(s) -> Stdlib.Option.Option.Some(s.readingIsCode)
    | _ -> Stdlib.Option.Option.None

  Stdlib.Test.all(
    [ Stdlib.List.length(recorded.back) |> Stdlib.Test.equal(1)
      Stdlib.List.length(skipped.back) |> Stdlib.Test.equal(0)
      recorded.activeView |> Stdlib.Test.equal(Cli.Workbench.vMatter)
      skipped.activeView |> Stdlib.Test.equal(Cli.Workbench.vMatter)
      code |> Stdlib.Test.equal(Stdlib.Option.Option.Some(true))
      prose |> Stdlib.Test.equal(Stdlib.Option.Option.Some(false)) ])


test workbenchHistoryRoundTrip =
  let base = workbenchState()
  let hit =
    Cli.Workbench.SearchHit
      { modules = [ "Darklang", "Stdlib", "List" ]
        name = "map"
        kind = "fn"
        display = "map" }

  let jumped =
    match Cli.Workbench.jumpToHit(base, hit) with
    | Continue(s) -> s
    | _ -> base

  let returned = (wbKey(jumped, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let tree = (wbChar(base, "2")).state
  let original =
    { tree with
        filter = "Darklang"
        selected = 0
        items = Cli.Workbench.applyFilter(tree.items, "Darklang") }

  let entered = (wbKey(original, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let parent = (wbKey(entered, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let lens = (wbChar(tree, "L")).state
  let beforeLens = (wbKey(lens, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let sameReturnPoint(a: Cli.Workbench.State, b: Cli.Workbench.State): Bool =
    Cli.Workbench.returnPointOf(a) == Cli.Workbench.returnPointOf(b)

  if
    Stdlib.List.length(jumped.back) == 1
    && sameReturnPoint(returned, base)
    && Stdlib.List.isEmpty(returned.back)
    && entered.location != original.location
    && sameReturnPoint(parent, original)
    && parent.items == original.items
    && lens.matter.lens != tree.matter.lens
    && sameReturnPoint(beforeLens, tree)
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("search, modules and lenses must return in one Escape")


test workbenchBranchPicker =
  let base = workbenchState()
  let opened = (wbChar(base, "S")).state
  let opens =
    match opened.overlay with
    | Branches(_) -> true
    | _ -> false

  let choices =
    Stdlib.List.range(1, 20)
    |> Stdlib.List.map(fun n ->
      Cli.Workbench.BranchChoice
        { id = SCM.Branch.mainBranchId
          name = "branch-" + Stdlib.display(n)
          detail = "" })

  let picker =
    Cli.Workbench.BranchPicker
      { choices = choices
        field = Stdlib.Cli.UI.TextField.fromText("")
        selected = 0 }

  let state = { base with overlay = Cli.Workbench.Overlay.Branches(picker) }
  let paged = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.PageDown)).state
  let typed = (wbChar(paged, "BRANCH-20")).state
  let matched =
    match typed.overlay with
    | Branches(p) ->
      let names =
        Cli.Workbench.matchingBranches(p) |> Stdlib.List.map(fun b -> b.name)

      p.selected == 0 && names == [ "branch-20" ]
    | _ -> false

  let missing = (wbChar(typed, "zzz")).state
  let enter = (wbKey(missing, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let noMatch =
    match enter.overlay with
    | Branches(p) -> Stdlib.List.isEmpty(Cli.Workbench.matchingBranches(p))
    | _ -> false

  let cancelled = (wbKey(typed, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let fromCode = (wbChar((wbChar(base, "2")).state, "S")).state
  let fromHome = (wbChar(base, "s")).state
  let isOpen(s: Cli.Workbench.State): Bool =
    match s.overlay with
    | Branches(_) -> true
    | _ -> false

  if
    opens
    && matched
    && noMatch
    && isOpen(fromCode)
    && isOpen(fromHome)
    && cancelled.overlay == Cli.Workbench.Overlay.NoOverlay
    && cancelled.branchId == base.branchId
    && cancelled.items == base.items
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "picker must filter all branches, cancel and reject no matches")


// A first run lands on Home. While nothing is in progress, Home ends with where to begin, and
// each of those rows opens the view it names.
test workbenchHomeSaysWhereToBegin =
  let start = Cli.Workbench.homeStartRows(true, 0, 0, 0)
  let kinds = start |> Stdlib.List.map(fun item -> item.kind)
  let gone =
    [ Cli.Workbench.homeStartRows(false, 0, 0, 0)
      Cli.Workbench.homeStartRows(true, 1, 0, 0)
      Cli.Workbench.homeStartRows(true, 0, 1, 0)
      Cli.Workbench.homeStartRows(true, 0, 0, 1) ]
    |> Stdlib.List.all(fun rows -> Stdlib.List.isEmpty(rows))

  let base = workbenchState()
  let opens(index: Int64): Int64 =
    let state = { base with items = start, selected = index }
    (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Enter)).state.activeView

  if
    kinds == [ "home-start-repl", "home-start-code", "home-start-docs" ]
    && gone
    && opens(0) == Cli.Workbench.vScratch
    && opens(1) == Cli.Workbench.vMatter
    && opens(2) == Cli.Workbench.vDocs
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Home must say where to begin while nothing is in progress, and open each view")
