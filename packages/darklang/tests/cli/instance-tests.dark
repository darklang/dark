/// Tests of the throwaway-instance harness itself.
///
/// Part of `Darklang.Cli.Tests`. These are the proof that `Instance` gives a test a store
/// of its own: if they pass, a CLI test written against it cannot see the developer's
/// work and cannot be seen by the next test.
module Darklang.Cli.Tests.TestSuite


/// An instance answers at all, from its own directory.
///
/// `branches` rather than `version`: `version` checks GitHub for a newer release, so it
/// would make this a test of the network.
test instanceAnswers =
  Instance.withInstance (fun i -> Instance.expectExit i [ "branches" ] 0)


/// Two instances do not see each other's work.
///
/// A branch is the cheapest thing that is unmistakably a store write: no stdin, no
/// authoring, and it shows up in a listing by name.
test instancesAreIsolated =
  match Instance.create () with
  | Error e -> Stdlib.Test.fail $"first instance: {e}"
  | Ok a ->
    match Instance.create () with
    | Error e ->
      let _ = Instance.dispose a
      Stdlib.Test.fail $"second instance: {e}"
    | Ok b ->
      let suffix = Stdlib.toString (Stdlib.Int.random 100000 999999)
      let name = $"iso-{suffix}"

      let _ = Instance.run a [ "branch", "create", name ]
      let inA = Instance.output a [ "branches" ]
      let inB = Instance.output b [ "branches" ]

      let _ = Instance.dispose a
      let _ = Instance.dispose b

      if Stdlib.Bool.not (Stdlib.String.contains inA name) then
        Stdlib.Test.fail $"the branch is missing from the instance that made it: {inA}"
      else if Stdlib.String.contains inB name then
        Stdlib.Test.fail $"the branch leaked into a second instance: {inB}"
      else
        Stdlib.Test.Result.Pass


/// Disposing an instance takes its store with it.
test disposeRemovesTheStore =
  match Instance.create () with
  | Error e -> Stdlib.Test.fail e
  | Ok i ->
    let store = $"{i.dir}/data.db"

    if Stdlib.Bool.not (Stdlib.Cli.Unix.fileExists store) then
      let _ = Instance.dispose i
      Stdlib.Test.fail $"a new instance has no store at {store}"
    else
      let _ = Instance.dispose i

      if Stdlib.Cli.Unix.fileExists store then
        Stdlib.Test.fail $"dispose left {store} behind"
      else
        Stdlib.Test.Result.Pass


/// The workbench paints, on a terminal, in an instance of its own.
///
/// The only test here that needs a pty, which is the whole reason `Interactive` exists.
/// Wait for the Home tab and the footer before sending q. These are part of
/// every initial frame, including an instance that has already been set up.
test workbenchPaints =
  if Stdlib.Bool.not (Interactive.available ()) then
    Stdlib.Test.fail "expect is not installed, so the interactive tests cannot run"
  else
    Instance.withInstance (fun i ->
      Interactive.expectSteps
        i
        []
        [ Interactive.Step.Await "Home"
          Interactive.Step.Await "quit"
          Interactive.Step.Send "q" ]
        30)
