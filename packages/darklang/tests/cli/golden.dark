/// Byte-for-byte ports of the two standalone workbench render checks.
/// Expected frames are copied from the checked-in .expected files, not generated
/// by the test.
module Darklang.Cli.Tests.Golden

let compare (render: Unit -> Unit) (expectedRows: List<String>) : Stdlib.Test.Result =
  // Key handlers read the worker's fixed 80x24 terminal size; viewAtSize
  // renders the original explicit sizes. Stdout contains frames only.
  let output = Stdlib.Test.Process.run (Stdlib.Test.Process.defaults ()) render ()
  match output with
  | Error message -> Stdlib.Test.fail message
  | Ok output ->
    let actualRows = Stdlib.String.split output.stdout "\n"
    Stdlib.Test.all
      [ Stdlib.Test.expect
          (output.exitCode == 0)
          $"Fixture failed: {output.stderr} {output.stdout}"
        Stdlib.List.length actualRows
        |> Stdlib.Test.equal (Stdlib.List.length expectedRows)
        expectedRows
        |> Stdlib.List.indexedMap (fun index expectedRow ->
          Stdlib.List.getAt actualRows index |> Stdlib.Test.equal (Some expectedRow))
        |> Stdlib.Test.all ]

// Differs from legacy: the source is
// `scripts/perf/workloads/checks/goldenview.dark` with additions only.
// `fixedHome` replaces the Home rows with the ones `goldenview.expected` shows,
// so the frames do not depend on the developer's branches or commit ages;
// `initialState` takes the `live` argument it has since gained (`false`); and
// the child runs with COLUMNS=80 LINES=24 and stdin detached (see `compare`).
// The expected rows are `goldenview.expected` byte for byte.
let goldenviewRender () : Unit =
  // Fixed view inputs: these screenshots test layout and key handling, not the
  // developer's branches or how long ago the store was reloaded.
  let homeItems () : List<Darklang.Cli.Workbench.BodyItem> =
    let row (name: String) (kind: String) (desc: String) : Darklang.Cli.Workbench.BodyItem =
      Darklang.Cli.Workbench.BodyItem { name = name; kind = kind; isModule = false; desc = desc }
    [ Darklang.Cli.Workbench.homeHeader "this branch"
      row "● main" "home-here" "nothing uncommitted · last commit 1m ago"
      Darklang.Cli.Workbench.homeHeader ""
      Darklang.Cli.Workbench.homeHeader "recent commits"
      row "package reload (baseline)" "home-commit" "system · 1m ago"
      Darklang.Cli.Workbench.homeHeader ""
      Darklang.Cli.Workbench.homeHeader "branches"
      row "● main" "home-branch" "current · 1m ago" ]

  let fixedHome (s: Darklang.Cli.Workbench.State) : Darklang.Cli.Workbench.State =
    if s.activeView == Darklang.Cli.Workbench.vHome then { s with items = homeItems () }
    else s

  // Every row of a workbench view at three sizes, for diffing a render change against.
  //
  // Not a benchmark. `compose`, `composeRow`, `overlay` and `renderSegments` decide what a frame
  // actually looks like, and a performance change to any of them has to produce the same bytes.
  //
  // `scripts/perf/checks` diffs this against `goldenview.expected` beside it. When the view itself
  // changes, regenerate that file deliberately -- never to make the check pass:
  //
  //   ./scripts/run-cli run scripts/perf/workloads/checks/goldenview.dark \
  //     > scripts/perf/workloads/checks/goldenview.expected
  //
  // Three sizes because the interesting bugs are in clipping and in rows that run out of room.

  let loadedBase =
    Darklang.Cli.Workbench.initialState
      Darklang.SCM.Branch.mainBranchId
      Stdlib.Option.Option.None
      "perf"
      "perf-instance"
      (Stdlib.List.range 0 40)
      false

  let base = fixedHome loadedBase

  let sizes =
    [ Stdlib.Cli.Tui.Size { width = 120; height = 40 }
      Stdlib.Cli.Tui.Size { width = 80; height = 24 }
      Stdlib.Cli.Tui.Size { width = 40; height = 10 } ]

  let dump (size: Stdlib.Cli.Tui.Size) : Unit =
    let v = Darklang.Cli.Workbench.viewAtSize base size
    let _ =
      v.rows
      |> Stdlib.List.indexedMap (fun i r ->
        Stdlib.printLine
          ((Stdlib.toString size.width)
           + "x"
           + (Stdlib.toString size.height)
           + " "
           + (Stdlib.toString i)
           + "|"
           + r))
    ()

  let _rendered = sizes |> Stdlib.List.map (fun s -> dump s)

  Stdlib.printLine "-- end of golden view --"

