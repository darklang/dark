// The small enums CLI fns take in place of a bare `true` or `false`, and the helpers that
// turn a parsed flag into one.
module Darklang.Cli.Tests.Flags

// `failed` is exit code 1; `exitWith` still decides it from a computed Bool.
test failedExitsOne =
  let state = Cli.initState()
  Stdlib.Test.all(
    [ (Cli.failed(state)).exitCode |> Stdlib.Test.equal(1)
      (Cli.exitWith(state, false)).exitCode |> Stdlib.Test.equal(1)
      (Cli.exitWith(state, true)).exitCode
      |> Stdlib.Test.equal(state.exitCode) ])


// `-y` assumes the yes, and an assumed yes is a yes with nobody asked.
test confirm =
  Stdlib.Test.all(
    [ Cli.Confirm.assumeIf(true) |> Stdlib.Test.equal(Cli.Confirm.Assume)

      Cli.Confirm.assumeIf(false) |> Stdlib.Test.equal(Cli.Confirm.Ask)

      Cli.Prompt.confirmExplicit(Cli.Confirm.Assume, "go?")
      |> Stdlib.Test.equal(true) ])


module Query =
  let hash(text: String): LanguageTools.ProgramTypes.Hash =
    LanguageTools.ProgramTypes.Hash.Hash(text)


  // `old` is deprecated with no live caller, so a listing hides it by default. `gone` was deleted
  // by name while `plain` holds the same content, so it is hidden and `plain` is not.
  let sets(): Cli.Packages.Query.DeprecationSets =
    Cli.Packages.Query.DeprecationSets
      { allDeprecated = Cli.Packages.Query.hashListToDict([ hash("aa") ])
        hidden = Cli.Packages.Query.hashListToDict([ hash("aa") ])
        marked =
          Stdlib.Dict.fromList([ ("aa", [ "M.old" ]), ("cc", [ "M.gone" ]) ]) }


  let shown(
    deprecated: Cli.Packages.Query.Deprecated,
    internal: Cli.Packages.Query.Internal)
    : List<String> =
    Cli.Packages.Query.filterHiddenPairs(
      [ "M" ],
      [ ("old", hash("aa"))
        ("__helper", hash("bb"))
        ("plain", hash("cc"))
        ("gone", hash("cc")) ],
      sets(),
      deprecated,
      internal)
    |> Stdlib.List.map(fun((name, _)) -> name)


  // Each enum shows or hides its own kind of item, and only that kind.
  test filterHiddenPairs =
    Stdlib.Test.all(
      [ shown(
          Cli.Packages.Query.Deprecated.Hide,
          Cli.Packages.Query.Internal.Hide)
        |> Stdlib.Test.equal([ "plain" ])

        shown(
          Cli.Packages.Query.Deprecated.Show,
          Cli.Packages.Query.Internal.Hide)
        |> Stdlib.Test.equal([ "old", "plain", "gone" ])

        shown(
          Cli.Packages.Query.Deprecated.Hide,
          Cli.Packages.Query.Internal.Show)
        |> Stdlib.Test.equal([ "__helper", "plain" ])

        shown(
          Cli.Packages.Query.Deprecated.Show,
          Cli.Packages.Query.Internal.Show)
        |> Stdlib.Test.equal([ "old", "__helper", "plain", "gone" ]) ])


  // The flag a command parsed picks the case.
  test showIf =
    Stdlib.Test.all(
      [ Cli.Packages.Query.Deprecated.showIf(true)
        |> Stdlib.Test.equal(Cli.Packages.Query.Deprecated.Show)

        Cli.Packages.Query.Deprecated.showIf(false)
        |> Stdlib.Test.equal(Cli.Packages.Query.Deprecated.Hide)

        Cli.Packages.Query.Internal.showIf(true)
        |> Stdlib.Test.equal(Cli.Packages.Query.Internal.Show)

        Cli.Packages.Query.Internal.showIf(false)
        |> Stdlib.Test.equal(Cli.Packages.Query.Internal.Hide) ])


// `diff --source`, `commits --all`, `view --include-tests` and `branches --all` each pick their case.
test showIfAtTheCommandLine =
  Stdlib.Test.all(
    [ Cli.Branch.Source.showIf(true)
      |> Stdlib.Test.equal(Cli.Branch.Source.Show)

      Cli.Branch.Source.showIf(false)
      |> Stdlib.Test.equal(Cli.Branch.Source.Hide)

      Cli.Commits.Housekeeping.showIf(true)
      |> Stdlib.Test.equal(Cli.Commits.Housekeeping.Show)

      Cli.Commits.Housekeeping.showIf(false)
      |> Stdlib.Test.equal(Cli.Commits.Housekeeping.Hide)

      Cli.Packages.View.Tests.showIf(true)
      |> Stdlib.Test.equal(Cli.Packages.View.Tests.Show)

      Cli.Packages.View.Tests.showIf(false)
      |> Stdlib.Test.equal(Cli.Packages.View.Tests.Hide)

      Cli.Branch.Merged.showIf(true)
      |> Stdlib.Test.equal(Cli.Branch.Merged.Show)

      Cli.Branch.Merged.showIf(false)
      |> Stdlib.Test.equal(Cli.Branch.Merged.Hide) ])
