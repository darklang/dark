test eachRefusalSaysWhyOnStderrAndExits1 = Instance.withInstance(fun i ->
  let faults =
    refusals
    |> Stdlib.List.filterMap(fun row ->
      let (args, reason) = row
      let (code, out, err) = streams(i, args)
      if code == 1 && out == "" && err == reason then
        Stdlib.Option.Option.None
      else
        let cmd = Stdlib.String.join(args, " ")
        Stdlib.Option.Option.Some(
          $"  dark {cmd} -> exit {Stdlib.display(code)}, stdout {Stdlib.inspect(out)}, stderr {Stdlib.inspect(err)}"))

  Stdlib.Test.expect(
    faults == [],
    "refusals that wrote to stdout, said something else, or did not exit 1:\n"
    + Stdlib.String.join(faults, "\n")))


/// Discarding an empty draft is not a refusal: there was nothing to do, and nothing was done.
test discardingAnEmptyDraftSaysSo = Instance.withInstance(fun i ->
  let (code, out, err) = streams(i, [ "discard", "-y" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 0, "nothing to discard is not a failure")
      Stdlib.Test.equal(out, "")
      Stdlib.Test.equal(err, "nothing to discard -- your draft on main is empty.") ]))


/// A dash-led argument is a flag someone mistyped, never a name: unguarded, `dark switch --help`
/// started a branch called "--help" and moved the store onto it.
test aDashLedArgumentIsNeverAName = Instance.withInstance(fun i ->
  [ "switch", "branch" ]
  |> Stdlib.List.map(fun cmd ->
    let (code, out, err) = streams(i, [ cmd, "--zzz-not-a-branch" ])
    Stdlib.Test.all(
      [ Instance.exitedWith(code, 1, $"dark {cmd} --zzz-not-a-branch refuses")
        Stdlib.Test.equal(out, "")
        Stdlib.Test.equal(
          err,
          $"error: `dark {cmd}` does not take `--zzz-not-a-branch`.\n  hint: `dark {cmd} --help` shows what it takes.")
        Instance.doesNotSay(
          Instance.said(i, [ "branches" ]),
          "--zzz-not-a-branch",
          $"dark {cmd} --zzz-not-a-branch must not start a branch")
        Instance.says(
          Instance.said(i, [ "branch" ]),
          "on main",
          "and must not move you off main") ]))
  |> Stdlib.Test.all)


/// The refusals a sweep cannot run, because a mistake there costs something: a mistyped flag beside
/// `-y` used to discard the whole draft, and a stray word after an inline definition used to be
/// dropped and the rest saved.
test aMistypedFlagOrAStrayWordChangesNothing = Instance.withInstance(fun i ->
  let (savedCode, _) = Instance.ran(i, [ "fn", "Tests.Costly.kept", "() : Int64 = 1" ])
  let (discardCode, _) = Instance.ran(i, [ "discard", "--only-this", "-y" ])
  let (keptCode, kept, _) = streams(i, [ "eval", "Tests.Costly.kept()" ])
  let (valCode, _) = Instance.ran(i, [ "val", "Tests.Costly.x", "42", "zzz" ])
  let (xCode, _) = Instance.ran(i, [ "eval", "Tests.Costly.x" ])
  let (fnCode, _) = Instance.ran(i, [ "fn", "Tests.Costly.f", "() : Int64 = 90817", "zzz" ])
  let (fCode, _) = Instance.ran(i, [ "eval", "Tests.Costly.f()" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(savedCode, 0, "the fixture saved")
      Instance.exitedWith(discardCode, 1, "discard refuses a flag it does not have")
      Instance.exitedWith(keptCode, 0, "and the draft is still there")
      Stdlib.Test.equal(kept, "1")
      Instance.exitedWith(valCode, 1, "val refuses a word after the definition")
      Instance.exitedWith(xCode, 1, "and saves nothing")
      Instance.exitedWith(fnCode, 1, "fn refuses a word after the definition")
      Instance.exitedWith(fCode, 1, "and saves nothing") ]))
