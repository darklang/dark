/// Refusals: a command that cannot do what was asked leaves stdout empty, says why on stderr, and
/// exits 1. stdout is the answer or nothing, `--json` included, so `dark x --json | jq` meets an
/// empty input and the exit code says why; a refusal that exits 0 is success to a shell, a CI step
/// or an agent.
module Darklang.Cli.Tests.Refusals

/// Trimmed, with the colour taken out and the lines kept.
let plain(text: String): String =
  Stdlib.Regex.replaceAll(Stdlib.String.trim(text), "\\x1b\\[[0-9;]*m", "")
  |> Stdlib.Result.withDefault(text)


/// A command's exit code, stdout and stderr, trimmed and without colour.
let streams(i: Instance.T, args: List<String>): (Int64 * String * String) =
  match Instance.run(i, args) with
  | Error(e) -> (-1, "", $"could not run: {e}")
  | Ok(out) ->
    (out.exitCode, plain(out.stdout), plain(out.stderr))


/// Each refusal and everything it says on stderr. Every row runs on one fresh store, on main with
/// an empty draft, and changes nothing, so the order does not matter.
val refusals: List<(List<String> * String)> =
  [ ([ "trait", "Tests.ExitT.T" ], "error: `dark trait` needs 2 arguments, and was given 1.\n  hint: `dark trait --help` shows what it takes.")
