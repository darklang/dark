module Darklang.Cli.Tests.ReleaseAssets

// Which release asset the in-CLI updater downloads.
//
// `linux-arm` and `linux-arm64` are both real platform ids and one is a prefix of the other, so a
// `contains` match hands an armv7l machine the arm64 binary. `install.sh` suffix-matches `-<rid>.gz`
// for this reason; these assert that the updater does the same.

module AssetForPlatform =
  let asset(name: String): GitHub.Releases.Asset =
    GitHub.Releases.Asset
      { name = name, browser_download_url = $"https://example.com/{name}" }


  // The LONGER name first, deliberately. `findFirst` with a `contains` match returns the arm64
  // asset when asked for `linux-arm`, so this order is what gives the assertions teeth; with arm
  // first, a prefix match is accidentally right and the test proves nothing.
  //
  // A function, not a `val`: a `val` holding a custom type carries the type identity it was built
  // against, and the testfile harness rebuilds the package set underneath it.

  let assets(): List<GitHub.Releases.Asset> =
    [ asset("darklang-alpha-abc1234-linux-arm64.gz")
      asset("darklang-alpha-abc1234-linux-arm.gz")
      asset("darklang-alpha-abc1234-linux-musl-arm64.gz")
      asset("darklang-alpha-abc1234-linux-musl-x64.gz")
      asset("darklang-alpha-abc1234-linux-x64.gz")
      asset("darklang-alpha-abc1234-osx-arm64.gz") ]


  // arm64 must not be served the 32-bit build, and arm must not be served the 64-bit one.
  test armBuilds =
    Stdlib.Test.all(
      [ GitHub.Releases.assetUrlFor(assets(), "linux-arm64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-arm64.gz"))

        GitHub.Releases.assetUrlFor(assets(), "linux-arm")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-arm.gz")) ])


  // Each glibc build and its musl build end alike (`linux-x64`, `linux-musl-x64`), the same trap
  // one letter along.
  test muslSuffix =
    Stdlib.Test.all(
      [ GitHub.Releases.assetUrlFor(assets(), "linux-x64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-x64.gz"))

        GitHub.Releases.assetUrlFor(assets(), "linux-musl-x64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-musl-x64.gz"))

        GitHub.Releases.assetUrlFor(assets(), "linux-arm64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-arm64.gz"))

        GitHub.Releases.assetUrlFor(assets(), "linux-musl-arm64")
        |> Stdlib.Test.equal(
          Some(
            "https://example.com/darklang-alpha-abc1234-linux-musl-arm64.gz"))

        GitHub.Releases.assetUrlFor(assets(), "osx-arm64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-osx-arm64.gz")) ])


  // A platform this release has no build for is None, not the first thing that looks close.
  // `osx-x64` is a real runtime we publish, so this is the "a tag is missing one asset" case
  // rather than "we do not build that at all".
  test missingPlatform =
    GitHub.Releases.assetUrlFor(assets(), "osx-x64") |> Stdlib.Test.equal(None)


  // An empty list, and an asset list that carries something other than a `.gz`.
  test emptyAndNonGzAssets =
    Stdlib.Test.all(
      [ GitHub.Releases.assetUrlFor([], "linux-x64") |> Stdlib.Test.equal(None)

        GitHub.Releases.assetUrlFor(
          [ asset("darklang-alpha-abc1234-linux-x64.tar") ],
          "linux-x64")
        |> Stdlib.Test.equal(None) ])


// Which runtime id a host maps to. Every id here is one `ALL_RUNTIMES` publishes.
module PlatformForHost =
  // A function rather than a `val`: a `val` holding a custom type carries the type identity it
  // was built against, and the testfile harness rebuilds the package set underneath it.
  let host(
    os: Stdlib.Cli.OS.OS,
    arch: Stdlib.Cli.Architecture.Architecture)
    : Stdlib.Cli.Host.Host =
    Stdlib.Cli.Host.Host
      { os = os, arch = arch, defaultShell = Stdlib.Cli.Shell.Shell.Bash }


  let idFor(
    os: Stdlib.Cli.OS.OS,
    arch: Stdlib.Cli.Architecture.Architecture)
    : Stdlib.Result.Result<String, String> =
    GitHub.Releases.platformId(PlatformForHost.host(os, arch))


  test everySupportedHost =
    Stdlib.Test.all(
      [ PlatformForHost.idFor(
          Stdlib.Cli.OS.OS.Linux,
          Stdlib.Cli.Architecture.Architecture.Arm)
        |> Stdlib.Test.equal(Ok("linux-arm"))

        PlatformForHost.idFor(
          Stdlib.Cli.OS.OS.Linux,
          Stdlib.Cli.Architecture.Architecture.Aarch64)
        |> Stdlib.Test.equal(Ok("linux-musl-arm64"))

        PlatformForHost.idFor(
          Stdlib.Cli.OS.OS.Linux,
          Stdlib.Cli.Architecture.Architecture.X86_64)
        |> Stdlib.Test.equal(Ok("linux-musl-x64"))

        PlatformForHost.idFor(
          Stdlib.Cli.OS.OS.MacOS,
          Stdlib.Cli.Architecture.Architecture.Arm64)
        |> Stdlib.Test.equal(Ok("osx-arm64"))

        PlatformForHost.idFor(
          Stdlib.Cli.OS.OS.MacOS,
          Stdlib.Cli.Architecture.Architecture.X86_64)
        |> Stdlib.Test.equal(Ok("osx-x64")) ])


  test unsupportedCombination =
    PlatformForHost.idFor(
      Stdlib.Cli.OS.OS.MacOS,
      Stdlib.Cli.Architecture.Architecture.Arm)
    |> Stdlib.Test.equal(Error("Unsupported OS or Arch"))


// Which release a build is. The tag is nowhere in the binary, so `dark version` finds it by the
// build its assets are named after.
module ReleaseForBuild =
  // A function rather than a `val`, for the reason `PlatformForHost.host` gives.
  let release(tag: String, hash: String): GitHub.Releases.Release =
    GitHub.Releases.Release
      { tag_name = tag
        assets =
          [ AssetForPlatform.asset($"darklang-alpha-{hash}-linux-x64.gz")
            AssetForPlatform.asset($"darklang-alpha-{hash}-osx-arm64.gz") ] }


  let releases(): List<GitHub.Releases.Release> =
    [ release("v0.0.104", "e76430be5c"), release("v0.0.103", "0ab12cd34e") ]


  // An asset carries ten characters of the hash and the CLI prints seven.
  test buildFromAssetName =
    GitHub.Releases.buildOf(release("v0.0.104", "e76430be5c"))
    |> Stdlib.Test.equal(Some("alpha-e76430b"))


  test tagOfAnOlderRelease =
    GitHub.Releases.tagFor(releases(), "alpha-0ab12cd")
    |> Stdlib.Test.equal(Some("v0.0.103"))


  // A dev build is no release, and a release with no assets names no build.
  test noReleaseForADevBuild =
    Stdlib.Test.all(
      [ GitHub.Releases.tagFor(releases(), "alpha-1234567")
        |> Stdlib.Test.equal(None)

        GitHub.Releases.buildOf(
          GitHub.Releases.Release { tag_name = "v0.0.1", assets = [] })
        |> Stdlib.Test.equal(None) ])


// What `install.sh` and `dark update` check a download against: the release's checksums file.
module Checksums =
  test sumsFileIsFoundAndNeverTakenForABinary =
    let assets =
      Stdlib.List.append(
        AssetForPlatform.assets(),
        AssetForPlatform.asset("darklang-alpha-abc1234-sha256sums.txt"))

    Stdlib.Test.all(
      [ GitHub.Releases.sumsUrlFor(assets)
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-sha256sums.txt"))

        GitHub.Releases.sumsUrlFor(AssetForPlatform.assets())
        |> Stdlib.Test.equal(None)

        GitHub.Releases.assetUrlFor(assets, "linux-x64")
        |> Stdlib.Test.equal(
          Some("https://example.com/darklang-alpha-abc1234-linux-x64.gz")) ])


  // As `sha256sum` prints them. `linux-arm` must not take `linux-arm64`'s line.
  val sums =
    "AB12  darklang-alpha-abc1234-linux-arm64.gz\ncd34  darklang-alpha-abc1234-linux-arm.gz\n"


  test hashForEachFile =
    Stdlib.Test.all(
      [ Cli.Installation.Download.expectedSha256(
          sums,
          "darklang-alpha-abc1234-linux-arm.gz")
        |> Stdlib.Test.equal(Some("cd34"))

        Cli.Installation.Download.expectedSha256(
          sums,
          "darklang-alpha-abc1234-linux-arm64.gz")
        |> Stdlib.Test.equal(Some("ab12"))

        Cli.Installation.Download.expectedSha256(
          sums,
          "darklang-alpha-abc1234-osx-x64.gz")
        |> Stdlib.Test.equal(None) ])


  val refused =
    "so the new version wasn't installed and nothing was changed. Please report this at https://github.com/darklang/dark/issues"


  // sha256 of "abc".
  val abcSums =
    "BA7816BF8F01CFEA414140DE5DAE2223B00361A396177A9CB410FF61F20015AD  darklang-alpha-abc1234-linux-x64.gz\n"


  test downloadMatchingItsSumIsAccepted =
    Cli.Installation.Download.matchesSums(
      abcSums,
      "darklang-alpha-abc1234-linux-x64.gz",
      Stdlib.Utf8.encode("abc"))
    |> Stdlib.Test.equal(Ok())


  test changedDownloadIsRefused =
    Cli.Installation.Download.matchesSums(
      abcSums,
      "darklang-alpha-abc1234-linux-x64.gz",
      Stdlib.Utf8.encode("abd"))
    |> Stdlib.Test.equal(
      Error(
        $"darklang-alpha-abc1234-linux-x64.gz doesn't match the checksum its release lists for it: it was damaged or changed on the way, {refused}"))


  test downloadMissingFromSumsIsRefused =
    Cli.Installation.Download.matchesSums(
      abcSums,
      "darklang-alpha-abc1234-osx-arm64.gz",
      Stdlib.Utf8.encode("abc"))
    |> Stdlib.Test.equal(
      Error(
        $"The release's checksums file doesn't list darklang-alpha-abc1234-osx-arm64.gz, {refused}"))


// Why a release lookup failed, as `update` and `install` say it.
module ReleaseErrors =
  test notFoundIsItsOwnError =
    Stdlib.Test.all(
      [ GitHub.Releases.statusError("v0.0.1", 404)
        |> Stdlib.Test.equal(GitHub.ReleaseError.ReleaseNotFound("v0.0.1"))

        GitHub.Releases.statusError("v0.0.1", 500)
        |> Stdlib.Test.equal(GitHub.ReleaseError.BadStatus(500))

        GitHub.Releases.statusError("v0.0.1", 403)
        |> Stdlib.Test.equal(GitHub.ReleaseError.BadStatus(403)) ])


  test messages =
    Stdlib.Test.all(
      [ GitHub.releaseErrorMessage(
          GitHub.ReleaseError.RequestFailed(
            Stdlib.HttpClient.RequestError.Timeout))
        |> Stdlib.Test.equal("Couldn't reach the GitHub API: Timeout")

        GitHub.releaseErrorMessage(GitHub.ReleaseError.BadStatus(500))
        |> Stdlib.Test.equal("The GitHub API answered with status 500")

        GitHub.releaseErrorMessage(GitHub.ReleaseError.UnexpectedResponse)
        |> Stdlib.Test.equal("Couldn't read the GitHub API's answer")

        GitHub.releaseErrorMessage(GitHub.ReleaseError.NoReleases)
        |> Stdlib.Test.equal("No releases found")

        GitHub.releaseErrorMessage(
          GitHub.ReleaseError.ReleaseNotFound("v0.0.1"))
        |> Stdlib.Test.equal("No release is tagged v0.0.1")

        GitHub.releaseErrorMessage(GitHub.ReleaseError.UnsupportedHost)
        |> Stdlib.Test.equal("No Darklang build for this OS and architecture")

        GitHub.releaseErrorMessage(
          GitHub.ReleaseError.NoAssetForPlatform("linux-x64"))
        |> Stdlib.Test.equal("No asset named `-linux-x64.gz` in this release")

        GitHub.releaseErrorMessage(GitHub.ReleaseError.NoChecksums("v0.0.1"))
        |> Stdlib.Test.equal(
          "Release v0.0.1 has no checksums file, so its download can't be checked") ])
