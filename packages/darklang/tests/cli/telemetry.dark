module Darklang.Cli.Tests.Telemetry

// `logFilePath` used to be a `val`, evaluated once when the package store was built, so it
// held the build machine's log dir plus a doubled slash. It is worked out per process now.
test telemetryLogFileNameHasOneSlashBeforeIt =
  Cli.Telemetry.logFilePath()
  |> Stdlib.String.endsWith("/logs/telemetry.jsonl")
  |> Stdlib.Test.equal(true)
