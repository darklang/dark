module Darklang.Cli.Tests.DocsForAI

// `docs for-ai` is read in full at the start of every agent session and carried through every
// call after, so it stays short; the reference sections are one more word away.

let subtopic(name: String): String =
  match Cli.Docs.Command.Topics.findTopic("for-ai") with
  | Some(topic) ->
    match Cli.Docs.Command.Topics.findIn(topic.subtopics, name) with
    | Some(sub) ->
      let content = sub.content
      content()
    | None -> ""
  | None -> ""


// Read in full at the start of every session; the limit keeps it from growing unnoticed.
test forAIStaysShort =
  let size = Stdlib.String.length(Cli.Docs.ForAI.content())
  Stdlib.Test.expect(size < 7300, $"docs for-ai is {size} characters")


// What moved out of `docs for-ai` is still there, under the part its More list names.
test movedSectionsAreOneWordAway =
  Stdlib.Test.all(
    [ ("packages", "view Some.fn --raw > /tmp/f.dark")
      ("tests", "test run --force")
      ("permissions", "permissions approve --for Vendor.Package.function")
      ("traces", "dark traces show <fn> --json")
      ("scm", "dark merge feature -y")
      ("syntax", "## Name Resolution")
      ("perms", "permissions profile local-dev")
      ("TESTS", "Stdlib.Test.incrementCounter") ]
    |> Stdlib.List.map(fun((name, phrase)) ->
      Stdlib.Test.expect(
        Stdlib.String.contains(subtopic(name), phrase),
        $"docs for-ai {name} has {phrase}"))
    |> Stdlib.List.append(
      Stdlib.Test.expect(
        Stdlib.String.contains(Cli.Docs.ForAI.content(), "docs for-ai tests"),
        "docs for-ai names its parts")))


/// What a person reads: trimmed, colour taken out, lines kept.
let plain(out: String): String =
  Stdlib.Regex.replaceAll(Stdlib.String.trim(out), "\\x1b\\[[0-9;]*m", "")
  |> Stdlib.Result.withDefault(out)


test unknownPartIsRefused = Instance.withInstance(fun i ->
  let (code, out) = Instance.ran(i, [ "docs", "for-ai", "zzz" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 1, "an unknown part fails")
      plain(out)
      |> Stdlib.Test.equal(
        "Unknown part of docs for-ai: zzz\n\n  docs for-ai packages - Saving and changing declarations, the type checker, a command-line tool\n  docs for-ai tests - Package tests in full\n  docs for-ai permissions - Rules, profiles and package approvals\n  docs for-ai traces - What a run did, and things that run at once\n  docs for-ai scm - Drafts, commits, branches, deprecation\n  docs for-ai syntax - The full syntax notes and name resolution\nAny other topic from `docs` can be added too.")

      Instance.says(
        Instance.said(i, [ "docs", "for-ai", "tests" ]),
        "## Package tests",
        "a part prints") ]))


// One call prints every part asked for, each once and under its own header, so an agent
// needs two turns at most: the main page, then the parts it names.
test severalPartsInOneCall = Instance.withInstance(fun i ->
  let (code, out) =
    Instance.ran(
      i,
      [ "docs", "for-ai", "tests", "scm", "perms", "permissions" ])

  Stdlib.Test.all(
    [ Stdlib.Test.expect(code == 0, "several parts print")
      Instance.says(out, "# Darklang AI: tests", "the first part")

      Instance.says(out, "# Darklang AI: scm", "the second part")

      Instance.says(
        out,
        "# Darklang AI: permissions",
        "a part named by its alias")

      Stdlib.Test.expect(
        Stdlib.List.length(
          Stdlib.String.split(out, "# Darklang AI: permissions"))
        == 2,
        "a part named twice prints once")

      Stdlib.Test.expect(
        Stdlib.String.contains(
          Cli.Docs.ForAI.content(),
          "docs for-ai tests http-server"),
        "the main page says parts and topics can be fetched together") ]))


// Another topic joins the parts in the same call, and the main page stays out: it was read first.
test otherTopicsJoinInOneCall = Instance.withInstance(fun i ->
  let (code, out) =
    Instance.ran(i, [ "docs", "for-ai", "http-server", "tests" ])

  let (scriptsCode, scripts) = Instance.ran(i, [ "docs", "scripts", "syntax" ])
  Stdlib.Test.all(
    [ Stdlib.Test.expect(code == 0, "a part and another topic print")

      Stdlib.Test.expect(
        Stdlib.Bool.not(
          Stdlib.String.contains(out, "# Darklang AI Quick Reference")),
        "without the main page")

      Instance.says(out, "# HTTP Server", "and the other topic")
      Instance.says(out, "# Darklang AI: tests", "and the part")
      Stdlib.Test.expect(scriptsCode == 0, "two topics print")
      Instance.says(scripts, "# Running .dark scripts", "the first topic")
      Instance.says(scripts, "## Basics", "and the second")
      Stdlib.Test.expect(
        Stdlib.Bool.not(
          Stdlib.String.contains(
            Instance.said(i, [ "docs", "for-ai", "tests" ]),
            "# Darklang AI Quick Reference")),
        "parts alone leave the main page out") ]))


test unknownPartsAreNamed = Instance.withInstance(fun i ->
  let (code, out) = Instance.ran(i, [ "docs", "for-ai", "tests", "zzz", "yyy" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 1, "a call with an unknown part fails")
      // and prints none of the parts it does know
      plain(out)
      |> Stdlib.Test.equal(
        "Unknown parts of docs for-ai: zzz, yyy\n\n  docs for-ai packages - Saving and changing declarations, the type checker, a command-line tool\n  docs for-ai tests - Package tests in full\n  docs for-ai permissions - Rules, profiles and package approvals\n  docs for-ai traces - What a run did, and things that run at once\n  docs for-ai scm - Drafts, commits, branches, deprecation\n  docs for-ai syntax - The full syntax notes and name resolution\nAny other topic from `docs` can be added too.") ]))


// `docs for-ai` says which values `Stdlib.display` takes, that interpolation falls back to
// `Stdlib.inspect`, and that lists, tuples and Unit have no `Display`. If that changes, the
// sentence needs changing.
test displayAdviceHolds = Instance.withInstance(fun i ->
  let (code, out) =
    Instance.ran(i, [ "--no-trace", "eval", "Stdlib.display([1, 2])" ])

  Stdlib.Test.all(
    [ Instance.exitedWith(code, 1, "a list has no Display")
      Stdlib.String.trim(out)
      |> Stdlib.Test.equal(
        "Error: List<Int64> has no implementation of Darklang.Stdlib.Display. Write `impl Display for List<Int64> = ...`, or run `dark impls Display` to see which types do. `Stdlib.inspect` shows any value")

      Stdlib.display(Stdlib.Option.Option.Some(3))
      |> Stdlib.Test.equal("Some(3)")

      Stdlib.display<Result<Int64, String>>(Stdlib.Result.Result.Ok(3))
      |> Stdlib.Test.equal("Ok(3)")

      Stdlib.inspect([ 1, 2 ]) |> Stdlib.Test.equal("[1, 2]")

      $"{[ 1, 2 ]}" |> Stdlib.Test.equal("[1, 2]") ]))


// Each function the main page lists by name is one a program can call.
test listedFunctionsExist =
  let names =
    [ "Stdlib.Int64.parse"
      "Stdlib.Float64.parse"
      "Stdlib.String.slice"
      "Stdlib.Utf8.decode"
      "Stdlib.Json.parse"
      "Stdlib.Cli.FileSystem.readFileAsString"
      "Stdlib.Cli.FileSystem.writeFile"
      "Stdlib.HttpClient.get"
      "Stdlib.List.getAt"
      "Stdlib.List.randomElement"
      "Stdlib.Dict.get"
      "Stdlib.Cli.Stdin.readLineOrEnd"
      "Stdlib.Int64.toFloat64"
      "Stdlib.Float64.round"
      "Stdlib.String.fromChar"
      "Stdlib.Json.serialize"
      "Stdlib.List.parallelMap"
      "Stdlib.Int64.random"
      "Stdlib.Cli.Posix.sleep"
      "Stdlib.DateTime.now"
      "Stdlib.DateTime.subtractMs"
      "Stdlib.Result.withDefault"
      "Stdlib.String.split"
      "Stdlib.String.join"
      "Stdlib.String.trim"
      "Stdlib.List.contains"
      "Stdlib.Dict.set" ]

  let page = Cli.Docs.ForAI.content()
  Instance.withInstance(fun i ->
    let (code, out) =
      Instance.ran(i, Stdlib.List.concat([ "search", "--exact" ], names))

    Stdlib.Test.all(
      [ Instance.exitedWith(code, 0, "every name is found")
        Stdlib.Test.expect(
          Stdlib.Bool.not(Stdlib.String.contains(out, "No results")),
          "no name is missing")

        Stdlib.Test.expect(
          Stdlib.List.all(names, fun n -> Stdlib.String.contains(page, n)),
          "the page names each one") ]))
