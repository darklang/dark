/// A throwaway Darklang install: its own store, its own home, gone when the test ends.
///
/// Part of `Darklang.Cli.Tests`.
///
/// Native package tests invoke these helpers inside a disposable snapshot. Nested
/// instances live beside that snapshot's store, so the isolation worker's cleanup also
/// removes them if a runtime error interrupts an assertion.
module Darklang.Cli.Tests.Instance

/// A running instance's identity: where it lives (`dir` is its `<home>/.darklang`) and what binary
/// drives it.
type T =
  { dir: String
    cli: String }


/// Keep nested instances beside the active store, inside the enclosing fixture.
/// LanguageTools.LocalStore.path is absolute; child process configuration requires that.
let root(): String =
  let store = LanguageTools.LocalStore.path()
  Stdlib.Cli.Path.parent(store) + "/test-instances"


/// The store a new instance starts from.
///
/// The live store, not `seed.db`. The seed is an export taken at some past point, and a
/// store older than the binary driving it fails on the first command with a hash that
/// cannot be found; the live store is by definition the one this build just loaded.
///
/// No environment variable for this. A guest gets no env by default and an ungranted read
/// is an error rather than a `None`, so every knob spelled as an env var is a grant every
/// caller has to remember.
let seedFrom(): String =
  LanguageTools.LocalStore.path()


/// The binary an instance drives.
///
/// NOT `scripts/run-cli`: the wrapper re-enters the container with the container's HOME, so an
/// instance driven through it uses the dev store.
let cliBinary(): String =
  match Stdlib.Env.get("DARK_CLI_UNDER_TEST") with
  | Some(path) -> path
  | None -> "backend/Build/out/Cli/Debug/net11.0/Cli"


/// A new `<home>/.darklang`. `mkdtemp` rather than a random suffix: under a seeded test two
/// runs draw the same suffix, and one's dispose would delete the other's instance.
let makeDir(): Stdlib.Result.Result<String, String> =
  let r = root()
  match Stdlib.Cli.Unix.ensureDirectoryExists(r) with
  | Error(e) -> Stdlib.Result.Result.Error($"could not create {r}: {e}")
  | Ok(_) ->
    match Stdlib.Cli.Posix.mkdtemp($"{r}/") with
    | Error(e) ->
      Stdlib.Result.Result.Error(
        $"could not create a dir in {r}: {Stdlib.display(e)}")
    | Ok(instanceHome) ->
      let dir = instanceHome + "/.darklang"
      match Stdlib.Cli.Unix.ensureDirectoryExists(dir) with
      | Error(e) -> Stdlib.Result.Result.Error($"could not create {dir}: {e}")
      | Ok(_) -> Stdlib.Result.Result.Ok(dir)


/// A fresh instance. Fails with a message rather than half-existing.
let create(): Stdlib.Result.Result<T, String> =
  let src = seedFrom()
  if Stdlib.Cli.Unix.fileExists(src) then
    match makeDir() with
    | Error(e) -> Stdlib.Result.Result.Error(e)
    | Ok(dir) ->
      // `.backup` while the store has writes in its WAL, and a read lock rather than a
      // write one, so this is safe against a dev store something else is using. With
      // nothing in the WAL the file is the whole store, and `cp` costs a third of the
      // CPU of a page-by-page backup. A run's shared snapshot is read-only, hence the
      // `chmod`.
      //
      // Then clear the copy's config. It would otherwise inherit the dev store's current
      // branch and identity, so if the dev store is on a branch, every test instance
      // starts there instead of on main. Clear all of it, not just the branch keys.
      //
      // And clear its traces: the source store holds other tests' runs, some still going,
      // so an instance would otherwise start with traces it never made.
      //
      // Unsynced, and switched to WAL here rather than by its first command: a sync on the
      // copy's first write sends the whole fresh copy to disk, and an instance is thrown
      // away anyway.
      //
      // The trace tables are listed first and cleared by a second sqlite3 once the first has
      // exited. Piped, both open the copy at once, and one can find it locked; the pipe hid
      // that, and the instance kept the source's traces.
      let db = $"{dir}/data.db"
      let traceTables =
        $"sqlite3 {db} \"SELECT 'DELETE FROM ' || name || ';' FROM sqlite_master WHERE type = 'table' AND name LIKE 'trace%'\""

      let copy =
        Stdlib.Cli.Unix.executeInDirectoryWithOutput(
          ".",
          $"if [ -s {src}-wal ]; then sqlite3 -cmd '.timeout 10000' {src} '.backup {db}'; else cp {src} {db} && chmod u+w {db}; fi && clear=$({traceTables}) && sqlite3 -cmd 'PRAGMA synchronous=OFF' {db} \"PRAGMA journal_mode=WAL; DELETE FROM config_v0; $clear\" >/dev/null")

      if copy.exitCode != 0 then
        Stdlib.Result.Result.Error(
          $"could not seed {dir} from {src}: {copy.stderr}")
      else
        Stdlib.Result.Result.Ok(T { dir = dir, cli = cliBinary() })
  else
    Stdlib.Result.Result.Error(
      $"no store to seed an instance from at {src}; build first")


let home(i: T): String =
  Stdlib.Cli.Path.parent(i.dir)


/// Remove an instance and everything in it. Safe to call twice.
let dispose(i: T): Unit =
  let _ = Stdlib.Cli.Unix.removeDirectory(home(i))
  ()


/// The environment that points a child at this instance rather than at the dev store.
///
/// `HOME` (`USERPROFILE` on Windows) moves the store. `DARK_CONFIG_DB_NAME` is named rather than
/// inherited, since a caller with it set would point the instance at a file it has no copy of.
/// `DARK_OUTPUT=pretty`: tests read what a person sees, and a pipe would otherwise get plain.
let env(i: T): List<(String * String)> =
  [ ("DARK_CONFIG_DB_NAME", "data.db")
    ("DARK_OUTPUT", "pretty")
    ("HOME", home(i))
    ("USERPROFILE", home(i))
    ("XDG_CONFIG_HOME", home(i) + "/config") ]


/// How long one command in an instance may take before it is stopped. The same limit the F#
/// harness puts on each command it runs.
val commandTimeoutMs = 120000


/// One command for an instance: its arguments, what to pipe into it, environment on top of the
/// instance's own, and whether its streams are a terminal.
type Call =
  { args: List<String>
    stdin: Stdlib.Option.Option<String>
    env: List<(String * String)>
    tty: Bool }


/// `args` with nothing piped in, no extra environment and no terminal.
let command(args: List<String>): Call =
  Call { args = args, stdin = Stdlib.Option.Option.None, env = [], tty = false }


/// Run one command in this instance. `call` is the same with a failure to start folded in.
///
/// Under a timeout, so a command that waits forever (on input, on a lock) fails as itself
/// rather than leaving the whole suite to stop answering. A terminal is `script`, sized like a
/// real one, so its stdout and stderr both come back as stdout.
let tryCall(
  i: T,
  c: Call)
  : Stdlib.Result.Result<Stdlib.Cli.Process.Output, String> =
  let terminal = if c.tty then [ ("TERM", "xterm-256color") ] else []
  let envArgs =
    Stdlib.List.flatten([ terminal, env(i), c.env ])
    |> Stdlib.List.map(fun((k, v)) -> $"{k}={v}")

  let direct = Stdlib.List.flatten([ envArgs, [ i.cli ], c.args ])
  let line =
    Stdlib.List.prepend(direct, "/usr/bin/env")
    |> Stdlib.List.map(Stdlib.Cli.Process.shellQuote)
    |> Stdlib.String.join(" ")

  let piped =
    match c.stdin with
    | Some(text) ->
      "printf '%s' " + Stdlib.Cli.Process.shellQuote(text) + " | " + line
    | None -> line

  let (program, programArgs) =
    if c.tty then
      ("script", [ "-qec", $"stty cols 100 rows 30; {piped}", "/dev/null" ])
    else
      match c.stdin with
      | Some(_) -> ("/bin/sh", [ "-c", piped ])
      | None -> ("/usr/bin/env", direct)

  Stdlib.Cli.Process.runWithTimeout(commandTimeoutMs, program, programArgs)
  |> Stdlib.Result.mapError(fun e ->
    if e == "Process timed out" then
      let cmd = Stdlib.String.join(c.args, " ")
      let seconds = Stdlib.display(commandTimeoutMs / 1000)
      $"`{cmd}` gave no answer in {seconds}s"
    else
      e)


/// A command's exit code and both streams. `-1`, with the reason on stderr, when it could not
/// start at all.
let call(i: T, c: Call): Stdlib.Cli.Process.Output =
  match tryCall(i, c) with
  | Ok(out) -> out
  | Error(e) ->
    Stdlib.Cli.Process.Output
      { exitCode = -1, stdout = "", stderr = $"could not run: {e}" }


let run(
  i: T,
  args: List<String>)
  : Stdlib.Result.Result<Stdlib.Cli.Process.Output, String> =
  tryCall(i, command(args))


/// A command with `source` piped into it: its exit code and both streams. See `ran`.
let runWithStdin(i: T, args: List<String>, source: String): (Int64 * String) =
  let out =
    call(i, { command(args) with stdin = Stdlib.Option.Option.Some(source) })

  (out.exitCode, out.stdout + out.stderr)


/// What a command printed: stdout, or stderr when stdout said nothing.
///
/// A refused command exits nonzero and explains itself on stdout, so dropping stdout on a
/// failure hides exactly the text a test wants to read.
let output(i: T, args: List<String>): String =
  match run(i, args) with
  | Error(e) -> $"ERROR: {e}"
  | Ok(out) ->
    let stdout = Stdlib.String.trim(out.stdout)
    if stdout != "" then
      stdout
    else
      let stderr = Stdlib.String.trim(out.stderr)
      if stderr == "" then "" else $"ERROR: {stderr}"


/// Fails if the instance's store binds a name to a hash with no body, as it is or after a
/// re-fold of its log.
let checkBindings(i: T): Stdlib.Test.Result =
  let out =
    Stdlib.Cli.Unix.executeInDirectoryWithOutput(
      ".",
      $"scripts/testing/check-store-bindings {i.dir}/data.db {seedFrom()} {i.cli}")

  if out.exitCode == 0 then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"the store's bindings are broken: {out.stdout}{out.stderr}")


/// Runs `f` against a fresh instance and disposes it, whatever `f` decided. A store that `f`
/// left with a name bound to no body fails the test.
///
/// Ordinary results dispose immediately. A runtime error escapes to the enclosing
/// isolation worker, whose host also removes these nested instance directories.
let withInstance(f: T -> Stdlib.Test.Result): Stdlib.Test.Result =
  match create() with
  | Error(e) -> Stdlib.Test.fail(e)
  | Ok(i) ->
    let result =
      match f(i) with
      | Pass -> checkBindings(i)
      | failed -> failed
    let _ = dispose(i)
    result


/// Asserts a command's output contains `needle`.
let expectContains(
  i: T,
  args: List<String>,
  needle: String)
  : Stdlib.Test.Result =
  let out = output(i, args)
  if Stdlib.String.contains(out, needle) then
    Stdlib.Test.Result.Pass
  else
    let cmd = Stdlib.String.join(args, " ")
    Stdlib.Test.fail($"`{cmd}` did not mention '{needle}'. It said: {out}")


/// Asserts a command's exit code.
let expectExit(i: T, args: List<String>, expected: Int64): Stdlib.Test.Result =
  let cmd = Stdlib.String.join(args, " ")
  match run(i, args) with
  | Error(e) -> Stdlib.Test.fail($"`{cmd}` could not run: {e}")
  | Ok(out) ->
    if out.exitCode == expected then
      Stdlib.Test.Result.Pass
    else
      let got = Stdlib.display(out.exitCode)
      let want = Stdlib.display(expected)
      Stdlib.Test.fail($"`{cmd}` exited {got}, expected {want}")


/// A command's exit code and everything it printed, both streams in that order.
///
/// Both streams because a refusal and its advice can land on either, and a test
/// about what a person sees should not depend on which. `-1` when the command could
/// not start at all.
let ran(i: T, args: List<String>): (Int64 * String) =
  match run(i, args) with
  | Error(e) -> (-1, $"could not run: {e}")
  | Ok(out) -> (out.exitCode, out.stdout + out.stderr)


/// A command's exit code, stdout and stderr, each trimmed and kept apart: `said` and `output`
/// join them, so they can't tell which stream a line went to.
let streams(i: T, args: List<String>): (Int64 * String * String) =
  match run(i, args) with
  | Error(e) -> (-1, "", $"could not run: {e}")
  | Ok(out) ->
    (
      out.exitCode,
      Stdlib.String.trim(out.stdout),
      Stdlib.String.trim(out.stderr))


/// Everything a command printed, both streams. See `ran`.
let said(i: T, args: List<String>): String =
  Stdlib.Tuple2.second(ran(i, args))


/// `out` mentions `needle`; `why` says what that means when it does not.
let says(out: String, needle: String, why: String): Stdlib.Test.Result =
  if Stdlib.String.contains(out, needle) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: expected '{needle}' in: {out}")


/// `out` does NOT mention `needle`.
let doesNotSay(out: String, needle: String, why: String): Stdlib.Test.Result =
  if Stdlib.String.contains(out, needle) then
    Stdlib.Test.fail($"{why}: did not expect '{needle}' in: {out}")
  else
    Stdlib.Test.Result.Pass


/// A command exited with `expected`; `why` names the case.
let exitedWith(code: Int64, expected: Int64, why: String): Stdlib.Test.Result =
  if code == expected then
    Stdlib.Test.Result.Pass
  else
    let got = Stdlib.display(code)
    let want = Stdlib.display(expected)
    Stdlib.Test.fail($"{why}: exited {got}, expected {want}")


/// Both streams, for a failure message.
let shown(out: Stdlib.Cli.Process.Output): String =
  $"stdout: {Stdlib.inspect(out.stdout)}, stderr: {Stdlib.inspect(out.stderr)}"


/// stdout mentions `needle`: the answer, not a hint or an error beside it.
let stdoutSays(
  out: Stdlib.Cli.Process.Output,
  needle: String,
  why: String)
  : Stdlib.Test.Result =
  if Stdlib.String.contains(out.stdout, needle) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: expected '{needle}' on stdout. {shown(out)}")


/// stderr mentions `needle`.
let stderrSays(
  out: Stdlib.Cli.Process.Output,
  needle: String,
  why: String)
  : Stdlib.Test.Result =
  if Stdlib.String.contains(out.stderr, needle) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: expected '{needle}' on stderr. {shown(out)}")


/// Nothing at all on stdout, not even a newline: `| jq` meets an empty input.
let stdoutIsEmpty(
  out: Stdlib.Cli.Process.Output,
  why: String)
  : Stdlib.Test.Result =
  if out.stdout == "" then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"{why}: expected nothing on stdout. {shown(out)}")


/// stdout is one JSON value and nothing else.
let stdoutIsJson(
  out: Stdlib.Cli.Process.Output,
  why: String)
  : Stdlib.Test.Result =
  match Stdlib.AltJson.parse(Stdlib.String.trim(out.stdout)) with
  | Ok(_) -> Stdlib.Test.Result.Pass
  | Error(_) ->
    Stdlib.Test.fail($"{why}: expected JSON on stdout. {shown(out)}")
