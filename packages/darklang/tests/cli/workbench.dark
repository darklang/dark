/// The workbench: every view renders, the nav walks, and navigation regressions that need real
/// key dispatch and populated views.
///
/// Part of `Darklang.Cli.Tests`.
module Darklang.Cli.Tests.Workbench

// ── Workbench: every view renders ──

/// A workbench state good enough to render, without touching the terminal.
let workbenchState(): Cli.Workbench.State =
  Cli.Workbench.initialState(
    SCM.Branch.mainBranchId,
    None,
    "test-instance",
    Cli.Workbench.Updates.Manual)


/// Render one view and report whether it produced a plausible frame.
let rendersView(viewIndex: Int64): Bool =
  let state = { workbenchState() with activeView = viewIndex }
  let size = Stdlib.Cli.Tui.Size { width = 120, height = 40 }
  let view = Cli.Workbench.viewAtSize(state, size)
  // A frame is `height` rows, and a view that drew nothing at all is a bug even if it didn't crash.
  Stdlib.List.length(view.rows) == 40
  && (view.rows
      |> Stdlib.List.any(fun r -> Stdlib.Cli.Tui.Text.stripSgr(r) != ""))


/// The same for Matter's lenses. `Changed` is the interesting one: it reads the draft rather than the
/// package tree, so it is a different code path from the other two rather than a filter over the same one.
let rendersMatterLens(lens: Cli.Workbench.Lens): Bool =
  let base = workbenchState()
  let state =
    { base with
        activeView = Cli.Workbench.vMatter
        matter = Cli.Workbench.MatterState { lens = lens } }

  let size = Stdlib.Cli.Tui.Size { width = 120, height = 40 }
  let view = Cli.Workbench.viewAtSize(state, size)
  Stdlib.List.length(view.rows) == 40
  && (view.rows
      |> Stdlib.List.any(fun r -> Stdlib.Cli.Tui.Text.stripSgr(r) != ""))


/// Matter's ITEM PAGE: the preview for a selected leaf, which is meta + source + access + references.
///
/// The deepest renderer in the workbench and the one nothing reached. It cannot be driven through the
/// terminal -- it is three interactions deep (open Matter, descend into a module, focus the preview) and
/// assertions stop being reliable past two, because the frame is painted as a diff. From state it is a
/// one-liner: put the location inside a real module so `loadItems` returns leaves rather than submodules,
/// and render.
let rendersMatterItemPage(path: List<String>): Bool =
  let base = workbenchState()
  let loc = Packages.PackageLocation.Module(path)
  let items = Cli.Workbench.loadItems(SCM.Branch.mainBranchId, loc)

  // A path with no leaves would render the empty case and prove nothing, so say so rather than pass.
  if Stdlib.List.isEmpty(items) then
    false
  else
    let state =
      { base with
          activeView = Cli.Workbench.vMatter
          location = loc
          items = items
          selected = 0
          focus = Stdlib.Cli.UI.SplitPane.Focus.Second }

    let size = Stdlib.Cli.Tui.Size { width = 120, height = 40 }
    let view = Cli.Workbench.viewAtSize(state, size)
    Stdlib.List.length(view.rows) == 40
    && (view.rows
        |> Stdlib.List.any(fun r -> Stdlib.Cli.Tui.Text.stripSgr(r) != ""))


test workbenchItemPageRenders =
  // A module of fns, and one of types + values, because the item page branches on what the leaf IS.
  let paths =
    [ [ "Darklang", "Stdlib", "List" ], [ "Darklang", "Stdlib", "Option" ] ]

  let broken =
    paths
    |> Stdlib.List.filter(fun p -> Stdlib.Bool.not(rendersMatterItemPage(p)))

  if Stdlib.List.isEmpty(broken) then
    Stdlib.Test.Result.Pass
  else
    let names =
      broken
      |> Stdlib.List.map(fun p -> Stdlib.String.join(p, "."))
      |> Stdlib.String.join(", ")

    Stdlib.Test.fail($"the item page drew nothing at: {names}")


/// ⏎ on a fn opens its page in the full-screen reader. The page is already styled (a dim title,
/// the coloured access block), and re-lexing it as code turned those escapes into literal `[2m` and
/// `[0m` on screen. Once the styling is stripped, no row may still carry an escape or a code.
test workbenchItemReaderShowsNoRawEscapes =
  let base = workbenchState()
  let loc = Packages.PackageLocation.Module([ "Darklang", "Stdlib", "List" ])
  let items = Cli.Workbench.loadItems(SCM.Branch.mainBranchId, loc)
  match Stdlib.List.findFirstIndex(items, fun i -> i.kind == "fn") with
  | None -> Stdlib.Test.fail("Darklang.Stdlib.List has no fn to open")
  | Some(idx) ->
    let state =
      { base with
          activeView = Cli.Workbench.vMatter
          location = loc
          items = items
          selected = idx
          focus = Stdlib.Cli.UI.SplitPane.Focus.First }

    let opened = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Enter)).state
    match opened.reading with
    | None -> Stdlib.Test.fail("⏎ on a fn did not open the reader")
    | Some(_) ->
      let size = Stdlib.Cli.Tui.Size { width = 120, height = 40 }
      let rows =
        (Cli.Workbench.viewAtSize(opened, size)).rows
        |> Stdlib.List.map(fun r -> Stdlib.Cli.Tui.Text.stripSgr(r))

      let raw =
        rows
        |> Stdlib.List.filter(fun r ->
          Stdlib.String.contains(r, "\u001b")
          || Stdlib.String.contains(r, "[0m")
          || Stdlib.String.contains(r, "[2m"))

      if
        Stdlib.Bool.not(
          Stdlib.List.any(rows, fun r -> Stdlib.String.contains(r, "access")))
      then
        Stdlib.Test.fail(
          "the reader did not show the fn's access block, so this proved nothing")
      else if Stdlib.List.isEmpty(raw) then
        Stdlib.Test.Result.Pass
      else
        let shown = Stdlib.String.join(raw, " | ")
        Stdlib.Test.fail($"raw escape codes in the item reader: {shown}")


/// Render one view's PREVIEW pane from state.
///
/// Opening a view draws its LIST; the preview is a separate function (`previewLines`) that nothing
/// reaches until something focuses it. That gap is measured, not assumed: with the Traces detail pane
/// deliberately broken, every assertion in `scripts/testing/gates workbench-views` still passed, because
/// none of them draw a preview. Focusing it through the terminal needs a third interaction, and the
/// frame diff stops being reliable past two -- so it belongs here, where rendering takes no terminal.
let rendersPreview(viewIndex: Int64): Bool =
  let base = workbenchState()
  let state = { base with activeView = viewIndex }
  // A pane reads the SELECTED item, so a view with an empty list exercises only its empty case. That is
  // still worth running (it is the case a fresh store hits), and the item page has its own test.
  let lines = Cli.Workbench.previewLines(state)
  // Any list at all, including an empty one, means it returned rather than raised. A pane that throws
  // takes this down loudly, which is the point.
  Stdlib.List.length(lines) >= 0


test workbenchPreviewsRender =
  let broken =
    Cli.Workbench.viewSpecs
    |> Stdlib.List.map(fun spec -> Stdlib.Tuple2.first(spec))
    |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(rendersPreview(i)))

  if Stdlib.List.isEmpty(broken) then
    Stdlib.Test.Result.Pass
  else
    let names =
      broken
      |> Stdlib.List.map(Stdlib.display)
      |> Stdlib.String.join(", ")

    Stdlib.Test.fail($"preview panes that drew nothing: {names}")


/// Every Matter lens draws a frame. No view has sections any more; the lenses are the one
/// remaining "same view, different list" switch, and `rendersView` only ever draws the default.
test workbenchSectionsRender =
  let brokenLenses =
    [ Cli.Workbench.Lens.WholeTree
      Cli.Workbench.Lens.ValuesOnly
      Cli.Workbench.Lens.Changed ]
    |> Stdlib.List.filter(fun l -> Stdlib.Bool.not(rendersMatterLens(l)))

  if Stdlib.List.isEmpty(brokenLenses) then
    Stdlib.Test.Result.Pass
  else
    let nl = Stdlib.display(Stdlib.List.length(brokenLenses))
    Stdlib.Test.fail($"{nl} Matter lens(es) produced no frame")


test workbenchEveryViewRenders =
  // Cheap guard for a renderer that type-checks and loads clean, then dies when the view opens.
  // Rendering is a pure function of state, so this needs no terminal. NB: a renderer that throws
  // takes the whole suite down (the harness does not catch runtime errors) -- caught either way,
  // just louder.
  let broken =
    Cli.Workbench.viewSpecs
    |> Stdlib.List.map(fun spec -> Stdlib.Tuple2.first(spec))
    |> Stdlib.List.filter(fun i -> Stdlib.Bool.not(rendersView(i)))

  if Stdlib.List.isEmpty(broken) then
    Stdlib.Test.Result.Pass
  else
    let names =
      broken
      |> Stdlib.List.map(Stdlib.display)
      |> Stdlib.String.join(", ")

    Stdlib.Test.fail($"Views produced no frame: {names}")


test workbenchDiffLinesRenderThroughPipe =
  // Dark's pipe supplies its value as the first argument. Keep this call in
  // the same shape as the Home WIP preview so argument-order regressions fail
  // here instead of when the interactive workbench opens an edit.
  let rendered =
    [ Stdlib.Diff.DiffLine.Added("let added = 1")
      Stdlib.Diff.DiffLine.Removed("let removed = 2") ]
    |> Cli.Workbench.renderDiffLines(workbenchState())

  let plain =
    rendered
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.String.join("\n")

  if
    Stdlib.List.length(rendered) == 2
    && Stdlib.String.contains(plain, "+ let added = 1")
    && Stdlib.String.contains(plain, "- let removed = 2")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected piped diff lines to render additions and removals")


test workbenchModuleInspectPreviewsChildren =
  // `LanguageTools` and its child `AtRestTypeChecker`, because the subject only has to be a
  // module under `Darklang` that itself holds a child module.
  let location = Cli.Packages.PackageLocation.Module([ "Darklang" ])
  let items = Cli.Workbench.loadItems(SCM.Branch.mainBranchId, location)
  let selected =
    Stdlib.List.findFirstIndex(items, fun item -> item.name == "LanguageTools")
    |> Stdlib.Option.withDefault(0)

  let state =
    { workbenchState() with
        activeView = Cli.Workbench.vMatter
        location = location
        items = items
        selected = selected }

  let plain =
    Cli.Workbench.previewLines(state)
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.String.join("\n")

  if
    Stdlib.String.contains(plain, "LanguageTools/")
    && Stdlib.String.contains(plain, "AtRestTypeChecker/")
    && Stdlib.String.contains(plain, "modules · ")
    && Stdlib.String.contains(plain, "enter")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected Inspect to preview a module's immediate children, grouped by kind")


/// The item page is built once per selection and drawn from `previews` after that: a scroll
/// draws the page it already has, a move to the next item builds a new one, and a move back
/// draws the first one again.
test workbenchPageBuiltOncePerSelection =
  let location =
    Cli.Packages.PackageLocation.Module([ "Darklang", "Stdlib", "List" ])

  let start = workbenchState()
  let items = Cli.Workbench.loadItems(SCM.Branch.mainBranchId, location)
  let selected =
    Stdlib.List.findFirstIndex(items, fun item -> item.name == "map")
    |> Stdlib.Option.withDefault(0)

  let onMap =
    Cli.Workbench.refresh(
      start,
      { start with
          activeView = Cli.Workbench.vMatter
          location = location
          items = items
          selected = selected })

  let planted =
    { onMap with
        previews =
          [ Cli.Workbench.PreviewCache
              { key = Cli.Workbench.previewKey(onMap)
                lines = [ "planted" ] } ] }

  let scrolled =
    Cli.Workbench.refresh(planted, { planted with detailScroll = 3 })

  let moved =
    Cli.Workbench.refresh(
      planted,
      { planted with selected = planted.selected + 1 })

  let back =
    Cli.Workbench.refresh(moved, { moved with selected = planted.selected })

  if Cli.Workbench.previewLines(scrolled) != [ "planted" ] then
    Stdlib.Test.fail(
      "a scroll rebuilt the item page instead of drawing the one it had")
  else if Cli.Workbench.previewLines(moved) == [ "planted" ] then
    Stdlib.Test.fail("moving to the next item drew the previous item's page")
  else if Cli.Workbench.previewLines(back) != [ "planted" ] then
    Stdlib.Test.fail(
      "moving back rebuilt the item page instead of drawing the one it had")
  else
    Stdlib.Test.Result.Pass


/// Saving from the workbench's editor shows the saved version on the next frame, though the
/// item list (names only) is the same before and after.
test workbenchPageFollowsYourSave =
  let start = { workbenchState() with activeView = Cli.Workbench.vMatter }
  let save(state: Cli.Workbench.State, src: String): Cli.Workbench.State =
    let editing =
      Cli.Workbench.EditingState
        { kind = "fn"
          nameStr = "answer"
          targetModule = [ "Tests", "WorkbenchPage" ]
          buf = Stdlib.Cli.UI.Editor.fromText(src)
          err = "" }

    match Cli.Workbench.saveEditing(state, editing) with
    | Continue(next) -> Cli.Workbench.refresh(state, next)
    | _ -> state

  let page(state: Cli.Workbench.State): String =
    Cli.Workbench.previewLines(state)
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.String.join("\n")

  // Fresh numbers each run: the store outlives the test, and saving a body the name has held
  // before is a revert, which is a different path.
  let n = Stdlib.Int64.random(100000, 999999)
  let before = Stdlib.display(n)
  let after = Stdlib.display(n + 1)
  let first = save(start, "let answer () : Int64 = " + before)
  let firstPage = page(first)
  let secondPage = page(save(first, "let answer () : Int64 = " + after))
  if Stdlib.Bool.not(Stdlib.String.contains(firstPage, before)) then
    Stdlib.Test.fail("the first save's page did not show it: " + firstPage)
  else if Stdlib.Bool.not(Stdlib.String.contains(secondPage, after)) then
    Stdlib.Test.fail(
      "the page went on showing the version before the save: " + secondPage)
  else
    Stdlib.Test.Result.Pass


test workbenchRunTestsAreLastInInspect =
  let location =
    Cli.Packages.PackageLocation.Module([ "Darklang", "Stdlib", "Float64" ])

  let items = Cli.Workbench.loadItems(SCM.Branch.mainBranchId, location)
  let selected =
    Stdlib.List.findFirstIndex(items, fun item -> item.name == "sqrt")
    |> Stdlib.Option.withDefault(0)

  let state =
    { workbenchState() with
        activeView = Cli.Workbench.vMatter
        location = location
        items = items
        selected = selected }

  let nonblank =
    Cli.Workbench.previewLines(state)
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.List.filter(fun line -> Stdlib.String.trim(line) != "")

  let last = Stdlib.Option.withDefault(Stdlib.List.last(nonblank), "")
  let hasWorkbenchHeading = Stdlib.List.contains(nonblank, "tests")
  let hasListingHeading = Stdlib.List.contains(nonblank, "⊢ Tests:")
  let testRows =
    nonblank
    |> Stdlib.List.filter(fun line ->
      Stdlib.String.contains(line, "Float64.Tests.sqrt"))

  if
    hasWorkbenchHeading
    && Stdlib.Bool.not(hasListingHeading)
    && Stdlib.List.length(testRows) == 1
    && Stdlib.String.contains(last, "`:test run` runs them")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected tests once in their final section with the run hint last, got '{last}'")


// ── Workbench: the nav walks ──

/// What the workbench dispatcher decided to do with a simulated keypress.
type WbAction =
  | Continued
  | Exited
  | Launched(command: String)


type WbResult =
  { state: Cli.Workbench.State
    action: WbAction }


/// One keypress through the workbench's dispatcher in a plain-view context.
/// Keep the action beside the state: encoding Exit as a fake status
/// message hid an unexpected Launch.
let wbPress(
  state: Cli.Workbench.State,
  key: Stdlib.Cli.Stdin.Key.Key,
  keyChar: Stdlib.Option.Option<String>)
  : WbResult =
  let mods =
    Stdlib.Cli.Stdin.Modifiers.Modifiers
      { alt = false, ctrl = false, shift = false }

  match Cli.Workbench.handleKey(state, key, mods, keyChar) with
  | Continue(s) -> WbResult { state = s, action = WbAction.Continued }
  | Exit(s) -> WbResult { state = s, action = WbAction.Exited }
  | Launch(s, cmd) -> WbResult { state = s, action = WbAction.Launched(cmd) }


/// A printable key.
let wbChar(state: Cli.Workbench.State, c: String): WbResult =
  wbPress(state, Stdlib.Cli.Stdin.Key.Key.NoName, Some(c))


let wbKey(state: Cli.Workbench.State, k: Stdlib.Cli.Stdin.Key.Key): WbResult =
  wbPress(state, k, None)


/// Move the nav cursor to a semantic row through the real key handler.
/// Tests care that REPL is reachable, not how many rows follow Code today.
/// The walking arrows depend on the nav's shape at the terminal size the
/// test runs under: along the strip, down the overlay.
let wbMoveNavbarTo(
  state: Cli.Workbench.State,
  matches: Cli.Workbench.NavbarRow -> Bool)
  : Cli.Workbench.State =
  let rows = Cli.Workbench.navbarRows(state, 0, 0)
  match Stdlib.List.findFirstIndex(rows, matches) with
  | None -> state
  | Some(target) ->
    let delta = target - state.navbarSel
    let steps = if delta < 0 then 0 - delta else delta
    let strip = Cli.Workbench.navFitsNow()
    let key =
      if delta < 0 then
        if strip then
          Stdlib.Cli.Stdin.Key.Key.LeftArrow
        else
          Stdlib.Cli.Stdin.Key.Key.UpArrow
      else if strip then
        Stdlib.Cli.Stdin.Key.Key.RightArrow
      else
        Stdlib.Cli.Stdin.Key.Key.DownArrow

    if steps == 0 then
      state
    else
      Stdlib.List.range(1, steps)
      |> Stdlib.List.fold(state, fun(s, _) -> (wbKey(s, key)).state)


let wbMoveNavbarToDest(
  state: Cli.Workbench.State,
  dest: Cli.Workbench.Dest)
  : Cli.Workbench.State =
  wbMoveNavbarTo(state, fun row -> row.dest == dest)


/// Is the nav cursor on the destination we expected?
let wbNavbarSelectionIsDest(
  state: Cli.Workbench.State,
  dest: Cli.Workbench.Dest)
  : Bool =
  let rows = Cli.Workbench.navbarRows(state, 0, 0)
  match Stdlib.List.getAt(rows, state.navbarSel) with
  | Some(row) -> row.dest == dest
  | None -> false


test workbenchNavbarNavigation =
  // End to end through `handleKey`: numbers jump to a view and hand the
  // keyboard to the content; esc goes back (never quits); arrows and ⏎ go to
  // a view; the nav is FLAT and no view has sections, so a number pressed
  // again stays put; a demoted view (Errors) is a key away from its parent
  // and lights the parent's item; q quits. Rendering is pure and so is this,
  // so it needs no terminal.
  let s0 = workbenchState()
  let atStart =
    s0.focus == Stdlib.Cli.UI.SplitPane.Focus.First
    && s0.activeView == Cli.Workbench.vHome

  // 2 → Code, landing on the tree with the content focused.
  let r1 = wbChar(s0, "2")
  let s1 = r1.state
  let jumped =
    r1.action == WbAction.Continued
    && s1.activeView == Cli.Workbench.vMatter
    && Stdlib.Bool.not(Cli.Workbench.navbarFocused(s1))
    && s1.focus == Stdlib.Cli.UI.SplitPane.Focus.First

  // Esc at the top of the tree → back to Home, where 2 was pressed, content focused.
  let r2 = wbKey(s1, Stdlib.Cli.Stdin.Key.Key.Escape)
  let s2 = r2.state
  let backedOut =
    r2.action == WbAction.Continued
    && s2.activeView == Cli.Workbench.vHome
    && Stdlib.Bool.not(Cli.Workbench.navbarFocused(s2))
    && Stdlib.List.isEmpty(s2.back)

  // ` takes the nav, with the cursor on where you are.
  let s2n = (wbChar(s2, "`")).state
  let navTaken =
    Cli.Workbench.navbarFocused(s2n)
    && wbNavbarSelectionIsDest(
      s2n,
      Cli.Workbench.mkDest(Cli.Workbench.vHome, 0))

  let atRepl =
    wbMoveNavbarToDest(s2n, Cli.Workbench.mkDest(Cli.Workbench.vScratch, 0))

  let r3 = wbKey(atRepl, Stdlib.Cli.Stdin.Key.Key.Enter)
  let s3 = r3.state
  let toRepl =
    r3.action == WbAction.Continued
    && s3.activeView == Cli.Workbench.vScratch
    && Stdlib.Bool.not(Cli.Workbench.navbarFocused(s3))
    && s3.input == None

  // The nav is one row per view: nothing under Changes, whichever section it is on.
  let rows = Cli.Workbench.navbarRows(s3, 0, 0)
  let flat =
    Stdlib.Bool.not(Stdlib.List.any(rows, fun r -> r.label == "History"))
    && Stdlib.List.length(rows)
       == Stdlib.List.length(
         Cli.Workbench.visibleWorkspacesIn(Cli.Workbench.visibleViews(s3)))

  // ⏎ on Changes goes there and takes the content: there is nothing to expand.
  let s4 = (wbChar(s3, "`")).state
  let atChanges =
    wbMoveNavbarToDest(s4, Cli.Workbench.mkDest(Cli.Workbench.vSCM, 0))

  let s5 = (wbKey(atChanges, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let entered =
    s5.activeView == Cli.Workbench.vSCM
    && Stdlib.Bool.not(Cli.Workbench.navbarFocused(s5))

  // `3` again stays: there is nothing under Changes to step to.
  let s6 = (wbChar(s5, "3")).state
  let cycled = s6.activeView == Cli.Workbench.vSCM && s6.items == s5.items
  let s6b = (wbChar(s6, "]")).state
  let s6c = (wbChar(s6b, "[")).state
  let stepped =
    s6b.activeView == Cli.Workbench.vSCM && s6c.activeView == Cli.Workbench.vSCM

  // Leaving and coming back by number returns to the view.
  let s7 = (wbChar((wbChar(s6c, "2")).state, "3")).state
  let remembered = s7.activeView == Cli.Workbench.vSCM
  // Errors has no nav row: `E` from Traces opens it, Traces stays lit, `5` comes back.
  let errors = Cli.Workbench.extViewIndex("errors")
  let s8 = (wbChar((wbChar(s7, "5")).state, "E")).state
  let tracesRow =
    Stdlib.List.findFirstIndex(Cli.Workbench.navbarRows(s8, 0, 0), fun r ->
      r.label == "Traces")
    |> Stdlib.Option.withDefault(0 - 1)

  let errorsCovered =
    s8.activeView == errors
    && Cli.Workbench.activeRow(s8, Cli.Workbench.navbarRows(s8, 0, 0))
       == tracesRow
    && (wbChar(s8, "5")).state.activeView == Cli.Workbench.vTraces

  // Assert q's action directly instead of smuggling it through `message`.
  let r9 = wbChar(s7, "q")
  let quits = r9.action == WbAction.Exited
  let checks =
    [ (atStart, "starts on Home with the list focused")
      (jumped, "2 jumps to Code and focuses the content")
      (backedOut, "esc goes back to Home, content focused")
      (navTaken, "` hands the keyboard to the nav, cursor on where you are")
      (toRepl, "arrowing to REPL then pressing ⏎ opens it, prompt closed")
      (flat, "the nav has one row per view and none for a section")
      (entered, "⏎ on Changes opens it and takes the content")
      (cycled, "3 again stays on Changes")
      (stepped, "] and [ do nothing: no view has sections")
      (remembered, "a view's number key returns to it")
      (errorsCovered, "E opens Errors from Traces, Traces stays lit, 6 returns")
      (quits, "q quits") ]

  let failed =
    checks
    |> Stdlib.List.filter(fun c ->
      let (ok, _l) = c
      Stdlib.Bool.not(ok))
    |> Stdlib.List.map(fun c ->
      let (_ok, l) = c
      l)

  if Stdlib.List.isEmpty(failed) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"Navigation broke: {Stdlib.String.join(failed, "; ")}")


// ── REPL session bindings ──
// Typed at the prompt, the way a person does: `let` binds, and the next line sees it.
test replLetBindsWhenTyped =
  let typeLine(st: Cli.Workbench.State, line: String): Cli.Workbench.State =
    let typed =
      Stdlib.String.toList(line)
      |> Stdlib.List.fold(st, fun(acc, c) ->
        (wbChar(acc, Stdlib.String.fromChar(c))).state)

    (wbKey(typed, Stdlib.Cli.Stdin.Key.Key.Enter)).state

  let atRepl = (wbChar(workbenchState(), "4")).state
  let prompt = (wbKey(atRepl, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let bound = typeLine(prompt, "let x = 5")
  let used = typeLine(bound, "x + 1")
  Stdlib.Test.all(
    [ bound.repl.bindings
      |> Stdlib.List.map(fun b -> (b.name, b.value, b.captured))
      |> Stdlib.Test.equal([ ("x", "5", true) ])

      used.repl.last |> Stdlib.Test.equal("6") ])


test workbenchCapturesStrayOutput =
  // The workbench owns the whole screen, so anything a command prints scrolls the alternate screen and every
  // frame after it lands that many rows off, which reads as two overlapping copies of the Stdlib.Cli.UI. It's easy to
  // hit: eval can print a call stack when a function fails. `captureOutputAnd` returns the value AND the output, so a caller gets the result without
  // letting the print through.
  let (value, out) = Cli.Workbench.captureOutputAnd(fun () ->
    Stdlib.printLine("this must not reach the terminal")
    41 + 1)

  if value == 42 && Stdlib.String.contains(out, "must not reach") then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected 42 and the captured line, got {Stdlib.display(value)} / '{out}'")


/// Does rendering view `viewIndex` put `marker` on the screen?
let viewShows(viewIndex: Int64, marker: String): Bool =
  let state =
    Cli.Workbench.focusNavbar({ workbenchState() with activeView = viewIndex })

  let view =
    Cli.Workbench.viewAtSize(
      state,
      Stdlib.Cli.Tui.Size { width = 160, height = 40 })

  view.rows
  |> Stdlib.List.any(fun r ->
    Stdlib.String.contains(Stdlib.Cli.Tui.Text.stripSgr(r), marker))


/// `viewShows`, with the CONTENT holding the keyboard: the footer then carries the
/// view's own hints rather than the nav's.
let contentShows(viewIndex: Int64, marker: String): Bool =
  let state =
    Cli.Workbench.focusContent({ workbenchState() with activeView = viewIndex })

  let view =
    Cli.Workbench.viewAtSize(
      state,
      Stdlib.Cli.Tui.Size { width = 160, height = 40 })

  view.rows
  |> Stdlib.List.any(fun r ->
    Stdlib.String.contains(Stdlib.Cli.Tui.Text.stripSgr(r), marker))


test workbenchViewsShowTheirChrome =
  // `workbenchEveryViewRenders` only asks whether a view drew *anything*,
  // which is why it once stayed green while two header bands rendered blank
  // (helpers that return spans, results discarded with `let _ =`). So: assert
  // on content a band actually contributes - a pane title, and the nav
  // rows above it.
  let checks =
    // Markers have to be unique to the band: something the context row
    // doesn't say. `2 Code` and `6 Traces` are numbered items on the strip,
    // which nothing else draws.
    [ (Cli.Workbench.vSCM, "3 Changes", "nav: Changes is one numbered item")
      (
        Cli.Workbench.vTraces,
        "5 Traces",
        "nav: Traces is its own item, not Activity")

      (Cli.Workbench.vScratch, "to type", "REPL title row")
      (Cli.Workbench.vMatter, "packages", "Code's root breadcrumb")
      (Cli.Workbench.vHome, "recent commits", "Home's recent work")
      (Cli.Workbench.vHome, "2 Code", "nav: a numbered workspace") ]

  // With the content focused, the footer is the view's: Changes advertises commit, and Home the
  // branch verbs it took over from the old Branches section.
  let contentChecks =
    [ (Cli.Workbench.vSCM, "commit", "footer: Changes offers commit")
      (Cli.Workbench.vHome, "merge", "footer: Home offers the branch verbs") ]

  let missing =
    Stdlib.List.concat(
      checks
      |> Stdlib.List.filter(fun c ->
        let (v, marker, _label) = c
        Stdlib.Bool.not(viewShows(v, marker)))
      |> Stdlib.List.map(fun c ->
        let (_v, _m, label) = c
        label),
      contentChecks
      |> Stdlib.List.filter(fun c ->
        let (v, marker, _label) = c
        Stdlib.Bool.not(contentShows(v, marker)))
      |> Stdlib.List.map(fun c ->
        let (_v, _m, label) = c
        label))

  if Stdlib.List.isEmpty(missing) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Missing from the rendered frame: {Stdlib.String.join(missing, ", ")}")


/// Home has no hidden inspector, and even a wide terminal gets one nav row.
test workbenchHomeOverview =
  let base = workbenchState()
  let longTitle = Stdlib.String.repeat("界", 30)
  let state =
    { base with
        items =
          [ Cli.Workbench.homeHeader("recent commits")
            Cli.Workbench.BodyItem
              { name = longTitle
                kind = "home-commit"
                isModule = false
                desc = "Alex · yesterday" } ]
        selected = 1 }

  let plain =
    (Cli.Workbench.viewAtSize(
       state,
       Stdlib.Cli.Tui.Size { width = 120, height = 24 })).rows
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.String.join("\n")

  let narrow =
    (Cli.Workbench.viewAtSize(
       state,
       Stdlib.Cli.Tui.Size { width = 80, height = 24 })).rows
    |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)
    |> Stdlib.String.join("\n")

  let right = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.RightArrow)).state
  let tab = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Tab)).state
  let back = (wbKey(tab, Stdlib.Cli.Stdin.Key.Key.Tab)).state
  let scm =
    Cli.Workbench.focusNavbar({ state with activeView = Cli.Workbench.vSCM })

  let nav =
    Cli.Workbench.renderNavStrip(
      scm,
      0,
      0,
      Stdlib.Cli.UI.Layout.Region { top = 1, left = 1, rows = 4, cols = 120 })

  let labels =
    nav
    |> Stdlib.List.map(fun span -> span.text)
    |> Stdlib.String.join(" ")

  let opened(kind: String): Cli.Workbench.State =
    let summary =
      { state with
          items =
            [ Cli.Workbench.BodyItem
                { name = "summary", kind = kind, isModule = false, desc = "" } ]
          selected = 0 }

    (wbKey(summary, Stdlib.Cli.Stdin.Key.Key.Enter)).state

  let openSummary(kind: String): Cli.Workbench.Dest =
    Cli.Workbench.activeDest(opened(kind))

  let opensReader(kind: String): Bool =
    match (opened(kind)).reading with
    | Some(_) -> true
    | None -> false

  let checks =
    [ (
        Stdlib.String.contains(plain, longTitle),
        "Home uses the full width for a commit")

      (
        Stdlib.String.contains(plain, "Alex · yesterday"),
        "commit metadata remains visible")

      (
        Stdlib.Bool.not(Stdlib.String.contains(plain, "Welcome")),
        "no welcome inspector")

      (
        Stdlib.Bool.not(Stdlib.String.contains(narrow, "⏎ go · esc")),
        "no startup menu overlay")

      (
        right.focus == Stdlib.Cli.UI.SplitPane.Focus.First,
        "right cannot focus a hidden pane")

      (Cli.Workbench.navbarFocused(tab), "tab opens navigation")
      (
        back.focus == Stdlib.Cli.UI.SplitPane.Focus.First,
        "tab returns to the list")

      (
        Stdlib.List.all(nav, fun span -> span.row == 0),
        "navigation uses one row")

      (
        Stdlib.Bool.not(Stdlib.String.contains(labels, "History")),
        "the nav has no row for a section")

      (
        (wbChar(scm, "3")).state.activeView == Cli.Workbench.vSCM,
        "3 again stays on Changes")

      (
        opensReader("home-more-commits"),
        "more commits opens the commit list in the reader")

      (
        openSummary("home-conflicts")
        == Cli.Workbench.mkDest(Cli.Workbench.vSCM, 0),
        "the conflict summary opens Changes, where the conflicts are") ]

  let failures =
    checks
    |> Stdlib.List.filterMap(fun check ->
      let (ok, label) = check
      if ok then None else Some(label))

  if Stdlib.List.isEmpty(failures) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(Stdlib.String.join(failures, "; "))


// ── Navigation regressions that need real key dispatch and populated views ──
// A move with History.Record leaves a way back and one with History.Skip (back's own) does
// not; the reader highlights what it is given only for Reader.Code.
test workbenchNavigationEnums =
  let base = workbenchState()
  let point =
    { Cli.Workbench.returnPointOf(base) with view = Cli.Workbench.vMatter }

  let recorded =
    Cli.Workbench.moveToPoint(base, point, Cli.Workbench.History.Record)

  let skipped =
    Cli.Workbench.moveToPoint(base, point, Cli.Workbench.History.Skip)

  let code =
    match Cli.Workbench.openReader(base, "x", Cli.Workbench.Reader.Code) with
    | Continue(s) -> Some(s.readingIsCode)
    | _ -> None

  let prose =
    match Cli.Workbench.openReader(base, "x", Cli.Workbench.Reader.Prose) with
    | Continue(s) -> Some(s.readingIsCode)
    | _ -> None

  Stdlib.Test.all(
    [ Stdlib.List.length(recorded.back) |> Stdlib.Test.equal(1)
      Stdlib.List.length(skipped.back) |> Stdlib.Test.equal(0)
      recorded.activeView |> Stdlib.Test.equal(Cli.Workbench.vMatter)
      skipped.activeView |> Stdlib.Test.equal(Cli.Workbench.vMatter)
      code |> Stdlib.Test.equal(Some(true))
      prose |> Stdlib.Test.equal(Some(false)) ])


test workbenchHistoryRoundTrip =
  let base = workbenchState()
  let hit =
    Cli.Workbench.SearchHit
      { modules = [ "Darklang", "Stdlib", "List" ]
        name = "map"
        kind = "fn"
        display = "map" }

  let jumped =
    match Cli.Workbench.jumpToHit(base, hit) with
    | Continue(s) -> s
    | _ -> base

  let returned = (wbKey(jumped, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let tree = (wbChar(base, "2")).state
  let original =
    { tree with
        filter = "Darklang"
        selected = 0
        items = Cli.Workbench.applyFilter(tree.items, "Darklang") }

  let entered = (wbKey(original, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let parent = (wbKey(entered, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let lens = (wbChar(tree, "L")).state
  let beforeLens = (wbKey(lens, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let sameReturnPoint(a: Cli.Workbench.State, b: Cli.Workbench.State): Bool =
    Cli.Workbench.returnPointOf(a) == Cli.Workbench.returnPointOf(b)

  if
    Stdlib.List.length(jumped.back) == 1
    && sameReturnPoint(returned, base)
    && Stdlib.List.isEmpty(returned.back)
    && entered.location != original.location
    && sameReturnPoint(parent, original)
    && parent.items == original.items
    && lens.matter.lens != tree.matter.lens
    && sameReturnPoint(beforeLens, tree)
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("search, modules and lenses must return in one Escape")


test workbenchBranchPicker =
  let base = workbenchState()
  let opened = (wbChar(base, "S")).state
  let opens =
    match opened.overlay with
    | Branches(_) -> true
    | _ -> false

  let choices =
    Stdlib.List.range(1, 20)
    |> Stdlib.List.map(fun n ->
      Cli.Workbench.BranchChoice
        { id = SCM.Branch.mainBranchId
          name = "branch-" + Stdlib.display(n)
          detail = "" })

  let picker =
    Cli.Workbench.BranchPicker
      { choices = choices
        field = Stdlib.Cli.UI.TextField.fromText("")
        selected = 0 }

  let state = { base with overlay = Cli.Workbench.Overlay.Branches(picker) }
  let paged = (wbKey(state, Stdlib.Cli.Stdin.Key.Key.PageDown)).state
  let typed = (wbChar(paged, "BRANCH-20")).state
  let matched =
    match typed.overlay with
    | Branches(p) ->
      let names =
        Cli.Workbench.matchingBranches(p) |> Stdlib.List.map(fun b -> b.name)

      p.selected == 0 && names == [ "branch-20" ]
    | _ -> false

  let missing = (wbChar(typed, "zzz")).state
  let enter = (wbKey(missing, Stdlib.Cli.Stdin.Key.Key.Enter)).state
  let noMatch =
    match enter.overlay with
    | Branches(p) -> Stdlib.List.isEmpty(Cli.Workbench.matchingBranches(p))
    | _ -> false

  let cancelled = (wbKey(typed, Stdlib.Cli.Stdin.Key.Key.Escape)).state
  let fromCode = (wbChar((wbChar(base, "2")).state, "S")).state
  let fromHome = (wbChar(base, "s")).state
  let isOpen(s: Cli.Workbench.State): Bool =
    match s.overlay with
    | Branches(_) -> true
    | _ -> false

  if
    opens
    && matched
    && noMatch
    && isOpen(fromCode)
    && isOpen(fromHome)
    && cancelled.overlay == Cli.Workbench.Overlay.NoOverlay
    && cancelled.branchId == base.branchId
    && cancelled.items == base.items
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "picker must filter all branches, cancel and reject no matches")


// A first run lands on Home. While nothing is in progress, Home ends with where to begin, and
// each of those rows opens the view it names.
test workbenchHomeSaysWhereToBegin =
  let start = Cli.Workbench.homeStartRows(true, 0, 0, 0)
  let kinds = start |> Stdlib.List.map(fun item -> item.kind)
  let gone =
    [ Cli.Workbench.homeStartRows(false, 0, 0, 0)
      Cli.Workbench.homeStartRows(true, 1, 0, 0)
      Cli.Workbench.homeStartRows(true, 0, 1, 0)
      Cli.Workbench.homeStartRows(true, 0, 0, 1) ]
    |> Stdlib.List.all(fun rows -> Stdlib.List.isEmpty(rows))

  let base = workbenchState()
  let opens(index: Int64): Int64 =
    let state = { base with items = start, selected = index }
    (wbKey(state, Stdlib.Cli.Stdin.Key.Key.Enter)).state.activeView

  if
    kinds == [ "home-start-repl", "home-start-code", "home-start-docs" ]
    && gone
    && opens(0) == Cli.Workbench.vScratch
    && opens(1) == Cli.Workbench.vMatter
    && opens(2) == Cli.Workbench.vDocs
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Home must say where to begin while nothing is in progress, and open each view")


// ── Workbench: the frame at any size ──

/// A workbench on main with its SCM status read, the way it opens.
let openedState(instance: String): Cli.Workbench.State =
  let st =
    Cli.Workbench.initialState(
      SCM.Branch.mainBranchId,
      None,
      instance,
      Cli.Workbench.Updates.Manual)

  Cli.Workbench.refreshScmStatus(st, st)


/// The SCM view with its items loaded.
let scmViewState(instance: String): Cli.Workbench.State =
  let s = { openedState(instance) with activeView = Cli.Workbench.vSCM }
  { s with items = Cli.Workbench.reloadItems(s) }


/// One frame of <param state> at <param width> by <param height>, styling stripped.
let frameAt(
  state: Cli.Workbench.State,
  width: Int64,
  height: Int64)
  : List<String> =
  (Cli.Workbench.viewAtSize(
     state,
     Stdlib.Cli.Tui.Size { width = width, height = height })).rows
  |> Stdlib.List.map(Stdlib.Cli.Tui.Text.stripSgr)


/// The key-hint row drops whole hints cheapest-first: secondary globals, then the view's own
/// actions, and `?` (help) and `esc/q` (quit) never. Clipping from the right lost exactly those two.
test hintRowDropsSecondaryKeysBeforeHelpAndQuit =
  let s = scmViewState("i")
  // Tall enough that the hint row is always in frame: a clean tree renders a roomier panel.
  let shown(width: Int64): String =
    Stdlib.String.join(frameAt(s, width, 26), "\n")

  let wide = shown(168)
  let narrow = shown(72)
  let tiny = shown(56)
  Stdlib.Test.all(
    [ Instance.says(wide, "views", "the full row has the secondary keys too")

      Instance.says(narrow, "help", "the keymap key survives")

      Instance.says(narrow, "quit", "and so does the way out")

      Instance.says(
        narrow,
        "move",
        "the pane's own actions outlive the globals")

      Instance.doesNotSay(narrow, "views", "a secondary global gave way first")
      Instance.says(tiny, "help", "narrower still, help survives")
      Instance.says(tiny, "quit", "and the way out") ])


/// The header drops whole segments, the instance first, so the branch survives a narrow terminal
/// rather than the right-aligned glance writing over it.
test headerDropsTheInstanceBeforeTheBranch =
  let name = "inst-with-a-deliberately-long-name-for-this-test"
  let s = scmViewState(name)
  let header(width: Int64): String =
    frameAt(s, width, 4)
    |> Stdlib.List.head
    |> Stdlib.Option.withDefault("")

  let wide = header(150)
  // Two columns under what the instance and the branch need; under about 50 the too-small guard
  // draws nothing, which would pass for the wrong reason.
  let narrow = header(56)
  Stdlib.Test.all(
    [ Instance.says(wide, name, "the full row shows the instance")
      Instance.says(wide, "main", "and the branch")
      Instance.doesNotSay(
        narrow,
        "inst-with-a-deliberately",
        "the instance gives way")

      Instance.says(narrow, "main", "and the branch survives") ])


/// The header names the branch in Home, Matter and SCM, and the instance you are on.
test workbenchHeaderNamesTheBranchInEveryView =
  let s = openedState("test-instance")
  let header(view: Int64): String =
    frameAt({ s with activeView = view }, 120, 40)
    |> Stdlib.List.head
    |> Stdlib.Option.withDefault("")

  Stdlib.Test.all(
    [ Instance.says(header(0), "main", "Home names the branch")
      Instance.says(header(1), "main", "so does Matter")
      Instance.says(header(4), "main", "and SCM")
      Instance.says(header(0), "test-instance", "and the instance") ])


/// 56x12 is the documented floor: at it a real frame, below it a message to resize. Both fill
/// the space they were given.
test workbenchFramesATinyTerminal =
  let s = openedState("test-instance")
  let tooSmall = frameAt(s, 40, 10)
  Stdlib.Test.all(
    [ Stdlib.Test.equal(Stdlib.List.length(frameAt(s, 56, 12)), 12)
      Stdlib.Test.equal(Stdlib.List.length(tooSmall), 10)
      Instance.says(
        Stdlib.String.join(tooSmall, "|"),
        "too small",
        "below the floor the frame says to resize") ])


/// No row is wider than its frame, in any view, with wide glyphs in a name and a commit message.
/// Widths are terminal columns: a row past the last one wraps and shifts every row under it.
test noWorkbenchRowOverflowsItsFrame = Instance.withInstance(fun i ->
  let overflowing(width: Int64): String =
    let code =
      "let st = Darklang.Cli.Workbench.initialState(Darklang.SCM.Branch.mainBranchId, Stdlib.Option.Option.None, \"i\", Darklang.Cli.Workbench.Updates.Manual) in\n"
      + "let s = Darklang.Cli.Workbench.refreshScmStatus(st, st) in\n"
      + $"let over = fun v -> (Darklang.Cli.Workbench.viewAtSize({{ s with activeView = v }}, Darklang.Stdlib.Cli.Tui.Size {{ width = {Stdlib.display(width)}, height = 24 }})).rows |> Stdlib.List.filter(fun r -> Darklang.Stdlib.Cli.Tui.Text.styledWidth(r) > {Stdlib.display(width)}) |> Stdlib.List.length in\n"
      + "[ over(0), over(1), over(3), over(4), over(6), over(7), over(8), over(9) ]"

    Instance.output(i, [ "eval", code ])

  Stdlib.Test.all(
    [ Instance.expectExit(i, [ "fn", "Tests.Wide.世界", "() : Int64 = 1" ], 0)
      Instance.expectExit(i, [ "commit", "コミット 🎉 wide", "-y" ], 0)
      Stdlib.Test.equal(overflowing(56), "[0, 0, 0, 0, 0, 0, 0, 0]")
      Stdlib.Test.equal(overflowing(80), "[0, 0, 0, 0, 0, 0, 0, 0]")
      Stdlib.Test.equal(overflowing(120), "[0, 0, 0, 0, 0, 0, 0, 0]") ]))


// ── Workbench: actions and edits ──

/// The footer an input action leaves, as the workbench would show it.
let inputActionSays(
  state: Cli.Workbench.State,
  action: String,
  text: String)
  : String =
  let input =
    Cli.Workbench.InputState
      { prompt = "p"
        field = Stdlib.Cli.UI.TextField.fromText(text)
        action = action }

  match Cli.Workbench.performInputAction(state, input) with
  | Continue(next) -> next.message
  | _ -> "(exit)"


/// Starting and switching to a branch work. Merge and rebase on main refuse and name main as the
/// reason: a rebase on main rewrites nothing, so a success message would be a no-op you believe.
test workbenchBranchActionsAndTheirRefusalsOnMain =
  let s = { openedState("t") with activeView = Cli.Workbench.vSCM }
  let rebased = inputActionSays(s, "rebase", "y")
  Stdlib.Test.all(
    [ Instance.says(
        inputActionSays(s, "branch-create", "wbTestBranch"),
        "on branch wbTestBranch",
        "starting a branch lands you on it")

      Instance.says(
        inputActionSays(s, "branch-switch", "wbTestBranch"),
        "switched to",
        "and it can be switched to")

      Instance.says(
        inputActionSays(s, "merge", "y"),
        "main is the trunk",
        "merge on main names the gate")

      Instance.says(rebased, "main is the trunk", "and so does rebase")
      Instance.doesNotSay(
        rebased,
        "rebased onto parent",
        "without claiming it ran") ])


/// A refusal is marked as one in the footer, not with a success tick. The mark used to be picked by
/// substring, so each of these went out behind a green tick.
test workbenchMarksARefusalAsARefusal =
  let s = { openedState("i") with activeView = Cli.Workbench.vMatter }
  let kindOf(step: Cli.Workbench.Step): String =
    match step with
    | Continue(next) ->
      let kind =
        match next.messageKind with
        | Succeeded -> "Succeeded"
        | Refused -> "Refused"
        | Failed -> "Failed"

      next.message + " => " + kind
    | _ -> "(no state)"

  let input(action: String, text: String): Cli.Workbench.InputState =
    Cli.Workbench.InputState
      { prompt = ""
        field = Stdlib.Cli.UI.TextField.fromText(text)
        action = action }

  [ (
      kindOf(Cli.Workbench.performInputAction(s, input("author-fn", " "))),
      "need an owner")

    (
      kindOf(
        Cli.Workbench.performInputAction(
          s,
          input("search", "zzzWbNothingIsCalledThis"))),
      "no matches for")

    (kindOf(Cli.Workbench.resolveConflict(s, "ok")), "no conflict selected") ]
  |> Stdlib.Test.table(fun row ->
    let (said, meant) = row
    Stdlib.Test.all(
      [ Instance.says(said, meant, "the message is the one meant")
        Instance.says(said, "=> Refused", "and it is marked as a refusal") ]))


/// A Dark string literal holding <param s>, for code passed to `dark eval`.
let darkLiteral(s: String): String =
  let escaped =
    s
    |> Stdlib.String.replaceAll("\\", "\\\\")
    |> Stdlib.String.replaceAll("\"", "\\\"")
    |> Stdlib.String.replaceAll("\n", "\\n")

  "\"" + escaped + "\""


let modulePathLiteral(modules: List<String>): String =
  modules
  |> Stdlib.List.map(darkLiteral)
  |> Stdlib.String.join(", ")


/// A workbench on main, in Matter at <param modules>, as code for `dark eval`.
let matterAtCode(modules: List<String>): String =
  "let st0 = Darklang.Cli.Workbench.initialState(Darklang.SCM.Branch.mainBranchId, Stdlib.Option.Option.None, \"i\", Darklang.Cli.Workbench.Updates.Manual) in\n"
  + $"let st = {{ st0 with activeView = Darklang.Cli.Workbench.vMatter, location = Darklang.Cli.Packages.PackageLocation.Module([ {modulePathLiteral(modules)} ]) }} in\n"


/// Run workbench code in <param i>. The workbench is the CLI's own command, so its saves may
/// write packages, which `dark eval` code gets only once the instance allows it.
let workbenchIn(i: Instance.T, code: String): String =
  let _ = Instance.run(i, [ "permissions", "allow", "package-write" ])
  Instance.output(i, [ "eval", code ])


/// Open <param item> in <param modules> in the workbench's editor, replace <param find> with
/// <param replace> in what it prefilled, and save. Answers the footer, or why it did not save.
let editInWorkbench(
  i: Instance.T,
  modules: List<String>,
  item: String,
  find: String,
  replace: String)
  : String =
  workbenchIn(
    i,
    matterAtCode(modules)
    + "let items = Darklang.Cli.Workbench.reloadItems(st) in\n"
    + $"match Stdlib.List.findFirst(items, fun i -> i.name == {darkLiteral(item)}) with\n"
    + "| None -> \"no item to edit\"\n"
    + "| Some(item) ->\n"
    + "  match Darklang.Cli.Workbench.openEditExisting(st, item) with\n"
    + "  | Continue(opened) ->\n"
    + "    match opened.editing with\n"
    + "    | None -> \"did not open: \" + opened.message\n"
    + "    | Some(es) ->\n"
    + $"      let edited = Stdlib.String.replaceAll(Stdlib.Cli.UI.Editor.toText(es.buf), {darkLiteral(find)}, {darkLiteral(replace)}) in\n"
    + "      match Darklang.Cli.Workbench.saveEditing(opened, { es with buf = Stdlib.Cli.UI.Editor.fromText(edited) }) with\n"
    + "      | Continue(saved) ->\n"
    + "        match saved.editing with\n"
    + "        | Some(still) -> \"save refused: \" + still.err\n"
    + "        | None -> \"footer: \" + saved.message\n"
    + "      | _ -> \"save did not continue\"\n"
    + "  | _ -> \"open did not continue\"")


/// Write a new <param kind> in the workbench, as `n`/`t`/`v`/`T`/`I` does: open the editor in
/// Matter at <param location>, saving into <param into>, put <param source> in it, and save.
/// Answers the footer, the module the view ended at and the selected row, or why it did not save.
let newInWorkbench(
  i: Instance.T,
  location: List<String>,
  kind: String,
  into: List<String>,
  source: String)
  : String =
  workbenchIn(
    i,
    matterAtCode(location)
    + $"match Darklang.Cli.Workbench.openNewEditor(st, {darkLiteral(kind)}, [ {modulePathLiteral(into)} ]) with\n"
    + "| Continue(opened) ->\n"
    + "  match opened.editing with\n"
    + "  | None -> \"did not open: \" + opened.message\n"
    + "  | Some(es) ->\n"
    + $"    match Darklang.Cli.Workbench.saveEditing(opened, {{ es with buf = Stdlib.Cli.UI.Editor.fromText({darkLiteral(source)}) }}) with\n"
    + "    | Continue(saved) ->\n"
    + "      match saved.editing with\n"
    + "      | Some(still) -> \"save refused: \" + still.err\n"
    + "      | None ->\n"
    + "        let on = (Stdlib.List.getAt(saved.items, saved.selected)) |> Stdlib.Option.map(fun i -> i.name) |> Stdlib.Option.withDefault(\"\") in\n"
    + "        \"footer: \" + saved.message + \" | at: \" + (Stdlib.String.join(Darklang.Cli.Packages.modulePathOf(saved.location), \".\")) + \" | on: \" + on\n"
    + "    | _ -> \"save did not continue\"\n"
    + "| _ -> \"open did not continue\"")


/// `dark <args>` in <param i> must succeed.
let setUp(i: Instance.T, args: List<String>): Stdlib.Test.Result =
  Instance.expectExit(i, args, 0)


/// The workbench's refusals say what is wrong, as the CLI's do.
test workbenchRefusalsNameTheProblem = Instance.withInstance(fun i ->
  let unresolved =
    newInWorkbench(
      i,
      [ "Tests", "WbRefuse" ],
      "fn",
      [ "Tests", "WbRefuse" ],
      "let wbQ(x: Int64): Int64 = Nope.wbZzz(x)")

  let noTrait =
    newInWorkbench(
      i,
      [ "Tests", "WbRefuse" ],
      "impl",
      [ "Tests", "WbRefuse" ],
      "impl WbNoSuchTrait for Int64 =\n  let m(x: Int64): String = \"\"")

  Stdlib.Test.all(
    [ Instance.says(unresolved, "save refused", "an unresolved name refuses")

      Instance.says(unresolved, "Nope.wbZzz", "and names the name")

      Instance.says(
        noTrait,
        "save refused",
        "an impl of a missing trait refuses")

      Instance.says(
        noTrait,
        "no trait called WbNoSuchTrait",
        "and says it is the trait that is missing") ]))


/// An implementation written in a module named for its type lands on `<module>.<Trait>`, where a
/// trait declared in that module already is. One name holds one item, so it is refused, as
/// `dark impl` refuses it, and the trait keeps its name.
test workbenchRefusesAnImplementationOverATraitsName =
  Instance.withInstance(fun i ->
    let setup =
      [ setUp(i, [ "type", "/Tests.WbPt.WbPt", "{ wbPtMark: Int64 }" ])

        setUp(
          i,
          [ "trait", "/Tests.WbPt.WbSh", "<'a> = let sh(v: 'a): String" ]) ]

    let answer =
      newInWorkbench(
        i,
        [ "Tests", "WbPt" ],
        "impl",
        [ "Tests", "WbPt" ],
        "impl WbSh for WbPt =\n  let sh(p: WbPt): String = \"p\"")

    Stdlib.Test.all(
      Stdlib.List.concat(
        setup,
        [ Instance.says(answer, "save refused", "the save is refused")

          Instance.says(
            answer,
            "already called Tests.WbPt.WbSh",
            "naming the name that is taken")

          Instance.says(
            Instance.output(i, [ "view", "Tests.WbPt.WbSh" ]),
            "trait",
            "and the trait is still there under its name") ])))


/// A save that changes nothing says so, and a new item is where the view lands.
test workbenchSaysUnchangedAndLandsOnWhatItSaved =
  Instance.withInstance(fun i ->
    let setup =
      setUp(i, [ "fn", "/Tests.WbSame.same", "(x: Int64) : Int64 = x + 7311" ])

    let same =
      editInWorkbench(i, [ "Tests", "WbSame" ], "same", "x + 7311", "x + 7311")

    let landed =
      newInWorkbench(
        i,
        [ "Tests" ],
        "fn",
        [ "Tests", "WbLand" ],
        "let landedHere(x: Int64): Int64 = x")

    Stdlib.Test.all(
      [ setup
        Instance.says(same, "unchanged", "an edit that changes nothing says so")

        Instance.says(
          landed,
          "at: Tests.WbLand",
          "the view moves to the module saved into")

        Instance.says(
          landed,
          "on: landedHere",
          "with the new item selected") ]))


/// A doc comment written above a declaration documents it. The save took the name from the
/// editor's first line, so `/// Adds a number` above `let docme` made a fn called `Adds`.
test workbenchDocCommentDocumentsTheItemItSitsOn =
  Instance.withInstance(fun i ->
    let setup =
      setUp(i, [ "fn", "/Tests.WbDoc.docme", "(x: Int64) : Int64 = x + 9137" ])

    let saved =
      editInWorkbench(
        i,
        [ "Tests", "WbDoc" ],
        "docme",
        "let docme",
        "/// Adds a number nobody else uses.\nlet docme")

    Stdlib.Test.all(
      [ setup
        Instance.says(saved, "saved docme", "the save is of docme")

        Instance.says(
          Instance.output(i, [ "view", "Tests.WbDoc.docme" ]),
          "nobody else uses",
          "and docme carries the doc")

        Instance.doesNotSay(
          Instance.said(i, [ "view", "Tests.WbDoc.Adds" ]),
          "9137",
          "no item was made from the doc's first word") ]))


/// Editing an implementation updates it in place. The save took the impl's location from the
/// trait's qualified name, so the edit landed as a rival beside the original.
test workbenchImplementationEditLeavesExactlyOne =
  Instance.withInstance(fun i ->
    let setup =
      [ setUp(
          i,
          [ "type", "/Tests.WbImplEdit.Box", "{ wbImplEditMark: Int64 }" ])

        setUp(
          i,
          [ "trait"
            "/Tests.WbImplEdit.WbShout"
            "<'a> = let shout(v: 'a): String" ])

        setUp(
          i,
          [ "impl"
            "/Tests.WbImplEdit"
            "WbShout for Box = let shout(b: Box): String = \"box\"" ]) ]

    let saved =
      editInWorkbench(
        i,
        [ "Tests", "WbImplEdit", "Box" ],
        "WbShout",
        "\"box\"",
        "\"box2\"")

    let impls = Instance.output(i, [ "impls", "Tests.WbImplEdit.WbShout" ])
    let boxRows =
      impls
      |> Stdlib.String.split("\n")
      |> Stdlib.List.filter(fun l ->
        Stdlib.String.contains(l, "Tests.WbImplEdit.Box"))
      |> Stdlib.List.length

    Stdlib.Test.all(
      Stdlib.List.concat(
        setup,
        [ Instance.says(saved, "footer: saved", "the edit saved")
          Stdlib.Test.expect(
            boxRows == 1,
            $"one implementation after the edit, not a rival beside it: {impls}")

          Instance.doesNotSay(
            impls,
            "not used",
            "nothing left behind is unused")

          Instance.says(
            Instance.output(
              i,
              [ "eval"
                "Tests.WbImplEdit.WbShout.shout(Tests.WbImplEdit.Box { wbImplEditMark = 1 })" ]),
            "box2",
            "the call answers with the edited body") ])))


/// Editing a trait carries its implementations along, as `dark trait` does. A new method leaves
/// the implementation incomplete, and both the footer and the call say so.
test workbenchTraitEditKeepsItsImplementations = Instance.withInstance(fun i ->
  let setup =
    [ setUp(
        i,
        [ "type", "/Tests.WbTraitEdit.Box", "{ wbTraitEditMark: Int64 }" ])

      setUp(
        i,
        [ "trait"
          "/Tests.WbTraitEdit.WbWave"
          "<'a> = let shout(v: 'a): String" ])

      setUp(
        i,
        [ "impl"
          "/Tests.WbTraitEdit"
          "WbWave for Box = let shout(b: Box): String = \"box\"" ]) ]

  let saved =
    editInWorkbench(
      i,
      [ "Tests", "WbTraitEdit" ],
      "WbWave",
      "let shout(v: 'a): String",
      "let shout(v: 'a): String\n  let wave(v: 'a): String")

  let box = "Tests.WbTraitEdit.Box { wbTraitEditMark = 1 }"
  Stdlib.Test.all(
    Stdlib.List.concat(
      setup,
      [ Instance.says(saved, "footer: saved", "the edit saved")

        Instance.says(
          saved,
          "no longer type-checks",
          "the footer names the implementation the new method left incomplete")

        Instance.says(
          Instance.output(
            i,
            [ "eval", $"Tests.WbTraitEdit.WbWave.shout({box})" ]),
          "box",
          "the implementation still answers the method it has")

        Instance.says(
          Instance.output(i, [ "impls", "Tests.WbTraitEdit.WbWave" ]),
          "Tests.WbTraitEdit.Box",
          "and is still listed against the trait")

        Instance.says(
          Instance.said(i, [ "eval", $"Tests.WbTraitEdit.WbWave.wave({box})" ]),
          "chosen here has no `wave`",
          "calling the new method blames the implementation") ])))


/// Editing a function in the workbench carries its callers to the new version.
test workbenchFunctionEditCarriesItsCallers = Instance.withInstance(fun i ->
  let setup =
    [ setUp(i, [ "fn", "/Tests.WbFnEdit.g", "(x: Int64) : Int64 = x + 1" ])

      setUp(
        i,
        [ "fn"
          "/Tests.WbFnEdit.f"
          "(x: Int64): Int64 = Tests.WbFnEdit.g(x)" ]) ]

  let saved = editInWorkbench(i, [ "Tests", "WbFnEdit" ], "g", "x + 1", "x + 5")
  Stdlib.Test.all(
    Stdlib.List.concat(
      setup,
      [ Instance.says(saved, "footer: saved", "the edit saved")
        Stdlib.Test.equal(
          Instance.output(i, [ "eval", "Tests.WbFnEdit.f(1)" ]),
          "6") ])))
