module Darklang.Cli.Tests.CommandCompletions

// Every command's `complete` is called on a real AppState, because the failure mode here is a function that
// parses and loads fine and only throws at the moment somebody presses Tab. Nothing but running it finds
// bad code behind a branch nobody exercises.
//
// The assertion is deliberately "none of them threw" rather than a completion count. Counts move whenever a
// command gains an option, and a test that has to be edited every time is a test people edit without reading.

module CompletionSweep =
  // forcing the length is what makes the lazy list actually run

  let forced(c: Cli.Registry.CommandHandler, args: List<String>): Bool =
    let state = Cli.initState()
    (c.complete(state, args) |> Stdlib.List.length) >= 0


  let sweep(args: List<String>): Bool =
    Cli.Registry.allCommands() |> Stdlib.List.all(fun c -> forced(c, args))


// no argument yet: the command was typed, then Tab
test noArgument = CompletionSweep.sweep([]) |> Stdlib.Test.equal(true)


// a partial first argument
test partialFirstArgument =
  Stdlib.Test.all(
    [ CompletionSweep.sweep([ "" ]) |> Stdlib.Test.equal(true)
      CompletionSweep.sweep([ "fea" ]) |> Stdlib.Test.equal(true) ])


// a subcommand, then Tab for its argument -- the arm that reads the store
test subcommandArgument =
  Stdlib.Test.all(
    [ CompletionSweep.sweep([ "show", "" ]) |> Stdlib.Test.equal(true)
      CompletionSweep.sweep([ "switch", "fea" ]) |> Stdlib.Test.equal(true) ])


// more arguments than any command takes; nothing should throw reaching for a word that isn't there
test tooManyArguments =
  CompletionSweep.sweep([ "a", "b", "c", "d" ]) |> Stdlib.Test.equal(true)


// --- the SCM commands specifically offer branch names, since those are the ones typed daily ---

module BranchCompletion =
  let values(args: List<String>): List<String> =
    let state = Cli.initState()
    Cli.Branch.complete(state, args) |> Stdlib.List.map(fun i -> i.value)


// a name that exists in no store: the filter runs and matches nothing, rather than the whole list coming back
test unknownBranchMatchesNothing =
  Stdlib.Test.all(
    [ BranchCompletion.values([ "zzz-no-such-branch" ]) |> Stdlib.Test.equal([])

      BranchCompletion.values([ "switch", "zzz-no-such-branch" ])
      |> Stdlib.Test.equal([]) ])


// `main` is always a legitimate target for the branch-taking subcommands
test mainIsAlwaysOffered =
  (BranchCompletion.values([ "switch", "mai" ]) |> Stdlib.List.contains("main"))
  |> Stdlib.Test.equal(true)


// a subcommand that takes no branch gets no branch names
test nonBranchSubcommand =
  BranchCompletion.values([ "list", "" ]) |> Stdlib.Test.equal([])


module PermissionProfiles =
  let values(args: List<String>): List<String> =
    Cli.Permissions.Command.complete(Cli.initState(), args)
    |> Stdlib.List.map(fun item -> item.value)


test profileNames =
  Stdlib.Test.all(
    [ PermissionProfiles.values([ "profile", "default" ])
      |> Stdlib.Test.equal([ "--yes" ])

      PermissionProfiles.values([ "profile", "read-only", "/tmp" ])
      |> Stdlib.Test.equal([ "--yes" ])

      PermissionProfiles.values([ "profile", "local-dev", "/tmp" ])
      |> Stdlib.Test.equal([ "--yes" ]) ])


// --- Tab completes to the shared prefix before opening the picker ---

module CommonPrefix =
  let items(values: List<String>): List<Cli.Completion.CompletionItem> =
    values |> Stdlib.List.map(Cli.Completion.simple)


  let extend(
    input: String,
    values: List<String>)
    : Stdlib.Option.Option<String> =
    Cli.Completion.extendToCommonPrefix(input, items(values))


  let pressTab(text: String): String =
    let state = Cli.initState()
    let state =
      { state with prompt = Cli.Prompt.Editing.setText(state.prompt, text) }

    let mods =
      Stdlib.Cli.Stdin.Modifiers.Modifiers
        { alt = false, ctrl = false, shift = false }

    (Cli.handleKeyInput(
       state,
       Stdlib.Cli.Stdin.Key.Key.Tab,
       mods,
       Stdlib.Option.Option.None)).prompt.text


// `fil` with `filter` and `filterMap` completes to `filter`
test commonPrefixExtendsPartial =
  CommonPrefix.extend("fil", [ "filter", "filterMap" ])
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some("filter"))


// once the shared part is typed, there is nothing to add, so the picker opens
test commonPrefixAlreadyTyped =
  CommonPrefix.extend("filter", [ "filter", "filterMap" ])
  |> Stdlib.Test.equal(Stdlib.Option.Option.None)


// only the last argument is replaced
test commonPrefixInArgument =
  CommonPrefix.extend("branch switch fea", [ "feature-a", "feature-b" ])
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some("branch switch feature-"))


// completions that match without starting with the partial are left to the picker
test commonPrefixNotAPrefixMatch =
  CommonPrefix.extend("Map", [ "filterMap", "flatMap" ])
  |> Stdlib.Test.equal(Stdlib.Option.Option.None)


// through the key handler: `commi` matches `commit` and `commits`
test tabCompletesCommandToCommonPrefix =
  CommonPrefix.pressTab("commi") |> Stdlib.Test.equal("commit")
