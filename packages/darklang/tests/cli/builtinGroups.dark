module Darklang.Cli.Tests.BuiltinGroups

// `Builtins.knownGroups` gives `dark builtins` its section names and their order. A prefix with
// no entry is uppercased by `getDisplayName` and sorted after every named group, so the drift is
// invisible: the listing still renders, it just puts most of the stdlib in a tail of SHOUTING
// headings. When this test was written, 49 of the 69 live prefixes had no entry -- `pm` with 57
// builtins, `syscall` with 45, and the ten integer widths with 302 between them -- and 7 of the
// 27 entries named a prefix no builtin carries any more.
//
// The bar is three. A prefix carrying one or two builtins is usually an artifact of
// `extractGroup` reading the characters before the first capital (`toRepr` -> `to`,
// `notEquals` -> `not`), and naming those would be pretending the artifact is a category.

module BuiltinGroups =
  let knownPrefixes () : List<String> =
    Darklang.Cli.Builtins.knownGroups |> Stdlib.List.map (fun (p, _) -> p)

  let livePrefixes () : List<String> =
    Darklang.LanguageTools.allBuiltinFns ()
    |> Stdlib.List.map (fun f -> Darklang.Cli.Builtins.extractGroup f.name.name)

  /// Prefixes carrying at least <param floor> builtins.
  let substantial (floor: Int) : List<String> =
    let live = livePrefixes ()
    live
    |> Stdlib.List.unique
    |> Stdlib.List.filter (fun p ->
      (Stdlib.List.length (Stdlib.List.filter live (fun q -> q == p))) >= floor)


// The floor, so neither test below can pass over an empty builtin set.
test theBuiltinSetWasActuallyRead =
  (Stdlib.List.length (BuiltinGroups.livePrefixes ()) > 400) |> Stdlib.Test.equal true

// A new family of builtins lands and nobody names it. The failure names the prefix.
test everySubstantialPrefixHasADisplayName =
  let known = BuiltinGroups.knownPrefixes ()
  BuiltinGroups.substantial 3
  |> Stdlib.List.filter (fun p -> Stdlib.Bool.not (Stdlib.List.member known p))
  |> Stdlib.List.sort
  |> Stdlib.Test.equal []

// A family is renamed or removed and its row is left behind, taking a slot in the display order.
test noDisplayNameIsStale =
  let live = Stdlib.List.unique (BuiltinGroups.livePrefixes ())
  BuiltinGroups.knownPrefixes ()
  |> Stdlib.List.filter (fun p -> Stdlib.Bool.not (Stdlib.List.member live p))
  |> Stdlib.List.sort
  |> Stdlib.Test.equal []

test noPrefixIsNamedTwice =
  let known = BuiltinGroups.knownPrefixes ()
  (Stdlib.List.length (Stdlib.List.unique known)) |> Stdlib.Test.equal (Stdlib.List.length known)
