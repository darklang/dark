/// Isolated tests run where the temp directory can't be written.
module Darklang.Cli.Tests.TestRunEnvironment

test isolatedTestsRunWithAnUnwritableTempDir = Instance.withInstance(fun i ->
  let path = Instance.home(i) + "/printer.dark"
  let source =
    "let main(): Int64 =\n  Stdlib.printLine(\"hi\")\n  0\n\ntest prints = main() |> Stdlib.Test.equal(0)\n"

  let _ = Stdlib.Cli.File.writeAtomic(path, source) |> Builtin.unwrap
  let _ = Instance.ran(i, [ "import", path, "/Me.Printer" ])
  // a file, not a directory: no user, root included, can make a directory in it
  let notADir = Instance.home(i) + "/not-a-dir"
  let _ = Stdlib.Cli.File.writeAtomic(notADir, "") |> Builtin.unwrap
  let out =
    Instance.call(
      i,
      Instance.Call
        { args = [ "test", "run", "--verbose", "Me.Printer" ]
          stdin = None
          env = [ ("TMPDIR", notADir) ]
          tty = false })

  let shown = Instance.shown(out)
  Stdlib.Test.all(
    [ Instance.exitedWith(out.exitCode, 0, shown)
      Instance.says(shown, "PASS Me.Printer.prints", "the test ran") ]))
