/// CLI tests: the command surface, driven by shelling out to the real binary.
///
/// Tests that launch commands run in disposable processes and stores.
module Darklang.Cli.Tests.TestSuite

/// The binary these tests drive.
///
/// Defaults to the dev wrapper, which is what you want locally. CI points it at
/// a freshly-published artifact instead (`DARK_CLI_UNDER_TEST=clis/darklang-...`)
/// so the suite validates the thing we're about to ship rather than a Debug
/// build. That matters most under NativeAOT, where a trimming failure is
/// invisible at build time and only shows up in the one command that hits it.
let cliUnderTest(): String =
  match Stdlib.Env.get("DARK_CLI_UNDER_TEST") with
  | Some(path) -> path
  | None -> "./scripts/run-cli"


/// What a call printed. A failure EXITS NONZERO and explains itself on stdout (a refused eval, a
/// halted harmful call), so dropping stdout on a nonzero exit hid the very text these tests assert
/// on. Stderr is only surfaced when stdout said nothing: appending it broke exact-match assertions
/// on any stray diagnostic line.
let callOutput(result: Stdlib.Cli.ExecutionOutcome): String =
  let out = Stdlib.String.trim(result.stdout)
  if out != "" then
    out
  else
    let err = Stdlib.String.trim(result.stderr)
    if err == "" then "" else $"ERROR: {err}"


// Quote the CLI path and every argument with Stdlib.Cli.Process.shellQuote.
let runWithCommand(args: List<String>): String =
  let argsString =
    args
    |> Stdlib.List.map(Stdlib.Cli.Process.shellQuote)
    |> Stdlib.String.join(" ")

  let command = Stdlib.Cli.Process.shellQuote(cliUnderTest()) + " " + argsString
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput(".", command)
  callOutput(result)


// Both streams, for a command whose answer and diagnostics are asserted together: a save prints what
// it saved on stdout and why it is only a draft on stderr.
let runWithBothStreams(args: List<String>): String =
  let argsString =
    args
    |> Stdlib.List.map(Stdlib.Cli.Process.shellQuote)
    |> Stdlib.String.join(" ")

  let command = Stdlib.Cli.Process.shellQuote(cliUnderTest()) + " " + argsString
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput(".", command)
  Stdlib.String.trim(result.stdout + "\n" + result.stderr)


// Pass input on stdin for commands such as conflicts walk.
// Use a quoted argument to printf %s so input cannot change the shell command.
let runWithStdinAndCommand(input: String, args: List<String>): String =
  let argsString =
    args
    |> Stdlib.List.map(Stdlib.Cli.Process.shellQuote)
    |> Stdlib.String.join(" ")

  let input = Stdlib.Cli.Process.shellQuote(input)
  let cli = Stdlib.Cli.Process.shellQuote(cliUnderTest())
  let command = $"printf '%s' {input} | {cli} {argsString}"
  let result = Stdlib.Cli.Unix.executeInDirectoryWithOutput(".", command)
  callOutput(result)


/// Run a command and compare its whole output exactly.
let expectExact(args: List<String>, expected: String): Stdlib.Test.Result =
  let output = runWithCommand(args)
  if output == expected then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"Expected '{expected}', got '{output}'")


// Drive conflicts walk between a throwaway parent and child.
// Commit both sides before merging and pass -y to avoid an interactive prompt.
test conflictWalkthrough =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let parent = "cli-walk-parent-" + suffix
  let child = "cli-walk-child-" + suffix
  let fnName = "Tests.CliWalk.f" + suffix
  let _ = runWithCommand([ "branch", "create", parent ])

  // A shared base for the name: both sides have to move it from something.
  let _ =
    runWithCommand([ "--branch", parent, "fn", "/" + fnName, "() : Int64 = 1" ])

  let _ = runWithCommand([ "--branch", parent, "commit", "shared base", "-y" ])

  let _ = runWithCommand([ "--branch", parent, "branch", "create", child ])

  let _ =
    runWithCommand(
      [ "--branch", child, "fn", "/" + fnName, "() : Int64 = 222" ])

  let _ = runWithCommand([ "--branch", child, "commit", "child change", "-y" ])

  let _ =
    runWithCommand(
      [ "--branch", parent, "fn", "/" + fnName, "() : Int64 = 111" ])

  let _ =
    runWithCommand([ "--branch", parent, "commit", "parent change", "-y" ])

  let merged = runWithCommand([ "--branch", child, "merge", child, "-y" ])

  let beforeJson = runWithCommand([ "--branch", parent, "conflicts", "--json" ])
  // `b` takes the other side, which is the answer that has to WRITE something.
  let walked =
    runWithStdinAndCommand("b\n", [ "--branch", parent, "conflicts", "walk" ])

  let afterJson = runWithCommand([ "--branch", parent, "conflicts", "--json" ])
  let onMain = runWithCommand([ "--branch", "main", "eval", fnName + " ()" ])

  // Archive before asserting, not after: every arm below returns, so a trailing cleanup only runs
  // on the passing path, and these branches are otherwise permanent.
  let _ = runWithCommand([ "branch", "archive", child, "-y" ])
  let _ = runWithCommand([ "branch", "archive", parent, "-y" ])
  if Stdlib.Bool.not(Stdlib.String.contains(merged, "conflict")) then
    Stdlib.Test.fail($"Expected the merge to record a conflict; got: {merged}")
  else if
    Stdlib.Bool.not(Stdlib.String.contains(beforeJson, "\"pending\":1"))
  then
    Stdlib.Test.fail(
      $"Expected one pending conflict before the walk; got: {beforeJson}")
  else if Stdlib.String.contains(walked, "ERROR:") then
    Stdlib.Test.fail($"`conflicts walk` failed: {walked}")
  else if Stdlib.Bool.not(Stdlib.String.contains(walked, "took theirs")) then
    Stdlib.Test.fail(
      $"Expected the walk to take the other side on `b`; got: {walked}")
  else if
    Stdlib.Bool.not(Stdlib.String.contains(afterJson, "\"pending\":0"))
  then
    Stdlib.Test.fail(
      $"Expected nothing pending after the walk; got: {afterJson}")
  else if Stdlib.Bool.not(Stdlib.String.contains(onMain, "not found")) then
    Stdlib.Test.fail(
      $"A conflict resolved between two branches reached MAIN. Got: {onMain}")
  else
    Stdlib.Test.Result.Pass


test helpCommand =
  let output = runWithCommand([ "help" ])

  // Assert on the groups and a command from a few of them.
  //
  // Assert the RENDERED ROW, not the bare word. `contains output "nav"` passed on the word "navigable" in
  // the workbench's description, so it would have stayed green with the `nav` command deleted; "help",
  // "version" and "status" all appear in other commands' descriptions too. The row shape
  // (`  name (aliases) - `) is what `formatCommandGroup` emits and is unique per command.
  if
    Stdlib.String.contains(output, "Packages:")
    && Stdlib.String.contains(output, "  nav (cd) -")
    && Stdlib.String.contains(output, "  ls (dir) -")
    && Stdlib.String.contains(output, "  version (--version, -v) -")
    && Stdlib.String.contains(output, "  status (wip, changes) -")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected help grouped by category, with the nav/ls/version/status rows rendered")


test versionCommand =
  let output = runWithCommand([ "version" ])
  if
    Stdlib.String.contains(output, "Darklang CLI")
    && Stdlib.String.contains(output, "alpha-")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("Expected version string with 'Darklang CLI alpha-'")


test statusCommand =
  // Two things, because `status` is the one signal you get while editing: WHERE you are, and WHAT you have.
  // The branch line matters most when several branches are in play, which is the normal case now.
  let output = runWithCommand([ "status" ])
  if
    Stdlib.String.contains(output, "On branch")
    && (Stdlib.String.contains(output, "clean:")
        || Stdlib.String.contains(output, "draft:"))
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected `status` to name the branch and summarise the draft; got: {output}")


test evalBoolAnd =
  // `run` is for script files now; calling a package function is `eval`'s job, without the `@`.
  expectExact([ "eval", "Stdlib.Bool.and(true, false)" ], "false")


test evalInt64Add = expectExact([ "eval", "(5 + 3)" ], "8")


test evalStringLength =
  expectExact([ "eval", "Stdlib.String.length(\"hello\")" ], "5")


test evalListLength =
  expectExact([ "eval", "[1, 2, 3] |> Stdlib.List.length" ], "3")


/// Create, update, and what happens to a module that does not type-check.
///
/// A declaration that fails the at-rest check is SAVED AS WIP and refused at `commit`, not rejected
/// at author time: a draft may be broken because you write the caller before the callee, a commit may
/// not, because a commit is what other machines pull. So after an invalid module the item EXISTS, the
/// message says it is WIP, and the definitions that were already there are untouched.
test moduleCommand =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let branchName = "cli-module-test-" + suffix
  let moduleName = "Tests.CliModule"
  let initialSource =
    [ "type Counter = { value: Int64 }"
      ""
      "val initial = Counter { value = 0 }"
      ""
      "let double(n: Int64): Int64 = n * 2"
      ""
      "let quadruple(n: Int64): Int64 = double(double(n))" ]
    |> Stdlib.String.join("\n")

  let updatedSource =
    [ "type Counter = { value: Int64 }"
      ""
      "val initial = Counter { value = 1 }"
      ""
      "let double(n: Int64): Int64 = n * 3"
      ""
      "let quadruple(n: Int64): Int64 = double(double(n))" ]
    |> Stdlib.String.join("\n")

  let invalidSource =
    [ "type Wrapped = Wrap(Int64 * String)"
      ""
      "let shouldNotExist(value: Wrapped): Wrapped ="
      "  match value with"
      "  | Wrap((number, text)) -> Wrapped.Wrap(number, text)" ]
    |> Stdlib.String.join("\n")

  let initialPath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap

  let updatedPath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap

  let invalidPath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap

  let _ =
    Stdlib.Cli.File.writeAtomic(initialPath, initialSource) |> Builtin.unwrap

  let _ =
    Stdlib.Cli.File.writeAtomic(updatedPath, updatedSource) |> Builtin.unwrap

  let _ =
    Stdlib.Cli.File.writeAtomic(invalidPath, invalidSource) |> Builtin.unwrap

  let _ = runWithCommand([ "branch", "create", branchName ])

  let moduleOutput =
    runWithCommand(
      [ "--branch", branchName, "module", "/" + moduleName, initialPath ])

  let initialEval =
    runWithCommand(
      [ "--branch", branchName, "eval", moduleName + ".quadruple(3)" ])

  let updateOutput =
    runWithCommand(
      [ "--branch", branchName, "module", "/" + moduleName, updatedPath ])

  let updatedEval =
    runWithCommand(
      [ "--branch", branchName, "eval", moduleName + ".quadruple(3)" ])

  let invalidOutput =
    runWithBothStreams(
      [ "--branch", branchName, "module", "/" + moduleName, invalidPath ])

  let searchOutput =
    runWithCommand(
      [ "--branch"
        branchName
        "search"
        moduleName + ".shouldNotExist"
        "--exact"
        "--fn" ])

  let afterInvalidEval =
    runWithCommand(
      [ "--branch", branchName, "eval", moduleName + ".quadruple(3)" ])

  let _ = runWithCommand([ "branch", "archive", branchName, "-y" ])
  let _ = Stdlib.Cli.File.delete(initialPath)
  let _ = Stdlib.Cli.File.delete(updatedPath)
  let _ = Stdlib.Cli.File.delete(invalidPath)
  if
    Stdlib.String.contains(moduleOutput, "Defined 4 declarations")
    && initialEval == "12"
    && Stdlib.String.contains(updateOutput, "Defined 4 declarations")
    && updatedEval == "27"
    && Stdlib.String.contains(invalidOutput, "expects 1 field")
    && Stdlib.String.contains(invalidOutput, "Saved as a draft")
    && Stdlib.String.contains(searchOutput, "shouldNotExist")
    && afterInvalidEval == "27"
  then
    Stdlib.Test.Result.Pass
  else
    let details =
      [ $"create: {moduleOutput}"
        $"initial eval: {initialEval}"
        $"update: {updateOutput}"
        $"updated eval: {updatedEval}"
        $"invalid: {invalidOutput}"
        $"invalid item search: {searchOutput}"
        $"eval after invalid: {afterInvalidEval}" ]
      |> Stdlib.String.join("; ")

    Stdlib.Test.fail(
      $"Expected atomic create, update, and rejection; got {details}")


test moduleRejectsDuplicateNames =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let branchName = "cli-module-duplicate-test-" + suffix
  let moduleName = "Tests.CliModuleDuplicate"
  let source =
    [ "let duplicate(n: Int64): Int64 = n"
      ""
      "let duplicate(n: Int64): Int64 = n + 1" ]
    |> Stdlib.String.join("\n")

  let sourcePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Stdlib.Cli.File.writeAtomic(sourcePath, source) |> Builtin.unwrap
  let _ = runWithCommand([ "branch", "create", branchName ])

  let moduleOutput =
    runWithCommand(
      [ "--branch", branchName, "module", "/" + moduleName, sourcePath ])

  let searchOutput =
    runWithCommand(
      [ "--branch"
        branchName
        "search"
        moduleName + ".duplicate"
        "--exact"
        "--fn" ])

  let _ = runWithCommand([ "branch", "archive", branchName, "-y" ])
  let _ = Stdlib.Cli.File.delete(sourcePath)
  if
    Stdlib.String.contains(moduleOutput, "duplicate declaration names")
    && Stdlib.String.contains(moduleOutput, "duplicate")
    && Stdlib.String.contains(searchOutput, "No results found")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected duplicate declarations to be rejected without mutation; "
      + $"module={moduleOutput}; search={searchOutput}")


// A module save that fails the type check says which function each error is in.
test moduleSaveNamesTheFunctionsWithTypeErrors =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let branchName = "cli-module-type-errors-test-" + suffix
  let moduleName = "Tests.CliModuleTypeErrors"
  let source =
    [ "let addsText(n: Int64): Int64 = n + \"x\""
      ""
      "let multipliesText(n: Int64): Int64 = n * \"y\""
      ""
      "let fine(n: Int64): Int64 = n" ]
    |> Stdlib.String.join("\n")

  let sourcePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Stdlib.Cli.File.writeAtomic(sourcePath, source) |> Builtin.unwrap
  let _ = runWithCommand([ "branch", "create", branchName ])
  let output =
    runWithBothStreams(
      [ "--branch", branchName, "module", "/" + moduleName, sourcePath ])

  let _ = runWithCommand([ "branch", "archive", branchName, "-y" ])
  let _ = Stdlib.Cli.File.delete(sourcePath)
  let namedAboveItsError(fnName: String): Bool =
    Stdlib.String.contains(
      output,
      $"  {moduleName}.{fnName}:\n    - [TypeMismatch]")

  if
    namedAboveItsError("addsText")
    && namedAboveItsError("multipliesText")
    && Stdlib.Bool.not(Stdlib.String.contains(output, $"{moduleName}.fine:"))
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected each failing function named above its error; got {output}")


// Two functions with identical bodies share a hash, and the warning still names each.
// The bodies call a name that does not exist yet, so the check is incomplete rather than failed:
// a failed item reports its type error instead of this line.
test moduleSaveNamesEachIdenticalFunctionWithUnresolvedTraitCalls =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let branchName = "cli-module-trait-calls-test-" + suffix
  let moduleName = "Tests.CliModuleTraitCalls"
  let source =
    [ "let addsText(n: Int64): Int64 = Tests.CliModuleTraitCallsMissing.g(n) + 1"
      ""
      "let addsTextToo(n: Int64): Int64 = Tests.CliModuleTraitCallsMissing.g(n) + 1" ]
    |> Stdlib.String.join("\n")

  let sourcePath = Stdlib.Cli.File.createTemp() |> Builtin.unwrap
  let _ = Stdlib.Cli.File.writeAtomic(sourcePath, source) |> Builtin.unwrap
  let _ = runWithCommand([ "branch", "create", branchName ])
  let output =
    runWithBothStreams(
      [ "--branch", branchName, "module", "/" + moduleName, sourcePath ])

  let _ = runWithCommand([ "branch", "archive", branchName, "-y" ])
  let _ = Stdlib.Cli.File.delete(sourcePath)
  if
    Stdlib.String.contains(output, $"{moduleName}.addsText: operator `+`")
    && Stdlib.String.contains(output, $"{moduleName}.addsTextToo: operator `+`")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected the warning to name each function and call; got {output}")


// Merge a child into a throwaway parent so the test leaves no function on main.
// Commit the changes before merging and pass -y to avoid an interactive prompt.
test mergeRoundTrip =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let parent = "cli-merge-parent-" + suffix
  let child = "cli-merge-child-" + suffix
  let fnName = "Tests.CliMerge.landed" + suffix
  let _ = runWithCommand([ "branch", "create", parent ])

  let _ = runWithCommand([ "--branch", parent, "branch", "create", child ])

  let _ =
    runWithCommand([ "--branch", child, "fn", "/" + fnName, "() : Int64 = 7" ])

  let _ = runWithCommand([ "--branch", child, "commit", "merge fixture", "-y" ])

  // --dry-run records nothing, so it has to answer the same question the merge does without doing it.
  let dryRun =
    runWithCommand([ "--branch", child, "merge", child, "--dry-run" ])

  let merged = runWithCommand([ "--branch", child, "merge", child, "-y" ])

  let onParent = runWithCommand([ "--branch", parent, "eval", fnName + " ()" ])

  let onMain = runWithCommand([ "--branch", "main", "eval", fnName + " ()" ])

  // Archived before the assertions, because each arm returns and a trailing cleanup would only run
  // on the passing path.
  let _ = runWithCommand([ "branch", "archive", child, "-y" ])

  let _ = runWithCommand([ "branch", "archive", parent, "-y" ])
  if Stdlib.String.contains(dryRun, "ERROR:") then
    Stdlib.Test.fail($"`merge --dry-run` failed: {dryRun}")
  else if Stdlib.Bool.not(Stdlib.String.contains(dryRun, parent)) then
    Stdlib.Test.fail(
      $"Expected `merge --dry-run` to name the parent it would merge into; got: {dryRun}")
  else if Stdlib.Bool.not(Stdlib.String.contains(dryRun, fnName)) then
    Stdlib.Test.fail(
      $"Expected `merge --dry-run` to list the name that would land; got: {dryRun}")
  else if Stdlib.Bool.not(Stdlib.String.contains(merged, "Merged")) then
    Stdlib.Test.fail(
      $"Expected `merge` to report what it merged; got: {merged}")
  else if onParent != "7" then
    Stdlib.Test.fail(
      $"Expected the merged fn to resolve on the parent as 7; got: {onParent}")
  else if onMain == "7" then
    Stdlib.Test.fail(
      $"A merge into \"{parent}\" reached MAIN -- the branch overlay leaked. Got: {onMain}")
  else
    Stdlib.Test.Result.Pass


test fnAcceptsCompleteDeclaration =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let branchName = "cli-authoring-test-" + suffix
  let moduleName = "Tests.CliAuthoring"
  let fnSource =
    [ "/// Greets someone by name."
      "let main(name: String): String ="
      "  \"Hello, \" + name" ]
    |> Stdlib.String.join("\n")

  let mismatchedSource = "let other(name: String): String = name"
  let multipleSource =
    [ "let extra(n: Int64): Int64 = n", "let ignored(n: Int64): Int64 = n" ]
    |> Stdlib.String.join("\n")

  let _ = runWithCommand([ "branch", "create", branchName ])

  let fnOutput =
    runWithCommand(
      [ "--branch", branchName, "fn", "/" + moduleName + ".main", fnSource ])

  let evalOutput =
    runWithCommand(
      [ "--branch", branchName, "eval", moduleName + ".main(\"Dark\")" ])

  let fragmentOutput =
    runWithCommand(
      [ "--branch"
        branchName
        "fn"
        "/" + moduleName + ".double"
        "(n: Int64) : Int64 = n * 2" ])

  let fragmentEval =
    runWithCommand(
      [ "--branch", branchName, "eval", moduleName + ".double(4)" ])

  let mismatchOutput =
    runWithCommand(
      [ "--branch"
        branchName
        "fn"
        "/" + moduleName + ".main"
        mismatchedSource ])

  let multipleOutput =
    runWithCommand(
      [ "--branch"
        branchName
        "fn"
        "/" + moduleName + ".extra"
        multipleSource ])

  let _ = runWithCommand([ "branch", "archive", branchName, "-y" ])
  if
    Stdlib.String.contains(fnOutput, "Created function")
    && evalOutput == "Hello, Dark"
    && Stdlib.String.contains(fragmentOutput, "Created function")
    && fragmentEval == "8"
    && Stdlib.String.contains(mismatchOutput, "does not match target")
    && Stdlib.String.contains(multipleOutput, "something after the definition")
    && Stdlib.String.contains(multipleOutput, "nothing was saved")
    && Stdlib.Bool.not(
      Stdlib.String.contains(multipleOutput, "Created function"))
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected complete and fragment fn input with target-name validation; "
      + $"fn={fnOutput}; eval={evalOutput}; fragment={fragmentOutput}; "
      + $"fragment eval={fragmentEval}; mismatch={mismatchOutput}; "
      + $"multiple={multipleOutput}")


test listFunctions =
  let output = runWithCommand([ "ls", "Stdlib.List" ])
  if
    Stdlib.String.contains(output, "Functions")
    && Stdlib.String.contains(output, "head")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("Expected directory listing with functions")


// Exercise the harmful gate through a real CLI process: the gate lives in the CLI host.
// Each command names main explicitly because deprecation folding only runs on main.
test harmfulGate =
  let suffix = Stdlib.display(Stdlib.Int64.random(100000, 999999))
  let fnName = $"Tests.HarmGate.g{suffix}"
  let onMain(args: List<String>): String =
    runWithCommand(Stdlib.List.concat([ "--branch", "main" ], args))

  let _ = onMain([ "fn", fnName, "(x: Int64) : Int64 = (x + 31)" ])
  let _ =
    onMain(
      [ "deprecate", "fn", fnName, "--kind", "harmful", "-m", "test", "--yes" ])

  let halted = onMain([ "eval", $"{fnName}(0)" ])
  let allowed = onMain([ "eval", $"{fnName}(0)", "--allow-harmful" ])
  if Stdlib.Bool.not(Stdlib.String.contains(halted, "Harmful")) then
    Stdlib.Test.fail(
      $"a fn marked harmful should refuse to run without the flag, got: {halted}")
  else if Stdlib.Bool.not(Stdlib.String.contains(allowed, "31")) then
    // The halt message names `--allow-harmful`, so the flag has to do what the message promises.
    Stdlib.Test.fail($"--allow-harmful should run it anyway, got: {allowed}")
  else
    Stdlib.Test.Result.Pass


/// Two names holding one body are one item, so deleting or deprecating one used to deprecate
/// both: deleting a probe `= 5` took stdlib constants with it. Now it is said at the name, and the
/// other name stays undeprecated and resolvable.
test deprecateLeavesATwinAlone = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let hashOf = fun name -> Stdlib.String.trim(said([ "hash", name ]))
  let _ = said([ "val", "Tests.Twins.kept", "= 770031" ])
  let _ = said([ "val", "Tests.Twins.probe", "= 770031" ])
  let deprecated =
    said([ "deprecate", "Tests.Twins.probe", "--kind", "obsolete", "--yes" ])

  if hashOf("Tests.Twins.kept") != hashOf("Tests.Twins.probe") then
    Stdlib.Test.fail(
      "the two names should hold one item, or this tests nothing")
  else
    Stdlib.Test.all(
      [ Instance.says(
          deprecated,
          "1 other name shares this code and is unaffected",
          "deprecate says the code is shared")

        Instance.says(
          said([ "undeprecate", "Tests.Twins.kept" ]),
          "is not deprecated",
          "the other name is left alone")

        Instance.says(
          said([ "eval", "Tests.Twins.kept" ]),
          "770031",
          "and still resolves")

        Instance.says(
          said([ "undeprecate", "Tests.Twins.probe" ]),
          "Undeprecated",
          "the name given was deprecated") ]))


/// Harmful is about the code, not the name: marking one name halts calls through every name holding
/// that code, and undoing it at one name clears it for all of them.
test harmfulMarksEveryTwin = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let _ =
    said([ "fn", "Tests.HarmTwins.a", "(x: Int64) : Int64 = (x + 770032)" ])

  let _ =
    said([ "fn", "Tests.HarmTwins.b", "(x: Int64) : Int64 = (x + 770032)" ])

  let marked =
    said(
      [ "deprecate", "fn", "Tests.HarmTwins.a", "--kind", "harmful", "--yes" ])

  let haltedB = said([ "eval", "Tests.HarmTwins.b(0)" ])
  let cleared = said([ "undeprecate", "Tests.HarmTwins.b" ])
  Stdlib.Test.all(
    [ Instance.says(
        marked,
        "1 other name shares this code and is also marked harmful: Tests.HarmTwins.b",
        "harmful names the others")

      Instance.says(haltedB, "Harmful", "a call through the twin halts")

      Instance.says(
        cleared,
        "no longer harmful: Tests.HarmTwins.a",
        "undoing it at the twin clears both")

      Instance.says(
        said([ "eval", "Tests.HarmTwins.a(0)" ]),
        "770032",
        "so the first name runs again") ]))


/// `ls` lists names: after deleting one of two names holding the same code, only the other is listed.
test lsDropsADeletedTwin = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let _ = said([ "val", "Tests.LsTwins.kept", "= 770033" ])
  let _ = said([ "val", "Tests.LsTwins.probe", "= 770033" ])
  let _ = said([ "delete", "Tests.LsTwins.probe", "--yes" ])
  let listed = said([ "ls", "Tests.LsTwins" ])
  Stdlib.Test.all(
    [ Instance.says(listed, "kept", "the twin is still listed")
      Instance.doesNotSay(
        listed,
        "⚠",
        "and nothing listed is marked deprecated")

      Instance.doesNotSay(listed, "probe", "the deleted name is not") ]))


test fnTakesACommentedDeclarationAsIs =
  let commented = "// one line about it\nlet f(x: Int64): Int64 = x"
  Stdlib.Test.all(
    [ Cli.Packages.Fn.fnSource("f", commented) |> Stdlib.Test.equal(commented)
      Cli.Packages.Fn.fnSource("f", "(x: Int64): Int64 = x")
      |> Stdlib.Test.equal("let f (x: Int64): Int64 = x") ])


// #6024: an impl's methods are called through its trait, never at the type's module, so
// `view` and `search` say where: the `Stdlib.display` shortcut beside `Display`, and the
// trait's own path for one without a shortcut.
test implListingsSayWhereTheMethodsAreCalled =
  let viewed = runWithCommand([ "view", "Stdlib.Int64" ])
  let searched = runWithCommand([ "search", "Int64.display", "--impl" ])
  if
    Stdlib.String.contains(viewed, "Stdlib.display")
    && Stdlib.String.contains(viewed, "Stdlib.Add.add")
    && Stdlib.Bool.not(Stdlib.String.contains(viewed, "Stdlib.Int64.toString"))
    && Stdlib.String.contains(searched, "Stdlib.display(v)")
    && Stdlib.String.contains(searched, "impl Display for Int64")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"Expected call paths; view={viewed}; search={searched}")


test listTypes =
  let output = runWithCommand([ "ls", "Stdlib.Option" ])
  if
    Stdlib.String.contains(output, "Types")
    && Stdlib.String.contains(output, "Option")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("Expected directory listing with types")


test helpForRun =
  let output = runWithCommand([ "help", "run" ])
  // `contains output "run"` is satisfied by the unknown-command fallback ("No help available for command:
  // run"), so it can't tell "help worked" from "help failed". The usage line is topic-unique, and it also
  // proves the `run` alias resolved to `run-script`, which is the rename this branch made.
  if Stdlib.String.contains(output, "Usage: run-script") then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      "Expected `help run` to resolve the alias and print run-script's usage")


test helpForLs =
  let output = runWithCommand([ "help", "ls" ])
  // Same reasoning as `help run`: assert something only the real topic prints.
  if Stdlib.String.contains(output, "Usage: ls") then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail("Expected `help ls` to print ls's usage")


test evalSimpleExpression = expectExact([ "eval", "2 + 3" ], "5")


test evalStringExpression =
  expectExact([ "eval", "\"hello\" + \"world\"" ], "helloworld")


// ---------------------------------------------------------------- native list rewrites
// These five moved from Dark to builtins for speed. The edge cases are the point: an out-of-bounds or
// negative index, an empty list, and nested empties are exactly where a reimplementation drifts.

test nativeListEdgeCases =
  let cases =
    [ ("Stdlib.List.getAt([1,2,3], 0)", "1")
      ("Stdlib.List.getAt([1,2,3], 2)", "3")
      ("Stdlib.List.getAt([1,2,3], 3)", "None")
      ("Stdlib.List.getAt([1,2,3], -1)", "None")
      ("Stdlib.List.getAt([], 0)", "None")
      ("Stdlib.List.reverse([1,2,3])", "[3, 2, 1]")
      ("Stdlib.List.reverse([])", "[]")
      ("Stdlib.List.prepend([2,3], 1)", "[1, 2, 3]")
      ("Stdlib.List.prepend([], 1)", "[1]")
      ("Stdlib.List.append([1,2], 3)", "[1, 2, 3]")
      ("Stdlib.List.append([], 1)", "[1]")
      ("Stdlib.List.flatten([[1,2],[3]])", "[1, 2, 3]")
      ("Stdlib.List.flatten([])", "[]")
      ("Stdlib.List.flatten([[],[1],[]])", "[1]") ]

  let failures =
    cases
    |> Stdlib.List.filterMap(fun pair ->
      let (expr, expected) = pair
      let output = runWithCommand([ "eval", expr ])
      if Stdlib.String.contains(output, expected) then
        Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.Some(
          $"`{expr}` expected `{expected}`, got `{output}`"))

  match failures with
  | [] -> Stdlib.Test.Result.Pass
  | _ -> Stdlib.Test.fail(Stdlib.String.join(failures, "; "))


/// A `None` from `getAt` must still compare and match as a plain `None`. The native version threads the
/// list's element type through, so the repr gained a type argument; this pins that the change is
/// display-only.
/// Calls carrying an EXPLICIT type argument take a different path through Apply than the usual inferred
/// case: resolving the type argument is the one step that can need the package store before anything has
/// run, so it hands off to `callBuiltinAsync`/`callPackageAsync` instead of staying synchronous.
///
/// Nothing else in either suite exercises that, and it has already been wrong once: an earlier version
/// awaited and then retried the synchronous path, which never terminates for a type argument that isn't
/// in the store, because cache misses aren't cached. A scalar type arg, a container one and a custom one
/// each resolve differently, so all three are here.
test explicitTypeArgs =
  let scalar = runWithCommand([ "eval", "Stdlib.Json.parse<Int64>(\"3\")" ])

  let container =
    runWithCommand([ "eval", "Stdlib.Json.parse<List<Int64>>(\"[1,2]\")" ])

  let custom =
    runWithCommand(
      [ "eval", "Stdlib.Json.parse<Stdlib.Uuid.ParseError>(\"{}\")" ])

  if
    Stdlib.String.contains(scalar, "Ok")
    && Stdlib.String.contains(scalar, "3")
    && Stdlib.String.contains(container, "Ok")
    && Stdlib.String.contains(container, "[1, 2]")
    && Stdlib.String.contains(custom, "ParseError")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected explicit type args to resolve; got scalar: {scalar}, container: {container}, custom: {custom}")


test getAtNoneIsStillNone =
  let eq =
    runWithCommand(
      [ "eval"
        "(Stdlib.List.getAt([1,2,3], 99)) == Stdlib.Option.Option.None" ])

  let dflt =
    runWithCommand(
      [ "eval"
        "Stdlib.Option.withDefault(Stdlib.List.getAt([1,2,3], 99), 0)" ])

  if
    Stdlib.String.contains(eq, "true") && Stdlib.String.contains(dflt, "0")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected out-of-bounds None to behave as None, got eq: {eq}, default: {dflt}")


/// Every way of passing a definition authors the same item. The `=` is a separator:
/// unquoted the shell splits it off, quoted it arrives attached, and both come off.
test authoringAcceptsAQuotedSeparator =
  let branch = "cli-quoted-eq-" + Stdlib.display(Stdlib.Int64.random(1, 999999))
  let run(args: List<String>): String =
    runWithCommand(Stdlib.List.concat([ "--branch", branch ], args))

  let body = "(x: Int64) : Int64 = (x * 2)"
  let _ = runWithCommand([ "branch", "create", branch ])
  let _ = run([ "fn", "/Tests.QuotedEq.quoted", "= " + body ])
  let _ = run([ "fn", "/Tests.QuotedEq.split", "=", body ])
  let typed = run([ "type", "/Tests.QuotedEq.T", "= { x: Int64 }" ])
  let valued = run([ "val", "/Tests.QuotedEq.v", "= 42" ])

  // The hash is the assertion: the same item, not merely both accepted. Evaluating it
  // shows the `=` inside the body survived.
  let quotedHash = run([ "hash", "Tests.QuotedEq.quoted" ])
  let splitHash = run([ "hash", "Tests.QuotedEq.split" ])
  let evaluated = run([ "eval", "Tests.QuotedEq.quoted(21)" ])
  let _ = runWithCommand([ "branch", "archive", branch, "-y" ])
  if
    quotedHash == splitHash
    && Stdlib.String.contains(evaluated, "42")
    && Stdlib.String.contains(typed, "Created type")
    && Stdlib.String.contains(valued, "Created value")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"hashes {quotedHash} / {splitHash}, eval {evaluated}, {typed}, {valued}")


/// A lowercase module segment is refused. It would be read as the item's NAME, so
/// `Tests.lower.f` authors `Tests.lower` and nothing can refer to it afterwards.
test authoringRefusesALowercaseModule =
  let branch = "cli-lowercase-" + Stdlib.display(Stdlib.Int64.random(1, 999999))
  let run(args: List<String>): String =
    runWithCommand(Stdlib.List.concat([ "--branch", branch ], args))

  let _ = runWithCommand([ "branch", "create", branch ])
  let refused = run([ "fn", "/Tests.lower.f", "() : Int64 = 1" ])
  let listed = run([ "ls", "Tests.lower" ])
  let _ = runWithCommand([ "branch", "archive", branch, "-y" ])
  if
    Stdlib.String.contains(refused, "must start with a capital")
    && Stdlib.Bool.not(Stdlib.String.contains(refused, "Created"))
    && Stdlib.String.contains(listed, "Not found")
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"refusal: {refused}, and listing said: {listed}")


/// "Not found" names the path, once. Naming it at the traversal covers every caller,
/// which is why none of them adds it again.
test notFoundNamesThePath =
  // A real prefix, so the traversal gets past it: it reports the FIRST missing segment,
  // and a wholly unknown path would only ever report its first.
  let missing = "Darklang.Stdlib.NoSuchModule.thing"
  let expected = "Not found: Darklang.Stdlib.NoSuchModule"
  let viewed = runWithCommand([ "view", missing ])
  let listed = runWithCommand([ "ls", missing ])
  let navigated = runWithCommand([ "nav", missing ])
  let names(s: String): Bool = Stdlib.String.contains(s, expected)
  let twice =
    Stdlib.List.length(Stdlib.String.split(viewed, "NoSuchModule")) > 2

  if
    names(viewed) && names(listed) && names(navigated) && Stdlib.Bool.not(twice)
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"view: {viewed}, ls: {listed}, nav: {navigated}")


/// `tree` refuses what it cannot show. Both arms used to answer instead: an unknown flag
/// was dropped with the real ones, and an unresolvable path fell back to where you stood.
test treeRefusesWhatItCannotShow =
  let badFlag = runWithCommand([ "tree", "--zzbogus" ])

  let badPath = runWithCommand([ "tree", "Zz.NoSuchThing" ])

  let twoPaths = runWithCommand([ "tree", "Darklang.Stdlib", "Darklang.Cli" ])

  let withDepth =
    runWithCommand([ "tree", "Darklang.Stdlib.Option", "--depth=1" ])

  // The header the render prints. Seeing it in a refusal means it showed a tree anyway.
  let shown(s: String): Bool = Stdlib.String.contains(s, "Package tree from")
  if
    Stdlib.String.contains(badFlag, "does not take `--zzbogus`")
    && Stdlib.Bool.not(shown(badFlag))
    && Stdlib.String.contains(badPath, "Not found")
    && Stdlib.Bool.not(shown(badPath))
    && Stdlib.String.contains(twoPaths, "does not take `Darklang.Cli`")
    && shown(withDepth)
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"flag: {badFlag}, path: {badPath}, two: {twoPaths}, depth shown: {Stdlib.display(shown(withDepth))}")


/// `discard` throws the whole draft away, so an unanswerable prompt is not a yes: it
/// refuses, and the work is still there. `-y` is how a script says yes.
test discardNeedsAnExplicitYes =
  let branch = "cli-discard-" + Stdlib.display(Stdlib.Int64.random(1, 999999))
  let run(args: List<String>): String =
    runWithCommand(Stdlib.List.concat([ "--branch", branch ], args))

  let _ = runWithCommand([ "branch", "create", branch ])
  let _ = run([ "fn", "/Tests.Discard.a", "() : Int64 = 1" ])
  let refused = run([ "discard" ])
  let survived = run([ "status" ])
  let discarded = run([ "discard", "-y" ])
  let after = run([ "status" ])
  let _ = runWithCommand([ "branch", "archive", branch, "-y" ])
  if
    Stdlib.String.contains(refused, "kept.")
    && Stdlib.String.contains(survived, "1 item")
    && Stdlib.String.contains(discarded, "discarded")
    && Stdlib.Bool.not(Stdlib.String.contains(after, "1 item"))
  then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"refused: {refused}, survived: {survived}, discarded: {discarded}, after: {after}")


/// Saving broken code keeps the draft and returns a failing exit code.
module ModuleSave =
  let save(i: Instance.T, source: String): Stdlib.Cli.Process.Output =
    let path = Instance.home(i) + "/probe.dark"
    let _ = Stdlib.Cli.File.writeText(path, source) |> Builtin.unwrap
    Instance.run(i, [ "module", "/Tests.ModuleSaveProbe", path ])
    |> Builtin.unwrap


  test invalidNamesExitNonzeroAndSaveNothing = Instance.withInstance(fun i ->
    let source =
      "type Shape = | Dot | Circle(Float64)\nlet f(): Shape = Circle(1.0)"

    let result = save(i, source)
    let viewed =
      Instance.run(i, [ "view", "Tests.ModuleSaveProbe.f" ]) |> Builtin.unwrap

    let shape =
      Instance.run(i, [ "view", "Tests.ModuleSaveProbe.Shape" ])
      |> Builtin.unwrap

    Stdlib.Test.all(
      [ result.exitCode |> Stdlib.Test.equal(1)

        Stdlib.String.contains(result.stderr, "Invalid name: Circle")
        |> Stdlib.Test.equal(true)

        viewed.exitCode |> Stdlib.Test.equal(1)

        shape.exitCode |> Stdlib.Test.equal(1) ]))


  test unresolvedNamesExitNonzeroAndKeepDraft = Instance.withInstance(fun i ->
    let result = save(i, "let f(): Int64 = Me.Later.notYet(\"hello\")")
    let viewed =
      Instance.run(i, [ "view", "Tests.ModuleSaveProbe.f" ]) |> Builtin.unwrap

    Stdlib.Test.all(
      [ result.exitCode |> Stdlib.Test.equal(1)

        Stdlib.String.contains(result.stderr, "UnresolvedValueName")
        |> Stdlib.Test.equal(true)

        viewed.exitCode |> Stdlib.Test.equal(0)

        Stdlib.String.contains(viewed.stdout, "notYet")
        |> Stdlib.Test.equal(true) ]))


  test checkedSaveExitsZero = Instance.withInstance(fun i ->
    let result = save(i, "let f(): Int64 = 42")
    result.exitCode |> Stdlib.Test.equal(0))


  // The checker can run out of depth even when the code is valid.
  test otherIncompleteChecksExitZero =
    let warning =
      LanguageTools.AtRestTypeChecker.failureIssue(
        Stdlib.Option.Option.None,
        LanguageTools.AtRestTypeChecker.CheckFailure.TooDeep)

    let report =
      LanguageTools.AtRestTypeChecker.Report
        { verdict = LanguageTools.AtRestTypeChecker.Verdict.Incomplete
          items = []
          diagnostics = []
          warnings = [ warning ] }

    Cli.Packages.AtRestCheck.saveHasErrors(report) |> Stdlib.Test.equal(false)
