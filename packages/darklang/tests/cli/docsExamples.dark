module Darklang.Cli.Tests.DocsExamples

// Every Dark example in `dark docs` parses, so one a reader copies can't drift into one that
// fails. A block is a run of indented lines, and a blank line followed by a line at the
// block's indent starts the next one. A block counts as Dark when its first line starts like
// Dark (a keyword, a call, a dotted name), and the body of a `<<'EOF'` heredoc always does.
// Shell lines and prose are left alone, and in a table only each line's first column is
// checked. A `...` standing for code is read as `()`. A block with a `// wrong` comment shows
// a mistake, and must not parse.

/// Shapes written to be read, not parsed.
val notCode =
  [ "let val in if elif then else type trait impl of match with fun when true false _"
    "type Request = { method, url, headers, body," ]


/// Every page `dark docs` prints from text, with its name.
let pages(): List<(String * String)> =
  Cli.Docs.Command.Topics.allTopics()
  |> Stdlib.List.filter(fun t -> t.name != "signatures")
  |> Stdlib.List.map(fun t ->
    let parts =
      t.subtopics
      |> Stdlib.List.map(fun s ->
        let content = s.content
        ($"{t.name} {s.name}", content()))

    let content = t.content
    [ (t.name, content()), ...parts ])
  |> Stdlib.List.flatten


let isBlank(line: String): Bool =
  Stdlib.String.trim(line) == ""


let inHeredoc(reversed: List<String>): Bool =
  let opened =
    reversed
    |> Stdlib.List.filter(fun l -> Stdlib.String.contains(l, "<<'EOF'"))

  let closed =
    reversed |> Stdlib.List.filter(fun l -> Stdlib.String.trim(l) == "EOF")

  Stdlib.List.length(opened) > Stdlib.List.length(closed)


let closeBlock(
  done: List<List<String>>,
  reversed: List<String>)
  : List<List<String>> =
  match reversed |> Stdlib.List.dropWhile(fun l -> isBlank(l)) with
  | [] -> done
  | lines -> [ Stdlib.List.reverse(lines), ...done ]


/// The blocks of indented lines in <param text>, without their first two spaces.
let blocks(text: String): List<List<String>> =
  let (done, current) =
    Stdlib.String.splitOnNewline(text)
    |> Stdlib.List.fold(([], []), fun(acc, line) ->
      let (done, current) = acc
      let afterBlank =
        match current with
        | [last, ...] -> isBlank(last)
        | [] -> false

      if isBlank(line) then
        if Stdlib.List.isEmpty(current) then acc else (done, [ "", ...current ])
      else if Stdlib.String.startsWith(line, "  ") then
        let line = Stdlib.String.dropFirst(line, 2)
        let newBlock =
          afterBlank
          && Stdlib.Bool.not(Stdlib.String.startsWith(line, " "))
          && Stdlib.Bool.not(inHeredoc(current))

        if newBlock then
          (closeBlock(done, current), [ line ])
        else
          (done, [ line, ...current ])
      else
        (closeBlock(done, current), []))

  closeBlock(done, current) |> Stdlib.List.reverse


let looksLikeDark(text: String): Bool =
  let line = Stdlib.String.trim(text)
  let word =
    (Stdlib.String.split(line, " ") |> Stdlib.List.head)
    |> Stdlib.Option.withDefault("")

  let keywords =
    [ "let"
      "val"
      "type"
      "module"
      "match"
      "|"
      "fun"
      "trait"
      "impl"
      "//" ]

  let quoted =
    Stdlib.String.startsWith(word, "(") || Stdlib.String.startsWith(word, "`")

  let capital =
    match Stdlib.String.toList(word) |> Stdlib.List.head with
    | Some(c) -> Stdlib.Char.isUppercase(c)
    | None -> false

  Stdlib.List.contains(keywords, word)
  || Stdlib.Bool.not(quoted) && Stdlib.String.contains(word, "(")
  || capital
     && (word == line
         || Stdlib.String.startsWith(
           Stdlib.String.dropFirst(line, Stdlib.String.length(word)),
           " {")
         || Stdlib.String.contains(word, ".")
            && Stdlib.Bool.not(startsAWord(line, word)))


/// Whether <param word> is followed by a plain word, as in prose: "Zero.zero has no ...".
let startsAWord(line: String, word: String): Bool =
  let rest =
    Stdlib.String.trimStart(
      Stdlib.String.dropFirst(line, Stdlib.String.length(word)))

  match Stdlib.String.toList(rest) |> Stdlib.List.head with
  | Some(c) -> Stdlib.Char.isLowercase(c)
  | None -> false


/// <param line> without a trailing `// comment` set off by two spaces.
let code(line: String): String =
  match Stdlib.String.indexOf(line, "  //") with
  | Some(i) -> Stdlib.String.first(line, i)
  | None -> line


/// A table lines up columns with two or more spaces between them.
let isTable(lines: List<String>): Bool =
  lines
  |> Stdlib.List.any(fun l ->
    Stdlib.String.contains(Stdlib.String.trim(code(l)), "  "))


/// A line's first column. A `#` comment after it stays, so it is reported: Dark comments are `//`.
let firstColumn(line: String): String =
  let columns =
    Stdlib.String.split(Stdlib.String.trim(code(line)), "  ")
    |> Stdlib.List.map(fun c -> Stdlib.String.trim(c))
    |> Stdlib.List.filter(fun c -> c != "")

  match columns with
  | [first, second, ...] when Stdlib.String.startsWith(second, "#") ->
    first + "  " + second
  | [first, ...] -> first
  | [] -> ""


/// The heredoc bodies in <param lines>, each with how to parse it: the body of a
/// `run - <<'EOF'` is a script, any other (`import - /X <<'EOF'`) is a package file.
let heredocs(
  lines: List<String>)
  : List<(LanguageTools.Parser.FileKind * String)> =
  let (bodies, _) =
    lines
    |> Stdlib.List.fold(([], Option.None), fun(acc, line) ->
      let (bodies, open) = acc
      match open with
      | None ->
        if Stdlib.String.contains(line, "<<'EOF'") then
          let kind =
            if Stdlib.String.startsWith(Stdlib.String.trim(line), "run ") then
              LanguageTools.Parser.FileKind.Script
            else
              LanguageTools.Parser.FileKind.Package

          (bodies, Option.Some((kind, [])))
        else
          acc
      | Some((kind, body)) ->
        if Stdlib.String.trim(line) == "EOF" then
          (
            [ (kind, Stdlib.String.join(Stdlib.List.reverse(body), "\n"))
              ...bodies ],
            Option.None)
        else
          (bodies, Option.Some((kind, [ line, ...body ]))))

  Stdlib.List.reverse(bodies)


/// An example as a script: match arms alone go inside a `match`, `...` stands for `()`, and
/// a closing `()` lets the example end on a `let`.
let asScript(source: String): String =
  let source =
    source
    |> Stdlib.String.replaceAll("(...)", "()")
    |> Stdlib.String.replaceAll("-> ...", "-> ()")
    |> Stdlib.String.replaceAll("= ...", "= ()")
    |> Stdlib.String.replaceAll(", ... ]", " ]")

  let source =
    if Stdlib.String.startsWith(source, "|") then
      "match x with\n" + source
    else
      source

  source + "\n()"


/// The Dark in <param block>, each with how to parse it.
let sources(
  block: List<String>)
  : List<(LanguageTools.Parser.FileKind * String)> =
  match block with
  | [] -> []
  | [first, ...] ->
    if
      Stdlib.List.any(block, fun l -> Stdlib.String.contains(l, "<<'EOF'"))
    then
      heredocs(block)
    else if
      Stdlib.List.contains(notCode, first)
      || Stdlib.String.startsWith(first, "type Stdlib.")
    then
      // `type Stdlib.X` shows a library type's shape.
      []
    else if Stdlib.Bool.not(looksLikeDark(first)) then
      []
    else if isTable(block) then
      block
      |> Stdlib.List.map(fun l -> firstColumn(l))
      |> Stdlib.List.filter(fun c -> looksLikeDark(c))
      |> Stdlib.List.map(fun c ->
        (LanguageTools.Parser.FileKind.Script, asScript(c)))
    else
      [ (
          LanguageTools.Parser.FileKind.Script,
          asScript(Stdlib.String.join(block, "\n"))) ]


let check(
  page: String,
  kind: LanguageTools.Parser.FileKind,
  source: String)
  : Option<String> =
  let (_, diagnostics) = LanguageTools.Parser.Parse.parse(kind, source)
  let wrong =
    Stdlib.String.contains(Stdlib.String.toLowercase(source), "// wrong")

  match diagnostics, wrong with
  | [], false -> Option.None
  | [_, ...], true -> Option.None
  | [], true -> Option.Some($"docs {page}: marked wrong, but parses:\n{source}")
  | [first, ...], false ->
    let why = LanguageTools.Parser.Parse.ParseError.diagnosticToString(first)
    Option.Some($"docs {page}: {why}\n{source}")


let failures(page: String, text: String): List<String> =
  blocks(text)
  |> Stdlib.List.map(fun b -> sources(b))
  |> Stdlib.List.flatten
  |> Stdlib.List.filterMap(fun((kind, source)) -> check(page, kind, source))


test everyDarkExampleParses =
  let found =
    pages()
    |> Stdlib.List.map(fun((page, text)) -> failures(page, text))
    |> Stdlib.List.flatten

  Stdlib.Test.expect(
    Stdlib.List.isEmpty(found),
    Stdlib.String.join(found, "\n\n"))


test theCheckFindsBrokenExamples =
  let page(lines: List<String>): String =
    lines
    |> Stdlib.List.map(fun l -> "  " + l)
    |> Stdlib.String.join("\n")

  Stdlib.Test.all(
    [ Stdlib.Test.expect(
        Stdlib.List.length(failures("t", page([ "let x = [1; 2]  # a list" ])))
        == 1,
        "a broken example is reported")

      Stdlib.Test.expect(
        Stdlib.List.isEmpty(
          failures("t", page([ "let x = [1; 2]  // wrong" ]))),
        "a broken one marked wrong is not")

      Stdlib.Test.expect(
        Stdlib.List.length(failures("t", page([ "let x = [1, 2]  // wrong" ])))
        == 1,
        "one marked wrong that parses is reported")

      Stdlib.Test.expect(
        Stdlib.List.length(
          failures("t", page([ "| Some x -> x", "| None -> 0" ])))
        == 1,
        "match arms are checked inside a match")

      Stdlib.Test.expect(
        Stdlib.List.isEmpty(
          failures("t", page([ "run Me.Greet.main Ada   # shell" ]))),
        "a shell line is left alone")

      Stdlib.Test.expect(
        Stdlib.List.length(
          failures(
            "t",
            page(
              [ "import - /Me.A <<'EOF'", "let f(): Int64 = 1 # x", "EOF" ])))
        == 1,
        "a heredoc's body is checked")

      Stdlib.Test.expect(
        Stdlib.List.isEmpty(
          failures(
            "t",
            page([ "run - Ada <<'EOF'", "Stdlib.printLine(\"hi\")", "EOF" ]))),
        "a `run -` heredoc is checked as a script")

      Stdlib.Test.expect(
        Stdlib.List.length(
          failures("t", page([ "run - <<'EOF'", "Stdlib.printLine(", "EOF" ])))
        == 1,
        "and a broken one is reported") ])
