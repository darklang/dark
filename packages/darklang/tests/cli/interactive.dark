/// Driving a full-screen CLI from a test.
///
/// Part of `Darklang.Cli.Tests`.
///
/// A spawned child gets pipes, not a terminal: `HostProcess.spawn` redirects all three
/// standard streams, so a `dark` started that way reports no tty and the workbench
/// correctly refuses to paint. Something has to allocate a pty, and in this container
/// that something is `expect`, which is also what the gate scripts use.
///
/// The whole interaction is one script and one child, rather than a session a test pokes
/// at: `expect` is built for exactly this, and a scripted round trip costs one process
/// instead of one per keystroke.
module Darklang.Cli.Tests.Interactive

/// One step of an interaction.
type Step =
  /// Wait for this text to appear, or fail the whole run.
  | Await(String)
  /// Send these keys. `expect`'s own notation, so "\r" is Enter and "\003" is Ctrl-C.
  | Send(String)


let escape(s: String): String =
  s
  |> Stdlib.String.replaceAll("\\", "\\\\")
  |> Stdlib.String.replaceAll("\"", "\\\"")
  |> Stdlib.String.replaceAll("$", "\\$")
  |> Stdlib.String.replaceAll("[", "\\[")
  |> Stdlib.String.replaceAll("]", "\\]")


/// A Tcl string literal. Built by concatenation rather than interpolation: an expect
/// script is mostly braces and quotes, and both are interpolation syntax here.
let quoted(s: String): String =
  let q = "\""
  q + (escape(s)) + q


let stepLine(step: Step): String =
  match step with
  | Await(text) ->
    // A timeout has to say WHAT it was waiting for, or a failure here reads as "the screen
    // was wrong" with no screen attached.
    let complaint = quoted("\nTIMED OUT waiting for: " + text)

    // Expect's braced pattern/action form needs newlines. A single-line
    // braced argument is treated as one pattern and silently times out.
    "expect {\n  -exact "
    + (quoted(text))
    + " {}\n  timeout { puts "
    + complaint
    + "; exit 2 }\n  eof { puts "
    + (quoted("\nEXITED BEFORE: " + text))
    + "; exit 3 }\n}"

  | Send(keys) ->
    // A key pressed while a frame is still painting is dropped, and the symptom is the
    // NEXT `Await` timing out rather than "the key did nothing". An `Await` before each
    // `Send` is the real fix and is how these should be written; the fifth of a second
    // covers the gap between the marker appearing and the frame finishing.
    "sleep 0.2\nsend -- " + (quoted(keys))


/// Whether this machine can run these tests. The dev container and CI both have expect;
/// a bare checkout might not, and a test should say so rather than fail obscurely.
let available(): Bool = Stdlib.Cli.Unix.isCommandAvailable("expect")


/// How long a child may take to start before a test's own timeout begins.
///
/// Starting is the part a busy machine stretches: the runtime loading, then the packages.
/// It takes about a second on an idle machine and several when other test suites are
/// running. Counting it against a ten-second step made a test fail because the machine
/// was busy, not because the thing it checks was slow.
val startupSeconds = 60


/// Tcl for `child_gone pid`: 1 once the child has exited, whether or not it is reaped yet.
///
/// Reads /proc where there is one, and asks `ps` where there isn't. Each alone breaks one
/// release platform, and there every child reads as gone, so each drive fails with "EXITED
/// BEFORE: the CLI was ready" before the child has loaded: macOS has no /proc, and Alpine's
/// BusyBox `ps` has no `-p`. An exited child stays a zombie (state Z) until the script's
/// `wait`.
val childGone =
  "proc child_gone {pid} {\n  if {[file isdirectory /proc/self]} {\n    if {[catch {set f [open /proc/$pid/stat]; set s [read $f]; close $f}]} { return 1 }\n    set fields [split [string range $s [string last \")\" $s] end] \" \"]\n    return [expr {[lindex $fields 1] eq \"Z\"}]\n  }\n  if {[catch {exec ps -o stat= -p $pid} s]} { return 1 }\n  return [string match Z* [string trim $s]]\n}"


/// Tcl that waits until the child has started, then returns.
///
/// "Started" is the `cli.pmInit` line in the child's telemetry log: the CLI writes it once
/// the runtime and packages are loaded, just before it runs the command. Nothing on the
/// screen says that, since `eval` prints nothing until its answer. The child is also
/// watched, so one that dies before it is ready says so at once instead of after the
/// whole startup budget.
let awaitStartup(telemetryLog: String): List<String> =
  [ childGone
    "set ready_by [expr {[clock milliseconds] + "
    + (Stdlib.display(startupSeconds * 1000))
    + "}]"
    // `gone` is read BEFORE the log, so a child that got ready and exited between the two
    // reads still counts as ready, and its output is still waiting for the first `Await`.
    "while {1} {\n  set gone [child_gone [exp_pid]]\n  if {[file exists "
    + (quoted(telemetryLog))
    + "]} {\n    set f [open "
    + (quoted(telemetryLog))
    + "]; set seen [read $f]; close $f\n    if {[string first \"\\\"cli.pmInit\\\"\" $seen] >= 0} break\n  }\n  if {$gone} { puts \"\\nEXITED BEFORE: the CLI was ready\"; exit 3 }\n  if {[clock milliseconds] > $ready_by} { puts \"\\nTIMED OUT waiting for the CLI to start\"; exit 2 }\n  after 50\n}" ]


/// Write an expect script to `path` and run it: Ok with its output if it exits 0.
let runScript(path: String, script: String): Stdlib.Result.Result<String, String> =
  match Stdlib.Cli.FileSystem.writeFile(path, Stdlib.Utf8.encode(script)) with
  | Error(e) -> Stdlib.Result.Result.Error($"could not write {path}: {e}")
  | Ok(_) ->
    let outcome =
      Stdlib.Cli.Unix.executeInDirectoryWithOutput(".", $"expect -f {path} 2>&1")

    if outcome.exitCode == 0 then
      Stdlib.Result.Result.Ok(outcome.stdout)
    else
      Stdlib.Result.Result.Error(outcome.stdout)


/// Run `dark <args>` on a real terminal in `i`, walk `steps`, return the transcript.
///
/// `timeoutSeconds` is per step and starts once the child is ready (see `startupSeconds`),
/// so it measures the thing under test rather than how busy the machine is.
///
/// The transcript is everything the child painted, escape sequences and all, which is
/// what you want in a failure message and what `Stdlib.String.contains` is happy to
/// search.
let drive(
  i: Instance.T,
  args: List<String>,
  steps: List<Step>,
  timeoutSeconds: Int64)
  : Stdlib.Result.Result<String, String> =
  if Stdlib.Bool.not(available()) then
    Stdlib.Result.Result.Error("expect is not installed")
  else
    // Parenthesised: Dark parses pipes greedily, so `Instance.env i |> ...` reads the
    // qualified name as the pipe's left-hand side and fails. Telemetry is on because its
    // log is how the script knows the child has started. TERM is set because the pty is a
    // terminal whatever shell started the test: CircleCI's macOS shell has no TERM, and
    // the workbench rightly refuses to start without one.
    let envPrefix =
      (Stdlib.List.concat(
        Instance.env(i),
        [ ("TERM", "xterm-256color"), ("DARK_TELEMETRY", "1") ]))
      |> Stdlib.List.map(fun pair ->
        let (k, v) = pair
        quoted($"{k}={v}"))
      |> Stdlib.String.join(" ")

    let argString =
      args |> Stdlib.List.map(quoted) |> Stdlib.String.join(" ")

    let telemetryLog = $"{i.dir}/logs/telemetry.jsonl"

    // The pane size is fixed so a layout assertion means the same thing on every machine;
    // the workbench refuses to start below its minimum. An earlier drive of the same
    // instance left its own log, so it goes first, or that run's line would say this child
    // was ready before it was.
    let header =
      Stdlib.List.concat(
        [ $"set timeout {Stdlib.display(timeoutSeconds)}",
          "set env(LINES) 50",
          "set env(COLUMNS) 200",
          "file delete -force -- " + (quoted(telemetryLog)),
          $"spawn /usr/bin/env {envPrefix} {quoted(i.cli)} {argString}" ],
        awaitStartup(telemetryLog))

    let body = steps |> Stdlib.List.map(fun s -> stepLine(s))

    // Steps must leave the child ready to exit (send q for a TUI). EOF and
    // successful exit are separate checks; neither may silently time out.
    let footer =
      [ "expect {\n  eof {}\n  timeout { puts \"TIMED OUT waiting for exit\"; exit 2 }\n}"
        "set result [wait]"
        "if {[llength $result] != 4 || [lindex $result 2] != 0 || [lindex $result 3] != 0} { puts \"CHILD EXIT FAILED: $result\"; exit 3 }"
        "exit 0" ]

    let script =
      (Stdlib.List.concat(header, Stdlib.List.concat(body, footer)))
      |> Stdlib.String.join("\n")

    runScript($"{i.dir}/drive.exp", script)


/// `drive`, as a test result.
let expectSteps(
  i: Instance.T,
  args: List<String>,
  steps: List<Step>,
  timeoutSeconds: Int64)
  : Stdlib.Test.Result =
  match drive(i, args, steps, timeoutSeconds) with
  | Ok(_) -> Stdlib.Test.Result.Pass
  | Error(transcript) ->
    let cmd = Stdlib.String.join(args, " ")
    Stdlib.Test.fail($"interactive `{cmd}` did not do what was asked:\n{transcript}")
