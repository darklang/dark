module Darklang.Cli.Tests.PermissionsDisplay

// Function reports omit instance defaults and warn about incomplete analysis.

module PermissionsDisplay =
  let packagePolicy(unit: Unit): LanguageTools.Permissions.Policy =
    LanguageTools.Permissions.Policy
      { allow =
          [ LanguageTools.Permissions.Rule.Effect(
              LanguageTools.Permissions.Effect.Http)

            LanguageTools.Permissions.Rule.Effect(
              LanguageTools.Permissions.Effect.Clock) ]
        deny = [] }


  let instancePolicy(unit: Unit): LanguageTools.Permissions.Policy =
    LanguageTools.Permissions.Policy
      { allow =
          [ LanguageTools.Permissions.Rule.Http(
              LanguageTools.Permissions.HttpRule
                { method = LanguageTools.Permissions.Scope.Only("GET")
                  scheme = LanguageTools.Permissions.Scope.Only("https")
                  host =
                    LanguageTools.Permissions.HostRule.Exact("api.example.com")
                  port = LanguageTools.Permissions.Scope.Only(443)
                  path = LanguageTools.Permissions.HttpPath.Subtree("/v1")
                  query = LanguageTools.Permissions.Scope.All }) ]
        deny = [] }


  let approved(unit: Unit): Cli.Permissions.Command.AccessReportFacts =
    Cli.Permissions.Command.AccessReportFacts
      { hash = "123456789abcdef"
        effects =
          [ LanguageTools.Permissions.Effect.Http
            LanguageTools.Permissions.Effect.Clock ]
        complete = true
        bundled = false
        approvals = [ ("Acme.Client.fetch", packagePolicy()) ]
        approvedAs = [ "Acme.Client.fetch" ]
        olderApproval = Stdlib.Option.Option.None
        instancePolicy = instancePolicy() }


  test approvedReport =
    Cli.Permissions.Command.renderAccessReport("Acme.Client.fetch", approved())
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: http, clock"
        "  Remembered approval for Acme.Client.fetch (version 12345678):"
        "    Allowed:"
        "      http"
        "      clock"
        "    Explicitly denied:"
        "      none" ])


  let unapproved(unit: Unit): Cli.Permissions.Command.AccessReportFacts =
    let facts = approved()
    { facts with
        effects = []
        complete = false
        approvals = []
        approvedAs = [] }


  test unapprovedReport =
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.fetch",
      unapproved())
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: not fully known"
        "  Warning: analysis is incomplete; more permissions may be needed."
        "  Remembered approval: none" ])


  test effectFreeReport =
    let facts = unapproved()
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.message",
      { facts with complete = true })
    |> Stdlib.Test.equal(
      [ "Acme.Client.message"
        "  Effects: none"
        "  Permissions needed: none"
        "  Remembered approval: none" ])


  test olderApprovalReport =
    let facts = unapproved()
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.fetch",
      { facts with
          complete = true
          olderApproval = Stdlib.Option.Option.Some("abcdef0123456789") })
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: none"
        "  Permissions needed: none"
        "  Remembered approval: for an older version (abcdef01); `permissions update Acme.Client.fetch` reviews this one" ])


/// What a denied `eval` or `run` prints: the denial and its remedy, exactly, with no
/// internal call stack. The path is worked out at runtime, so the denial comes from
/// inside the call rather than from the check before the run.
module Denials =
  /// Exit code and both streams, without colors, and unrecorded so no trace line follows the
  /// denial. Line by line, since `stripSgr` also drops newlines.
  let deny(i: Instance.T, args: List<String>): (Int64 * String) =
    let (code, out) = Instance.ran(i, [ "--no-trace", ...args ])
    let lines =
      Stdlib.String.split(out, "\n")
      |> Stdlib.List.map(fun line -> Stdlib.Cli.Tui.Text.stripSgr(line))

    (code, Stdlib.String.trim(Stdlib.String.join(lines, "\n")))


  /// A `run` of a script holding `source`.
  let runScript(i: Instance.T, source: String): (Int64 * String) =
    let path = $"{Instance.home(i)}/denied.dark"
    let _ = Stdlib.Cli.File.writeText(path, source)
    deny(i, [ "run", path ])


  val readAtRuntime =
    "Stdlib.Cli.File.readText(Stdlib.String.reverse(\"txt.terces/deined/\"))"


  val packageRemedy =
    "permission denied:\n  reading `/denied/secret.txt` is not allowed.\n\n`Tests.Denied.readAt` has no remembered approval. Remember this access:\n  dark permissions approve Tests.Denied.readAt \"file read '/denied/secret.txt'\"\n\nFor one run:\n  dark run --allow \"file read '/denied/secret.txt'\" …\n\nFor everything in its folder:\n  dark run --allow \"file read '/denied'\" …"


  val instanceRemedy =
    "permission denied by instance policy:\n  reading `/denied/secret.txt` is not allowed.\n\nTo allow:\n  dark permissions allow file read '/denied/secret.txt'\n\nFor everything in its folder:\n  dark permissions allow file read '/denied'\n\nPreview a policy for working in that folder:\n  dark permissions profile read-only '/denied'\n  This replaces the whole instance policy; add --yes to apply it.\n\nAgents:\n  Submit the exact allow command through your runner's approval flow.\n  The current approval mode applies.\n  After it succeeds, retry only if earlier side effects will not be repeated."


  // A package fn's denial names the fn and the command that approves it, and leaves
  // the runner hint to instance denials.
  test packageFnDenialNamesTheFnAndItsApproval = Instance.withInstance(fun i ->
    let source = $"{Instance.home(i)}/denied-module.dark"
    let _ =
      Stdlib.Cli.File.writeText(
        source,
        "let readAt(path: String): String =\n  match Stdlib.Cli.File.readText(path) with\n  | Ok(t) -> t\n  | Error(e) -> Stdlib.display(e)\n")

    let (saved, _) = Instance.ran(i, [ "module", "Tests.Denied", source ])
    let call =
      "Tests.Denied.readAt(Stdlib.String.reverse(\"txt.terces/deined/\"))"

    Stdlib.Test.all(
      [ saved |> Stdlib.Test.equal(0)

        deny(i, [ "eval", call ])
        |> Stdlib.Test.equal((1, "Error: " + packageRemedy))

        runScript(i, $"Stdlib.printLine({call})")
        |> Stdlib.Test.equal((1, packageRemedy)) ]))


  // A function that reads one file and writes another is offered read and write together,
  // first, so following the suggestion does not lead to a second denial.
  test readAndWriteAreSuggestedTogetherFirst = Instance.withInstance(fun i ->
    let source = $"{Instance.home(i)}/copy-module.dark"
    let _ =
      Stdlib.Cli.File.writeText(
        source,
        "let copy(path: String): Unit =\n  match Stdlib.Cli.File.readText(path) with\n  | Ok(t) ->\n    let _ = Stdlib.Cli.File.writeText(path + \".out\", t)\n    ()\n  | Error(_) -> ()\n")

    let (saved, _) = Instance.ran(i, [ "module", "Tests.Copy", source ])
    let (_, out) =
      deny(
        i,
        [ "eval"
          "Tests.Copy.copy(Stdlib.String.reverse(\"txt.terces/deined/\"))" ])

    let both = "\"file read '/denied'; file write '/denied'\""
    // The remember command, pasted: the same two rules as one argument.
    let (approvedCode, approved) =
      Instance.ran(
        i,
        [ "permissions"
          "approve"
          "Tests.Copy.copy"
          "file read '/denied'; file write '/denied'"
          "--yes" ])

    Stdlib.Test.all(
      [ saved |> Stdlib.Test.equal(0)
        Instance.says(
          out,
          $"Remember this access:\n  dark permissions approve Tests.Copy.copy {both}",
          "remembering covers both")

        Instance.says(
          out,
          $"It reads and writes files. For one run, both in that folder:\n  dark run --allow {both}",
          "and so does one run")

        Instance.doesNotSay(
          out,
          "For one run:\n",
          "with no read-only suggestion before it")

        Instance.exitedWith(
          approvedCode,
          0,
          $"and the remember command works: {approved}") ]))


  // An instance-policy denial gives the exact allow command and tells agents to submit
  // it through their runner's approval.
  test instanceDenialGivesTheAllowCommandAndRunnerHint =
    Instance.withInstance(fun i ->
      Stdlib.Test.all(
        [ deny(i, [ "eval", readAtRuntime ])
          |> Stdlib.Test.equal((1, "Error: " + instanceRemedy))

          runScript(i, $"let _ = {readAtRuntime}\n()")
          |> Stdlib.Test.equal((1, instanceRemedy)) ]))
