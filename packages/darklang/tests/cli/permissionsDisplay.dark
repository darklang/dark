module Darklang.Cli.Tests.PermissionsDisplay

// Function reports omit instance defaults and warn about incomplete analysis.

module PermissionsDisplay =
  let packagePolicy(unit: Unit): LanguageTools.Permissions.Policy =
    LanguageTools.Permissions.Policy
      { allow =
          [ LanguageTools.Permissions.Rule.Effect(
              LanguageTools.Permissions.Effect.Http)

            LanguageTools.Permissions.Rule.Effect(
              LanguageTools.Permissions.Effect.Clock) ]
        deny = [] }


  let instancePolicy(unit: Unit): LanguageTools.Permissions.Policy =
    LanguageTools.Permissions.Policy
      { allow =
          [ LanguageTools.Permissions.Rule.Http(
              LanguageTools.Permissions.HttpRule
                { method = LanguageTools.Permissions.Scope.Only("GET")
                  scheme = LanguageTools.Permissions.Scope.Only("https")
                  host =
                    LanguageTools.Permissions.HostRule.Exact("api.example.com")
                  port = LanguageTools.Permissions.Scope.Only(443)
                  path = LanguageTools.Permissions.HttpPath.Subtree("/v1")
                  query = LanguageTools.Permissions.Scope.All }) ]
        deny = [] }


  let approved(unit: Unit): Cli.Permissions.Command.AccessReportFacts =
    Cli.Permissions.Command.AccessReportFacts
      { hash = "123456789abcdef"
        effects =
          [ LanguageTools.Permissions.Effect.Http
            LanguageTools.Permissions.Effect.Clock ]
        complete = true
        bundled = false
        approvals = [ ("Acme.Client.fetch", packagePolicy()) ]
        approvedAs = [ "Acme.Client.fetch" ]
        olderApproval = Stdlib.Option.Option.None
        instancePolicy = instancePolicy() }


  test approvedReport =
    Cli.Permissions.Command.renderAccessReport("Acme.Client.fetch", approved())
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: http, clock"
        "  Remembered approval for Acme.Client.fetch (version 12345678):"
        "    Allowed:"
        "      http"
        "      clock"
        "    Explicitly denied:"
        "      none" ])


  let unapproved(unit: Unit): Cli.Permissions.Command.AccessReportFacts =
    let facts = approved()
    { facts with
        effects = []
        complete = false
        approvals = []
        approvedAs = [] }


  test unapprovedReport =
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.fetch",
      unapproved())
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: not fully known"
        "  Warning: analysis is incomplete; more permissions may be needed."
        "  Remembered approval: none" ])


  test effectFreeReport =
    let facts = unapproved()
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.message",
      { facts with complete = true })
    |> Stdlib.Test.equal(
      [ "Acme.Client.message"
        "  Effects: none"
        "  Permissions needed: none"
        "  Remembered approval: none" ])


  test olderApprovalReport =
    let facts = unapproved()
    Cli.Permissions.Command.renderAccessReport(
      "Acme.Client.fetch",
      { facts with
          complete = true
          olderApproval = Stdlib.Option.Option.Some("abcdef0123456789") })
    |> Stdlib.Test.equal(
      [ "Acme.Client.fetch"
        "  Effects: none"
        "  Permissions needed: none"
        "  Remembered approval: for an older version (abcdef01); `permissions update Acme.Client.fetch` reviews this one" ])
