/// CLI tests: `dark deprecate`, and what a deprecation does to calls and listings.
module Darklang.Cli.Tests.Deprecate

// Exercise the execution block and its override through the CLI process.
test harmfulGate = Instance.withInstance(fun i ->
  let fnName = "Tests.HarmGate.g"
  let onMain(args: List<String>): String =
    Instance.output(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let _ = onMain([ "fn", fnName, "(x: Int64) : Int64 = (x + 31)" ])
  let _ =
    onMain(
      [ "deprecate", "fn", fnName, "--block-execution", "-m", "test", "--yes" ])

  let halted = onMain([ "eval", $"{fnName}(0)" ])
  let allowed = onMain([ "eval", $"{fnName}(0)", "--allow-harmful" ])
  Stdlib.Test.all(
    [ Instance.says(
        halted,
        "Harmful",
        "a fn marked harmful refuses to run without the flag")

      // The halt message names `--allow-harmful`, so the flag has to do what the message promises.
      Instance.says(allowed, "31", "--allow-harmful runs it anyway") ]))


/// Two names holding one body are one item, so deleting or deprecating one must be said at the
/// name: the other name stays undeprecated and resolvable.
test deprecateLeavesATwinAlone = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let hashOf = fun name -> Stdlib.String.trim(said([ "hash", name ]))
  let _ = said([ "val", "Tests.Twins.kept", "= 770031" ])
  let _ = said([ "val", "Tests.Twins.probe", "= 770031" ])
  let deprecated = said([ "deprecate", "Tests.Twins.probe", "--yes" ])
  if hashOf("Tests.Twins.kept") != hashOf("Tests.Twins.probe") then
    Stdlib.Test.fail(
      "the two names should hold one item, or this tests nothing")
  else
    Stdlib.Test.all(
      [ Instance.says(
          deprecated,
          "1 other name shares this code and is unaffected",
          "deprecate says the code is shared")

        Instance.says(
          said([ "undeprecate", "Tests.Twins.kept" ]),
          "is not deprecated",
          "the other name is left alone")

        Instance.says(
          said([ "eval", "Tests.Twins.kept" ]),
          "770031",
          "and still resolves")

        Instance.says(
          said([ "undeprecate", "Tests.Twins.probe" ]),
          "Undeprecated",
          "the name given was deprecated") ]))


/// Harmful is about the code, not the name: marking one name halts calls through every name holding
/// that code, and undoing it at one name clears it for all of them.
test harmfulMarksEveryTwin = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let _ =
    said([ "fn", "Tests.HarmTwins.a", "(x: Int64) : Int64 = (x + 770032)" ])

  let _ =
    said([ "fn", "Tests.HarmTwins.b", "(x: Int64) : Int64 = (x + 770032)" ])

  let marked =
    said(
      [ "deprecate", "fn", "Tests.HarmTwins.a", "--block-execution", "--yes" ])

  let haltedB = said([ "eval", "Tests.HarmTwins.b(0)" ])
  let cleared = said([ "undeprecate", "Tests.HarmTwins.b" ])
  Stdlib.Test.all(
    [ Instance.says(
        marked,
        "1 other name shares this code and is also marked harmful: Tests.HarmTwins.b",
        "harmful names the others")

      Instance.says(haltedB, "Harmful", "a call through the twin halts")

      Instance.says(
        cleared,
        "no longer harmful: Tests.HarmTwins.a",
        "undoing it at the twin clears both")

      Instance.says(
        said([ "eval", "Tests.HarmTwins.a(0)" ]),
        "770032",
        "so the first name runs again") ]))


/// `ls` lists names: after deleting one of two names holding the same code, only the other is listed.
test lsDropsADeletedTwin = Instance.withInstance(fun i ->
  let said = fun args ->
    Instance.said(i, Stdlib.List.concat([ "--branch", "main" ], args))

  let _ = said([ "val", "Tests.LsTwins.kept", "= 770033" ])
  let _ = said([ "val", "Tests.LsTwins.probe", "= 770033" ])
  let _ = said([ "delete", "Tests.LsTwins.probe", "--yes" ])
  let listed = said([ "ls", "Tests.LsTwins" ])
  Stdlib.Test.all(
    [ Instance.says(listed, "kept", "the twin is still listed")
      Instance.doesNotSay(
        listed,
        "⚠",
        "and nothing listed is marked deprecated")

      Instance.doesNotSay(listed, "probe", "the deleted name is not") ]))


test executionBlocksFollowTheSelectedBranch = Instance.withInstance(fun i ->
  let name = "Tests.BranchExecutionBlock.entry"
  let _ = Instance.ran(i, [ "fn", name, "(): Int64 = 1414 - 1414" ])

  let (blockedOnMain, _) =
    Instance.ran(i, [ "deprecate", name, "--block-execution", "--yes" ])

  let (committed, _) =
    Instance.ran(i, [ "commit", "-m", "Block entry on main", "--yes" ])

  let (created, _) = Instance.ran(i, [ "branch", "create", "block-child" ])
  let onChild = fun args ->
    Instance.ran(i, [ "--branch", "block-child", ...args ])

  let onMain = fun args -> Instance.ran(i, [ "--branch", "main", ...args ])
  let (inherited, inheritedOut) = onChild([ "run", name ])
  let (restored, _) = onChild([ "restore", name ])
  let (restoredRun, _) = onChild([ "run", name ])
  let (deleted, deletion) = onChild([ "delete", name, "--yes" ])
  let (deprecatedRun, _) = onChild([ "run", name ])
  let (mainRun, mainOut) = onMain([ "run", name ])
  Stdlib.Test.all(
    [ Instance.exitedWith(blockedOnMain, 0, "block on main")
      Instance.exitedWith(committed, 0, "commit the block")
      Instance.exitedWith(created, 0, "create a child branch")
      Instance.exitedWith(inherited, 1, "the committed block is inherited")
      Instance.says(
        inheritedOut,
        "--allow-harmful",
        "run reports the inherited block")

      Instance.exitedWith(restored, 0, "restore on the child")
      Instance.exitedWith(restoredRun, 0, "the child can now run it")
      Instance.exitedWith(deleted, 0, "delete on the child")
      Instance.says(
        deletion,
        "(still callable)",
        "explains the effect on the child")

      Instance.exitedWith(
        deprecatedRun,
        0,
        "the child can still run it after plain deprecation")

      Instance.exitedWith(mainRun, 1, "main is still blocked")
      Instance.says(
        mainOut,
        "--allow-harmful",
        "run on main still reports the block") ]))


test executionBlockOnChildLeavesMainCallable = Instance.withInstance(fun i ->
  let name = "Tests.ChildExecutionBlock.entry"
  let _ = Instance.ran(i, [ "fn", name, "(): Int64 = 1726 - 1726" ])

  let (committed, _) =
    Instance.ran(i, [ "commit", "-m", "Add callable entry", "--yes" ])

  let (created, _) = Instance.ran(i, [ "branch", "create", "local-block" ])

  let (blocked, _) =
    Instance.ran(
      i,
      [ "--branch"
        "local-block"
        "deprecate"
        name
        "--block-execution"
        "--yes" ])

  let (childRun, childOut) =
    Instance.ran(i, [ "--branch", "local-block", "run", name ])

  let (mainRun, _) = Instance.ran(i, [ "--branch", "main", "run", name ])
  Stdlib.Test.all(
    [ Instance.exitedWith(committed, 0, "commit the callable entry")

      Instance.exitedWith(created, 0, "create a child branch")

      Instance.exitedWith(blocked, 0, "block execution on the child")

      Instance.exitedWith(
        childRun,
        1,
        "a draft block takes effect on the child")

      Instance.says(
        childOut,
        "--allow-harmful",
        "run reports the child's block")

      Instance.exitedWith(mainRun, 0, "main can still run it") ]))
