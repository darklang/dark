/// What a one-shot command writes to a terminal: no keypad-mode switch, and under `NO_COLOR` no
/// reset left behind by a colour that was taken out.
module Darklang.Cli.Tests.TerminalEscapes

/// Everything a command wrote, run with its stdout and stderr on a terminal.
let onTerminal(
  i: Instance.T,
  env: List<(String * String)>,
  args: List<String>)
  : String =
  let out =
    Instance.call(i, { Instance.command(args) with env = env, tty = true })

  out.stdout + out.stderr


test oneShotCommandsLeaveKeypadModeAlone = Instance.withInstance(fun i ->
  let out = onTerminal(i, [ ("CLICOLOR_FORCE", "") ], [ "version", "--local" ])
  Stdlib.Test.all(
    [ Instance.says(out, "Darklang CLI", "the version is printed")
      Instance.doesNotSay(out, "\u001b[?1h", "no keypad mode")
      Instance.doesNotSay(out, "\u001b=", "no keypad mode") ]))


/// How many times `needle` appears in `out`.
let count(out: String, needle: String): Int64 =
  Stdlib.List.length(Stdlib.String.split(out, needle)) - 1


test noColorLeavesNoStrayReset = Instance.withInstance(fun i ->
  let env = [ ("NO_COLOR", "1"), ("CLICOLOR_FORCE", "") ]
  let value = onTerminal(i, env, [ "--no-trace", "eval", "1" ])
  let status = onTerminal(i, env, [ "status" ])
  let resets = count(status, "\u001b[0m")
  let styles = count(status, "\u001b[") - resets
  Stdlib.Test.all(
    [ Instance.says(value, "1", "the value is printed")
      Instance.doesNotSay(value, "\u001b", "a plain value has no escape codes")
      Instance.says(status, "On branch main", "status answers")
      resets |> Stdlib.Test.equal(styles) ]))


/// Each argument reaches the command as one word, spaces, quotes and parentheses included.
test argumentsReachTheTerminalIntact = Instance.withInstance(fun i ->
  let out = onTerminal(i, [], [ "eval", "Stdlib.String.length(\"it's a b\")" ])
  Instance.says(out, "8", "the whole expression was evaluated"))


test noColorFlagTakesTheColourOut = Instance.withInstance(fun i ->
  let env = [ ("NO_COLOR", ""), ("CLICOLOR_FORCE", "") ]
  let plain = onTerminal(i, env, [ "status" ])
  let before = onTerminal(i, env, [ "--no-color", "status" ])
  let after = onTerminal(i, env, [ "status", "--no-color" ])
  Stdlib.Test.all(
    [ Instance.says(plain, "\u001b[32m", "status is coloured on a terminal")
      Instance.says(before, "On branch main", "status answers")
      Instance.doesNotSay(before, "\u001b[32m", "--no-color before the command")
      Instance.says(after, "On branch main", "status answers")
      Instance.doesNotSay(
        after,
        "\u001b[32m",
        "--no-color after the command") ]))
