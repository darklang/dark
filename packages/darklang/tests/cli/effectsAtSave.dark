/// A save says what a fn's effects are, and a review flags a fn that does more than before.
module Darklang.Cli.Tests.EffectsAtSave

val pureFn: String = "(path: String): String = path + \"/fx-7731\""


val readsFn: String =
  "(path: String): String = Stdlib.Cli.File.readText(path + \"/fx-7731\") |> Stdlib.Result.withDefault(\"\")"


test aPureFnSaysNone = Instance.withInstance(fun i ->
  let (_, out, _) = Instance.streams(i, [ "fn", "Me.Fx.f", pureFn ])
  Instance.says(out, "\n  effects: none", "on stdout, under the save line"))


test anEffectfulFnNamesThem = Instance.withInstance(fun i ->
  let (_, out, _) = Instance.streams(i, [ "fn", "Me.Fx.f", readsFn ])
  Instance.says(out, "\n  effects: file-read", "the effect it has"))


test aSaveSaysWhatChanged = Instance.withInstance(fun i ->
  let _ = Instance.ran(i, [ "fn", "Me.Fx.f", pureFn ])
  let (_, impure, _) = Instance.streams(i, [ "fn", "Me.Fx.f", readsFn ])
  let (_, pureAgain, _) = Instance.streams(i, [ "fn", "Me.Fx.f", pureFn ])
  Stdlib.Test.all(
    [ Instance.says(impure, "(was none)", "it had none before")

      Instance.says(
        pureAgain,
        "effects: none (no longer file-read",
        "and dropped it") ]))


test aModuleSaveNamesEachFn = Instance.withInstance(fun i ->
  let path = Instance.home(i) + "/fx.dark"
  let source = $"let f{pureFn}\nlet g{readsFn}"
  let _ = Stdlib.Cli.File.writeAtomic(path, source) |> Builtin.unwrap
  let (_, out, _) = Instance.streams(i, [ "import", path, "/Me.Fx" ])
  Stdlib.Test.all(
    [ Instance.says(out, "effects of f: none", "the pure one")
      Instance.says(out, "effects of g: file-read", "the one that reads") ]))


test aReviewFlagsNewEffects = Instance.withInstance(fun i ->
  let _ = Instance.ran(i, [ "fn", "Me.Fx.f", pureFn ])
  let _ = Instance.ran(i, [ "commit", "pure", "-y" ])
  let _ = Instance.ran(i, [ "fn", "Me.Fx.f", readsFn ])
  Stdlib.Test.all(
    [ Instance.says(
        Instance.said(i, [ "diff" ]),
        "updated, now also file-read",
        "the draft diff")

      Instance.says(
        Instance.said(i, [ "diff", "--json" ]),
        "\"newEffects\":[\"file-read\"",
        "and its JSON") ]))


test aBranchDiffFlagsNewEffects = Instance.withInstance(fun i ->
  let _ = Instance.ran(i, [ "fn", "Me.Fx.f", pureFn ])
  let _ = Instance.ran(i, [ "commit", "pure", "-y" ])
  let _ = Instance.ran(i, [ "switch", "-c", "fx" ])
  let _ = Instance.ran(i, [ "fn", "Me.Fx.f", readsFn ])
  let _ = Instance.ran(i, [ "commit", "reads", "-y" ])
  let _ = Instance.ran(i, [ "switch", "main" ])
  Stdlib.Test.all(
    [ Instance.says(
        Instance.said(i, [ "diff", "fx" ]),
        "now also file-read",
        "the branch diff")

      Instance.says(
        Instance.said(i, [ "merge", "fx", "--dry-run" ]),
        "now also file-read",
        "the merge preview") ]))


/// `Stdlib.List.shuffle` came from the package reload; the same body saved as a module must get
/// the same effects.
test aModuleSaveAgreesWithTheReload = Instance.withInstance(fun i ->
  let path = Instance.home(i) + "/shuffle.dark"
  let source =
    Stdlib.String.join(
      [ "let shuffle(list: List<'a>): List<'a> ="
        "  let last = Stdlib.List.length(list) - 1"
        "  let start = Stdlib.Dict.fromEntries(Stdlib.List.indexedMap(list, fun(i, v) -> (i, v)))"
        "  let shuffled = Stdlib.List.fold(Stdlib.List.reverse(Stdlib.List.range(1, last)), start, fun(items, i) ->"
        "    let j = Stdlib.Int64.random(0, i)"
        "    match Stdlib.Dict.get(items, i), Stdlib.Dict.get(items, j) with"
        "    | Some(atI), Some(atJ) -> Stdlib.Dict.set(Stdlib.Dict.set(items, i, atJ), j, atI)"
        "    | _ -> items)"
        ""
        "  Stdlib.List.filterMap(Stdlib.List.range(0, last), fun i -> Stdlib.Dict.get(shuffled, i))" ],
      "\n")

  let _ = Stdlib.Cli.File.writeAtomic(path, source) |> Builtin.unwrap
  let _ = Instance.ran(i, [ "import", path, "/Me.Fx" ])
  Stdlib.Test.equal(
    Instance.said(i, [ "effects", "Me.Fx.shuffle" ]),
    Instance.said(i, [ "effects", "Stdlib.List.shuffle" ])))
