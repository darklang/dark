module Darklang.Cli.Tests.Scripts

test unitSucceeds =
  Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DUnit)
  |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))


test integerExitCodes =
  Stdlib.Test.all(
    [ Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DBigInt(7z))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(7))

      Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DInt64(3))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))

      Cli.Run.exitCode(
        LanguageTools.RuntimeTypes.Dval.DBigInt(9223372036854775808z))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1)) ])


test invalidResultKeepsValue =
  let returned = LanguageTools.RuntimeTypes.Dval.DBool(true)
  match Cli.Run.exitCode(returned) with
  | Error(Runtime(CLI(NonIntReturned(actual)), [], [])) ->
    actual |> Stdlib.Test.equal(returned)
  | _ ->
    Stdlib.Test.fail("Expected a script result error with the returned value")


module Eval =
  let evaluate(
    source: String)
    : Stdlib.Result.Result<
    Stdlib.Option.Option<String>,
    Cli.ExecutionError.ExecutionError> =
    Cli.Eval.evaluateRaw(
      Stdlib.Option.Option.None,
      SCM.Branch.mainBranchId,
      source,
      [],
      Cli.Eval.Harmful.Halt)


  test unitIsSilent =
    evaluate("()")
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(Stdlib.Option.Option.None))


  test stringsAreUnquoted =
    evaluate("\"hello\\nworld\"")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some("hello\nworld")))


  test otherValuesArePrinted =
    evaluate("[1, 2]")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some("[1, 2]")))


module CallStack =
  let source(): LanguageTools.RuntimeTypes.ExecutionPoint =
    LanguageTools.RuntimeTypes.ExecutionPoint.Source


  let builtin(): LanguageTools.RuntimeTypes.ExecutionPoint =
    LanguageTools.RuntimeTypes.ExecutionPoint.Function(
      LanguageTools.RuntimeTypes.FQFnName.FQFnName.Builtin(
        LanguageTools.RuntimeTypes.FQFnName.Builtin
          { name = "bigIntDivide", version = 0s32 }))


  let render(frames: List<LanguageTools.RuntimeTypes.ExecutionPoint>): String =
    PrettyPrinter.RuntimeTypes.callStack(SCM.Branch.mainBranchId, frames)


  test emptyStack =
    render([]) |> Stdlib.Test.equal("Call stack (last call at bottom):")


  test groupsOnlyConsecutiveFrames =
    render([ source(), builtin(), builtin(), source() ])
    |> Stdlib.Test.equal(
      "Call stack (last call at bottom):\n- Source\n- Builtin Function bigIntDivide (×2)\n- Source")


  test lambdaLabel =
    PrettyPrinter.RuntimeTypes.executionPoint(
      SCM.Branch.mainBranchId,
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(),
        23u64,
        Stdlib.Option.Option.None))
    |> Stdlib.Test.equal("Lambda 23")


  // A lambda is shown with the fn it was written in, when that is known.
  test lambdaLabelSaysWhereItWasWritten =
    PrettyPrinter.RuntimeTypes.executionPoint(
      SCM.Branch.mainBranchId,
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        builtin(),
        23u64,
        Stdlib.Option.Option.Some(source())))
    |> Stdlib.Test.equal("Lambda in Source (23)")


  // A script's ids change on every parse; its lines do not.
  test lambdaLabelGivesItsLine =
    PrettyPrinter.RuntimeTypes.executionPointAt(
      SCM.Branch.mainBranchId,
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        builtin(),
        23u64,
        Stdlib.Option.Option.Some(source())),
      [ (22u64, 3), (23u64, 4) ])
    |> Stdlib.Test.equal("Lambda in Source (line 4)")


  /// A crash in these frames, as `run` and `eval` see it.
  let whereLines(
    frames: List<LanguageTools.RuntimeTypes.ExecutionPoint>,
    entry: Cli.ExecutionError.Entry)
    : List<String> =
    Cli.ExecutionError.whereLines(
      SCM.Branch.mainBranchId,
      Cli.ExecutionError.ExecutionError.Runtime(
        LanguageTools.RuntimeTypes.RuntimeError.Error.DecimalOutOfRange,
        frames,
        [ (23u64, 4) ]),
      entry)


  // Only the user's code is shown: a builtin and the source of a one-line call are not.
  test whereLinesLeaveOutWhatTheUserDidNotWrite =
    let scriptLambda =
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(),
        23u64,
        Stdlib.Option.Option.Some(source()))

    Stdlib.Test.all(
      [ whereLines([ source(), builtin() ], Cli.ExecutionError.Entry.Script)
        |> Stdlib.Test.equal([])

        whereLines(
          [ source(), scriptLambda, builtin() ],
          Cli.ExecutionError.Entry.Call)
        |> Stdlib.Test.equal([])

        whereLines(
          [ source(), scriptLambda, builtin() ],
          Cli.ExecutionError.Entry.Script)
        |> Stdlib.Test.equal([ "  in line 4 of the script" ])

        whereLines(
          [ source(), scriptLambda, scriptLambda, builtin() ],
          Cli.ExecutionError.Entry.Script)
        |> Stdlib.Test.equal([ "  in line 4 of the script (×2)" ]) ])


  test processStacksUseTheSharedType =
    let frame =
      LanguageTools.Exec.ExecutionPoint.Lambda(
        LanguageTools.Exec.ExecutionPoint.Source,
        18446744073709551615u64,
        Stdlib.Option.Option.None)

    PrettyPrinter.RuntimeTypes.executionPoint(SCM.Branch.mainBranchId, frame)
    |> Stdlib.Test.equal("Lambda 18446744073709551615")


/// A script's tests run under `test run`, seeing its declarations and none of its statements;
/// `run` skips them.
test scriptTestsSeeDeclarationsOnly = Instance.withInstance(fun i ->
  let path = $"{Instance.home(i)}/todo.dark"
  let source =
    [ "val factor = 2"
      "let double(x: Int64): Int64 = x * factor"
      "test doubles = Stdlib.Test.equal(double(4), 8)"
      "test wrong = Stdlib.Test.equal(double(1), 3)"
      "Stdlib.printLine(\"statement ran\")"
      "0" ]
    |> Stdlib.String.join("\n")

  let _ = Stdlib.Cli.File.writeText(path, source)
  let (testCode, tested) = Instance.ran(i, [ "test", "run", "--verbose", path ])
  let (runCode, ran) = Instance.ran(i, [ "run", path ])
  let (_, status) = Instance.ran(i, [ "status" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(testCode, 1, $"a test failed: {tested}")
      Instance.says(tested, "PASS Script.doubles", "the passing test")
      Instance.says(tested, "FAIL Script.wrong", "the failing test")
      Instance.doesNotSay(
        tested,
        "statement ran",
        "no statement runs under test")

      Instance.exitedWith(runCode, 0, $"run skips the tests: {ran}")
      Instance.says(ran, "statement ran", "run runs the statements")
      Instance.doesNotSay(
        status,
        "draft:",
        "nothing the run saved is left in the draft") ]))


/// A script test that reaches a top-level `let` through a function below it, directly or through
/// a chain of them, or calls a function below the `let` at all, is refused before any test or
/// statement runs.
test scriptTestUsesLet = Instance.withInstance(fun i ->
  let path = $"{Instance.home(i)}/sales.dark"
  let source =
    [ "test totalForEast = Stdlib.Test.equal(total(\"east\"), 120)"
      "test countsRows = Stdlib.Test.equal(count(), 1)"
      "test greets = Stdlib.Test.equal(greet(), \"hi\")"
      "let rows = [ 120 ]"
      "let total(region: String): Int64 = Stdlib.List.length(rows)"
      "let size(): Int64 = Stdlib.List.length(rows)"
      "let count(): Int64 = size()"
      "let greet(): String = \"hi\""
      "Stdlib.printLine(\"statement ran\")" ]
    |> Stdlib.String.join("\n")

  let _ = Stdlib.Cli.File.writeText(path, source)
  let (code, out) = Instance.ran(i, [ "test", "run", "--verbose", path ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 1, $"refused: {out}")
      Instance.says(
        out,
        "error[SCRIPT-TEST-USES-LET] at 1:39: `totalForEast` calls `total`, which uses the top-level `let rows` on line 4.\n  hint: make it a `val` if it's a constant, or pass it to `total` as an argument",
        "the direct call")

      Instance.says(
        out,
        "error[SCRIPT-TEST-USES-LET] at 2:37: `countsRows` calls `count`, which calls `size`, which uses the top-level `let rows` on line 4.\n  hint: make it a `val` if it's a constant, or pass it to `size` as an argument",
        "the call through another function")

      Instance.says(
        out,
        "error[SCRIPT-TEST-BELOW-LET] at 3:33: `greets` calls `greet`, which is defined below the top-level `let rows` on line 4.\n  hint: move `greet` above line 4",
        "the call to a function below the let that doesn't use it")

      Instance.doesNotSay(out, "PASS", "no test runs")
      Instance.doesNotSay(out, "statement ran", "no statement runs") ]))


/// A test that uses only functions and `val`s still runs when a top-level `let` sits below it,
/// even through a lambda parameter named like the `let`.
test scriptTestAboveLetRuns = Instance.withInstance(fun i ->
  let path = $"{Instance.home(i)}/size.dark"
  let source =
    [ "val factor = 2"
      "let double(x: Int64): Int64 = x * factor"
      "test doubles = Stdlib.Test.equal(double(4), 8)"
      "test shadows = Stdlib.Test.equal(Stdlib.List.map([ 1 ], fun rows -> rows), [ 1 ])"
      "let rows = [ 1, 2 ]"
      "let size(): Int64 = Stdlib.List.length(rows)"
      "Stdlib.printLine(Stdlib.display(size()))" ]
    |> Stdlib.String.join("\n")

  let _ = Stdlib.Cli.File.writeText(path, source)
  let (testCode, tested) = Instance.ran(i, [ "test", "run", "--verbose", path ])
  let (runCode, ran) = Instance.ran(i, [ "run", path ])
  Stdlib.Test.all(
    [ Instance.exitedWith(testCode, 0, $"the tests pass: {tested}")
      Instance.says(tested, "PASS Script.doubles", "the function and val test")
      Instance.says(tested, "PASS Script.shadows", "the lambda parameter test")
      Instance.exitedWith(runCode, 0, $"run still works: {ran}")
      Instance.says(ran, "2", "run uses the let") ]))
