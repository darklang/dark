module Darklang.Cli.Tests.Scripts

test unitSucceeds =
  Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DUnit)
  |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))


test integerExitCodes =
  Stdlib.Test.all(
    [ Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DBigInt(7z))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(7))

      Cli.Run.exitCode(LanguageTools.RuntimeTypes.Dval.DInt64(3))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(3))

      Cli.Run.exitCode(
        LanguageTools.RuntimeTypes.Dval.DBigInt(9223372036854775808z))
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1)) ])


test invalidResultKeepsValue =
  let returned = LanguageTools.RuntimeTypes.Dval.DBool(true)
  match Cli.Run.exitCode(returned) with
  | Error(Runtime(CLI(NonIntReturned(actual)), [])) ->
    actual |> Stdlib.Test.equal(returned)
  | _ ->
    Stdlib.Test.fail("Expected a script result error with the returned value")


module Eval =
  let evaluate(
    source: String)
    : Stdlib.Result.Result<
    Stdlib.Option.Option<String>,
    Cli.ExecutionError.ExecutionError> =
    Cli.Eval.evaluateRaw(
      Stdlib.Option.Option.None,
      SCM.Branch.mainBranchId,
      source,
      [],
      Cli.Eval.Harmful.Halt)


  test unitIsSilent =
    evaluate("()")
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(Stdlib.Option.Option.None))


  test stringsAreUnquoted =
    evaluate("\"hello\\nworld\"")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some("hello\nworld")))


  test otherValuesArePrinted =
    evaluate("[1, 2]")
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(Stdlib.Option.Option.Some("[1, 2]")))


module CallStack =
  let source(): LanguageTools.RuntimeTypes.ExecutionPoint =
    LanguageTools.RuntimeTypes.ExecutionPoint.Source


  let builtin(): LanguageTools.RuntimeTypes.ExecutionPoint =
    LanguageTools.RuntimeTypes.ExecutionPoint.Function(
      LanguageTools.RuntimeTypes.FQFnName.FQFnName.Builtin(
        LanguageTools.RuntimeTypes.FQFnName.Builtin
          { name = "bigIntDivide", version = 0s32 }))


  let render(frames: List<LanguageTools.RuntimeTypes.ExecutionPoint>): String =
    PrettyPrinter.RuntimeTypes.callStack(SCM.Branch.mainBranchId, frames)


  test emptyStack =
    render([]) |> Stdlib.Test.equal("Call stack (last call at bottom):")


  test groupsOnlyConsecutiveFrames =
    render([ source(), builtin(), builtin(), source() ])
    |> Stdlib.Test.equal(
      "Call stack (last call at bottom):\n- Source\n- Builtin Function bigIntDivide (×2)\n- Source")


  test lambdaLabel =
    PrettyPrinter.RuntimeTypes.executionPoint(
      SCM.Branch.mainBranchId,
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(),
        23u64,
        Stdlib.Option.Option.None))
    |> Stdlib.Test.equal("Lambda 23")


  // A lambda is shown with the fn it was written in, when that is known.
  test lambdaLabelSaysWhereItWasWritten =
    PrettyPrinter.RuntimeTypes.executionPoint(
      SCM.Branch.mainBranchId,
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        builtin(),
        23u64,
        Stdlib.Option.Option.Some(source())))
    |> Stdlib.Test.equal("Lambda in Source (23)")


  test entryOnlyStacksAreHidden =
    let lambda =
      LanguageTools.RuntimeTypes.ExecutionPoint.Lambda(
        source(),
        23u64,
        Stdlib.Option.Option.None)

    Stdlib.Test.all(
      [ Cli.ExecutionError.hasReadableFrames([ source(), lambda ])
        |> Stdlib.Test.equal(false)

        Cli.ExecutionError.hasReadableFrames([ source(), builtin() ])
        |> Stdlib.Test.equal(true) ])


  test processStacksUseTheSharedType =
    let frame =
      LanguageTools.Exec.ExecutionPoint.Lambda(
        LanguageTools.Exec.ExecutionPoint.Source,
        18446744073709551615u64,
        Stdlib.Option.Option.None)

    PrettyPrinter.RuntimeTypes.executionPoint(SCM.Branch.mainBranchId, frame)
    |> Stdlib.Test.equal("Lambda 18446744073709551615")
