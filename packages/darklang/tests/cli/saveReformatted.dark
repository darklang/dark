/// A save that reformats the code says nothing about it; `view` shows the stored form.
module Darklang.Cli.Tests.SaveReformatted

test fnSaveDoesNotReprint = Instance.withInstance(fun i ->
  let (code, out, _) =
    Instance.streams(
      i,
      [ "fn", "Me.Fmt.double", "(x: Int64): Int64 = (x * 2)" ])

  let (_, viewed, _) = Instance.streams(i, [ "view", "--raw", "Me.Fmt.double" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 0, "the save")
      Instance.doesNotSay(out, "x * 2", "nothing reprinted")
      Instance.says(
        viewed,
        "let double(x: Int64): Int64 =\n  x * 2",
        "view shows it") ]))


test moduleSaveDoesNotReprint = Instance.withInstance(fun i ->
  let path = Instance.home(i) + "/mod.dark"
  let source =
    "let top(x: Int64): Int64 = x+1\n\nmodule Sub =\n  let c(x: Int64): Int64 = (x+3)\n"

  let _ = Stdlib.Cli.File.writeAtomic(path, source) |> Builtin.unwrap
  let (code, out, _) = Instance.streams(i, [ "import", path, "/Me.Fmt" ])
  Stdlib.Test.all(
    [ Instance.exitedWith(code, 0, "the save")
      Instance.doesNotSay(out, "x + 1", "nothing reprinted")
      Instance.doesNotSay(out, "x + 3", "nor in a submodule") ]))


test aPatchWithATypeErrorShowsTheDeclarationOnce =
  Instance.withInstance(fun i ->
    let _ = Instance.ran(i, [ "fn", "Me.Fmt.inc", "(x: Int64): Int64 = x + 1" ])
    let patch = "@@\n let inc(x: Int64): Int64 =\n-  x + 1\n+  (x + \"one\")\n"
    let (code, out) =
      Instance.runWithStdin(i, [ "edit", "Me.Fmt.inc", "--patch", "-" ], patch)

    let shown =
      Stdlib.String.split(out, "let inc(x: Int64): Int64 =")
      |> Stdlib.List.length

    Stdlib.Test.all(
      [ Instance.exitedWith(code, 1, out)
        Instance.says(out, "x + \"one\"", "the stored declaration")
        shown |> Stdlib.Test.equal(2) ]))
