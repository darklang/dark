/// Which stream a command writes to. stdout is the answer, stderr is everything a person reads
/// while it runs (refusals, hints, logs, previews), and the exit code is the verdict, so
/// `dark search x | wc -l` counts results and nothing else.
module Darklang.Cli.Tests.Streams

/// The colour taken out, the lines kept.
let plain(text: String): String =
  Stdlib.Regex.replaceAll(text, "\\x1b\\[[0-9;]*m", "")
  |> Stdlib.Result.withDefault(text)


/// A command's exit code, stdout and stderr, trimmed and without colour.
let plainStreams(i: Instance.T, args: List<String>): (Int64 * String * String) =
  let (code, out, err) = Instance.streams(i, args)
  (code, plain(out), plain(err))


let same(actual: String, expected: String, why: String): Stdlib.Test.Result =
  if actual == expected then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"{why}: expected {Stdlib.inspect(expected)}, got {Stdlib.inspect(actual)}")


test anEvalErrorAndDebugGoToStderr = Instance.withInstance(fun i ->
  let (failedCode, failedOut, failedErr) = plainStreams(i, [ "eval", "1 / 0" ])

  let (debugCode, debugOut, debugErr) =
    plainStreams(i, [ "eval", "let _ = Stdlib.debug(\"lbl\", 5) in 7" ])

  Stdlib.Test.all(
    [ Instance.exitedWith(failedCode, 1, "a raised eval exits 1")
      same(failedOut, "", "a failed eval has no answer on stdout")
      Instance.says(
        failedErr,
        "Error: Cannot divide by 0",
        "the error is on stderr")

      Instance.exitedWith(debugCode, 0, "the eval succeeded")
      same(debugOut, "7", "stdout is the value alone")
      Instance.says(
        debugErr,
        "DEBUG: lbl: 5",
        "the debug line is on stderr") ]))


test logLinesAndHintsGoToStderr = Instance.withInstance(fun i ->
  let (logCode, logOut, logErr) =
    plainStreams(i, [ "eval", "let _ = Stdlib.Cli.Log.warn(\"careful\") in 7" ])

  let (searchCode, searchOut, searchErr) =
    plainStreams(i, [ "search", "Stdlib.List.map" ])

  Stdlib.Test.all(
    [ Instance.exitedWith(logCode, 0, "the eval succeeded")
      same(logOut, "7", "stdout is the value alone")
      Instance.says(logErr, "[WARN] careful", "the log line is on stderr")
      Instance.exitedWith(searchCode, 0, "the search answered")
      Instance.says(searchOut, "map", "stdout has the results")
      Instance.doesNotSay(
        searchOut,
        "--with-docs",
        "but not the hint about another flag")

      Instance.says(searchErr, "--with-docs", "which is on stderr") ]))


/// A save's answer is the line that says what it saved. A warning about it, the note that a dry
/// run wrote nothing, and the preview a prompt asks about go to stderr, so `dark fn ... | next`
/// gets the one line, and a delete nobody could confirm leaves stdout empty.
test saveWarningsDryRunNotesAndPreviewsGoToStderr =
  Instance.withInstance(fun i ->
    let (saveCode, saveOut, saveErr) =
      plainStreams(
        i,
        [ "fn"
          "Tests.Streams.f"
          "(x: Int64): Int64 = Zzz.Streams.nope(x) + 41" ])

    let (dryCode, dryOut, dryErr) =
      plainStreams(i, [ "delete", "Tests.Streams.f", "--dry-run" ])

    let (deleteCode, deleteOut, deleteErr) =
      plainStreams(i, [ "delete", "Tests.Streams.f" ])

    Stdlib.Test.all(
      [ Instance.exitedWith(saveCode, 0, "the fn saved")
        Instance.says(
          saveOut,
          "Created function Tests.Streams.f",
          "stdout says what was saved")

        Instance.doesNotSay(saveOut, "Unresolved", "but not the warning")
        Instance.says(
          saveErr,
          "Not found: Zzz.Streams.nope",
          "which is on stderr")

        Instance.exitedWith(dryCode, 0, "the dry run answered")
        Instance.says(
          dryOut,
          "Would discard fn Tests.Streams.f",
          "the preview is the answer")

        Instance.doesNotSay(dryOut, "dry-run", "the dry-run note is not")
        Instance.says(dryErr, "no op emitted", "it is on stderr")
        Instance.exitedWith(
          deleteCode,
          1,
          "nobody could confirm, so it refused")

        same(deleteOut, "", "and stdout is empty")
        Instance.says(deleteErr, "Discard not done", "the refusal is on stderr")

        Instance.says(
          deleteErr,
          "`dark discard Tests.Streams.f -y` does it without asking",
          "with the flag that gets past the prompt") ]))


/// What one stream of a command holds: nothing at all, a line with this text in it, or whatever it
/// likes, for a hint that depends on what the store holds.
type Stream =
  | Silent
  | Says(String)
  | Any


/// What is wrong with one stream, against what it should hold and what belongs on the other one.
let streamFault(
  name: String,
  expected: Stream,
  other: Stream,
  text: String)
  : Stdlib.Option.Option<String> =
  let first =
    Stdlib.String.splitOnNewline(text)
    |> Stdlib.List.head
    |> Stdlib.Option.withDefault("")

  let wrong =
    match expected with
    | Silent -> if text != "" then Some($"{name} not empty: {first}") else None
    | Says(s) ->
      if Stdlib.String.contains(text, s) then
        None
      else
        Some($"{name} lacks \"{s}\": {first}")
    | Any -> None

  match wrong with
  | Some(w) -> Some(w)
  | None ->
    match other with
    | Says(s) ->
      if Stdlib.String.contains(text, s) then
        Some($"{name} also has \"{s}\"")
      else
        None
    | _ -> None


/// The top-level commands in the forms people type, in order, each with its exit code and what
/// lands on stdout and stderr. The rows build on each other: the fn saved first is the one `view`,
/// `deps` and `rename` name later.
val streamRows: List<(List<String> * Int64 * Stream * Stream)> =
  [ ([ "branches" ], 0, Stream.Silent, Stream.Says("no branches"))
    (
      [ "fn", "Tests.Rows.f", "(x: Int64): Int64 = x + 1" ],
      0,
      Stream.Says("Created function Tests.Rows.f"),
      Stream.Silent)

    (
      [ "undo", "Tests.Rows.f" ],
      1,
      Stream.Silent,
      Stream.Says("nothing further to undo"))

    // Before anything runs, so there is no trace yet: an empty answer is empty stdout.
    ([ "traces", "list" ], 0, Stream.Silent, Stream.Says("nothing has run yet"))
    (
      [ "traces", "find", "zzzqqq" ],
      0,
      Stream.Silent,
      Stream.Says("no kept trace matches"))

    (
      [ "traces", "calls", "Tests.Rows.f" ],
      0,
      Stream.Silent,
      Stream.Says("no recorded trace"))

    (
      [ "traces", "show", "Tests.Rows.f" ],
      0,
      Stream.Silent,
      Stream.Says("no recorded trace"))

    (
      [ "traces", "fns" ],
      0,
      Stream.Silent,
      Stream.Says("no runs have been kept yet"))

    ([ "traces", "hotspots" ], 0, Stream.Silent, Stream.Says("No fn-call data"))
    (
      [ "fn", "Tests.Rows.g", "(x: Int64): Int64 = Tests.Rows.f(x)" ],
      0,
      Stream.Says("Created function Tests.Rows.g"),
      Stream.Silent)

    (
      [ "test", "add", "Tests.Rows.t", "Stdlib.Test.pass()" ],
      0,
      Stream.Says("Created test Tests.Rows.t"),
      Stream.Silent)

    ([ "status" ], 0, Stream.Says("draft:"), Stream.Says("`dark commit`"))
    (
      [ "status", "--json" ],
      0,
      Stream.Says("\"branch\":\"main\""),
      Stream.Silent)

    ([ "eval", "Tests.Rows.f(1)" ], 0, Stream.Says("2"), Stream.Silent)
    ([ "eval", "1 / 0" ], 1, Stream.Silent, Stream.Says("Cannot divide by 0"))
    (
      [ "test", "run", "--verbose", "Tests.Rows.t" ],
      0,
      Stream.Says("PASS Tests.Rows.t"),
      Stream.Says("Running: Tests.Rows.t"))

    (
      [ "test", "run", "Zzz.Nope" ],
      1,
      Stream.Silent,
      Stream.Says("No package tests matched"))

    ([ "view", "Tests.Rows.f" ], 0, Stream.Says("let f(x: Int64)"), Stream.Any)
    ([ "view", "Zzz.Nope.f" ], 1, Stream.Silent, Stream.Says("Not found"))
    (
      [ "view", "Darklang.Stdlib.Float64.round" ],
      0,
      Stream.Says("can raise a runtime error"),
      Stream.Any)

    (
      [ "effects", "Darklang.Stdlib.Float64.round" ],
      0,
      Stream.Says("via Builtin.float64Round"),
      Stream.Silent)

    // Its `/` declares `Raise`, but it tests for every case where `/` raises.
    (
      [ "effects", "Darklang.Stdlib.Int64.checkedDivide" ],
      0,
      Stream.Says("effect-free"),
      Stream.Silent)

    (
      [ "effects", "Darklang.Stdlib.DateTime.weekday" ],
      0,
      Stream.Says("effect-free"),
      Stream.Silent)

    ([ "hash", "Tests.Rows.f" ], 0, Stream.Says("fn "), Stream.Silent)
    (
      [ "deps", "Tests.Rows.f" ],
      0,
      Stream.Says("dependencies of Tests.Rows.f"),
      Stream.Any)

    (
      [ "deps", "Tests.Rows.g" ],
      0,
      Stream.Says("dependencies of Tests.Rows.g"),
      Stream.Says("No dependents"))

    (
      [ "nav" ],
      1,
      Stream.Silent,
      Stream.Says("Interactive terminal UI unavailable"))

    (
      [ "search" ],
      1,
      Stream.Silent,
      Stream.Says("Interactive terminal UI unavailable"))

    (
      [ "builtins", "zzzqqq" ],
      0,
      Stream.Silent,
      Stream.Says("Showing 0 functions"))

    (
      [ "ls", "Darklang.Stdlib.Bool" ],
      0,
      Stream.Says("Contents of"),
      Stream.Silent)

    (
      [ "nav", "Darklang.Stdlib.Bool" ],
      0,
      Stream.Says("Changed to"),
      Stream.Says("only for this command"))

    (
      [ "tree", "Darklang.Stdlib", "--depth", "1" ],
      0,
      Stream.Says("Package tree"),
      Stream.Silent)

    (
      [ "search", "Stdlib.List.map" ],
      0,
      Stream.Says("Darklang.Stdlib.List.map"),
      Stream.Says("--with-docs"))

    ([ "search", "zzzqqq" ], 0, Stream.Silent, Stream.Says("No results found"))
    (
      [ "find-values", "Darklang.Stdlib.Option.Option", "Zzz" ],
      0,
      Stream.Silent,
      Stream.Says("No values of type"))

    (
      [ "builtins", "listMap" ],
      0,
      Stream.Says("List: listMap"),
      Stream.Says("--with-sigs"))

    (
      [ "typecheck", "Darklang.Stdlib.Bool" ],
      0,
      Stream.Says("failed 0"),
      Stream.Silent)

    (
      [ "impls", "Darklang.Stdlib.Add" ],
      0,
      Stream.Says("Darklang.Stdlib.Add"),
      Stream.Silent)

    ([ "docs", "scm" ], 0, Stream.Says("# Source control"), Stream.Silent)
    ([ "docs", "zzznope" ], 1, Stream.Silent, Stream.Says("Unknown topic"))
    ([ "help" ], 0, Stream.Says("Packages:"), Stream.Silent)
    ([ "help", "status" ], 0, Stream.Says("draft"), Stream.Silent)
    ([ "help", "zzznope" ], 1, Stream.Silent, Stream.Says("No command called"))
    ([ "version", "--local" ], 0, Stream.Says("Darklang CLI"), Stream.Silent)
    ([ "config", "list" ], 0, Stream.Says("exec.workers"), Stream.Silent)
    ([ "config" ], 0, Stream.Says("exec.workers"), Stream.Silent)
    (
      [ "config", "get", "zzznope" ],
      1,
      Stream.Silent,
      Stream.Says("not a config key"))

    (
      [ "permissions", "show", "Tests.Rows.f" ],
      0,
      Stream.Says("Effects:"),
      Stream.Silent)

    (
      [ "commit", "-m", "rows", "--json" ],
      1,
      Stream.Says("\"committed\":false"),
      Stream.Any)

    (
      [ "commit", "-m", "rows", "-y" ],
      0,
      Stream.Says("commit "),
      Stream.Says("CHANGED"))

    ([ "commits", "1", "--json" ], 0, Stream.Says("\"hash\""), Stream.Silent)
    ([ "log" ], 0, Stream.Says("commits"), Stream.Silent)
    ([ "ops", "1" ], 0, Stream.Says("ops on main"), Stream.Silent)
    (
      [ "show", "zzznope" ],
      1,
      Stream.Silent,
      Stream.Says("nothing matching zzznope"))

    ([ "constraints" ], 0, Stream.Silent, Stream.Says("no constraints"))
    ([ "conflicts" ], 0, Stream.Silent, Stream.Says("no conflicts"))
    ([ "backups" ], 0, Stream.Silent, Stream.Says("no backups yet"))
    ([ "backups", "now" ], 0, Stream.Says("copied the store"), Stream.Silent)
