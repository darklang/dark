      Stream.Says("1"),
      Stream.Says("d: no function named Me.Nope.step"))

    ([ "zzznope" ], 1, Stream.Silent, Stream.Says("Unknown command")) ]


test eachCommandKeepsItsStreams = Instance.withInstance(fun i ->
  let faults =
    streamRows
    |> Stdlib.List.map(fun row ->
      let (args, code, out, err) = row
      let (status, stdout, stderr) = plainStreams(i, args)
      let exitFault =
        if status != code then
          Some($"exit {Stdlib.display(status)}, not {Stdlib.display(code)}")
        else
          None

      let cmd = Stdlib.String.join(args, " ")
      [ exitFault
        streamFault("stdout", out, err, stdout)
        streamFault("stderr", err, out, stderr) ]
      |> Stdlib.List.filterMap(fun f -> f)
      |> Stdlib.List.map(fun f -> $"  dark {cmd} -> {f}"))
    |> Stdlib.List.flatten

  Stdlib.Test.expect(
    faults == [],
    "commands that put a line on the wrong stream, or exited wrong:\n"
    + Stdlib.String.join(faults, "\n")))
