    ([ "ps", "--json" ], 0, Stream.Says("thisInstance"), Stream.Silent)
    ([ "ack", "--all" ], 0, Stream.Silent, Stream.Says("nothing to ack"))
    (
      [ "branch", "create", "main" ],
      1,
      Stream.Silent,
      Stream.Says("main already exists"))

    (
      [ "branch", "create", "rows-b" ],
      0,
      Stream.Says("started branch"),
      Stream.Silent)

    (
      [ "fn", "Tests.Rows.h", "(): Int64 = 2" ],
      0,
      Stream.Says("Created function"),
      Stream.Silent)

    ([ "diff" ], 0, Stream.Says("Tests.Rows.h"), Stream.Says("`dark commit`"))
    ([ "switch", "main" ], 0, Stream.Says("switched to main"), Stream.Silent)
    ([ "branches" ], 0, Stream.Says("rows-b"), Stream.Silent)
    (
      [ "diff", "rows-b" ],
      0,
      Stream.Says("changes 1 name"),
      Stream.Says("--source"))

    (
      [ "merge", "rows-b", "--dry-run" ],
      0,
      Stream.Says("would merge"),
      Stream.Says("`dark merge rows-b`"))

    (
      [ "merge", "rows-b" ],
      1,
      Stream.Silent,
      Stream.Says("cannot merge \"rows-b\""))

    (
      [ "rename", "Tests.Rows.g", "Tests.Rows.g2" ],
      0,
      Stream.Says("renamed"),
      Stream.Says("callers now use"))

    (
      [ "delete", "Tests.Rows.g2", "--dry-run" ],
      0,
      Stream.Says("Would deprecate"),
      Stream.Says("dry-run"))

    (
      [ "delete", "Tests.Rows.g2" ],
      1,
      Stream.Silent,
      Stream.Says("Delete not done"))

    (
      [ "delete", "Tests.Rows.g2", "-y" ],
      0,
      Stream.Says("Deleted Tests.Rows.g2 (still callable)."),
      Stream.Silent)

    (
      [ "undeprecate", "Tests.Rows.g2" ],
      0,
      Stream.Says("Undeprecated"),
      Stream.Silent)

    (
      [ "fn", "Tests.Rows.f", "(x: Int64): Int64 = x + 2" ],
      0,
      Stream.Says("Updated function"),
      Stream.Silent)

    (
      [ "undo", "Tests.Rows.f" ],
      0,
      Stream.Says("back on the version"),
      Stream.Silent)

    (
      [ "discard" ],
      1,
      Stream.Says("DISCARDING"),
      Stream.Says("Discard not done"))

    (
      [ "discard", "-y" ],
      0,
      Stream.Says("DISCARDING"),
      Stream.Says("discarded"))

    ([ "ack" ], 1, Stream.Silent, Stream.Says("dark ack --all"))
    ([ "import" ], 1, Stream.Silent, Stream.Says("needs 2 arguments"))
    ([ "workbench" ], 1, Stream.Silent, Stream.Says("unavailable"))
    ([], 1, Stream.Silent, Stream.Says("unavailable"))
    ([ "uninstall" ], 1, Stream.Silent, Stream.Says("`dark uninstall -y`"))
    ([ "quit" ], 0, Stream.Silent, Stream.Says("Goodbye!"))
    (
      [ "run-script", "/zzznope/x.dark" ],
      1,
      Stream.Silent,
      Stream.Says("Script not found"))

    ([ "hash" ], 1, Stream.Silent, Stream.Says("needs an argument"))
    ([ "find-values" ], 1, Stream.Silent, Stream.Says("needs an argument"))
