/// Cases from
/// `backend/testfiles/execution/cli/workbench-repl.dark`,
/// in original assertion order.
module Darklang.Cli.Tests.WorkbenchRepl

// The workbench REPL's session bindings: `let x = ...` binds for the rest of the session by being re-injected
// as a `let` chain around every later expression. The parse and injection halves are pure, so they're testable
// directly. The value-capture half needs a running evaluator and lives in the CLI suite instead.
//
// --- what binds ---
test letBinding =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.parseLetBinding "let x = 1"
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some(("x", "1")))
      Darklang.Cli.Repl.parseLetBinding "  let  ys  =  [ 1, 2 ]  "
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some(("ys", "[ 1, 2 ]")))
      Darklang.Cli.Repl.parseLetBinding "let _priv = 3"
      |> Stdlib.Test.equal (Stdlib.Option.Option.Some(("_priv", "3"))) ]

// the right-hand side keeps its own `=`, so a record literal or a named argument survives
test rhsKeepsEquals =
  Darklang.Cli.Repl.parseLetBinding "let r = f (a = 1)"
  |> Stdlib.Test.equal (Stdlib.Option.Option.Some(("r", "f (a = 1)")))

// --- what deliberately doesn't, and falls through to being evaluated ---
test nonBindingsFallThrough =
  Darklang.Cli.Repl.parseLetBinding "1 + 1"
  |> Stdlib.Test.equal Stdlib.Option.Option.None

// a comparison typo, not a binding
test comparisonTypo =
  Darklang.Cli.Repl.parseLetBinding "let x == 3"
  |> Stdlib.Test.equal Stdlib.Option.Option.None

// a pattern binding can't be re-injected by name
test patternBindingRejected =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.parseLetBinding "let (a, b) = t"
      |> Stdlib.Test.equal Stdlib.Option.Option.None
      Darklang.Cli.Repl.parseLetBinding "let x ="
      |> Stdlib.Test.equal Stdlib.Option.Option.None
      Darklang.Cli.Repl.parseLetBinding "letter = 3"
      |> Stdlib.Test.equal Stdlib.Option.Option.None
      Darklang.Cli.Repl.parseLetBinding "let 2x = 3"
      |> Stdlib.Test.equal Stdlib.Option.Option.None ]

// --- when ⏎ moves down a line instead of running ---
test openBrackets =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.openBracketDepth "Stdlib.List.map xs (fun x -> x"
      |> Stdlib.Test.equal 1
      Darklang.Cli.Repl.openBracketDepth "Stdlib.List.map xs (fun x -> x)"
      |> Stdlib.Test.equal 0
      Darklang.Cli.Repl.openBracketDepth "[ 1, [ 2 ]" |> Stdlib.Test.equal 1
      Darklang.Cli.Repl.openBracketDepth "1 + 1" |> Stdlib.Test.equal 0 ]

// Brackets inside a string literal aren't brackets.
test stringBrackets =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.openBracketDepth "Stdlib.String.contains s \"(\""
      |> Stdlib.Test.equal 0
      Darklang.Cli.Repl.openBracketDepth "\"a\\\"(\"" |> Stdlib.Test.equal 0 ]

// An open bracket, or a line that ends in something nothing can follow.
test wantsAnotherLine =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.wantsAnotherLine "Stdlib.List.map xs (fun x ->"
      |> Stdlib.Test.equal true
      Darklang.Cli.Repl.wantsAnotherLine "[ 1" |> Stdlib.Test.equal true
      Darklang.Cli.Repl.wantsAnotherLine "let x =" |> Stdlib.Test.equal true
      Darklang.Cli.Repl.wantsAnotherLine "xs |>" |> Stdlib.Test.equal true
      Darklang.Cli.Repl.wantsAnotherLine "if x then" |> Stdlib.Test.equal true
      Darklang.Cli.Repl.wantsAnotherLine "match x with" |> Stdlib.Test.equal true ]

// A finished statement runs.
test finishedStatementRuns =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.wantsAnotherLine "1 + 1" |> Stdlib.Test.equal false
      Darklang.Cli.Repl.wantsAnotherLine "let x = 1" |> Stdlib.Test.equal false
      Darklang.Cli.Repl.wantsAnotherLine "Stdlib.List.map xs (fun x -> x * 2L)"
      |> Stdlib.Test.equal false
      Darklang.Cli.Repl.wantsAnotherLine "" |> Stdlib.Test.equal false ]

// Judged over the whole statement so far, not just the last line: this closes what the first line opened.
test wholeStatementJudged =
  Darklang.Cli.Repl.wantsAnotherLine "Stdlib.List.map xs\n  (fun x -> x * 2L)"
  |> Stdlib.Test.equal false

// A keyword only counts as the whole last token, so a name that merely ends in one isn't mistaken for it.
test keywordAsWholeToken =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.wantsAnotherLine "outlet" |> Stdlib.Test.equal false
      Darklang.Cli.Repl.wantsAnotherLine "myIf" |> Stdlib.Test.equal false ]

// --- the chain that re-establishes a session ---
// An empty session evaluates exactly what you typed.
test emptySession =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.withBindings [] "x + 1" |> Stdlib.Test.equal "x + 1"
      Darklang.Cli.Repl.withBindings
        [ Darklang.Cli.Repl.Binding { name = "x"; source = "42"; value = "42"; captured = true } ]
        "x + 1"
      |> Stdlib.Test.equal "let x = 42\nx + 1" ]

// Order is load-bearing: a later binding may refer to an earlier one.
test bindingOrder =
  Darklang.Cli.Repl.withBindings
    [ Darklang.Cli.Repl.Binding { name = "x"; source = "42"; value = "42"; captured = true }
      Darklang.Cli.Repl.Binding { name = "y"; source = "x + 1"; value = "x + 1"; captured = false } ]
    "y * 2"
  |> Stdlib.Test.equal "let x = 42\nlet y = x + 1\ny * 2"

// Which is why a rebind keeps its position rather than moving to the end.
test rebindKeepsPosition =
  (Darklang.Cli.Repl.upsert
    [ Darklang.Cli.Repl.Binding { name = "x"; source = "1"; value = "1"; captured = true }
      Darklang.Cli.Repl.Binding { name = "y"; source = "x + 1"; value = "x + 1"; captured = false } ]
    (Darklang.Cli.Repl.Binding { name = "x"; source = "99"; value = "99"; captured = true })
   |> Stdlib.List.map (fun b -> b.name + "=" + b.source))
  |> Stdlib.Test.equal [ "x=99", "y=x + 1" ]

// --- reading `captureValue` back ---
test readCaptured =
  Darklang.Cli.Repl.readCaptured "ok:[1L, 2L]"
  |> Stdlib.Test.equal (Stdlib.Option.Option.Some "[1L, 2L]")

// anything that isn't `ok:` means "hold the expression instead"
test nonOkHoldsExpression =
  Stdlib.Test.all
    [ Darklang.Cli.Repl.readCaptured "err:no literal form"
      |> Stdlib.Test.equal Stdlib.Option.Option.None
      Darklang.Cli.Repl.readCaptured ""
      |> Stdlib.Test.equal Stdlib.Option.Option.None ]
