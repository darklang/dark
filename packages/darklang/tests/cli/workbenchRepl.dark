module Darklang.Cli.Tests.WorkbenchRepl

// The workbench REPL's session bindings: `let x = ...` binds for the rest of the session by being re-injected
// as a `let` chain around every later expression. The parse, injection and value-capture halves are tested
// directly; typing at the prompt is in workbench.dark.
//
// --- what binds ---
test letBinding =
  Stdlib.Test.all(
    [ Cli.Repl.parseLetBinding("let x = 1")
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("x", "1")))

      Cli.Repl.parseLetBinding("  let  ys  =  [ 1, 2 ]  ")
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("ys", "[ 1, 2 ]")))

      Cli.Repl.parseLetBinding("let _priv = 3")
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("_priv", "3")))

      Cli.Repl.parseLetBinding("let x2 = x + 1")
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("x2", "x + 1")))

      // A wrapped declaration binds, rhs and all - a pasted chain never reaches here, because
      // `splitStatements` has already separated it into one statement per binding.
      Cli.Repl.parseLetBinding("let xs = [ 1\n  2 ]")
      |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("xs", "[ 1\n  2 ]"))) ])


// the right-hand side keeps its own `=`, so a record literal or a named argument survives
test rhsKeepsEquals =
  Cli.Repl.parseLetBinding("let r = f (a = 1)")
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some(("r", "f (a = 1)")))


// --- what deliberately doesn't, and falls through to being evaluated ---
test nonBindingsFallThrough =
  Cli.Repl.parseLetBinding("1 + 1")
  |> Stdlib.Test.equal(Stdlib.Option.Option.None)


// a comparison typo, not a binding
test comparisonTypo =
  Cli.Repl.parseLetBinding("let x == 3")
  |> Stdlib.Test.equal(Stdlib.Option.Option.None)


// a pattern binding can't be re-injected by name
test patternBindingRejected =
  Stdlib.Test.all(
    [ Cli.Repl.parseLetBinding("let (a, b) = t")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Cli.Repl.parseLetBinding("let x =")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Cli.Repl.parseLetBinding("letter = 3")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Cli.Repl.parseLetBinding("let 2x = 3")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])


// --- when ⏎ moves down a line instead of running ---
test openBrackets =
  Stdlib.Test.all(
    [ Cli.Repl.openBracketDepth("Stdlib.List.map xs (fun x -> x")
      |> Stdlib.Test.equal(1)

      Cli.Repl.openBracketDepth("Stdlib.List.map(xs, fun x -> x)")
      |> Stdlib.Test.equal(0)

      Cli.Repl.openBracketDepth("[ 1, [ 2 ]") |> Stdlib.Test.equal(1)

      Cli.Repl.openBracketDepth("1 + 1") |> Stdlib.Test.equal(0) ])


// Brackets inside a string literal aren't brackets.
test stringBrackets =
  Stdlib.Test.all(
    [ Cli.Repl.openBracketDepth("Stdlib.String.contains(s, \"(\")")
      |> Stdlib.Test.equal(0)

      Cli.Repl.openBracketDepth("\"a\\\"(\"") |> Stdlib.Test.equal(0) ])


// An open bracket, or a line that ends in something nothing can follow.
test wantsAnotherLine =
  Stdlib.Test.all(
    [ Cli.Repl.wantsAnotherLine("Stdlib.List.map xs (fun x ->")
      |> Stdlib.Test.equal(true)

      Cli.Repl.wantsAnotherLine("[ 1") |> Stdlib.Test.equal(true)

      Cli.Repl.wantsAnotherLine("let x =") |> Stdlib.Test.equal(true)

      Cli.Repl.wantsAnotherLine("xs |>") |> Stdlib.Test.equal(true)

      Cli.Repl.wantsAnotherLine("if x then") |> Stdlib.Test.equal(true)

      Cli.Repl.wantsAnotherLine("match x with") |> Stdlib.Test.equal(true) ])


// A finished statement runs.
test finishedStatementRuns =
  Stdlib.Test.all(
    [ Cli.Repl.wantsAnotherLine("1 + 1") |> Stdlib.Test.equal(false)

      Cli.Repl.wantsAnotherLine("let x = 1") |> Stdlib.Test.equal(false)

      Cli.Repl.wantsAnotherLine("Stdlib.List.map(xs, fun x -> x * 2)")
      |> Stdlib.Test.equal(false)

      Cli.Repl.wantsAnotherLine("") |> Stdlib.Test.equal(false) ])


// Judged over the whole statement so far, not just the last line: this closes what the first line opened.
test wholeStatementJudged =
  Cli.Repl.wantsAnotherLine("Stdlib.List.map(xs,\n  fun x -> x * 2)")
  |> Stdlib.Test.equal(false)


// A keyword only counts as the whole last token, so a name that merely ends in one isn't mistaken for it.
test keywordAsWholeToken =
  Stdlib.Test.all(
    [ Cli.Repl.wantsAnotherLine("outlet") |> Stdlib.Test.equal(false)
      Cli.Repl.wantsAnotherLine("myIf") |> Stdlib.Test.equal(false) ])


// --- splitting a paste into statements ---
test splitsPastedStatements =
  // A paste has to behave exactly like typing the lines one at a time, which means knowing where one
  // statement ends. Indentation is the signal: an indented line continues the one above, so a wrapped
  // expression stays whole while a chain separates.
  let cases =
    [ ("let a = 21\na * 2", [ "let a = 21", "a * 2" ])
      (
        "Stdlib.List.map(xs,\n  fun x -> x * 2)",
        [ "Stdlib.List.map(xs,\n  fun x -> x * 2)" ])

      // A blank line closes a statement rather than joining across it.
      ("let a = 1\n\nlet b = 2", [ "let a = 1", "let b = 2" ])
      ("one line", [ "one line" ])
      ("", []) ]

  let wrong =
    cases
    |> Stdlib.List.filter(fun c ->
      let (input, expected) = c
      Cli.Repl.splitStatements(input) != expected)
    |> Stdlib.List.map(fun c ->
      let (input, _e) = c
      Stdlib.inspect(input))

  if Stdlib.List.isEmpty(wrong) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"splitStatements wrong for: {Stdlib.String.join(wrong, " | ")}")


// --- the chain that re-establishes a session ---
// An empty session evaluates exactly what you typed.
test emptySession =
  Stdlib.Test.all(
    [ Cli.Repl.withBindings([], "x + 1") |> Stdlib.Test.equal("x + 1")

      Cli.Repl.withBindings(
        [ Cli.Repl.Binding
            { name = "x", source = "42", value = "42", captured = true } ],
        "x + 1")
      |> Stdlib.Test.equal("let x = 42\nx + 1") ])


// Order is load-bearing: a later binding may refer to an earlier one.
test bindingOrder =
  Cli.Repl.withBindings(
    [ Cli.Repl.Binding
        { name = "x", source = "42", value = "42", captured = true }

      Cli.Repl.Binding
        { name = "y", source = "x + 1", value = "x + 1", captured = false } ],
    "y * 2")
  |> Stdlib.Test.equal("let x = 42\nlet y = x + 1\ny * 2")


// Which is why a rebind keeps its position rather than moving to the end.
test rebindKeepsPosition =
  (Cli.Repl.upsert(
     [ Cli.Repl.Binding
         { name = "x", source = "1", value = "1", captured = true }

       Cli.Repl.Binding
         { name = "y", source = "x + 1", value = "x + 1", captured = false } ],
     Cli.Repl.Binding
       { name = "x", source = "99", value = "99", captured = true })
   |> Stdlib.List.map(fun b -> b.name + "=" + b.source))
  |> Stdlib.Test.equal([ "x=99", "y=x + 1" ])


test uncapturedRebindMovesLast =
  // An uncaptured binding holds an EXPRESSION, so it must sit after anything it references. Rebinding it in
  // place produced `let a = d` above `let d = ...`, which left `d` undefined and wedged the session.
  let mk = fun(n, s, c) ->
    Cli.Repl.Binding { name = n, source = s, value = s, captured = c }

  let after =
    Cli.Repl.upsert(
      [ mk("a", "1", true), mk("d", "Stdlib.DateTime.now()", false) ],
      mk("a", "d", false))

  let order =
    after
    |> Stdlib.List.map(fun b -> b.name)
    |> Stdlib.String.join(",")

  if order == "d,a" then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail(
      $"Expected the uncaptured rebind to move last (d,a), got {order}")


// --- capturing a value, and reading `captureValue` back ---
test capturesRealValues =
  // The end of the round-trip that matters: a value goes out as source you could paste back in. Enums are
  // in here because they're what a REPL actually produces, and they only render as names because
  // `dvalToExpr` resolves the type's package location.
  let branch = SCM.Branch.mainBranchId
  let cases =
    [ (Cli.Repl.captureValue(branch, 42), "ok:42")
      (Cli.Repl.captureValue(branch, [ 1, 2 ]), "ok:[ 1, 2 ]")
      (Cli.Repl.captureValue(branch, "hi"), "ok:\"hi\"")
      // An enum renders under its shortest name, so `Some(1)`. That and the fully-qualified
      // spelling both parse back to the same value, which is what matters here: the property is
      // that the output is source you could paste in, not that it is spelled one way.
      (Cli.Repl.captureValue(branch, Some(1)), "ok:Some(1)") ]

  let wrong =
    cases
    |> Stdlib.List.filter(fun c ->
      let (got, want) = c
      got != want)
    |> Stdlib.List.map(fun c ->
      let (got, want) = c
      $"{want} -> {got}")

  if Stdlib.List.isEmpty(wrong) then
    Stdlib.Test.Result.Pass
  else
    Stdlib.Test.fail($"captureValue: {Stdlib.String.join(wrong, " | ")}")


test readCaptured =
  Cli.Repl.readCaptured("ok:[1, 2]")
  |> Stdlib.Test.equal(Stdlib.Option.Option.Some("[1, 2]"))


// anything that isn't `ok:` means "hold the expression instead"
test nonOkHoldsExpression =
  Stdlib.Test.all(
    [ Cli.Repl.readCaptured("err:no literal form")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None)

      Cli.Repl.readCaptured("")
      |> Stdlib.Test.equal(Stdlib.Option.Option.None) ])
