module Darklang.Sqlite.Tests

// withTemp hands over an empty file, which SQLite opens as an empty database.
let withDb(fn: String -> Stdlib.Test.Result): Stdlib.Test.Result =
  Stdlib.Cli.File.withTemp(fn) |> Builtin.unwrap


let text(s: String): Sqlite.Value =
  Sqlite.Value.Text(s)


let int(i: Int64): Sqlite.Value =
  Sqlite.Value.Integer(i)


let changed(n: Int64, rowid: Int64): Result<Sqlite.Changes, Sqlite.Error> =
  Stdlib.Result.Result.Ok(
    Sqlite.Changes { rowsAffected = n, lastInsertRowid = rowid })


let affected(
  result: Result<Sqlite.Changes, Sqlite.Error>)
  : Result<Int64, Sqlite.Error> =
  result |> Stdlib.Result.map(fun c -> c.rowsAffected)


let failedWith(
  result: Result<'a, Sqlite.Error>,
  part: String)
  : Stdlib.Test.Result =
  match result with
  | Error(e) ->
    Stdlib.Test.expect(Stdlib.String.contains(e.message, part), e.message)
  | Ok(_) -> Stdlib.Test.fail($"expected an error containing {part}")


test insertAndQuery = withDb(fun db ->
  Stdlib.Test.all(
    [ Sqlite.execute(
        db,
        "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)",
        [])
      |> affected
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(0))

      Sqlite.execute(
        db,
        "INSERT INTO users (id, name) VALUES (?1, ?2), (?3, ?4)",
        [ int(1), text("Alice"), int(2), text("Bob") ])
      |> Stdlib.Test.equal(changed(2, 2))

      Sqlite.query(
        db,
        "SELECT name FROM users WHERE id > ?1 ORDER BY id",
        [ int(0) ])
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok(
          [ Dict { "name": text("Alice") }, Dict { "name": text("Bob") } ])) ]))


test valueKinds =
  withDb(fun db ->
    Sqlite.query(
      db,
      "SELECT 1 AS i, 1.5 AS r, 2.0 AS whole, 'a' AS t, NULL AS n, X'00FF' AS b",
      [])
    |> Stdlib.Test.equal(
      Stdlib.Result.Result.Ok(
        [ Dict { "i": int(1)
                 "r": Sqlite.Value.Real(1.5)
                 "whole": Sqlite.Value.Real(2.0)
                 "t": text("a")
                 "n": Sqlite.Value.Null
                 "b": Sqlite.Value.Blob(
                   Stdlib.Base16.decode("00FF") |> Builtin.unwrap) } ])))


// Each parameter comes back as the same type and value it went in as
test parametersRoundTrip = withDb(fun db ->
  let bytes = Stdlib.Base16.decode("00FFA0") |> Builtin.unwrap
  Sqlite.query(
    db,
    "SELECT ?1 AS a, typeof(?1) AS ta, ?2 AS b, typeof(?2) AS tb, ?3 AS c, ?4 AS d, ?5 AS e, typeof(?5) AS te",
    [ Sqlite.Value.Real(2.0)
      int(-5)
      Sqlite.Value.Null
      text("")
      Sqlite.Value.Blob(bytes) ])
  |> Stdlib.Test.equal(
    Stdlib.Result.Result.Ok(
      [ Dict { "a": Sqlite.Value.Real(2.0)
               "ta": text("real")
               "b": int(-5)
               "tb": text("integer")
               "c": Sqlite.Value.Null
               "d": text("")
               "e": Sqlite.Value.Blob(bytes)
               "te": text("blob") } ])))


// A text parameter is data, however much it looks like SQL
test textParametersAreNotSql = withDb(fun db ->
  let nasty = "'); DROP TABLE t; --\" \n.shell echo hi\n]\n[ é"
  let _ = Sqlite.execute(db, "CREATE TABLE t (v TEXT)", [])
  Stdlib.Test.all(
    [ Sqlite.execute(db, "INSERT INTO t (v) VALUES (?1)", [ text(nasty) ])
      |> Stdlib.Test.equal(changed(1, 1))

      Sqlite.query(db, "SELECT v FROM t", [])
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok([ Dict { "v": text(nasty) } ])) ]))


test severalStatements =
  withDb(fun db ->
    Stdlib.Test.all(
      [ Sqlite.execute(
          db,
          "CREATE TABLE t (v INTEGER); INSERT INTO t VALUES (1); INSERT INTO t VALUES (2)",
          [])
        |> Stdlib.Test.equal(changed(2, 2))

        Sqlite.query(
          db,
          "SELECT v FROM t WHERE v = 1; SELECT v FROM t WHERE v = 2",
          [])
        |> Stdlib.Test.equal(
          Stdlib.Result.Result.Ok(
            [ Dict { "v": int(1) }, Dict { "v": int(2) } ])) ]))


test updateAndDelete = withDb(fun db ->
  let _ = Sqlite.execute(db, "CREATE TABLE t (id INTEGER, name TEXT)", [])

  let _ =
    Sqlite.execute(db, "INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c')", [])

  Stdlib.Test.all(
    [ Sqlite.execute(
        db,
        "UPDATE t SET name = ?1 WHERE id = ?2",
        [ text("z"), int(1) ])
      |> affected
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(1))

      Sqlite.execute(db, "DELETE FROM t WHERE id > ?1", [ int(1) ])
      |> affected
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok(2))

      Sqlite.query(db, "SELECT name FROM t", [])
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok([ Dict { "name": text("z") } ])) ]))


test noRows =
  withDb(fun db ->
    Sqlite.query(db, "SELECT 1 AS x WHERE 0", [])
    |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([])))


test invalidSql =
  withDb(fun db ->
    failedWith(Sqlite.execute(db, "THIS IS NOT VALID SQL", []), "syntax error"))


test missingTable =
  withDb(fun db ->
    failedWith(Sqlite.query(db, "SELECT * FROM nope", []), "no such table"))


test constraintCode = withDb(fun db ->
  let _ = Sqlite.execute(db, "CREATE TABLE t (v INTEGER UNIQUE)", [])
  let _ = Sqlite.execute(db, "INSERT INTO t VALUES (1)", [])
  match Sqlite.execute(db, "INSERT INTO t VALUES (1)", []) with
  | Error(e) -> e.code |> Stdlib.Test.equal(2067)  // SQLITE_CONSTRAINT_UNIQUE
  | Ok(_) -> Stdlib.Test.fail("expected a UNIQUE failure"))


// query opens the file read-only, so SQLite refuses a write however it is spelled
test queryCannotWrite = withDb(fun db ->
  let _ =
    Sqlite.execute(
      db,
      "CREATE TABLE t (v INTEGER); INSERT INTO t VALUES (1)",
      [])

  Stdlib.Test.all(
    [ failedWith(Sqlite.query(db, "DELETE FROM t RETURNING v", []), "readonly")
      Sqlite.query(db, "SELECT v FROM t", [])
      |> Stdlib.Test.equal(
        Stdlib.Result.Result.Ok([ Dict { "v": int(1) } ])) ]))


// a failing statement undoes the ones before it
test executeIsOneTransaction = withDb(fun db ->
  let _ = Sqlite.execute(db, "CREATE TABLE t (v INTEGER)", [])
  Stdlib.Test.all(
    [ failedWith(
        Sqlite.execute(
          db,
          "INSERT INTO t VALUES (1); INSERT INTO nope VALUES (2)",
          []),
        "no such table")

      Sqlite.query(db, "SELECT v FROM t", [])
      |> Stdlib.Test.equal(Stdlib.Result.Result.Ok([])) ]))


// The SQL reaches the one database file only
test otherFilesAreRefused = withDb(fun db ->
  Stdlib.Test.all(
    [ failedWith(
        Sqlite.execute(db, $"ATTACH '{db}-other' AS other", []),
        "too many attached databases")

      // query is not in a transaction, so this reaches the attach limit
      failedWith(
        Sqlite.query(db, $"VACUUM INTO '{db}-copy'", []),
        "too many attached databases")

      failedWith(Sqlite.execute(db, $"VACUUM INTO '{db}-copy'", []), "VACUUM")

      failedWith(Sqlite.query(db, ".shell echo hi", []), "syntax error") ]))
