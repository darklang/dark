module Darklang.PrettyPrinter.RuntimeTypes


// <aliases>
type FQFnName = LanguageTools.RuntimeTypes.FQFnName.FQFnName
type FQTypeName = LanguageTools.RuntimeTypes.FQTypeName.FQTypeName
type FQValueName = LanguageTools.RuntimeTypes.FQValueName.FQValueName
type TypeReference = LanguageTools.RuntimeTypes.TypeReference
type ValueType = LanguageTools.RuntimeTypes.ValueType
type Dval = LanguageTools.RuntimeTypes.Dval
type LetPattern = LanguageTools.RuntimeTypes.LetPattern
// </aliases>

module RuntimeError =

  /// Error pretty printing
  /// ---------------
  /// Segments allow us to build error messages where the UI and CLI can both
  /// decorate/link to the sources in a native way
  type ErrorSegment =
    // -- Basic types
    | String(String)
    | Int64(Int64)
    | Ordinal(Int64) // 1st, 2nd, etc
    | IndefiniteArticle // "a" or "an" (chosen based on the next segment)
    | Count(Int64, singular: ErrorSegment, plural: ErrorSegment) // 2 errors, 1 error, etc

    // -- Functions
    | FunctionName(FQFnName)
    /// Description from StdLib description fields.
    /// Note: may include markers like `<param name>`, to be parsed and displayed differently.
    | Description(String)
    | ParamName(String)
    | InlineParamName(String)

    // -- Types
    | TypeName(FQTypeName)
    | ShortTypeName(FQTypeName)
    | TraitName(LanguageTools.RuntimeTypes.FQTraitName.FQTraitName)
    | ShortTraitName(LanguageTools.RuntimeTypes.FQTraitName.FQTraitName)
    | TypeReference(TypeReference)
    | TypeOfValue(Dval) // CLEANUP should these all just be ValueTypes?
    | ValueType(ValueType)
    /// A value type together with the type reference it was declared as. One
    /// content hash can be bound to several names, so the declaration is the
    /// only thing that says which of them the author meant.
    | DeclaredValueType(
      Stdlib.Option.Option<LanguageTools.RuntimeTypes.TypeReference>,
      ValueType)
    | FieldName(String) // records and enums
    | InlineFieldName(String) // records and enums

    // -- Values
    | ValueName(FQValueName)

    // -- Variables
    //| DBName(String)
    | VarName(String)
    | InlineVarName(String)

    // -- Dvals
    | InlineValue(Dval) // possibly shortened to be shown inline
    | FullValue(Dval)

    | LetPattern(LetPattern)


  type ES = ErrorSegment


  type ErrorSegments = List<ErrorSegment>


  /// The escaped form of the longest prefix of `chars` that fits in `room` columns. Cuts
  /// between characters, before escaping, so a cut never splits an escape like `\"`.
  let __escapedPrefix(chars: List<Char>, acc: String, room: Int64): String =
    match chars with
    | [] -> acc
    | [c, ...rest] ->
      let e = PrettyPrinter.escapeSpecialCharacters(Stdlib.String.fromChar(c))
      let w = Stdlib.String.displayWidth(e)
      if w > room then acc else __escapedPrefix(rest, acc + e, room - w)


  let segmentsToString(branchId: Uuid, segments: ErrorSegments): String =
    let reversed = Stdlib.List.reverse(segments)

    let parts =
      Stdlib.List.fold(reversed, [], fun(prevSegments, segment) ->

        let newSegment =
          match segment with
          | String(s) -> s
          | Int64(i) -> Stdlib.toString(i)
          | Ordinal(i) -> Stdlib.English.toOrdinal(i)
          | Count(i, singular, plural) ->
            let count = Stdlib.toString(i)

            if i == 1 then
              let segment = segmentsToString(branchId, [ singular ])
              $"{count} {segment}"
            else
              let segment = segmentsToString(branchId, [ plural ])
              $"{count} {segment}"

          | IndefiniteArticle ->
            //Stdlib.debug("prevSegments", prevSegments)
            match Stdlib.List.head(prevSegments) with
            | None -> ""
            | Some(prev) -> Stdlib.English.articleFor(prev) + " "

          | FunctionName(fn) -> fnName(branchId, fn)

          | Description(d) -> d
          | ParamName(p) -> $"`{p}`"
          | InlineParamName(p) -> p // Inline versions don't have quotes
          | TypeName(t) -> typeName(branchId, t)
          | ValueName(v) -> valueName(branchId, v)
          | ShortTypeName(t) -> shortTypeName(branchId, t)
          | TraitName(t) -> traitName(branchId, t)
          | ShortTraitName(t) -> shortTraitName(branchId, t)
          | TypeReference(t) -> typeReference(branchId, t)
          | TypeOfValue(dv) -> Dval.valueTypeName(branchId, dv)
          | ValueType(vt) -> valueType(branchId, vt)
          | DeclaredValueType(declared, vt) ->
            declaredValueType(branchId, declared, vt)
          | FieldName(f) -> $"`{f}`"
          | InlineFieldName(f) -> f
          | VarName(v) -> $"`{v}`"
          | InlineVarName(v) -> v
          | InlineValue(DString(s)) ->
            let escaped = PrettyPrinter.escapeSpecialCharacters(s)

            if Stdlib.String.displayWidth(escaped) <= 11 then
              $"\"{escaped}\""
            else
              $"\"{__escapedPrefix(Stdlib.String.toList(s), "", 8)}...\""
          | InlineValue(dv) ->
            (dval(branchId, dv))
            |> Stdlib.Text.ellipsis(13)
            |> Stdlib.String.splitOnNewline
            |> Stdlib.String.join("")
          | FullValue(dv) -> dval(branchId, dv)
          | LetPattern(p) -> letPattern(p)
          | segment ->
            $"(RTETODO segmentsToString parts {(Stdlib.Json.serialize<ErrorSegment>(segment))})"

        Stdlib.List.prepend(prevSegments, newSegment))

    Stdlib.String.join(parts, "")


  /// For a value type that has a `toString` in stdlib, return a hint
  /// suffix pointing the user at the right conversion function. Empty
  /// string otherwise (Unknown, Unit, String, collection/custom types).
  let toStringHint(vt: LanguageTools.RuntimeTypes.ValueType): String =
    // One hint for the types that have a ToString impl; `Stdlib.toString` is the fn to
    // reach for whichever it is. Collections and custom types have none, so no hint.
    match vt with
    | Known(KTInt8)
    | Known(KTUInt8)
    | Known(KTInt16)
    | Known(KTUInt16)
    | Known(KTInt32)
    | Known(KTUInt32)
    | Known(KTInt64)
    | Known(KTUInt64)
    | Known(KTInt128)
    | Known(KTUInt128)
    | Known(KTBigInt)
    | Known(KTFloat)
    | Known(KTFloat32)
    | Known(KTDecimal)
    | Known(KTBool)
    | Known(KTChar)
    | Known(KTDateTime)
    | Known(KTUuid) -> ". Try wrapping it with `Stdlib.toString`."
    | _ -> ""


  /// <fn toStringHint> for a value that went where a String was expected, and nothing otherwise.
  let stringExpectedHint(expected: ValueType, actual: ValueType): String =
    match expected with
    | Known(KTString) -> toStringHint(actual)
    | _ -> ""


  /// `"total: " + 5` is the usual way a newcomer meets this error, so when one side is a String
  /// and the other has a ToString impl, say how to join them.
  let joinWithStringHint(left: ValueType, right: ValueType): ErrorSegments =
    let other =
      match (left, right) with
      | (Known(KTString), Known(KTString)) -> Stdlib.Option.Option.None
      | (Known(KTString), other) -> Stdlib.Option.Option.Some(other)
      | (other, Known(KTString)) -> Stdlib.Option.Option.Some(other)
      | _ -> Stdlib.Option.Option.None
    match other with
    | Some(vt) when toStringHint(vt) != "" ->
      [ ES.String(". To join them, make the ")
        ES.ValueType(vt)
        ES.String(" a String with `Stdlib.toString`, or interpolate it: `$\"total: {n}\"`.") ]
    | _ -> []


  /// ". Both sides must be the same type." and how to convert, for an integer and a Float
  /// (<fn LanguageTools.AtRestTypeChecker.mixedNumbersHint>, which the check before a run uses).
  let mixedNumbersHint(left: ValueType, right: ValueType): ErrorSegments =
    let name =
      fun vt ->
        match vt with
        | Known(KTInt8) -> "Int8"
        | Known(KTUInt8) -> "UInt8"
        | Known(KTInt16) -> "Int16"
        | Known(KTUInt16) -> "UInt16"
        | Known(KTInt32) -> "Int32"
        | Known(KTUInt32) -> "UInt32"
        | Known(KTInt64) -> "Int64"
        | Known(KTUInt64) -> "UInt64"
        | Known(KTInt128) -> "Int128"
        | Known(KTUInt128) -> "UInt128"
        | Known(KTBigInt) -> "BigInt"
        | Known(KTFloat) -> "Float"
        | _ -> ""
    match LanguageTools.AtRestTypeChecker.mixedNumbersHint(name(left), name(right)) with
    | "" -> []
    | text -> [ ES.String(". Both sides must be the same type. " + text) ]


  /// `&&` or `||` met a non-Bool. Names the side that wasn't a Bool, and only that one: when
  /// the left side isn't a Bool, the right may never have been evaluated.
  let boolOperandSegments(
    op: String,
    left: ValueType,
    right: ValueType)
    : ErrorSegments =
    let (side, vt) =
      match left with
      | Known(KTBool) -> ("right", right)
      | _ -> ("left", left)

    [ ES.String($"`{op}` only works on Bools, but its {side} side is ")
      ES.IndefiniteArticle
      ES.ValueType(vt) ]


  // The only exhaustive match over RuntimeError on the Dark side. A new RuntimeError case needs an
  // arm here, and Dark says nothing at build time: the first error of that kind raises right here.
  let toSegments(
    e: LanguageTools.RuntimeTypes.RuntimeError.Error)
    : ErrorSegments =
    match e with
    | Bool(err) ->
      match err with
      | AndOnlySupportsBooleans(left, right) -> boolOperandSegments("&&", left, right)
      // F# names these fields (gotRight, gotLeft), but the interpreter passes the left
      // operand first, as it does for `&&`.
      | OrOnlySupportsBooleans(left, right) -> boolOperandSegments("||", left, right)

      | ConditionRequiresBool(actualValueType, actualValue) ->
        [ ES.String("Encountered a condition that must be a Bool, but got ")
          ES.IndefiniteArticle
          ES.ValueType(actualValueType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(")") ]

    | BigInt(DivideByZeroError) -> [ ES.String("Cannot divide by 0") ]
    | BigInt(OutOfRange) -> [ ES.String("Encountered an out-of-range integer value") ]
    | DecimalOutOfRange -> [ ES.String("Decimal result is out of range (larger than 79228162514264337593543950335)") ]
    | BigInt(NegativeExponent) -> [ ES.String("Cannot raise integer to a negative exponent") ]
    | BigInt(NegativeModulus) -> [ ES.String("Cannot evaluate modulus against a negative number") ]
    | BigInt(ZeroModulus) -> [ ES.String("Cannot evaluate modulus against 0") ]

    | String(NonStringInInterpolation(vt, dv)) ->
      [ ES.String("Expected String in string interpolation, got ")
        ES.IndefiniteArticle
        ES.ValueType(vt)
        ES.String(" (")
        ES.InlineValue(dv)
        ES.String($") instead{toStringHint(vt)}") ]

    | List(TriedToAddMismatchedData(index, expectedType, actualType, actualValue)) ->
      [ ES.String("Cannot add ")
        ES.IndefiniteArticle
        ES.ValueType(actualType)
        ES.String(" (")
        ES.FullValue(actualValue)
        ES.String(") to a list of ")
        ES.ValueType(expectedType)
        ES.String(". Failed at index ")
        ES.Int64(Stdlib.Int64.fromInt32(index))
        ES.String(".")]

    | List(CannotSort(value)) ->
      [ ES.String("Cannot sort ")
        ES.FullValue(value)
        ES.String(". Bytes, functions and streams have no order;")
        ES.String(" use List.sortBy with a key that has one.") ]

    | Dict(err) ->
      match err with
      | TriedToAddMismatchedData(key, expectedType, actualType, actualValue) ->
        [ ES.String("Cannot add ")
          ES.IndefiniteArticle
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(") to a dict of ")
          ES.ValueType(expectedType)
          ES.String(". Failed at key ")
          ES.FullValue(key)
          ES.String(".") ]
      | UnsupportedKeyType(_keyType, key) ->
        [ ES.String("Cannot use ")
          ES.FullValue(key)
          ES.String(" as a dict key. Functions, streams,")
          ES.String(" and values containing them cannot be keys.") ]
      | NaNKey(key) ->
        [ ES.String("Cannot use ")
          ES.FullValue(key)
          ES.String(" as a dict key. NaN is not equal to itself,")
          ES.String(" so a key holding it could never be found.") ]
      | MismatchedKeyType(expectedType, actualType, actualKey) ->
        [ ES.String("This dict uses keys of type ")
          ES.ValueType(expectedType)
          ES.String(", but ")
          ES.FullValue(actualKey)
          ES.String(" has type ")
          ES.ValueType(actualType)
          ES.String(".") ]

    | Let(PatternDoesNotMatch(dval, pat)) ->
      [ ES.String("Could not deconstruct value ")
        ES.FullValue(dval)
        ES.String(" into pattern ")
        ES.LetPattern(pat) ]

    | VariableNotFound(attemptedVarName) ->
      [ ES.String($"There is no variable named: {attemptedVarName}") ]

    | EqualityCheckOnIncompatibleTypes(left, right) ->
      Stdlib.List.concat(
        [ ES.String("Cannot perform equality check on ")
          ES.ValueType(left)
          ES.String(" and ")
          ES.ValueType(right) ],
        mixedNumbersHint(left, right))

    | NumericOperationOnIncompatibleTypes(left, right) ->
      Stdlib.List.concat(
        [ ES.String("Cannot perform numeric operation on ")
          ES.ValueType(left)
          ES.String(" and ")
          ES.ValueType(right) ],
        Stdlib.List.concat(joinWithStringHint(left, right), mixedNumbersHint(left, right)))

    | IfConditionNotBool(actualValue, actualValueType) ->
      [ ES.String("If condition must be a Bool, but got ")
        ES.ValueType(actualValueType)
        ES.String(" (")
        ES.FullValue(actualValue)
        ES.String(")") ]

    | Match(err) ->
      match err with
      | MatchUnmatched(unmatchedValue) ->
          [ ES.String("No matching case found for value ")
            ES.FullValue(unmatchedValue)
            ES.String(" in match expression") ]

    | ParseTimeNameResolution(originalName, err) ->
      let nameStr = Stdlib.String.join(originalName, ".")

      match err with
      | NotFound ->
        [ ES.String(nameStr + " not found" + PrettyPrinter.ProgramTypes.NameResolutionError.hint(originalName)) ]
      | InvalidName -> [ES.String(nameStr + " is not a valid name")]

    | TypeNotFound(name) ->
      [ ES.String("Type ")
        ES.TypeName(name)
        ES.String(" couldn't be found") ]
    | ValueNotFound(name) ->
      [ ES.String("Value ")
        ES.ValueName(name)
        ES.String(" couldn't be found") ]
    | FnNotFound(name) ->
      [ ES.String("Function ")
        ES.FunctionName(name)
        ES.String(" couldn't be found") ]

    | WrongNumberOfTypeArgsForType(typeName, expected, actual) ->
      [ ES.TypeName(typeName)
        ES.String(" expects ")
        ES.Count(expected, ES.String("type argument"), ES.String("type arguments"))
        ES.String(", but got ")
        ES.Count(actual, ES.String("type argument"), ES.String("type arguments")) ]

    | DeprecatedItemHalted(_target) ->
      [ ES.String("Refusing to run a function marked Harmful. ")
        ES.String("Pass --allow-harmful to run/eval if you really meant to.") ]

    | Record(err) ->
      match err with
      // -- Creation --
      | CreationTypeNotRecord(name) ->
        [ ES.String("Expected a record, but ")
          ES.TypeName(name)
          ES.String(" is not one") ]
      | CreationEmptyKey -> [ ES.String("Empty key in record creation") ]
      | CreationMissingField(fieldName) ->
        [ ES.String("Missing field ")
          ES.FieldName(fieldName)
          // ES.String " in "
          // ES.TypeName typeName
          ]
      | CreationDuplicateField(fieldName) ->
        [ ES.String("Duplicate field ")
          ES.FieldName(fieldName)
          // ES.String " in "
          // ES.TypeName typeName
          ]
      | CreationFieldNotExpected(fieldName) ->
        [ ES.String("No field named ")
          ES.FieldName(fieldName)
          // ES.String " in "
          // ES.TypeName typeName
          // ES.String " record"
          ]
      | CreationFieldOfWrongType(fieldName, declaredType, expectedType, actualType, actualValue) ->
        [ ES.String("Failed to create record. ")
          ES.String("Expected ")
          ES.DeclaredValueType(declaredType, expectedType)
          ES.String(" for field ")
          ES.FieldName(fieldName)
          ES.String(", but got ")
          ES.InlineValue(actualValue)
          ES.String(" (")
          ES.IndefiniteArticle
          ES.ValueType(actualType)
          ES.String(")") ]

      // -- Update --
      | UpdateNotRecord(actualType) ->
        [ ES.String("Cannot apply a record-update to ")
          ES.IndefiniteArticle
          ES.ValueType(actualType) ]
      | UpdateEmptyKey -> [ ES.String("Empty key in record update") ]
      | UpdateDuplicateField(fieldName) ->
        [ ES.String("Duplicate field ")
          ES.FieldName(fieldName)
          // ES.String " in "
          // ES.TypeName typeName
          ]
      | UpdateFieldNotExpected(fieldName) ->
        [ ES.String("No field named ")
          ES.FieldName(fieldName)
          // ES.String " in "
          // ES.TypeName typeName
          // ES.String " record"
          ]
      | UpdateFieldOfWrongType(fieldName, declaredType, expectedType, actualType, actualValue) ->
        [ ES.String("Failed to create updated record. ")
          ES.String("Expected ")
          ES.DeclaredValueType(declaredType, expectedType)
          ES.String(" for field ")
          ES.FieldName(fieldName)
          ES.String(", but got ")
          ES.InlineValue(actualValue)
          ES.String(" (")
          ES.IndefiniteArticle
          ES.ValueType(actualType)
          ES.String(")") ]

      // -- Field Access --
      | FieldAccessEmptyFieldName ->
        [ ES.String("Field name is empty") ]
      | FieldAccessFieldNotFound(fieldName) ->
        [ ES.String("Tried to access field ")
          ES.FieldName(fieldName)
          ES.String(", but it doesn't exist")
          // ES.String " in "
          // ES.TypeName typeName
          ]
      | FieldAccessNotRecord(actualType) ->
        [ ES.String("Attempting to perform field access of ")
          ES.IndefiniteArticle
          ES.ValueType(actualType)
          ES.String(", but this only works with records and tuples") ]
      | FieldAccessTupleIndexOutOfRange(fieldName, tupleLength) ->
        [ ES.String($"Tried to access element .{fieldName} of a tuple with ")
          ES.Int64(tupleLength)
          ES.String(" elements; tuple elements are numbered from .1") ]


    | Enum(err) ->
      match err with
      | ConstructionWrongNumberOfFields(typeName, caseName, expectedFieldCount, actualFieldCount) ->
        [ ES.String("Expected ")
          ES.Count(expectedFieldCount, ES.String("field"), ES.String("fields"))
          ES.String(" in ")
          ES.TypeName(typeName)
          ES.String(".")
          ES.FieldName(caseName)
          ES.String(", but got ")
          ES.Int64(actualFieldCount) ]

      | ConstructionCaseNotFound(typeName, caseName) ->
        [ ES.String("There is no case named ")
          ES.FieldName(caseName)
          ES.String(" in ")
          ES.TypeName(typeName) ]

      | ConstructionFieldOfWrongType(caseName, fieldIndex, declaredType, expectedType, actualType, actualValue) ->
        [ ES.String("Failed to create enum. ")
          ES.String("Expected ")
          ES.DeclaredValueType(declaredType, expectedType)
          ES.String(" for field ")
          ES.Int64(fieldIndex)
          ES.String(" in ")
          ES.FieldName(caseName)
          ES.String(", but got ")
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(")") ]

    | Unwrap(err) ->
      match err with
      | GotNone -> [ ES.String("Cannot unwrap None") ]
      | GotError(err) -> [ ES.String("Cannot unwrap Error: "), ES.FullValue(err) ]
      | NonOptionOrResult(actual) -> [ ES.String("Can only unwrap Options and Results, yet got "), ES.FullValue(actual) ]
      | UnwrapContainerMismatch(actual) ->
        let (got, returns, convert) =
          match actual with
          | DEnum(_, _, _, caseName, _) ->
            if caseName == "Some" || caseName == "None" then
              ("an Option", "a Result", "Stdlib.Option.toResult")
            else
              ("a Result", "an Option", "Stdlib.Result.toOption")
          | _ -> ("a value", "a different container", "a conversion")
        [ ES.String($"`?` got {got}, but the enclosing function or lambda ")
          ES.String($"returns {returns}; convert it first with {convert}: ")
          ES.FullValue(actual) ]
      | UnwrapOperandNotContainer(actual) ->
        [ ES.String("`?` needs an Option or Result, but got ")
          ES.InlineValue(actual)
          ES.String(" (")
          ES.IndefiniteArticle
          ES.TypeOfValue(actual)
          ES.String(")") ]
      | MultipleArgs(args) ->
        [ ES.String("Unwrap expects a single argument, but got ")
          ES.Int64(Stdlib.List.length(args)) ]

    | Apply(err) ->
      match err with
      | ExpectedApplicableButNot(actualTyp, actualValue) ->
        [ ES.String("Expected something we could apply to, such as a lambda or function, but got ")
          ES.IndefiniteArticle
          ES.ValueType(actualTyp)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(")") ]

      | WrongNumberOfTypeArgsForFn(fn, expected, actual) ->
        [ ES.FunctionName(fn)
          ES.String(" expects ")
          ES.Count(expected, ES.String("type argument"), ES.String("type arguments"))
          ES.String(", but got ")
          ES.Count(actual, ES.String("type argument"), ES.String("type arguments")) ]
      | CannotApplyTypeArgsMoreThanOnce ->
        [ ES.String("Cannot apply type arguments more than once") ]
      | TooManyArgsForFn(fn, expected, actual) ->
        [ ES.FunctionName(fn)
          ES.String(" expects ")
          ES.Count(expected, ES.String("argument"), ES.String("arguments"))
          ES.String(", but got ")
          ES.Count(actual, ES.String("argument"), ES.String("arguments")) ]
      | TooFewArgsForFn(fn, expected, actual) ->
        [ ES.FunctionName(fn)
          ES.String(" expects ")
          ES.Count(expected, ES.String("argument"), ES.String("arguments"))
          ES.String(", but got ")
          ES.Count(actual, ES.String("argument"), ES.String("arguments"))
          ES.String("; to supply the rest later, write a lambda") ]
      | FnParameterNotExpectedType(fnName, paramIndex, paramName, declaredType, expectedType, actualType, actualValue) ->
        [ ES.FunctionName(fnName)
          ES.String("'s ")
          ES.Ordinal(paramIndex + 1)
          ES.String(" parameter ")
          ES.ParamName(paramName)
          ES.String(" expects ")
          ES.DeclaredValueType(declaredType, expectedType)
          ES.String(", but got ")
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(")" + stringExpectedHint(expectedType, actualType)) ]
      | FnResultNotExpectedType(fnName, declaredType, expectedType, actualType, actualValue) ->
        [ ES.FunctionName(fnName)
          ES.String("'s return value expects ")
          ES.DeclaredValueType(declaredType, expectedType)
          ES.String(", but got ")
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String(")" + stringExpectedHint(expectedType, actualType)) ]



      | LambdaResultNotExpectedType(fnName, paramIndex, paramName, declaredType, expectedType, actualType, actualValue) ->
        [ ES.FunctionName(fnName)
          ES.String("'s ")
          ES.Ordinal(paramIndex + 1)
          ES.String(" parameter ")
          ES.ParamName(paramName)
          ES.String(" returned ")
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String("), but should return ")
          ES.DeclaredValueType(declaredType, expectedType) ]

      | CannotApplyTypeArgsToLambda ->
        [ ES.String("Cannot apply type arguments to a lambda") ]

      | TooManyArgsForLambda(_lambdaExprId, expected, actual) ->
        [ ES.String("Lambda expects ")
          ES.Count(expected, ES.String("argument"), ES.String("arguments"))
          ES.String(", but got ")
          ES.Count(actual, ES.String("argument"), ES.String("arguments")) ]

      | TooFewArgsForLambda(_lambdaExprId, expected, actual) ->
        [ ES.String("Lambda expects ")
          ES.Count(expected, ES.String("argument"), ES.String("arguments"))
          ES.String(", but got ")
          ES.Count(actual, ES.String("argument"), ES.String("arguments")) ]

      | LambdaNotAvailable(_lambdaExprId) ->
        [ ES.String("This lambda was made by an earlier run and its instructions ")
          ES.String("belong to that run, so it can't be called here. ")
          ES.String("Store a named function (`let f() = ...`) instead, ")
          ES.String("which is rebuilt per call.") ]

    | Statement(err) ->
      match err with
      | FirstExpressionMustBeUnit(_exprId, expectedTypes, actualType, actualValue) ->
        [ ES.String("A statement before the last must return ")
          ES.ValueType(expectedTypes)
          ES.String(", but this one returned ")
          ES.ValueType(actualType)
          ES.String(" (")
          ES.FullValue(actualValue)
          ES.String("). Discard a value with `let _ = ...`") ]

    | Json(err) ->
      match err with
      | UnsupportedType(typ) ->
        [ ES.String("Unsupported type in JSON: ")
          ES.TypeReference(typ)
          ES.String(". Some types are not supported in Json serialization, and cannot be used as arguments to ")
          ES.FunctionName(LanguageTools.RuntimeTypes.FQFnName.FQFnName.Builtin(LanguageTools.RuntimeTypes.FQFnName.Builtin { name = "jsonParse", version = 0s32 }))
          ES.String(" or ")
          ES.FunctionName(LanguageTools.RuntimeTypes.FQFnName.FQFnName.Builtin(LanguageTools.RuntimeTypes.FQFnName.Builtin { name = "jsonSerialize", version = 0s32 })) ]
      | CannotSerializeValue(dv) ->
        [ ES.String("Cannot serialize ")
          ES.FullValue(dv)
          ES.String(" into JSON") ]

    | Trait(err) ->
      match err with
      | MissingImpl(trait_, self) ->
        // The type is in hand, so the fix-it names it: `impl Add for <type>` made the reader
        // work out that `<type>` meant the String they had just used.
        [ ES.ValueType(self)
          ES.String(" has no implementation of ")
          ES.TraitName(trait_)
          ES.String(". Write `impl ")
          ES.ShortTraitName(trait_)
          ES.String(" for ")
          ES.ValueType(self)
          ES.String(" = ...`, or run `dark impls ")
          ES.ShortTraitName(trait_)
          ES.String("` to see which types do") ]
      | DispatchAmbiguous(trait_, self, candidates) ->
        [ ES.String(Stdlib.toString(Stdlib.List.length(candidates)))
          ES.String(" implementations of ")
          ES.TraitName(trait_)
          ES.String(" for ")
          ES.ValueType(self)
          ES.String(" exist, and there is no record of which came first, so none is used. `dark impls ")
          ES.ShortTraitName(trait_)
          ES.String("` lists them; `dark deprecate impl <name>` retires one") ]
      | MethodAmbiguous(method_, self, traits) ->
        // No article in front of the type: an article here produces "on a Int64".
        [ ES.ValueType(self)
          ES.String($" has more than one `{method_}`: ")
          ES.String(Stdlib.toString(Stdlib.List.length(traits)))
          ES.String($" traits declare it. Say which one you mean, as `SomeTrait.{method_}(value)`") ]
      | SelfTypeUnknown(trait_, method_) ->
        [ ES.ShortTraitName(trait_)
          ES.String($".{method_} has no argument to read a type from, so it cannot tell which ")
          ES.String("type you mean. Name it: `")
          ES.ShortTraitName(trait_)
          ES.String($".{method_}<Int64>(...)`") ]
      // Raised from one place only: an implementation WAS chosen, and it lacks the method. Saying
      // the trait has no such method sent people looking at a trait that declares it, typically
      // one just given a new method that its existing implementations don't have yet.
      | NoSuchMethod(trait_, method_) ->
        [ ES.String("The implementation of ")
          ES.TraitName(trait_)
          ES.String($" chosen here has no `{method_}`. Add it to that implementation; `dark impls ")
          ES.ShortTraitName(trait_)
          ES.String("` lists them") ]
      | TraitNotFound(trait_) ->
        [ ES.String("Trait ")
          ES.TraitName(trait_)
          ES.String(" is not on this branch") ]

    | CLI(err) ->
      match err with
      | NoExpressionsToExecute ->
        [ ES.String("Nothing to evaluate. Add a final expression after your declarations. For a .dark script, use `main(args)` to call your function, or `0` to exit successfully. See `dark docs scripts`.") ]
      | NonIntReturned(returnedValue) ->
        [ ES.String("Script must finish with an Int64 exit code (0 succeeds) or Unit; got ")
          ES.FullValue(returnedValue)
          ES.String(". A main function is not called automatically: finish with `main(args)` to call it. See `dark docs scripts`.") ]

    | UncaughtException(msg, metadata) ->
      let withMetadata =
        match metadata with
        | [] -> []
        | metadata ->
          let metadataStrings =
            Stdlib.List.map(metadata, fun((key, value)) ->
              ES.String($"\n  {key}: {Stdlib.Json.serialize<Dval>(value)}"))

          Stdlib.List.prepend(metadataStrings, ES.String("\nMetadata:"))

      Stdlib.List.concat(
        [ ES.String("Uncaught exception: "), ES.String(msg) ],
        withMetadata)

    // Its own sentence and nothing else: it is a refusal, written for whoever ran the command.
    | Condition(message) -> [ ES.String(message) ]

    // Every case above has a message, so this only fires for a case added without one.
    | unhandled ->
      let serialized = Stdlib.Json.serialize<LanguageTools.RuntimeTypes.RuntimeError.Error>(unhandled)
      [ ES.String($"A runtime error with no message written for it yet: {serialized}") ]



  let toString(
    branchId: Uuid,
    e: LanguageTools.RuntimeTypes.RuntimeError.Error)
    : String =
    let s = e |> toSegments
    segmentsToString(branchId, s)


  type ErrorMessage = ErrorString(String)

  let toErrorMessage(
        branchId: Uuid,
        e: LanguageTools.RuntimeTypes.RuntimeError.Error)
    : ErrorMessage =
    ErrorMessage.ErrorString(toString(branchId, e))
