module Darklang.PrettyPrinter

module ModuleDeclaration =
  type Module =
    { name: String
      types: List<LanguageTools.ProgramTypes.PackageType.PackageType>
      fns: List<LanguageTools.ProgramTypes.PackageFn.PackageFn>
      values: List<LanguageTools.ProgramTypes.PackageValue.PackageValue>
      traits: List<LanguageTools.ProgramTypes.Trait.Trait>
      impls: List<LanguageTools.ProgramTypes.TraitImpl.TraitImpl>
      exprs: List<LanguageTools.ProgramTypes.Expr * List<String>>
      submodules: List<Module> }

  /// Add an item that has no module path to the sentinel module `name`, creating it at the end
  /// of `ms` if it isn't there yet. Everything already in `ms` is kept.
  let intoRootless (ms: List<Module>) (name: String) (add: Module -> Module) : List<Module> =
    let (found, others) = ms |> Stdlib.List.partition (fun m -> m.name == name)

    let target =
      match found with
      | m :: _ -> m
      | [] ->
        Module
          { name = name
            types = []
            fns = []
            values = []
            traits = []
            impls = []
            exprs = []
            submodules = [] }

    Stdlib.List.append others [ add target ]

  let withTypeHelper
    (ms: List<Module>)
    (t: LanguageTools.ProgramTypes.PackageType.PackageType)
    (modulePath: List<String>)
    : List<Module> =
    match modulePath with
    // An item with no module path (`Owner.name`) has nowhere in the tree to go. Keep the modules
    // accumulated so far and add it under a sentinel, rather than replacing them with it.
    | [] -> ModuleDeclaration.intoRootless ms "type has no modules" (fun m -> { m with types = Stdlib.List.append m.types [ t ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      match (foundModuleMaybe, submoduleNames) with
      | [], [] ->
        let newModule =
          Module
            { name = firstModuleNamePart
              types = [ t ]
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = [] }

        Stdlib.List.append otherModules [ newModule ]

      | [], submoduleNames ->
        let newModuleWithSubmodule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = withTypeHelper [] t submoduleNames }

        Stdlib.List.append otherModules [ newModuleWithSubmodule ]

      | foundModule :: _, [] ->
        let updatedModule =
          { foundModule with
              types = Stdlib.List.append foundModule.types [ t ] }

        Stdlib.List.append otherModules [ updatedModule ]

      | foundModule :: _, submoduleNames ->
        let updatedModule =
          { foundModule with
              submodules = withTypeHelper foundModule.submodules t submoduleNames }

        Stdlib.List.append otherModules [ updatedModule ]

  let withType
    (branchId: Uuid)
    (ms: List<Module>)
    (t: LanguageTools.ProgramTypes.PackageType.PackageType)
    : List<Module> =
    match Darklang.LanguageTools.PackageManager.pickLocation Darklang.LanguageTools.PackageManager.PickContext.empty (LanguageTools.PackageManager.Type.locations branchId t.hash) with
    | Some location ->
      // The owner is NOT a module. The parser takes it as a separate input, so printing it as one
      // means the output re-parses a level deeper than it started: `module Tests = ...` fed back in
      // with owner "Tests" becomes `Tests.Tests.*`, and again on every pass after that.
      let fullPath = location.modules
      withTypeHelper ms t fullPath
    | None ->
      [ Module
          { name = "type with unknown location"
            types = [ t ]
            fns = []
            values = []
            traits = []
            impls = []
            exprs = []
            submodules = [] } ]


  let withFnHelper
    (ms: List<Module>)
    (f: LanguageTools.ProgramTypes.PackageFn.PackageFn)
    (modulePath: List<String>)
    : List<Module> =
    match modulePath with
    // An item with no module path (`Owner.name`) has nowhere in the tree to go. Keep the modules
    // accumulated so far and add it under a sentinel, rather than replacing them with it.
    | [] -> ModuleDeclaration.intoRootless ms "fn has no modules" (fun m -> { m with fns = Stdlib.List.append m.fns [ f ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      match (foundModuleMaybe, submoduleNames) with
      | [], [] ->
        let newModule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = [ f ]
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = [] }

        Stdlib.List.append otherModules [ newModule ]

      | [], submoduleNames ->
        let newModuleWithSubmodule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = withFnHelper [] f submoduleNames }

        Stdlib.List.append otherModules [ newModuleWithSubmodule ]

      | foundModule :: _, [] ->
        let updatedModule =
          { foundModule with
              fns = Stdlib.List.append foundModule.fns [ f ] }

        Stdlib.List.append otherModules [ updatedModule ]

      | foundModule :: _, submoduleNames ->
        let updatedModule =
          { foundModule with
              submodules = withFnHelper foundModule.submodules f submoduleNames }

        Stdlib.List.append otherModules [ updatedModule ]

  let withFn
    (branchId: Uuid)
    (ms: List<Module>)
    (f: LanguageTools.ProgramTypes.PackageFn.PackageFn)
    : List<Module> =
    match Darklang.LanguageTools.PackageManager.pickLocation Darklang.LanguageTools.PackageManager.PickContext.empty (LanguageTools.PackageManager.Function.locations branchId f.hash) with
    | Some location ->
      // The owner is NOT a module. The parser takes it as a separate input, so printing it as one
      // means the output re-parses a level deeper than it started: `module Tests = ...` fed back in
      // with owner "Tests" becomes `Tests.Tests.*`, and again on every pass after that.
      let fullPath = location.modules
      withFnHelper ms f fullPath
    | None ->
      [ Module
          { name = "fn with unknown location"
            types = []
            fns = [ f ]
            values = []
            traits = []
            impls = []
            exprs = []
            submodules = [] } ]

  let withValueHelper
    (ms: List<Module>)
    (v: LanguageTools.ProgramTypes.PackageValue.PackageValue)
    (modulePath: List<String>)
    : List<Module> =
    match modulePath with
    // An item with no module path (`Owner.name`) has nowhere in the tree to go. Keep the modules
    // accumulated so far and add it under a sentinel, rather than replacing them with it.
    | [] -> ModuleDeclaration.intoRootless ms "value has no modules" (fun m -> { m with values = Stdlib.List.append m.values [ v ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      match (foundModuleMaybe, submoduleNames) with
      | [], [] ->
        let newModule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = [ v ]
              traits = []
              impls = []
              exprs = []
              submodules = [] }

        Stdlib.List.append otherModules [ newModule ]

      | [], submoduleNames ->
        let newModuleWithSubmodule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = withValueHelper [] v submoduleNames }

        Stdlib.List.append otherModules [ newModuleWithSubmodule ]

      | foundModule :: _, [] ->
        let updatedModule =
          { foundModule with
              values = Stdlib.List.append foundModule.values [ v ] }

        Stdlib.List.append otherModules [ updatedModule ]

      | foundModule :: _, submoduleNames ->
        let updatedModule =
          { foundModule with
              submodules = withValueHelper foundModule.submodules v submoduleNames }

        Stdlib.List.append otherModules [ updatedModule ]

  let withValue
    (branchId: Uuid)
    (ms: List<Module>)
    (v: LanguageTools.ProgramTypes.PackageValue.PackageValue)
    : List<Module> =
    match Darklang.LanguageTools.PackageManager.pickLocation Darklang.LanguageTools.PackageManager.PickContext.empty (LanguageTools.PackageManager.Value.locations branchId v.hash) with
    | Some location ->
      // The owner is NOT a module. The parser takes it as a separate input, so printing it as one
      // means the output re-parses a level deeper than it started: `module Tests = ...` fed back in
      // with owner "Tests" becomes `Tests.Tests.*`, and again on every pass after that.
      let fullPath = location.modules
      withValueHelper ms v fullPath
    | None ->
      [ Module
          { name = "value with unknown location"
            types = []
            fns = []
            values = [ v ]
            traits = []
            impls = []
            exprs = []
            submodules = [] } ]

  let withTraitHelper
    (ms: List<Module>)
    (t: LanguageTools.ProgramTypes.Trait.Trait)
    (modulePath: List<String>)
    : List<Module> =
    match modulePath with
    | [] -> ModuleDeclaration.intoRootless ms "trait has no modules" (fun m -> { m with traits = Stdlib.List.append m.traits [ t ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      let target =
        match foundModuleMaybe with
        | found :: _ -> found
        | [] ->
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = [] }

      let updated =
        match submoduleNames with
        | [] -> { target with traits = Stdlib.List.append target.traits [ t ] }
        | submoduleNames ->
          { target with submodules = withTraitHelper target.submodules t submoduleNames }

      Stdlib.List.append otherModules [ updated ]

  let withTrait
    (branchId: Uuid)
    (ms: List<Module>)
    (t: LanguageTools.ProgramTypes.Trait.Trait)
    : List<Module> =
    match Darklang.LanguageTools.PackageManager.pickLocation Darklang.LanguageTools.PackageManager.PickContext.empty (LanguageTools.PackageManager.Trait.locations branchId t.hash) with
    | Some location -> withTraitHelper ms t location.modules
    | None ->
      [ Module
          { name = "trait with unknown location"
            types = []
            fns = []
            values = []
            traits = [ t ]
            impls = []
            exprs = []
            submodules = [] } ]

  /// An impl is named at `<module>[.<Type>].<Trait>`; printed at its location it
  /// would sit inside a module named for the trait, so it prints one level up, where
  /// the `impl ... for Type` header carries the type. Its method fns are the `let m =
  /// Fn` lines of that block, so `toModules` leaves them out of the fns.
  let withImplHelper
    (ms: List<Module>)
    (i: LanguageTools.ProgramTypes.TraitImpl.TraitImpl)
    (modulePath: List<String>)
    : List<Module> =
    match modulePath with
    | [] -> ModuleDeclaration.intoRootless ms "impl has no modules" (fun m -> { m with impls = Stdlib.List.append m.impls [ i ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      let target =
        match foundModuleMaybe with
        | found :: _ -> found
        | [] ->
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = [] }

      let updated =
        match submoduleNames with
        | [] -> { target with impls = Stdlib.List.append target.impls [ i ] }
        | submoduleNames ->
          { target with submodules = withImplHelper target.submodules i submoduleNames }

      Stdlib.List.append otherModules [ updated ]

  let withImpl
    (branchId: Uuid)
    (ms: List<Module>)
    (i: LanguageTools.ProgramTypes.TraitImpl.TraitImpl)
    : List<Module> =
    match Darklang.LanguageTools.PackageManager.pickLocation Darklang.LanguageTools.PackageManager.PickContext.empty (LanguageTools.PackageManager.TraitImpl.locations branchId i.hash) with
    | Some location ->
      // `<module>[.<Type>].<Trait>` names the impl. Drop the type segment when it
      // is there: `impl Show for Point` inside `Shapes` re-lowers to
      // `Shapes.Point.Show` either way, so this always round-trips.
      let ctx = PrettyPrinter.ProgramTypes.Context.forBranch branchId
      let selfHead =
        PrettyPrinter.ProgramTypes.typeReference ctx i.self
        |> Stdlib.String.split "<"
        |> Stdlib.List.head
        |> Stdlib.Option.withDefault ""
        |> Stdlib.String.split "."
        |> Stdlib.List.last
        |> Stdlib.Option.withDefault ""
      let path =
        match Stdlib.List.reverse location.modules with
        | last :: rest when last == selfHead -> Stdlib.List.reverse rest
        | _ -> location.modules
      withImplHelper ms i path
    | None ->
      [ Module
          { name = "impl with unknown location"
            types = []
            fns = []
            values = []
            traits = []
            impls = [ i ]
            exprs = []
            submodules = [] } ]

  /// The fns an impl's `let m = Fn` lines already print
  let implMethodFnHashes
    (impls: List<LanguageTools.ProgramTypes.TraitImpl.TraitImpl>)
    : List<LanguageTools.ProgramTypes.Hash> =
    impls
    |> Stdlib.List.map (fun i ->
      i.methods
      |> Stdlib.List.filterMap (fun (_, fn) ->
        match fn.resolved with
        | Ok resolved ->
          (match resolved.name with
           | Package h -> Stdlib.Option.Option.Some h
           | _ -> Stdlib.Option.Option.None)
        | Error _ -> Stdlib.Option.Option.None))
    |> Stdlib.List.flatten


  let withExpr
    (ms: List<Module>)
    (e: (LanguageTools.ProgramTypes.Expr * List<String>))
    : List<Module> =
    let (expr, modules) = e

    match modules with
    | [] -> ModuleDeclaration.intoRootless ms "expression has no modules" (fun m -> { m with exprs = Stdlib.List.append m.exprs [ (expr, []) ] })

    | firstModuleNamePart :: submoduleNames ->
      let (foundModuleMaybe, otherModules) =
        ms |> Stdlib.List.partition (fun m -> m.name == firstModuleNamePart)

      match (foundModuleMaybe, submoduleNames) with
      | [], [] ->
        let newModule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = [ (expr, []) ]
              submodules = [] }

        Stdlib.List.append otherModules [ newModule ]

      | [], submoduleNames ->
        let newModuleWithSubmodule =
          Module
            { name = firstModuleNamePart
              types = []
              fns = []
              values = []
              traits = []
              impls = []
              exprs = []
              submodules = withExpr [] (expr, submoduleNames) }

        Stdlib.List.append otherModules [ newModuleWithSubmodule ]

      | foundModule :: _, [] ->
        let updatedModule =
          { foundModule with
              exprs = Stdlib.List.append foundModule.exprs [ (expr, []) ] }

        Stdlib.List.append otherModules [ updatedModule ]

      | foundModule :: _, submoduleNames ->
        let updatedModule =
          { foundModule with
              submodules = withExpr foundModule.submodules (expr, submoduleNames) }

        Stdlib.List.append otherModules [ updatedModule ]



  let toModules
    (branchId: Uuid)
    (p: LanguageTools.ProgramTypes.Definitions)
    : List<Module> =
    let empty = []

    let modulesAfterTypes =
      Stdlib.List.fold p.types empty (fun modules t ->
        ModuleDeclaration.withType branchId modules t)

    // An impl's method fns print as its `let m = Fn` lines, not as fns of their own
    let implMethods = ModuleDeclaration.implMethodFnHashes p.impls
    let ownFns =
      p.fns |> Stdlib.List.filter (fun f -> Stdlib.Bool.not (Stdlib.List.``member`` implMethods f.hash))

    let modulesWithTypesAndFns =
      Stdlib.List.fold ownFns modulesAfterTypes (fun modules f ->
        ModuleDeclaration.withFn branchId modules f)

    let modulesWithTypesAndFnsAndValues =
      Stdlib.List.fold p.values modulesWithTypesAndFns (fun modules v ->
        ModuleDeclaration.withValue branchId modules v)

    let modulesWithTraits =
      Stdlib.List.fold p.traits modulesWithTypesAndFnsAndValues (fun modules t ->
        ModuleDeclaration.withTrait branchId modules t)

    let modulesWithImpls =
      Stdlib.List.fold p.impls modulesWithTraits (fun modules i ->
        ModuleDeclaration.withImpl branchId modules i)

    let modulesWithTypesAndFnsAndValuesAndExprs =
      Stdlib.List.fold
        p.exprs
        modulesWithImpls
        (fun modules e ->
          // Same rule as the declarations above: the owner is not a module. An expr's path arrives
          // from the parser owner-first, so drop that segment before nesting it.
          let (expr, path) = e
          let path =
            match path with
            | [] -> []
            | _ :: rest -> rest
          withExpr modules ((expr, path)))


    modulesWithTypesAndFnsAndValuesAndExprs


let moduleDeclaration
  (ctx: PrettyPrinter.ProgramTypes.Context)
  (m: ModuleDeclaration.Module)
  : String =
  // Account for the indentation added after rendering.
  let ctx = { ctx with width = Stdlib.Int.max 1 (ctx.width - 2) }

  let typesPart =
    match m.types with
    | [] -> Stdlib.Option.Option.None
    | types ->
      m.types
      |> Stdlib.List.map (fun t -> PrettyPrinter.ProgramTypes.packageType ctx t)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let fnsPart =
    match m.fns with
    | [] -> Stdlib.Option.Option.None
    | fns ->
      m.fns
      |> Stdlib.List.map (fun f -> PrettyPrinter.ProgramTypes.packageFn ctx f)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let valuesPart =
    match m.values with
    | [] -> Stdlib.Option.Option.None
    | values ->
      m.values
      |> Stdlib.List.map (fun v -> PrettyPrinter.ProgramTypes.packageValue ctx v)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let traitsPart =
    match m.traits with
    | [] -> Stdlib.Option.Option.None
    | traits ->
      traits
      |> Stdlib.List.map (fun t -> PrettyPrinter.ProgramTypes.packageTrait ctx t)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let implsPart =
    match m.impls with
    | [] -> Stdlib.Option.Option.None
    | impls ->
      impls
      |> Stdlib.List.map (fun i -> PrettyPrinter.ProgramTypes.packageImpl ctx i)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let exprsPart =
    match m.exprs with
    | [] -> Stdlib.Option.Option.None
    | exprs ->
      m.exprs
      |> Stdlib.List.map (fun (e, _) -> PrettyPrinter.ProgramTypes.expr ctx e)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some


  let submodulesPart =
    match m.submodules with
    | [] -> Stdlib.Option.Option.None
    | submodules ->
      submodules
      |> Stdlib.List.map (fun m -> PrettyPrinter.moduleDeclaration ctx m)
      |> Stdlib.String.join "\n\n"
      |> Stdlib.Option.Option.Some

  let parts =
    [ typesPart, traitsPart, fnsPart, valuesPart, implsPart, exprsPart, submodulesPart ]
    |> Stdlib.List.filterMap (fun s -> s)

  match parts with
  | [] ->
    // CLEANUP: actually error
    "Error - module defined somehow without parts"
  | parts ->
    let bodyPart = (Stdlib.String.join parts "\n\n") |> PrettyPrinter.indent

    $"module {m.name} =\n{bodyPart}"


let definitions
  (ctx: PrettyPrinter.ProgramTypes.Context)
  (p: LanguageTools.ProgramTypes.Definitions)
  : String =
  let modules = ModuleDeclaration.toModules ctx.branchId p

  // CLEANUP make ordering 'better' in some way
  modules
  |> Stdlib.List.map (fun m -> PrettyPrinter.moduleDeclaration ctx m)
  |> Stdlib.String.join "\n\n"