module Darklang.PrettyPrinter.ProgramTypes

let sourceFileAtWidth(
  branchId: Uuid,
  width: Int64,
  source: LanguageTools.ProgramTypes.SourceFile.SourceFile)
  : String =
  // The parser supplies the owner separately, so print names from the root.
  let ctx = { Context.forModule(branchId, []) with width = width }
  let declsPart =
    Stdlib.List.fold(source.declarations, [], fun(acc, decl) ->
      match decl with
      | Module(moduleDecl) ->
        let prettyPrinted = definitions(ctx, moduleDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Type(typeDecl) ->
        let prettyPrinted = packageType(ctx, typeDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Value(valDecl) ->
        let prettyPrinted = packageValue(ctx, valDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Function(fnDecl) ->
        let prettyPrinted = packageFn(ctx, fnDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Trait(traitDecl) ->
        let prettyPrinted = packageTrait(ctx, traitDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Impl(implDecl) ->
        let prettyPrinted = packageImpl(ctx, implDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Test(testDecl) ->
        let prettyPrinted = packageTest(ctx, testDecl)
        acc |> Stdlib.List.prepend(prettyPrinted))
    |> Stdlib.List.reverse

  let exprsPart =
    Stdlib.List.fold(source.exprsToEval, [], fun(acc, expr) ->
      let prettyPrinted = ProgramTypes.expr(ctx, expr)
      acc |> Stdlib.List.prepend(prettyPrinted))
    |> Stdlib.List.reverse

  [ declsPart, exprsPart ]
  |> Stdlib.List.flatten
  |> Stdlib.String.join("\n\n")


/// The width `.dark` source is written to: what `dark view --raw` and `dark edit` print at,
/// whatever the terminal is, so the source they hand back is laid out the way files are.
val sourceWidth = 100


/// Print a source file using the standard source width.
let sourceFile(branchId: Uuid, source: LanguageTools.ProgramTypes.SourceFile.SourceFile): String =
  sourceFileAtWidth(branchId, sourceWidth, source)
