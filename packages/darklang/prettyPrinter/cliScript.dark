module Darklang.PrettyPrinter.ProgramTypes

let sourceFileAtWidth(
  branchId: Uuid,
  width: Int64,
  source: LanguageTools.ProgramTypes.SourceFile.SourceFile)
  : String =
  // The parser supplies the owner separately, so print names from the root. Which numbers need
  // their suffix is worked out for the file at once: its declarations call each other.
  let ctx =
    { Context.forModule(branchId, []) with
        width = width
        bareNumbers =
          Option.Some(
            LanguageTools.AtRestTypeChecker.Suffixes.droppable(
              branchId,
              sourceFileOps(source.declarations))) }

  let declsPart =
    Stdlib.List.fold(source.declarations, [], fun(acc, decl) ->
      match decl with
      | Module(moduleDecl) ->
        let prettyPrinted = definitions(ctx, moduleDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Type(typeDecl) ->
        let prettyPrinted = packageType(ctx, typeDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Value(valDecl) ->
        let prettyPrinted = packageValue(ctx, valDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Function(fnDecl) ->
        let prettyPrinted = packageFn(ctx, fnDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Trait(traitDecl) ->
        let prettyPrinted = packageTrait(ctx, traitDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Impl(implDecl) ->
        let prettyPrinted = packageImpl(ctx, implDecl)
        acc |> Stdlib.List.prepend(prettyPrinted)
      | Test(testDecl) ->
        let prettyPrinted = packageTest(ctx, testDecl)
        acc |> Stdlib.List.prepend(prettyPrinted))
    |> Stdlib.List.reverse

  let exprsPart =
    Stdlib.List.fold(source.exprsToEval, [], fun(acc, expr) ->
      let prettyPrinted = ProgramTypes.expr(ctx, expr)
      acc |> Stdlib.List.prepend(prettyPrinted))
    |> Stdlib.List.reverse

  [ declsPart, exprsPart ]
  |> Stdlib.List.flatten
  |> Stdlib.String.join("\n\n")


/// <param declarations> as the ops that would add them.
let sourceFileOps(
  declarations: List<LanguageTools.ProgramTypes.SourceFile.Declaration>)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  let ofDefinitions(
    d: LanguageTools.ProgramTypes.Definitions)
    : List<LanguageTools.ProgramTypes.PackageOp> =
    Stdlib.List.flatten(
      [ Stdlib.List.map(d.types, fun t -> LanguageTools.ProgramTypes.PackageOp.AddType(t))
        Stdlib.List.map(d.values, fun v -> LanguageTools.ProgramTypes.PackageOp.AddValue(v))
        Stdlib.List.map(d.fns, fun f -> LanguageTools.ProgramTypes.PackageOp.AddFn(f))
        Stdlib.List.map(d.traits, fun t -> LanguageTools.ProgramTypes.PackageOp.AddTrait(t))
        Stdlib.List.map(d.impls, fun i -> LanguageTools.ProgramTypes.PackageOp.AddTraitImpl(i)) ])

  declarations
  |> Stdlib.List.map(fun d ->
    match d with
    | Module(defs) -> ofDefinitions(defs)
    | Type(t) -> [ LanguageTools.ProgramTypes.PackageOp.AddType(t) ]
    | Value(v) -> [ LanguageTools.ProgramTypes.PackageOp.AddValue(v) ]
    | Function(f) -> [ LanguageTools.ProgramTypes.PackageOp.AddFn(f) ]
    | Trait(t) -> [ LanguageTools.ProgramTypes.PackageOp.AddTrait(t) ]
    | Impl(i) -> [ LanguageTools.ProgramTypes.PackageOp.AddTraitImpl(i) ]
    | Test(t) -> [ LanguageTools.ProgramTypes.PackageOp.AddTest(t) ])
  |> Stdlib.List.flatten


/// The width `.dark` source is written to: what `dark view --raw` and `dark edit` print at,
/// whatever the terminal is, so the source they hand back is laid out the way files are.
val sourceWidth = 100


/// Print a source file using the standard source width.
let sourceFile(branchId: Uuid, source: LanguageTools.ProgramTypes.SourceFile.SourceFile): String =
  sourceFileAtWidth(branchId, sourceWidth, source)
