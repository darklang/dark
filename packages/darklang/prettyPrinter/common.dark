module Darklang.PrettyPrinter

let indent(s: String): String =
  s
  |> Stdlib.String.split("\n")
  |> Stdlib.List.map(fun line ->
    match line with
    | "" -> ""
    | line -> "  " + line)
  |> Stdlib.String.join("\n")


let indentByLevel(level: Int64, s: String): String =
  let indentStr = Stdlib.String.checkedRepeat("  ", level) |> Stdlib.Result.withDefault("")
  s
  |> Stdlib.String.split("\n")
  |> Stdlib.List.map(fun line ->
    match line with
    | "" -> ""
    | line -> indentStr + line)
  |> Stdlib.String.join("\n")


let sign(s: LanguageTools.Sign): String =
  match s with
  | Positive -> ""
  | Negative -> "-"


/// Escape for `"..."` string literals: backslashes, control characters and the closing `"`,
/// symmetric with the parser's `decodeStringContent`.
let escapeSpecialCharacters(s: String): String =
  escapeLiteral(s, "\"")


/// Escape for `'...'` char literals: the same, with `'` as the quote.
let escapeCharLiteral(s: String): String =
  escapeLiteral(s, "'")


/// One hex digit (0-15) as its source character.
let __hexDigitChar(n: Int64): String =
  Stdlib.String.slice("0123456789ABCDEF", n, n + 1)


/// Text a `"..."` literal holds as it is: printable ASCII but `"` and `\`.
val __plainForString = Stdlib.Regex.ofPattern("\\A[ !#-\\[\\]-~]*\\z")


/// Text a `'...'` literal holds as it is: printable ASCII but `'` and `\`.
val __plainForChar = Stdlib.Regex.ofPattern("\\A[ -&(-\\[\\]-~]*\\z")


/// Whether <param s> matches <param pattern> whole.
let __matchesWhole(s: String, pattern: Stdlib.Regex.Regex): Bool =
  match Stdlib.Regex.scan(s, pattern, Stdlib.Regex.Limit.First, Stdlib.Regex.Collect.TextOnly) with
  | Ok(([_, _], _)) -> true
  | _ -> false


/// <param n> as <param digits> upper-case hex digits, in front of <param acc>.
let __hexDigits(n: Int64, digits: Int64, acc: String): String =
  if digits == 0 then
    acc
  else
    let q = Stdlib.Int64.checkedDivide(n, 16) |> Stdlib.Result.withDefault(0)
    let r = Stdlib.Int64.checkedMod(n, 16) |> Stdlib.Result.withDefault(0)
    __hexDigits(q, digits - 1, __hexDigitChar(r) + acc)


/// One code point under 128, <param c>, as written inside a literal closed by <param quote>.
let __escapeAscii(code: Int64, c: String, quote: String): String =
  if code == 92 then
    "\\\\"
  else if code == 7 then
    "\\a"
  else if code == 8 then
    "\\b"
  else if code == 9 then
    "\\t"
  else if code == 10 then
    "\\n"
  else if code == 11 then
    "\\v"
  else if code == 12 then
    "\\f"
  else if code == 13 then
    "\\r"
  else if c == quote then
    "\\" + c
  else if code < 32 || code == 127 then
    "\\u" + __hexDigits(code, 4, "")
  else
    c


/// Code point <param cp> as an escape: `\uXXXX`, or `\UXXXXXXXX` past 16 bits.
let __codepointEscape(cp: Int64): String =
  if cp > 65535 then
    "\\U" + __hexDigits(cp, 8, "")
  else
    "\\u" + __hexDigits(cp, 4, "")


/// One grapheme, <param g>, as written inside a literal closed by <param quote>. One that starts
/// with an ASCII character has its other code points written as escapes, so a quote and a
/// combining accent can't hide the quote from the lexer. U+FFFD is what a bad escape decodes to;
/// written raw it would read as one, so it is always escaped.
let __escapeGrapheme(g: String, quote: String): String =
  let codepoints = Stdlib.String.toCodepoints(g) |> Stdlib.List.map(Stdlib.Int64.fromUInt32)
  match codepoints with
  | [cp] when cp < 128 -> __escapeAscii(cp, g, quote)
  | [] -> g
  | [first, ...] ->
    let asciiFirst = first < 128
    codepoints
    |> Stdlib.List.indexedMap(fun(i, cp) ->
      let one =
        Stdlib.Char.fromCodepoint(Stdlib.UInt32.fromInt64(cp) |> Stdlib.Option.withDefault(0u32))
        |> Stdlib.Option.map(Stdlib.display)
        |> Stdlib.Option.withDefault("")

      if cp < 128 then
        __escapeAscii(cp, one, quote)
      else if asciiFirst && i > 0 || cp == 65533 then
        __codepointEscape(cp)
      else
        one)
    |> Stdlib.String.join("")


/// <param s> as it is written inside a literal closed by <param quote>: backslashes, controls
/// (as `\uXXXX`) and the quote escaped.
let escapeLiteral(s: String, quote: String): String =
  let plain = if quote == "'" then __plainForChar else __plainForString
  if s == "" || __matchesWhole(s, plain) then
    s
  else
    s
    |> Stdlib.String.toList
    |> Stdlib.List.map(fun g -> __escapeGrapheme(Stdlib.display(g), quote))
    |> Stdlib.String.join("")


/// The lexer's reserved words, as a set.
val reservedNames =
  LanguageTools.Parser.keywords
  |> Stdlib.List.map(fun word -> (word, ()))
  |> Stdlib.Dict.fromList


/// A name the lexer reads as a bare identifier, ASCII only: the common case, and cheaper.
val bareAsciiName = Stdlib.Regex.ofPattern("\\A[A-Za-z_][A-Za-z0-9_']*\\z")


/// The lexer's full rule for a bare identifier.
val bareName = Stdlib.Regex.ofPattern("\\A[\\p{L}_][\\p{L}\\p{Nd}_']*\\z")


/// Whether the lexer reads <param name> as one bare identifier: a letter or `_`
/// followed by letters, digits, `_`, or `'` (Unicode letters included). A regex
/// rather than a walk over the characters, since the printer runs this for every
/// name it writes. A whole-name match splits the name into two texts, the empty
/// ones either side of it. The ASCII pattern answers for nearly every name and
/// allocates less; the second is the lexer's full rule.
let hasBareShape(name: String): Bool =
  let first = Stdlib.Regex.Limit.First
  let textOnly = Stdlib.Regex.Collect.TextOnly
  match Stdlib.Regex.scan(name, bareAsciiName, first, textOnly) with
  | Ok(([_, _], _)) -> true
  | _ ->
    match Stdlib.Regex.scan(name, bareName, first, textOnly) with
    | Ok(([_, _], _)) -> true
    | _ -> false


/// Format a name (a variable, parameter or declaration) for source output.
/// Two reasons a name needs backticks:
///  - its shape: a hyphen or a leading digit breaks a bare identifier.
///  - it's a reserved word: keywords lex as their own tokens, so a name
///    literally `type` or `match` needs backticks even though its shape is fine.
/// `_` prints bare, since in a pattern it is the wildcard. The empty name prints as
/// `___`, the lexer's spelling of it. A name holding a backtick, a space or a newline
/// can't be written in source.
let formatName(name: String): String =
  if name == "_" then
    name
  else if name == "" then
    "___"
  else if hasBareShape(name) && Stdlib.Bool.not(Stdlib.Dict.containsKey(reservedNames, name)) then
    name
  else
    $"`{name}`"


/// Format a name where only a name can go: a record field, or after a `.`. A keyword
/// needs no backticks there. `_`, `true` and `false` still do, since they read as a
/// wildcard or a literal.
let formatFieldName(name: String): String =
  if name == "" then
    "___"
  else if
    hasBareShape(name) && Stdlib.Bool.not(Stdlib.List.contains([ "_", "true", "false" ], name))
  then
    name
  else
    $"`{name}`"


/// Print numeric field names without backticks for tuple access such as `t.1`.
let formatAccessedFieldName(name: String): String =
  let isDigits =
    Stdlib.Bool.not(Stdlib.String.isEmpty(name))
    && (name
        |> Stdlib.String.toList
        |> Stdlib.List.all(Stdlib.Char.isDigit))

  if isDigits then name else formatFieldName(name)


/// The fraction of a float literal with its trailing zeros dropped (`1.50` -> `1.5`), by parsing and
/// reprinting it. Only trusted when that comes back as a plain `0.xxx` decimal: `00001` reprints as
/// `1e-5`, and cutting two characters off that gave `0.-5`.
let processRemainder(remainder: String): String =
  match $".{remainder}" |> Stdlib.Float64.parse with
  | Ok(floatValue) ->
    let printed = Stdlib.display(floatValue)
    let isPlainDecimal =
      printed
      |> Stdlib.String.toList
      |> Stdlib.List.all(fun c -> Stdlib.Char.isDigit(c) || Stdlib.display(c) == ".")

    if isPlainDecimal && Stdlib.String.startsWith(printed, "0.") then
      Stdlib.String.dropFirst(printed, 2)
    else
      remainder
  | Error(_) -> remainder


/// Shorten a fully-qualified package name for display from inside `currentModule`.
///
/// The rule mirrors how names are actually resolved, which is the only rule that produces output the
/// parser will accept back. `LibDB.NameLookup.namesToTry` tries the given name with progressively
/// shorter prefixes of the current module glued on the front: from
/// `Darklang.LanguageTools.ProgramTypes.PackageFn`, a bare `TypeReference` is tried as
/// `…PackageFn.TypeReference`, then `…ProgramTypes.TypeReference` (a hit), then `Darklang.TypeReference`,
/// then bare. So the shortest spelling that still resolves is the target's path with its longest common
/// prefix with the current module removed, and that is what this returns.
///
/// Two rules on top, both of which exist because `namesToTry` has them:
///  - `Option` and `Result` resolve unqualified from anywhere, so they are never qualified here.
///  - A path starting `Stdlib` resolves with `Darklang` implied, so the owner comes off.
///
/// Caveat: a name is shortened, not verified. If the current module happened to contain something that
/// captures the short spelling first, the resolver would pick that instead. Checking would mean walking
/// every candidate against the package store for every name printed, which is far too expensive for a
/// listing; the parser round-trip suite is what catches it.
let shortenName(
  currentModule: List<String>,
  owner: String,
  modules: List<String>,
  name: String)
  : String =
  let fullPath = Stdlib.List.prepend(modules, owner)

  // `Option` / `Result` and nothing else: the resolver gives these an unconditional stdlib fallback.
  let isAlwaysBare =
    fullPath == [ "Darklang", "Stdlib", "Option" ] && name == "Option"
    || fullPath == [ "Darklang", "Stdlib", "Result" ] && name == "Result"

  if isAlwaysBare then
    name
  else
    let shared = LanguageTools.PackageManager.countMatchingPrefix(currentModule, fullPath)
    let remaining = Stdlib.List.drop(fullPath, shared)

    // Nothing shared: the resolver implies `Darklang.` in front of `Stdlib.` and nothing else, so
    // that is the one real owner that can come off -- `Darklang.LanguageTools.X` printed as
    // `LanguageTools.X` resolves only when parsed back with owner Darklang. `Tests`, `CliScript`
    // and `""` come off for a different reason: they are scaffolding the parser stamped on, not
    // names anything can be reached by, so printing them tells the reader nothing.
    let scaffoldingOwner = owner == "Tests" || owner == "CliScript" || owner == ""
    let remaining =
      match fullPath with
      | ["Darklang", "Stdlib", ...] when shared == 0 -> Stdlib.List.drop(fullPath, 1)
      | _ when shared == 0 && scaffoldingOwner -> Stdlib.List.drop(fullPath, 1)
      | _ -> remaining

    match remaining with
    | [] -> name
    | segments -> Stdlib.String.join(segments, ".") + "." + name


/// How to paint the pieces of a rendered value.
///
/// The printer knows what KIND each piece is; the caller decides how it looks. That keeps terminal
/// escapes out of `PrettyPrinter`, which has no business knowing about `Cli.Colors`, and means the same
/// value can be painted for a terminal, left plain for a pipe, or styled some other way entirely
/// without the printer changing.
type Palette =
  { string_: String
    number: String
    typeName: String
    caseName: String
    keyword: String
    /// Emitted after every painted piece, so it has to end whatever the others start.
    reset: String }


module Palette =
  /// No decoration at all. The default, because a printer's output is text until someone says otherwise.
  val plain =
    Palette { string_ = "", number = "", typeName = "", caseName = "", keyword = "", reset = "" }


/// How to render something, threaded through the printers rather than read from anywhere.
///
/// No printer looks up the terminal, a config file, or a global. Everything that varies with where the
/// output is going lives here and comes from the caller, so the same value can be printed for a 60-column
/// pane, a piped stdout and a test with the only difference being the record passed in. That is also what
/// makes the printers safely nestable: an inner call cannot disagree with its caller about the rules.
type DisplayOptions =
  {
    /// Columns available for the whole line, counted from column 0. A printer that starts partway
    /// along a line accounts for that itself; this is the page width, not the room remaining.
    width: Int64

    /// The module the reader is standing in, owner-first. Names are spelled relative to it.
    currentModule: List<String>

    /// Print type arguments on enum and record values (`Option<Int64>.Some(1)`). Off is usually right for
    /// a person reading a value, since the payload shows the type; on is useful when the type is the
    /// question being asked.
    showTypeArgs: Bool

    /// How to paint each kind of piece. `Palette.plain` for none.
    palette: Palette

    /// Stop descending past this depth and print a marker instead. `None` means print it all. Traces and
    /// error messages want a shallow cap; `eval` generally doesn't.
    maxDepth: Stdlib.Option.Option<Int64>
  }


module DisplayOptions =
  /// The defaults every existing caller gets. 80 columns because that is what the printers assumed
  /// before this record existed, not because it is a good width; callers that know better should say so.
  val default =
    DisplayOptions
      { width = 80
        currentModule = []
        showTypeArgs = true
        // Written out rather than `Palette.plain`, which is the same value one line up. A package
        // `val` whose body references another `val` evaluates that reference to Unit under the test
        // harness -- the field is present and correctly typed, and reading it still yields Unit. Every
        // other field here is a literal, which is why this was the only one affected.
        palette =
          Palette
            { string_ = ""
              number = ""
              typeName = ""
              caseName = ""
              keyword = ""
              reset = "" }
        maxDepth = Stdlib.Option.Option.None }


  /// The defaults, printed from inside `path`.
  let inModule(path: List<String>): DisplayOptions =
    { default with currentModule = path }


  /// The defaults, painted with `p`.
  let painted(p: Palette): DisplayOptions =
    { default with palette = p }


  /// The defaults at a given width.
  let atWidth(width: Int64): DisplayOptions =
    { default with width = width }
