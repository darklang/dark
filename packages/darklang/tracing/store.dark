/// Reads and maintenance over the recorded trace store.
///
/// Every read is one builtin, `tracesQuery`, asked through `query` with a `TraceQuery`; the
/// functions below keep the names callers use and pick their field out of the answer. Writes
/// and the recording switch are a builtin each. Consumers (the CLI `traces` command, the
/// workbench, dashboards) go through here.
///
/// No SQL here: the trace tables belong to F# (`LibDB.Traces`), and every read
/// and write of them is a builtin.
module Darklang.Tracing.Store

/// Is this trace being recorded? Worth asking before reporting an empty result: with recording
/// off, every query returns empty whatever ran.
let enabled(): Bool =
  Builtin.tracesRecording()


/// The lasting setting: `trace.record` in this instance's store config, which the boot reads.
/// `None` when nothing is stored, in which case the environment or the default decides.
let storedSetting(): Option<Bool> =
  match LanguageTools.LocalStore.configGet("trace.record") with
  | Some("on") -> Option.Some(true)
  | Some("off") -> Option.Some(false)
  | _ -> Option.None


/// Turn recording on or off for this instance: the stored setting, plus this process, so a
/// session that is already open does not have to be restarted. `dark config set trace.record`
/// is the same setting by the other door, and takes effect on the next command.
let setRecording(on: Bool): Unit =
  let _ = LanguageTools.LocalStore.configSet("trace.record", if on then "on" else "off")
  Builtin.tracesApplyRecording(on)


/// What <param q> asks of the trace store. The one way Dark reads it.
let query(q: TraceQuery): TraceAnswer =
  Builtin.tracesQuery(q)


/// The runs <param q> asks for, newest first. `list`, `listByFn`, `find`, `get` and
/// `wentThrough` are the names callers use.
let read(q: TraceQuery): List<Trace> =
  (query(q)).runs


/// The most recent <param limit> traces, newest first.
let list(limit: Int64): List<Trace> =
  read(TraceQuery.Newest(limit))


/// The most recent <param limit> traces that called <param fnName>.
let listByFn(fnName: String, limit: Int64): List<Trace> =
  read(TraceQuery.Calling(fnName, limit))


/// The most recent <param limit> traces whose inputs, args or results
/// contain <param pattern>.
let find(pattern: String, limit: Int64): List<Trace> =
  read(TraceQuery.Containing(pattern, limit))


/// Full payload for one trace: its row, its inputs and its calls.
let view(traceID: String): Option<TraceData> =
  (query(TraceQuery.Detail(traceID))).detail


/// Read saved CLI input without loading the result.
/// Returns None for HTTP traces, or missing or corrupt input.
let getScriptOrEvalInput(traceID: String): Option<ScriptOrEvalInput> =
  (query(TraceQuery.SavedInput(traceID))).savedInput


/// One trace by id, if it is still here.
let get(traceID: String): Option<Trace> =
  Stdlib.List.head(read(TraceQuery.ById(traceID)))


/// A new trace branched from <param traceID>, keeping its log up to <param at> (a position from
/// `traces show`; the whole log when {{None}}), suspended, so `resume` takes it from there.
let fork(traceID: String, at: Option<Int64>): Result<String, String> =
  Builtin.tracesFork(traceID, at)


/// Arm a resume of <param traceID>: the next `eval` or `run` this instance starts replays its
/// log instead of performing the effects, then goes live. `dark traces resume` arms and then
/// runs the trace's own input; that is the whole of a resume.
let armResume(traceID: String): Bool =
  Builtin.tracesArmResume(traceID)


/// Pin a trace so retention never drops it, or unpin it. Returns whether a trace had that id.
let setPinned(traceID: String, pinned: Bool): Bool =
  Builtin.tracesSetPinned(traceID, pinned)


/// The package functions one trace went through: each one's name, and the hash the trace
/// went through. The names are what `traces show <trace>` offers when you name a trace
/// rather than a function; the hashes are what `traces resume` compares against the
/// store to say which of a trace's callees have been edited since.
let fnsWithHashes(traceID: String): List<(String * String)> =
  (query(TraceQuery.FnsOf(traceID))).fns


/// How many times each loop in a run actually went round, as RECORDED.
///
/// Keyed by the lambda's expression id, which is the same key the replay's frames carry. A view
/// recomputes values by replaying, so it can only show what it reaches; this is what HAPPENED,
/// including passes a replay that stopped early will never get to.
let recordedLoopPasses(traceID: String): List<(String * Int64)> =
  (query(TraceQuery.LoopPasses(traceID))).counts


/// Just the names of `fnsWithHashes`.
let fnsOf(traceID: String): List<String> =
  fnsWithHashes(traceID) |> Stdlib.List.map(fun pair -> Stdlib.Tuple2.first(pair))


/// The traces that went through <param fnName>, newest first. Answers at the shipped recording
/// level: it reads the names-only index every recorded trace writes, not the call rows.
/// Which package functions recent runs went through, and how many runs each, most first.
///
/// The other direction from `wentThrough`: that one answers "show me the runs for this
/// function", this one answers "I have not got a function in mind, what have the runs been
/// about". `hotspots` reads the effect log and so can only ever name builtins.
let fnCounts(traceLimit: Int64): List<(String * Int64)> =
  (query(TraceQuery.FnCounts(traceLimit))).counts


/// The runs that went through a function, newest first.
///
/// By name OR by hash, because they answer opposite halves of one question.
///
/// The HASH finds runs of this CODE under any name: Dark is content-addressed, so two
/// byte-identical functions are one function and both names should find the same runs.
///
/// The NAME finds runs of this FUNCTION under any code, which is what makes values follow an
/// edit. Editing a callee changes the caller's hash too, so one edit later the recorded run sits
/// under a hash that nothing resolves to. By hash alone, a live view would go blank the moment
/// you changed anything, which is the opposite of the point.
///
/// `""` for the hash when there is none to give.
let wentThrough(fnName: String, fnHash: String, limit: Int64): List<Trace> =
  read(TraceQuery.WentThrough(fnName, fnHash, limit))


/// The runs that went through a function a person named.
///
/// Resolves the name to its hash first, so every alias of one function finds the same runs, and
/// falls back to the name when the store has no such function. That fallback is what lets a run
/// whose code has since gone stay distinguishable from a typo.
let wentThroughNamed(branchId: Uuid, fnName: String, limit: Int64): List<Trace> =
  wentThrough(fnName, hashNamed(branchId, fnName), limit)


/// The hash a person's name for a function resolves to here, or "" when the store has none.
let hashNamed(branchId: Uuid, fnName: String): String =
  LanguageTools.PackageManager.Function.find(
    branchId,
    LanguageTools.ProgramTypes.parsePackageLocation(fnName))
  |> Stdlib.Option.map(fun h ->
    match h with
    | Hash(v) -> v)
  |> Stdlib.Option.withDefault("")


/// What a function cost in one recorded run.
type TimeInFn =
  { traceId: String
    /// How many times the run called it.
    calls: Int64
    /// Wall clock inside it, in microseconds, counted from the outermost call only, so a
    /// recursive function is not counted once per level. 0 for a function answered without a
    /// frame of its own (a forwarder to a builtin).
    totalUs: Int64
    /// The longest of those outermost calls.
    slowestUs: Int64 }


/// What each of the runs `wentThroughNamed` finds spent in that function, in the same order.
let timeInNamed(branchId: Uuid, fnName: String, limit: Int64): List<TimeInFn> =
  (query(TraceQuery.TimeIn(fnName, hashNamed(branchId, fnName), limit))).totals
  |> Stdlib.List.map(fun row ->
    let (traceId, calls, totalUs, slowestUs) = row
    TimeInFn { traceId = traceId, calls = calls, totalUs = totalUs, slowestUs = slowestUs })


/// One frame the replay walked. `parent` is "" at the entry. A loop's passes are the frames
/// that share a parent and a `callSite`, numbered by `pass` in the order they ran.
type ViewFrame =
  { id: String
    parent: String
    /// The SITE: the thing a trace can enter more than once. A lambda's own expression id, or
    /// a hash of a function's name. Frames sharing one are the iterations of a loop, whether
    /// that loop is a `List.map` going round or a function calling itself.
    callSite: Int64
    /// "source" | "function" | "lambda"
    kind: String
    /// The callee's hash, for a `function` frame. "" otherwise.
    callee: String
    /// The order this frame was pushed, across the whole view. `pass` counts within one call
    /// site and cannot order frames at different sites; this can.
    ord: Int64
    /// What this entry was given, in order. Empty for a frame outside the window the view
    /// keeps, which is how the arguments cost what the values cost rather than more.
    args: List<LanguageTools.RuntimeTypes.Dval> }


/// The same replay, with the frame tree and the values keyed by (frame, expression).
///
/// That key is what tells pass 3 from pass 7: keyed by expression alone, a loop's two hundred
/// passes overwrite each other and only the last survives.
let viewTraceTree(
  /// The CLI passes the logged-in account. None keeps the caller's account.
  accountID: Option<Uuid>,
  branchId: Uuid,
  traceID: String,
  /// Extra iterations to keep, as (site, which one, counting from 0). A view holds the first
  /// and last few of each site; this is how one in between is reached, by running the view
  /// again and asking for it. `[]` for an ordinary view.
  focus: List<(Int64 * Int64)>)
  : (List<(Int64 * LanguageTools.RuntimeTypes.Dval)> *
     List<ViewFrame> *
     List<(String * Int64 * LanguageTools.RuntimeTypes.Dval)> *
     Option<ReplayStop>) =
  let (values, frames, frameValues, problem) =
    Builtin.cliViewTrace(accountID, branchId, traceID, focus)

  let frames =
    frames
    |> Stdlib.List.map(fun row ->
      let (id, parent, callSite, kind, callee, ord, args) = row
      ViewFrame
        { id = id
          parent = parent
          callSite = callSite
          kind = kind
          callee = callee
          ord = ord
          args = args })

  (values, frames, frameValues, problem)


/// Replay a recorded trace for VIEWING: every effectful call answered from that trace's log, none
/// performed, and every expression's value collected. Hands back the values, by source
/// expression id, and why it stopped early if it did. `ReplayStop.isDrift` is what tells a
/// genuine raise from the store having moved under the recording.
///
/// This is the FLAT view: one value per expression, the last one executed, which is what puts
/// `// = 140` beside a line. `viewTraceTree` is the same replay with the frames as well.
let viewTrace(
  accountID: Option<Uuid>,
  branchId: Uuid,
  traceID: String)
  : (List<(Int64 * LanguageTools.RuntimeTypes.Dval)> * Option<ReplayStop>) =
  // Through `viewTraceTree` rather than the builtin: one Dark wrapper per builtin is the
  // rule, and a second reference to `cliViewTrace` is what the builtin-access test catches.
  let (values, _frames, _frameValues, problem) = viewTraceTree(accountID, branchId, traceID, [])
  (values, problem)


/// Expand a trace-ID prefix to the full ID, or say why it can't be.
///
/// What was typed is matched as plain text, quotes and wildcards included. The store hands
/// back up to six ids, enough to tell "one more" from "several more"; the message shows five.
let resolveID(input: String): Result<String, String> =
  match (query(TraceQuery.IdsStartingWith(input))).ids with
  | [fullID] -> Result.Ok(fullID)
  | [] -> Result.Error($"no trace whose id starts with {input} -- `dark traces` lists them")
  | candidates ->
    // Six were asked for, so a sixth means "at least one more", not "one more".
    let shown = Stdlib.List.take(candidates, 5)
    let suffix = if Stdlib.List.length(candidates) > 5 then "\n  and more" else ""
    let body =
      shown
      |> Stdlib.List.map(fun id -> $"  {Stdlib.String.slice(id, 0, 12)}")
      |> Stdlib.String.join("\n")

    Result.Error($"more than one trace starts with {input}; give more of the id:\n{body}{suffix}")


/// Per-fn totals over the last <param traceLimit> traces:
/// (fnName, callCount, totalMs, maxMs), most total time first.
let hotspots(traceLimit: Int64): List<(String * Int64 * Int64 * Int64)> =
  (query(TraceQuery.Hotspots(traceLimit))).totals


/// Per-handler totals over the last <param traceLimit> traces:
/// (handler, traceCount, totalMs, maxMs).
let statsByHandler(traceLimit: Int64): List<(String * Int64 * Int64 * Int64)> =
  (query(TraceQuery.StatsByHandler(traceLimit))).totals


/// Delete the runs <param which> names, with their calls. Returns how many went. The four below
/// are the names callers use.
let deleteWhere(which: TraceSelection): Int64 =
  Builtin.tracesDelete(which)


/// Delete one trace by full ID. Returns the number of rows deleted.
let delete(traceID: String): Int64 =
  deleteWhere(TraceSelection.One(traceID))


/// Delete every trace. Returns the number deleted.
let clear(): Int64 =
  deleteWhere(TraceSelection.All)


/// Delete traces recorded before <param cutoff>. Returns the number deleted.
let clearBefore(cutoff: String): Int64 =
  deleteWhere(TraceSelection.Before(cutoff))


/// Keep the <param keepN> most recent traces, delete the rest. Returns the
/// number deleted.
let pruneKeep(keepN: Int64): Int64 =
  deleteWhere(TraceSelection.AllButNewest(keepN))
