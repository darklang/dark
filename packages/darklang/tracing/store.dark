/// Reads and maintenance over the recorded trace store.
///
/// These are thin wrappers over the `traces*` builtins, typed to the shapes
/// in `Darklang.Tracing`: the builtins return bare `List<'a>`, so without a
/// wrapper every caller re-states the type it expects. Consumers (the CLI
/// `traces` command, the workbench, dashboards) go through here.
module Darklang.Tracing.Store


/// Is trace recording on for this process? Worth asking before reporting an
/// empty result: with recording off, every query returns empty whatever ran.
let enabled () : Bool =
  Builtin.tracesEnabled ()


/// The most recent <param limit> traces, newest first.
let list (limit: Int) : List<Trace> =
  Builtin.tracesList limit


/// The most recent <param limit> traces that called <param fnName>.
let listByFn (fnName: String) (limit: Int) : List<Trace> =
  Builtin.tracesListByFn fnName limit


/// The most recent <param limit> traces whose inputs, args or results
/// contain <param pattern>.
let find (pattern: String) (limit: Int) : List<Trace> =
  Builtin.tracesFind pattern limit


/// Full payload for one run: its row, its inputs and its calls.
let view (traceID: String) : Stdlib.Option.Option<TraceData> =
  Builtin.tracesView traceID


/// The trace's input as source text, for replay. {{None}} when the trace
/// is missing or its input isn't a string (e.g. an HTTP Request record).
let getInput (traceID: String) : Stdlib.Option.Option<String> =
  Builtin.tracesGetInput traceID


/// One run by id, if it is still here.
let get (traceID: String) : Stdlib.Option.Option<Trace> =
  Builtin.tracesGet traceID


/// A new run branched from <param traceID>, keeping its log up to <param at> (a position from
/// `traces show`; the whole log when {{None}}), suspended, so `resume` takes it from there.
let fork (traceID: String) (at: Stdlib.Option.Option<Int64>) : Stdlib.Result.Result<String, String> =
  Builtin.tracesFork traceID at


/// Arm a resume of <param traceID>: the next `eval` or `run` this instance starts replays its
/// log instead of performing the effects, then goes live. `dark traces resume` arms and then
/// runs the run's own input; that is the whole of a resume.
let armResume (traceID: String) : Bool =
  Builtin.tracesArmResume traceID


/// Pin a run so retention never drops it, or unpin it. Returns whether a run had that id.
///
/// SQL here rather than in a builtin, the way the SCM silos own theirs: it is one UPDATE over a
/// table this module owns, and nothing about it needs the runtime.
let setPinned (traceID: String) (pinned: Bool) : Bool =
  let db = Stdlib.LocalStore.path ()
  let flag = if pinned then "1" else "0"
  let updated =
    Stdlib.Sqlite.mustExec
      db
      "UPDATE traces SET pinned = @p0, updated = strftime('%Y-%m-%dT%H:%M:%fZ','now')
       WHERE id = @p1"
      [ flag, traceID ]
  updated > 0


/// The runs that went through <param fnName>, newest first. Answers at the shipped recording
/// level: it reads the names-only index every recorded run writes, not the call rows.
let runsCalling (fnName: String) (limit: Int64) : List<Trace> =
  Builtin.tracesRunsCalling fnName limit


/// Replay a recorded run for VIEWING: every effectful call answered from that run's log, none
/// performed, and every expression's value collected. Hands back the values, by source
/// expression id, and why it stopped early if it did.
let previewRun
  (branchId: Uuid)
  (traceID: String)
  : (List<(Int64 * LanguageTools.RuntimeTypes.Dval)> * Stdlib.Option.Option<String>) =
  Builtin.cliPreviewRun branchId traceID


/// Expand a trace-ID prefix to the full ID, or say why it can't be.
///
/// `%` and `_` are escaped so a prefix someone typed matches those characters rather than
/// acting as wildcards. Six rows are enough to tell "one match" from "several" without reading
/// the table; the message shows five.
let resolveID (input: String) : Stdlib.Result.Result<String, String> =
  let escaped =
    input
    |> (fun s -> Stdlib.String.replaceAll s "\\" "\\\\")
    |> (fun s -> Stdlib.String.replaceAll s "%" "\\%")
    |> (fun s -> Stdlib.String.replaceAll s "_" "\\_")

  let matches =
    Stdlib.Sqlite.column
      (Stdlib.LocalStore.path ())
      $"SELECT id FROM traces WHERE id LIKE '{escaped}%' ESCAPE '\\'
        ORDER BY rowid DESC LIMIT 6"
      "id"

  match matches with
  | [] ->
    Stdlib.Result.Result.Error
      $"no run whose id starts with {input} -- `dark traces` lists them"
  | [ fullID ] -> Stdlib.Result.Result.Ok fullID
  | candidates ->
    // Six were asked for, so a sixth means "at least one more", not "one more".
    let shown = Stdlib.List.take candidates 5
    let suffix =
      if (Stdlib.List.length candidates) > 5 then "\n  and more" else ""
    let body =
      shown
      |> Stdlib.List.map (fun id -> $"  {Stdlib.String.slice id 0 12}")
      |> Stdlib.String.join "\n"
    Stdlib.Result.Result.Error
      $"more than one run starts with {input}; give more of the id:\n{body}{suffix}"


/// Per-fn totals over the last <param traceLimit> traces:
/// (fnName, totalMs, maxMs, callCount).
let hotspots (traceLimit: Int) : List<(String * Int * Int * Int)> =
  Builtin.tracesHotspots traceLimit


/// Per-handler totals over the last <param traceLimit> traces:
/// (handler, totalMs, maxMs, traceCount).
let statsByHandler (traceLimit: Int) : List<(String * Int * Int * Int)> =
  Builtin.tracesStatsByHandler traceLimit


/// Delete one trace by full ID. Returns the number of rows deleted.
let delete (traceID: String) : Int =
  Builtin.tracesDelete traceID


/// Delete every trace. Returns the number deleted.
let clear () : Int =
  Builtin.tracesClear ()


/// Delete traces recorded before <param cutoff>. Returns the number deleted.
let clearBefore (cutoff: String) : Int =
  Builtin.tracesClearBefore cutoff


/// Keep the <param keepN> most recent traces, delete the rest. Returns the
/// number deleted.
let pruneKeep (keepN: Int) : Int =
  Builtin.tracesPruneKeep keepN
