/// Generic formatting helpers used by the trace surface. None of these
/// are CLI-specific; they're string utilities that any trace consumer
/// (CLI, dashboard, third-party tool) will want.
module Darklang.Tracing.Format


/// Right-align a number in a field `width` columns wide by prepending spaces.
let padNum (n: Int) (width: Int) : String =
  Stdlib.String.padStartToWidth (Stdlib.Int.toString n) width


/// Escape a string for embedding in JSON. Handles backslash and double-
/// quote — the only characters that appear in trace handler/fn names
/// (URL paths, dotted package names, builtin identifiers).
let jsonEscape (s: String) : String =
  s
  |> Stdlib.String.replaceAll "\\" "\\\\"
  |> Stdlib.String.replaceAll "\"" "\\\""


/// Pretty-print a Dval as a single compact line (no indentation, no
/// embedded newlines). Used wherever we need a Dval inline — e.g. the
/// trace tree's `fn(args) → result` rows.
let compactDval (branchId: Uuid) (dv: LanguageTools.RuntimeTypes.Dval) : String =
  // Bounded, for the same reason the page's rendering is: formatting a 2000-element list in full
  // took 1.3 seconds to produce one field of a JSON document. The budget is far larger than the
  // sixty characters a line of the page gets, because an agent reading this has more use for the
  // value than someone skimming a column does. `...` means there was more.
  //
  // NOT through `dvalOneLine`, which caps depth at two as well. Doing that here would quietly
  // start eliding the inside of any nested value an agent reads, which is a different and worse
  // kind of loss than a long list being cut short. Full depth, as this has always had.
  let budget = 2000

  let text =
    PrettyPrinter.RuntimeTypes.dval
      branchId
      (PrettyPrinter.RuntimeTypes.capForDisplay budget dv)

  let oneLine =
    text
    |> Stdlib.String.split "\n"
    |> Stdlib.List.map (fun s -> Stdlib.String.trim s)
    |> Stdlib.String.join ""

  if (Stdlib.String.length oneLine) > budget then
    (Stdlib.String.slice oneLine 0 (budget - 3)) ++ "..."
  else
    oneLine


/// What to tell a person about a replay that stopped, as (what happened, what to do about it).
///
/// The second half is the point. "The view stopped here: <error>" told a reader nothing they
/// could act on, and worse, a drift error carries advice for a different command: a harmful
/// deprecation says "pass --allow-harmful to run/eval", which is not what the reader is doing.
///
/// What to DO about it is left to the caller, because the answer names a command and this module
/// is not CLI-specific.
let replayStop
  (branchId: Uuid)
  (stop: Darklang.Tracing.ReplayStop)
  : (String * Stdlib.Option.Option<String>) =
  match stop with
  | Unreplayable message -> (message, Stdlib.Option.Option.None)
  | Raised err ->
    let rendered = PrettyPrinter.RuntimeTypes.RuntimeError.toString branchId err

    if Darklang.Tracing.ReplayStop.isDrift stop then
      (rendered,
       Stdlib.Option.Option.Some
         "the store has changed since this ran, so the replay no longer resolves")
    else
      (rendered, Stdlib.Option.Option.None)
