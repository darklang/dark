module Darklang.LanguageTools.ProgramTypes


/// Used to name where type/function/etc lives, eg a User module, or a Package module.
type PackageLocation =
  { owner: String
    modules: List<String>
    name: String }


/// A successfully resolved name and (where applicable) the package
/// location that resolved it.
///
/// `location` is the matched fully-qualified location after `namesToTry`
/// expansion — `Some` for resolved package items, `None` for builtins
/// (and for resolved package items where no location was captured).
/// Carrying it alongside the resolved hash lets downstream consumers
/// skip a post-hoc lookup: dep-edge inserts, propagation rewrites,
/// SCC hash substitution, and deferred refresh after a package moves.
type ResolvedName<'a> =
  { name: 'a
    location: Stdlib.Option.Option<PackageLocation> }


module FQTypeName =
  type Package = Hash
  type FQTypeName = Package(Package)

/// A trait, by content hash. A trait is its own item kind (`Trait.Trait`).
module FQTraitName =
  type Package = Hash
  type FQTraitName = Package(Package)

module FQValueName =
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  type FQValueName =
    | Builtin(Builtin)
    | Package(Package)

module FQFnName =
  type Builtin = { name: String, version: Int32 }
  type Package = Hash

  /// How much of a trait call's implementation the save could say. Three states, not
  /// two: a call waiting for its caller's type argument is not the same as one
  /// nobody could work out, and an Option said both with the same value.
  type ImplChoice =
    /// The save picked it; stored code goes on running it
    | Chosen(ResolvedName<Package>)
    /// The self type is this type param of the item the call sits in, so the
    /// implementation is whatever the caller's type argument implies, and the
    /// caller records it.
    | FromTypeParam(String)
    /// Nothing to say. Only code parsed and run without being saved gets here.
    | Unknown

  /// What a CALL worked out for one of the callee's bounds: for the callee's type
  /// param `param` owing `trait_`, what this call's type argument implies.
  type BoundImpl =
    { param: String
      trait_: FQTraitName.Package
      /// One entry per method of the trait: the callee's body may call any of them
      method_: String
      choice: ImplChoice }

  /// A trait method call: the trait, the method name (`Display.display`), and how
  /// much the save could say about which implementation runs.
  type TraitMethod =
    { trait_: FQTraitName.Package
      method_: String
      implFn: ImplChoice }

  type FQFnName =
    | Builtin(Builtin)
    | Package(Package)
    | TraitMethod(TraitMethod)


type NameResolutionError =
  | NotFound
  | InvalidName

/// `originalName` is the user-typed name (a list of qualifiers).
/// `resolved` is the resolved name (or the resolution error). The Ok
/// payload bundles the resolved name with its package location so
/// "location without resolution" is unrepresentable.
type NameResolution<'a> =
  { originalName: List<String>
    resolved: Stdlib.Result.Result<ResolvedName<'a>, NameResolutionError> }


/// Darklang's available types (int, List<T>, user-defined types, etc.)
type TypeReference =
  // A named variable, eg `a` in `List<a>`, matches anything
  | TVariable(String)

  | TUnit
  | TBool
  | TInt8
  | TUInt8
  | TInt16
  | TUInt16
  | TInt32
  | TUInt32
  | TInt64
  | TUInt64
  | TInt128
  | TUInt128
  | TBigInt
  | TFloat
  | TFloat32
  | TDecimal
  | TChar
  | TString
  | TDateTime
  | TUuid
  | TBytes
  | TStream(TypeReference)

  | TList(TypeReference)
  | TTuple(TypeReference, TypeReference, List<TypeReference>)
  | TDict(key: TypeReference, value: TypeReference)

  | TCustomType(
    NameResolution<FQTypeName.FQTypeName>,
    typeArgs: List<TypeReference>)


  // TODO: this should be an NEList
  | TFn(List<TypeReference>, TypeReference)



type LetPattern =
  | LPUnit(ID)
  | LPVariable(ID, name: String)
  | LPWildcard(ID)
  | LPTuple(
    ID,
    first: LetPattern,
    second: LetPattern,
    theRest: List<LetPattern>)


/// Used for pattern matching in a match statement
type MatchPattern =
  | MPVariable(ID, String)

  | MPUnit(ID)
  | MPBool(ID, Bool)
  | MPInt8(ID, Int8)
  | MPUInt8(ID, UInt8)
  | MPInt16(ID, Int16)
  | MPUInt16(ID, UInt16)
  | MPInt32(ID, Int32)
  | MPUInt32(ID, UInt32)
  | MPInt64(ID, Int64)
  | MPUInt64(ID, UInt64)
  | MPInt128(ID, Int128)
  | MPUInt128(ID, UInt128)
  | MPBigInt(ID, BigInt)
  | MPFloat(ID, Sign, String, String)
  | MPFloat32(ID, Sign, String, String)
  | MPDecimal(ID, Decimal)
  | MPChar(ID, String)
  | MPString(ID, String)

  | MPList(ID, List<MatchPattern>)
  | MPListCons(ID, head: MatchPattern, tail: MatchPattern)

  | MPTuple(ID, MatchPattern, MatchPattern, List<MatchPattern>)

  | MPEnum(ID, caseName: String, fieldPats: List<MatchPattern>)

  | MPOr(ID, List<MatchPattern>)

  /// `pattern as name`: matches what `pattern` matches and binds the whole value
  | MPAs(ID, pattern: MatchPattern, name: String)

  /// `{ name = p, … }`: matches a record whose named fields match their patterns.
  /// Fields left out are ignored; `{ name }` arrives as `name = name`.
  | MPRecord(ID, fields: List<(String * MatchPattern)>)

type BinaryOperation =
  | BinOpAnd
  | BinOpOr


type InfixFnName =
  | ArithmeticPlus
  | ArithmeticMinus
  | ArithmeticMultiply
  | ArithmeticDivide
  | ArithmeticModulo
  | ArithmeticPower
  | BitwiseAnd
  | BitwiseOr
  | BitwiseXor
  | ShiftLeft
  | ShiftRight
  | ComparisonGreaterThan
  | ComparisonGreaterThanOrEqual
  | ComparisonLessThan
  | ComparisonLessThanOrEqual
  | ComparisonEquals
  | ComparisonNotEquals
  | StringConcat

type Infix =
  | InfixFnCall(InfixFnName)
  | BinOp(BinaryOperation)

/// An operator that can be a trait method: any infix one, unary minus, or `~`.
type Operator =
  | OpInfix(InfixFnName)
  | OpNegate
  | OpBitwiseNot


type StringSegment =
  | StringText(String)
  | StringInterpolation(Expr)


type PipeExpr =
  | EPipeVariable(ID, String, List<Expr>)

  | EPipeLambda(ID, List<LetPattern>, Expr)

  | EPipeInfix(ID, Infix, Expr, FQFnName.ImplChoice)

  | EPipeFnCall(
    ID,
    NameResolution<FQFnName.FQFnName>,
    typeArgs: List<TypeReference>,
    args: List<Expr>,
    /// As `EFnName`: what this call worked out for the callee's bounds.
    boundImpls: List<FQFnName.BoundImpl>)

  | EPipeEnum(
    ID,
    typeName: NameResolution<FQTypeName.FQTypeName>,
    caseName: String,
    fields: List<Expr>)


type MatchCase =
  { pat: MatchPattern
    whenCondition: Stdlib.Option.Option<Expr>
    rhs: Expr }



/// Expressions - the main part of the language.
type Expr =
  | EUnit(ID)

  // simple data

  | EBool(ID, Bool)

  | EInt8(ID, Int8)
  | EUInt8(ID, UInt8)
  | EInt16(ID, Int16)
  | EUInt16(ID, UInt16)
  | EInt32(ID, Int32)
  | EUInt32(ID, UInt32)
  | EInt64(ID, Int64)
  | EUInt64(ID, UInt64)
  | EInt128(ID, Int128)
  | EUInt128(ID, UInt128)
  | EBigInt(ID, BigInt)

  // Allow the user to have arbitrarily big numbers, even if they don't make sense as
  // floats. The float is split as we want to preserve what the user entered.
  // Strings are used as numbers lose the leading zeros (eg 7.00007)
  | EFloat(ID, Sign, String, String)
  /// A decimal literal, `19.99dec`; the value keeps its written scale
  | EDecimal(ID, Decimal)

  /// Single precision, written `1.5f32`. Same shape as `EFloat`.
  | EFloat32(ID, Sign, String, String)

  /// A character is an Extended Grapheme Cluster (hence why we use a String). This
  /// is equivalent to one screen-visible "character" in Unicode.
  | EChar(ID, String)

  | EString(ID, List<StringSegment>)


  // structures of data
  | EList(ID, List<Expr>)

  | EDict(ID, List<Expr * Expr>)

  | ETuple(ID, Expr, Expr, List<Expr>)

  | ERecord(
    ID,
    typeName: NameResolution<FQTypeName.FQTypeName>,
    typeArgs: List<TypeReference>,
    fields: List<String * Expr>)

  | EEnum(
    ID,
    typeName: NameResolution<FQTypeName.FQTypeName>,
    typeArgs : List<TypeReference>,
    caseName: String,
    fields: List<Expr>)

  // declaring and accessing variables
  | ELet(ID, LetPattern, Expr, Expr)
  | ERecordFieldAccess(ID, Expr, String)
  | EVariable(ID, String)
  | EArg(ID, Int64)
  | EValue(ID, NameResolution<FQValueName.FQValueName>)

  // control flow
  | EUnwrap(ID, Expr)
  | EIf(
    ID,
    cond: Expr,
    thenExpr: Expr,
    elseExpr: Stdlib.Option.Option<Expr>)

  | EMatch(ID, arg: Expr, cases: List<MatchCase>)

  | EPipe(ID, Expr, List<PipeExpr>)


  // function calls
  /// `a + b`. `implFn` is what a trait-method name carries: the fn the implementation chosen
  /// when this was SAVED names for the operator's method, so the operator goes on meaning what
  /// it meant. `Unknown` for the operators that are no trait method (`==`, `!=`, `&&`, `||`)
  /// and where the operand type is only known at run time.
  | EInfix(
    ID,
    Infix,
    Expr,
    Expr,
    implFn: FQFnName.ImplChoice)

  | ELambda(ID, List<LetPattern>, Expr)

  // TODO do typeArgs actually apply here?
  // they definitely don't _always_ make sense.
  | EApply(ID, Expr, typeArgs: List<TypeReference>, args: List<Expr>)

  /// A fn by name. `typeArgs` are for a reference that is not called:
  /// `let h = Stdlib.List.map<Int64, Int64>` is the fn as a value, specialised to them.
  /// A call keeps its type args on the `EApply`, so they are empty for every call.
  | EFnName(
    ID,
    NameResolution<FQFnName.FQFnName>,
    List<FQFnName.BoundImpl>,
    typeArgs: List<TypeReference>)

  | ERecordUpdate(ID, record: Expr, updates: List<String * Expr>)

  | EStatement(ID, first: Expr, next: Expr)

  | ESelf(ID)

module Expr =
  let toID(expr: Expr): ID =
    match expr with
    | EUnit(id)
    | EBool(id, _)
    | EInt8(id, _)
    | EUInt8(id, _)
    | EInt16(id, _)
    | EUInt16(id, _)
    | EInt32(id, _)
    | EUInt32(id, _)
    | EInt64(id, _)
    | EUInt64(id, _)
    | EInt128(id, _)
    | EUInt128(id, _)
    | EBigInt(id, _)
    | EFloat(id, _, _, _)
    | EFloat32(id, _, _, _)
    | EDecimal(id, _)
    | EChar(id, _)
    | EString(id, _)
    | ELet(id, _, _, _)
    | EIf(id, _, _, _)
    | EInfix(id, _, _, _, _)
    | ELambda(id, _, _)
    | ERecordFieldAccess(id, _, _)
    | EUnwrap(id, _)
    | EVariable(id, _)
    | EArg(id, _)
    | EValue(id, _)
    | EFnName(id, _, _, _)
    | EApply(id, _, _, _)
    | EList(id, _)
    | EDict(id, _)
    | ETuple(id, _, _, _)
    | EPipe(id, _, _)
    | ERecord(id, _, _, _)
    | EEnum(id, _, _, _, _)
    | EMatch(id, _, _)
    | ERecordUpdate(id, _, _)
    | EStatement(id, _, _)
    | ESelf(id) -> id


// Used to mark whether a function/type has been deprecated, and if so,
// details about possible replacements/alternatives, and reasoning
type Deprecation<'name> =
  | NotDeprecated

  /// The exact same thing is available under a new, preferred name
  | RenamedTo('name)

  /// This has been deprecated and has a replacement we can suggest
  | ReplacedBy('name)

  /// This has been deprecated and not replaced, provide a message for the user
  | DeprecatedBecause(String)


let parsePackageLocation(nameToParse: String): PackageLocation =
  let parts = Stdlib.String.split(nameToParse, ".")
  match parts with
  | [owner, ...rest] ->
    let rev = Stdlib.List.reverse(rest)
    match rev with
    | [name, ...rest] ->
      PackageLocation
        { owner = owner
          modules = Stdlib.List.reverse(rest)
          name = name }
    | [] ->
      // CLEANUP: This case should be handled better
      // Just an owner name with no module/entity name
      // Return a location pointing to the owner itself
      PackageLocation
        { owner = owner
          modules = []
          name = "" }
  | [] ->
    // Empty name (shouldn't happen, but handle it)
    PackageLocation { owner = "", modules = [], name = "" }

type BranchID = Uuid

/// Content-addressed hash for package items (hex-encoded SHA-256)
type Hash = | Hash(String)

let hashToString(hash: Hash): String =
  match hash with
  | Hash(h) -> h

/// First 8 hex chars, for human-readable display
let hashToShort(hash: Hash): String =
  let h = hashToString(hash)
  Stdlib.String.first(h, 8)

/// The hash of a piece of PROSE, which is not content and so is not hashed the way an item is.
///
/// `UpdateDoc.previous` names the text it replaces, and naming it needs a way to say WHICH text
/// without carrying it. Same construction as an item hash (SHA-256, lowercase hex) so the two are
/// indistinguishable in a column, and deliberately not the same function: an item hash is over a
/// canonical serialization and this is over the bytes of a string. Must agree with
/// `LibExecution.ProgramTypes.Hash.ofText`, which is what reads it back.
let hashOfText(text: String): Hash =
  (Stdlib.Base16.encode(Stdlib.Crypto.sha256(Stdlib.Utf8.encode(text))))
  |> Stdlib.String.toLowercase
  |> Hash.Hash

/// A package entity paired with its location
type LocatedItem<'entity> =
  { entity: 'entity
    location: PackageLocation }


/// A trait named from a bound or an impl, plus type args for any non-self params.
type TraitRef =
  { trait_: NameResolution<FQTraitName.FQTraitName>
    typeArgs: List<TypeReference> }

/// `'a: Show` on a fn or type declaration
type Bound =
  { param: String
    trait_: TraitRef }


/// A stdlib-, user-, or package- defined type (an alias, record, or enum)
module TypeDeclaration =
  type RecordField =
    { name: String
      typ: TypeReference
      description: String }

  type EnumField =
    { typ: TypeReference
      label: Stdlib.Option.Option<String>
      description: String }

  type EnumCase =
    { name: String
      fields: List<EnumField>
      description: String }

  type Definition =
    | Alias(TypeReference)
    | Record(List<RecordField>)
    | Enum(List<EnumCase>)

  type TypeDeclaration =
    { typeParams: List<String>
      /// `type Set<'a: Compare> = ...`
      bounds: List<Bound>
      definition: Definition }




// Package space
module PackageType =
  type PackageType =
    { hash: FQTypeName.Package
      declaration: TypeDeclaration.TypeDeclaration
      description: String }

module PackageValue =
  type PackageValue =
    { hash: FQValueName.Package
      body: Expr
      description: String }

module PackageFn =
  type Parameter =
    { name: String
      typ: TypeReference
      description: String }

  type PackageFn =
    { hash: FQFnName.Package
      body: Expr
      typeParams: List<String>
      parameters: List<Parameter>
      returnType: TypeReference
      description: String
      /// The author's ceiling on what this function and everything it calls
      /// may do at runtime, from the `:{…}` row on the declaration. It only
      /// restricts; granting stays with the instance, run and package layers.
      ///
      ///   None          no row was written: no function layer is added
      ///   Some []       `:{}`: effect-free, every host effect inside is denied
      ///   Some [Http, …] `:{Http, …}`: only these; anything else inside is denied
      ///
      /// Part of the content hash and of the upgrade contract, so changing the
      /// row is a new version that `permissions update` asks about.
      permissionCeiling: Option<List<LanguageTools.Permissions.Effect>>
      /// `'a: Show + Compare` on the type params; part of the content hash. Checked
      /// at fn entry by the interpreter and statically by the at-rest checker.
      bounds: List<Bound> }


/// A trait: a set of fn signatures over one open type. Its own item kind.
module Trait =
  /// One method's signature; no body (the impls have those).
  ///
  /// The ceiling binds every call through the method, whichever impl runs, and is enforced
  /// when it runs. See the F# mirror for the detail.
  type Method =
    { name: String
      typeParams: List<String>
      /// `let convert<'b: Compare> (v: 'a) : 'b`: what the method's own type params owe, on
      /// top of the trait's bound on the self type
      bounds: List<Bound>
      parameters: List<PackageFn.Parameter>
      returnType: TypeReference
      permissionCeiling: Option<List<LanguageTools.Permissions.Effect>>
      description: String }

  type Trait =
    { hash: FQTraitName.Package
      /// The first is the self type
      typeParams: List<String>
      /// Supertraits, as bounds on the params
      bounds: List<Bound>
      methods: List<Method>
      description: String }


/// An impl: how one type does a trait. Its own item kind, named at
/// `<module>[.<Type>].<Trait>`, with its method fns as ordinary fns beneath it.
module TraitImpl =
  type TraitImpl =
    { hash: Hash
      trait_: NameResolution<FQTraitName.FQTraitName>
      /// The trait's non-self type args
      traitTypeArgs: List<TypeReference>
      /// What the impl is for: `Point`, `Int64`, `List<'a>`
      self: TypeReference
      /// `impl<'a: Show> Show for List<'a>`: the impl's own params and bounds
      typeParams: List<String>
      bounds: List<Bound>
      /// method name and the fn that implements it, in the trait's order
      methods: List<String * NameResolution<FQFnName.FQFnName>>
      description: String }

module PackageTest =
  type ExpectedError =
    | RuntimeError(String)

  /// Named executable package content. It is deliberately not callable from
  /// production expressions; the test runner evaluates its body directly.
  type PackageTest =
    { hash: Hash
      body: Expr
      description: String
      expectedError: Option<ExpectedError> }


/// The kind of package item (function, type, value, trait, impl, or test)
type ItemKind =
  | Fn
  | Type
  | Value
  | Trait
  | TraitImpl
  | Test

module ItemKind =
  /// The spelling that goes in a database column, a URL and an op bundle. The one place it is
  /// written on this side, because it is a round trip: a second copy that disagreed about `impl`
  /// versus `traitImpl` would read back someone else's rows as the wrong kind. It has to agree
  /// with `PT.ItemKind.toString` in F#, which writes the same column from the fold.
  let toString(k: ItemKind): String =
    match k with
    | Fn -> "fn"
    | Type -> "type"
    | Value -> "value"
    | Trait -> "trait"
    | TraitImpl -> "impl"
    | Test -> "test"

  /// `None` for anything `toString` would not have written. A blanket arm here is how a kind
  /// nobody anticipated becomes a function: the copy in `SCM.Deps` fell through to `Fn`.
  let fromString(s: String): Stdlib.Option.Option<ItemKind> =
    match s with
    | "fn" -> Stdlib.Option.Option.Some(ItemKind.Fn)
    | "type" -> Stdlib.Option.Option.Some(ItemKind.Type)
    | "value" -> Stdlib.Option.Option.Some(ItemKind.Value)
    | "trait" -> Stdlib.Option.Option.Some(ItemKind.Trait)
    | "impl" -> Stdlib.Option.Option.Some(ItemKind.TraitImpl)
    | "test" -> Stdlib.Option.Option.Some(ItemKind.Test)
    | _ -> Stdlib.Option.Option.None

/// A reference to a specific package item by content hash.
/// Collapses (Hash * ItemKind) pairs into one shape; leaves room for future
/// growth (RefBuiltin, RefExternal, ...).
type Reference =
  | PackageType(Hash)
  | PackageValue(Hash)
  | PackageFn(Hash)
  | PackageTrait(Hash)
  | PackageTraitImpl(Hash)
  | PackageTest(Hash)

module Reference =
  let hash(r: Reference): Hash =
    match r with
    | PackageType(h) -> h
    | PackageValue(h) -> h
    | PackageFn(h) -> h
    | PackageTrait(h) -> h
    | PackageTraitImpl(h) -> h
    | PackageTest(h) -> h

  let kind(r: Reference): ItemKind =
    match r with
    | PackageType(_) -> ItemKind.Type
    | PackageValue(_) -> ItemKind.Value
    | PackageFn(_) -> ItemKind.Fn
    | PackageTrait(_) -> ItemKind.Trait
    | PackageTraitImpl(_) -> ItemKind.TraitImpl
    | PackageTest(_) -> ItemKind.Test

  let fromHashAndKind(h: Hash, k: ItemKind): Reference =
    match k with
    | Type -> Reference.PackageType(h)
    | Value -> Reference.PackageValue(h)
    | Fn -> Reference.PackageFn(h)
    | Trait -> Reference.PackageTrait(h)
    | TraitImpl -> Reference.PackageTraitImpl(h)
    | Test -> Reference.PackageTest(h)

/// Why a package item has been deprecated. Author-supplied metadata on the
/// Deprecate op; consumers decide how loud to be.
type DeprecationKind =
  /// A different item (different hash) should be used instead.
  | SupersededBy(replacement: Reference)
  /// Actively dangerous — runtime halts on invocation by default.
  | Harmful
  /// Don't use this anymore (catch-all).
  | Obsolete

/// A single repoint: what propagation moved. Reported back to the caller; NOT an op.
type PropagateRepoint =
  { location: PackageLocation
    fromRef: Reference
    toRef: Reference }


/// What a `Decision` DID. The shared part of a decision (who, where, why) lives on the op; this is the
/// part that varies, so a decision that binds a name and one that only closes a finding can't be
/// confused for each other.
type DecisionKind =
  /// Bind this name to THIS version, the one the fold didn't pick. Its own case rather than another
  /// SetName because ops are content-addressed: re-authoring the losing SetName produces the op that
  /// already exists and folds nothing. Binds with source='resolution' and closes the conflict as
  /// `overridden`.
  | Override(target: Reference)
  /// Used by `dark undo` to bring back an earlier edit.
  /// Restore both the declaration's content and the names its references used.
  /// `revision` records which edit we returned to, so the next undo can go further back.
  | Restore(revision: Uuid, target: Reference, names: List<(Reference * Stdlib.Option.Option<PackageLocation>)>)
  /// A standing finding has been seen and accepted. Closes it as `acked`, and binds nothing.
  | Ack(findingId: String)
/// WHICH piece of prose an `UpdateDoc` sets: the declaration's own, or one named part of it.
///
/// The nested parts are the point. A doc on a field, a case or a parameter is outside the identity
/// hash too, so before these there was no op that could carry an edit to one.
type DocPart =
  | WholeItem
  | RecordField(fieldName: String)
  | EnumCase(caseName: String)
  /// By POSITION, not name: a parameter's name is not in the identity hash, so a name would not
  /// survive the version it was written against. Field and case names ARE hashed.
  | Parameter(parameterIndex: Int64)

module DocPart =
  /// The part a stored key names ("item", "record-field:x", "parameter:0"), or None for one this
  /// build cannot read. Must agree with `LibDB.Docs.partKey`, which writes them.
  let fromKey(key: String): Stdlib.Option.Option<DocPart> =
    match Stdlib.String.split(key, ":") with
    | [ "item" ] -> Stdlib.Option.Option.Some(DocPart.WholeItem)
    | [ "record-field", name ] -> Stdlib.Option.Option.Some(DocPart.RecordField(name))
    | [ "enum-case", name ] -> Stdlib.Option.Option.Some(DocPart.EnumCase(name))
    | [ "parameter", index ] ->
      Stdlib.Int64.parse(index)
      |> Stdlib.Result.toOption
      |> Stdlib.Option.map(fun i -> DocPart.Parameter(i))
    | _ -> Stdlib.Option.Option.None

  /// How it reads in a listing: which part of the declaration is being described.
  let describe(p: DocPart): String =
    match p with
    | WholeItem -> "the item"
    | RecordField(name) -> $"field {name}"
    | EnumCase(name) -> $"case {name}"
    | Parameter(index) -> $"parameter {Stdlib.display(index + 1)}"


/// Keep the reference names for one declaration at a particular package location.
/// `target` says which content hash these names belong to.
/// Keep one entry per package reference, in AST traversal order, so we can match
/// each saved name back to its reference.
type ReferenceNamesSnapshot =
  { location: PackageLocation
    target: Reference
    names: List<(Reference * Stdlib.Option.Option<PackageLocation>)>
    restating: Stdlib.Option.Option<String> }

type PackageOp =
  | AddType(PackageType.PackageType)
  | AddValue(PackageValue.PackageValue)
  | AddFn(PackageFn.PackageFn)
  | AddTrait(Trait.Trait)
  | AddTraitImpl(TraitImpl.TraitImpl)
  | AddTest(PackageTest.PackageTest)
  /// Bind a name (location) to a piece of content (target).
  ///
  /// `previous` is the hash this binding REPLACED, or None when the location was empty (or when whoever
  /// authored it had no store to ask, which is true of the parsers). Two SetNames for one location that
  /// BOTH name no predecessor are two independent creations, which is a conflict; one that names the
  /// other's hash is an ordinary edit, which is not.
  | SetName(
      location: PackageLocation,
      target: Reference,
      previous: Stdlib.Option.Option<Hash>)
  /// A name stops existing. Unlists whatever is live at the location and nothing else: the content stays
  /// reachable by hash. `previous` is the hash it unbound. Not a Deprecate, which is about content and would
  /// mark every other name on the same body; a deprecated name still resolves, an unbound one does not.
  | Unbind(location: PackageLocation, previous: Stdlib.Option.Option<Hash>)
  /// Author-initiated deprecation annotation on a specific hash.
  ///
  /// `restating` is empty except on the restatement path, same hole as `UpdateDoc`'s one axis over:
  /// `Deprecate` and `Undeprecate` are each other's inverse, so saying one again after the other
  /// produces the op that said it the first time. It matters more on `Undeprecate`, which carries
  /// nothing else, so without it there is exactly one possible undeprecate per item for all time.
  | Deprecate(
      target: Reference,
      kind: DeprecationKind,
      message: String,
      restating: Stdlib.Option.Option<String>)
  /// Clear any prior deprecation on a target.
  | Undeprecate(target: Reference, restating: Stdlib.Option.Option<String>)
  /// What the thing at a NAME says about itself, or one named part of it.
  ///
  /// Scoped to a location, not to content, and that is the point: content is shared. Ten names hold
  /// `type ParseError = | BadFormat | OutOfRange`, and what `Int64.ParseError` means is not what
  /// `UInt64.ParseError` means. The declaration's own `///` still travels in the item and is the
  /// fallback; this is how one name says something else.
  ///
  /// `previous` is the hash of the text being replaced, None when there was nothing there. It is
  /// what lets two people editing one doc comment produce a recorded conflict rather than one of
  /// them losing their words silently. `restating` is empty except on the restatement path.
  | UpdateDoc(
      location: PackageLocation,
      part: DocPart,
      text: String,
      previous: Stdlib.Option.Option<Hash>,
      restating: Stdlib.Option.Option<String>)
  /// Save which name each package reference uses in this declaration.
  /// For example, `double` and `twice` can point to the same function hash.
  /// Renaming `double` should update calls to `double`, leaving calls to `twice` alone.
  /// The hash cannot tell those names apart, so we save the names here.
  /// We collect references as we walk the declaration's AST and read this list
  /// back in the same order. `double() + double()` needs two entries, one per call.
  | SetReferenceNames(
      location: PackageLocation,
      target: Reference,
      names: List<(Reference * Stdlib.Option.Option<PackageLocation>)>,
      restating: Stdlib.Option.Option<String>)
  /// Rename an item and update the names its callers use, all in one operation.
  /// `references` includes saved names for the callers and the item being moved.
  | Rename(
      oldLocation: PackageLocation,
      newLocation: PackageLocation,
      target: Reference,
      references: List<ReferenceNamesSnapshot>,
      stamp: String)
  /// A human's judgment about a NAME, recorded so that it travels. Overriding a binding and acking a
  /// finding are one class of act -- someone decided something about a location, and it has to hold on
  /// every machine -- so they are one op differing by `kind`. `id` is what makes each decision distinct,
  /// and idempotence is the caller's choice of what to put in it. `reason` is carried, never interpreted.
  | Decision(
      id: String,
      location: PackageLocation,
      reason: String,
      kind: DecisionKind)


module PackageOp =
  /// A `Rename` removes the old name with `Unbind` and adds the new name with `SetName`.
  /// A `Restore` uses `SetName` to put the earlier version back at its name.
  /// Other operations stay as they are.
  /// LibDB.ReferenceNames reads the original operation to update reference names.
  /// If two renames change different calls in the same declaration, it keeps both changes.
  let bindingOps(op: PackageOp): List<PackageOp> =
    match op with
    | Rename(oldLocation, newLocation, target, _, _) ->
      [ PackageOp.Unbind(oldLocation, Stdlib.Option.Option.Some(Reference.hash(target)))
        PackageOp.SetName(newLocation, target, Stdlib.Option.Option.None) ]
    | Decision(_, location, _, Restore(_, target, _)) ->
      [ PackageOp.SetName(location, target, Stdlib.Option.Option.None) ]
    | _ -> [ op ]

  /// A caller can switch from `double` to `twice` without changing its content hash.
  /// Return a `SetName` so draft listings and partial commits can see that edit.
  /// The stored operation stays `SetReferenceNames`.
  let draftOps(op: PackageOp): List<PackageOp> =
    match op with
    | SetReferenceNames(location, target, _, _) ->
      [ PackageOp.SetName(location, target, Stdlib.Option.Option.None) ]
    | _ -> bindingOps(op)


module Search =
  /// The type of entity to search for
  type EntityType =
    | Type
    | Module
    | Fn
    | Value
    | Trait
    | TraitImpl
    | Test

  /// How deep to search in the module hierarchy
  type SearchDepth =
    | OnlyDirectDescendants
    | AllDescendants

  /// Query parameters for searching packages
  type SearchQuery =
    {
      /// i.e. "Darklang.Stdlib"
      currentModule: List<String>

      /// i.e. "List" or "map"
      text: String

      searchDepth: SearchDepth

      /// empty list implies 'any'
      entityTypes: List<EntityType>

      /// if true, require exact matches for names and modules instead of fuzzy matching
      exactMatch: Bool
    }

  /// Results from a package search
  type SearchResults =
    { submodules: List<List<String>> // [ [ "List"], ["String", "List"] ]
      types : List<LocatedItem<ProgramTypes.PackageType.PackageType>>
      values : List<LocatedItem<ProgramTypes.PackageValue.PackageValue>>
      fns : List<LocatedItem<ProgramTypes.PackageFn.PackageFn>>
      traits : List<LocatedItem<ProgramTypes.Trait.Trait>>
      impls : List<LocatedItem<ProgramTypes.TraitImpl.TraitImpl>>
      tests : List<LocatedItem<ProgramTypes.PackageTest.PackageTest>> }




/// Functionality written in Dark stored and managed outside of user space
///
/// Note: It may be tempting to think the `getX` fns shouldn't return Options,
/// but there's a chance of Local <-> Cloud not being fully in sync,
/// for whatever reasons.
///
/// Visibility rules:
/// - Approved items are visible to everyone
module PackageManager =
  type PackageManager =
    { findType: (BranchID * PackageLocation) -> Stdlib.Option.Option<FQTypeName.Package>
      findValue: (BranchID * PackageLocation) -> Stdlib.Option.Option<FQValueName.Package>
      findFn: (BranchID * PackageLocation) -> Stdlib.Option.Option<FQFnName.Package>
      findTrait: (BranchID * PackageLocation) -> Stdlib.Option.Option<FQTraitName.Package>

      getType:
        FQTypeName.Package -> Stdlib.Option.Option<PackageType.PackageType>
      getValue:
        FQValueName.Package
          -> Stdlib.Option.Option<PackageValue.PackageValue>
      getFn: FQFnName.Package -> Stdlib.Option.Option<PackageFn.PackageFn>
      getTrait: FQTraitName.Package -> Stdlib.Option.Option<Trait.Trait>

      search: (BranchID * Search.SearchQuery) -> Search.SearchResults }


  /// Allows you to side-load a few 'extras' in-memory, along
  /// the normal fetching functionality. (Mostly helpful for tests)
  let withExtras(
    pm: PackageManager.PackageManager,
    types: List<LocatedItem<PackageType.PackageType>>,
    values: List<LocatedItem<PackageValue.PackageValue>>,
    fns: List<LocatedItem<PackageFn.PackageFn>>)
    : PackageManager.PackageManager =
    PackageManager.PackageManager
      { findType =
          fun((branchId, location)) ->
            match types |> Stdlib.List.findFirst(fun t -> t.location == location) with
            | Some(t) -> Stdlib.Option.Option.Some(t.entity.hash)
            | None -> pm.findType((branchId, location))
        findValue =
          fun((branchId, location)) ->
            match values |> Stdlib.List.findFirst(fun v -> v.location == location) with
            | Some(v) -> Stdlib.Option.Option.Some(v.entity.hash)
            | None -> pm.findValue((branchId, location))
        findFn =
          fun((branchId, location)) ->
            match fns |> Stdlib.List.findFirst(fun f -> f.location == location) with
            | Some(f) -> Stdlib.Option.Option.Some(f.entity.hash)
            | None -> pm.findFn((branchId, location))

        getType =
          fun id ->
            match types |> Stdlib.List.findFirst(fun t -> t.entity.hash == id) with
            | Some(t) -> Stdlib.Option.Option.Some(t.entity)
            | None -> pm.getType(id)
        getValue =
          fun id ->
            match values |> Stdlib.List.findFirst(fun v -> v.entity.hash == id) with
            | Some(v) -> Stdlib.Option.Option.Some(v.entity)
            | None -> pm.getValue(id)
        getFn =
          fun id ->
            match fns |> Stdlib.List.findFirst(fun f -> f.entity.hash == id) with
            | Some(f) -> Stdlib.Option.Option.Some(f.entity)
            | None -> pm.getFn(id)

        findTrait = pm.findTrait
        getTrait = pm.getTrait

        search = pm.search }


  /// Create a PackageManager from PackageOps, combining with an existing PM
  let withExtraOps(
    basePM: PackageManager.PackageManager,
    ops: List<PackageOp>)
    : PackageManager.PackageManager =
    let typesByID =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | AddType(t) -> Stdlib.Option.Option.Some((t.hash, t))
        | _ -> Stdlib.Option.Option.None)

    let valuesByID =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | AddValue(v) -> Stdlib.Option.Option.Some((v.hash, v))
        | _ -> Stdlib.Option.Option.None)

    let fnsByID =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | AddFn(f) -> Stdlib.Option.Option.Some((f.hash, f))
        | _ -> Stdlib.Option.Option.None)

    let traitsByID =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | AddTrait(t) -> Stdlib.Option.Option.Some((t.hash, t))
        | _ -> Stdlib.Option.Option.None)

    let traitLocationMap =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | SetName(loc, PackageTrait(hash), _) -> Stdlib.Option.Option.Some((loc, hash))
        | _ -> Stdlib.Option.Option.None)

    let typeLocationMap =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | SetName(loc, PackageType(hash), _) -> Stdlib.Option.Option.Some((loc, hash))
        | _ -> Stdlib.Option.Option.None)

    let valueLocationMap =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | SetName(loc, PackageValue(hash), _) -> Stdlib.Option.Option.Some((loc, hash))
        | _ -> Stdlib.Option.Option.None)

    let fnLocationMap =
      ops
      |> Stdlib.List.filterMap(fun op ->
        match op with
        | SetName(loc, PackageFn(hash), _) -> Stdlib.Option.Option.Some((loc, hash))
        | _ -> Stdlib.Option.Option.None)

    // Create PackageManager that looks up in ops first, then falls back to basePM
    PackageManager.PackageManager
      { findType =
          fun((branchId, location)) ->
            match typeLocationMap
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (loc, _) = tuple
                    loc == location) with
            | Some(tuple) ->
              let (_, id) = tuple
              Stdlib.Option.Option.Some(id)
            | None -> basePM.findType((branchId, location))

        findValue =
          fun((branchId, location)) ->
            match valueLocationMap
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (loc, _) = tuple
                    loc == location) with
            | Some(tuple) ->
              let (_, id) = tuple
              Stdlib.Option.Option.Some(id)
            | None -> basePM.findValue((branchId, location))

        findFn =
          fun((branchId, location)) ->
            match fnLocationMap
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (loc, _) = tuple
                    loc == location) with
            | Some(tuple) ->
              let (_, id) = tuple
              Stdlib.Option.Option.Some(id)
            | None -> basePM.findFn((branchId, location))

        getType =
          fun id ->
            match typesByID
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (tid, _) = tuple
                    tid == id) with
            | Some(tuple) ->
              let (_, t) = tuple
              Stdlib.Option.Option.Some(t)
            | None -> basePM.getType(id)

        getValue =
          fun id ->
            match valuesByID
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (vid, _) = tuple
                    vid == id) with
            | Some(tuple) ->
              let (_, v) = tuple
              Stdlib.Option.Option.Some(v)
            | None -> basePM.getValue(id)

        getFn =
          fun id ->
            match fnsByID
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (fid, _) = tuple
                    fid == id) with
            | Some(tuple) ->
              let (_, f) = tuple
              Stdlib.Option.Option.Some(f)
            | None -> basePM.getFn(id)

        findTrait =
          fun((branchId, location)) ->
            match traitLocationMap
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (loc, _) = tuple
                    loc == location) with
            | Some(tuple) ->
              let (_, id) = tuple
              Stdlib.Option.Option.Some(id)
            | None -> basePM.findTrait((branchId, location))

        getTrait =
          fun id ->
            match traitsByID
                  |> Stdlib.List.findFirst(fun tuple ->
                    let (tid, _) = tuple
                    tid == id) with
            | Some(tuple) ->
              let (_, t) = tuple
              Stdlib.Option.Option.Some(t)
            | None -> basePM.getTrait(id)

        search = basePM.search }


type Definitions =
  { types: List<PackageType.PackageType>
    values: List<PackageValue.PackageValue>
    fns: List<PackageFn.PackageFn>
    traits: List<Trait.Trait>
    impls: List<TraitImpl.TraitImpl>
    // TODO db and handlers
    exprs: List<Expr * List<String>> }

module SourceFile =
  type Declaration =
    | Type(PackageType.PackageType)
    | Value(PackageValue.PackageValue)
    | Function(PackageFn.PackageFn)
    | Trait(Trait.Trait)
    /// The impl item; its method fns are separate `Function` declarations
    | Impl(TraitImpl.TraitImpl)
    | Test(PackageTest.PackageTest)
    // db and handlers
    | Module(Definitions) // re-evaluate if this makes sense to be here

  type SourceFile =
    { declarations: List<Declaration>
      exprsToEval: List<Expr> }
