/// The Dark representation of the runtime permission policy. This is a typed
/// host boundary, not a second authorization model.
module Darklang.LanguageTools.Permissions

type Scope<'a> =
  | All
  | Only('a)


type HostRule =
  | Any
  | Exact(String)
  | SubdomainsOf(String)


type HttpPath =
  | All
  | Exact(String)
  | Subtree(String)


type HttpRule =
  { method: Scope<String>
    scheme: Scope<String>
    host: HostRule
    port: Scope<Int64>
    path: HttpPath
    /// The query string is part of the request, so `/x?id=public` and
    /// `/x?id=secret` are different requests. A rule written with a query
    /// covers only that exact one (`Only "?id=public"`, leading `?` kept, as
    /// the runtime derives it); a rule written without one covers any query
    /// on the path (`All`).
    query: Scope<String> }


type ProcessRule =
  { executable: Scope<String>
    /// The exact argument list, in order, or any.
    args: Scope<List<String>> }


/// One statically visible kind of host behaviour, mirroring the runtime's
/// `Effects.Effect`. Requirements analysis reports these; a policy
/// rule names one whole (`allow clock`). `effectCases` gives each its source
/// case name and its rule name.
type Effect =
  | Http
  | HttpServer
  | FileRead
  | FileWrite
  | EnvRead
  | EnvWrite
  | Stdin
  | Stdout
  | Clock
  | Random
  | Process
  | PackageRead
  | PackageWrite
  | TraceRead
  | TraceWrite
  /// Starting a process beside this one (`Exec.spawn`); it runs under the spawner's access.
  | Concurrency
  /// This process's own in-memory state: its package caches and store watch.
  | Runtime
  | Native
  /// A call can stop with a runtime error. Not a permission: no rule grants or denies it.
  | Raise


type Rule =
  | All
  | Effect(Effect)
  | Http(HttpRule)
  | HttpServer(address: Scope<String>, port: Scope<Int64>)
  | FileRead(Scope<String>)
  | FileWrite(Scope<String>)
  | EnvRead(Scope<String>)
  | EnvWrite(Scope<String>)
  | Process(ProcessRule)


type Policy =
  { allow: List<Rule>
    deny: List<Rule> }


/// Why approving a version for a name did not happen. An approval outcome rather than a policy
/// type; it lives here because the host builtin that returns it addresses Dark types through the
/// `LanguageTools.Permissions` package ref.
type ApprovalFailure =
  /// The permission contract differs from the currently approved version's: the human-readable
  /// differences, for a second explicit review.
  | ContractChanged(List<String>)
  /// The version cannot be approved as asked: an unknown hash, an
  /// unacknowledged incomplete analysis, rules that never allow an effect it
  /// requires, or a storage failure. The message is complete.
  | Refused(String)


/// A change to the instance policy. Like `ApprovalFailure`, it lives here because the host
/// builtin that takes it addresses Dark types through the `LanguageTools.Permissions` package ref.
type PolicyEdit =
  /// Replace the whole policy.
  | Replace(Policy)
  /// Add allow and deny rules and remove rules from both lists. Removals apply first.
  | Change(allow: List<Rule>, deny: List<Rule>, remove: List<Rule>)


/// Which approval to take back. The two are separate records on purpose.
type ApprovalTarget =
  /// The version approved for a logical function name; the hash's approval stays.
  | Name(String)
  /// The approval of one immutable version, with the dependencies no other approved root needs.
  | Hash(String)


/// One approval as an account sees it. A hash approved under several names appears once per name.
type Approval =
  { hash: String
    /// A logical name whose approved version is this hash; None when no name points at it.
    name: Option<String>
    /// The consumer policy stored for this hash, when it is approved.
    policy: Option<Policy>
    /// The rules written when approving this hash as a root; None for a derived approval.
    explicitRules: Option<Policy> }


type TokenMode =
  | Bare
  | SingleQuoted
  | DoubleQuoted
  | EscapedBare
  | EscapedDouble


/// Every effect with its source case name and its rule name, in the F#
/// `Effects.all` order. The rule name is what `permissions allow` and
/// denial messages use.
/// An F# test asserts this table agrees with `Effects.all`.
val effectCases =
  [ (Effect.Http, "Http", "http")
    (Effect.HttpServer, "HttpServer", "http-server")
    (Effect.FileRead, "FileRead", "file-read")
    (Effect.FileWrite, "FileWrite", "file-write")
    (Effect.EnvRead, "EnvRead", "env-read")
    (Effect.EnvWrite, "EnvWrite", "env-write")
    (Effect.Stdin, "Stdin", "stdin")
    (Effect.Stdout, "Stdout", "stdout")
    (Effect.Clock, "Clock", "clock")
    (Effect.Random, "Random", "random")
    (Effect.Process, "Process", "process")
    (Effect.PackageRead, "PackageRead", "package-read")
    (Effect.PackageWrite, "PackageWrite", "package-write")
    (Effect.TraceRead, "TraceRead", "trace-read")
    (Effect.TraceWrite, "TraceWrite", "trace-write")
    (Effect.Concurrency, "Concurrency", "concurrency")
    (Effect.Runtime, "Runtime", "runtime")
    (Effect.Native, "Native", "native")
    (Effect.Raise, "Raise", "raise") ]


/// The `effectCases` row an effect is in. Every effect has one, so the
/// fallback is unreachable; it keeps the lookups total without an Option.
let effectRow(effect: Effect): (Effect * String * String) =
  effectCases
  |> Stdlib.List.findFirst(fun((e, _case, _name)) -> e == effect)
  |> Stdlib.Option.withDefault((effect, "Unknown", "unknown"))


/// The rule name of an effect: `FileRead` -> `"file-read"`.
let effectName(effect: Effect): String =
  let (_e, _case, name) = effectRow(effect)
  name


/// The source case name of an effect: `FileRead` -> `"FileRead"`.
let effectCaseName(effect: Effect): String =
  let (_e, case, _name) = effectRow(effect)
  case


/// `"file-read"` -> `FileRead`; None for an unknown rule name.
let effectOfName(name: String): Option<Effect> =
  effectCases
  |> Stdlib.List.findFirst(fun((_e, _case, n)) -> n == name)
  |> Stdlib.Option.map(fun((e, _case, _name)) -> e)


/// `"FileRead"` -> `FileRead`; None for an unknown case name.
let effectOfCase(case: String): Option<Effect> =
  effectCases
  |> Stdlib.List.findFirst(fun((_e, c, _name)) -> c == case)
  |> Stdlib.Option.map(fun((e, _case, _name)) -> e)


let empty(): Policy =
  Policy { allow = [], deny = [] }


/// A POSIX absolute path or a Windows drive/UNC path.
let isAbsolutePath(path: String): Bool =
  Stdlib.String.startsWith(path, "/")
  || Stdlib.String.startsWith(path, "\\\\")
  || Stdlib.String.length(path) >= 3 && Stdlib.String.slice(path, 1, 3) == ":\\"


let scope(value: String): Scope<String> =
  if value == "*" then Scope.All else Scope.Only(value)


/// A port for `http-server`: `*` or 0-65535. Anything else is None, never a
/// rule that silently matches nothing.
let portScope(value: String): Option<Scope<Int64>> =
  if value == "*" then
    Option.Some(Scope.All)
  else
    Stdlib.Int64.parse(value)
    |> Stdlib.Result.toOption
    |> Stdlib.Option.andThen(fun port ->
      if port >= 0 && port <= 65535 then
        Option.Some(Scope.Only(port))
      else
        Option.None)


/// The rules for `<kind> <access> <target>`, where <param kind> is one of the
/// read/write-split resources (`file`, `env`) and <param access> is
/// `read`, `write` or `read+write` (also `readwrite`, `rw`). None for an
/// unknown kind or access.
let accessRules(kind: String, access: String, target: String): Option<List<Rule>> =
  let target = scope(target)
  let pair =
    match kind with
    | "file" -> Option.Some((Rule.FileRead(target), Rule.FileWrite(target)))
    | "env" -> Option.Some((Rule.EnvRead(target), Rule.EnvWrite(target)))
    | _ -> Option.None

  match pair with
  | None -> Option.None
  | Some((read, write)) ->
    match access with
    | "read" -> Option.Some([ read ])
    | "write" -> Option.Some([ write ])
    | "read+write" | "readwrite" | "rw" -> Option.Some([ read, write ])
    | _ -> Option.None


let defaultPort(scheme: String): Int64 =
  if scheme == "http" then 80 else 443


/// Parse a URL authority such as `h`, `h:8080`, `h:*`, `[::1]`, or
/// `[::1]:8080`. An explicit port is exact or `:*` for any port. If omitted,
/// named hosts use the scheme default; wildcard hosts or schemes use any port
/// (`https://*` therefore covers every HTTPS port). Malformed input returns
/// `None` instead of widening the rule.
let hostAndPort(scheme: String, authority: String): Option<(String * Scope<Int64>)> =
  let withPort(host: String, portText: String): Option<(String * Scope<Int64>)> =
    portScope(portText) |> Stdlib.Option.map(fun port -> (host, port))

  // If both scheme and host are specific, an omitted port uses the scheme's
  // default. If either is a wildcard, an omitted port means any port.
  let withoutPort(host: String): Option<(String * Scope<Int64>)> =
    if host == "*" || scheme == "*" then
      Option.Some((host, Scope.All))
    else
      Option.Some((host, Scope.Only(defaultPort(scheme))))

  if Stdlib.String.startsWith(authority, "[") then
    match Stdlib.String.splitFirst(authority, "]") with
    | None -> Option.None
    | Some((bracketed, rest)) ->
      let host = Stdlib.String.dropFirst(bracketed, 1)
      if rest == "" then
        withoutPort(host)
      else if Stdlib.String.startsWith(rest, ":") then
        withPort(host, Stdlib.String.dropFirst(rest, 1))
      else
        Option.None
  else
    match Stdlib.String.splitFirst(authority, ":") with
    | Some((host, port)) -> withPort(host, port)
    | None -> withoutPort(authority)


/// A bare path is exact. Only a trailing /* includes the path and its children.
let httpPath(path: String): Option<HttpPath> =
  let subtree = Stdlib.String.endsWith(path, "/*")
  let root = if subtree then Stdlib.String.dropLast(path, 2) else path
  if Stdlib.String.contains(root, "*") then
    Option.None
  else if subtree then
    Option.Some(HttpPath.Subtree(if root == "" then "/" else root))
  else
    Option.Some(HttpPath.Exact(root))


/// Bind addresses are literal IPv4, or localhost (always 127.0.0.1).
let serverAddress(address: String): Option<String> =
  if address == "localhost" then
    Option.Some("127.0.0.1")
  else if Stdlib.Url.isIPv4(address) then
    Option.Some(address)
  else
    Option.None


/// Use the runtime's URI normalization for every literal rule component.
let normalizeHttpRule(rule: HttpRule): Option<Rule> =
  Builtin.permissionNormalizeHttpRule(rule) |> Stdlib.Option.map(fun rule -> Rule.Http(rule))


/// Parse a URL for a scoped rule. `*` alone is the broad form. Otherwise:
/// scheme `http`, `https` or `*`; host, `*`, or `*.domain`; a port, `:*`, or
/// none (the scheme's default for a named host, any for `*`); an exact path,
/// a subtree ending in `/*`, or no path (any); a query or none (any). Every rendered rule parses back to
/// itself. Malformed URLs are rejected rather than widened.
let httpRule(method: String, url: String): Option<Rule> =
  let method = scope(Stdlib.String.toUppercase(method))
  if url == "*" then
    Option.Some(
      Rule.Http(
        HttpRule
          { method = method
            scheme = Scope.All
            host = HostRule.Any
            port = Scope.All
            path = HttpPath.All
            query = Scope.All }))
  else
    match Stdlib.String.splitFirst(url, "://") with
    | None -> Option.None
    | Some((scheme, rest)) ->
      if scheme != "http" && scheme != "https" && scheme != "*" then
        Option.None
      else
        // Split the query off first, matching the runtime request: a rule
        // written with a query covers only that exact query; without one, any.
        // Doing it before the path split keeps `https://h?x=1` as host `h`
        // with path `/`, the way the runtime normalizes it.
        let (beforeQuery, query) =
          match Stdlib.String.splitFirst(rest, "?") with
          | Some((before, query)) -> (before, Scope.Only("?" + query))
          | None -> (rest, Scope.All)

        // No path matches every path; a written path is exact unless it ends in /*.
        let authorityAndPath =
          match Stdlib.String.splitFirst(beforeQuery, "/") with
          | Some((authority, path)) ->
            httpPath("/" + path) |> Stdlib.Option.map(fun path -> (authority, path))
          | None -> Option.Some((beforeQuery, HttpPath.All))

        match authorityAndPath with
        | None -> Option.None
        | Some((authority, path)) ->
          match hostAndPort(scheme, authority) with
          | None -> Option.None
          | Some((host, port)) ->
            if host == "" then
              Option.None
            else
              let hostRule =
                if host == "*" then
                  HostRule.Any
                else if Stdlib.String.startsWith(host, "*.") then
                  HostRule.SubdomainsOf(Stdlib.String.dropFirst(host, 2))
                else
                  HostRule.Exact(host)

              normalizeHttpRule(
                HttpRule
                  { method = method
                    scheme = scope(scheme)
                    host = hostRule
                    port = port
                    path = path
                    query = query })


/// Parse one CLI rule. This only constructs the typed Policy value; runtime
/// authorization remains in `Permissions.Policy`.
let parseRule(args: List<String>): Option<List<Rule>> =
  match args with
  | ["all"] -> Option.Some([ Rule.All ])
  | ["http", method] -> httpRule(method, "*") |> Stdlib.Option.map(Stdlib.List.singleton)
  | ["http", method, url] -> httpRule(method, url) |> Stdlib.Option.map(Stdlib.List.singleton)
  | ["http-server", address, port] ->
    let address =
      if address == "*" then
        Option.Some(Scope.All)
      else
        serverAddress(address) |> Stdlib.Option.map(fun address -> Scope.Only(address))

    match address, portScope(port) with
    | Some(address), Some(port) -> Option.Some([ Rule.HttpServer(address, port) ])
    | _ -> Option.None
  | ["process-exact", executable, ...argv] ->
    if executable != "*" && Stdlib.Bool.not(isAbsolutePath(executable)) then
      Option.None
    else
      Option.Some(
        [ Rule.Process(ProcessRule { executable = scope(executable), args = Scope.Only(argv) }) ])
  | ["process", executable, ...argv] ->
    // The executable is `*` or an absolute path; a relative one would mean a
    // different program in every working directory, so it is not a rule.
    if executable != "*" && Stdlib.Bool.not(isAbsolutePath(executable)) then
      Option.None
    else
      Option.Some(
        [ Rule.Process(
            ProcessRule
              { executable = scope(executable)
                args = if Stdlib.List.isEmpty(argv) then Scope.All else Scope.Only(argv) }) ])
  // `file|env read|write [target]`; a missing target means every target.
  // These come after the kinds above so `http GET` and
  // `process EXE` are not mistaken for `<kind> <access>`.
  | [kind, access] -> accessRules(kind, access, "*")
  | [kind, access, target] -> accessRules(kind, access, target)
  // A bare effect name is always `Effect`, including `http`, `http-server`
  // and `process`: the scoped forms above need at least one more token (their
  // broad spellings are `http * *`, `http-server * *`, `process *`), so every
  // rule text names exactly one Rule value and `renderRule` round-trips.
  | [name] ->
    match effectOfName(name) with
    | Some(Raise) -> Option.None
    | found -> found |> Stdlib.Option.map(fun effect -> [ Rule.Effect(effect) ])
  | _ -> Option.None


/// Shell-style tokens for one rule's text, or None for an unterminated quote
/// or escape. Rendered rules single-quote every guest-controlled field, so
/// spaces and metacharacters remain one token and a displayed
/// `permissions allow ...` command is safe to paste into a shell.
let tokens(text: String): Option<List<String>> =
  let finish(current: List<Char>, soFar: List<String>, active: Bool): List<String> =
    if active then
      Stdlib.List.prepend(soFar, Stdlib.String.fromList(Stdlib.List.reverse(current)))
    else
      soFar

  let walk(
    remaining: List<Char>,
    mode: TokenMode,
    current: List<Char>,
    soFar: List<String>,
    active: Bool)
    : Option<List<String>> =
    match remaining with
    | [] ->
      match mode with
      | Bare -> Option.Some(Stdlib.List.reverse(finish(current, soFar, active)))
      | _ -> Option.None
    | [c, ...rest] ->
      let s = Stdlib.display(c)
      match mode with
      | Bare ->
        if s == " " || s == "\t" || s == "\n" then
          let soFar = finish(current, soFar, active)
          walk(rest, TokenMode.Bare, [], soFar, false)
        else if s == "'" then
          walk(rest, TokenMode.SingleQuoted, current, soFar, true)
        else if s == "\"" then
          walk(rest, TokenMode.DoubleQuoted, current, soFar, true)
        else if s == "\\" then
          walk(rest, TokenMode.EscapedBare, current, soFar, true)
        else
          walk(rest, TokenMode.Bare, Stdlib.List.prepend(current, c), soFar, true)
      | SingleQuoted ->
        if s == "'" then
          walk(rest, TokenMode.Bare, current, soFar, true)
        else
          walk(rest, TokenMode.SingleQuoted, Stdlib.List.prepend(current, c), soFar, true)
      | DoubleQuoted ->
        if s == "\"" then
          walk(rest, TokenMode.Bare, current, soFar, true)
        else if s == "\\" then
          walk(rest, TokenMode.EscapedDouble, current, soFar, true)
        else
          walk(rest, TokenMode.DoubleQuoted, Stdlib.List.prepend(current, c), soFar, true)
      | EscapedBare -> walk(rest, TokenMode.Bare, Stdlib.List.prepend(current, c), soFar, true)
      | EscapedDouble ->
        walk(rest, TokenMode.DoubleQuoted, Stdlib.List.prepend(current, c), soFar, true)

  walk(Stdlib.String.toList(Stdlib.String.trim(text)), TokenMode.Bare, [], [], false)


/// Parse one rule's text (as `permissions allow` would receive it, or as a
/// denial's `To allow:` hint prints it). Rendered rules round-trip through
/// this.
let parseRuleText(text: String): Option<List<Rule>> =
  tokens(text) |> Stdlib.Option.andThen(parseRule)


/// Parse a whole policy from rule texts; `deny <rule>` goes to the deny list.
/// Error carries the first spec that did not parse.
let parse(specs: List<String>): Result<Policy, String> =
  Stdlib.List.fold(specs, Result.Ok(empty()), fun(result, spec) ->
    match result with
    | Error(error) -> Result.Error(error)
    | Ok(policy) ->
      let rules =
        Permissions.tokens(spec)
        |> Stdlib.Option.andThen(fun tokens ->
          let (denied, tokens) =
            match tokens with
            | ["deny", ...rest] -> (true, rest)
            | tokens -> (false, tokens)

          parseRule(tokens) |> Stdlib.Option.map(fun rules -> (denied, rules)))

      match rules with
      | None -> Result.Error(spec)
      | Some((denied, rules)) ->
        if denied then
          Result.Ok({ policy with deny = Stdlib.List.concat(policy.deny, rules) })
        else
          Result.Ok({ policy with allow = Stdlib.List.concat(policy.allow, rules) }))


let isAll(scope: Scope<'a>): Bool =
  match scope with
  | All -> true
  | Only(_) -> false


let scopeText(scope: Scope<String>): String =
  match scope with
  | All -> "*"
  | Only(value) -> value


/// A shell-safe token. This is also understood by <fn tokens>, so rendered
/// policies round-trip internally as well as through an external shell.
let quoteToken(value: String): String =
  "'" + Stdlib.String.replaceAll(value, "'", "'\\''") + "'"


let renderStringScope(scope: Scope<String>): String =
  match scope with
  | All -> "*"
  | Only(value) -> quoteToken(value)


let renderHostRule(host: HostRule): String =
  match host with
  | Any -> "*"
  | Exact(host) ->
    if
      Stdlib.String.contains(host, ":") && Stdlib.Bool.not(Stdlib.String.startsWith(host, "["))
    then
      "[" + host + "]"
    else
      host
  | SubdomainsOf(domain) -> "*." + domain


/// Faithful text for one HTTP rule: `http <method> <url>`.
let renderHttpRule(rule: HttpRule): String =
  let method = scopeText(rule.method)
  let broad =
    isAll(rule.scheme)
    && isAll(rule.port)
    && rule.path == HttpPath.All
    && isAll(rule.query)
    && rule.host == HostRule.Any

  if broad then
    $"http {method} *"
  else
    let scheme = scopeText(rule.scheme)
    let host = renderHostRule(rule.host)
    // An absent port parses as the default for a named host and as any for
    // the wildcard host, so `All` is spelled `:*` only where it would
    // otherwise read as the default.
    let port =
      match rule.port with
      | All -> if rule.host == HostRule.Any then "" else ":*"
      | Only(port) -> ":" + Stdlib.display(port)

    let path =
      match rule.path with
      | All -> ""
      | Exact(path) -> path
      | Subtree(path) -> if path == "/" then "/*" else path + "/*"

    // The query (leading `?` already included) round-trips so `show` reflects
    // exactly what `allow` was given; `All` renders nothing (any query).
    let query =
      match rule.query with
      | All -> ""
      | Only(query) -> query

    let url = $"{scheme}://{host}{port}{path}{query}"
    $"http {method} {quoteToken(url)}"


/// Faithful text for one process rule: `process <executable> [args…]`.
let renderProcessRule(rule: ProcessRule): String =
  let executable = renderStringScope(rule.executable)
  match rule.args with
  | All -> $"process {executable}"
  | Only([]) -> $"process-exact {executable}"
  | Only(args) ->
    let args =
      args
      |> Stdlib.List.map(quoteToken)
      |> Stdlib.String.join(" ")

    $"process {executable} {args}"


let renderRule(rule: Rule): String =
  match rule with
  | All -> "all"
  | Effect(effect) -> effectName(effect)
  | Http(rule) -> renderHttpRule(rule)
  | HttpServer(address, port) ->
    let port =
      match port with
      | All -> "*"
      | Only(p) -> Stdlib.display(p)

    "http-server " + scopeText(address) + " " + port
  | FileRead(scope) -> "file read " + renderStringScope(scope)
  | FileWrite(scope) -> "file write " + renderStringScope(scope)
  | EnvRead(scope) -> "env read " + renderStringScope(scope)
  | EnvWrite(scope) -> "env write " + renderStringScope(scope)
  | Process(rule) -> renderProcessRule(rule)


let render(policy: Policy): List<String> =
  Stdlib.List.concat(
    policy.allow |> Stdlib.List.map(renderRule),
    policy.deny |> Stdlib.List.map(fun rule -> "deny " + renderRule(rule)))
