/// Shared `Range`/`Point` types for source positions. Structured parsing lives
/// in the F# `LibParser`.
module Darklang.LanguageTools.Parser

type Point =
  { row: Int64
    column: Int64 }


type Range =
  { start: Point
    end_: Point }


/// The kind of file `Builtin.parse` reads. In a `Script`, a top-level `let x = ...` binds
/// over the rest of the file, and test assertions are errors. In a
/// `Package` that `let` is an error (values use `val`), and so are top-level expressions
/// and test assertions.
type FileKind =
  | Script
  | Package
  /// Package input for `dark import`. Keep declarations that pass syntax and package checks.
  | PackagePartialSave


/// The words the parser reserves, from the lexer itself: each one is a name in
/// backticks (`match`), or where only a name can go. `_` is among them.
val keywords = Builtin.parserKeywords
