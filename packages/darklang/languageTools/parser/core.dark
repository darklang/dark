/// Shared `Range`/`Point` types for source positions. Structured parsing lives
/// in the F# `LibParser`.
module Darklang.LanguageTools.Parser


// TODO: these should be UInts of some size
// (UInt8 might even be enough - how many lines are over 255chars?)
type Point = { row: Int, column: Int }

type Range = { start: Point, end_: Point }

/// The kind of file `Builtin.parse` reads. In a `Script`, a top-level `let x = ...` binds
/// over the rest of the file, and named tests and test assertions are errors. In a
/// `Package` that `let` is an error (values use `val`), and so are top-level expressions
/// and test assertions.
type FileKind =
  | Script
  | Package
