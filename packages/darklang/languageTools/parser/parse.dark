module Darklang.LanguageTools.Parser.Parse


/// The parser's tree for <param code> and its diagnostics, as (range, message) pairs. The tree is
/// best-effort, {{None}} only if the tokenizer failed outright.
let parse(
  kind: Parser.FileKind,
  code: String)
  : (Stdlib.Option.Option<WrittenTypes.ParsedFile> * List<(Parser.Range * String)>) =
  Builtin.parse(kind, code)


/// The written-types tree for <param code>, or {{None}} if the tokenizer failed outright. Syntax errors
/// short of that come back as a tree plus `diagnostics`.
let toWrittenTypes(code: String): Stdlib.Option.Option<WrittenTypes.ParsedFile> =
  (parse(Parser.FileKind.Script, code)) |> Stdlib.Tuple2.first


/// The parser's syntax diagnostics for <param code>, as (range, message) pairs. Empty on a clean parse.
let diagnostics(code: String): List<(Parser.Range * String)> =
  (parse(Parser.FileKind.Script, code)) |> Stdlib.Tuple2.second


/// Why a parser entry point refused its source.
type ParseError =
  /// The parser's syntax diagnostics, as (range, message) pairs, in source order. Never empty.
  | Syntax(diagnostics: List<(Parser.Range * String)>)
  /// The tokenizer failed outright, so there is no tree and nothing more specific to say.
  | NoTree
  /// `parsePTExpr` wants exactly one expression, and the source held this many.
  | NotOneExpression(count: Int64)


module ParseError =
  /// One diagnostic as a line a person can act on. The line and column count from 1, as in
  /// the parser messages and the CLI diagnostics.
  let diagnosticToString(diagnostic: (Parser.Range * String)): String =
    let (range, message) = diagnostic
    $"Parse error at line {Stdlib.display(range.start.row + 1)}, column {Stdlib.display(range.start.column + 1)}: {message}"

  let toString(err: ParseError): String =
    match err with
    | Syntax(diagnostics) ->
      diagnostics
      |> Stdlib.List.map(fun d -> diagnosticToString(d))
      |> Stdlib.String.join("\n")
    | NoTree -> "Couldn't parse the source at all"
    | NotOneExpression(count) ->
      $"Expected exactly one expression, but found {Stdlib.display(count)}"


/// The range-complete parser's tree for <param code>, or why not. Every consumer of this fn
/// (canvas modules, CLI scripts, the package-test runner, parsePTExpr) parses through it.
///
/// A source with any syntax diagnostic is an `Error`, even though the parser recovered a tree:
/// lowering turns the recovery holes into `()`, so passing that tree on would run something
/// other than what was written.
let initialParse(code: String): Stdlib.Result.Result<WrittenTypes.ParsedFile, ParseError> =
  initialParseAs(Parser.FileKind.Script, code)


/// `initialParse` for a <param kind> other than a script, such as a package file, where named
/// tests are allowed.
let initialParseAs(
  kind: Parser.FileKind,
  code: String)
  : Stdlib.Result.Result<WrittenTypes.ParsedFile, ParseError> =
  match parse(kind, code) with
  | (Some(parsedFile), []) -> Stdlib.Result.Result.Ok(parsedFile)
  | (None, []) -> Stdlib.Result.Result.Error(ParseError.NoTree)
  | (_, diagnostics) -> Stdlib.Result.Result.Error(ParseError.Syntax(diagnostics))


let parsePTExpr(
  code: String)
  : Stdlib.Result.Result<ProgramTypes.Expr, ParseError> =
  // context-free lowering is just the in-context lowering with an empty context, against main
  parsePTExprInContext(SCM.Branch.mainBranchId, "", [], [], [], code)


/// Lower an expression against <param branchId>, under a real module / fn-name / parameter context.
///
/// The LoweringDifferential uses this so it can catch resolution-context-dependent divergences (pipe
/// callee resolves fn-first, self-recursion -> ESelf, a match pattern shadowing a parameter) that a
/// context-free lowering can't surface.
///
/// The branch is a PARAMETER, not the process's: the same source must lower the same way whichever
/// branch a long-lived process (the LSP) happens to sit on.
let parsePTExprInContext(
  branchId: Uuid,
  owner: String,
  currentModule: List<String>,
  // empty = no self-context (None); non-empty = Some (the fully-qualified fn name)
  currentFnName: List<String>,
  paramNames: List<String>,
  code: String)
  : Stdlib.Result.Result<ProgramTypes.Expr, ParseError> =
  match code |> initialParse with
  | Ok(sourceFile) ->
    let exprs =
      match sourceFile with
      | SourceFile(s) -> s.exprsToEval

    let ctx =
      NameResolver.NRContext
        { onMissing = NameResolver.OnMissing.Allow
          pm = PackageManager.pm()
          branchId = branchId
          owner = owner
          currentModule = currentModule }

    let argMap =
      paramNames
      |> Stdlib.List.indexedMap(fun(i, name) -> (name, i))
      |> Stdlib.List.fold(Stdlib.Dict.empty, fun(acc, (name, idx)) ->
        Stdlib.Dict.set(acc, name, idx))

    let wtCtx =
      WrittenTypesToProgramTypes.Context
        { currentFnName =
            if Stdlib.List.isEmpty(currentFnName) then
              Stdlib.Option.Option.None
            else
              Stdlib.Option.Option.Some(currentFnName)
          argMap = argMap
          localBindings = [] }

    match exprs with
    | [ expr ] ->
      let (expr, _) = WrittenTypesToProgramTypes.Expr.toPT(ctx, wtCtx, expr)
      expr |> Stdlib.Result.Result.Ok
    | _ ->
      ParseError.NotOneExpression(Stdlib.List.length(exprs))
      |> Stdlib.Result.Result.Error
  | Error(e) -> Stdlib.Result.Result.Error(e)


let parsePTSourceFileWithOps(
  branchId: Uuid,
  code: String)
  : Stdlib.Result.Result<
    (ProgramTypes.SourceFile.SourceFile * List<ProgramTypes.PackageOp>),
    ParseError
  > =
  match code |> initialParse with
  | Ok(parsedFile) ->
    let (sourceFile, ops, _unresolvedNames) =
      WrittenTypesToProgramTypes.parsedFileAsSourceFile(branchId, parsedFile)

    (sourceFile, ops) |> Stdlib.Result.Result.Ok
  | Error(e) -> Stdlib.Result.Result.Error(e)


/// Parse package declarations into written types, or return syntax diagnostics.
let packageToWrittenTypes(
  source: String)
  : Stdlib.Result.Result<WrittenTypes.ParsedFile, List<(Parser.Range * String)>> =
  match parse(Parser.FileKind.Package, source) with
  | (Some(parsedFile), []) -> Stdlib.Result.Result.Ok(parsedFile)
  | (_, diagnostics) -> Stdlib.Result.Result.Error(diagnostics)


/// Convert a top-level declaration to a module member for shared lowering.
let toModuleDeclaration(
  declaration: WrittenTypes.SourceFile.SourceFileDeclaration)
  : WrittenTypes.ModuleDeclaration.Declaration =
  match declaration with
  | Type(typ) -> WrittenTypes.ModuleDeclaration.Declaration.Type(typ)
  | Function(fn) -> WrittenTypes.ModuleDeclaration.Declaration.Function(fn)
  | Value(value) -> WrittenTypes.ModuleDeclaration.Declaration.Value(value)
  // The branch carried its own copy of this mapping in `cli/packages/module.dark`; main moved
  // the mapping here and calls it from both of that file's sites, so the trait and impl arms
  // have to live here now or a source file declaring either lowers to nothing.
  | Trait(t) -> WrittenTypes.ModuleDeclaration.Declaration.Trait(t)
  | Impl(i) -> WrittenTypes.ModuleDeclaration.Declaration.Impl(i)
  | Test(test) -> WrittenTypes.ModuleDeclaration.Declaration.Test(test)
  | Module(modul) -> WrittenTypes.ModuleDeclaration.Declaration.SubModule(modul)


/// Lower a module to package operations without storing them. Resolve references
/// within the module and against <param context>, then stabilize recursive hashes.
let moduleToPackageOps(
  context: NameResolver.NRContext,
  rootModule: WrittenTypes.ModuleDeclaration.ModuleDeclaration)
  : (List<ProgramTypes.PackageOp> * List<WrittenTypes.UnresolvedName>) =
  // Provisional ops use unique location hashes, so every declaration can resolve
  // every other without touching the store.
  let (_, provisionalOps, _) =
    WrittenTypesToProgramTypes.moduleDeclarationWithOpsHelper(context, rootModule)

  let pm = ProgramTypes.PackageManager.withExtraOps(context.pm, provisionalOps)

  let (_, ops, unresolvedNames) =
    WrittenTypesToProgramTypes.moduleDeclarationWithOpsHelper(
      { context with pm = pm },
      rootModule)

  (PackageManager.stabilizeHashes(ops), unresolvedNames)


/// Parse package source under <param owner> and <param modules>, resolving against
/// <param branchId> and the other declarations in the source. Return stabilized
/// operations, or an error for invalid syntax or unresolved names.
let packageSourceToOps(
  branchId: Uuid,
  owner: String,
  modules: List<String>,
  source: String)
  : Stdlib.Result.Result<List<ProgramTypes.PackageOp>, String> =
  match packageToWrittenTypes(source) with
  | Error(diagnostics) ->
    let messages = Stdlib.List.map(diagnostics, fun((_, message)) -> message)
    Stdlib.Result.Result.Error(Stdlib.String.join(messages, "; "))
  | Ok(SourceFile(sourceFile)) ->
    let rootModule =
      WrittenTypes.ModuleDeclaration.ModuleDeclaration
        { range = sourceFile.range
          name = (sourceFile.range, "__module__")
          declarations =
            Stdlib.List.map(sourceFile.declarations, fun d -> toModuleDeclaration(d))
          keywordModule = sourceFile.range }

    let context =
      NameResolver.NRContext
        { onMissing = NameResolver.OnMissing.Allow
          pm = PackageManager.pm()
          branchId = branchId
          owner = owner
          currentModule = modules }

    let (ops, unresolvedNames) = moduleToPackageOps(context, rootModule)

    if Stdlib.List.isEmpty(unresolvedNames) then
      Stdlib.Result.Result.Ok(ops)
    else
      let names =
        unresolvedNames
        |> Stdlib.List.map(fun((_, parts, _)) -> Stdlib.String.join(parts, "."))
        |> Stdlib.List.unique
      Stdlib.Result.Result.Error("unresolved: " + Stdlib.String.join(names, ", "))
