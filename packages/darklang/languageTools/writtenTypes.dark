module Darklang.LanguageTools.WrittenTypes

// <aliases>
type Range = Parser.Range
// <aliases>

/// A name that failed to resolve, with its source location and error details.
type UnresolvedName =
  (Parser.Range * List<String> * ProgramTypes.NameResolutionError)

// Identifiers
type ModuleIdentifier = { range: Range, name: String }

type TypeIdentifier = { range: Range, name: String }

type QualifiedTypeIdentifier =
  {
    range: Range
    /// the Range corresponds to the `.` after the module name
    modules: List<(ModuleIdentifier * Range)>
    typ: TypeIdentifier
    typeArgs: List<TypeReference.TypeReference>
  }

type VariableIdentifier = { range: Range, name: String }

type ValueIdentifier = { range: Range, name: String }

type FnIdentifier = { range: Range, name: String }

type QualifiedFnIdentifier =
  {
    range: Range
    /// the range corresponds to the `.` after the module name
    modules: List<(ModuleIdentifier * Range)>
    fn: FnIdentifier
  }

// CLEANUP: Refactor List<String> to List<Range* String> or use a QualifiedTypeIdentifier.
// Consider removing 'Unresolved' and inlining it where it's used, since all names are unresolved at this stage (wt)
type Name = Unresolved(Range, List<String>)

// Types
module TypeReference =
  // The first range corresponds to the whole type
  type Builtin =
    | TUnit(Range)
    | TBool(Range)
    | TInt8(Range)
    | TUInt8(Range)
    | TInt16(Range)
    | TUInt16(Range)
    | TInt32(Range)
    | TUInt32(Range)
    | TInt64(Range)
    | TUInt64(Range)
    | TInt128(Range)
    | TUInt128(Range)
    | TBigInt(Range)
    | TFloat(Range)
    | TFloat32(Range)
    | TDecimal(Range)
    | TChar(Range)
    | TString(Range)
    | TDateTime(Range)
    | TUuid(Range)
    | TBytes(Range)

    | TStream(
      Range,
      keywordStream: Range,
      openBracket: Range,
      typ: TypeReference.TypeReference,
      closeBracket: Range)

    | TList(
      Range,
      keywordList: Range,
      openBracket: Range,
      typ: TypeReference.TypeReference,
      closeBracket: Range)

    | TDict(
      Range,
      keywordDict: Range,
      openBrace: Range,
      key: TypeReference.TypeReference,
      symbolComma: Range,
      value: TypeReference.TypeReference,
      closeBrace: Range)

    | TTuple(
      Range,
      first: TypeReference,
      symbolAsterisk: Range,
      second: TypeReference,
      /// the Range corresponds to the `*` symbol
      rest: List<(Range * TypeReference)>,
      openParen: Range,
      closeParen: Range)

    | TFn(
      Range,
      /// the Range corresponds to the `->` symbol
      arguments: List<(TypeReference.TypeReference * Range)>,
      ret: TypeReference.TypeReference)

    | TVariable(
      Range,
      symbolSingleQuote: Range,
      /// the Range corresponds to the `'` symbol
      name: Range * String)


  type TypeReference =
    | Builtin(Builtin)
    | QualifiedName(QualifiedTypeIdentifier)

// Expressions
type LetPattern =
  | LPUnit(Range)
  | LPVariable(Range, name: String)
  | LPWildcard(Range)
  | LPTuple(
    Range,
    first: LetPattern,
    symbolComma: Range,
    second: LetPattern,
    /// the Range corresponds to the `,` symbol
    rest: List<(Range * LetPattern)>,
    symbolOpenParen: Range,
    symbolCloseParen: Range)


type MatchPattern =
  | MPUnit(Range)
  | MPBool(Range, Bool)
  | MPInt8(Range, intPart: Range * Int8, suffixPart: Range)
  | MPUInt8(Range, intPart: Range * UInt8, suffixPart: Range)
  | MPInt16(Range, intPart: Range * Int16, suffixPart: Range)
  | MPUInt16(Range, intPart: Range * UInt16, suffixPart: Range)
  | MPInt32(Range, intPart: Range * Int32, suffixPart: Range)
  | MPUInt32(Range, intPart: Range * UInt32, suffixPart: Range)
  | MPInt64(Range, intPart: Range * Int64, suffixPart: Range)
  | MPUInt64(Range, intPart: Range * UInt64, suffixPart: Range)
  | MPInt128(Range, intPart: Range * Int128, suffixPart: Range)
  | MPUInt128(Range, intPart: Range * UInt128, suffixPart: Range)
  | MPBigInt(Range, intPart: Range * BigInt)
  | MPFloat(Range, Sign, String, String)
  | MPFloat32(Range, Sign, String, String)
  | MPDecimal(Range, Decimal)
  | MPChar(
    Range,
    contents: Stdlib.Option.Option<(Range * String)>,
    symbolOpenQuote: Range,
    symbolCloseQuote: Range)
  | MPString(
    Range,
    contents: Stdlib.Option.Option<(Range * String)>,
    symbolOpenQuote: Range,
    symbolCloseQuote: Range)
  | MPList(
    Range,
    /// the Range corresponds to the `,` symbol
    contents: List<(MatchPattern * Stdlib.Option.Option<Range>)>,
    symbolOpenBracket: Range,
    symbolCloseBracket: Range)
  /// `[head, ...tail]`, one node per head; every node in a chain shares the `...`
  | MPListCons(
    Range,
    head: MatchPattern,
    tail: MatchPattern,
    symbolDots: Range)
  | MPTuple(
    Range,
    first: MatchPattern,
    symbolComma: Range,
    second: MatchPattern,
    /// the Range corresponds to the `,` symbol
    rest: List<(Range * MatchPattern)>,
    symbolOpenParen: Range,
    symbolCloseParen: Range)
  | MPVariable(Range, String)
  | MPEnum(
    Range,
    caseName: Range * String,
    fieldPats: List<MatchPattern>)

  // CLEANUP: handle pipe symbols
  | MPOr(Range, List<MatchPattern>)

  /// `pattern as name`: matches what `pattern` matches and binds the whole value
  | MPAs(
    Range,
    pattern: MatchPattern,
    symbolAs: Range,
    name: Range * String)

  /// `{ name = p, age }`: a record, by the fields it names; the rest are ignored.
  /// A field with no `= p` binds a variable named after it. The Range is the `=`.
  | MPRecord(
    Range,
    fields: List<((Range * String) * Stdlib.Option.Option<(Range * MatchPattern)>)>,
    symbolOpenBrace: Range,
    symbolCloseBrace: Range)

  // A recovery hole where a pattern was expected but couldn't be parsed (the
  // parse carries a diagnostic at this range). Tooling renders around it; it
  // never reaches execution.
  | MPError(Range)

type MatchCase =
  { pat:
      /// the Range corresponds to the `|` symbol
      ( Range *
        MatchPattern *
        /// the Range corresponds to the `->` symbol
        Range)
    /// the Range corresponds to the `when` keyword
    whenCondition: Stdlib.Option.Option<(Range * Expr)>
    rhs: Expr }


type BinaryOperation =
  | BinOpAnd
  | BinOpOr

type InfixFnName =
  | ArithmeticPlus
  | ArithmeticMinus
  | ArithmeticMultiply
  | ArithmeticDivide
  | ArithmeticModulo
  | ArithmeticPower
  | BitwiseAnd
  | BitwiseOr
  | BitwiseXor
  | ShiftLeft
  | ShiftRight
  | ComparisonGreaterThan
  | ComparisonGreaterThanOrEqual
  | ComparisonLessThan
  | ComparisonLessThanOrEqual
  | ComparisonEquals
  | ComparisonNotEquals

type Infix =
  | InfixFnCall(InfixFnName)
  | BinOp(BinaryOperation)

type StringSegment =
  | StringText(Range, String)
  | StringInterpolation(
    Range,
    Expr,
    symbolOpenBrace: Range,
    symbolCloseBrace: Range)

type Expr =
  | EUnit(Range)
  | EBool(Range, Bool)
  | EInt8(Range, intPart: Range * Int8, suffixPart: Range)
  | EUInt8(Range, intPart: Range * UInt8, suffixPart: Range)
  | EInt16(Range, intPart: Range * Int16, suffixPart: Range)
  | EUInt16(Range, intPart: Range * UInt16, suffixPart: Range)
  | EInt32(Range, intPart: Range * Int32, suffixPart: Range)
  | EUInt32(Range, intPart: Range * UInt32, suffixPart: Range)
  | EInt64(
    Range,
    intPart: Range * Int64,
    /// for the L suffix
    suffixPart: Range)
  | EUInt64(Range, intPart: Range * UInt64, suffixPart: Range)
  | EInt128(Range, intPart: Range * Int128, suffixPart: Range)
  | EUInt128(Range, intPart: Range * UInt128, suffixPart: Range)
  | EBigInt(Range, intPart: Range * BigInt)
  | EFloat(Range, Sign, String, String)
  | EFloat32(Range, Sign, String, String)
  | EDecimal(Range, Decimal)
  | EString(
    Range,
    symbolDollarSign: Stdlib.Option.Option<Range>,
    contents: List<StringSegment>,
    symbolOpenQuote: Range,
    symbolCloseQuote: Range)
  | EChar(
    Range,
    contents: Stdlib.Option.Option<(Range * String)>,
    symbolOpenQuote: Range,
    symbolCloseQuote: Range)

  | EList(
    Range,
    /// the Range corresponds to the `,` symbol
    contents: List<(Expr * Stdlib.Option.Option<Range>)>,
    symbolOpenBracket: Range,
    symbolCloseBracket: Range)

  | EDict(
    Range,
    contents: List<(Range * Expr * Range * Expr)>,
    keywordDict: Range,
    symbolOpenBrace: Range,
    symbolCloseBrace: Range)

  | ETuple(
    Range,
    first: Expr,
    symbolComma: Range,
    second: Expr,
    /// the Range corresponds to the `,` symbol
    rest: List<(Range * Expr)>,
    symbolOpenParen: Range,
    symbolCloseParen: Range)

  | ERecord(
    Range,
    typeName: QualifiedTypeIdentifier,
    // fields: List<:, key, value>
    fields: List<(Range * (Range * String) * Expr)>,
    symbolOpenBrace: Range,
    symbolCloseBrace: Range)

  | ERecordUpdate(
    Range,
    record: Expr,
    /// the second Range corresponds to the symbol `=`
    updates: List<((Range * String) * Range * Expr)>,
    symbolOpenBrace: Range,
    symbolCloseBrace: Range,
    keywordWith: Range)

  | EEnum(
    Range,
    typeName: QualifiedTypeIdentifier,
    caseName: Range * String,
    fields: List<Expr>,
    /// between the typeName and the caseName
    symbolDot: Range)

  | ELet(
    Range,
    LetPattern,
    expr: Expr,
    body: Expr,
    keywordLet: Range,
    symbolEquals: Range)

  | EUnwrap(Range, Expr, symbolQuestion: Range)
  | EVariable(Range, String)

  | ERecordFieldAccess(
    Range,
    Expr,
    fieldName: Range * String,
    symbolDot: Range)

  | EIf(
    Range,
    cond: Expr,
    thenExpr: Expr,
    elseExpr: Stdlib.Option.Option<Expr>,
    keywordIf: Range,
    keywordThen: Range,
    keywordElse: Stdlib.Option.Option<Range>)

  | EMatch(
    Range,
    expr: Expr,
    cases: List<MatchCase>,
    keywordMatch: Range,
    keywordWith: Range)

  /// the Range corresponds to the `|` symbol
  | EPipe(Range, Expr, List<(Range * PipeExpr)>)

  | EInfix(Range, op: Range * Infix, left: Expr, right: Expr)

  | ELambda(
    Range,
    pats: List<LetPattern>,
    body: Expr,
    keywordFun: Range,
    symbolArrow: Range)

  | EApply(
    Range,
    lhs: Expr,
    typeArgs: List<TypeReference.TypeReference>,
    args: List<Expr>)

  | EFnName(Range, name: QualifiedFnIdentifier)

  | EStatement(Range, first: Expr, next: Expr)

  // A recovery hole where an expression was expected but couldn't be parsed
  // (the parse carries a diagnostic at this range). Tooling renders around it;
  // it never reaches execution.
  | EError(Range)

type PipeExpr =
  | EPipeLambda(
    Range,
    pats: List<LetPattern>,
    body: Expr,
    keywordFun: Range,
    symbolArrow: Range)
  | EPipeEnum(
    Range,
    typeName: QualifiedTypeIdentifier,
    caseName: Range * String,
    fields: List<Expr>,
    /// between the typeName and the caseName
    symbolDot: Range)
  | EPipeFnCall(
    Range,
    fnName: QualifiedFnIdentifier,
    typeArgs: List<TypeReference.TypeReference>,
    args: List<Expr>)
  | EPipeVariableOrFnCall(Range, String)


module Expr =
  /// Source range covering a whole expression node.
  let range(expr: Expr): Range =
    match expr with
    | EUnit(range) -> range
    | EBool(range, _) -> range
    | EInt8(range, _, _) -> range
    | EUInt8(range, _, _) -> range
    | EInt16(range, _, _) -> range
    | EUInt16(range, _, _) -> range
    | EInt32(range, _, _) -> range
    | EUInt32(range, _, _) -> range
    | EInt64(range, _, _) -> range
    | EUInt64(range, _, _) -> range
    | EInt128(range, _, _) -> range
    | EUInt128(range, _, _) -> range
    | EBigInt(range, _) -> range
    | EFloat(range, _, _, _) -> range
    | EFloat32(range, _, _, _) -> range
    | EDecimal(range, _) -> range
    | EString(range, _, _, _, _) -> range
    | EChar(range, _, _, _) -> range
    | EList(range, _, _, _) -> range
    | EDict(range, _, _, _, _) -> range
    | ETuple(range, _, _, _, _, _, _) -> range
    | ERecord(range, _, _, _, _) -> range
    | ERecordUpdate(range, _, _, _, _, _) -> range
    | EEnum(range, _, _, _, _) -> range
    | ELet(range, _, _, _, _, _) -> range
    | EUnwrap(range, _, _) -> range
    | EVariable(range, _) -> range
    | ERecordFieldAccess(range, _, _, _) -> range
    | EIf(range, _, _, _, _, _, _) -> range
    | EMatch(range, _, _, _, _) -> range
    | EPipe(range, _, _) -> range
    | EInfix(range, _, _, _) -> range
    | ELambda(range, _, _, _, _) -> range
    | EApply(range, _, _, _) -> range
    | EFnName(range, _) -> range
    | EStatement(range, _, _) -> range
    | EError(range) -> range


// Module declarations
module ModuleDeclaration =
  type Declaration =
    | Type(TypeDeclaration.TypeDeclaration)
    | Function(FnDeclaration.FnDeclaration)
    | Value(ValueDeclaration.ValueDeclaration)
    | Trait(TraitDeclaration.TraitDeclaration)
    | Impl(ImplDeclaration.ImplDeclaration)
    | Test(TestDeclaration.TestDeclaration)
    | SubModule(ModuleDeclaration.ModuleDeclaration)
    // TODO: handle http handler and db
    | Expr(Expr)

  type ModuleDeclaration =
    { range: Range
      name: (Range * String)
      declarations: List<Declaration>
      keywordModule: Range }


// Type declaration
/// `'a: Show<Int64>` in a type-param list: the trait is a type name
type TypeParamBound =
  { range: Range
    param: String
    trait_: QualifiedTypeIdentifier
    symbolColon: Range }


module TypeDeclaration =
  type RecordField =
    { range: Range
      name: (Range * String)
      typ: TypeReference.TypeReference
      description: String
      symbolColon: Range }

  type EnumField =
    { range: Range
      typ: TypeReference.TypeReference
      label: Stdlib.Option.Option<(Range * String)>
      description: String
      symbolColon: Stdlib.Option.Option<Range> }

  type EnumCase =
    { range: Range
      name: (Range * String)
      fields: List<EnumField>
      description: String }

  type Definition =
    | Alias(TypeReference.TypeReference)
    /// the Range corresponds to the `,` symbol
    | Record(List<(RecordField * Stdlib.Option.Option<Range>)>)
    /// the Range corresponds to the `|` symbol
    | Enum(List<(Range * EnumCase)>)

  type TypeDeclaration =
    { range: Range
      name: TypeIdentifier
      typeParams: List<(Range * String)>
      /// `'a: Compare` on the type params
      bounds: List<TypeParamBound>
      definition: Definition
      description: String
      keywordType: Range
      symbolEquals: Range }


// Value declarations
module ValueDeclaration =
  type ValueDeclaration =
    { range: Range
      name: ValueIdentifier
      body: Expr
      description: String
      keywordVal: Range
      symbolEquals: Range }


// Named package tests
module TestDeclaration =
  type ExpectedError =
    | RuntimeError(String)

  type TestDeclaration =
    { range: Range
      name: ValueIdentifier
      body: Expr
      expectedError: Option<(Range * ExpectedError)>
      description: String
      keywordTest: Range
      errorKindRange: Option<Range>
      symbolOutcome: Option<Range>
      symbolEquals: Range }


// Fn declarations
module FnDeclaration =
  type UnitParameter = { range: Range }

  type NormalParameter =
    { range: Range
      name: VariableIdentifier
      typ: TypeReference.TypeReference
      /// The `///` written above the parameter.
      description: String
      symbolLeftParen: Range
      symbolColon: Range
      symbolRightParen: Range }

  type Parameter =
    | Unit(UnitParameter)
    | Normal(NormalParameter)


  type FnDeclaration =
    { range: Range
      name: FnIdentifier
      typeParams: List<(Range * String)>
      /// `'a: Show + Compare` on the type params, one entry per trait
      bounds: List<TypeParamBound>
      parameters: List<Parameter>
      /// The effect row on the return colon, if one was written. Like
      /// `typeParams`, these are names as written with their positions; they
      /// become `Permissions.Effect` values in WrittenTypesToProgramTypes,
      /// which is where an unknown name is reported. At runtime the row is the
      /// author's ceiling on the body and everything it calls: it can only
      /// take away, never grant.
      ///
      ///   `: String`              None       no row, no promise
      ///   `:{} String`            Some []    effect-free: every host effect inside is denied
      ///   `:{Http, Clock} String` Some [...] only these; anything else inside is denied
      effects: Option<List<(Range * String)>>
      returnType: TypeReference.TypeReference
      body: Expr
      description: String
      keywordLet: Range
      symbolColon: Range
      symbolEquals: Range }


/// `trait Show<'a> = <method signatures>`
module TraitDeclaration =
  type Method =
    { range: Range
      name: FnIdentifier
      typeParams: List<(Range * String)>
      bounds: List<TypeParamBound>
      parameters: List<FnDeclaration.Parameter>
      effects: Option<List<(Range * String)>>
      returnType: TypeReference.TypeReference
      description: String
      keywordLet: Range
      symbolColon: Range }

  type TraitDeclaration =
    { range: Range
      name: TypeIdentifier
      typeParams: List<(Range * String)>
      bounds: List<TypeParamBound>
      methods: List<Method>
      description: String
      keywordTrait: Range
      symbolEquals: Range }


/// `impl[<'a: B>] Trait<Args> for Type = <method fns or aliases>`
module ImplDeclaration =
  type Member =
    /// A full fn declaration in the block
    | Method(FnDeclaration.FnDeclaration)
    /// `let name = Existing.fn`: the method is a fn that already exists
    | Alias(ValueDeclaration.ValueDeclaration)

  type ImplDeclaration =
    { range: Range
      typeParams: List<(Range * String)>
      bounds: List<TypeParamBound>
      trait_: QualifiedTypeIdentifier
      forType: TypeReference.TypeReference
      members: List<Member>
      description: String
      keywordImpl: Range
      keywordFor: Range
      symbolEquals: Range }


module SourceFile =
  type SourceFileDeclaration =
    | Type(TypeDeclaration.TypeDeclaration)
    | Function(FnDeclaration.FnDeclaration)
    | Value(ValueDeclaration.ValueDeclaration)
    | Trait(TraitDeclaration.TraitDeclaration)
    | Impl(ImplDeclaration.ImplDeclaration)
    | Test(TestDeclaration.TestDeclaration)
    | Module(ModuleDeclaration.ModuleDeclaration)

  type SourceFile =
    { range: Range
      declarations: List<SourceFile.SourceFileDeclaration>
      exprsToEval: List<Expr> }


type ParsedFile = SourceFile(SourceFile.SourceFile)
