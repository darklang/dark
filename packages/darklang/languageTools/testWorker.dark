/// Entry point for a disposable test process, selected for this invocation only.
module Darklang.LanguageTools.PackageManager.Test.Worker

/// F# executes exact hashes and transports runtime values without losing their types.
let execute (request: Blob) (access: Blob) : (Blob * Int) =
  Builtin.pmTestWorkerExecute request access

let read (path: String) : Blob =
  Builtin.unwrap (Stdlib.Cli.FileSystem.readFile path)

let main (args: List<String>) : Int =
  match args with
  | [ requestPath, resultPath ] ->
    let dir = Stdlib.Cli.Path.parent requestPath
    let privateDirectory =
      Stdlib.String.startsWith (Stdlib.Cli.Path.basename dir) "dark-test-"
    if Stdlib.Env.get "HOME" != Some dir
       || Stdlib.Bool.not privateDirectory
       || requestPath != Stdlib.Cli.Path.join [ dir, "request.bin" ]
       || resultPath != Stdlib.Cli.Path.join [ dir, "result.bin" ] then
      Stdlib.printLine "Test worker requires a disposable test directory"
      1
    else
      // The run's shared store already records its branch, and it is read-only:
      // writing the same value again would fail and send the test to a copy.
      let branch = Stdlib.toString (Darklang.SCM.PackageOps.currentBranch ())
      let _ =
        if Stdlib.LocalStore.configGet "current_branch" != branch then
          Stdlib.LocalStore.configSet "current_branch" branch
      let access = read (Stdlib.Cli.Path.join [ dir, "access.bin" ])
      let (result, code) = execute (read requestPath) access
      match Stdlib.Cli.FileSystem.overwriteFile resultPath result with
      | Ok () -> code
      | Error error ->
        Stdlib.printLine (Stdlib.Cli.FileSystem.FileError.toString error)
        1
  | _ ->
    Stdlib.printLine "Invalid test worker arguments"
    1
