/// Check each function, value, or type declaration and produce its report.
/// Definite errors make a declaration Failed. Warnings or unresolved checks make
/// it Incomplete when there are no definite errors. Otherwise it is Checked.
module Darklang.LanguageTools.AtRestTypeChecker.Items

/// The verdict and reported issues for one declaration.
type Outcome =
  { verdict: Verdict
    diagnostics: List<Issue>
    warnings: List<Issue>
    /// Present only for Checked declarations. The batch saves package values'
    /// schemes so later declarations can use their inferred types.
    scheme: Stdlib.Option.Option<Model.Scheme> }

/// Wrap a type in a scheme without making any of its unknowns generic.
/// Those unknowns must be resolved before the declaration can be Checked.
let monomorphic (t: Model.Ty) : Model.Scheme =
  Model.Scheme { quantified = []; typ = t; constraints = [] }

/// Report an error encountered while running the checker as an Incomplete result.
/// Attach the warning to at when a source node is available, and return no scheme.
let checkerFailureOutcome
  (at: Stdlib.Option.Option<Int64>)
  (failure: CheckFailure)
  : Outcome =
  Outcome
    { verdict = Verdict.Incomplete
      diagnostics = []
      warnings =
        [ failureIssue (Stdlib.Option.map at (fun id -> toUInt64 id)) failure ]
      scheme = Stdlib.Option.Option.None }

/// Catch errors from checking one declaration so the rest of the batch can continue.
/// On failure, return Incomplete and keep the environment from before this check.
let guardItem
  (at: Stdlib.Option.Option<Int64>)
  (env: Model.Environment)
  (check: Model.Environment -> (Outcome * Model.Environment))
  : (Outcome * Model.Environment) =
  match guard check env with
  | Ok result -> result
  | Error failure -> (checkerFailureOutcome at failure, env)


// --------------------
// Turn solver findings into reported issues and a verdict.
// --------------------

/// Convert the checker's signed node ID to the report's UInt64 representation.
/// For negative IDs, add 2^64 to preserve the original 64-bit identifier.
let toUInt64 (id: Int64) : UInt64 =
  let n = Stdlib.Int.fromInt64 id
  let unsigned = if n < 0 then n + 18446744073709551616 else n
  Builtin.unwrap (Stdlib.Int.toUInt64 unsigned)

/// Convert a finding to the public report format, replacing type unknowns with
/// any types the solver determined before formatting expected and actual types.
let toIssue (s: Solve.State) (finding: Model.Finding) : Issue =
  let staticType (t: Model.Ty) : StaticType = Types.toStatic (Solve.zonk s t)

  Issue
    { code = finding.code
      nodeId = Stdlib.Option.map finding.at (fun id -> toUInt64 id)
      expected = Stdlib.Option.map finding.expected staticType
      actual = Stdlib.Option.map finding.actual staticType
      context = finding.context }

/// Check match coverage after type inference and report gaps as warnings.
/// Skip a match if its input type contains an error or its patterns already have
/// findings, since those problems can make coverage warnings misleading.
let checkCoverage (s: Solve.State) : Solve.State =
  let nodesWithFindings =
    Stdlib.List.fold s.findings Dict {} (fun ids finding ->
      match finding.at with
      | Some id -> Stdlib.Dict.setOverridingDuplicates ids id true
      | None -> ids)

  Stdlib.List.fold (Stdlib.List.reverse s.coverage) s (fun s c ->
    match c with
    | Covers(at, scrutinee, cases, ids) ->
      let scrutinee = Solve.zonk s scrutinee

      let skip =
        Types.hasError scrutinee
        || Stdlib.List.any ids (fun id ->
          Stdlib.Dict.``member`` nodesWithFindings id)

      if skip then
        s
      else
        match Coverage.uncovered s.env s.subst scrutinee cases with
        | None -> s
        | Some missing ->
          // Anything means coverage is incomplete but no specific example is
          // available. Omit the example while retaining the coverage warning.
          let witness =
            match missing with
            | Anything -> Stdlib.Option.Option.None
            | _ -> Stdlib.Option.Option.Some(Coverage.render missing)

          Solve.addFinding
            s
            (Types.warning
              IssueCode.NonExhaustiveMatch
              (Stdlib.Option.Option.Some at)
              (Context.UncoveredPattern witness))
    | _ -> s)

/// Finish deferred checks, classify findings, and decide the declaration's verdict.
/// Generic variables saved in the scheme may remain unknown. Other unknowns in
/// the declaration's type or an error's evidence prevent a complete check.
let finish
  (s: Solve.State)
  (itemAt: Stdlib.Option.Option<Int64>)
  (scheme: Model.Scheme)
  : Outcome =
  let s = checkCoverage (Solve.reportUnsolvedConstraints s)
  let findings = Stdlib.List.reverse s.findings

  // Quantified variables are intentionally generic, so they do not indicate
  // missing type information for this declaration.
  let unsolved (t: Model.Ty) : List<Model.Var> =
    (Stdlib.Dict.keys (Types.freeVars s.subst t))
    |> Stdlib.List.filter (fun v ->
      Stdlib.Bool.not (Stdlib.List.``member`` scheme.quantified v))

  // A definite error holds even if its displayed types still contain unknowns.
  // For other errors, unresolved expected or actual types leave the error uncertain.
  let unsolvedIn (finding: Model.Finding) : List<Model.Var> =
    if finding.definite then
      []
    else
      match (finding.expected, finding.actual) with
      | (None, None) -> []
      | _ ->
        let among (t: Stdlib.Option.Option<Model.Ty>) : List<Model.Var> =
          Stdlib.List.flatten (Stdlib.List.map (Stdlib.Option.toList t) unsolved)

        Stdlib.List.append (among finding.expected) (among finding.actual)

  let diagnostics =
    Stdlib.List.filter findings (fun f -> Stdlib.Bool.not (Types.isWarning f.code))

  // Report these unresolved types once per source node. Solver-created unknowns
  // have no source node of their own, so use the declaration's body node instead.
  let origins =
    (Stdlib.List.append
      (unsolved scheme.typ)
      (Stdlib.List.flatten (Stdlib.List.map diagnostics unsolvedIn)))
    |> Stdlib.List.map (fun v ->
      match v with
      | Of(id, _) -> Stdlib.Option.Option.Some id
      | Fresh _ -> itemAt)
    |> Stdlib.List.unique

  let ambiguities =
    Stdlib.List.map origins (fun origin ->
      Types.warning
        IssueCode.AmbiguousType
        origin
        (Context.Ambiguous AmbiguousSubject.ItemType))

  let warnings =
    Stdlib.List.append
      (Stdlib.List.filter findings (fun f -> Types.isWarning f.code))
      ambiguities

  // Errors that still depend on unknown types become warnings. Retain them even
  // when a separate, definite error makes the declaration Failed.
  let (diagnostics, provisional) =
    Stdlib.List.partition diagnostics (fun d -> Stdlib.List.isEmpty (unsolvedIn d))
  let warnings = Stdlib.List.append warnings provisional

  let verdict =
    if Stdlib.Bool.not (Stdlib.List.isEmpty diagnostics) then Verdict.Failed
    else if Stdlib.Bool.not (Stdlib.List.isEmpty warnings) then Verdict.Incomplete
    else Verdict.Checked

  // Save inferred types into the scheme before this declaration's solver state
  // is discarded. Later checks must not need its private substitution table.
  let checkedScheme =
    match verdict with
    | Checked ->
      Stdlib.Option.Option.Some({ scheme with typ = Solve.zonk s scheme.typ })
    | _ -> Stdlib.Option.Option.None

  Outcome
    { verdict = verdict
      diagnostics = Stdlib.List.map diagnostics (fun f -> toIssue s f)
      warnings = Stdlib.List.map warnings (fun f -> toIssue s f)
      scheme = checkedScheme }


// --------------------
// Check individual declarations.
// --------------------

/// Produce a declaration-wide error for each repeated name, using the supplied
/// issue code and context to distinguish type parameters from type members.
let duplicateProblems
  (names: List<String>)
  (site: DuplicateSite)
  (code: IssueCode)
  : Model.Constraint =
  Generate.all (
    Stdlib.List.map (Generate.duplicates names) (fun name ->
      Generate.report (
        Types.error
          code
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          Stdlib.Option.Option.None
          (Context.Duplicate(name, site))
      ))
  )

/// Check a function's declared signature and require its body to return that type.
/// Return any environment caches populated during the check for later declarations.
let checkFunction
  (env: Model.Environment)
  (fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : (Outcome * Model.Environment) =
  let none = Stdlib.Option.Option.None
  // Declared type parameters must stay generic while checking the body; choosing
  // a concrete type for one would accept a function that fails for other callers.
  let rigid = Types.rigid fn.typeParams

  let (parameters, parameterProblems) =
    Types.fromReferences rigid none (Stdlib.List.map fn.parameters (fun p -> p.typ))

  let (ret, returnProblems) = Types.fromReference rigid none fn.returnType
  let self = Model.Ty.TFn(parameters, ret)

  let locals =
    (Stdlib.List.zipShortest fn.parameters parameters)
    |> Stdlib.List.fold Dict {} (fun locals (p, t) ->
      Stdlib.Dict.setOverridingDuplicates locals p.name (Model.Binder.Mono t))

  // Named parameters and positional arguments use the signature's types. Self
  // calls use the same signature, and ? must agree with the declared return type.
  let scope =
    Generate.Scope
      { locals = locals
        arguments = parameters
        self = Stdlib.Option.Option.Some self
        typeVariables = rigid
        returns = Stdlib.Option.Option.Some ret }

  let constraints =
    Generate.all
      [ duplicateProblems
          fn.typeParams
          DuplicateSite.InFunctionSignature
          IssueCode.DuplicateTypeParameter
        Generate.reports parameterProblems
        Generate.reports returnProblems
        Model.Constraint.WellFormed(none, self)
        // Duplicate inference IDs can merge unrelated types. Report the problem
        // and skip the body, while still checking the signature above.
        (match NodeIds.problem fn.body with
         | Some problem -> Generate.report problem
         | None -> Generate.check scope ret Site.FunctionReturnValue fn.body) ]

  let s = Solve.solve (Solve.start env) constraints
  let bodyId = LanguageTools.ProgramTypes.Expr.toID fn.body
  (finish s (Stdlib.Option.Option.Some bodyId) (monomorphic self), s.env)

/// Solve the requirements prepared for a package value and infer its type.
/// Allow a reusable generic type only for bodies accepted by isNonExpansive,
/// such as literals and lambdas. Results of calls must have one resolved type.
let checkValue
  (env: Model.Environment)
  (value: LanguageTools.ProgramTypes.PackageValue.PackageValue)
  (typ: Model.Ty)
  (constraints: Model.Constraint)
  : (Outcome * Model.Environment) =
  let s = Solve.solve (Solve.start env) constraints

  let (scheme, s) =
    if Generate.isNonExpansive value.body then
      Solve.schemeFor s typ []
    else
      (monomorphic typ, s)

  let bodyId = LanguageTools.ProgramTypes.Expr.toID value.body
  (finish s (Stdlib.Option.Option.Some bodyId) scheme, s.env)

/// Check duplicate type parameters and member names, then include validation
/// problems from this type declaration and the declarations it depends on.
let checkType (env: Model.Environment) (packageType: LanguageTools.ProgramTypes.PackageType.PackageType) : Outcome =
  let none = Stdlib.Option.Option.None
  let decl = packageType.declaration

  let memberNames =
    match decl.definition with
    | Alias _ -> []
    | Record fields -> Stdlib.List.map fields (fun f -> f.name)
    | Enum cases -> Stdlib.List.map cases (fun c -> c.name)

  let (closure, _) = Declarations.declarationProblemsFor env packageType.hash
  let found = Stdlib.List.reverse closure

  let constraints =
    Generate.all
      [ duplicateProblems
          decl.typeParams
          DuplicateSite.InTypeDeclaration
          IssueCode.DuplicateTypeParameter
        duplicateProblems
          memberNames
          DuplicateSite.InTypeDeclaration
          IssueCode.DuplicateTypeMember
        Generate.reports (Stdlib.List.reverse found) ]

  let s = Solve.solve (Solve.start env) constraints
  // A type declaration has no expression type to infer. Supply Unit so finish
  // can classify its findings without introducing an unknown result type.
  finish s none (monomorphic Model.Ty.TUnit)


// --------------------
// Prepare declarations and check package values in dependency order.
// --------------------

/// Make a type declaration available by hash before checking references to it.
let addType (env: Model.Environment) (t: LanguageTools.ProgramTypes.PackageType.PackageType) : Model.Environment =
  { env with
      types = Stdlib.Dict.setOverridingDuplicates env.types t.hash t.declaration }

/// Make the declared signature available before checking function bodies, so
/// callers and recursive functions can be checked regardless of their list order.
let addFunctionSignature
  (env: Model.Environment)
  (fn: LanguageTools.ProgramTypes.PackageFn.PackageFn)
  : Model.Environment =
  let signature =
    Model.Signature
      { typeParams = fn.typeParams
        parameters = Stdlib.List.map fn.parameters (fun p -> p.typ)
        returnType = fn.returnType
        needsTypeArgs = false }

  { env with
      functions =
        Stdlib.Dict.setOverridingDuplicates
          env.functions
          (LanguageTools.ProgramTypes.FQFnName.FQFnName.Package fn.hash)
          signature }

/// Collect package-value references recorded in these requirements, including
/// nested All groups. Builtin values do not need to be scheduled with the batch.
let valueDependencies (c: Model.Constraint) : List<LanguageTools.ProgramTypes.Hash> =
  match c with
  | All constraints ->
    Stdlib.List.flatten (Stdlib.List.map constraints valueDependencies)
  | UseValue(_, name, _) ->
    match name with
    | Package hash -> [ hash ]
    | Builtin _ -> []
  | _ -> []

/// A value whose body has been inspected but whose type requirements still need
/// solving. Save those requirements so waiting for dependencies does not repeat
/// the syntax walk.
type PendingValue =
  { value: LanguageTools.ProgramTypes.PackageValue.PackageValue
    typ: Model.Ty
    constraints: Model.Constraint
    /// Distinct package-value hashes referenced by the generated requirements.
    uses: List<LanguageTools.ProgramTypes.Hash> }

/// Use the body's root node as the location for findings about the whole value
/// or function, including errors encountered while running the checker.
let bodyNodeId
  (body: LanguageTools.ProgramTypes.Expr)
  : Stdlib.Option.Option<Int64> =
  Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.Expr.toID body)

/// Infer an initial type and requirements from a value's syntax without solving
/// them yet. If inference IDs are duplicated, record that problem and skip inference.
let prepareValue
  (value: LanguageTools.ProgramTypes.PackageValue.PackageValue)
  : PendingValue =
  let (t, constraints) =
    match NodeIds.problem value.body with
    | Some problem -> (Model.Ty.TError, Generate.report problem)
    | None ->
      // Too deep is skipped here for the same reason duplicate IDs are: inferring would
      // produce a requirement per level, and the result could not be trusted anyway.
      match NodeIds.tooDeep value.body with
      | Some problem -> (Model.Ty.TError, Generate.report problem)
      | None -> Generate.infer (Generate.emptyScope ()) value.body

  PendingValue
    { value = value
      typ = t
      constraints = constraints
      uses = Stdlib.List.unique (valueDependencies constraints) }

/// Prepare each value, then check dependencies before values that use them.
/// Check dependency cycles last; missing inferred types prevent a Checked verdict.
let checkValues
  (env: Model.Environment)
  (values: List<LanguageTools.ProgramTypes.PackageValue.PackageValue>)
  : (Model.Environment * Dict<LanguageTools.ProgramTypes.Hash, Outcome>) =
  // A failure while inspecting one body must not stop preparation of the others.
  // Record Incomplete without a scheme, so its users cannot assume a valid type.
  let (pending, outcomes) =
    Stdlib.List.fold values ([], Dict {}) (fun (pending, outcomes) value ->
      match guard prepareValue value with
      | Ok p -> (Stdlib.List.push pending p, outcomes)
      | Error failure ->
        let outcome = checkerFailureOutcome (bodyNodeId value.body) failure
        (pending, Stdlib.Dict.setOverridingDuplicates outcomes value.hash outcome))

  checkPendingValues env outcomes (Stdlib.List.reverse pending)

/// Check values whose dependencies are no longer pending and save successful
/// type schemes for later values. Continue until every pending value has an outcome.
let checkPendingValues
  (env: Model.Environment)
  (outcomes: Dict<LanguageTools.ProgramTypes.Hash, Outcome>)
  (pending: List<PendingValue>)
  : (Model.Environment * Dict<LanguageTools.ProgramTypes.Hash, Outcome>) =
  if Stdlib.List.isEmpty pending then
    (env, outcomes)
  else
    let pendingHashes =
      Stdlib.List.fold pending Dict {} (fun waiting p ->
        Stdlib.Dict.setOverridingDuplicates waiting p.value.hash true)

    // Wait only for other values still in this batch. A self-reference cannot
    // become available by waiting; references with no usable scheme are reported
    // during checking, including missing or unsuccessful dependencies.
    let (ready, blocked) =
      Stdlib.List.partition pending (fun p ->
        Stdlib.List.all p.uses (fun h ->
          h == p.value.hash
          || Stdlib.Bool.not (Stdlib.Dict.``member`` pendingHashes h)))

    // If none are ready, the remaining dependencies contain a cycle. Check all
    // remaining values with the schemes available so far instead of waiting forever.
    let (checkNow, later) =
      if Stdlib.List.isEmpty ready then (blocked, []) else (ready, blocked)

    let (env, outcomes) =
      Stdlib.List.fold checkNow (env, outcomes) (fun (env, outcomes) p ->
        let (outcome, env) =
          guardItem (bodyNodeId p.value.body) env (fun env ->
            checkValue env p.value p.typ p.constraints)

        // Only Checked outcomes provide a scheme. An incomplete or failed value
        // must not supply an assumed type to declarations that reference it.
        let env =
          match outcome.scheme with
          | Some scheme ->
            let values =
              Stdlib.Dict.setOverridingDuplicates env.values p.value.hash scheme
            { env with values = values }
          | None -> env

        (env, Stdlib.Dict.setOverridingDuplicates outcomes p.value.hash outcome))

    checkPendingValues env outcomes later

/// Check the supplied declarations using env for dependencies outside this batch.
/// Register all types and function signatures first, then infer package values
/// before checking function bodies that may reference them. Return results grouped
/// as types, values, and functions, preserving the supplied order within each group.
let checkBatch
  (env: Model.Environment)
  (types: List<LanguageTools.ProgramTypes.PackageType.PackageType>)
  (values: List<LanguageTools.ProgramTypes.PackageValue.PackageValue>)
  (fns: List<LanguageTools.ProgramTypes.PackageFn.PackageFn>)
  : List<(LanguageTools.ProgramTypes.Reference * Outcome)> =
  let env = Stdlib.List.fold types env (fun env t -> addType env t)
  let env = Stdlib.List.fold fns env (fun env fn -> addFunctionSignature env fn)
  let env = Declarations.prepareDeclarations env

  let typeResults =
    Stdlib.List.map types (fun t ->
      let (outcome, _) =
        guardItem Stdlib.Option.Option.None env (fun env -> (checkType env t, env))

      (LanguageTools.ProgramTypes.Reference.PackageType t.hash, outcome))

  let (env, valueOutcomes) = checkValues env values

  let valueResults =
    Stdlib.List.filterMap values (fun v ->
      (Stdlib.Dict.get valueOutcomes v.hash)
      |> Stdlib.Option.map (fun outcome ->
        (LanguageTools.ProgramTypes.Reference.PackageValue v.hash, outcome)))

  let (_, fnResults) =
    Stdlib.List.fold fns (env, []) (fun (env, results) fn ->
      let signatureTypes =
        Stdlib.List.push
          (Stdlib.List.map fn.parameters (fun p -> p.typ))
          fn.returnType

      let (outcome, env) =
        // Refused before inference rather than during it. `checkFunction` would otherwise
        // generate a requirement per level of the body and then solve all of them, and
        // converting a deep signature to the checker's own types costs the same whether or
        // not anything ever compares it.
        match NodeIds.tooDeep fn.body with
        | Some _ ->
          (checkerFailureOutcome (bodyNodeId fn.body) CheckFailure.TooDeep, env)
        | None ->
          match NodeIds.typeTooDeep signatureTypes with
          | Some _ ->
            (checkerFailureOutcome (bodyNodeId fn.body) CheckFailure.TooDeep, env)
          | None -> guardItem (bodyNodeId fn.body) env (fun env -> checkFunction env fn)
      let item = LanguageTools.ProgramTypes.Reference.PackageFn fn.hash
      (env, Stdlib.List.push results (item, outcome)))

  Stdlib.List.flatten [ typeResults, valueResults, Stdlib.List.reverse fnResults ]
