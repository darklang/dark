/// Supply builtin metadata and load the package declarations needed for checking.
/// Read package dependencies by content hash and inspect their syntax and declared
/// types without executing their code. Builtin metadata is fetched as needed.
module Darklang.LanguageTools.AtRestTypeChecker.Environment

// --------------------
// Convert builtin metadata into the types used by the checker.
// --------------------

/// Read the package type's hash stored in a record or enum value.
/// Used to identify the standard Option and Result types from actual values.
/// Return an empty hash for values that are neither package records nor enums.
let typeHashOf (value: 'a) : LanguageTools.ProgramTypes.Hash =
  match LanguageTools.RuntimeTypes.reflect value with
  | DEnum(Package hash, _, _, _, _) -> hash
  | DRecord(Package hash, _, _, _) -> hash
  | _ -> LanguageTools.ProgramTypes.Hash.Hash ""

/// Convert a builtin's runtime type metadata to the type-reference format used
/// by package declarations. Preserve type arguments, names, and resolution errors;
/// runtime metadata provides no source location for resolved package types.
let fromRuntimeType
  (typ: LanguageTools.RuntimeTypes.TypeReference)
  : LanguageTools.ProgramTypes.TypeReference =
  match typ with
  | TUnit -> LanguageTools.ProgramTypes.TypeReference.TUnit
  | TBool -> LanguageTools.ProgramTypes.TypeReference.TBool
  | TInt8 -> LanguageTools.ProgramTypes.TypeReference.TInt8
  | TUInt8 -> LanguageTools.ProgramTypes.TypeReference.TUInt8
  | TInt16 -> LanguageTools.ProgramTypes.TypeReference.TInt16
  | TUInt16 -> LanguageTools.ProgramTypes.TypeReference.TUInt16
  | TInt32 -> LanguageTools.ProgramTypes.TypeReference.TInt32
  | TUInt32 -> LanguageTools.ProgramTypes.TypeReference.TUInt32
  | TInt64 -> LanguageTools.ProgramTypes.TypeReference.TInt64
  | TUInt64 -> LanguageTools.ProgramTypes.TypeReference.TUInt64
  | TInt128 -> LanguageTools.ProgramTypes.TypeReference.TInt128
  | TUInt128 -> LanguageTools.ProgramTypes.TypeReference.TUInt128
  | TInt -> LanguageTools.ProgramTypes.TypeReference.TInt
  | TFloat -> LanguageTools.ProgramTypes.TypeReference.TFloat
  | TChar -> LanguageTools.ProgramTypes.TypeReference.TChar
  | TString -> LanguageTools.ProgramTypes.TypeReference.TString
  | TUuid -> LanguageTools.ProgramTypes.TypeReference.TUuid
  | TDateTime -> LanguageTools.ProgramTypes.TypeReference.TDateTime
  | TBlob -> LanguageTools.ProgramTypes.TypeReference.TBlob
  | TStream inner ->
    LanguageTools.ProgramTypes.TypeReference.TStream(fromRuntimeType inner)
  | TList inner ->
    LanguageTools.ProgramTypes.TypeReference.TList(fromRuntimeType inner)
  | TDB inner -> LanguageTools.ProgramTypes.TypeReference.TDB(fromRuntimeType inner)
  | TTuple(first, second, rest) ->
    LanguageTools.ProgramTypes.TypeReference.TTuple(
      fromRuntimeType first,
      fromRuntimeType second,
      Stdlib.List.map rest (fun t -> fromRuntimeType t)
    )
  | TDict(key, value) ->
    LanguageTools.ProgramTypes.TypeReference.TDict(
      fromRuntimeType key, fromRuntimeType value
    )
  | TFn(parameters, ret) ->
    LanguageTools.ProgramTypes.TypeReference.TFn(
      Stdlib.List.map parameters (fun t -> fromRuntimeType t),
      fromRuntimeType ret
    )
  | TVariable name -> LanguageTools.ProgramTypes.TypeReference.TVariable name
  | TCustomType(name, args) ->
    let resolved =
      match name.resolved with
      | Ok(Package hash) ->
        Stdlib.Result.Result.Ok(
          LanguageTools.ProgramTypes.ResolvedName
            { name = LanguageTools.ProgramTypes.FQTypeName.FQTypeName.Package hash
              location = Stdlib.Option.Option.None }
        )
      | Error NotFound ->
        Stdlib.Result.Result.Error
          LanguageTools.ProgramTypes.NameResolutionError.NotFound
      | Error InvalidName ->
        Stdlib.Result.Result.Error
          LanguageTools.ProgramTypes.NameResolutionError.InvalidName

    LanguageTools.ProgramTypes.TypeReference.TCustomType(
      LanguageTools.ProgramTypes.NameResolution
        { originalName = name.originalName; resolved = resolved },
      Stdlib.List.map args (fun t -> fromRuntimeType t)
    )

/// Collect type-variable names from a runtime type, including nested components.
/// Repeated occurrences remain in the list; builtinCallable removes duplicates
/// when adding undeclared parameters to the signature.
let runtimeVariables (typ: LanguageTools.RuntimeTypes.TypeReference) : List<String> =
  match typ with
  | TVariable name -> [ name ]
  | TStream inner -> runtimeVariables inner
  | TList inner -> runtimeVariables inner
  | TDB inner -> runtimeVariables inner
  | TDict(key, value) ->
    Stdlib.List.append (runtimeVariables key) (runtimeVariables value)
  | TTuple(first, second, rest) ->
    Stdlib.List.flatten
      (Stdlib.List.map (Stdlib.List.append [ first, second ] rest) runtimeVariables)
  | TFn(parameters, ret) ->
    Stdlib.List.flatten
      (Stdlib.List.map (Stdlib.List.push parameters ret) runtimeVariables)
  | TCustomType(_, args) ->
    Stdlib.List.flatten (Stdlib.List.map args runtimeVariables)
  | _ -> []

/// Convert a declared signature into a template that callers can reuse.
/// Keep generic parameters as named TRigid types for substitution at each use,
/// and save validation problems to report at the calls that rely on this signature.
/// Return any declaration-validation caches populated along the way.
let signatureTemplate
  (env: Model.Environment)
  (signature: Model.Signature)
  : (Model.Callable * Model.Environment) =
  let none = Stdlib.Option.Option.None
  let mapping = Types.rigid signature.typeParams
  let (parameters, found) = Types.fromReferencesInto mapping none [] signature.parameters
  let (ret, found) = Types.fromReferenceInto mapping none found signature.returnType
  let (found, env) =
    Declarations.validateType env none found (Model.Ty.TFn(parameters, ret))

  (Model.Callable.Declared(
    Model.Template
      { typeParams = signature.typeParams
        parameters = parameters
        returnType = ret
        needsTypeArgs = signature.needsTypeArgs
        dictKeyTypes = Declarations.dictKeyTypes env (Model.Ty.TFn(parameters, ret))
        problems = Stdlib.List.reverse found }
   ),
   env)

/// Decide whether a builtin's metadata supplies a usable signature and convert it.
/// A type variable appearing only in the return type needs an explicit type
/// argument, as in jsonParse<'a>. If it is not declared as a type parameter,
/// mark the builtin Untrusted because its result type cannot be determined safely.
let builtinCallable
  (env: Model.Environment)
  (fn: LanguageTools.BuiltinFunction)
  : (Model.Callable * Model.Environment) =
  let parameterTypes = Stdlib.List.map fn.parameters (fun p -> p.``type``)

  let parameterVariables =
    Stdlib.List.flatten (Stdlib.List.map parameterTypes runtimeVariables)

  let returnVariables = runtimeVariables fn.returnType

  let resultOnly =
    Stdlib.List.filter returnVariables (fun v ->
      Stdlib.Bool.not (Stdlib.List.``member`` parameterVariables v))

  let resultOnlyDeclared =
    Stdlib.List.all resultOnly (fun v -> Stdlib.List.``member`` fn.typeParams v)

  if Stdlib.List.isEmpty parameterTypes then
    // The checker does not support builtin signatures with no parameters.
    (Model.Callable.Unavailable, env)
  else if resultOnlyDeclared then
    // Older builtins omit some type parameters from their metadata. Add the
    // missing names so argument types can determine them. The check above has
    // already rejected undeclared variables that appear only in the return type.
    let undeclared =
      (Stdlib.List.append parameterVariables returnVariables)
      |> Stdlib.List.unique
      |> Stdlib.List.filter (fun v ->
        Stdlib.Bool.not (Stdlib.List.``member`` fn.typeParams v))

    signatureTemplate
      env
      (Model.Signature
        { typeParams = Stdlib.List.append fn.typeParams undeclared
          parameters = Stdlib.List.map parameterTypes (fun t -> fromRuntimeType t)
          returnType = fromRuntimeType fn.returnType
          needsTypeArgs = Stdlib.Bool.not (Stdlib.List.isEmpty resultOnly) })
  else
    (Model.Callable.Untrusted UntrustedBuiltin.ResultTypeUnconstrained, env)

/// Look up a package signature in env or fetch one builtin's metadata, then
/// convert it for checking. Return Unavailable if the signature cannot be found.
/// Solve.callableFor caches the result, including unavailable or untrusted signatures.
let resolveCallable
  (env: Model.Environment)
  (fn: LanguageTools.ProgramTypes.FQFnName.FQFnName)
  : (Model.Callable * Model.Environment) =
  match fn with
  | Package _ ->
    match Stdlib.Dict.get env.functions fn with
    | Some signature -> signatureTemplate env signature
    | None -> (Model.Callable.Unavailable, env)
  | Builtin name ->
    match LanguageTools.findBuiltinFn name.name name.version with
    | Some builtin -> builtinCallable env builtin
    | None -> (Model.Callable.Unavailable, env)
  // A trait method call (`Show.show v`), whose signature is the TRAIT's rather than any one
  // implementation's. The trait's first type param is the self type and stays rigid here, so
  // inference unifies it with the argument the caller passes: that is what decides which type
  // the call is for, and the implementation is chosen from it afterwards.
  | TraitMethod method ->
    match LanguageTools.PackageManager.Trait.get method.trait_ with
    | None -> (Model.Callable.Unavailable, env)
    | Some trait_ ->
      match
        trait_.methods
        |> Stdlib.List.findFirst (fun m -> m.name == method.method_)
      with
      | None -> (Model.Callable.Unavailable, env)
      | Some declared ->
        signatureTemplate
          env
          (Model.Signature
            { // The trait's params first, self among them, then the method's own.
              typeParams =
                Stdlib.List.append trait_.typeParams declared.typeParams
              parameters =
                declared.parameters |> Stdlib.List.map (fun p -> p.typ)
              returnType = declared.returnType
              // The self type comes from the argument, not from a type argument the
              // caller has to write.
              needsTypeArgs = false })

/// Fetch one builtin value's declared type and convert it to a package-style type
/// reference. Return None for missing builtins or package values, whose types
/// must instead be inferred from their bodies.
let builtinValueType
  (name: LanguageTools.ProgramTypes.FQValueName.FQValueName)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.TypeReference> =
  match name with
  | Builtin name ->
    (LanguageTools.findBuiltinValue name.name name.version)
    |> Stdlib.Option.map (fun value -> fromRuntimeType value.``type``)
  | Package _ -> Stdlib.Option.Option.None

/// A runtime type reference as the checker's own type, for comparing against one it inferred.
///
/// Findings are discarded on purpose: a type variable in an implementation's self type
/// (`impl Add for List<'a>`) has no mapping here and converts to a placeholder, which is
/// correct, because the only question asked of the result is what its HEAD is.
let tyOfRuntimeType (typ: LanguageTools.RuntimeTypes.TypeReference) : Model.Ty =
  let (ty, _) =
    Types.fromReference (Dict {}) (Stdlib.Option.Option.None) (fromRuntimeType typ)

  ty

/// A cache key for an operator. Spelled out rather than borrowed from the pretty printer,
/// which the checker has no business depending on.
let infixKey (operation: LanguageTools.ProgramTypes.InfixFnName) : String =
  match operation with
  | ArithmeticPlus -> "+"
  | ArithmeticMinus -> "-"
  | ArithmeticMultiply -> "*"
  | ArithmeticDivide -> "/"
  | ArithmeticModulo -> "%"
  | ArithmeticPower -> "^"
  | BitwiseAnd -> "&&&"
  | BitwiseOr -> "|||"
  | BitwiseXor -> "^^^"
  | ShiftLeft -> "<<"
  | ShiftRight -> ">>"
  | ComparisonGreaterThan -> ">"
  | ComparisonGreaterThanOrEqual -> ">="
  | ComparisonLessThan -> "<"
  | ComparisonLessThanOrEqual -> "<="
  | ComparisonEquals -> "=="
  | ComparisonNotEquals -> "!="
  | StringConcat -> "++"

/// Every operator, so the cache below can be filled without waiting to meet one.
let allInfixOperations () : List<LanguageTools.ProgramTypes.InfixFnName> =
  [ LanguageTools.ProgramTypes.InfixFnName.ArithmeticPlus
    LanguageTools.ProgramTypes.InfixFnName.ArithmeticMinus
    LanguageTools.ProgramTypes.InfixFnName.ArithmeticMultiply
    LanguageTools.ProgramTypes.InfixFnName.ArithmeticDivide
    LanguageTools.ProgramTypes.InfixFnName.ArithmeticModulo
    LanguageTools.ProgramTypes.InfixFnName.ArithmeticPower
    LanguageTools.ProgramTypes.InfixFnName.BitwiseAnd
    LanguageTools.ProgramTypes.InfixFnName.BitwiseOr
    LanguageTools.ProgramTypes.InfixFnName.BitwiseXor
    LanguageTools.ProgramTypes.InfixFnName.ShiftLeft
    LanguageTools.ProgramTypes.InfixFnName.ShiftRight
    LanguageTools.ProgramTypes.InfixFnName.ComparisonGreaterThan
    LanguageTools.ProgramTypes.InfixFnName.ComparisonGreaterThanOrEqual
    LanguageTools.ProgramTypes.InfixFnName.ComparisonLessThan
    LanguageTools.ProgramTypes.InfixFnName.ComparisonLessThanOrEqual
    LanguageTools.ProgramTypes.InfixFnName.ComparisonEquals
    LanguageTools.ProgramTypes.InfixFnName.ComparisonNotEquals
    LanguageTools.ProgramTypes.InfixFnName.StringConcat ]

/// Every visible trait's implementations, self types converted to the checker's own.
///
/// Taken for the whole batch up front. See `Model.Environment.traitImpls` for why that is
/// the point rather than an optimisation.
let traitImpls (branchId: Uuid) : Dict<String, List<(Model.Ty * LanguageTools.ProgramTypes.Hash)>> =
  let query =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = []
        text = ""
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Trait ]
        exactMatch = false }

  (LanguageTools.PackageManager.Search.search branchId query).traits
  |> Stdlib.List.fold (Dict {}) (fun acc t ->
    let converted =
      (LanguageTools.PackageManager.Trait.impls branchId t.entity.hash)
      |> Stdlib.List.map (fun candidate ->
        ((tyOfRuntimeType candidate.self), candidate.source))

    Stdlib.Dict.setOverridingDuplicates
      acc
      (LanguageTools.ProgramTypes.hashToString t.entity.hash)
      converted)

/// Which trait and method each operator is. One table, in F#, shared with the lowering, so
/// the checker and the runtime cannot come to disagree about what `+` means.
let infixTrait
  (branchId: Uuid)
  : Dict<String, Stdlib.Option.Option<(LanguageTools.ProgramTypes.Hash * String)>> =
  (allInfixOperations ())
  |> Stdlib.List.fold (Dict {}) (fun acc operation ->
    let found =
      match LanguageTools.PackageManager.Trait.forInfix branchId operation with
      | None -> Stdlib.Option.Option.None
      | Some((traitHash, method_, _)) ->
        Stdlib.Option.Option.Some((traitHash, method_))

    Stdlib.Dict.setOverridingDuplicates acc (infixKey operation) found)

/// The implementations of <param traitHash> that this batch knows about.
let implsOfTrait
  (env: Model.Environment)
  (traitHash: LanguageTools.ProgramTypes.Hash)
  : List<(Model.Ty * LanguageTools.ProgramTypes.Hash)> =
  match
    Stdlib.Dict.get env.traitImpls (LanguageTools.ProgramTypes.hashToString traitHash)
  with
  | Some impls -> impls
  | None -> []

/// The trait and method an operator is, and that trait's implementations.
let infixImplsFor
  (env: Model.Environment)
  (operation: LanguageTools.ProgramTypes.InfixFnName)
  : Stdlib.Option.Option<(LanguageTools.ProgramTypes.Hash * String * List<(Model.Ty * LanguageTools.ProgramTypes.Hash)>)> =
  match Stdlib.Dict.get env.infixTrait (infixKey operation) with
  | Some(Some((traitHash, method_))) ->
    Stdlib.Option.Option.Some(
      (traitHash, method_, implsOfTrait env traitHash)
    )
  | _ -> Stdlib.Option.Option.None

/// Create an empty environment with the standard Option and Result type hashes.
/// Declarations are loaded later; builtin signatures are fetched as needed and
/// their converted templates are cached when the solver first uses them.
let builtins (branchId: Uuid) : Model.Environment =
  Model.Environment
    { branchId = branchId
      types = Dict {}
      functions = Dict {}
      values = Dict {}
      declarationFacts = Dict {}
      traitImpls = traitImpls branchId
      infixTrait = infixTrait branchId
      valueTypeParameters = Dict {}
      dictKeyParameters = Dict {}
      callables = Dict {}
      declarationProblems = Dict {}
      optionType = typeHashOf Stdlib.Option.Option.None
      resultType = typeHashOf (Stdlib.Result.Result.Ok ()) }


// --------------------
// Find package dependencies in names, types, and expression syntax.
// --------------------

/// Return the package reference for a resolved type name. Unresolved names add
/// no dependency here; type checking reports their resolution errors separately.
let typeNameRefs
  (name: LanguageTools.ProgramTypes.NameResolution<LanguageTools.ProgramTypes.FQTypeName.FQTypeName>)
  : List<LanguageTools.ProgramTypes.Reference> =
  match Types.resolvedType name with
  | Some hash -> [ LanguageTools.ProgramTypes.Reference.PackageType hash ]
  | None -> []

/// Find the package declarations needed to check a function reference.
/// A package function contributes its own reference; a builtin contributes the
/// package types in its signature, or those required by its special checking rule.
let functionNameRefs
  (env: Model.Environment)
  (name: LanguageTools.ProgramTypes.NameResolution<LanguageTools.ProgramTypes.FQFnName.FQFnName>)
  : List<LanguageTools.ProgramTypes.Reference> =
  match name.resolved with
  | Ok resolved ->
    match resolved.name with
    | Package hash -> [ LanguageTools.ProgramTypes.Reference.PackageFn hash ]
    | Builtin builtinName ->
      if builtinName.name == "unwrap" then
        // unwrap's generic signature does not mention Option or Result. Load
        // both declarations so its special typing rule can recognize their cases
        // when inferring types from unwrap calls and enum patterns.
        [ LanguageTools.ProgramTypes.Reference.PackageType env.optionType
          LanguageTools.ProgramTypes.Reference.PackageType env.resultType ]
      else
        match LanguageTools.findBuiltinFn builtinName.name builtinName.version with
        | Some builtin ->
          (Stdlib.List.push (Stdlib.List.map builtin.parameters (fun p -> p.``type``)) builtin.returnType)
          |> Stdlib.List.map (fun t -> fromRuntimeType t)
          |> typeListRefs
        | None -> []
    // A trait method call needs the TRAIT, which is where its signature lives. Not the
    // implementation: which one applies is decided from the self type after inference, and an
    // implementation is not needed to type the call.
    | TraitMethod method ->
      [ LanguageTools.ProgramTypes.Reference.PackageTrait method.trait_ ]
  | Error _ -> []

/// Find the package declarations needed to check a value reference: the value
/// itself for a package value, or the package types in a builtin value's metadata.
let valueNameRefs
  (name: LanguageTools.ProgramTypes.NameResolution<LanguageTools.ProgramTypes.FQValueName.FQValueName>)
  : List<LanguageTools.ProgramTypes.Reference> =
  match name.resolved with
  | Ok resolved ->
    match resolved.name with
    | Package hash -> [ LanguageTools.ProgramTypes.Reference.PackageValue hash ]
    | Builtin _ ->
      match builtinValueType resolved.name with
      | Some typ -> typeRefs typ
      | None -> []
  | Error _ -> []

/// Collect resolved package-type references throughout a type, including type
/// arguments and function components. Loading follows these references later;
/// this walk does not fetch declarations or remove duplicate references.
let typeRefs (typ: LanguageTools.ProgramTypes.TypeReference) : List<LanguageTools.ProgramTypes.Reference> =
  match typ with
  | TStream inner -> typeRefs inner
  | TList inner -> typeRefs inner
  | TDB inner -> typeRefs inner
  | TDict(key, value) -> Stdlib.List.append (typeRefs key) (typeRefs value)
  | TTuple(first, second, rest) ->
    Stdlib.List.flatten
      (Stdlib.List.map (Stdlib.List.append [ first, second ] rest) typeRefs)
  | TFn(parameters, ret) ->
    Stdlib.List.flatten (Stdlib.List.map (Stdlib.List.push parameters ret) typeRefs)
  | TCustomType(name, args) ->
    Stdlib.List.append
      (typeNameRefs name)
      (Stdlib.List.flatten (Stdlib.List.map args typeRefs))
  | _ -> []

/// Collect package-type references from all the supplied types into one list.
let typeListRefs
  (typs: List<LanguageTools.ProgramTypes.TypeReference>)
  : List<LanguageTools.ProgramTypes.Reference> =
  Stdlib.List.flatten (Stdlib.List.map typs typeRefs)

/// Collect references from an alias's target, a record's field types, or an enum's
/// case payload types, so loading can follow the declaration's dependencies.
let declarationRefs
  (decl: LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration)
  : List<LanguageTools.ProgramTypes.Reference> =
  typeListRefs (Types.declarationFieldTypes decl)

/// Walk an expression's syntax to collect package dependencies without evaluating it.
/// Visit lambda bodies, both sides of conditionals, and every match guard and body,
/// since checking needs their declarations even when execution might skip them.
let exprRefs
  (env: Model.Environment)
  (expr: LanguageTools.ProgramTypes.Expr)
  : List<LanguageTools.ProgramTypes.Reference> =
  let many (exprs: List<LanguageTools.ProgramTypes.Expr>) : List<LanguageTools.ProgramTypes.Reference> =
    Stdlib.List.flatten (Stdlib.List.map exprs (fun e -> exprRefs env e))

  match expr with
  | EString(_, segments) ->
    segments
    |> Stdlib.List.map (fun segment ->
      match segment with
      | StringText _ -> []
      | StringInterpolation e -> exprRefs env e)
    |> Stdlib.List.flatten
  | EList(_, elements) -> many elements
  | EDict(_, entries) ->
    Stdlib.List.flatten (Stdlib.List.map entries (fun (k, v) -> many [ k, v ]))
  | ETuple(_, first, second, rest) ->
    many (Stdlib.List.append [ first, second ] rest)
  | ERecord(_, name, typeArgs, fields) ->
    Stdlib.List.flatten
      [ typeNameRefs name
        typeListRefs typeArgs
        many (Stdlib.List.map fields (fun (_, v) -> v)) ]
  | EEnum(_, name, typeArgs, _, fields) ->
    Stdlib.List.flatten [ typeNameRefs name, typeListRefs typeArgs, many fields ]
  | ELet(_, _, value, body) -> many [ value, body ]
  | ERecordFieldAccess(_, record, _) -> exprRefs env record
  | EValue(_, name) -> valueNameRefs name
  | EIf(_, condition, thenExpr, elseExpr) ->
    many
      (Stdlib.List.append [ condition, thenExpr ] (Stdlib.Option.toList elseExpr))
  | EMatch(_, arg, cases) ->
    // Match patterns contain unqualified case names, not package references.
    // Their enum declarations are determined from the matched value's type.
    Stdlib.List.append
      (exprRefs env arg)
      (cases
       |> Stdlib.List.map (fun case ->
         many
           (Stdlib.List.append
             (Stdlib.Option.toList case.whenCondition)
             [ case.rhs ]))
       |> Stdlib.List.flatten)
  | EPipe(_, lhs, parts) ->
    Stdlib.List.append
      (exprRefs env lhs)
      (Stdlib.List.flatten (Stdlib.List.map parts (fun p -> pipeRefs env p)))
  | EInfix(_, _, lhs, rhs, _) -> many [ lhs, rhs ]
  | ELambda(_, _, body) -> exprRefs env body
  | EApply(_, callee, typeArgs, args) ->
    Stdlib.List.flatten [ exprRefs env callee, typeListRefs typeArgs, many args ]
  | EFnName(_, name, _) -> functionNameRefs env name
  | ERecordUpdate(_, record, updates) ->
    Stdlib.List.append
      (exprRefs env record)
      (many (Stdlib.List.map updates (fun (_, v) -> v)))
  | EStatement(_, first, next) -> many [ first, next ]
  | EUnwrap(_, operand) ->
    // ? has no explicit type name in the syntax. Add Option and Result so the
    // solver can check its operand and the enclosing function's return type.
    Stdlib.List.append
      [ LanguageTools.ProgramTypes.Reference.PackageType env.optionType
        LanguageTools.ProgramTypes.Reference.PackageType env.resultType ]
      (exprRefs env operand)
  | _ -> []

/// Collect dependencies from a pipeline step, including named functions or enum
/// constructors and the expressions supplied as arguments. exprRefs handles the
/// value entering the pipeline separately.
let pipeRefs
  (env: Model.Environment)
  (pipePart: LanguageTools.ProgramTypes.PipeExpr)
  : List<LanguageTools.ProgramTypes.Reference> =
  let many (exprs: List<LanguageTools.ProgramTypes.Expr>) : List<LanguageTools.ProgramTypes.Reference> =
    Stdlib.List.flatten (Stdlib.List.map exprs (fun e -> exprRefs env e))

  match pipePart with
  | EPipeVariable(_, _, args) -> many args
  | EPipeLambda(_, _, body) -> exprRefs env body
  | EPipeInfix(_, _, rhs, _) -> exprRefs env rhs
  | EPipeFnCall(_, name, typeArgs, args) ->
    Stdlib.List.flatten
      [ functionNameRefs env name, typeListRefs typeArgs, many args ]
  | EPipeEnum(_, name, _, fields) ->
    Stdlib.List.append (typeNameRefs name) (many fields)

/// Collect the types referenced by a function's parameters and return type.
/// Dependency functions are checked through these signatures, without walking their bodies.
let signatureRefs (fn: LanguageTools.ProgramTypes.PackageFn.PackageFn) : List<LanguageTools.ProgramTypes.Reference> =
  typeListRefs
    (Stdlib.List.push (Stdlib.List.map fn.parameters (fun p -> p.typ)) fn.returnType)


// --------------------
// Load dependencies and follow their references to further declarations.
// --------------------

/// Successfully loaded dependencies, indexed by content hash. Keep value bodies
/// for later inference; loaded functions contribute their declared signatures.
type Closure =
  { types: Dict<LanguageTools.ProgramTypes.Hash, LanguageTools.ProgramTypes.PackageType.PackageType>
    values: Dict<LanguageTools.ProgramTypes.Hash, LanguageTools.ProgramTypes.PackageValue.PackageValue>
    fns: Dict<LanguageTools.ProgramTypes.Hash, LanguageTools.ProgramTypes.PackageFn.PackageFn> }

/// Load the dependencies in pending, then follow references found in each one.
/// candidateRefs identifies declarations already supplied by the caller; skip
/// loading those again. Follow dependency values' bodies and dependency functions'
/// signatures, since values need inference but functions have declared types.
let loadClosure
  (env: Model.Environment)
  (candidateRefs: List<LanguageTools.ProgramTypes.Reference>)
  (pending: List<LanguageTools.ProgramTypes.Reference>)
  : Closure =
  let seen =
    Stdlib.List.fold candidateRefs Dict {} (fun seen r ->
      Stdlib.Dict.setOverridingDuplicates seen r true)

  loadPendingDependencies
    (loadDependency env)
    seen
    pending
    (Closure { types = Dict {}; values = Dict {}; fns = Dict {} })

/// Process the remaining references, attempting each distinct reference once.
/// Mark a reference seen before loading it so cycles, duplicates, and failed loads
/// do not cause repeated attempts. Keep successfully loaded declarations in closure.
let loadPendingDependencies
  (load: Closure -> LanguageTools.ProgramTypes.Reference -> (List<LanguageTools.ProgramTypes.Reference> * Closure))
  (seen: Dict<LanguageTools.ProgramTypes.Reference, Bool>)
  (pending: List<LanguageTools.ProgramTypes.Reference>)
  (closure: Closure)
  : Closure =
  match pending with
  | [] -> closure
  | next :: rest ->
    if Stdlib.Dict.``member`` seen next then
      loadPendingDependencies load seen rest closure
    else
      let seen = Stdlib.Dict.setOverridingDuplicates seen next true

      // Fetching converts stored syntax into Dark values and can fail before the
      // reference walk begins. Catch errors from either step, leave that dependency
      // unavailable, and continue loading the rest. Its users are checked later.
      match guard (fun reference -> load closure reference) next with
      | Ok((refs, loaded)) ->
        loadPendingDependencies load seen (Stdlib.List.append refs rest) loaded
      | Error _ -> loadPendingDependencies load seen rest closure

/// Fetch one declaration by hash, save it, and return the references to visit next.
/// Missing declarations leave closure unchanged. The caller guards both loading
/// and traversal so a conversion or syntax-walk failure cannot abort the queue.
let loadDependency
  (env: Model.Environment)
  (closure: Closure)
  (reference: LanguageTools.ProgramTypes.Reference)
  : (List<LanguageTools.ProgramTypes.Reference> * Closure) =
  match reference with
  | PackageType hash ->
    match LanguageTools.PackageManager.Type.get hash with
    | Some t ->
      let refs = declarationRefs t.declaration
      (refs,
       { closure with
           types = Stdlib.Dict.setOverridingDuplicates closure.types hash t })
    | None -> ([], closure)
  | PackageValue hash ->
    match LanguageTools.PackageManager.Value.get hash with
    | Some v ->
      let refs = exprRefs env v.body
      (refs,
       { closure with
           values = Stdlib.Dict.setOverridingDuplicates closure.values hash v })
    | None -> ([], closure)
  | PackageFn hash ->
    match LanguageTools.PackageManager.Function.get hash with
    | Some fn ->
      let refs = signatureRefs fn
      (refs,
       { closure with
           fns = Stdlib.Dict.setOverridingDuplicates closure.fns hash fn })
    | None -> ([], closure)
