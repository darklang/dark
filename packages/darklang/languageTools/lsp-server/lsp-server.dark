/// This supports a Language Server for Darklang,
/// matching the 3.17 LSP (Language Server Protocol) spec.
///
/// This LSP server is currently used by our in-progress VS Code Extension.
/// Namely, `LspServer.runServerCli` creates a long-running process that reads
/// incoming requests from stdin, and writes responses to stdout, following the LSP spec
module Darklang.LanguageTools.LspServer

// <aliases>
type Json = Stdlib.AltJson.Json
// </aliases>

/// This is the main entrypoint for the Darklang LSP server.
///
/// It reads incoming messages from stdin, and writes responses to stdout,
/// following the LSP spec. It also logs all incoming and outgoing messages to
/// stderr (`log`), which the editor shows as the server's output.
let runServerCli (u: Unit) : Int =
  (Stdlib.DateTime.now ())
  |> Stdlib.toString
  |> fun nowStr -> log $"Running Darklang LSP Server {nowStr}"


  // The first message is the `initialize` capability exchange. No readable message
  // at all means the client never arrived or went away immediately, and there is
  // nothing to serve.
  match readMessageFromClient () with
  | None ->
    log "No `initialize` message to read; the client is gone, nothing to serve"
    0
  | Some incomingMessageRaw -> runServerCliInit incomingMessageRaw


/// Everything after a readable `initialize`: build the first state, then loop.
let runServerCliInit (incomingMessageRaw: String) : Int =
  logIncomingRequest incomingMessageRaw

  let initialState =
    match JsonRPC.IncomingMessage.parse incomingMessageRaw with
    | SingleRequest(Ok jsonRpcRequest) ->
      match jsonRpcRequest.id with
      | Some requestId -> handleInitializeRequest requestId
      | None ->
        log "Error: initialize request must have an id"

        LspState
          { initialized = false
            shouldShutdown = false
            accountID = Stdlib.Option.Option.None
            accountName = ""
            currentBranchId = SCM.Branch.mainBranchId
            documentsInScope = Dict { } }

    | _ ->
      log "Error: expected initialize request as first message"

      LspState
        { initialized = false
          shouldShutdown = false
          accountID = Stdlib.Option.Option.None
          accountName = ""
          currentBranchId = SCM.Branch.mainBranchId
          documentsInScope = Dict { } }


  // now that _that_ is out of the way, we can start responding to normal requests
  runServerCliLoop initialState



let runServerCliLoop (state: LspState) : Int =
  log "---"

  // No readable message means the client has gone. Stop, rather than reading
  // again forever.
  match readMessageFromClient () with
  | None -> 0
  | Some incomingMessageRaw -> runServerCliStep state incomingMessageRaw


/// One message, handled: parse it, act on it, then stop or wait for the next one.
let runServerCliStep (state: LspState) (incomingMessageRaw: String) : Int =
  logIncomingRequest incomingMessageRaw

  let updatedState =
    // parse a json-rpc message from stdin, and call `handleIncomingMessage` on it when relevant
    match JsonRPC.IncomingMessage.parse incomingMessageRaw with
    // The json-rpc spec says to just ignore any incoming messages of `[]`
    | EmptyBatch -> state

    // # Things we want/expect
    | SingleRequest(Ok jsonRpcRequest) ->
      log $"Parsed incoming message as single JSON-RPC request"
      handleIncomingMessage state jsonRpcRequest

    | BatchOfRequests items ->
      // TODO: need to reply in a batch as well
      log "TODO - Got batch request; not yet set to handle these"
      state


    // # Errors

    // was an object {} but not a valid json-rpc 2.0 _request_
    // (note: could have been a valid _response_ though - we don't yet have good support for that)
    | SingleRequest(Error singleRequestParseError) ->
      match singleRequestParseError with
      | NotObject json ->
        let error = Stdlib.AltJson.format json

        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: it must be an object, but was: {error}"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | MissingJsonRpcField ->
        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: it must have a 'jsonrpc' field"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | InvalidIdField json ->
        let error = Stdlib.AltJson.format json

        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: 'id' field must be Null, a Number or a String, but was: {error}"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | MissingMethodField id ->
        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: 'method' field must be provided"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | InvalidMethodField(id, actual) ->
        let error = Stdlib.AltJson.format actual

        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: 'method' field must be a string, but was: {error}"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | InvalidParamsField(id, actual) ->
        let error = Stdlib.AltJson.format actual

        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}\nError: 'params' field must be an Array or an Object, but was: {error}"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state

      | _ ->
        log
          $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}"

        logAndSendToClient
          """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

        state


    | NotJson err ->
      log
        $"Error parsing incoming message as json:\n{incomingMessageRaw}\nError: {err}"

      logAndSendToClient
        """{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}"""

      state


    | NotObjectOrArray _ ->
      log $"Error parsing incoming message as json-rpc:\n{incomingMessageRaw}"

      logAndSendToClient
        """{"jsonrpc": "2.0", "error": {"code": -32600, "message": "Invalid Request"}, "id": null}"""

      state


  // shut down if instructed, or listen for the next message
  if updatedState.shouldShutdown then
    0
  else
    runServerCliLoop updatedState


let tryReadHeader
  (contentLength: Stdlib.Option.Option<Int>)
  : Stdlib.Result.Result<Int, String> =
  let line = Stdlib.Cli.Stdin.readLine ()

  if line == "" then
    contentLength |> Stdlib.Option.toResult "No Content-Length header found"
  else if Stdlib.String.startsWith line "Content-Length: " then
    let lengthStr = Stdlib.String.dropFirst line 16

    match Stdlib.Int.parse lengthStr with
    | Ok length -> tryReadHeader (Stdlib.Option.Option.Some length)
    | Error _ -> Stdlib.Result.Result.Error "Invalid Content-Length value"
  else
    // Skip other headers (like Content-Type) and continue reading
    tryReadHeader contentLength


/// The next message from the client, or `None` when there is not going to be one.
///
/// `None` covers two cases that cannot be told apart and do not need to be.
/// `Stdin.readLine` maps a null read (EOF) to `""`, the same value a blank line
/// gives, so neither this function nor its caller can distinguish "the client
/// closed stdin" from "a blank line arrived before any `Content-Length`". Nothing
/// is lost: an editor holds stdin open for the whole session and always sends the
/// header first, so the first case means the client is gone and the second means
/// the stream has desynchronised. Reading more cannot recover either.
///
/// This used to return `""` on that error, which left the loop parsing an empty
/// message, failing to parse it, and reading again immediately, forever. With
/// stdin closed that spin emitted about 68 KB/s and grew about 0.6 MB/s; one of
/// these reached 42.6 GB over 28 hours and left the machine with 1 GB free.
let readMessageFromClient () : Stdlib.Option.Option<String> =
  match tryReadHeader Stdlib.Option.Option.None with
  | Ok contentLength ->
    Stdlib.Option.Option.Some(Builtin.stdinReadExactly contentLength)
  | Error err ->
    log $"No message to read ({err}); treating the client as gone, shutting down"
    Stdlib.Option.Option.None