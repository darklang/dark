module Darklang.LanguageTools.LspServer


/// The server's log goes to stderr, which an editor shows as the server's output (VS Code's
/// "Darklang LSP - Server" channel). Stdout is the JSON-RPC channel and must carry nothing else,
/// and a log file would need a filesystem grant the default policy does not give: a denied write
/// raises, so the server died before answering `initialize`.
let log (input: String) : Unit = Stdlib.printErrorLine input


let logIncomingRequest (request: String) : Unit = log $"From client: {request}"


let logAndSendToClient (response: String) : Unit =
  log $"To client: {response}"

  let contentLengthInBytes =
    response
    |> Stdlib.String.toBytes
    |> Stdlib.List.length
    |> Stdlib.toString

  Stdlib.printProtocol $"Content-Length: {contentLengthInBytes}\r\n\r\n{response}"

(*
  // These are (basically) the only things we're allowed to do before
  // returning the initialize response
