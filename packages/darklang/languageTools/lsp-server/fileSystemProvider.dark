module Darklang.LanguageTools.LspServer.FileSystemProvider


module ReadFile =
  let sendResponse
    (state: LspState)
    (requestId: JsonRPC.RequestID)
    (content: String)
    : LspState =
    let responseJson =
      (LspExtension.FileSystemProvider.ReadFile.ReadFileResponse.ReadFileResponse
        { content = content })
      |> LspExtension.FileSystemProvider.ReadFile.ReadFileResponse.toJson
      |> (fun r ->
        JsonRPC.Response.Ok.make (Stdlib.Option.Option.Some(requestId)) r)
      |> Stdlib.AltJson.format

    logAndSendToClient responseJson
    state


  let handleReadFileRequest
    (state: LspState)
    (requestId: JsonRPC.RequestID)
    (params:
      LspExtension.FileSystemProvider.ReadFile.ReadFileParams.ReadFileParams)
    : LspState =

    // CLEANUP: make the 'remove scheme part of URI' more universal. Maybe be add it to Stdlib eg.`Stdlib.Uri.removeScheme`
    let nameForLookup =
      // TODO: remove magic
      params.uri
      |> Stdlib.String.dropFirst 8  // Drop "darkfs:/"
      |> Stdlib.String.dropLast 5   // Drop ".dark"

    let location =
      ProgramTypes.parsePackageLocation nameForLookup


    let getContent =
      // Check if this is a script request
      if Stdlib.String.startsWith nameForLookup "script/" then
        let scriptName =
          nameForLookup
          |> Stdlib.String.dropFirst 7  // Drop "script/"

        match Cli.Scripts.get scriptName with
        | Some script -> script.text
        | None -> $"Script not found: {scriptName}"
      else
        // Handle package entities
        let pm = LanguageTools.PackageManager.pm ()
        let branchId = state.currentBranchId

        let ctx = PrettyPrinter.ProgramTypes.Context.forBranch branchId

        // Try to find as a specific entity (type, function, or value)
        let entityContent =
          match LanguageTools.PackageManager.findAny branchId location with
          | Some ((hash, kind)) ->
            match kind with
            | Type ->
              (pm.getType hash)
              |> Stdlib.Option.andThen (fun typ ->
                Stdlib.Option.Option.Some(
                  PrettyPrinter.ProgramTypes.packageType ctx typ))
            | Fn ->
              (pm.getFn hash)
              |> Stdlib.Option.andThen (fun fn ->
                Stdlib.Option.Option.Some(
                  PrettyPrinter.ProgramTypes.packageFn ctx fn))
            | Value ->
              (pm.getValue hash)
              |> Stdlib.Option.andThen (fun value ->
                Stdlib.Option.Option.Some(
                  PrettyPrinter.ProgramTypes.packageValue ctx value))
          | None -> Stdlib.Option.Option.None

        match entityContent with
        | Some content -> content
        | None ->
          // Not a specific entity, treat as a module
          let modulePath = nameForLookup |> Stdlib.String.split "."

          // Search for all entities in this module
          let searchQuery =
            LanguageTools.ProgramTypes.Search.SearchQuery
              { currentModule = modulePath
                text = ""
                searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
                entityTypes = []
                exactMatch = false }

          let ctx =
            PrettyPrinter.ProgramTypes.Context.forBranch state.currentBranchId

          let results =
            LanguageTools.PackageManager.Search.search state.currentBranchId searchQuery

          let definitions =
            LanguageTools.ProgramTypes.Definitions
              { types = results.types |> Stdlib.List.map (fun found -> found.entity)
                fns = results.fns |> Stdlib.List.map (fun found -> found.entity)
                values = results.values |> Stdlib.List.map (fun found -> found.entity)
                exprs = [] }

          // The owner is not a module, so a package's items fan out into several top-level
          // modules (`Stdlib`, `Cli`, ...). Print all of them; `head` would show only the first.
          let modules =
            PrettyPrinter.ModuleDeclaration.toModules state.currentBranchId definitions

          match modules with
          | [] -> $"// No definitions found in {nameForLookup}"
          | _ -> PrettyPrinter.definitions ctx definitions

    sendResponse state requestId getContent


module WriteFile =
  // Lift a top-level SourceFileDeclaration into the nested Declaration type, so one
  // recursion handles both levels (they share Type/Function/Value; only the nested-module
  // case name differs — Module vs SubModule).
  let sfDeclToModuleDecl
    (d: LanguageTools.WrittenTypes.SourceFile.SourceFileDeclaration)
    : LanguageTools.WrittenTypes.ModuleDeclaration.Declaration =
    match d with
    | Type t -> LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Type t
    | Function f -> LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Function f
    | Value v -> LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.Value v
    | Module m -> LanguageTools.WrittenTypes.ModuleDeclaration.Declaration.SubModule m


  // Remove the prefix from a module path if it matches
  let stripModulePrefix
    (prefix: List<String>)
    (path: List<String>)
    : List<String> =
    match (prefix, path) with
    | ([], rest) -> rest
    | (p :: pRest, m :: mRest) ->
      if p == m then
        WriteFile.stripModulePrefix pRest mRest
      else
        path
    | _ -> path


  // Recursively collect (extraModules, declaration) for every leaf declaration,
  // descending into nested modules and accumulating the module path.
  let collectDecls
    (currentExtraModules: List<String>)
    (decls: List<LanguageTools.WrittenTypes.ModuleDeclaration.Declaration>)
    : List<List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration> =
    decls
    |> Stdlib.List.map (fun d ->
      match d with
      | SubModule m ->
        let newPath =
          Stdlib.List.append currentExtraModules [ Stdlib.Tuple2.second m.name ]
        WriteFile.collectDecls newPath m.declarations
      | _ -> [ (currentExtraModules, d) ])
    |> Stdlib.List.flatten


  /// One lowered declaration and the ops that publish it.
  type LoweredDecl =
    { location: LanguageTools.ProgramTypes.PackageLocation
      kind: LanguageTools.ProgramTypes.ItemKind
      ops: List<LanguageTools.ProgramTypes.PackageOp>
      unresolvedNames: List<LanguageTools.WrittenTypes.UnresolvedName> }


  /// Lower against `pm` with a stable placeholder identity; batch stabilization
  /// replaces it before checking or storage.
  let lowerDecl
    (pm: LanguageTools.ProgramTypes.PackageManager.PackageManager)
    (branchId: Uuid)
    (owner: String)
    (decl:
      (List<String> * LanguageTools.WrittenTypes.ModuleDeclaration.Declaration))
    : LoweredDecl =
    let (extraModules, decl) = decl

    // `extraModules` includes the owner; package modules do not.
    let modules =
      match extraModules with
      | _owner :: rest -> rest
      | _ -> []

    let ctx =
      LanguageTools.NameResolver.NRContext
        { onMissing = LanguageTools.NameResolver.OnMissing.Allow
          pm = pm
          branchId = branchId
          owner = owner
          currentModule = modules }

    let locationOf (name: String) : LanguageTools.ProgramTypes.PackageLocation =
      LanguageTools.ProgramTypes.PackageLocation
        { owner = owner; modules = modules; name = name }

    let placeholder (name: String) : LanguageTools.ProgramTypes.Hash =
      LanguageTools.WrittenTypesToProgramTypes.locationPlaceholderHash owner modules name

    match decl with
    | Type typeDecl ->
      let location = locationOf typeDecl.name.name
      let (packageType, unresolvedNames) =
        LanguageTools.WrittenTypesToProgramTypes.TypeDeclaration.toPackageTypePT
          ctx
          typeDecl
      let packageType = { packageType with hash = placeholder typeDecl.name.name }
      LoweredDecl
        { location = location
          kind = LanguageTools.ProgramTypes.ItemKind.Type
          ops =
            [ LanguageTools.ProgramTypes.PackageOp.AddType packageType
              LanguageTools.ProgramTypes.PackageOp.SetName (location, ProgramTypes.Reference.PackageType packageType.hash) ]
          unresolvedNames = unresolvedNames }
    | Function fnDecl ->
      let location = locationOf fnDecl.name.name
      let (packageFn, unresolvedNames) =
        LanguageTools.WrittenTypesToProgramTypes.FunctionDeclaration.toPackageFnPT
          ctx
          fnDecl
      let packageFn = { packageFn with hash = placeholder fnDecl.name.name }
      LoweredDecl
        { location = location
          kind = LanguageTools.ProgramTypes.ItemKind.Fn
          ops =
            [ LanguageTools.ProgramTypes.PackageOp.AddFn packageFn
              LanguageTools.ProgramTypes.PackageOp.SetName (location, ProgramTypes.Reference.PackageFn packageFn.hash) ]
          unresolvedNames = unresolvedNames }
    | Value valDecl ->
      let location = locationOf valDecl.name.name
      let (packageValue, unresolvedNames) =
        LanguageTools.WrittenTypesToProgramTypes.ValueDeclaration.toPackageValuePT
          ctx
          valDecl
      let packageValue = { packageValue with hash = placeholder valDecl.name.name }
      LoweredDecl
        { location = location
          kind = LanguageTools.ProgramTypes.ItemKind.Value
          ops =
            [ LanguageTools.ProgramTypes.PackageOp.AddValue packageValue
              LanguageTools.ProgramTypes.PackageOp.SetName (location, ProgramTypes.Reference.PackageValue packageValue.hash) ]
          unresolvedNames = unresolvedNames }
    // `collectDecls` flattens submodules and never saves expressions.
    | SubModule _
    | Expr _ ->
      LoweredDecl
        { location = locationOf ""
          kind = LanguageTools.ProgramTypes.ItemKind.Value
          ops = []
          unresolvedNames = [] }


  /// Whether nothing of `kind` is already bound at `location`.
  let isNewLocation
    (pm: LanguageTools.ProgramTypes.PackageManager.PackageManager)
    (branchId: Uuid)
    (location: LanguageTools.ProgramTypes.PackageLocation)
    (kind: LanguageTools.ProgramTypes.ItemKind)
    : Bool =
    let existing =
      match kind with
      | Type -> pm.findType (branchId, location) |> Stdlib.Option.isSome
      | Fn -> pm.findFn (branchId, location) |> Stdlib.Option.isSome
      | Value -> pm.findValue (branchId, location) |> Stdlib.Option.isSome
    Stdlib.Bool.not existing


  let sendSuccessResponse
    (state: LspState)
    (requestId: JsonRPC.RequestID)
    (ops: List<LanguageTools.ProgramTypes.PackageOp>)
    (updatedContent: Stdlib.Option.Option<String>)
    : LspState =
    let opsJson =
      ops
      |> Stdlib.List.map (fun op ->
        Json.String (Stdlib.Json.serialize<LanguageTools.ProgramTypes.PackageOp> op))
      |> Json.Array

    let contentJson =
      match updatedContent with
      | Some content -> Json.String content
      | None -> Json.Null

    let responseJson =
      (JsonRPC.Response.Ok.make
        (Stdlib.Option.Option.Some(requestId))
        (Json.Object
          [ ("success", Json.Bool true)
            ("ops", opsJson)
            ("updatedContent", contentJson)
            ("errors", Json.Array []) ]))
      |> Stdlib.AltJson.format

    logAndSendToClient responseJson
    state


  let sendErrorResponse
    (state: LspState)
    (requestId: JsonRPC.RequestID)
    (errors: List<String>)
    : LspState =
    let errorsJson = errors |> Stdlib.List.map (fun e -> Json.String e) |> Json.Array

    let responseJson =
      (JsonRPC.Response.Ok.make
        (Stdlib.Option.Option.Some(requestId))
        (Json.Object
          [ ("success", Json.Bool false)
            ("ops", Json.Array [])
            ("errors", errorsJson) ]))
      |> Stdlib.AltJson.format

    logAndSendToClient responseJson
    state


  let handleWriteFileRequest
    (state: LspState)
    (requestId: JsonRPC.RequestID)
    (params:
      LspExtension.FileSystemProvider.WriteFile.WriteFileParams.WriteFileParams)
    : LspState =
    let content = params.content

    // Check if this is a script write request
    let nameForLookup =
      // TODO: remove magic
      params.uri
      |> Stdlib.String.dropFirst 8  // Drop "darkfs:/"
      |> Stdlib.String.dropLast 5   // Drop ".dark"

    if Stdlib.String.startsWith nameForLookup "script/" then
      let scriptName =
        nameForLookup
        |> Stdlib.String.dropFirst 7  // Drop "script/"

      // Update the script content
      match Cli.Scripts.update scriptName content with
      | Ok () -> sendSuccessResponse state requestId [] Stdlib.Option.Option.None
      | Error err -> sendErrorResponse state requestId [ err ]
    else
      // Parse package module content
      // Parse then collect every declaration with its module path (descending into nested modules).
      let allDecls =
        match Parser.Parse.toWrittenTypes content with
        | Some(SourceFile sourceFile) ->
          WriteFile.collectDecls
            []
            (sourceFile.declarations |> Stdlib.List.map WriteFile.sfDeclToModuleDecl)
        | None -> []

      // Reject duplicate names before stabilization collapses their identities.
      let duplicateNames =
        Cli.Packages.ModuleCommand.duplicateDeclarationNames allDecls

      if Stdlib.Bool.not (Stdlib.List.isEmpty duplicateNames) then
        sendErrorResponse
          state
          requestId
          (duplicateNames
           |> Stdlib.List.map (fun name -> $"Declared more than once: {name}"))
      else
        let parts = Stdlib.String.split nameForLookup "."

        let owner =
          match parts with
          | owner :: _rest -> owner
          | _ -> ""

        let pm = LanguageTools.PackageManager.pm ()
        let branchId = state.currentBranchId

        // First assign batch identities, then lower against them so declarations
        // in the same file resolve one another.
        let firstPassOps =
          allDecls
          |> Stdlib.List.map (WriteFile.lowerDecl pm branchId owner)
          |> Stdlib.List.map (fun lowered -> lowered.ops)
          |> Stdlib.List.flatten
          |> LanguageTools.PackageManager.stabilizeHashes

        let batchPm = ProgramTypes.PackageManager.withExtraOps pm firstPassOps

        // Save only locations absent from the persistent package manager.
        let allOps =
          allDecls
          |> Stdlib.List.map (WriteFile.lowerDecl batchPm branchId owner)
          |> Stdlib.List.filter (fun lowered ->
            WriteFile.isNewLocation pm branchId lowered.location lowered.kind)
          |> Stdlib.List.map (fun lowered -> lowered.ops)
          |> Stdlib.List.flatten

        // Save as WIP; editor diagnostics report findings and `commit`
        // enforces them.
        let addResult = SCM.PackageOps.addAuthored branchId allOps

        match addResult with
        | Error err ->
          sendErrorResponse state requestId [ $"Failed to add package ops: {err}" ]
        | Ok _report ->
          // If ops were added, re-read the content from database to get the version with IDs
          let updatedContent =
            if (Stdlib.List.isEmpty allOps) |> Stdlib.Bool.not then
              // Re-read from package manager to get content with assigned IDs
              let pm = LanguageTools.PackageManager.pm ()
              let location = ProgramTypes.parsePackageLocation nameForLookup

              // Build the content from database (same logic as ReadFile)
              let modulePath = nameForLookup |> Stdlib.String.split "."
              let searchQuery =
                LanguageTools.ProgramTypes.Search.SearchQuery
                  { currentModule = modulePath
                    text = ""
                    searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
                    entityTypes = []
                    exactMatch = false }

              let ctx =
                PrettyPrinter.ProgramTypes.Context.forBranch state.currentBranchId

              let results =
                LanguageTools.PackageManager.Search.search state.currentBranchId searchQuery

              let definitions =
                LanguageTools.ProgramTypes.Definitions
                  { types = results.types |> Stdlib.List.map (fun found -> found.entity)
                    fns = results.fns |> Stdlib.List.map (fun found -> found.entity)
                    values = results.values |> Stdlib.List.map (fun found -> found.entity)
                    exprs = [] }

              // As above: every top-level module, not just the first.
              let modules =
                PrettyPrinter.ModuleDeclaration.toModules state.currentBranchId definitions

              (match modules with
              | [] -> $"// No definitions found in {nameForLookup}"
              | _ -> PrettyPrinter.definitions ctx definitions)
              |> Stdlib.Option.Option.Some
            else
              Stdlib.Option.Option.None

          sendSuccessResponse state requestId allOps updatedContent
