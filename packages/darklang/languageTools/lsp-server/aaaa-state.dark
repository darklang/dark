module Darklang.LanguageTools.LspServer


/// What a document's text means: parsed, names resolved, checked, diagnostics published.
/// Worked out the first time a request needs it, not on every keystroke (`DocSync.analysed`).
type DocumentAnalysis =
  { /// The branch it was resolved against. A branch switch makes it stale.
    branchId: Uuid
    parsed: Stdlib.Result.Result<WrittenTypes.ParsedFile, String>
    /// The package manager plus this document's own declarations, which hover resolves
    /// names against. Filled on the first hover, since nothing else needs it.
    hoverPM: Stdlib.Option.Option<ProgramTypes.PackageManager.PackageManager> }

type DocumentInScope =
  { uri: String
    text: String
    /// The analysis of exactly `text`, or None until something asks. A change builds a
    /// new DocumentInScope with this empty, so the text and its analysis are one value and
    /// an analysis can never be read against text it was not made from.
    analysis: Stdlib.Option.Option<DocumentAnalysis> }

type LspState =
  {
    initialized: Bool

    shouldShutdown: Bool

    /// The account ID of the current user (for commit attribution)
    accountID: Stdlib.Option.Option<Uuid>

    /// The account name of the current user
    accountName: String

    /// Which branch we're working on
    currentBranchId: Uuid

    /// Documents that are currently open in the editor
    /// (i.e. have been `textDocument/didOpen`ed, and not yet `textDocument/didClose`d)
    /// note: the string key here is the URI
    documentsInScope: Dict<String, DocumentInScope>
  }
