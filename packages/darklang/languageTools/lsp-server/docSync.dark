module Darklang.LanguageTools.LspServer.DocSync


let hardcodedServerCapabilities
  ()
  : LanguageServerProtocol.Lifecycle.InitializeRequest.TextDocumentSyncServerCapabilities.TextDocumentSyncServerCapabilities =
  LanguageServerProtocol
    .Lifecycle
    .InitializeRequest
    .TextDocumentSyncServerCapabilities
    .TextDocumentSyncServerCapabilities
    .TextDocumentSyncOptions(
      LanguageServerProtocol.DocumentSync.TextDocument.TextDocumentSyncOptions.TextDocumentSyncOptions
        { openClose = Stdlib.Option.Option.Some true
          change =
            Stdlib.Option.Option.Some
              LanguageServerProtocol.DocumentSync.TextDocument.TextDocumentSyncKind.TextDocumentSyncKind.Full
          save =
            Stdlib.Option.Option.Some(
              LanguageServerProtocol
                .DocumentSync
                .TextDocument
                .TextDocumentSyncOptions
                .SaveOptionsOrBool
                .SaveOptionsOrBool
                .SaveOptions(
                  LanguageServerProtocol.DocumentSync.TextDocument.SaveOptions.SaveOptions
                    { includeText = Stdlib.Option.Option.Some true }
                )
            ) }
    )

let parseAndReportDiagnostics
  (branchId: Uuid)
  (requestUri: String)
  (requestText: String)
  : Stdlib.Result.Result<WrittenTypes.ParsedFile, String> =

  let onMissing = LanguageTools.NameResolver.OnMissing.Allow
  let pm = LanguageTools.PackageManager.pm ()

  // The parser is best-effort and its lexer recovers from malformed input, so it
  // always returns `Some` (a partial tree + precise diagnostics reported below).
  // `None` is unreachable.
  let parsed =
    match Parser.Parse.toWrittenTypes requestText with
    | Some parsedFile -> Stdlib.Result.Result.Ok parsedFile
    | None -> Stdlib.Result.Result.Error "tokenizer failure"

  // the parser's precise syntax errors (empty on a clean parse) — reported
  // alongside name-resolution warnings below
  let parseDiagnostics = Parser.Parse.diagnostics requestText

  match parsed with
  | Ok (SourceFile sf) ->
    let (owner, scriptName) =
      if Stdlib.String.startsWith requestUri "darkfs:/" then
        let pathPart =
          // TODO: remove magic
          requestUri
          |> Stdlib.String.dropFirst 8 // Remove "darkfs:/"
          |> Stdlib.String.dropLast 5 // Remove ".dark"

        if Stdlib.String.startsWith pathPart "script/" then
          ("LSP", "scriptName")
        else
          let parts = Stdlib.String.split pathPart "."

          match parts with
          | [] -> ("LSP", "scriptName")
          | [ owner ] -> (owner, "")
          | owner :: rest ->
            let moduleParts = Stdlib.List.dropLast rest

            let scriptName = Stdlib.String.join moduleParts "."

            (owner, scriptName)
      else
        ("LSP", "scriptName")

    let nrCtx =
      LanguageTools.NameResolver.NRContext
        { onMissing = onMissing
          pm = pm
          branchId = branchId
          owner = owner
          currentModule = if scriptName == "" then [] else [ scriptName ] }

    let parsedFile = WrittenTypes.ParsedFile.SourceFile sf

    // Check only syntax-clean trees; keep parser diagnostics during partial edits.
    let (unresolvedNames, checkerDiagnostics) =
      match
        Parser.CliScript.parseFromWT
          nrCtx
          scriptName
          parseDiagnostics
          parsedFile
      with
      | Ok ((ptCliScriptModule, unresolvedNames)) ->
        match
          Parser.CliScript.parseDecls
            owner
            scriptName
            parseDiagnostics
            parsedFile
        with
        | Ok wtCliScriptModule ->
          (unresolvedNames,
            Diagnostics.atRestDiagnostics
              sf.range
              wtCliScriptModule
              ptCliScriptModule)
        | Error _ -> (unresolvedNames, [])
      | Error err ->
        log $"Name resolution error: {Parser.CliScript.ParseError.toString err}"
        ([], [])

    Diagnostics.gatherAndReportDiagnostics
      requestUri
      unresolvedNames
      parseDiagnostics
      checkerDiagnostics

    parsed
  | Error err ->
    log $"Parse error: {err}"
    Stdlib.Result.Result.Error err


// -- analysis, once per version of a document

/// Store `doc` as the current version of its document.
let remember (state: LspState) (doc: DocumentInScope) : LspState =
  { state with
      documentsInScope =
        state.documentsInScope
        |> Stdlib.Dict.setOverridingDuplicates doc.uri doc }


/// The document at `uri` and its analysis, current for this branch, with the state that
/// remembers it. None when no such document is open.
///
/// A keystroke only stores the new text (`handleTextDocumentDidChange`), and the parse,
/// name resolution and checking happen here, the first time a request needs them, once
/// per version. Typing ten characters used to queue ten full analyses, 2 to 3 s each on a
/// 500-line file, ahead of the next hover; now the hover pays for one.
///
/// No request can see a half-applied change: the loop handles each message to completion
/// before it reads the next, so whatever this fills in belongs to the text it is stored
/// beside. If requests ever run concurrently (spawned against a snapshot of the state),
/// that stops being true, and an analysis must then be stored only if the document still
/// holds the text it was made from.
let analysed
  (state: LspState)
  (uri: String)
  : (LspState * Stdlib.Option.Option<(DocumentInScope * DocumentAnalysis)>) =
  match Stdlib.Dict.get state.documentsInScope uri with
  | None -> (state, Stdlib.Option.Option.None)
  | Some doc ->
    let current =
      match doc.analysis with
      | Some a ->
        if a.branchId == state.currentBranchId then
          doc.analysis
        else
          Stdlib.Option.Option.None
      | None -> Stdlib.Option.Option.None

    match current with
    | Some a -> (state, Stdlib.Option.Option.Some((doc, a)))
    | None ->
      let analysis =
        LanguageTools.LspServer.DocumentAnalysis
          { branchId = state.currentBranchId
            parsed = parseAndReportDiagnostics state.currentBranchId uri doc.text
            hoverPM = Stdlib.Option.Option.None }

      let doc = { doc with analysis = Stdlib.Option.Option.Some analysis }
      (remember state doc, Stdlib.Option.Option.Some((doc, analysis)))


// -- message-handling

/// A document as the editor just sent it, not yet analysed.
let unanalysed (uri: String) (text: String) : DocumentInScope =
  LanguageTools.LspServer.DocumentInScope
    { uri = uri
      text = text
      analysis = Stdlib.Option.Option.None }


/// Opening analyses at once: the editor wants diagnostics and colour straight away.
let handleTextDocumentDidOpen
  (state: LspState)
  (request:
    LanguageServerProtocol.DocumentSync.TextDocument.DidOpenTextDocumentNotification.DidOpenTextDocumentParams.DidOpenTextDocumentParams)
  : LspState =
  let uri = request.textDocument.uri
  let state = remember state (unanalysed uri request.textDocument.text)
  let (state, _doc) = analysed state uri
  state


/// A keystroke: store the text, analyse nothing. The next request that needs the
/// analysis (semantic tokens, hover, inlay hints, a save) does it once, and publishes
/// the diagnostics then.
let handleTextDocumentDidChange
  (state: LspState)
  (request:
    LanguageServerProtocol.DocumentSync.TextDocument.DidChangeTextDocumentNotification.DidChangeTextDocumentParams.DidChangeTextDocumentParams)
  : LspState =
  match request.contentChanges |> Stdlib.List.head with
  | None ->
    log "no content changes in didChange request"
    state
  | Some change ->
    match Stdlib.Dict.get state.documentsInScope request.textDocument.uri with
    | None ->
      log $"document not found in scope: {request.textDocument.uri}"
      state
    | Some _existingDoc ->
      remember state (unanalysed request.textDocument.uri change.text)


/// Saving analyses at once, so the diagnostics match what was written.
let handleTextDocumentDidSave
  (state: LspState)
  (request:
    LanguageServerProtocol.DocumentSync.TextDocument.DidSaveTextDocumentNotification.DidSaveTextDocumentParams.DidSaveTextDocumentParams)
  : LspState =

  match request.text with
  | None ->
    log
      "WARNING: no text in didSave, even though we configured to include text in these requests, in the `initialize` handshake"

    state

  | Some text ->
    let uri = request.textDocument.uri
    let state = remember state (unanalysed uri text)
    let (state, _doc) = analysed state uri
    state


let handleTextDocumentDidClose
  (state: LspState)
  (requestParams:
    LanguageServerProtocol.DocumentSync.TextDocument.DidCloseTextDocumentNotification.DidCloseTextDocumentParams.DidCloseTextDocumentParams)
  : LspState =
  // An empty diagnostic list clears the closed document's squiggles.
  sendDiagnostic requestParams.textDocument.uri []
  { state with
      documentsInScope =
        Stdlib.Dict.remove
          state.documentsInScope
          requestParams.textDocument.uri }
