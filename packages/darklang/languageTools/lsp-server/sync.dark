module Darklang.LanguageTools.LspServer.Sync

/// Handles `dark/listInstances` requests from VS Code
let handleListInstancesRequest
  (state: LspState)
  (requestID: JsonRPC.RequestID)
  : LspState =
  // TODO: instances aren't modeled yet (there is no SCM.Instances);
  // reply with an empty list so the client gets a valid response.
  let responseJson =
    let requestID = Stdlib.Option.Option.Some requestID
    (JsonRPC.Response.Ok.make requestID (Json.Array []))
    |> Stdlib.AltJson.format

  logAndSendToClient responseJson

  state
