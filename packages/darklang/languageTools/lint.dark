/// Package lint messages and their presentation, separate from type-checking verdicts.
module Darklang.LanguageTools.Lint

type WarningCode = | UnusedTestResult

type Warning =
  { code: WarningCode
    nodeId: Stdlib.Option.Option<UInt64>
    name: String }

type Results = List<(ProgramTypes.Reference * List<Warning>)>

let codeToString (code: WarningCode) : String =
  match code with
  | UnusedTestResult -> "UnusedTestResult"

let toString (warning: Warning) : String =
  match warning.code with
  | UnusedTestResult ->
    $"The check bound to '{warning.name}' is never used, so it cannot fail this test. "
    ++ "Return it, or combine checks with Stdlib.Test.all"

let forItem
  (results: Results)
  (item: ProgramTypes.Reference)
  : List<Warning> =
  results
  |> Stdlib.List.filterMap (fun (reference, warnings) ->
    if reference == item then Stdlib.Option.Option.Some warnings
    else Stdlib.Option.Option.None)
  |> Stdlib.List.flatten

let allWarnings (results: Results) : List<Warning> =
  results |> Stdlib.List.map (fun (_item, warnings) -> warnings) |> Stdlib.List.flatten
