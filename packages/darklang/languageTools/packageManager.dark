  let findByValueType
    (valueType: RuntimeTypes.ValueType)
    : List<ProgramTypes.Hash> =
    Builtin.pmFindValuesByValueType valueType

  let find
    (branchId: Uuid)
    (location: ProgramTypes.PackageLocation)
    : Stdlib.Option.Option<ProgramTypes.FQValueName.Package> =
    Builtin.pmFindValue branchId location

  let get
    (hash: ProgramTypes.FQValueName.Package)
    : Stdlib.Option.Option<ProgramTypes.PackageValue.PackageValue> =
    Builtin.pmGetValue hash

  /// Every name this value is bound to on <param branchId>.
