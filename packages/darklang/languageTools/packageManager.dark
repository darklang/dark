  let get (hash: ProgramTypes.Hash) : Stdlib.Option.Option<ProgramTypes.TraitImpl.TraitImpl> =
    Builtin.pmGetTraitImpl hash

  /// Every name this impl is bound to on <param branchId>.
  let locations
    (branchId: Uuid)
    (hash: ProgramTypes.Hash)
    : List<ProgramTypes.PackageLocation> =
    Builtin.pmGetLocationsByTraitImpl branchId hash


