/// Quick fixes for what the analysis reported.
module Darklang.LanguageTools.LanguageServer.Actions

/// Whether the editor applies a fix on its own ("Fix all", the lightbulb's first choice).
type Preference =
  | Preferred
  | Offered


let quickFix(
  title: String,
  uri: String,
  edits: List<Lsp.TextEdit>,
  diagnostic: Lsp.Diagnostic,
  preference: Preference)
  : Lsp.CodeAction =
  Lsp.CodeAction
    { title = title
      kind = "quickfix"
      diagnostics = [ diagnostic ]
      preferred = preference == Preference.Preferred
      edit = Lsp.WorkspaceEdit { changes = [ (uri, edits) ] } }


let parserRange(r: Lsp.Range): Parser.Range =
  Parser.Range { start = Analysis.point(r.start), end_ = Analysis.point(r.end) }


/// The text <param r> covers on its line.
let textAt(text: String, r: Parser.Range): String =
  let (_, from) = Lsp.Text.splitAt(Names.lineOf(text, r.start.row), r.start.column)
  let (inside, _) = Lsp.Text.splitAt(from, r.end_.column - r.start.column)
  inside


// --- an unresolved name: the package items it could mean ---

/// The shortest way to write <param loc> that resolves to it from where the document is.
let shortest(ctx: NameResolver.NRContext, loc: ProgramTypes.PackageLocation): String =
  let full = Stdlib.List.flatten([ [ loc.owner ], loc.modules, [ loc.name ] ])
  let n = Stdlib.List.length(full)
  let fits(parts: List<String>): Bool =
    match Names.resolve(ctx, parts) with
    | Some(found) -> Names.itemLocation(found) == loc
    | None -> false

  Stdlib.List.checkedRange(1, n)
  |> Stdlib.Result.withDefault([])
  |> Stdlib.List.map(fun k -> Stdlib.List.drop(full, n - k))
  |> Stdlib.List.findFirst(fits)
  |> Stdlib.Option.withDefault(full)
  |> Stdlib.String.join(".")


let qualify(
  session: Session,
  doc: Document,
  diagnostic: Lsp.Diagnostic,
  r: Parser.Range)
  : List<Lsp.CodeAction> =
  // The range can be the whole call (`padStart(s, ' ', 3)` reads as an unknown local applied):
  // the name is what it starts with.
  let written =
    Stdlib.Regex.find(textAt(doc.text, r), "^" + Names.namePattern)
    |> Stdlib.Result.toOption
    |> Stdlib.Option.join
    |> Stdlib.Option.withDefault("")

  let r =
    { r with
        end_ =
          Parser.Point { row = r.start.row, column = r.start.column + Lsp.Text.width(written) } }

  let name =
    Stdlib.String.split(written, ".")
    |> Stdlib.List.last
    |> Stdlib.Option.withDefault(written)

  let found =
    PackageManager.Search.search(
      session.state.branchId,
      ProgramTypes.Search.SearchQuery
        { currentModule = []
          text = name
          searchDepth = ProgramTypes.Search.SearchDepth.AllDescendants
          entityTypes =
            [ ProgramTypes.Search.EntityType.Fn
              ProgramTypes.Search.EntityType.Type
              ProgramTypes.Search.EntityType.Value ]
          exactMatch = true })

  let ctx = Names.context(session.state.branchId, doc.uri)
  Stdlib.List.flatten(
    [ Stdlib.List.map(found.fns, fun i -> i.location)
      Stdlib.List.map(found.types, fun i -> i.location)
      Stdlib.List.map(found.values, fun i -> i.location) ])
  |> Stdlib.List.filter(fun loc -> Stdlib.Bool.not(Stdlib.String.startsWith(loc.name, "__")))
  |> Stdlib.List.take(5)
  |> Stdlib.List.map(fun loc ->
    let replacement = shortest(ctx, loc)
    quickFix(
      $"Use {replacement}",
      doc.uri,
      [ Edits.textEdit(r, replacement) ],
      diagnostic,
      Preference.Offered))


// --- a match that misses a case ---

let matchesIn(n: Syntax.Node): List<WrittenTypes.Expr> =
  let own =
    match n with
    | E(e) ->
      match e with
      | EMatch(_, _, _, _, _) -> [ e ]
      | _ -> []
    | _ -> []

  Stdlib.List.concat(
    own,
    Syntax.children(n)
    |> Stdlib.List.map(matchesIn)
    |> Stdlib.List.flatten)


/// A case for <param missing> after the last case of the match the diagnostic is about: the
/// innermost one around the cursor, or the only one in the declaration.
let addCase(
  doc: Document,
  diagnostic: Lsp.Diagnostic,
  r: Parser.Range,
  cursor: Parser.Range,
  missing: String)
  : List<Lsp.CodeAction> =
  let matches =
    match Analysis.parsed(doc) with
    | Some(file) ->
      Syntax.bodies(file)
      |> Stdlib.List.filter(fun b -> Syntax.contains(b.range, r.start.row, r.start.column))
      |> Stdlib.List.map(fun b -> matchesIn(Syntax.Node.E(b.body)))
      |> Stdlib.List.flatten
    | None -> []

  let around =
    matches
    |> Stdlib.List.filter(fun m ->
      Syntax.contains(WrittenTypes.Expr.range(m), cursor.start.row, cursor.start.column))
    |> Stdlib.List.last

  let chosen =
    match around, matches with
    | Some(m), _ -> Option.Some(m)
    | None, [only] -> Option.Some(only)
    | _ -> Option.None

  match chosen with
  | Some(EMatch(_, _, cases, _, _)) ->
    match Stdlib.List.last(cases) with
    | Some(last) ->
      let (bar, _, _) = last.pat
      let at = (WrittenTypes.Expr.range(last.rhs)).end_
      let (indent, _) = Lsp.Text.splitAt(Names.lineOf(doc.text, bar.start.row), bar.start.column)
      let insert = "\n" + indent + "| " + missing + " -> ()"
      [ quickFix(
          $"Add a case for {missing}",
          doc.uri,
          [ Edits.textEdit(Parser.Range { start = at, end_ = at }, insert) ],
          diagnostic,
          Preference.Preferred) ]
    | None -> []
  | _ -> []


/// The fixes for the diagnostics the editor shows at the cursor: qualify an unresolved name, or
/// add the case a match misses.
let codeActions(
  session: Session,
  doc: Document,
  cursor: Lsp.Range,
  diagnostics: List<Lsp.Diagnostic>)
  : List<Lsp.CodeAction> =
  diagnostics
  |> Stdlib.List.map(fun d ->
    let r = parserRange(d.range)
    let missing = d.data |> Stdlib.Option.andThen(fun data -> Lsp.Read.string(data, [ "missing" ]))
    match d.code, missing with
    | Some("NonExhaustiveMatch"), Some(missing) -> addCase(doc, d, r, parserRange(cursor), missing)
    | Some("UnknownVariable"), _ -> qualify(session, doc, d, r)
    | _ ->
      if Stdlib.String.endsWith(d.message, "not found") then
        qualify(session, doc, d, r)
      else
        [])
  |> Stdlib.List.flatten
