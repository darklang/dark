module Darklang.LanguageTools


// TODO: should this be UInt64?
type ID = Int64

type TLID = UInt64

type Sign =
  | Positive
  | Negative

type BuiltinFunctionParameter =
  { name: String
    ``type``: RuntimeTypes.TypeReference }

/// Purity classification for a builtin (mirrors RT.Previewable in F#).
/// `Pure` is referentially transparent; `ImpurePreviewable` may vary
/// across calls but is safe to preview client-side (e.g. `DateTime.now`,
/// `Int.random`); `Impure` requires server execution (e.g. DB writes,
/// HTTP).
type BuiltinFunctionPurity =
  | Pure
  | ImpurePreviewable
  | Impure

/// A Darklang builtin function
type BuiltinFunction =
  { name: RuntimeTypes.FQFnName.Builtin
    description: String
    parameters: List<BuiltinFunctionParameter>
    returnType: RuntimeTypes.TypeReference
    purity: BuiltinFunctionPurity

    /// What calling this may do, by effect name, or empty for one that reaches nothing.
    ///
    /// Per BUILTIN rather than per platform, which is the granularity the question is actually
    /// asked at: a platform's effect list is the union of its builtins', so it tells you that
    /// `Files` reaches `file-write` and not which four functions are the reason.
    effects: List<String> }

/// Every builtin fn this runtime has. The list is built fresh on each call,
/// so hold onto it if you're looking up more than one name.
let allBuiltinFns () : List<BuiltinFunction> =
  Builtin.getAllBuiltinFns ()

/// A Darklang builtin value
type BuiltinValue =
  { name: RuntimeTypes.FQValueName.Builtin
    description: String
    ``type``: RuntimeTypes.TypeReference }
