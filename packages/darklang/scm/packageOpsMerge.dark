module Darklang.SCM.PackageOps

// Sealing work and moving it between branches: commit, merge, rebase, archive, and settling a
// conflict by binding the version a person chose.
//
// All of it is ordinary ops. There is no merge op and no propagation op: a merge flips its
// frontier effective and records a `BranchEvent`, and a resolution authors a `Decision`.
//
// Each act runs in F# as one action (`SCM.Actions`); what is here is when to ask for it, the checks
// in front of it, and what a person reads about it.

/// Settle a conflict on <param hash>: author a `Decision`/`Override` binding the name to it, close the
/// record, and repoint what had followed the losing version -- one act, in F#.
///
/// An op, so the choice TRAVELS: a peer folding it lands on the same binding rather than re-deriving
/// its own auto-pick. It carries the conflict id, which makes it distinct from the losing `SetName` the
/// log already holds, and makes settling twice one op.
///
/// Refuses an empty hash rather than binding a name to nothing: `Hash ""` corrupts the binding in a way
/// no later fold undoes.
let settleConflict(
  branchId: Uuid,
  c: Conflicts.Conflict,
  hash: String)
  : Stdlib.Result.Result<Unit, String> =
  match SCM.Actions.resolve(SCM.Actions.Resolution.Override(branchId, c.id, hash)) with
  | Ok(_) -> Stdlib.Result.Result.Ok()
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


/// Settle a conflict by taking the REMOVAL: end the name again, and close the record.
///
/// The sibling of <fn settleConflict>, which binds a hash, and one function for the same reason: an
/// unbind with the record left open, or a closed record with no op behind it, are both states
/// nothing later repairs.
///
/// `previous` is what the name holds NOW, so the op says what it ended. That is what lets a peer's
/// detector tell an ordinary removal from a divergence.
let settleConflictByRemoval(
  branchId: Uuid,
  c: Conflicts.Conflict)
  : Stdlib.Result.Result<Unit, String> =
  let location = Deps.locationOf(c.owner, c.modules, c.name)

  let previous =
    PackageOps.liveBindingFor(branchId, location) |> Stdlib.Option.map(fun b -> b.hash)

  match
    SCM.Actions.resolve(SCM.Actions.Resolution.TakeRemoval(branchId, c.id, previous))
  with
  | Ok(_) -> Stdlib.Result.Result.Ok()
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


/// Commit the draft on <param branchId> under <param message>. Returns the new commit's hash.
///
/// Refuses when something in the draft references a name that does not resolve. The gate is on the
/// OPERATION, not on one command: there is more than one way to commit, and a draft must not be
/// committable from one surface and refused from another.
///
/// The commit row and the stamping are one transaction, and nothing is written when nothing would be
/// stamped, so `log` never shows a commit claiming work that isn't there.
///
/// The workbench's commit. The CLI has its own path (`Cli.Commit`), which additionally offers
/// `--allow-type-errors` and `--allow-unresolved`; there is no way to type a flag at the workbench's
/// commit prompt, so this refuses outright rather than offering an override it cannot take.
let commitDraft(branchId: Uuid, message: String): Stdlib.Result.Result<String, String> =
  let typeReport = typeCheckDraft(branchId)

  match typeReport.verdict with
  | Failed ->
    let count =
      Stdlib.List.length(
        Stdlib.List.concat(typeReport.diagnostics, typeReport.warnings))

    Stdlib.Result.Result.Error(
      $"the at-rest type check found {Stdlib.toString(count)} definite error(s); "
      + "`dark constraints` and `dark typecheck` show them")
  | Checked
  | Incomplete ->

  match unresolvedInDraft(branchId) with
  | [] ->
    match draftOpCountFor(branchId) with
    | 0 -> Stdlib.Result.Result.Error("nothing to commit")
    | _ ->
      match commitOn(branchId, message, SCM.Actions.CommitScope.Whole, false) with
      | Ok(c) -> Stdlib.Result.Result.Ok(c.hash)
      | Error(Refused(NothingToCommit)) -> Stdlib.Result.Result.Error("nothing was committed")
      | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))
  | broken ->
    let names =
      broken
      |> Stdlib.List.map(fun((label, _)) -> label)
      |> Stdlib.String.join(", ")

    Stdlib.Result.Result.Error(
      $"unresolved references in {names} -- author what's missing, or commit with --allow-unresolved")


/// Drop the draft for <param branchId>, whichever kind of draft that is. Returns how many ops went.
let discardDraftFor(branchId: Uuid): Int64 =
  match discardOn(branchId, SCM.Actions.DiscardWhat.All) with
  | Ok(n) -> n
  | Error(_) -> 0


/// Commit <param scope> of <param branchId>'s draft under <param message>: the commit and its ops in
/// one transaction. Refused (`NothingToCommit`) when nothing would be stamped, with nothing written.
/// <param collapse> drops main's superseded namings first.
let commitOn(
  branchId: Uuid,
  message: String,
  scope: SCM.Actions.CommitScope,
  collapse: Bool)
  : Stdlib.Result.Result<SCM.Actions.Committed, SCM.Actions.Failure> =
  SCM.Actions.commit(
    SCM.Actions.CommitRequest
      { branchId = branchId
        message = message
        scope = scope
        collapse = collapse })


/// What a merge did: how many ops moved, and what it auto-resolved on the way. `warning` is
/// something that went wrong after it landed (its values failed to evaluate), or "".
type MergeOutcome =
  { merged: Int64
    conflicts: List<Conflicts.Conflict>
    /// The branch's callers repointed at the parent's version before it landed.
    repointed: List<String>
    warning: String }


/// What stopped a merge: the gate said no, or the mechanism failed partway through.
///
/// The two are worth telling apart. A refusal is a state the branch is in and a person can act on;
/// a mechanism failure means the store did something unexpected halfway.
type MergeError =
  | Refused of Branches.MergeRefusal
  | Mechanism of String

/// The sentence a person reads, whichever half it came from.
let mergeErrorMessage(e: MergeError): String =
  match e with
  | Refused(r) -> Branches.refusalMessage(r)
  | Mechanism(m) -> m


/// Merge a branch into its parent, as one action: gate (`Branches.canMerge`'s three refusals), repoint
/// the branch's callers of names the parent moved at the parent's version (as a rebase does), detect
/// the conflicts, then in ONE transaction flip the frontier effective and fold it, mark the branch
/// merged, author the event that tells other machines, commit what landed, and record the conflicts.
/// Into a branch-off-a-branch the frontier is retagged onto the parent instead of folded.
///
/// Conflicts do not BLOCK the merge. They are auto-resolved by origin_ts LWW and recorded against the
/// parent, so the loser is reviewable rather than silently gone. Conflicts still pending on the branch
/// (a rebase records them there) move to the parent too.
let mergeBranch(branchId: Uuid): Stdlib.Result.Result<MergeOutcome, MergeError> =
  let repoints = Branches.outdatedRepoints(branchId)

  match SCM.Actions.merge(SCM.Actions.MergeAction.IntoParent(branchId, repoints)) with
  | Ok(r) ->
    (MergeOutcome
      { merged = r.moved
        conflicts = r.conflicts
        repointed = r.repointed
        warning = r.warning })
    |> Stdlib.Result.Result.Ok
  | Error(Refused(IsMain)) ->
    Stdlib.Result.Result.Error(MergeError.Refused(Branches.MergeRefusal.IsMain))
  | Error(Refused(NothingToMerge)) ->
    Stdlib.Result.Result.Error(MergeError.Refused(Branches.MergeRefusal.NothingToMerge))
  | Error(Refused(HasActiveChildren)) ->
    Stdlib.Result.Result.Error(MergeError.Refused(Branches.MergeRefusal.HasActiveChildren))
  | Error(Refused(Moved)) ->
    Stdlib.Result.Result.Error(
      MergeError.Mechanism(
        "the branch changed while it was being merged, so nothing was changed. Run it again."))
  | Error(e) -> Stdlib.Result.Result.Error(MergeError.Mechanism(SCM.Actions.failureMessage(e)))


/// What a rebase did: the parent's message, and what the rebase reconciled.
type RebaseOutcome =
  { message: String
    conflicts: List<Conflicts.Conflict> }


/// What a rebase reconciled, said to the person who ran it.
///
/// Names the parent by NAME, never by id: a bare uuid where a branch name belongs is exactly what the
/// boundary rule exists to prevent, and main's id renders as one.
let rebaseMessage(parentId: Uuid, rebased: Branches.Rebased): String =
  let parentName = branchName(parentId)

  // Two different things happened, and the advice differs: a divergence is yours to settle, a repoint
  // already agrees with the parent and needs nothing from you.
  let divergedPart =
    match rebased.diverged with
    | [] -> []
    | names ->
      let n = Stdlib.toString(Stdlib.List.length(names))
      let listed = Stdlib.String.join(names, "\n  ")
      [ $"it had changed {n} name(s) you also touched:\n  {listed}\nthe newer edit of each won and the other is recorded: `dark conflicts` lists them, and an override takes the other." ]

  let repointedPart =
    match rebased.repointed with
    | [] -> []
    | names ->
      let n = Stdlib.toString(Stdlib.List.length(names))
      let listed = Stdlib.String.join(names, "\n  ")
      [ $"it had moved names this branch calls; {n} caller(s) now point at the parent's version:\n  {listed}" ]

  match Stdlib.List.concat(divergedPart, repointedPart) with
  | [] ->
    $"already current with \"{parentName}\" -- nothing to reconcile; merge is ready"
  | parts ->
    $"rebased onto \"{parentName}\". " + (Stdlib.String.join(parts, "\n"))


/// Rebase a branch: accept the parent's current state as the new base; reports the names the parent changed
/// since the fork. Where both changed a name the newer edit wins, on the branch too. Records what it
/// reconciled, same as merge.
let rebaseBranch(branchId: Uuid): Stdlib.Result.Result<RebaseOutcome, String> =
  if SCM.Branch.isMain(branchId) then
    // Main has no parent to rebase onto, so this is not a thing you can do rather than a thing that found
    // nothing to do.
    Stdlib.Result.Result.Error(
      "main is the trunk -- rebase moves a BRANCH onto its parent, and main has none.")
  else
    match Branches.rebaseDetailed(branchId) with
    | Ok(reconciled) ->
      let rebased =
        Branches.Rebased
          { diverged = reconciled.diverged
            repointed = reconciled.repointed }

      let msg = rebaseMessage(branchParentOf(branchId), rebased)

      (RebaseOutcome { message = msg, conflicts = reconciled.conflicts })
      |> Stdlib.Result.Result.Ok
    | Error(e) -> Stdlib.Result.Result.Error(e)


/// A display of all active branches (one line each: name (id) <- parent [status]).
let branchList(includeMerged: Bool): String =
  let hidden = if includeMerged then 0 else Branches.mergedCount()

  let footer =
    if hidden == 0 then
      ""
    else
      $"\n\n{Stdlib.toString(hidden)} merged -- `dark branches --all` shows them."

  match Branches.listLines(includeMerged) with
  | [] ->
    if hidden == 0 then
      "no branches -- `dark switch <name>` starts one."
    else
      $"no live branches.{footer}"
  | lines ->
    // Newest first, capped: a long-lived store accretes dozens of finished experiments, and the one
    // live branch you care about should not be buried in them. `--all` uncaps along with unhiding.
    let cap = 20

    let shown =
      if includeMerged || (Stdlib.List.length(lines)) <= cap then
        lines
      else
        let more = (Stdlib.List.length(lines)) - cap

        Stdlib.List.append(
          Stdlib.List.take(lines, cap),
          $"+ {Stdlib.toString(more)} more -- `dark branches --all` lists every branch.")

    (Stdlib.String.join(shown, "\n")) + footer


/// Resolve a conflicted name on a branch: choice = "mine" (keep the branch's) or "theirs" (take parent's).
let resolveConflict(
  branchId: Uuid,
  name: String,
  choice: String)
  : Stdlib.Result.Result<String, String> =
  let resolved =
    match choice with
    | "mine" ->
      Branches.resolveKeepMine(branchId, name)
      |> Stdlib.Result.map(fun _ ->
        $"kept the branch's {name} (it now wins on merge)")
    | "theirs" ->
      Branches.resolveTakeTheirs(branchId, name)
      |> Stdlib.Result.map(fun _ ->
        $"took the parent's {name} (dropped the branch's binding)")
    | other ->
      Stdlib.Result.Result.Error(
        $"unknown choice \"{other}\" -- use \"mine\" or \"theirs\"")

  match resolved with
  | Ok(kept) ->
    // The branch by NAME: this line is read by a person, and the id is a uuid.
    Stdlib.Result.Result.Ok(
      $"resolved {name} on \"{branchName(branchId)}\": {kept}.")
  | Error(e) -> Stdlib.Result.Result.Error(e)


/// Archive (soft-delete) a branch, discarding its unmerged ops: one action, which also authors and
/// commits the event that tells other machines.
let archiveBranch(branchId: Uuid): Stdlib.Result.Result<String, String> =
  // Read before the archive: afterwards the branch has no name to put in the message.
  let handle = branchName(branchId)

  match SCM.Actions.branch(SCM.Actions.BranchAction.Archive(branchId)) with
  | Ok(_) -> Stdlib.Result.Result.Ok($"archived branch \"{handle}\".")
  | Error(e) ->
    Stdlib.Result.Result.Error(
      $"archive failed, nothing was changed: {SCM.Actions.failureMessage(e)}")


/// The id of the branch NAMED <param name>, starting it off <param parentId> if no live branch has that
/// name. `switch` uses this, so a branch started while on another branch is parented to it (branches off
/// branches). Returns (id, wasCreated).
let ensureBranch(name: String, parentId: Uuid): (Uuid * Bool) =
  resolveBranch(name, parentId)


/// One name a branch changes vs its parent.
type BranchDiffEntry =
  { /// Dotted, as a person reads it.
    name: String
    /// "fn" / "type" / "value" -- named `kind`, as every other JSON surface spells it.
    kind: String
    /// "new" when the parent does not have this name at all, "changed" when it has a different version.
    change: String
    /// What the parent binds. "" when the name is new there.
    parentHash: String
    /// What the branch binds.
    hash: String }