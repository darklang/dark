module Darklang.SCM.PackageOps

// What is UNCOMMITTED on the branch you are standing on, and the decisions a later edit undid.
//
// Live-on-write means a draft is not "pending work" -- it is already running. It is the set of ops you
// have not reviewed and committed yet, which is exactly what `dark status` reports and `dark commit`
// acts on. On a branch it is that branch's own uncommitted frontier instead. The clause that spells
// that difference out is in F#, once (`LibDB.ScmActions.draftWhere`, mirrored by `LibDB.ScmOps` for
// the reads), and so is every write that changes a draft: committing it, dropping part of it.
//
// Same module as `packageOps.dark`; see the note there.


/// How many ops are in the draft.
let draftOpCountFor(branchId: Uuid): Int64 = countOf(OpFilter.Draft(branchId))


let draftOpCount(): Int64 = draftOpCountFor(currentBranch())



/// The ids of the ops the draft holds, sorted, so a commit can be hashed over WHAT it commits.
///
/// Sorted rather than in log order: two machines that authored the same ops in a different order committed
/// the same thing, and an id that says otherwise would be lying about the contents it claims to name.
let draftOpIdsFor(branchId: Uuid): List<String> = idsOf(OpFilter.DraftIds(branchId))


/// What the draft BINDS: one entry per name, latest edit wins. Five edits to one fn collapse to one entry
/// here, which is why propagation runs at commit time -- the intermediate versions never need to be shown
/// or propagated to.
let draftBindingsFor(branchId: Uuid): List<Conflicts.Binding> =
  draftEntriesFromOpRows(draftOpRowsFor(branchId))
  |> Stdlib.List.filterMap(fun word -> word.binding)


/// The draft's op rows for <param branchId>, oldest first -- the one query behind
/// <fn draftBindingsFor>, <fn draftRemovalsFor> and <fn draftEntriesFor>.
let draftOpRowsFor(branchId: Uuid): List<OpRow> = rowsOf(OpFilter.Draft(branchId))


let draftBindings(): List<Conflicts.Binding> =
  draftBindingsFor(currentBranch())


/// The names the draft REMOVES, fully qualified: an `Unbind` with no later binding of the same name.
/// Not a binding, so `draftBindingsFor` cannot carry it, and a status that counted bindings alone would
/// read "clean" over a draft whose one op deletes something.
let draftRemovalsFor(branchId: Uuid): List<String> =
  bindingEntriesFromOpRows(draftOpRowsFor(branchId))
  |> Stdlib.List.filterMap(fun w ->
    match w.binding with
    | Some(_) -> Stdlib.Option.Option.None
    | None -> Stdlib.Option.Option.Some(Conflicts.fqn(w.owner, w.modules, w.name)))


let draftRemovals(): List<String> = draftRemovalsFor(currentBranch())


/// Draft items that still reference a name which does not resolve, as (item, the names it cannot find).
///
/// An unresolved reference is fine while you work -- you can write a caller before the callee exists, and
/// `WipRefresh` re-resolves once it does. It stops being fine at commit, where a draft becomes history
/// other machines rely on. What to DO about the answer is decided in `Cli.Commit`.
let unresolvedInDraft(branchId: Uuid): List<(String * List<String>)> =
  let ops = draftEntriesFor(branchId) |> Stdlib.List.map(fun e -> e.op)
  let bindings = draftBindingsFor(branchId)

  // What the draft's named versions reference. An earlier version's references don't count: saving a
  // fix leaves the broken version in the draft, and it still references the old versions around it.
  let referenced =
    SCM.Deps.query(SCM.Deps.DepQuery.Closure(bindings |> Stdlib.List.map(fun b -> b.hash)))
    |> Stdlib.List.map(fun e -> e.dependsOnHash)

  LanguageTools.UnresolvedNames.inOps(ops)
  |> Stdlib.List.filterMap(fun((hash, names)) ->
    // The draft binds the hash it just authored, so the name is usually right there.
    match bindings |> Stdlib.List.findFirst(fun b -> b.hash == hash) with
    | Some(b) -> Stdlib.Option.Option.Some((Conflicts.fqn(b.owner, b.modules, b.name), names))
    | None ->
      // An Add with NO surviving SetName is content nothing names: an earlier version, or
      // `dark discard <name>` dropped the binding and kept the content on purpose (see `Draft.collapse`).
      if Stdlib.List.contains(referenced, hash) then
        // Reachable but unnamed: still a real problem, and the short hash is the only honest label.
        Stdlib.Option.Option.Some((Stdlib.String.first(hash, 8), names))
      else
        Stdlib.Option.Option.None)


/// The names whose CURRENT binding was written by PROPAGATION rather than by a person.
///
/// `locations.source` is the only place this is knowable: a repoint changes an item's resolved references
/// and nothing else, so its binding is shape-identical to one you typed. Returned fully-qualified so a
/// caller can intersect with what it is about to display rather than asking per item.
let propagatedNames(): List<String> =
  SCM.Bindings.query(SCM.Bindings.BindingFilter.Propagated(currentBranch()))
  |> Stdlib.List.map(fun b -> Conflicts.fqn(b.owner, b.modules, b.name))


/// The draft, decoded, oldest first. Same predicate as `draftWhere`, so this and the counts can't disagree
/// about what the draft is.
let draftEntriesFor(branchId: Uuid): List<DraftEntry> =
  decodeOpRowEntries(draftOpRowsFor(branchId))
  |> Stdlib.List.map(fun((id, ts, op)) -> DraftEntry { id = id, ts = ts, op = op })


let draftEntries(): List<DraftEntry> = draftEntriesFor(currentBranch())


/// The per-location key the two decision folds below group on. A string built here rather than through
/// `Constraints.fqnOf`: this silo owns the op log and must not depend on the one that reports findings.
let decisionKey(loc: LanguageTools.ProgramTypes.PackageLocation): String =
  loc.owner + "|" + (Stdlib.String.join(loc.modules, ".")) + "|" + loc.name


/// Where a human's OVERRIDE was later undone by an ordinary edit.
///
/// Returns (location, the hash the override chose, the hash bound now) per name.
///
/// Last-writer-wins is working as designed here; what is missing is that the losing side goes silently.
/// `SCM.Constraints` turns these into standing findings.
///
/// Only an override counts: an ordinary edit can replace it without another explicit decision.
///
/// Guarded on the `conflicts` projection first, which is small and usually empty of overrides, so the
/// op-log decode below costs nothing on the common path.
/// A failed read of the op log is reported rather than mistaken for no findings.
let supersededOverrides(
  )
  : Stdlib.Result.Result<List<(LanguageTools.ProgramTypes.PackageLocation * String * String)>, String> =
  match SCM.Conflicts.query(SCM.Conflicts.ConflictFilter.AnyOverridden) with
  | [] -> Stdlib.Result.Result.Ok([])
  | _ ->
    // Fold the log in order, remembering per location: the hash the last LOCAL override chose, and
    // the hash bound now. Order is the fold's own (origin_ts, rowid), so "later" means what the fold
    // means. Only YOUR override can be superseded
    // (a peer's is theirs to watch), and a later edit of YOURS is a change of mind, which closes the
    // record rather than reporting you to yourself.
    let hashOf =
      (fun target ->
        LanguageTools.ProgramTypes.hashToString(
          LanguageTools.ProgramTypes.Reference.hash(target)))

    rowsOf(OpFilter.Main)
    |> Stdlib.List.fold(Stdlib.Dict.empty, fun(acc, row) ->
      match row.op with
      | None -> acc
      | Some(Decision(_, loc, _, Override(target))) ->
        let h = hashOf(target)
        Stdlib.Dict.set(acc, decisionKey(loc), (loc, h, h))
      | Some(SetName(loc, _target, _)) ->
        match Stdlib.Dict.get(acc, decisionKey(loc)) with
        | None -> acc
        | Some(_entry) -> Stdlib.Dict.remove(acc, decisionKey(loc))
      | _ -> acc)
    |> Stdlib.Dict.values
    |> Stdlib.List.filter(fun entry ->
      let (_loc, chosen, live) = entry
      chosen != live)
    |> Stdlib.Result.Result.Ok


/// The at-rest check over any set of ops, with the same live-items rule the draft gate uses:
/// only the last binding per name, and the content those bindings target.
///
/// Split out so `merge` can ask the same question of a branch's COMMITTED frontier that
/// `commit` asks of a draft. One implementation, so the two gates cannot disagree about what
/// "definite type error" means.
let typeCheckOps(
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : LanguageTools.AtRestTypeChecker.Report =

  let effects = ops |> Stdlib.List.map(LanguageTools.ProgramTypes.PackageOp.bindingOps) |> Stdlib.List.flatten

  // Work out what each name points to after these operations.
  // Later bindings replace earlier ones, and Unbind removes the name.
  // Then collect the hashes still bound to names for the type-check filter below.
  let liveTargetsByLocation =
    effects
    |> Stdlib.List.fold(Stdlib.Dict.empty, fun(acc, op) ->
      match op with
      | SetName(loc, target, _) ->
        Stdlib.Dict.set(
          acc,
          decisionKey(loc),
          LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target)))
      | Decision(_, loc, _, Override(target)) ->
        Stdlib.Dict.set(acc, decisionKey(loc), LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target)))
      | Unbind(loc, _) -> Stdlib.Dict.remove(acc, decisionKey(loc))
      | _ -> acc)

  // Use Dict lookups so checking each operation does not scan the whole list of names.
  // Both commit and merge use this filter.
  let liveTargets =
    liveTargetsByLocation
    |> Stdlib.Dict.values
    |> Stdlib.List.map(fun h -> (h, true))
    |> Stdlib.Dict.fromEntries

  let namedHashes =
    effects
    |> Stdlib.List.filterMap(fun op ->
      match op with
      | SetName(_, target, _) ->
        Stdlib.Option.Option.Some(
          (LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target)),
           true)
        )
      | _ -> Stdlib.Option.Option.None)
    |> Stdlib.Dict.fromEntries

  let liveOps =
    ops
    |> Stdlib.List.filter(fun op ->
      match op with
      | AddFn(f) ->
        let h = LanguageTools.ProgramTypes.hashToString(f.hash)
        // Content some binding targets, or content no draft SetName ever named (don't silently
        // skip a shape this filter does not understand).
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | AddType(t) ->
        let h = LanguageTools.ProgramTypes.hashToString(t.hash)
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | AddValue(v) ->
        let h = LanguageTools.ProgramTypes.hashToString(v.hash)
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | AddTrait(t) ->
        let h = LanguageTools.ProgramTypes.hashToString(t.hash)
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | AddTraitImpl(i) ->
        let h = LanguageTools.ProgramTypes.hashToString(i.hash)
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | AddTest(test) ->
        let h = LanguageTools.ProgramTypes.hashToString(test.hash)
        (Stdlib.Dict.containsKey(liveTargets, h))
        || (Stdlib.Bool.not(Stdlib.Dict.containsKey(namedHashes, h)))
      | _ -> true)

  match liveOps with
  | [] -> LanguageTools.AtRestTypeChecker.emptyReport()
  | live -> LanguageTools.AtRestTypeChecker.checkPackageOps(live)


/// The at-rest type check over what the DRAFT holds, on <param branchId>.
///
/// Asked at commit rather than only at save, because a draft is allowed to be broken (you write the caller
/// before the callee) and a commit is not: a commit is what other machines pull. Saving already reports
/// this; committing is where refusing it is worth something.
///
/// Checks the draft's LIVE items only: the last binding per name, and the content those bindings
/// target. A superseded version's `Add` stays in the draft by design (its naming collapses, the
/// content ships as history), and must not be checked, or a broken-then-fixed edit would refuse every
/// commit. Unreachable history is not what the gate protects; what other machines will RESOLVE is.
let typeCheckDraft(
  branchId: Uuid)
  : LanguageTools.AtRestTypeChecker.Report =
  typeCheckOps(draftEntriesFor(branchId) |> Stdlib.List.map(fun e -> e.op))


// Dropping part of a draft. Each is one action in F# (`SCM.Actions.discard`), which decides what
// survives, whether the rows a dropped op wrote can be removed surgically or the draft has to be
// rebuilt, and never deletes an op this build cannot decode.


/// A draft op, with the two things a selection needs that a decoded op alone doesn't carry: which row it is,
/// and when it was authored.
type DraftEntry =
  { id: String
    ts: String
    op: LanguageTools.ProgramTypes.PackageOp }


/// Drop <param what> from <param branchId>'s draft. Returns how many ops went.
let discardOn(
  branchId: Uuid,
  what: SCM.Actions.DiscardWhat)
  : Stdlib.Result.Result<Int64, String> =
  match SCM.Actions.discard(branchId, what) with
  | Ok(n) -> Stdlib.Result.Result.Ok(n)
  | Error(Refused(Moved)) ->
    Stdlib.Result.Result.Error(
      "the draft kept changing while it was being rewritten (10 tries), usually another save, a pull, or your own editor, so nothing was changed. Run it again.")
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


/// Drop one name's uncommitted bindings from the current scope's draft.
///
/// What neither `discard` (all-or-nothing) nor `undo` (step back a version) can express: a newly-authored
/// item has no previous version, so `undo` refuses it, and without this one typo in a reference blocks
/// `commit` until the entire draft goes.
///
/// Only the NAME's bindings go -- `SetName`s, and the overrides an `undo` writes. That reverts the name to
/// its last committed binding, or to not existing at all if it never had one. Its content stays.
let discardDraftName(
  owner: String,
  modules: List<String>,
  name: String)
  : Stdlib.Result.Result<Int64, String> =
  discardOn(
    currentBranch(),
    SCM.Actions.DiscardWhat.Name(
      LanguageTools.ProgramTypes.PackageLocation
        { owner = owner
          modules = modules
          name = name }
    ))


/// Drop these ops from <param branchId>'s draft. Returns how many went.
let dropBranchOps(branchId: Uuid, ids: List<String>): Stdlib.Result.Result<Int64, String> =
  match ids with
  | [] -> Stdlib.Result.Result.Ok(0)
  | ids -> discardOn(branchId, SCM.Actions.DiscardWhat.Ops(ids))


/// Drop the current scope's draft, whichever it is.
let discardDraft(): Stdlib.Result.Result<Int64, String> =
  discardOn(currentBranch(), SCM.Actions.DiscardWhat.All)
