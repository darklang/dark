module Darklang.SCM.Commits

// The CHECKPOINT record, and the `commits` silo.
//
// Authoring is live-on-write: an op takes effect the moment it folds, committed or not, so a commit is not a
// gate. It is the one human moment -- review what changed, let propagation run over the FINAL versions,
// surface conflicts, commit the dep-closed set -- and afterwards the answer to "what have I changed since I
// last looked".
//
// Membership is `package_ops.commit_hash` (NULL = draft). This module OWNS the `commits` table; the
// `package_ops` side of it (the draft query, the stamping) belongs to `SCM.PackageOps`.


type Commit =
  { hash: String
    message: String
    author: String
    originTs: String
    createdAt: String
    /// The commit this one follows on the line it was made on, or "" for the first commit in a store.
    /// Part of the hash, so a commit's id says where it sits as well as what it holds.
    parent: String }

/// The next portable stamp: MAX(origin_ts) + 1s over the log, not wall-clock. Authoring stamps from a
/// monotonic counter that can run ahead of the clock, so `now` isn't reliably "after" the ops being
/// committed -- and this way it needs no clock capability.
let nextStamp () : String =
  Stdlib.Sqlite.scalarTextP
    (localDb ())
    "SELECT COALESCE(strftime('%Y-%m-%dT%H:%M:%fZ', MAX(origin_ts), '+1 second'),
            strftime('%Y-%m-%dT%H:%M:%fZ','now')) AS ts FROM package_ops"
    []
    "ts"
    ""

/// A content-derived commit id: the same work, committed onto the same history, computes the same id on two
/// machines rather than each inventing its own. Short: it's a handle you type, not a security boundary.
///
/// Op ids and parent are IN the material, so the id says what the commit holds and where it sits:
/// identical ops committed onto different histories get different ids. Ops arrive sorted (see
/// `draftOpIdsFor`).
let mintHash
  (message: String)
  (author: String)
  (stamp: String)
  (opIds: List<String>)
  (parent: String)
  : String =
  let ops = Stdlib.String.join opIds ","
  let material = $"{message}|{author}|{stamp}|{parent}|{ops}"
  let digest = Stdlib.Blob.toHex (Stdlib.Crypto.sha256 (Stdlib.String.toBlob material))
  Stdlib.String.toLowercase (Stdlib.String.first digest 16)

/// Write a commit ROW (it commits nothing by itself -- the caller stamps the ops). Returns its hash.
let create
  (message: String)
  (author: String)
  (opIds: List<String>)
  (parent: String)
  : String =
  let stamp = nextStamp ()
  let hash = mintHash message author stamp opIds parent

  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      "INSERT OR REPLACE INTO commits (hash, message, author, origin_ts, parent)
       VALUES (@p0, @p1, @p2, @p3, @p4)"
      [ hash, message, author, stamp, parent ]

  hash

let commitFromRow (row: Dict<String, Stdlib.Sqlite.Value>) : Stdlib.Option.Option<Commit> =
  match Stdlib.Sqlite.textField row "hash" with
  | Some hash ->
    (Commit
      { hash = hash
        message = Stdlib.Sqlite.textOr row "message"
        author = Stdlib.Sqlite.textOr row "author"
        originTs = Stdlib.Sqlite.textOr row "origin_ts"
        createdAt = Stdlib.Sqlite.textOr row "created_at"
        parent = Stdlib.Sqlite.textOr row "parent" })
    |> Stdlib.Option.Option.Some
  | None -> Stdlib.Option.Option.None

/// Number of commits across the store, matching the unfiltered recent listing.
let count () : Int64 =
  Stdlib.Sqlite.scalarIntP (localDb ()) "SELECT count(*) AS n FROM commits" [] "n"
  |> Stdlib.Option.withDefault 0L

/// The most recent commits, newest first.
let recent (limit: Int64) : List<Commit> =
  Stdlib.Sqlite.rowsP
    (localDb ())
    "SELECT hash, message, author, origin_ts, created_at, parent FROM commits
     ORDER BY created_at DESC, rowid DESC LIMIT @p0"
    [ Stdlib.toString limit ]
    commitFromRow

/// Remove a commit row. For a commit that turned out to name no ops -- an import where everything deduped,
/// which is what a routine re-sync is. The ops side of "did it commit anything" is `PackageOps.opCountIn`;
/// this owns the table.
let delete (hash: String) : Unit =
  let _ =
    Stdlib.Sqlite.mustExec (localDb ()) "DELETE FROM commits WHERE hash = @p0" [ hash ]

  ()

/// The commit whose hash starts with <param prefix>. Newest wins if a short prefix matches more than one,
/// which is the same rule `dark ops show` uses for op ids.
let byHashPrefix (prefix: String) : Stdlib.Option.Option<Commit> =
  match
    Stdlib.Sqlite.queryOneP
      (localDb ())
      "SELECT hash, message, author, origin_ts, created_at, parent FROM commits
       WHERE hash LIKE @p0 || '%' ORDER BY created_at DESC, rowid DESC LIMIT 1"
      [ prefix ]
  with
  | Some row -> commitFromRow row
  | None -> Stdlib.Option.Option.None


/// The commits that follow <param hash> on some line. Empty when nothing does, which is what makes a
/// commit the tip of its own chain.
let children (hash: String) : List<String> =
  Stdlib.Sqlite.rowsOrEmptyP
    (localDb ())
    "SELECT hash FROM commits WHERE parent = @p0"
    [ hash ]
  |> Stdlib.List.filterMap (fun row ->
    match Stdlib.Dict.get row "hash" with
    | Some(Text h) -> Stdlib.Option.Option.Some h
    | _ -> Stdlib.Option.Option.None)

/// The op ids a commit holds.
let opIdsIn (hash: String) : List<String> =
  Stdlib.Sqlite.rowsOrEmptyP
    (localDb ())
    "SELECT id FROM package_ops WHERE commit_hash = @p0 ORDER BY origin_ts, rowid"
    [ hash ]
  |> Stdlib.List.filterMap (fun row ->
    match Stdlib.Dict.get row "id" with
    | Some(Text id) -> Stdlib.Option.Option.Some id
    | _ -> Stdlib.Option.Option.None)

/// Collapse a run of commits into one.
///
/// Mints no op, deletes no op, re-inserts no op. An op's id IS its content hash and does not move;
/// membership is `package_ops.commit_hash`, so this is an UPDATE of one column plus a row swap. That
/// is why it is safe where `WipRefresh`'s delete-and-re-insert needs its symmetry argument: there is
/// nothing here for a peer's op to fall out of.
///
/// <param run> is OLDEST FIRST and must be a parent chain whose newest member has no children, so
/// nothing outside it points at a hash this deletes. The caller selects the run; the one thing this
/// will not do is work out for itself which commits are yours, because that is the decision that
/// keeps a pulled peer's commit out of it.
let squashRun
  (run: List<Commit>)
  (message: String)
  (author: String)
  : Stdlib.Result.Result<String, String> =
  match run with
  | [] -> Stdlib.Result.Result.Error "nothing to squash"
  | [ _ ] -> Stdlib.Result.Result.Error "one commit is already one commit"
  | oldest :: _ ->
    let newest =
      run |> Stdlib.List.last |> Stdlib.Option.withDefault oldest

    let hashes = run |> Stdlib.List.map (fun c -> c.hash)

    // Anything outside the run pointing at its tip would be orphaned by the delete below.
    let outsiders =
      children newest.hash
      |> Stdlib.List.filter (fun h ->
        Stdlib.Bool.not (Stdlib.List.member hashes h))

    if Stdlib.Bool.not (Stdlib.List.isEmpty outsiders) then
      Stdlib.Result.Result.Error
        "that run is not the tip of its line; something newer follows it"
    else
      let opIds =
        hashes |> Stdlib.List.map (fun h -> opIdsIn h) |> Stdlib.List.flatten

      if Stdlib.List.isEmpty opIds then
        Stdlib.Result.Result.Error "those commits hold no ops"
      else
        let newHash = create message author opIds oldest.parent

        // By commit hash, one commit at a time. NOT by op id, not by a stamp window, and not by a
        // parent walk over ops: an op that arrived over the wire carries its AUTHOR's commit hash
        // so the receiver files it under that rather than under its own import, and any selection
        // that ignores the commit column would re-stamp a peer's op under mine. It would not lose
        // it; it would silently reattribute it.
        hashes
        |> Stdlib.List.iter (fun h ->
          let _ =
            Stdlib.Sqlite.mustExec
              (localDb ())
              "UPDATE package_ops SET commit_hash = @p0 WHERE commit_hash = @p1"
              [ newHash, h ]

          ())

        hashes |> Stdlib.List.iter (fun h -> delete h)

        Stdlib.Result.Result.Ok newHash
