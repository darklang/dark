module Darklang.SCM.Commits

// The CHECKPOINT record, and the `commits` silo.
//
// Authoring is live-on-write: an op takes effect the moment it folds, committed or not, so a commit is not a
// gate. It is the one human moment -- review what changed, let propagation run over the FINAL versions,
// surface conflicts, commit the dep-closed set -- and afterwards the answer to "what have I changed since I
// last looked".
//
// Membership is `package_ops.commit_hash` (NULL = draft). Making a commit is one action in F#
// (`SCM.Actions.commit`): the row and the stamping of its ops in one transaction, with an id minted
// from what it holds and where it sits (`LibDB.ScmActions.mintCommitHash`), so the same work committed
// onto the same history gets the same id on any machine.
//
// The reads go through one builtin, `scmCommits`, and the SQL lives with it in F# (`LibDB.ScmCommits`).

type Commit =
  { hash: String
    message: String
    originTs: String
    createdAt: String
    /// The commit this one follows on the line it was made on, or "" for the first commit in a store.
    /// Part of the hash, so a commit's id says where it sits as well as what it holds.
    parent: String
    /// A commit that records what happened to a branch rather than work: archiving one.
    housekeeping: Bool }


/// Which commits `query` is asked for.
type CommitFilter =
  /// Every commit in the store, newest first by when it was written here.
  | Recent
  /// The commits in this branch's own history, newest first. A merge moves a branch's commits to its
  /// parent.
  | OnBranch(branchId: Uuid)
  /// The commits whose hash starts with this, newest first. `%` and `_` match only themselves.
  | HashPrefix(prefix: String)
  /// The commits that name this one as their parent.
  | ChildrenOf(hash: String)


/// What `query` answers with. `total` counts every match when the limit was 0 (and `commits` is then
/// empty); otherwise it is how many commits came back.
type CommitPage =
  { total: Int64
    commits: List<Commit> }


/// The commits <param filter> selects, at most <param limit> of them; a negative limit means all of them,
/// and 0 asks only for the count.
let query(filter: CommitFilter, limit: Int64): CommitPage =
  Builtin.scmCommits(filter, limit)


/// Number of commits across the store, matching the unfiltered recent listing.
let count(): Int64 =
  (query(CommitFilter.Recent, 0)).total


/// The most recent commits, newest first.
let recent(limit: Int64): List<Commit> =
  (query(CommitFilter.Recent, limit)).commits


/// The commit whose hash starts with <param prefix>. Newest wins if a short prefix matches more than one,
/// which is the same rule `dark ops show` uses for op ids.
let byHashPrefix(prefix: String): Option<Commit> =
  Stdlib.List.head((query(CommitFilter.HashPrefix(prefix), 1)).commits)


/// The commits that follow <param hash> on some line. Empty when nothing does, which is what makes a
/// commit the tip of its own chain.
let children(hash: String): List<String> =
  (query(CommitFilter.ChildrenOf(hash), -1)).commits |> Stdlib.List.map(fun c -> c.hash)
