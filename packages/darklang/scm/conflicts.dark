module Darklang.SCM.Conflicts

// The base-agnostic conflict DETECTOR, and the `conflicts` / `sync_bases` silo.
//
// A conflict is a RECONCILIATION event: two divergent op sets folded against a common BASE -- a merge, a
// rebase, or a sync-import -- where BOTH sides rebound the same name to DIFFERENT hashes since that base.
// Superseding your own earlier version is an update, so nothing here runs on the authoring hot path.
//
// BASE-AGNOSTIC on purpose: a branch merge supplies `branch_name_bases`, a sync-import supplies
// `sync_bases`. One path, two base sources, so main-to-main sync is as conflict-aware as a branch merge.
//
// Detection never decides what APPLIES -- the fold's origin_ts LWW does. This decides what gets RECORDED.
//
// OWNS every statement against `conflicts` and `sync_bases`, plus the `locations` reads the detector needs.
// Does NOT read `package_ops`: that is `SCM.PackageOps`'s silo, which hands the op-log side here as plain
// `Binding`s. One-way, PackageOps -> Conflicts.

let localDb () : String = Stdlib.LocalStore.path ()

/// The branch this process is on. Asked of `SCM.Branches`, not of `SCM.PackageOps` (which spells the same
/// thing `currentBranch`): PackageOps depends on this module, so reaching back would close the loop.
let onBranch () : Uuid = Branches.current ()


// the shapes

/// One side's binding of a name: the hash it points at, plus the authoring stamp of the op that bound it
/// (the same `origin_ts` the fold's LWW compares).
type Binding =
  { owner: String
    modules: String
    name: String
    itemType: String
    hash: String
    originTs: String
    /// WHO wrote it, when that is known. "" for anything read out of the local projection, which does not
    /// record authorship per name; the local side of a conflict is labelled by the caller instead.
    author: String

    /// The hash this binding REPLACED, when the op said. `None` means no predecessor was recorded -- by a
    /// parser that had no store to ask, or by an op that predates bindings carrying this.
    ///
    /// Two bindings of one name that BOTH say None were each created from nothing. One that names the
    /// other's hash descends from it, which is an ordinary edit and not a conflict.
    previous: Stdlib.Option.Option<String> }

/// A recorded per-name base: the hash two sides last AGREED on. "" = the name did not exist at the base.
type NameBase =
  { owner: String
    modules: String
    name: String
    baseHash: String }

/// One competing version of a name at a reconciliation point. `side` is "local" or "incoming"; `author` is
/// a best-effort label (an identity or a source id) -- ops aren't signed yet, so it's attribution, not proof.
type Candidate =
  { side: String
    hash: String
    originTs: String
    author: String }

/// A recorded conflict. `autoResolvedTo` is the hash the deterministic fold picked; the LOSER stays here in
/// `candidates` so the choice is reviewable and reversible rather than silent.
type Conflict =
  { id: String
    owner: String
    modules: String
    name: String
    itemType: String
    kind: String
    candidates: List<Candidate>
    autoResolvedTo: String
    reason: String
    status: String
    resolvedBy: String }


// small shared helpers

/// The join key for a location across the three sides (local / incoming / base). A name can't contain "/",
/// so this is unambiguous.
let bindingKey (owner: String) (modules: String) (name: String) : String =
  $"{owner}/{modules}/{name}"

/// The human-facing dotted name for a location.
let fqn (owner: String) (modules: String) (name: String) : String =
  if modules == "" then $"{owner}.{name}" else $"{owner}.{modules}.{name}"

/// Lexical "is <param a> after <param b>". Dark's numeric operators don't span String, and both things we
/// order here (ISO stamps, hex hashes) are compared lexically by the F# fold, so route it through the same
/// ordinal ordering `Stdlib.List.sort` uses rather than inventing a second rule.
let stringGt (a: String) (b: String) : Bool =
  if a == b then
    false
  else
    match Stdlib.List.sort [ a, b ] with
    | [ lower, _ ] -> lower == b
    | _ -> false


// the auto-resolution rule (must mirror the fold exactly)

/// Does the INCOMING binding beat the LOCAL one?
///
/// THIS RULE EXISTS TWICE. `LibDB.Lww.isStale` decides the same question during the fold (the fold reaches
/// it through `PackageOpPlayback.applySetNameFrom`), and the two must agree or a recorded conflict names a
/// winner the fold did not pick. Change one, change both.
/// Both say: later stamp wins, an exact tie goes to the higher hash (portable, so every instance
/// converges), and a local binding with no stamp never defends itself.
///
/// No equal-hash case here: `detect` returns None when the hashes match. The F# side needs that case,
/// since the fold sees every op.
let incomingWins (incoming: Binding) (local: Binding) : Bool =
  if local.originTs == "" then
    true
  else if incoming.originTs == local.originTs then
    stringGt incoming.hash local.hash
  else
    stringGt incoming.originTs local.originTs

/// Why the auto-resolution picked what it did.
let resolutionReason (incoming: Binding) (local: Binding) : String =
  if local.originTs == "" then "no-local-stamp"
  else if incoming.originTs == local.originTs then "tie-break-by-hash"
  else "later-origin-ts"

/// A stable short id: the first 8 hex of sha256 over the location plus both candidate hashes, SORTED so the
/// id doesn't depend on which side happened to be local. Re-detecting the same conflict yields the same id,
/// so recording is idempotent (INSERT OR IGNORE) instead of piling up duplicate rows on every re-fold.
let conflictId
  (owner: String)
  (modules: String)
  (name: String)
  (hashes: List<String>)
  : String =
  let sorted = Stdlib.List.sort hashes
  let material = $"{owner}/{modules}/{name}|" ++ (Stdlib.String.join sorted ",")
  let digest = Stdlib.Blob.toHex (Stdlib.Crypto.sha256 (Stdlib.String.toBlob material))
  Stdlib.String.toLowercase (Stdlib.String.first digest 8)


// THE DETECTOR

/// A name conflicts when BOTH sides moved it, and there are two ways to establish that.
///
/// WITH a recorded base, the base decides: incoming != local, incoming != base, local != base.
///   - same hash          -> not a divergence at all (a re-pull, or both sides authored identical bytes).
///   - only local moved   -> our own update; the peer is simply behind.
///   - only incoming moved-> an ordinary peer update of a name we never touched. Take it, quietly.
///
/// WITHOUT one, the BINDINGS still say enough on their own, so this does not simply decline:
///   - both replaced the SAME predecessor -> two people editing one parent (`bothMovedTheSameParent`).
///   - both replaced NOTHING              -> two independent creations of one name
///                                           (`bothCreatedFromNothing`).
/// Anything else with no base is not a conflict. `None` also means "no predecessor recorded", so both
/// rules require both sides to say it; guessing from one side is what false-alarms on ordinary peer
/// updates.
let detect
  (localLabel: String)
  (incomingLabel: String)
  (local: List<Binding>)
  (incoming: List<Binding>)
  (bases: List<NameBase>)
  : List<Conflict> =
  let localEntries =
    local |> Stdlib.List.map (fun b -> (bindingKey b.owner b.modules b.name, b))

  let localByKey = Stdlib.Dict.fromListOverwritingDuplicates localEntries

  let baseEntries =
    bases |> Stdlib.List.map (fun b -> (bindingKey b.owner b.modules b.name, b.baseHash))

  let baseByKey = Stdlib.Dict.fromListOverwritingDuplicates baseEntries

  incoming
  |> Stdlib.List.filterMap (fun inc ->
    let k = bindingKey inc.owner inc.modules inc.name

    // No base: the name postdates the last agreement. Only what a binding REPLACED tells
    // creation-collision apart from one side editing the other's version; the doc above has the rule.
    let bothCreatedFromNothing =
      (inc.previous == Stdlib.Option.Option.None)
      && (inc.hash != "")

    // Both sides REPLACED the same hash and disagree about what replaced it: two people editing one
    // parent, which is a divergence whatever the recorded base says. Asked separately because the base
    // is not always the version you both agreed on -- an instance that has pushed but never pulled
    // records its bases from what it is holding, its own edit included, and then reads as unchanged.
    //
    // `Some` on BOTH sides, never None -- `None` also means "no predecessor recorded" (see the fn doc).
    //
    // An ordinary update does not match. If they edited the version you hold, their `previous` is your
    // CURRENT hash while yours is whatever came before it.
    let bothMovedTheSameParent (localBinding: Binding) : Bool =
      match (inc.previous, localBinding.previous) with
      | (Some incPrev, Some locPrev) -> (incPrev == locPrev) && (inc.hash != localBinding.hash)
      | _ -> false

    // The incoming edit was made ON TOP of what this store holds: its `previous` is the local hash.
    // That is collaboration, not divergence, whatever the recorded base says. The base arm below
    // sees both sides having moved since the last agreement and would otherwise call it a conflict:
    // a colleague pulling my edit and then editing the same fn would read as a divergence on my
    // side, resolved to the version I was about to take anyway.
    let descendsFromLocal (localBinding: Binding) : Bool =
      match inc.previous with
      | Some incPrev -> incPrev == localBinding.hash
      | None -> false

    // The record, once a rule has fired. <param kind> names WHICH rule, honestly: two people editing
    // one parent did not invent the name independently, even when no base was there to say so.
    let conflictWith (loc: Binding) (kind: String) : Conflict =
      Conflict
        { id = conflictId inc.owner inc.modules inc.name [ loc.hash, inc.hash ]
          owner = inc.owner
          modules = inc.modules
          name = inc.name
          itemType = inc.itemType
          kind = kind
          candidates =
            [ Candidate
                { side = "local"
                  hash = loc.hash
                  originTs = loc.originTs
                  author = localLabel }
              Candidate
                { side = "incoming"
                  hash = inc.hash
                  originTs = inc.originTs
                  // The op's own author when the sender told us, falling back to the source it arrived
                  // through (a relay url, say) when it didn't.
                  author = if inc.author == "" then incomingLabel else inc.author } ]
          autoResolvedTo = if incomingWins inc loc then inc.hash else loc.hash
          reason = resolutionReason inc loc
          status = "pending"
          resolvedBy = "" }

    match (Stdlib.Dict.get localByKey k, Stdlib.Dict.get baseByKey k) with
    | (Some loc, None) when
      ((bothCreatedFromNothing
        && (loc.previous == Stdlib.Option.Option.None)
        && (inc.hash != loc.hash))
       || bothMovedTheSameParent loc)
      ->
      let kind =
        if bothMovedTheSameParent loc then
          "same-name-different-hash"
        else
          "independent-creation"

      Stdlib.Option.Option.Some(conflictWith loc kind)

    | (Some loc, Some baseHash) ->
      // Lineage first: an edit on top of mine is never a conflict. Then the base test, then the
      // parent test, so a divergence the base cannot see is still caught.
      if descendsFromLocal loc then
        Stdlib.Option.Option.None
      else if
        ((inc.hash == loc.hash) || (inc.hash == baseHash) || (loc.hash == baseHash))
        && (Stdlib.Bool.not (bothMovedTheSameParent loc))
      then
        Stdlib.Option.Option.None
      else
        Stdlib.Option.Option.Some(conflictWith loc "same-name-different-hash")
    | _ -> Stdlib.Option.Option.None)


// reading the LOCAL side (the `locations` projection)

/// "@p0, @p1, ..." for an IN-list of <param values>.
let inPlaceholders (values: List<String>) : String =
  let ps =
    values
    |> Stdlib.List.indexedMap (fun i _ -> $"@p{Stdlib.Int.toString i}")

  Stdlib.String.join ps ", "

let bindingFromRow (row: Dict<String, Stdlib.Sqlite.Value>) : Stdlib.Option.Option<Binding> =
  match
    (Stdlib.Sqlite.textField row "owner",
     Stdlib.Sqlite.textField row "modules",
     Stdlib.Sqlite.textField row "name",
     Stdlib.Sqlite.textField row "item_hash")
  with
  | (Some owner, Some modules, Some name, Some hash) ->
    (Binding
      { owner = owner
        modules = modules
        name = name
        itemType =
          Stdlib.Sqlite.textField row "item_type" |> Stdlib.Option.withDefault ""
        hash = hash
        originTs = Stdlib.Sqlite.textField row "ts" |> Stdlib.Option.withDefault ""
        // `locations` records no authorship, so the local side is labelled by the caller.
        author = ""
        // Projected onto `locations` by the fold, straight off the `SetName` that wrote the row.
        previous = Stdlib.Sqlite.textField row "previous" })
    |> Stdlib.Option.Option.Some
  | _ -> Stdlib.Option.Option.None

/// How many values go into one `IN (...)`.
///
/// SQLite caps bound parameters per statement at a compile-time constant of whatever build is linked
/// (32,766 here, 999 on anything older). Crossing it ERRORS, and every caller here turns an error into
/// `[]`, which reads downstream as "no conflict" -- so nothing in this module builds an unbounded IN-list.
/// 900 stays under even the old cap, which costs nothing on these paths since none is hot. The import
/// loop chunks larger (`PackageOps.unknownRecords`), where round trips are what the size buys.
val inChunkSize = 900

/// Split <param values> into IN-list-sized chunks. Falls back to one chunk rather than dropping
/// anything, because the size is a constant and the only Error case is a non-positive one.
let inChunks (values: List<String>) : List<List<String>> =
  match Stdlib.List.chunkBySize values inChunkSize with
  | Ok cs -> cs
  | Error _ -> [ values ]

/// What this instance's fold currently binds, restricted to <param names> (the incoming side's bare names),
/// so a reconciliation never scans the whole `locations` projection. Filtering by bare name is enough of a
/// narrowing; the detector matches on the full (owner, modules, name) key anyway.
///
/// Chunked: a sync bundle can touch thousands of names. See `inChunkSize`.
///
/// main-scoped, on purpose: a sync import folds into MAIN, so main's bindings are the local side of that
/// reconciliation whatever branch the process stands on. A branch merge reads the parent's side through
/// `PackageOps.parentBindings`, which starts from this and overlays the chain.
let localBindingsFor (names: List<String>) : List<Binding> =
  match names with
  | [] -> []
  | _ ->
    Stdlib.List.unique names
    |> inChunks
    |> Stdlib.List.map (fun chunk ->
      let sql =
        "SELECT owner, modules, name, item_type, item_hash, COALESCE(origin_ts,'') AS ts,
                previous
         FROM locations
         WHERE unlisted_at IS NULL AND name IN ("
        ++ (inPlaceholders chunk)
        ++ ")"

      Stdlib.Sqlite.rowsP (localDb ()) sql chunk bindingFromRow)
    |> Stdlib.List.flatten


// reading the BASES (the two sources, one shape)

let baseFromRow (row: Dict<String, Stdlib.Sqlite.Value>) : Stdlib.Option.Option<NameBase> =
  match
    (Stdlib.Sqlite.textField row "owner",
     Stdlib.Sqlite.textField row "modules",
     Stdlib.Sqlite.textField row "name",
     Stdlib.Sqlite.textField row "base_hash")
  with
  | (Some owner, Some modules, Some name, Some baseHash) ->
    (NameBase
      { owner = owner
        modules = modules
        name = name
        baseHash = baseHash })
    |> Stdlib.Option.Option.Some
  | _ -> Stdlib.Option.Option.None

/// The bases a BRANCH recorded when it first touched each name (the parent's hash at the fork point).
let branchBases (branchId: Uuid) : List<NameBase> =
  Stdlib.Sqlite.rowsP
    (localDb ())
    "SELECT owner, modules, name, base_hash FROM branch_name_bases WHERE branch_id = @p0"
    [ Stdlib.Uuid.toString branchId ]
    baseFromRow

/// The bases recorded for a SYNC SOURCE: the hashes this instance and that source last agreed on.
let syncBases (sourceId: String) : List<NameBase> =
  Stdlib.Sqlite.rowsP
    (localDb ())
    "SELECT owner, modules, name, base_hash FROM sync_bases WHERE source_id = @p0"
    [ sourceId ]
    baseFromRow

/// Has this instance ever recorded agreement with <param sourceId>? A first sync has none, which is why a
/// first sync can't (and shouldn't) report conflicts.
let hasSyncBases (sourceId: String) : Bool =
  let n =
    Stdlib.Sqlite.scalarIntP
      (localDb ())
      "SELECT count(*) AS n FROM sync_bases WHERE source_id = @p0"
      [ sourceId ]
      "n"

  (Stdlib.Option.withDefault n 0L) > 0L

/// Record agreement with <param sourceId> for EVERY name this instance currently binds, in one statement.
/// The bulk-import path: adopting a whole log wholesale is exactly "we now agree on everything I hold", and
/// decoding every op blob in Dark just to narrow the list would cost far more than it buys.
///
/// main-scoped, on purpose: what was adopted folded into main, and the bases say what main and the
/// source now agree on.
let recordAllSyncBases (sourceId: String) : Unit =
  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      "INSERT INTO sync_bases (source_id, owner, modules, name, base_hash)
       SELECT @p0, owner, modules, name, item_hash FROM locations WHERE unlisted_at IS NULL
       ON CONFLICT(source_id, owner, modules, name)
       DO UPDATE SET base_hash = excluded.base_hash, updated_at = datetime('now')"
      [ sourceId ]

  ()


// the `conflicts` table (record / read / resolve)

let conflictFromRow (row: Dict<String, Stdlib.Sqlite.Value>) : Stdlib.Option.Option<Conflict> =
  match Stdlib.Sqlite.textField row "id" with
  | Some id ->
    let candidates =
      match Stdlib.Json.parse<List<Candidate>> (Stdlib.Sqlite.textOr row "candidates") with
      | Ok cs -> cs
      | Error _ -> []

    (Conflict
      { id = id
        owner = Stdlib.Sqlite.textOr row "owner"
        modules = Stdlib.Sqlite.textOr row "modules"
        name = Stdlib.Sqlite.textOr row "name"
        itemType = Stdlib.Sqlite.textOr row "item_type"
        kind = Stdlib.Sqlite.textOr row "kind"
        candidates = candidates
        autoResolvedTo = Stdlib.Sqlite.textOr row "auto_resolved_to"
        reason = Stdlib.Sqlite.textOr row "reason"
        status = Stdlib.Sqlite.textOr row "status"
        resolvedBy = Stdlib.Sqlite.textOr row "resolved_by" })
    |> Stdlib.Option.Option.Some
  | None -> Stdlib.Option.Option.None

/// Record conflicts against <param branchId> as `pending`. Returns how many of them the store accepted
/// without error -- one per conflict, since each is its own batch, and an `INSERT OR IGNORE` that
/// deduped counts as accepted.
///
/// INSERT OR IGNORE on the content-derived id, so re-detecting the same divergence is a no-op and an
/// already-acked conflict is never quietly reopened. When the id already exists on a DIFFERENT branch
/// and is still pending, the row is re-parented rather than left where it was: a rebase records the
/// divergence against the branch, and the merge that follows re-detects the same pair against the
/// parent; without this the parent's list never showed it, and re-minting an id would have split one
/// divergence into two.
///
/// The branch is a PARAMETER, not read from the process: a sync import folds into main, while a merge
/// folds into the PARENT of the branch being merged.
///
/// Counted rather than discarded, because the CLI promises "the losing version is kept, not dropped" off
/// the back of this: a caller compares the count against what it handed in and warns when they differ.
let record (branchId: Uuid) (conflicts: List<Conflict>) : Int =
  conflicts
  |> Stdlib.List.fold 0 (fun written c ->
    match
      Stdlib.Sqlite.execBatch
        (localDb ())
        [ ("INSERT OR IGNORE INTO conflicts
              (id, owner, modules, name, item_type, kind, candidates, auto_resolved_to, reason, status, origin_ts, branch_id)
            VALUES (@p0, @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, 'pending',
                    strftime('%Y-%m-%dT%H:%M:%fZ','now'), @p9)",
           [ [ c.id
               c.owner
               c.modules
               c.name
               c.itemType
               c.kind
               Stdlib.Json.serialize<List<Candidate>> c.candidates
               c.autoResolvedTo
               c.reason
               Stdlib.Uuid.toString branchId ] ])
          ("UPDATE conflicts SET branch_id = @p0 WHERE id = @p1 AND status = 'pending'",
           [ [ Stdlib.Uuid.toString branchId, c.id ] ]) ]
    with
    | Ok _ -> written + 1
    | Error _ -> written)

/// Conflicts awaiting a human ON THIS BRANCH, oldest first.
///
/// Scoped, because a conflict is a divergence in one line of work: settling main's while standing on a
/// branch would write the answer into an overlay where it does nothing until merge, and settling a
/// branch's from main would answer for a projection that hasn't happened yet. Each branch sees its own.
let pending () : List<Conflict> =
  let recorded =
    Stdlib.Sqlite.rowsP
      (localDb ())
      "SELECT id, owner, modules, name, item_type, kind, candidates, auto_resolved_to, reason, status,
              COALESCE(resolved_by,'') AS resolved_by
       FROM conflicts WHERE status = 'pending' AND branch_id = @p0 ORDER BY created_at"
      [ Stdlib.Uuid.toString (onBranch ()) ]
      conflictFromRow

  // A conflict whose name has since been bound to something that is NEITHER candidate was settled by
  // events, not by a person: an override's cascade repointed the callers, or a later edit moved on. Left
  // pending it asks for a choice between two versions nobody runs any more. Settled here, at the point
  // it is noticed, and recorded under what superseded it.
  let branchId = onBranch ()

  recorded
  |> Stdlib.List.filter (fun c ->
    let loc = Deps.locationOf c.owner c.modules c.name

    match PackageOps.liveBindingFor branchId loc with
    | Some live ->
      let stillACandidate = c.candidates |> Stdlib.List.any (fun cand -> cand.hash == live.hash)

      if stillACandidate then
        true
      else
        setStatus c.id "superseded" live.hash
        false
    | None -> true)

/// How many conflicts are waiting -- the number `dark status` and `dark commit` surface. Runs the same
/// sweep as `pending`, so the count and the list never disagree about a superseded one.
let pendingCount () : Int64 =
  Stdlib.Int.toInt64 (Stdlib.List.length (pending ())) |> Stdlib.Option.withDefault 0L

/// The conflict on THIS branch whose id starts with <param rawPrefix> (ids are short already; a prefix
/// keeps them typeable).
///
/// Branch-scoped like `pending`, so the ids you can act on are exactly the ids you were just shown -- an
/// unscoped lookup would let an id pasted from main's list resolve while standing on a branch.
let getByIdPrefix (rawPrefix: String) : Stdlib.Option.Option<Conflict> =
  // `dark conflicts` prints ids as `#509907c8`, so a copy-paste brings the `#` along. Accept what we print.
  let idPrefix =
    if Stdlib.String.startsWith rawPrefix "#" then
      Stdlib.String.dropFirst rawPrefix 1
    else
      rawPrefix

  // A NAME is accepted as well as an id, because the name is what the list puts in front of you and what
  // you were working on; making you copy a hex id to act on `Stachu.Thing.foo` is a step for the
  // machine's benefit. Matched as owner.modules.name so a fully-dotted name is unambiguous, and only
  // among THIS branch's pending ones.
  match
    Stdlib.Sqlite.queryP
      (localDb ())
      "SELECT id, owner, modules, name, item_type, kind, candidates, auto_resolved_to, reason, status,
              COALESCE(resolved_by,'') AS resolved_by
       FROM conflicts
       WHERE (id LIKE @p0 || '%'
              OR (owner || '.' || modules || '.' || name) = @p0
              OR name = @p0)
         AND branch_id = @p1
       ORDER BY created_at LIMIT 1"
      [ idPrefix, Stdlib.Uuid.toString (onBranch ()) ]
  with
  | Ok [ row ] -> conflictFromRow row
  | _ -> Stdlib.Option.Option.None

/// Close a conflict: 'acked' (the auto-pick stands) or 'overridden' (a resolution op took over).
let setStatus (id: String) (status: String) (resolvedBy: String) : Unit =
  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      "UPDATE conflicts SET status = @p1, resolved_by = @p2 WHERE id = @p0"
      [ id, status, resolvedBy ]

  ()


// rendering (one place, so pretty and --json never drift)

let shortHash (h: String) : String =
  if h == "" then "(none)"
  else if Stdlib.String.length h <= 8 then h
  else Stdlib.String.first h 8

let candidateFor (c: Conflict) (side: String) : Stdlib.Option.Option<Candidate> =
  Stdlib.List.findFirst c.candidates (fun cand -> cand.side == side)

/// One line per conflict: the name, which side the fold kept, and the id to inspect with.
let summaryLine (c: Conflict) : String =
  let kept =
    match candidateFor c "local" with
    | Some local -> if local.hash == c.autoResolvedTo then "kept yours" else "took theirs"
    | None -> "auto"

  let dotted = fqn c.owner c.modules c.name
  $"  #{c.id}  {dotted}   auto: {kept} ({c.reason})   [{c.status}]"

/// The full block for one conflict: both candidates, the auto-pick, and why.
let detailLines (c: Conflict) : List<String> =
  let dotted = fqn c.owner c.modules c.name

  let candidateLines =
    c.candidates
    |> Stdlib.List.map (fun cand ->
      let mark = if cand.hash == c.autoResolvedTo then "kept" else "over"
      let who = if cand.author == "" then cand.side else $"{cand.side} ({cand.author})"
      $"    {mark}  {who}  hash {shortHash cand.hash}  stamped {cand.originTs}")

  Stdlib.List.append
    [ $"  #{c.id}  {dotted}  [{c.itemType}] -- two live versions" ]
    (Stdlib.List.append
      candidateLines
      [ $"    auto-resolution: {shortHash c.autoResolvedTo}, by {c.reason}" ])
