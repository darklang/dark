module Darklang.SCM.Conflicts

// The base-agnostic conflict DETECTOR, and the `conflicts` silo.
//
// A conflict is a RECONCILIATION event: two divergent op sets folded against a common BASE -- a merge or
// a rebase -- where BOTH sides rebound the same name to DIFFERENT hashes since that base.
// Superseding your own earlier version is an update, so nothing here runs on the authoring hot path.
//
// BASE-AGNOSTIC on purpose: the detector takes its bases as a parameter, so a branch merge supplies
// `branch_name_bases` and anything else that reconciles two op sets can supply its own.
//
// Detection never decides what APPLIES -- the fold's origin_ts LWW does. It decides what gets RECORDED,
// and it lives in F# beside that rule (`LibDB.ScmDetect`), so the winner a conflict names and the
// winner the fold picks are one answer. Merge and rebase detect and record in F#; this module holds the
// shapes, the reads, and how a conflict is shown.


/// The branch this process is on. Asked of `SCM.Branches`, not of `SCM.PackageOps` (which spells the same
/// thing `currentBranch`): PackageOps depends on this module, so reaching back would close the loop.
let onBranch(): Uuid = Branches.current()


// the shapes

/// One side's binding of a name: the hash it points at, plus the authoring stamp of the op that bound it
/// (the same `origin_ts` the fold's LWW compares).
type Binding =
  { owner: String
    modules: String
    name: String
    itemType: String
    hash: String
    originTs: String
    /// WHO wrote it, when that is known. "" for anything read out of the local projection, which does not
    /// record authorship per name; the local side of a conflict is labelled by the caller instead.
    author: String

    /// The hash this binding REPLACED, when the op said. `None` means no predecessor was recorded -- by a
    /// parser that had no store to ask, or by an op that predates bindings carrying this.
    ///
    /// Two bindings of one name that BOTH say None were each created from nothing. One that names the
    /// other's hash descends from it, which is an ordinary edit and not a conflict.
    previous: Stdlib.Option.Option<String> }

/// A name ENDING, as the other side told it. `dark rename` authors one of these for the old name.
///
/// Not a `Binding` with an empty hash: a removal binds nothing, and every reader of `Binding` would
/// then have to know about a case that has no version to offer.
type Removal =
  { owner: String
    modules: String
    name: String
    originTs: String
    author: String
    /// What the name held when it was ended. A removal of exactly what you hold is an ordinary
    /// removal; a removal of something you have since edited is the divergence.
    previous: Stdlib.Option.Option<String> }

/// A recorded per-name base: the hash two sides last AGREED on. "" = the name did not exist at the base.
type NameBase =
  { owner: String
    modules: String
    name: String
    baseHash: String }

/// One competing version of a name at a reconciliation point. `side` is "local" or "incoming"; `author` is
/// a best-effort label (an identity or a source id) -- ops aren't signed yet, so it's attribution, not proof.
type Candidate =
  { side: String
    hash: String
    /// This side ENDED the name rather than binding it. `hash` is empty, and there is nothing to
    /// take but the removal itself.
    removed: Bool
    /// The competing TEXT, for a divergence whose sides are prose rather than versions. Empty for a
    /// name divergence, where the hash is what identifies a side and the text is the item itself.
    text: String
    originTs: String
    author: String }

/// A recorded conflict. `autoResolvedTo` is the hash the deterministic fold picked; the LOSER stays here in
/// `candidates` so the choice is reviewable and reversible rather than silent.
type Conflict =
  { id: String
    owner: String
    modules: String
    name: String
    itemType: String
    /// WHICH part of the declaration, for a doc divergence: "item", "record-field:x",
    /// "enum-case:X", "parameter:0". Empty for a name divergence, which is about the whole binding.
    part: String
    kind: String
    candidates: List<Candidate>
    autoResolvedTo: String
    reason: String
    status: String
    resolvedBy: String }


/// What `query` is asked. Branch-scoped cases take the branch; the rest read every branch.
type ConflictFilter =
  /// Conflicts awaiting a human on this branch, oldest first.
  | Pending of branchId: Uuid
  /// The one conflict on this branch whose id starts with the reference, or whose name (dotted, or
  /// bare) is that. Pending ones first, then oldest. At most one comes back.
  | ByRef of reference: String * branchId: Uuid
  /// The acked records that are not name conflicts: the constraint acks. Only `id` is filled.
  | AckedConstraints
  /// Whether anything was ever overridden: at most one row, only `id` filled.
  | AnyOverridden

/// One row of the `conflicts` table as the store holds it. `candidates` is the stored JSON, parsed by
/// `conflictFromRow`. Fields a filter doesn't fill are "".
type ConflictRow =
  { id: String
    owner: String
    modules: String
    name: String
    itemType: String
    part: String
    kind: String
    candidates: String
    autoResolvedTo: String
    reason: String
    status: String
    resolvedBy: String }

/// The recorded conflicts <param filter> selects.
let query(filter: ConflictFilter): List<ConflictRow> = Builtin.scmConflicts(filter)


// small shared helpers

/// The join key for a location across the three sides (local / incoming / base). A name can't contain "/",
/// so this is unambiguous.
let bindingKey(owner: String, modules: String, name: String): String =
  $"{owner}/{modules}/{name}"

/// The human-facing dotted name for a location.
let fqn(owner: String, modules: String, name: String): String =
  if modules == "" then $"{owner}.{name}" else $"{owner}.{modules}.{name}"

// the auto-resolution rule

/// Does the thing stamped <param aTs> / hashed <param aHash> beat the one stamped
/// <param bTs> / hashed <param bHash>?
///
/// The fold's own rule (`LibExecution.Lww`), asked rather than restated: later stamp wins, an exact tie
/// goes to the higher hash, and a side with no stamp never defends itself. Two implementations of one
/// trait for one type are settled by it too (`SCM.Constraints`).
let beats(aTs: String, aHash: String, bTs: String, bHash: String): Bool =
  SCM.Actions.beats(aTs, aHash, bTs, bHash)


// THE DETECTOR (in F#: `LibDB.ScmDetect`)

/// The conflicts between what this side binds (<param local>) and what arrives (<param incoming>),
/// tested against the bases they last agreed on: a name conflicts when BOTH sides moved it since its
/// base, or, with no base, when both created it or both edited one parent. An edit made on top of the
/// local version never conflicts. Each conflict names the winner the fold will pick.
let detect(
  localLabel: String,
  incomingLabel: String,
  local: List<Binding>,
  incoming: List<Binding>,
  bases: List<NameBase>)
  : List<Conflict> =
  SCM.Actions.detect(
    SCM.Actions.DetectRequest
      { localLabel = localLabel
        incomingLabel = incomingLabel
        local = local
        incoming = incoming
        bases = bases
        removals = [] })


/// A removal that arrives for a name you have SINCE edited. A removal of exactly what you hold
/// records nothing.
let detectRemovals(
  localLabel: String,
  incomingLabel: String,
  local: List<Binding>,
  removals: List<Removal>)
  : List<Conflict> =
  SCM.Actions.detect(
    SCM.Actions.DetectRequest
      { localLabel = localLabel
        incomingLabel = incomingLabel
        local = local
        incoming = []
        bases = []
        removals = removals })


// reading the LOCAL side (the `locations` projection)

/// A binding read out of the `locations` projection, as a conflict's local side.
let bindingOf(row: SCM.Bindings.BindingRow): Binding =
  Binding
    { owner = row.owner
      modules = row.modules
      name = row.name
      itemType = row.itemType
      hash = row.hash
      originTs = row.originTs
      // `locations` records no authorship, so the caller labels the local side.
      author = ""
      // Projected onto `locations` by the fold, off the `SetName` that wrote it.
      previous = row.previous }

/// What this instance's fold currently binds, restricted to <param names> (the incoming side's bare names),
/// so a reconciliation never scans the whole `locations` projection. Filtering by bare name is enough of a
/// narrowing; the detector matches on the full (owner, modules, name) key anyway.
///
/// main-scoped, on purpose: a sync import folds into MAIN, so main's bindings are the local side of that
/// reconciliation whatever branch the process stands on. A branch merge reads the parent's side through
/// `PackageOps.parentBindings`, which starts from this and overlays the chain.
let localBindingsFor(names: List<String>): List<Binding> =
  match names with
  | [] -> []
  | _ ->
    SCM.Bindings.query(
      SCM.Bindings.BindingFilter.MainByBareNames(Stdlib.List.unique(names))
    )
    |> Stdlib.List.map(bindingOf)


// reading the BASES (the two sources, one shape)

/// The bases a BRANCH recorded when it first touched each name (the parent's hash at the fork point).
let branchBases(branchId: Uuid): List<NameBase> = SCM.Branches.baseRecords(branchId)


// the `conflicts` table (record / read / resolve)

/// A stored row as a `Conflict`. Candidates that don't parse read as none, as they always have.
let conflictFromRow(row: ConflictRow): Conflict =
  let candidates =
    match Stdlib.Json.parse<List<Candidate>>(row.candidates) with
    | Ok(cs) -> cs
    | Error(_) -> []

  Conflict
    { id = row.id
      owner = row.owner
      modules = row.modules
      name = row.name
      itemType = row.itemType
      part = row.part
      kind = row.kind
      candidates = candidates
      autoResolvedTo = row.autoResolvedTo
      reason = row.reason
      status = row.status
      resolvedBy = row.resolvedBy }

/// Settle a wording disagreement by SAYING the chosen text, and close the record.
///
/// An op, not a local opinion: it syncs, a peer folding it lands on the same wording, and re-folding
/// the ops that caused the divergence cannot quietly undo it. `previous` names the text being
/// replaced, so the op reads as an ordinary edit made on top of what this store holds -- which is
/// exactly what it is, once a person has looked at both.
let settleWording(
  branchId: Uuid,
  c: Conflict,
  text: String)
  : Stdlib.Result.Result<Unit, String> =
  match SCM.Actions.resolve(SCM.Actions.Resolution.Reword(branchId, c.id, text)) with
  | Ok(_) -> Stdlib.Result.Result.Ok()
  | Error(Refused(UnreadablePart(part))) ->
    Stdlib.Result.Result.Error($"#{c.id} names a part this build cannot read: {part}")
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


/// Is this conflict about WHICH VERSION a name holds?
///
/// The two divergence kinds are; a `doc-divergence` is about the prose said on one piece of content,
/// and its candidates are hashes of text rather than of items. Anything keyed on the live binding
/// has to ask this first.
let aboutABinding(kind: String): Bool =
  Stdlib.List.contains(
    [ "same-name-different-hash", "independent-creation", "removed-vs-edited" ],
    kind)


/// Conflicts awaiting a human ON THIS BRANCH, oldest first.
///
/// Scoped, because a conflict is a divergence in one line of work: settling main's while standing on a
/// branch would write the answer into an overlay where it does nothing until merge, and settling a
/// branch's from main would answer for a projection that hasn't happened yet. Each branch sees its own.
let pending(): List<Conflict> =
  let recorded =
    query(ConflictFilter.Pending(onBranch())) |> Stdlib.List.map(conflictFromRow)

  // A conflict whose name has since been bound to something that is NEITHER candidate was settled by
  // events, not by a person: an override's cascade repointed the callers, or a later edit moved on. Left
  // pending it asks for a choice between two versions nobody runs any more. Settled here, at the point
  // it is noticed, and recorded under what superseded it.
  let branchId = onBranch()

  let liveByName =
    PackageOps.liveBindingsFor(
      branchId,
      (recorded
       |> Stdlib.List.filter(fun c -> aboutABinding(c.kind))
       |> Stdlib.List.map(fun c -> Deps.locationOf(c.owner, c.modules, c.name))))

  recorded
  |> Stdlib.List.filter(fun c ->
    // The sweep asks "does the name still hold one of these versions", so it only applies to a
    // conflict that is ABOUT which version a name holds. A `doc-divergence` is about the prose on a
    // piece of content: its candidates are hashes of TEXT, which no binding will ever equal, so
    // sweeping it superseded every one of them the moment it was noticed and none was ever shown.
    if Stdlib.Bool.not(aboutABinding(c.kind)) then
      true
    else
      match Stdlib.Dict.get(liveByName, bindingKey(c.owner, c.modules, c.name)) with
      | Some(live) ->
        let stillACandidate =
          c.candidates |> Stdlib.List.any(fun cand -> cand.hash == live.hash)

        if stillACandidate then
          true
        else
          // Shown only once the record says so: a close that did not land leaves it pending, and
          // the next read sweeps it again.
          match supersede(c.id, live.hash) with
          | Ok(_) -> false
          | Error(_) -> true
      | None -> true)

/// How many conflicts are waiting -- the number `dark status` and `dark commit` surface. Runs the same
/// sweep as `pending`, so the count and the list never disagree about a superseded one.
let pendingCount(): Int64 =
  Stdlib.Int.toInt64(Stdlib.List.length(pending())) |> Stdlib.Option.withDefault(0L)

/// The conflict on THIS branch whose id starts with <param rawPrefix> (ids are short already; a prefix
/// keeps them typeable).
///
/// Branch-scoped like `pending`, so the ids you can act on are exactly the ids you were just shown -- an
/// unscoped lookup would let an id pasted from main's list resolve while standing on a branch.
let getByIdPrefix(rawPrefix: String): Stdlib.Option.Option<Conflict> =
  // `dark conflicts` prints ids as `#509907c8`, so a copy-paste brings the `#` along. Accept what we print.
  let idPrefix =
    if Stdlib.String.startsWith(rawPrefix, "#") then
      Stdlib.String.dropFirst(rawPrefix, 1)
    else
      rawPrefix

  // A NAME is accepted as well as an id, because the name is what the list puts in front of you and what
  // you were working on; making you copy a hex id to act on `Stachu.Thing.foo` is a step for the
  // machine's benefit. Matched as owner.modules.name so a fully-dotted name is unambiguous, and only
  // among THIS branch's conflicts, pending ones first.
  match query(ConflictFilter.ByRef(idPrefix, onBranch())) with
  | [ row ] -> Stdlib.Option.Option.Some(conflictFromRow(row))
  | _ -> Stdlib.Option.Option.None

/// Close a conflict as ACKED: the auto-pick stands. An Error says the record is still open.
let ack(id: String): Stdlib.Result.Result<Unit, String> =
  match SCM.Actions.resolve(SCM.Actions.Resolution.Ack(id)) with
  | Ok(_) -> Stdlib.Result.Result.Ok()
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))

/// Close a conflict as SUPERSEDED: the name has since moved to <param liveHash>, which is neither side.
/// An Error says the record is still open.
let supersede(id: String, liveHash: String): Stdlib.Result.Result<Unit, String> =
  match SCM.Actions.resolve(SCM.Actions.Resolution.Supersede(id, liveHash)) with
  | Ok(_) -> Stdlib.Result.Result.Ok()
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


// rendering (one place, so pretty and --json never drift)

let shortHash(h: String): String =
  if h == "" then "(none)"
  else if Stdlib.String.length(h) <= 8 then h
  else Stdlib.String.first(h, 8)

let candidateFor(c: Conflict, side: String): Stdlib.Option.Option<Candidate> =
  Stdlib.List.findFirst(c.candidates, fun cand -> cand.side == side)

/// One line per conflict: the name, which side the fold kept, and the id to inspect with.
let summaryLine(c: Conflict): String =
  let kept =
    match candidateFor(c, "local") with
    | Some(local) -> if local.hash == c.autoResolvedTo then "kept yours" else "took theirs"
    | None -> "auto"

  let dotted = fqn(c.owner, c.modules, c.name)
  $"  #{c.id}  {dotted}   auto: {kept} ({c.reason})   [{c.status}]"

/// The full block for one conflict: both candidates, the auto-pick, and why.
///
/// A wording disagreement shows the TEXTS. A hash is what identifies a version, and a sentence is
/// what identifies a wording -- printing `shortHash` of a sentence tells a reader nothing they can
/// act on, and acting on it is the point of the screen.
let detailLines(c: Conflict): List<String> =
  let dotted = fqn(c.owner, c.modules, c.name)

  let candidateLines =
    c.candidates
    |> Stdlib.List.map(fun cand ->
      let mark = if cand.hash == c.autoResolvedTo then "kept" else "over"
      let who = if cand.author == "" then cand.side else $"{cand.side} ({cand.author})"
      let what =
        if cand.removed then
          "REMOVED the name"
        else if cand.text == "" then
          $"hash {shortHash(cand.hash)}"
        else
          $"\"{cand.text}\""

      $"    {mark}  {who}  {what}  stamped {cand.originTs}")

  let header =
    if aboutABinding(c.kind) then
      $"  #{c.id}  {dotted}  [{c.itemType}] -- two live versions"
    else
      $"  #{c.id}  {dotted}  [{c.part}] -- two wordings"

  let footer =
    if c.autoResolvedTo == "" then
      $"    auto-resolution: the name is gone, by {c.reason}"
    else if aboutABinding(c.kind) then
      $"    auto-resolution: {shortHash(c.autoResolvedTo)}, by {c.reason}"
    else
      $"    auto-resolution: by {c.reason}"

  Stdlib.List.prepend(Stdlib.List.append(candidateLines, footer), header)
