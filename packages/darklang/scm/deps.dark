module Darklang.SCM.Deps

// The `package_dependencies` data-access silo: who references whom.
//
// The edges are recorded per item hash with the user-typed FQN alongside, which is what lets two distinct
// names that happen to share a hash stay distinct here. That distinction is load-bearing: identical content
// IS one item, so a hash routinely lives at several names, and collapsing them loses dependents.
//
// The reads go through one builtin, `scmDeps`, and the SQL lives with it in F# (`LibDB.ScmDeps`). What to
// make of the answer -- main versus branch, which name a hash goes by -- stays here.


/// What `query` is asked. Names are spelled as the store spells them: modules joined by ".", and a kind
/// as `ItemKind.toString` writes it.
type DepQuery =
  /// What one item references, as distinct (hash, kind) pairs.
  | Of of hash: String
  /// What one item references, with the name each edge recorded. Edges with no name are left out.
  | EdgesOf of hash: String
  /// Every edge out of these items, in the order they were recorded. A missing name reads as "".
  | EdgesOfAll of hashes: List<String>
  /// The names one item references, skipping edges with no name.
  | NamesOf of hash: String
  /// The names referenced by whatever MAIN binds at this fully-qualified name.
  | NamesOfFqn of fqn: String
  /// The distinct hashes these items reference.
  | Closure of hashes: List<String>
  /// Who references this name, with the name MAIN binds each of them at. Main-scoped.
  | Dependents of kind: String * owner: String * modules: String * name: String
  /// Who references this name, by hash only, so branch-authored dependents are included.
  | DependentHashes of kind: String * owner: String * modules: String * name: String
  /// The other names dependents wrote for the content `hash`, besides the one given.
  | RenamedAway of
    hash: String *
    kind: String *
    owner: String *
    modules: String *
    name: String
  /// Whether anything references this hash: at most one edge comes back.
  | Referenced of hash: String
  /// Every live item on main whose edge points at a version its name no longer holds.
  | Outdated
  /// Everything that transitively references an old version of each seed, given as
  /// (owner, modules, name, current hash), tagged with the seed's index.
  | StaleBySeed of seeds: List<(String * String * String * String)>


/// One recorded edge. Which fields a query fills is said on its case; the rest are "" (or 0).
type DepEdge =
  { /// The item holding the reference.
    itemHash: String
    /// Where main binds that item, when the query looked it up.
    itemType: String
    owner: String
    modules: String
    name: String
    /// What it references, as the edge recorded it.
    dependsOnHash: String
    dependsOnType: String
    dependsOnOwner: String
    dependsOnModules: String
    dependsOnName: String
    /// `Outdated` only: what the referenced name holds now.
    currentHash: String
    currentType: String
    /// `StaleBySeed` only: the index of the seed this item was reached from.
    seed: Int64 }


/// The recorded dependency edges <param q> asks for.
let query(q: DepQuery): List<DepEdge> = Builtin.scmDeps(q)


/// The `item_type` column, which only ever holds what `ItemKind.toString` wrote.
// CLEANUP: a string `toString` would not have written reads as `Fn`, which is a guess. It should
// either raise, or this should return a `Result` or an `Option` and make the six callers say what
// they want done. Left as a default for now because the column has one writer, so it cannot
// currently fire; this is the one place to change when that stops being true.
let kindOf(s: String): LanguageTools.ProgramTypes.ItemKind =
  LanguageTools.ProgramTypes.ItemKind.fromString(s)
  |> Stdlib.Option.withDefault(LanguageTools.ProgramTypes.ItemKind.Fn)

let locationOf(
  owner: String,
  modules: String,
  name: String)
  : LanguageTools.ProgramTypes.PackageLocation =
  let mods = if modules == "" then [] else Stdlib.String.split(modules, ".")

  LanguageTools.ProgramTypes.PackageLocation
    { owner = owner, modules = mods, name = name }

/// Everything <param source> references (forward dependencies), as (hash, kind).
let dependenciesOf(
  source: LanguageTools.ProgramTypes.Hash)
  : List<(LanguageTools.ProgramTypes.Hash * String)> =
  query(DepQuery.Of(LanguageTools.ProgramTypes.hashToString(source)))
  |> Stdlib.List.map(fun e ->
    (LanguageTools.ProgramTypes.Hash.Hash(e.dependsOnHash), e.dependsOnType))

/// The branch chain's own bindings as (hash, location, kind), or [] on main.
///
/// Computed ONCE per call that needs it and passed down. `chainBindings` is a recursive walk up the
/// parent chain over every op the chain holds, so asking it per dependent turns one query into one per
/// caller of the thing you asked about.
let branchOverlayBindings(
  )
  : List<(String * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  match SCM.PackageOps.currentBranch() with
  | id when SCM.Branch.isMain(id) -> []
  | branch ->
    SCM.PackageOps.chainBindings(branch)
    |> Stdlib.List.map(fun b ->
      (b.hash, locationOf(b.owner, b.modules, b.name), kindOf(b.itemType)))


/// The hash <param loc> holds as a <param kind> on the current branch, if anything.
let hashAt(
  loc: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind)
  : Stdlib.Option.Option<String> =
  let branchId = SCM.PackageOps.currentBranch()

  let found =
    match kind with
    | Fn -> LanguageTools.PackageManager.Function.find(branchId, loc)
    | Type -> LanguageTools.PackageManager.Type.find(branchId, loc)
    | Value -> LanguageTools.PackageManager.Value.find(branchId, loc)
    | Trait -> LanguageTools.PackageManager.Trait.find(branchId, loc)
    | TraitImpl -> LanguageTools.PackageManager.TraitImpl.find(branchId, loc)
    | Test -> LanguageTools.PackageManager.Test.find(branchId, loc)

  found |> Stdlib.Option.map(LanguageTools.ProgramTypes.hashToString)


/// Names that dependents wrote for what <param loc> holds now, and that no longer hold it: what a
/// rename leaves on every edge written before it, since an edge keeps the name its dependent typed.
///
/// A name that still holds the same content is NOT one of these. Identical content is one item, so
/// it can be live at another name too, and an edge written against that name belongs to it; counting
/// it here would let one name's callers block deleting the other.
///
/// Follows only the content <param loc> holds NOW, so an edge written against an older version
/// under the old name (renamed, then edited) is still not found.
let renamedAwayNames(
  loc: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind)
  : List<LanguageTools.ProgramTypes.PackageLocation> =
  match hashAt(loc, kind) with
  | None -> []
  | Some(h) ->
    query(
      DepQuery.RenamedAway(
        h,
        LanguageTools.ProgramTypes.ItemKind.toString(kind),
        loc.owner,
        Stdlib.String.join(loc.modules, "."),
        loc.name
      )
    )
    |> Stdlib.List.map(fun e ->
      locationOf(e.dependsOnOwner, e.dependsOnModules, e.dependsOnName))
    |> Stdlib.List.filter(fun old -> hashAt(old, kind) != Stdlib.Option.Option.Some(h))


/// `dependentsOf` for exactly the names given, by the name each edge recorded.
let dependentsByName(
  targets: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  let overlay = branchOverlayBindings()

  targets
  |> Stdlib.List.map(fun target ->
    let (loc, kind) = target
    let modules = Stdlib.String.join(loc.modules, ".")
    let kindName = LanguageTools.ProgramTypes.ItemKind.toString(kind)

    // TWO queries, not a join and not one per caller.
    //
    // A join to `locations` answers about MAIN: a branch-authored item has no row there, so the join
    // drops it and the list comes back looking complete. The edge is always there -- the fold records
    // `package_dependencies` for a branch's ops like any other -- so only the name is missing.
    //
    // Resolving every dependent through the overlay instead would be correct and slow: an item with
    // four hundred callers pays four hundred lookups where a join did one. So main answers by join, and
    // only the hashes the join could not name are looked up in the overlay, which on a branch is a
    // handful and on main is none.
    let mainResolved =
      // main-scoped: main's half, by join; the overlay half below answers for the branch.
      query(DepQuery.Dependents(kindName, loc.owner, modules, loc.name))
      |> Stdlib.List.map(fun e ->
        (LanguageTools.ProgramTypes.Hash.Hash(e.itemHash),
         locationOf(e.owner, e.modules, e.name),
         kindOf(e.itemType)))

    if Stdlib.List.isEmpty(overlay) then
      mainResolved
    else
      // Main's row for a name the chain has REBOUND is main's version of that caller, not this branch's:
      // the branch re-authored it, and whether the new version still depends on the target is what the
      // overlay half below answers. Keyed by name, not hash: one hash at two names with only one of them
      // rebound keeps the other.
      let mainResolved =
        mainResolved
        |> Stdlib.List.filter(fun d ->
          match d with
          | (h, dloc, _) ->
            let hs = LanguageTools.ProgramTypes.hashToString(h)
            overlay
            |> Stdlib.List.findFirst(fun entry ->
              match entry with
              | (oh, oloc, _) -> (oloc == dloc) && (oh != hs))
            |> Stdlib.Option.isNone)

      let named =
        mainResolved
        |> Stdlib.List.map(fun d ->
          match d with
          | (h, _, _) -> LanguageTools.ProgramTypes.hashToString(h))

      let fromOverlay =
        query(DepQuery.DependentHashes(kindName, loc.owner, modules, loc.name))
        |> Stdlib.List.filterMap(fun e ->
          let h = e.itemHash
          if Stdlib.List.contains(named, h) then
            Stdlib.Option.Option.None
          else
            overlay
            |> Stdlib.List.findFirst(fun entry ->
              match entry with
              | (oh, _, _) -> oh == h)
            |> Stdlib.Option.map(fun entry ->
              match entry with
              | (oh, oloc, okind) ->
                (LanguageTools.ProgramTypes.Hash.Hash(oh), oloc, okind)))

      Stdlib.List.concat(mainResolved, fromOverlay))
  |> Stdlib.List.flatten


/// Items that reference any of <param targets> (reverse dependencies), as (hash, location, kind).
/// Matches on the target's NAME rather than its hash, so a dependent pointing at an older version of the
/// name is still found -- which is the case propagation cares about. A name the target's content was
/// renamed away from counts as the target's (`renamedAwayNames`), or a rename would orphan every
/// dependent written before it.
let dependentsOf(
  targets: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  targets
  |> Stdlib.List.map(fun target ->
    let (loc, kind) = target
    Stdlib.List.prepend(
      renamedAwayNames(loc, kind) |> Stdlib.List.map(fun old -> (old, kind)),
      (loc, kind)))
  |> Stdlib.List.flatten
  |> dependentsByName


/// The name `locations` gives this hash, if any.
let mainLocationOf(
  h: String)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageLocation> =
  match
    // main-scoped, on purpose: what MAIN names this hash; the overlay's names come from `branchOverlayBindings`.
    Stdlib.Sqlite.queryOneP(
      localDb(),
      "SELECT owner, modules, name FROM locations
       WHERE item_hash = @p0 AND unlisted_at IS NULL LIMIT 1",
      [ h ])
  with
  | Some(row) ->
    (match
      (Stdlib.Sqlite.textField(row, "owner"),
       Stdlib.Sqlite.textField(row, "modules"),
       Stdlib.Sqlite.textField(row, "name"))
     with
     | (Some(o), Some(m), Some(n)) -> Stdlib.Option.Option.Some(locationOf(o, m, n))
     | _ -> Stdlib.Option.Option.None)
  | None -> Stdlib.Option.Option.None

/// Resolve hashes to a location, for display. A hash can be live at several names; this takes one, since
/// the callers are rendering a label rather than driving a cascade.
///
/// Main answers first, and the branch overlay only fills what main can't. `locations` holds main's
/// bindings only -- a branch's SetNames deliberately never fold into it -- so without the overlay every
/// branch-authored item renders as a bare 64-character hash. But the overlay must not go FIRST: identical
/// content is one item, so a hash is routinely live at several names, and preferring the branch's would
/// relabel a main item whose body you happened to duplicate on a branch. Right content, wrong label, which
/// is worse than the gap.
let resolveLocations(
  hashes: List<LanguageTools.ProgramTypes.Hash>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation)> =
  let overlay =
    branchOverlayBindings()
    |> Stdlib.List.map(fun entry ->
      match entry with
      | (h, loc, _) -> (h, loc))

  hashes
  |> Stdlib.List.filterMap(fun hash ->
    let h = LanguageTools.ProgramTypes.hashToString(hash)

    match mainLocationOf(h) with
    | Some(loc) -> Stdlib.Option.Option.Some((hash, loc))
    | None ->
      match overlay |> Stdlib.List.findFirst(fun pair -> Stdlib.Tuple2.first(pair) == h) with
      | Some(pair) -> Stdlib.Option.Option.Some((hash, Stdlib.Tuple2.second(pair)))
      | None -> Stdlib.Option.Option.None)


/// Everything <param source> references, WITH the name it referenced them by: (hash, kind, location).
///
/// Distinct from `dependenciesOf` because the name is recorded on the EDGE, not looked up from the hash.
/// That matters exactly when the dependency has moved on: its old hash is unlisted, so resolving it through
/// `locations` finds nothing and the edge silently disappears -- which is the one case a caller asking
/// "what am I behind on" actually cares about.
let dependencyEdges(
  source: LanguageTools.ProgramTypes.Hash)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.ItemKind * LanguageTools.ProgramTypes.PackageLocation)> =
  query(DepQuery.EdgesOf(LanguageTools.ProgramTypes.hashToString(source)))
  |> Stdlib.List.map(fun e ->
    (LanguageTools.ProgramTypes.Hash.Hash(e.dependsOnHash),
     kindOf(e.dependsOnType),
     locationOf(e.dependsOnOwner, e.dependsOnModules, e.dependsOnName)))
