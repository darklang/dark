module Darklang.SCM.Deps

// Read package_dependencies to find references between declarations.
// Caller lookups use the same branch and reference-name rules as propagation.
//
// Each dependency records the content hash and the full name used by the caller.
// Several names can point at the same content, so keep the names separate when finding callers.
//
// Plain edge reads by hash go through `scmDeps`, and the SQL lives with it in F# (`LibDB.ScmDeps`).
// Name-aware reads (callers, reference names) go through `pmDependents` and `namedReferencesFor`.


/// What `query` is asked.
type DepQuery =
  /// What one item references, as distinct (hash, kind) pairs.
  | Of of hash: String
  /// The distinct hashes these items reference.
  | Closure of hashes: List<String>
  /// Whether anything references this hash: at most one edge comes back.
  | Referenced of hash: String


/// One recorded edge. `Closure` leaves `dependsOnType` as "".
type DepEdge =
  { /// The item holding the reference.
    itemHash: String
    /// What it references, as the edge recorded it.
    dependsOnHash: String
    dependsOnType: String }


/// The recorded dependency edges <param q> asks for.
let query(q: DepQuery): List<DepEdge> = Builtin.scmDeps(q)


/// The `item_type` column, which only ever holds what `ItemKind.toString` wrote.
// CLEANUP: a string `toString` would not have written reads as `Fn`, which is a guess. It should
// either raise, or this should return a `Result` or an `Option` and make the six callers say what
// they want done. Left as a default for now because the column has one writer, so it cannot
// currently fire; this is the one place to change when that stops being true.
let kindOf(s: String): LanguageTools.ProgramTypes.ItemKind =
  LanguageTools.ProgramTypes.ItemKind.fromString(s)
  |> Stdlib.Option.withDefault(LanguageTools.ProgramTypes.ItemKind.Fn)

let locationOf(
  owner: String,
  modules: String,
  name: String)
  : LanguageTools.ProgramTypes.PackageLocation =
  let mods = if modules == "" then [] else Stdlib.String.split(modules, ".")

  LanguageTools.ProgramTypes.PackageLocation
    { owner = owner, modules = mods, name = name }

/// Everything <param source> references (forward dependencies), as (hash, kind).
let dependenciesOf(
  source: LanguageTools.ProgramTypes.Hash)
  : List<(LanguageTools.ProgramTypes.Hash * String)> =
  query(DepQuery.Of(LanguageTools.ProgramTypes.hashToString(source)))
  |> Stdlib.List.map(fun e ->
    (LanguageTools.ProgramTypes.Hash.Hash(e.dependsOnHash), e.dependsOnType))

/// The branch chain's own bindings as (hash, location, kind), or [] on main.
///
/// Computed ONCE per call that needs it and passed down. `chainBindings` is a recursive walk up the
/// parent chain over every op the chain holds, so asking it per dependent turns one query into one per
/// caller of the thing you asked about.
let branchOverlayBindings(
  )
  : List<(String * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  match SCM.PackageOps.currentBranch() with
  | id when SCM.Branch.isMain(id) -> []
  | branch ->
    SCM.PackageOps.chainBindings(branch)
    |> Stdlib.List.map(fun b ->
      (b.hash, locationOf(b.owner, b.modules, b.name), kindOf(b.itemType)))


/// Find callers of these names using this branch's saved reference names.
/// A rename updates these names without changing the caller's content hash.
let dependentsFor(
  branch: Uuid,
  targets: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  Builtin.pmDependents(branch, targets)

let dependentsByName(targets: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)>): List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  dependentsFor(SCM.PackageOps.currentBranch(), targets)

/// Items that reference any target name, including older versions of that name.
let dependentsOf(
  targets: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.ItemKind)> =
  dependentsByName(targets)


/// The name `locations` gives this hash, if any.
let mainLocationOf(
  h: String)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageLocation> =
  // main-scoped, on purpose: what MAIN names this hash; the overlay's names come
  // from `branchOverlayBindings`.
  SCM.Bindings.query(SCM.Bindings.BindingFilter.MainLocationOf(h))
  |> Stdlib.List.head
  |> Stdlib.Option.map(fun b -> locationOf(b.owner, b.modules, b.name))

/// Resolve hashes to a location, for display. A hash can be live at several names; this takes one, since
/// the callers are rendering a label rather than driving a cascade.
///
/// Main answers first, and the branch overlay only fills what main can't. `locations` holds main's
/// bindings only -- a branch's SetNames deliberately never fold into it -- so without the overlay every
/// branch-authored item renders as a bare 64-character hash. But the overlay must not go FIRST: identical
/// content is one item, so a hash is routinely live at several names, and preferring the branch's would
/// relabel a main item whose body you happened to duplicate on a branch. Right content, wrong label, which
/// is worse than the gap.
let resolveLocations(
  hashes: List<LanguageTools.ProgramTypes.Hash>)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.PackageLocation)> =
  let overlay =
    branchOverlayBindings()
    |> Stdlib.List.map(fun entry ->
      match entry with
      | (h, loc, _) -> (h, loc))

  hashes
  |> Stdlib.List.filterMap(fun hash ->
    let h = LanguageTools.ProgramTypes.hashToString(hash)

    match mainLocationOf(h) with
    | Some(loc) -> Stdlib.Option.Option.Some((hash, loc))
    | None ->
      match overlay |> Stdlib.List.findFirst(fun pair -> Stdlib.Tuple2.first(pair) == h) with
      | Some(pair) -> Stdlib.Option.Option.Some((hash, Stdlib.Tuple2.second(pair)))
      | None -> Stdlib.Option.Option.None)


/// A named edge: caller location, caller version, referenced version, referenced name.
type NamedReference =
  (LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.Reference * LanguageTools.ProgramTypes.Reference * LanguageTools.ProgramTypes.PackageLocation)

/// Read the reference names used by each caller at its current location and version.
let namedReferences(branchId: Uuid): List<NamedReference> =
  namedReferencesFor(branchId, [])

/// Read what this caller references, using the names it follows on this branch.
let dependencyEdges(
  branchId: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  source: LanguageTools.ProgramTypes.Reference)
  : List<(LanguageTools.ProgramTypes.Hash * LanguageTools.ProgramTypes.ItemKind * LanguageTools.ProgramTypes.PackageLocation)> =
  namedReferencesFor(branchId, [ (location, source) ])
  |> Stdlib.List.map(fun((_, _, target, name)) ->
    (LanguageTools.ProgramTypes.Reference.hash(target), LanguageTools.ProgramTypes.Reference.kind(target), name))
  |> Stdlib.List.unique
