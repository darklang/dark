module Darklang.SCM.Draft

/// Rewriting the draft: dropping ops you authored but have not committed.
///
/// Same module as `draft.dark`; that one describes the draft, this one changes it.
///
/// The draft is a REWRITABLE head over an immutable tail: committed ops never change, draft ops can be
/// dropped until `commit` takes them. Rewriting means un-doing a fold, and a fold has no general inverse,
/// so there are two ways back. SURGICAL deletes the rows an op wrote and re-lists what it superseded, and
/// is sound only for ops whose rows can be identified afterwards (see `surgicallyUndoable`). The fallback
/// is a whole REBUILD, which is always correct and expensive enough not to be the default.
///
/// The invariant that matters most here: what is skipped for READING must never be dropped for WRITING.
/// A synced store's draft is not only its own work -- ops pulled from a peer on a newer build are stored
/// and left unapplied on purpose -- and those are invisible to `mainDraftOps` because they cannot be
/// decoded. The surgical path is safe by construction, since it deletes exactly the ops it was handed.

let db () : String = Stdlib.LocalStore.path ()


/// One op in main's draft, with what is needed to undo its effect.
type DraftOp =
  { id: String
    /// The authoring stamp. `locations.origin_ts` carries the stamp of the op that wrote the row, so
    /// this is how a row is traced back to the op that put it there.
    ts: String
    op: LanguageTools.ProgramTypes.PackageOp }


/// Main's draft, oldest first, skipping any op this build cannot decode.
///
/// `effective = 1` matters here as much as in `draftWhere`: a relay-hosted store holds
/// client-pushed ops at effective=0, untagged and uncommitted, and without the clause a
/// discard's surgical path would DELETE data this store is only holding for someone else --
/// and status/discard would count two different drafts.
let mainDraftOps () : List<DraftOp> =
  let rows =
    Stdlib.Sqlite.rowsOrEmptyP
      (db ())
      "SELECT id, op_blob, origin_ts AS ts
       FROM package_ops
       WHERE commit_hash IS NULL
         AND effective = 1
         AND id NOT IN (SELECT op_id FROM op_branches)
       ORDER BY origin_ts, rowid"
      []

  SCM.PackageOps.decodeOpRowEntries rows
  |> Stdlib.List.map (fun (id, ts, op) -> DraftOp { id = id; ts = ts; op = op })


/// The content hashes the draft ADDS, so a naming can be told from a rename.
let addedHashes (ops: List<LanguageTools.ProgramTypes.PackageOp>) : List<String> =
  ops
  |> Stdlib.List.filterMap (fun op ->
    match op with
    | AddType t ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString t.hash)
    | AddValue v ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString v.hash)
    | AddFn f ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString f.hash)
    | _ -> Stdlib.Option.Option.None)


let referenceHash (r: LanguageTools.ProgramTypes.Reference) : String =
  LanguageTools.ProgramTypes.hashToString (LanguageTools.ProgramTypes.Reference.hash r)


/// Can dropping this op be undone by deleting the rows it wrote and re-listing what it superseded?
///
/// Yes for `Add*`, whose rows are content-addressed by hash: leaving one behind breaks nothing, since
/// content is immutable and shared and an orphan is a GC question. Yes for an `Override` decision and for
/// a `SetName` paired with an `Add` in the same draft, which each wrote one `locations` row identifiable
/// by (name, hash, origin_ts).
///
/// No for a STANDALONE SetName: that is a rename, and the fold also unlists every other row holding the
/// hash, rows this cannot identify afterwards since `unlisted_at` is a wall-clock second. No for
/// `Deprecate`/`Undeprecate` (`deprecations` has no `origin_ts` to trace a row back by), a non-override
/// `Decision` (upserts `propagation_policy` without recording what it overwrote), or a `BranchEvent`
/// (`branches` records no origin_ts). No for `Unbind`: what it unlisted is identifiable only by
/// `unlisted_at`, the same wall-clock second as a rename.
let surgicallyUndoable
  (added: List<String>)
  (op: LanguageTools.ProgramTypes.PackageOp)
  : Bool =
  match op with
  | AddType _ -> true
  | AddValue _ -> true
  | AddFn _ -> true
  | SetName(_, target, _) ->
    Stdlib.List.``member`` added (referenceHash target)
  | Decision(_, _, _, Override _) -> true
  | Decision(_, _, _, _) -> false
  | Unbind(_, _) -> false
  | Deprecate(_, _, _) -> false
  | Undeprecate _ -> false
  | Describe(_, _) -> false
  | BranchEvent(_, _, _) -> false


/// The `locations` row an op wrote, as the tuple identifying it: (owner, modules, name, hash, ts).
let locationRowOf (d: DraftOp) : Stdlib.Option.Option<(String * String * String * String * String)> =
  match d.op with
  | SetName(loc, target, _) ->
    Stdlib.Option.Option.Some(
      (loc.owner,
       Stdlib.String.join loc.modules ".",
       loc.name,
       referenceHash target,
       d.ts))
  | Decision(_, loc, _, Override target) ->
    Stdlib.Option.Option.Some(
      (loc.owner,
       Stdlib.String.join loc.modules ".",
       loc.name,
       referenceHash target,
       d.ts))
  | _ -> Stdlib.Option.Option.None


/// Drop the in-memory caches after this module edits `locations` outside the fold.
let invalidateCaches () : Unit = Builtin.scmInvalidateCaches ()


/// Drop ops by deleting the rows they wrote and re-listing what they superseded.
///
/// Order matters, and it is why this is one batch rather than three calls: `locations` rows go first,
/// then names left with nothing live get their most recent surviving binding back, then the op rows.
/// Op rows first would leave a window where a reader sees a binding no op explains.
///
/// Deletes by the full tuple, not by `origin_ts` alone: a stamp is unique per process but two instances
/// can mint the same one, and deleting a committed row that collided would silently unbind a name nobody
/// touched.
let surgicalDrop (dropped: List<DraftOp>) : Stdlib.Result.Result<Unit, String> =
  let rows = dropped |> Stdlib.List.filterMap locationRowOf

  let deleteRows =
    rows
    |> Stdlib.List.map (fun (owner, modules, name, hash, ts) ->
      [ owner, modules, name, hash, ts ])

  // Re-list what the dropped binding superseded: the most recent row left for that name. Ordered by
  // `origin_ts` (the authoring stamp) rather than by insertion, so this restores the binding the fold's
  // timestamp-LWW would pick, not whichever row happened to be written last.
  let relistRows =
    rows
    |> Stdlib.List.map (fun (owner, modules, name, _, _) -> [ owner, modules, name ])
    |> Stdlib.List.unique

  let deleteOps = dropped |> Stdlib.List.map (fun d -> [ d.id ])

  // main-scoped: this rewrites MAIN's draft; a branch's draft goes through `PackageOps.dropBranchOps`.
  let statements =
    [ ("DELETE FROM locations
        WHERE owner = @p0 AND modules = @p1 AND name = @p2
          AND item_hash = @p3 AND origin_ts = @p4",
       deleteRows)
      // A name whose newest surviving row is an unbind's tombstone stays unbound: the binding just
      // dropped was the first since the name was removed.
      ("UPDATE locations SET unlisted_at = NULL
        WHERE location_id = (
          SELECT location_id FROM locations
          WHERE owner = @p0 AND modules = @p1 AND name = @p2
          ORDER BY origin_ts DESC, rowid DESC
          LIMIT 1
        )
        AND source <> 'unbind'
        AND NOT EXISTS (
          SELECT 1 FROM locations
          WHERE owner = @p0 AND modules = @p1 AND name = @p2
            AND unlisted_at IS NULL
        )",
       relistRows)
      ("DELETE FROM package_ops WHERE id = @p0", deleteOps) ]

  match Stdlib.Sqlite.execBatch (db ()) statements with
  | Ok _ ->
    invalidateCaches ()
    Stdlib.Result.Result.Ok()
  | Error e -> Stdlib.Result.Result.Error e


/// Rewrite the draft to whatever <param keep> returns, and report how many ops went.
///
/// `keep` gets the draft in authoring order and returns the subset that remains: it SELECTS, it does not
/// author. That contract is what makes every caller one operation.
///
/// Falls back to the F# rebuild when any dropped op is not surgically undoable. That path deletes main's
/// log and re-inserts the survivors, and it stays in F# because it re-mints op ids and re-folds -- and
/// because ops this build cannot decode are invisible here, so the only safe rule is that the delete
/// never touches them, which `Inserts.wholeMainDeletes` enforces by id.
let rewriteBy
  (keep: List<DraftOp> -> List<DraftOp>)
  : Stdlib.Result.Result<Int, String> =
  let draft = mainDraftOps ()

  if Stdlib.List.isEmpty draft then
    Stdlib.Result.Result.Ok 0
  else
    let keptIds = keep draft |> Stdlib.List.map (fun d -> d.id)
    let dropped =
      draft
      |> Stdlib.List.filter (fun d ->
        Stdlib.Bool.not (Stdlib.List.``member`` keptIds d.id))
    let count = Stdlib.List.length dropped

    if count == 0 then
      Stdlib.Result.Result.Ok 0
    else
      let added = addedHashes (draft |> Stdlib.List.map (fun d -> d.op))
      let allSurgical =
        dropped |> Stdlib.List.all (fun d -> surgicallyUndoable added d.op)

      if allSurgical then
        match surgicalDrop dropped with
        | Ok _ -> Stdlib.Result.Result.Ok count
        | Error e -> Stdlib.Result.Result.Error e
      else
        match Builtin.scmRebuildDraftKeeping keptIds with
        | Ok _ -> Stdlib.Result.Result.Ok count
        | Error e -> Stdlib.Result.Result.Error e


/// Drop ONE name's uncommitted bindings, leaving the rest of the draft alone.
///
/// Bindings go, whichever op wrote them. The NAME is what makes an item exist in `locations`, so
/// dropping its bindings reverts the name to its last committed binding, or to not existing.
///
/// Two op kinds bind: `SetName`, and a `Decision` that OVERRIDES a binding -- which is what `undo`
/// writes when it steps a name back to an earlier version. Matching only `SetName` meant
/// `discard <name>` after an `undo` reported the change dropped and changed nothing, and `status`
/// went on listing it. `PackageOps.bindingOf` makes the same pairing for the same reason.
///
/// The `Add` carrying the content STAYS; dropping content needs a real reachability check (see
/// `collapse`).
let discardName
  (owner: String)
  (modules: List<String>)
  (name: String)
  : Stdlib.Result.Result<Int, String> =
  let modulePath = Stdlib.String.join modules "."

  let bindsThisName (loc: LanguageTools.ProgramTypes.PackageLocation) : Bool =
    loc.owner == owner
    && (Stdlib.String.join loc.modules ".") == modulePath
    && loc.name == name

  rewriteBy (fun draft ->
    draft
    |> Stdlib.List.filter (fun d ->
      match d.op with
      | SetName(loc, _, _) -> Stdlib.Bool.not (bindsThisName loc)
      | Decision(_, loc, _, Override _) -> Stdlib.Bool.not (bindsThisName loc)
      | _ -> true))


/// Drop main's draft entirely. Returns how many ops went.
let discardAll () : Stdlib.Result.Result<Int, String> = rewriteBy (fun _ -> [])


/// The stamps of the bindings PROPAGATION wrote for this name.
let propagationStampsFor
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  : List<String> =
  // main-scoped: main's draft. The branch's record is `op_branches.source`; see `unstageRepoint`.
  Stdlib.Sqlite.columnP
    (db ())
    "SELECT origin_ts FROM locations
     WHERE owner = @p0 AND modules = @p1 AND name = @p2
       AND source = 'propagation'"
    [ loc.owner, Stdlib.String.join loc.modules ".", loc.name ]
    "origin_ts"


/// Is this name's live binding a repoint that PROPAGATION staged and no commit has committed?
///
/// Joined on `locations.op_id`, the exact op the fold recorded for this binding. The stamp orders
/// bindings but does not identify one: two instances can mint the same stamp and after a sync this store
/// holds both, so matching on it would make `pin` take the wrong path.
let isStagedRepoint (loc: LanguageTools.ProgramTypes.PackageLocation) : Bool =
  match
    // main-scoped: main's staged repoints. `unstageRepoint` dispatches to the branch's own record first.
    Stdlib.Sqlite.queryP
      (db ())
      "SELECT l.source AS source
       FROM locations l
       WHERE l.owner = @p0 AND l.modules = @p1 AND l.name = @p2
         AND l.unlisted_at IS NULL
         AND EXISTS (
           SELECT 1 FROM package_ops p
           WHERE p.id = l.op_id
             AND p.commit_hash IS NULL
             AND p.id NOT IN (SELECT op_id FROM op_branches)
         )
       LIMIT 1"
      [ loc.owner, Stdlib.String.join loc.modules ".", loc.name ]
  with
  | Ok(row :: _) ->
    (Stdlib.Sqlite.textField row "source") == (Stdlib.Option.Option.Some "propagation")
  | _ -> false


/// Un-stage the repoint the draft holds for one name: a PIN, before commit.
///
/// A pin is retroactive by design: by the time you decide something should not have followed, it already
/// has. Authoring a rebinding op would leave a permanent op recording a decision still being made;
/// dropping the staged repoint says it never happened and leaves nothing behind. Only the naming op is
/// dropped, never the `Add`.
///
/// Returns 0 when there is nothing staged (the binding is committed, or you authored it), and the caller
/// then takes the post-commit path, which rebinds against committed history.
let unstageRepoint
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Result.Result<Int, String> =
  // Two records of provenance, one per scope. `isStagedRepoint` and `rewriteBy` read and rewrite MAIN's
  // draft, so on a branch they would find and drop MAIN's staged repoint -- a pin issued on a branch
  // reverting main. The branch's own record is `op_branches.source`.
  match SCM.PackageOps.currentBranch () with
  | id when Stdlib.Bool.not (SCM.Branch.isMain id) ->
    let key = (loc.owner, Stdlib.String.join loc.modules ".", loc.name)

    // The branch's binders of this name, oldest first, with what wrote each.
    let binders =
      SCM.Branches.ownFrontierOpsWithSource id
      |> Stdlib.List.filter (fun (_, op, _) -> Stdlib.Option.isSome (SCM.Branches.opBindsKey op key))

    // Staged means the LAST binder was propagation's. Then every propagation-written binder goes, and an
    // edit you typed underneath stays, as on main.
    let lastSource =
      match Stdlib.List.last binders with
      | Some entry ->
        let (_, _, source) = entry
        source
      | None -> ""

    if lastSource == "propagation" then
      let staged =
        binders
        |> Stdlib.List.filterMap (fun entry ->
          let (opId, _, source) = entry
          if source == "propagation" then
            Stdlib.Option.Option.Some(Stdlib.Uuid.toString opId)
          else
            Stdlib.Option.Option.None)

      SCM.PackageOps.dropBranchOps id staged
    else
      Stdlib.Result.Result.Ok 0
  | _ ->

  if Stdlib.Bool.not (isStagedRepoint loc) then
    Stdlib.Result.Result.Ok 0
  else
    // Only the namings PROPAGATION wrote: dropping every naming for the name would silently revert an
    // edit you typed yourself, whenever you edited the item and then edited something it depends on.
    let propagated = propagationStampsFor loc
    let modulePath = Stdlib.String.join loc.modules "."

    rewriteBy (fun draft ->
      draft
      |> Stdlib.List.filter (fun d ->
        match d.op with
        | SetName(l, _, _) ->
          if l.owner == loc.owner
             && (Stdlib.String.join l.modules ".") == modulePath
             && l.name == loc.name then
            Stdlib.Bool.not (Stdlib.List.``member`` propagated d.ts)
          else
            true
        | _ -> true))


/// Collapse the draft's superseded NAMINGS: for each name keep the last binding, drop the earlier ones.
///
/// Five edits to one function otherwise leave five namings in the log, four of them naming a version that
/// stopped being what the name means before anyone saw it.
///
/// Deliberately does NOT drop the `Add` carrying each intermediate version's content: that needs a
/// reachability check (a pinned dependent may be the only thing still referring to one), and getting it
/// wrong means a re-fold produces a different store. Keeping them re-folds identically.
///
/// Run at commit. Before that every version in the draft is reachable by `undo`.
let collapse () : Stdlib.Result.Result<Int, String> =
  rewriteBy (fun draft ->
    let nameKey (loc: LanguageTools.ProgramTypes.PackageLocation) : String =
      loc.owner ++ "|" ++ (Stdlib.String.join loc.modules ".") ++ "|" ++ loc.name

    // The id of the LAST naming for each name, in authoring order.
    let step =
      (fun acc d ->
        match d.op with
        | SetName(loc, _, _) ->
          Stdlib.Dict.setOverridingDuplicates acc (nameKey loc) d.id
        | _ -> acc)

    let lastForName = draft |> Stdlib.List.fold Stdlib.Dict.empty step

    draft
    |> Stdlib.List.filter (fun d ->
      match d.op with
      | SetName(loc, _, _) ->
        (Stdlib.Dict.get lastForName (nameKey loc))
        == (Stdlib.Option.Option.Some d.id)
      | _ -> true))
