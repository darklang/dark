module Darklang.SCM.PackageOps

// Turning op rows into bindings: what each op says about a name, and what a name holds NOW. What a
// name holds is the store's answer (`SCM.Bindings`), asked of the branch; the op-row folds here are for
// a run of ops that is not in the store's answer yet, such as a draft being checked.

/// (id, ts, op) per row whose op this build could read -- the one filter behind every op-log read
/// that wants ops. `scmOps` decodes the blobs; a row it could not decode (a peer's op on a newer
/// format, stored here on purpose) is skipped.
///
/// What an unreadable op MEANS belongs to `SCM.StoreHealth`, which counts them. Not to whichever
/// reader touches one first.
let decodeOpRowEntries(
  rows: List<OpRow>)
  : List<(String * String * LanguageTools.ProgramTypes.PackageOp)> =
  rows
  |> Stdlib.List.filterMap(fun row -> row.op |> Stdlib.Option.map(fun op -> (row.id, row.ts, op)))


/// The ops of these rows, skipping any this build could not read.
let decodeOpRows(rows: List<OpRow>): List<LanguageTools.ProgramTypes.PackageOp> =
  rows |> Stdlib.List.filterMap(fun row -> row.op)


// Read the bindings described by decoded operations.

/// Read the binding from a SetName or an Override decision, with its timestamp.
/// Callers first split renames and restores into binding changes.
/// Include overrides so Dark reports the same binding that F# uses when running the code.
let bindingFromOp(
  op: LanguageTools.ProgramTypes.PackageOp,
  ts: String)
  : Option<(String * Conflicts.Binding)> =
  // Only SetName records the version this edit was based on.
  // An Override chooses a binding without recording an earlier version.
  let previous =
    match op with
    | SetName(_, _, Some(h)) -> Option.Some(LanguageTools.ProgramTypes.hashToString(h))
    | _ -> Option.None

  match op with
  | Decision(_, location, _, Override(target)) | SetName(location, target, _) ->
    let modules = Stdlib.String.join(location.modules, ".")
    let itemType =
      LanguageTools.ProgramTypes.ItemKind.toString(
        LanguageTools.ProgramTypes.Reference.kind(target))

    let hash =
      LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target))

    let binding =
      Conflicts.Binding
        { owner = location.owner
          modules = modules
          name = location.name
          itemType = itemType
          hash = hash
          originTs = ts
          // These operations do not include an author.
          author = ""
          previous = previous }

    Option.Some((Conflicts.bindingKey(location.owner, modules, location.name), binding))
  | _ -> Option.None


/// What a name points to after applying the operations.
/// None means the name was unbound, which also hides any inherited binding.
type NameWord =
  { owner: String
    modules: String
    name: String
    binding: Option<Conflicts.Binding> }


/// Sort the binding to keep last, using the same rules as F#.
/// The newest timestamp wins. At equal timestamps, a binding (with its <param hash>) beats an
/// Unbind, and the greater hash wins between bindings.
/// SQL row order depends on arrival order, so it cannot settle these ties consistently.
/// Timestamps have a fixed format, so sorting this string also sorts them by time.
let bindingSortKey(ts: String, hash: Option<String>): String =
  match hash with
  | Some(h) -> $"{ts}|1|{h}"
  | None -> $"{ts}|0|"


/// Read the operations and keep the latest change for each name.
/// Sort by <fn bindingSortKey> so the result does not depend on the order rows arrived in.
/// An Unbind removes the binding until a later operation gives the name a binding again.
let nameEntriesFromOpRows(
  expand: LanguageTools.ProgramTypes.PackageOp -> List<LanguageTools.ProgramTypes.PackageOp>,
  rows: List<OpRow>)
  : List<NameWord> =
  let entries =
    decodeOpRowEntries(rows)
    |> Stdlib.List.map(fun((_, ts, op)) ->
      expand(op)
      |> Stdlib.List.filterMap(fun effect ->
        match effect with
        | Unbind(location, _) ->
          let modules = Stdlib.String.join(location.modules, ".")
          Option.Some(
            (
              bindingSortKey(ts, Option.None),
              Conflicts.bindingKey(location.owner, modules, location.name),
              NameWord
                { owner = location.owner
                  modules = modules
                  name = location.name
                  binding = Option.None }))
        | _ ->
          bindingFromOp(effect, ts)
          |> Stdlib.Option.map(fun((k, b)) ->
            (
              bindingSortKey(b.originTs, Option.Some(b.hash)),
              k,
              NameWord
                { owner = b.owner
                  modules = b.modules
                  name = b.name
                  binding = Option.Some(b) }))))
    |> Stdlib.List.flatten

  entries
  |> Stdlib.List.sortBy(fun e ->
    let (sortKey, _k, _w) = e
    sortKey)
  |> Stdlib.List.map(fun e ->
    let (_sortKey, k, w) = e
    (k, w))
  |> Stdlib.Dict.fromEntries
  |> Stdlib.Dict.values


/// Read changes to what each name points to. Edits to reference names alone do not change bindings.
let bindingEntriesFromOpRows(rows: List<OpRow>): List<NameWord> =
  nameEntriesFromOpRows(LanguageTools.ProgramTypes.PackageOp.bindingOps, rows)


/// Include edits to reference names when listing or selecting draft changes.
let draftEntriesFromOpRows(rows: List<OpRow>): List<NameWord> =
  nameEntriesFromOpRows(LanguageTools.ProgramTypes.PackageOp.draftOps, rows)


/// <fn bindingEntriesFromOpRows>, keeping only the names that end up bound.
let bindingsFromOpRows(rows: List<OpRow>): List<Conflicts.Binding> =
  bindingEntriesFromOpRows(rows) |> Stdlib.List.filterMap(fun w -> w.binding)


/// What <param branchId> has COMMITTED at each of <param locations>: its own committed work over its
/// ancestors', main's included. Its draft is left out.
let committedBindingsOn(
  branchId: Uuid,
  locations: List<(String * String * String)>)
  : List<Conflicts.Binding> =
  Bindings.query(Bindings.BindingFilter.CommittedAt(branchId, locations))
  |> Stdlib.List.map(Conflicts.bindingOf)


type ReferenceSource =
  (LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.Reference)


let sourceOfBinding(binding: Conflicts.Binding): ReferenceSource =
  (
    Deps.locationOf(binding.owner, binding.modules, binding.name),
    LanguageTools.ProgramTypes.Reference.fromHashAndKind(
      LanguageTools.ProgramTypes.Hash.Hash(binding.hash),
      Deps.kindOf(binding.itemType)))


/// List the declarations visible on this branch, including its own draft.
let liveReferenceSources(branchId: Uuid): List<ReferenceSource> =
  Builtin.pmLiveReferenceSources(branchId)


/// What <param loc> resolves to on <param branchId>: the branch's own work over what its ancestors
/// committed, main's included. THE branch-aware read of a live binding.
let liveBindingFor(
  branchId: Uuid,
  loc: LanguageTools.ProgramTypes.PackageLocation)
  : Option<Conflicts.Binding> =
  Bindings.query(
    Bindings.BindingFilter.At(
      branchId,
      [ (loc.owner, Stdlib.String.join(loc.modules, "."), loc.name) ]))
  |> Stdlib.List.head
  |> Stdlib.Option.map(Conflicts.bindingOf)


/// <fn liveBindingFor> for many names at once, keyed by `Conflicts.bindingKey`; a name that resolves
/// to nothing is absent.
let liveBindingsFor(
  branchId: Uuid,
  locs: List<LanguageTools.ProgramTypes.PackageLocation>)
  : Dict<String, Conflicts.Binding> =
  let names =
    locs
    |> Stdlib.List.map(fun loc -> (loc.owner, Stdlib.String.join(loc.modules, "."), loc.name))
    |> Stdlib.List.unique

  if Stdlib.List.isEmpty(names) then
    Dict {}
  else
    Bindings.query(Bindings.BindingFilter.At(branchId, names))
    |> Stdlib.List.map(fun row ->
      (Conflicts.bindingKey(row.owner, row.modules, row.name), Conflicts.bindingOf(row)))
    |> Stdlib.Dict.fromEntries


/// <fn liveBindingFor> on the branch this process stands on.
let liveBindingAt(loc: LanguageTools.ProgramTypes.PackageLocation): Option<Conflicts.Binding> =
  liveBindingFor(currentBranch(), loc)
