module Darklang.SCM.PackageOps

// Read operations to work out what each name points to.
// The locations table holds main's bindings. For other branches, apply the changes
// from the branch and its parents to find the bindings visible there.

/// Decode a stored operation using the F# binary reader.
/// Return None if this build cannot read it. SCM.StoreHealth counts unreadable operations
/// so each caller does not need its own way to report them.
let tryDecodeOp(
  id: Uuid,
  blob: Bytes)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageOp> =
  Builtin.packageOpFromBytesOption(id, blob)


/// Read each row's operation ID, timestamp, and decoded operation.
/// Skip rows with invalid IDs or unreadable operations. Use "" when the timestamp is missing.
/// Dark reads the rows; the builtin decodes each operation's bytes.
let decodeOpRowEntries(
  rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<(String * String * LanguageTools.ProgramTypes.PackageOp)> =
  rows
  |> Stdlib.List.filterMap(fun row ->
    match
      (Stdlib.Sqlite.textField(row, "id"), Stdlib.Sqlite.bytesField(row, "op_blob"))
    with
    | (Some(idStr), Some(blob)) ->
      match Stdlib.Uuid.parse(idStr) with
      | Ok(id) ->
        tryDecodeOp(id, blob)
        |> Stdlib.Option.map(fun op -> (idStr, Stdlib.Sqlite.textOr(row, "ts"), op))
      | Error(_) -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None)


/// Decode op-log rows (id, op_blob) into fully-decoded PackageOps.
let decodeOpRows(
  rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRowEntries(rows) |> Stdlib.List.map(fun((_id, _ts, op)) -> op)


// Read the bindings described by decoded operations.


/// Read the binding from a SetName or an Override decision, with its timestamp.
/// Callers first split renames and restores into binding changes.
/// Include overrides so Dark reports the same binding that F# uses when running the code.
let bindingFromOp(
  op: LanguageTools.ProgramTypes.PackageOp,
  ts: String)
  : Stdlib.Option.Option<(String * Conflicts.Binding)> =
  // Only SetName records the version this edit was based on.
  // An Override chooses a binding without recording an earlier version.
  let previous =
    match op with
    | SetName(_, _, Some(h)) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(h))
    | _ -> Stdlib.Option.Option.None

  match op with
  | Decision(_, location, _, Override(target))
  | SetName(location, target, _) ->
    let modules = Stdlib.String.join(location.modules, ".")

    let itemType =
      LanguageTools.ProgramTypes.ItemKind.toString(LanguageTools.ProgramTypes.Reference.kind(target))

    let hash =
      LanguageTools.ProgramTypes.hashToString(
        LanguageTools.ProgramTypes.Reference.hash(target))

    let binding =
      Conflicts.Binding
        { owner = location.owner
          modules = modules
          name = location.name
          itemType = itemType
          hash = hash
          originTs = ts
          // These operations do not include an author.
          author = ""
          previous = previous }

    Stdlib.Option.Option.Some((Conflicts.bindingKey(location.owner, modules, location.name), binding))
  | _ -> Stdlib.Option.Option.None


/// What a name points to after applying the operations.
/// None means the name was unbound, which also hides any inherited binding.
type NameWord =
  { owner: String
    modules: String
    name: String
    binding: Stdlib.Option.Option<Conflicts.Binding> }


/// Sort the binding to keep last, using the same rules as F#.
/// The newest timestamp wins. At equal timestamps, a binding beats an Unbind,
/// and the greater hash wins between bindings.
/// SQL row order depends on arrival order, so it cannot settle these ties consistently.
/// Timestamps have a fixed format, so sorting this string also sorts them by time.
let bindingSortKey(ts: String, isBinding: Bool, hash: String): String =
  let rank = if isBinding then "1" else "0"
  $"{ts}|{rank}|{hash}"


/// Read the operations and keep the latest change for each name.
/// Sort by <fn bindingSortKey> so the result does not depend on the order rows arrived in.
/// An Unbind removes the binding until a later operation gives the name a binding again.
let nameEntriesFromOpRows(
  expand: LanguageTools.ProgramTypes.PackageOp -> List<LanguageTools.ProgramTypes.PackageOp>,
  rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<NameWord> =
  let entries =
    decodeOpRowEntries(rows)
    |> Stdlib.List.map(fun((_, ts, op)) ->
      expand(op)
      |> Stdlib.List.filterMap(fun effect ->
        match effect with
        | Unbind(location, _) ->
          let modules = Stdlib.String.join(location.modules, ".")
          Stdlib.Option.Option.Some(
            (bindingSortKey(ts, false, ""),
             Conflicts.bindingKey(location.owner, modules, location.name),
             NameWord { owner = location.owner, modules = modules, name = location.name
                        binding = Stdlib.Option.Option.None }))
        | _ ->
          bindingFromOp(effect, ts)
          |> Stdlib.Option.map(fun((k, b)) ->
            (bindingSortKey(b.originTs, true, b.hash), k,
             NameWord { owner = b.owner, modules = b.modules, name = b.name
                        binding = Stdlib.Option.Option.Some(b) }))))
    |> Stdlib.List.flatten

  entries
  |> Stdlib.List.sortBy(fun e ->
    let (sortKey, _k, _w) = e
    sortKey)
  |> Stdlib.List.map(fun e ->
    let (_sortKey, k, w) = e
    (k, w))
  |> Stdlib.Dict.fromEntries
  |> Stdlib.Dict.values


/// Read changes to what each name points to. Edits to reference names alone do not change bindings.
let bindingEntriesFromOpRows(rows: List<Dict<String, Stdlib.Sqlite.Value>>): List<NameWord> =
  nameEntriesFromOpRows(LanguageTools.ProgramTypes.PackageOp.bindingOps, rows)

/// Include edits to reference names when listing or selecting draft changes.
let draftEntriesFromOpRows(rows: List<Dict<String, Stdlib.Sqlite.Value>>): List<NameWord> =
  nameEntriesFromOpRows(LanguageTools.ProgramTypes.PackageOp.draftOps, rows)


/// <fn bindingEntriesFromOpRows>, keeping only the names that end up bound.
let bindingsFromOpRows(rows: List<Dict<String, Stdlib.Sqlite.Value>>): List<Conflicts.Binding> =
  bindingEntriesFromOpRows(rows) |> Stdlib.List.filterMap(fun w -> w.binding)


/// Read binding changes from this branch and its parents, stopping before main.
/// Use the same ordering as LibDB.Branches.chainOverlayOps so Dark and F# agree.
/// The query uses main's UUID as @p1. Comparing parent_id with the text "main"
/// would miss that boundary because parent_id stores a UUID.
let chainBindingEntries(branchId: Uuid): List<NameWord> =
  bindingEntriesFromOpRows(chainOpRows(branchId))


/// The parent-chain walk: @p0 = the branch, @p1 = main's id. Spliced into each chain
/// statement (`chainOpRows`, `visibleWhere`, `parentCommitFor`), never edited in
/// place -- the one copy of the walk every chain query shares.
val chainCteSql =
  "WITH RECURSIVE chain(bid) AS (
     SELECT @p0
     UNION
     SELECT b.parent_id FROM branches b JOIN chain c ON b.id = c.bid
     WHERE b.parent_id != @p1
   )"


/// Read this branch's operations and its parents' committed operations, oldest first.
/// <fn chainBindingEntries> and branchHashHistoryFor share this query.
let chainOpRows(branchId: Uuid): List<Dict<String, Stdlib.Sqlite.Value>> =
  Stdlib.Sqlite.rowsOrEmptyP(
    localDb(),
    (chainCteSql
     + " SELECT p.id, p.op_blob, p.origin_ts AS ts, p.commit_hash
          FROM package_ops p JOIN op_branches ob ON ob.op_id = p.id
          WHERE ob.branch_id IN (SELECT bid FROM chain)
            AND (ob.branch_id = @p0 OR p.commit_hash IS NOT NULL)
          ORDER BY p.origin_ts, p.rowid"),
    [ Stdlib.toString(branchId)
      Stdlib.toString(SCM.Branch.mainBranchId) ])


/// <fn chainBindingEntries>, keeping only the names the chain leaves bound.
let chainBindings(branchId: Uuid): List<Conflicts.Binding> =
  chainBindingEntries(branchId) |> Stdlib.List.filterMap(fun w -> w.binding)


/// Read committed main bindings from the shared storage reader.
/// It also finds bindings whose location rows were hidden by main's draft.
let committedBindingsFor(locs: List<List<String>>): List<Conflicts.Binding> =
  let locations = locs |> Stdlib.List.filterMap(fun parts ->
    match parts with
    | [ owner, modules, name ] -> Stdlib.Option.Option.Some(Deps.locationOf(owner, modules, name))
    | _ -> Stdlib.Option.Option.None)
  Builtin.pmCommittedBindings(locations)
  |> Stdlib.List.filterMap(fun((op, stamp)) -> bindingFromOp(op, stamp) |> Stdlib.Option.map(fun((_, binding)) -> binding))

/// Read the committed bindings visible on this branch for the requested names.
let committedBindingsOn(branchId: Uuid, locations: List<List<String>>): List<Conflicts.Binding> =
  let main = committedBindingsFor(locations)
  let branch = if SCM.Branch.isMain(branchId) then [] else
    chainOpRows(branchId)
    |> Stdlib.List.filter(fun row -> Stdlib.Option.isSome(Stdlib.Sqlite.textField(row, "commit_hash")))
    |> bindingEntriesFromOpRows
  let key(b: Conflicts.Binding): String = Conflicts.bindingKey(b.owner, b.modules, b.name)
  let touched = branch |> Stdlib.List.map(fun word -> Conflicts.bindingKey(word.owner, word.modules, word.name))
  Stdlib.List.concat(
    main |> Stdlib.List.filter(fun b -> Stdlib.Bool.not(Stdlib.List.contains(touched, key(b)))),
    branch |> Stdlib.List.filterMap(fun word -> word.binding))

type ReferenceSource =
  (LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.Reference)

let sourceOfBinding(binding: Conflicts.Binding): ReferenceSource =
  (Deps.locationOf(binding.owner, binding.modules, binding.name),
   LanguageTools.ProgramTypes.Reference.fromHashAndKind(
     LanguageTools.ProgramTypes.Hash.Hash(binding.hash), Deps.kindOf(binding.itemType)))

/// List the declarations visible on this branch, including its own draft.
let liveReferenceSources(branchId: Uuid): List<ReferenceSource> =
  Builtin.pmLiveReferenceSources(branchId)


/// Resolve one name through the same branch-aware batch reader as dependency checks.
let liveBindingFor(
  branchId: Uuid,
  loc: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<Conflicts.Binding> =
  Stdlib.Dict.get(liveBindingsFor(branchId, [ loc ]),
    Conflicts.bindingKey(loc.owner, Stdlib.String.join(loc.modules, "."), loc.name))


/// <fn liveBindingFor> for many names at once, keyed by `Conflicts.bindingKey`; a name that resolves
/// to nothing is absent.
///
/// Same two layers, asked once each: the chain decoded once, then main in one query for the names
/// the chain says nothing about. Asked per name, a branch re-decodes its whole chain every time.
let liveBindingsFor(
  branchId: Uuid,
  locs: List<LanguageTools.ProgramTypes.PackageLocation>)
  : Dict<String, Conflicts.Binding> =
  let chain = if SCM.Branch.isMain(branchId) then [] else chainBindingEntries(branchId)
  liveBindingsOver(branchId, chain, locs)


/// <fn liveBindingsFor> for a caller that has already read <param chain>, the
/// `chainBindingEntries` of <param branchId>, and should not pay for it twice.
let liveBindingsOver(
  branchId: Uuid,
  chain: List<NameWord>,
  locs: List<LanguageTools.ProgramTypes.PackageLocation>)
  : Dict<String, Conflicts.Binding> =
  let onMain = SCM.Branch.isMain(branchId)

  let chainWords =
    chain
    |> Stdlib.List.map(fun w -> (Conflicts.bindingKey(w.owner, w.modules, w.name), w))
    |> Stdlib.Dict.fromEntries

  let undecided =
    locs
    |> Stdlib.List.map(fun loc ->
      [ loc.owner, Stdlib.String.join(loc.modules, "."), loc.name ])
    |> Stdlib.List.unique
    |> Stdlib.List.filter(fun t ->
      match t with
      | [ owner, modules, name ] ->
        let key = Conflicts.bindingKey(owner, modules, name)
        Stdlib.Option.isNone(Stdlib.Dict.get(chainWords, key))
      | _ -> false)

  // main-scoped: read main's bindings for names the branch has not changed.
  // Other branches inherit committed bindings; main also sees its own draft.
  // Reverse the rows before building the Dict so the first row for each name wins.
  let fromMain =
    if Stdlib.List.isEmpty(undecided) then []
    else if Stdlib.Bool.not(onMain) then committedBindingsFor(undecided)
    else
      Stdlib.Sqlite.rowsOrEmptyP(localDb(),
        "SELECT l.owner, l.modules, l.name, l.item_type, l.item_hash,
                COALESCE(l.origin_ts,'') AS ts, l.previous
         FROM json_each(@p0) j JOIN locations l
           ON l.owner = json_extract(j.value, '$[0]')
           AND l.modules = json_extract(j.value, '$[1]')
           AND l.name = json_extract(j.value, '$[2]')
         WHERE l.unlisted_at IS NULL",
        [ Stdlib.Json.serialize<List<List<String>>>(undecided) ])
      |> Stdlib.List.filterMap(Conflicts.bindingFromRow)
      |> Stdlib.List.reverse

  Stdlib.List.concat(
    (chainWords
     |> Stdlib.Dict.toEntries
     |> Stdlib.List.filterMap(fun kw ->
       let (k, w) = kw
       w.binding |> Stdlib.Option.map(fun b -> (k, b)))),
    fromMain |> Stdlib.List.map(fun b -> (Conflicts.bindingKey(b.owner, b.modules, b.name), b)))
  |> Stdlib.Dict.fromEntries


/// <fn liveBindingFor> on the branch this process stands on.
let liveBindingAt(
  loc: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<Conflicts.Binding> =
  liveBindingFor(currentBranch(), loc)

