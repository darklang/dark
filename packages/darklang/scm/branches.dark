module Darklang.SCM.Branches

//  the BRANCH-TABLES data-access silo
//
// Reads `branches` and `branch_name_bases`, and decides what to make of them. Every write
// to them is an action in F# (`SCM.Actions`): starting, archiving, merging, rebasing and resolving a
// branch each run as one operation there.
//
// The READS of `branches` and `branch_name_bases` go through one builtin, `scmBranches`, and the SQL
// lives with it in F# (`LibDB.ScmBranches`); a branch's ops are read through `SCM.PackageOps.query`,
// with the op log. What to make of the answer -- main, a missing parent, an id that will not
// parse -- stays here.
//


/// The branch this process is on. This is an ID: `--branch <name>` and `DARK_BRANCH` are resolved to one in
/// the CLI entry point before any Dark runs, and the persistent `current_branch` already holds one.
///
/// Lives in this silo, the lowest branch-aware module, so both `SCM.PackageOps` and `SCM.Conflicts` can ask
/// without either depending on the other. `SCM.PackageOps.currentBranch` is the name most callers use.
let current(): Uuid = Builtin.scmCurrentBranch()


/// Which branches <fn query> reads. Main has no `branches` row, so no case ever finds it.
type BranchFilter =
  /// Every branch not archived, newest first, each with its op count.
  | All
  /// The branch with this id, archived or not. At most one row.
  | ById of id: Uuid
  /// The newest branch not archived that goes by this name. At most one row.
  | ByName of name: String
  /// The active (unmerged, unarchived) children of this branch, ordered by display name (the id when
  /// the name is "").
  | ChildrenOf of id: Uuid
  /// The bases this branch recorded, one per name it touched, on a single row. Answers whether or not
  /// the branch has a `branches` row, since the bases are kept by id alone.
  | NameBasesOf of id: Uuid


/// One branch as the store holds it. Which fields a filter fills is said on its case; the rest are
/// "", 0 or empty.
type BranchInfo =
  { id: String
    /// "" when the id is the only handle.
    name: String
    parentId: String
    merged: Bool
    /// `All` only: how many ops it holds.
    ops: Int64
    /// `NameBasesOf` only.
    nameBases: List<SCM.Conflicts.NameBase> }


/// The branches <param f> asks for.
let query(f: BranchFilter): List<BranchInfo> = Builtin.scmBranches(f)


/// Why a merge may not go ahead.
///
/// A DU rather than a sentence because one caller has to tell the empty case apart from the rest:
/// approving a review queue that holds nothing pending is a normal outcome, not a failure, and it
/// used to be recognised by searching the message for "nothing to merge".
type MergeRefusal =
  /// Main is the trunk; there is nothing above it to merge into.
  | IsMain
  /// The branch holds no ops, so a merge would move nothing.
  | NothingToMerge
  /// Unmerged, unarchived branches sit under this one.
  | HasActiveChildren

/// The sentence a person reads, kept beside the cases so the two cannot drift.
let refusalMessage(r: MergeRefusal): String =
  match r with
  | IsMain ->
    "main is the trunk -- merge moves a BRANCH into its parent. `dark branches` lists them."
  | NothingToMerge -> "nothing to merge (the branch has no changes)"
  | HasActiveChildren -> "branch has active children -- merge or archive them first"


/// Can this branch merge into its parent? Two structural preconditions: it has changes, and it has no
/// active (unmerged, unarchived) children.
///
/// It deliberately does NOT gate on conflicts. Those are detected, auto-resolved by the fold's origin_ts
/// LWW, and RECORDED at reconciliation: review-AFTER, not block-before, and the recorded conflict is what
/// keeps that safe.
///
/// The merge action asks the same three questions itself, in F#, and refuses with the same cases; this is
/// for the callers that want the answer before asking for a merge (the confirmation, `--dry-run`).
let canMerge(branchId: Uuid): Stdlib.Result.Result<Unit, MergeRefusal> =
  if SCM.Branch.isMain(branchId) then
    Stdlib.Result.Result.Error(MergeRefusal.IsMain)
  else

  let changes = SCM.PackageOps.countOf(SCM.PackageOps.OpFilter.Own(branchId))

  if changes == 0 then
    Stdlib.Result.Result.Error(MergeRefusal.NothingToMerge)
  else
    // "Active" must mean the same here as in the message below, which tells you to merge OR ARCHIVE the
    // children -- counting archived ones as active makes that advice a dead end.
    // A failed read raises rather than answering "no children", so the guard cannot fail open.
    if Stdlib.List.isEmpty(query(BranchFilter.ChildrenOf(branchId))) then
      Stdlib.Result.Result.Ok()
    else
      Stdlib.Result.Result.Error(MergeRefusal.HasActiveChildren)


/// The active (unmerged, unarchived) children of <param branchId>, by name.
///
/// `canMerge` asks the same question; this is the shape a caller needs when it has to NAME them. A
/// branch with no name goes by its id.
let activeChildNames(branchId: Uuid): List<String> =
  query(BranchFilter.ChildrenOf(branchId))
  |> Stdlib.List.map(fun b -> if b.name == "" then b.id else b.name)


//  listings

/// One active branch, as data. The CLI renders it as a line and the LSP as JSON, so the QUERY lives in
/// one place and neither surface has to know the table.
type BranchRow =
  { id: Uuid
    /// a mutable display alias; "" when the id is the only handle
    name: String
    parent: Uuid
    /// how many ops are on its frontier
    ops: Int64
    merged: Bool }

/// Every active branch, oldest first.
let list(): List<BranchRow> =
  query(BranchFilter.All)
  |> Stdlib.List.filterMap(fun b ->
    match Stdlib.Uuid.parse(b.id) with
    // A row whose id will not parse is skipped, not fatal: this feeds every listing and the LSP
    // tree, and one bad row taking all of them down is worse than one branch missing from the list.
    | Ok(id) ->
      Stdlib.Option.Option.Some(
        BranchRow
          { id = id
            name = b.name
            parent = SCM.Branch.fromTextField(Stdlib.Option.Option.Some(b.parentId))
            ops = b.ops
            merged = b.merged }
      )
    | Error(_) -> Stdlib.Option.Option.None)

/// How many branches are already merged. The `dark branches` footer needs the count of what it
/// hid, and asking for it separately keeps `listLines` returning only what it will print.
let mergedCount(): Int64 =
  list()
  |> Stdlib.List.filter(fun b -> b.merged)
  |> Stdlib.List.length

/// The branch list, one line each. <param includeMerged> false drops the ones already merged -- the
/// default, because merged branches accumulate forever and nothing removes them.
let listLines(includeMerged: Bool): List<String> =
  // Fetched ONCE: `parentLabel` reads its parent out of this list, so rendering n branches is one query
  // rather than n+1.
  let branches = list()

  let parentLabel(parentId: Uuid): String =
    if SCM.Branch.isMain(parentId) then
      SCM.Branch.mainBranchName
    else
      // A parent this store has never registered is a colleague's branch that was not pulled
      // with its child. The id alone reads as corruption; say what it is instead.
      match Stdlib.List.findFirst(branches, fun p -> p.id == parentId) with
      | Some(p) when p.name != "" -> p.name
      | Some(_) -> Stdlib.String.slice(Stdlib.toString(parentId), 0, 8)
      | None ->
        let short = Stdlib.String.slice(Stdlib.toString(parentId), 0, 8)
        $"{short} (a branch not in this store)"

  branches
  |> Stdlib.List.filter(fun b -> includeMerged || (Stdlib.Bool.not(b.merged)))
  |> Stdlib.List.map(fun b ->
    let status =
      if b.merged then "merged" else $"{Stdlib.toString(b.ops)} op(s)"

    let label = if b.name == "" then Stdlib.toString(b.id) else b.name
    let shortId = Stdlib.String.slice(Stdlib.toString(b.id), 0, 8)
    $"{label} ({shortId}) <- {parentLabel(b.parent)}  [{status}]")

/// The names a branch has recorded a base for -- i.e. every name it has touched.
let touchedNames(branchId: Uuid): List<String> =
  baseRecords(branchId) |> Stdlib.List.map(fun b -> b.name)


/// The bases <param branchId> recorded, one per name it touched.
let baseRecords(branchId: Uuid): List<SCM.Conflicts.NameBase> =
  query(BranchFilter.NameBasesOf(branchId))
  |> Stdlib.List.map(fun b -> b.nameBases)
  |> Stdlib.List.flatten


/// The key a name is looked up by. `branch_name_bases` and `locations` both spell a name as
/// (owner, dotted-modules, name), and this is that triple flattened so a Dict can hold it. The separator
/// is a newline because none of the three parts can contain one.
let nameKey(owner: String, modules: String, name: String): String =
  owner + "\n" + modules + "\n" + name


/// How a conflicted name is SPOKEN: "owner.Module.name", or "owner.name" for a top-level item. Mirrors the
/// detector's fqn format, because `resolve <name>` has to accept what a conflict listing prints.
let fqnOf(owner: String, modules: String, name: String): String =
  if modules == "" then
    owner + "." + name
  else
    owner + "." + modules + "." + name


/// A branch's recorded bases: the parent's hash per name AT THE FORK, which is what a later comparison is
/// against. `(owner, modules, name, base_hash)` rows, unformatted.
let nameBases(branchId: Uuid): List<(String * String * String * String)> =
  baseRecords(branchId)
  |> Stdlib.List.map(fun b -> (b.owner, b.modules, b.name, b.baseHash))


/// The parent's CURRENT hash for each name this branch has a base for -- the state a child forks from and
/// merges back into: what the branch sees beneath itself, its ancestors' COMMITTED work. A name the
/// parent removed, or never had, reads "".
///
/// Committed only: rebasing onto a parent's draft would pull its uncommitted work into the branch.
let parentHashesForBases(_parentId: Uuid, branchId: Uuid): Dict<String, String> =
  SCM.Bindings.query(SCM.Bindings.BindingFilter.AboveBases(branchId))
  |> Stdlib.List.map(fun b -> (nameKey(b.owner, b.modules, b.name), b.hash))
  |> Stdlib.Dict.fromEntries


/// Names the PARENT has moved since this branch forked, given bases and hashes already read: its current
/// hash differs from the branch's recorded base.
///
/// A name the parent has since UNLISTED reads as "" and so counts as moved, which is right: the thing the
/// branch forked from is not there any more.
let divergedIn(
  bases: List<(String * String * String * String)>,
  parentHashes: Dict<String, String>)
  : List<String> =
  bases
  |> Stdlib.List.filterMap(fun row ->
    let (o, m, n, baseHash) = row

    let current =
      parentHashes
      |> Stdlib.Dict.get(nameKey(o, m, n))
      |> Stdlib.Option.withDefault("")

    if current == baseHash then
      Stdlib.Option.Option.None
    else
      Stdlib.Option.Option.Some(fqnOf(o, m, n)))


/// Names the PARENT has moved since this branch forked. This is the merge GATE, not a view --
/// `SCM.Conflicts` presents conflicts, this decides whether there are any.
let nameConflicts(branchId: Uuid): List<String> =
  let parent = SCM.PackageOps.branchParentOf(branchId)

  divergedIn(nameBases(branchId), parentHashesForBases(parent, branchId))


/// What a rebase did, in the two ways the parent's changes reach a branch.
type Rebased =
  { /// Names the parent changed that this branch had ALSO changed: a divergence. The newer edit wins
    /// (the branch takes the parent's version when that is the parent's), and the other is recorded.
    diverged: List<String>
    /// The branch's own callers of names the parent moved, repointed at the parent's version. Not a
    /// divergence: nobody on the branch touched these, and after the repoint they agree with the
    /// parent by construction.
    repointed: List<String> }


/// REBASE: accept the parent's current state as this branch's new base. Returns the names the parent had
/// changed since the fork; where both changed a name the newer edit (by origin_ts) now stands on the
/// branch, and merge is unblocked. The union of both halves of <fn rebaseDetailed>, for callers that want one list.
let rebase(branchId: Uuid): Stdlib.Result.Result<List<String>, String> =
  match rebaseDetailed(branchId) with
  | Ok(r) -> Stdlib.Result.Result.Ok(Stdlib.List.unique(Stdlib.List.concat(r.diverged, r.repointed)))
  | Error(e) -> Stdlib.Result.Result.Error(e)


/// The branch's own callers that still reference a version of something the parent has since moved,
/// each as the repoint that brings it to the parent's version. Rebase and merge both apply them first,
/// so a caller written on a branch calls what the parent runs once the two meet.
let outdatedRepoints(branchId: Uuid): List<SCM.Actions.Repoint> =
  SCM.Constraints.detectOutdatedUsagesOn(branchId)
  |> Stdlib.List.filterMap(fun f ->
    match f.detail with
    | Versions(using, current) ->
      Stdlib.Option.Option.Some(
        SCM.Actions.Repoint
          { usage =
              Conflicts.fqn(f.usage.owner, SCM.Propagation.modulesOf(f.usage), f.usage.name)
            dependency = f.dependency
            kind = f.dependencyKind
            fromHash = using
            toHash = current }
      )
    | _ -> Stdlib.Option.Option.None)


/// The rebase itself, as one action: the divergences and repoints apart (see <type Rebased>), and the
/// conflicts it recorded on the branch.
///
/// Which of the branch's callers are outdated is a language question, answered here
/// (`SCM.Constraints`): a branch that never touched `f` has no base for it, so when the parent moves `f`
/// the branch's own callers of it still reference the old version by hash. The action repoints each of
/// those the way an edit on the parent would have, then moves every base and records the conflicts in
/// one transaction.
let rebaseDetailed(branchId: Uuid): Stdlib.Result.Result<SCM.Actions.Reconciled, String> =
  match SCM.Actions.merge(SCM.Actions.MergeAction.Rebase(branchId, outdatedRepoints(branchId))) with
  | Ok(r) -> Stdlib.Result.Result.Ok(r)
  | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))


/// "owner.Module.Sub.name" -> (owner, dotted-modules, name). The inverse of <fn fqnOf>, and it has to
/// stay that way: `dark resolve <name>` is handed back a name a conflict listing printed.
let parseFqn(fqn: String): Stdlib.Option.Option<(String * String * String)> =
  match Stdlib.String.split(fqn, ".") with
  | [] -> Stdlib.Option.Option.None
  | [ _single ] -> Stdlib.Option.Option.None
  | [owner, ...rest] ->
    // The LAST segment is the name; everything between owner and it is the module path.
    let n = Stdlib.List.length(rest)
    let modules = rest |> Stdlib.List.take(n - 1) |> (fun ms -> Stdlib.String.join(ms, "."))

    match Stdlib.List.last(rest) with
    | Some(name) -> Stdlib.Option.Option.Some((owner, modules, name))
    | None -> Stdlib.Option.Option.None


/// The branch's OWN frontier ops with their ids, oldest-first. Just this branch's tag, not the chain.
///
/// Ordered, because callers take the LAST one as the branch's current word on a name; unordered, that is
/// whatever the query happened to return. Skips an op this build cannot decode rather than raising: a
/// peer's op on a newer format is stored here on purpose.
let ownFrontierOps(
  branchId: Uuid)
  : List<(Uuid * LanguageTools.ProgramTypes.PackageOp)> =
  ownFrontierOpsWithSource(branchId)
  |> Stdlib.List.map(fun((id, op, _)) -> (id, op))


/// <fn ownFrontierOps>, with what put each op on the branch: 'op', 'propagation' or 'resolution' (see
/// `package_ops.source`). What lets a branch tell an edit you typed from a repoint that followed one.
let ownFrontierOpsWithSource(
  branchId: Uuid)
  : List<(Uuid * LanguageTools.ProgramTypes.PackageOp * String)> =
  ownOpRows(branchId)
  |> Stdlib.List.filterMap(fun row ->
    match (Stdlib.Uuid.parse(row.id), row.op) with
    | (Ok(id), Some(op)) -> Stdlib.Option.Option.Some((id, op, row.source))
    | _ -> Stdlib.Option.Option.None)


/// A branch's own op rows, oldest first, each with its `source`. The one query
/// behind <fn ownFrontierOpsWithSource>, `branchBindings` and `branchOps`.
let ownOpRows(branchId: Uuid): List<SCM.PackageOps.OpRow> =
  SCM.PackageOps.rowsOf(SCM.PackageOps.OpFilter.Own(branchId))


/// Does this op bind <param key>? True for a SetName and for a Decision that overrides the binding, since
/// both are the branch saying what that name points at.
let opBindsKey(
  op: LanguageTools.ProgramTypes.PackageOp,
  key: (String * String * String))
  : Stdlib.Option.Option<(LanguageTools.ProgramTypes.PackageLocation *
      LanguageTools.ProgramTypes.Reference)> =
  let (owner, modules, name) = key

  let matches(loc: LanguageTools.ProgramTypes.PackageLocation): Bool =
    (loc.owner == owner)
    && ((Stdlib.String.join(loc.modules, ".")) == modules)
    && (loc.name == name)

  LanguageTools.ProgramTypes.PackageOp.bindingOps(op)
  |> Stdlib.List.filterMap(fun effect ->
    match effect with
    | SetName(loc, target, _) ->
      if matches(loc) then
        Stdlib.Option.Option.Some((loc, target))
      else
        Stdlib.Option.Option.None
    | Decision(_, loc, _, Override(target)) ->
      if matches(loc) then
        Stdlib.Option.Option.Some((loc, target))
      else
        Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None)
  |> Stdlib.List.last


/// RESOLVE take-theirs: drop the branch's binding for <param fqn> -- every op that binds it, a `SetName`
/// or the override a `resolve mine` wrote -- so the branch's view falls back to the parent's version, and move
/// the name's base to the parent's current. One action.
let resolveTakeTheirs(
  branchId: Uuid,
  fqn: String)
  : Stdlib.Result.Result<Unit, String> =
  resolveName(branchId, fqn, false)


/// RESOLVE keep-mine: author an OVERRIDE that re-states the branch's binding with a stamp that wins LWW,
/// and move the name's base to the parent's current. One action.
///
/// It authors a NEW op rather than re-stamping the existing `SetName`, and that distinction is the whole
/// point: `origin_ts` is a PORTABLE stamp, byte-identical on every machine holding that op, because it is
/// what LWW compares. Rewriting it locally on an op that has already travelled makes two peers resolve
/// the same pair of bindings differently, forever.
let resolveKeepMine(
  branchId: Uuid,
  fqn: String)
  : Stdlib.Result.Result<Unit, String> =
  resolveName(branchId, fqn, true)


/// Parse <param fqn>, keep the branch's version (<param mine>) or take the parent's, and word what went
/// wrong.
let resolveName(
  branchId: Uuid,
  fqn: String,
  mine: Bool)
  : Stdlib.Result.Result<Unit, String> =
  match parseFqn(fqn) with
  | None -> Stdlib.Result.Result.Error($"can't parse a name from \"{fqn}\"")
  | Some((owner, modules, name)) ->
    let resolution =
      if mine then
        SCM.Actions.Resolution.KeepMine(branchId, owner, modules, name)
      else
        SCM.Actions.Resolution.TakeTheirs(branchId, owner, modules, name)

    match SCM.Actions.resolve(resolution) with
    | Ok(_) -> Stdlib.Result.Result.Ok()
    // The NAME, because this reaches a person through `dark resolve` and a name is what they typed.
    | Error(Refused(NotBound)) ->
      Stdlib.Result.Result.Error(
        $"branch \"{SCM.PackageOps.branchName(branchId)}\" doesn't bind {fqn} -- nothing to resolve")
    | Error(e) -> Stdlib.Result.Result.Error(SCM.Actions.failureMessage(e))
