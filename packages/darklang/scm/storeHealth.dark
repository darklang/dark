module Darklang.SCM.StoreHealth

// Things that can be wrong with the STORE itself, as opposed to with your code. Each is a condition this
// design can produce and nothing else reports:
//
//   - the fold QUARANTINES an op it can't parse: marks it applied, skips it, one line to stderr, and never
//     mentions it again.
//   - a live name bound to a hash with no content: the name resolves, and fetching it finds nothing.
//
// NOT a command -- a health check you have to think of is one nobody runs, so `dark status` reports these
// when non-zero. Read-only: this reports, it never repairs.


/// The raw counts behind <fn problems>, each 0 when it can't be answered: ops stamped more than a
/// day ahead of now, ops the fold never applied, and live names bound to a hash with no content.
type Counts =
  { futureStamped: Int64
    unfolded: Int64
    danglingBindings: Int64 }

/// Count everything <fn problems> reports on, straight from the store.
let counts(): Counts = Builtin.scmHealth()

/// Where a problem's damage is.
type Damage =
  /// A projection: a reload rebuilds past it.
  | Projection
  /// The log: re-folding reproduces it.
  | Log

/// One thing wrong with the store, and whether re-folding is the way out.
///
/// The two kinds have opposite remedies: a PROJECTION can be thrown away and rebuilt from the log, so
/// "reload" genuinely fixes it, while a CANONICAL row can't -- the log is what's wrong, and re-folding
/// reproduces it faithfully.
type Problem =
  { text: String
    damage: Damage }

let countedProblem(n: Int64, damage: Damage, what: String): List<Problem> =
  if n > 0 then
    [ Problem
        { text = $"{Stdlib.display(n)} {what}"
          damage = damage } ]
  else
    []

/// Everything wrong with the store right now. Empty when it's healthy.
///
/// main-scoped, on purpose: health is a property of the store's log and main's projections of it.
let problems(): List<Problem> =
  let c = counts()

  Stdlib.List.flatten(
    [ // `package_ops` is the log itself. Re-folding replays them exactly as they are.
      //
      // A stamp well ahead of now means some instance's clock is wrong. Ordering still works -- the
      // authoring clock advances past anything it receives, so your later edits win -- but the stamps
      // stop meaning "when", and a day is far outside any plausible skew.
      countedProblem(
        c.futureStamped,
        Damage.Log,
        "op(s) stamped over a day in the future (a peer's clock is wrong)")

      // What a fold produces, so a fold can produce it again correctly.
      countedProblem(
        c.unfolded,
        Damage.Projection,
        "op(s) that never folded (the fold stopped partway, or they don't parse)")

      // The log, despite living in a projection: the reachable cause is a missing op (a `SetName`
      // arrived without the `AddX` carrying its content), and a re-fold replays that SetName and rebinds
      // it identically. The lost-projection-row direction would refold, but only hand-edited tables
      // reach it, so classify by the cause people hit.
      countedProblem(
        c.danglingBindings,
        Damage.Log,
        "live name(s) bound to a hash with no content (an op that carries it never arrived)") ])
