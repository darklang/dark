module Darklang.SCM.PackageOps

// Reading the op log as HISTORY: recent ops, the ops in a commit, counts and summaries.
//
// Same module as `packageOps.dark`; see the note there.


/// Get recent package ops (fully decoded), newest first.
let getRecent(limit: Int64): List<LanguageTools.ProgramTypes.PackageOp> =
  let n = limit
  decodeOpRows((query(OpFilter.Recent, n)).ops)


/// Ops whose id starts with <param prefix>, fully decoded -- for inspecting op CONTENT. Newest 20: a
/// prefix short enough to match more than a handful is a typo, not a listing.
let getByIdPrefix(
  prefix: String)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRows((query(OpFilter.IdPrefix(prefix), 20)).ops)


let opsInCommitLimited(
  commitHash: String,
  limit: Int64)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRows((query(OpFilter.InCommit(commitHash), limit)).ops)


/// How many ops a commit committed.
let opCountIn(commitHash: String): Int64 = countOf(OpFilter.InCommit(commitHash))


/// How many ops are in the log.
let count(): Int64 = countOf(OpFilter.Recent)


/// How many ops this branch can see: main's log, plus that branch's chain's own delta ops. Another
/// branch's ops are in the same table but invisible from here -- that isolation is the point of the
/// overlay.
let countFor(branchId: Uuid): Int64 = countOf(OpFilter.Visible(branchId))


/// An op row as `dark ops` lists it. The op is None for one this build cannot read: a synced store's
/// log holds ops this build cannot read, and a listing that raised on one would be a listing you
/// cannot run.
let summaryOf(row: OpRow): OpSummary =
  OpSummary
    { id = row.id
      sizeBytes = row.sizeBytes
      ts = row.ts
      op = row.op }


/// The <param limit> most recent op summaries this branch can see, newest first by insertion order.
let summariesFor(branchId: Uuid, limit: Int64): List<OpSummary> =
  (query(OpFilter.Visible(branchId), limit)).ops |> Stdlib.List.map(summaryOf)


/// The ops this branch can see that LANDED here at or after <param since> (a `created_at`, local
/// insert time, millisecond resolution), oldest first, as (id, `created_at`). Ids only, no blobs: the
/// caller drops the ones it has seen before and asks `summariesByIds` about the rest.
///
/// The "what changed?" query for a process that stays up (`LanguageTools.Live.poll`). By insert time, not
/// `origin_ts` and not `rowid`: the origin stamp is a logical clock that runs ahead after a big batch
/// (a package reload mints thousands a millisecond apart) and arrives from peers with THEIR clocks, so
/// "newer than the log's newest" misses real edits; a rowid is reused after a delete. Insert time only
/// moves forward on this store: writes take the store's one write lock in turn, so a transaction still
/// in flight stamps no earlier than anything already committed. It can stamp the SAME instant, and
/// commit after the clock has moved on, which is why `since` itself is always included. What it cannot
/// do is tell a new op from an old one handed back by a draft rewrite (`WipRefresh` deletes and
/// re-inserts main's draft, with a fresh insert time and the same id); that is rare, and the caller
/// treats a flood as "everything changed".
///
/// APPLIED ops only. An op is inserted before it is folded into `locations` and marked applied, so a
/// reader that saw it inserted but not folded would see the op in the log while the name still
/// resolves to the previous hash. A host that took the op then would check the old version, keep it,
/// and never look again. Reporting an op only once it is applied means a host that looks mid-fold sees
/// nothing new, and the poll after the fold sees the op.
let landedSince(branchId: Uuid, since: String): List<(String * String)> =
  rowsOf(OpFilter.LandedSince(branchId, since)) |> Stdlib.List.map(fun r -> (r.id, r.ts))


/// The summaries for <param ids>, in the order given. An id the log does not hold is skipped.
let summariesByIds(ids: List<String>): List<OpSummary> =
  if Stdlib.List.isEmpty(ids) then
    []
  else
    let found = rowsOf(OpFilter.Ids(ids)) |> Stdlib.List.map(summaryOf)

    ids
    |> Stdlib.List.filterMap(fun id -> found |> Stdlib.List.findFirst(fun s -> s.id == id))


/// The newest instant an APPLIED op landed here (`created_at`), on any branch, and the ids that
/// landed at it; ("", []) for an empty log. Where a watcher starts from. Applied only, as
/// `landedSince`: an op inserted and not yet folded must not advance a watcher past itself.
let landedLast(): (String * List<String>) =
  let rows = rowsOf(OpFilter.LandedLast)

  match Stdlib.List.head(rows) with
  | Some(first) -> (first.ts, rows |> Stdlib.List.map(fun r -> r.id))
  | None -> ("", [])


/// How many commits this branch has, without decoding any of them.
///
/// The same predicate `commitsOnBranch` selects with, counted in SQLite, so nothing is decoded to
/// print one number.
let commitCountOnBranch(branchId: Uuid): Int64 =
  (Commits.query(Commits.CommitFilter.OnBranch(branchId), 0)).total


/// The commits whose ops live on <param branchId>, newest first.
///
/// A commit belongs to `commits.branch_id`, and a merge moves it to the parent. That is what a branch
/// OWNS, a different question from what it can SEE: "owns" answers "what did I do that the parent has
/// not" -- the number Home means when it says a branch is N ahead.
let commitsOnBranch(branchId: Uuid, limit: Int64): List<Commits.Commit> =
  (Commits.query(Commits.CommitFilter.OnBranch(branchId), limit)).commits

