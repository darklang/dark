module Darklang.SCM.PackageOps

// Reading the op log as HISTORY: recent ops, the ops in a commit, counts and summaries.
//
// Same module as `packageOps.dark`; see the note there.


/// Get recent package ops (fully decoded), newest first.
let getRecent(limit: Int): List<LanguageTools.ProgramTypes.PackageOp> =
  let n = Stdlib.Int.toInt64(limit) |> Stdlib.Option.withDefault(-1L)
  decodeOpRows((query(OpFilter.Recent, n)).ops)


/// Ops whose id starts with <param prefix>, fully decoded -- for inspecting op CONTENT. Newest 20: a
/// prefix short enough to match more than a handful is a typo, not a listing.
let getByIdPrefix(
  prefix: String)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRows((query(OpFilter.IdPrefix(prefix), 20L)).ops)


let opsInCommitLimited(
  commitHash: String,
  limit: Int64)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRows((query(OpFilter.InCommit(commitHash), limit)).ops)


/// How many ops a commit committed.
let opCountIn(commitHash: String): Int64 = countOf(OpFilter.InCommit(commitHash))


/// How many ops are in the log.
let count(): Int64 = countOf(OpFilter.Recent)


/// How many ops this branch can see: main's log, plus that branch's chain's own delta ops. Another
/// branch's ops are in the same table but invisible from here -- that isolation is the point of the
/// overlay.
let countFor(branchId: Uuid): Int64 = countOf(OpFilter.Visible(branchId))


/// An op row as `dark ops` lists it. The op is None for one this build cannot read: a synced store's
/// log holds ops this build cannot read, and a listing that raised on one would be a listing you
/// cannot run.
let summaryOf(row: OpRow): OpSummary =
  OpSummary
    { id = row.id
      sizeBytes = row.sizeBytes
      ts = row.ts
      op = row.op }


/// The <param limit> most recent op summaries this branch can see, newest first by insertion order.
let summariesFor(branchId: Uuid, limit: Int64): List<OpSummary> =
  (query(OpFilter.Visible(branchId), limit)).ops |> Stdlib.List.map(summaryOf)


/// The ids of the ops this branch can see that LANDED here after <param since> (a `created_at`, local
/// insert time, second resolution), oldest first; and the ones AT <param since> too when
/// <param andAtSince> says that second may still be filling. Ids only, no blobs: the caller drops
/// the ones it has seen before and asks `summariesByIds` about the rest.
///
/// The "what changed?" query for a process that stays up (`Stdlib.Live.poll`). By insert time, not
/// `origin_ts` and not `rowid`: the origin stamp is a logical clock that runs ahead after a big batch
/// (a package reload mints thousands a millisecond apart) and arrives from peers with THEIR clocks, so
/// "newer than the log's newest" misses real edits; a rowid is reused after a delete. Insert time only
/// moves forward on this store. What it cannot do is tell a new op from an old one handed back by a
/// draft rewrite (`WipRefresh` deletes and re-inserts main's draft, with a fresh insert time and the
/// same id); that is rare, and the caller treats a flood as "everything changed".
///
/// APPLIED ops only. An op is inserted before it is folded into `locations` and marked applied after
/// (authoring: two transactions; a pull: one), so between the two a reader sees the op in the log while
/// the name still resolves to the previous hash. A host that took the op then would check the old
/// version, keep it, and never look again: the fold's own commit moves the store's counter, but the
/// next poll would find no op it had not already reported. Reporting an op only once it is applied
/// means a host that looks mid-fold sees nothing new, and the poll after the fold sees the op.
///
/// A BRANCH's own ops are the exception: they are stored inert (`applied = 0` is their steady
/// state, since nothing folds them into main's `locations`) and tagged onto the branch in the same
/// transaction, so there is no window, and a tagged op is complete the moment it is visible. A
/// branch watch takes main's ops when applied and its chain's ops when tagged.
let idsLandedSince(branchId: Uuid, since: String, andAtSince: Bool): List<String> =
  idsOf(OpFilter.LandedSince(branchId, since, andAtSince))


/// The summaries for <param ids>, in the order given. An id the log does not hold is skipped.
let summariesByIds(ids: List<String>): List<OpSummary> =
  if Stdlib.List.isEmpty(ids) then
    []
  else
    let found = rowsOf(OpFilter.Ids(ids)) |> Stdlib.List.map(summaryOf)

    ids
    |> Stdlib.List.filterMap(fun id -> found |> Stdlib.List.findFirst(fun s -> s.id == id))


/// When the newest APPLIED op in the log landed here (`created_at`), or "" for an empty log. Where a
/// watcher starts from. Applied only, as `idsLandedSince`: an op inserted and not yet folded must not
/// advance a watcher past itself.
/// An op counts as landed once it is applied (main's ops) or tagged onto a branch (a branch's
/// own ops are inert, `applied = 0` for good, and tagged in the same transaction they are stored
/// in). The same rule `idsLandedSince` reports by; a frontier taken by a narrower rule sits behind
/// every branch op, and a branch watch then re-reports its whole history on every poll.
let newestInsert(): String = stampOf(OpFilter.NewestLanded)


/// The ids of the ops that landed at exactly <param at> (a `created_at`). A watcher that resumes from
/// `at` while that second may still be filling gets these back, and drops them.
let idsInsertedAt(at: String): List<String> = idsOf(OpFilter.LandedAt(at))


/// The store's clock, in `created_at` form, so a watcher can tell whether the second it last saw an
/// insert in is still the current one.
let storeNow(): String = stampOf(OpFilter.StoreNow)


/// How many commits this branch has, without decoding any of them.
///
/// The same predicate `commitsOnBranch` selects with, counted in SQLite. The listing used to get
/// this by asking for a hundred thousand commits and taking the length, which decodes every row of
/// a store's whole history to print one number above twenty lines.
let commitCountOnBranch(branchId: Uuid): Int64 =
  (Commits.query(Commits.CommitFilter.OnBranch(branchId), 0L)).total


/// The commits whose ops live on <param branchId>, newest first.
///
/// `commits` has no branch column, and cannot: a commit is not ON a branch, its OPS are. So the question
/// goes to the log. A branch OWNS the ops tagged to it and nothing else; main owns the effective ops no
/// branch has claimed. That is a different question from what a branch can SEE: "owns" answers "what did
/// I do that the parent has not" -- the number Home means when it says a branch is N ahead.
let commitsOnBranch(branchId: Uuid, limit: Int64): List<Commits.Commit> =
  (Commits.query(Commits.CommitFilter.OnBranch(branchId), limit)).commits


/// The commit a new one on <param branchId> follows: the newest commit among the ops this branch can see
/// (a commit is not ON a branch, its ops are -- see `commitsOnBranch`). A branch that has committed
/// nothing answers with main's latest, keeping the chain continuous across a fork, and a branch off a
/// branch follows its parent's commits too.
///
/// The newest COMMIT this branch can see, not the commit of the newest visible OP. They differ whenever
/// commits are made out of authoring order, which `--include=` makes easy, and then the commit made
/// second is on nobody's chain.
///
/// Empty means this store has committed nothing yet, which is the only honest answer for a first commit.
let parentCommitFor(branchId: Uuid): String =
  let page = Commits.query(Commits.CommitFilter.ParentFor(branchId), 1L)

  match Stdlib.List.head(page.commits) with
  | Some(c) -> c.hash
  | None -> ""


/// True when every op in <param commitHash> is an ARCHIVE marker -- a `BranchEvent` recording
/// that a branch was discarded, carrying no authored work. `dark commits` hides these by
/// default; `--all` shows them. Merge events are never housekeeping: on a peer's machine the
/// merged work files under the author's commits and the merge commit holds only its event, and
/// hiding it there would make the same history read differently per machine.
let isHousekeepingCommit(commitHash: String): Bool =
  if (opCountIn(commitHash)) > 3L then
    false
  else
    let ops = opsInCommitLimited(commitHash, 4L)

    (Stdlib.Bool.not(Stdlib.List.isEmpty(ops)))
    && (ops
        |> Stdlib.List.all(fun op ->
          match op with
          | BranchEvent(_branchId, event, _at) ->
            match event with
            | Archived -> true
            | _ -> false
          | _ -> false))


