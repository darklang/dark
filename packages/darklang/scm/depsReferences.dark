module Darklang.SCM.Deps

/// Read selected callers, or all visible callers when sources is empty.
/// Read the graph in one batch, keeping each caller's reference names separate.
let namedReferencesFor(
  branchId: Uuid,
  sources: List<PackageOps.ReferenceSource>)
  : Result<List<NamedReference>, String> =
  Builtin.pmNamedReferences(branchId, sources)


/// Only stale references cross into Dark during a review, with the current target.
type StaleReference =
  (LanguageTools.ProgramTypes.PackageLocation *
   LanguageTools.ProgramTypes.Reference *
   LanguageTools.ProgramTypes.Reference *
   LanguageTools.ProgramTypes.PackageLocation *
   LanguageTools.ProgramTypes.Reference)


type DependencyReview =
  (List<StaleReference> *
   List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.PackageLocation)>)


let review(
  branchId: Uuid,
  changed: List<PackageOps.ReferenceSource>)
  : Result<DependencyReview, String> =
  Builtin.pmDependencyReview(branchId, changed)
