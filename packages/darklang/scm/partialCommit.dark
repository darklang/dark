module Darklang.SCM.PartialCommit

// Select the operations for `dark commit "msg" --include=Ux.A,Ux.B`.
// A partial commit uses the normal commit write, limited to the selected operations.
//
// 1. Include a name's content. A committed binding must not point at draft content.
// 2. Include the draft versions and names that content references, following their
//    dependencies too. Report any extra names added to the selection.
// 3. A propagated edit belongs to the caller that changed. Selecting that caller
//    includes the dependency it now uses. Selecting the dependency alone leaves
//    the caller's edit in the draft.
//
// A rename also needs the caller versions recorded with it. Later caller edits
// stay in the draft. Dependencies are included automatically so every committed
// reference has the content and name it needs.


/// A draft binding or reference-name change, with the operation ID and timestamp that recorded it.
type Selected =
  { fqn: String
    itemType: String
    hash: String
    opId: String
    ts: String
    metadataBefore: Stdlib.Option.Option<String> }

/// Is stamp <param a> after stamp <param b>? Stamps are fixed-width ISO text, so the ordinal order
/// `Stdlib.List.sort` uses is chronological.
let stringGt(a: String, b: String): Bool =
  if a == b then
    false
  else
    match Stdlib.List.sort([ a, b ]) with
    | [ lower, _ ] -> lower == b
    | _ -> false

/// `owner.modules.name` for a location, which is what a person types at `--include=`.
let fqnOf(location: LanguageTools.ProgramTypes.PackageLocation): String =
  let parts =
    Stdlib.List.prepend(Stdlib.List.append(location.modules, location.name), location.owner)

  Stdlib.String.join(parts, ".")

/// List draft bindings and reference-name changes in order, with their operation IDs.
/// Keep repeated edits to a name so a commit can include the earlier revisions it needs.
let namingsFrom(entries: List<SCM.PackageOps.DraftEntry>): List<Selected> =
  entries
  |> Stdlib.List.map(fun e ->
    LanguageTools.ProgramTypes.PackageOp.draftOps(e.op)
    |> Stdlib.List.filterMap(fun op ->
      match op with
      | Decision(_, location, _, Override(target))
      | SetName(location, target, _) ->
        let itemType =
          LanguageTools.ProgramTypes.ItemKind.toString(LanguageTools.ProgramTypes.Reference.kind(target))

        Stdlib.Option.Option.Some(
          Selected
            { fqn = fqnOf(location)
              itemType = itemType
              hash =
                LanguageTools.ProgramTypes.hashToString(
                  LanguageTools.ProgramTypes.Reference.hash(target))
              opId = e.id
              ts = e.ts
              metadataBefore = Stdlib.Option.Option.None }
        )
      | _ -> Stdlib.Option.Option.None))
  |> Stdlib.List.flatten

/// List the content hashes added by the draft.
/// Dependency selection also needs new names for content that is already committed.
let draftAddedHashes(entries: List<SCM.PackageOps.DraftEntry>): List<String> =
  entries
  |> Stdlib.List.filterMap(fun e ->
    match e.op with
    | AddFn(f) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(f.hash))
    | AddType(t) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(t.hash))
    | AddValue(v) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(v.hash))
    | AddTrait(t) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(t.hash))
    | AddTraitImpl(i) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(i.hash))
    | AddTest(test) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString(test.hash))
    | _ -> Stdlib.Option.Option.None)

/// Find dependencies of these hashes that still have draft content or names.
/// The dependency index records the hashes referenced by each stored body.
/// Reuse the pending hashes from closeOverDeps so each step does not read the draft again.
let draftDepsOf(pending: List<String>, hashes: List<String>): List<String> =
  if Stdlib.List.isEmpty(hashes) then
    []
  else
    SCM.Deps.query(SCM.Deps.DepQuery.Closure(hashes))
    |> Stdlib.List.map(fun e -> e.dependsOnHash)
    |> Stdlib.List.filter(fun h -> Stdlib.List.contains(pending, h))

/// Add draft dependencies that are not yet selected.
let closeStep(pending: List<String>, acc: List<String>): List<String> =
  let next =
    draftDepsOf(pending, acc)
    |> Stdlib.List.filter(fun h -> Stdlib.Bool.not(Stdlib.List.contains(acc, h)))

  Stdlib.List.concat(acc, next)

/// Include draft dependencies until no new content is found.
/// Each round adds only unseen hashes, so cycles terminate too.
let closeOverDeps(entries: List<SCM.PackageOps.DraftEntry>, namings: List<Selected>, hashes: List<String>): List<String> =
  // Build this list once and reuse it in every round.
  // Include new names for existing content: callers need those names committed too.
  // plan selects the names separately so unrelated aliases stay in the draft.
  let pending =
    Stdlib.List.concat(
      draftAddedHashes(entries),
      namings |> Stdlib.List.map(fun s -> s.hash))
    |> Stdlib.List.unique
  let walk(acc: List<String>): List<String> =
    let next = closeStep(pending, acc)
    if next == acc then acc else walk(next)
  walk(Stdlib.List.unique(hashes))

/// Return this operation's ID if it adds content for a wanted hash.
let contentIdIfWanted(
  wantedHashes: List<String>,
  e: SCM.PackageOps.DraftEntry)
  : Stdlib.Option.Option<String> =
  let hashOf(h: LanguageTools.ProgramTypes.Hash): String =
    LanguageTools.ProgramTypes.hashToString(h)

  let target =
    match e.op with
    | AddFn(f) -> Stdlib.Option.Option.Some(hashOf(f.hash))
    | AddType(t) -> Stdlib.Option.Option.Some(hashOf(t.hash))
    | AddValue(v) -> Stdlib.Option.Option.Some(hashOf(v.hash))
    | AddTrait(t) -> Stdlib.Option.Option.Some(hashOf(t.hash))
    | AddTraitImpl(i) -> Stdlib.Option.Option.Some(hashOf(i.hash))
    | AddTest(test) -> Stdlib.Option.Option.Some(hashOf(test.hash))
    | _ -> Stdlib.Option.Option.None

  match target with
  | Some(h) ->
    if Stdlib.List.contains(wantedHashes, h) then
      Stdlib.Option.Option.Some(e.id)
    else
      Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None

/// Return this operation's ID if it updates documentation or deprecation for a selected name.
/// Both belong to the name, so select these edits by name.
let docIdIfWanted(
  wantedFqns: List<String>,
  e: SCM.PackageOps.DraftEntry)
  : Stdlib.Option.Option<String> =
  let location =
    match e.op with
    | UpdateDoc(location, _, _, _, _) -> Stdlib.Option.Option.Some(location)
    | Deprecate(location, _, _, _, _) -> Stdlib.Option.Option.Some(location)
    | Undeprecate(location, _, _) -> Stdlib.Option.Option.Some(location)
    | _ -> Stdlib.Option.Option.None
  match location with
  | Some(loc) ->
    if Stdlib.List.contains(wantedFqns, fqnOf(loc)) then Stdlib.Option.Option.Some(e.id)
    else Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None


/// Which names `--include=` asked for that the draft doesn't hold.
let unknownNames(names: List<String>): List<String> =
  let held = namingsFrom(SCM.PackageOps.draftEntries()) |> Stdlib.List.map(fun s -> s.fqn) |> Stdlib.List.unique

  names |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(held, n)))

/// Include the versions needed by the selected changes.
/// For a rename, keep later edits to its callers in the draft.
let closeOverNamings(entries: List<SCM.PackageOps.DraftEntry>, namings: List<Selected>, selected: List<Selected>): List<Selected> =
  let required(location: LanguageTools.ProgramTypes.PackageLocation, target: LanguageTools.ProgramTypes.Reference, before: Stdlib.Option.Option<String>): List<Selected> =
    let name = fqnOf(location)
    let hash = LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(target))
    let kind = LanguageTools.ProgramTypes.ItemKind.toString(LanguageTools.ProgramTypes.Reference.kind(target))
    let matches(naming: Selected): Bool =
      let sameVersion = naming.fqn == name && naming.hash == hash && naming.itemType == kind
      let earlyEnough = match before with
        | Some(stamp) -> Stdlib.Bool.not(stringGt(naming.ts, stamp))
        | None -> true
      sameVersion && earlyEnough
    match namings |> Stdlib.List.filter(matches) |> Stdlib.List.last with
    | None -> []
    | Some(chosen) ->
      // Include earlier versions too. Otherwise they remain in the draft
      // and appear as outstanding edits after the newer version is committed.
      namings |> Stdlib.List.filter(fun naming ->
        naming.fqn == name && naming.itemType == kind
        && Stdlib.Bool.not(stringGt(naming.ts, chosen.ts)))
      |> Stdlib.List.map(fun naming -> { naming with metadataBefore = before })
  let walk(pending: List<Selected>, selected: List<Selected>): List<Selected> =
    let ids = pending |> Stdlib.List.map(fun naming -> naming.opId)
    let dependencies = pending |> Stdlib.List.map(fun naming ->
      let version = LanguageTools.ProgramTypes.Reference.fromHashAndKind(
        LanguageTools.ProgramTypes.Hash.Hash(naming.hash), Deps.kindOf(naming.itemType))
      // For a rename, read dependency names as they were when the rename was made.
      let edges = match SCM.Branches.parseFqn(naming.fqn) with
        | None -> []
        | Some((owner, modules, name)) ->
          PackageOps.referenceSnapshotsAt(PackageOps.currentBranch(), [ (Deps.locationOf(owner, modules, name), version) ], naming.metadataBefore)
          |> Stdlib.List.map(fun snapshot -> snapshot.names)
          |> Stdlib.List.flatten
          |> Stdlib.List.filterMap(fun((target, name)) -> name |> Stdlib.Option.map(fun location -> (target, location)))
      edges |> Stdlib.List.map(fun((target, location)) -> required(location, target, naming.metadataBefore)) |> Stdlib.List.flatten)
      |> Stdlib.List.flatten
    let renameVersions = entries |> Stdlib.List.filterMap(fun entry ->
      if Stdlib.List.contains(ids, entry.id) then
        match entry.op with
        | Rename(oldLocation, _, target, snapshots, _) ->
          Stdlib.Option.Option.Some(Stdlib.List.concat(
            required(oldLocation, target, Stdlib.Option.Option.Some(entry.ts)),
            snapshots |> Stdlib.List.map(fun snapshot -> required(snapshot.location, snapshot.target, Stdlib.Option.Option.Some(entry.ts))) |> Stdlib.List.flatten))
        | _ -> Stdlib.Option.Option.None
      else Stdlib.Option.Option.None) |> Stdlib.List.flatten
    let next = Stdlib.List.unique(Stdlib.List.concat(dependencies, renameVersions))
      |> Stdlib.List.filter(fun naming -> Stdlib.Bool.not(Stdlib.List.contains(selected, naming)))
    if Stdlib.List.isEmpty(next) then selected else walk(next, Stdlib.List.concat(selected, next))
  let roots = Stdlib.List.unique(selected)
  walk(roots, roots)


/// Choose the operations needed to commit these names, and list any extra names they require.
/// Return an error if a requested name has no draft changes.
let plan(
  names: List<String>)
  : Stdlib.Result.Result<(List<String> * List<String>), String> =
  let entries = SCM.PackageOps.draftEntries()
  let namings = namingsFrom(entries)
  let held = namings |> Stdlib.List.map(fun naming -> naming.fqn)
  match names |> Stdlib.List.filter(fun name -> Stdlib.Bool.not(Stdlib.List.contains(held, name))) with
  | [] ->

    // Include every draft edit to each requested name so older edits are not left behind.
    let directly = namings |> Stdlib.List.filter(fun s -> Stdlib.List.contains(names, s.fqn))
    let keptNamings = closeOverNamings(entries, namings, directly)
    let wantedHashes = closeOverDeps(entries, namings, keptNamings |> Stdlib.List.map(fun s -> s.hash))

    let namingIds = keptNamings |> Stdlib.List.map(fun s -> s.opId)

    // Content for the same hashes (see `contentIdIfWanted`), plus the doc and deprecation edits
    // for the names in play, which are selected by name rather than by hash.
    let wantedFqns = Stdlib.List.unique(Stdlib.List.concat(names, keptNamings |> Stdlib.List.map(fun s -> s.fqn)))

    let otherIds =
      Stdlib.List.concat(
        entries |> Stdlib.List.filterMap(fun e -> contentIdIfWanted(wantedHashes, e)),
        entries |> Stdlib.List.filterMap(fun e -> docIdIfWanted(wantedFqns, e)))

    let pulledIn =
      keptNamings
      |> Stdlib.List.map(fun s -> s.fqn)
      |> Stdlib.List.unique
      |> Stdlib.List.filter(fun f -> Stdlib.Bool.not(Stdlib.List.contains(names, f)))

    (Stdlib.List.unique(Stdlib.List.concat(namingIds, otherIds)), pulledIn)
    |> Stdlib.Result.Result.Ok

  | missing ->
    let shown = Stdlib.String.join(missing, ", ")

    $"nothing in your draft is named: {shown}"
    |> Stdlib.Result.Result.Error
