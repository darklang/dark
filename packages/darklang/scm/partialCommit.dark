module Darklang.SCM.PartialCommit

// Committing PART of the draft: `dark commit "msg" --include=Ux.A,Ux.B`.
//
// The whole-draft commit is one UPDATE over a predicate. This is the same UPDATE narrowed to a chosen set of
// ops, and everything hard about it is deciding WHICH ops. Three rules, and each one exists because breaking
// it produces a commit that is internally inconsistent:
//
//   1. A name comes with its CONTENT. Committing `SetName(A -> h)` while `AddFn h` stays in the draft commits a
//      binding to something uncommitted -- history pointing at a keystroke.
//   2. A name comes with what its content NEEDS. If A's body references B's draft version, committing A alone
//      commits a reference to an uncommitted hash. So the selection closes over draft dependencies, transitively,
//      and says which items it pulled in.
//   3. A repoint belongs to the item it renamed, not to the edit that caused it. Naming a dependent pulls in
//      the source it now points at (rule 2 does that, since the repointed body references the source's draft
//      content). Naming the SOURCE does not drag its dependents' repoints along: those are changes to other
//      items, they stay in the draft, and they are still consistent because what they reference just got
//      committed. That is not a separate switch; it falls out of rule 2.
//
// What this deliberately does NOT do is let you commit an item while excluding something it depends on. That is
// expressible, and it is always wrong, so the closure is automatic and reported rather than optional.

let localDb () : String = Stdlib.LocalStore.path ()

/// One draft naming, with the row that wrote it.
type Selected =
  { fqn: String
    itemType: String
    hash: String
    opId: String }

/// `owner.modules.name` for a location, which is what a person types at `--include=`.
let fqnOf (location: LanguageTools.ProgramTypes.PackageLocation) : String =
  let parts =
    Stdlib.List.append [ location.owner ] (Stdlib.List.append location.modules [ location.name ])

  Stdlib.String.join parts "."

/// The namings the draft holds, newest LAST, one entry per op (not per name -- a name edited twice has two,
/// and both have to be committed together or the earlier one is left behind describing a version nobody has).
let draftNamings () : List<Selected> =
  SCM.PackageOps.draftEntries ()
  |> Stdlib.List.filterMap (fun e ->
    match e.op with
    | Decision(_, location, _, Override target)
    | SetName(location, target, _) ->
      let itemType =
        SCM.Deps.kindString (LanguageTools.ProgramTypes.Reference.kind target)

      Stdlib.Option.Option.Some(
        Selected
          { fqn = fqnOf location
            itemType = itemType
            hash =
              LanguageTools.ProgramTypes.hashToString
                (LanguageTools.ProgramTypes.Reference.hash target)
            opId = e.id }
      )
    | _ -> Stdlib.Option.Option.None)

/// The content hashes the draft ADDS. Only these participate in the dependency closure: a reference to
/// something already committed needs nothing done about it.
let draftAddedHashes () : List<String> =
  SCM.PackageOps.draftEntries ()
  |> Stdlib.List.filterMap (fun e ->
    match e.op with
    | AddFn f ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString f.hash)
    | AddType t ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString t.hash)
    | AddValue v ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString v.hash)
    | _ -> Stdlib.Option.Option.None)

/// What <param hashes> reference, restricted to <param added> (the hashes the draft adds).
///
/// Reads the recorded edges rather than the bodies: `package_dependencies` is written by the same fold that
/// wrote the content, so it can't disagree with what the item actually references.
///
/// `added` is a parameter: computing it decodes every draft blob, and the set can't change mid-closure
/// (see `closeOverDeps`).
let draftDepsOf (added: List<String>) (hashes: List<String>) : List<String> =
  if Stdlib.List.isEmpty hashes then
    []
  else
    let quoted =
      hashes |> Stdlib.List.map (fun h -> $"'{h}'") |> Stdlib.String.join ", "

    (Stdlib.Sqlite.columnP
      (localDb ())
      $"SELECT DISTINCT depends_on_hash AS h FROM package_dependencies
        WHERE item_hash IN ({quoted}) AND depends_on_hash != ''"
      []
      "h")
    |> Stdlib.List.filter (fun h -> Stdlib.List.``member`` added h)

/// One round of closure: whatever <param acc> references that the draft adds and acc doesn't have yet.
let closeStep (added: List<String>) (acc: List<String>) : List<String> =
  let next =
    draftDepsOf added acc
    |> Stdlib.List.filter (fun h -> Stdlib.Bool.not (Stdlib.List.``member`` acc h))

  Stdlib.List.append acc next

/// Close a hash set over draft dependencies.
///
/// Folded a bounded number of times rather than recursed to a fixpoint, and the bound is the termination
/// argument: each round either adds a hash the draft holds or changes nothing, so the draft's own size is
/// more rounds than can ever be needed. A cycle therefore can't hang it.
let closeOverDeps (hashes: List<String>) : List<String> =
  // Read ONCE, then passed down: it decodes every blob in the draft, and both the round count and every
  // round need it, so asking per use is N+1 full decodes of the draft to commit a subset of it.
  let added = draftAddedHashes ()
  let rounds = Stdlib.List.length added + 1

  Stdlib.List.range 1 rounds
  |> Stdlib.List.fold (Stdlib.List.unique hashes) (fun acc _ -> closeStep added acc)

/// The names <param names> depend on, transitively, by NAME rather than by content hash.
///
/// `package_dependencies` records edges as owner/modules/name, which is what makes this able to
/// tell "B is a dependency of A" from "B happens to have A's body". Bounded the same way
/// `closeOverDeps` is bounded, and for the same reason.
let closeOverDepFqns (names: List<String>) : List<String> =
  // main-scoped: `--include=` is a MAIN commit surface (a branch commits its whole frontier), so
  // reading main's `locations` to resolve a name to its dependencies is the right scope here.
  let step (acc: List<String>) : List<String> =
    let next =
      acc
      |> Stdlib.List.map (fun fqn ->
        Stdlib.Sqlite.rowsOrEmptyP
          (SCM.PackageOps.localDb ())
          "SELECT d.depends_on_owner AS o, d.depends_on_modules AS m, d.depends_on_name AS n
           FROM package_dependencies d
           JOIN locations l ON l.item_hash = d.item_hash
           WHERE l.owner || '.' || (CASE WHEN l.modules = '' THEN '' ELSE l.modules || '.' END)
                 || l.name = @p0
             AND d.depends_on_name <> ''"
          [ fqn ]
          |> Stdlib.List.filterMap (fun row ->
            match
              (Stdlib.Sqlite.textField row "o",
               Stdlib.Sqlite.textField row "m",
               Stdlib.Sqlite.textField row "n")
            with
            | (Some o, Some m, Some n) ->
              let mid = if m == "" then "" else m ++ "."
              Stdlib.Option.Option.Some(o ++ "." ++ mid ++ n)
            | _ -> Stdlib.Option.Option.None))
      |> Stdlib.List.flatten
    Stdlib.List.unique (Stdlib.List.append acc next)

  Stdlib.List.range 1 8
  |> Stdlib.List.fold (Stdlib.List.unique names) (fun acc _ -> step acc)


/// The op id of <param e>, when it carries CONTENT (or a deprecation) for one of <param wantedHashes>.
///
/// Deprecations are keyed on content rather than on a name, so they travel with the hash.
let contentIdIfWanted
  (wantedHashes: List<String>)
  (e: SCM.PackageOps.DraftEntry)
  : Stdlib.Option.Option<String> =
  let hashOf (h: LanguageTools.ProgramTypes.Hash) : String =
    LanguageTools.ProgramTypes.hashToString h

  let target =
    match e.op with
    | AddFn f -> Stdlib.Option.Option.Some(hashOf f.hash)
    | AddType t -> Stdlib.Option.Option.Some(hashOf t.hash)
    | AddValue v -> Stdlib.Option.Option.Some(hashOf v.hash)
    // A `Reference`, not a `Hash`: deprecations key on content, and the hash is inside the reference.
    | Deprecate(target, _, _) ->
      Stdlib.Option.Option.Some(hashOf (LanguageTools.ProgramTypes.Reference.hash target))
    | Undeprecate target ->
      Stdlib.Option.Option.Some(hashOf (LanguageTools.ProgramTypes.Reference.hash target))
    // Same as a deprecation: it says something ABOUT content, so `--include=` finds it by the
    // name that content is bound to.
    | Describe(target, _) ->
      Stdlib.Option.Option.Some(hashOf (LanguageTools.ProgramTypes.Reference.hash target))
    | _ -> Stdlib.Option.Option.None

  match target with
  | Some h ->
    if Stdlib.List.``member`` wantedHashes h then
      Stdlib.Option.Option.Some e.id
    else
      Stdlib.Option.Option.None
  | None -> Stdlib.Option.Option.None

/// Which names `--include=` asked for that the draft doesn't hold.
let unknownNames (names: List<String>) : List<String> =
  let held = draftNamings () |> Stdlib.List.map (fun s -> s.fqn) |> Stdlib.List.unique

  names |> Stdlib.List.filter (fun n -> Stdlib.Bool.not (Stdlib.List.``member`` held n))

/// The ops to commit for <param names>, and the FQNs that came along by closure.
///
/// Returns Error for a name the draft doesn't hold: `--include=` naming something with no draft changes is a
/// typo or a misunderstanding, and committing the whole draft (or nothing) in response are both worse than
/// saying so.
let plan
  (names: List<String>)
  : Stdlib.Result.Result<(List<String> * List<String>), String> =
  match unknownNames names with
  | [] ->
    let namings = draftNamings ()

    // Every naming for a requested name, not just the last: an intermediate naming left in the draft would
    // describe a version that is no longer what the name means, with nothing to collapse it later.
    let directly =
      namings |> Stdlib.List.filter (fun s -> Stdlib.List.``member`` names s.fqn)

    let wantedHashes =
      closeOverDeps (directly |> Stdlib.List.map (fun s -> s.hash))

    // A naming counts if its target is in the closed hash set AND the name is one the selection is
    // actually about: requested outright, or reachable from a requested item through the dependency
    // graph.
    //
    // The hash test alone was not enough, because a hash is CONTENT: two unrelated names with
    // identical bodies share one, so `--include=` of a finished function also committed a private
    // half-done one that happened to have the same body, and reported it as "needed by what you
    // named". Nothing depended on it; it just looked the same.
    let reachableFqns = closeOverDepFqns names

    let keptNamings =
      namings
      |> Stdlib.List.filter (fun s ->
        (Stdlib.List.``member`` wantedHashes s.hash)
        && ((Stdlib.List.``member`` names s.fqn)
            || (Stdlib.List.``member`` reachableFqns s.fqn)))

    let namingIds = keptNamings |> Stdlib.List.map (fun s -> s.opId)

    // Content and deprecations for the same hashes (see `contentIdIfWanted`).
    let otherIds =
      SCM.PackageOps.draftEntries ()
      |> Stdlib.List.filterMap (fun e -> contentIdIfWanted wantedHashes e)

    let pulledIn =
      keptNamings
      |> Stdlib.List.map (fun s -> s.fqn)
      |> Stdlib.List.unique
      |> Stdlib.List.filter (fun f -> Stdlib.Bool.not (Stdlib.List.``member`` names f))

    (Stdlib.List.unique (Stdlib.List.append namingIds otherIds), pulledIn)
    |> Stdlib.Result.Result.Ok

  | missing ->
    let shown = Stdlib.String.join missing ", "

    $"nothing in your draft is named: {shown}"
    |> Stdlib.Result.Result.Error
