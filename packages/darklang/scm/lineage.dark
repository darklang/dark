/// What a binding REPLACED, recorded at the moment of authoring.
///
/// A `SetName` says what a name points at AND what it pointed at before. Without the second half, an
/// ordinary edit and an independent creation are the same shape to another machine: "one local binding,
/// one incoming binding, no shared base". With it they are different facts -- your edit of my function
/// names my hash as its predecessor, and two people who each invented the same name name nothing.
///
/// This is the ONE place that answers the question, and it answers it by asking the store. Parsers
/// cannot: they read a source file and have no store. So they emit `None`, this fills it in on the way
/// to being stored, and `None` survives only where it is true.
///
/// `None` means "no predecessor known", NOT "there was definitely nothing there". A conclusion is only
/// drawn when both sides of a comparison say it, which is why the weaker reading is safe.
module Darklang.SCM.Lineage

/// The hash currently bound at `location` for `kind` on the PARENT of the branch being authored on (on
/// main, main itself), if anything is.
///
/// A branch's binding replaced what its PARENT binds, which is the fact a later merge wants: not the
/// branch's own previous version.
let currentlyBound(
  parent: Uuid,
  location: LanguageTools.ProgramTypes.PackageLocation,
  kind: LanguageTools.ProgramTypes.ItemKind)
  : Option<LanguageTools.ProgramTypes.Hash> =
  PackageOps.liveBindingFor(parent, location)
  |> Stdlib.Option.andThen(fun b ->
    if b.itemType == LanguageTools.ProgramTypes.ItemKind.toString(kind) then
      Option.Some(LanguageTools.ProgramTypes.Hash.Hash(b.hash))
    else
      Option.None)


/// Fill in `previous` on every SetName in `ops` that does not already carry one.
///
/// Ops are looked at in order and the answer is taken from the store, so a batch that binds the same
/// name twice records the same predecessor for both. That is correct: both replaced what was there when
/// the batch started, and the second's real predecessor is the first, which is in the same batch and
/// travels with it. Chasing that would mean the fold's own ordering rules leaking into authoring.
///
/// An op that already carries a predecessor keeps it. Propagation sets its own, and it knows better than
/// this does: it repointed a caller from a specific version deliberately.
///
/// Runs BEFORE hash stabilization, which is safe because the answer is keyed on the location and the
/// item kind, and stabilization rewrites neither -- it only replaces provisional target hashes.
let recordPrevious(
  branchId: Uuid,
  ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  let parent =
    if Branch.isMain(branchId) then
      branchId
    else
      PackageOps.branchParentOf(branchId)

  ops
  |> Stdlib.List.map(fun op ->
    match op with
    | SetName(location, target, None) ->
      let previous =
        currentlyBound(parent, location, LanguageTools.ProgramTypes.Reference.kind(target))

      LanguageTools.ProgramTypes.PackageOp.SetName(location, target, previous)
    // Same for an unbind: what it removes is what is live at the name on this branch, whatever kind.
    | Unbind(location, None) ->
      let previous =
        PackageOps.liveBindingFor(branchId, location)
        |> Stdlib.Option.map(fun b -> LanguageTools.ProgramTypes.Hash.Hash(b.hash))

      LanguageTools.ProgramTypes.PackageOp.Unbind(location, previous)
    | other -> other)
