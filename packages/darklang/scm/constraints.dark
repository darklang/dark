module Darklang.SCM.Constraints

// Standing findings about the store: which live items still call a version that is no longer the name's
// current one.
//
// Imported usages can lag behind local edits. A caller written on another machine
// may arrive after a callee edit. Local edits propagate automatically, but imported
// references can still be outdated. So this is a check you RUN, not a
// warning at every commit.
//
// Detection needs no storage, being derivable from the projections at any moment. Only a human's ANSWER is
// durable, for the same reason `Resolve` is an op: an ack that lives only locally re-reports forever, and
// differently on each machine.

/// What kind of thing a Constraint noticed.
///
/// The type is here so the next kind is a case rather than a new command: an item left with no inbound
/// references after a propagation, and a newly-bound fn shadowing an existing one with an identical
/// signature, both want this same detect / record / ack lifecycle.
type Kind =
  | StaleUsage
  /// The name moved to a different KIND of item, and this usage is still on the old one.
  ///
  /// Its own kind rather than a flavour of StaleUsage because the two want opposite advice: a stale usage
  /// is a version behind and repointing fixes it, while a kind change cannot be repointed at all -- swapping
  /// a value reference's hash to a fn's produces code that claims one thing and points at another. Nothing
  /// breaks meanwhile: references resolve by hash, and the old item is still there.
  | KindChanged
  /// A deliberate DECISION of yours is no longer what the store reflects: you overrode a conflict to
  /// pin a name to one version, and a later ordinary edit rebound it.
  ///
  /// Its own kind because the advice is different again: nothing is stale and no kind moved, the name is
  /// simply not where you put it. Last-writer-wins is working as designed here; it just discards the
  /// losing side SILENTLY, and with sync running as a daemon that can happen while you are asleep. This
  /// is how you find out.
  ///
  /// Only an override qualifies (see `SCM.PackageOps.supersededOverrides`).
  | DecisionSuperseded
  /// Two visible implementations of one trait for one type. Legal to store, and a call runs the
  /// newer of them: the same last-writer-wins rule that settles two bindings of one name, so every
  /// instance runs the same one. This says so, because the loser is still there and the second
  /// implementation usually arrives by sync while nobody is looking. Deprecate one to settle it.
  | RivalImplementations


let kindToString(k: Kind): String =
  match k with
  | StaleUsage -> "stale-usage"
  | KindChanged -> "kind-changed"
  | DecisionSuperseded -> "decision-superseded"
  | RivalImplementations -> "rival-implementations"


/// The other direction, for reading a kind back out of storage or a CLI argument.
let kindFromString(s: String): Option<Kind> =
  match s with
  | "stale-usage" -> Option.Some(Kind.StaleUsage)
  | "kind-changed" -> Option.Some(Kind.KindChanged)
  | "decision-superseded" -> Option.Some(Kind.DecisionSuperseded)
  | "rival-implementations" -> Option.Some(Kind.RivalImplementations)
  | _ -> Option.None


/// The ways a finding of this kind can be RESOLVED, named, most-obvious first.
///
/// Acking is uniform across kinds -- "leave it, I've seen it" is the same answer whatever the finding is --
/// so it can be a bulk verb. Resolving is not: it means something different per kind, so `dark constraints
/// resolve` checks this list before doing anything.
let resolutionsFor(k: Kind): List<String> =
  match k with
  | StaleUsage -> [ "repoint" ]
  // Nothing automatic. Following this one means rewriting the usage to call a function where it used to
  // read a value, which is a change to what the code MEANS, not to which version it points at. Ack it, or
  // edit the usage yourself.
  | KindChanged -> []
  // Nothing automatic, deliberately. Re-asserting the decision means authoring a new override, which is
  // `dark conflicts override` -- a different verb with its own confirmation. `dark constraints resolve`
  // does one thing (repoint a usage), and offering a name here that it does not implement would run the
  // repoint instead. Ack it, or override again.
  | DecisionSuperseded -> []
  // Nothing automatic: the call already runs the newer one, and making that permanent is `deprecate`
  // on the other, its own verb with its own confirmation. Ack it, or pick.
  | RivalImplementations -> []


/// Is <param choice> a resolution this kind offers?
let offersResolution(k: Kind, choice: String): Bool =
  Stdlib.List.contains(resolutionsFor(k), choice)


/// Which of two implementations of one trait for one type a call runs.
type RivalChoice =
  /// The finding's own implementation (`usage`): it was written later.
  | Mine
  /// The other one (`rival`).
  | Theirs
  /// Neither: nothing orders them, so the call errors. Only reachable when no op introduced
  /// either implementation, which means something grafted them in (a script's own).
  | Neither


/// What VARIES between kinds of finding.
///
/// A DU rather than two hash fields every kind has to fill: a replaced propagation choice has no hashes
/// to put in them, and the alternative is a case carrying fields it cannot honour.
type FindingDetail =
  /// A usage still on an old version: what it references, and what that name means now.
  | Versions(using: LanguageTools.ProgramTypes.Hash, current: LanguageTools.ProgramTypes.Hash)
  /// Two implementations of one trait for one type: the type, as printed, the other
  /// implementation (`usage` is this one, `dependency` the trait), and which of the two a call
  /// runs.
  | Rivals(self: String, rival: LanguageTools.ProgramTypes.PackageLocation, choice: RivalChoice)


/// One finding: which kind it is, the usage it is about, the dependency involved, and whatever that kind
/// needs to say beyond that.
type Finding =
  { kind: Kind
    /// stable across re-detection, so an ack sticks
    id: String
    usage: LanguageTools.ProgramTypes.PackageLocation
    usageKind: LanguageTools.ProgramTypes.ItemKind
    dependency: LanguageTools.ProgramTypes.PackageLocation
    dependencyKind: LanguageTools.ProgramTypes.ItemKind
    detail: FindingDetail }


let fqnOf(loc: LanguageTools.ProgramTypes.PackageLocation): String =
  let mods = Stdlib.String.join(loc.modules, ".")
  if mods == "" then
    $"{loc.owner}.{loc.name}"
  else
    $"{loc.owner}.{mods}.{loc.name}"


/// The identity of a finding, and the semantics of an ack, are the same decision.
///
/// Keyed on the version the usage is ON, not just the pair of names: "leave it, it's fine" survives the
/// dependency getting further versions, but not the usage itself moving. It is the "not now" answer;
/// retaining a reference never needs an update policy.
///
/// <param discriminator> is whatever makes this finding a DIFFERENT one from the next: the version a
/// usage is on, or another kind-specific discriminator. Kept as text so a kind with no hashes can key on
/// something else and still get a stable id.
let findingId(
  usage: LanguageTools.ProgramTypes.PackageLocation,
  dependency: LanguageTools.ProgramTypes.PackageLocation,
  discriminator: String)
  : String =
  let raw = $"{fqnOf(usage)}|{fqnOf(dependency)}|{discriminator}"
  let digest = Stdlib.Base16.encode(Stdlib.Crypto.sha256(Stdlib.Utf8.encode(raw)))
  Stdlib.String.toLowercase(Stdlib.String.first(digest, 8))


/// Find callers that still use an older version of a dependency.
/// Check each caller's reference names, since callers can follow different aliases.
let outdatedFindings(edges: List<Deps.StaleReference>): List<Finding> =
  edges
  |> Stdlib.List.map(fun((usage, caller, target, dependency, current)) ->
    let using = LanguageTools.ProgramTypes.Reference.hash(target)
    let dependencyKind = LanguageTools.ProgramTypes.Reference.kind(target)
    Finding
      { kind =
          if LanguageTools.ProgramTypes.Reference.kind(current) == dependencyKind then
            Kind.StaleUsage
          else
            Kind.KindChanged
        id = findingId(usage, dependency, LanguageTools.ProgramTypes.hashToString(using))
        usage = usage
        usageKind = LanguageTools.ProgramTypes.Reference.kind(caller)
        dependency = dependency
        dependencyKind = dependencyKind
        detail =
          FindingDetail.Versions(using, LanguageTools.ProgramTypes.Reference.hash(current)) })
  |> Stdlib.List.uniqueBy(fun f -> f.id)
  |> Stdlib.List.sortBy(fun f -> fqnOf(f.usage) + ":" + fqnOf(f.dependency))


let outdatedUsagesOn(branchId: Uuid): Result<List<Finding>, String> =
  Deps.review(branchId, []) |> Stdlib.Result.map(fun((stale, _)) -> outdatedFindings(stale))


/// Ack ids, read from the shared conflicts record.
///
/// Shares that record because a Constraint finding and a conflict have the same lifecycle -- detect,
/// record, ack or override -- and both acks must be durable and syncable. An unanswered finding is not
/// stored at all; only answers are rows.
///
/// Selected by "not a conflict" rather than by listing Constraint kinds, so a new kind's acks are read
/// without touching this: conflicts are the closed set (both its kinds excluded), Constraints the open one.
///
/// Deliberately NOT scoped to a branch: a constraint is a property of the STORE, so a branch filter would
/// make an ack given on main stop counting the moment you switched.
let ackedIds(): List<String> =
  Conflicts.query(Conflicts.ConflictFilter.AckedConstraints) |> Stdlib.List.map(fun row -> row.id)


/// A deliberate OVERRIDE of yours that a later ordinary edit undid.
///
/// The op log holds both facts, so this needs no storage and no authorship: `SCM.PackageOps` walks it and
/// reports (location, the hash the override chose, the hash bound now). See its comment for why only an
/// override qualifies.
///
/// The `Finding` fields are the stale-usage ones reused: `dependency` is the location ITSELF, because the
/// thing whose version moved is this name rather than something it calls. That is the one field here that
/// reads oddly, and it is why `line` in the CLI prints this kind separately.
let detectSupersededDecisions(): Result<List<Finding>, String> =
  PackageOps.supersededOverrides()
  |> Stdlib.Result.map(fun entries ->
    entries
    |> Stdlib.List.map(fun entry ->
      let (loc, chosen, live) = entry

      // The item's REAL kind, from the live binding: a hardcoded Fn feeds `--json` the wrong kind for a
      // decision on a type or value.
      let kind =
        Propagation.kindAt(loc) |> Stdlib.Option.withDefault(LanguageTools.ProgramTypes.ItemKind.Fn)

      Finding
        { kind = Kind.DecisionSuperseded
          id = findingId(loc, loc, chosen)
          usage = loc
          usageKind = kind
          dependency = loc
          dependencyKind = kind
          detail =
            FindingDetail.Versions(
              LanguageTools.ProgramTypes.Hash.Hash(chosen),
              LanguageTools.ProgramTypes.Hash.Hash(live)) }))


/// Two visible implementations of one trait for one type, on <param branchId>, and which one a
/// call runs.
///
/// Reads the same candidates a call reads (`Trait.impls`), grouped by the self type
/// exactly as written: `Show for List<Int64>` and `Show for List<'a>` are not rivals (the
/// specific one wins at the call), two `Show for Point` are. One finding per pair, keyed
/// on both names and the type, so an ack survives unrelated churn.
///
/// The winner is `SCM.Conflicts.beats` over the two stamps, which is the rule the runtime's own
/// selection uses (`LibExecution.Traits.select`, through `LibExecution.Lww`). Asking it here rather
/// than restating it is the point: a finding that named a different winner than the one running
/// would be worse than no finding.
///
/// Every trait the branch can see, one candidate read each: a handful of traits, and
/// the read is cached per (branch, trait), so `dark status` can afford it.
/// <param t> as a key that two spellings of one type (`Point`, `Tests.Tr.Point`) share: a named
/// type is its hash, so nothing is looked up in the store.
let typeKey(branchId: Uuid, t: LanguageTools.RuntimeTypes.TypeReference): String =
  let keys(ts: List<LanguageTools.RuntimeTypes.TypeReference>): String =
    ts
    |> Stdlib.List.map(fun a -> typeKey(branchId, a))
    |> Stdlib.String.join(", ")

  match t with
  | TStream(inner) -> $"Stream<{typeKey(branchId, inner)}>"
  | TTuple(first, second, rest) -> $"({keys(Stdlib.List.concat([ first, second ], rest))})"
  | TList(inner) -> $"List<{typeKey(branchId, inner)}>"
  | TDict(k, v) -> $"Dict<{typeKey(branchId, k)}, {typeKey(branchId, v)}>"
  | TCustomType(nr, args) ->
    match nr.resolved with
    | Ok(Package(hash)) -> $"{LanguageTools.RuntimeTypes.hashToString(hash)}<{keys(args)}>"
    | Error(_) -> PrettyPrinter.RuntimeTypes.typeReference(branchId, t)
  | TFn(args, ret) -> $"({keys(args)}) -> {typeKey(branchId, ret)}"
  | other -> PrettyPrinter.RuntimeTypes.typeReference(branchId, other)


/// Pairs of candidates with the same self-type key, in input order, earlier first.
/// Keep later candidates by key so unrelated implementations are never compared.
let rivalPairs(candidates: List<(String * 'a)>): List<('a * 'a)> =
  let (_groups, pairs) =
    candidates
    |> Stdlib.List.reverse
    |> Stdlib.List.fold((Dict {}, []), fun((groups, pairs), (key, candidate)) ->
      let later = Stdlib.Dict.get(groups, key) |> Stdlib.Option.withDefault([])
      let nextPairs = Stdlib.List.map(later, fun other -> (candidate, other))
      (
        Stdlib.Dict.set(groups, key, Stdlib.List.prepend(later, candidate)),
        Stdlib.List.concat(nextPairs, pairs)))

  pairs


let detectRivalImplementations(branchId: Uuid): List<Finding> =
  let query =
    LanguageTools.ProgramTypes.Search.SearchQuery
      { currentModule = []
        text = ""
        searchDepth = LanguageTools.ProgramTypes.Search.SearchDepth.AllDescendants
        entityTypes = [ LanguageTools.ProgramTypes.Search.EntityType.Trait ]
        exactMatch = false }

  let traits = (LanguageTools.PackageManager.Search.search(branchId, query)).traits
  traits
  |> Stdlib.List.map(fun t ->
    // The self type as compared. A name resolution carries the name as WRITTEN (`Point`
    // here, `Scratch.Shapes.Point` there) beside the hash it resolved to, so structural
    // equality says two spellings of one type differ. Compare by hash (`typeKey`).
    //
    // The type is printed only for a pair that matched, which is almost never, and
    // `dark status` runs this every time.
    let candidates =
      LanguageTools.PackageManager.Trait.impls(branchId, t.entity.hash)
      |> Stdlib.List.map(fun c -> (typeKey(branchId, c.self), c))

    candidates
    |> rivalPairs
    |> Stdlib.List.filterMap(fun((c, d)) ->
      let selfStr = PrettyPrinter.RuntimeTypes.typeReference(branchId, c.self)
      let locOf(
        h: LanguageTools.ProgramTypes.Hash)
        : Option<LanguageTools.ProgramTypes.PackageLocation> =
        LanguageTools.PackageManager.pickLocation(
          LanguageTools.PackageManager.PickContext.empty,
          LanguageTools.PackageManager.TraitImpl.locations(branchId, h))

      match locOf(c.source), locOf(d.source) with
      | Some(mine), Some(other) ->
        let cHash = LanguageTools.ProgramTypes.hashToString(c.source)
        let dHash = LanguageTools.ProgramTypes.hashToString(d.source)
        let choice =
          if c.stamp == "" && d.stamp == "" then
            RivalChoice.Neither
          else if Conflicts.beats(c.stamp, cHash, d.stamp, dHash) then
            RivalChoice.Mine
          else
            RivalChoice.Theirs

        Option.Some(
          Finding
            { kind = Kind.RivalImplementations
              id = findingId(mine, t.location, $"{selfStr}|{fqnOf(other)}")
              usage = mine
              usageKind = LanguageTools.ProgramTypes.ItemKind.TraitImpl
              dependency = t.location
              dependencyKind = LanguageTools.ProgramTypes.ItemKind.Trait
              detail = FindingDetail.Rivals(selfStr, other, choice) })
      | _, _ -> Option.None))
  |> Stdlib.List.flatten


/// Find outdated references on a non-main branch, including inherited callers.
let detectOutdatedUsagesOn(branchId: Uuid): Result<List<Finding>, String> =
  if Branch.isMain(branchId) then Result.Ok([]) else outdatedUsagesOn(branchId)


/// Everything detection turned up, and everything it could not look at.
///
/// Two of these detectors read the op log, and a failed read used to come back empty. A caller that
/// prints "no constraints" has to be able to tell that from "nothing found".
type Detection =
  { findings: List<Finding>
    /// One sentence per detector that could not run. Empty is the normal case.
    blocked: List<String> }


let detectWithOutdated(outdated: Result<List<Finding>, String>): Detection =
  let (outdated, outdatedBlocked) =
    match outdated with
    | Ok(fs) -> (fs, [])
    | Error(e) -> ([], [ e ])

  // Detection and acknowledgement are independent of dependency upgrades.
  let (decisions, decisionsBlocked) =
    match detectSupersededDecisions() with
    | Ok(fs) -> (fs, [])
    | Error(e) -> ([], [ e ])

  Detection
    { findings =
        Stdlib.List.flatten(
          [ outdated, decisions, detectRivalImplementations(PackageOps.currentBranch()) ])
      blocked = Stdlib.List.concat(outdatedBlocked, decisionsBlocked) }


/// Findings that have not been acknowledged.
let pendingWithOutdated(outdated: Result<List<Finding>, String>): Detection =
  let ackedSet =
    ackedIds()
    |> Stdlib.List.map(fun a -> (a, true))
    |> Stdlib.Dict.fromEntries

  let detected = detectWithOutdated(outdated)

  // Blockers pass through: an ack answers a finding, and a detector that never ran produced none.
  Detection
    { findings =
        detected.findings
        |> Stdlib.List.filter(fun s ->
          let isAcked =
            match Stdlib.Dict.get(ackedSet, s.id) with
            | Some(_) -> true
            | None -> false

          Stdlib.Bool.not(isAcked))
      blocked = detected.blocked }


let detectAll(): Detection =
  detectWithOutdated(outdatedUsagesOn(PackageOps.currentBranch()))


let pending(): Detection =
  pendingWithOutdated(outdatedUsagesOn(PackageOps.currentBranch()))


/// Record "I've seen this one, leave it" -- as an OP, so the ack travels. An ack that lives only on the
/// machine you typed it on re-reports forever everywhere else, and differently on each of them.
///
/// The fold writes the `conflicts` row, so that table is derived rather than a second source of truth.
let ack(branchId: Uuid, s: Finding, note: String): Result<Unit, String> =
  // The default has to name the finding it answers. Only StaleUsage is a use of something else; for
  // the other two `dependency` IS the name itself, and "stale use of X" describes nothing that happened.
  let reason =
    if note != "" then
      note
    else
      match s.kind with
      | StaleUsage -> $"stale use of {fqnOf(s.dependency)}"
      | KindChanged -> $"{fqnOf(s.dependency)} is a different kind of item now"
      | DecisionSuperseded -> $"decision on {fqnOf(s.usage)} superseded"
      | RivalImplementations ->
        $"{fqnOf(s.usage)} is one of two implementations of {fqnOf(s.dependency)}"

  let op =
    LanguageTools.ProgramTypes.PackageOp.Decision(
      // The finding id, so acking the same finding twice is one decision stated twice. That is safe
      // only while there is no un-ack: an op's id is its content hash, so a second identical
      // `Decision` is the first one and folds nothing. If an un-ack is ever added, ack-unack-ack
      // loses the last ack, the way deprecate-undeprecate-deprecate loses the last deprecation
      // today. The fix then is what the keep-mine override already does in `branches.dark`: put a
      // stamp in the decision id so a repeat is a distinct op.
      $"ack:{s.id}",
      s.usage,
      reason,
      LanguageTools.ProgramTypes.DecisionKind.Ack(s.id))

  match PackageOps.add(branchId, [ op ]) with
  | Ok(_) -> Result.Ok()
  | Error(e) -> Result.Error(e)
