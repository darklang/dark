module Darklang.SCM.PackageOps

// Every dependent an edit should repoint.
//
// Propagation's read half: all callers follow.

/// One knock-on repoint: <param name> moves because <param uses> did. Carrying the CAUSE is what lets the
/// commit view read as an outcome ("Home.render -> uses User.format") instead of a bare list of names.
type Repoint =
  { name: String
    uses: String }


/// Render the native traversal's result. First changed seed wins when causes overlap.
let repointsFromReview(
  pairs:
    List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.PackageLocation)>)
  : List<Repoint> =
  pairs
  |> Stdlib.List.map(fun((usage, dependency)) ->
    Repoint
      { name = Conflicts.fqn(usage.owner, Stdlib.String.join(usage.modules, "."), usage.name)
        uses =
          Conflicts.fqn(
            dependency.owner,
            Stdlib.String.join(dependency.modules, "."),
            dependency.name) })
  |> Stdlib.List.sortBy(fun r -> r.name)


/// Shared native review for constraints and caller updates.
let dependencyReview(changed: List<Conflicts.Binding>): Result<Deps.DependencyReview, String> =
  Deps.review(currentBranch(), changed |> Stdlib.List.map(sourceOfBinding))


let draftRepoints(changed: List<Conflicts.Binding>): Result<List<Repoint>, String> =
  if Stdlib.List.isEmpty(changed) then
    Result.Ok([])
  else
    dependencyReview(changed)
    |> Stdlib.Result.map(fun((_, repoints)) -> repointsFromReview(repoints))
