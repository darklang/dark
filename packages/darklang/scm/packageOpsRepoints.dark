module Darklang.SCM.PackageOps

// Every dependent an edit should repoint.
//
// Propagation's read half: all callers follow.

/// Find names for this content using main's bindings and the branch's binding changes.
/// Deprecating content affects every name that points to it, so include inherited names too.
let namesAtContent(branchId: Uuid, hash: String, itemType: String): List<String> =
  let mainNames =
    // main-scoped: main's names for this content; the chain's names and rebinds are applied below.
    SCM.Bindings.query(SCM.Bindings.BindingFilter.MainByHash(hash, itemType))
    |> Stdlib.List.map(fun b -> Conflicts.fqn(b.owner, b.modules, b.name))

  if SCM.Branch.isMain(branchId) then
    mainNames
  else
    // Include names inherited from parent branches.
    // Remove main's names when the branch or a parent now binds them to different content.
    let chain = chainBindings(branchId)

    let branchNames =
      chain
      |> Stdlib.List.filterMap(fun b ->
        if b.hash == hash && b.itemType == itemType then
          Stdlib.Option.Option.Some(Conflicts.fqn(b.owner, b.modules, b.name))
        else
          Stdlib.Option.Option.None)

    let reboundAway =
      chain
      |> Stdlib.List.filterMap(fun b ->
        if b.hash != hash then
          Stdlib.Option.Option.Some(Conflicts.fqn(b.owner, b.modules, b.name))
        else
          Stdlib.Option.Option.None)

    let mainStill =
      mainNames |> Stdlib.List.filter(fun n -> Stdlib.Bool.not(Stdlib.List.contains(reboundAway, n)))

    Stdlib.List.unique(Stdlib.List.concat(mainStill, branchNames))


/// A caller update and the dependency that caused it.
/// The commit preview uses both names to explain why the caller will change.
type Repoint =
  { name: String
    uses: String }


/// Render the native traversal's result. First changed seed wins when causes overlap.
let repointsFromReview(pairs: List<(LanguageTools.ProgramTypes.PackageLocation * LanguageTools.ProgramTypes.PackageLocation)>): List<Repoint> =
  pairs |> Stdlib.List.map(fun((usage, dependency)) ->
    Repoint { name = Conflicts.fqn(usage.owner, Stdlib.String.join(usage.modules, "."), usage.name)
              uses = Conflicts.fqn(dependency.owner, Stdlib.String.join(dependency.modules, "."), dependency.name) })
  |> Stdlib.List.sortBy(fun r -> r.name)

/// Shared native review for constraints and caller updates.
let dependencyReview(changed: List<Conflicts.Binding>): Deps.DependencyReview =
  Deps.review(currentBranch(), changed |> Stdlib.List.map(sourceOfBinding))

let draftRepoints(changed: List<Conflicts.Binding>): List<Repoint> =
  if Stdlib.List.isEmpty(changed) then [] else
    let (_, repoints) = dependencyReview(changed)
    repointsFromReview(repoints)
