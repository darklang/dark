module Darklang.SCM.PackageOps

// Authoring is live-on-write: `add` appends ops that take effect the moment they fold. `add` and
// `getRecent` are the substrate everything else here is built on.
//
// This file is the substrate: authoring (`add`, `addAuthored`). The rest of the module lives
// beside it, one file per subject:
//
//   packageOpsBindings   what an op says about a name, and what a name holds now
//   packageOpsDraft      stamping a draft into a commit, and dropping one
//   packageOpsRepoints   which dependents an edit would move
//   packageOpsMerge      commit, merge, rebase, archive, settle a conflict
//   packageOpsBranch     branch registry and frontier reads
//   packageOpsCommits    the commit rows themselves
//
// Dark lets several files contribute to one module and see each other's definitions unqualified, so
// the split is physical only: no new silo, and `package_ops` still has exactly one owner. It is a
// split rather than one file because one file was 1,750 lines and 67 functions, which is past the
// point where anyone finds anything.


/// Add a list of package ops to the database (immediately live on the given branch).
/// Returns the number of inserted ops on success (duplicates are skipped), or an error message on failure.
let add
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<Int, String> =
  Builtin.scmAddOps branchId (Lineage.recordPrevious branchId ops)


/// THE authoring boundary: stabilize a batch and store it, refusing what stabilization would corrupt.
///
/// Ordered deliberately. Duplicate names are checked FIRST, because `stabilizeHashes` keys by name: a
/// batch declaring one name twice would store one body under the other's hash, and whichever landed
/// second would silently become the first. Then each trait-method call is resolved to an
/// implementation and that choice is written onto the call, BEFORE hashing, because it is part of
/// what the item is. Then the at-rest check runs over what was actually stored, so its report
/// describes the store rather than the request.
///
/// Every authoring surface goes through here rather than calling `add`: the CLI's fn/type/value/module
/// commands, the workbench, and the LSP's file provider.
let addAuthored
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<LanguageTools.AtRestTypeChecker.Report, String> =
  let duplicates = LanguageTools.PackageManager.duplicateDeclarations ops

  if Stdlib.Bool.not (Stdlib.List.isEmpty duplicates) then
    Stdlib.Result.Result.Error(
      "Declared more than once: " + (Stdlib.String.join duplicates ", "))
  else
    let stabilizedOps =
      ops
      |> LanguageTools.PackageManager.resolveTraitCalls
      |> LanguageTools.PackageManager.stabilizeHashes

    let added = add branchId stabilizedOps

    // A value is evaluated after its ops are stored, so a value that fails has already landed. Take
    // its binding back out, or "Could not save" is untrue: the value sits in the draft, and every
    // later commit either refuses on it or commits a value nobody can read.
    match unevaluatedValuesBoundBy branchId stabilizedOps with
    | [] ->
      match added with
      | Ok _ ->
        Stdlib.Result.Result.Ok(
          LanguageTools.AtRestTypeChecker.checkPackageOpsOn branchId stabilizedOps)
      | Error message -> Stdlib.Result.Result.Error message
    | failed -> Stdlib.Result.Result.Error(takeBackFailedValues branchId stabilizedOps added failed)


/// Unbind the values a save could not evaluate, and say what that left. A batch (`dark module`,
/// the editor) can hold good items beside the bad value, and those stay.
let takeBackFailedValues
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  (added: Stdlib.Result.Result<Int, String>)
  (failed: List<(LanguageTools.ProgramTypes.PackageLocation * String)>)
  : String =
  let failedLocations = failed |> Stdlib.List.map (fun (loc, _) -> loc)

  let names =
    failedLocations
    |> Stdlib.List.map PrettyPrinter.ProgramTypes.PackageLocation.packageLocation
    |> Stdlib.String.join ", "

  let why =
    match added with
    | Error message -> message
    | Ok _ -> $"{names} could not be evaluated"

  let kept =
    ops
    |> Stdlib.List.filterMap (fun op ->
      match op with
      | SetName(loc, _, _) ->
        if Stdlib.List.``member`` failedLocations loc then
          Stdlib.Option.Option.None
        else
          Stdlib.Option.Option.Some(
            PrettyPrinter.ProgramTypes.PackageLocation.packageLocation loc)
      | _ -> Stdlib.Option.Option.None)

  let keptNote =
    match kept with
    | [] -> ""
    | kept ->
      let keptList = Stdlib.String.join kept ", "
      $" The rest of this save was kept: {keptList}."

  match unbind branchId failed with
  | Ok _ -> $"{why}\nNothing was saved for {names}.{keptNote}"
  | Error e ->
    $"{why}\n{names} is still in your draft, and taking it back out failed: {e}. `dark discard {names}` removes it."


/// The values <param ops> binds whose stored form never got a runtime value: what evaluation
/// failed on. Asked of the store, by the hash each name holds now, because the save restabilizes
/// and refreshes hashes after the ones in hand.
let unevaluatedValuesBoundBy
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<(LanguageTools.ProgramTypes.PackageLocation * String)> =
  ops
  |> Stdlib.List.filterMap (fun op ->
    match op with
    | SetName(loc, PackageValue _, _) ->
      match liveBindingFor branchId loc with
      | Some b ->
        if b.itemType == "value" && Stdlib.Bool.not (valueEvaluated b.hash) then
          Stdlib.Option.Option.Some((loc, b.hash))
        else
          Stdlib.Option.Option.None
      | None -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None)


let valueEvaluated (hash: String) : Bool =
  Stdlib.Sqlite.queryOneP
    (localDb ())
    "SELECT 1 AS ok FROM package_values WHERE hash = @p0 AND rt_dval IS NOT NULL"
    [ hash ]
  |> Stdlib.Option.isSome


/// Drop the bindings to exactly these (name, hash) pairs from the draft, leaving the name on
/// whatever it held before, including an earlier uncommitted version, and the value content behind
/// them: the commit's type check reads content as well as names, so content left behind with no name
/// would go on refusing every commit. Anything else this save added that uses one of these values is
/// left referencing nothing, and is refused as unresolved, which is what it is.
let unbind
  (branchId: Uuid)
  (bindings: List<(LanguageTools.ProgramTypes.PackageLocation * String)>)
  : Stdlib.Result.Result<Int, String> =
  let hashes = bindings |> Stdlib.List.map (fun (_, hash) -> hash)

  let isOneOf (op: LanguageTools.ProgramTypes.PackageOp) : Bool =
    match op with
    | SetName(loc, target, _) ->
      let hash =
        LanguageTools.ProgramTypes.hashToString
          (LanguageTools.ProgramTypes.Reference.hash target)

      Stdlib.List.``member`` bindings (loc, hash)
    | AddValue v ->
      Stdlib.List.``member`` hashes (LanguageTools.ProgramTypes.hashToString v.hash)
    | _ -> false

  if SCM.Branch.isMain branchId then
    SCM.Draft.rewriteBy (fun draft ->
      draft |> Stdlib.List.filter (fun d -> Stdlib.Bool.not (isOneOf d.op)))
  else
    let ids =
      decodeOpRowEntries (Branches.ownOpRows branchId)
      |> Stdlib.List.filterMap (fun (id, _, op) ->
        if isOneOf op then Stdlib.Option.Option.Some id else Stdlib.Option.Option.None)

    dropBranchOps branchId ids


// the op-log DATA-ACCESS SILO
// This module OWNS every SQL query against `package_ops`. Callers (the `dark ops` CLI, doctor) go
// through the typed functions below and never hand-roll SQL. There should be no op-log SQL outside here.


/// A lightweight op-log row for display (no op_blob decode): what `dark ops` shows.
type OpSummary =
  { id: String
    sizeBytes: Int64
    ts: String
    /// The op itself, so a listing can say what the op DOES rather than how many bytes it
    /// is. `None` for an op this build's deserializer cannot read, which a store that has
    /// taken ops from elsewhere holds on purpose; the row still lists, it just cannot
    /// describe itself.
    op: Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageOp> }


/// What a branch REF resolved to. A DU rather than an Option because "no such branch" and "that could be
/// several branches" want different words from the caller, and an Option would flatten them into one.
type BranchRefResult =
  | Found of Uuid
  /// Not a live name, not an id, not a prefix: a name this store has never had. The ONE miss a write
  /// verb may answer by starting a branch.
  | NotFound
  /// A full id, and no branch here has it: a peer's, or a mispaste. Never something to start a branch
  /// named after.
  | UnknownId of Uuid
  /// The prefix matched more than one branch.
  | Ambiguous

