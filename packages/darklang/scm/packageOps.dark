module Darklang.SCM.PackageOps


/// A commit on a branch
type Commit =
  { hash: LanguageTools.ProgramTypes.Hash
    message: String
    createdAt: DateTime
    opCount: Int
    branchId: Uuid
    branchName: String
    committerId: Uuid
    committerName: String }


/// Store raw WIP ops without type checking. Authored declarations use
/// `addAuthored`; sync, rename, and deprecation use this path. Returns the number
/// inserted, excluding duplicates.
let add
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<Int, String> =
  Builtin.scmAddOps branchId ops


/// Stabilize and store authored declarations as one WIP graph, then return their
/// type-check report. Type errors do not block saving; duplicate names and storage
/// failures do. `commit` is the type-error gate.
let addAuthored
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<LanguageTools.AtRestTypeChecker.Report, String> =
  let duplicates = LanguageTools.PackageManager.duplicateDeclarations ops
  if Stdlib.Bool.not (Stdlib.List.isEmpty duplicates) then
    Stdlib.Result.Result.Error(
      "Declared more than once: " ++ (Stdlib.String.join duplicates ", "))
  else
    let stabilizedOps = LanguageTools.PackageManager.stabilizeHashes ops
    match add branchId stabilizedOps with
    | Ok _ ->
      Stdlib.Result.Result.Ok(
        LanguageTools.AtRestTypeChecker.checkPackageOps stabilizedOps)
    | Error message -> Stdlib.Result.Result.Error message


/// Get recent package ops from the database
let getRecent (limit: Int) : List<LanguageTools.ProgramTypes.PackageOp> =
  Builtin.scmGetRecentOps limit


/// Get all WIP (uncommitted) ops on a branch
let getWip (branchId: Uuid) : List<LanguageTools.ProgramTypes.PackageOp> =
  branchId |> getWipWithIds |> Stdlib.List.map (fun e -> e.op)


/// A WIP package op with its DB row id and optional propagation batch id.
type WipOpEntry =
  { id: Uuid
    op: LanguageTools.ProgramTypes.PackageOp
    propagationId: Stdlib.Option.Option<Uuid> }


/// Get all WIP ops on a branch as `WipOpEntry` records (op + DB id + batch).
let getWipWithIds (branchId: Uuid) : List<WipOpEntry> =
  branchId
  |> Builtin.scmGetWipOpsWithIds
  |> Stdlib.List.map (fun tuple ->
    let (id, op, propId) = tuple
    WipOpEntry { id = id; op = op; propagationId = propId })


/// Render a PackageLocation as its dotted FQN string. Mirrors
/// `LibDB.PackageLocation.toFQN` on the F# side so CLI-side name matching
/// agrees with what `getWipItems` returns.
let locationToFqn (loc: LanguageTools.ProgramTypes.PackageLocation) : String =
  if Stdlib.List.isEmpty loc.modules then
    $"{loc.owner}.{loc.name}"
  else
    let modStr = Stdlib.String.join loc.modules "."
    $"{loc.owner}.{modStr}.{loc.name}"


/// Summary of WIP (uncommitted) changes on a branch
type WipSummary =
  { types: Int
    values: Int
    fns: Int
    renames: Int
    deprecations: Int
    total: Int }

/// Get a count from a Dict, defaulting to 0
let getCount (d: Dict<String, Int>) (key: String) : Int =
  match Stdlib.Dict.get d key with
  | Some v -> v
  | None -> 0

/// Get summary of WIP ops on a branch (counts by type)
let getWipSummary (branchId: Uuid) : WipSummary =
  let d = Builtin.scmGetWipSummary branchId

  WipSummary
    { types = getCount d "types"
      values = getCount d "values"
      fns = getCount d "fns"
      renames = getCount d "renames"
      deprecations = getCount d "deprecations"
      total = getCount d "total" }

/// Fast count of WIP ops on a branch (no deserialization)
let getWipOpCount (branchId: Uuid) : Int =
  Builtin.scmGetWipOpCount branchId

/// Fast count of commits on a branch (no deserialization)
let getCommitCount (branchId: Uuid) : Int =
  Builtin.scmGetCommitCount branchId

/// Get WIP items on a branch (excludes auto-propagated ops)
let getWipItems (branchId: Uuid) : List<Dict<String, String>> =
  Builtin.scmGetWipItems branchId


type CommitError =
  /// Declarations in the commit have definite type errors. Nothing was committed.
  /// Fix them (or `undo`/`discard`), or commit with `allowTypeErrors` to take
  /// them anyway.
  | TypeCheckFailed of LanguageTools.AtRestTypeChecker.Report
  /// Storage refused the commit.
  | CommitFailed of String

/// One line for a `CommitError`, for callers with nowhere to show a full report.
let commitErrorMessage (error: CommitError) : String =
  match error with
  | TypeCheckFailed report ->
    let count = Stdlib.List.length report.diagnostics
    $"at-rest type check failed ({Stdlib.Int.toString count} type errors); "
    ++ "fix them or commit with --allow-type-errors"
  | CommitFailed message -> message


/// Commit all WIP ops, refusing definite type errors unless
/// <param allowTypeErrors> is set.
let commit
  (accountId: Uuid)
  (branchId: Uuid)
  (message: String)
  (allowTypeErrors: Bool)
  : Stdlib.Result.Result<String, CommitError> =
  // Full commit means committing every WIP op id.
  let opIds =
    branchId |> getWipWithIds |> Stdlib.List.map (fun e -> e.id)

  if Stdlib.List.isEmpty opIds then
    Stdlib.Result.Result.Error(CommitError.CommitFailed "Nothing to commit")
  else
    commitOpIds accountId branchId message opIds allowTypeErrors


/// Include declaration bodies published by selected `SetName` ops, preventing a
/// partial commit from checking only location rows.
let opsForCommitTypeCheck
  (allWipOps: List<LanguageTools.ProgramTypes.PackageOp>)
  (selectedOps: List<LanguageTools.ProgramTypes.PackageOp>)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  let selectedTargets =
    selectedOps
    |> Stdlib.List.filterMap (fun op ->
      match op with
      | SetName (_, target) -> Stdlib.Option.Option.Some target
      | _ -> Stdlib.Option.Option.None)

  let referencedAdds =
    allWipOps
    |> Stdlib.List.filter (fun op ->
      let target =
        match op with
        | AddType typ ->
          Stdlib.Option.Option.Some(
            LanguageTools.ProgramTypes.Reference.PackageType typ.hash)
        | AddValue value ->
          Stdlib.Option.Option.Some(
            LanguageTools.ProgramTypes.Reference.PackageValue value.hash)
        | AddFn fn ->
          Stdlib.Option.Option.Some(
            LanguageTools.ProgramTypes.Reference.PackageFn fn.hash)
        | _ -> Stdlib.Option.Option.None

      match target with
      | Some target -> Stdlib.List.member selectedTargets target
      | None -> false)

  Stdlib.List.append selectedOps referencedAdds


/// Commit selected WIP ops after rechecking them as one batch. Selected names pull
/// in their WIP bodies so a location cannot publish unchecked content.
let commitOpIds
  (accountId: Uuid)
  (branchId: Uuid)
  (message: String)
  (opIds: List<Uuid>)
  (allowTypeErrors: Bool)
  : Stdlib.Result.Result<String, CommitError> =
  let store () : Stdlib.Result.Result<String, CommitError> =
    match Builtin.scmCommitWipOpsByIds accountId branchId message opIds with
    | Ok commitHash -> Stdlib.Result.Result.Ok commitHash
    | Error message -> Stdlib.Result.Result.Error(CommitError.CommitFailed message)

  if allowTypeErrors then
    store ()
  else
    let allWip = getWipWithIds branchId
    let selectedOps =
      allWip
      |> Stdlib.List.filter (fun e -> Stdlib.List.member opIds e.id)
      |> Stdlib.List.map (fun e -> e.op)
    let allWipOps = allWip |> Stdlib.List.map (fun e -> e.op)
    let checkOps = opsForCommitTypeCheck allWipOps selectedOps
    let report = LanguageTools.AtRestTypeChecker.checkPackageOps checkOps
    match report.verdict with
    | Failed -> Stdlib.Result.Result.Error(CommitError.TypeCheckFailed report)
    | Checked
    | Incomplete -> store ()


/// Discard all WIP ops on a branch
/// Returns the count of discarded ops on success, or an error message on failure
let discard (branchId: Uuid) : Stdlib.Result.Result<Int, String> =
  Builtin.scmDiscard branchId


/// Get commit log for a branch ordered by date descending
let getCommits (branchId: Uuid) (limit: Int) : List<Commit> =
  Builtin.scmGetCommits branchId limit


/// Get commit log across the entire branch chain (current + ancestors),
/// ordered by date descending.
let getCommitsWithAncestors (branchId: Uuid) (limit: Int) : List<Commit> =
  Builtin.scmGetCommitsForBranchChain branchId limit


/// Get ops for a specific commit
let getCommitOps (commitHash: String) : List<LanguageTools.ProgramTypes.PackageOp> =
  Builtin.scmGetCommitOps commitHash


/// The ops in a commit that name or deprecate something, capped at <param limit>, with the total
/// count of them alongside.
///
/// <fn getCommitOps> turns every op in the commit into a Dark value, and the init commit holds tens
/// of thousands of them. Rendering a twelve-line summary that way took over a second.
let getCommitNamedOps
  (commitHash: String)
  (limit: Int)
  : (List<LanguageTools.ProgramTypes.PackageOp> * Int) =
  Builtin.scmGetCommitNamedOps commitHash limit
