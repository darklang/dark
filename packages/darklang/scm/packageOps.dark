module Darklang.SCM.PackageOps

// Authoring is live-on-write: `add` appends ops that take effect the moment they fold. `add` and
// `getRecent` are the substrate everything else here is built on.
//
// This file is the substrate: authoring (`add`, `addAuthored`), this instance's identity, and the
// relay it is pointed at. The rest of the module lives beside it, one file per subject:
//
//   packageOpsBindings   what an op says about a name, and what a name holds now
//   packageOpsDraft      stamping a draft into a commit, and dropping one
//   packageOpsRepoints   which dependents an edit would move, and which it left behind
//   packageOpsMerge      commit, merge, rebase, archive, settle a conflict
//   packageOpsBundles    a branch as a bundle, for a relay to store and forward
//   packageOpsBranch     branch registry and frontier reads
//   packageOpsCommits    the commit rows themselves
//   packageOpsSync       in `../sync/`, since sync sits on top of SCM
//
// Dark lets several files contribute to one module and see each other's definitions unqualified, so
// the split is physical only: no new silo, and `package_ops` still has exactly one owner. It is a
// split rather than one file because one file was 1,750 lines and 67 functions, which is past the
// point where anyone finds anything.


/// Add a list of package ops to the database (immediately live on the given branch).
/// Returns the number of inserted ops on success (duplicates are skipped), or an error message on failure.
let add
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<Int, String> =
  Builtin.scmAddOps branchId (Lineage.recordPrevious branchId ops)


/// THE authoring boundary: stabilize a batch and store it, refusing what stabilization would corrupt.
///
/// Ordered deliberately. Duplicate names are checked FIRST, because `stabilizeHashes` keys by name: a
/// batch declaring one name twice would store one body under the other's hash, and whichever landed
/// second would silently become the first. Then the at-rest check runs over what was actually stored,
/// so its report describes the store rather than the request.
///
/// Every authoring surface goes through here rather than calling `add`: the CLI's fn/type/value/module
/// commands, the workbench, and the LSP's file provider.
let addAuthored
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<LanguageTools.AtRestTypeChecker.Report, String> =
  let duplicates = LanguageTools.PackageManager.duplicateDeclarations ops

  if Stdlib.Bool.not (Stdlib.List.isEmpty duplicates) then
    Stdlib.Result.Result.Error(
      "Declared more than once: " ++ (Stdlib.String.join duplicates ", "))
  else
    let stabilizedOps = LanguageTools.PackageManager.stabilizeHashes ops

    match add branchId stabilizedOps with
    | Ok _ ->
      Stdlib.Result.Result.Ok(
        LanguageTools.AtRestTypeChecker.checkPackageOps stabilizedOps)
    | Error message -> Stdlib.Result.Result.Error message


// the op-log DATA-ACCESS SILO
// This module OWNS every SQL query against `package_ops`. Callers (the `dark ops` CLI, doctor, sync) go
// through the typed functions below and never hand-roll SQL. There should be no op-log SQL outside here.

let localDb () : String = Stdlib.LocalStore.path ()

// Identity here is a NAME, not an authentication. There is no crypto and no proof: it is a string you
// reuse across machines so a relay can attribute ops to you, trusted by convention, stored in per-install
// config. Anything that needs to be un-forgeable needs something this is not.


/// This instance's sync identity, minted on first use.
///
/// An instance is a STORE, not a person or a machine: two clones of a store are two instances. Copying a
/// database copies its config, so the id is stamped with where it was minted and re-minted when that no
/// longer matches -- two peers sharing an id cannot sync or record a conflict against each other.
///
/// Gap: a store copied to the same PATH on another machine keeps its id. Closing that needs a hostname
/// builtin that doesn't exist.
let identity () : String =
  let here = Stdlib.LocalStore.path ()
  let stored = Stdlib.LocalStore.configGet "sync.identity"
  let mintedAt = Stdlib.LocalStore.configGet "sync.identity.origin"

  // Only an AUTO-MINTED id is ever replaced: a name someone chose deliberately (`dark identity alice`) is
  // theirs and survives being copied.
  let autoMinted = Stdlib.String.startsWith stored "inst-"

  if (stored != "") && ((mintedAt == here) || (autoMinted |> Stdlib.Bool.not)) then
    stored
  else
    let generated = $"inst-{Stdlib.Uuid.toString (Stdlib.Uuid.generate ())}"
    Stdlib.LocalStore.configSet "sync.identity" generated
    Stdlib.LocalStore.configSet "sync.identity.origin" here
    generated


/// Whether <param name> can be an instance identity, and why not when it cannot.
///
/// An identity travels as a query parameter and comes back in the relay's owner listing, one owner
/// per line. So a space makes that listing unparseable and every peer's automatic branch sync
/// silently skips you, and an `&` is read as a second parameter, which files your ops under two
/// owners and makes your branches unpullable by name. Neither fails loudly anywhere.
///
/// Letters, digits, dot, dash and underscore. Narrow on purpose: an identity is a name you retype on
/// another machine, and the auto-minted `inst-<uuid>` fits well inside it.
let identityProblem (name: String) : Stdlib.Option.Option<String> =
  if name == "" then
    Stdlib.Option.Option.Some "an identity can't be empty"
  else
    let bad =
      name
      |> Stdlib.String.toList
      |> Stdlib.List.filter (fun c ->
        let ok =
          (Stdlib.Char.isAlphanumeric c)
          || (c == '.')
          || (c == '-')
          || (c == '_')

        Stdlib.Bool.not ok)

    match bad with
    | [] -> Stdlib.Option.Option.None
    | c :: _ ->
      let shown = Stdlib.Char.toString c
      Stdlib.Option.Option.Some
        $"an identity can't contain \"{shown}\" -- letters, digits, dot, dash and underscore only, because it travels in a url and comes back in the relay's owner list"


/// Set (or change) this instance's sync identity. Refuses one that cannot survive the round trip.
let setIdentity (name: String) : Stdlib.Result.Result<Unit, String> =
  match identityProblem name with
  | Some why -> Stdlib.Result.Result.Error why
  | None ->
    let _ = Stdlib.LocalStore.configSet "sync.identity" name
    Stdlib.Result.Result.Ok()


/// The remembered default relay URL, or "" if none (so `dark sync` needs no url).
let relay () : String = Stdlib.LocalStore.configGet "sync.relay"

let setRelay (url: String) : Unit =
  let _ = Stdlib.LocalStore.configSet "sync.relay" url
  ()


/// What a sync-import from <param sourceId> will reconcile. `conflicts` are detected but NOT yet recorded,
/// and `names` are the names the import touches (they become the new bases once the fold lands).
/// `bulk` means the import was ADOPTED WHOLESALE without per-name detection; `detected` says whether the
/// detector actually ran, so a caller never reports "no conflicts" when it really means "didn't look".
type SyncPlan =
  { conflicts: List<Conflicts.Conflict>
    bulk: Bool
    detected: Bool }


/// A lightweight op-log row for display (no op_blob decode): what `dark ops` shows.
type OpSummary =
  { id: String
    sizeBytes: Int64
    ts: String
    /// The op itself, so a listing can say what the op DOES rather than how many bytes it
    /// is. `None` for an op this build's deserializer cannot read, which a synced store
    /// holds on purpose; the row still lists, it just cannot describe itself.
    op: Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageOp> }


/// What a branch REF resolved to. A DU rather than an Option because "no such branch" and "that could be
/// several branches" want different words from the caller, and an Option would flatten them into one.
type BranchRefResult =
  | Found of Uuid
  /// Not a live name, not an id, not a prefix: a name this store has never had. The ONE miss a write
  /// verb may answer by starting a branch.
  | NotFound
  /// A full id, and no branch here has it: a peer's, or a mispaste. Never something to start a branch
  /// named after.
  | UnknownId of Uuid
  /// The prefix matched more than one branch.
  | Ambiguous

