module Darklang.SCM.PackageOps

// Authoring is live-on-write: `add` appends ops that take effect the moment they fold. `add` and
// `getRecent` are the substrate everything else here is built on.
//
// This module spans five files: this one, `packageOpsBranch.dark`, `packageOpsSync.dark` (in
// `../sync/`, since sync sits on top of SCM), `packageOpsDraft.dark` and `packageOpsCommits.dark`. Together they would be a 2,000-line file,
// too big to review and too big to find anything in. Dark lets several files contribute to one
// module and see each other's definitions unqualified, so the split is physical only: no new silo,
// and `package_ops` still has exactly one owner.


/// Add a list of package ops to the database (immediately live on the given branch).
/// Returns the number of inserted ops on success (duplicates are skipped), or an error message on failure.
let add
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<Int, String> =
  Builtin.scmAddOps branchId (Lineage.recordPrevious branchId ops)


/// THE authoring boundary: stabilize a batch and store it, refusing what stabilization would corrupt.
///
/// Ordered deliberately. Duplicate names are checked FIRST, because `stabilizeHashes` keys by name: a
/// batch declaring one name twice would store one body under the other's hash, and whichever landed
/// second would silently become the first. Then the at-rest check runs over what was actually stored,
/// so its report describes the store rather than the request.
///
/// Every authoring surface goes through here rather than calling `add`: the CLI's fn/type/value/module
/// commands, the workbench, and the LSP's file provider.
let addAuthored
  (branchId: Uuid)
  (ops: List<LanguageTools.ProgramTypes.PackageOp>)
  : Stdlib.Result.Result<LanguageTools.AtRestTypeChecker.Report, String> =
  let duplicates = LanguageTools.PackageManager.duplicateDeclarations ops

  if Stdlib.Bool.not (Stdlib.List.isEmpty duplicates) then
    Stdlib.Result.Result.Error(
      "Declared more than once: " ++ (Stdlib.String.join duplicates ", "))
  else
    let stabilizedOps = LanguageTools.PackageManager.stabilizeHashes ops

    match add branchId stabilizedOps with
    | Ok _ ->
      Stdlib.Result.Result.Ok(
        LanguageTools.AtRestTypeChecker.checkPackageOps stabilizedOps)
    | Error message -> Stdlib.Result.Result.Error message


// the op-log DATA-ACCESS SILO
// This module OWNS every SQL query against `package_ops`. Callers (the `dark ops` CLI, doctor, sync) go
// through the typed functions below and never hand-roll SQL. There should be no op-log SQL outside here.


let localDb () : String = Stdlib.LocalStore.path ()

// Identity here is a NAME, not an authentication. There is no crypto and no proof: it is a string you
// reuse across machines so a relay can attribute ops to you, trusted by convention, stored in per-install
// config. Anything that needs to be un-forgeable needs something this is not.


/// This instance's sync identity, minted on first use.
///
/// An instance is a STORE, not a person or a machine: two clones of a store are two instances. Copying a
/// database copies its config, so the id is stamped with where it was minted and re-minted when that no
/// longer matches -- two peers sharing an id cannot sync or record a conflict against each other.
///
/// Gap: a store copied to the same PATH on another machine keeps its id. Closing that needs a hostname
/// builtin that doesn't exist.
let identity () : String =
  let here = Stdlib.LocalStore.path ()
  let stored = Stdlib.LocalStore.configGet "sync.identity"
  let mintedAt = Stdlib.LocalStore.configGet "sync.identity.origin"

  // Only an AUTO-MINTED id is ever replaced: a name someone chose deliberately (`dark identity alice`) is
  // theirs and survives being copied.
  let autoMinted = Stdlib.String.startsWith stored "inst-"

  if (stored != "") && ((mintedAt == here) || (autoMinted |> Stdlib.Bool.not)) then
    stored
  else
    let generated = $"inst-{Stdlib.Uuid.toString (Stdlib.Uuid.generate ())}"
    Stdlib.LocalStore.configSet "sync.identity" generated
    Stdlib.LocalStore.configSet "sync.identity.origin" here
    generated


/// Set (or change) this instance's sync identity.
let setIdentity (name: String) : Unit =
  let _ = Stdlib.LocalStore.configSet "sync.identity" name
  ()


/// The remembered default relay URL, or "" if none (so `dark sync` needs no url).
let relay () : String = Stdlib.LocalStore.configGet "sync.relay"


let setRelay (url: String) : Unit =
  let _ = Stdlib.LocalStore.configSet "sync.relay" url
  ()


/// The ONE Dark call into the op-blob decoder, and it answers None when this build cannot read the
/// blob. The binary op format isn't Dark-decodable, so this single primitive is all F# has to hand
/// over for reading ops; the queries and folding are Dark on top of it.
///
/// What an unreadable op MEANS belongs to `SCM.StoreHealth`, which counts them. Not to whichever
/// reader touches one first.
let tryDecodeOp
  (id: Uuid)
  (blob: Blob)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageOp> =
  Builtin.packageOpFromBlobOption id blob


/// Whether an op binds a NAME, read from its tag without decoding it.
///
/// Worth having only because of what it saves: an import decodes every arriving op to learn which names
/// moved, and content ops (the `Add*` family, which are whole ASTs and so the expensive ones) move none.
/// Asking first turns most of that decoding into a byte comparison.
let opBindsAName (blob: Blob) : Bool = Builtin.packageOpBindsAName blob


/// (id text, ts, decoded op) per decodable row -- the one id/blob/ts decode behind every
/// op-log read. A row whose id won't parse or whose blob this build can't read is
/// skipped; a row without a `ts` column reads as "". The QUERY is Dark; only the
/// per-row blob decode is a builtin, so there's no read builtin at all.
let decodeOpRowEntries
  (rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<(String * String * LanguageTools.ProgramTypes.PackageOp)> =
  rows
  |> Stdlib.List.filterMap (fun row ->
    match
      (Stdlib.Sqlite.textField row "id", Stdlib.Sqlite.bytesField row "op_blob")
    with
    | (Some idStr, Some blob) ->
      match Stdlib.Uuid.parse idStr with
      | Ok id ->
        tryDecodeOp id blob
        |> Stdlib.Option.map (fun op -> (idStr, Stdlib.Sqlite.textOr row "ts", op))
      | Error _ -> Stdlib.Option.Option.None
    | _ -> Stdlib.Option.Option.None)


/// Decode op-log rows (id, op_blob) into fully-decoded PackageOps.
let decodeOpRows
  (rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<LanguageTools.ProgramTypes.PackageOp> =
  decodeOpRowEntries rows |> Stdlib.List.map (fun (_id, _ts, op) -> op)


// reading an INCOMING side (op blobs -> the names they bind)


/// A decoded op + its stamp -> the name it BINDS, keyed for the latest-wins fold.
///
/// TWO ops bind a name: `SetName`, and a `Decision` whose kind is `Override`. Everything else is
/// content, which is content-addressed and so can never contend.
///
/// The override must be included. The F# fold (`PackageOpPlayback.applySetNameFrom`) and the in-memory
/// overlay (`PackageManager.createInMemoryOver`) both treat it as a binding; omitting it here makes Dark
/// report the last SetName while execution runs the override.
let bindingFromOp
  (op: LanguageTools.ProgramTypes.PackageOp)
  (ts: String)
  : Stdlib.Option.Option<(String * Conflicts.Binding)> =
  // Split because only a SetName carries a predecessor. An Override is a human overriding a binding, and
  // "what it replaced" is the version the fold picked, which is not lineage in the sense this asks about.
  let previous =
    match op with
    | SetName(_, _, Some h) ->
      Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.hashToString h)
    | _ -> Stdlib.Option.Option.None

  match op with
  | Decision(_, location, _, Override target)
  | SetName(location, target, _) ->
    let modules = Stdlib.String.join location.modules "."

    let itemType =
      Deps.kindString (LanguageTools.ProgramTypes.Reference.kind target)

    let hash =
      LanguageTools.ProgramTypes.hashToString
        (LanguageTools.ProgramTypes.Reference.hash target)

    let binding =
      Conflicts.Binding
        { owner = location.owner
          modules = modules
          name = location.name
          itemType = itemType
          hash = hash
          originTs = ts
          // Filled in by the wire path when the sender told us; a local fold has nobody to name.
          author = ""
          previous = previous }

    Stdlib.Option.Option.Some((Conflicts.bindingKey location.owner modules location.name, binding))
  | _ -> Stdlib.Option.Option.None


/// A run of ops' last word on one name: `binding` is what the name ends up bound to, or None for a name
/// left unbound, which hides whatever is underneath.
type NameWord =
  { owner: String
    modules: String
    name: String
    binding: Stdlib.Option.Option<Conflicts.Binding> }


/// Fold a run of (op, origin_ts) rows into what the run BINDS, latest-stamp-wins per name. The rows must
/// arrive oldest-first; the later SetName then overwrites the earlier, which is the binding the fold lands
/// on. An `Unbind` is the name's latest word too: it takes the name out, until a later op binds it again.
let bindingEntriesFromOpRows
  (rows: List<Dict<String, Stdlib.Sqlite.Value>>)
  : List<NameWord> =
  let entries =
    rows
    |> Stdlib.List.filterMap (fun row ->
      match
        (Stdlib.Sqlite.textField row "id", Stdlib.Sqlite.bytesField row "op_blob")
      with
      | (Some idStr, Some blob) ->
        match Stdlib.Uuid.parse idStr with
        | Ok id ->
          let ts = Stdlib.Sqlite.textField row "ts" |> Stdlib.Option.withDefault ""

          match tryDecodeOp id blob with
          | Some(Unbind(location, _)) ->
            let modules = Stdlib.String.join location.modules "."
            Stdlib.Option.Option.Some(
              (Conflicts.bindingKey location.owner modules location.name,
               NameWord
                 { owner = location.owner
                   modules = modules
                   name = location.name
                   binding = Stdlib.Option.Option.None })
            )
          | Some op ->
            bindingFromOp op ts
            |> Stdlib.Option.map (fun pair ->
              let (k, b) = pair
              (k,
               NameWord
                 { owner = b.owner
                   modules = b.modules
                   name = b.name
                   binding = Stdlib.Option.Option.Some b }))
          | None -> Stdlib.Option.Option.None
        | Error _ -> Stdlib.Option.Option.None
      | _ -> Stdlib.Option.Option.None)

  Stdlib.Dict.values (Stdlib.Dict.fromListOverwritingDuplicates entries)


/// <fn bindingEntriesFromOpRows>, keeping only the names that end up bound.
let bindingsFromOpRows (rows: List<Dict<String, Stdlib.Sqlite.Value>>) : List<Conflicts.Binding> =
  bindingEntriesFromOpRows rows |> Stdlib.List.filterMap (fun w -> w.binding)


/// What a branch CHAIN binds (the branch, then its ancestors up to main), for a non-main parent -- which is
/// never materialized in `locations`, only ever an overlay. The Dark mirror of the F# overlay walk in
/// `LibDB.Branches.chainOverlayOps`, so a name resolves the same whichever side asks.
///
/// `@p1` is main's ID, bound, never the literal "main". `SCM.Branch.mainBranchId` exists to enforce exactly that, and
/// SQL is where it drifts unnoticed, because no type checker reads a string: against a store whose
/// `parent_id` holds main's uuid, comparing to `'main'` is true for every row and the recursion walks
/// past main instead of stopping at it.
let chainBindingEntries (branchId: Uuid) : List<NameWord> =
  bindingEntriesFromOpRows (chainOpRows branchId)


/// The parent-chain walk: @p0 = the branch, @p1 = main's id. Spliced into each chain
/// statement (`chainOpRows`, `visibleWhere`, `parentCommitFor`), never edited in
/// place -- the one copy of the walk every chain query shares.
val chainCteSql =
  "WITH RECURSIVE chain(bid) AS (
     SELECT @p0
     UNION
     SELECT b.parent_id FROM branches b JOIN chain c ON b.id = c.bid
     WHERE b.parent_id != @p1
   )"


/// The chain's op rows (the chain CTE plus the id/op_blob/ts SELECT), oldest first --
/// the one query behind <fn chainBindingEntries> and `branchHashHistoryFor`.
let chainOpRows (branchId: Uuid) : List<Dict<String, Stdlib.Sqlite.Value>> =
  Stdlib.Sqlite.rowsOrEmptyP
    (localDb ())
    (chainCteSql
     ++ " SELECT p.id, p.op_blob, p.origin_ts AS ts
          FROM package_ops p JOIN op_branches ob ON ob.op_id = p.id
          WHERE ob.branch_id IN (SELECT bid FROM chain)
          ORDER BY p.origin_ts, p.rowid")
    [ Stdlib.Uuid.toString branchId
      Stdlib.Uuid.toString SCM.Branch.mainBranchId ]


/// <fn chainBindingEntries>, keeping only the names the chain leaves bound.
let chainBindings (branchId: Uuid) : List<Conflicts.Binding> =
  chainBindingEntries branchId |> Stdlib.List.filterMap (fun w -> w.binding)


/// What <param loc> resolves to on <param branchId>: the chain overlay first, then main's projection,
/// which is where every chain ends. THE branch-aware read of a live binding.
///
/// `locations` is main's projection and a branch's SetName never folds into it, so a read that goes
/// straight to the table answers about MAIN while you stand on a branch, and answers plausibly. Every
/// "what is live at this name" question goes through here; a direct read of `locations` is for a
/// question that is genuinely about main, and says so.
///
/// Its own three-key query rather than `Conflicts.localBindingsFor`, which matches on bare name across
/// owners. A caller asking about N names builds `chainBindings` once and looks up, the way
/// `Deps.branchOverlayBindings` does; this is the one-name form.
let liveBindingFor
  (branchId: Uuid)
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<Conflicts.Binding> =
  let modules = Stdlib.String.join loc.modules "."

  // The chain's last word on the name: bound to something, unbound (an `Unbind` with no later binding,
  // which hides whatever main holds), or nothing said.
  let onBranch =
    if SCM.Branch.isMain branchId then
      Stdlib.Option.Option.None
    else
      chainBindingEntries branchId
      |> Stdlib.List.findFirst (fun w ->
        (w.owner == loc.owner) && (w.modules == modules) && (w.name == loc.name))

  match onBranch with
  | Some w -> w.binding
  | None ->
    match
      // main-scoped: the fallback half of THE branch-aware read, after the chain overlay above.
      //
      // From a BRANCH, committed bindings only: a parent's draft is invisible downstream. Main
      // authors live-on-write, so its `locations` carry uncommitted work too, and without the
      // clause a branch resolves names through whatever main has half-written -- and a rebase
      // then repoints the branch's callers at it.
      //
      // From MAIN, no such clause: main's draft IS main's live state, and hiding it would have
      // `status`, `view` and `eval` disagree with the edit just made.
      Stdlib.Sqlite.queryOneP
        (localDb ())
        (if SCM.Branch.isMain branchId then
           "SELECT owner, modules, name, item_type, item_hash,
                   COALESCE(origin_ts,'') AS ts, previous
            FROM locations
            WHERE owner = @p0 AND modules = @p1 AND name = @p2 AND unlisted_at IS NULL
            LIMIT 1"
         else
           "SELECT l.owner, l.modules, l.name, l.item_type, l.item_hash,
                   COALESCE(l.origin_ts,'') AS ts, l.previous
            FROM locations l
            JOIN package_ops p ON p.id = l.op_id
            WHERE l.owner = @p0 AND l.modules = @p1 AND l.name = @p2
              AND l.unlisted_at IS NULL
              AND p.commit_hash IS NOT NULL
            LIMIT 1")
        [ loc.owner, modules, loc.name ]
    with
    | Some row -> Conflicts.bindingFromRow row
    | None -> Stdlib.Option.Option.None


/// <fn liveBindingFor> on the branch this process stands on.
let liveBindingAt
  (loc: LanguageTools.ProgramTypes.PackageLocation)
  : Stdlib.Option.Option<Conflicts.Binding> =
  liveBindingFor (currentBranch ()) loc


/// One name a branch changes vs its parent.
type BranchDiffEntry =
  { /// Dotted, as a person reads it.
    name: String
    /// "fn" / "type" / "value" -- named `kind`, as every other JSON surface spells it.
    kind: String
    /// "new" when the parent does not have this name at all, "changed" when it has a different version.
    change: String
    /// What the parent binds. "" when the name is new there.
    parentHash: String
    /// What the branch binds.
    hash: String }


/// What a sync-import from <param sourceId> will reconcile. `conflicts` are detected but NOT yet recorded,
/// and `names` are the names the import touches (they become the new bases once the fold lands).
/// `bulk` means the import was ADOPTED WHOLESALE without per-name detection; `detected` says whether the
/// detector actually ran, so a caller never reports "no conflicts" when it really means "didn't look".
type SyncPlan =
  { conflicts: List<Conflicts.Conflict>
    bulk: Bool
    detected: Bool }


/// A lightweight op-log row for display (no op_blob decode): what `dark ops` shows.
type OpSummary =
  { id: String
    sizeBytes: Int64
    ts: String
    /// The op itself, so a listing can say what the op DOES rather than how many bytes it
    /// is. `None` for an op this build's deserializer cannot read, which a synced store
    /// holds on purpose; the row still lists, it just cannot describe itself.
    op: Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageOp> }


/// What a branch REF resolved to. A DU rather than an Option because "no such branch" and "that could be
/// several branches" want different words from the caller, and an Option would flatten them into one.
type BranchRefResult =
  | Found of Uuid
  /// Not a live name, not an id, not a prefix: a name this store has never had. The ONE miss a write
  /// verb may answer by starting a branch.
  | NotFound
  /// A full id, and no branch here has it: a peer's, or a mispaste. Never something to start a branch
  /// named after.
  | UnknownId of Uuid
  /// The prefix matched more than one branch.
  | Ambiguous


/// Commit the whole current draft into <param commitHash>. Returns how many ops the draft held.
///
/// The whole-draft form counts BEFORE the stamp, because the UPDATE's predicate is the draft itself and
/// after it there is nothing left to count. `stampDraftOpsFor` narrows the same UPDATE to an id list and
/// so can report matched rows instead; the two answer the same question by different means.
let stampDraftFor (branchId: Uuid) (commitHash: String) : Int64 =
  let n = draftOpCountFor branchId

  // `draftWhere` binds @p0 when there is a branch; the commit hash takes the next slot, as in
  // `stampDraftOpsFor`, so the predicate is the one definition of "the draft" and not a copy of it.
  let params = draftParams branchId
  let hashSlot = $"@p{Stdlib.Int.toString (Stdlib.List.length params)}"

  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      ("UPDATE package_ops SET commit_hash = " ++ hashSlot ++ " WHERE id IN
          (SELECT p.id FROM package_ops p WHERE " ++ draftWhere branchId ++ ")")
      (Stdlib.List.append params [ commitHash ])

  n


let stampDraft (commitHash: String) : Int64 =
  stampDraftFor (currentBranch ()) commitHash


/// A draft op, with the two things a selection needs that a decoded op alone doesn't carry: which row it is,
/// and when it was authored.
type DraftEntry =
  { id: String
    ts: String
    op: LanguageTools.ProgramTypes.PackageOp }


/// Commit ONLY these ops into <param commitHash>. Returns how many rows it actually stamped.
///
/// The whole-draft UPDATE narrowed to an explicit id set, for `dark commit --include=`. It re-applies the
/// draft predicate as well as the id list, so a stale id -- already committed, or belonging to a branch --
/// cannot be swept in by a caller whose selection is a moment old. Counts MATCHED rows, not the caller's
/// list length.
let stampDraftOpsFor
  (branchId: Uuid)
  (commitHash: String)
  (opIds: List<String>)
  : Int64 =
  if Stdlib.List.isEmpty opIds then
    0L
  else
    // One UPDATE per id, every value BOUND, all in one transaction. Splicing the ids into an `IN (...)`
    // would be safe only because they came out of this store's own `id` column, and nothing in the code
    // says so; bound is the shape a reader can trust without tracing where the values came from.
    //
    // The statement is scoped by `draftWhere` as well as by id, so an id that is not in the draft (already
    // committed, or another branch's) updates nothing. Each row's affected-count reports that, and that is
    // where the return value comes from.
    let params = draftParams branchId
    let positional = Stdlib.List.length params

    // `draftWhere` binds @p0 when there is a branch. The commit hash and the id follow it.
    let where = draftWhere branchId
    let hashSlot = $"@p{Stdlib.Int.toString positional}"
    let idSlot = $"@p{Stdlib.Int.toString (positional + 1)}"

    let rows =
      opIds
      |> Stdlib.List.map (fun id -> Stdlib.List.append params [ commitHash, id ])

    Stdlib.Sqlite.mustExecBatch
      (localDb ())
      [ ("UPDATE package_ops SET commit_hash = " ++ hashSlot ++ " WHERE id = " ++ idSlot
         ++ " AND id IN (SELECT p.id FROM package_ops p WHERE " ++ where ++ ")",
         rows) ]
    // Per-row counts are `Int`; this reports `Int64`. `toInt64` is an Option because an Int is
    // unbounded, which an affected-row count is not, so `0L` stands in for the impossible case.
    |> Stdlib.List.fold 0L (fun acc n ->
      acc + (Stdlib.Int.toInt64 n |> Stdlib.Option.withDefault 0L))


let stampDraftOps (commitHash: String) (opIds: List<String>) : Int64 =
  stampDraftOpsFor (currentBranch ()) commitHash opIds


/// Stamp <param opIds> that have LANDED on main (effective, uncommitted) with <param commitHash>,
/// whatever branch tags they may still carry. `stampDraftOpsFor` scopes by `draftWhere`, which
/// excludes ops a SIBLING branch still tags -- right for a person's commit, wrong for a merge:
/// content-addressed ops are one row, so a review queue holding the same op must not keep a merge
/// from committing what it landed (left unstamped, the op surfaces later as draft work nobody
/// typed, or gets swept under the sibling's merge message).
let stampLandedOps (commitHash: String) (opIds: List<String>) : Int64 =
  if Stdlib.List.isEmpty opIds then
    0L
  else
    let rows = opIds |> Stdlib.List.map (fun id -> [ commitHash, id ])

    Stdlib.Sqlite.mustExecBatch
      (localDb ())
      [ ("UPDATE package_ops SET commit_hash = @p0
          WHERE id = @p1 AND commit_hash IS NULL AND effective = 1",
         rows) ]
    |> Stdlib.List.fold 0L (fun acc n ->
      acc + (Stdlib.Int.toInt64 n |> Stdlib.Option.withDefault 0L))


/// Collapse the draft's superseded NAMINGS, keeping the last binding per name. Returns how many ops went.
///
/// Main only. A branch's ops are branch-pending rather than draft, and they're collapsed when they merge.
let collapseDraft () : Stdlib.Result.Result<Int, String> =
  match currentBranch () with
  | id when SCM.Branch.isMain id -> SCM.Draft.collapse ()
  | _ -> Stdlib.Result.Result.Ok 0


/// Drop a BRANCH's uncommitted ops. Returns how many went.
///
/// Nothing is re-folded: a branch's ops are effective=0 and never fold into main's projections, so
/// deleting the rows and reloading the overlay IS the removal. Main's draft goes through `discardMainDraft`.
///
/// The op rows go FIRST -- untagging before deleting leaves an op looking like a main op, and a main op
/// is one that folds.
let discardBranchDraft (branchId: Uuid) : Int64 =
  let n = draftOpCountFor branchId

  // The ids FIRST, as a list: each statement below shrinks what the other's subquery would see, so
  // running them against live subqueries either deletes rows the untag then cannot find (dangling
  // tags, which `dark status`'s store health reports as damage) or untags rows the delete then
  // will not touch. Against a fixed list, order stops mattering for coverage; rows still go before
  // tags so an op never sits untagged-but-present looking like a main op.
  let draftIds =
    Stdlib.Sqlite.columnP
      (localDb ())
      "SELECT id FROM package_ops
       WHERE commit_hash IS NULL AND effective = 0
         AND id IN (SELECT op_id FROM op_branches WHERE branch_id = @p0)"
      [ Stdlib.Uuid.toString branchId ]
      "id"

  let idsJson = Stdlib.Json.serialize<List<String>> draftIds

  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      // Only ops no OTHER branch holds -- see the same guard in `Branches.archive`. The tag can also
      // point at an op main holds live (author the same value on both places), which the
      // `commit_hash IS NULL AND effective = 0` shape of the id list above already excludes.
      "DELETE FROM package_ops
        WHERE id IN (SELECT value FROM json_each(@p0))
          AND id NOT IN (SELECT op_id FROM op_branches WHERE branch_id <> @p1)"
      [ idsJson, Stdlib.Uuid.toString branchId ]

  // Untag everything the branch held, whether or not the row above survived (a sibling's tag keeps
  // the row; this branch's tag must still go).
  let _ =
    Stdlib.Sqlite.mustExec
      (localDb ())
      "DELETE FROM op_branches
        WHERE branch_id = @p0
          AND op_id IN (SELECT value FROM json_each(@p1))"
      [ Stdlib.Uuid.toString branchId, idsJson ]

  // Once the branch holds nothing, its per-name fork points describe ops that no longer exist. They stay
  // while any op survives, because those ops are still based on them.
  let remaining =
    Stdlib.Sqlite.scalarIntP
      (localDb ())
      "SELECT count(*) AS n FROM op_branches WHERE branch_id = @p0"
      [ Stdlib.Uuid.toString branchId ]
      "n"
    |> Stdlib.Option.withDefault 0L

  let _ =
    if remaining == 0L then
      Stdlib.Sqlite.execP
        (localDb ())
        "DELETE FROM branch_name_bases WHERE branch_id = @p0"
        [ Stdlib.Uuid.toString branchId ]
    else
      Stdlib.Result.Result.Ok 0

  // Reload the overlay so this process stops resolving names through the ops just deleted.
  let _ = selectBranch branchId
  n


/// Drop MAIN's uncommitted ops. Returns how many went.
///
/// Dark decides what survives and does the surgical drop; only the whole-log rebuild fallback is still
/// F#, because it re-mints ids and re-folds. See `SCM.Draft.rewriteBy`.
let discardMainDraft () : Stdlib.Result.Result<Int, String> = SCM.Draft.discardAll ()


/// Drop ONE name's uncommitted bindings from MAIN's draft, leaving the rest alone.
let discardMainDraftName
  (owner: String)
  (modules: List<String>)
  (name: String)
  : Stdlib.Result.Result<Int, String> =
  SCM.Draft.discardName owner modules name


/// Drop one name's uncommitted bindings from the current scope's draft.
///
/// What neither `discard` (all-or-nothing) nor `undo` (step back a version) can express: a newly-authored
/// item has no previous version, so `undo` refuses it, and without this one typo in a reference blocks
/// `commit` until the entire draft goes.
///
/// Only the NAME's bindings go. That reverts the name to its last committed binding, or to not
/// existing at all if it never had one.
let discardDraftName
  (owner: String)
  (modules: List<String>)
  (name: String)
  : Stdlib.Result.Result<Int, String> =
  match currentBranch () with
  | id when SCM.Branch.isMain id -> discardMainDraftName owner modules name
  | branchId ->
    // A branch's ops are effective=0 and never fold into main, so deleting the tagged rows for this
    // name IS the removal, exactly as `discardBranchDraft` does for all of them.
    //
    // Which rows: the branch's own ops that BIND this name, found by reading the ops. Not via
    // `locations` -- that is main's projection, and a branch's SetName never folds into it, so a join
    // through it matches nothing and drops no rows while reporting the name gone.
    let key = (owner, Stdlib.String.join modules ".", name)

    // UNCOMMITTED ops only. `ownFrontierOps` is every op the branch holds, committed ones
    // included, and discard is about the draft: dropping a committed binding here takes the
    // branch's last committed version of the name with it.
    let uncommitted = SCM.Branches.uncommittedOpIds branchId

    let bindingIds =
      SCM.Branches.ownFrontierOps branchId
      |> Stdlib.List.filter (fun entry ->
        let (id, op) = entry
        (Stdlib.List.member uncommitted (Stdlib.Uuid.toString id))
        && (Stdlib.Option.isSome (SCM.Branches.opBindsKey op key)))
      |> Stdlib.List.map (fun entry ->
        let (id, _) = entry
        Stdlib.Uuid.toString id)

    dropBranchOps branchId bindingIds


/// Drop these ops from <param branchId>'s frontier, and reload the overlay. Returns how many went.
///
/// A branch's ops are effective=0 and never fold into main, so deleting the rows IS the removal. Only
/// uncommitted, inert rows the branch holds alone: an op another branch also tags stays, untagged here.
let dropBranchOps (branchId: Uuid) (ids: List<String>) : Stdlib.Result.Result<Int, String> =
  match ids with
  | [] -> Stdlib.Result.Result.Ok 0
  | ids ->
    let b = Stdlib.Uuid.toString branchId
    let rows = ids |> Stdlib.List.map (fun id -> [ id, b, b ])

    let untagRows = ids |> Stdlib.List.map (fun id -> [ b, id ])

    match
      Stdlib.Sqlite.execBatch
        (localDb ())
        // Untag FIRST, then delete the rows. The untag is guarded on the op being uncommitted,
        // which it can only check while the row still exists; deleting first left the tag behind
        // pointing at nothing.
        //
        // Uncommitted only, and belt-and-braces with the caller's own filter: an untag is what
        // takes an op off a branch, so without this clause a committed op reached here by any
        // path would be silently removed from the branch's history.
        [ ("DELETE FROM op_branches WHERE branch_id = @p0 AND op_id = @p1
            AND op_id IN (SELECT id FROM package_ops WHERE commit_hash IS NULL)",
           untagRows)
          // The op ROW survives when a sibling also tags it or when main holds the same content
          // live, and that is deliberate; only rows nothing else holds go.
          ("DELETE FROM package_ops WHERE commit_hash IS NULL AND effective = 0 AND id = @p0
            AND id NOT IN (SELECT op_id FROM op_branches)
            AND @p1 = @p2",
           rows) ]
    with
    | Ok counts ->
      // Count the UNTAGS, which is what "dropped from this branch" means, and they run first now.
      // The op-row deletes are fewer whenever content is shared, so reporting those would make a
      // real drop read as a no-op.
      let dropped =
        counts
        |> Stdlib.List.take (Stdlib.List.length ids)
        |> Stdlib.List.fold 0 (fun acc n -> acc + n)

      let _ = selectBranch branchId
      Stdlib.Result.Result.Ok dropped
    | Error e -> Stdlib.Result.Result.Error e


/// Drop the current scope's draft, whichever it is.
let discardDraft () : Stdlib.Result.Result<Int, String> =
  match currentBranch () with
  | id when SCM.Branch.isMain id -> discardMainDraft ()
  | branchId ->
    Stdlib.Result.Result.Ok(
      Stdlib.Int.fromInt64 (discardBranchDraft branchId)
    )


/// The names that would REPOINT if the draft were committed now: everything that still references an OLD hash
/// of a changed name, plus everything that references those, transitively.
///
/// The recursion is the cascade: if X repoints it gets a new hash, so anything referencing X repoints too.
/// One recursive query rather than a Dark loop, so `dark status` is cheap enough to run on every prompt.
let staleHashesFor (b: Conflicts.Binding) : List<String> =
  Stdlib.Sqlite.columnP
    (localDb ())
    "WITH RECURSIVE stale(hash) AS (
       SELECT d.item_hash FROM package_dependencies d
        WHERE d.depends_on_owner = @p0
          AND d.depends_on_modules = @p1
          AND d.depends_on_name = @p2
          AND d.depends_on_hash <> @p3
       UNION
       SELECT d2.item_hash FROM package_dependencies d2 JOIN stale s ON d2.depends_on_hash = s.hash
     )
     SELECT DISTINCT hash FROM stale"
    [ b.owner, b.modules, b.name, b.hash ]
    "hash"


/// Every name bound to <param hash>, as <param branchId> sees it: main's, plus the branch's own frontier.
///
/// Deprecation is keyed on CONTENT, so it applies to every name holding that hash, which for a trivial
/// value can be many unrelated ones. `locations` answers for MAIN only, so reading it alone under-reports
/// the collateral on a branch -- precisely where a caller is about to warn someone about it.
let namesAtContent (branchId: Uuid) (hash: String) (itemType: String) : List<String> =
  let mainNames =
    // main-scoped: main's names for this content; the chain's names and rebinds are applied below.
    Stdlib.Sqlite.rowsP
      (localDb ())
      "SELECT owner, modules, name FROM locations
       WHERE item_hash = @p0 AND item_type = @p1 AND unlisted_at IS NULL"
      [ hash, itemType ]
      (fun row ->
        match
          (Stdlib.Sqlite.textField row "owner",
           Stdlib.Sqlite.textField row "modules",
           Stdlib.Sqlite.textField row "name")
        with
        | (Some o, Some m, Some n) -> Stdlib.Option.Option.Some(Conflicts.fqn o m n)
        | _ -> Stdlib.Option.Option.None)

  if SCM.Branch.isMain branchId then
    mainNames
  else
    // The whole CHAIN, not the branch's own frontier: a parent branch's name for this content is
    // collateral too. And main's name is not, when the chain has rebound it away from this content.
    let chain = chainBindings branchId

    let branchNames =
      chain
      |> Stdlib.List.filterMap (fun b ->
        if b.hash == hash && b.itemType == itemType then
          Stdlib.Option.Option.Some(Conflicts.fqn b.owner b.modules b.name)
        else
          Stdlib.Option.Option.None)

    let reboundAway =
      chain
      |> Stdlib.List.filterMap (fun b ->
        if b.hash != hash then
          Stdlib.Option.Option.Some(Conflicts.fqn b.owner b.modules b.name)
        else
          Stdlib.Option.Option.None)

    let mainStill =
      mainNames |> Stdlib.List.filter (fun n -> Stdlib.Bool.not (Stdlib.List.``member`` reboundAway n))

    Stdlib.List.unique (Stdlib.List.append mainStill branchNames)


/// Where MAIN says each of <param hashes> lives. LIST-valued per hash on purpose: identical content is the
/// same item, so one hash is routinely live at several names, and picking one would drop the others from
/// the preview -- the same mistake that would drop them from the cascade itself.
///
/// main-scoped, by name and on purpose: the cascade preview asks what MAIN binds, and a branch's
/// own names are added by the caller from the overlay.
let mainNamesForHashes (hashes: List<String>) : List<(String * String)> =
  match hashes with
  | [] -> []
  | _ ->
    // Chunked for the same reason as `Conflicts.localBindingsFor`: a wide cascade can produce more stale
    // hashes than SQLite will bind in one statement, and the over-cap failure reads as an empty repoint list.
    Stdlib.List.unique hashes
    |> Conflicts.inChunks
    |> Stdlib.List.map (fun chunk ->
      let sql =
        "SELECT item_hash, owner, modules, name FROM locations
         WHERE unlisted_at IS NULL AND item_hash IN ("
        ++ (Conflicts.inPlaceholders chunk)
        ++ ")"

      Stdlib.Sqlite.rowsP
        (localDb ())
        sql
        chunk
        (fun row ->
          match
            (Stdlib.Sqlite.textField row "item_hash",
             Stdlib.Sqlite.textField row "owner",
             Stdlib.Sqlite.textField row "modules",
             Stdlib.Sqlite.textField row "name")
          with
          | (Some h, Some o, Some m, Some n) ->
            Stdlib.Option.Option.Some((h, Conflicts.fqn o m n))
          | _ -> Stdlib.Option.Option.None))
    |> Stdlib.List.flatten


/// The NAMES `staleHashesFor` finds for <param b>, resolved through the BRANCH overlay first, then main. A
/// branch's items have no `locations` row, so resolving only against main undercounts the preview -- fewer
/// repoints than the commit will perform, which is the wrong direction for a number whose job is to warn you.
let repointsFor (b: Conflicts.Binding) : List<String> =
  let hashes = staleHashesFor b

  let overlay =
    match currentBranch () with
    | id when SCM.Branch.isMain id -> []
    | branch ->
      chainBindings branch
      |> Stdlib.List.map (fun bind ->
        (bind.hash, Conflicts.fqn bind.owner bind.modules bind.name))

  let overlayHashes = overlay |> Stdlib.List.map (fun pair -> Stdlib.Tuple2.first pair)

  let fromOverlay =
    overlay
    |> Stdlib.List.filter (fun pair ->
      Stdlib.List.``member`` hashes (Stdlib.Tuple2.first pair))

  // Main answers only for hashes the branch doesn't already place.
  let unresolved =
    hashes |> Stdlib.List.filter (fun h -> Stdlib.Bool.not (Stdlib.List.``member`` overlayHashes h))

  (Stdlib.List.append fromOverlay (mainNamesForHashes unresolved))
  |> Stdlib.List.map (fun pair -> Stdlib.Tuple2.second pair)
  |> Stdlib.List.unique


/// The location a fully-qualified name refers to, as `Conflicts.fqn` writes them: the first segment is the
/// owner, the last is the name, everything between is the module path. None when there aren't enough
/// segments to be an item.
let locationOfFqn
  (fqn: String)
  : Stdlib.Option.Option<LanguageTools.ProgramTypes.PackageLocation> =
  (Branches.parseFqn fqn)
  |> Stdlib.Option.map (fun (o, m, n) -> Deps.locationOf o m n)


/// One knock-on repoint: <param name> moves because <param uses> did. Carrying the CAUSE is what lets the
/// commit view read as an outcome ("Home.render -> uses User.format") instead of a bare list of names.
type Repoint =
  { name: String
    uses: String }


/// Every name the draft would touch as a knock-on, before any policy is applied: it references an old
/// version of something the draft changed. Never a name the draft itself changed, which is listed as a
/// change rather than an effect. Split by `draftRepoints` (will follow) and `draftLeftBehind` (pinned).
let draftRepointCandidates
  (changed: List<Conflicts.Binding>)
  : List<Repoint> =
  let changedNames =
    changed |> Stdlib.List.map (fun b -> Conflicts.fqn b.owner b.modules b.name)

  changed
  |> Stdlib.List.map (fun b ->
    let cause = Conflicts.fqn b.owner b.modules b.name

    repointsFor b
    |> Stdlib.List.map (fun n -> Repoint { name = n; uses = cause }))
  |> Stdlib.List.flatten
  |> Stdlib.List.filter (fun r ->
    Stdlib.Bool.not (Stdlib.List.``member`` changedNames r.name))
  |> Stdlib.List.uniqueBy (fun r -> r.name)
  |> Stdlib.List.sortBy (fun r -> r.name)


/// Every name the draft would repoint, deduped: the candidates policy says will follow.
let draftRepoints (changed: List<Conflicts.Binding>) : List<Repoint> =
  draftRepointCandidates changed
  |> (fun rs ->
    let choices = Propagation.allChoices ()

    rs
    |> Stdlib.List.filter (fun r ->
      match locationOfFqn r.name with
      | Some loc -> Propagation.shouldFollowIn choices loc
      | None -> true))


/// Every name that WOULD have repointed and won't, because a pin says so.
///
/// The complement of `draftRepoints`, and a first-class outcome rather than a warning: leaving a reference
/// on an older version is what a pin IS. Shown at commit so you can see the decision next to the changes
/// that triggered it.
let draftLeftBehind (changed: List<Conflicts.Binding>) : List<Repoint> =
  draftRepointCandidates changed
  |> (fun rs ->
    let choices = Propagation.allChoices ()

    rs
    |> Stdlib.List.filter (fun r ->
      match locationOfFqn r.name with
      | Some loc -> Stdlib.Bool.not (Propagation.shouldFollowIn choices loc)
      | None -> false))


/// Authors a `Decision` op with an `Override`, which is why that op exists. Ops are content-addressed, so
/// re-authoring the losing SetName reproduces the op already in the log: it INSERT-OR-IGNOREs and folds
/// nothing, and there is no way to say "the same binding, but now I mean it" as a plain op. Carrying the
/// conflict id makes it distinct and makes re-resolving idempotent.
///
/// Authoring alone. `settleConflict` is the whole act (author, close the record, cascade); a caller that
/// wants a settled conflict goes there.
///
/// Being an op is what makes the choice TRAVEL: a peer folding it lands on the same binding rather than
/// re-deriving its own auto-pick.
let applyResolution
  (branchId: Uuid)
  (c: Conflicts.Conflict)
  (hash: String)
  : Stdlib.Result.Result<Int, String> =
  let location = Deps.locationOf c.owner c.modules c.name
  let h = LanguageTools.ProgramTypes.Hash.Hash hash

  let reference =
    match c.itemType with
    | "type" -> LanguageTools.ProgramTypes.Reference.PackageType h
    | "value" -> LanguageTools.ProgramTypes.Reference.PackageValue h
    | _ -> LanguageTools.ProgramTypes.Reference.PackageFn h

  add
    branchId
    [ LanguageTools.ProgramTypes.PackageOp.Decision(
        c.id,
        location,
        "",
        LanguageTools.ProgramTypes.DecisionKind.Override reference
      ) ]


/// Settle a conflict on <param hash>: author the resolution AND close the record, together.
///
/// One function because they are one act. Split across callers, they drift into a conflict left open with
/// its resolution authored, or closed with nothing behind it.
///
/// Refuses an empty hash rather than binding a name to nothing: `Hash ""` corrupts the binding in a way no
/// later fold undoes.
let settleConflict
  (branchId: Uuid)
  (c: Conflicts.Conflict)
  (hash: String)
  : Stdlib.Result.Result<Unit, String> =
  if hash == "" then
    Stdlib.Result.Result.Error
      "no version to keep: that side of the conflict has no recorded hash"
  else
    match applyResolution branchId c hash with
    | Ok _ ->
      let _ = Conflicts.setStatus c.id "overridden" hash

      // Cascade, the way an edit does. An override rebinds the NAME; without this the callers that
      // had followed the losing version go on calling it by hash, so the name says one thing and
      // everything that uses it does another, on every machine the override reaches.
      let location = Deps.locationOf c.owner c.modules c.name
      let kind = Deps.kindOf c.itemType
      let losers =
        c.candidates
        |> Stdlib.List.filterMap (fun cand ->
          if (cand.hash == hash) || (cand.hash == "") then
            Stdlib.Option.Option.None
          else
            Stdlib.Option.Option.Some(LanguageTools.ProgramTypes.Hash.Hash cand.hash))
      let _ =
        Propagation.repointDependents
          branchId
          location
          kind
          losers
          (LanguageTools.ProgramTypes.Hash.Hash hash)

      Stdlib.Result.Result.Ok()
    | Error e -> Stdlib.Result.Result.Error e


/// Commit the draft on <param branchId> under <param message>. Returns the new commit's hash.
///
/// Refuses when something in the draft references a name that does not resolve. The gate is on the
/// OPERATION, not on one command: there is more than one way to commit, and a draft must not be
/// committable from one surface and refused from another.
///
/// The commit row is created first and deleted again if nothing is stamped, since a commit naming no ops
/// shows up in `log` claiming work that isn't there.
///
/// The workbench's commit. The CLI has its own path (`Cli.Commit`), which additionally offers
/// `--allow-type-errors` and `--allow-unresolved`; there is no way to type a flag at the workbench's
/// commit prompt, so this refuses outright rather than offering an override it cannot take.
let commitDraft
  (author: String)
  (branchId: Uuid)
  (message: String)
  : Stdlib.Result.Result<String, String> =
  let typeReport = typeCheckDraft branchId

  match typeReport.verdict with
  | Failed ->
    let count =
      Stdlib.List.length
        (Stdlib.List.append typeReport.diagnostics typeReport.blockers)

    Stdlib.Result.Result.Error(
      $"the at-rest type check found {Stdlib.Int.toString count} definite error(s); "
      ++ "`dark constraints` and `dark typecheck` show them")
  | Checked
  | Incomplete ->

  match unresolvedInDraft branchId with
  | [] ->
    match draftOpCountFor branchId with
    | 0L -> Stdlib.Result.Result.Error "nothing to commit"
    | _ ->
      // The ids and the parent are read BEFORE the stamp, because stamping is what takes them out of the
      // draft: ask afterwards and the answer is empty.
      let opIds = draftOpIdsFor branchId
      let parent = parentCommitFor branchId
      let hash = Commits.create message author opIds parent
      let committed = stampDraftFor branchId hash

      if committed == 0L then
        let _ = Commits.delete hash
        Stdlib.Result.Result.Error "nothing was committed"
      else
        Stdlib.Result.Result.Ok hash
  | broken ->
    let names =
      broken
      |> Stdlib.List.map (fun (label, _) -> label)
      |> Stdlib.String.join ", "

    Stdlib.Result.Result.Error
      $"unresolved references in {names} -- author what's missing, or commit with --allow-unresolved"


/// Drop the draft for <param branchId>, whichever kind of draft that is. Returns how many ops went.
let discardDraftFor (branchId: Uuid) : Int =
  if SCM.Branch.isMain branchId then
    match discardMainDraft () with
    | Ok n -> n
    | Error _ -> 0
  else
    Stdlib.Int.fromInt64 (discardBranchDraft branchId)


/// Commit, on main, whichever of <param opIds> are still in main's draft, under <param message>. Nothing
/// happens when none are. For the ops a branch verb lands in main by itself -- a merge's frontier and
/// its event, an archive's event -- which nobody typed and so nobody will think to commit.
///
/// Exactly these ids, never "whatever is uncommitted": that would sweep a half-written fn into a commit
/// about a branch.
let commitMainOps (message: String) (fallbackAuthor: String) (opIds: List<String>) : Unit =
  // "In the draft" here means landed on main and uncommitted -- NOT `draftWhere`, whose
  // op_branches exclusion would drop any op a sibling branch still tags. A merge lands
  // content-addressed ops that a review queue may genuinely share; they are main's now,
  // and this commit is their commit.
  let toStamp =
    if Stdlib.List.isEmpty opIds then
      []
    else
      let rows =
        Stdlib.Sqlite.rowsOrEmptyP
          (localDb ())
          "SELECT id FROM package_ops WHERE commit_hash IS NULL AND effective = 1"
          []

      let landed =
        rows
        |> Stdlib.List.filterMap (fun row -> Stdlib.Sqlite.textField row "id")

      opIds |> Stdlib.List.filter (fun id -> Stdlib.List.``member`` landed id)

  if Stdlib.List.isEmpty toStamp then
    ()
  else
    let author =
      match identity () with
      | "" -> fallbackAuthor
      | id -> id

    let hash =
      Commits.create
        message
        author
        (Stdlib.List.sort toStamp)
        (parentCommitFor SCM.Branch.mainBranchId)

    let _ = stampLandedOps hash toStamp
    ()


/// What a merge did: how many ops moved, and what it auto-resolved on the way.
type MergeOutcome =
  { merged: Int
    conflicts: List<Conflicts.Conflict> }


/// Merge a branch into its parent. Decides whether it MAY (`Branches.canMerge`), then has the builtin do
/// it: flip the frontier effective, fold into main, evaluate merged values, clear the frontier, mark
/// merged. The gate is here and the mechanism is there, which is the line this module draws everywhere.
///
/// Conflicts do not BLOCK the merge. They are detected first (the fold is about to move the local side,
/// after which the comparison is meaningless), auto-resolved by origin_ts LWW, and recorded once the merge
/// succeeds, so the loser is reviewable rather than silently gone.
let mergeBranch (branchId: Uuid) : Stdlib.Result.Result<MergeOutcome, String> =
  match Branches.canMerge branchId with
  | Error e -> Stdlib.Result.Result.Error e
  | Ok _ ->

  let conflicts = branchPreview branchId

  let parent = branchParentOf branchId

  // What the merge moves, read now: both arms drop the tags, and the event that tells the other
  // machine has to name exactly these, so a peer holding more of the branch keeps its own.
  let moved = Branches.frontierIds branchId

  // Which arm: into MAIN the frontier flips effective and folds; into a branch-off-a-branch it only
  // retags onto the parent, whose own overlay folds it later. Folding there would leak the child's work
  // into main, which nobody asked to merge.
  let merged =
    if SCM.Branch.isMain parent then
      // Flip the frontier effective, fold it into main, then close the branch. The fold is the F# half;
      // the order, and stopping if any step fails, is the decision.
      Branches.markMergedEffective branchId
      |> Stdlib.Result.andThen (fun n ->
        Builtin.scmApplyMergedOps ()
        |> Stdlib.Result.andThen (fun _ ->
          Branches.finishMerge branchId |> Stdlib.Result.map (fun _ -> n)))
    else
      Branches.retagFrontierToParent branchId parent

  match merged with
  | Ok n ->
    // Say so in the log too, so the machine your colleague is on learns the branch is finished. The
    // local projections are already updated by the arm above; this is only how the OTHER machine learns.
    let eventId = Builtin.scmRecordBranchMerged branchId moved

    // A merge into main COMMITS what it landed: the branch's ops that were not committed here (a pulled
    // branch's ops arrive uncommitted, since a bundle carries no commits) and the event itself. Left in
    // main's draft, they read as "1 item changed" that nobody edited, and the next unrelated commit
    // sweeps them up under its message. A merge into a branch retags; the parent's own merge commits.
    let _ =
      if SCM.Branch.isMain parent then
        let landed =
          Stdlib.List.append
            (moved |> Stdlib.List.map (fun id -> Stdlib.Uuid.toString id))
            [ Stdlib.Uuid.toString eventId ]

        commitMainOps $"merged branch \"{branchName branchId}\"" "merge" landed
      else
        ()

    // Filed against the PARENT, not against `branchId`: the merge folded into the parent's projection and
    // the branch it came from is finished. `parent_id` and a branch id spell main the same way, so the id
    // goes through as-is; translated, main's conflict list would never see them.
    let _ = Conflicts.record parent conflicts

    (MergeOutcome { merged = n; conflicts = conflicts })
    |> Stdlib.Result.Result.Ok
  | Error e -> Stdlib.Result.Result.Error e


/// What a rebase did: the parent's message, and what the rebase reconciled.
type RebaseOutcome =
  { message: String
    conflicts: List<Conflicts.Conflict> }


/// What a rebase reconciled, said to the person who ran it.
///
/// Names the parent by NAME, never by id: a bare uuid where a branch name belongs is exactly what the
/// boundary rule exists to prevent, and main's id renders as one.
let rebaseMessage (parentId: Uuid) (rebased: Branches.Rebased) : String =
  let parentName = branchName parentId

  // Two different things happened, and the advice differs: a divergence is yours to settle, a repoint
  // already agrees with the parent and needs nothing from you.
  let divergedPart =
    match rebased.diverged with
    | [] -> []
    | names ->
      let n = Stdlib.Int.toString (Stdlib.List.length names)
      let listed = Stdlib.String.join names "\n  "
      [ $"it had changed {n} name(s) you also touched:\n  {listed}\nyour branch's versions win by recency on merge -- re-author any you want to take the parent's version of." ]

  let repointedPart =
    match rebased.repointed with
    | [] -> []
    | names ->
      let n = Stdlib.Int.toString (Stdlib.List.length names)
      let listed = Stdlib.String.join names "\n  "
      [ $"it had moved names this branch calls; {n} caller(s) now point at the parent's version:\n  {listed}" ]

  match Stdlib.List.append divergedPart repointedPart with
  | [] ->
    $"already current with \"{parentName}\" -- nothing to reconcile; merge is ready"
  | parts ->
    $"rebased onto \"{parentName}\". " ++ (Stdlib.String.join parts "\n")


/// Rebase a branch: accept the parent's current state as the new base; reports the names the parent changed
/// since the fork, so the branch's own ops layer on top (LWW). Records what it reconciled, same as merge.
let rebaseBranch (branchId: Uuid) : Stdlib.Result.Result<RebaseOutcome, String> =
  if SCM.Branch.isMain branchId then
    // Main has no parent to rebase onto, so this is not a thing you can do rather than a thing that found
    // nothing to do. The rewrite loops over `branch_name_bases`, and main has no rows there.
    Stdlib.Result.Result.Error
      "main is the trunk -- rebase moves a BRANCH onto its parent, and main has none."
  else

  let conflicts = branchPreview branchId

  match Branches.rebaseDetailed branchId with
  | Ok rebased ->
    let msg = rebaseMessage (branchParentOf branchId) rebased
    // The mirror of merge: a rebase folds the PARENT's work into the branch, so the conflict is the
    // branch's to answer and stays with it.
    let _ = Conflicts.record branchId conflicts

    (RebaseOutcome { message = msg; conflicts = conflicts })
    |> Stdlib.Result.Result.Ok
  | Error e -> Stdlib.Result.Result.Error e


/// A display of all active branches (one line each: name (id) <- parent [status]).
let branchList (includeMerged: Bool) : String =
  let hidden = if includeMerged then 0L else Branches.mergedCount ()

  let footer =
    if hidden == 0L then
      ""
    else
      $"\n\n{Stdlib.Int64.toString hidden} merged -- `dark branches --all` shows them."

  match Branches.listLines includeMerged with
  | [] ->
    if hidden == 0L then
      "no branches -- `dark switch <name>` starts one."
    else
      $"no live branches.{footer}"
  | lines ->
    // Newest first, capped: a long-lived store accretes dozens of finished experiments, and the one
    // live branch you care about should not be buried in them. `--all` uncaps along with unhiding.
    let cap = 20

    let shown =
      if includeMerged || (Stdlib.List.length lines) <= cap then
        lines
      else
        let more = (Stdlib.List.length lines) - cap

        Stdlib.List.append
          (Stdlib.List.take lines cap)
          [ $"+ {Stdlib.Int.toString more} more -- `dark branches --all` lists every branch." ]

    (Stdlib.String.join shown "\n") ++ footer



/// Present everything a branch changes vs its parent (+ new, ~ changed) -- the review-before-merge diff.
let branchDiff (branchId: Uuid) : String =
  match branchDiffLines branchId with
  | [] -> $"\"{branchName branchId}\" changes nothing vs its parent."
  | lines ->
    let n = Stdlib.Int.toString (Stdlib.List.length lines)
    let body = Stdlib.String.join lines "\n"
    $"\"{branchName branchId}\" changes {n} name(s) vs its parent:\n\n{body}"


/// Resolve a conflicted name on a branch: choice = "mine" (keep the branch's) or "theirs" (take parent's).
let resolveConflict
  (branchId: Uuid)
  (name: String)
  (choice: String)
  : Stdlib.Result.Result<String, String> =
  let resolved =
    match choice with
    | "mine" ->
      Branches.resolveKeepMine branchId name
      |> Stdlib.Result.map (fun _ ->
        $"kept the branch's {name} (it now wins on merge)")
    | "theirs" ->
      Branches.resolveTakeTheirs branchId name
      |> Stdlib.Result.map (fun _ ->
        $"took the parent's {name} (dropped the branch's binding)")
    | other ->
      Stdlib.Result.Result.Error
        $"unknown choice \"{other}\" -- use \"mine\" or \"theirs\""

  match resolved with
  | Ok kept ->
    // The branch by NAME: this line is read by a person, and the id is a uuid.
    Stdlib.Result.Result.Ok
      $"resolved {name} on \"{branchName branchId}\": {kept}."
  | Error e -> Stdlib.Result.Result.Error e


/// Archive (soft-delete) a branch, discarding its unmerged ops.
let archiveBranch (branchId: Uuid) : Stdlib.Result.Result<String, String> =
  // Read before the archive: afterwards the branch has no name to put in the message.
  let handle = branchName branchId

  // The event is authored only if the local archive actually happened. It travels, so recording one for
  // an archive that failed here archives the branch on every other machine and nowhere on this one.
  match Branches.archive branchId with
  | Error e -> Stdlib.Result.Result.Error e
  | Ok() ->
    // ...and say so in the log, so the machine your colleague is on stops showing it as live work. The
    // local projection is already updated by the line above; this is only how the OTHER machine learns.
    let eventId = Builtin.scmRecordBranchArchived branchId

    // And COMMIT that event, for the same reason a merge commits what it lands. A `BranchEvent` binds
    // no name, so `status` (which counts bindings) reads clean while `commit` (which counts ops) finds
    // one; left in main's draft it sits there until some unrelated commit sweeps it up under a message
    // about something else.
    //
    // Exactly this event, by id. Committing "whatever is uncommitted" would sweep up a half-written fn
    // that has nothing to do with archiving a branch.
    let _ =
      commitMainOps $"archived branch \"{handle}\"" "archive" [ Stdlib.Uuid.toString eventId ]

    Stdlib.Result.Result.Ok $"archived branch \"{handle}\"."


/// The id of the branch NAMED <param name>, starting it off <param parentId> if no live branch has that
/// name. `switch` uses this, so a branch started while on another branch is parented to it (branches off
/// branches). Returns (id, wasCreated).
let ensureBranch (name: String) (parentId: Uuid) : (Uuid * Bool) =
  resolveBranch name parentId

/// Store <param records> as ops on <param branchId>, registering the branch if this store has never
/// heard of it. Returns how many op rows were new.
///
/// The two callers are the two ways a branch's ops arrive from somebody else: a branch bundle
/// (`importBranch`) and a review queue (`Wire.reviewImportTo`). Both land ops inert and tagged, for
/// later merge or approval; neither folds anything.
///
/// <param parent> is TEXT rather than a Uuid on purpose. On the bundle path it arrives inside a peer's
/// JSON and may be anything at all, so the builtin parses it and treats what it cannot read as main.
/// A review queue's parent is main by construction and spells it out.
let stageOpsOnBranch
  (branchId: Uuid)
  (name: String)
  (parent: String)
  (records: List<(String * String * String)>)
  : Stdlib.Result.Result<Int, String> =
  Builtin.scmImportBranchOps branchId name parent records


// branch transfer (a branch as a portable unit)
// A branch bundle = its registry (id/name/parent) + its frontier ops. Name-bases are re-derived
// against the DESTINATION's main on import (the fork point that matters is the receiver's).


/// An op inside a branch bundle: no author, deliberately. A branch bundle is a file you hand someone, and
/// the conflict detector does not read authorship off it, so reusing `Wire.SyncOp` would attach a field nothing
/// here reads. Branch authorship, if wanted later, gets its own field and its own version bump.
type BranchBundleOp =
  { id: String
    blobHex: String
    ts: String
    /// The commit the op belongs to on the sender, or "" for an uncommitted one. Without it a pulled
    /// branch arrives wholly uncommitted and the puller's next `commit` sweeps the author's finished work
    /// into its own: the same op under a different commit on each machine.
    commit: String }


/// A commit row, as it travels with a branch bundle. Same fields as `Commits.Commit` minus the local
/// `createdAt`; the hash is the sender's and is kept, since it is derived from what the commit holds.
type BranchBundleCommit =
  { hash: String
    message: String
    author: String
    originTs: String
    parent: String }


type BranchBundle =
  { branchId: Uuid
    name: String
    parent: String
    ops: List<BranchBundleOp>
    commits: List<BranchBundleCommit> }


/// The commit rows behind a list of commit hashes ("" and duplicates dropped), in the shape both
/// bundles ship. What a sender attaches so the receiver can file ops under the author's commits.
let commitRowsFor (hashes: List<String>) : List<BranchBundleCommit> =
  let wanted = hashes |> Stdlib.List.filter (fun h -> h != "") |> Stdlib.List.unique

  if Stdlib.List.isEmpty wanted then
    []
  else
    Stdlib.Sqlite.rowsP
      (localDb ())
      "SELECT hash, message, author, origin_ts, COALESCE(parent, '') AS parent FROM commits
       WHERE hash IN (SELECT value FROM json_each(@p0))"
      [ Stdlib.Json.serialize<List<String>> wanted ]
      (fun row ->
        match
          (Stdlib.Sqlite.textField row "hash",
           Stdlib.Sqlite.textField row "message",
           Stdlib.Sqlite.textField row "author",
           Stdlib.Sqlite.textField row "origin_ts",
           Stdlib.Sqlite.textField row "parent")
        with
        | (Some hash, Some message, Some author, Some originTs, Some parent) ->
          Stdlib.Option.Option.Some(
            BranchBundleCommit
              { hash = hash
                message = message
                author = author
                originTs = originTs
                parent = parent }
          )
        | _ -> Stdlib.Option.Option.None)


/// Take on a sender's commits: the rows first, then each op stamped with its author's commit, but only
/// where <param onlyReplacing> currently stands ("" for an op with no commit yet). An op already
/// committed under something else keeps it: a branch pulled before its merge event arrives keeps the
/// branch's commits when the event lands.
let adoptCommitsWhere
  (onlyReplacing: String)
  (commits: List<BranchBundleCommit>)
  (opCommits: List<(String * String)>)
  : Unit =
  let stamps =
    opCommits
    |> Stdlib.List.filter (fun pair ->
      let (_, commit) = pair
      commit != "")
    |> Stdlib.List.map (fun pair ->
      let (id, commit) = pair
      [ commit, id, onlyReplacing ])

  if Stdlib.List.isEmpty commits && Stdlib.List.isEmpty stamps then
    ()
  else
    let _ =
      Stdlib.Sqlite.mustExecBatch
        (localDb ())
        [ ("INSERT OR IGNORE INTO commits (hash, message, author, origin_ts, parent)
            VALUES (@p0, @p1, @p2, @p3, @p4)",
           commits
           |> Stdlib.List.map (fun c -> [ c.hash, c.message, c.author, c.originTs, c.parent ]))
          ("UPDATE package_ops SET commit_hash = @p0
            WHERE id = @p1 AND COALESCE(commit_hash, '') = @p2",
           stamps) ]
    ()

/// <fn adoptCommitsWhere> for ops that have no commit here yet: a pulled branch, a relay storing a push.
let adoptCommits (commits: List<BranchBundleCommit>) (opCommits: List<(String * String)>) : Unit =
  adoptCommitsWhere "" commits opCommits

/// <fn adoptCommitsWhere> for ops an import just filed under <param importCommit>: they move to the
/// author's commit, and whatever the import committed on its own stays.
let adoptCommitsOver
  (importCommit: String)
  (commits: List<BranchBundleCommit>)
  (opCommits: List<(String * String)>)
  : Unit =
  adoptCommitsWhere importCommit commits opCommits


/// One column from the branches row for a branch (or a default).
let branchField (branchId: Uuid) (col: String) (dflt: String) : String =
  match
    Stdlib.Sqlite.queryP
      (localDb ())
      ("SELECT " ++ col ++ " AS v FROM branches WHERE id = @p0")
      [ Stdlib.Uuid.toString branchId ]
  with
  | Ok rows ->
    (match rows with
     | [ row ] -> Stdlib.Sqlite.textField row "v" |> Stdlib.Option.withDefault dflt
     | _ -> dflt)
  | Error _ -> dflt


/// The id of the `Add*` op that adds content <param hash> of <param kind> ("fn", "type", "value"). An
/// Add op is identified by what it adds, so the id follows from the two alone.
let contentOpId (kind: String) (hash: String) : Uuid = Builtin.scmContentOpId kind hash


/// Export a single branch as a portable bundle (registry + frontier ops, plus the content its names
/// point at).
///
/// A branch's frontier is its TAGGED ops, and an `Add` is tagged only when the branch was the first to
/// hold that content. A body main already had under another name is main's op, untagged; the branch
/// holds only the `SetName` naming it. The receiver may not hold that content (its main may be behind),
/// and a name pointing at content it does not have is "couldn't be found". So the bundle carries the Add
/// for every hash a frontier `SetName` binds, whether or not the branch was the one to add it; the
/// receiver ignores what it already has.
let exportBranch (branchId: Uuid) : String =
  let frontier =
    Wire.rowsToSyncOps (
      Stdlib.Sqlite.rowsOrEmptyP
        (localDb ())
        // `author` is borrowed to carry the commit hash through `rowsToSyncOps`; it moves to `commit`
        // below.
        "SELECT p.id, p.op_blob, p.origin_ts AS ts, COALESCE(p.commit_hash, '') AS author
         FROM package_ops p JOIN op_branches ob ON ob.op_id = p.id
         WHERE ob.branch_id = @p0 ORDER BY p.rowid ASC"
        [ Stdlib.Uuid.toString branchId ])

  let frontierIds = frontier |> Stdlib.List.map (fun o -> o.id)

  let contentIds =
    Branches.ownFrontierOps branchId
    |> Stdlib.List.filterMap (fun entry ->
      let (_, op) = entry

      match op with
      | SetName(_, target, _) ->
        let hash = LanguageTools.ProgramTypes.hashToString (LanguageTools.ProgramTypes.Reference.hash target)
        let kind = Deps.kindString (LanguageTools.ProgramTypes.Reference.kind target)
        Stdlib.Option.Option.Some(Stdlib.Uuid.toString (contentOpId kind hash))
      | _ -> Stdlib.Option.Option.None)
    |> Stdlib.List.filter (fun id -> Stdlib.Bool.not (Stdlib.List.``member`` frontierIds id))
    |> Stdlib.List.unique

  let content =
    if Stdlib.List.isEmpty contentIds then
      []
    else
      Wire.rowsToSyncOps (
        Stdlib.Sqlite.rowsOrEmptyP
          (localDb ())
          "SELECT p.id, p.op_blob, p.origin_ts AS ts FROM package_ops p
           WHERE p.id IN (SELECT value FROM json_each(@p0)) ORDER BY p.rowid ASC"
          [ Stdlib.Json.serialize<List<String>> contentIds ])

  // Content first, so a receiver folding in order has the body before the name. Borrowed content is
  // main's and travels uncommitted here; the receiver's main decides its commit, as for any content.
  let bundleOps =
    Stdlib.List.append
      (content
       |> Stdlib.List.map (fun o ->
         BranchBundleOp { id = o.id; blobHex = o.blobHex; ts = o.ts; commit = "" }))
      (frontier
       |> Stdlib.List.map (fun o ->
         BranchBundleOp { id = o.id; blobHex = o.blobHex; ts = o.ts; commit = o.author }))

  let commits = commitRowsFor (frontier |> Stdlib.List.map (fun o -> o.author))

  Stdlib.Json.serialize<BranchBundle> (
    BranchBundle
      { branchId = branchId
        name = branchField branchId "name" ""
        // The bundle is JSON, so the parent travels as text like every other field in it.
        parent = branchField branchId "parent_id" (Stdlib.Uuid.toString SCM.Branch.mainBranchId)
        ops = bundleOps
        commits = commits })


// relay branch storage (silo wrappers over the F# store; used by the matter relay)
let relayStoreBranch (owner: String) (branchId: Uuid) (bundle: String) : Unit =
  Branches.relayStoreBundle owner branchId bundle


let relayGetBranch (owner: String) (branchId: Uuid) : String =
  Branches.relayGetBundle owner branchId


let relayListBranches (owner: String) : String =
  Stdlib.String.join (Branches.relayListBranches owner) "\n"


/// `owner branch-id` per hosted bundle, one per line: the discovery listing `/branch/owners` serves.
let relayListAllBranches () : String =
  Branches.relayListOwners ()
  |> Stdlib.List.map (fun entry ->
    let (owner, _n) = entry

    Branches.relayListBranches owner
    |> Stdlib.List.map (fun bid -> $"{owner} {bid}"))
  |> Stdlib.List.flatten
  |> (fun lines -> Stdlib.String.join lines "\n")


/// The op ids a branch bundle CARRIES, without importing it.
///
/// What `branch pull` records as held by the relay's bundle channel: the ops that actually came
/// over the wire. The branch's own local ops are not in it, and recording those as sent is how a
/// local-only commit went missing from a colleague's pull.
let bundleOpIds (json: String) : List<String> =
  match Stdlib.Json.parse<BranchBundle> json with
  | Ok b -> b.ops |> Stdlib.List.map (fun op -> op.id)
  | Error _ -> []


/// Import a branch bundle: register + store its ops effective=0 + tag + re-base against local main.
let importBranch (json: String) : Stdlib.Result.Result<String, String> =
  match Stdlib.Json.parse<BranchBundle> json with
  | Ok b ->
    let records = b.ops |> Stdlib.List.map (fun op -> (op.id, op.blobHex, op.ts))

    // A name is an alias; the id is the identity. Two people can each start a `fix-auth` and both survive
    // (`branches` deliberately has no unique index on names), but `switch <name>` has to land on ONE of
    // them. A colliding import therefore keeps its own name plus a short id: unambiguous and switchable,
    // rather than silently answering for the other branch of the same name.
    let taken =
      SCM.Branches.list ()
      |> Stdlib.List.any (fun r -> r.name == b.name && r.id != b.branchId)

    let importName =
      if b.name != "" && taken then
        $"{b.name}~{Stdlib.String.first (Stdlib.Uuid.toString b.branchId) 8}"
      else
        b.name

    // A bundle for a branch this store has MERGED must not revive it, unless the peer kept working on it
    // and the bundle carries ops this store lacks. The builtin registers through `createBranch`, whose
    // upsert clears `merged_at`; that is right for a branch that is alive somewhere and wrong for one
    // that is finished here and merely re-sent.
    let knownHere =
      Stdlib.Sqlite.scalarIntP
        (localDb ())
        "SELECT count(*) AS n FROM package_ops WHERE id IN (SELECT value FROM json_each(@p0))"
        [ Stdlib.Json.serialize<List<String>> (b.ops |> Stdlib.List.map (fun op -> op.id)) ]
        "n"
      |> Stdlib.Option.withDefault 0L

    let nothingNew = (Stdlib.Int.fromInt64 knownHere) == (Stdlib.List.length b.ops)

    if (branchIsMerged b.branchId) && nothingNew then
      let handle = if importName == "" then Stdlib.Uuid.toString b.branchId else importName
      Stdlib.Result.Result.Ok
        $"branch \"{handle}\" is already merged here, and the bundle carries nothing new; left as merged."
    else

    // Known before this import? The message below tells a re-pull that found nothing apart from a
    // first pull whose ops happened to be here already (a retargeted bundle, say).
    let knownBranch = Stdlib.Option.isSome (SCM.Branch.get b.branchId)

    match stageOpsOnBranch b.branchId importName b.parent records with
    | Ok n ->
      // The sender's commits come with the ops, so a pulled branch shows the author's commits under the
      // author's messages, and the puller's next `commit` takes only the puller's own work. An op this
      // store already had committed keeps its commit.
      adoptCommits b.commits (b.ops |> Stdlib.List.map (fun op -> (op.id, op.commit)))

      // Falls back to the ID when the bundle carries no name. A branch CAN have an empty name -- one first
      // registered by authoring rather than by `switch` gets `""` -- and the hint below has to be typeable.
      let handle =
        if importName == "" then
          Stdlib.Uuid.toString b.branchId
        else
          importName

      // Say what happened, not what was asked. A pull that finds nothing new is the common case for
      // anything that polls (a sync loop runs this every half minute), and "imported branch X (0 ops)"
      // thirty times an hour is a log nobody reads.
      if n == 0 && knownBranch then
        Stdlib.Result.Result.Ok $"branch \"{handle}\" is up to date."
      else
        Stdlib.Result.Result.Ok
          $"imported branch \"{handle}\" ({Stdlib.Int.toString n} op(s)). `dark switch {handle}` to use it."
    | Error e -> Stdlib.Result.Result.Error e
  | Error _ -> Stdlib.Result.Result.Error "unparseable branch bundle"
