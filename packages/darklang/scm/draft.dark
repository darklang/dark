module Darklang.SCM.Draft

// The DRAFT, read once, for everyone who describes it.
//
// `dark status`, `dark status --json`, `dark commit`'s review and the workbench all describe the same picture
// reads: `draftBindings`, `propagatedNames`, `draftRepoints`, `Conflicts.pending`.
// This module owns that picture; callers add presentation on top but never repeat those reads.
//
// Deliberately NOT branch-parameterised. Every read resolves the branch through
// `SCM.PackageOps.currentBranch ()`, the process's branch -- a `branchId` parameter would invite callers to
// pass `AppState.currentBranchId`, which is a DIFFERENT value.

/// The current draft, as anything describing it needs to see it.
type Picture =
  { /// Every name the draft touches, in authoring order.
    bindings: List<Conflicts.Binding>
    /// Of those, the fully-qualified names whose CURRENT binding propagation wrote rather than a person.
    /// Held as the raw name list because that's the shape the membership test wants.
    propagated: List<String>
    /// The fully-qualified names the draft removes. Not bindings, so not in `bindings`.
    removed: List<String>
    /// What would repoint if you committed right now.
    repoints: List<PackageOps.Repoint>
    conflicts: List<Conflicts.Conflict>
    /// A COUNT, never a list. Constraints are a standing property of the STORE rather than of this draft,
    /// so a list here is something you learn to scroll past while a count points at a command.
    constraints: Int64
    ops: Int64 }


/// Read the whole picture. One call, five reads, and the only place they happen.
let read(unit: Unit): Picture =
  let bindings = PackageOps.draftBindings()
  let review = PackageOps.dependencyReview(bindings)
  // A review that fails repoints nothing; `pendingConstraints.blocked` says why.
  let (_, repoints) = review |> Stdlib.Result.withDefault(([], []))
  let pendingConstraints =
    Constraints.pendingWithOutdated(
      review |> Stdlib.Result.map(fun((stale, _)) -> Constraints.outdatedFindings(stale)))

  Picture
    { bindings = bindings
      removed = PackageOps.draftRemovals()
      propagated = PackageOps.propagatedNames()
      repoints = PackageOps.repointsFromReview(repoints)
      conflicts = Conflicts.pending()
      constraints = Stdlib.List.length(pendingConstraints.findings)
      ops = PackageOps.draftOpCount() }


/// Just the counts, for the hot path.
///
/// `dark status` runs on every invocation, so it deliberately does NOT build a `Picture`: it asks for a
/// count where a count will do, and skips dependency details.
type Counts =
  { changed: Int64
    followed: Int64
    removed: Int64
    repoints: Int64
    conflicts: Int64
    constraints: Int64
    /// How many of `constraints` touch a name this draft binds, as the usage or as the
    /// dependency. The rest stood before the draft did, and a count that lumps them together
    /// reads as "your edit broke N things" on a store where N were broken when you arrived.
    constraintsFromDraft: Int64
    ops: Int64 }


let counts(unit: Unit): Counts =
  let bindings = PackageOps.draftBindings()
  let review = PackageOps.dependencyReview(bindings)
  // A review that fails repoints nothing; `pendingConstraints.blocked` says why.
  let (_, repoints) = review |> Stdlib.Result.withDefault(([], []))
  let pendingConstraints =
    Constraints.pendingWithOutdated(
      review |> Stdlib.Result.map(fun((stale, _)) -> Constraints.outdatedFindings(stale)))

  let propagated = PackageOps.propagatedNames()
  let draftNames = bindings |> Stdlib.List.map(fun b -> Conflicts.fqn(b.owner, b.modules, b.name))
  let fromDraft =
    pendingConstraints.findings
    |> Stdlib.List.filter(fun f ->
      Stdlib.List.contains(draftNames, Constraints.fqnOf(f.dependency))
      || Stdlib.List.contains(draftNames, Constraints.fqnOf(f.usage)))

  Counts
    { changed = Stdlib.List.length(bindings)
      followed =
        bindings
        |> Stdlib.List.filter(fun b ->
          Stdlib.List.contains(propagated, Conflicts.fqn(b.owner, b.modules, b.name)))
        |> Stdlib.List.length
      removed = Stdlib.List.length(PackageOps.draftRemovals())
      repoints = Stdlib.List.length(repoints)
      conflicts = Conflicts.pendingCount()
      constraints = Stdlib.List.length(pendingConstraints.findings)
      constraintsFromDraft = Stdlib.List.length(fromDraft)
      ops = PackageOps.draftOpCount() }


/// Did PROPAGATION write this name's current binding, rather than a person?
///
/// The split the whole draft view turns on: an entry that followed your edit is otherwise indistinguishable
/// from one you made.
let followed(p: Picture, b: Conflicts.Binding): Bool =
  Stdlib.List.contains(p.propagated, Conflicts.fqn(b.owner, b.modules, b.name))


/// How many of the changed names followed something rather than being edited by you.
let followedCount(p: Picture): Int64 =
  p.bindings
  |> Stdlib.List.filter(fun b -> followed(p, b))
  |> Stdlib.List.length


/// How many you actually authored.
let authoredCount(p: Picture): Int64 =
  Stdlib.List.length(p.bindings) - followedCount(p)


/// Everything waiting on a person right now: divergences the fold settled and standing findings. One
/// number, because they're one question ("is anything waiting on me?").
let needsYouCount(p: Picture): Int64 =
  Stdlib.List.length(p.conflicts) + p.constraints


// Rewriting MAIN's draft: dropping ops you authored but have not committed. Each is one action in F#
// (`SCM.Actions.discard`): the draft is a rewritable head over an immutable tail, and a rewrite either
// deletes exactly the rows the dropped ops wrote and re-lists what they superseded. An op this build
// cannot decode is never deleted: what is skipped for reading must never be dropped for writing.

/// Drop the in-memory package caches, for a caller that knows the store moved under it.
let invalidateCaches(): Unit =
  Builtin.scmInvalidateCaches()


/// Drop main's draft entirely. Returns how many ops went.
let discardAll(): Result<Int64, String> =
  PackageOps.discardOn(Branch.mainBranchId, Actions.DiscardWhat.All)


/// Drop ONE name's uncommitted bindings from main's draft, leaving the rest alone. The content stays.
let discardName(owner: String, modules: List<String>, name: String): Result<Int64, String> =
  PackageOps.discardOn(
    Branch.mainBranchId,
    Actions.DiscardWhat.Name(
      LanguageTools.ProgramTypes.PackageLocation { owner = owner, modules = modules, name = name }))


/// Collapse main's draft's superseded NAMINGS: for each name keep the binding that wrote the row the
/// name has now, drop the earlier ones. Content stays, so a re-fold produces the same store.
let collapse(): Result<Int64, String> =
  PackageOps.discardOn(Branch.mainBranchId, Actions.DiscardWhat.Collapse)


/// The content hash a reference points at, as text.
let referenceHash(r: LanguageTools.ProgramTypes.Reference): String =
  LanguageTools.ProgramTypes.hashToString(LanguageTools.ProgramTypes.Reference.hash(r))
