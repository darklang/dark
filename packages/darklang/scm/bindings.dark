module Darklang.SCM.Bindings

// The `locations` data-access silo: which hash a branch binds at which name.
//
// Every case names the branch it asks about and answers as that branch SEES its names: its own work over
// what its ancestors committed, main's included. Main is a branch like any other. The reads go through one
// builtin, `scmBindings`, and the SQL lives with it in F# (`LibDB.ScmBindings`).


/// What `query` is asked. Names are spelled as the store spells them: modules joined by ".", and a kind as
/// `ItemKind.toString` writes it.
type BindingFilter =
  /// One name the branch binds this hash at, if any. Fills owner, modules, name.
  | LocationOf of branchId: Uuid * hash: String
  /// Every binding whose bare name is one of these, whatever its owner and modules.
  | ByBareNames of branchId: Uuid * names: List<String>
  /// What the branch binds at each (owner, modules, name); a name bound to nothing is absent.
  | At of branchId: Uuid * names: List<(String * String * String)>
  /// `At`, in the branch's committed view: its draft left out.
  | CommittedAt of branchId: Uuid * names: List<(String * String * String)>
  /// Every binding the branch's own work holds that propagation wrote. Fills owner, modules, name.
  | Propagated of branchId: Uuid
  /// Every hash this name was bound to by an op or by propagation, oldest first, live or not.
  | AuthoringOrder of branchId: Uuid * owner: String * modules: String * name: String
  /// Every hash ever bound at each (owner, modules, name, kind), removals left out, the live one first.
  | EverBound of branchId: Uuid * keys: List<(String * String * String * String)>
  /// Every name the branch binds this content at. Fills owner, modules, name.
  | ByHash of branchId: Uuid * hash: String * kind: String
  /// Every name the branch binds each of these hashes at. Fills owner, modules, name, hash.
  | ByHashes of branchId: Uuid * hashes: List<String>
  /// What the branch's own work last said about each name it touched; a removal has hash "".
  | Own of branchId: Uuid
  /// Every hash the branch and its ancestors below main bound by an op or by propagation, oldest
  /// first. Fills owner, modules, name, hash.
  | BranchHistory of branchId: Uuid
  /// What the branch sees beneath itself -- its ancestors' committed work -- at each name it recorded a
  /// base for. Fills owner, modules, name, hash ("" for nothing there).
  | AboveBases of branchId: Uuid


/// One binding. Which fields a filter fills is said on its case; the rest are ""
/// (or None).
type BindingRow =
  { owner: String
    modules: String
    name: String
    itemType: String
    hash: String
    /// The `origin_ts` of the op that bound it; "" when none was recorded.
    originTs: String
    /// The hash this binding replaced, when the op said.
    previous: Stdlib.Option.Option<String> }


/// The bindings <param f> asks for.
let query(f: BindingFilter): List<BindingRow> = Builtin.scmBindings(f)
