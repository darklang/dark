{
  "name": "Darklang",
  "scopeName": "source.darklang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.darklang", "match": "///.*$" },
        { "name": "comment.line.double-slash.darklang", "match": "//.*$" },
        { "name": "comment.block.darklang", "begin": "\\(\\*", "end": "\\*\\)" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.triple.darklang", "begin": "\\$?\"\"\"", "end": "\"\"\"" },
        {
          "name": "string.quoted.double.darklang",
          "begin": "\\$?\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.darklang", "match": "\\\\." },
            { "name": "meta.interpolation.darklang", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        { "name": "string.quoted.single.darklang", "match": "'(\\\\.|[^'\\\\])'" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.darklang",
          "match": "\\b(let|val|if|then|else|type|trait|impl|for|match|with|fun|when|as|module|test)\\b"
        },
        { "name": "constant.language.darklang", "match": "\\b(true|false)\\b" },
        { "name": "keyword.operator.darklang", "match": "\\|>|->|==|!=|<=|>=|&&|\\|\\||\\+\\+|\\.\\.\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.darklang",
          "match": "\\b[0-9][0-9_]*(\\.[0-9]+)?([eE][+-]?[0-9]+)?(u8|u16|u32|u64|u128|s8|s16|s32|s64|s128|z|dec|f32)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(let|val|test)\\s+([a-zA-Z_][a-zA-Z0-9_']*)",
          "captures": { "1": { "name": "keyword.control.darklang" }, "2": { "name": "entity.name.function.darklang" } }
        }
      ]
    },
    "types": {
      "patterns": [{ "name": "entity.name.type.darklang", "match": "\\b[A-Z][a-zA-Z0-9_]*\\b" }]
    },
    "calls": {
      "patterns": [{ "name": "entity.name.function.call.darklang", "match": "\\b[a-z_][a-zA-Z0-9_']*(?=\\()" }]
    }
  }
}
