{
  "name": "dark-builder",

  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },

  // Set *default* container specific settings.json values on container create.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "FSharp.dotNetRoot": "/usr/share/dotnet",
        "FSharp.useSdkScripts": true,
        "FSharp.workspaceModePeekDeepLevel": 5,
        "FSharp.workspacePath": "/home/dark/app/backend/fsdark.sln",
        "remote.containers.cacheVolume": true,
        "remote.containers.workspaceMountConsistency": "delegated",
        "editor.tabSize": 2,
        "files.trimTrailingWhitespace": true,
        "python.formatting.provider": "yapf"
      },

      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "ionide.ionide-fsharp",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "editorconfig.editorconfig"
      ]
    }
  },

  "postCreateCommand": "cd ${containerWorkspaceFolder} && ./scripts/package-extension.sh",

  /////////////////////////////////////////////////
  // From here down, the contents are supposed to represent the exact same
  // as we see in script/builder
  /////////////////////////////////////////////////

  // Ports: 9090-9099 are for reserved to expose ad-hoc `darklang serve` usages.
  "forwardPorts": [9090, 9091, 9092, 9093, 9094, 9095, 9096, 9097, 9098, 9099],

  "containerEnv": {
    "IN_DEV_CONTAINER": "true"
  },

  "runArgs": [
    "--dns",
    "8.8.8.8",
    "--dns",
    "8.8.4.4",
    "--ulimit=nofile=1048576:1048576",
    // Host side is a per-clone block so two clones don't fight over it; scripts/dev/start
    // picks a free one. Container side is 9090-9099 everywhere. Published rather than left
    // to forwardPorts, which only runs when VS Code manages the container.
    "--publish=${localEnv:DARK_PORTS:9090-9099}:9090-9099",
    "--env",
    "DARK_HOST_PORT_BASE=${localEnv:DARK_HOST_PORT_BASE:9090}",
    // `DARK_DEV_WATCH=true scripts/dev/start` gets rebuild-on-save back for the life
    // of the container, without a diff to a tracked file.
    "--env",
    "DARK_DEV_WATCH=${localEnv:DARK_DEV_WATCH:false}",
    "--hostname",
    "dark-dev",
    "--env-file",
    "config/dev",
    // "--env-file",
    // "config/local",
    "--env",
    "HOST_PWD=${localWorkspaceFolder}",
    "--security-opt",
    "seccomp=unconfined",
    "--label",
    "dark-dev-container",
    "--workdir",
    "/home/dark/app"
  ],

  "workspaceMount": "source=${localWorkspaceFolder},target=/home/dark/app,type=bind,consistency=delegated", // for local
  // If using a remote DOCKER_HOST, you need to mount a directory on the remote host
  // "workspaceMount": "source=/home/paulbiggar/projects/dark,target=/home/dark/app,type=bind,consistency=delegated",
  "workspaceFolder": "/home/dark/app",

  "mounts": [
    // Docker-in-Docker - uncomment this to be able to build Dark's production containers
    // "type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock",

    // Bash history - uncomment this to save bash history between container restarts
    // "type=bind,src=${localEnv:HOME}${localEnv:USERPROFILE}/.dark_bash_history,dst=/home/dark/.bash_history,consistency=cached",
    // If using a remote DOCKER_HOST, you need to mount a directory on the remote host instead
    // "type=bind,src=/home/paulbiggar/.dark_bash_history,dst=/home/dark/.bash_history,consistency=cached",

    // One checkout's compiled output, so it's keyed per clone: sharing it lets divergent
    // branches overwrite each other's binaries. A volume rather than the bind mount,
    // because bind-mounted build dirs sync to the host and make compiles crawl on macOS.
    "type=volume,src=dark_build_${localWorkspaceFolderBasename},dst=/home/dark/app/backend/Build",

    // Shared on purpose: a package cache, not the state of any one clone.
    "type=volume,src=dark_nuget,dst=/home/dark/.nuget",

    // VS Code extensions
    "type=volume,src=darklang-dark-extension-volume,dst=/home/dark/.vscode-server/extensions",
    "type=volume,src=darklang-dark-extension-volume-insiders,dst=/home/dark/.vscode-server-insiders/extensions"
  ],

  // See https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "dark",
  "containerUser": "dark",
  "updateRemoteUserUID": true,

  // Set the container up and build once, so it's usable on arrival. No file watcher:
  // rebuilding on save is opt-in now (scripts/dev/watch).
  "postStartCommand": "./scripts/devcontainer/_post-start",

  // Where the build stands, then the watcher's live log if you've opted into it.
  // Never an unconditional `tail -F`: postAttach that doesn't return hangs the attach.
  "postAttachCommand": "./scripts/dev/_post-attach"
}
