<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org is the only source, and source mapping sends every package to it, so a
       package can never come from a feed configured elsewhere on the machine. Paket reads
       its own source from paket.dependencies; this covers what NuGet fetches itself, such
       as the SDK packs a publish needs. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
