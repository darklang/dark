<Project>
  <!-- Per-project outputs avoid concurrent builds racing on one native file.
       Windows/browser use managed host operations and need no syscall transport. -->
  <PropertyGroup>
    <DarkKernelRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</DarkKernelRid>
    <DarkKernelRid Condition="'$(DarkKernelRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</DarkKernelRid>
    <DarkKernelEnabled Condition="$([System.String]::Copy('$(DarkKernelRid)').StartsWith('linux-')) Or $([System.String]::Copy('$(DarkKernelRid)').StartsWith('osx-'))">true</DarkKernelEnabled>
    <DarkKernelDirectory>$(DarkBuildDir)/native/$(MSBuildProjectName)/$(DarkKernelRid)</DarkKernelDirectory>
    <DarkKernelExtension Condition="$([System.String]::Copy('$(DarkKernelRid)').StartsWith('osx-'))">dylib</DarkKernelExtension>
    <DarkKernelExtension Condition="'$(DarkKernelExtension)' == ''">so</DarkKernelExtension>
    <DarkKernelLibrary>$(DarkKernelDirectory)/libdark_syscalls.$(DarkKernelExtension)</DarkKernelLibrary>
  </PropertyGroup>
  <!-- Exe only. This `None` item flows along project references, so an executable
       collected one copy per reference and a single-file publish refused the
       duplicate BundleRelativePath. P/Invoke looks beside the executable, so its
       own copy is the only one that was ever used. -->
  <ItemGroup Condition="'$(DarkKernelEnabled)' == 'true' And '$(PublishAot)' != 'true' And '$(OutputType)' == 'Exe'">
    <None Include="$(DarkKernelLibrary)" Link="libdark_syscalls.$(DarkKernelExtension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DarkKernelEnabled)' == 'true' And '$(PublishAot)' == 'true'">
    <DirectPInvoke Include="dark_syscalls" />
    <NativeLibrary Include="$(DarkKernelDirectory)/libdark_syscalls.a" />
  </ItemGroup>
  <Target Name="BuildDarkKernel" BeforeTargets="PrepareForBuild" Condition="'$(DarkKernelEnabled)' == 'true'" Inputs="$(MSBuildThisFileDirectory)native/syscalls.c;$(MSBuildThisFileDirectory)native/build.sh" Outputs="$(DarkKernelLibrary);$(DarkKernelDirectory)/libdark_syscalls.a">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)native/build.sh&quot; &quot;$(DarkKernelDirectory)&quot; &quot;$(DarkKernelRid)&quot;" />
  </Target>
  <!-- Stable reference-assembly MVIDs, so an edit inside a function body recompiles only its
       own project. Delete this UsingTask and the target below once
       https://github.com/dotnet/fsharp/issues/19751 is fixed.

       fsc gives each reference assembly a new random MVID on every compile, even from the same
       source. CopyRefAssembly compares MVIDs to decide whether the API changed, so every compile
       looked like one and every project above it recompiled. This sets the MVID, and the PE
       timestamp, from a hash of the rest of the file: the same API gets the same MVID, and a real
       API change still gets a new one. Debug only: a release build starts clean, so it has nothing
       to skip, and what ships stays exactly what fsc wrote. -->
  <UsingTask TaskName="DarkStableRefMvid" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Assembly ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Read by hand: inline tasks compile against netstandard, which has no System.Reflection.Metadata.
        var b = File.ReadAllBytes(Assembly);
        Func<int, int> u16 = o => BitConverter.ToUInt16(b, o);
        Func<int, int> i32 = o => BitConverter.ToInt32(b, o);
        var coff = i32(0x3c) + 4;
        var sections = u16(coff + 2);
        var stamp = coff + 4;
        var opt = coff + 20;
        var dataDirs = opt + (u16(opt) == 0x10b ? 96 : 112);
        Func<int, int> fileOffset = rva => {
          for (var k = 0; k < sections; k++) {
            var sec = opt + u16(coff + 16) + 40 * k;
            var va = i32(sec + 12);
            if (va <= rva && rva < va + Math.Max(i32(sec + 8), i32(sec + 16)))
              return rva - va + i32(sec + 20);
          }
          throw new Exception($"{Assembly}: RVA {rva} is in no section");
        };
        var cliHeader = fileOffset(i32(dataDirs + 14 * 8));
        var metadata = fileOffset(i32(cliHeader + 8));
        var q = metadata + 16 + i32(metadata + 12) + 2;
        var streams = u16(q);
        q += 2;
        var guidHeap = -1;
        for (var k = 0; k < streams; k++) {
          var heapOffset = i32(q);
          q += 8;
          var end = Array.IndexOf(b, (byte)0, q);
          if (System.Text.Encoding.ASCII.GetString(b, q, end - q) == "#GUID") guidHeap = metadata + heapOffset;
          q = (end + 4) & ~3;
        }
        if (guidHeap < 0) throw new Exception($"{Assembly}: no #GUID heap");
        // The MVID is the first GUID; it appears again as the PDB id in the debug directory.
        var mvid = new byte[16];
        Array.Copy(b, guidHeap, mvid, 0, 16);
        var spots = new List<int>();
        for (var i = 0; i <= b.Length - 16; i++) {
          var j = 0;
          while (j < 16 && b[i + j] == mvid[j]) j++;
          if (j == 16) { spots.Add(i); i += 15; }
        }
        var updated = (byte[])b.Clone();
        foreach (var s in spots) Array.Clear(updated, s, 16);
        Array.Clear(updated, stamp, 4);
        byte[] hash;
        using (var sha = SHA256.Create()) hash = sha.ComputeHash(updated);
        foreach (var s in spots) Array.Copy(hash, 0, updated, s, 16);
        Array.Copy(hash, 16, updated, stamp, 4);
        var changed = false;
        for (var i = 0; i < b.Length && !changed; i++) changed = b[i] != updated[i];
        if (changed) File.WriteAllBytes(Assembly, updated);
      ]]></Code>
    </Task>
  </UsingTask>
  <!-- Inputs/Outputs, so a build that compiled nothing never loads the task: compiling it costs a
       few seconds in every MSBuild process that does. -->
  <Target Name="DarkStableRefMvid" AfterTargets="CoreCompile" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Debug' And '@(IntermediateRefAssembly)' != '' And Exists('@(IntermediateRefAssembly)')"
          Inputs="@(IntermediateRefAssembly)" Outputs="$(IntermediateOutputPath)DarkStableRefMvid.done">
    <DarkStableRefMvid Assembly="@(IntermediateRefAssembly->'%(FullPath)')" />
    <Touch Files="$(IntermediateOutputPath)DarkStableRefMvid.done" AlwaysCreate="true" />
  </Target>
</Project>
