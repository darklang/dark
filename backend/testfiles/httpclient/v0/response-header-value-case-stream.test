[expected-request]
GET PATH HTTP/1.1
Host: HOST
Accept-Encoding: gzip
Accept-Encoding: br
Content-Length: 0

[response]
HTTP/1.1 200 OK
Date: xxx, xx xxx xxxx xx:xx:xx xxx
Content-type: text/plain; charset=utf-8
Content-Length: LENGTH
ETag: "AbC123"

Hello back

[test]
// Same as response-header-value-case, on the streaming path.
(let response = (Darklang.Stdlib.HttpClient.stream("get", "http://URL", [], Stdlib.Bytes.empty)) |> Builtin.unwrap
 let etags = Darklang.Stdlib.HttpClient.Response.headers(response, "etag")
 let body = response.body |> Darklang.Stdlib.Stream.toBytes |> Darklang.Stdlib.Utf8.decode |> Builtin.unwrap
 (etags, body)) ==
   ([ "\"AbC123\"" ], "Hello back")
