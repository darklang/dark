[expected-request]
PUT PATH HTTP/1.1
Host: HOST
Accept-Encoding: gzip
Accept-Encoding: br
Content-Type: application/json; charset=utf-8
Content-Length: 6

string
[response]
HTTP/1.1 200 OK
Date: xxx, xx xxx xxxx xx:xx:xx xxx
Content-type: text/plain; charset=utf-8
Content-Length: LENGTH

Hello back

[test]
(let reqHeaders = [("content-type", "application/json; charset=utf-8")]
 let response = (Darklang.Stdlib.HttpClient.request("put", "http://URL", reqHeaders, "string" |> Darklang.Stdlib.Utf8.encode) |> Builtin.unwrap)
 let respHeaders = (response.headers |> Darklang.Stdlib.List.filter(fun h -> (Darklang.Stdlib.Tuple2.first(h)) != "Date"))
 {response with headers = respHeaders}) ==
   Darklang.Stdlib.HttpClient.Response
    { statusCode = Darklang.Stdlib.Http.Status.ok
      url = "http://URL"
      headers = [
          ("Server", "kestrel")
          ("Content-Length", "LENGTH")
          ("Content-Type", "text/plain; charset=utf-8")
      ]
      body = ("Hello back" |> Darklang.Stdlib.Utf8.encode) }