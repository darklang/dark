[expected-request]
GET PATH HTTP/1.1
Host: HOST
Content-Length: 0

[response]
HTTP/1.1 200 OK
Date: xxx, xx xxx xxxx xx:xx:xx xxx
Content-type: text/plain; charset=utf-8
Content-Length: LENGTH

Hello back

[test]
(let reqHeaders = [("Content-Type", "just an invalid string")]
 Darklang.Stdlib.HttpClient.request("get", "http://URL", reqHeaders, Darklang.Stdlib.Bytes.empty)) ==
   Darklang.Stdlib.Result.Result.Error(
     Darklang.Stdlib.HttpClient.RequestError.BadHeader(
       Darklang.Stdlib.HttpClient.BadHeader.InvalidContentType))
