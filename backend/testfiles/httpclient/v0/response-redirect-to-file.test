[expected-request]
GET PATH HTTP/1.1
Host: HOST
Content-Length: 0

[response]
HTTP/1.1 301 Moved Permanently
Date: xxx, xx xxx xxxx xx:xx:xx xxx
Location: file:////etc/passwd


[test]
// Followed, to a scheme the host refuses: no file is read.
Darklang.Stdlib.HttpClient.request("get", "http://URL", [], Stdlib.Bytes.empty) ==
  Stdlib.Result.Result.Error(
    Darklang.Stdlib.HttpClient.RequestError.BadUrl(
      Darklang.Stdlib.HttpClient.BadUrlDetails.UnsupportedProtocol))
