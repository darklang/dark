// Traits: a trait and an impl are package items of their own kinds; an impl's
// method fns are ordinary fns under it, found at runtime by the self type; bounds
// (`'a: Show`) are checked when a fn is entered.

module Shapes =
  type Point = { x: Int; y: Int }

  trait Show<'a> =
    let show (value: 'a) : String

  impl Show for Point =
    let show (p: Point) : String =
      $"({Stdlib.toString p.x}, {Stdlib.toString p.y})"

  impl Show for Int =
    let show (n: Int) : String = Stdlib.toString n

  impl Show for Bool =
    let show (b: Bool) : String = if b then "yes" else "no"

  impl<'a: Show> Show for List<'a> =
    let show (xs: List<'a>) : String =
      "[" + (xs |> Stdlib.List.map (fun x -> Show.show x) |> Stdlib.String.join ", ") + "]"

  let display<'a: Show> (v: 'a) : String = "value: " + Show.show v

  let neverCalls<'a: Show> (v: 'a) : String = if false then Show.show v else "never"

  // The impl's method is an ordinary fn under <Type>.<Trait>
  Shapes.Point.Show.show (Shapes.Point { x = 1; y = 2 }) = "(1, 2)"

  // The impl is its own item, named `Shapes.Point.Show`; its methods are the fns beneath it

  // Dispatch by the argument's type
  Shapes.Show.show (Shapes.Point { x = 5; y = 6 }) = "(5, 6)"
  Shapes.Show.show 7 = "7"
  Shapes.Show.show true = "yes"

  // Inside a bounded generic fn
  Shapes.display (Shapes.Point { x = 1; y = 2 }) = "value: (1, 2)"
  Shapes.display 5 = "value: 5"

  // Conditional impls dispatch on the head, then on the elements lazily
  Shapes.display [ 1, 2, 3 ] = "value: [1, 2, 3]"
  Shapes.Show.show [ [ true ], [] ] = "[[yes], []]"
  Shapes.display [ Shapes.Point { x = 1; y = 2 } ] = "value: [(1, 2)]"

  // As a function value, and piped
  ([ 1, 2 ] |> Stdlib.List.map Shapes.Show.show) = [ "1", "2" ]
  ((Shapes.Point { x = 7; y = 8 }) |> Shapes.Show.show) = "(7, 8)"

  // Receiver calls: `x.method` is the whole call for a one-argument method
  (Shapes.Point { x = 1; y = 2 }).show = "(1, 2)"
  (9).show = "9"

  // A real field always wins over a method of the same name
  (Shapes.Point { x = 1; y = 2 }).x = 1

  // No impl: at the method call for a direct call
  Shapes.Show.show 3.5 = error "Float has no implementation of Shapes.Show. Write `impl Show for Float = ...`, or run `dark impls Show` to see which types do"

  // No impl: at the CALL of a bounded fn, before its body runs
  Shapes.neverCalls 3.5 = error "Float has no implementation of Shapes.Show. Write `impl Show for Float = ...`, or run `dark impls Show` to see which types do"
  Shapes.neverCalls 5 = "never"


module Multi =
  type Vec = { dx: Int; dy: Int }

  // The operators are the stdlib traits: `+` is `Stdlib.Add.add`. A user impl
  // makes `Vec + Vec` an ordinary expression.
  impl Stdlib.Add for Vec =
    let add (a: Vec) (b: Vec) : Vec = Vec { dx = a.dx + b.dx; dy = a.dy + b.dy }

  let sum<'a: Stdlib.Add> (a: 'a) (b: 'a) (c: 'a) : 'a = a + b + c

  Multi.Vec { dx = 1; dy = 2 } + Multi.Vec { dx = 10; dy = 20 } = Multi.Vec { dx = 11; dy = 22 }
  Stdlib.Add.add (Multi.Vec { dx = 1; dy = 2 }) (Multi.Vec { dx = 10; dy = 20 }) = Multi.Vec { dx = 11; dy = 22 }
  Multi.sum 1 2 3 = 6
  Multi.sum 1.5 2.5 3.0 = 7.0
  Multi.sum (Multi.Vec { dx = 1; dy = 1 }) (Multi.Vec { dx = 2; dy = 2 }) (Multi.Vec { dx = 3; dy = 3 }) = Multi.Vec { dx = 6; dy = 6 }
  Multi.sum "a" "b" "c" = "abc"
  Multi.sum true false true = error "Bool has no implementation of Darklang.Stdlib.Add. Write `impl Add for Bool = ...`, or run `dark impls Add` to see which types do"

  // Worth knowing: a trait declared here with the same shape as `Stdlib.Add`
  // IS `Stdlib.Add` (content addressing), so `impl Add for Int` next to it
  // would be a second impl for Int and every `1 + 2` an ambiguity.

  // Receiver call on a two-argument method is a partial application
  ((Multi.Vec { dx = 1; dy = 2 }).add (Multi.Vec { dx = 1; dy = 1 })) = Multi.Vec { dx = 2; dy = 3 }
  (Multi.Vec { dx = 1; dy = 2 }).add (Multi.Vec { dx = 1; dy = 1 }) = Multi.Vec { dx = 2; dy = 3 }


module Ambiguity =
  // Two traits with the same method name. Their SHAPES differ (Describe has a
  // second method): a trait is content-addressed, so two identically shaped
  // traits are one trait, however they are named.
  trait Describe<'a> =
    let describe (v: 'a) : String
    let short (v: 'a) : String

  trait Label<'a> =
    let describe (v: 'a) : String

  impl Describe for Int =
    let describe (n: Int) : String = "described"
    let short (n: Int) : String = "d"

  impl Label for Int =
    let describe (n: Int) : String = "labelled"

  // Naming the trait disambiguates
  Ambiguity.Describe.describe 1 = "described"
  Ambiguity.Label.describe 1 = "labelled"

  // A receiver call cannot pick between two traits with the same method name
  (1).describe = error "Int has more than one `describe`: 2 traits declare it. Say which one you mean, as `SomeTrait.describe value`"


module MethodBounds =
  // A method may declare its own type params and bounds, on top of the trait's bound on the
  // self type. They are discharged where the method is CALLED, since a method has no body of
  // its own to check them in.
  type Box = { n: Int64 }

  trait Pair<'a> =
    let pair<'b: Stdlib.Compare> (v: 'a) (w: 'b) (x: 'b) : Bool

  impl Pair for Box =
    let pair<'b: Stdlib.Compare> (v: Box) (w: 'b) (x: 'b) : Bool = w < x

  // Two values rather than one compared with itself, and both polarities asserted. `w < w` is
  // false for any total ordering, for a swapped argument order and for a constant `false`, so a
  // test built on it passes whether or not the bound is discharged against the right trait. These
  // four cannot: a swap turns the first two red, and no constant satisfies both.
  MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) 1L 2L = true
  MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) 2L 1L = false
  MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) "a" "b" = true
  MethodBounds.Pair.pair (MethodBounds.Box { n = 1L }) true true = error "Bool has no implementation of Darklang.Stdlib.Compare. Write `impl Compare for Bool = ...`, or run `dark impls Compare` to see which types do"

  // A METHOD's own bound is owed against ITS trait, not the enclosing one. `Bool` has no
  // `Compare`, and the error says `Compare`: if the method's bound were discharged against
  // the trait it is declared in, this would ask for a `Pair` impl for Bool instead.


module SortOrder =
  // `List.sort` orders a type that has its own `Compare` the way `<` does. This one's order is
  // the reverse of its structural order, and the tag is ignored by `Compare`.
  type Desc = { descKey: Int64; descTag: String }

  impl Compare for Desc =
    let lessThan (a: Desc) (b: Desc) : Bool = a.descKey > b.descKey
    let lessThanOrEqualTo (a: Desc) (b: Desc) : Bool = a.descKey >= b.descKey
    let greaterThan (a: Desc) (b: Desc) : Bool = a.descKey < b.descKey
    let greaterThanOrEqualTo (a: Desc) (b: Desc) : Bool = a.descKey <= b.descKey

  (SortOrder.Desc { descKey = 1L; descTag = "" } < SortOrder.Desc { descKey = 2L; descTag = "" }) = false

  Stdlib.List.sort [ SortOrder.Desc { descKey = 1L; descTag = "" }, SortOrder.Desc { descKey = 3L; descTag = "" }, SortOrder.Desc { descKey = 2L; descTag = "" } ] = [ SortOrder.Desc { descKey = 3L; descTag = "" }, SortOrder.Desc { descKey = 2L; descTag = "" }, SortOrder.Desc { descKey = 1L; descTag = "" } ]

  // Stable: values equal under `Compare` keep the order they came in, whatever their structure.
  Stdlib.List.sort [ SortOrder.Desc { descKey = 1L; descTag = "b" }, SortOrder.Desc { descKey = 2L; descTag = "x" }, SortOrder.Desc { descKey = 1L; descTag = "a" } ] = [ SortOrder.Desc { descKey = 2L; descTag = "x" }, SortOrder.Desc { descKey = 1L; descTag = "b" }, SortOrder.Desc { descKey = 1L; descTag = "a" } ]

  // A type with no `Compare` of its own sorts structurally, as before.
  type Plain = { plainKey: Int64 }
  Stdlib.List.sort [ SortOrder.Plain { plainKey = 2L }, SortOrder.Plain { plainKey = 1L } ] = [ SortOrder.Plain { plainKey = 1L }, SortOrder.Plain { plainKey = 2L } ]



module Equality =
  // `==` is NOT a trait: equality is structural, for every value, always. A type cannot
  // say what equal means for it, which is what keeps `List.member`, `List.unique`,
  // `List.sort` and dict keys meaning the same thing as `==`.
  type User = { id: Int64; name: String }
  type Holder = { user: User }

  // Every field counts, including the one a custom equality would have ignored.
  Equality.User { id = 1L; name = "a" } == Equality.User { id = 1L; name = "a" } = true
  Equality.User { id = 1L; name = "a" } == Equality.User { id = 1L; name = "b" } = false
  Equality.User { id = 1L; name = "a" } != Equality.User { id = 1L; name = "b" } = true

  1 == 1 = true
  1 != 1 = false
  "a" == "a" = true
  [ 1, 2 ] == [ 1, 2 ] = true
  Stdlib.Option.Option.Some 1 == Stdlib.Option.Option.Some 1 = true
  1 == "a" = error "Cannot perform equality check on Int and String"

  // Containers compare element by element, structurally, and agree with the elements.
  [ Equality.User { id = 1L; name = "a" } ] == [ Equality.User { id = 1L; name = "a" } ] = true
  [ Equality.User { id = 1L; name = "a" } ] == [ Equality.User { id = 1L; name = "b" } ] = false
  [ Equality.User { id = 1L; name = "a" } ] != [ Equality.User { id = 1L; name = "b" } ] = true
  // lengths first
  [ Equality.User { id = 1L; name = "a" } ] == [] = false

  // the same one level down: a tuple slot, a dict value, an Option payload, a record field
  (1L, Equality.User { id = 1L; name = "a" }) == (1L, Equality.User { id = 1L; name = "a" }) = true
  (1L, Equality.User { id = 1L; name = "a" }) == (1L, Equality.User { id = 1L; name = "b" }) = false
  (Stdlib.Dict.fromListOverwritingDuplicates [ ("k", Equality.User { id = 1L; name = "a" }) ]) == (Stdlib.Dict.fromListOverwritingDuplicates [ ("k", Equality.User { id = 1L; name = "a" }) ]) = true
  Stdlib.Option.Option.Some(Equality.User { id = 1L; name = "a" }) == Stdlib.Option.Option.None = false
  [ [ Equality.User { id = 1L; name = "a" } ] ] == [ [ Equality.User { id = 1L; name = "b" } ] ] = false
  Equality.Holder { user = Equality.User { id = 1L; name = "a" } } == Equality.Holder { user = Equality.User { id = 1L; name = "a" } } = true
  Equality.Holder { user = Equality.User { id = 1L; name = "a" } } == Equality.Holder { user = Equality.User { id = 1L; name = "b" } } = false

  // a list of builtin values, unchanged throughout
  [ 1L, 2L ] == [ 1L, 2L ] = true
  [ 1L, 2L ] == [ 1L, 3L ] = false
  [] == [] = true


module Identities =
  // `Zero`/`One` dispatch from an explicit type arg or a caller's bound: there is
  // no argument to read the type from.
  Stdlib.Zero.zero<Int64> () = 0L
  Stdlib.One.one<Float> () = 1.0
  Stdlib.Zero.zero () = error "Zero.zero has no argument to read a type from, so it cannot tell which type you mean. Name it: `Zero.zero<Int64> ...`"

  let zeroOf<'a: Stdlib.Zero + Stdlib.Add> (x: 'a) : 'a = Stdlib.Zero.zero () + x
  Identities.zeroOf 5L = 5L
  Identities.zeroOf 2.5 = 2.5

  // `sum` and `product` take a seed, so `[]` never has to ask
  Stdlib.sum 0L [ 1L, 2L, 3L ] = 6L
  Stdlib.sum 0.0 [] = 0.0
  Stdlib.product 1 [ 2, 3, 4 ] = 24
  Stdlib.sum (Multi.Vec { dx = 0; dy = 0 }) [ Multi.Vec { dx = 1; dy = 2 }, Multi.Vec { dx = 3; dy = 4 } ] = Multi.Vec { dx = 4; dy = 6 }


module Rendering =
  // `ToString` is the trait behind every builtin type's `toString`
  type Point = { x: Int64; y: Int64 }

  impl Stdlib.ToString for Point =
    let toString (p: Point) : String = $"({Stdlib.toString p.x}, {Stdlib.toString p.y})"

  (Rendering.Point { x = 1L; y = 2L }).toString = "(1, 2)"
  Stdlib.toString (Rendering.Point { x = 1L; y = 2L }) = "(1, 2)"
  Stdlib.toString 42L = "42"
  Stdlib.toString true = "true"
  Stdlib.toString 2.5 = "2.5"
  (7).toString = "7"
  Stdlib.max 3L 9L = 9L
  // String, Char and DateTime implement Compare, so the generics cover them too
  Stdlib.min "apple" "banana" = "apple"
  Stdlib.max 'a' 'z' = 'z'
  // A type with no Compare implementation is what the bound refuses
  Stdlib.min true false = error "Bool has no implementation of Darklang.Stdlib.Compare. Write `impl Compare for Bool = ...`, or run `dark impls Compare` to see which types do"
  Stdlib.clamp 15 20 10 = 15
  // `abs` needs three traits at once: compare, negate, and a zero to compare against
  Stdlib.abs -5L = 5L
  Stdlib.abs 2.5 = 2.5
  Stdlib.abs 0 = 0
  // an unsigned type has no Negate implementation, so it has no abs either
  Stdlib.abs 5uy = error "UInt8 has no implementation of Darklang.Stdlib.Negate. Write `impl Negate for UInt8 = ...`, or run `dark impls Negate` to see which types do"
