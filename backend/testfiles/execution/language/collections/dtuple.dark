(1L, 2L) = (1L, 2L)
(1L, 2L, 3L) = (1L, 2L, 3L)
(1L, 2L + 3L, 4L) = (1L, 5L, 4L)

// note: there is no upper limit set on Tuple size
(1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L) =
  (1L, 2L, 3L, 4L, 5L, 6L, 7L, 8L, 9L)

(1L, Builtin.testRuntimeError "test", 3L) = error="Uncaught exception: test"

(1L, Builtin.testRuntimeError "error1", Builtin.testRuntimeError "error2") = error="Uncaught exception: error1"

// Tuple indices start at 1.
(1L, "two").1 = 1L
(1L, "two").2 = "two"
(1L, 2L, 3L, 4L).4 = 4L
(let t = (true, 'c', 3L) in t.3) = 3L
(let t = ((1L, 2L), 3L) in t.1.2) = 2L
(let t = ((1L, (2L, 3L)), 4L) in t.1.2.1) = 2L
(let t = (1L, 2L) in t.1 + t.2) = 3L
(let t = (1L, 2L) in Stdlib.Int64.add t.1 t.2) = 3L
(let t = (1L, 2L) in t.3) = error="Tried to access element .3 of a tuple with 2 elements; tuple elements are numbered from .1"
(let t = (1L, 2L) in t.0) = error="Tried to access element .0 of a tuple with 2 elements; tuple elements are numbered from .1"
(let t = (1L, 2L) in t.name) = error="Tried to access element .name of a tuple with 2 elements; tuple elements are numbered from .1"
(let x = 6L in x.1) = error="Attempting to perform field access of an Int64, but this only works with records and tuples"
(1L, 2L) .1 = 1L
(let t = (1L, (2L, 3L)) in t.2.2 |> Stdlib.Int64.add 10L) = 13L
(let t = (1L, 2L) in $"{Stdlib.toString t.1}-{Stdlib.toString t.2}") = "1-2"
(Stdlib.List.map [ (1L, "a"), (2L, "b") ] (fun p -> p.2)) = [ "a", "b" ]
(let first = fun t -> t.1 in (first (1L, "a"), first ("b", 2L, true))) = (1L, "b")
(let t = (1L, 2L) in t.01) = error="Tried to access element .01 of a tuple with 2 elements; tuple elements are numbered from .1"
(let t = (1L, 2L) in t.99999999999999999999) = error="Tried to access element .99999999999999999999 of a tuple with 2 elements; tuple elements are numbered from .1"
(let t = (1L, 2L) in t.___) = error="Field name is empty"

// Resolve the package value before accessing its elements.
module TupleVal =
  val pair = (1L, ("a", true))
  pair.1 = 1L
  pair.2.1 = "a"
  TupleVal.pair.2.2 = true
  (let pair = (9L, 8L) in pair.1) = 9L
