// Smoke tests for the full-screen app's VIEW path: App.view is pure (State + Size -> View), so we can
// render it here without a terminal and catch "not found" / crash bugs that the pure kernel tests miss.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten [ Darklang.Fluid.Prims.specs (), Darklang.Fluid.PT.specs (), Darklang.Fluid.PT.Types.specs () ])

  let size () : Darklang.Stdlib.Cli.Tui.Size =
    Darklang.Stdlib.Cli.Tui.Size { width = 110; height = 26 }

  let narrow () : Darklang.Stdlib.Cli.Tui.Size =
    Darklang.Stdlib.Cli.Tui.Size { width = 60; height = 20 }

  let stateOf (editor: Darklang.Fluid.Editor.State) : Darklang.Fluid.App.State =
    Darklang.Fluid.App.State
      { editor = editor
        title = "fluid: test"
        scroll = 0
        target = Darklang.Fluid.App.Target.Scratch
        theme = Darklang.Fluid.Theme.default ()
        bodyRows = 20
        textMode = Stdlib.Option.Option.None }

  let docOf (src: String) : Darklang.Fluid.Slot =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e)
    | Error _ -> Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")

  // Render the app after driving `keys`, at `size`; return the number of non-empty rows drawn.
  let drawnRows (src: String) (keys: List<String>) (size: Darklang.Stdlib.Cli.Tui.Size) : Int =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (reg ()) (docOf src) 60) keys
    let v = Darklang.Fluid.App.view (stateOf ed) size
    v.rows |> Stdlib.List.filter (fun r -> (Stdlib.String.trim (Darklang.Stdlib.Cli.Tui.Text.stripSgr r)) != "") |> Stdlib.List.length


module Smoke =
  // The view renders something for a plain document, on a wide screen (framed pane + inspector).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [] (Fixtures.size ())) > 5) = true

  // ... after navigating into the tree (exercises breadcrumb + inspector "ON"/actions).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [ "j", "j" ] (Fixtures.size ())) > 5) = true

  // ... with the palette open (exercises the overlay + visibleActions).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [ ":" ] (Fixtures.size ())) > 5) = true

  // ... on a hole with completion showing (exercises the popover + candidates in the inspector).
  ((Fixtures.drawnRows "" [ "l", "e" ] (Fixtures.size ())) > 3) = true

  // ... and it degrades on a narrow screen (inspector dropped, no crash).
  ((Fixtures.drawnRows "if x > 2 then 1 else 2" [] (Fixtures.narrow ())) > 3) = true


module InspectorLabels =
  // The inspector's sections read as one consistent uppercase list. On an empty hole it leads with an
  // EXPECTS header; the ACTIONS header carries no stray colon.
  let screenText (src: String) (keys: List<String>) : String =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf src) 60) keys
    let v = Darklang.Fluid.App.view (Fixtures.stateOf ed) (Fixtures.size ())
    v.rows
    |> Stdlib.List.map (fun r -> Darklang.Stdlib.Cli.Tui.Text.stripSgr r)
    |> Stdlib.String.join "\n"

  (Stdlib.String.contains (InspectorLabels.screenText "" []) "EXPECTS") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" []) "ACTIONS") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" []) "ACTIONS  :") = false

  // Completions live at the caret now, so the panel does NOT carry a COMPLETE section; while typing, its
  // header reads TYPING and the candidate itself shows in the popover (its label is on screen).
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "COMPLETE") = false
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "TYPING") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "let") = true


module CompletionOverflow =
  // When the completion list is capped, the panel says how many more there are, so a long list doesn't
  // masquerade as the whole set. A short list shows no such line.
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e", "t", " ", "x", " ", "1", " " ]) "more") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "more") = false


module TextMode =
  // Ctrl-E drops to plain text: the current document prints to source, and edited source parses back.
  // The round-trip (source -> doc -> source) is stable, which is what makes the switch safe.
  (Darklang.Fluid.App.docToSource (Fixtures.docOf "1 + 2 * 3")) = "1 + 2 * 3"
  (Darklang.Fluid.App.docToSource (Fixtures.docOf "if b then 1 else 2")) = "if b then 1 else 2"
  ((match Darklang.Fluid.App.sourceToDoc "[1, 2, 3]" with
    | Ok s -> Darklang.Fluid.App.docToSource s
    | Error e -> "err: " ++ e)) = "[1, 2, 3]"
  // A multi-line construct survives the trip too.
  ((match Darklang.Fluid.App.sourceToDoc "let x = 1\nx" with
    | Ok s -> Darklang.Fluid.App.docToSource s
    | Error e -> "err: " ++ e)) = "let x = 1\nx"


module TextEditGuard =
  // parsePTExpr fills gaps rather than failing, so applying garbage would silently mangle the expression.
  // The guard catches placeholders the parser invented (a `()` or `_` the text never mentioned).
  let verdict (src: String) : String =
    match Darklang.Fluid.App.sourceToDoc src with
    | Ok s ->
      (match Darklang.Fluid.App.textEditProblem src s with
       | Some _ -> "reject"
       | None -> "ok")
    | Error _ -> "reject"

  (TextEditGuard.verdict "let =") = "reject"
  (TextEditGuard.verdict "((((") = "reject"
  (TextEditGuard.verdict "if if if") = "reject"

  // Valid code is accepted, including code that legitimately contains unit or a wildcard, and a lambda
  // (which the printer parenthesises) -- no false positives.
  (TextEditGuard.verdict "1 + 2") = "ok"
  (TextEditGuard.verdict "let x = 1\nx") = "ok"
  (TextEditGuard.verdict "()") = "ok"
  (TextEditGuard.verdict "if b then () else ()") = "ok"
  (TextEditGuard.verdict "let _ = 1\n2") = "ok"
  (TextEditGuard.verdict "fun x -> x") = "ok"


module TextModeReadiness =
  // Entering text mode on a document that can't be printed yet (a half-typed name) must say why -- it used
  // to hand back an empty string, which would open a blank buffer over real work and then apply it.
  let srcOf (keys: List<String>) : String =
    let ed =
      Darklang.Fluid.Test.drive
        (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expression")) 60)
        keys
    match Darklang.Fluid.App.docToSourceResult ed.root with
    | Ok s -> "ok:" ++ s
    | Error _ -> "error"

  // A bare half-typed name, and a let whose body is still an unsettled name.
  (TextModeReadiness.srcOf [ "l", "e" ]) = "error"
  (TextModeReadiness.srcOf [ "l", "e", "t", " ", "x", " ", "1", " ", "y" ]) = "error"

  // A complete document prints; an untouched hole is simply an empty buffer.
  (TextModeReadiness.srcOf [ "1", "+", "2" ]) = "ok:1 + 2"
  (TextModeReadiness.srcOf []) = "ok:"
