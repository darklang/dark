// Smoke tests for the full-screen app's VIEW path: App.view is pure (State + Size -> View), so we can
// render it here without a terminal and catch "not found" / crash bugs that the pure kernel tests miss.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten [ Darklang.Fluid.Prims.specs (), Darklang.Fluid.PT.specs (), Darklang.Fluid.PT.Types.specs () ])

  let size () : Darklang.Stdlib.Cli.Tui.Size =
    Darklang.Stdlib.Cli.Tui.Size { width = 110; height = 26 }

  let narrow () : Darklang.Stdlib.Cli.Tui.Size =
    Darklang.Stdlib.Cli.Tui.Size { width = 60; height = 20 }

  let stateOf (editor: Darklang.Fluid.Editor.State) : Darklang.Fluid.App.State =
    Darklang.Fluid.App.State
      { editor = editor
        title = "fluid: test"
        scroll = 0
        target = Darklang.Fluid.App.Target.Scratch
        theme = Darklang.Fluid.Theme.default ()
        bodyRows = 20
        inspectorOpen = false
        evaluated = Stdlib.Option.Option.None
        textMode = Stdlib.Option.Option.None }

  let docOf (src: String) : Darklang.Fluid.Slot =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e)
    | Error _ -> Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")

  // Render the app after driving `keys`, at `size`; return the number of non-empty rows drawn.
  let drawnRows (src: String) (keys: List<String>) (size: Darklang.Stdlib.Cli.Tui.Size) : Int =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (reg ()) (docOf src) 60) keys
    let v = Darklang.Fluid.App.view (stateOf ed) size
    v.rows |> Stdlib.List.filter (fun r -> (Stdlib.String.trim (Darklang.Stdlib.Cli.Tui.Text.stripSgr r)) != "") |> Stdlib.List.length


module Smoke =
  // The view renders something for a plain document, on a wide screen (framed pane + inspector).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [] (Fixtures.size ())) > 5) = true

  // ... after navigating into the tree (exercises breadcrumb + inspector "ON"/actions).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [ "j", "j" ] (Fixtures.size ())) > 5) = true

  // ... with the palette open (exercises the overlay + visibleActions).
  ((Fixtures.drawnRows "if x > 2 then [1, 2] else 3" [ ":" ] (Fixtures.size ())) > 5) = true

  // ... on a hole with completion showing (exercises the popover + candidates in the inspector).
  ((Fixtures.drawnRows "" [ "l", "e" ] (Fixtures.size ())) > 3) = true

  // ... and it degrades on a narrow screen (inspector dropped, no crash).
  ((Fixtures.drawnRows "if x > 2 then 1 else 2" [] (Fixtures.narrow ())) > 3) = true


module InspectorLabels =
  // The inspector's sections read as one consistent uppercase list. On an empty hole it leads with an
  // EXPECTS header; the ACTIONS header carries no stray colon.
  let screenText (src: String) (keys: List<String>) : String =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf src) 60) keys
    // These are about what the PANEL says, and the panel is on demand now, so open it.
    let v = Darklang.Fluid.App.view { (Fixtures.stateOf ed) with inspectorOpen = true } (Fixtures.size ())
    v.rows
    |> Stdlib.List.map (fun r -> Darklang.Stdlib.Cli.Tui.Text.stripSgr r)
    |> Stdlib.String.join "\n"

  (Stdlib.String.contains (InspectorLabels.screenText "" []) "EXPECTS") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" []) "ACTIONS") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" []) "ACTIONS  :") = false

  // Completions live at the caret now, so the panel does NOT carry a COMPLETE section; while typing, its
  // header reads TYPING and the candidate itself shows in the popover (its label is on screen).
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "COMPLETE") = false
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "TYPING") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "let") = true


module CompletionOverflow =
  // When the completion list is capped, the panel says how many more there are, so a long list doesn't
  // masquerade as the whole set. A short list shows no such line.
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e", "t", " ", "x", " ", "1", " " ]) "more") = true
  (Stdlib.String.contains (InspectorLabels.screenText "" [ "l", "e" ]) "more") = false


module TextMode =
  // Ctrl-E drops to plain text: the current document prints to source, and edited source parses back.
  // The round-trip (source -> doc -> source) is stable, which is what makes the switch safe.
  (Darklang.Fluid.App.docToSource (Fixtures.docOf "1 + 2 * 3")) = "1 + 2 * 3"
  (Darklang.Fluid.App.docToSource (Fixtures.docOf "if b then 1 else 2")) = "if b then 1 else 2"
  ((match Darklang.Fluid.App.sourceToDoc "[1, 2, 3]" with
    | Ok s -> Darklang.Fluid.App.docToSource s
    | Error e -> "err: " ++ e)) = "[1, 2, 3]"
  // A multi-line construct survives the trip too.
  ((match Darklang.Fluid.App.sourceToDoc "let x = 1\nx" with
    | Ok s -> Darklang.Fluid.App.docToSource s
    | Error e -> "err: " ++ e)) = "let x = 1\nx"


module TextEditGuard =
  // parsePTExpr fills gaps rather than failing, so applying garbage would silently mangle the expression.
  // The guard catches placeholders the parser invented (a `()` or `_` the text never mentioned).
  let verdict (src: String) : String =
    match Darklang.Fluid.App.sourceToDoc src with
    | Ok s ->
      (match Darklang.Fluid.App.textEditProblem src s with
       | Some _ -> "reject"
       | None -> "ok")
    | Error _ -> "reject"

  (TextEditGuard.verdict "let =") = "reject"
  (TextEditGuard.verdict "((((") = "reject"
  (TextEditGuard.verdict "if if if") = "reject"

  // Valid code is accepted, including code that legitimately contains unit or a wildcard, and a lambda
  // (which the printer parenthesises) -- no false positives.
  (TextEditGuard.verdict "1 + 2") = "ok"
  (TextEditGuard.verdict "let x = 1\nx") = "ok"
  (TextEditGuard.verdict "()") = "ok"
  (TextEditGuard.verdict "if b then () else ()") = "ok"
  (TextEditGuard.verdict "let _ = 1\n2") = "ok"
  (TextEditGuard.verdict "fun x -> x") = "ok"


module TextModeReadiness =
  // Entering text mode on a document that can't be printed yet (a half-typed name) must say why -- it used
  // to hand back an empty string, which would open a blank buffer over real work and then apply it.
  let srcOf (keys: List<String>) : String =
    let ed =
      Darklang.Fluid.Test.drive
        (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expression")) 60)
        keys
    match Darklang.Fluid.App.docToSourceResult ed.root with
    | Ok s -> "ok:" ++ s
    | Error _ -> "error"

  // A bare half-typed name, and a let whose body is still an unsettled name.
  (TextModeReadiness.srcOf [ "l", "e" ]) = "error"
  (TextModeReadiness.srcOf [ "l", "e", "t", " ", "x", " ", "1", " ", "y" ]) = "error"

  // A complete document prints; an untouched hole is simply an empty buffer.
  (TextModeReadiness.srcOf [ "1", "+", "2" ]) = "ok:1 + 2"
  (TextModeReadiness.srcOf []) = "ok:"


module TextModeScope =
  // Ctrl-E from NAV edits just the SELECTED node: printing is scoped to its path, and applying splices the
  // re-parsed node back there, leaving the rest of the expression alone.
  let thenPath () : Darklang.Fluid.Path = [ Darklang.Fluid.Step.Into "then" ]

  (match Darklang.Fluid.slotAtPath (Fixtures.docOf "if b then [1, 2] else 3") (TextModeScope.thenPath ()) with
   | Some s -> Darklang.Fluid.App.docToSource s
   | None -> "none") = "[1, 2]"

  ((let ed = Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf "if b then [1, 2] else 3") 60
    let replacement =
      match Darklang.Fluid.App.sourceToDoc "[1, 2, 9]" with
      | Ok s -> s
      | Error _ -> Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "x")
    let spliced =
      Darklang.Fluid.Editor.commit ed [ Darklang.Fluid.Edit.Replace(TextModeScope.thenPath (), replacement) ] ed.caret
    Darklang.Fluid.App.docToSource spliced.root)) = "if b then [1, 2, 9] else 3"


module TextPaneWindow =
  // The text pane draws a window on the buffer: `Layout.at` silently drops rows past the bottom, so a
  // buffer taller than the pane used to hide its own tail while the caret walked off-screen. `textTop`
  // picks which line sits at the top.
  let linesOf (n: Int) : List<String> =
    Stdlib.List.range 1 n |> Stdlib.List.map (fun i -> Stdlib.Int.toString i)

  // A buffer that fits never scrolls, wherever the caret is.
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 5) 0 10) = 0
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 5) 4 10) = 0

  // A taller buffer: the top of it is visible on entry, and the caret at the end scrolls exactly far
  // enough to show the last line -- never past it, which would draw blank rows under the tail.
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 14) 0 10) = 0
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 14) 13 10) = 4

  // Mid-buffer, the window keeps a couple of lines of lookahead below the caret.
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 14) 9 10) = 2
  (Darklang.Fluid.App.textTop (TextPaneWindow.linesOf 14) 7 10) = 0


module PanelOnDemand =
  // Redesign step 2: the code is the hero and gets the full width. The always-on context rail is now
  // opened with `?`, and what it said constantly moved to where it is actually needed -- completions to
  // the caret popover (step 1), and "what does this hole expect" to the status line.
  let stateWith (open_: Bool) (editor: Darklang.Fluid.Editor.State) : Darklang.Fluid.App.State =
    { (Fixtures.stateOf editor) with inspectorOpen = open_ }

  let screenOf (open_: Bool) (src: String) (keys: List<String>) : String =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf src) 60) keys
    (Darklang.Fluid.App.view (PanelOnDemand.stateWith open_ ed) (Fixtures.size ())).rows
    |> Stdlib.List.map (fun r -> Darklang.Stdlib.Cli.Tui.Text.stripSgr r)
    |> Stdlib.String.join "\n"

  // Closed by default: no rail, and no ACTIONS header taking a third of the width.
  (Stdlib.String.contains (PanelOnDemand.screenOf false "if x > 2 then [1, 2] else 3" []) "context") = false
  (Stdlib.String.contains (PanelOnDemand.screenOf false "if x > 2 then [1, 2] else 3" []) "ACTIONS") = false
  // Open on request, with the actions AND the full keymap, which is what lets the status line be short.
  (Stdlib.String.contains (PanelOnDemand.screenOf true "if x > 2 then [1, 2] else 3" []) "context") = true
  (Stdlib.String.contains (PanelOnDemand.screenOf true "if x > 2 then [1, 2] else 3" []) "ACTIONS") = true
  (Stdlib.String.contains (PanelOnDemand.screenOf true "if x > 2 then [1, 2] else 3" []) "KEYS") = true

  // The status line says what the panel used to: what this hole wants, or what you are typing.
  (Darklang.Fluid.App.statusOf
    (PanelOnDemand.stateWith false (Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf "") 60) []))) = " expects expr ·"
  (Darklang.Fluid.App.statusOf
    (PanelOnDemand.stateWith false (Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf "") 60) [ "l", "e" ]))) = " typing le ·"

  // The footer has to FIT: it used to run past the right edge and read `q qu`.
  ((Stdlib.String.length (Darklang.Fluid.App.helpFor
     (PanelOnDemand.stateWith false (Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf "if x > 2 then 1 else 2") 60) [ "<Esc>" ])))) < 80) = true


module ValueOnDemand =
  // Redesign step 4: the VALUE of what you have selected. `v` asks and the answer stays; it is not a live
  // readout, because evaluating is RUNNING THE CODE, and doing that on every keystroke would fire whatever
  // effects an expression has while you are still typing it. allowHarmful stays false for the same reason.
  //
  // The evaluation ITSELF cannot be pinned here: it goes through Cli.Eval, whose `cliEvaluateExpression`
  // is a CliHost builtin, and testfiles run with the cloud builtins -- asking for it gives
  // `FnNotFound (Builtin "cliEvaluateExpression")`. So the behaviour was checked by hand in the editor
  // (`1 + 2 * 3` -> 7, the `2 * 3` inside it -> 6, `x + 1` -> the free-variable error) and what is pinned
  // here is everything around it that the harness CAN reach: where the answer is kept, and how the panel
  // decides to show it.
  let withValue (src: String) (keys: List<String>) (answer: String) (at: Darklang.Fluid.Path) : Darklang.Fluid.App.State =
    let ed = Darklang.Fluid.Test.drive (Darklang.Fluid.Editor.init (Fixtures.reg ()) (Fixtures.docOf src) 60) keys
    { (Fixtures.stateOf ed) with
        inspectorOpen = true
        evaluated = Stdlib.Option.Option.Some((at, answer)) }

  let screenOf (st: Darklang.Fluid.App.State) : String =
    (Darklang.Fluid.App.view st (Fixtures.size ())).rows
    |> Stdlib.List.map (fun r -> Darklang.Stdlib.Cli.Tui.Text.stripSgr r)
    |> Stdlib.String.join "\n"

  // An answer about the node you are ON is shown, under a VALUE heading.
  (Stdlib.String.contains
    (ValueOnDemand.screenOf (ValueOnDemand.withValue "1 + 2 * 3" [ "<Esc>" ] "7" [])) "VALUE") = true
  (Stdlib.String.contains
    (ValueOnDemand.screenOf (ValueOnDemand.withValue "1 + 2 * 3" [ "<Esc>" ] "7" [])) "7") = true

  // An answer about a DIFFERENT node is not: a value that quietly belonged to something else would be
  // worse than no value at all.
  (Stdlib.String.contains
    (ValueOnDemand.screenOf
      (ValueOnDemand.withValue "1 + 2 * 3" [ "<Esc>" ] "6" [ Darklang.Fluid.Step.Into "right" ])) "VALUE") = false

  // Nothing asked, nothing shown.
  (Stdlib.String.contains
    (ValueOnDemand.screenOf { (ValueOnDemand.withValue "1 + 2 * 3" [ "<Esc>" ] "7" []) with evaluated = Stdlib.Option.Option.None })
    "VALUE") = false

  // And the key is advertised in the status line. (Not asserted on the PANEL: it truncates to the height
  // of its region, so which of its rows are on screen depends on the size of the terminal.)
  (Stdlib.String.contains
    (Darklang.Fluid.App.helpFor (ValueOnDemand.withValue "1 + 2 * 3" [ "<Esc>" ] "7" [])) "v value") = true


module NewShapesSurviveTextMode =
  // Ctrl-E prints the selection and re-parses what you edited, so anything Fluid can BUILD it must also be
  // able to print and read back. Records and constructors were the newest things it can build.
  let roundTrip (src: String) : String =
    match Darklang.Fluid.App.sourceToDoc src with
    | Ok back ->
      (match Darklang.Fluid.App.docToSourceResult back with
       | Ok again -> again
       | Error e -> "print ERR " ++ e)
    | Error e -> "parse ERR " ++ e

  (NewShapesSurviveTextMode.roundTrip "Stdlib.Cli.Tui.Size { width = 80; height = 24 }") =
    "Stdlib.Cli.Tui.Size { width = 80; height = 24 }"
  (NewShapesSurviveTextMode.roundTrip "Result.Ok(1)") = "Result.Ok(1)"
  (NewShapesSurviveTextMode.roundTrip "match r with\n| Ok(v) -> v\n| Error(e) -> 0") =
    "match r with\n| Ok(v) -> v\n| Error(e) -> 0"
