// Changing a node's kind, and an undo history that reads the way a person expects: a typed word is one
// step, a structural edit is one step, and redo brings it back.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten
        [ Darklang.Fluid.Prims.specs (), Darklang.Fluid.PT.specs (), Darklang.Fluid.PT.Types.specs () ])

  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")

  let run (keys: List<String>) : String = Darklang.Fluid.Test.run (reg ()) (hole ()) 60 keys


module Change =
  // NAV `c` clears the node to a typed hole and drops into INSERT with the menu, so you retype it as
  // anything of the same type -- here an Int becomes an expression hole.
  (Fixtures.run [ "5", "<Esc>", "c" ]) = "~⟨expression⟩"

  // ... and you build the replacement immediately.
  (Fixtures.run [ "5", "<Esc>", "c", "9" ]) = "9~"

  (Fixtures.run [ "5", "<Esc>", "c", "i", "f", "<Enter>" ]) = "if ~⟨cond⟩ then ⟨then⟩ else ⟨else⟩"


module Undo =
  // The change and the retype are separate steps: one undo drops the 9, another restores the original 5.
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "u" ]) = "~⟨expression⟩"
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "u", "u" ]) = "~5"


module Coalesce =
  // Typing into a text run is ONE undo step, not one per character: undoing a string body clears the
  // whole word back to the empty string, and a second undo removes the string itself.
  (Fixtures.run [ "\"", "a", "b", "c" ]) = "\"abc~\""
  (Fixtures.run [ "\"", "a", "b", "c", "<Esc>", "u" ]) = "\"~\""
  (Fixtures.run [ "\"", "a", "b", "c", "<Esc>", "u", "u" ]) = "~⟨expr⟩"


module Redo =
  // Redo reapplies what undo took back.
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "u", "<C-r>" ]) = "~9"
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "u", "u", "<C-r>", "<C-r>" ]) = "~9"


module BothSpellingsInBothModes =
  // NAV had `u` and `^R`; INSERT had `^Z` and `^Y`. So redo answered to its Ctrl name in NAV and undo did
  // not, and anyone who learned `^Z` one mode over got silence. It cost me a sweep: 1,120 keystroke-then-
  // undo checks over real store functions came back with 160 "failures" that were all `^Z` doing nothing
  // in NAV, and then 113 more that were `o` dropping into INSERT where `u` types a letter. The invariant
  // was fine both times; the harness was pressing keys that were not bound where it thought.
  //
  // Nothing in NAV claims either character, so both modes answer to both spellings now.
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "<C-z>" ]) = "~⟨expression⟩"
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "<C-z>", "<C-z>" ]) = "~5"

  // Redo the same way, from NAV.
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "<C-z>", "<C-y>" ]) = "~9"

  // And the keys that already worked still do.
  (Fixtures.run [ "5", "<Esc>", "c", "9", "<Esc>", "u", "<C-r>" ]) = "~9"

  // `o` drops into INSERT, so an undo straight after it has to be one that works THERE. This is the case
  // the sweep tripped over, pinned as the thing it should be.
  (Fixtures.run [ "[", "1", "<Esc>", "o", "<C-z>" ]) = "[~1]"
