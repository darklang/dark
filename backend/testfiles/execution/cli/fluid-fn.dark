// The function shell: a whole PackageFn edits as one document -- name, typed params, return type, body.
// A constructed PackageFn is used so the test needs no package store.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten
        [ Darklang.Fluid.Prims.specs ()
          Darklang.Fluid.PT.specs ()
          Darklang.Fluid.PT.Types.specs ()
          Darklang.Fluid.PT.Fn.specs () ])

  let param (name: String) (t: Darklang.LanguageTools.ProgramTypes.TypeReference) : Darklang.LanguageTools.ProgramTypes.PackageFn.Parameter =
    Darklang.LanguageTools.ProgramTypes.PackageFn.Parameter { name = name; typ = t; description = "" }

  // let inc (n: Int) : Int = n + 1   -- body references the param as EArg 0
  let inc () : Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn =
    Darklang.LanguageTools.ProgramTypes.PackageFn.PackageFn
      { hash = Darklang.LanguageTools.ProgramTypes.Hash.Hash "deadbeef"
        body =
          Darklang.LanguageTools.ProgramTypes.Expr.EInfix(
            1L,
            Darklang.LanguageTools.ProgramTypes.Infix.InfixFnCall Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticPlus,
            Darklang.LanguageTools.ProgramTypes.Expr.EArg(2L, 0),
            Darklang.LanguageTools.ProgramTypes.Expr.EInt(3L, 1))
        typeParams = []
        parameters = [ param "n" Darklang.LanguageTools.ProgramTypes.TypeReference.TInt ]
        returnType = Darklang.LanguageTools.ProgramTypes.TypeReference.TInt
        description = "" }

  let doc () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.Fn.toDoc "inc" (inc ()))

  let render () : String = Darklang.Fluid.Debug.render (reg ()) 70 (doc ())


module Rendering =
  // The whole signature is on screen, and the param reference in the body reads as its name, not earg0.
  (Fixtures.render ()) = "let inc (n: Int) : Int =\n  n + 1"


module RoundTrip =
  // Lowering the document back gives a PackageFn with the same shape; the body keeps the param name (the
  // parser re-lowers it to EArg on save).
  let shape () : (String * Int) =
    match Fixtures.doc () with
    | Filled n ->
      match Darklang.Fluid.PT.Fn.fromDoc (Fixtures.inc ()) n with
      | Ok((name, fn)) -> (name, Stdlib.List.length fn.parameters)
      | Error _ -> ("err", -1)
    | _ -> ("not-a-node", -1)

  (Fixtures.doc () |> fun _ -> RoundTrip.shape ()) = ("inc", 1)


module Editing =
  // Start from an empty function hole and build a signature: params complete their types, the return type
  // completes, the body edits.
  let fnHole () : Darklang.Fluid.Slot =
    Darklang.Fluid.Slot.Empty(Darklang.Fluid.Expect.ofKind (Darklang.Fluid.Kind.named "Darklang.Fluid.PT.Fn.Function") "fn")

  // A param node's type slot completes like any type hole.
  (Darklang.Fluid.Debug.render (Fixtures.reg ()) 70 (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.Fn.paramToDoc (Fixtures.param "x" Darklang.LanguageTools.ProgramTypes.TypeReference.TString)))) =
    "(x: String)"


module SaveFidelity =
  // The save path is: fromDoc, print with the pretty-printer, apply that SOURCE. So anything fromDoc
  // fails to rebuild is silently rewritten out of the store -- that is exactly how the enum-field labels
  // were lost. This checks the whole path against REAL package functions, as a property rather than a
  // fixed string, so it stays honest as the stdlib changes: printing what fromDoc returns must equal
  // printing the original.
  let stripDocs (s: String) : String =
    Stdlib.String.split s "\n"
    |> Stdlib.List.filter (fun l -> Stdlib.Bool.not (Stdlib.String.startsWith (Stdlib.String.trim l) "///"))
    |> Stdlib.String.join "\n"

  let verdict (name: String) : String =
    let branchId = Darklang.SCM.Branch.mainBranchId
    let loc = Darklang.LanguageTools.ProgramTypes.parsePackageLocation name
    match Darklang.LanguageTools.PackageManager.Function.find branchId loc with
    | None -> "missing"
    | Some hash ->
      match Darklang.LanguageTools.PackageManager.Function.get hash with
      | None -> "missing"
      | Some fn ->
        let ctx = Darklang.Fluid.PT.printerContext ()
        let printed = SaveFidelity.stripDocs (Darklang.PrettyPrinter.ProgramTypes.packageFn ctx fn)
        (match Darklang.Fluid.PT.Fn.fromDoc fn (Darklang.Fluid.PT.Fn.toDoc loc.name fn) with
         | Error _ -> "refuses"
         | Ok(pair) ->
           let (_n, updated) = pair
           if (SaveFidelity.stripDocs (Darklang.PrettyPrinter.ProgramTypes.packageFn ctx updated)) == printed then "same"
           else "LOSES SOMETHING")

  // Generic signatures, higher-order params and multi-arm bodies all survive the trip.
  (SaveFidelity.verdict "Darklang.Stdlib.Option.map") = "same"
  (SaveFidelity.verdict "Darklang.Stdlib.Result.map") = "same"
  (SaveFidelity.verdict "Darklang.Stdlib.Option.andThen") = "same"
  (SaveFidelity.verdict "Darklang.Stdlib.Option.withDefault") = "same"
  (SaveFidelity.verdict "Darklang.Stdlib.Result.map2") = "same"
  (SaveFidelity.verdict "Darklang.Stdlib.List.head") = "same"

  // A body that calls a builtin can't be rebuilt yet, and the right answer to that is a REFUSAL. It
  // reaches the person as "not saved: ..." rather than a function quietly rewritten without its body.
  (SaveFidelity.verdict "Darklang.Stdlib.List.length") = "refuses"
  (SaveFidelity.verdict "Darklang.Stdlib.Bool.not") = "refuses"
