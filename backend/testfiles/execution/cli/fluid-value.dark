// Fluid edits package values too: a PackageValue (name + body expression) as one document.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten [ Darklang.Fluid.Prims.specs (), Darklang.Fluid.PT.specs (), Darklang.Fluid.PT.Value.specs () ])

  let mk (body: Darklang.LanguageTools.ProgramTypes.Expr) : Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue =
    Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue
      { hash = Darklang.LanguageTools.ProgramTypes.Hash.Hash "cafe"; body = body; description = "" }

  let strVal () : Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue =
    mk (Darklang.LanguageTools.ProgramTypes.Expr.EString(1L, [ Darklang.LanguageTools.ProgramTypes.StringSegment.StringText "hello" ]))

  let listVal () : Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue =
    mk (Darklang.LanguageTools.ProgramTypes.Expr.EList(1L, [ Darklang.LanguageTools.ProgramTypes.Expr.EInt(2L, 1), Darklang.LanguageTools.ProgramTypes.Expr.EInt(3L, 2) ]))

  let show (nm: String) (pv: Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue) : String =
    Darklang.Fluid.Debug.render (reg ()) 60 (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.Value.toDoc nm pv))

  let ctx () : Darklang.PrettyPrinter.ProgramTypes.Context = Darklang.Fluid.PT.printerContext ()

  // Compare printed forms: a round trip regenerates node ids, so structural `==` would differ on ids.
  let rt (pv: Darklang.LanguageTools.ProgramTypes.PackageValue.PackageValue) : Bool =
    match Darklang.Fluid.PT.Value.fromDoc pv (Darklang.Fluid.PT.Value.toDoc "x" pv) with
    | Ok((_n, p2)) ->
      (Darklang.PrettyPrinter.ProgramTypes.expr (ctx ()) p2.body) == (Darklang.PrettyPrinter.ProgramTypes.expr (ctx ()) pv.body)
    | Error _ -> false


module Rendering =
  // One line, the way the printer writes it: packageValue is `val {name} = {body}`, and the body wraps on
  // its own if it needs to. This used to hard-break after the `=`.
  (Fixtures.show "greeting" (Fixtures.strVal ())) = "val greeting = \"hello\""
  (Fixtures.show "nums" (Fixtures.listVal ())) = "val nums = [1, 2]"


module RoundTrips =
  (Fixtures.rt (Fixtures.strVal ())) = true
  (Fixtures.rt (Fixtures.listVal ())) = true


module MatchesThePrinter =
  // The printer writes `val name = body` on ONE line: packageValue interpolates the body straight in and
  // lets the body's own layout wrap. Fluid hard-broke after the `=`, so every value in the store showed on
  // two lines where the printer uses one. (A FUNCTION does break before its body -- that difference is the
  // printer's own, and Fluid follows it.)
  let verdict (name: String) : String =
    let branchId = Darklang.SCM.Branch.mainBranchId
    let loc = Darklang.LanguageTools.ProgramTypes.parsePackageLocation name
    match Darklang.LanguageTools.PackageManager.Value.find branchId loc with
    | None -> "missing"
    | Some hash ->
      match Darklang.LanguageTools.PackageManager.Value.get hash with
      | None -> "missing"
      | Some pv ->
        // The doc comment is drawn now, so nothing is stripped before comparing.
        let printed =
          Darklang.PrettyPrinter.ProgramTypes.packageValue (Darklang.Fluid.PT.printerContext ()) pv
        let screen =
          Darklang.Fluid.Debug.render
            (Darklang.Fluid.App.defaultRegistry ())
            80
            (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.Value.toDoc loc.name pv))
        if screen == printed then "same" else "DIFF: " ++ screen

  (MatchesThePrinter.verdict "Darklang.SCM.Branch.mainBranchId") = "same"
  (MatchesThePrinter.verdict "Darklang.PrettyPrinter.ProgramTypes.Context.forMain") = "same"
  (MatchesThePrinter.verdict "Darklang.Fluid.PT.exprType") = "same"


module BuiltinValuesRoundTrip =
  // A value whose body is a builtin reference could not be lowered either, and the document had dropped the
  // version on the way in, so there was nothing to rebuild from. `v` on one reported "can't print that yet:
  // unresolved value name: Builtin.scmMainBranchId".
  let verdict (name: String) : String =
    let loc = Darklang.LanguageTools.ProgramTypes.parsePackageLocation name
    match Darklang.LanguageTools.PackageManager.Value.find Darklang.SCM.Branch.mainBranchId loc with
    | None -> "missing"
    | Some hash ->
      match Darklang.LanguageTools.PackageManager.Value.get hash with
      | None -> "missing"
      | Some pv ->
        match Darklang.Fluid.PT.Value.fromDoc pv (Darklang.Fluid.PT.Value.toDoc loc.name pv) with
        | Error e -> "refuses: " ++ e
        | Ok(pair) ->
          let (_n, v2) = pair
          let ctx = Darklang.Fluid.PT.printerContext ()
          if (Darklang.PrettyPrinter.ProgramTypes.packageValue ctx pv)
             == (Darklang.PrettyPrinter.ProgramTypes.packageValue ctx v2) then "same"
          else "CHANGED"

  (BuiltinValuesRoundTrip.verdict "Darklang.SCM.Branch.mainBranchId") = "same"


module ValueNamesAreShortened =
  // `EFnName` shortened its name in `toDoc` and `EValue` did not, so one call could carry both forms:
  // `Stdlib.Cli.UI.Colors.colorize Darklang.Stdlib.Cli.UI.Colors.yellow`. Precisely the drift t88 was
  // about -- two paths to the same decision, one of them missed -- and t88's fix did not reach this path.
  //
  // Found by counting rather than sampling: 50 of 250 real functions drew tokens the printer does not
  // write, and my two known causes explained only 19 of them.
  let docOf (src: String) : Darklang.Fluid.Slot =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e)
    | Error e -> Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect ("parse failed: " ++ e))

  let show (src: String) : String =
    Darklang.Fluid.Debug.render (Darklang.Fluid.App.defaultRegistry ()) 80 (ValueNamesAreShortened.docOf src)

  // A value reference and a function reference in the same expression, both short.
  (ValueNamesAreShortened.show "Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow \"x\"") =
    "Stdlib.Cli.UI.Colors.colorize Stdlib.Cli.UI.Colors.yellow \"x\""

  // And what the printer writes for the same program, which is the point of shortening at all.
  (ValueNamesAreShortened.show "Stdlib.Cli.UI.Colors.yellow") = "Stdlib.Cli.UI.Colors.yellow"


module AValueIsADocument =
  // A runtime VALUE projected into a document. Everything else in Fluid projects a program -- an
  // expression, a declaration, a function shell -- and this projects what a program produced.
  //
  // The design doc calls it out as the missing half (7.D, "editing a runtime value of type T needs
  // Dval <-> Node") and it is why a value of your own type could be drawn in the demo and saved nowhere.
  //
  // No new specs. `Derive` already builds one for any type from its declaration and `Prims` covers the
  // leaves, so a value document draws with what is there. This is the conversion only.
  let bid () : Uuid = Darklang.SCM.Branch.mainBranchId

  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()

  let draw (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    Darklang.Fluid.Debug.render
      (AValueIsADocument.reg ())
      70
      (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Value.ofDval (AValueIsADocument.bid ()) v))

  (AValueIsADocument.draw (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 42)) = "42"
  (AValueIsADocument.draw (Darklang.LanguageTools.RuntimeTypes.Dval.DString "hi")) = "\"hi\""
  (AValueIsADocument.draw (Darklang.LanguageTools.RuntimeTypes.Dval.DBool true)) = "true"
  (AValueIsADocument.draw Darklang.LanguageTools.RuntimeTypes.Dval.DUnit) = "()"

  (AValueIsADocument.draw
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1, Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2 ]))) = "[1, 2]"

  // Every integer width draws as the same leaf. On screen `1` is `1` whichever width it came from, and
  // the width lives in the type; going back is where it matters.
  (AValueIsADocument.draw (Darklang.LanguageTools.RuntimeTypes.Dval.DInt8 7y)) = "7"
  (AValueIsADocument.draw (Darklang.LanguageTools.RuntimeTypes.Dval.DInt64 7L)) = "7"


module AValueOfAStoredType =
  // The case that matters: a value whose type is IN the store, so its kind resolves and `Derive` can
  // build the spec that draws it. Nothing hand-written anywhere in this path.
  let optionType () : Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName =
    match
      Darklang.LanguageTools.PackageManager.Type.find
        (AValueIsADocument.bid ())
        (Darklang.LanguageTools.ProgramTypes.parsePackageLocation "Darklang.Stdlib.Option.Option")
    with
    | Some h ->
      Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName.Package(
        Darklang.LanguageTools.RuntimeTypes.Hash.Hash(Darklang.LanguageTools.ProgramTypes.hashToString h))
    | None -> Builtin.testDerrorMessage "Option is not in the store"

  let some (v: Darklang.LanguageTools.RuntimeTypes.Dval) : Darklang.LanguageTools.RuntimeTypes.Dval =
    Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
      AValueOfAStoredType.optionType (), AValueOfAStoredType.optionType (), [], "Some", [ v ])

  /// The registry plus the specs `Derive` builds for this type. `Derive` is not wired into the registry
  /// as a fallback yet -- `fluid generate` is its only caller -- so a value entry point has to add them,
  /// which is the next slice.
  let derivedReg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.addAll
      (AValueIsADocument.reg ())
      (Darklang.Fluid.Derive.specsForName (AValueIsADocument.bid ()) "Darklang.Stdlib.Option.Option")

  let drawn (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    Darklang.Fluid.Debug.render
      (AValueOfAStoredType.derivedReg ())
      70
      (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Value.ofDval (AValueIsADocument.bid ()) v))

  // The kind carries the FULL location name, because that name is a KEY: `Derive.specsForName` hands it
  // to `parsePackageLocation`, and `Option` does not resolve where `Darklang.Stdlib.Option.Option` does.
  // The printer's `typeNameWith` shortens for display, which is a different job.
  (Darklang.Fluid.Value.typeKeyName (AValueIsADocument.bid ()) (AValueOfAStoredType.optionType ())) =
    "Darklang.Stdlib.Option.Option"

  // Drawn by a spec derived from the declaration, with the field in it.
  (AValueOfAStoredType.drawn (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) =
    "Some(1)"

  (AValueOfAStoredType.drawn
    (Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
      AValueOfAStoredType.optionType (), AValueOfAStoredType.optionType (), [], "None", []))) = "None"


module AValueGoesBack =
  // The other direction: a document back to the value it came from. Slice 1 could draw a value and save
  // it nowhere, which is half a feature -- an editor you cannot commit from is a viewer.
  //
  // Pinned as a round trip rather than by comparing documents, because equality on the VALUE is the thing
  // that has to hold. A document that draws right and rebuilds wrong looks correct on screen.
  let rt (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    let bid = Darklang.SCM.Branch.mainBranchId
    match Darklang.Fluid.Value.toDval bid (Darklang.Fluid.Value.ofDval bid v) with
    | Ok back -> if back == v then "same" else "CHANGED"
    | Error e -> "ERR " ++ e

  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 42)) = "same"
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DString "hi")) = "same"
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DBool true)) = "same"
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DBool false)) = "same"
  (AValueGoesBack.rt Darklang.LanguageTools.RuntimeTypes.Dval.DUnit) = "same"

  // Every width draws as the same `1` on screen, so the width rides along in a hidden `_w` slot -- the
  // same `_`-prefix convention `_hash` and `_doc` use, skipped by drawing and by `firstEditable`.
  // Without it an `Int8` came back an `Int`, which is a type error at the far end and nothing on screen.
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DInt8 7y)) = "same"
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DInt64 7L)) = "same"
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DUInt128 9Z)) = "same"

  // The float leaf draws `whole` and `fraction` as two slots. Putting the whole rendering in the first
  // one drew `1.5` correctly and rebuilt `1.5.0`, which is the exact failure the round trip is for.
  (AValueGoesBack.rt (Darklang.LanguageTools.RuntimeTypes.Dval.DFloat 1.5)) = "same"

  (AValueGoesBack.rt
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1, Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2 ]))) = "same"

  (AValueGoesBack.rt
    (Darklang.LanguageTools.RuntimeTypes.Dval.DTuple(
      Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
      Darklang.LanguageTools.RuntimeTypes.Dval.DString "a",
      []))) = "same"


module StoredTypesGoBack =
  // Records and enums, where the type has to be looked up by name in both directions. The kind carries
  // the full location name for exactly this: going back needs the hash the name resolves to.
  let errorType () : Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName =
    match
      Darklang.LanguageTools.PackageManager.Type.find
        (AValueIsADocument.bid ())
        (Darklang.LanguageTools.ProgramTypes.parsePackageLocation "Darklang.Stdlib.Cli.Posix.Error")
    with
    | Some h ->
      Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName.Package(
        Darklang.LanguageTools.RuntimeTypes.Hash.Hash(Darklang.LanguageTools.ProgramTypes.hashToString h))
    | None -> Builtin.testDerrorMessage "Posix.Error is not in the store"

  (AValueGoesBack.rt (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) = "same"

  (AValueGoesBack.rt
    (Darklang.LanguageTools.RuntimeTypes.Dval.DEnum(
      AValueOfAStoredType.optionType (), AValueOfAStoredType.optionType (), [], "None", []))) = "same"

  // Nested: the enum's field is itself a document, rebuilt by the same recursion.
  (AValueGoesBack.rt
    (AValueOfAStoredType.some
      (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
        Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
        [ Darklang.LanguageTools.RuntimeTypes.Dval.DString "a" ])))) = "same"

  (AValueGoesBack.rt
    (Darklang.LanguageTools.RuntimeTypes.Dval.DRecord(
      StoredTypesGoBack.errorType (),
      StoredTypesGoBack.errorType (),
      [],
      Stdlib.Dict.fromListOverwritingDuplicates
        [ ("errno", Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2),
          ("message", Darklang.LanguageTools.RuntimeTypes.Dval.DString "nope") ]))) = "same"


module AHoleIsNotAValue =
  // Saving refuses rather than inventing. A zero for an empty integer slot would be a value nobody typed,
  // and it would be indistinguishable from one they did -- the same contract `PT.Fn.fromDoc` holds to.
  let verdict (n: Darklang.Fluid.Node) : String =
    match Darklang.Fluid.Value.toDval Darklang.SCM.Branch.mainBranchId n with
    | Ok _ -> "ACCEPTED"
    | Error e -> "refuses: " ++ e

  (AHoleIsNotAValue.verdict
    (Darklang.Fluid.Node.make
      (Darklang.Fluid.Kind.named "List")
      [ ("items",
         Darklang.Fluid.Field.Many(
           [ Darklang.Fluid.Slot.Empty(Darklang.Fluid.Expect.any "an item") ],
           Darklang.Fluid.Expect.any "an item")) ])) = "refuses: hole: an item"

  // A dict draws but cannot be rebuilt: a runtime dict key is a whole Dval, and Dark's own `Dict` is
  // keyed by text, so there is no Dark value to rebuild into. Named, rather than falling through to
  // "not a type in this branch: Dict".
  (AHoleIsNotAValue.verdict (Darklang.Fluid.Node.make (Darklang.Fluid.Kind.named "Dict") [])) =
    "refuses: a dict cannot be rebuilt yet: its keys are values, not text"

  // Same for the things that were never projected in the first place.
  (AHoleIsNotAValue.verdict
    (Darklang.Fluid.Node.make
      (Darklang.Fluid.Kind.named "Opaque")
      [ ("source", Darklang.Fluid.Field.Text "<function>") ])) = "refuses: nothing to rebuild from: <function>"


module AValueDocumentBringsItsOwnSpecs =
  // A value's types are only knowable from the VALUE. `Some([1, 2])` needs an editor for `Option`, and
  // nothing said so up front -- there is no declaration to read the list off, the way a function shell
  // knows its own parameter types. So the entry point walks the document and derives what it finds.
  //
  // This is the difference between a value that draws and a value that draws as an unknown kind, which
  // on screen is indistinguishable from a broken projection.
  let bid () : Uuid = Darklang.SCM.Branch.mainBranchId

  let namesIn (v: Darklang.LanguageTools.RuntimeTypes.Dval) : List<String> =
    Darklang.Fluid.Value.typeNamesIn (Darklang.Fluid.Value.ofDval (AValueDocumentBringsItsOwnSpecs.bid ()) v)

  // A prim mentions no named type at all, so nothing is derived and nothing needs to be.
  (AValueDocumentBringsItsOwnSpecs.namesIn (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1)) = []

  // The FULL location name, because that is what the derive lookup is keyed by.
  (AValueDocumentBringsItsOwnSpecs.namesIn (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) =
    [ "Darklang.Stdlib.Option.Option" ]

  // Nested, and each type ONCE however often it appears -- two `Some`s derive one spec, not two.
  //
  // A list contributes nothing of its own: its kind is a PRIM, and `Prims` already ships the spec that
  // draws it. Only a NAMED type has a declaration to derive from, which is the whole distinction the
  // walk is making.
  (AValueDocumentBringsItsOwnSpecs.namesIn
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1),
        AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2) ]))) =
    [ "Darklang.Stdlib.Option.Option" ]

  // And the registry it builds draws that value, with no spec written or declared anywhere.
  let drawn (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    let node = Darklang.Fluid.Value.ofDval (AValueDocumentBringsItsOwnSpecs.bid ()) v
    Darklang.Fluid.Debug.render
      (Darklang.Fluid.App.registryForValue (AValueDocumentBringsItsOwnSpecs.bid ()) node)
      70
      (Darklang.Fluid.Slot.Filled node)

  (AValueDocumentBringsItsOwnSpecs.drawn (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) =
    "Some(1)"


module OpeningAValue =
  // `fluid eval <expr>` is the first entry point that opens the OUTPUT of code rather than code.
  // Everything else Fluid can open is a program: an expression, a declaration, a function shell.
  //
  // Pinned one step in, at `valueTargetFor`, because the evaluation itself cannot run here: the testfile
  // harness registers every builtin group except `CliHost`, so `cliEvaluateToDval` does not exist in this
  // process. Everything downstream of the evaluator is this, and it is the part with decisions in it.
  let drawn (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    let (reg, root, _target) =
      Darklang.Fluid.App.valueTargetFor (AValueIsADocument.bid ()) "<probe>" v
    Darklang.Fluid.Debug.render reg 70 root

  (OpeningAValue.drawn (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 3)) = "3"
  (OpeningAValue.drawn (Darklang.LanguageTools.RuntimeTypes.Dval.DString "hi")) = "\"hi\""

  (OpeningAValue.drawn
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
        Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2 ]))) = "[1, 2]"

  // The one that matters: a stored type, drawn by a spec derived on the spot. `AValueOfAStoredType` has
  // to build that registry by hand; here the entry point does it, which is the whole point of the slice.
  (OpeningAValue.drawn (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) =
    "Some(1)"

  // The target says what it is, so save refuses for the right reason instead of telling you to try
  // `fluid fn <name>`, which is what `Scratch` would have said.
  let targetOf (source: String) (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    match Darklang.Fluid.App.valueTargetFor (AValueIsADocument.bid ()) source v with
    | (_reg, _root, RuntimeValue src) -> "runtime value of: " ++ src
    | _ -> "some other target"

  (OpeningAValue.targetOf "1 + 2" (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 3)) =
    "runtime value of: 1 + 2"


module AWidthComesFromTheSlot =
  // An integer draws the same digits at every width, so the width has nowhere to live in the projection
  // and rides in a hidden `_w`. The question this module answers is where that field gets its VALUE when
  // a person types the number rather than when `ofDval` builds it.
  //
  // Not from the old node. `c` CLEARS the slot to a hole before you type, so by the time a digit arrives
  // the previous node is gone: an `Int8` retyped came back a plain `Int`, with the right digits on screen
  // and the wrong type underneath. Found by driving it, invisible to every pin that reads the screen.
  //
  // From the SLOT, which is the only thing that knows: a hole carries the declared type of the field it
  // is filling, and `Derive` puts it there.
  let bid () : Uuid = Darklang.SCM.Branch.mainBranchId

  let typed (t: Darklang.LanguageTools.ProgramTypes.TypeReference) (keys: List<String>) : String =
    let root = Darklang.Fluid.Slot.Empty(Darklang.Fluid.Derive.expectFor t "reps")
    let st =
      Darklang.Fluid.Test.drive
        (Darklang.Fluid.Editor.init (Darklang.Fluid.App.defaultRegistry ()) root 60)
        keys
    match st.root with
    | Filled n ->
      (match Darklang.Fluid.Value.toDval (AWidthComesFromTheSlot.bid ()) n with
       | Ok(DInt8 i) -> "DInt8 " ++ (Stdlib.Int8.toString i)
       | Ok(DUInt64 i) -> "DUInt64 " ++ (Stdlib.UInt64.toString i)
       | Ok(DInt i) -> "DInt " ++ (Stdlib.Int.toString i)
       | Ok _ -> "some other case"
       | Error e -> "ERR " ++ e)
    | _ -> "not filled"

  (AWidthComesFromTheSlot.typed Darklang.LanguageTools.ProgramTypes.TypeReference.TInt8 [ "9" ]) = "DInt8 9"
  (AWidthComesFromTheSlot.typed Darklang.LanguageTools.ProgramTypes.TypeReference.TUInt64 [ "9" ]) = "DUInt64 9"
  (AWidthComesFromTheSlot.typed Darklang.LanguageTools.ProgramTypes.TypeReference.TInt [ "9" ]) = "DInt 9"


module RetypingAFieldKeepsItsWidth =
  // The whole case, end to end: a record whose editor is derived from a declaration with an `Int8` field,
  // the field changed with `c` and typed again. `Acme.Log` so nothing in Darklang is doing the work.
  let decl () : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
      { typeParams = []
        definition =
          Darklang.LanguageTools.ProgramTypes.TypeDeclaration.Definition.Record
            [ Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField
                { name = "reps"
                  typ = Darklang.LanguageTools.ProgramTypes.TypeReference.TInt8
                  description = "" } ] }

  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.addAll
      (Darklang.Fluid.App.defaultRegistry ())
      (Darklang.Fluid.Derive.specsFor "Acme.Log" (RetypingAFieldKeepsItsWidth.decl ()))

  let root () : Darklang.Fluid.Slot =
    Darklang.Fluid.Slot.Filled(
      Darklang.Fluid.Node.make
        (Darklang.Fluid.Kind.named "Acme.Log")
        [ ("reps",
           Darklang.Fluid.Field.One(
             Darklang.Fluid.Slot.Filled(Darklang.Fluid.Prims.intNodeOfWidth "Int8" "7"))) ])

  let after (keys: List<String>) : String =
    let st =
      Darklang.Fluid.Test.drive
        (Darklang.Fluid.Editor.init (RetypingAFieldKeepsItsWidth.reg ()) (RetypingAFieldKeepsItsWidth.root ()) 60)
        keys
    match st.root with
    | Filled n ->
      (match Darklang.Fluid.Node.slot n "reps" with
       | Some(Filled leaf) ->
         (match Darklang.Fluid.Value.toDval (AWidthComesFromTheSlot.bid ()) leaf with
          | Ok(DInt8 i) -> "DInt8 " ++ (Stdlib.Int8.toString i)
          | Ok(DInt i) -> "DInt " ++ (Stdlib.Int.toString i)
          | Ok _ -> "some other case"
          | Error e -> "ERR " ++ e)
       | _ -> "field gone")
    | _ -> "not filled"

  (RetypingAFieldKeepsItsWidth.after []) = "DInt8 7"
  (RetypingAFieldKeepsItsWidth.after [ "j", "c", "9", "9", "<Esc>" ]) = "DInt8 99"

  // Typing INTO the leaf rather than replacing it always worked, because the node never went away.
  (RetypingAFieldKeepsItsWidth.after [ "j", "i", "9", "<Esc>" ]) = "DInt8 97"

  // The width is hidden, so none of this shows on screen. That is the point of pinning it here.
  (Darklang.Fluid.Debug.render
    (RetypingAFieldKeepsItsWidth.reg ())
    60
    (RetypingAFieldKeepsItsWidth.root ())) = "Log { reps = 7 }"


module AWidthNeedsSomethingToComeFrom =
  // The boundary, pinned deliberately rather than left to be discovered. A value opened on its own has
  // nothing above it: `fluid eval "7y"` is a bare `Int8` and the root slot has no declared type, because
  // there is no field it is filling. Replace it and the width is genuinely not recoverable.
  //
  // Left alone rather than papered over. Retyping the whole document IS saying "something else goes
  // here", and inventing an `Int8` because that is what used to be there would be guessing. Every case
  // that matters has a slot above it, which is where the answer lives.
  let retyped (v: Darklang.LanguageTools.RuntimeTypes.Dval) (keys: List<String>) : String =
    let root = Darklang.Fluid.Slot.Filled(Darklang.Fluid.Value.ofDval (AWidthComesFromTheSlot.bid ()) v)
    let st =
      Darklang.Fluid.Test.drive
        (Darklang.Fluid.Editor.init (Darklang.Fluid.App.defaultRegistry ()) root 60)
        keys
    match st.root with
    | Filled n ->
      (match Darklang.Fluid.Value.toDval (AWidthComesFromTheSlot.bid ()) n with
       | Ok(DInt8 i) -> "DInt8 " ++ (Stdlib.Int8.toString i)
       | Ok(DInt i) -> "DInt " ++ (Stdlib.Int.toString i)
       | Ok _ -> "some other case"
       | Error e -> "ERR " ++ e)
    | _ -> "not filled"

  (AWidthNeedsSomethingToComeFrom.retyped (Darklang.LanguageTools.RuntimeTypes.Dval.DInt8 7y) []) = "DInt8 7"
  (AWidthNeedsSomethingToComeFrom.retyped (Darklang.LanguageTools.RuntimeTypes.Dval.DInt8 7y) [ "i", "9", "<Esc>" ]) = "DInt8 97"
  (AWidthNeedsSomethingToComeFrom.retyped (Darklang.LanguageTools.RuntimeTypes.Dval.DInt8 7y) [ "c", "9", "9", "<Esc>" ]) = "DInt 99"


module AValueDrawsTheWayItPrints =
  // The strongest pin available here: not a literal string I typed, but agreement with the printer.
  // Fluid's job on a value document is to draw what the printer would write, and a pin that spells the
  // expected text out is a pin that agrees with whatever I believed on the day.
  //
  // Both sides get the same context, which is the trap this comparison has fallen into twice: the
  // printer was given a module and Fluid was not, and thousands of phantom diffs came out of it.
  let agrees (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    let bid = Darklang.SCM.Branch.mainBranchId
    let node = Darklang.Fluid.Value.ofDval bid v
    let drawn =
      Darklang.Fluid.Debug.render
        (Darklang.Fluid.App.registryForValue bid node)
        70
        (Darklang.Fluid.Slot.Filled node)
    match Darklang.LanguageTools.RuntimeTypesToProgramTypes.dvalToExpr bid v with
    | Ok e ->
      let printed = Darklang.PrettyPrinter.ProgramTypes.expr (Darklang.Fluid.PT.printerContext ()) e
      if drawn == printed then "same" else "DIFF fluid=" ++ drawn ++ " printer=" ++ printed
    | Error r -> "no literal form: " ++ r

  // A TUPLE is why this module exists. `ofDval` kinded it `Kind.named "Tuple"`, so the value entry point
  // went looking for a package type called `Tuple` to derive an editor from, found none, and fell back to
  // the unknown-kind drawing: `Tuple { items = [1, "two"] }` where the printer writes `(1, "two")`. A
  // program's tuple is `Expr.ETuple` and has always drawn correctly; a runtime tuple is a different node
  // and nothing had ever drawn one. Found by opening real values, not by reading the code.
  (AValueDrawsTheWayItPrints.agrees
    (Darklang.LanguageTools.RuntimeTypes.Dval.DTuple(
      Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
      Darklang.LanguageTools.RuntimeTypes.Dval.DString "two",
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DBool true ]))) = "same"

  (AValueDrawsTheWayItPrints.agrees (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 42)) = "same"
  (AValueDrawsTheWayItPrints.agrees (Darklang.LanguageTools.RuntimeTypes.Dval.DFloat 1.5)) = "same"
  (AValueDrawsTheWayItPrints.agrees (Darklang.LanguageTools.RuntimeTypes.Dval.DString "hi")) = "same"
  (AValueDrawsTheWayItPrints.agrees (Darklang.LanguageTools.RuntimeTypes.Dval.DBool false)) = "same"
  (AValueDrawsTheWayItPrints.agrees Darklang.LanguageTools.RuntimeTypes.Dval.DUnit) = "same"

  (AValueDrawsTheWayItPrints.agrees
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
        Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2 ]))) = "same"

  // Nested, where a tuple is inside a list and a list inside a tuple.
  (AValueDrawsTheWayItPrints.agrees
    (Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DTuple(
          Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
          Darklang.LanguageTools.RuntimeTypes.Dval.DList(
            Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown,
            [ Darklang.LanguageTools.RuntimeTypes.Dval.DString "x" ]),
          []) ]))) = "same"

  // An ENUM does not agree, and the disagreement is not Fluid's. There are two printers: the one that
  // writes a value for a terminal (`dvalToReprForTerminal`, what `dark eval` prints) says `Some(1)`, and
  // the one that writes SOURCE says `Option.Some(1)`. Fluid draws a VALUE, so it follows the first, and
  // `dark eval` and `dark fluid eval` agree on every enum I have compared.
  //
  // Pinned as a difference rather than deleted, because a pin that quietly drops the case it disagrees
  // with is how a comparison stops being one. If the two printers are ever reconciled, this fails and
  // says so.
  (AValueDrawsTheWayItPrints.agrees (AValueOfAStoredType.some (Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1))) =
    "DIFF fluid=Some(1) printer=Option.Some(1)"


module ADictKeyIsAValue =
  // A dict cannot be built from Dark at all: a runtime dict key is a whole value, and Dark's own `Dict`
  // is keyed by text, so there is no expression in this file that produces one. Which is exactly how the
  // bug survived -- Dark checks a call when it RUNS it, and nothing had ever run this branch.
  //
  // `dictPairNode` took the key as a `String`. It compiled, every probe I could write passed, and it
  // crashed the first time a real dict reached it: "expects String, but got Dval (DString("j"))". Found
  // by opening a dict that already existed rather than by constructing one.
  //
  // So the NODE is pinned here, which is the half that is reachable. The key is a slot holding its own
  // document, which is why a string key draws its own quotes and comes out `{ "j": 2 }`, the way the
  // printer writes it.
  let pair (k: String) (v: Int) : Darklang.Fluid.Slot =
    Darklang.Fluid.Slot.Filled(
      Darklang.Fluid.Prims.dictPairNode
        (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Prims.stringNode k))
        (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Prims.intNode (Stdlib.Int.toString v))))

  let drawn (pairs: List<Darklang.Fluid.Slot>) : String =
    Darklang.Fluid.Debug.render
      (Darklang.Fluid.App.defaultRegistry ())
      70
      (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Prims.dictNode pairs))

  (ADictKeyIsAValue.drawn [ ADictKeyIsAValue.pair "k" 1 ]) = "{ \"k\": 1 }"
  (ADictKeyIsAValue.drawn [ ADictKeyIsAValue.pair "j" 2, ADictKeyIsAValue.pair "k" 1 ]) = "{ \"j\": 2, \"k\": 1 }"

  // An empty one is `{}`, not `{  }`. Both braces carry a space when there are entries between them, and
  // both spaces survive when there are none.
  (ADictKeyIsAValue.drawn []) = "{}"


module SomeValuesHaveNoWrittenForm =
  // A function, a database, a blob, a stream. Each draws what it is rather than drawing nothing, and each
  // refuses to be rebuilt, because there is nothing here to rebuild from.
  let drawn (source: String) : String =
    Darklang.Fluid.Debug.render
      (Darklang.Fluid.App.defaultRegistry ())
      70
      (Darklang.Fluid.Slot.Filled(Darklang.Fluid.Prims.opaqueNode source))

  (SomeValuesHaveNoWrittenForm.drawn "<function>") = "<function>"
  (SomeValuesHaveNoWrittenForm.drawn "<db users>") = "<db users>"


module AListOfRecordsIsAGrid =
  // The one place a value document deliberately draws something the printer would not write, and the
  // reason to have a value document at all.
  //
  //     [Log { reps = 20; note = "am" }, Log { reps = 15; note = "pm" }]
  //
  // is a spreadsheet that has been written out as source. A person filling that in wants the grid, and
  // `Piece.Table` has been able to draw one since early on -- reachable only from a hand-written demo
  // kind, which is a poor place to keep the answer to "can a table be seen as a table". A record
  // declaration already says what the columns are, so this needed nothing written: the columns ARE the
  // field names and the rows ARE the records, whose slots are named the same way.
  let bid () : Uuid = Darklang.SCM.Branch.mainBranchId

  let errType () : Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName =
    match
      Darklang.LanguageTools.PackageManager.Type.find
        (AListOfRecordsIsAGrid.bid ())
        (Darklang.LanguageTools.ProgramTypes.parsePackageLocation "Darklang.Stdlib.Cli.Posix.Error")
    with
    | Some h ->
      Darklang.LanguageTools.RuntimeTypes.FQTypeName.FQTypeName.Package(
        Darklang.LanguageTools.RuntimeTypes.Hash.Hash(Darklang.LanguageTools.ProgramTypes.hashToString h))
    | None -> Builtin.testDerrorMessage "Posix.Error is not in the store"

  let row (n: Int) (m: String) : Darklang.LanguageTools.RuntimeTypes.Dval =
    Darklang.LanguageTools.RuntimeTypes.Dval.DRecord(
      AListOfRecordsIsAGrid.errType (),
      AListOfRecordsIsAGrid.errType (),
      [],
      Stdlib.Dict.fromListOverwritingDuplicates
        [ ("errno", Darklang.LanguageTools.RuntimeTypes.Dval.DInt n),
          ("message", Darklang.LanguageTools.RuntimeTypes.Dval.DString m) ])

  let listOf (vs: List<Darklang.LanguageTools.RuntimeTypes.Dval>) : Darklang.LanguageTools.RuntimeTypes.Dval =
    Darklang.LanguageTools.RuntimeTypes.Dval.DList(
      Darklang.LanguageTools.RuntimeTypes.ValueType.Unknown, vs)

  let drawn (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    let node = Darklang.Fluid.Value.ofDval (AListOfRecordsIsAGrid.bid ()) v
    Darklang.Fluid.Debug.render
      (Darklang.Fluid.App.registryForValue (AListOfRecordsIsAGrid.bid ()) node)
      70
      (Darklang.Fluid.Slot.Filled node)

  // A header, and every column as wide as its widest cell. That measuring pass is what no Wadler group
  // can do: a group knows its own width and nothing about its siblings.
  (AListOfRecordsIsAGrid.drawn
    (AListOfRecordsIsAGrid.listOf
      [ AListOfRecordsIsAGrid.row 1 "a", AListOfRecordsIsAGrid.row 22 "bb" ])) =
    "errno  message\n1      \"a\"\n22     \"bb\""

  // A list of anything else stays a list, and so does a list whose records DISAGREE about their type.
  // The grid is a claim that every row has the same columns.
  (AListOfRecordsIsAGrid.drawn
    (AListOfRecordsIsAGrid.listOf
      [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1,
        Darklang.LanguageTools.RuntimeTypes.Dval.DInt 2 ])) = "[1, 2]"

  (AListOfRecordsIsAGrid.drawn
    (AListOfRecordsIsAGrid.listOf
      [ AListOfRecordsIsAGrid.row 1 "a", Darklang.LanguageTools.RuntimeTypes.Dval.DInt 5 ])) =
    "[Error { errno = 1; message = \"a\" }, 5]"

  // An empty list has no rows to read a type off, so there is no grid to draw.
  (AListOfRecordsIsAGrid.drawn (AListOfRecordsIsAGrid.listOf [])) = "[]"

  // The kind is bracketed so it cannot collide with a real type: a package location has no `[` in it.
  // It has to be a kind of its own, because a spec is found BY kind and a list of integers must go on
  // drawing as a list.
  (Darklang.Fluid.Derive.tableRowTypeName "[Acme.Log]") = Stdlib.Option.Option.Some "Acme.Log"
  (Darklang.Fluid.Derive.tableRowTypeName "Acme.Log") = Stdlib.Option.Option.None

  // Drawing only. The value it came from and the value it goes back to are the same `DList` a plain
  // list would give, which is what makes the grid a reading of the document rather than a second one.
  let rt (v: Darklang.LanguageTools.RuntimeTypes.Dval) : String =
    match
      Darklang.Fluid.Value.toDval
        (AListOfRecordsIsAGrid.bid ())
        (Darklang.Fluid.Value.ofDval (AListOfRecordsIsAGrid.bid ()) v)
    with
    | Ok back -> if back == v then "same" else "CHANGED"
    | Error e -> "ERR " ++ e

  (AListOfRecordsIsAGrid.rt
    (AListOfRecordsIsAGrid.listOf
      [ AListOfRecordsIsAGrid.row 1 "a", AListOfRecordsIsAGrid.row 22 "bb" ])) = "same"
  (AListOfRecordsIsAGrid.rt (AListOfRecordsIsAGrid.listOf [ AListOfRecordsIsAGrid.row 1 "a" ])) = "same"


module TheGridGoesBothWays =
  // A grid you cannot leave would be a worse default than no grid. The toggle is a KIND change and
  // nothing else: the same items in the same slot, so the two drawings are two readings of one document.
  //
  // Actions, so it is spec data rather than a key the kernel knows. A DSL with its own tabular type gets
  // the same switch by declaring it.
  let runNamed (n: Darklang.Fluid.Node) (nm: String) : String =
    let reg = Darklang.Fluid.App.registryForValue (AListOfRecordsIsAGrid.bid ()) n
    match Darklang.Fluid.Registry.find reg n.kind with
    | Some sp ->
      (match sp.actions |> Stdlib.List.findFirst (fun a -> a.name == nm) with
       | Some a ->
         if Stdlib.Bool.not (a.applies n) then
           "does not apply"
         else
           (match a.run n with
            | Filled n2 -> Darklang.Fluid.Debug.render reg 70 (Darklang.Fluid.Slot.Filled n2)
            | _ -> "not filled")
       | None -> "no action named " ++ nm)
    | None -> "no spec"

  let grid () : Darklang.Fluid.Node =
    Darklang.Fluid.Value.ofDval
      (AListOfRecordsIsAGrid.bid ())
      (AListOfRecordsIsAGrid.listOf
        [ AListOfRecordsIsAGrid.row 1 "a", AListOfRecordsIsAGrid.row 22 "bb" ])

  (TheGridGoesBothWays.runNamed (TheGridGoesBothWays.grid ()) "see as a list") =
    "[\n  Error { errno = 1; message = \"a\" },\n  Error { errno = 22; message = \"bb\" }\n]"

  // And a plain list of records offers the way in, reading the row type off the items, which is the only
  // place it is written down: a list node carries no element type.
  let plainList () : Darklang.Fluid.Node =
    Darklang.Fluid.Prims.listNode
      [ Darklang.Fluid.Slot.Filled(
          Darklang.Fluid.Value.ofDval (AListOfRecordsIsAGrid.bid ()) (AListOfRecordsIsAGrid.row 1 "a")),
        Darklang.Fluid.Slot.Filled(
          Darklang.Fluid.Value.ofDval (AListOfRecordsIsAGrid.bid ()) (AListOfRecordsIsAGrid.row 22 "bb")) ]
      (Darklang.Fluid.Expect.any "item")

  (TheGridGoesBothWays.runNamed (TheGridGoesBothWays.plainList ()) "see as a grid") =
    "errno  message\n1      \"a\"\n22     \"bb\""

  // A list of integers is offered nothing: rows that are not records of one type have no columns.
  (TheGridGoesBothWays.runNamed
    (Darklang.Fluid.Value.ofDval
      (AListOfRecordsIsAGrid.bid ())
      (AListOfRecordsIsAGrid.listOf [ Darklang.LanguageTools.RuntimeTypes.Dval.DInt 1 ]))
    "see as a grid") = "does not apply"


module OneShortenerForDisplayNames =
  // There were four copies of "take the last dotted segment", and a bracketed kind made three of them
  // wrong at once: `[Darklang.Stdlib.Cli.Posix.StatResult]` came out `StatResult]` in the breadcrumb and
  // in the tree, with the opening bracket left on a segment nobody kept.
  //
  // Same drift t88 found in the two hand-written name shorteners. One function now, in the kernel, and
  // `Derive.shortName` is a call to it.
  (Darklang.Fluid.Kind.shortLabel "Darklang.Stdlib.Cli.Posix.StatResult") = "StatResult"
  (Darklang.Fluid.Kind.shortLabel "[Darklang.Stdlib.Cli.Posix.StatResult]") = "[StatResult]"
  (Darklang.Fluid.Kind.shortLabel "Int") = "Int"
  (Darklang.Fluid.Derive.shortName "[Acme.Log]") = "[Log]"

  // A node's display name is its CASE when it has one, whatever its type is called.
  (Darklang.Fluid.Kind.label (Darklang.Fluid.Kind.ofCase "Darklang.Stdlib.Option.Option" "Some")) = "Some"
  (Darklang.Fluid.Kind.label (Darklang.Fluid.Kind.named "[Acme.Log]")) = "[Log]"
  (Darklang.Fluid.Kind.label (Darklang.Fluid.Kind.prim "Int")) = "Int"
