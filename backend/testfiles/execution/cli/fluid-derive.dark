// Specs derived from type declarations, and completion on partials.

module Fixtures =
  let field (name: String) (typ: Darklang.LanguageTools.ProgramTypes.TypeReference) : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.RecordField { name = name; typ = typ; description = "" }

  let colorDecl () : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
      { typeParams = []
        definition =
          Darklang.LanguageTools.ProgramTypes.TypeDeclaration.Definition.Record
            [ field "r" Darklang.LanguageTools.ProgramTypes.TypeReference.TInt
              field "g" Darklang.LanguageTools.ProgramTypes.TypeReference.TInt
              field "name" Darklang.LanguageTools.ProgramTypes.TypeReference.TString ] }

  let enumField (label: Stdlib.Option.Option<String>) (typ: Darklang.LanguageTools.ProgramTypes.TypeReference) : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField { typ = typ; label = label; description = "" }

  let case (name: String) (fields: List<Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumField>) : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.EnumCase { name = name; fields = fields; description = "" }

  let shapeDecl () : Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration =
    Darklang.LanguageTools.ProgramTypes.TypeDeclaration.TypeDeclaration
      { typeParams = []
        definition =
          Darklang.LanguageTools.ProgramTypes.TypeDeclaration.Definition.Enum
            [ case "Circle" [ enumField (Stdlib.Option.Option.Some "radius") Darklang.LanguageTools.ProgramTypes.TypeReference.TInt ]
              case "Cube" [ enumField Stdlib.Option.Option.None Darklang.LanguageTools.ProgramTypes.TypeReference.TInt ]
              case "Point" [] ] }

  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.flatten
        [ Darklang.Fluid.Prims.specs ()
          Darklang.Fluid.Derive.specsFor "Acme.Color" (colorDecl ())
          Darklang.Fluid.Derive.specsFor "Acme.Shape" (shapeDecl ()) ])

  let colorHole () : Darklang.Fluid.Slot =
    Darklang.Fluid.Slot.Empty(Darklang.Fluid.Expect.ofKind (Darklang.Fluid.Kind.named "Acme.Color") "Color")

  let shapeHole () : Darklang.Fluid.Slot =
    Darklang.Fluid.Slot.Empty(Darklang.Fluid.Expect.ofKind (Darklang.Fluid.Kind.named "Acme.Shape") "Shape")

  let run (root: Darklang.Fluid.Slot) (keys: List<String>) : String =
    Darklang.Fluid.Test.run (reg ()) root 80 keys


module Records =
  // `{` into a hole expecting a record makes the record with every field a hole, caret on the first.
  //
  // One line when it fits. This used to be vertical ALWAYS for any record with more than one field, on
  // the bias that structure you can scan down a column beats structure packed onto a line; reversed on
  // Stachu's call so a DERIVED editor and the printer agree. That agreement is the point of the whole
  // exercise: a generated editor laying out differently from the hand-written ones is the exact drift
  // this design exists to stop.
  (Fixtures.run (Fixtures.colorHole ()) [ "{" ]) = "Color { r = ~⟨r⟩; g = ⟨g⟩; name = ⟨name⟩ }"

  // Fields know their types: digits make Ints, a quote makes a String.
  (Fixtures.run (Fixtures.colorHole ()) [ "{", "1", "<Tab>", "2", "<Tab>", "\"", "x" ]) =
    "Color { r = 1; g = 2; name = \"x~\" }"

  // The record's name is a completion too, for people who type it.
  (Fixtures.run (Fixtures.colorHole ()) [ "C", "<Enter>" ]) = "Color { r = ~⟨r⟩; g = ⟨g⟩; name = ⟨name⟩ }"


module Enums =
  // Letters into an enum hole start a partial; the cases that match are the candidates.
  (Fixtures.run (Fixtures.shapeHole ()) [ "C" ]) = "C~"

  // Enter takes the first candidate and lands on its first hole.
  (Fixtures.run (Fixtures.shapeHole ()) [ "C", "<Enter>" ]) = "Circle(~⟨radius⟩)"

  (Fixtures.run (Fixtures.shapeHole ()) [ "C", "<Enter>", "5" ]) = "Circle(5~)"

  // Down picks the next candidate. An unlabelled field is named by position.
  (Fixtures.run (Fixtures.shapeHole ()) [ "C", "<Down>", "<Enter>" ]) = "Cube(~⟨f0⟩)"

  // Tab commits as well.
  (Fixtures.run (Fixtures.shapeHole ()) [ "cu", "<Tab>" ]) = "Cube(~⟨f0⟩)"

  // A case with no fields anchors the caret on its name.
  (Fixtures.run (Fixtures.shapeHole ()) [ "P", "<Enter>" ]) = "~Point"

  // No match: the partial stays and Enter does nothing.
  (Fixtures.run (Fixtures.shapeHole ()) [ "x", "<Enter>" ]) = "x~"

  // Matching is case-insensitive.
  (Fixtures.run (Fixtures.shapeHole ()) [ "p", "<Enter>" ]) = "~Point"


module Lists =
  (Fixtures.run (Darklang.Fluid.Slot.Empty(Darklang.Fluid.Derive.expectFor (Darklang.LanguageTools.ProgramTypes.TypeReference.TList Darklang.LanguageTools.ProgramTypes.TypeReference.TInt) "xs")) [ "[" ]) =
    "[~⟨item⟩]"

  (Fixtures.run (Darklang.Fluid.Slot.Empty(Darklang.Fluid.Derive.expectFor (Darklang.LanguageTools.ProgramTypes.TypeReference.TList Darklang.LanguageTools.ProgramTypes.TypeReference.TInt) "xs")) [ "[", "7" ]) =
    "[7~]"
