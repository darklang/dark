// ProgramTypes through Fluid: parse -> toDoc -> fromDoc prints the same program, and editing an
// expression hole builds real expressions.

module Fixtures =
  let reg () : Darklang.Fluid.Registry =
    Darklang.Fluid.Registry.ofList
      (Stdlib.List.append (Darklang.Fluid.Prims.specs ()) (Darklang.Fluid.PT.specs ()))

  let ctx () : Darklang.PrettyPrinter.ProgramTypes.Context = Darklang.Fluid.PT.printerContext ()

  /// The program after a trip through the document, as the printer writes it; or the failure.
  let roundTrip (src: String) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e ->
      match Darklang.Fluid.PT.fromDoc (Darklang.Fluid.PT.toDoc e) with
      | Ok e2 -> Darklang.PrettyPrinter.ProgramTypes.expr (ctx ()) e2
      | Error err -> "ERR " ++ err
    | Error err -> "PARSE ERR " ++ err

  /// What the printer writes for the original, so the two sides compare like for like.
  let printed (src: String) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.PrettyPrinter.ProgramTypes.expr (ctx ()) e
    | Error err -> "PARSE ERR " ++ err

  let render (src: String) (width: Int) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Debug.render (reg ()) width (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e))
    | Error err -> "PARSE ERR " ++ err

  let exprHole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")

  let run (keys: List<String>) : String = Darklang.Fluid.Test.run (reg ()) (exprHole ()) 60 keys


module RoundTrips =
  (Fixtures.roundTrip "42") = (Fixtures.printed "42")
  (Fixtures.roundTrip "\"hi\"") = (Fixtures.printed "\"hi\"")
  (Fixtures.roundTrip "[1, 2, 3]") = (Fixtures.printed "[1, 2, 3]")
  (Fixtures.roundTrip "(1, \"a\", true)") = (Fixtures.printed "(1, \"a\", true)")
  (Fixtures.roundTrip "let x = 1 + 2\nx * 3") = (Fixtures.printed "let x = 1 + 2\nx * 3")
  (Fixtures.roundTrip "if x > 2 then [x, 3] else (1, \"two\")") = (Fixtures.printed "if x > 2 then [x, 3] else (1, \"two\")")
  (Fixtures.roundTrip "if x then 1") = (Fixtures.printed "if x then 1")
  (Fixtures.roundTrip "fun a b -> a ++ b") = (Fixtures.printed "fun a b -> a ++ b")
  (Fixtures.roundTrip "let (a, b) = (1, 2)\na") = (Fixtures.printed "let (a, b) = (1, 2)\na")
  (Fixtures.roundTrip "3.25") = (Fixtures.printed "3.25")
  (Fixtures.roundTrip "-3.25") = (Fixtures.printed "-3.25")

  (Fixtures.roundTrip "match x with\n| 1 -> \"one\"\n| _ -> \"other\"") = (Fixtures.printed "match x with\n| 1 -> \"one\"\n| _ -> \"other\"")
  (Fixtures.roundTrip "match xs with\n| [] -> 0\n| h :: t -> h\n| (a, b) -> a\n| Some v when v > 1 -> v\n| 1 | 2 -> 3") =
    (Fixtures.printed "match xs with\n| [] -> 0\n| h :: t -> h\n| (a, b) -> a\n| Some v when v > 1 -> v\n| 1 | 2 -> 3")
  (Fixtures.roundTrip "$\"a {b} c\"") = (Fixtures.printed "$\"a {b} c\"")
  (Fixtures.roundTrip "xs |> Stdlib.List.map (fun x -> x + 1) |> Stdlib.List.length") =
    (Fixtures.printed "xs |> Stdlib.List.map (fun x -> x + 1) |> Stdlib.List.length")
  (Fixtures.roundTrip "Stdlib.Option.Option.Some 5") = (Fixtures.printed "Stdlib.Option.Option.Some 5")
  (Fixtures.roundTrip "Dict { a = 1; b = 2 }") = (Fixtures.printed "Dict { a = 1; b = 2 }")
  (Fixtures.roundTrip "r.field") = (Fixtures.printed "r.field")
  (Fixtures.roundTrip "Stdlib.List.length [ 1 ]") = (Fixtures.printed "Stdlib.List.length [ 1 ]")


module Vertical =
  // A list of scalars stays on one line; it's readable and compact.
  (Fixtures.render "[1, 2, 3]" 60) = "[1, 2, 3]"

  // A record literal is laid out vertically (its fields break unconditionally), and because a tall child
  // forces its container to break, a list of records goes vertical too.
  (Fixtures.render "Stdlib.Option.Option.Some 5" 60) = "Option.Some(5)"


module Parens =
  // Nesting is precedence-aware and matches the pretty-printer: arguments and operands get exactly the
  // parentheses they need, no more.
  let show (src: String) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Debug.render (Fixtures.reg ()) 60 (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e))
    | Error _ -> "parse err"

  (Parens.show "1 + 2 * 3") = "1 + 2 * 3"
  (Parens.show "(1 + 2) * 3") = "(1 + 2) * 3"
  (Parens.show "f (g x) (a + b)") = "f (g x) (a + b)"
  (Parens.show "a && (b || c)") = "a && (b || c)"
  // A compound argument (a lambda) is parenthesised, and the fn name is shortened.
  (Parens.show "Stdlib.List.map xs (fun x -> x + 1)") = "Stdlib.List.map xs (fun x -> x + 1)"

  // A swallowing construct in a keyword position (a match as an if condition, an if as a match
  // scrutinee) is parenthesised so the trailing keyword can't run onto it -- better than the printer.
  (Parens.show "if (match x with\n| _ -> b) then 1 else 2") = "if (match x with\n| _ -> b) then\n  1\nelse\n  2"
  // A plain condition needs no parens.
  (Parens.show "if a then 1 else 2") = "if a then\n  1\nelse\n  2"


module Rendering =
  (Fixtures.render "let x = 1 + 2\nif x > 2 then [x, 3] else (1, \"two\")" 60) =
    "let x = 1 + 2\nif x > 2 then\n  [x, 3]\nelse\n  (1, \"two\")"

  // An `if` without `else` shows the optional hole, dimly labelled.
  (Fixtures.render "if x then 1" 60) = "if x then\n  1\nelse\n  ⟨else⟩"


module Editing =
  (Fixtures.run [ "4", "2" ]) = "42~"
  (Fixtures.run [ "\"", "h", "i" ]) = "\"hi~\""
  (Fixtures.run [ "[", "1" ]) = "[1~]"
  (Fixtures.run [ "(", "1", "<Tab>", "2" ]) = "(1, 2~)"

  // Keywords come from completion: `let` then Enter makes a let with the caret on the name.
  (Fixtures.run [ "l", "e", "<Enter>" ]) = "let ~⟨name⟩ = ⟨value⟩\n⟨body⟩"

  // Letters into a pattern hole start a variable; Tab moves to the value.
  (Fixtures.run [ "l", "e", "<Enter>", "x", "y", "<Tab>", "7" ]) = "let xy = 7~\n⟨body⟩"

  (Fixtures.run [ "i", "f", "<Enter>" ]) = "if ~⟨cond⟩ then\n  ⟨then⟩\nelse\n  ⟨else⟩"

  (Fixtures.run [ "f", "u", "<Enter>", "a", "<Tab>", "1" ]) = "fun a -> 1~"

  // An operator after an expression wraps it; more operator characters extend the operator; the first
  // other character moves on to the right-hand hole.
  (Fixtures.run [ "1", "+" ]) = "1 +~ ⟨right⟩"
  (Fixtures.run [ "1", "+", "2" ]) = "1 + 2~"
  (Fixtures.run [ "1", "=", "=", "2" ]) = "1 == 2~"
  (Fixtures.run [ "1", "+", "2", "*", "3" ]) = "1 + 2 * 3~"
  (Fixtures.run [ "\"", "a", "<Right>", "+", "+", "\"", "b" ]) = "\"a\" ++ \"b~\""
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "1", "+", "2", "*", "3" ]) = "1 + 2 * 3"

  // `|` after an expression starts a pipe with a hole for the first step.
  (Fixtures.run [ "xs", "|" ]) = "xs\n|> ~⟨step⟩"

  // Multi-grapheme input (a paste) moves the caret past all of it.
  (Fixtures.run [ "hello" ]) = "hello~"
  (Fixtures.run [ "\"", "hello", " world" ]) = "\"hello world~\""

  // An identifier becomes a variable when you type past it; a pipe step completes from the package
  // tree, with the piped argument left out of the placeholders.
  (Fixtures.run [ "xs", "|" ]) = "xs\n|> ~⟨step⟩"
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "xs", "|", "List.len", "<Enter>" ]) =
    "xs |> Stdlib.List.length"
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "xs", "|", "List.map", "<Enter>", "fu", "<Enter>", "x", "<Tab>", "x", "+", "1" ]) =
    "xs |> Stdlib.List.map (fun x -> x + 1)"
  // A trailing identifier resolves when you leave it (Esc, or save).
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "x", "+", "y" ]) = "ERR unresolved: y"
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "x", "+", "y", "<Esc>" ]) = "x + y"
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "le", "<Enter>", "n", "<Tab>", "1", "<Tab>", "n", "<Enter>" ]) =
    "let n = 1\nn"

  // Names bound by an enclosing let, lambda, or match arm are offered in scope and complete.
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "l", "e", "<Enter>", "sum", "<Tab>", "1", "<Tab>", "su", "<Enter>" ]) =
    "let sum = 1\nsum"
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "fu", "<Enter>", "acc", "<Tab>", "acc", "+", "1", "<Esc>" ]) =
    "(fun acc -> acc + 1)"
  // A pasted identifier (many graphemes at once) becomes a variable, same as typing it.
  (Fixtures.run [ "fu", "<Enter>", "acc", "<Tab>" ]) = "fun acc -> ~⟨body⟩"

  // The palette (`:` in NAV) offers structural actions on the node under the caret.
  (Fixtures.run [ "4", "2", "<Esc>", ":", "m", "a", "t", "c", "h", "<Enter>" ]) = "match ~42 with\n| ⟨pattern⟩ -> ⟨rhs⟩"
  (Fixtures.run [ "4", "2", "<Esc>", ":", "<Enter>" ]) = "let ~⟨name⟩ = ⟨value⟩\n42"
  (Fixtures.run [ "4", "2", "<Esc>", ":", "p", "i", "p", "e", "<Enter>" ]) = "~42\n|> ⟨step⟩"
  // Esc closes the palette without changing anything.
  (Fixtures.run [ "4", "2", "<Esc>", ":", "<Esc>" ]) = "~42"

  // NAV `y` yanks the node under the caret; `p` puts that subtree into another slot.
  (Fixtures.run [ "(", "7", "<Tab>", "<Esc>", "k", "y", "j", "p" ]) = "(7, ~7)"

  // `match` comes with one case; letters into the pattern hole start a variable, `[` a list pattern.
  (Fixtures.run [ "m", "a", "<Enter>" ]) = "match ~⟨arg⟩ with\n| ⟨pattern⟩ -> ⟨rhs⟩"
  (Fixtures.run [ "m", "a", "<Enter>", "x", "<Tab>", "[", "<Tab>", "0" ]) = "match x with\n| [⟨pattern⟩] -> 0~"

  // A finished edit is a real expression.
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "l", "e", "<Enter>", "x", "<Tab>", "7", "<Tab>", "[", "1" ]) =
    "let x = 7\n[1]"

  // ... and an unfinished one says what is missing.
  (Darklang.Fluid.PT.Test.program (Fixtures.reg ()) (Fixtures.exprHole ()) [ "l", "e", "<Enter>", "x" ]) =
    "ERR hole: value"


module NamesReadTheWayThePrinterWritesThem =
  // Fluid drew fully-qualified names where the printer shortens: `Darklang.Stdlib.Option.Option<'a>` for a
  // parameter the printer writes `Option<'a>`, long enough to break the line mid-type. displayName defers
  // to the pretty-printer's own shortenName now, so there is one answer rather than two.
  (Darklang.Fluid.PT.displayName "Darklang.Stdlib.Option.Option") = "Option"
  (Darklang.Fluid.PT.displayName "Darklang.Stdlib.Result.Result") = "Result"
  (Darklang.Fluid.PT.displayName "Darklang.Stdlib.List.length") = "Stdlib.List.length"

  // The shortening is on the way to the SCREEN, not into the document: the full name is the thing's
  // identity, and storing the short one made `Result.Ok` come back as `Result..Ok`. So both have to hold:
  // the screen is short, and the round-trip is unchanged.
  let screen (src: String) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e ->
      Darklang.Fluid.Debug.render (Darklang.Fluid.App.defaultRegistry ()) 80 (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e))
    | Error err -> "ERR " ++ err

  let roundTrip (src: String) : String =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e ->
      (match Darklang.Fluid.PT.fromDoc (Darklang.Fluid.PT.toDoc e) with
       | Ok e2 -> Darklang.PrettyPrinter.ProgramTypes.expr (Darklang.Fluid.PT.printerContext ()) e2
       | Error err -> "ERR " ++ err)
    | Error err -> "ERR " ++ err

  (NamesReadTheWayThePrinterWritesThem.screen "Ok(1)") = "Result.Ok(1)"
  (NamesReadTheWayThePrinterWritesThem.roundTrip "Ok(1)") = "Result.Ok(1)"
  (NamesReadTheWayThePrinterWritesThem.screen "Stdlib.Option.Option.Some(1)") = "Option.Some(1)"
  (NamesReadTheWayThePrinterWritesThem.roundTrip "Stdlib.Option.Option.Some(1)") = "Option.Some(1)"
  (NamesReadTheWayThePrinterWritesThem.screen "nums |> Stdlib.List.filter f") = "nums\n|> Stdlib.List.filter f"
  (NamesReadTheWayThePrinterWritesThem.roundTrip "nums |> Stdlib.List.filter f") = "nums |> Stdlib.List.filter f"


module PrecedenceIsShared =
  // Fluid used to carry its own copy of the printer's precedence: the same operator table, the same two
  // named powers, and the same two rules for when an operand or an argument needs parens. Two hand-written
  // copies of one language fact drift -- the name shorteners already had -- and an editor that disagrees
  // with the printer about parentheses is worse than either. The numbers and the rules are the printer's
  // now, and Fluid only says what a DOCUMENT NODE's power is.
  let ops () : List<String> =
    [ "||", "&&", "==", "!=", "<", ">", "<=", ">=", "+", "-", "++", "*", "/", "%", "^" ]

  // The editor's answer IS the printer's answer, for every operator it can draw.
  (PrecedenceIsShared.ops ()
   |> Stdlib.List.all (fun op ->
     (Darklang.Fluid.Project.infixPowerOf op) == (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText op))) = true

  // And the table itself is unchanged, stated once so a careless edit to it has to be deliberate.
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "||") = (1, false)
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "&&") = (2, false)
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "==") = (3, false)
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "+") = (5, false)
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "*") = (6, false)
  (Darklang.PrettyPrinter.ProgramTypes.infixPowerOfText "^") = (7, true)

  // The enum path goes through the same table, so `infixPower` and the editor cannot disagree.
  (Darklang.PrettyPrinter.ProgramTypes.infixPower
    (Darklang.LanguageTools.ProgramTypes.Infix.InfixFnCall Darklang.LanguageTools.ProgramTypes.InfixFnName.ArithmeticPower)) = (7, true)
  (Darklang.PrettyPrinter.ProgramTypes.infixPower
    (Darklang.LanguageTools.ProgramTypes.Infix.BinOp Darklang.LanguageTools.ProgramTypes.BinaryOperation.BinOpOr)) = (1, false)

  // The operand rule, stated over powers alone: looser always parenthesises, equal depends on the side.
  (Darklang.PrettyPrinter.ProgramTypes.operandNeedsParensAt 5 6 false false) = true
  (Darklang.PrettyPrinter.ProgramTypes.operandNeedsParensAt 6 5 false false) = false
  (Darklang.PrettyPrinter.ProgramTypes.operandNeedsParensAt 5 5 false true) = true
  (Darklang.PrettyPrinter.ProgramTypes.operandNeedsParensAt 5 5 false false) = false
  (Darklang.PrettyPrinter.ProgramTypes.operandNeedsParensAt 7 7 true false) = true

  // The argument rule takes "does this form bracket itself" as an ANSWER rather than baking it in: the
  // printer's lambda does, Fluid's draws bare and gets its parens from the rule. Same result either way.
  (Darklang.PrettyPrinter.ProgramTypes.argNeedsParensAt 0 false true) = false
  (Darklang.PrettyPrinter.ProgramTypes.argNeedsParensAt 0 false false) = true
  (Darklang.PrettyPrinter.ProgramTypes.argNeedsParensAt 100 true false) = true

  // What the whole thing is for: the editor and the printer put parentheses in the same places.
  let sameParens (src: String) : Bool =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e ->
      let strip (s: String) : String =
        s |> Stdlib.String.toList |> Stdlib.List.filter (fun c -> (Stdlib.Char.toString c) != "\n" && (Stdlib.Char.toString c) != " ")
          |> Stdlib.List.map (fun c -> Stdlib.Char.toString c) |> Stdlib.String.join ""
      (strip (Darklang.PrettyPrinter.ProgramTypes.expr (Darklang.Fluid.PT.printerContext ()) e))
      == (strip (Darklang.Fluid.Debug.render (Darklang.Fluid.App.defaultRegistry ()) 80 (Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e))))
    | Error _ -> false

  (PrecedenceIsShared.sameParens "1 + 2 * 3") = true
  (PrecedenceIsShared.sameParens "(1 + 2) * 3") = true
  (PrecedenceIsShared.sameParens "a - b - c") = true
  (PrecedenceIsShared.sameParens "2 ^ 3 ^ 2") = true
  (PrecedenceIsShared.sameParens "a || b && c") = true
  (PrecedenceIsShared.sameParens "f (g x) (a + b)") = true
  (PrecedenceIsShared.sameParens "(if a then 1 else 2) + 3") = true


module RecordsCanBeBuilt =
  // Record literals had no build path: ERecord needs a resolved type HASH -- typeNameResolution refuses an
  // empty one -- so you cannot get there by typing punctuation the way a list or a tuple does. The type
  // has to be RESOLVED first, which makes COMPLETION the build path rather than a `{` trigger. That pays
  // for itself: the search hands back the declaration, so the shell arrives with the real field names in
  // it and the caret in the first value.
  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expression")
  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()

  // The candidate names the type and summarises its fields, so the menu says what you are about to get.
  ((Darklang.Fluid.PT.recordCandidates "Size" |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.label))
   |> Stdlib.Option.withDefault "none") = "Stdlib.Cli.Tui.Size"
  ((Darklang.Fluid.PT.recordCandidates "Size" |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.detail))
   |> Stdlib.Option.withDefault "none") = "{ width, height }"

  // A capitalised name is a TYPE in this language, so a record leads the menu there. Without this, `Size`
  // offered `Stdlib.Dict.size` first and Enter built a call.
  ((Darklang.Fluid.PT.completeExpr (Darklang.Fluid.PT.exprExpect "e") "Size"
    |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.label)) |> Stdlib.Option.withDefault "none") = "Stdlib.Cli.Tui.Size"

  // The shell, with the declaration's field names and the caret in the first value.
  (Darklang.Fluid.Test.run (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ()) 60
    [ "S", "i", "z", "e", "<Enter>" ]) =
    "Stdlib.Cli.Tui.Size {\n  width = ~⟨width⟩;\n  height = ⟨height⟩\n}"

  // Filled in and lowered, which is the whole point: this is a real ERecord with a resolved type.
  (Darklang.Fluid.PT.Test.program (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ())
    [ "S", "i", "z", "e", "<Enter>", "8", "0", "<Tab>", "2", "4", "<Esc>", "<Esc>" ]) =
    "Stdlib.Cli.Tui.Size { width = 80; height = 24 }"

  // An existing record still round-trips through the document unchanged.
  ((match Darklang.LanguageTools.Parser.Parse.parsePTExpr "Stdlib.Cli.Tui.Size { width = 80; height = 24 }" with
    | Ok e ->
      (match Darklang.Fluid.PT.fromDoc (Darklang.Fluid.PT.toDoc e) with
       | Ok e2 -> Darklang.PrettyPrinter.ProgramTypes.expr (Darklang.Fluid.PT.printerContext ()) e2
       | Error err -> "ERR " ++ err)
    | Error err -> "parse ERR " ++ err)) = "Stdlib.Cli.Tui.Size { width = 80; height = 24 }"

  // And the type reads the way the printer writes it, not fully qualified.
  (Stdlib.String.contains
    (Darklang.Fluid.Test.run (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ()) 60 [ "S", "i", "z", "e", "<Enter>" ])
    "Darklang.Stdlib") = false


module EnumConstructorsCanBeBuilt =
  // The gap found in t86: `Ok(1)` and `None` in an EXPRESSION had no build path, so an uppercase name
  // became a variable -- `None` lowered to a variable named None, which prints fine and fails at
  // resolution. Same wall as records (EEnum carries a type name and hash), and the same answer, except
  // the search cannot do the matching: you type a CASE name and the store indexes types by their own
  // name, so the enum declarations are read and the cases matched here.
  ((Darklang.Fluid.PT.enumCandidates "Ok" |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.label))
   |> Stdlib.Option.withDefault "none") = "Result.Ok"
  ((Darklang.Fluid.PT.enumCandidates "Ok" |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.detail))
   |> Stdlib.Option.withDefault "none") = "case of 1"

  // A case's fields become holes, so `Ok` lands you inside the constructor; a nullary case has none.
  (Darklang.Fluid.Test.run (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ()) 60 [ "O", "k", "<Enter>" ]) =
    "Result.Ok(~⟨field⟩)"
  (Darklang.Fluid.PT.Test.program (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ())
    [ "O", "k", "<Enter>", "1", "<Esc>", "<Esc>" ]) = "Result.Ok(1)"
  (Darklang.Fluid.PT.Test.program (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ())
    [ "N", "o", "n", "e", "<Enter>", "<Esc>", "<Esc>" ]) = "Option.None"

  // Two characters is enough for a case, because `Ok` is two. The general search still wants three.
  ((Darklang.Fluid.PT.completeExpr (Darklang.Fluid.PT.exprExpect "e") "Ok"
    |> Stdlib.List.head |> Stdlib.Option.map (fun c -> c.label)) |> Stdlib.Option.withDefault "none") = "Result.Ok"

  // It is the LAST segment that says type or function: `Stdlib.List.length` starts with a capital too,
  // and routing it down the type path lost its function candidates entirely.
  (Darklang.Fluid.PT.looksLikeATypeName "Stdlib.Cli.Tui.Size") = true
  (Darklang.Fluid.PT.looksLikeATypeName "Stdlib.List.length") = false
  (Darklang.Fluid.PT.looksLikeATypeName "Ok") = true
  (Darklang.Fluid.PT.looksLikeATypeName "nums") = false
  (Darklang.Fluid.PT.Test.program (RecordsCanBeBuilt.reg ()) (RecordsCanBeBuilt.hole ())
    [ "S", "t", "d", "l", "i", "b", ".", "L", "i", "s", "t", ".", "l", "e", "n", "g", "t", "h", " ", "n", "u", "m", "s", "<Esc>", "<Esc>" ]) =
    "Stdlib.List.length nums"


module NewShapesCompose =
  // Records and constructors have to work WITH everything that was already there, not just on their own.
  // These are the compositions checked by hand after building them; nothing here found a bug, which is
  // worth having written down as much as a fix would be.
  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expression")
  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()

  // A record bound in a let, and then used.
  (Darklang.Fluid.PT.Test.program (NewShapesCompose.reg ()) (NewShapesCompose.hole ())
    [ "l", "e", "t", " ", "s", " ", "S", "i", "z", "e", "<Enter>", "8", "0", "<Tab>", "2", "4", "<Tab>"
      "s", ".", "w", "i", "d", "t", "h", " ", "<Esc>", "<Esc>" ]) =
    "let s = Stdlib.Cli.Tui.Size { width = 80; height = 24 }\ns.width"

  // Constructor PATTERNS and constructor VALUES in the same program: the pattern side has worked since the
  // uppercase-means-a-case fix, and the expression side since the completion one.
  (Darklang.Fluid.PT.Test.program (NewShapesCompose.reg ()) (NewShapesCompose.hole ())
    [ "m", "a", "t", "c", "h", " ", "r", " ", "w", "i", "t", "h", " ", "O", "k", "(", "v", "<Tab>", "v"
      "<Enter>", "E", "r", "r", "o", "r", "(", "e", "<Tab>", "0", "<Esc>", "<Esc>" ]) =
    "match r with\n| Ok(v) -> v\n| Error(e) -> 0"

  // They nest: a record inside a list, and a record inside a constructor.
  (Darklang.Fluid.PT.Test.program (NewShapesCompose.reg ()) (NewShapesCompose.hole ())
    [ "[", "S", "i", "z", "e", "<Enter>", "8", "0", "<Tab>", "2", "4", "<Esc>", "<Esc>" ]) =
    "[Stdlib.Cli.Tui.Size { width = 80; height = 24 }]"
  (Darklang.Fluid.PT.Test.program (NewShapesCompose.reg ()) (NewShapesCompose.hole ())
    [ "O", "k", "<Enter>", "S", "i", "z", "e", "<Enter>", "1", "<Tab>", "2", "<Esc>", "<Esc>" ]) =
    "Result.Ok(Stdlib.Cli.Tui.Size { width = 1; height = 2 })"

  // Undo peels a record field the way it peels anything else.
  (Darklang.Fluid.Test.run (NewShapesCompose.reg ()) (NewShapesCompose.hole ()) 70
    [ "S", "i", "z", "e", "<Enter>", "8", "0", "<Tab>", "2", "4", "<Esc>", "u", "u" ]) =
    "Stdlib.Cli.Tui.Size {\n  width = 80;\n  height = ~⟨height⟩\n}"


module BarStartsTheNextArm =
  // `|` at the end of a match arm's rhs starts the next arm, which is how anyone writing the source would
  // type it. It used to build a PIPE, so the natural keystroke gave you `2 |> ⟨step⟩` inside the arm.
  //
  // Which character does this is not written down here: the kernel asks the SPEC what it draws before each
  // item of the field (`EachWith("cases", [ Punct "|", Space ], ...)`), so a DSL that separates its items
  // some other way gets the same behaviour without touching the kernel.
  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")
  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()

  /// `match x with | 1 -> 2`, then whatever else you type.
  let arm (extra: List<String>) : String =
    Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
      (Stdlib.List.append [ "ma", "<Enter>", "x", "<Tab>", "1", "<Tab>", "2" ] extra)

  (BarStartsTheNextArm.arm []) = "match x with\n| 1 -> 2~"
  (BarStartsTheNextArm.arm [ "|" ]) = "match x with\n| 1 -> 2\n| ~⟨pattern⟩ -> ⟨rhs⟩"
  (BarStartsTheNextArm.arm [ "|", "3" ]) = "match x with\n| 1 -> 2\n| 3~ -> ⟨rhs⟩"
  (BarStartsTheNextArm.arm [ "|", "3", "<Tab>", "4", "|", "5", "<Tab>", "6" ]) =
    "match x with\n| 1 -> 2\n| 3 -> 4\n| 5 -> 6~"

  // The half that makes stealing `|` safe. Typing it AGAIN, in the fresh empty arm it just made, means the
  // operator was meant after all -- and the arm goes away rather than being left behind as an empty one.
  // Stateless: `|` is never valid at the start of an empty pattern, and an arm still made entirely of
  // holes is one nothing has been typed into.
  (BarStartsTheNextArm.arm [ "|", "|" ]) = "match x with\n| 1 -> 2 ||~ ⟨right⟩"
  (BarStartsTheNextArm.arm [ "|", "|", "b" ]) = "match x with\n| 1 -> 2 || b~"

  // The same for CONTINUING it into another operator rather than repeating it: `|` then `>` is the pipe it
  // always was, in the arm, not an arm whose pattern starts with `>`.
  (BarStartsTheNextArm.arm [ "|", ">" ]) = "match x with\n| 1 ->\n  2\n  |> ~⟨step⟩"
  (BarStartsTheNextArm.arm [ "|", ">", "f" ]) = "match x with\n| 1 ->\n  2\n  |> f~"

  // Outside a list drawn that way, `|` is untouched: it still builds a pipe, and `||` still builds an
  // infix.
  (Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60 [ "a", "|" ]) =
    "a\n|> ~⟨step⟩"
  (Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
    [ "a", "|", "|", "b" ]) = "a || b~"

  // `|` on a match arm's PATTERN is still an or-pattern. The rule only fires at the END of an item --
  // starting the next one is meaningless anywhere else -- so the pattern spec's own `|` keeps winning.
  (Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
    [ "ma", "<Enter>", "n", "<Tab>", "0", "|" ]) = "match n with\n| 0 | ~⟨pattern⟩ -> ⟨rhs⟩"
  (Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
    [ "ma", "<Enter>", "n", "<Tab>", "0", "|", "1", "|", "2" ]) = "match n with\n| 0 | 1 | 2~ -> ⟨rhs⟩"

  // THE RHS IS NOT ALWAYS A TEXT NODE WITH THE CARET INSIDE IT, which is how the first version of this
  // shipped broken. Type a string and the closing quote leaves the caret AFTER the node; type a list and it
  // leaves you after the LIST, while the last node in the arm is the `1` inside it. The rule lived in the
  // text branch of the typing path, so `| 1 -> 2` made an arm and `| 1 -> "zero"` made a pipe. Every pin
  // above ends its arm with a number, which is why they all passed. Found by writing an ordinary program in
  // the terminal.
  let armEnding (rhs: String) (extra: List<String>) : String =
    Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
      (Stdlib.List.flatten [ [ "ma", "<Enter>", "x", "<Tab>", "1", "<Tab>", rhs ], extra ])

  (BarStartsTheNextArm.armEnding "\"zero\"" [ "|" ]) = "match x with\n| 1 -> \"zero\"\n| ~⟨pattern⟩ -> ⟨rhs⟩"
  (BarStartsTheNextArm.armEnding "[1]" [ "|" ]) = "match x with\n| 1 -> [1]\n| ~⟨pattern⟩ -> ⟨rhs⟩"
  // An arm often ends in a name typed but not yet settled -- a PARTIAL, whose caret is in the SLOT rather
  // than in any text. An empty hole looks the same, and there the lead punct must not add an arm: there is
  // nothing in this one yet. The difference is whether anything has been typed.
  (BarStartsTheNextArm.armEnding "foo" [ "|" ]) = "match x with\n| 1 -> foo\n| ~⟨pattern⟩ -> ⟨rhs⟩"

  // The revision still works from there: the operator applies to the string, not to a new arm.
  (BarStartsTheNextArm.armEnding "\"zero\"" [ "|", "|" ]) = "match x with\n| 1 -> \"zero\" ||~ ⟨right⟩"

  // And a list whose items are separated rather than led keeps its own key: `,` still adds an element.
  (Darklang.Fluid.Test.run (BarStartsTheNextArm.reg ()) (BarStartsTheNextArm.hole ()) 60
    [ "[", "1", ",", "2" ]) = "[1, 2~]"


module EnterDoesNotGrowWhatItJustMade =
  // Enter in a sequence does two jobs: settle what you typed, and start the next item. When the candidate
  // it settles has holes OF ITS OWN the caret is already inside it, so "the next item" meant that node's
  // own list -- `fun` in a function argument committed the lambda, landed in its first parameter, and
  // added a SECOND one. `List.map (fun ⟨param⟩ ⟨param⟩ -> ⟨body⟩)` for typing `fun`.
  //
  // Found by writing an ordinary pipe in the terminal. `\` builds the same lambda through the hole rule
  // rather than the menu and gave one parameter, which is what pinned the blame on Enter.
  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")
  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()
  let run (keys: List<String>) : String =
    Darklang.Fluid.Test.run (EnterDoesNotGrowWhatItJustMade.reg ()) (EnterDoesNotGrowWhatItJustMade.hole ()) 80 keys

  (EnterDoesNotGrowWhatItJustMade.run [ "[", "1", "]", "|", "List.map", "<Enter>", "fun", "<Enter>" ]) =
    "[1]\n|> Stdlib.List.map (fun ~⟨param⟩ -> ⟨body⟩)"

  // The same lambda through the hole rule instead of the menu: it always did the right thing.
  (EnterDoesNotGrowWhatItJustMade.run [ "[", "1", "]", "|", "List.map", "<Enter>", "\\" ]) =
    "[1]\n|> Stdlib.List.map (fun ~⟨param⟩ -> ⟨body⟩)"

  // The half of Enter this must not lose: a candidate with nothing left to fill still commits AND starts
  // the next item, so a list grows as you type it.
  (EnterDoesNotGrowWhatItJustMade.run [ "[", "true", "<Enter>" ]) = "[true, ~⟨item⟩]"
  (EnterDoesNotGrowWhatItJustMade.run [ "[", "1", "<Enter>" ]) = "[1, ~⟨item⟩]"


module SeparatorsComeFromTheSpec =
  // `,` was written into the kernel, in two places, so it was the `,` of a list and nothing else. The
  // character that separates a list's items is something the SPEC draws -- `,` between list elements, `;`
  // between a record's fields -- so the kernel asks the projection, the way it already asks what is drawn
  // BEFORE each item for `|`. A DSL whose lists are separated by `;` gets the key it actually writes.
  let hole () : Darklang.Fluid.Slot = Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect "expr")
  let reg () : Darklang.Fluid.Registry = Darklang.Fluid.App.defaultRegistry ()
  let run (keys: List<String>) : String =
    Darklang.Fluid.Test.run (SeparatorsComeFromTheSpec.reg ()) (SeparatorsComeFromTheSpec.hole ()) 70 keys

  // A record types the way the source reads: `;` goes on to the next FIELD.
  (SeparatorsComeFromTheSpec.run [ "S", "i", "z", "e", "<Enter>", "8", "0", ";", "2", "4" ]) =
    "Stdlib.Cli.Tui.Size {\n  width = 80;\n  height = 24~\n}"

  // ...because a record's fields come from its TYPE. A separator between items that already exist and are
  // not finished means "on to the next one", not "put another one here" -- there is no third field to add.
  // A list is the other way round, and there the next item has nothing left to fill, so it inserts.
  (SeparatorsComeFromTheSpec.run [ "[", "1", ",", "2", ",", "3" ]) = "[1, 2, 3~]"
  (SeparatorsComeFromTheSpec.run [ "(", "1", ",", "2" ]) = "(1, 2~)"


module TuplePatternsAreVisible =
  // `let (a, b) = t` drew as `let ?pattern = t`. The LPTuple spec was registered with `simpleExpr` rather
  // than `simpleLetPat`, so it lived under the EXPRESSION kind and was never found for a LetPattern node.
  // The three lines above it in the spec list use `simpleLetPat` and read the same at a glance.
  //
  // Nothing was lost -- the pattern is carried whole, so it lowered back correctly the entire time -- but a
  // destructuring you cannot see or edit is its own kind of bad in an editor. Found by opening the largest
  // real function in the store and walking to the bottom of it; no pin and no fuzz seed builds one, because
  // nothing constructs a tuple let-pattern by typing.
  let docOf (src: String) : Darklang.Fluid.Slot =
    match Darklang.LanguageTools.Parser.Parse.parsePTExpr src with
    | Ok e -> Darklang.Fluid.Slot.Filled(Darklang.Fluid.PT.toDoc e)
    | Error e -> Darklang.Fluid.Slot.Empty(Darklang.Fluid.PT.exprExpect ("parse failed: " ++ e))

  let show (src: String) : String =
    Darklang.Fluid.Debug.render (Darklang.Fluid.App.defaultRegistry ()) 70 (TuplePatternsAreVisible.docOf src)

  (TuplePatternsAreVisible.show "let (a, b) = t\na") = "let (a, b) = t\na"
  (TuplePatternsAreVisible.show "let (a, b, c) = t\na") = "let (a, b, c) = t\na"
  (TuplePatternsAreVisible.show "let (a, (b, c)) = t\na") = "let (a, (b, c)) = t\na"
  (TuplePatternsAreVisible.show "let (a, _) = t\na") = "let (a, _) = t\na"

  // The other three let-patterns, which were always fine, so the fix cannot have moved them.
  (TuplePatternsAreVisible.show "let x = 1\nx") = "let x = 1\nx"
  (TuplePatternsAreVisible.show "let _ = 1\n2") = "let _ = 1\n2"
  (TuplePatternsAreVisible.show "let () = 1\n2") = "let () = 1\n2"
