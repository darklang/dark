Stdlib.Int8.fromUInt128 255Z = Stdlib.Option.Option.None

(12y & 10y) = 8y
(0y & 0y) = 0y
((-1y) & 0y) = 0y
(127y & 127y) = 127y
((-128y) & (-1y)) = -128y
(127y & (-128y)) = 0y
((-1y) & (-1y)) = -1y

(12y | 10y) = 14y
(0y | 0y) = 0y
((-1y) | 0y) = -1y
(127y | 0y) = 127y
((-128y) | 0y) = -128y
(127y | (-128y)) = -1y

(12y ^ 10y) = 6y
(0y ^ 0y) = 0y
((-1y) ^ (-1y)) = 0y
(127y ^ (-1y)) = -128y
((-128y) ^ (-1y)) = 127y
(127y ^ 127y) = 0y

(~0y) = -1y
(~(-1y)) = 0y
(~127y) = -128y
(~(-128y)) = 127y
(~1y) = -2y

(1y << 2y) = 4y
(0y << 5y) = 0y
(1y << 0y) = 1y
(1y << 6y) = 64y
(5y << 3y) = 40y

(8y >> 2y) = 2y
(0y >> 5y) = 0y
(1y >> 0y) = 1y
(64y >> 6y) = 1y
((-1y) >> 1y) = -1y
(40y >> 3y) = 5y
