(0L % 15L) = 0L
(-1L % 2L) = 1L
(-754L % 53L) = 41L
(9999999999998L % 3L) = 2L

(5L % 0L) = error="Cannot evaluate modulus against 0"
(5L % -5L) = error="Cannot evaluate modulus against a negative number"
Stdlib.List.map (Stdlib.List.range -5 5) (fun v ->
 ((Builtin.unwrap (Stdlib.Int.toInt64 v)) % 4L)) = [ 3L, 0L, 1L, 2L, 3L, 0L, 1L, 2L, 3L, 0L, 1L ]

15L % 5L = 0L
5L % 0L = error="Cannot evaluate modulus against 0"
5L % -5L = error="Cannot evaluate modulus against a negative number"
Stdlib.List.map (Stdlib.List.range -5 5) (fun v -> (Builtin.unwrap (Stdlib.Int.toInt64 v)) % 4L) =
  [ 3L, 0L, 1L, 2L, 3L, 0L, 1L, 2L, 3L, 0L, 1L ]

