Stdlib.abs -5L = 5L
Stdlib.abs 5L = 5L
Stdlib.abs (-9223372036854775808L) = -9223372036854775808L

// `Stdlib.max`, `min` and `clamp` are one generic over `Compare`; these check that it
// reaches this type and that the type's own comparison holds at its extremes.
Stdlib.max -100L -20000L = -100L

Stdlib.min -100L -20000L = -20000L

Stdlib.clamp -2147483647L 250L -26L = -26L

(--5L) = 5L
(-5L) = -5L
(-0L) = 0L
(--0L) = 0L
(-(-9223372036854775808L)) = -9223372036854775808L

Stdlib.Int64.remainder 15L 6L = Stdlib.Result.Result.Ok 3L
Stdlib.Int64.remainder 20L 8L = Stdlib.Result.Result.Ok 4L
Stdlib.Int64.remainder -20L 8L = Stdlib.Result.Result.Ok -4L
Stdlib.Int64.remainder -20L -8L = Stdlib.Result.Result.Ok -4L
