Stdlib.Int32.fromUInt128 1Z = Stdlib.Option.Option.Some 1l
Stdlib.Int32.fromUInt128 2147483647Z = Stdlib.Option.Option.Some 2147483647l
Stdlib.Int32.fromUInt128 2147483648Z = Stdlib.Option.Option.None

(12l & 10l) = 8l
(0l & 0l) = 0l
((-1l) & 0l) = 0l
(2147483647l & 2147483647l) = 2147483647l
((-2147483648l) & (-1l)) = -2147483648l
(2147483647l & (-2147483648l)) = 0l
((-1l) & (-1l)) = -1l

(12l | 10l) = 14l
(0l | 0l) = 0l
((-1l) | 0l) = -1l
(2147483647l | 0l) = 2147483647l
((-2147483648l) | 0l) = -2147483648l
(2147483647l | (-2147483648l)) = -1l

(12l ^ 10l) = 6l
(0l ^ 0l) = 0l
((-1l) ^ (-1l)) = 0l
(2147483647l ^ (-1l)) = -2147483648l
((-2147483648l) ^ (-1l)) = 2147483647l
(2147483647l ^ 2147483647l) = 0l

(~0l) = -1l
(~(-1l)) = 0l
(~2147483647l) = -2147483648l
(~(-2147483648l)) = 2147483647l
(~1l) = -2l

(1l << 2l) = 4l
(0l << 5l) = 0l
(1l << 0l) = 1l
(1l << 30l) = 1073741824l
(5l << 3l) = 40l

(8l >> 2l) = 2l
(0l >> 5l) = 0l
(1l >> 0l) = 1l
(1073741824l >> 30l) = 1l
((-1l) >> 1l) = -1l
(40l >> 3l) = 5l
