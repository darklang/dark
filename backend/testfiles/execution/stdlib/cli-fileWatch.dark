module Tests

Stdlib.Cli.FileWatch.events [] 0 false false = Ok ((false, false))
Stdlib.Cli.FileWatch.events [0uy] 1 false false = Error 5
Stdlib.Cli.FileWatch.events [1uy,0uy,0uy,0uy,2uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy] 16 false false = Ok ((true, false))
Stdlib.Cli.FileWatch.events [1uy,0uy,0uy,0uy,0uy,8uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy] 16 false false = Ok ((true, true))
Stdlib.Cli.FileWatch.events [1uy,0uy,0uy,0uy,2uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,8uy,0uy,0uy,0uy] 16 false false = Error 5
Stdlib.Cli.FileWatch.linux "/does-not-exist" 10 (fun _ -> true) (fun _ -> ()) = Ok ()
// Zero remains a valid interval, including an immediately stopped watch.
Stdlib.Cli.Dir.withTemp (fun dir -> let path = dir ++ "/watch" in let wrote = Stdlib.Cli.File.writeText path "x" in let watched = Stdlib.Cli.File.watch path 0.0 (fun () -> true) (fun () -> ()) in (wrote, watched) == (Ok (), Ok ())) = Ok true
Stdlib.Cli.FileWatch.vnodeEvents [] 0 false false = Ok ((false, false))
Stdlib.Cli.FileWatch.vnodeEvents [0uy] 1 false false = Error 5
Stdlib.Cli.FileWatch.vnodeEvents (Stdlib.List.append [1uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,252uy,255uy,0uy,0uy,2uy,0uy,0uy,0uy] (Stdlib.List.repeatUnsafe 16 0uy)) 32 false false = Ok ((true, false))
Stdlib.Cli.FileWatch.vnodeEvents (Stdlib.List.append [1uy,0uy,0uy,0uy,0uy,0uy,0uy,0uy,252uy,255uy,0uy,0uy,32uy,0uy,0uy,0uy] (Stdlib.List.repeatUnsafe 16 0uy)) 32 false false = Ok ((true, true))
