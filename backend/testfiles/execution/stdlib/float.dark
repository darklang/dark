Stdlib.Float.toInt 2.5 = Stdlib.Float.roundTowardsZero 2.5
Stdlib.Float.toInt -2.5 = Stdlib.Float.roundTowardsZero -2.5
// Truncation and floor differ for negative values.
Stdlib.Float.toInt -1.5 = -1
Stdlib.Float.floor -1.5 = -2
// NaN and infinities cannot become Ints.
Stdlib.Float.toInt Builtin.testNan =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.toInt Builtin.testInfinity =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.toInt Builtin.testNegativeInfinity =
  error="Encountered out-of-range value for type of Int"


// IEEE 754 binary64 representations.
Stdlib.Float.toBits 0.0 = 0
Stdlib.Float.toBits 0.5 = 4602678819172646912
Stdlib.Float.toBits 1.0 = 4607182418800017408
Stdlib.Float.toBits 2.0 = 4611686018427387904
Stdlib.Float.toBits Builtin.testInfinity = 9218868437227405312
// Bit equality distinguishes signed zero and is reflexive for a fixed NaN.
Stdlib.Float.toBits -0.0 = -9223372036854775808
(Stdlib.Float.toBits -0.0 == Stdlib.Float.toBits 0.0) = false
(-0.0 == 0.0) = true
(Stdlib.Float.toBits (Builtin.testNan)
 == Stdlib.Float.toBits (Builtin.testNan)) = true