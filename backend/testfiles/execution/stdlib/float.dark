// NaN / Infinity have no Int representation -> Dark error, not a host crash
Stdlib.Float.ceiling Builtin.testNan =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.roundUp Builtin.testInfinity =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.floor Builtin.testNegativeInfinity =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.roundDown Builtin.testNan =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.round Builtin.testInfinity =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.truncate Builtin.testNan =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.roundTowardsZero Builtin.testNegativeInfinity =
  error="Encountered out-of-range value for type of Int"

