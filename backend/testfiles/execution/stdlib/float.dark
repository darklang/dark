// toInt truncates toward zero.
Stdlib.Float.toInt 3.0 = 3
Stdlib.Float.toInt 0.0 = 0
Stdlib.Float.toInt -0.0 = 0
Stdlib.Float.toInt 1.5 = 1
Stdlib.Float.toInt 1.9 = 1
