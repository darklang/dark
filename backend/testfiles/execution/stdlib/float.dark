Builtin.testNan == Builtin.testNan = false

Stdlib.toString 1.5 = "1.5"
Stdlib.toString 0.0 = "0.0"
Stdlib.toString -0.5 = "-0.5"
Stdlib.toString 0.5 = "0.5"
Stdlib.toString -55555555555555555555555555555.5 = "-5.555555555555555e+28"
// Shortest round-trip: what prints is the number, not a twelve-digit rounding of it.
Stdlib.toString (0.1 + 0.2) = "0.30000000000000004"
Stdlib.toString (1.0 / 3.0) = "0.3333333333333333"
Stdlib.toString 1.0000000000000002 = "1.0000000000000002"
(Stdlib.toString (1.0 / 3.0) |> Stdlib.Float.parse) = Stdlib.Result.Result.Ok (1.0 / 3.0)
// Fixed notation from 1e-4 up to 1e16, scientific outside, no zero padding, and no `.0` on scientific
// (it used to print `1e+17.0`, which Float.parse refuses). Same layout as the compiler's Float.toString.
Stdlib.toString 0.0001 = "0.0001"
Stdlib.toString 0.00001 = "1e-5"
Stdlib.toString -0.00001 = "-1e-5"
Stdlib.toString 123456789012345.0 = "123456789012345.0"
Stdlib.toString 9007199254740992.0 = "9007199254740992.0"
Stdlib.toString 10000000000000000.0 = "1e+16"
Stdlib.toString 123456789012345678.0 = "1.2345678901234568e+17"
(Stdlib.toString 123456789012345678.0 |> Stdlib.Float.parse) = Stdlib.Result.Result.Ok 123456789012345678.0
(Stdlib.toString -0.00001 |> Stdlib.Float.parse) = Stdlib.Result.Result.Ok -0.00001
(Stdlib.Float.parse "5e-324" |> Stdlib.Result.map (fun f -> Stdlib.toString f)) = Stdlib.Result.Result.Ok "5e-324"


// toInt truncates toward zero.
Stdlib.Float.toInt 3.0 = 3
Stdlib.Float.toInt 0.0 = 0
Stdlib.Float.toInt -0.0 = 0
Stdlib.Float.toInt 1.5 = 1
Stdlib.Float.toInt 1.9 = 1
Stdlib.Float.toInt -1.5 = -1
Stdlib.Float.toInt -1.9 = -1
Stdlib.Float.toInt -3.0 = -3
Stdlib.Float.toInt 0.1 = 0
Stdlib.Float.toInt 2147483648.7 = 2147483648
Stdlib.Float.toInt 2.5 = Stdlib.Float.roundTowardsZero 2.5
Stdlib.Float.toInt -2.5 = Stdlib.Float.roundTowardsZero -2.5
// Truncation and floor differ for negative values.
Stdlib.Float.toInt -1.5 = -1
Stdlib.Float.floor -1.5 = -2
// NaN and infinities cannot become Ints.
Stdlib.Float.toInt Builtin.testNan =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.toInt Builtin.testInfinity =
  error="Encountered out-of-range value for type of Int"
Stdlib.Float.toInt Builtin.testNegativeInfinity =
  error="Encountered out-of-range value for type of Int"


// IEEE 754 binary64 representations.
Stdlib.Float.toBits 0.0 = 0
Stdlib.Float.toBits 0.5 = 4602678819172646912
Stdlib.Float.toBits 1.0 = 4607182418800017408
Stdlib.Float.toBits 2.0 = 4611686018427387904
Stdlib.Float.toBits Builtin.testInfinity = 9218868437227405312
// Bit equality distinguishes signed zero and is reflexive for a fixed NaN.
Stdlib.Float.toBits -0.0 = -9223372036854775808
(Stdlib.Float.toBits -0.0 == Stdlib.Float.toBits 0.0) = false
(-0.0 == 0.0) = true
(Stdlib.Float.toBits (Builtin.testNan)
 == Stdlib.Float.toBits (Builtin.testNan)) = true
