module Tests
match Stdlib.Cli.Syscall.clockGettime (-1) with | Error e -> e == (if Stdlib.Cli.KernelABI.mac () then 78 else 22) | Ok _ -> false = true
Stdlib.Cli.Clock.monotonicMilliseconds () > 0 = true
Stdlib.Cli.Clock.sleepNanoseconds 0 0 = Ok ()
Stdlib.Cli.Clock.sleepNanoseconds 0 (-1) = Error 22
Stdlib.Cli.Clock.realtimeNanoseconds () |> Stdlib.Result.map (fun pair -> let (seconds, nanos) = pair in seconds > 1700000000 && nanos >= 0 && nanos < 1000000000) = Ok true
Stdlib.Cli.Clock.sleepWith (fun seconds _ -> if seconds == 1 then (-4, Stdlib.Blob.fromList [0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy, 0uy]) else (0, Stdlib.Blob.empty)) 1 0 = Ok ()
