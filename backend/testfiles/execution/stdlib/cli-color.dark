// The one-shot colourisers. They used to be `Stdlib.Cli.UI.Color`, a module whose names collided with the
// palette in `Colors` one letter away (`Color.red` a function, `Colors.red` a code); they live in `Colors`
// now as `<name>Text`, alongside the `boldText`/`dimText` that were already there.

Stdlib.Cli.UI.Colors.redText "hi" = "\u001b[31mhi\u001b[0m"
Stdlib.Cli.UI.Colors.greenText "hi" = "\u001b[32mhi\u001b[0m"
Stdlib.Cli.UI.Colors.yellowText "hi" = "\u001b[33mhi\u001b[0m"
Stdlib.Cli.UI.Colors.blueText "hi" = "\u001b[34mhi\u001b[0m"
Stdlib.Cli.UI.Colors.magentaText "hi" = "\u001b[35mhi\u001b[0m"
Stdlib.Cli.UI.Colors.cyanText "hi" = "\u001b[36mhi\u001b[0m"
Stdlib.Cli.UI.Colors.whiteText "hi" = "\u001b[37mhi\u001b[0m"
Stdlib.Cli.UI.Colors.grayText "hi" = "\u001b[90mhi\u001b[0m"
Stdlib.Cli.UI.Colors.boldText "hi" = "\u001b[1mhi\u001b[0m"
Stdlib.Cli.UI.Colors.dimText "hi" = "\u001b[2mhi\u001b[0m"
Stdlib.Cli.UI.Colors.italicText "hi" = "\u001b[3mhi\u001b[0m"
Stdlib.Cli.UI.Colors.underlineText "hi" = "\u001b[4mhi\u001b[0m"
Stdlib.Cli.UI.Colors.strikethroughText "hi" = "\u001b[9mhi\u001b[0m"
Stdlib.Cli.UI.Colors.onRed "hi" = "\u001b[41mhi\u001b[0m"
Stdlib.Cli.UI.Colors.onGreen "hi" = "\u001b[42mhi\u001b[0m"
Stdlib.Cli.UI.Colors.onYellow "hi" = "\u001b[43mhi\u001b[0m"
Stdlib.Cli.UI.Colors.onBlue "hi" = "\u001b[44mhi\u001b[0m"
Stdlib.Cli.UI.Colors.redText "" = "\u001b[31m\u001b[0m"
