// Like libc's default C locale, matching consumes UTF-8 bytes, not graphemes.
Stdlib.Cli.Glob.matches "é" "é" false = true
Stdlib.Cli.Glob.matches "?" "é" false = false
Stdlib.Cli.Glob.matches "??" "é" false = true
Stdlib.Cli.Glob.matches "***a***b***" "aaabbb" false = true

