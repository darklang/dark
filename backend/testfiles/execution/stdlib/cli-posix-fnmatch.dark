// POSIX glob semantics, independent of libc availability.
Stdlib.Cli.Posix.fnmatch "" "" false = true
Stdlib.Cli.Posix.fnmatch "*" "" false = true
Stdlib.Cli.Posix.fnmatch "*" ".hidden" true = true
Stdlib.Cli.Posix.fnmatch "*" "a/b" false = true
Stdlib.Cli.Posix.fnmatch "*" "a/b" true = false
Stdlib.Cli.Posix.fnmatch "?" "/" true = false
Stdlib.Cli.Posix.fnmatch "[/]" "/" true = false
Stdlib.Cli.Posix.fnmatch "[/]" "/" false = true
Stdlib.Cli.Posix.fnmatch "a/**/x" "a/b/c/x" true = false
Stdlib.Cli.Posix.fnmatch "a/**/x" "a/b/c/x" false = true
Stdlib.Cli.Posix.fnmatch "a/**/x" "a/b/x" true = true
Stdlib.Cli.Posix.fnmatch "\\*" "*" false = true
Stdlib.Cli.Posix.fnmatch "\\?" "?" false = true
Stdlib.Cli.Posix.fnmatch "a\\" "a" false = false
Stdlib.Cli.Posix.fnmatch "[abc" "[abc" false = true
Stdlib.Cli.Posix.fnmatch "[]a]" "]" false = true
Stdlib.Cli.Posix.fnmatch "[a-]" "-" false = true
Stdlib.Cli.Posix.fnmatch "[-a]" "-" false = true
Stdlib.Cli.Posix.fnmatch "[a-c]" "b" false = true
Stdlib.Cli.Posix.fnmatch "[!a-c]" "b" false = false
Stdlib.Cli.Posix.fnmatch "[^a-c]" "z" false = true
Stdlib.Cli.Posix.fnmatch "[[:digit:]]" "5" false = true
Stdlib.Cli.Posix.fnmatch "[[:alpha:]]" "F" false = true
Stdlib.Cli.Posix.fnmatch "[[:xdigit:]]" "g" false = false
Stdlib.Cli.Posix.fnmatch "[[:space:]]" "\t" false = true
Stdlib.Cli.Posix.fnmatch "[![:bogus:]]" "a" false = false
Stdlib.Cli.Posix.fnmatch "[[.a.]]" "a" false = true
Stdlib.Cli.Posix.fnmatch "[[=a=]]" "a" false = true
Stdlib.Cli.Posix.fnmatch "[a-[.c.]]" "b" false = true
Stdlib.Cli.Posix.fnmatch "a\0b" "a" false = true
Stdlib.Cli.Posix.fnmatch "a" "a\0b" false = true
Stdlib.Cli.Posix.fnmatch "?" "\0a" false = false
// Like libc's default C locale, matching consumes UTF-8 bytes, not graphemes.
Stdlib.Cli.Posix.fnmatch "é" "é" false = true
Stdlib.Cli.Posix.fnmatch "?" "é" false = false
Stdlib.Cli.Posix.fnmatch "??" "é" false = true
Stdlib.Cli.Posix.fnmatch "***a***b***" "aaabbb" false = true

// Compiler compatibility corpus, checked against libc's default C locale.
// POSIX fnmatch outcomes checked against host libc in its default C locale.
Stdlib.Cli.Posix.fnmatch "**/x" "a" true = false
Stdlib.Cli.Posix.fnmatch "?" "z" true = true
Stdlib.Cli.Posix.fnmatch "[a-c]*" "F" true = false
Stdlib.Cli.Posix.fnmatch "[[:space:]]" "b" false = false
