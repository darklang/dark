module Tests
Stdlib.Cli.Syscall.readlinkAt "/definitely/missing/dark-link" 2 = Error 2
Stdlib.Cli.PathIO.readlinkWith (fun count -> if count == 2 then Ok (Stdlib.Blob.fromString "ab") else if count == 4 then Ok (Stdlib.Blob.fromString "abc") else Error 22) 2 |> Stdlib.Result.map Stdlib.Blob.toList = Ok [97uy, 98uy, 99uy]
Stdlib.Cli.PathIO.readlinkWith (fun _ -> Ok Stdlib.Blob.empty) 0 = Error 22
Stdlib.Cli.Dir.withTemp (fun dir -> let link = Stdlib.Cli.Path.join [dir, "link"] in let _ = Stdlib.Cli.Posix.symlink "abcdef" link in Stdlib.Cli.Syscall.readlinkAt link 2 |> Stdlib.Result.map Stdlib.Blob.toList) = Ok (Ok [97uy, 98uy])
