module Tests
match Stdlib.Cli.Syscall.getcwd 1 with | Error e -> e == (if Stdlib.Cli.KernelABI.mac () then 78 else 34) | Ok _ -> false = true
Stdlib.Cli.PathIO.cwdWith (fun count -> if count == 2 then Error 34 else Ok (Stdlib.Blob.fromString "/x\0")) 2 |> Stdlib.Result.map Stdlib.Blob.toList = Ok [47uy, 120uy, 0uy]
Stdlib.Cli.Posix.getCwd () |> Stdlib.Result.map (fun path -> Stdlib.String.startsWith path "/") = Ok true
