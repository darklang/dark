// Process.shellQuote
Stdlib.Cli.Process.shellQuote "hello" = "'hello'"
Stdlib.Cli.Process.shellQuote "hello world" = "'hello world'"
Stdlib.Cli.Process.shellQuote "" = "''"
Stdlib.Cli.Process.shellQuote "it's" = "'it'\\''s'"
Stdlib.Cli.Process.shellQuote "a'b'c" = "'a'\\''b'\\''c'"
Stdlib.Cli.Process.shellQuote "no-special" = "'no-special'"
Stdlib.Cli.Process.shellQuote "has spaces" = "'has spaces'"
Stdlib.Cli.Process.shellQuote "semi;colon" = "'semi;colon'"
Stdlib.Cli.Process.shellQuote "pipe|char" = "'pipe|char'"
Stdlib.Cli.Process.shellQuote "$(dangerous)" = "'$(dangerous)'"
Stdlib.Cli.Process.shellQuote "`backtick`" = "'`backtick`'"

// Shared Dark capture, EOF, errors, deadlines and interactive owned-child IO.
(match Stdlib.Cli.Process.run "/bin/sh" ["-c", "printf out; printf err >&2; exit 7"] with | Ok output -> (output.exitCode, output.stdout, output.stderr) | Error _ -> (-1, "", "")) = (7, "out", "err")
(match Stdlib.Cli.Process.run "/bin/cat" [] with | Ok output -> (output.exitCode, output.stdout) | Error _ -> (-1, "")) = (0, "")
(match Stdlib.Cli.Process.run "/definitely/not/a/dark/executable" [] with | Error error -> error.errno | Ok _ -> 0) = 2
Stdlib.Cli.Process.runWithTimeout 0 "/bin/true" [] = Error "timeoutMs must be positive"
Stdlib.Cli.Process.runWithTimeout 5 "/bin/sh" ["-c", "sleep 1"] = Error "Process timed out"
(let handle = Stdlib.Cli.Process.spawn "while read line; do printf 'reply:%s\\n' \"$line\"; done" in let first = Stdlib.Cli.Process.communicate handle "one" in let second = Stdlib.Cli.Process.communicate handle "two" in let final = Stdlib.Cli.Process.terminate handle in (first.stdout, second.stdout, final.stdout)) = ("reply:one\n", "reply:two\n", "reply:one\nreply:two\n")
(let handle = Stdlib.Cli.Process.spawn "while read line; do printf 'reply:'; sleep 0.03; printf '%s\\n' \"$line\"; done" in let response = Stdlib.Cli.Process.communicate handle "chunked" in let _ = Stdlib.Cli.Process.terminate handle in response.stdout) = "reply:chunked\n"
(let handle = Stdlib.Cli.Process.spawn "read line" in let result = Stdlib.Cli.Process.communicate handle "" in let _ = Stdlib.Cli.Process.terminate handle in (result.stdout, result.stderr)) = ("", "")
Builtin.runtimeChildPoll (-1) = Error 9
Builtin.runtimeChildDescriptors (-1) = Error 9
Builtin.runtimeChildClose (-1) = Error 9
