// A response's token counts are bookkeeping: a missing one reads as 0 rather
// than losing the whole response, but one that isn't an integer is an error.
module Anthropic =
  let parse (usage: String) : String =
    let body =
      """{"id":"m","type":"message","role":"assistant","""
      ++ """"content":[{"type":"text","text":"hi"}],"stop_reason":"end_turn","""
      ++ usage
      ++ "}"

    match Stdlib.AltJson.parse body with
    | Ok json ->
      match Darklang.LLM.Providers.Anthropic.parseExtendedResponse json with
      | Ok r ->
        r.content
        ++ " "
        ++ (Stdlib.Int.toString r.usage.inputTokens)
        ++ "/"
        ++ (Stdlib.Int.toString r.usage.outputTokens)
        ++ "/"
        ++ (Stdlib.Int.toString r.usage.cacheReadTokens)
      | Error e -> Darklang.LLM.Provider.ProviderError.toString e
    | Error _ -> "bad json"

  parse """"usage":{"input_tokens":10,"output_tokens":5}""" = "hi 10/5/0"
  parse """"usage":{"input_tokens":10,"output_tokens":5,"cache_read_input_tokens":3}""" =
    "hi 10/5/3"
  parse """"usage":{}""" = "hi 0/0/0"
  parse """"usage":{"input_tokens":null,"output_tokens":5}""" = "hi 0/5/0"
  parse """"usage":{"input_tokens":1.5,"output_tokens":5}""" =
    "Invalid response: Invalid JSON integer field: input_tokens"
  parse """"usage":{"input_tokens":10,"output_tokens":5,"cache_read_input_tokens":2.5}""" =
    "Invalid response: Invalid JSON integer field: cache_read_input_tokens"


module OpenAI =
  let usage (json: String) : String =
    match Stdlib.AltJson.parse json with
    | Ok(Object fields) ->
      match Darklang.LLM.Providers.OpenAI.extractUsage fields with
      | Ok u ->
        (Stdlib.Int.toString u.inputTokens)
        ++ "/"
        ++ (Stdlib.Int.toString u.outputTokens)
        ++ "/"
        ++ (Stdlib.Int.toString u.cacheReadTokens)
      | Error e -> e
    | _ -> "bad json"

  usage """{"usage":{"prompt_tokens":10,"completion_tokens":5}}""" = "10/5/0"
  usage
    """{"usage":{"prompt_tokens":10,"completion_tokens":5,"prompt_tokens_details":{"cached_tokens":4}}}""" =
    "10/5/4"
  usage """{}""" = "0/0/0"
  usage """{"usage":{"prompt_tokens":10.5}}""" =
    "Invalid JSON integer field: prompt_tokens"
