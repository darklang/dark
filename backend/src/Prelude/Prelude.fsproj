<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Publishing configuration -->
    <IsPublishable>false</IsPublishable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ply" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Wcwidth" />
    <Compile Include="Exception.fs" />
    <Compile Include="NEList.fs" />
    <Compile Include="Regex.fs" />
    <Compile Include="Tuple2.fs" />
    <Compile Include="UTF8.fs" />
    <Compile Include="NormalizationData.fs" />
    <Compile Include="Normalization.fs" />
    <Compile Include="String.fs" />
    <Compile Include="TextWidth.fs" />
    <Compile Include="Lookup.fs" />
    <Compile Include="Map.fs" />
    <Compile Include="List.fs" />
    <Compile Include="Option.fs" />
    <Compile Include="Result.fs" />
    <Compile Include="Task.fs" />
    <Compile Include="Ply.fs" />
    <Compile Include="NonBlockingConsole.fs" />
    <Compile Include="Prelude.fs" />
    <Compile Include="Telemetry.fs" />
  </ItemGroup>
</Project>
