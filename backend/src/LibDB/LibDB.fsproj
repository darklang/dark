<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Publishing configuration -->
    <IsPublishable>false</IsPublishable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="paket.references" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Prelude/Prelude.fsproj" />
    <ProjectReference Include="../LibExecution/LibExecution.fsproj" />
    <ProjectReference Include="../LibSerialization/LibSerialization.fsproj" />
    <ProjectReference Include="../LibConfig/LibConfig.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="OriginTs.fs" />
    <Compile Include="Sqlite.fs" />
    <Compile Include="PreparedBatch.fs" />
    <Compile Include="Deprecations.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="PackageLocation.fs" />
    <Compile Include="Caching.fs" />
    <Compile Include="Purge.fs" />
    <Compile Include="PackageItem.fs" />
    <Compile Include="DependencyExtractor.fs" />
    <Compile Include="Branches.fs" />
    <Compile Include="BranchSelection.fs" />
    <Compile Include="AstTransformer.fs" />
    <Compile Include="HashStabilization.fs" />
    <Compile Include="NameLookup.fs" />
    <Compile Include="DeferredResolver.fs" />
    <Compile Include="UnresolvedCheck.fs" />
    <Compile Include="Docs.fs" />
    <Compile Include="PackageOpPlayback.fs" />
    <Compile Include="OpValidation.fs" />
    <Compile Include="Inserts.fs" />
    <Compile Include="Queries.fs" />
    <Compile Include="Draft.fs" />
    <Compile Include="ProgramTypes.fs" />
    <Compile Include="WipRefresh.fs" />
    <Compile Include="Propagation.fs" />
    <Compile Include="RuntimeTypes.fs" />
    <Compile Include="Impls.fs" />
    <Compile Include="EphemeralPackages.fs" />
    <Compile Include="LocalFile.fs" />
    <Compile Include="PolicyStore.fs" />
    <Compile Include="PackageManager.fs" />
    <Compile Include="PackageRefsGenerator.fs" />
    <Compile Include="UpgradeKeep.fs" />
    <!-- Store upgrades: the runner, then each unit's code (backend/migrations/upgrades/*/step.fs), then
         the registry the build generates from those directories (see GenerateUpgradeRegistry below). -->
    <Compile Include="Upgrades.fs" />
    <Compile Include="../../migrations/upgrades/*/step.fs" />
    <Compile Include="$(BaseIntermediateOutputPath)/UpgradeRegistry.g.fs" />
    <Compile Include="Releases.fs" />
    <Compile Include="Seed.fs" />
    <Compile Include="PackagePermissions.fs" />

    <!-- ex-LibCloud SQLite-bound modules /-->
    <Compile Include="Tracing.fs" />
    <Compile Include="Traces.fs" />
    <Compile Include="UserDB.fs" />
  </ItemGroup>
  <!-- Every unit under backend/migrations/upgrades, listed in F# for the runner. Generated, not committed:
       a committed list would be the one file every upgrade PR touches. Not reflection: the published
       binary is AOT and trimmed. -->
  <Target Name="GenerateUpgradeRegistry" BeforeTargets="BeforeBuild;CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../../../scripts/build/_gen-upgrade-registry&quot; &quot;$(MSBuildProjectDirectory)/../../migrations/upgrades&quot; &quot;$(BaseIntermediateOutputPath)/UpgradeRegistry.g.fs&quot;" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>