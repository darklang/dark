+def Stdlib.String.__toBytesHelper(s: String, idx: Int64, acc: List<Int64>) : List<Int64> =
+    if idx >= Stdlib.String.length(s) then
+        Stdlib.List.reverse<Int64>(acc)
+    else
+        Stdlib.String.__toBytesHelper(s, idx + 1, [Stdlib.String.getByteAt(s, idx), ...acc])
