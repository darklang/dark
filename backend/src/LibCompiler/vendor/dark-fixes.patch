+// label is irrelevant to the 64 bits stored. It also keeps us away from the compiler's
+// signed-comparison bug on unsigned values (see PROGRESSION-LOG).
+def Stdlib.Float.fromBits(bits: Int64) : Float =
+    let ptr = __raw_alloc(8) in
+    let _ = __raw_set<Int64>(ptr, 0, bits) in
+    __raw_get<Float>(ptr, 0)
