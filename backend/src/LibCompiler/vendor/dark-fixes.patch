+def Stdlib.List.__filterMapHelper<a, b>(list: List<a>, fn: (a) -> Stdlib.Option.Option<b>, acc: List<b>) : List<b> =
+    if Stdlib.__FingerTree.isEmpty<a>(list) then acc
