<!-- Blazor WebAssembly host for the Darklang REPL. Standalone: NOT wired into
     the main solution/build (it targets browser-wasm and needs the wasm-tools
     workload). Build/publish it on its own — see README.md. -->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- must match the assembly name JS passes to DotNet.invokeMethodAsync in index.html -->
    <AssemblyName>Darklang.Wasm</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Never let a legacy in-project publish directory become an input to a
         later publish. Current output lives under repo-root/rundir. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
    <!-- size levers; AOT is slower to build but shrinks/speeds the result -->
    <PublishTrimmed>true</PublishTrimmed>
    <!-- AOT: the interpreter's F# task state machines could not suspend a second time under
         the mono interpreter (a blocking wait on the browser's one thread). Compiled, they can.
         Slower to build, faster to run. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- No ICU: the CLI's string work is ordinal/invariant, and the ICU data is ~1 MB gz plus
         load time on every cold start. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Native relink: statically links e_sqlite3 (SourceGear.sqlite3 ships a browser-wasm
         .a and adds it as a NativeFileReference through its buildTransitive targets) so the
         real LibDB store runs in the tab. -->
    <WasmBuildNative>true</WasmBuildNative>
    <!-- For bringing the host up: `WasmNativeStrip=false` makes a paused stack in DevTools
         read as mono/sqlite function names, `WasmDebugLevel=1` plus
         `CopyOutputSymbolsToPublishDirectory=true` keeps pdbs. Both cost size; off for release. -->
  </PropertyGroup>

  <!-- Partial AOT. Only leaves nothing F#-generic calls into stay interpreted: mixed
       AOT/interpreter mode asserts ("should not be reached") when compiled generic code
       crosses into an interpreted assembly, which excluding the BCL wholesale triggered.
       These are big, self-contained, and barely used at runtime. -->
  <ItemGroup>
    <_AOT_InternalForceInterpretAssemblies Include="System.Private.Xml.dll;System.Private.Xml.Linq.dll;System.Xml.Linq.dll;System.Xml.ReaderWriter.dll;System.Xml.XDocument.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Expecto.dll;Mono.Cecil.dll;Mono.Cecil.Mdb.dll;Mono.Cecil.Pdb.dll;Mono.Cecil.Rocks.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="System.Linq.Expressions.dll;System.Linq.Queryable.dll;System.ComponentModel.TypeConverter.dll;System.Net.HttpListener.dll;System.Diagnostics.Process.dll" />
    <_AOT_InternalForceInterpretAssemblies Include="Microsoft.AspNetCore.Components.dll;Microsoft.AspNetCore.Components.Web.dll" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Probe.fs" />
    <Compile Include="Output.fs" />
    <Compile Include="PmLookup.fs" />
    <Compile Include="Repl.fs" />
    <!-- The CLI host: the real store plus browser stand-ins for stdin/terminal -->
    <Compile Include="Host/Browser.fs" />
    <Compile Include="Host/BrowserBuiltins.fs" />
    <Compile Include="Host/Cli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- The package snapshot (generated from the DB, see README) — force it into
       the published wwwroot; the static-web-assets pipeline skips it otherwise. -->
  <ItemGroup Condition="Exists('wwwroot/packages.snapshot')">
    <Content Update="wwwroot/packages.snapshot" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
                      Version="10.*" PrivateAssets="all" />
    <!-- Same version paket.lock pins for LibDB; referenced directly so NuGet imports the
         bundle's buildTransitive targets (that is what links e_sqlite3.a). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <!-- The runtime + parser. LibDB is currently referenced only for createInMemory;
       the browser never opens SQLite. See the hosted-PM cleanup in Repl.fs. -->
  <ItemGroup>
    <ProjectReference Include="../Prelude/Prelude.fsproj" />
    <ProjectReference Include="../LibExecution/LibExecution.fsproj" />
    <ProjectReference Include="../LibParser/LibParser.fsproj" />
    <ProjectReference Include="../LibSerialization/LibSerialization.fsproj" />
    <ProjectReference Include="../LibDB/LibDB.fsproj" /> <!-- createInMemory (in-memory PM) -->
    <ProjectReference Include="../Builtins/Builtins.Pure/Builtins.Pure.fsproj" />
    <!-- .NET HttpClient runs over fetch() in the browser, so this set works in WASM -->
    <ProjectReference Include="../Builtins/Builtins.Http.Client/Builtins.Http.Client.fsproj" />
    <!-- The CLI's full builtin set. CliHost pulls Matter, Language, Time, Random, Http.Server
         and LibCloud; all of it is plain BCL + SQLite, which links now. The browser replaces
         the few that need a tty or a process (Host/BrowserBuiltins.fs), layered last so they win. -->
    <ProjectReference Include="../Builtins/Builtins.Cli/Builtins.Cli.fsproj" />
    <ProjectReference Include="../Builtins/Builtins.CliHost/Builtins.CliHost.fsproj" />
  </ItemGroup>

</Project>
