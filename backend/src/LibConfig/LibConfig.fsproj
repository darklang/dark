<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Publishing configuration -->
    <IsPublishable>false</IsPublishable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="paket.references" />
    <Compile Include="ConfigDsl.fs" />
    <Compile Include="StoreLocation.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="Dirs.fs" />
    <Compile Include="File.fs" />
  </ItemGroup>
  
  <Target Name="EmbedGitHash" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="DarkBuildHash" />
    </Exec>
    <!-- Keep the timestamp when the hash is unchanged so dependent projects
         can reuse their build. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)build-hash.txt"
                      Lines="$(DarkBuildHash)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)build-hash.txt" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Prelude/Prelude.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
