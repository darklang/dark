<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Publishing configuration -->
    <IsPublishable>false</IsPublishable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="paket.references" />
    <Compile Include="ConfigDsl.fs" />
    <Compile Include="Config.fs" />
  </ItemGroup>
  
  <Target Name="EmbedGitHash" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="git rev-parse --short=7 HEAD > $(IntermediateOutputPath)build-hash.txt" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)build-hash.txt" />
    </ItemGroup>
  </Target>
  <!-- Which release this is, or which it comes after; see scripts/build/_release-tag. -->
  <Target Name="EmbedReleaseTag" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="bash $(MSBuildThisFileDirectory)../../../scripts/build/_release-tag &gt; $(IntermediateOutputPath)release-tag.txt" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)release-tag.txt" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Prelude/Prelude.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
