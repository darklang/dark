<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTrimmable>true</IsTrimmable>

    <!-- Tiered PGO instruments tier-0 code to build a profile that tier-1 then optimizes against. A CLI
         command lives a second or two and exits, so it pays the instrumentation and never collects.
         Scoped to this project, not global: `darklang serve` is long-lived and should keep the default. -->
    <TieredPGO>false</TieredPGO>
    <!-- Publishing configuration -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Assembly linking - trim framework assemblies too -->
    <TrimMode>link</TrimMode>
    <!-- Show every trim/AOT warning so latent reflective/dynamic-code paths get surfaced. If a
         warning is genuinely not actionable after audit, suppress it locally via `<NoWarn>` on the
         offending assembly's project, not globally. -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <!-- Additional aggressive settings -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>

    <!-- Disable optional .NET runtime subsystems we don't use under AOT.
         Each prunes a meaningful slice of metadata + code from the published
         binary. JIT/Debug builds: no-op (these only kick in during AOT
         compilation; the runtime ships them by default for managed code). -->
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- We don't hot-reload, don't run startup hooks, don't use built-in COM,
         and don't need autorelease pool semantics (macOS-Cocoa-specific). -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <StartupHookSupport>false</StartupHookSupport>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <!-- Custom resource manager kicks in only for satellite assemblies, which
         we don't ship (InvariantGlobalization is on). -->
    <CustomResourceTypesSupport>false</CustomResourceTypesSupport>

    <!-- AOT-specific size wins. Drop user-code line metadata (native stack
         traces via DWARF still work; the AggregateException-walking
         diagnostic in Cli.fs still surfaces inner errors) and fold dup
         method bodies across generic instantiations. -->
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>

    <!-- We publish these for lots of different runtimes, so leave these empty and
         then specify them in scripts/build/build-release-cli-exes.sh. The
         regular build works fine with the defaults (and will pick a runtime
         automatically) -->
    <!-- <PublishTrimmed>true</PublishTrimmed> -->
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <!-- <PublishReadyToRun>false</PublishReadyToRun> -->
    <!-- <SelfContained>true</SelfContained> -->
  </PropertyGroup>
  <!-- Build-time values that we use to make version info -->
  <!-- Creates a GitHash property -->
  <Target Name="GitHash" BeforeTargets="AddCliAssemblyMetadata">
    <Exec Command="git describe --long --always --dirty --exclude=* --abbrev=8" ConsoleToMSBuild="True" IgnoreExitCode="False">
      <Output PropertyName="GitHash" TaskParameter="ConsoleOutput" />
    </Exec>
  </Target>
  <!-- Creates a BuildDate property -->
  <Target Name="BuildDate" BeforeTargets="AddCliAssemblyMetadata">
    <Exec Command="date" ConsoleToMSBuild="True" IgnoreExitCode="False">
      <Output PropertyName="BuildDate" TaskParameter="ConsoleOutput" />
    </Exec>
  </Target>
  <!-- Creates AssemblyMetadataAttributes which can be used via
       `System.Reflection.Assembly.GetEntryAssembly.GetCustomAttributes<
          System.Reflection.AssemblyMetadataAttribute>()` -->
  <Target Name="AddCliAssemblyMetadata" BeforeTargets="CoreGenerateAssemblyInfo">
    <ItemGroup>
      <AssemblyAttribute Include="AssemblyMetadata">
        <_Parameter1>$(BuildDate)</_Parameter1>
        <_Parameter2>$(GitHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="paket.references" />
    <TrimmerRootAssembly Include="LibExecution" />
  </ItemGroup>

  <!-- Static-link SQLite under NativeAOT so the published exe has no libe_sqlite3.so dependency.
       DirectPInvoke binds the managed DllImport("e_sqlite3") calls to the linker; <NativeLibrary>
       tells the AOT linker where to find the archive, picked per RuntimeIdentifier. The archives
       come from scripts/build/build-sqlite.sh, and the per-RID list below must stay in sync with it.

       Only active for PublishAot=true. JIT publish and `dotnet build` ignore both items and load
       libe_sqlite3.so from the NuGet at runtime. build-release-cli-exes.sh runs build-sqlite.sh for
       AOT targets; a hand-rolled `dotnet publish /p:PublishAot=true` needs the archives first. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="e_sqlite3" />
  </ItemGroup>

  <!-- Escape hatch for linking additional native archives into an AOT publish,
       for targets that need a compatibility shim the shipped set doesn't.
       Semicolon-separated paths. No shipped build sets this, so it's inert
       unless a caller passes /p:DarkExtraNativeLibs=... explicitly. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(DarkExtraNativeLibs)' != ''">
    <NativeLibrary Include="$(DarkExtraNativeLibs)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'linux-x64'">
    <NativeLibrary Include="lib/libe_sqlite3-linux-x64.a" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'linux-musl-x64'">
    <NativeLibrary Include="lib/libe_sqlite3-linux-musl-x64.a" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'linux-arm64'">
    <NativeLibrary Include="lib/libe_sqlite3-linux-arm64.a" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'linux-arm'">
    <NativeLibrary Include="lib/libe_sqlite3-linux-arm.a" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'osx-x64'">
    <NativeLibrary Include="lib/libe_sqlite3-osx-x64.a" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(RuntimeIdentifier)' == 'osx-arm64'">
    <NativeLibrary Include="lib/libe_sqlite3-osx-arm64.a" />
  </ItemGroup>
  <Target Name="PrintRuntimeIdentifierCli" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="RuntimeIdentifier in Cli is '$(RuntimeIdentifier)'" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../LibExecution/LibExecution.fsproj" />
    <ProjectReference Include="../LibDB/LibDB.fsproj" />
    <ProjectReference Include="../Builtins/Builtins.CliHost/Builtins.CliHost.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="EmbeddedResources.fs" />
    <Compile Include="Cli.fs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Embed the seed db gzip-compressed (saves ~7 MB on the AOT binary).
         The .gz is regenerated by the CompressDatabase target below from
         rundir/seed.db just-in-time at build. EmbeddedResources.fs decompresses
         on first extract via GZipStream. -->
    <EmbeddedResource Include="../../../rundir/seed.db.gz">
      <LogicalName>data.db.gz</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="README-to-embed.md">
      <LogicalName>README.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Fail the build if there's no SEED to embed in Release mode.
       Deliberately rundir/seed.db and NOT rundir/data.db: data.db is a working store, holding relay
       secrets, sync identity and cursors in the same file as the packages. `export-seed`
       (LibDB.Seed.export) is the one place that knows what a stranger may inherit; this only insists
       that it has been run. -->
  <Target Name="CheckDatabaseExists" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Configuration)' == 'Release' And !Exists('../../../rundir/seed.db')"
           Text="No seed to embed (rundir/seed.db). Build one from your store first: scripts/run-local-exec export-seed rundir/seed.db" />
  </Target>

  <!-- Warn when the seed predates the package sources it is supposed to carry. A bare `dotnet publish`
       embeds whatever seed is lying around, so the binary's PackageRefs can point at hashes its own
       seed does not have, which fails only OUTSIDE the source tree.
       A warning rather than an error: mtime is a proxy, and a touched-but-unchanged .dark should not
       fail a build. `build-release-cli-exes.sh` exports first, so the scripted path stays quiet. -->
  <Target Name="WarnIfSeedIsStale" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' And Exists('../../../rundir/seed.db')">
    <Exec Command="find ../../../packages -name '*.dark' -newer ../../../rundir/seed.db -print -quit 2>/dev/null | grep -q ."
          ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="SeedIsStale" />
    </Exec>
    <Warning Condition="'$(SeedIsStale)' == '0'"
             Text="rundir/seed.db is older than a file in packages/. This binary may embed a seed that does not match its package refs, which fails only OUTSIDE the source tree. Re-export: scripts/run-local-exec export-seed rundir/seed.db" />
  </Target>

  <!-- Compress seed.db -> seed.db.gz at build time. Re-run only when the source file is newer
       than the .gz (or the .gz doesn't exist yet). -->
  <Target Name="CompressDatabase" BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' And Exists('../../../rundir/seed.db')"
          Inputs="../../../rundir/seed.db"
          Outputs="../../../rundir/seed.db.gz">
    <Exec Command="gzip -9 -c ../../../rundir/seed.db &gt; ../../../rundir/seed.db.gz" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>