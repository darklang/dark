<?xml version="1.0" encoding="utf-8"?>
<!--
  This moves all of the build files out of the build directory, so that they can be put
  in a single Docker volume.

  This file allows us to set where the build runs. It need to be in this
  file to be read by the msbuild tools before the SDK (which uses some
  of these values) is loaded.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Shared across every fsproj in backend/ -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>

    <!-- Where all build output goes. Computed from this file's own location
         rather than hardcoded to /home/dark/app/backend/Build: inside the dev
         container those are the same path, but the release image (and any
         other build host) checks out somewhere else, and a hardcoded path
         sends msbuild at a directory it can't write.
         Overridable with /p:DarkBuildDir=... if something needs to. -->
    <DarkBuildDir Condition="'$(DarkBuildDir)' == ''">$(MSBuildThisFileDirectory)Build</DarkBuildDir>
    <BaseOutputPath>$(DarkBuildDir)/out/$(MSBuildProjectName)</BaseOutputPath>
    <BaseIntermediateOutputPath>$(DarkBuildDir)/obj/$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <GenerateDocumentation>false</GenerateDocumentation>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- Run some parts of compilation in parallel: https://blog.nojaf.com/2023/08/22/unleashing-parallel-processing-in-your-fsharp-compiler/ -->
    <OtherFlags>$(OtherFlags) --test:GraphBasedChecking --test:ParallelOptimization --test:ParallelIlxGen</OtherFlags>
    <!-- warnings - https://learn.microsoft.com/en-us/dotnet/fsharp/language-reference/compiler-options#opt-in-warnings -->
    <OtherFlags>$(OtherFlags) --warnaserror --warnon:1182,3387,3366</OtherFlags>
    <!-- AOT only: drops the compiler-made `%A` ToString on records and unions, which a release
         build cannot print fields with anyway. The tests still use `%A`. -->
    <OtherFlags Condition="'$(PublishAot)' == 'true'">$(OtherFlags) --reflectionfree</OtherFlags>

    <!-- FSharp.Core is pinned in Directory.Packages.props like any other package. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>

    <!-- Each project's packages.lock.json records its whole graph, with hashes. CI restores in
         locked mode, so a lock that disagrees with Directory.Packages.props fails the job.
         A trimmed or AOT publish adds the SDK's ILLink and ILCompiler packages to every project,
         for the build host's runtime, which a checked-in lock can't hold. Its lock goes beside
         the build output instead, unchecked. Those packages' versions come with the SDK that
         global.json pins, and the rest resolve to the same pins as the locked restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DarkPublishRestore Condition="'$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true'">true</DarkPublishRestore>
    <NuGetLockFilePath Condition="'$(DarkPublishRestore)' == 'true'">$(BaseIntermediateOutputPath)publish.packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="'$(CI)' == 'true' And '$(DarkPublishRestore)' != 'true'">true</RestoreLockedMode>

    <!-- NU1603: a pinned version wasn't found, so NuGet took the next one up.
         That is a dependency changing without anyone changing it, so it fails the build. -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>

  <!-- A Debug build leaves the commit out of every project, so a commit or branch switch
       recompiles nothing. SourceLink writes the commit into each project's compile inputs, and the
       SDK appends it to the informational version. Release keeps both. `!= Release` rather than
       `== Debug`: this file is read before the SDK defaults Configuration to Debug. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
