#! /usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

TOKEN="${GITHUB_RELEASES_TOKEN}"
OWNER="darklang"
REPO="dark"
TARGET_COMMITISH="main"
NAME="cli-pre-release"
# What a person landing on the release page needs: how to install, and which of the eight files
# is theirs. Keep the URL in step with install.sh's header.
read -r -d '' BODY <<'END_BODY' || true
Install on Linux or macOS:

    curl -fsSL https://wip.darklang.com/install | sh

Or download the file for your platform below, and run it from wherever you put it:

- Linux x64: `linux-x64` (Alpine, or anywhere with no system libraries, such as an empty container: `linux-musl-x64`, which is statically linked)
- Linux ARM: `linux-arm64`, or `linux-arm` for 32-bit
- macOS: `osx-arm64` on Apple silicon, `osx-x64` on Intel

For example, on Linux x64:

    gunzip darklang-alpha-*-linux-x64.gz
    chmod +x darklang-alpha-*-linux-x64
    ./darklang-alpha-*-linux-x64

To check a download, run `sha256sum -c --ignore-missing darklang-alpha-*-sha256sums.txt` (on macOS, `shasum -a 256 -c --ignore-missing`) in the folder you downloaded it to.

A fresh install can't touch files, the network, processes or environment variables until you allow it; the refusal names the `dark permissions allow ...` command that does.
END_BODY

# Function to delete a release by ID
delete_release() {
  release_id=$1
  echo "Deleting release: $release_id"
  curl -s -L \
    -X DELETE \
    -H "Accept: application/vnd.github+json" \
    -H "Authorization: Bearer $TOKEN" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/repos/$OWNER/$REPO/releases/$release_id"
}

# This only runs for a pushed v* tag, and the release takes that tag's name.
# Choosing the version is someone else's job: scripts/deployment/release (or
# tag-release, if switched back on in CI) pushes the next v0.0.N, and a tag
# pushed by hand works too. This script never makes up a version itself.
if [ -z "${CIRCLE_TAG:-}" ]; then
  echo "No CIRCLE_TAG set. Releases are cut from a pushed tag; refusing to"
  echo "invent a version. Push a tag (v0.0.N) to publish one."
  exit 1
fi
TAG="$CIRCLE_TAG"
echo "Publishing for pushed tag: $TAG"

# Only commits on main are released. A v* tag pushed anywhere else would otherwise become the
# newest release, which is what `install.sh` and `dark update` install.
git fetch --quiet https://github.com/darklang/dark.git main
if ! git merge-base --is-ancestor "$CIRCLE_SHA1" FETCH_HEAD; then
  echo "$TAG points at $CIRCLE_SHA1, which is not on main. Not publishing it."
  exit 1
fi

## The gzipped binaries in the clis directory. Only those: the `.mode` file beside each one
## records how it was built, for the perf tooling, and is not a download.
FILES_DIR="/home/dark/app/clis"
shopt -s nullglob
binaries=("$FILES_DIR"/*.gz)
if [ "${#binaries[@]}" -eq 0 ]; then
  echo "No binaries in $FILES_DIR to publish."
  exit 1
fi

## One checksum file beside them, named like them so the asset name still starts with the
## build that `dark update` reads from it.
sums="$FILES_DIR/darklang-alpha-$(git rev-parse HEAD | cut -c 1-10)-sha256sums.txt"
(cd "$FILES_DIR" && sha256sum -- *.gz) > "$sums"
cat "$sums"


# Create the release as a draft, which nobody else sees, and publish it once every file is on
# it. Installers never see a release with files still missing, and the repo's immutable
# releases setting, which locks a release when it is published, leaves the uploads alone.
response=$(curl -s -L \
  -X POST \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: Bearer $TOKEN" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/repos/$OWNER/$REPO/releases" \
  -d "$(jq -n --arg tag "$TAG" --arg target "$TARGET_COMMITISH" --arg name "$NAME" --arg body "$BODY" \
    '{tag_name: $tag, target_commitish: $target, name: $name, body: $body,
      draft: true, prerelease: true, generate_release_notes: false}')")

echo "Release creation response: $response"

new_release_id=$(jq -r '.id' <<<"$response")
if [ "$new_release_id" == "null" ]; then
  echo "Release creation failed"
  exit 1
fi


# Upload files to the draft. Every upload is checked; on any failure the draft is deleted. The
# pushed tag is left in place.

## Extract the upload URL from the response: remove the {?name,label} part
upload_url=$(jq -r .upload_url <<<"$response" | sed -e "s/{?name,label}//")

for FILE_PATH in "${binaries[@]}" "$sums"; do
  FILE_NAME=$(basename "$FILE_PATH")
  echo "Uploading file: $FILE_PATH"

  upload_response=$(curl -s -L \
      -X POST \
      -H "Accept: application/vnd.github+json" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/octet-stream" \
      "$upload_url?name=$FILE_NAME" \
      --data-binary @"$FILE_PATH")

  if [ "$(jq -r '.state' <<<"$upload_response")" != "uploaded" ]; then
    echo "Uploading $FILE_NAME failed: $upload_response"
    delete_release "$new_release_id"
    echo "Deleted the draft. Leaving the pushed tag $TAG in place."
    exit 1
  fi
done

publish_response=$(curl -s -L \
  -X PATCH \
  -H "Accept: application/vnd.github+json" \
  -H "Authorization: Bearer $TOKEN" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/repos/$OWNER/$REPO/releases/$new_release_id" \
  -d '{"draft": false}')

if [ "$(jq -r '.draft' <<<"$publish_response")" != "false" ]; then
  echo "Publishing the release failed: $publish_response"
  delete_release "$new_release_id"
  echo "Deleted the draft. Leaving the pushed tag $TAG in place."
  exit 1
fi

echo "Done - new release published (old releases preserved)"
