#!/usr/bin/env bash
# Download the pinned darkc release builds a release CLI embeds, and check them:
#   scripts/compiler/fetch <dir>
#
# Writes <dir>/darkc-linux-x64 and <dir>/darkc-linux-arm64, the static builds darklang/compiler
# attaches to the release darkc-<first 9 of `pinnedCommit`> (in
# packages/darklang/compiler/darkc.dark), each checked against the release's SHA256SUMS.
# `build-release-cli-exes.sh --darkc-dir=<dir>` embeds them.

set -euo pipefail

if [[ $# -ne 1 ]]; then
  sed -n "2,8p" "$0" | sed "s/^# \{0,1\}//" >&2
  exit 1
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OUT="$1"
PINNED=$(sed -n "s/^val pinnedCommit = \"\([0-9a-f]*\)\"$/\1/p" "$DIR/packages/darklang/compiler/darkc.dark")
if [[ -z "$PINNED" ]]; then
  echo "No pinnedCommit in packages/darklang/compiler/darkc.dark" >&2
  exit 1
fi
BASE="https://github.com/darklang/compiler/releases/download/darkc-${PINNED:0:9}"

sha256_of() {
  if command -v sha256sum > /dev/null; then
    sha256sum "$1" | cut -d" " -f1
  else
    shasum -a 256 "$1" | cut -d" " -f1
  fi
}

mkdir -p "$OUT"
sums=$(curl --fail --silent --show-error --location --retry 3 "$BASE/SHA256SUMS")
# The release names each build after `uname -m` on the machine that built it.
for pair in linux-x64:linux-x86_64 linux-arm64:linux-aarch64; do
  target="${pair%%:*}"
  asset="darkc-${pair#*:}"
  file="$OUT/darkc-$target"
  curl --fail --silent --show-error --location --retry 3 -o "$file.partial" "$BASE/$asset"
  want=$(echo "$sums" | awk -v a="$asset" '$2 == a { print $1 }')
  got=$(sha256_of "$file.partial")
  if [[ -z "$want" || "$want" != "$got" ]]; then
    echo "$asset: sha256 is $got, the release's SHA256SUMS says ${want:-nothing}" >&2
    rm -f "$file.partial"
    exit 1
  fi
  chmod +x "$file.partial"
  mv "$file.partial" "$file"
  echo "Fetched $file ($got)"
done
