#! /usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

CHECK=255 # (0 mean check, 1 means format, 255 means error)
PRETTIER=0 # (0 means check prettier files, 1 means don't)
FSHARP=0 # (0 means check fsharp files, 1 means don't)
DARK=1 # (0 means check .dark files, 1 means don't; only --dark-only checks them)
FILES=()

#######################
# --help
#######################
function print_help ()
{
	printf '%s\n' "All formatting across Dark"
	printf 'Usage: %s [check|format] <files|dirs...> [--help] \n' "$0"
	printf '\t%s\n' "check: Error if files are not formatted. No argument means check all files. Does not error if file is not supported."
	printf '\t%s\n' "format: Format file or dir. Formats all files with no argument. Does not error or format if file is not supported."
  printf '\t%s\n' "--fsharp-only: Only check fsharp files (fsi, fs)"
  printf '\t%s\n' "--prettier-only: Only check prettier files (js, css, etc)"
  printf '\t%s\n' "--dark-only: Only check .dark files (under packages/, with the dev CLI). Without it, .dark is not checked"
}

FILES=()

# check for flags
for val in "${@}"; do
  case "$val" in
    --help)
        print_help
        exit 0
        ;;
    --prettier-only)
        FSHARP=1
        DARK=1
        ;;
    --fsharp-only)
        PRETTIER=1
        DARK=1
        ;;
    --dark-only)
        FSHARP=1
        PRETTIER=1
        DARK=0
        ;;
    check)
      CHECK=0
      ;;
    format)
      CHECK=1
      ;;
    *)
      FILES+=("$val")
      ;;
  esac
done

if [[ 255 -eq "$CHECK" ]]; then
  echo -e "usage:\n  ./scripts/formatting/format check [files]\n  ./scripts/formatting/format format [files]"
  exit 255
fi

#######################
# Parse rest of arguments
#######################
if [[ ${#FILES[@]} -eq 0 ]]; then
  FILES=(".")
fi

#######################
# functions
#######################
is_dir() {
  [[ -d "$1" ]]
}

is_fsharp() {
  [[ $1 == *.fs || $1 == *.fsi ]]
}

is_dark() {
  [[ $1 == *.dark ]]
}

is_allowed() {
  [[ $1 == *.fs || $1 == *.fsi \
    || $1 == *.css || $1 == *.scss \
    || $1 == *.js || $1 == *.ts \
    || $1 == *.html
    || $1 == *.res || $1 == *.resi ]]
}

all_prettier_files() {
  find "$1" \
    \( -path ".git" \
    -o -path "./later" \
    -o -path "rundir" \
    -o -path "./rundir" \
    -o -path "backend" \
    -o -path "backend/static" \
    -o -path "./backend/static" \
    -o -path "backend/Build" \
    -o -path "./backend/Build" \
    \) -prune -false \
    \
    -o -type f \
    \( -name "*.css" \
    -o -name "*.scss" \
    -o -name "*.js" \
    -o -name "*.ts" \
    -o -name "*.html" \
    \) -print0
}

all_fsharp_files() {
  find "$1" \
    \( -path ".git" \
    -o -path "./later" \
    -o -path "rundir" \
    -o -path "./rundir" \
    -o -path "backend" \
    -o -path "backend/Build" \
    -o -path "./backend/Build" \
    \) -prune -false \
    \
    -o -type f \
    \( -name "*.fs" \
    -o -name "*.fsi" \
    \) -print
}

check_fantomas () {
  xargs fantomas --check
}

check_prettier () {
  xargs -0 -r npx prettier --list-different
}

format_fantomas() {
  xargs fantomas
}

format_prettier() {
  xargs -0 -r npx prettier --write
}

do_fantomas() {
  if [[ 0 -eq "$CHECK" ]]; then
    check_fantomas
  else
    format_fantomas
  fi
}

do_prettier() {
  if [[ 0 -eq "$CHECK" ]]; then
    check_prettier
  else
    format_prettier
  fi
}

# `.dark` is formatted by `dark format`, so it needs the dev CLI built. Only packages/: it is package
# source, which is what `dark format` reads.
DARK_CLI=backend/Build/out/Cli/Debug/net11.0/Cli
DARK_PATHS=()

# The .dark files under <paths> that scripts/formatting/dark-format-skip doesn't leave as written.
dark_files() {
  local skip
  skip=$(grep -v -e '^#' -e '^$' scripts/formatting/dark-format-skip)
  find "$@" -name '*.dark' -type f | sort | while IFS= read -r f; do
    f=${f#./}
    local keep=1
    while IFS= read -r s; do
      [[ -n "$s" && "$f" == "$s"* ]] && keep=0
    done <<<"$skip"
    [[ "$keep" == 1 ]] && echo "$f"
  done
}

do_dark() {
  if [[ ${#DARK_PATHS[@]} -eq 0 ]]; then
    return 0
  fi
  if [[ ! -x "$DARK_CLI" ]]; then
    echo "skipped .dark: no dev CLI built (scripts/dev/build makes one)"
    return 0
  fi
  local files=()
  mapfile -t files < <(dark_files "${DARK_PATHS[@]}")
  if [[ ${#files[@]} -eq 0 ]]; then
    return 0
  fi
  # A collector per core: formatting many files spreads over the cores, which otherwise wait on
  # the one collector. Not the CLI's default, since for a short command it costs more than it saves.
  if [[ 0 -eq "$CHECK" ]]; then
    DOTNET_gcServer=1 ./scripts/run-cli format --check "${files[@]}"
  else
    DOTNET_gcServer=1 ./scripts/run-cli format "${files[@]}"
  fi
}

# TODO sqlfmt for sql
# TODO add python
# TODO bash formatter

#######################
# action files/dirs
#######################
for i in "${FILES[@]}"; do
  if [[ -d "$i" ]]; then
    if [[ 0 -eq "$FSHARP" ]]; then
      all_fsharp_files $i | do_fantomas
    fi
    if [[ 0 -eq "$PRETTIER" ]]; then
      # CLEANUP there's no JS/CSS files at the moment
      # all_prettier_files "$i" | do_prettier
      :
    fi
    if [[ 0 -eq "$DARK" ]]; then
      dir=$(realpath --relative-to=. "$i")
      if [[ "$dir" == "." ]]; then
        DARK_PATHS+=("packages")
      elif [[ "$dir" == packages || "$dir" == packages/* ]]; then
        DARK_PATHS+=("$dir")
      fi
    fi
  elif [[ 0 -eq "$DARK" ]] && is_dark "$i"; then
    DARK_PATHS+=("$i")
  elif is_allowed "$i"; then
    if is_fsharp "$i"; then
      if [[ 0 -eq "$FSHARP" ]]; then
        echo "$i" | do_fantomas
      fi
    else
      if [[ 0 -eq "$PRETTIER" ]]; then
        echo "$i" | do_prettier
      fi
    fi
  else
    echo "ignored : $i"
  fi
done

do_dark
