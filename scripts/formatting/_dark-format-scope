#!/usr/bin/env bash
# Which .dark files a change has to have formatted. Sourced by scripts/formatting/format and the
# dark-format gate, so both check the same files.

# The .dark files scripts/formatting/dark-format-skip lists are left as written.
dark_format_skipped() {  # dark_format_skipped <path relative to the checkout>
  local s
  while IFS= read -r s; do
    [[ -n "$s" && "$1" == "$s"* ]] && return 0
  done < <(grep -v -e '^#' -e '^$' scripts/formatting/dark-format-skip)
  return 1
}

# Every path this checkout changes against main, committed or not. Fails when there is no main.
dark_format_changed_files() {
  local base=""
  if [[ -n "${CIRCLE_SHA1:-}" ]]; then
    # CI checks out HEAD alone, so its history has to come too or nothing connects it to main
    git fetch -q --depth=200 --filter=blob:none origin "+refs/heads/main:refs/remotes/origin/main" "$(git rev-parse HEAD)" 2>/dev/null || true
  fi
  for ref in refs/remotes/upstream/main refs/remotes/origin/main; do
    if git rev-parse -q --verify "$ref" >/dev/null; then
      base=$(git merge-base "$ref" HEAD 2>/dev/null || true)
      [[ -n "$base" ]] && break
    fi
  done
  [[ -n "$base" ]] || return 1
  { git diff --name-only --no-renames "$base" HEAD; git diff --name-only HEAD; git ls-files -o --exclude-standard packages; } \
    | sort -u
}

# The changed .dark files, one a line. Fails when every file needs checking: there is no main, or
# the change touches the formatter, which can move any file.
dark_format_changed_dark_files() {
  local changed f
  if changed=$(dark_format_changed_files) \
    && ! grep -qE '^(packages/darklang/prettyPrinter/|packages/darklang/languageTools/formatter\.dark$|packages/darklang/stdlib/pretty\.dark$|backend/src/LibParser/|backend/src/Builtins/Builtins\.(Pure/Libs/Pretty|Language/Libs/Formatter)\.fs$|scripts/formatting/(dark-format-skip|_dark-format-scope)$)' <<<"$changed"; then
    while IFS= read -r f; do
      [[ "$f" == packages/*.dark && -f "$f" ]] && ! dark_format_skipped "$f" && echo "$f"
    done <<<"$changed"
    return 0
  fi
  return 1
}

dark_format_all() {
  local f
  find packages -name '*.dark' -type f | sort | while IFS= read -r f; do
    dark_format_skipped "$f" || echo "$f"
  done
}

# One CPU of each core this process may run on, comma-separated; empty where that can't be told.
dark_format_cores() {
  local allowed=() range i
  for range in $(sed -n 's/^Cpus_allowed_list:\s*//p' /proc/self/status 2>/dev/null | tr , ' '); do
    for ((i = ${range%-*}; i <= ${range#*-}; i++)); do allowed[i]=1; done
  done
  lscpu -p=CPU,CORE 2>/dev/null | grep -v '^#' | while IFS=, read -r cpu core; do
    [[ -n "${allowed[cpu]:-}" ]] && echo "$core,$cpu"
  done | sort -t, -k1,1n -s -u | cut -d, -f2 | paste -sd, -
}

# Run `dark format` with a collector per core, at most 8, on one hardware thread of each core.
# Formatting many files spreads over the cores, which otherwise wait on the one collector. A
# core's second thread makes it barely faster and doubles the CPU time it takes, and past 8
# collectors each collection costs more than it saves.
dark_format_run() {
  local cores n
  cores=$(dark_format_cores)
  if [[ -n "$cores" ]] && command -v taskset >/dev/null; then
    n=$(tr , '\n' <<<"$cores" | wc -l)
    DOTNET_gcServer=1 DOTNET_GCHeapCount=$(printf %x $((n < 8 ? n : 8))) taskset -c "$cores" "$@"
  else
    DOTNET_gcServer=1 "$@"
  fi
}
