// What each basic operation costs in *time*, measured against each other.
//
// The time counterpart to `costs.dark`, which measures the same operations in bytes. Work that
// moves allocation moves time far less, so time needs its own instrument: this says which
// operations the microseconds per list element are in.
//
//   ./scripts/run-cli run scripts/perf/workloads/probes/optime.dark
//
// Read it as a cost model, not a benchmark. The baseline row is the harness itself (a fold, a lambda
// application and an Int comparison per iteration) and every other row includes it, so compare rows
// to each other and subtract the baseline, never read a row as an absolute.
//
// Two things a row's name leaves out, because the harness needs every row to return an `Int`:
//
//   - the list and string rows wrap their result in `List.length` or `String.length`, an elided
//     package wrapper around a builtin, so each carries that call as well as the operation it names
//   - a row naming a `val` pays to load a package value first; `load a val` is there to subtract
//
// Neither matters when comparing rows to each other. Both matter a great deal if a row is read as the
// cost of the thing in its name.
//
// `saturate` below warms the process before the first row. Without it the table warms up as it
// runs, a positional bias bigger than most of what this table is used to measure. With it the two
// baselines agree to within ~0.25 us, which is this instrument's noise floor.
//
// `load a val (an Int)` is measured at both ends to keep that honest. Expect the first to read
// ~0.4 us above the second and no more: that gap is first-touch, not drift, since only the first
// row to reference a value pays it. A *larger* gap means the drift is back and the warm-up needs
// more.
//
// Each row is the fastest of three passes. Time is noisy where allocation is not, and the minimum
// of several passes is the least noisy estimator available: a pass can be slowed by the machine,
// never sped up by it.

type Rec = { a: Int64, b: String }

type Enum =
  | One(Int64)
  | Two(String, Int64)

let plainFn(i: Int64): Int64 = i + 1
let twoArgFn(i: Int64, j: Int64): Int64 = i + j
let recFn(i: Int64): Rec = Rec { a = i, b = "x" }
let optFn(i: Int64): Stdlib.Option.Option<Int64> = Stdlib.Option.Option.Some(i)
let listFn(i: Int64): List<Int64> = [ i ]

type Rec5 = { a: Int64, b: Int64, c: Int64, d: Int64, e: Int64 }

val preBuiltInt = 7
val preBuilt = Rec { a = 1, b = "x" }
val preBuilt5 = Rec5 { a = 1, b = 2, c = 3, d = 4, e = 5 }

// perf-probes-run runs a copy with this set to true: every case, fewer repetitions.
let smoke = false

let _smokeNotice =
  if smoke then Stdlib.printLine("SMOKE CHECK: figures are not performance measurements") else ()

let iterations = if smoke then 3 else 10000

/// One timed pass of `f`, in milliseconds.
///
/// The accumulator is never added to, for the reason `costs.dark` gives: summing the results would
/// make each row depend on how large its own accumulator grew, so the harness would measure the
/// arithmetic.
let onePass(f: Int64 -> Int64): Int64 =
  let t0 = Darklang.Cli.Telemetry.now()

  // Keep the match and comparisons taking both branches, even with few calls.
  let inputs = if smoke then [ 1, 5, 1001 ] else Stdlib.List.range(1, iterations)
  let _r =
    Stdlib.List.fold(inputs, 0, fun(acc, i) ->
      if (f(i)) == -987654321 then acc + 1 else acc)

  (Darklang.Cli.Telemetry.now()) - t0

let measure(label: String, f: Int64 -> Int64): Unit =
  // Warm first: the first call through a function loads and converts it.
  let _warm = onePass(f)
  let a = onePass(f)
  let b = onePass(f)
  let c = onePass(f)
  let best = Stdlib.min(a, Stdlib.min(b, c))
  // Nanoseconds per call, from milliseconds over `iterations`.
  let ns = (best * 1000000) / iterations
  Stdlib.printLine(label + "  " + (Stdlib.display(ns)) + " ns")

/// Run the process hot before the first row is timed.
///
/// Warming each row inside `measure` is not enough: the drift is the *process* getting faster, not
/// the row -- the same expression reads slower near the top of the table than at the end. This
/// exercises the paths the table shares (a fold, a lambda, package and builtin calls, a record, a
/// list) enough times to saturate that before any of it counts.
let saturate(n: Int64, acc: Int64): Int64 =
  if n == 0 then
    acc
  else
    let r = Rec { a = n, b = "x" }
    let l = Stdlib.List.map([ 1, 2, 3, 4, 5 ], fun x -> x + n)
    saturate(
      n - 1,
      acc + r.a + (plainFn(n)) + (twoArgFn(n, 1)) + (Stdlib.List.length(l)))

let _saturated = saturate((if smoke then 2 else 40000), 0)

Stdlib.printLine("--- harness")
measure("baseline (fold + lambda + compare)   ", fun i -> i)

Stdlib.printLine("--- calls")
measure("load a val (an Int)                  ", fun i -> preBuiltInt)
measure("call a 1-arg fn                      ", fun i -> plainFn(i))
measure("call a 2-arg fn                      ", fun i -> twoArgFn(i, 1))
measure("apply a lambda                       ", fun i -> (fun x -> x + 1)(i))
// The same builtin reached both ways, twice over. The gap in each pair is what is left of the
// package-call machinery after the thin-wrapper elision has taken what it can.
measure("call a builtin directly              ", fun i -> Builtin.stringLength("hello"))
measure("  the same, via its package wrapper  ", fun i -> Stdlib.String.length("hello"))
// `stringLength` counts grapheme clusters, so the pair above carries its body as well. `boolNot` has
// no body worth the name and is on the interpreter's operator fast path, so this pair is the call
// machinery on its own, with and without a wrapper around it.
// A wrapper called with an EXPLICIT type argument. The thin-wrapper elision declines when
// `typeArgs` is non-empty, so this pair is the un-elided cost of the same forwarding.
measure("builtin with a type arg              ", fun i -> Stdlib.String.length(Builtin.jsonSerialize<Int64>(i)))
measure("  the same, via its package wrapper  ", fun i -> Stdlib.String.length(Stdlib.Json.serialize<Int64>(i)))
measure("call a trivial builtin (boolNot)     ", fun i -> if Builtin.boolNot(true) then 1 else 0)
measure("  the same, via its package wrapper  ", fun i -> if Stdlib.Bool.not(true) then 1 else 0)

Stdlib.printLine("--- values")
measure("build a 2-field record, read a field", fun i -> (Rec { a = i, b = "x" }).a)
// Built once, outside the loop: `(recFn i).a` would be a package call plus a record construction
// plus a field read, and could not isolate any of the three.
// A `val` is a package value, and loading one is most of what these two rows cost. Subtract the
// `load a val` row for the field read itself, which is ~25 ns and nothing like what these look like.
measure("load a val, read its field           ", fun i -> preBuilt.a)
measure("load a val, read a 5-field's last    ", fun i -> preBuilt5.e)
measure("update a record field                ", fun i ->
  let r = Rec { a = i, b = "x" }
  ({ r with a = i + 1 }).a)
measure("build a 1-field enum                 ", fun i ->
  match Enum.One(i) with
  | One(v) -> v
  | Two(_, v) -> v)
measure("build an Option                      ", fun i ->
  match optFn(i) with
  | Some(v) -> v
  | None -> 0)
measure("build a tuple                        ", fun i ->
  let (a, b) = (i, i + 1)
  a + b)

Stdlib.printLine("--- lists")
measure("cons onto a 3-list                   ", fun i -> Stdlib.List.length(Stdlib.List.prepend([ 1, 2, 3 ], i)))
measure("append two 3-lists                   ", fun i -> Stdlib.List.length(Stdlib.List.concat([ 1, 2, 3 ], [ 4, 5, 6 ])))
// The get and set measurements include building the dictionary with `fromEntries`.
// Compare them with each other and with `build a 2-entry dict` to account for that cost.
measure("build a 2-entry dict                 ", fun i -> Stdlib.List.length(Stdlib.Dict.keys(Stdlib.Dict.fromEntries([ ("a", 1), ("b", 2) ]))))
measure("dict get, 2 entries                  ", fun i -> Stdlib.Option.withDefault(Stdlib.Dict.get(Stdlib.Dict.fromEntries([ ("a", 1), ("b", 2) ]), "a"), 0))
measure("dict set, onto 2 entries             ", fun i -> Stdlib.List.length(Stdlib.Dict.keys(Stdlib.Dict.set(Stdlib.Dict.fromEntries([ ("a", 1), ("b", 2) ]), "c", 3))))
measure("range 1..5                           ", fun i -> Stdlib.List.length(Stdlib.List.range(1, 5)))
measure("map over 5                           ", fun i -> Stdlib.List.length(Stdlib.List.map([ 1, 2, 3, 4, 5 ], fun x -> x + i)))
measure("fold over 5                          ", fun i -> Stdlib.List.fold([ 1, 2, 3, 4, 5 ], 0, fun(acc, x) -> acc + x))
measure("filter over 5                        ", fun i -> Stdlib.List.length(Stdlib.List.filter([ 1, 2, 3, 4, 5 ], fun x -> x > 2)))
measure("contains over 5                      ", fun i -> if Stdlib.List.contains([ 1, 2, 3, 4, 5 ], 3) then 1 else 0)
measure("any over 5                           ", fun i ->
  if Stdlib.List.any([ 1, 2, 3, 4, 5 ], fun x -> x > 4) then 1 else 0)
measure("findFirst over 5                     ", fun i ->
  match Stdlib.List.findFirst([ 1, 2, 3, 4, 5 ], fun x -> x > 4) with
  | Some(v) -> v
  | None -> 0)
measure("build a 5-element literal            ", fun i -> Stdlib.List.length([ i, i, i, i, i ]))

Stdlib.printLine("--- strings")
measure("concat two strings                   ", fun i -> Stdlib.String.length("ab" + "cd"))
measure("repeat one char 8 times             ", fun i -> Stdlib.String.length(Stdlib.String.repeat(" ", 8)))
measure("Int to String                        ", fun i -> Stdlib.String.length(Stdlib.display(i)))

Stdlib.printLine("--- control flow")
// What an `Int` operator costs: the interpreter evaluates it rather than calling a builtin.
// The `Apply` instruction is still there, so this is what a compile-time opcode would be aiming at.
measure("add two Ints                         ", fun i -> i + 1)
measure("compare two Ints                     ", fun i -> if i < 1000 then 1 else 0)
measure("if/else                              ", fun i -> if i > 1000 then 1 else 0)
measure("match on an Int                      ", fun i ->
  match i with
  | 1 -> 1
  | _ -> 0)

// Repeated last as well as first: the first row absorbs one-time costs, so the honest floor is this.
Stdlib.printLine("--- harness, again")
measure("load a val (an Int), at the end      ", fun i -> preBuiltInt)
measure("baseline again, at the end           ", fun i -> i)
