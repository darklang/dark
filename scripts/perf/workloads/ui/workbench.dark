// The interactive CLI's first frame and its keypresses, headless, at 120x40. `gate` budgets both.
//
// PERF_ITERS=0 builds the first frame the way `dark` with no arguments does and stops: the draft,
// Home's items, the badges and SCM status, the view, and the full paint as a string. Nothing is
// written to a terminal.
//
// PERF_ITERS=n presses n keys, per PERF_UI:
//   keypress  Code at Darklang.Stdlib.List with `map` selected, Down and Up in turn: the same two items
//   keyWalk   the same start, Down every time: n items, each seen for the first time
//   homeKey   Home, Down and Up in turn
//   moduleKey Code at Darklang.Stdlib on its first module, Down every time: n modules, each new
// Each press is what the CLI does per key: `onKey`, `refresh`, the view, and the diff against the last
// frame. `gate` runs this at 1 and 1+N, so the setup cancels.
let iters(): Int64 =
  match Stdlib.Env.get("PERF_ITERS") with
  | Some(s) ->
    match Stdlib.Int64.parse(s) with
    | Ok(n) -> n
    | Error(_) -> 0
  | None -> 0

type Screen =
  { state: Darklang.Cli.Workbench.State
    terminal: Stdlib.Cli.Tui.TerminalSession.State
    bytes: Int64 }

let size = Stdlib.Cli.Tui.Size { width = 120, height = 40 }
let noMods = Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false, ctrl = false, shift = false }
let c = Darklang.Cli.Workbench.component()

let present(prev: Darklang.Cli.Workbench.State, next: Darklang.Cli.Workbench.State, terminal: Stdlib.Cli.Tui.TerminalSession.State): Screen =
  let state = c.refresh(prev, next)
  let p = Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize(terminal, size, c.view(state, size))
  Screen { state = state, terminal = p.state, bytes = Stdlib.String.length(p.output) }

let press(s: Screen, key: Stdlib.Cli.Stdin.Key.Key, keyChar: Stdlib.Option.Option<String>): Screen =
  match c.onKey(s.state, key, noMods, keyChar) with
  | Stay(next) -> present(s.state, next, s.terminal)
  | Save(next) -> present(s.state, next, s.terminal)
  | Exit(_) -> s
  | Launch(_, _) -> s

let select(s: Screen, name: String): Screen =
  match Stdlib.List.findFirstIndex(s.state.items, fun it -> it.name == name) with
  | Some(i) -> present(s.state, { s.state with selected = i }, s.terminal)
  | None -> s

let openItem(s: Screen, name: String): Screen =
  press(select(s, name), Stdlib.Cli.Stdin.Key.Key.Enter, Stdlib.Option.Option.None)

// The bytes painted, or -1 once a Down did not move: the list ran out, and the rest would be repeats.
let pressN(s: Screen, n: Int64, bytes: Int64, alternate: Bool): Int64 =
  if n <= 0 then
    bytes
  else
    let up = alternate && (n % 2 == 0)
    let key = if up then Stdlib.Cli.Stdin.Key.Key.UpArrow else Stdlib.Cli.Stdin.Key.Key.DownArrow
    let next = press(s, key, Stdlib.Option.Option.None)
    if Stdlib.Bool.not(up) && next.state.selected == s.state.selected then
      0 - 1
    else
      pressN(next, n - 1, bytes + next.bytes, alternate)

let selectedName(s: Screen): String =
  match Stdlib.List.getAt(s.state.items, s.state.selected) with
  | Some(it) -> it.name
  | None -> ""

let firstModule(s: Screen): Screen =
  match Stdlib.List.findFirstIndex(s.state.items, fun it -> it.isModule) with
  | Some(i) -> present(s.state, { s.state with selected = i }, s.terminal)
  | None -> s

let measure(start: Screen, n: Int64, alternate: Bool): Unit =
  let t0 = Darklang.Cli.Telemetry.now()
  let bytes = pressN(start, n, 0, alternate)
  let t1 = Darklang.Cli.Telemetry.now()
  if bytes < 0 then
    Stdlib.printLine("ran out of items after " + (selectedName(start)))
  else
    Stdlib.printLine("elapsed_ms=" + (Stdlib.display(t1 - t0)) + " keys=" + (Stdlib.display(n)) + " bytes=" + (Stdlib.display(bytes)))

let branchId = Darklang.SCM.Branch.mainBranchId
let draft = Darklang.SCM.Draft.read()
let home =
  Darklang.Cli.Workbench.initialStateFrom(
    branchId,
    Stdlib.Option.Option.None,
    "perf-instance",
    Darklang.Cli.Workbench.Updates.Manual,
    draft)
let (wip, deprecated) = Darklang.Cli.Workbench.readBadges(home)
let home =
  { home with
      wipNames = wip
      deprecatedNames = deprecated
      scmStatus = Darklang.Cli.Workbench.scmStatusFrom(branchId, draft) }
let first = Stdlib.Cli.Tui.TerminalSession.preparePresentAtSize(Stdlib.Cli.Tui.TerminalSession.init(), size, c.view(home, size))
let screen = Screen { state = home, terminal = first.state, bytes = Stdlib.String.length(first.output) }
let n = iters()
let workload = Stdlib.Env.get("PERF_UI") |> Stdlib.Option.withDefault("keypress")

if n == 0 then
  Stdlib.printLine("first frame " + (Stdlib.display(screen.bytes)) + " bytes")
else if workload == "homeKey" then
  measure(screen, n, true)
else
  let code = press(screen, Stdlib.Cli.Stdin.Key.Key.D2, Stdlib.Option.Option.Some("2"))
  let stdlib = openItem(openItem(code, "Darklang"), "Stdlib")
  if workload == "moduleKey" then
    let start = firstModule(stdlib)
    // Without this a reshaped Stdlib would quietly measure keys somewhere else.
    if Stdlib.Bool.not(start.state.items |> Stdlib.List.any(fun it -> it.isModule)) then
      Stdlib.printLine("no modules in Darklang.Stdlib")
    else
      measure(start, n, false)
  else
    let atMap = select(openItem(stdlib, "List"), "map")
    // Without this a renamed module would quietly measure keys on Home instead.
    if selectedName(atMap) != "map" then
      Stdlib.printLine("did not reach Darklang.Stdlib.List.map")
    else
      measure(atMap, n, workload != "keyWalk")
