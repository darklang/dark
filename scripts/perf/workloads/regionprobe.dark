// What each region of a workbench frame costs, and whether a keypress changes it.
//
// `redrawprobe.dark` says 2 of 40 rows change per arrow key. This says which regions those rows are
// in, and what each region costs to build -- the map a "don't rebuild what did not change" change
// would need.
//
//   ./scripts/run-cli run scripts/perf/workloads/regionprobe.dark

let base =
  Darklang.Cli.Workbench.initialState
    Darklang.SCM.Branch.mainBranchId
    Stdlib.Option.Option.None
    "perf"
    "perf-instance"
    (Stdlib.List.range 0 40)

let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }
let mods = Stdlib.Cli.Stdin.Modifiers.Modifiers { alt = false; ctrl = false; shift = false }

let screen =
  Stdlib.Cli.UI.Layout.Region { top = 1; left = 1; rows = 40; cols = 120 }

let sidebarRegion =
  Stdlib.Cli.UI.Layout.Region { top = 2; left = 1; rows = 37; cols = 32 }

let bodyRegion =
  Stdlib.Cli.UI.Layout.Region { top = 2; left = 33; rows = 37; cols = 88 }

let rounds = 20

let timeIt (label: String) (f: Int -> Int) : Unit =
  let _warm = f 0
  let t0 = Darklang.Cli.Telemetry.now ()
  let _r = Stdlib.List.fold (Stdlib.List.range 1 rounds) 0 (fun acc i -> acc + (f i))
  let t1 = Darklang.Cli.Telemetry.now ()
  Stdlib.printLine
    (label ++ "  " ++ (Stdlib.Int.toString (Stdlib.Int.divide (t1 - t0) rounds)) ++ " ms")

let step (s: Darklang.Cli.Workbench.State) (k: Stdlib.Cli.Stdin.Key.Key) : Darklang.Cli.Workbench.State =
  match Darklang.Cli.Workbench.handleKey s k mods Stdlib.Option.Option.None with
  | Continue next -> next
  | Exit next -> next
  | Launch(next, _) -> next
  | ToPrompt next -> next

let spanCount (s: List<Stdlib.Cli.UI.Layout.Span>) : Int = Stdlib.List.length s

timeIt "whole view (viewAtSize)      " (fun i ->
  Stdlib.List.length (Darklang.Cli.Workbench.viewAtSize base size).rows)
timeIt "renderFull (spans only)      " (fun i ->
  spanCount (Darklang.Cli.Workbench.renderFull base size))
timeIt "  renderSidebar              " (fun i ->
  spanCount (Darklang.Cli.Workbench.renderSidebar base 0 0 sidebarRegion))
timeIt "  renderBody                 " (fun i ->
  spanCount (Darklang.Cli.Workbench.renderBody base bodyRegion))

let spans = Darklang.Cli.Workbench.renderFull base size

timeIt "  Canvas.compose (real spans)" (fun i ->
  Stdlib.List.length (Stdlib.Cli.UI.Canvas.compose 120 40 spans))
timeIt "  Canvas.compose (no spans)  " (fun i ->
  Stdlib.List.length (Stdlib.Cli.UI.Canvas.compose 120 40 []))

Stdlib.printLine ("spans in a frame: " ++ (Stdlib.Int.toString (Stdlib.List.length spans)))

let afterRight = step base Stdlib.Cli.Stdin.Key.Key.RightArrow

let sidebarSame =
  (Darklang.Cli.Workbench.renderSidebar base 0 0 sidebarRegion)
  == (Darklang.Cli.Workbench.renderSidebar afterRight 0 0 sidebarRegion)

let bodySame =
  (Darklang.Cli.Workbench.renderBody base bodyRegion)
  == (Darklang.Cli.Workbench.renderBody afterRight bodyRegion)

Stdlib.printLine
  ("sidebar unchanged by RightArrow: " ++ (Stdlib.Bool.toString sidebarSame))
Stdlib.printLine ("body unchanged by RightArrow:    " ++ (Stdlib.Bool.toString bodySame))
