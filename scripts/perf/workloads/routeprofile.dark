// Where routing one HTTP request goes, by package fn. Detailed timing on.
//
// The counterpart to viewprofile.dark for the server path. `scripts/perf/http` says what a request
// costs end to end; this says which functions it spends that in, and pipes into fnprofile:
//
//   ./scripts/run-cli run scripts/perf/workloads/routeprofile.dark | ./scripts/perf/fnprofile --divide 50
//
// Routing only: no socket, no parse, no serialize. Handlers are deliberately trivial so the number
// is the framing around them, which is the part `scripts/perf/suite` never touches.

let hello (req: Stdlib.Http.Request) : Stdlib.Http.Response =
  Stdlib.Http.responseWithText "hello" 200

let handlers =
  [ Stdlib.HttpServer.Handler
      { route = "/hello"; method = "GET"; handler = hello }
    Stdlib.HttpServer.Handler
      { route = "/items"; method = "GET"; handler = hello }
    Stdlib.HttpServer.Handler
      { route = "/items/:id"; method = "GET"; handler = hello }
    Stdlib.HttpServer.Handler
      { route = "/health"; method = "GET"; handler = hello } ]

let req =
  Stdlib.Http.Request
    { url = "GET /items/42?q=1 HTTP/1.1"
      headers = [ ("host", "localhost"); ("accept", "*/*") ]
      body = Stdlib.Blob.empty }

let routeN (i: Int) (acc: Int) : Int =
  if i == 0 then
    acc
  else
    let resp = Stdlib.HttpServer.routeRequest handlers req
    routeN (i - 1) (acc + resp.statusCode)

let _warm = routeN 20 0
let _on = Darklang.LanguageTools.InterpreterStats.enableDetailedTiming true
let _reset = Darklang.LanguageTools.InterpreterStats.reset ()
let _r = routeN 50 0
Stdlib.printLine (Darklang.LanguageTools.InterpreterStats.get ())
