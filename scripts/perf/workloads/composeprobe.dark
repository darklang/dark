// What `composeRow` spends its time on. `compose` is 17 ms of a 29 ms frame; bucketing is 5.65 of
// that and this is the other 11.35.
//
//   ./scripts/run-cli run scripts/perf/workloads/composeprobe.dark

let base =
  Darklang.Cli.Workbench.initialState
    Darklang.SCM.Branch.mainBranchId
    Stdlib.Option.Option.None
    "perf"
    "perf-instance"
    (Stdlib.List.range 0 40)

let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }
let spans = Darklang.Cli.Workbench.renderFull base size
let rounds = 20

let timeIt (label: String) (f: Int -> Int) : Unit =
  let _warm = f 0
  let t0 = Darklang.Cli.Telemetry.now ()
  let _r = Stdlib.List.fold (Stdlib.List.range 1 rounds) 0 (fun acc i -> acc + (f i))
  let t1 = Darklang.Cli.Telemetry.now ()
  Stdlib.printLine
    (label
     ++ "  "
     ++ (Stdlib.Int.toString (Stdlib.Int.divide ((t1 - t0) * 1000) rounds))
     ++ " us")

/// Every row's spans, in row order, as `compose` would hand them to `composeRow`.
let rowsOfSpans =
  Stdlib.List.range 0 39
  |> Stdlib.List.map (fun r -> Stdlib.List.filter spans (fun sp -> sp.row == r))

/// The whole of composeRow, for all 40 rows.
let allComposeRow (unit: Int) : Int =
  rowsOfSpans
  |> Stdlib.List.fold 0 (fun acc rs ->
    acc + (Stdlib.String.length (Stdlib.Cli.UI.Canvas.composeRow 120 rs)))

/// Just the width measurement composeRow does per span.
let allStyledWidth (unit: Int) : Int =
  spans
  |> Stdlib.List.fold 0 (fun acc sp -> acc + (Stdlib.Cli.Tui.Text.styledWidth sp.text))

/// Just the segment placement, no rendering: overlay each span into the row's list.
let allOverlay (unit: Int) : Int =
  rowsOfSpans
  |> Stdlib.List.fold 0 (fun acc rs ->
    let placed =
      rs
      |> Stdlib.List.fold [] (fun segs sp ->
        Stdlib.Cli.UI.Canvas.overlay
          segs
          (Stdlib.Cli.UI.Canvas.Segment
            { col = sp.col; text = sp.text; width = Stdlib.Cli.Tui.Text.styledWidth sp.text }))
    acc + (Stdlib.List.length placed))

/// renderSegments as it is: fold, appending onto a growing string per segment.
let renderByAppend (width: Int) (segments: List<Stdlib.Cli.UI.Canvas.Segment>) : String =
  let (text, _endCol) =
    segments
    |> Stdlib.List.fold ("", 0) (fun acc seg ->
      let (out, col) = acc
      if seg.col >= width then
        acc
      else
        let start = Stdlib.Int.max col seg.col
        let gap = Stdlib.String.repeat " " (Stdlib.Int.max 0 (start - col))
        let room = width - start
        let (clipped, used) =
          if seg.col >= col && seg.width <= room then
            (seg.text, seg.width)
          else
            let c = Stdlib.Cli.Tui.Text.clipToWidth seg.text room
            (c, Stdlib.Cli.Tui.Text.styledWidth c)
        (out ++ gap ++ clipped, start + used))
  text

/// The same, collecting pieces and joining once.
let renderByJoin (width: Int) (segments: List<Stdlib.Cli.UI.Canvas.Segment>) : String =
  let (pieces, _endCol) =
    segments
    |> Stdlib.List.fold ([], 0) (fun acc seg ->
      let (out, col) = acc
      if seg.col >= width then
        acc
      else
        let start = Stdlib.Int.max col seg.col
        let gap = Stdlib.String.repeat " " (Stdlib.Int.max 0 (start - col))
        let room = width - start
        let (clipped, used) =
          if seg.col >= col && seg.width <= room then
            (seg.text, seg.width)
          else
            let c = Stdlib.Cli.Tui.Text.clipToWidth seg.text room
            (c, Stdlib.Cli.Tui.Text.styledWidth c)
        (Stdlib.List.push (Stdlib.List.push out gap) clipped, start + used))
  Stdlib.String.join (Stdlib.List.reverse pieces) ""

let placedRows =
  rowsOfSpans
  |> Stdlib.List.map (fun rs ->
    rs
    |> Stdlib.List.fold [] (fun segs sp ->
      Stdlib.Cli.UI.Canvas.overlay
        segs
        (Stdlib.Cli.UI.Canvas.Segment
          { col = sp.col; text = sp.text; width = Stdlib.Cli.Tui.Text.styledWidth sp.text })))

timeIt "  renderSegments (append)   " (fun i ->
  placedRows
  |> Stdlib.List.fold 0 (fun acc segs -> acc + (Stdlib.String.length (renderByAppend 120 segs))))
timeIt "  renderSegments (join)     " (fun i ->
  placedRows
  |> Stdlib.List.fold 0 (fun acc segs -> acc + (Stdlib.String.length (renderByJoin 120 segs))))

/// overlay as it is: `List.any` over everything placed, per span.
let overlayAsIs (unit: Int) : Int =
  rowsOfSpans
  |> Stdlib.List.fold 0 (fun acc rs ->
    let placed =
      rs
      |> Stdlib.List.fold [] (fun segs sp ->
        Stdlib.Cli.UI.Canvas.overlay
          segs
          (Stdlib.Cli.UI.Canvas.Segment
            { col = sp.col; text = sp.text; width = Stdlib.Cli.Tui.Text.styledWidth sp.text }))
    acc + (Stdlib.List.length placed))

/// The same, but carrying the rightmost end placed so far. A span starting at or after it cannot
/// overlap anything, which is the ordinary case, and that is one comparison instead of a `List.any`.
let overlayWithEnd (unit: Int) : Int =
  rowsOfSpans
  |> Stdlib.List.fold 0 (fun acc rs ->
    let (placed, _end) =
      rs
      |> Stdlib.List.fold ([], 0) (fun st sp ->
        let (segs, rightmost) = st
        let w = Stdlib.Cli.Tui.Text.styledWidth sp.text
        let seg = Stdlib.Cli.UI.Canvas.Segment { col = sp.col; text = sp.text; width = w }
        let nextEnd = Stdlib.Int.max rightmost (sp.col + w)
        if sp.col >= rightmost then
          (Stdlib.List.append segs [ seg ], nextEnd)
        else
          (Stdlib.Cli.UI.Canvas.overlay segs seg, nextEnd))
    acc + (Stdlib.List.length placed))

timeIt "  overlay as-is             " overlayAsIs
timeIt "  overlay w/ rightmost end  " overlayWithEnd

timeIt "all 40 composeRow          " allComposeRow
timeIt "  styledWidth x 252        " allStyledWidth
timeIt "  overlay x 252 (+ widths) " allOverlay
Stdlib.printLine ("spans: " ++ (Stdlib.Int.toString (Stdlib.List.length spans)))
