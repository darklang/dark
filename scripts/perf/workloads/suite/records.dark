// Records and enums: construction, field access, functional update, and matching on both. Every
// Dark program that models anything does this constantly, and none of it goes through the list path.
let iters(): Int64 =
  match Stdlib.Env.get("PERF_ITERS") with
  | Some(s) ->
    match Stdlib.Int64.parse(s) with
    | Ok(n) -> n
    | Error(_) -> 0
  | None -> 0

type Point = { x: Int64, y: Int64, label: String }

type Shape =
  | Dot(Point)
  | Seg(Point, Point)
  | Group(List<Shape>)

let span(s: Shape): Int64 =
  match s with
  | Dot(p) -> p.x + p.y
  | Seg(a, b) -> (b.x - a.x) + (b.y - a.y)
  | Group(inner) -> Stdlib.List.fold(inner, 0, fun(acc, sh) -> acc + (span(sh)))

let step(p: Point): Point = { p with x = p.x + 1, y = p.y + 2 }

let tilt(p: Point): Int64 =
  match p with
  | { x = 0, y = 0 } -> 0
  | { x, y } -> x - y

let work(n: Int64): Int64 =
  let p = Point { x = n, y = n + 1, label = "p" }
  let q = step(step(p))
  let shape = Shape.Group([Shape.Dot(p), Shape.Seg(p, q), Shape.Dot(q)])
  (span(shape)) + q.x + (tilt(q))

let repeat(times: Int64, acc: Int64): Int64 =
  if times <= 0 then acc else repeat(times - 1, acc + (work(times)))

let _warm = repeat(20, 0)
let t0 = Darklang.Cli.Telemetry.now()
let result = repeat(iters(), 0)
let t1 = Darklang.Cli.Telemetry.now()
Stdlib.printLine("elapsed_ms=" + (Stdlib.display(t1 - t0)) + " result=" + (Stdlib.display(result)))
