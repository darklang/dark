// Dicts: insert, lookup, iterate. A different container representation from lists, and the one
// most programs reach for when they have keys.
let iters(): Int64 =
  match Stdlib.Env.get("PERF_ITERS") with
  | Some(s) ->
    match Stdlib.Int64.parse(s) with
    | Ok(n) -> n
    | Error(_) -> 0
  | None -> 0

let build(n: Int64): Dict<String, Int64> =
  Stdlib.List.fold(Stdlib.List.range(1, n), Stdlib.Dict.empty, fun(acc, i) ->
    Stdlib.Dict.set(acc, "k" + (Stdlib.display(i)), i))

let work(n: Int64): Int64 =
  let d = build(20)
  let got =
    match Stdlib.Dict.get(d, "k7") with
    | Some(v) -> v
    | None -> 0
  got + (Stdlib.List.length(Stdlib.Dict.keys(d))) + n

let repeat(times: Int64, acc: Int64): Int64 =
  if times <= 0 then acc else repeat(times - 1, acc + (work(times)))

let _warm = repeat(10, 0)
let t0 = Darklang.Cli.Telemetry.now()
let result = repeat(iters(), 0)
let t1 = Darklang.Cli.Telemetry.now()
Stdlib.printLine("elapsed_ms=" + (Stdlib.display(t1 - t0)) + " result=" + (Stdlib.display(result)))
