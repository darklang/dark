// A server for measuring the async path: accept, parse, run a Dark handler, serialize, respond.
//
// Deliberately small handlers. The point is what a request costs *around* the handler -- the parts
// the single-process workloads never touch -- so the handler itself should not dominate. `/json`
// does a little real work so the number isn't purely framing overhead.

type Item = { id: Int64, name: String, tags: List<String> }

let helloFn(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.Http.responseWithText(Stdlib.Http.Status.ok, "hello")

let jsonFn(req: Stdlib.Http.Request): Stdlib.Http.Response =
  let item = Item { id = 1, name = "item", tags = ["a", "b", "c"] }
  Stdlib.Http.responseWithText(Stdlib.Http.Status.ok, Stdlib.Json.serialize<Item>(item))

let echoFn(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.Http.responseWithText(Stdlib.Http.Status.ok, Stdlib.Utf8.decodeWithReplacement(req.body))

// How much this process has allocated so far. The load driver reads it before and after the
// measured run, which is the only way to get a per-request number out of a server that never exits.
let allocFn(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.Http.responseWithText(Stdlib.Http.Status.ok, Stdlib.display(Darklang.LanguageTools.InterpreterStats.allocatedBytes()))

// Interpreter counters for the VM that ran this request. Each request gets its own VM, so this is
// per-request work: how many instructions, builtin calls and package calls a request costs.
let statsFn(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.Http.responseWithText(Stdlib.Http.Status.ok, Darklang.LanguageTools.InterpreterStats.get())

// A value, not a function. As `handlers ()` this rebuilt five records and five lambdas on every
// request, which is not what the documented usage does and made the benchmark measure the harness.
let handlers =
  [ Stdlib.HttpServer.Handler { route = "/hello", method = "GET", handler = helloFn }
    Stdlib.HttpServer.Handler { route = "/json", method = "GET", handler = jsonFn }
    Stdlib.HttpServer.Handler { route = "/echo", method = "POST", handler = echoFn }
    Stdlib.HttpServer.Handler { route = "/alloc", method = "GET", handler = allocFn }
    Stdlib.HttpServer.Handler { route = "/stats", method = "GET", handler = statsFn } ]

let router(req: Stdlib.Http.Request): Stdlib.Http.Response =
  Stdlib.HttpServer.routeRequest(handlers, req)

let portNumber(): Int64 =
  match Stdlib.Env.get("PERF_HTTP_PORT") with
  | Some(s) ->
    match Stdlib.Int64.parse(s) with
    | Ok(n) -> n
    | Error(_) -> 9095
  | None -> 9095

let serve(port: Stdlib.Net.Port): Int64 =
  match
    Stdlib.HttpServer.serve(
      (Stdlib.HttpServer.Config.Config
        { port = port
          maxBodyBytes = 1048576
          injectStandardHeaders = true
          canonicalizeFromForwardedProto = false
          // Off: a stdout line per request would be most of what we're measuring.
          logRequests = false }),
      router,
      fun () -> Stdlib.printLine("LISTENING"))
  with
  | Ok(_) -> 0
  | Error(e) ->
    Stdlib.printLine("serve failed: " + e)
    1

let main(): Int64 =
  match Stdlib.Net.Port.fromInt64(portNumber()) with
  | Ok(port) -> serve(port)
  | Error(e) ->
    Stdlib.printLine($"serve failed: PERF_HTTP_PORT {e}")
    1

main()
