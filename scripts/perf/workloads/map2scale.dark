// `List.map2shortest` over a long list, where the accumulator's shape shows.
//
// The Dark version accumulated with `pushBack`, which copies, so it was quadratic in the list
// length. A view build only ever stacks 3-9 components, so the view cannot tell the difference;
// this can.
val iterations = 200

let xs = Stdlib.List.range 1 300
let ys = Stdlib.List.range 1 300

let run (n: Int) (acc: Int) : Int =
  if n <= 0 then
    acc
  else
    let zipped = Stdlib.List.map2shortest xs ys (fun a b -> a + b)
    run (n - 1) (acc + (Stdlib.List.length zipped))

let _warm = run 5 0
let t0 = Darklang.Cli.Telemetry.now ()
let total = run iterations 0
let elapsed = (Darklang.Cli.Telemetry.now ()) - t0

Stdlib.printLine
  ((Stdlib.Int.toString iterations)
   ++ " x map2shortest over 300: "
   ++ (Stdlib.Int.toString elapsed)
   ++ " ms (checksum "
   ++ (Stdlib.Int.toString total)
   ++ ")")
