// Marginal cost of applying a lambda, measured without a fold anywhere in the harness.
//
// `lambdapath.dark` times its rows inside a `List.fold`, which is fine normally and useless when the
// thing being probed is the lambda machinery itself -- a stub that breaks lambda application breaks
// the harness first. This drives everything with self-recursion instead.
//
//   ./scripts/run-cli run scripts/perf/workloads/framestub.dark

val iterations = 400

let small = Stdlib.List.range 1 50
let large = Stdlib.List.range 1 250

/// Walk a list, applying `f` to each element.
let walkApply (xs: List<Int>) (f: Int -> Int) (acc: Int) : Int =
  match xs with
  | [] -> acc
  | head :: rest -> walkApply rest f (acc + (f head))

/// The same walk with no application in it, to price the recursion.
let walkOnly (xs: List<Int>) (acc: Int) : Int =
  match xs with
  | [] -> acc
  | head :: rest -> walkOnly rest (acc + head)

let repeatApply (n: Int) (xs: List<Int>) (acc: Int) : Int =
  if n <= 0 then
    acc
  else
    repeatApply (n - 1) xs (acc + (walkApply xs (fun x -> x + 1) 0))

let repeatOnly (n: Int) (xs: List<Int>) (acc: Int) : Int =
  if n <= 0 then acc else repeatOnly (n - 1) xs (acc + (walkOnly xs 0))

let timeApply (xs: List<Int>) : Int =
  let t0 = Darklang.Cli.Telemetry.now ()
  let _r = repeatApply iterations xs 0
  (Darklang.Cli.Telemetry.now ()) - t0

let timeOnly (xs: List<Int>) : Int =
  let t0 = Darklang.Cli.Telemetry.now ()
  let _r = repeatOnly iterations xs 0
  (Darklang.Cli.Telemetry.now ()) - t0

let bestApply (xs: List<Int>) : Int =
  let _w = timeApply xs
  let a = timeApply xs
  let b = timeApply xs
  Stdlib.Int.min a b

let bestOnly (xs: List<Int>) : Int =
  let _w = timeOnly xs
  let a = timeOnly xs
  let b = timeOnly xs
  Stdlib.Int.min a b

let report (label: String) (sm: Int) (lg: Int) : Unit =
  let ns = Stdlib.Int.divide ((lg - sm) * 1000000) (iterations * 200)
  Stdlib.printLine (label ++ "  " ++ (Stdlib.Int.toString ns) ++ " ns")

let _a = report "walk + applied lambda   " (bestApply small) (bestApply large)
let _b = report "walk alone              " (bestOnly small) (bestOnly large)

Stdlib.printLine "(applied lambda = row 1 minus row 2)"
