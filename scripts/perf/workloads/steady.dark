let work(n: Int64): Int64 =
  Stdlib.List.length(Stdlib.List.map(Stdlib.List.range(1, n), fun x -> x + 1))

let repeat(times: Int64, n: Int64, acc: Int64): Int64 =
  if times <= 0 then acc else repeat(times - 1, n, acc + (work(n)))

let _warm = repeat(20, 50, 0)
let t0 = Darklang.Cli.Telemetry.now()
let result = repeat(200, 50, 0)
let t1 = Darklang.Cli.Telemetry.now()
Stdlib.printLine("elapsed_ms=" + (Stdlib.display(t1 - t0)))
