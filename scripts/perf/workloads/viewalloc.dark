// Bytes allocated to build one workbench view. The allocation counterpart to keypress.dark.
let base =
  Darklang.Cli.Workbench.initialState
    Darklang.SCM.Branch.mainBranchId
    Stdlib.Option.Option.None
    "perf"
    "perf-instance"
    (Stdlib.List.range 0 40)

let size = Stdlib.Cli.Tui.Size { width = 120; height = 40 }

let viewN (i: Int) (s: Darklang.Cli.Workbench.State) (acc: Int) : Int =
  if i == 0 then
    acc
  else
    let v = Darklang.Cli.Workbench.viewAtSize s size
    viewN (i - 1) s (acc + (Stdlib.List.length v.rows))

let _warm = viewN 2 base 0
let a0 = Darklang.LanguageTools.InterpreterStats.allocatedBytes ()
let _v = viewN 10 base 0
let a1 = Darklang.LanguageTools.InterpreterStats.allocatedBytes ()

Stdlib.printLine
  ("bytes per view build: "
   ++ (Stdlib.Int.toString (Stdlib.Int.divide (Stdlib.Int.fromInt64 (a1 - a0)) 10)))
