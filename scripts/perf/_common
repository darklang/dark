#!/usr/bin/env bash
# Sourced by the perf tools; not runnable on its own.

# Where a published CLI can be. Three layouts, and a tool that knows only one of them passes in one
# environment and fails in another:
#   clis/                       `build-release-cli-exes.sh` *moves* it here, emptying the publish dir
#   net10.0/publish/            `dotnet publish` with no runtime identifier, which is what CI runs
#   net10.0/<rid>/publish/      `dotnet publish -r <rid>`, before the move above
RELEASE_EXE_PATHS=(
  clis/darklang-alpha-*-linux-x64
  backend/Build/out/Cli/Release/net10.0/publish/Cli
  backend/Build/out/Cli/Release/net10.0/*/publish/Cli
)

# Which publish mode produced a released binary: `aot`, `r2r`, or `unknown` for one built before
# the marker existed.
#
# It matters because the two are not comparable. AOT starts about five times faster than R2R and
# allocates a different amount, so a budget recorded against one is meaningless against the other,
# and nothing in the filename says which you have. `build-release-cli-exes.sh` writes the marker.
release_exe_mode() {
  local exe="$1"
  if [[ -f "$exe.mode" ]]; then cat "$exe.mode"; else echo "unknown"; fi
}

# Refuse rather than report a number that compares across modes.
#
# Same shape as `assert_release_exe_fresh`, and the same reason: a measurement that looks fine and
# means nothing is worse than no measurement.
assert_release_exe_mode() {
  local exe="$1" want="$2" who="$3"
  local have
  have="$(release_exe_mode "$exe")"
  if [[ "$have" == "$want" ]]; then return 0; fi
  {
    echo "$who: $(basename "$exe") was published as $have, and the budget is $want."
    echo "  AOT and R2R are not comparable -- about 5x apart on startup alone -- so this would"
    echo "  report a number that means nothing. Build the mode the budget is in:"
    echo "    scripts/build/build-release-cli-exes.sh --mode=$want"
  } >&2
  return 1
}

# The newest published CLI, or empty if there isn't one.
release_exe() {
  # shellcheck disable=SC2012 # need mtime order, and no filename here has a space in it
  ls -t "${RELEASE_EXE_PATHS[@]}" 2>/dev/null | head -1 || true
}

# Where a binary writes its telemetry: under the store it is using. Published and Debug builds both
# honour DARK_CONFIG_RUNDIR, and every perf script re-execs into the container, which sets it, so
# there is no per-binary case here to get wrong.
telemetry_path() {
  echo "${DARK_CONFIG_RUNDIR}/logs/telemetry.jsonl"
}

# `$1` is the tool's name. Prints where a published CLI was looked for, since an empty path in a
# "not found" message tells the reader nothing.
no_release_exe() {
  {
    echo "$1: no published CLI found. Looked for, newest first:"
    printf '  %s\n' "${RELEASE_EXE_PATHS[@]}"
    echo "Build one with scripts/build/build-release-cli-exes.sh, or publish the solution."
  } >&2
}

# Refuse a published CLI that predates the source it is meant to contain. A stale artifact does not
# produce a stale-looking number -- it produces a plausible one, for the previous build, and a budget
# compared against it says nothing. `find -print -quit` stops at the first newer file, so this costs
# nothing on a warm tree.
assert_release_exe_fresh() {
  local exe=$1 tool=$2 newer
  newer=$(find packages backend/src -type f \( -name '*.dark' -o -name '*.fs' \) \
    -newer "$exe" -print -quit 2>/dev/null || true)
  [[ -z "$newer" ]] && return 0
  {
    echo "$tool: $(basename "$exe") is older than $newer."
    echo "  It would be measured instead of your change. Rebuild it:"
    echo "    scripts/build/build-release-cli-exes.sh"
  } >&2
  return 1
}
