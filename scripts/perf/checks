#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# By-hand checks for changes to the interpreter, the type checker or error construction.
#
# Not assertions: read each result against the "expect" line printed above it. They exist because
# the backend suite can pass while the interpreter returns a quietly wrong answer.
#
# Error paths get most of the attention. They only run once something has already gone wrong, so a
# change can garble every message with every test green.
set -euo pipefail
cd /home/dark/app

EXE="backend/Build/out/Cli/Debug/net10.0/Cli"
[[ -x "$EXE" ]] || { echo "perf/checks: no CLI at $EXE -- run scripts/dev/build" >&2; exit 2; }

CHECKS="scripts/perf/workloads/checks"
SCRATCH=rundir/perf-scratch
mkdir -p "$SCRATCH"

run() { # run <title> <expect> <script>
  printf '\n=== %s\n    expect: %s\n' "$1" "$2"
  "$EXE" run "$3" 2>&1 || true
}

# Writes a case to scratch and returns its path. Inline rather than one committed file per case:
# most are three lines whose whole content is the error they die with.
case_file() { local name="$1"; shift; local f="$SCRATCH/check-$name.dark"; cat > "$f"; echo "$f"; }

# --- happy paths -------------------------------------------------------------------------------

run "semantics" \
    "fib 18 = 2584, areas [12.56636, 12.0, 3.0], and the JSON round trips both ways" \
    "$CHECKS/semantics.dark"

# --- type checking -----------------------------------------------------------------------------

run "argument of the wrong type" \
    "a type error naming the parameter, Int64 and String" \
    "$(case_file type-error <<'DARK'
let takesInt (n: Int64) : Int64 = n + 1L
let main () : Int64 =
  Builtin.debug "bad" (takesInt "not an int")
  0L
main ()
DARK
)"

# `tryUnifySync` answers "same declared type, no type arguments" without consulting the type store,
# since a value built through an alias carries the *underlying* type's name and so equal names
# cannot mean an alias. This is what catches that path accepting anything.
#
# The two records must be genuinely different: names are content hashes, so `type A = { x: Int }`
# and `type B = { x: Int }` are the SAME type and passing one for the other tests nothing.
run "record of the wrong type" \
    "1, then a type error naming both hashes" \
    "$(case_file type-identity <<'DARK'
type A = { x: Int }
type B = { y: String }
let takesA (a: A) : Int = a.x
let main () : Int64 =
  Builtin.debug "takesA a" (takesA (A { x = 1 }))
  Builtin.debug "takesA b" (takesA (B { y = "no" }))
  0L
main ()
DARK
)"

# --- record construction failures --------------------------------------------------------------
#
# The declared type is resolved only once a field has already failed to unify, so these four
# messages come from paths the happy case never takes.

record_case() { # record_case <name> <expect> <literal>
  run "record: $1" "$2" "$(case_file "rec-$1" <<DARK
type Point = { x: Int; y: String }
let main () : Int64 =
  let bad = $3
  Builtin.debug "should not get here" bad
  0L
main ()
DARK
)"
}

record_case wrong-field-type "Expected String for field \`y\`, but got 2 (an Int)" 'Point { x = 1; y = 2 }'
record_case missing-field    "Missing field \`y\`"                                 'Point { x = 1 }'
record_case extra-field      "No field named \`z\`"                                'Point { x = 1; y = "a"; z = 3 }'
record_case duplicate-field  "Duplicate field \`x\`"                               'Point { x = 1; x = 2; y = "a" }'

# --- record update failures -----------------------------------------------------------------
#
# Separate from construction: updates go through `DvalCreator.recordUpdate`, a different function
# with its own error messages, and nothing else exercises them.

update_case() { # update_case <name> <expect> <update-expr>
  run "record update: $1" "$2" "$(case_file "upd-$1" <<DARK
type Point = { x: Int; y: String }
let main () : Int64 =
  let p = Point { x = 1; y = "a" }
  let bad = $3
  Builtin.debug "should not get here" bad
  0L
main ()
DARK
)"
}

update_case wrong-type   "Failed to create updated record. Expected String for field \`y\`, but got 2 (an Int)" '{ p with y = 2 }'
update_case unknown-field "No field named \`z\`"                                                              '{ p with z = 3 }'

# --- call stacks -------------------------------------------------------------------------------

# Worth checking whenever frames start sharing ExecutionPoints. Not `Builtin.testRuntimeError`:
# that exists only in the test harness, so in the CLI it fails name resolution instead of raising.
#
# Two Lambda frames, not the four this expected while `map` was written in Dark: two of those were
# the fold's own `fun acc elem -> push acc (fn elem)`, one per level, and a native `map` does not
# have one. The frames that matter are the caller's, and they must still be there -- applying a
# lambda from a builtin runs it in a borrowed VM whose frames the caller's chain cannot reach, and
# they only appear because the error carries them back (`Execution.raiseFromApplied`).
run "error raised inside nested lambdas" \
    "two map levels, two Lambda frames, then 'Cannot divide by 0'" \
    "$(case_file lambda-callstack <<'DARK'
let main () : Int64 =
  let grid = [[1L; 2L]; [3L; 4L]]
  let ys = grid |> Stdlib.List.map (fun row ->
    row |> Stdlib.List.map (fun x -> if x == 3L then x / 0L else x))
  Builtin.debug "ys" ys
  0L
main ()
DARK
)"

# --- behaviour preservation ----------------------------------------------------------------------
#
# The only check with a recorded expected output, since it pins behaviour rather than reading well.
# String.split and String.length take a fast path for strings whose grapheme clusters are exactly
# their chars; these are the cases where it must decline -- non-ASCII, an empty separator, and CRLF,
# which is one cluster, so "a\r\nb" split on "\n" is one part, not two.
printf '\n=== string grapheme-cluster fast path\n    expect: no diff\n'
if "$EXE" run "$CHECKS/string-egc.dark" 2>&1 | grep '^DEBUG' | diff - "$CHECKS/string-egc.expected"; then
  echo "    ok, 18 cases byte-identical"
fi

# The operator fast path answers these without the builtin's record, its capability check or either
# type check, so nothing in the ordinary builtin machinery verifies it. This one asserts for itself;
# every entry in the `FastOps` table wants a line in it.
printf '\n=== operator fast path matches the builtins it stands in for\n    expect: no FAIL lines\n'
if "$EXE" run "$CHECKS/fastopcheck.dark" 2>&1 | grep '^FAIL'; then
  echo "    FAILED -- a fast-path entry disagrees with its builtin"
else
  echo "    ok"
fi

run "SGR width, stripping, clipping and wrapping" \
    "5, 3, 1, then abc, abc, and 2 wrapped lines" \
    "$CHECKS/sgrcheck.dark"

# A render change has to produce the same bytes. Regenerate deliberately when the view itself
# changes, with the command in the header of goldenview.dark -- never to make this pass.
printf '\n=== workbench view renders byte-identically\n    expect: no diff\n'
if "$EXE" run "$CHECKS/goldenview.dark" 2>&1 | diff - "$CHECKS/goldenview.expected"; then
  echo "    ok, three sizes byte-identical"
fi
