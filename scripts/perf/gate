#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"
. ./scripts/devcontainer/_lower-priority "$0" "$@"

# Fails if the reference workload allocates more than its budget. CI does not run it; see
# `measure-release` and `track`, which run it on each release and chart the readings over time.
#
# The published gate checks six things, all on the binary just built:
#   - steady.dark's allocation, warm, net of startup (the number this gate started with)
#   - startup's allocation, warm: `run` of a one-line script (workloads/startup.dark)
#   - allocation per iteration of every workload in workloads/suite/, as `suite` measures it
#   - the cold first run's allocation and peak memory, on a store grown from nothing
#   - the interactive CLI's first frame and its keys: VM instructions, allocation and, per key,
#     SQL statements (_ui.py)
#   - CPU for `fib 24`, `lists.dark` and `ls Darklang.Stdlib.List`, paired against the newest
#     release (_paired.py)
# Allocation can't see a call getting slower, and the warm run can't see the first run getting
# bigger.
#
# Startup is two thirds of a whole steady.dark run, so a budget on the total would dilute a
# regression in the workload threefold. The two are budgeted apart: a startup regression still
# fails, and the workload's number is its own.
#
#   scripts/perf/gate              the debug build's allocation, reported but NOT gated
#   scripts/perf/gate --published  against the published one. This is the gate.
#   scripts/perf/gate --published --update   rewrite the published budget to what it measures
#   scripts/perf/gate --published --report   the same readings, but over budget does not fail
#   scripts/perf/gate --published --json F   also write every reading and its budget to F
#
# Nothing in CI runs it. `measure-release` runs it with `--report --json` on a release binary, and
# `track` charts those readings over releases; the budget is the baseline the charts draw. Exit 2,
# could not measure, still fails in report mode: a run that measured nothing must not read as a pass.
#
# Allocation, not time: it doesn't care how loaded the machine is. It is not byte-identical either --
# see docs/perf/playbook.md for the noise floor.
#
# Only the published build is budgeted. Debug allocates for interpreter hooks (`noteValue`, a
# closure per frame) that the Release optimiser elides, so its number tracks a configuration nobody
# ships. A debug run still prints what it allocated; it just does not fail.
# The budget is in scripts/perf/budget.json.

set -euo pipefail
. ./scripts/perf/_common

PUBLISHED=false
UPDATE=false
REPORT=false
JSON_OUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --published) PUBLISHED=true ;;
    --update) UPDATE=true ;;
    --report) REPORT=true ;;
    --json) JSON_OUT="${2:?--json needs a path}"; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done
# Absolute, because the gate changes HOME and the caller's relative path should not move with it.
[[ -z "$JSON_OUT" ]] || JSON_OUT=$(realpath -m "$JSON_OUT")
export PERF_GATE_REPORT="$REPORT"

if [[ "$PUBLISHED" == "true" ]]; then
  EXE=$(release_exe)
  # A binary named by PERF_EXE is a downloaded release (see scripts/perf/measure-release): built from its own
  # commit, not this tree, and AOT because every linux-x64 release is. Neither check applies.
  if [[ -z "${PERF_EXE:-}" ]]; then
    [[ -x "$EXE" ]] && { assert_release_exe_fresh "$EXE" perf/gate || exit 2; }
    # And that it is the same publish mode the budget was recorded in. See `release_exe_mode`.
    WANT_MODE=$(python3 -c "import json;print(json.load(open('scripts/perf/budget.json')).get('steady',{}).get('publishedMode','r2r'))")
    [[ -x "$EXE" ]] && { assert_release_exe_mode "$EXE" "$WANT_MODE" perf/gate || exit 2; }
  fi
else
  EXE="backend/Build/out/Cli/Debug/net11.0/Cli"
fi

if [[ ! -x "$EXE" ]]; then
  if [[ "$PUBLISHED" == "true" ]]; then no_release_exe perf/gate
  else echo "perf/gate: no CLI at $EXE -- run scripts/dev/build" >&2
  fi
  exit 2
fi

BUDGET_FILE="scripts/perf/budget.json"
# PERF_WORKLOADS: another copy of workloads/, which measure-release points at a release's own.
WORKLOAD="${PERF_WORKLOADS:-scripts/perf/workloads}/steady.dark"
STARTUP="${PERF_WORKLOADS:-scripts/perf/workloads}/startup.dark"
# Warm readings of each, alternated. A single reading lands in one of the clusters
# docs/perf/playbook.md describes, and a difference of two single readings moves about 4%; the
# median of three each holds it inside the tolerance.
SAMPLES=3

# The published gate grows its own store, so the first run is cold and the number doesn't depend on
# whose store this is. The debug build keeps the dev store: it has no budget to be cold against.
if [[ "$PUBLISHED" == "true" ]]; then
  # PERF_HOME: a HOME the caller made and cleans up (measure-release, which also links an old
  # release's beside-the-binary store into it).
  if [[ -n "${PERF_HOME:-}" ]]; then
    GATE_HOME="$PERF_HOME"
  else
    GATE_HOME=$(mktemp -d "${TMPDIR:-/tmp}/perf-gate.XXXXXX")
    trap 'rm -rf "$GATE_HOME"' EXIT
  fi
  export HOME="$GATE_HOME"
  # Older releases keep their store beside the binary unless the rundir is named, and an explicit
  # one wins in every release, so name it: the store and its telemetry are then always here.
  export DARK_CONFIG_RUNDIR="$GATE_HOME/.darklang"
fi

TELEMETRY=$(telemetry_path)

# Recording off: a dev shell sets it on, a user's run has it off, and with it on the interpreter
# holds every argument and result alive for the whole run.
#
# `--no-trace`, not just the environment variable, and this is load-bearing. The ladder in
# `LibDB/Tracing.fs` is env, then the store's `trace.record`, then the flag, and a STORED setting
# beats the environment by design. So on any store where somebody has run `dark traces record on`,
# the env var below is silently overridden and the gate measures a recording run, about a fifth of
# the budget. The flag pins the setting for the run and beats both.
run_script() {
  DARK_TELEMETRY=1 DARK_CONFIG_TRACE_DETAIL=off "$EXE" --no-trace run "$1"
}

# The first run grows the store from the embedded seed, so it isn't counted in steady's number. It
# is budgeted on its own instead: it is what every new user's first command costs.
#
# Peak memory depends on the GC's settings as much as on the program, and those depend on the
# machine: gen0's size follows the CPU cache, and a container memory limit, which a CI container
# may have and a laptop doesn't, turns on a hard heap limit.
# Both are pinned here so the reading is the same on any box. Allocation doesn't move with either.
# The values are hex with no 0x: with one, .NET ignores the setting without saying so.
COLD=$(DOTNET_GCgen0size=1000000 DOTNET_GCHeapHardLimit=180000000 \
  DARK_TELEMETRY=1 DARK_CONFIG_TRACE_DETAIL=off \
  python3 ./scripts/perf/_rusage.py "$EXE" --no-trace run "$WORKLOAD") || exit 2
COLD_PEAK_MB=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["peak_rss_mb"])' "$COLD")
COLD_ALLOC=$(python3 ./scripts/perf/_total-alloc.py "$TELEMETRY") || exit 2
# One parser for this, shared with `suite`: see scripts/perf/_total-alloc.py.
STARTUP_READINGS=""
TOTAL_READINGS=""
for _ in $(seq "$SAMPLES"); do
  rm -f "$TELEMETRY"
  run_script "$STARTUP" > /dev/null
  STARTUP_READINGS="$STARTUP_READINGS $(python3 ./scripts/perf/_total-alloc.py "$TELEMETRY")" || exit 2
  rm -f "$TELEMETRY"
  OUTPUT=$(run_script "$WORKLOAD")
  TOTAL_READINGS="$TOTAL_READINGS $(python3 ./scripts/perf/_total-alloc.py "$TELEMETRY")" || exit 2
done
echo "$OUTPUT" | head -c 200
echo

# The suite's workloads, each per iteration with startup differenced out (see `suite`). Debug has
# no budget for them, so it skips them.
SUITE_JSON=""
UI_JSON=""
MISSING=""
if [[ "$PUBLISHED" == "true" ]]; then
  SUITE_JSON="$GATE_HOME/suite.json"
  SUITE_ITERS=$(python3 -c "import json;print(json.load(open('scripts/perf/budget.json'))['suite']['iters'])")
  # In report mode a section that cannot run is recorded as missing rather than ending the run: an
  # older release may predate a workload, and the rest of its numbers are still worth having.
  if ! ./scripts/perf/suite --release --iters "$SUITE_ITERS" --json "$SUITE_JSON" > /dev/null; then
    [[ "$REPORT" == "true" ]] || exit 2
    echo "perf/gate: the suite did not run; recorded as missing"; SUITE_JSON=""; MISSING="$MISSING suite"
  fi
  UI_JSON="$GATE_HOME/ui.json"
  UI_KEYS=$(python3 -c "import json;print(json.load(open('scripts/perf/budget.json'))['ui']['keys'])")
  if ! python3 ./scripts/perf/_ui.py "$EXE" "$UI_KEYS" "$UI_JSON"; then
    [[ "$REPORT" == "true" ]] || exit 2
    echo "perf/gate: the interactive CLI did not run; recorded as missing"; UI_JSON=""; MISSING="$MISSING ui"
  fi
fi

# The store is measured too, not just the binary: a working rundir carrying your own ops allocates a
# couple of percent more than a freshly loaded one, which is enough to read as a regression.
echo "store    ${HOME}/.darklang"
echo "build    $(exe_build_tag "$EXE")"

MODE=$([[ "$PUBLISHED" == "true" ]] && echo published || echo debug)

BUDGET_STATUS=0
PERF_GATE_JSON="$JSON_OUT" PERF_GATE_MISSING="$MISSING" \
python3 - "$BUDGET_FILE" "$TOTAL_READINGS" "$UPDATE" "$MODE" "$COLD_ALLOC" "$COLD_PEAK_MB" "$STARTUP_READINGS" "$SUITE_JSON" "$UI_JSON" <<'PY' || BUDGET_STATUS=$?
import json, os, statistics, subprocess, sys, traceback

# A traceback exits 1, which is "over budget", which `--report` passes. A crash is 2.
def _crash(kind, value, tb):
    traceback.print_exception(kind, value, tb)
    sys.stderr.flush()
    os._exit(2)
sys.excepthook = _crash

report_only = os.environ.get("PERF_GATE_REPORT") == "true"
json_out = os.environ.get("PERF_GATE_JSON") or None
# Every reading, keyed the same way on every run, with the budget it was held to. This is what
# `scripts/perf/track` charts across releases, so a key renamed here is a series
# broken there.
recorded = {}

def record(key, got, base=None, tol=None):
    recorded[key] = {"value": got, "budget": base, "tolerance": tol}

def finish(code):
    if json_out and mode == "published" and not update:
        git = lambda *a: subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()
        os.makedirs(os.path.dirname(json_out), exist_ok=True)
        with open(json_out, "w") as f:
            json.dump({"commit": git("rev-parse", "HEAD"),
                       "committedAt": git("show", "-s", "--format=%cI", "HEAD"),
                       "overBudget": code == 1,
                       "missing": os.environ.get("PERF_GATE_MISSING", "").split(),
                       "readings": recorded}, f, indent=2)
            f.write("\n")
    sys.exit(code)

budget_file, update = sys.argv[1], sys.argv[3] == "true"
readings = lambda s: [int(x) for x in s.split()]
total = int(statistics.median(readings(sys.argv[2])))
startup = int(statistics.median(readings(sys.argv[7])))
# What the budget is on: the workload, with startup taken off.
measured = total - startup
cold_alloc, cold_peak_mb = int(sys.argv[5]), float(sys.argv[6])
suite = {r["workload"]: r["bytesPerIter"] for r in json.load(open(sys.argv[8]))} if sys.argv[8] else {}
ui = json.load(open(sys.argv[9])) if sys.argv[9] else {}

budget = json.load(open(budget_file))
mode = sys.argv[4]
# `.get`, not `[...]`: debug has no budget and a missing key must not be a crash.
limit = budget["steady"].get(mode)
tolerance = budget["steady"]["tolerance"]
startup_limit = budget["startup"].get(mode)
startup_tolerance = budget["startup"]["tolerance"]
mb = lambda b: f"{b/1e6:.1f} MB"
mb2 = lambda b: f"{b/1e6:.2f} MB"
bytes_ = lambda b: f"{b:.0f} bytes"
# A key workload new to budget.json starts with these. SQL statements repeat exactly, so any more is a regression.
UI_TOLERANCES = {"instructionsTolerance": 0.02, "allocatedTolerance": 0.05, "sqlTolerance": 0}

# Prints a reading against its budget and says whether it is over the ceiling. Under the floor is
# only said: the budget is moved when the charts are read, not by the PR that earned it.
def over(key, label, got, base, tol, show, indent=""):
    record(key, got, base, tol)
    top = base * (1 + tol)
    print(f"{indent}{label} {show(got)}; budget {show(base)}, ceiling {show(top)}")
    if got > top:
        tag = "OVER (reported, not failing)" if report_only else "FAIL"
        print(f"{tag}: {label} {(got / base - 1) * 100:.1f}% over budget." if base else f"{tag}: {label} over a budget of 0.")
        return True
    if got < base * (1 - tol):
        print(f"{indent}  {(1 - got / base) * 100:.1f}% under budget.")
    return False

# Retired on purpose, so `--update` does not quietly put it back.
if mode == "debug" and update:
    print("perf/gate: the debug budget was retired; there is nothing to update.")
    print("`scripts/perf/gate --published --update` is the one that exists.")
    sys.exit(2)

if mode == "debug":
    # Exit 2, not 0. This run measured something and checked it against nothing, and a caller
    # reading only the exit code would take a 0 for a budget that held. 2 is what the rest of
    # this script uses for "could not do the job", as against 1 for "over budget".
    print(f"steady.dark (debug) allocated {mb2(measured)} net of startup ({mb2(startup)}), "
          f"{mb2(total)} in all; not budgeted, so this does not gate.")
    print(f"first run allocated {mb(cold_alloc)}, peak {cold_peak_mb:.0f} MB (on the dev store, so not cold).")
    print("The published build is what is budgeted: `scripts/perf/gate --published`.")
    sys.exit(2)

if update:
    budget["steady"][mode] = measured
    budget["startup"][mode] = startup
    budget["cold"]["allocated"] = cold_alloc
    budget["cold"]["peakRssMB"] = round(cold_peak_mb)
    for name, per in suite.items():
        budget["suite"]["workloads"].setdefault(name, {"tolerance": 0.05})[mode] = per
    for name, r in ui.items():
        b = budget["ui"].setdefault(name, dict(UI_TOLERANCES))
        b.update(instructions=r["instructions"], allocated=r["allocated"])
        if name != "firstFrame":
            b["sql"] = r["sql"]
    with open(budget_file, "w") as f:
        json.dump(budget, f, indent=2)
        f.write("\n")
    print(f"{mode} budget updated to {mb2(measured)} net of startup, startup {mb2(startup)}; "
          f"first run {mb(cold_alloc)}, peak {cold_peak_mb:.0f} MB; "
          + ", ".join(f"{name} {bytes_(per)}/iter" for name, per in suite.items())
          + "".join(f", {name} {r['instructions']:,} instructions {mb2(r['allocated'])}"
                    for name, r in ui.items()))
    sys.exit(0)

# The first run, on a store grown from nothing, with tolerances of its own.
cold = budget["cold"]
cold_failed = any([
    over("cold.allocated", "first run allocated", cold_alloc, cold["allocated"], cold["allocatedTolerance"], mb),
    over("cold.peakRssMB", "first run peak memory", cold_peak_mb, cold["peakRssMB"], cold["peakRssTolerance"],
         lambda v: f"{v:.0f} MB"),
])

# A workload added to the suite with no budget yet reports and passes, like the rest below.
workloads = budget["suite"]["workloads"]
print(f"suite, allocation per iteration over {budget['suite']['iters']} iterations")
suite_failed = any([over(f"suite.{name}", name, per, workloads[name][mode], workloads[name]["tolerance"], bytes_, "  ")
                    for name, per in suite.items() if mode in workloads.get(name, {})])
for name in suite.keys() - {name for name in workloads if mode in workloads[name]}:
    record(f"suite.{name}", suite[name])
    print(f"  {name} {bytes_(suite[name])}; no budget recorded yet.")

# Instructions and allocation, not time: both repeat run to run. A budget not recorded yet reports
# and passes, like the suite's.
labels = {"firstFrame": "first frame", "keypress": "keypress, Down/Up at List.map",
          "keyWalk": "keypress, Down through List", "homeKey": "Home keypress, Down/Up",
          "moduleKey": "keypress, Down through Stdlib's modules"}
ui_failed = False
if ui:
    print("interactive CLI at 120x40")
for name, r in ui.items():
    b = budget["ui"].get(name, {})
    checks = [("instructions", "instructions", lambda v: f"{v:,.0f}"), ("allocated", "allocated", mb2),
              ("sql", "SQL statements", lambda v: f"{v:,.0f}")]
    for field, what, show in checks:
        if field not in r:
            continue
        key = f"ui.{name}.{field}"
        if field in b:
            ui_failed = over(key, f"{labels[name]}: {what}", r[field], b[field], b[f"{field}Tolerance"], show, "  ") or ui_failed
        else:
            record(key, r[field])
            print(f"  {labels[name]}: {what} {show(r[field])}; no budget recorded yet.")
for name, r in ui.items():
    record(f"ui.{name}.ms", r["ms"])
if ui:
    print("  wall time, not gated: " + ", ".join(f"{labels[name]} {r['ms']} ms" for name, r in ui.items()))
failed = cold_failed or suite_failed or ui_failed

# A budget nobody has recorded yet reports and passes. Better than a number carried over from the
# other build mode, which would be wrong in a way that looks right.
if limit is None or startup_limit is None:
    print(f"steady.dark ({mode}) allocated {mb2(measured)} net of startup ({mb2(startup)}); no budget recorded yet.")
    flag = " --published" if mode == "published" else ""
    print(f"Pin it with `scripts/perf/gate{flag} --update`.")
    record("startup", startup)
    record("steady", measured)
    finish(1 if failed else 0)

print(f"steady.dark ({mode}) allocated {mb2(total)} in all, median of {len(readings(sys.argv[2]))} warm runs")
steady_failed = any([
    over("startup", "startup", startup, startup_limit, startup_tolerance, mb2, "  "),
    over("steady", "steady.dark net of startup", measured, limit, tolerance, mb2, "  "),
])

if failed or steady_failed:
    print("This ran against a store the binary grew itself, as measure-release does, so a working dev")
    print("store (2.1 MB higher) is not the reason. docs/perf/playbook.md has the readings.")
finish(1 if failed or steady_failed else 0)
PY

# `--update` rewrites the allocation budgets only. The paired check has no number to update: it is a
# ratio against a release.
[[ "$PUBLISHED" == "true" && "$UPDATE" == "false" && "$BUDGET_STATUS" -ne 2 ]] || exit "$BUDGET_STATUS"
echo
PAIRED_STATUS=0
PERF_GATE_JSON="$JSON_OUT" python3 ./scripts/perf/_paired.py "$EXE" "$HOME" || PAIRED_STATUS=$?
if [[ "$REPORT" == "true" && "$PAIRED_STATUS" -eq 2 ]]; then
  echo "perf/gate: the CPU comparison did not run; recorded as missing"
  PAIRED_STATUS=0
  [[ -z "$JSON_OUT" ]] || python3 -c 'import json,sys; p=sys.argv[1]; d=json.load(open(p)); d["missing"].append("paired"); json.dump(d, open(p, "w"), indent=2)' "$JSON_OUT"
fi
STATUS=$(( BUDGET_STATUS > PAIRED_STATUS ? BUDGET_STATUS : PAIRED_STATUS ))
# Report mode passes over budget (1) and nothing else: 2 is a run that could not measure.
if [[ "$REPORT" == "true" && "$STATUS" -eq 1 ]]; then
  echo
  echo "perf/gate: over budget, reported only (--report)."
  STATUS=0
fi
exit "$STATUS"
