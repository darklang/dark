#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# Fails if the reference workload allocates more than its budget. This is the only perf tool in CI,
# deliberately: one script, a couple of seconds. A long perf job gets ignored and then disabled.
#
#   scripts/perf/gate              the debug build's allocation, reported but NOT gated
#   scripts/perf/gate --published  against the published one, as CI does. This is the gate.
#   scripts/perf/gate --update     rewrite the published budget to what it measures
#
# Allocation, not time: it doesn't care how loaded the machine is. It is not byte-identical either --
# see docs/perf/playbook.md for the noise floor.
#
# Only the published build is budgeted. Debug had its own budget and it was retired: most of the
# debug overage was `noteValue`, an interpreter hook that allocates a closure per frame in Debug
# and is elided entirely by the Release optimiser, so the debug number tracked a configuration
# nobody ships while the one we do ship was inside its budget. A debug run still prints what it
# allocated, because the number is worth seeing; it just does not fail.
# The budget is in scripts/perf/budget.json -- lower it in the same commit that earns it.

set -euo pipefail
. ./scripts/perf/_common

PUBLISHED=false
UPDATE=false
for arg in "$@"; do
  case "$arg" in
    --published) PUBLISHED=true ;;
    --update) UPDATE=true ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

if [[ "$PUBLISHED" == "true" ]]; then
  EXE=$(release_exe)
  [[ -x "$EXE" ]] && { assert_release_exe_fresh "$EXE" perf/gate || exit 2; }
  # And that it is the same publish mode the budget was recorded in. See `release_exe_mode`.
  WANT_MODE=$(python3 -c "import json;print(json.load(open('scripts/perf/budget.json')).get('steady',{}).get('publishedMode','r2r'))")
  [[ -x "$EXE" ]] && { assert_release_exe_mode "$EXE" "$WANT_MODE" perf/gate || exit 2; }
else
  EXE="backend/Build/out/Cli/Debug/net10.0/Cli"
fi

if [[ ! -x "$EXE" ]]; then
  if [[ "$PUBLISHED" == "true" ]]; then no_release_exe perf/gate
  else echo "perf/gate: no CLI at $EXE -- run scripts/dev/build" >&2
  fi
  exit 2
fi

BUDGET_FILE="scripts/perf/budget.json"
WORKLOAD="scripts/perf/workloads/steady.dark"

TELEMETRY=$(telemetry_path)

# Recording off: a dev shell sets it on, a user's run has it off, and with it on the interpreter
# holds every argument and result alive for the whole run.
#
# `--no-trace`, not just the environment variable, and this is load-bearing. The ladder in
# `LibDB/Tracing.fs` is env, then the store's `trace.record`, then the flag, and a STORED setting
# beats the environment by design. So on any store where somebody has run `dark traces record on`
# -- which the walkthrough tells you to do, and which every dev store on this branch therefore has
# -- the env var below was silently overridden and the gate measured a recording run. That is worth
# 2.1 MB on this workload, 22% of the budget, and it is why a local red here has looked like a
# regression all week. The flag pins the setting for the run and beats both.
run_workload() {
  DARK_TELEMETRY=1 DARK_CONFIG_TRACE_DETAIL=off "$EXE" --no-trace run "$WORKLOAD"
}

# One throwaway run first: against an empty store the first invocation seeds it, which on the
# published binary is an extra ~470 MB that would otherwise be recorded as the budget.
run_workload > /dev/null
rm -f "$TELEMETRY"
OUTPUT=$(run_workload)
echo "$OUTPUT" | head -c 200
echo

# The store is measured too, not just the binary: a working rundir carrying your own ops allocates a
# couple of percent more than a freshly loaded one, which is enough to read as a regression.
echo "store    ${DARK_CONFIG_RUNDIR}"

MODE=$([[ "$PUBLISHED" == "true" ]] && echo published || echo debug)
python3 - "$BUDGET_FILE" "$TELEMETRY" "$UPDATE" "$MODE" <<'PY'
import json, sys

budget_file, telemetry, update = sys.argv[1], sys.argv[2], sys.argv[3] == "true"

allocs = [int(json.loads(l)["ctx"]["totalAllocatedBytes"])
          for l in open(telemetry) if '"gc.stats"' in l]
if not allocs:
    print("perf/gate: no gc.stats event in telemetry -- did the workload run?")
    sys.exit(2)
measured = allocs[0]

budget = json.load(open(budget_file))
mode = sys.argv[4]
# `.get`, not `[...]`: debug has no budget any more and a missing key must not be a crash.
limit = budget["steady"].get(mode)
tolerance = budget["tolerance"]
mb = lambda b: f"{b/1e6:.1f} MB"

# Retired on purpose, so `--update` does not quietly put it back.
if mode == "debug" and update:
    print("perf/gate: the debug budget was retired; there is nothing to update.")
    print("`scripts/perf/gate --published --update` is the one that exists.")
    sys.exit(2)

if mode == "debug":
    print(f"steady.dark (debug) allocated {mb(measured)}; not budgeted, so this does not gate.")
    print("The published build is what is budgeted: `scripts/perf/gate --published`.")
    sys.exit(0)

if update:
    budget["steady"][mode] = measured
    with open(budget_file, "w") as f:
        json.dump(budget, f, indent=2)
        f.write("\n")
    print(f"{mode} budget updated to {mb(measured)}")
    sys.exit(0)

# A budget nobody has recorded yet reports and passes. Better than a number carried over from the
# other build mode, which would be wrong in a way that looks right.
if limit is None:
    print(f"steady.dark ({mode}) allocated {mb(measured)}; no budget recorded yet.")
    flag = " --published" if mode == "published" else ""
    print(f"Pin it with `scripts/perf/gate{flag} --update`.")
    sys.exit(0)

ceiling = int(limit * (1 + tolerance))
print(f"steady.dark ({mode}) allocated {mb(measured)}; budget {mb(limit)}, ceiling {mb(ceiling)}")

if measured > ceiling:
    over = (measured / limit - 1) * 100
    print(f"FAIL: {over:.1f}% over budget.")
    print("If the regression is intended, raise the budget in the same commit and say why.")
    print("Before calling this a regression: measured on this box, the same binary and")
    print("workload reads 2.1 MB higher against a working dev store than against one the")
    print("published binary grew itself, which is 22% of the budget. CI is in the second")
    print("case, so re-run there before believing this. Locally:")
    print("  HOME=$(mktemp -d) DARK_CONFIG_RUNDIR=<path that does not exist yet> \\")
    print("    scripts/perf/gate --published")
    print("docs/perf/playbook.md has the four readings and what each part of the gap was.")
    sys.exit(1)

if measured < limit * (1 - tolerance):
    under = (1 - measured / limit) * 100
    print(f"{under:.1f}% under budget -- lower it with `scripts/perf/gate --update`.")
PY
