#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# Repeatable CLI timing. See scripts/perf/_bench.py for what it does and why.
#
#   scripts/perf/bench fixture save      snapshot the current store as the fixture
#   scripts/perf/bench run <scenario>    one scenario, N runs, against the fixture
#   scripts/perf/bench ab <a> <b>        two variants, interleaved, paired difference
#   scripts/perf/bench scenarios         list what's runnable

set -euo pipefail
exec python3 scripts/perf/_bench.py "$@"
