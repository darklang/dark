#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

TEST=false
PUBLISHED_FLAG=

for i in "$@"
do
  case "${i}" in
    --test)
    TEST=true
    ;;
    --published)
    PUBLISHED_FLAG=$i
    ;;
    *)
    echo "Usage: $0 [--test] [--published]" >&2
    exit 2
    ;;
  esac
done

if [[ "$TEST" == "true" ]]; then
  LOG_PACKAGES="${HOME}/.darklang/logs/test-packages.log"
else
  LOG_PACKAGES="${HOME}/.darklang/logs/packages.log"
fi


grey="\033[1;30m"
reset="\033[0m"

echo -e "Reloading packages ${grey}(${LOG_PACKAGES})${reset}"

# The build skips a reload when this record says the store is already what one would produce
# (scripts/build/_reloadstamp.py). A reload that fails or is killed half way must not leave it behind.
rm -f "${HOME}/.darklang/${DARK_CONFIG_DB_NAME:-data.db}.reload-stamp.json"

# Everything goes to the log because a reload is thousands of lines of parse progress. A FAILURE must
# not go only there: this runs from other scripts, and a caller that sees "Reloading packages" and then
# silence carries on against a store that hasn't changed. So the reason comes out on stderr, and exit 1.
if ! ./scripts/run-local-exec $PUBLISHED_FLAG reload-packages > "$LOG_PACKAGES" 2>&1; then
  echo "Reloading packages FAILED. Last lines of ${LOG_PACKAGES}:" >&2
  grep -E "Exception:|error:|Failed to parse" "$LOG_PACKAGES" | head -20 >&2 || tail -20 "$LOG_PACKAGES" >&2
  exit 1
fi

echo "Done reloading packages"
