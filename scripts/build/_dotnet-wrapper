#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# note: no set -e
set -uo pipefail
set +e

# run the last segment of a pipeline in the current shell. This allows getting
# the exit code.
shopt -s lastpipe

cd backend && dotnet "$@" 2>&1 | while read -r line; do
  # A running binary holds its own output file open, and msbuild can't overwrite
  # it. Killing the holder lets the build finish rather than failing on the copy.
  if [[ "$line" == *"warning MSB3026: Could not copy "* ]]; then
    echo "Saw a failed copy, killing the process holding the output"
    killall Tests || true
  fi
  echo "$line"
done
