#!/usr/bin/env bash

# The .NET SDK and zig that release artifacts are built with, each checked against a hash
# held here before it is unpacked.
#
#   scripts/build/install-release-toolchain <rid> <dotnet-dir> <zig-dir>
#
# <rid> is the machine's own: linux-x64 (Dockerfile.build-base), linux-musl-x64 (the musl
# job) or osx-arm64 (the macOS job). zig's tarballs are static, so linux-x64's serves musl.
#
# The SDK is the version backend/global.json pins. To bump it, change both, with the sha512s
# from https://builds.dotnet.microsoft.com/dotnet/release-metadata/<major>.0/releases.json.
# zig's sha256s are in https://ziglang.org/download/index.json.

set -euo pipefail

cd "$( dirname "${BASH_SOURCE[0]}" )/../.."

[[ $# -eq 3 ]] || { echo "usage: $0 <rid> <dotnet-dir> <zig-dir>" >&2; exit 2; }
rid=$1 dotnet_dir=$2 zig_dir=$3

dotnet_version=11.0.100
zig_version=0.13.0

case "$rid" in
  linux-x64)
    dotnet_sha512=1bec9cca2ec689b1e80245b84f2b53c9441d1aa6daccf2ceb27490768bffa95954fa585bd275def31069d874d543d9ba9e6591fe9ade2dbd9f34ec5c0fd0050c
    zig_platform=linux-x86_64
    zig_sha256=d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea ;;
  linux-musl-x64)
    dotnet_sha512=b6d042d4bd7a9a35f63648e33e1d0b39378d59bd488d306b9286f6a3e48ff605b4bd08902e3e4dd23ae489c7122d2b5d181077558124a63e98c3b03a56b24d21
    zig_platform=linux-x86_64
    zig_sha256=d45312e61ebcc48032b77bc4cf7fd6915c11fa16e4aad116b66c9468211230ea ;;
  osx-arm64)
    dotnet_sha512=6c8978e0a8f24a04b69a539fe29edf0c68e3247e46e24afb4920ee479e2ce1256b17fdf0626f8835b9c743784c08b40ecb25abdd8dd49fc99d040daf1ddb4de2
    zig_platform=macos-aarch64
    zig_sha256=46fae219656545dfaf4dce12fb4e8685cec5b51d721beee9389ab4194d43394c ;;
  *) echo "$0: no pinned toolchain for $rid" >&2; exit 2 ;;
esac

pinned=$(grep -oE '"version"[^"]*"[^"]+"' backend/global.json | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
[[ "$pinned" == "$dotnet_version" ]] \
  || { echo "$0: backend/global.json pins .NET SDK $pinned, this installs $dotnet_version. Bump both." >&2; exit 1; }

# fetch <url> <sha bits> <expected hash>: download to a temp file, check it, print its path.
# shasum is macOS's; Linux and Alpine have sha256sum and sha512sum.
fetch() {
  local file actual
  file=$(mktemp)
  curl -fsSL --retry 3 -o "$file" "$1"
  if command -v "sha$2sum" > /dev/null; then actual=$("sha$2sum" "$file"); else actual=$(shasum -a "$2" "$file"); fi
  actual=${actual%% *}
  [[ "$actual" == "$3" ]] || { echo "$0: $1 has sha$2 $actual, expected $3" >&2; exit 1; }
  echo "$file"
}

sdk=$(fetch "https://builds.dotnet.microsoft.com/dotnet/Sdk/$dotnet_version/dotnet-sdk-$dotnet_version-$rid.tar.gz" 512 "$dotnet_sha512")
mkdir -p "$dotnet_dir"
tar -xzf "$sdk" -C "$dotnet_dir"
rm "$sdk"

zig=$(fetch "https://ziglang.org/download/$zig_version/zig-$zig_platform-$zig_version.tar.xz" 256 "$zig_sha256")
mkdir -p "$zig_dir"
# Not the bundled docs: nothing builds from them.
tar -xJf "$zig" -C "$zig_dir" --strip-components=1 --exclude="zig-$zig_platform-$zig_version/doc"
rm "$zig"

echo "Installed .NET SDK $dotnet_version in $dotnet_dir and zig $zig_version in $zig_dir"
