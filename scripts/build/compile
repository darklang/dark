class Outcome:
  """What execute() actually did, for build-state.json.

  Separate from Should, which is what it intended to do. The two differ whenever a
  step fails, and the difference is the useful part of a failure report.
  """

  def __init__(self):
    self.ran = []
    self.succeeded = set()
    self.skipped = []
    self.failed = None

  def record(self, name, ok):
    self.ran.append(name)
    if ok:
      self.succeeded.add(name)
    elif self.failed is None:
      self.failed = name
    return ok

  def skip(self, name):
    self.skipped.append(name)
    print(f"skipping {name}: an earlier step failed")


def execute(should, outcome):
  """Run the chosen actions. Returns whether everything that ran succeeded.

  The backend chain is ordered and each step consumes the last one's output, so a
  failure stops the rest of it: reloading packages into a binary that didn't build
  costs half a minute and tells you nothing. The validators at the end don't depend
  on the build, so they still run.
  """
  packages_from_seed = _buildplan.packages_from_seed()
  chain_ok = True

  def step(name, fn):
    nonlocal chain_ok
    if not chain_ok:
      outcome.skip(name)
      return False
    if not outcome.record(name, fn()):
      chain_ok = False
      return False
    return True

  if should.fsharp_tool_restore:
    if step("fsharp_tool_restore", fsharp_tool_restore):
      should.fsharp_paket_restore = True
      should.backend_full_build = True

  if should.fsharp_paket_restore:
    if step("fsharp_paket_restore", fsharp_paket_restore):
      should.backend_full_build = True

  if should.fsharp_paket_install:
    if step("fsharp_paket_install", fsharp_paket_install):
      should.backend_full_build = True

  if should.backend_full_build:
    should.backend_quick_build = False  # no need to do both
    if step("backend_full_build", backend_full_build):
      should.run_migrations = True
      should.backend_test |= run_tests

  if should.backend_quick_build:
    if step("backend_quick_build", backend_quick_build):
      should.run_migrations = True
      should.backend_test |= run_tests

  if should.run_migrations:
    if step("run_migrations", run_migrations):
      if not packages_from_seed:
        should.reload_all_packages = True

  if should.reload_all_packages:
    step("reload_all_packages", reload_all_packages)

  # Gated here rather than inside backend_test(), so a build that skipped the tests
  # doesn't list running them among the things it did.
  if should.backend_test and run_tests:
    step("backend_test", backend_test)

  # Independent of the build, so worth running even when it failed.
  success = chain_ok

  if should.circleci_validate:
    if not outcome.record("circleci_validate", circleci_validate()): success = False

  if should.shellcheck != []:
    all_files = " ".join(should.shellcheck)
    if not outcome.record("shellcheck", shellcheck(all_files)): success = False

  if should.yamllint:
    ok = all([yamllint(f) for f in should.yamllint])
    if not outcome.record("yamllint", ok):
      success = False

  return success


def main():
  files = []
  global run_tests, optimize, source, log_path

  for f in sys.argv[1:]:
    if f == "--test":
      run_tests = True
    elif f == "--optimize":
      optimize = True
    elif f.startswith("--source="):
      source = f.split("=", 1)[1]
    elif f.startswith("--log="):
      log_path = f.split("=", 1)[1]
    else:
      f = _buildplan.relative(f)
      # Deduped: one save can arrive as several watcher events for the same path.
      if not _buildplan.spec().match_file(f) and f not in files:
        files.append(f)

  if len(files) == 0:
    # Don't print as it can be overwhelming
    sys.exit(1)

  pretty_print("Compiling: " + ", ".join(files), 43)

  should = _buildplan.Should()
  for f in files:
    _buildplan.mark(should, f)

  # A change that maps to nothing (a doc, a file mark() doesn't route) is not a
  # build, and must not be recorded as one: doing so would move the last-success
  # mark forward and declare a stale tree fresh. It does still need noting as
  # accounted for, or it stays in the changed set forever and the tree reads as
  # permanently behind.
  if should.is_empty():
    _buildindex.record_covered(should.unrouted)
    sys.exit(1)

  planned = _buildplan.expand(should, run_tests=run_tests).chosen()
  _buildstate.begin(planned, files, source, log_path)

  # Taken before the build, so it records what the build actually consumed. A file
  # saved while it runs won't match, and will correctly show as changed afterwards.
  previous_index = _buildindex.load()
  snapshot = _buildindex.snapshot(previous_index)

  outcome = Outcome()
  try:
    ok = execute(should, outcome)
  except BaseException:
    _buildstate.finish(False, outcome.ran, outcome.failed or "interrupted", 1,
                       outcome.skipped)
    raise

  _buildstate.finish(ok, outcome.ran, outcome.failed, 0 if ok else 1,
                     outcome.skipped)

  # A file counts as built only if everything it needed succeeded. The actions are
  # whole-tree (a quick build compiles the whole solution, a reload reloads every
  # package), so one .fs succeeding really does account for all of them; but a build
  # that only reloaded packages must leave the .fs entries alone.
  satisfied = _buildplan.satisfied_by(outcome.succeeded)

  # The first build has no baseline to diff against, so every file looks new. If that
  # build compiled the whole solution and reloaded every package with nothing
  # skipped, it is a complete account of the tree, including the few files whose
  # action only ever runs when they themselves change (paket.dependencies wants
  # `paket install`, which a from-scratch build has no reason to run).
  whole_tree = ({"backend_quick_build", "reload_all_packages"}.issubset(satisfied)
                and not outcome.skipped)
  bootstrap = previous_index is None and whole_tree

  def covered(rel):
    return bootstrap or _buildplan.actions_for(rel, run_tests).issubset(satisfied)

  _buildindex.save(_buildindex.merge(previous_index, snapshot, covered))

  sys.exit(0 if ok else 1)


main()
