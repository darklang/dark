def pretty_print(msg, color):
  print(f"\x1b[6;30;{str(color)}m\n$ {msg}\x1b[0m")


def run_backend(start, bash):
  pretty_print(bash, 42)
  return run(start, bash)


def run_test(start, bash):
  pretty_print(bash, 45)
  return run(start, bash)


