#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

# Bring the dev database up to date. A build step, called from
# scripts/build/compile; you rarely want it by hand.
#
# It was scripts/run-backend-server until BwdServer was replaced by the in-Dark
# `darklang serve <fn>` flow, after which the name described a server it no longer
# started. Its `--restart=no` flag went at the same time: nothing passed it, and
# there was nothing left to restart.

PUBLISHED=false
for i in "$@"; do
  case "${i}" in
    --published) PUBLISHED=true; shift ;;
  esac
done

grey="\033[1;30m"
reset="\033[0m"

LOGS="${DARK_CONFIG_RUNDIR}/logs"
MIGRATIONS_LOG="$LOGS/migrations.log"

if [[ "$PUBLISHED" == "true" ]]; then
  LOCALEXEC_EXE="backend/Build/out/LocalExec/Release/net10.0/publish/LocalExec"
else
  LOCALEXEC_EXE="backend/Build/out/LocalExec/Debug/net10.0/LocalExec"
fi

# This runs as a step inside a build, so it can't ask whether the build finished. A
# missing binary here means the step before it didn't produce one, which is worth
# saying plainly rather than waiting ten seconds and failing anyway.
if [[ ! -f "${LOCALEXEC_EXE}" ]]; then
  {
    echo "No LocalExec binary at ${LOCALEXEC_EXE}"
    echo "Build it: scripts/dev/build"
  } >&2
  exit 1
fi

# In seed mode: if data.db is missing or empty, copy from seed.db
if [[ "${DARK_CONFIG_PACKAGES_SOURCE:-disk}" == "seed" ]]; then
  DB_PATH="${DARK_CONFIG_RUNDIR}/${DARK_CONFIG_DB_NAME:-data.db}"
  SEED_PATH="${DARK_CONFIG_RUNDIR}/seed.db"
  if [[ ! -f "$DB_PATH" ]] || [[ $(stat -c%s "$DB_PATH" 2>/dev/null || echo 0) -lt 1000000 ]]; then
    if [[ -f "$SEED_PATH" ]]; then
      echo "Copying seed.db as data.db"
      cp "$SEED_PATH" "$DB_PATH"
    fi
  fi
fi

echo -e "Running migrations (${grey}${MIGRATIONS_LOG}${reset})"
"${LOCALEXEC_EXE}" migrations run > "${MIGRATIONS_LOG}" 2>&1
