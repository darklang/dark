#!/usr/bin/env bash

# Remove this clone's docker volumes, or every clone's with --all. Run from the host,
# containers stopped.

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )"/../.. && pwd )"

if [[ "${1:-}" == "--all" ]]; then
  mapfile -t vols < <(docker volume ls --format '{{.Name}}' | grep '^dark_build' || true)
  vols+=(dark_nuget darklang-dark-extension-volume
         darklang-dark-extension-volume-insiders)
else
  vols=("dark_build_$(basename "$DIR")")  # matches devcontainer.json
fi

for v in "${vols[@]}"; do
  docker volume rm "$v" > /dev/null 2>&1 \
    && echo "removed $v" \
    || echo "skipped $v (in use, or not there)"
done
