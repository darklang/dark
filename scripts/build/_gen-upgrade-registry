#!/usr/bin/env python3
# Generate LibDB's registry of store upgrades from backend/migrations/upgrades/<name>/.
#
#   _gen-upgrade-registry <upgrades dir> <output .fs>
#
# Called by LibDB.fsproj before it compiles. Generated rather than found by reflection at run time:
# the published binary is AOT-compiled and trimmed, which does not reliably keep what reflection needs.
# Generated rather than committed: a list of every unit would be the one file two upgrade PRs both
# touch, and so a rebase conflict by construction.
import os, re, sys

root, out = sys.argv[1], sys.argv[2]

def fsharp_text(path, unit):
    text = open(path).read()
    if '"""' in text:
        sys.exit(f"_gen-upgrade-registry: {path} contains \"\"\", which an F# string cannot hold")
    return text

entries = []
names = sorted(d for d in os.listdir(root) if os.path.isdir(os.path.join(root, d)))
for name in names:
    d = os.path.join(root, name)
    if not re.fullmatch(r"[A-Za-z0-9_\-]+", name):
        sys.exit(f"_gen-upgrade-registry: {name}: a unit's name is its directory's name, letters, digits, - and _ only")
    spec_path = os.path.join(d, "upgrade.toml")
    if not os.path.exists(spec_path):
        sys.exit(f"_gen-upgrade-registry: {name} has no upgrade.toml")
    spec = fsharp_text(spec_path, name)
    shape_path = os.path.join(d, "shape.sql")
    shape = f'Some """{fsharp_text(shape_path, name)}"""' if os.path.exists(shape_path) else "None"
    ident = "U" + re.sub(r"[^A-Za-z0-9_]", "_", name)
    code = f"Some LibDB.UpgradeSteps.{ident}.run" if os.path.exists(os.path.join(d, "step.fs")) else "None"
    entries.append(
        f'    {{ name = "{name}"\n'
        f'      spec = """{spec}"""\n'
        f'      shape = {shape}\n'
        f'      code = {code} }}'
    )

body = "\n".join(entries)
generated = (
    "// Generated by scripts/build/_gen-upgrade-registry from backend/migrations/upgrades/. Do not edit.\n"
    "module LibDB.UpgradeRegistry\n\n"
    f"/// Every store upgrade in the tree ({len(entries)}), by directory name. `Upgrades.order` sorts them.\n"
    "let sources : List<LibDB.Upgrades.Source> =\n"
    "  [\n" + body + "\n  ]\n"
)
os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
# Write only on change, so an unchanged tree does not recompile LibDB.
if not os.path.exists(out) or open(out).read() != generated:
    open(out, "w").write(generated)
