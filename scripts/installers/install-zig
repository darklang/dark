#!/usr/bin/env bash

# Installs zig, checked against its sha256, into the directory given (default ~/zig).
# The dev container installs it this way, and scripts/build/build-sqlite.sh fetches it when it
# is missing, which is how CI's image does without it: CI only needs zig when the SQLite archive
# isn't cached.
#
# NOTE: release builds use 0.13.0 (scripts/build/install-release-toolchain), so release SQLite
# archives and local ones are built with different zig versions.
# The hashes are the ones https://ziglang.org/download/index.json lists.

set -euo pipefail

version=0.11.0
dir=${1:-$HOME/zig}

case $(uname -m) in
  aarch64) arch=aarch64 sha256=956eb095d8ba44ac6ebd27f7c9956e47d92937c103bf754745d0a39cdaa5d4c6 ;;
  x86_64) arch=x86_64 sha256=2d00e789fec4f71790a6e7bf83ff91d564943c5ee843c5fd966efc474b423047 ;;
  *) echo "install-zig: no zig for $(uname -m)" >&2; exit 1 ;;
esac

tarball=$(mktemp)
curl -fsSL --retry 3 -o "$tarball" "https://ziglang.org/download/$version/zig-linux-$arch-$version.tar.xz"
echo "$sha256  $tarball" | sha256sum -c - > /dev/null
mkdir -p "$dir"
# Not the bundled docs (46 MB): nothing builds from them.
tar -xJf "$tarball" -C "$dir" --strip-components=1 --exclude="zig-linux-$arch-$version/doc"
rm "$tarball"
