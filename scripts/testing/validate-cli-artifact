#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# Validate a published CLI artifact.
#
#   ./scripts/testing/validate-cli-artifact clis/darklang-alpha-abc1234567-linux-x64
#   ./scripts/testing/validate-cli-artifact <artifact> --compare-against <other>
#
# The gate for the NativeAOT rollout. A trimming failure is invisible at build
# time and surfaces at runtime in whichever command happens to hit it, so an
# artifact is not considered good until it has actually run.
#
# Three parts, in increasing order of how much they'd catch:
#
#   1. A reflection-heavy smoke set. These are the paths most likely to break
#      under trimming: the parser, the interpreter, package loading, the HTTP
#      client's TLS stack, the HTTP server's request handling.
#   2. The Dark CLI test suite, pointed at this artifact via DARK_CLI_UNDER_TEST
#      rather than at the dev wrapper.
#   3. Optionally, an output diff against a second artifact (the R2R build of
#      the same commit).
#
# On (3): checking exit codes is not enough. A failing run is fast, and during
# the perf campaign a broken binary was mistaken for a fast one three times.
# Both times the tell was output (`ls` printing 5 lines where the other printed
# 7), not timing or exit status.
#
# Each artifact gets its own HOME, which is what decides where an installed-mode
# binary keeps its store. Two binaries sharing one .darklang directory corrupt
# the store outright ("database disk image is malformed"), which is its own way
# to produce a confidently wrong result.

set -euo pipefail

ARTIFACT=""
COMPARE_AGAINST=""
SKIP_SUITE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --compare-against)
      COMPARE_AGAINST="${2:-}"
      shift 2
      ;;
    --compare-against=*)
      COMPARE_AGAINST="${1#*=}"
      shift
      ;;
    --skip-suite)
      SKIP_SUITE=1
      shift
      ;;
    -*)
      echo "Unknown argument: $1"
      exit 1
      ;;
    *)
      if [[ -n "$ARTIFACT" ]]; then
        echo "Expected one artifact, got a second: $1"
        exit 1
      fi
      ARTIFACT="$1"
      shift
      ;;
  esac
done

if [[ -z "$ARTIFACT" ]]; then
  echo "Usage: $0 <artifact> [--compare-against <other-artifact>] [--skip-suite]"
  exit 1
fi
if [[ ! -x "$ARTIFACT" ]]; then
  echo "Not an executable file: $ARTIFACT"
  exit 1
fi

# Not `realpath`: that's GNU coreutils and isn't dependable on macOS. The
# absolute path matters because every check runs with cwd moved elsewhere.
abspath() {
  printf '%s/%s\n' "$(cd "$(dirname "$1")" && pwd -P)" "$(basename "$1")"
}

ARTIFACT=$(abspath "$ARTIFACT")
if [[ -n "$COMPARE_AGAINST" ]]; then
  COMPARE_AGAINST=$(abspath "$COMPARE_AGAINST")
fi

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

failures=0

# Prefix each line of stdin. `sed 's/^/.../'` trips SC2001 and the parameter
# expansion it suggests doesn't do per-line prefixes, so: a read loop.
indent() {
  while IFS= read -r line; do
    printf '       %s\n' "$line"
  done
}

# A command that never answers must fail as itself, not as the step going quiet.
# CI gives each step a pty, so anything gated on "is a human here?" answers yes
# and then blocks on a read nobody will service; stdin from /dev/null settles
# that. The watchdog is hand-rolled because `timeout` is GNU coreutils, the same
# reason `realpath` is avoided above.
CHECK_TIMEOUT=${CHECK_TIMEOUT:-120}

# Run one command against one binary, in that binary's own home directory.
# Echoes the combined output; returns the command's exit code, or 124 on timeout.
run_in_home() {
  local binary="$1" home="$2"
  shift 2
  mkdir -p "$home" || return 1
  (
    cd "$home" || exit 127
    # Not `local`: the subshell already scopes these, and bash 3.2 (macOS) drops
    # locals before the EXIT trap runs when this is called inside `$(...)`.
    cmd="" watchdog="" state=""
    state=$(mktemp -d .artifact-check.XXXXXX) || exit 1
    # shellcheck disable=SC2317  # reached through EXIT
    cleanup_check() {
      if [[ -n "$watchdog" ]]; then
        kill "$watchdog" 2> /dev/null || true
        wait "$watchdog" 2> /dev/null || true
      fi
      if [[ -n "$cmd" ]]; then
        kill -KILL -- "-$cmd" 2> /dev/null || true
        wait "$cmd" 2> /dev/null || true
      fi
      rm -rf "$state"
    }
    trap cleanup_check EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Bash job control gives the command its own process group on Linux and
    # macOS, without relying on GNU timeout or setsid. A timed-out command's
    # children must not survive holding the captured-output pipe open either.
    set -m
    HOME="$home" "$binary" "$@" < /dev/null 2>&1 &
    cmd=$!
    # Only the fork needs job control; the group is fixed by now. Left on, bash
    # prints "[1]+ Done ..." into the captured output whenever the command exits
    # before `wait` reaps it.
    set +m
    (
      # Stopping the watchdog must also stop and reap its sleep. Redirect BOTH
      # streams: otherwise sleep inherits command substitution's output pipe,
      # making every successful check wait the whole CHECK_TIMEOUT (120s).
      # shellcheck disable=SC2317  # reached through EXIT
      cleanup_timer() {
        local timer
        for timer in $(jobs -p); do kill "$timer" 2> /dev/null || true; done
        wait 2> /dev/null || true
      }
      trap cleanup_timer EXIT
      trap 'exit 0' TERM INT
      sleep "$CHECK_TIMEOUT" &
      wait "$!" || exit 0
      touch "$state/timed-out"
      kill -KILL -- "-$cmd" 2> /dev/null || true
    ) > /dev/null 2>&1 &
    watchdog=$!
    rc=0
    wait "$cmd" 2> /dev/null || rc=$?
    kill "$watchdog" 2> /dev/null || true
    wait "$watchdog" 2> /dev/null || true
    watchdog=""
    # Exit 137 can also be an independent SIGKILL; only our timer means timeout.
    [[ -f "$state/timed-out" ]] && rc=124
    exit "$rc"
  )
}

check() {
  local name="$1" expected="$2"
  shift 2

  # Named before it runs. The result line cannot say which command hung.
  echo "  run  $name"

  local out rc=0
  out=$(run_in_home "$ARTIFACT" "$WORKDIR/primary" "$@") || rc=$?

  if [[ $rc -eq 124 ]]; then
    echo "  FAIL $name (no answer in ${CHECK_TIMEOUT}s)"
    echo "$out" | indent
    failures=$((failures + 1))
    return
  fi
  if [[ $rc -ne 0 ]]; then
    echo "  FAIL $name (exit $rc)"
    echo "$out" | indent
    failures=$((failures + 1))
    return
  fi
  if [[ -n "$expected" && "$out" != *"$expected"* ]]; then
    echo "  FAIL $name (output did not contain '$expected')"
    echo "$out" | indent
    failures=$((failures + 1))
    return
  fi
  echo "  ok   $name"
}

echo "Validating $(basename "$ARTIFACT")"
echo ""
echo "Smoke set:"

# Cheap liveness first. If these fail, everything below is noise.
#
# `status` goes first deliberately, so the check that covers first run is not
# also the one that talks to the network. This is a fresh store, so whichever
# command runs first pays for the setup and the package-DB grow, and that is
# worth asserting on: first run is the path every new user takes. But `version`
# calls the GitHub releases API, and CI runs from shared IPs that GitHub
# rate-limits, so leading with it conflates "first run is broken" with "GitHub
# said no today". Keep both, just not as the same assertion.
check "status (first run)" ""  status
check "version"        ""    version
check "help"           ""    help

# The interpreter, parser and package loading in one line. If trimming broke
# any of the three, this is where it shows.
check "eval"           "3"   eval "1 + 2"

# Package space: name resolution and the package deserializer.
check "ls"             ""    ls
check "ls a module"    ""    ls Darklang.Stdlib.List

# The HTTP client's whole TLS stack, which is reflection-heavy and entirely
# absent from every other check here. Bare `version` is what asks GitHub.
check "version check"  ""    version

# Run it the way a user does: from outside the checkout entirely.
#
# Everything above runs the artifact from within the source tree, and that hides
# a whole class of bug. `PackageRefs` prefers `package-ref-hashes.txt` from the
# tree it was COMPILED in, and falls back to the embedded copy only when that
# path is missing. So inside the checkout a wrong or empty embedded copy is
# invisible: the on-disk file wins, and the first run regenerates it anyway.
#
# That is not academic. The first tagged release shipped with an empty embedded
# hash file and failed with `FnNotFound` on every command, while passing every
# check above.
echo ""
echo "Outside the source tree (what a user actually gets):"

OUTSIDE=$(mktemp -d /tmp/dark-artifact-outside.XXXXXX)
cp "$ARTIFACT" "$OUTSIDE/dark"
outside_rc=0
outside_out=$( cd "$OUTSIDE" && HOME="$OUTSIDE" ./dark eval "1 + 2" < /dev/null 2>&1 ) || outside_rc=$?
if [[ $outside_rc -ne 0 || "$outside_out" != *"3"* ]]; then
  echo "  FAIL eval outside the checkout (exit $outside_rc)"
  echo "$outside_out" | tail -15 | indent
  failures=$((failures + 1))
else
  echo "  ok   eval outside the checkout"
fi
rm -rf "$OUTSIDE"

echo ""
echo "The store it was pointed at:"

# A published binary carries an embedded seed and, told nothing, extracts it beside
# itself. An explicit DARK_HOME has to win over that default, or every
# process on a machine shares one store and a second instance cannot be asked for.
NAMED=$(mktemp -d /tmp/dark-artifact-store.XXXXXX)
cp "$ARTIFACT" "$NAMED/dark"
named_rc=0
named_out=$( cd "$NAMED" && HOME="$NAMED" DARK_HOME="$NAMED/named" \
  ./dark eval "1 + 2" < /dev/null 2>&1 ) || named_rc=$?
if [[ $named_rc -ne 0 || ! -f "$NAMED/named/data.db" ]]; then
  echo "  FAIL store follows DARK_HOME (exit $named_rc)"
  echo "$named_out" | tail -15 | indent
  failures=$((failures + 1))
elif [[ -e "$NAMED/.darklang/data.db" ]]; then
  echo "  FAIL store follows DARK_HOME (seeded .darklang beside the exe too)"
  failures=$((failures + 1))
else
  echo "  ok   store follows DARK_HOME"
fi
rm -rf "$NAMED"

# A store is the instance's own, so a second binary started from inside this one must
# not inherit it. It used to: the binary told itself where its store was by setting
# the store variable in its own environment, every process it started inherited that,
# and a second copy run from a script opened the parent's store instead of seeding its
# own beside itself.
CHILD=$(mktemp -d /tmp/dark-artifact-child.XXXXXX)
mkdir -p "$CHILD/parent" "$CHILD/child"
cp "$ARTIFACT" "$CHILD/parent/dark"
cp "$ARTIFACT" "$CHILD/child/dark"
inner="$CHILD/child/dark eval 1L"
child_rc=0
child_out=$( cd "$CHILD" && export HOME="$CHILD" && unset DARK_HOME \
  && ./parent/dark permissions allow process /bin/sh -c "$inner" \
  && ./parent/dark eval "Stdlib.Cli.executeWithStdOutOrStdErr(\"$inner\")" ) < /dev/null 2>&1 \
  || child_rc=$?
if [[ $child_rc -ne 0 || ! -f "$CHILD/parent/.darklang/data.db" ]]; then
  echo "  FAIL a child dark gets its own store (exit $child_rc)"
  echo "$child_out" | tail -15 | indent
  failures=$((failures + 1))
elif [[ ! -f "$CHILD/child/.darklang/data.db" ]]; then
  echo "  FAIL a child dark gets its own store (it opened the parent's)"
  failures=$((failures + 1))
else
  echo "  ok   a child dark gets its own store"
fi
rm -rf "$CHILD"

echo ""
echo "Dark CLI test suite:"

if [[ $SKIP_SUITE -eq 1 ]]; then
  echo "  skip (--skip-suite)"
else
# Native package tests own discovery and failure reporting. The isolated command
# fixtures drive the artifact selected by DARK_CLI_UNDER_TEST.
suite_out=""
suite_rc=0
# The home directory has to exist before the binary starts. A single-file R2R
# build extracts its embedded native libraries to a cache under HOME and fails
# outright if that path isn't writable ("Failed to determine location for
# extracting embedded files"). AOT binaries extract nothing, so this only
# shows up the first time you point the validator at an R2R artifact, which
# is exactly what --compare-against does.
mkdir -p "$WORKDIR/suite"
# Give the native runner its own store and policy as well as its own HOME.
# The artifact seeds this store with the package tests it carries.
suite_cli() {
  DARK_CLI_UNDER_TEST="$ARTIFACT" HOME="$WORKDIR/suite" \
    XDG_CONFIG_HOME="$WORKDIR/suite/config" DARK_HOME="$WORKDIR/suite/" \
    "$ARTIFACT" "$@"
}
suite_cli permissions allow env read DARK_CLI_UNDER_TEST > /dev/null 2>&1
for suite_process in /bin/bash /usr/bin/env; do
  suite_cli permissions allow process "$suite_process" > /dev/null 2>&1
done
suite_cli permissions allow native > /dev/null 2>&1
suite_out=$(suite_cli test run --force Darklang.Cli.Tests.TestSuite 2>&1) || suite_rc=$?

if [[ $suite_rc -ne 0 ]]; then
  echo "  FAIL suite (exit $suite_rc)"
  echo "$suite_out" | tail -40 | indent
  failures=$((failures + 1))
else
  echo "$suite_out" | tail -5 | indent
  echo "  ok   suite (exit $suite_rc)"
fi
fi

if [[ -n "$COMPARE_AGAINST" ]]; then
  echo ""
  echo "Output comparison against $(basename "$COMPARE_AGAINST"):"

  # Warm both binaries first. A CLI keeps its store next to itself, so the
  # first invocation of each prints setup chatter ("Setting up Darklang CLI
  # data directory", "Growing package DB from ops") that has nothing to do
  # with whether the two builds agree.
  run_in_home "$ARTIFACT" "$WORKDIR/cmp-a" version > /dev/null 2>&1 || true
  run_in_home "$COMPARE_AGAINST" "$WORKDIR/cmp-b" version > /dev/null 2>&1 || true

  # Commands whose output should be byte-identical between two builds of the
  # same commit. `version` is excluded on purpose: it can legitimately differ.
  for cmd in "help" "ls" "ls Darklang.Stdlib.List" "eval 1 + 2"; do
    # shellcheck disable=SC2086
    a=$(run_in_home "$ARTIFACT" "$WORKDIR/cmp-a" $cmd 2>&1 || true)
    # shellcheck disable=SC2086
    b=$(run_in_home "$COMPARE_AGAINST" "$WORKDIR/cmp-b" $cmd 2>&1 || true)
    if [[ "$a" == "$b" ]]; then
      echo "  ok   $cmd"
    else
      echo "  FAIL $cmd (output differs)"
      diff <(echo "$b") <(echo "$a") | head -20 | indent
      failures=$((failures + 1))
    fi
  done
fi

echo ""
if [[ $failures -ne 0 ]]; then
  echo "$failures check(s) failed."
  exit 1
fi
echo "All checks passed."
