#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# One entry point for the gate scripts: the end-to-end checks the F# suite structurally cannot
# make (a published binary outside the tree, a TTY, a real terminal). What earns
# a gate its place is a PROCESS boundary, not a store -- F# owns stores fine, MultiInstance
# copies one per instance. Each gate says which boundary it crosses, above its function.
#
#     gates list        every gate, one line each
#     gates <name>      one gate; extra arguments go to the gate (first-day takes an artifact)
#     gates ci          the CI subset, each bounded by its own `timeout 5m`
#     gates all         every gate except gates-are-clean, which re-runs the rest itself
#
# The gates live beside this file in _gates-ui, _gates-store and _gates-meta, one
# bash function each. `all` and `ci` give every gate its own PROCESS by re-invoking this
# script, so a gate keeps its own `set -e`, its own traps and its own exit -- the same
# isolation the standalone files had.

set -uo pipefail

[[ -f scripts/testing/gates ]] || { echo "gates: run from the repo root" >&2; exit 2; }

GATES=(
  workbench-scm
  workbench-views
  first-day
  backups-restore
  reload-is-reproducible
  trait-choice-survives-rival
  trait-choice-any-batching
  trait-checker-vs-dispatch
  trait-deprecation-is-per-branch
  trait-pin-across-branches
  package-tests
  prompts-unattended
  shipped-tree-typechecks
  perf-probes-run
  gates-are-clean
)

# What CI runs, in one config line: the gates that need only the build CI already has.
#
# The lesson this list came from: a gate was found RED on main having never once run in CI,
# leaking a server that reached 42.6 GB over 28 hours. A gate nobody runs is not a gate, and
# fixing it without running it leaves the next one to rot the same way. So a new gate goes in
# here unless there is a reason it cannot.
#
# first-day is not in this list because it needs the binary's path, so `build-cli` runs it as its
# own step. The gates below run later in that same job, against the same binary.
#
# Measured locally, for comparison with the 5m per-gate bound CI applies:
#   workbench-views 14s, first-day 24s, workbench-scm 35s
#   trait-choice-survives-rival 6s, trait-deprecation-is-per-branch 10s,
#   trait-checker-vs-dispatch 16s, trait-pin-across-branches 21s
# These are durations, so they drift with whatever else is on the box; the trait four were taken
# while another clone was running perf experiments. Treat them as orders of magnitude against the
# 5m bound, not as a budget. A gate reporting 0s has not run at all.
CI_GATES=(workbench-scm workbench-views
          trait-choice-survives-rival trait-choice-any-batching trait-checker-vs-dispatch
          trait-deprecation-is-per-branch trait-pin-across-branches
          shipped-tree-typechecks perf-probes-run prompts-unattended)

describe() {
  # shellcheck disable=SC2016  # the backticks are prose, not expansion
  case "$1" in
    workbench-scm)          echo 'the workbench SCM views with real work in the store' ;;
    workbench-views)        echo 'every workbench view, one session each' ;;
    first-day)              echo 'a published binary, empty home, whole SCM workflow' ;;
    backups-restore)        echo 'backup, wipe, restore; the destructive verbs ask first' ;;
    reload-is-reproducible) echo 'two reloads of one tree agree on every op id' ;;
    trait-choice-survives-rival) echo 'a saved call keeps its implementation when a newer rival lands' ;;
    trait-choice-any-batching) echo 'the choice is recorded whether trait, impls and callers are saved together or apart' ;;
    trait-checker-vs-dispatch) echo 'the at-rest checker and dispatch agree on which impls apply' ;;
    trait-deprecation-is-per-branch) echo 'deprecating an implementation is branch-aware, display and dispatch' ;;
    trait-pin-across-branches) echo 'a saved call keeps its implementation across a branch boundary' ;;
    package-tests)          echo 'every package test in packages/, through `dark test run` (CI: own step)' ;;
    shipped-tree-typechecks) echo 'production packages pass the at-rest checker; package-tests checks test sources' ;;
    perf-probes-run)        echo 'every perf probe still starts; they have no other caller' ;;
    prompts-unattended)     echo 'a question nobody can answer is refused, never waited on' ;;
    gates-are-clean)        echo 'no gate touches the shared dev store (slow: re-runs the rest)' ;;
    *)                      echo '?' ;;
  esac
}

known() {
  local g
  for g in "${GATES[@]}"; do [[ "$g" == "$1" ]] && return 0; done
  return 1
}

# One gate, in this process. The domain files only define functions, so sourcing all four is
# cheap and keeps the dispatch a name-mangle away.
run_gate() {
  local name="$1"; shift
  # Record each gate separately, including when a surrounding timeout kills it.
  # The collector snapshots only failed/interrupted gates' working databases.
  if [[ "${CIRCLECI:-}" == "true" && "${CI_DIAGNOSTIC_GATE:-}" != "$name" ]]; then
    CI_DIAGNOSTIC_GATE="$name" python3 .circleci/collect_diagnostics.py \
      --run "gate-$name" -- "$0" "$name" "$@"
    return $?
  fi
  # shellcheck source=scripts/testing/_gates-ui
  . scripts/testing/_gates-ui
  # shellcheck source=scripts/testing/_gates-store
  . scripts/testing/_gates-store
  # shellcheck source=scripts/testing/_gates-meta
  . scripts/testing/_gates-meta
  "gate_${name//-/_}" "$@"
}

run_many() {  # run_many <bound|unbound> <name...> -- serial, with per-gate timing
  local bound="$1"; shift
  local total=$#
  local failed=()
  local g started took
  for g in "$@"; do
    echo "==> $g"
    started=$SECONDS
    if [[ "$bound" == "bound" ]]; then
      timeout 5m "$0" "$g" || failed+=("$g")
    else
      "$0" "$g" || failed+=("$g")
    fi
    took=$((SECONDS - started))
    printf '<== %s  %dm%02ds\n\n' "$g" $((took / 60)) $((took % 60))
  done
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "FAILED: ${failed[*]}"
    exit 1
  fi
  echo "all $total gate(s) passed."
}

run_parallel() {  # run_parallel <bound|unbound> <name...> -- every gate at once
  # Wall time is the slowest gate instead of the sum. Output is buffered per gate so logs don't
  # interleave, and each gate's own time is kept, since 0s is how a gate that never ran shows.
  #
  # What makes this safe is that a gate shares NOTHING it writes with another gate: its own
  # process, its own rundir under rundir/, its own HOME where it touches `caps`, and any port it
  # takes is its alone. That list is the whole claim, so a new gate that writes anywhere else has
  # to be added to it or it breaks this mode. The one that did was not a rundir or a port but a
  # file in the SOURCE TREE: a package reload rewrote `package-ref-hashes.txt`, which every CLI
  # in the checkout reads at startup, and every gate running beside reload-is-reproducible
  # failed with FnNotFound. The reload no longer writes that file unless its contents changed;
  # see `PackageRefsGenerator.generate`.
  local bound="$1"; shift
  local total=$#
  local failed=()
  local g started took
  local outdir
  outdir=$(mktemp -d)
  declare -A pids
  started=$SECONDS
  for g in "$@"; do
    (
      s=$SECONDS
      if [[ "$bound" == "bound" ]]; then timeout 5m "$0" "$g"; else "$0" "$g"; fi
      rc=$?
      echo $((SECONDS - s)) > "$outdir/$g.time"
      exit $rc
    ) >"$outdir/$g.log" 2>&1 &
    pids[$g]=$!
  done
  for g in "$@"; do
    local verdict=ok
    wait "${pids[$g]}" || { verdict=FAIL; failed+=("$g"); }
    took=$(cat "$outdir/$g.time" 2>/dev/null || echo 0)
    printf '  %-5s %-32s %dm%02ds\n' "$verdict" "$g" $((took / 60)) $((took % 60))
  done
  took=$((SECONDS - started))
  for g in "${failed[@]+"${failed[@]}"}"; do
    echo; echo "---- $g output ----"
    cat "$outdir/$g.log"
  done
  rm -rf "$outdir"
  printf 'wall time %dm%02ds for %d gate(s)\n' $((took / 60)) $((took % 60)) "$total"
  if [[ ${#failed[@]} -gt 0 ]]; then
    echo "FAILED: ${failed[*]}"
    exit 1
  fi
  echo "all $total gate(s) passed."
}

cmd=${1:-}
[[ -n "$cmd" ]] || { echo "usage: gates list|all|ci|<name>  (gates list names them)" >&2; exit 2; }
shift

# The gates run the binary through `CLI=`, not `run-cli`, so they skip the check `run-cli` makes:
# a build in flight or a failed one refuses, and a tree edited since the last build warns. Once
# per invocation, not once per gate, since `all` and `ci` re-exec this script for every gate.
# What it cannot see: a build that starts after this line, and a bare
# `scripts/build/reload-packages`, which records no build state at all.
if [[ "$cmd" != "list" && "${CI:-}" != "true" && -z "${GATES_BUILD_CHECKED:-}" ]]; then
  python3.12 scripts/build/_dev.py check || exit 1
  export GATES_BUILD_CHECKED=1
fi

case "$cmd" in
  list)
    echo "gates (scripts/testing/gates <name>):"
    # Width from the longest name. The old fixed 24 was already too narrow for
    # `trait-choice-survives-rival`, whose description ran straight into its name.
    w=0
    for g in "${GATES[@]}"; do [[ ${#g} -gt $w ]] && w=${#g}; done
    for g in "${GATES[@]}"; do printf "  %-$((w + 2))s%s\n" "$g" "$(describe "$g")"; done
    echo
    echo "  ci  = ${CI_GATES[*]}" | fold -sw 84 | sed -e '2,$s/^/        /' -e 's/ *$//'
    echo "        (first-day also runs in CI, in build-cli, on the binary that job builds)"
    echo "  all = every gate except gates-are-clean, all at once, with per-gate timings."
    echo "        --serial runs them one after another (the sum, not the slowest)."
    echo "  ci  runs serial; --parallel for the same thing at once, still each bounded by 5m."
    echo "  Run gates-are-clean only when a gate itself changes."
    echo
    ;;
  all)
    NAMES=()
    for g in "${GATES[@]}"; do [[ "$g" == "gates-are-clean" ]] || NAMES+=("$g"); done
    # Parallel by default. `--serial` is for reading one gate's output as it happens, or for a
    # box too small to run them all at once.
    if [[ "${1:-}" == "--serial" ]]; then
      run_many unbound "${NAMES[@]}"
    else
      run_parallel unbound "${NAMES[@]}"
    fi
    ;;
  ci)
    # Serial by default. In CI they run at the end of build-cli, which finishes before the backend
    # tests anyway, so running them at once would not shorten a PR's wait, and would put nine CLIs
    # on one machine.
    if [[ "${1:-}" == "--parallel" ]]; then
      run_parallel bound "${CI_GATES[@]}"
    else
      run_many bound "${CI_GATES[@]}"
    fi
    ;;
  *)
    if ! known "$cmd"; then
      { echo "gates: no gate named \"$cmd\". Valid: list, all, ci,"
        echo "  ${GATES[*]}"; } >&2
      exit 2
    fi
    run_gate "$cmd" "$@"
    ;;
esac
