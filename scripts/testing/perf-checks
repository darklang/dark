#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

# By-hand checks for changes that touch execution.
#
# The backend suite has twice passed while the interpreter returned a quietly wrong answer, so
# anything touching the interpreter, the type checker or error construction gets run past these as
# well. They are not assertions -- read the output against the "expect" line printed above each.
#
# Error paths get most of the attention here on purpose: they only run once something has already
# gone wrong, so a change can garble every message with every test green.
set -euo pipefail
cd /home/dark/app

EXE="backend/Build/out/Cli/Debug/net10.0/Cli"
[[ -x "$EXE" ]] || { echo "perf-checks: no CLI at $EXE -- run scripts/dev/build" >&2; exit 2; }

CHECKS="scripts/testing/perf-workloads/checks"
SCRATCH=rundir/perf-scratch
mkdir -p "$SCRATCH"

run() { # run <title> <expect> <script>
  printf '\n=== %s\n    expect: %s\n' "$1" "$2"
  "$EXE" run "$3" 2>&1 || true
}

# A case whose whole point is the error message it dies with. Written out rather than kept as a file
# each, because there are seven of them and they are three lines apiece.
case_file() { local name="$1"; shift; local f="$SCRATCH/check-$name.dark"; cat > "$f"; echo "$f"; }

# --- happy paths -------------------------------------------------------------------------------

run "semantics" \
    "fib 18 = 2584, areas [12.56636, 12.0, 3.0], and the JSON round trips both ways" \
    "$CHECKS/semantics.dark"

# --- type checking -----------------------------------------------------------------------------

run "argument of the wrong type" \
    "a type error naming the parameter, Int64 and String" \
    "$(case_file type-error <<'DARK'
let takesInt (n: Int64) : Int64 = n + 1L
let main () : Int64 =
  Builtin.debug "bad" (takesInt "not an int")
  0L
main ()
DARK
)"

# `tryUnifySync` answers "same declared type, no type arguments" without consulting the type store,
# on the argument that a value built through an alias carries the *underlying* type's name, so equal
# names cannot mean an alias. This is the check that would catch it accepting anything.
#
# Note `type A = { x: Int }` and `type B = { x: Int }` are the SAME type in Dark -- names are content
# hashes -- so the two records have to be genuinely different, as below. The obvious version of this
# test passes a `B` where an `A` is wanted and is surprised when it works.
run "record of the wrong type" \
    "1, then a type error naming both hashes" \
    "$(case_file type-identity <<'DARK'
type A = { x: Int }
type B = { y: String }
let takesA (a: A) : Int = a.x
let main () : Int64 =
  Builtin.debug "takesA a" (takesA (A { x = 1 }))
  Builtin.debug "takesA b" (takesA (B { y = "no" }))
  0L
main ()
DARK
)"

# --- record construction failures --------------------------------------------------------------
#
# The declared type is only resolved once a field has already failed to unify, so these four
# messages are built on paths the happy case never takes.

record_case() { # record_case <name> <expect> <literal>
  run "record: $1" "$2" "$(case_file "rec-$1" <<DARK
type Point = { x: Int; y: String }
let main () : Int64 =
  let bad = $3
  Builtin.debug "should not get here" bad
  0L
main ()
DARK
)"
}

record_case wrong-field-type "Expected String for field \`y\`, but got 2 (an Int)" 'Point { x = 1; y = 2 }'
record_case missing-field    "Missing field \`y\`"                                 'Point { x = 1 }'
record_case extra-field      "No field named \`z\`"                                'Point { x = 1; y = "a"; z = 3 }'
record_case duplicate-field  "Duplicate field \`x\`"                               'Point { x = 1; x = 2; y = "a" }'

# --- call stacks -------------------------------------------------------------------------------

# Worth checking whenever frames start sharing ExecutionPoints.
run "error raised inside nested lambdas" \
    "a call stack showing the package functions and then both Lambda frames" \
    "$(case_file lambda-callstack <<'DARK'
let main () : Int64 =
  let xs = [1L; 2L; 3L]
  let ys = xs |> Stdlib.List.map (fun x -> if x == 2L then Builtin.testRuntimeError "boom" else x)
  Builtin.debug "ys" ys
  0L
main ()
DARK
)"

# --- behaviour preservation ----------------------------------------------------------------------
#
# The only check with a recorded expected output, because it pins behaviour rather than reading
# well: String.split and String.length have a fast path for strings whose grapheme clusters are
# exactly their chars, and this fixes the cases where that path must decline -- non-ASCII, an empty
# separator, and CRLF, which is a single cluster, so "a\r\nb" split on "\n" is one part, not two.
printf '\n=== string grapheme-cluster fast path\n    expect: no diff\n'
if "$EXE" run "$CHECKS/string-egc.dark" 2>&1 | grep '^DEBUG' | diff - "$CHECKS/string-egc.expected"; then
  echo "    ok, 18 cases byte-identical"
fi
