#!/usr/bin/env bash
# _gates-ui: the workbench under a real TTY
#
# Sourced by scripts/testing/gates -- not run directly. Each gate is one self-contained bash
# function (helpers and all), and the runner gives every invocation its own process, so a
# gate's `set -e`, traps and exits stay its own.
# shellcheck disable=SC2329  # the functions are invoked by the runner, not from this file

# --- workbench-scm: the workbench's SCM surfaces, with actual work in the store -----------------
# fixtures/test-workbench.expect only ever opens the workbench on an EMPTY store, which asserts
# that a view renders, not that it can show anything. So: build a store with a draft, a commit,
# a branch and a recorded conflict, and check each reaches the screen; then a QUIET store
# (commits only), so Home's commit-detail-on-open path renders too. Every row asserted on comes
# from an SCM API, so the data path is under test as much as the drawing.
#
# Gate, not an F#/.dark test: it runs under a pty. The views render fine when called directly;
# what needs a terminal is the keyboard, the alternate screen and the frame the workbench paints.
gate_workbench_scm() {
  set -euo pipefail

  CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
  WORK=rundir/workbench-scm-test

  rm -rf "$WORK"
  mkdir -p "$WORK"
  # Strip ALL config, so the gate runs against a store in a known state rather than whatever the
  # dev store's config says (see _copy-store, which has the history of why).
  scripts/testing/_copy-store "$WORK/data.db"
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"

  # a commit, for History
  "$PWD/$CLI" fn /WbScm.T.base '() : Int64 = 1L' >/dev/null 2>&1
  "$PWD/$CLI" commit "workbench scm fixture" -y >/dev/null 2>&1

  # a branch that diverges from main on one name, so merging it RECORDS a conflict.
  # The branch commits first: merge refuses uncommitted branch work, so without this the merge
  # never happens, no conflict is recorded, and Home has no "needs you" to show -- which is a
  # fixture that stopped building the thing the gate asserts on.
  "$PWD/$CLI" branch create wb-scm >/dev/null 2>&1
  "$PWD/$CLI" --branch wb-scm fn /WbScm.T.base '() : Int64 = 222L' >/dev/null 2>&1
  "$PWD/$CLI" --branch wb-scm commit "wb-scm diverges" -y >/dev/null 2>&1
  "$PWD/$CLI" --branch main fn /WbScm.T.base '() : Int64 = 111L' >/dev/null 2>&1
  "$PWD/$CLI" --branch wb-scm merge wb-scm -y >/dev/null 2>&1

  # and an uncommitted draft on main, for Changes
  "$PWD/$CLI" switch main >/dev/null 2>&1
  "$PWD/$CLI" fn /WbScm.T.draft '() : Int64 = 9L' >/dev/null 2>&1

  # More branches than Home displays: the picker must still reach every one.
  for n in $(seq 1 12); do
    "$PWD/$CLI" --branch main branch create "wb-pick-$n" >/dev/null 2>&1
  done
  "$PWD/$CLI" switch main >/dev/null 2>&1

  expect "$PWD/scripts/testing/fixtures/_workbench-scm.expect" "$PWD/$CLI" "$PWD/$WORK" || exit 1

  # And a QUIET store: commits, no conflict, no draft. Home then selects a commit on open and renders its
  # detail, which the fixture above never reaches because its conflict is selected first.
  QUIET="$WORK-quiet"
  rm -rf "$QUIET"; mkdir -p "$QUIET"
  scripts/testing/_copy-store "$QUIET/data.db"
  sqlite3 "$QUIET/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true
  export DARK_CONFIG_RUNDIR="$PWD/$QUIET"
  "$PWD/$CLI" fn /WbQuiet.T.only '() : Int64 = 1L' >/dev/null 2>&1
  "$PWD/$CLI" commit "workbench quiet fixture" -y >/dev/null 2>&1
  exec expect "$PWD/scripts/testing/fixtures/_workbench-quiet.expect" "$PWD/$CLI" "$PWD/$QUIET"
}

# --- workbench-views: every workbench view, with work in the store ------------------------------
# A field access resolves at RUNTIME in Dark, so a pane reading a shape that moved underneath it
# is invisible until there is data to draw (the Conflicts pane once took the whole workbench
# down). Fill the store first -- draft, commits, a branch, a conflict, traces, an identity --
# then visit every view on its DEFAULT section. Reaching a non-default section is
# workbench-scm's job; the two are complementary rather than one subsuming the other.
#
# Gate, not an F#/.dark test: a pty again, same as workbench-scm. A view called directly returns
# a value; only under a terminal does it become a frame anyone could have read wrong.
gate_workbench_views() {
  set -euo pipefail

  CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
  WORK=rundir/workbench-views-test

  rm -rf "$WORK"
  mkdir -p "$WORK"
  # Strip ALL config, so the gate runs against a store in a known state rather than whatever the
  # dev store's config says (see _copy-store, which has the history of why).
  scripts/testing/_copy-store "$WORK/data.db"
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  run() { "$PWD/$CLI" "$@" >/dev/null 2>&1 || true; }

  # commits, for History and Home's "last commit"
  run fn /WbV.T.base '() : Int64 = 1L'
  run commit "workbench views fixture" -y

  # a branch that diverges on one name, merged so a conflict is RECORDED
  run branch create wbv
  run --branch wbv fn /WbV.T.base '() : Int64 = 222L'
  run --branch main fn /WbV.T.base '() : Int64 = 111L'
  run --branch wbv merge wbv -y
  run switch main

  # an uncommitted draft, for Changes and the Home status box
  run fn /WbV.T.draft '() : Int64 = 9L'

  # traces: recording is OFF until asked for, and something has to have RUN, for the Traces view
  # to hold anything
  run traces record on
  run eval 'WbV.T.draft ()'
  run eval 'Stdlib.List.length [ 1L; 2L; 3L ]'

  exec expect "$PWD/scripts/testing/fixtures/_workbench-views.expect" "$PWD/$CLI" "$PWD/$WORK"
}
