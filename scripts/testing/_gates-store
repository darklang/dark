#!/usr/bin/env bash
# _gates-store: the store from nothing, backups, and reload determinism
#
# Sourced by scripts/testing/gates -- not run directly. Each gate is one self-contained bash
# function (helpers and all), and the runner gives every invocation its own process, so a
# gate's `set -e`, traps and exits stay its own.
# shellcheck disable=SC2329  # the functions are invoked by the runner, not from this file

# --- first-day: a new user's first day, on a PUBLISHED binary and a store that does not exist ---
# Every other gate copies rundir/data.db, a developer's store, which skips the whole bootstrap
# path (the embedded seed, the package-DB grow, the first commit against an empty history); when
# that breaks, the binary works inside the source tree and dies outside it. So: author, commit,
# branch, merge, diverge, resolve, discard, pin, on a binary a user would download, from an
# empty home. Deliberately no relay: sync has its own gates. Optional argument: the artifact to
# test; otherwise the newest in clis/, refused if older than the tree.
#
# Gate, not an F#/.dark test: the thing under test is a published artifact, which does not exist
# inside the tree, run against a $HOME that has never seen Darklang.
gate_first_day() {
  set -euo pipefail

  ARTIFACT=${1:-}
  if [[ -z "$ARTIFACT" ]]; then
    # shellcheck disable=SC2012  # need mtime order; no filename here has a space
    ARTIFACT=$(ls -t clis/darklang-alpha-*-linux-x64 2>/dev/null | head -1 || true)
    AUTO_PICKED=1
  fi
  [[ -x "$ARTIFACT" ]] || { echo "first-day: no published CLI (pass one, or build with scripts/build/build-release-cli-exes.sh)" >&2; exit 2; }

  if [[ -n "${AUTO_PICKED:-}" ]]; then
    # An artifact older than the packages it is supposed to contain tests the LAST build, and says nothing
    # about the tree. Worse, it does not fail like a stale binary: it fails like a broken product, with
    # "Function <hash> couldn't be found" on every command, because the refs the binary was pinned to are not
    # in the seed it shipped. Only checked when we picked the artifact ourselves: an explicitly passed one
    # is the caller's business, and CI passes the one it just built.
    newest_source=$(find packages backend/src -newer "$ARTIFACT" -type f \( -name '*.dark' -o -name '*.fs' \) -print -quit 2>/dev/null || true)
    if [[ -n "$newest_source" ]]; then
      echo "first-day: $(basename "$ARTIFACT") is older than $newest_source" >&2
      echo "  Rebuild it, or this gate reports on a binary that predates your change:" >&2
      echo "    scripts/build/build-release-cli-exes.sh" >&2
      exit 2
    fi
  fi

  # Absolute BEFORE the cd below: `$PWD` inside the subshell is the temp home, not the repo.
  ARTIFACT=$(readlink -f "$ARTIFACT")

  HOMEDIR=$(mktemp -d)
  trap 'rm -rf "$HOMEDIR"' EXIT

  failures=0

  # DARK_CONFIG_RUNDIR, not just HOME: the container sets it for every process and it WINS over the
  # `<home>/.darklang` default, so HOME alone runs this against the shared dev store.
  # The gates-are-clean gate has the full story.
  dark() { ( cd "$HOMEDIR" && HOME="$HOMEDIR" DARK_CONFIG_RUNDIR="$HOMEDIR/rundir" "$ARTIFACT" "$@" 2>&1 ); }
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  # A failure prints its first four lines through a process substitution: `| head` here dies on
  # SIGPIPE under pipefail and takes the gate with it, and a store's release steps are noise.
  wantnot() {  # wantnot <name> <pattern> <command...> -- the pattern must NOT appear
    local name="$1" pat="$2"; shift 2
    local out
    out=$(dark "$@" | clean) || true
    if grep -qE "Encountered a Runtime Error|No matching case found|couldn't be found" <<<"$out"; then
      echo "  FAIL $name: the command errored:"
      while IFS= read -r line; do printf '         %s\n' "$line"; done < <(grep -vE 'Running release step|release: adding' <<<"$out" | head -4)
      failures=$((failures + 1))
    elif grep -qE "$pat" <<<"$out"; then
      echo "  FAIL $name: /$pat/ appeared:"
      while IFS= read -r line; do printf '         %s\n' "$line"; done < <(grep -vE 'Running release step|release: adding' <<<"$out" | head -4)
      failures=$((failures + 1))
    else
      echo "  ok   $name"
    fi
  }

  want() {  # want <name> <pattern> <command...>
    local name="$1" pat="$2"; shift 2
    local out
    out=$(dark "$@" | clean) || true
    # A refusal must never satisfy a pattern. Patterns here are anchored for that reason (a bare "commit"
    # matches "commit failed", a bare "conflict" matches "Conflict detection did not run") and this is the
    # backstop for the ones that cannot be.
    if grep -qE "Encountered a Runtime Error|No matching case found|couldn't be found" <<<"$out"; then
      echo "  FAIL $name: the command errored:"
      while IFS= read -r line; do printf '         %s\n' "$line"; done < <(grep -vE 'Running release step|release: adding' <<<"$out" | head -4)
      failures=$((failures + 1))
    elif grep -qE "$pat" <<<"$out"; then
      echo "  ok   $name"
    else
      echo "  FAIL $name: wanted /$pat/, got:"
      while IFS= read -r line; do printf '         %s\n' "$line"; done < <(grep -vE 'Running release step|release: adding' <<<"$out" | head -4)
      failures=$((failures + 1))
    fi
  }

  echo "First day on $(basename "$ARTIFACT"), from an empty home:"

  # 1. First run at all. This is where the seed is unpacked and the package DB grown from ops.
  want "first run reports a clean tree" "^(clean:|draft:)" status

  # 2. Author something and run it. The thing the language is for.
  want "authoring a fn"    "Created function FirstDay\.Hello\.greet" fn /FirstDay.Hello.greet '(name: String) : String = "hi " + name'
  want "and running it"    "hi world"        eval 'FirstDay.Hello.greet "world"'
  want "status sees it"    "^draft: 1 item"  status

  # 3. Commit it, and read the commit back.
  want "committing"        "^ *commit [0-9a-f]{8} -- [0-9]+ op" commit "first day" -y
  want "commits lists it"  "first day"       commits
  want "tree is clean"     "^clean:"         status

  # 4. A branch, isolated from main.
  want "starting a branch" "^(started|switched|on) .*firstday" branch create firstday
  want "authoring on it"   "Created function FirstDay\.Hello\.only" --branch firstday fn /FirstDay.Hello.only '() : Int64 = 1L'
  want "main cannot see it" "not found"      --branch main eval 'FirstDay.Hello.only ()'
  # Merge refuses uncommitted branch work, so the branch has to commit before it can be merged.
  # Without this the merge below never happens, and "main sees it now" then fails about a branch
  # that was never merged rather than about anything main did. `_gates-ui`'s workbench-scm fixture
  # carries the same note for the same reason. The op count is asserted with it, because a commit
  # that reports committing nothing is exactly what this step is here to catch.
  want "committing the branch" "^ *commit [0-9a-f]{8} -- [0-9]+ op" --branch firstday commit "first day on a branch" -y

  # 5. Merge it, and main can.
  want "merge --dry-run"   "would merge"     --branch firstday merge firstday --dry-run
  want "merging"           "Merged"          --branch firstday merge firstday -y
  want "main sees it now"  "^1$"             --branch main eval 'FirstDay.Hello.only ()'

  # 6. A real divergence: both sides move one name, merge records a conflict.
  dark branch create clash >/dev/null 2>&1 || true
  dark --branch clash fn /FirstDay.Hello.greet '(name: String) : String = "yo " + name' >/dev/null 2>&1 || true
  # Same reason as above: an uncommitted branch cannot be merged, so no conflict would be recorded
  # and the two assertions below would both be about a merge that never ran.
  dark --branch clash commit "clash diverges" -y >/dev/null 2>&1 || true
  dark --branch main fn /FirstDay.Hello.greet '(name: String) : String = "hey " + name' >/dev/null 2>&1 || true
  want "merge records a conflict" "[0-9]+ conflict" --branch clash merge clash -y
  want "conflicts --json lists it" '"pending":[1-9]' --branch main conflicts --json

  # 6b. An override you made, then YOUR OWN later edit: last-writer-wins as designed, and NOT a finding.
  #
  # The superseded-decision report is for the daemon case: a PEER's edit beats your override while nobody
  # is at the keyboard (`supersededOverrides` checks authorship through `op_owners`, which only a sync
  # import writes). Your own later edit is a change of mind. The peer case needs two stores and lives in
  # `MultiInstance.Tests.fs` (`supersededReportsCheckAuthorship`).
  CID=$(dark --branch main conflicts --json 2>/dev/null | grep -oE '"id":"[a-f0-9]+"' | head -1 | cut -d'"' -f4)
  dark --branch main conflicts override "$CID" B >/dev/null 2>&1 || true
  want "the override holds"      "yo "        --branch main eval 'FirstDay.Hello.greet "x"'
  dark --branch main fn /FirstDay.Hello.greet '(name: String) : String = "later " + name' >/dev/null 2>&1 || true
  want "a later edit wins"       "later "     --branch main eval 'FirstDay.Hello.greet "x"'
  wantnot "and your own change of mind is not reported" "overrode this|decision-superseded" --branch main constraints

  # 6c. A deprecation is a commit like any other.
  #
  # `dark delete` authors a `Deprecate` op, which binds no NAME. So "is the draft empty" cannot be answered
  # from the changed-BINDINGS list: that answer leaves the deprecation uncommitted forever, where it ships
  # inside the release seed as somebody else's mystery op.
  dark --branch main fn /FirstDay.Hello.doomed '() : Int64 = 1L' >/dev/null 2>&1 || true
  dark --branch main commit "before deleting" -y >/dev/null 2>&1 || true
  want "delete deprecates it"   "^ *[Dd]eprecated "  --branch main delete fn FirstDay.Hello.doomed -y
  want "and it is committable"  "^ *commit [0-9a-f]{8} -- [0-9]+ op" --branch main commit "retire it" -y
  want "leaving a clean tree"   "^clean:"        --branch main status

  # 7. And you can walk away from a draft.
  dark fn /FirstDay.Hello.scratch '() : Int64 = 5L' >/dev/null 2>&1 || true
  want "discard drops the draft" "discarded"  discard -y
  want "and it is gone"          "not found"  eval 'FirstDay.Hello.scratch ()'

  # 8. A pin BEFORE committing un-stages the repoint rather than authoring one back.
  #
  # The one step of the two-machine walk no other gate covered, and it is single-instance
  # behaviour, so it belongs here rather than in the multi-instance gate.
  dark fn /FirstDay.Chain.p1 '(x: Int64): Int64 = x + 1L' >/dev/null 2>&1 || true
  dark fn /FirstDay.Chain.p2 '(x: Int64): Int64 = (FirstDay.Chain.p1 x) + 1L' >/dev/null 2>&1 || true
  dark commit "chain" -y >/dev/null 2>&1 || true
  dark fn /FirstDay.Chain.p1 '(x: Int64): Int64 = x + 50L' >/dev/null 2>&1 || true
  want "the dependent followed"   "followed"            status
  want "pin drops the repoint"    "dropped the staged"  propagate pin FirstDay.Chain.p2
  want "and nothing followed now" "1 item changed"      status
  # The point of the whole step: p2 is back on the OLD p1, so 0 -> 2, not 0 -> 51.
  want "the pin actually holds"   "^2$"                 eval 'FirstDay.Chain.p2 0L'

  # 9. The installed layout: the binary in `<home>/.darklang/bin`, a directory `install.sh` has already
  # made, and no DARK_CONFIG_RUNDIR. Everything above starts from a rundir that does not exist yet,
  # which is not the state a person who ran the installer is in; a store directory that already
  # exists once shipped unseeded, and every command died with FnNotFound.
  INSTALLED=$(mktemp -d)
  trap 'rm -rf "$HOMEDIR" "$INSTALLED"' EXIT
  mkdir -p "$INSTALLED/.darklang/bin"
  cp "$ARTIFACT" "$INSTALLED/.darklang/bin/dark"
  # shellcheck disable=SC2317  # reached through want, which calls `dark`
  dark() { ( cd "$INSTALLED" && env -u DARK_CONFIG_RUNDIR HOME="$INSTALLED" "$INSTALLED/.darklang/bin/dark" "$@" 2>&1 ); }
  want "installed: first run seeds the store" "^2$"  eval '1L + 1L'
  want "installed: and it stays seeded"       "^(clean:|draft:)" status

  if [[ "$failures" -gt 0 ]]; then
    echo "$failures first-day step(s) failed."
    exit 1
  fi
  echo "first day: author, run, commit, branch, merge, conflict, discard and pinning all work from an empty home, and an installed binary seeds its store."
}

# --- backups-restore: a backup holds what the store holds, and a wiped store comes back ---------
# The one thing this proves: a copy of data.db alone is not a backup of a WAL-mode store --
# recent writes sit in data.db-wal until a checkpoint, so `backups now` folds the WAL first, and
# only a gate that authored a fn, backed up, wiped and restored checks it did. The two
# destructive verbs must ask first. Its own rundir: everything here is destructive.
#
# Gate, not an F#/.dark test: it has to be allowed to destroy a store, which is a bad thing to
# hand a suite that shares one.
gate_backups_restore() {
  set -uo pipefail

  CLI=${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}
  ROOT=rundir/backups-test
  pass=0; fail=0
  ok()  { pass=$((pass+1)); printf '  ok   %s\n' "$1"; }
  bad() { fail=$((fail+1)); printf '  FAIL %s\n       got: %s\n' "$1" "$(head -c 200 <<<"$2" | tr '\n' ' ')"; }
  want() { if grep -qE "$2" <<<"$3"; then ok "$1"; else bad "$1" "$3"; fi; }

  rm -rf "$ROOT"; mkdir -p "$ROOT/home"
  scripts/testing/_copy-store "$ROOT/data.db"
  sqlite3 "$ROOT/data.db" 'DELETE FROM config_v0;'
  x() { DARK_CONFIG_RUNDIR="$PWD/$ROOT" HOME="$PWD/$ROOT/home" "$PWD/$CLI" "$@" 2>&1 | sed 's/\x1b\[[0-9;]*m//g'; }

  echo "== a backup holds what the store holds, WAL included"
  x fn /BK.T.kept '() : Int64 = 4242L' > /dev/null
  want "the fn is live" "^4242$" "$(x eval 'BK.T.kept ()' | tail -1)"
  want "a backup is taken" "^copied the store to " "$(x backups now)"
  name=$(x backups | grep -oE 'data\.db\.manual-[0-9TZ]+' | head -1)
  if [[ -n "$name" ]]; then ok "and it is listed ($name)"; else bad "and it is listed" "$(x backups)"; fi

  echo "== a wiped store comes back from it"
  # Wipe: the fn is gone. Then restore, and it is back. `-y`, since a piped stdin cannot answer.
  x discard -y > /dev/null
  want "the fn is gone after the wipe" "not found" "$(x eval 'BK.T.kept ()' | tail -1)"
  want "restore asks first" "kept\." "$(x backups restore "$name" < /dev/null)"
  want "the store is still the wiped one" "not found" "$(x eval 'BK.T.kept ()' | tail -1)"
  want "restore with -y" "^restored $name" "$(x backups restore "$name" -y)"
  want "and the fn is back" "^4242$" "$(x eval 'BK.T.kept ()' | tail -1)"
  want "and the wiped store was put aside, not lost" "pre-restore" "$(x backups)"

  echo "== prune asks first"
  want "prune asks" "kept\." "$(x backups prune 0 < /dev/null)"
  want "and deleted nothing" "manual-" "$(x backups)"
  want "prune -y deletes" "^deleted [1-9]" "$(x backups prune 0 -y)"
  want "nothing left" "no backups|0 backup" "$(x backups)"

  echo
  echo "passed: $pass   failed: $fail"
  [[ "$fail" -eq 0 ]]
}

# --- reload-is-reproducible: two reloads of one tree must agree on every op id ------------------
# The parser mints ephemeral node ids into every expression; an Add op whose id hashes a
# serialization carrying them changes id on every reload, so every upgrade grows every store and
# two machines authoring the same fn make two ops. Own rundir, never the shared dev store: a
# reload is a purge-and-refill and drops whatever draft was open, which the gates-are-clean
# fingerprint cannot see (two reloads leave the same COUNTS behind). Main's ops only.
#
# Gate, not an F#/.dark test, on the weakest grounds of any of them: it COULD be an F# test. Two
# full reloads cost about 70s, and as a gate they run beside the rest instead of lengthening the
# suite. Pragmatic, not structural.
gate_reload_is_reproducible() {
  set -euo pipefail

  WORK=rundir/reload-reproducible
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"

  ids() {
    sqlite3 "$WORK/data.db" \
      "SELECT id FROM package_ops WHERE id NOT IN (SELECT op_id FROM op_branches) ORDER BY id"
  }

  ./scripts/build/reload-packages > "$WORK/logs/reload-1.log" 2>&1
  first=$(ids)
  ./scripts/build/reload-packages > "$WORK/logs/reload-2.log" 2>&1
  second=$(ids)

  # The reload must have RECORDED something, not merely finished: resolution fails for the
  # whole batch and still prints Success, and nothing else asserts the pre-pass ran. A floor,
  # since the count moves with the tree.
  # The line goes to the reload's OWN log under this gate's rundir, not to its stdout.
  moved=$(grep -oE 'Resolved trait calls: [0-9]+ op' "$WORK/logs/packages.log" \
            | tail -1 | grep -oE '[0-9]+' || true)
  if [[ -z "$moved" ]]; then
    echo "reload-is-reproducible: the reload printed no 'Resolved trait calls:' line at all."
    echo "  Either the pre-pass did not run or its output moved; both want looking at."
    exit 1
  fi
  if [[ "$moved" -lt 100 ]]; then
    echo "reload-is-reproducible: the reload pinned $moved trait call op(s), which is too few."
    echo "  A whole-tree reload resolves thousands. Zero or a handful means the checker failed"
    echo "  over the batch and reported nothing. Look in $WORK/logs/packages.log for the line"
    echo "  saying the at-rest checker failed over a whole batch."
    exit 1
  fi

  n=$(wc -l <<<"$second")
  differ=$(comm -3 <(echo "$first") <(echo "$second") | wc -l)
  if [[ "$differ" -ne 0 ]]; then
    echo "reload-is-reproducible: $differ of $n op ids differ between two reloads of one tree"
    exit 1
  fi
  echo "reload-is-reproducible: two reloads of one tree agree on all $n op ids,"
  echo "  and the second pinned $moved trait call op(s)."
}

# --- trait-checker-vs-dispatch: the checker and dispatch agree on which impls exist ---
# An implementation is a candidate only while a name binds it AND it is not deprecated. Dispatch
# applies both filters; so does the save-time resolver. The checker's visible-impl set applied
# only the first, so deprecating the one implementation a call needs left a save that type-checked
# clean, committed, and raised on its first call. The checker is the copy of the rule that has to
# agree with the other two, and nothing in the suite compares them.
#
# Gate, not a testfile: deprecation is an op against a store, and the save under test has to go
# through `addAuthored` with that op already in it.
#
# The property is "the checker and dispatch agree about which implementations APPLY". This gate
# covers one way that has been broken, a deprecated implementation. There is a second, known and
# NOT covered here: the checker matches an implementation by the head of its self type and the
# runtime matches the type arguments too, so with `impl T for Option<Int64>` and
# `impl T for Option<String>` the save pins whichever was authored LATER rather than the one that
# fits, and the call then raises against a save that was green. A case for that belongs here, with
# the fix, rather than in a gate of its own: one gate named for the property, a case per way it has
# been broken, or the next instance needs a third name and nobody can find where the property lives.
gate_trait_checker_vs_dispatch() {
  set -euo pipefail

  WORK=rundir/trait-deprecated
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"
  # A copied store carries the real relay and its write secret. See the AGENTS.md note.
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  # The runner's binary, not `run-cli`: CI has no debug build and passes the published one in.
  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  # A field name nobody else would write: a record's hash IS its identity, so a shared shape
  # would hand us somebody's leftover implementations. See the AGENTS.md note.
  $CLI type Stachu.Dep.Dt "= { gateDeprecatedOnly: Int64 }" >/dev/null
  $CLI impl Stachu.Dep \
    "Stdlib.Add for Dt = let add (a: Dt) (b: Dt) : Dt = Stachu.Dep.Dt { gateDeprecatedOnly = a.gateDeprecatedOnly + b.gateDeprecatedOnly }" \
    >/dev/null

  # While it is live, the save is fine and so is the call. Both halves matter: a gate that only
  # checked the refusal would pass against a checker that refused everything.
  $CLI fn Stachu.Dep.sumLive - >/dev/null <<'DARK'
(a: Stachu.Dep.Dt) (b: Stachu.Dep.Dt) : Int64 =
  (a + b).gateDeprecatedOnly
DARK
  live=$($CLI eval 'Stachu.Dep.sumLive (Stachu.Dep.Dt { gateDeprecatedOnly = 1L }) (Stachu.Dep.Dt { gateDeprecatedOnly = 2L })' | clean)
  if [[ "$live" != *3* ]]; then
    echo "trait-checker-vs-dispatch: the call did not work with a live implementation: $live"
    exit 1
  fi

  $CLI deprecate impl Stachu.Dep.Dt.Add --kind obsolete -m 'gate' --yes >/dev/null

  # Dispatch's answer, first, so the rest of the gate is measuring a real retirement and not a
  # deprecate that did nothing.
  dispatch=$($CLI eval 'Stdlib.Add.add (Stachu.Dep.Dt { gateDeprecatedOnly = 1L }) (Stachu.Dep.Dt { gateDeprecatedOnly = 2L })' 2>&1 | clean || true)
  if [[ "$dispatch" != *"no implementation"* ]]; then
    echo "trait-checker-vs-dispatch: deprecating the implementation did not retire it at"
    echo "  dispatch, so nothing was tested. A fresh call answered: $dispatch"
    exit 1
  fi

  # The checker must now say the same thing, at save time.
  # The call saved while the implementation was live holds a recorded choice and still runs, so
  # `commit` must take it. It used to refuse with MissingImpl, which is the walkthrough's own
  # ending and what the PR's GIF shows. Committed here, before the refused save below, because
  # that one is meant to hold the draft back.
  committed=$($CLI commit -m 'gate: recorded choice' --yes 2>&1 | clean || true)
  if [[ "$committed" == *MissingImpl* ]]; then
    echo "trait-checker-vs-dispatch: commit refused a call that holds a recorded implementation."
    echo "  It runs, and the run time uses the choice it recorded, so the check must accept it."
    echo "    ${committed//$'\n'/$'\n'    }"
    exit 1
  fi

  saved=$($CLI fn Stachu.Dep.sumDeprecated - 2>&1 <<'DARK' | clean || true
(a: Stachu.Dep.Dt) (b: Stachu.Dep.Dt) : Int64 =
  (a + b).gateDeprecatedOnly
DARK
)
  if [[ "$saved" != *MissingImpl* ]]; then
    echo "trait-checker-vs-dispatch: the checker accepted a call that dispatch refuses."
    # shellcheck disable=SC2016  # the backticks are prose, not expansion
    echo '  Saving a `+` on a type whose only implementation is deprecated should report'
    echo "  MissingImpl. It answered:"
    echo "    ${saved//$'\n'/$'\n'    }"
    exit 1
  fi

  # --- case 2: they must agree about which implementation FITS, not only which exist ---
  #
  # The checker matched an implementation by the HEAD of its self type and the runtime matched the
  # type arguments too, so `impl T for Option<Int64>` and `impl T for Option<String>` were both
  # candidates at the save and it picked between them by timestamp. The pin landed on whichever was
  # authored later rather than the one that fits, and since the pin is `Chosen` the runtime never
  # re-asked: a green save that raised on its first call. The tell is that the ANSWER depended on
  # authoring order, so this walks both orders and expects the same answer from each.
  for order in int-first str-first; do
    W2="rundir/trait-argfit-$order"
    rm -rf "$W2"
    mkdir -p "$W2/logs"
    scripts/testing/_copy-store "$W2/data.db"
    sqlite3 "$W2/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true
    export DARK_CONFIG_RUNDIR="$PWD/$W2"

    $CLI trait Stachu.Fit.Show "<'a> = let show (v: 'a) : String" >/dev/null

    intImpl() {
      $CLI impl Stachu.FitInt - >/dev/null <<'DARK'
Stachu.Fit.Show for Stdlib.Option.Option<Int64> =
  let show (v: Stdlib.Option.Option<Int64>) : String = "INT"
DARK
    }
    strImpl() {
      $CLI impl Stachu.FitStr - >/dev/null <<'DARK'
Stachu.Fit.Show for Stdlib.Option.Option<String> =
  let show (v: Stdlib.Option.Option<String>) : String = "STR"
DARK
    }

    if [[ "$order" == "int-first" ]]; then
      intImpl
      strImpl
    else
      strImpl
      intImpl
    fi

    saved=$($CLI fn Stachu.Fit.callIt - 2>&1 <<'DARK' | clean || true
() : String =
  Stachu.Fit.Show.show (Stdlib.Option.Option.Some 1L)
DARK
)
    # The save has to agree as well as the call. The checker compared the impl's Int64 against
    # the literal's still-unwalked type variable, so it refused this save while the call ran.
    if [[ "$saved" == *MissingImpl* || "$saved" == *"could not pin"* ]]; then
      echo "trait-checker-vs-dispatch: the save refused or left unpinned a call that dispatch runs,"
      echo "  with the implementations authored $order:"
      echo "    ${saved//$'\n'/$'\n'    }"
      exit 1
    fi

    got=$($CLI eval 'Stachu.Fit.callIt ()' 2>&1 | clean || true)
    if [[ "$got" != *INT* ]]; then
      echo "trait-checker-vs-dispatch: a saved call was pinned to an implementation that does not"
      echo "  fit its type arguments, with the implementations authored $order."
      echo "  An Option<Int64> should take the Option<Int64> implementation whichever order they"
      echo "  were written in. It answered:"
      echo "    ${got//$'\n'/$'\n'    }"
      exit 1
    fi
  done

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"

  echo "trait-checker-vs-dispatch: a live implementation types and runs ($live); once it is"
  echo "  deprecated the checker refuses the save with MissingImpl, as dispatch does; and a saved"
  echo "  call takes the implementation whose TYPE ARGUMENTS fit, in either authoring order."
}

# --- trait-choice-survives-rival: a saved call keeps the implementation it was written against ---
# The property the save-time choice exists for. An ordinary trait call stores the fn the chosen
# implementation names, and a BOUNDED generic cannot: its self type is its caller's business. So
# the callee records that it defers to its own type param and the CALL records what that param
# implied, and neither is decided again at run time. A newer rival implementation arriving after
# the save must therefore change nothing until something repoints the call.
#
# Gate, not a testfile: nothing loaded from disk records a choice (only `addAuthored` does), so
# the thing under test only exists after authoring through the CLI, twice, with a store in between.
gate_trait_choice_survives_rival() {
  set -euo pipefail

  WORK=rundir/trait-rival
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"
  # A copied store carries the real relay and its write secret. See the AGENTS.md note.
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  # The runner's binary, not `run-cli`: CI has no debug build and passes the published one in.
  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  $CLI type Stachu.Rival.Pt "= { gateRivalOnly: Int64 }" >/dev/null
  $CLI impl Stachu.Rival \
    "ToString for Pt = let toString (p: Pt) : String = Stdlib.toString p.gateRivalOnly" >/dev/null
  $CLI module Stachu.Rival - >/dev/null <<'DARK'
let display<'a: Stdlib.ToString> (v: 'a) : String =
  Stdlib.ToString.toString v

let callIt () : String =
  let p = Stachu.Rival.Pt { gateRivalOnly = 7L }
  Stdlib.String.join ["value: ", Stachu.Rival.display p] ""
DARK

  before=$($CLI eval 'Stachu.Rival.callIt ()' | clean)
  if [[ "$before" != *"value: 7"* ]]; then
    echo "trait-choice-survives-rival: the bounded call did not work before any rival: $before"
    exit 1
  fi

  # A NEWER implementation for the same type: it wins any run-time dispatch, which is
  # exactly why the saved call must not be asking.
  $CLI impl Stachu.RivalNewer \
    "Stdlib.ToString for Stachu.Rival.Pt = let toString (p: Stachu.Rival.Pt) : String = \"RIVAL\"" \
    >/dev/null

  after=$($CLI eval 'Stachu.Rival.callIt ()' | clean)
  if [[ "$after" == *RIVAL* ]]; then
    echo "trait-choice-survives-rival: a newer implementation changed a saved call underneath it"
    echo "  before the rival: $before"
    echo "  after  the rival: $after"
    exit 1
  fi
  if [[ "$after" != *"value: 7"* ]]; then
    echo "trait-choice-survives-rival: the saved call stopped working once a rival existed: $after"
    exit 1
  fi

  # Proves the rival landed, so a pass is not a failed authoring.
  direct=$($CLI eval 'Stdlib.ToString.toString (Stachu.Rival.Pt { gateRivalOnly = 7L })' | clean)
  if [[ "$direct" != *RIVAL* ]]; then
    echo "trait-choice-survives-rival: the rival implementation never became the newest one,"
    echo "  so nothing was actually tested. A fresh call answered: $direct"
    exit 1
  fi

  echo "trait-choice-survives-rival: the saved bounded call kept its implementation ($after)"
  echo "  while a fresh call takes the newer one ($direct)."
}


# --- trait-choice-any-batching: the choice is recorded however the saves were batched ---
# `trait-choice-survives-rival` saves the implementation first and the calls after. A person
# writing one file saves the trait, its implementations and their callers in ONE `dark module`,
# and the checker used to see only what the store held before that save. So the same code was
# protected or not depending on how it was batched: saved with its trait, every trait call in
# the batch was left to run-time dispatch (`toString` included); saved with its implementations,
# the CALLER recorded nothing. Both saved cleanly, `typecheck` passed both, and re-saving was a
# no-op, so the only way to find out was to author a rival and watch the code change meaning.
#
# One trait, two implementations, a bounded generic and a caller, saved three ways. Each way gets
# its own method name, so no two share a content hash. Each must record its caller's choice and
# keep its answer when a newer rival for String lands.
gate_trait_choice_any_batching() {
  set -euo pipefail

  WORK=rundir/trait-batching
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"
  # A copied store carries the real relay and its write secret. See the AGENTS.md note.
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  # The runner's binary, not `run-cli`: CI has no debug build and passes the published one in.
  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  local src="$WORK/src"
  mkdir -p "$src"

  traitSrc() { printf '%s\n' "trait Gauge<'c> =" "  let $1 (c: 'c) : Int"; }
  implsSrc() {
    printf '%s\n' \
      "impl $1 for List<'a> =" \
      "  let $2 (xs: List<'a>) : Int = Stdlib.List.length xs" \
      "" \
      "impl $1 for String =" \
      "  let $2 (s: String) : Int = Stdlib.String.length s"
  }
  usersSrc() {
    printf '%s\n' \
      "let describe<'c: $1> (c: 'c) : String =" \
      "  (Stdlib.toString ($1.$2 c)) + \" items\"" \
      "" \
      "let tryIt () : List<String> = [ describe [ 1, 2, 3 ], describe \"hello\" ]"
  }

  # How many choices a stored fn's body records, `Unknown` aside: what pinning wrote.
  recorded() {
    $CLI eval "match Darklang.LanguageTools.PackageManager.Function.find Darklang.SCM.Branch.mainBranchId (Darklang.LanguageTools.ProgramTypes.PackageLocation { owner = \"Stachu\"; modules = [\"$1\"]; name = \"$2\" }) with
| Some h ->
  (match Darklang.LanguageTools.PackageManager.Function.get h with
   | Some f -> Stdlib.toRepr f.body
   | None -> \"\")
| None -> \"\"" | tr -s ' \n' ' ' | { grep -oE 'ImplChoice\.(Chosen|FromTypeParam)' || true; } | wc -l
  }

  save() {
    local out
    out=$($CLI module "/$1" - < "$2" 2>&1 | clean)
    if [[ "$out" != *"Defined"* ]]; then
      echo "trait-choice-any-batching: saving /$1 failed:"
      echo "$out"
      exit 1
    fi
  }

  # $1 the way, $2 the module tryIt lives in, $3 the trait's path, $4 the method
  check() {
    local way=$1 mod=$2 traitPath=$3 method=$4

    local pinned
    pinned=$(recorded "$mod" tryIt)
    if [[ "$pinned" -lt 2 ]]; then
      echo "trait-choice-any-batching: saved $way, the caller recorded $pinned choice(s) for"
      echo "  its two calls into the bounded generic, so both are left to run-time dispatch"
      exit 1
    fi

    local before after direct
    before=$($CLI eval "Stachu.$mod.tryIt ()" | clean)
    if [[ "$before" != *'"3 items", "5 items"'* ]]; then
      echo "trait-choice-any-batching: saved $way, the calls did not work before any rival: $before"
      exit 1
    fi

    $CLI impl "Stachu.${mod}Rival" \
      "$traitPath for String = let $method (s: String) : Int = 777" >/dev/null

    after=$($CLI eval "Stachu.$mod.tryIt ()" | clean)
    direct=$($CLI eval "$traitPath.$method \"hello\"" | clean)
    if [[ "$direct" != *777* ]]; then
      echo "trait-choice-any-batching: saved $way, the rival never became the newest"
      echo "  implementation, so nothing was tested. A fresh call answered: $direct"
      exit 1
    fi
    if [[ "$after" != "$before" ]]; then
      echo "trait-choice-any-batching: saved $way, a newer implementation changed a saved call"
      echo "  before the rival: $before"
      echo "  after  the rival: $after"
      exit 1
    fi
    echo "  $way: $pinned choices recorded, saved calls kept $after"
  }

  # One save: the trait, its implementations and their callers together.
  { traitSrc gaugeOne; echo; implsSrc Gauge gaugeOne; echo; usersSrc Gauge gaugeOne; } \
    > "$src/one.dark"
  save Stachu.BatchOne "$src/one.dark"
  check "in one batch" BatchOne Stachu.BatchOne.Gauge gaugeOne

  # Two saves: the trait, then the implementations with their callers.
  traitSrc gaugeTwo > "$src/two-trait.dark"
  { implsSrc Stachu.BatchTwoT.Gauge gaugeTwo; echo; usersSrc Stachu.BatchTwoT.Gauge gaugeTwo; } \
    > "$src/two-rest.dark"
  save Stachu.BatchTwoT "$src/two-trait.dark"
  save Stachu.BatchTwoU "$src/two-rest.dark"
  check "in two batches" BatchTwoU Stachu.BatchTwoT.Gauge gaugeTwo

  # Three saves: the shape that always worked, kept as the control.
  traitSrc gaugeThree > "$src/three-trait.dark"
  implsSrc Stachu.BatchThreeT.Gauge gaugeThree > "$src/three-impls.dark"
  usersSrc Stachu.BatchThreeT.Gauge gaugeThree > "$src/three-users.dark"
  save Stachu.BatchThreeT "$src/three-trait.dark"
  save Stachu.BatchThreeI "$src/three-impls.dark"
  save Stachu.BatchThreeU "$src/three-users.dark"
  check "in three batches" BatchThreeU Stachu.BatchThreeT.Gauge gaugeThree

  echo "trait-choice-any-batching: a trait, its implementations and their callers record the"
  echo "  same choices saved together or apart, and a newer rival changes none of them."
}


# --- trait-deprecation-is-per-branch: deprecating an implementation is branch-aware ---
# `deprecations` has no `branch_id`: a branch's `Deprecate` op sits inert in the op log the same
# way its names do, and names answer that with an in-memory overlay. The impl-candidate read did
# not, so it answered about MAIN while you stood on a branch: `dark view` there called an
# implementation deprecated while a call there still dispatched to it. The display half and the
# dispatch half disagreed exactly where a branch is supposed to be the thing that differs.
#
# Gate, not a testfile: it needs a store, a commit, and a second branch, which is three things a
# testfile has none of.
gate_trait_deprecation_is_per_branch() {
  set -euo pipefail

  WORK=rundir/trait-branch-dep
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"
  # A copied store carries the real relay and its write secret. See the AGENTS.md note.
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  # The runner's binary, not `run-cli`: CI has no debug build and passes the published one in.
  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  # A field name nobody else would write: a record's hash IS its identity. See the AGENTS.md note.
  $CLI type Stachu.BDep.Pt "= { gateBranchDepOnly: Int64 }" >/dev/null
  $CLI trait Stachu.BDep.Show "<'a> = let show (v: 'a) : String" >/dev/null
  $CLI impl Stachu.BDep \
    "Stachu.BDep.Show for Pt = let show (p: Pt) : String = \"FIRST\"" >/dev/null
  $CLI impl Stachu.BDepRival - >/dev/null <<'DARK'
Stachu.BDep.Show for Stachu.BDep.Pt =
  let show (p: Stachu.BDep.Pt) : String = "RIVAL"
DARK

  # The rival is newer, so it is what a call takes. Checked before anything is deprecated, so a
  # pass cannot come from the pair never having been ambiguous.
  on_main=$($CLI eval 'Stachu.BDep.Show.show (Stachu.BDep.Pt { gateBranchDepOnly = 1L })' | clean)
  if [[ "$on_main" != *RIVAL* ]]; then
    echo "trait-deprecation-is-per-branch: the rival never became the newest implementation,"
    echo "  so nothing was tested. Main answered: $on_main"
    exit 1
  fi

  # A branch sees main's items only once they are committed.
  $CLI commit -m 'gate: the pair' --yes >/dev/null
  $CLI branch create gate-dep >/dev/null

  $CLI deprecate impl Stachu.BDepRival.Pt.Show --kind obsolete -m 'gate' --yes >/dev/null

  # The display half, which was right all along.
  viewed=$($CLI view Stachu.BDepRival.Pt.Show 2>&1 | clean || true)
  if [[ "$viewed" != *DEPRECATED* ]]; then
    echo "trait-deprecation-is-per-branch: the branch does not even DISPLAY the implementation as"
    echo "  deprecated, so the two halves cannot be compared. It showed:"
    echo "    ${viewed//$'\n'/$'\n'    }"
    exit 1
  fi

  # The dispatch half, which is the bug. A deprecated implementation is not a candidate, so the
  # call falls back to the one that is left.
  on_branch=$($CLI eval 'Stachu.BDep.Show.show (Stachu.BDep.Pt { gateBranchDepOnly = 1L })' | clean)
  if [[ "$on_branch" != *FIRST* ]]; then
    echo "trait-deprecation-is-per-branch: the branch calls an implementation it reports as"
    echo "  deprecated. The display path is branch-aware and the candidate path is not."
    echo "  Expected FIRST, got: $on_branch"
    exit 1
  fi

  # And main is untouched by a deprecation authored on a branch.
  $CLI switch main >/dev/null
  after_main=$($CLI eval 'Stachu.BDep.Show.show (Stachu.BDep.Pt { gateBranchDepOnly = 1L })' | clean)
  if [[ "$after_main" != *RIVAL* ]]; then
    echo "trait-deprecation-is-per-branch: a deprecation authored on a branch reached MAIN."
    echo "  Expected RIVAL, got: $after_main"
    exit 1
  fi

  echo "trait-deprecation-is-per-branch: deprecating an implementation on a branch retires it"
  echo "  there ($on_branch) and leaves main alone ($after_main)."
}


# --- trait-pin-across-branches: a saved call keeps its implementation across a BRANCH boundary ---
# `trait-choice-survives-rival` proves the pin holds against a newer rival on the same branch. This
# is the harder half and the one nothing covered: the rival arrives on a DIFFERENT branch, where
# names resolve through an overlay rather than through main's projection. It was verified by hand
# and by nothing else, which is how a property stops being true without anyone noticing.
#
# Two fixtures, because the three directions want different arrangements and sharing one would make
# each assertion depend on the last.
gate_trait_pin_across_branches() {
  set -euo pipefail

  WORK=rundir/trait-pin-branch
  rm -rf "$WORK"
  mkdir -p "$WORK/logs"
  scripts/testing/_copy-store "$WORK/data.db"
  # A copied store carries the real relay and its write secret. See the AGENTS.md note.
  sqlite3 "$WORK/data.db" 'DELETE FROM config_v0;' 2>/dev/null || true

  # The runner's binary, not `run-cli`: CI has no debug build and passes the published one in.
  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"

  export DARK_CONFIG_RUNDIR="$PWD/$WORK"
  clean() { sed 's/\x1b\[[0-9;]*m//g'; }

  # A field name nobody else would write: a record's hash IS its identity. See the AGENTS.md note.
  $CLI type Stachu.Pin.Thing "= { gatePinOnly: Int64 }" >/dev/null
  $CLI trait Stachu.Pin.Tr "<'a> = let go (v: 'a) : Int64" >/dev/null
  $CLI impl Stachu.PinA - >/dev/null <<'DARK'
Stachu.Pin.Tr for Stachu.Pin.Thing =
  let go (v: Stachu.Pin.Thing) : Int64 = 1L
DARK
  $CLI impl Stachu.PinB - >/dev/null <<'DARK'
Stachu.Pin.Tr for Stachu.Pin.Thing =
  let go (v: Stachu.Pin.Thing) : Int64 = 2L
DARK

  # B is newer, so a call saved on main pins B.
  $CLI fn Stachu.Pin.callIt - >/dev/null <<'DARK'
() : Int64 =
  Stachu.Pin.Tr.go (Stachu.Pin.Thing { gatePinOnly = 0L })
DARK
  pinned=$($CLI eval 'Stachu.Pin.callIt ()' | clean)
  if [[ "$pinned" != *2* ]]; then
    echo "trait-pin-across-branches: the saved call did not pin the newer implementation on main,"
    echo "  so nothing downstream is testing what it says. It answered: $pinned"
    exit 1
  fi

  # A branch sees main's items only once they are committed.
  $CLI commit -m 'gate: the pin fixture' --yes >/dev/null
  $CLI branch create gate-pin >/dev/null

  # The rival arrives on the branch, newer than both.
  $CLI impl Stachu.PinC - >/dev/null <<'DARK'
Stachu.Pin.Tr for Stachu.Pin.Thing =
  let go (v: Stachu.Pin.Thing) : Int64 = 3L
DARK

  # A FRESH call on the branch takes the branch's rival: without this the next assertion could pass
  # against a branch that simply cannot see the new implementation.
  fresh=$($CLI eval 'Stachu.Pin.Tr.go (Stachu.Pin.Thing { gatePinOnly = 0L })' | clean)
  if [[ "$fresh" != *3* ]]; then
    echo "trait-pin-across-branches: the branch's own implementation never became the newest one,"
    echo "  so the pin was not actually under pressure. A fresh call answered: $fresh"
    exit 1
  fi

  # THE PROPERTY: the caller saved on main still runs what it resolved against, on the branch.
  held=$($CLI eval 'Stachu.Pin.callIt ()' | clean)
  if [[ "$held" != *2* ]]; then
    echo "trait-pin-across-branches: a call saved on main changed meaning on a branch. It should"
    echo "  keep the implementation it was written against (2) while a fresh call takes the"
    echo "  branch's newer one (3). It answered: $held"
    exit 1
  fi

  # --- fixture 2: deprecation inherits down and can be overridden up ---
  $CLI switch main >/dev/null
  $CLI type Stachu.Pin.Other "= { gatePinOtherOnly: Int64 }" >/dev/null
  $CLI impl Stachu.PinD - >/dev/null <<'DARK'
Stachu.Pin.Tr for Stachu.Pin.Other =
  let go (v: Stachu.Pin.Other) : Int64 = 10L
DARK
  $CLI impl Stachu.PinE - >/dev/null <<'DARK'
Stachu.Pin.Tr for Stachu.Pin.Other =
  let go (v: Stachu.Pin.Other) : Int64 = 20L
DARK
  $CLI commit -m 'gate: the deprecation fixture' --yes >/dev/null

  other() { $CLI eval 'Stachu.Pin.Tr.go (Stachu.Pin.Other { gatePinOtherOnly = 0L })' | clean; }

  # E is newer, so it runs on main.
  if [[ "$(other)" != *20* ]]; then
    echo "trait-pin-across-branches: the second fixture's newer implementation does not run on main."
    exit 1
  fi

  $CLI deprecate impl Stachu.PinE.Other.Tr --kind obsolete -m 'gate' --yes >/dev/null
  if [[ "$(other)" != *10* ]]; then
    echo "trait-pin-across-branches: deprecating on main did not retire the implementation there."
    exit 1
  fi

  # Down: a branch forked after that deprecation sees it.
  $CLI branch create gate-pin-dep >/dev/null
  if [[ "$(other)" != *10* ]]; then
    echo "trait-pin-across-branches: a branch does not inherit a deprecation made on main."
    echo "  Expected 10, got: $(other)"
    exit 1
  fi

  # Up: the branch says "not here", and main is untouched by it.
  $CLI undeprecate Stachu.PinE.Other.Tr >/dev/null
  if [[ "$(other)" != *20* ]]; then
    echo "trait-pin-across-branches: a branch cannot undeprecate what main deprecated."
    echo "  Expected 20 on the branch, got: $(other)"
    exit 1
  fi

  $CLI switch main >/dev/null
  if [[ "$(other)" != *10* ]]; then
    echo "trait-pin-across-branches: a branch's undeprecate reached MAIN."
    echo "  Expected 10 on main, got: $(other)"
    exit 1
  fi

  echo "trait-pin-across-branches: a call saved on main keeps its implementation ($held) on a branch"
  echo "  where a fresh call takes the branch's newer one ($fresh); and a deprecation made on main"
  echo "  is inherited by a branch, overridable there, and unaffected by that override."
}

# --- hosted-db: a served handler reads and writes a user DB, and its functions commit ---
# Three things each stopped this on their own: `DB<T>` could not be written in saved code, the
# at-rest checker read a DB's name as an unbound variable so nothing naming one could be
# committed, and `serve` never loaded the DBs, so every request answered 500 "There is no variable
# named". Each step below is the one that broke.
gate_hosted_db() {
  set -uo pipefail

  CLI="$PWD/${CLI:-backend/Build/out/Cli/Debug/net10.0/Cli}"
  ROOT=rundir/hosted-db
  PORT=$(( 9200 + RANDOM % 300 ))
  if command -v ss > /dev/null && ss -ltn 2>/dev/null | grep -q ":$PORT "; then
    echo "port $PORT is already in use; re-run (the port is random per run)" >&2
    exit 2
  fi

  rm -rf "$ROOT"; mkdir -p "$ROOT/home"
  scripts/testing/_copy-store "$ROOT/data.db"
  sqlite3 "$ROOT/data.db" 'DELETE FROM config_v0;'
  # The grants below go into the policy under HOME, so this gate has its own.
  export DARK_CONFIG_RUNDIR="$PWD/$ROOT" HOME="$PWD/$ROOT/home"

  pass=0; fail=0
  ok()   { pass=$((pass+1)); printf '  ok   %s\n' "$1"; }
  bad()  { fail=$((fail+1)); printf '  FAIL %s\n       got: %s\n' "$1" "$(head -c 200 <<<"$2" | tr '\n' ' ')"; }
  want() { if grep -qE "$2" <<<"$3"; then ok "$1"; else bad "$1" "$3"; fi; }
  x()    { "$CLI" "$@" 2>&1 | sed 's/\x1b\[[0-9;]*m//g'; }

  x type Stachu.HostedDb.Note "= { hostedDbGateNote: String }" > /dev/null
  want "a DB is declared" "Created database" "$(x db HostedDbNotes Stachu.HostedDb.Note)"

  saved=$(x module Stachu.HostedDb - <<'DARK'
let countOf (book: DB<Note>) : Int = Stdlib.DB.count book

let router (req: Stdlib.Http.Request) : Stdlib.Http.Response =
  match Stdlib.HttpServer.getMethod req with
  | "POST" ->
    let note = Stdlib.String.fromBlobWithReplacement req.body
    let _ = Stdlib.DB.set (Note { hostedDbGateNote = note }) note HostedDbNotes
    Stdlib.Http.responseWithText $"signed, {Stdlib.toString (countOf HostedDbNotes)} so far" 201
  | _ ->
    Stdlib.DB.getAll HostedDbNotes
    |> Stdlib.List.map (fun n -> n.hostedDbGateNote)
    |> Stdlib.List.sort
    |> (fun notes -> Stdlib.Http.responseWithText (Stdlib.String.join notes ",") 200)
DARK
)
  want "a parameter typed DB<Note> saves" "Defined 2 declarations" "$saved"
  want "the functions naming the DB type-check" '"verdict":"checked".*"failed":0' \
    "$(x typecheck Stachu.HostedDb --json)"
  want "and commit" "commit [0-9a-f]+ -- " "$(x commit 'hosted db' -y)"

  x permissions allow http-server "$PORT" > /dev/null
  x permissions approve Stachu.HostedDb.router -y > /dev/null

  serve() {
    "$CLI" serve Stachu.HostedDb.router --port "$PORT" > "$ROOT/serve$1.log" 2>&1 &
    SPID=$!
    trap 'kill $SPID 2>/dev/null' EXIT
    for _ in $(seq 1 40); do
      curl -s -o /dev/null --max-time 2 "http://localhost:$PORT/" && return 0
      kill -0 $SPID 2>/dev/null || { echo "the server we started is not running"; cat "$ROOT/serve$1.log"; exit 2; }
      sleep 1
    done
  }
  get()  { curl -s --max-time 10 "http://localhost:$PORT/"; }
  post() { curl -s --max-time 10 -X POST --data "$1" "http://localhost:$PORT/"; }

  serve 1
  want "a POST writes" "^signed, 1 so far$" "$(post alpha)"
  want "a second one counts both" "^signed, 2 so far$" "$(post beta)"
  want "a GET reads what was written" "^alpha,beta$" "$(get)"
  kill $SPID; wait $SPID 2>/dev/null

  serve 2
  want "the rows outlive the server process" "^alpha,beta$" "$(get)"
  kill $SPID; wait $SPID 2>/dev/null

  echo "hosted-db: $pass ok, $fail failed"
  [[ $fail -eq 0 ]]
}
