#!/usr/bin/expect -f
# Driven by the workbench-scm gate (scripts/testing/_gates-ui), which builds the store.
set timeout 45
log_user 0

proc fail {msg} { puts "FAIL: $msg"; exit 1 }
# Returns what was received up to and including the match. `expect_out` is set in the scope the `expect`
# ran in, so a caller that wants to look at the text has to be handed it from in here.
proc want {pattern what} {
  expect {
    -re $pattern { puts "  ok: $what"; return $expect_out(buffer) }
    timeout { fail "timed out waiting for $what" }
    eof { fail "process exited while waiting for $what" }
  }
}

# Give each key a moment to land: a key pressed while a frame is still painting is dropped, and the
# symptom is the NEXT assertion timing out, not "the key did nothing".
proc press {key} { sleep 1; send $key }

set exe [lindex $argv 0]
set env(DARK_CONFIG_RUNDIR) [lindex $argv 1]
spawn $exe

# Home IS the SCM summary: needs attention / current work / recent commits / branches all render on the landing
# screen, each from its own SCM API (`SCM.Conflicts.pending`, `SCM.Draft.read`, `SCM.Commits.recent`,
# `SCM.Branch.list`). That makes Home the place to assert the DATA path -- one of those wired wrong takes
# the workbench down on startup, so the assertions below are as much about the queries as the drawing.
#
# The startup marker is the frame's top border, not a greeting: the welcome panel only appears on a
# genuine first run, and this store has work in it. It has to be something every frame has at
# expect's 80 columns, where there is no nav strip and the header is just the branch and the
# instance -- the navbar's `1 Home` is not drawn at that width, and the instance name comes from
# the hostname. It used to be the header's `who @ where`, which stopped existing when accounts did.
want "╭" "the workbench on startup"

want "needs attention" "Home summarizes what needs you"
want "recent commits" "Home shows recent commits across branches"
want "workbench scm fixtur" "including the one this fixture made"
want "branches" "and the branches"

# 3 is the Changes view. It must show the draft rather than an empty state.
press "3"
want "WbScm.T.draft" "the draft item in the Changes view"

# Switch without leaving Changes or remembering the exact branch name.
# The target is outside Home's summary cap, but must be in the full picker.
press "S"
want "Switch branch" "the global branch picker"
press "wb-pick-12"
want "wb-pick-12" "typing filters the full branch list"
press "\r"
want "nothing uncommitted on this branch" "Changes reads the new overlay"
want "switched to wb-pick-12" "Enter switches the selected branch"

press "S"
want "Switch branch" "the picker opens on the current branch"
press "zzz-no-branch"
want "No matching branches" "unknown names do not switch branches"
press "\r"
press "\033"

press "S"
want "Switch branch" "main is reachable through the same picker"
press "main"
press "\r"
want "WbScm.T.draft" "main's draft survives the round trip"
want "switched to main" "Enter returns to main"

# `q`, not Escape: Escape means "step back" inside a view, so it does not leave from here.
press "q"
expect {
  eof { puts "workbench: Home shows real SCM work, Changes lists the draft, and the branch picker switches." }
  timeout { fail "q did not exit the workbench" }
}
