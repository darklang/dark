#!/usr/bin/expect -f
# The workbench on a store where nothing needs you: commits, no conflicts, no draft. Home then starts
# with recent commits, without an empty attention or draft section.
set timeout 45
log_user 0
proc fail {msg} { puts "FAIL: $msg"; exit 1 }
proc want {pattern what} {
  expect {
    -re $pattern { puts "  ok: $what"; return $expect_out(buffer) }
    timeout { fail "timed out waiting for $what" }
    eof { fail "process exited while waiting for $what" }
  }
}
proc press {key} { sleep 1; send $key }
set exe [lindex $argv 0]
set env(DARK_CONFIG_RUNDIR) [lindex $argv 1]
spawn $exe
want " @ " "the workbench on startup"
want "recent commits" "Home shows recent commits across branches"
want "workbench quiet fixtur" "including the one this fixture made"
# A runtime error prints instead of the frame; also reject the old permanent inspector.
set timeout 3
expect {
  -re "Welcome|nothing waiting|Runtime Error|expects .* but got" { fail "Home rendered an obsolete panel or a runtime error" }
  timeout { puts "  ok: and the overview stays quiet" }
}
set timeout 45
press "q"
expect {
  eof { puts "workbench: a quiet store opens on recent commits." }
  timeout { fail "q did not exit the workbench" }
}
