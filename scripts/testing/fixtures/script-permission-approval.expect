#!/usr/bin/expect -f
# Run the script in a terminal and choose "Remember for this code version".
# The backend test checks the output and exit code.
set timeout 30

proc fail {message} {
  global spawn_id
  puts stderr "Permission approval interaction failed: $message"
  catch {exec kill -KILL [exp_pid]}
  catch {close}
  catch {wait}
  exit 2
}

set cli [lindex $argv 0]
set script [lindex $argv 1]
# This plays a person at a terminal, so CI must not say nobody is there.
catch {unset env(CI)}
catch {unset env(DARK_NO_INPUT)}
spawn -noecho $cli run $script
# .NET switches the terminal to keypad mode (ESC[?1h ESC=) the first time it sets the console up,
# and that can land between two of the prompt's lines, so any escape may appear where colour can.
set esc {(?:\x1b(?:\[[0-9;?]*[A-Za-z]|[=>]))*}
set remember [string map [list ESC $esc] {\r?\nESC +ESC([0-9]+)ESC\. Remember for this code version}]
expect {
  -re $remember {
    set choice $expect_out(1,string)
  }
  timeout { fail "no remember-for-this-version option" }
  eof { fail "exited before offering approval" }
}
expect {
  "Enter number:" { send -- "$choice\r" }
  timeout { fail "no selection prompt" }
  eof { fail "exited before selection" }
}
expect {
  eof {}
  timeout { fail "did not exit after approval" }
}
set result [wait]
if {[lindex $result 2] != 0 || [llength $result] != 4} {
  puts stderr "Unexpected worker status: $result"
  exit 2
}
exit [lindex $result 3]
