#!/usr/bin/env bash

# Start the dev environment without VS Code, and follow the build.
#
# Delegates rather than running its own `docker run`, so there's one container spec
# (.devcontainer/devcontainer.json) instead of two that drift apart.

set -euo pipefail

if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
  echo "We require bash >= 4. On a Mac with homebrew: brew install bash" >&2
  exit 1
fi

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )"/.. && pwd )"

# The container builds once on start, so the old --compile/--watch/--serve/--test
# flags have nothing left to control.
if [[ "$#" -gt 0 ]]; then
  echo "note: $* ignored. The container builds once when it starts. After that:" >&2
  echo "      scripts/dev/build    build what's changed" >&2
  echo "      scripts/dev/watch    rebuild on save" >&2
  echo "      scripts/run-backend-tests" >&2
fi

"$DIR/scripts/dev/start"

echo
"$DIR/scripts/dev/status"
