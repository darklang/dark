#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

PUBLISHED=false
FLAGS=""
NO_LOG=false

# The wrapper's own flags come first, in any order, and are not passed on. Scanning
# every argument and calling `shift` for a match dropped the FIRST argument whichever
# one matched, so `run-cli eval x --no-log` ran `x --no-log` with the log still on.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --published) PUBLISHED=true; shift ;;
    --no-log) NO_LOG=true; shift ;;
    *) break ;;
  esac
done

for i in "$@"
do
  case "${i}" in
    --flags=*) FLAGS="${i#*=}" ;;
  esac
done

if [[ -n "$FLAGS" ]]; then
  echo "Flags: $FLAGS" >&2
fi

LOGS="${DARK_CONFIG_RUNDIR}/logs"
CLI_LOG="$LOGS/cli.log"

if [[ "$PUBLISHED" == "true" ]]; then
  EXE="backend/Build/out/Cli/Release/net10.0/linux-x64/publish/Cli"
else
  EXE="backend/Build/out/Cli/Debug/net10.0/Cli"
fi

# Is what we're about to run current? This used to be inferred by tailing
# packages.log for "Exception" and "DEBUG: about to parse", which meant the answer
# depended on log strings nobody was maintaining. scripts/dev/build records what it
# did instead; a build in flight or a failed one is fatal, a tree that's merely moved
# on since the last build is a warning, since editing and then running is normal.
if [[ "${CI:-}" != "true" ]]; then
  python3.12 scripts/build/_dev.py check || exit 1
fi

if [[ ! -f "${EXE}" ]]; then
  {
    echo "No CLI binary at ${EXE}"
    echo "Build it: scripts/dev/build"
  } >&2
  exit 1
fi

GIT_COMMIT=$(git rev-parse --short HEAD)
export GIT_COMMIT

# context: 'tee' was screwing up our MCP server running through this script
# so a --no-log argument is supported to skip logging to the file.
# also skip the tee when stdout is a tty (interactive): the pipe makes stdout a
# non-tty, which breaks full-screen TUIs (`dark apps`, `dark outliner`, …).
#
# exec, so signals reach the CLI rather than stopping at this wrapper. Without it a
# terminated `run-cli` leaves the Cli child orphaned; one container accumulated 57.
if [[ "$NO_LOG" == "true" ]] || [ -t 1 ]; then
  exec "${EXE}" "$@"
else
  # Both streams go to the log, and each stays on its own stream. This used to be
  # `2>&1 | tee`, which put every refusal and hint on stdout for anyone piping the
  # CLI, agents included. fd 3 carries stdout past the inner tee, which takes stderr.
  : > "${CLI_LOG}"
  { "${EXE}" "$@" 2>&1 1>&3 3>&- | tee -a "${CLI_LOG}" >&2 3>&-; } 3>&1 | tee -a "${CLI_LOG}"
fi

