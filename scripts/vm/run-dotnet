#!/usr/bin/env bash
# Explicit, build-only launcher for Work VMs; never a shipped CLI wrapper.
set -euo pipefail
: "${DARK_VM_DOTNET_ROOT:?Set to the extracted pinned SDK directory}"
: "${DARK_VM_COMPAT_SO:?Set to the compiler VM adapter shared object}"
: "${DARK_VM_METADATA_SO:?Set to the compiled dotnet-metadata.c shared object}"
export DOTNET_ROOT="$DARK_VM_DOTNET_ROOT"
export PATH="$DOTNET_ROOT:$PATH"
export DOTNET_ROLL_FORWARD=Major
export DOTNET_GCHeapHardLimit=40000000
export DOTNET_EnableWriteXorExecute=0
export DOTNET_CLI_HOME="$DOTNET_ROOT/cli-home"
export TMPDIR="$DOTNET_ROOT/tmp"
export PORT_VM_TMPDIR="$TMPDIR"
export LD_PRELOAD="$DARK_VM_METADATA_SO:$DARK_VM_COMPAT_SO"
exec "$DOTNET_ROOT/dotnet" "$@"
