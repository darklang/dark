#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

# Start a store upgrade: a directory of its own under backend/migrations/upgrades/.
#
#   scripts/migrations/new add_trace_duration
#
# One upgrade is one directory, and a store records it by the directory's name once it has run, so
# fresh stores and existing ones get it the same way and there is nothing else to edit:
#
#   upgrade.toml   kind, what it comes after, the tables it touches
#   shape.sql      for a table or column change: `add-column <table> <column> <declaration>`
#                  (SQLite cannot say "if missing"), or any statement safe to run twice
#   step.fs        instead, when the upgrade is code (rewriting rows, moving data)
#
# `after` is how order is decided, not the name. Two upgrades that touch the same table must be
# ordered, or the build refuses and says which line to add; upgrades on different tables need
# nothing. Usually `after` names the last upgrade to touch your table:
#
#   grep -l '"<table>"' backend/migrations/upgrades/*/upgrade.toml
#
# The base schema files (backend/migrations/schema/*.sql) are frozen; a new table is an upgrade too.

case "${1:-}" in
  -h|--help) sed -n '6,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  # A tag is a name, not a flag.
  -*) echo "Not a tag: $1. Try --help" >&2; exit 1 ;;
  "") echo "usage: $0 <short_tag>" >&2; exit 1 ;;
esac
[[ "$#" -eq 1 ]] || { echo "usage: $0 <short_tag>" >&2; exit 1; }
[[ "$1" =~ ^[a-z0-9_]+$ ]] || { echo "A tag is lowercase letters, digits and _ only: $1" >&2; exit 1; }

NAME="$(date -u +%Y%m%d_%H%M%S)_$1"
DIR="backend/migrations/upgrades/${NAME}"
mkdir -p "$DIR"

cat > "$DIR/upgrade.toml" <<'EOF'
# <what this upgrade is, and why it is safe against a store that already has it>

kind = "shape"
after = []
touches = []
EOF

cat > "$DIR/shape.sql" <<'EOF'
-- add-column <table> <column> <declaration>
EOF

git add "$DIR"

echo "Created ${DIR}/"
echo "  upgrade.toml  say why, which tables it touches, and what it comes after"
echo "  shape.sql     the change; or replace it with step.fs if this is code"
echo "It runs on the next scripts/dev/build, against the dev store, and on every store a release opens."
