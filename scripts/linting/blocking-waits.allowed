# Blocking waits scripts/linting/blocking-waits lets through: a path, then text from the line.
# Each is a thread that is the program's own and has nothing else to do; a browser build has no
# such thread, so these go before it can run.

# LocalExec's benchmarks: what one call allocates, against a source that answers at once.
backend/src/LocalExec/BenchmarkScenarios.fs client.GetAsync("http://fake.local/body").GetAwaiter().GetResult()
backend/src/LocalExec/BenchmarkScenarios.fs resp.Content.ReadAsByteArrayAsync().GetAwaiter().GetResult()
backend/src/LocalExec/BenchmarkScenarios.fs (Option.get (Stream.readAllBytes stream)).Result

# Reader threads waiting for a request, on a semaphore rather than a task.
backend/src/LibExecution/HostEvents.fs requests.Wait()

# A zero timeout: takes a slot if one is free, never waits.
backend/src/LibExecution/Spread.fs workers.ChunkSlots.Wait 0
