#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

all_yaml_files() {
  # Each prune is spelled the way `find .` yields paths, with the leading `./`. One spelled
  # without it never matches, and the walk then lints vendored yaml instead of ours.
  find . \
    \( -path ./.git \
    -o -path ./later \
    -o -path ./rundir \
    -o -path ./clis \
    -o -path ./backend/paket-files \
    -o -path ./backend/Build \
    -o -name node_modules \
    \) -prune \
    -o -type f \( -name "*.yml" -o -name "*.yaml" \) -print
}

if [[ "$#" -eq 1 ]]; then
  yamllint "$1"
else
  echo "linting yaml files ..."
  files=$(all_yaml_files)
  # A mistake in the prunes above presents as a clean run, so check that the walk found the
  # file anybody actually edits. A count would not do: there are only three files to count.
  n=$(echo "$files" | grep -c . || true)
  if [[ -z "$files" ]] || ! echo "$files" | grep -qx "./.circleci/config.yml"; then
    echo "yamllinter: the walk matched $n file(s) and did not include ./.circleci/config.yml," >&2
    echo "            which means the prune list is wrong" >&2
    exit 2
  fi
  echo "$files" | xargs yamllint
  echo "linted $n yaml file(s)"
fi
