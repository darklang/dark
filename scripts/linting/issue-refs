#!/usr/bin/env python3
"""Code doesn't cite issue or PR numbers: fail on `#` and four or five digits.

A comment says what it needs to say itself; the issue can move, close or be renamed.

  scripts/linting/issue-refs      exit 1 naming each file:line
"""

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
DIRS = ["backend/src", "backend/tests", "packages", "scripts"]
REF = re.compile(r"(?<![\w&/])#[0-9]{4,5}\b|\bdarklang/[\w-]+#[0-9]+")


def main():
    files = subprocess.run(
        ["git", "ls-files", "--", *DIRS], cwd=ROOT, capture_output=True, text=True, check=True
    ).stdout.split()
    found = []
    for rel in files:
        try:
            with open(os.path.join(ROOT, rel), encoding="utf-8") as f:
                text = f.read()
        except (UnicodeDecodeError, FileNotFoundError, IsADirectoryError):
            continue
        for n, line in enumerate(text.split("\n"), 1):
            if REF.search(line):
                found.append(f"{rel}:{n}: {line.strip()}")
    for f in found:
        print(f)
    if found:
        print(
            "\nissue-refs: say what the issue or PR says instead of citing its number.",
            file=sys.stderr,
        )
    sys.exit(1 if found else 0)


if __name__ == "__main__":
    main()
