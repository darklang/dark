#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

# Lint the shell scripts you name, or every one in the repo if you name none.

# SC2002: useless cat. SC2044: for loops over find. SC2086: unquoted variables.
EXCLUDE=(-e SC2002 -e SC2044 -e SC2086)

if [[ "$#" -gt 0 ]]; then
  echo "shellcheck $*"
  exec shellcheck -x "${EXCLUDE[@]}" "$@"
fi

echo "shellcheck bash files ..."

# Everything with a shebang naming a shell, skipping vendored and generated trees.
# shellcheck disable=SC2038 # our filenames have no spaces
find . \
  \( -name .git \
  -o -name later \
  -o -name node_modules \
  -o -name rundir \
  -o -name Build \
  -o -name paket-files \
  -o -name static \
  \) -prune \
  -o -type f \
  -exec awk 'FNR == 1 && /^#!.*sh/{print FILENAME}' {} + \
  | xargs shellcheck "${EXCLUDE[@]}"
