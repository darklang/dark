#!/usr/bin/env bash
. ./scripts/devcontainer/_assert-in-container "$0" "$@"

set -euo pipefail

PUBLISHED=false
PUBLISHED_FLAG=
FORCE=false
FILTERED=false

# Parallel by default, which is now much faster. `--sequenced` puts it back.
#
# It was sequenced, on this measurement over the cli/fluid subtree, 991 tests:
#
#   parallel    1702s wall    64,720s of per-test time
#   sequenced    807s wall       787s of per-test time
#
# Eighty times the CPU for twice the wall clock is not a scheduling preference, it is
# a bug, and the bug was the garbage collector. This interpreter allocates hard and the
# test binary was using the WORKSTATION collector: one heap, every thread stopped for
# every collection. The tell was that the parallel ceiling ignored the worker count --
# 200 independent CPU-only cases took 5.37s with 8 Expecto workers and 5.52s with 32,
# against 23.1s sequenced. A ceiling that does not move with workers is a serial section.
#
# `ServerGarbageCollection` in backend/tests/Tests/Tests.fsproj took those same 200 cases
# to 2.06s, and the whole cli/fluid subtree from 311% CPU to ~2900%:
#
#   sequenced             ~34 min
#   parallel + server GC    4:23     1,880 tests, all passing
#
# Files that share DB state stay sequenced where it matters: `LibExecution.Tests.fs` marks
# the `/cloud` testfiles `testSequenced` itself, so this flag does not race them.
EXPECTO_ARGS=()

for i in "$@"
do
  case "${i}" in
    --published)
      PUBLISHED=true
      PUBLISHED_FLAG=$i
      ;;
    --force) FORCE=true ;;
    # Opt back into sequential, undoing the parallel default above.
    --sequenced) EXPECTO_ARGS=(--sequenced) ;;
    # Accepted and ignored: parallel is the default now.
    --parallel) ;;
    --filter|--filter-test-list|--filter-test-case|--run)
      FILTERED=true
      EXPECTO_ARGS+=("${i}")
      ;;
    *) EXPECTO_ARGS+=("${i}");;
  esac
done

# Discovery, before anything expensive: no database, no package reload. Working out
# what to run shouldn't cost as much as running it.
case "${1:-}" in
  --groups) exec python3.12 scripts/testing/_test-explorer.py groups "${@:2}" ;;
  --find)   exec python3.12 scripts/testing/_test-explorer.py find "${@:2}" ;;
esac

# Two runs in one clone destroy each other: same test-data.db, same httpclient port,
# and the `killall -9 Tests` below would take out the other one's process.
#
# Two runs in *different* clones are fine, and used to not be. Each clone has its own
# container, so its own PID namespace, its own bridge network and its own bind-mounted
# rundir; none of those three things is shared. It was only ever true while every
# clone's scripts re-execed into whichever container was newest, which is fixed.
LOCK="${DARK_CONFIG_RUNDIR}/test.lock"
if [[ -f "$LOCK" ]] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then
  if [[ "$FORCE" != "true" ]]; then
    {
      echo "Tests are already running in this clone (pid $(cat "$LOCK"))."
      echo "Two runs share test-data.db and would destroy each other."
      echo "Wait for it, or pass --force if you're sure it's dead."
    } >&2
    exit 1
  fi
  echo "--force given; taking over from pid $(cat "$LOCK")" >&2
fi

mkdir -p "${DARK_CONFIG_RUNDIR}"
echo $$ > "$LOCK"

# shellcheck disable=SC2317  # reached via trap
cleanup() {
  kill "${HEARTBEAT_PID:-}" 2>/dev/null || true
  killall -9 Tests 2>/dev/null || true
  rm -f "$LOCK"
}
trap cleanup EXIT INT

# Anything still running is a leftover from a crashed run: the lock above means no
# live run of our own.
killall -9 Tests 2>/dev/null || true

if [[ "$PUBLISHED" == "true" ]]; then
  EXE=Build/out/Tests/Release/net10.0/publish/Tests
  LOCALEXEC=Build/out/LocalExec/Release/net10.0/publish/LocalExec
else
  EXE=Build/out/Tests/Debug/net10.0/Tests
  LOCALEXEC=Build/out/LocalExec/Debug/net10.0/LocalExec
fi


LOGS="${DARK_CONFIG_RUNDIR}/logs"

grey="\033[1;30m"
reset="\033[0m"


# Delete the database file before running tests.
# WAL mode keeps `.db-wal` (uncommitted writes) and `.db-shm`
# (shared-memory index) alongside `.db`. Removing only `.db`
# leaves the WAL behind — the next run picks it up and behaves
# unpredictably (slow / corrupt).
export DARK_CONFIG_DB_NAME=test-data.db
DB_PATH="${DARK_CONFIG_RUNDIR}/${DARK_CONFIG_DB_NAME}"
echo -e "Deleting database file ${grey}(${DB_PATH})${reset}"
rm -f "$DB_PATH" "$DB_PATH-wal" "$DB_PATH-shm"

# Run the migrations before the other servers start
echo -e "Running migrations ${grey}($LOGS/test-migrations.log)${reset}"
cd backend && \
  DARK_CONFIG_TELEMETRY_EXPORTER=none \
  "${LOCALEXEC}" migrations run > "$LOGS/test-migrations.log" 2>&1
cd ..

if [[ "${DARK_CONFIG_PACKAGES_SOURCE:-disk}" == "seed" ]]; then
  # Seed mode: copy seed as test DB, Tests exe auto-grows on startup
  SEED_PATH="${DARK_CONFIG_RUNDIR}/seed.db"
  if [[ -f "$SEED_PATH" ]]; then
    echo "Copying seed.db as test database"
    cp "$SEED_PATH" "$DB_PATH"
  else
    echo "ERROR: No seed.db found at $SEED_PATH"
    echo "Run: ./scripts/run-cli export-seed /home/dark/app/rundir/seed.db"
    echo "Or:  ./scripts/fetch-seed"
    exit 1
  fi
else
  # Disk mode: reload packages from .dark files.
  #  Migrations already ran inline above
  #
  # Reloading is 11.9s of a ~16s startup, and most runs do not need it: editing a TESTFILE does not
  # change a package. So keep a pristine snapshot taken right after a reload, stamped with the state of
  # `packages/`, and copy it back when nothing there has moved. A 64MB copy against twelve seconds.
  #
  # A snapshot rather than reusing the database in place, because tests WRITE to the store -- authoring
  # cases add declarations -- and the next run has to start from the same place this one did. That is
  # what the delete above is for, and this keeps it.
  PRISTINE_PATH="${DARK_CONFIG_RUNDIR}/test-data-pristine.db"
  PRISTINE_STAMP="${DARK_CONFIG_RUNDIR}/test-data-pristine.stamp"
  PACKAGES_STAMP=$(
    { find packages -name '*.dark' -type f -printf '%T@ %s %p\n' 2>/dev/null | sort;
      echo "published=${PUBLISHED_FLAG}"; } | sha256sum | cut -d' ' -f1
  )

  if [[ -f "$PRISTINE_PATH" && -f "$PRISTINE_STAMP" && "$(cat "$PRISTINE_STAMP")" == "$PACKAGES_STAMP" ]]; then
    echo -e "Reusing package snapshot ${grey}(packages unchanged)${reset}"
    cp "$PRISTINE_PATH" "$DB_PATH"
  else
    if [[ -v CI ]]; then
      echo "Reloading packages"
      ./scripts/build/reload-packages $PUBLISHED_FLAG
    else
      echo "Reloading packages"
      ./scripts/build/reload-packages --test $PUBLISHED_FLAG
    fi
    # Snapshot AFTER the reload and before any test has run, so what gets restored is what a reload
    # produces. WAL and shm are checkpointed into the copy by copying all three.
    cp "$DB_PATH" "$PRISTINE_PATH" 2>/dev/null || true
    echo "$PACKAGES_STAMP" > "$PRISTINE_STAMP"
  fi
fi

JUNIT_FILE="${DARK_CONFIG_RUNDIR}/test_results/backend.xml"


COLOURS="256"
SPINNER=
if [[ -v CI ]]; then
  # Expecto needs `--colours 0` or the xml will be invalid
  # https://github.com/haf/expecto/issues/434
  COLOURS="0"
  SPINNER="--no-spinner"
fi

TEST_LOG="${LOGS}/fsharp-tests.log"
true > "${TEST_LOG}" # truncate

cd backend
echo -e "Logging to: ${grey}${TEST_LOG}${reset}"

# CI only, because CI is the only place with nothing else to look at: the spinner is
# disabled up there, and Expecto prints nothing between "Running tests..." and the
# summary. A step with no output for ten minutes gets killed, which turns any slowdown
# into a hang with no evidence of where. Locally the spinner already says it is alive.
#
# Two minutes, not thirty seconds: this exists to stay inside a ten-minute limit, not to
# report progress, so the cheapest interval that does that is the right one. A four
# minute run costs one line. Use `--debug` when you need to know WHICH test.
#
# Goes to this script's stdout rather than through the `tee` below, so it lands in the
# step output CI keeps rather than in `fsharp-tests.log`. Killed with the runner.
if [[ -v CI ]]; then
  (
    start=$(date +%s)
    while true; do
      sleep 120
      echo "[heartbeat] tests still running, $(( $(date +%s) - start ))s elapsed"
    done
  ) &
  HEARTBEAT_PID=$!
fi

set +e
DARK_CONFIG_TELEMETRY_EXPORTER=none \
"${EXE}" ${SPINNER} --colours "${COLOURS}" --junit-summary "${JUNIT_FILE}" "${EXPECTO_ARGS[@]}" 2>&1 | tee "${TEST_LOG}"
STATUS=${PIPESTATUS[0]}
set -e

kill "${HEARTBEAT_PID:-}" 2>/dev/null || true

# Expecto reports a filter that matched nothing as "0 tests run - Success!" and exits
# 0, which is the worst answer available: you believe you ran a suite you didn't.
if [[ "$STATUS" -eq 0 && "$FILTERED" == "true" ]]; then
  if ! sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' -e 's/\r/\n/g' "${TEST_LOG}" \
       | grep -qE "EXPECTO! [1-9][0-9]* tests run"; then
    {
      echo
      echo "Your filter matched no tests, so nothing ran. Reporting that as a"
      echo "failure, because Expecto calls it a success."
      echo
      echo "Find what to run:"
      echo "    scripts/run-backend-tests --groups          the tree, with counts"
      echo "    scripts/run-backend-tests --find <substr>   which tests match"
    } >&2
    exit 1
  fi
fi

exit "$STATUS"
